      <aliases enabled='yes' />
      <column caption='% Users' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([users]) / TOTAL(SUM([users]))'>
          <table-calc ordering-type='Field'>
            <order field='[federated.1xqpbqu1hvp0oi17n2bqd0uo9g32].[tmn:reporting_month:ok]' />
            <order field='[federated.1xqpbqu1hvp0oi17n2bqd0uo9g32].[Calculation_6205819566323068932]' />
            <order field='[federated.1xqpbqu1hvp0oi17n2bqd0uo9g32].[Calculation_6205819566323171333]' />
            <order field='[federated.1xqpbqu1hvp0oi17n2bqd0uo9g32].[Calculation_6205819566322704387]' />
          </table-calc>
        </calculation>
      </column>
      <column caption='MoM Users' datatype='integer' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([users])) - LOOKUP(ZN(SUM([users])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM Users %' datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([users])) - LOOKUP(ZN(SUM([users])), -1)) / ABS(LOOKUP(ZN(SUM([users])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2400277899684032520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_marketing_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [User Filter]&#10;END' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_5969380585602654209]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Users Start Period' datatype='integer' name='[Calculation_5969380585603059714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [reporting_month] = [Parameters].[Breakdown by (copy 2)] THEN [users] ELSE 0 END' />
      </column>
      <column caption='Users End Period' datatype='integer' name='[Calculation_5969380585603145731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [reporting_month] = [Parameters].[Start Month (copy)] THEN [users] ELSE 0 END' />
      </column>
      <column caption='Users Diff Overview' datatype='integer' name='[Calculation_5969380585603231748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5969380585603145731]) - SUM([Calculation_5969380585603059714])' />
      </column>
      <column caption='Users Diff % Overview' datatype='real' name='[Calculation_5969380585603338245]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_5969380585603145731])-SUM([Calculation_5969380585603059714])) / SUM([Calculation_5969380585603059714])' />
      </column>
      <column caption='Users Diff Overview Direction' datatype='string' name='[Calculation_5969380585603432454]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5969380585603231748] &lt; 0 THEN &quot;Down&quot; &#10;ELSEIF [Calculation_5969380585603231748] &gt; 0 THEN &quot;Up&quot; &#10;ELSE &quot;No Change&quot;&#10;END' />
      </column>
      <column caption='Negative Users Diff %' datatype='string' name='[Calculation_5969380585603936263]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5969380585603338245] &lt; 0 &#10;THEN &quot;▼&quot; + &quot; &quot; + STR(ROUND([Calculation_5969380585603338245]*-100)) + &quot;%&quot; END' />
      </column>
      <column caption='Positive Users Diff %' datatype='string' name='[Calculation_5969380585604050952]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5969380585603338245] &gt; 0 THEN &quot;▲&quot; + &quot; &quot; + STR(ROUND([Calculation_5969380585603338245]*100)) + &quot;%&quot; END' />
      </column>
