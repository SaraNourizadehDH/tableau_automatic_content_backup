          <datasource-dependencies datasource='federated.1ccvqz81ez35ej171el2u0wuldaj'>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[partition_month]' derivation='None' name='[none:partition_month:qk]' pivot='key' type='quantitative' />
            <column caption='Partition Month' datatype='date' name='[partition_month]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1pt8omj0qycyuv1cki3wi06sej6b'>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2400277899684315145]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_marketing_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [User Filter]&#10;END' />
            </column>
            <column caption='GEID Filter' datatype='boolean' name='[Calculation_6189845908904448017]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 4] = &quot;All&quot;, TRUE, &quot;FP_&quot; + [Parameters].[Parameter 4]== [global_entity_id])' />
            </column>
            <column caption='MAU Churn Rate' datatype='real' name='[MAU Retention Rate (copy)_2288180519235473408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - SUM([retained_mau]) / SUM([mau_prev])' />
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='integer' name='[mau_prev]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2400277899684315145]' derivation='None' name='[none:Calculation_2400277899684315145:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6189845908904448017]' derivation='None' name='[none:Calculation_6189845908904448017:nk]' pivot='key' type='nominal' />
            <column-instance column='[reporting_month]' derivation='None' name='[none:reporting_month:qk]' pivot='key' type='quantitative' />
            <column caption='Reporting Month' datatype='date' name='[reporting_month]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[retained_mau]' role='measure' type='quantitative' />
            <column-instance column='[reporting_month]' derivation='Month-Trunc' name='[tmn:reporting_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[MAU Retention Rate (copy)_2288180519235473408]' derivation='User' name='[usr:MAU Retention Rate (copy)_2288180519235473408:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1ccvqz81ez35ej171el2u0wuldaj].[none:partition_month:qk]' filter-group='24' included-values='in-range'>
