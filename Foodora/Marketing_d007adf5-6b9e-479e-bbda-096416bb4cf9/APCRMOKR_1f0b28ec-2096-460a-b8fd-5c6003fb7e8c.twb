            <column caption='OKR (#)' datatype='boolean' name='[Calculation_3856418302005067776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Calculation_5244793625362477057] WHEN &quot;#&quot; THEN&#10;IF [Parameters].[OKR (copy)_3856418302007152643] = &quot;MAU&quot; AND [metric] = &quot;MAU&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;MAU&quot; AND [metric] = &quot;MAU attributable to CRM&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;MAU&quot; AND [metric] = &quot;MAU incentivised by CRM&quot; THEN TRUE&#10;&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;1st order&quot; AND [metric] = &quot;1st order&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;1st order&quot; AND [metric] = &quot;1st order attributable to CRM&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;1st order&quot; AND [metric] = &quot;1st order incentivised by CRM&quot; THEN TRUE&#10;&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;2nd order&quot; AND [metric] = &quot;2nd order&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;2nd order&quot; AND [metric] = &quot;2nd order attributable to CRM&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;2nd order&quot; AND [metric] = &quot;2nd order incentivised by CRM&quot; THEN TRUE&#10;&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;Reactivations&quot; AND [metric] = &quot;Reactivations&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;Reactivations&quot; AND [metric] = &quot;Reactivations attributable to CRM&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;Reactivations&quot; AND [metric] = &quot;Reactivations incentivised by CRM&quot; THEN TRUE&#10;&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;QC Trial&quot; AND [metric] = &quot;1st QC order&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;QC Trial&quot; AND [metric] = &quot;QC Trial attributable to CRM&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;QC Trial&quot; AND [metric] = &quot;QC Trial incentivised by CRM&quot; THEN TRUE&#10;&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;GMV attributable to CRM&quot; AND [metric] = &quot;GMV attributable to CRM&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;Dmart MAU&quot; AND [metric] = &quot;Dmart MAU&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;Shops MAU&quot; AND [metric] = &quot;Shops MAU&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;Pickup MAU&quot; AND [metric] = &quot;Pickup MAU&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;FLGP Positive MAU&quot; AND [metric] = &quot;FLGP Positive MAU&quot; THEN TRUE&#10;ELSEIF [Parameters].[OKR (copy)_3856418302007152643] = &quot;Order Frequency (Valid orders)&quot; AND [metric] = &quot;Order Frequency&quot; THEN TRUE&#10;END&#10;END' />
            </column>
            <column caption='OKR Unit' datatype='string' name='[Calculation_5244793625362477057]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[OKR (copy)_3856418302007152643] &#10;WHEN &quot;MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Dmart MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Shops MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Pickup MAU&quot; THEN &quot;#&quot;&#10;WHEN &quot;Pro % MAU Penetration&quot; THEN &quot;%&quot;&#10;WHEN &quot;% registrations make 1st order in 30 days&quot; THEN &quot;%&quot;&#10;WHEN &quot;% users make 2nd order in 30 days&quot; THEN &quot;%&quot;&#10;WHEN &quot;Reactivations&quot; THEN &quot;#&quot;&#10;WHEN &quot;Order Frequency (Valid orders)&quot; THEN &quot;#&quot;&#10;WHEN &quot;% MAU tried ≥2 verticals&quot; THEN &quot;%&quot;&#10;WHEN &quot;Automation %&quot; THEN &quot;%&quot;&#10;WHEN &quot;1st order&quot; THEN &quot;#&quot;&#10;WHEN &quot;2nd order&quot; THEN &quot;#&quot;&#10;WHEN &quot;QC Trial&quot; THEN &quot;#&quot;&#10;WHEN &quot;GMV attributable to CRM&quot; THEN &quot;#&quot;&#10;WHEN &quot;Orders&quot; THEN &quot;#&quot;&#10;WHEN &quot;FLGP Positive MAU&quot; THEN &quot;#&quot;&#10;END' />
            </column>
            <column caption='OKR (#) MoM' datatype='real' name='[Calculation_5244793625365573635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[OKR (copy)_3856418302007152643] &#10;   WHEN &quot;MAU&quot; THEN ZN(SUM([okr])) - LOOKUP(ZN(SUM([okr])), -1)&#10;   WHEN &quot;Dmart MAU&quot; THEN ZN(SUM([okr])) - LOOKUP(ZN(SUM([okr])), -1)&#10;   WHEN &quot;Shops MAU&quot; THEN ZN(SUM([okr])) - LOOKUP(ZN(SUM([okr])), -1)&#10;   WHEN &quot;Pickup MAU&quot; THEN ZN(SUM([okr])) - LOOKUP(ZN(SUM([okr])), -1) &#10;   WHEN &quot;Reactivations&quot; THEN ZN(SUM([okr])) - LOOKUP(ZN(SUM([okr])), -1)&#10;   WHEN &quot;1st order&quot; THEN ZN(SUM([okr])) - LOOKUP(ZN(SUM([okr])), -1)&#10;   WHEN &quot;2nd order&quot; THEN ZN(SUM([okr])) - LOOKUP(ZN(SUM([okr])), -1)&#10;   WHEN &quot;QC Trials&quot; THEN ZN(SUM([okr])) - LOOKUP(ZN(SUM([okr])), -1)&#10;   WHEN &quot;GMV attributable to CRM&quot; THEN ZN(SUM([okr])) - LOOKUP(ZN(SUM([okr])), -1)&#10;   WHEN &quot;FLGP Positive MAU&quot; THEN ZN(SUM([okr])) - LOOKUP(ZN(SUM([okr])), -1)&#10;   WHEN &quot;Order Frequency&quot; THEN ZN(SUM([okr])) - LOOKUP(ZN(SUM([okr])), -1)&#10;&#10;  WHEN &quot;% registrations make 1st order in 30 days&quot; THEN ZN(SUM([okr])*100) - LOOKUP(ZN(SUM([okr])*100), -1)&#10;  WHEN &quot;% users make 2nd order in 30 days&quot; THEN ZN(SUM([okr])*100) - LOOKUP(ZN(SUM([okr])*100), -1)&#10;  WHEN &quot;% MAU tried ≥2 verticals&quot; THEN ZN(SUM([okr])*100) - LOOKUP(ZN(SUM([okr])*100), -1)&#10;  WHEN &quot;Pro % MAU Penetration&quot; THEN ZN(SUM([okr])*100) - LOOKUP(ZN(SUM([okr])*100), -1)&#10;  WHEN &quot;Automation %&quot; THEN ZN(SUM([okr])*100) - LOOKUP(ZN(SUM([okr])*100), -1)&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='OKR (#) MoM %' datatype='real' name='[Calculation_5244793625366704134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([okr])) - LOOKUP(ZN(SUM([okr])), -1)) / ABS(LOOKUP(ZN(SUM([okr])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Negative OKR (#) MoM %' datatype='string' name='[Calculation_5244793625367044103]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5244793625366704134] &lt; 0 &#10;THEN &quot;▼&quot; + &quot; &quot; + STR(ROUND([Calculation_5244793625366704134]*-100,0)) + &quot;%&quot; &#10;END'>
                <table-calc ordering-type='Rows' />
