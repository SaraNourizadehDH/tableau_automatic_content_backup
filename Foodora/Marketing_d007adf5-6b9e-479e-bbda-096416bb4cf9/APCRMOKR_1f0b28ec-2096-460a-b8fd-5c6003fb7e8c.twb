            <column caption='MoM Diff (%)' datatype='real' name='[MoM Diff (#) (copy)_1559934360354910211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([Calculation_3649815719592349753])) - LOOKUP(ZN(SUM([Calculation_3649815719592349753])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_3649815719592349753])), -1))'>
