      <column caption='MTD Difference (in #)' datatype='integer' name='[Calculation_1492169280528736263]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[current_mtd_acid]-[previous_mtd_acid]' />
      </column>
      <column caption='APAC User Filter' datatype='boolean' name='[Calculation_2400277899681972226]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_marketing_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_marketing_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [User Filter]&#10;END' />
      </column>
      <column caption='Target' datatype='integer' name='[Calculation_618470896082251776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [new_segments] &#10;WHEN &quot;New Customer&quot; THEN [nc_target]&#10;WHEN &quot;Reactivated&quot; THEN [reactivated_target]&#10;WHEN &quot;Retained Existing Customer&quot; THEN [retained_ec_target]&#10;WHEN &quot;Retained New Customer&quot; THEN [retained_nc_target]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='MTD % Target Reached' datatype='real' name='[Calculation_618470896085450754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[current_mtd_acid]/[Calculation_618470896082251776]' />
      </column>
      <column caption='MTD Difference (in %)' datatype='real' name='[MTD Difference (in #) (copy)_1492169280528834568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1492169280528736263])/SUM([previous_mtd_acid])' />
