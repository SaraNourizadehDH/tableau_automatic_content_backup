        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0yt8bsw0ofn3tc1asvw8d067v4sx' name='Custom SQL Query' type='text'><![CDATA[WITH cm_segments AS (
  SELECT
    country_name,
    global_entity_id,
    active_segment_by_acid,
    partition_date_local,
    DATE_TRUNC(partition_date_local, MONTH) AS partition_month,
    analytical_customer_id,
    ROW_NUMBER() OVER (PARTITION BY analytical_customer_id, DATE_TRUNC(partition_date_local, MONTH) ORDER BY partition_date_local ASC) = 1 AS is_first_segment
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_crm_mac_segments`
  WHERE DATE_TRUNC(partition_date_local, MONTH) = DATE_TRUNC(CURRENT_DATE, MONTH)
   AND EXTRACT(DAY FROM partition_date_local) <<= EXTRACT(DAY FROM CURRENT_DATE) - 2
   AND DATE_TRUNC(last_order_date_local_by_acid, MONTH) = DATE_TRUNC(partition_date_local, MONTH)
),

cm_agg AS (
  SELECT
    country_name,
    global_entity_id,
    partition_month,
    CASE 
     WHEN active_segment_by_acid = "Reactivated Churn" OR  active_segment_by_acid = "Reactivated Inactive" THEN "Reactivated"
    ELSE active_segment_by_acid
    END AS new_segments,   
    COUNT(DISTINCT analytical_customer_id) AS num_users
  FROM cm_segments 
  WHERE is_first_segment
  GROUP BY 1,2,3,4
  UNION ALL
  SELECT
    'APAC' AS country_name,
    'APAC' AS global_entity_id,
    partition_month,
    CASE 
     WHEN active_segment_by_acid = "Reactivated Churn" OR  active_segment_by_acid = "Reactivated Inactive" THEN "Reactivated"
    ELSE active_segment_by_acid
    END AS new_segments,   
    COUNT(DISTINCT analytical_customer_id) AS num_users
  FROM cm_segments 
  WHERE is_first_segment
  GROUP BY 1,2,3,4
),
-- with
p1m_segments AS (
  SELECT
    country_name,
    global_entity_id,
    active_segment_by_acid,
    partition_date_local,
    DATE_TRUNC(partition_date_local, MONTH) AS partition_month,
    analytical_customer_id,
    ROW_NUMBER() OVER (PARTITION BY analytical_customer_id, DATE_TRUNC(partition_date_local, MONTH) ORDER BY partition_date_local ASC) = 1 AS is_first_segment
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_crm_mac_segments`
  WHERE DATE_TRUNC(partition_date_local, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 MONTH), MONTH)
     AND EXTRACT(DAY FROM partition_date_local) <<= EXTRACT(DAY FROM DATE_SUB(CURRENT_DATE, INTERVAL 1 MONTH)) - 2
   AND DATE_TRUNC(last_order_date_local_by_acid, MONTH) = DATE_TRUNC(partition_date_local, MONTH)
),

p1m_agg AS (
  SELECT
    country_name,
    global_entity_id,
    partition_month,
    CASE 
     WHEN active_segment_by_acid = "Reactivated Churn" OR  active_segment_by_acid = "Reactivated Inactive" THEN "Reactivated"
    ELSE active_segment_by_acid
    END AS new_segments,    
    COUNT(DISTINCT analytical_customer_id) AS num_users
  FROM p1m_segments 
  WHERE is_first_segment
  GROUP BY 1,2,3,4
  UNION ALL
  SELECT
    'APAC' AS country_name,
    'APAC' AS global_entity_id,
    partition_month,
    CASE 
     WHEN active_segment_by_acid = "Reactivated Churn" OR  active_segment_by_acid = "Reactivated Inactive" THEN "Reactivated"
    ELSE active_segment_by_acid
    END AS new_segments,   
    COUNT(DISTINCT analytical_customer_id) AS num_users
  FROM p1m_segments 
  WHERE is_first_segment
  GROUP BY 1,2,3,4
)

SELECT
  cm.country_name,
  cm.global_entity_id,
  cm.partition_month AS month_local,
  cm.new_segments,
  p1m.num_users AS previous_mtd_acid,
  cm.num_users AS current_mtd_acid,
  DATE_SUB(CURRENT_DATE, INTERVAL 2 DAY) AS report_date
FROM cm_agg AS cm
LEFT JOIN p1m_agg AS p1m
ON p1m.global_entity_id = cm.global_entity_id
AND p1m.new_segments = cm.new_segments
ORDER BY 1,2,3,4]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
