        <calculation class='tableau' formula='CASE [Calculation_3754102193565216777] WHEN &quot;#&quot;&#10; THEN CASE [Parameters].[mac CRM contribution % Parameter] &#10;   WHEN &quot;MAU&quot; THEN [mau]&#10;   WHEN &quot;Dmart MAU&quot; THEN [dmart_mau]&#10;   WHEN &quot;Shops MAU&quot; THEN [shops_mau]&#10;   WHEN &quot;Pickup MAU&quot; THEN [pickup_mau]&#10;   WHEN &quot;QCommerce MAU&quot; THEN [qcomm_mau]&#10;   WHEN &quot;# Reactivated Churn&quot; THEN [reactivated_churn]&#10;   WHEN &quot;# Reactivated Inactive&quot; THEN [reactivated_inactive]&#10;   WHEN &quot;# Reactivated&quot; THEN [reactivated_churn] + [reactivated_inactive]&#10;   WHEN &quot;MAUs attributable to CRM&quot; THEN [converted_mau_uplift]&#10;   WHEN &quot;Reactivations attributable to CRM&quot; THEN [converted_reactivation_uplift]&#10;   WHEN &quot;1st Order in 30 days attributable to CRM&quot; THEN [converted_1st_order_uplift]&#10;   WHEN &quot;2nd Order in 30 days attributable to CRM&quot; THEN [converted_2nd_order_uplift]&#10;   WHEN &quot;QC trials attributable to CRM&quot; THEN [converted_qc_trial_uplift]&#10;   WHEN &quot;Net GMV attributable to CRM&quot; THEN [net_gmv_uplift]&#10;   WHEN &quot;Orders attributable to CRM&quot; THEN [orders_uplift]&#10;   WHEN &quot;FLGP Positive MAU&quot; THEN [flgp_positive_mau]&#10;   WHEN &quot;Users make 2nd order in 30 days&quot; THEN [second_order_in_30d]&#10;END&#10;END' />
