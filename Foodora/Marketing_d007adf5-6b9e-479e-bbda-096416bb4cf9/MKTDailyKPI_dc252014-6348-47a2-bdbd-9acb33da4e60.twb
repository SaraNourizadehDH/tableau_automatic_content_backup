            <column caption='is_today' datatype='boolean' name='[Calculation_1790180856673083392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date]=TODAY()&#10;//[Date]=TODAY() or [Date]=TODAY()-1' />
            </column>
            <column caption='Existing Customer MTD vs PYTD (Indicator)' datatype='string' name='[Existing Customer MTD vs PMTD (Indicator) (copy)_25192057159323649]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*if&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Existing customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Existing customers PYTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Existing customers PYTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;*/&#10;&#10;&#10;if&#10;(&#10;    [Existing Customer MTD vs PMTD (copy)_6831890293033697283]&#10;    -&#10;    [Existing customers PMTD (copy)_25192057159503874]&#10;)&#10;/&#10;(&#10;[Existing customers PMTD (copy)_25192057159503874]&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='Existing Customer MTD vs PYTD' datatype='string' name='[Existing Customer MTD vs PMTD (copy)_25192057160052739]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*if&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Existing customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Existing customers PYTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Existing customers PYTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Existing customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Existing customers PYTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Existing customers PYTD])})&#10;)&#10;* 100&#10;,1)&#10;)&#10;*/&#10;&#10;&#10;if&#10;(&#10;    [Existing Customer MTD vs PMTD (copy)_6831890293033697283]&#10;    -&#10;    [Existing customers PMTD (copy)_25192057159503874]&#10;)&#10;/&#10;(&#10;[Existing customers PMTD (copy)_25192057159503874]&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    [Existing Customer MTD vs PMTD (copy)_6831890293033697283]&#10;    -&#10;    [Existing customers PMTD (copy)_25192057159503874]&#10;)&#10;/&#10;(&#10;[Existing customers PMTD (copy)_25192057159503874]&#10;)&#10;* 100&#10;,1)&#10;)' />
            </column>
            <column caption='Existing customers MTD' datatype='integer' name='[Existing Customer MTD vs PMTD (copy)_6831890293033697283]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(IF DAY(TODAY()) = 1 THEN [eu_previous_month_cumulative_cum_distinct_cnt] ELSE&#10;[eu_current_month_cumulative_cum_distinct_cnt] END)&#10;/*&#10;MAX(IF DAY(TODAY()) = 2 THEN [Eu Previous Month Cumulative Cum Distinct Cnt] ELSE&#10;[Eu Current Month Cumulative Cum Distinct Cnt] END)*/' />
            </column>
            <column caption='Existing customers PYTD' datatype='integer' name='[Existing customers PMTD (copy)_25192057159503874]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, TODAY())) &#10;AND DAY([date]) &lt;= DAY(TODAY()-1)&#10;THEN [eu_yoy_month_cumulative_cum_distinct_cnt] END)&#10;/*&#10;MAX(IF DATETRUNC(&apos;month&apos;, [Date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, TODAY())) &#10;AND DAY([Date]) &lt;= DAY(TODAY()-2)&#10;THEN [Eu Yoy Month Cumulative Cum Distinct Cnt] END)*/' />
            </column>
