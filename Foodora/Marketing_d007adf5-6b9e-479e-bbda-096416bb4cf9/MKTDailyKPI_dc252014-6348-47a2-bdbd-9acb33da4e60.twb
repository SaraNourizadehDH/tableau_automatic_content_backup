      <table>
        <view>
          <datasources>
            <datasource caption='EU daily kpis(pandata)' name='federated.1c51twp19tsd9o12b8pgw0t7rtgu' />
          </datasources>
          <datasource-dependencies datasource='federated.1c51twp19tsd9o12b8pgw0t7rtgu'>
            <column caption='CVR MTD' datatype='real' name='[% Incentivised Orders MTD (copy)_582371763051900936]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SUM(iif([MTD (copy)_3533636887910658068],[transaction],0))&#10;/&#10;SUM(iif([MTD (copy)_3533636887910658068],[sessions],0))' />
            </column>
            <column caption='CVR PMTD' datatype='real' name='[% Incentivised Orders PMTD (copy)_582371763053334537]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SUM(iif([PMTD (copy)_3533636887910744085],[transaction],0))&#10;/&#10;SUM(iif([PMTD (copy)_3533636887910744085],[sessions],0))' />
            </column>
            <column caption='One' datatype='integer' name='[Calculation_1127588798567391234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='MTD (session)' datatype='boolean' name='[MTD (copy)_3533636887910658068]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() /*- 2*/-1) = 0&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()/*-2*/-1)' />
            </column>
            <column caption='MTD CVR (Negative)' datatype='string' name='[MTD Incentivised Orders (Negative) (copy)_582371763074277414]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([% Incentivised Orders MTD (copy)_582371763051900936] - [% Incentivised Orders PMTD (copy)_582371763053334537]) &lt; 0&#10;THEN &apos;▼&apos; ELSE null END&#10;&#10;+ &#10;if&#10;([% Incentivised Orders MTD (copy)_582371763051900936] - [% Incentivised Orders PMTD (copy)_582371763053334537]) &lt; 0&#10;then&#10;STR(&#10;ROUND(&#10;   ([% Incentivised Orders MTD (copy)_582371763051900936] - [% Incentivised Orders PMTD (copy)_582371763053334537])* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='MTD CVR (Positive)' datatype='string' name='[MTD Incentivised Orders% (Positive) (copy)_582371763074269221]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([% Incentivised Orders MTD (copy)_582371763051900936] - [% Incentivised Orders PMTD (copy)_582371763053334537]) &gt;= 0&#10;THEN &apos;▲&apos; ELSE null END&#10;&#10;+ &#10;if&#10;([% Incentivised Orders MTD (copy)_582371763051900936] - [% Incentivised Orders PMTD (copy)_582371763053334537]) &gt;= 0&#10;then&#10;STR(&#10;ROUND(&#10;   ([% Incentivised Orders MTD (copy)_582371763051900936] - [% Incentivised Orders PMTD (copy)_582371763053334537])* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='PMTD (session)' datatype='boolean' name='[PMTD (copy)_3533636887910744085]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() /*- 2*/-1) = 1&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()/*-2*/-1)' />
            </column>
            <column caption='W1 CVR % (L1W)' datatype='real' name='[W1 Incentivised Order % (L1W) (copy)_582371763072639004]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date], [global_entity_id]:&#10;SUM(IF [is_same_day_last_week (copy)_3533636887903768587] THEN [transaction] ELSE 0 END) / SUM(IF [is_same_day_last_week (copy)_3533636887903768587] THEN [sessions] ELSE 0 END)&#10;}' />
            </column>
            <column caption='W1 CVR (Indicator)' datatype='string' name='[W1 Incentivised Orders % (Indicator) (copy)_582371763072811038]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [W1 Incentivised Orders % (Value Only) (copy)_582371763073093666] &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='W1 CVR % (Negative)' datatype='string' name='[W1 Incentivised Orders % (Negative) (copy)_582371763072913439]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([W1 Incentivised Orders % (Indicator) (copy)_582371763072811038] = &apos;▼&apos;, [W1 Incentivised Orders (copy)_582371763072741405]+&apos;%&apos;, NULL)' />
            </column>
            <column caption='W1 CVR % (Positive)' datatype='string' name='[W1 Incentivised Orders % (Positive) (copy)_582371763072974880]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([W1 Incentivised Orders % (Indicator) (copy)_582371763072811038] = &apos;▲&apos;, [W1 Incentivised Orders (copy)_582371763072741405]+&apos;%&apos;, NULL)' />
            </column>
            <column caption='W1 CVR (Value Only)' datatype='real' name='[W1 Incentivised Orders % (Value Only) (copy)_582371763073093666]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND(&#10;(SUM([W1 Incentivised Orders % (Yesterday) (copy)_582371763073155107]) - SUM([W1 Incentivised Order % (L1W) (copy)_582371763072639004])) / SUM([W1 Incentivised Order % (L1W) (copy)_582371763072639004])&#10;//    SUM(IF [L1W] THEN [total_number_of_successful_orders] ELSE 0 END) / SUM(IF [Yesterday] THEN [total_number_of_successful_orders] ELSE 0 END)&#10;* 100, 2)' />
            </column>
            <column caption='W1 CVR (Yesterday)' datatype='real' name='[W1 Incentivised Orders % (Yesterday) (copy)_582371763073155107]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date], [global_entity_id]:&#10;SUM(IF [is_yesterday (copy)_3533636887883218944] THEN [transaction] ELSE 0 END) / SUM(IF [is_yesterday (copy)_3533636887883218944] THEN [sessions] ELSE 0 END)&#10;}' />
            </column>
            <column caption='W1 CVR' datatype='string' name='[W1 Incentivised Orders (copy)_582371763072741405]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[W1 Incentivised Orders % (Indicator) (copy)_582371763072811038]&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR([W1 Incentivised Orders % (Value Only) (copy)_582371763073093666])' />
            </column>
            <column caption='Yesterday&apos;s CVR Main' datatype='real' name='[Yesterday&apos;s Incentivised Orders Main (copy)_582371763073658916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday (copy)_3533636887883218944], [transaction], null))/SUM(IIF([is_yesterday (copy)_3533636887883218944], [sessions], null))' />
            </column>
