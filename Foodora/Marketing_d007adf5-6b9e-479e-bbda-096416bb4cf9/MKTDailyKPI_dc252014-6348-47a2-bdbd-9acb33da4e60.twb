            </column>
            <column caption='LS Active customers MTD vs PYTD' datatype='string' name='[Dmart Active customers MTD vs PYTD (copy)_6234530059697475594]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*if&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers PYTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Dmart Active customers PYTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers PYTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Dmart Active customers PYTD])})&#10;)&#10;* 100&#10;,1)&#10;)*/&#10;&#10;if&#10;(&#10;    [Dmart Active customers MTD (copy)_6234530059695394821]&#10;    -&#10;    [Dmart Active customers PYTD (copy)_6234530059697365001]&#10;)&#10;/&#10;(&#10;[Dmart Active customers PYTD (copy)_6234530059697365001]&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    [Dmart Active customers MTD (copy)_6234530059695394821]&#10;    -&#10;    [Dmart Active customers PYTD (copy)_6234530059697365001]&#10;)&#10;/&#10;(&#10;[Dmart Active customers PYTD (copy)_6234530059697365001]&#10;)&#10;* 100&#10;,1)&#10;)' />
            </column>
            <column caption='LS Active customers MTD vs PYTD(Indicator)' datatype='string' name='[Dmart Active customers MTD vs PYTD(Indicator) (copy)_6234530059697864715]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*if&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers PYTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Dmart Active customers PYTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end*/&#10;&#10;&#10;if&#10;(&#10;    [Dmart Active customers MTD (copy)_6234530059695394821]&#10;    -&#10;    [Dmart Active customers PYTD (copy)_6234530059697365001]&#10;)&#10;/&#10;(&#10;[Dmart Active customers PYTD (copy)_6234530059697365001]&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='LS Active customers PYTD' datatype='integer' name='[Dmart Active customers PYTD (copy)_6234530059697365001]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, TODAY() - 1))&#10;AND DAY([date]) &lt;= DAY(TODAY()-1)&#10;THEN [ls_au_yoy_month_cumulative_cum_distinct_cnt] END)&#10;/*&#10;MAX(IF DATETRUNC(&apos;month&apos;, [Date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, TODAY() - 1))&#10;AND DAY([Date]) &lt;= DAY(TODAY()-2)&#10;THEN [Dm Au Yoy Month Cumulative Cum Distinct Cnt] END)*/' />
