        <calculation class='tableau' formula='if&#10;(&#10;    [% Incentivised Orders MTD (copy)_582371763051900936] - [% Incentivised Orders PMTD (copy)_582371763053334537]&#10;)&#10;&#10; &lt;= 0&#10;then &apos;▼ &apos;&#10;ELSE &apos;▲ &apos; &#10;end' />
