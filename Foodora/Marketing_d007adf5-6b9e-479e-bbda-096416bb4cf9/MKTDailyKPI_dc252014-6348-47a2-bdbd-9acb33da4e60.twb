      <column caption='PYTD' datatype='boolean' hidden='true' name='[PMTD (copy)_25192057159188480]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='/*DATEDIFF(&apos;month&apos;, [Date], today() - 1) = 12&#10;AND&#10;DAY([Date]) &lt;= DAY(TODAY()-1)*/&#10;&#10;DATEDIFF(&apos;month&apos;, [date], today() - 2) = 12&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-2)' />
