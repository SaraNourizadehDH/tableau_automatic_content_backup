            <column caption='is_same_day_last_week (session)' datatype='boolean' name='[is_same_day_last_week (copy)_3533636887903768587]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date]= TODAY()-/*9*/8' />
            </column>
            <column caption='is_yesterday (session)' datatype='boolean' name='[is_yesterday (copy)_3533636887883218944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date]= TODAY()-/*2*/1' />
