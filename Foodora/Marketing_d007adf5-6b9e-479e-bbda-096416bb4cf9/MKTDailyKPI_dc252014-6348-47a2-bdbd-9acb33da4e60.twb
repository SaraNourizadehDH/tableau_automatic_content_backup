          <datasource-dependencies datasource='federated.1c51twp19tsd9o12b8pgw0t7rtgu'>
            <column aggregation='Sum' caption='1 T7D Delta' datatype='integer' name='[1 T7D Growth (copy)_6784813611301699590]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Last7D vs Prev7D Delta' />
