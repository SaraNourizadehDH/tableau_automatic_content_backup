          <datasource-dependencies datasource='federated.1c51twp19tsd9o12b8pgw0t7rtgu'>
            <column aggregation='Sum' caption='1 RR' datatype='integer' name='[1 T7D (Active Customer) (copy)_5219812740103204866]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Current Month RR' />
              </aliases>
            </column>
            <column caption='Active customers MTD' datatype='integer' name='[Existing customers MTD (copy)_1516798309607297053]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(IF DAY(TODAY()) = 1 THEN [au_previous_month_cumulative_cum_distinct_cnt] ELSE&#10;[au_current_month_cumulative_cum_distinct_cnt] END)&#10;/*MAX(IF DAY(TODAY()) = 2 THEN [Au Previous Month Cumulative Cum Distinct Cnt] ELSE&#10;[Au Current Month Cumulative Cum Distinct Cnt] END)*/' />
            </column>
            <column caption='au_rr' datatype='real' name='[acq_rr (copy)_5219812740104556547]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='/*IIF (DATEPART(&apos;day&apos;, TODAY()) =1&#10;,[Active customers MTD],&#10;MAX(IF DATETRUNC(&apos;month&apos;, [Date]) = DATETRUNC(&apos;month&apos;, TODAY() - 1) THEN [Au Current Month Cumulative Cum Distinct Cnt] END)&#10;+ MAX(IF DATETRUNC(&apos;month&apos;, [Date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY() - 1)) THEN [Au Previous Month Cumulative Cum Distinct Cnt] END)&#10;/ MAX(IF DATETRUNC(&apos;month&apos;, [Date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY() - 1)) THEN [Days in Month] END)&#10;* (MAX(IF DATETRUNC(&apos;month&apos;, [Date]) = DATETRUNC(&apos;month&apos;, TODAY() - 1) THEN [Days in Month] END) - DAY(TODAY()-1))&#10;)*/&#10;&#10;IIF (DATEPART(&apos;day&apos;, TODAY()) =2&#10;,[Existing customers MTD (copy)_1516798309607297053],&#10;MAX(IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, TODAY() - 2) THEN [au_current_month_cumulative_cum_distinct_cnt] END)&#10;+ MAX(IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY() - 2)) THEN [au_previous_month_cumulative_cum_distinct_cnt] END)&#10;/ MAX(IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY() - 2)) THEN [acq_rr (copy)_5219812740105531396] END)&#10;* (MAX(IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, TODAY() - 2) THEN [acq_rr (copy)_5219812740105531396] END) - DAY(TODAY()-2))&#10;)' />
              <aliases>
                <alias key='1.0' value='WoW %' />
              </aliases>
            </column>
            <column caption='Days in Month' datatype='integer' name='[acq_rr (copy)_5219812740105531396]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[date]))))' />
              <aliases>
                <alias key='1' value='WoW %' />
