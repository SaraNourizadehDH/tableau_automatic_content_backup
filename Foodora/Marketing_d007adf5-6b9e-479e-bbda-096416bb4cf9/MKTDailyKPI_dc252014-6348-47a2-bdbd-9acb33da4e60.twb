      <column caption='Order Count LW Growth' datatype='string' hidden='true' name='[Calculation_4464052437733662720]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM(IF [Calculation_6831890293018333185] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [subscription_orders] ELSE 0 END))&#10;/ SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [subscription_orders] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND( &#10;   (SUM(IF [Calculation_6831890293018333185] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [subscription_orders] ELSE 0 END))&#10;   / SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [subscription_orders] ELSE 0 END)* 100, 1))' />
      </column>
      <column caption='Color - Order Count LW Growth' datatype='string' hidden='true' name='[Calculation_4464052437733945347]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM(IF [Calculation_6831890293018333185] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [subscription_orders] ELSE 0 END))&#10;/ SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [subscription_orders] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
