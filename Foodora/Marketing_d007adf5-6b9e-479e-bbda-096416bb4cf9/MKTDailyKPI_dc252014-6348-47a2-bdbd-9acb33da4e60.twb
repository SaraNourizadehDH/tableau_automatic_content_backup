      <column caption='PY Same Month' datatype='boolean' name='[PMTD (acq) (copy)_630433583383072769]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='/*MONTH([Date])=MONTH(TODAY()-2)&#10;AND&#10;DATEDIFF(&apos;year&apos;, [Date], today() - 2) = 1*/&#10;MONTH([date])=MONTH(TODAY()-1)&#10;AND&#10;DATEDIFF(&apos;year&apos;, [date], today() - 1) = 1' />
