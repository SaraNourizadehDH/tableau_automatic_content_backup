              <calculation class='tableau' formula='IF (SUM(IF [Calculation_6831890293018333185] THEN [au_dmart_daily] ELSE 0 END) - SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [au_dmart_daily]  ELSE 0 END))&#10;/ SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [au_dmart_daily]  ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND( &#10;   (SUM(IF [Calculation_6831890293018333185] THEN [au_dmart_daily]  ELSE 0 END) - SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [au_dmart_daily]  ELSE 0 END))&#10;   / SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [au_dmart_daily]  ELSE 0 END)* 100, 1))' />
