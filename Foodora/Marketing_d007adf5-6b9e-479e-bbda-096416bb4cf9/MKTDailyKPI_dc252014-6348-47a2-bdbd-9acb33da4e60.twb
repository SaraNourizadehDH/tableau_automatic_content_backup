            <column caption='LS Active customers MTD' datatype='integer' name='[Dmart Active customers MTD (copy)_6234530059695394821]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(IF DAY(TODAY()) = 1 THEN [ls_au_previous_month_cumulative_cum_distinct_cnt] ELSE&#10;[ls_au_current_month_cumulative_cum_distinct_cnt] END)&#10;/*MAX(IF DAY(TODAY()) = 2 THEN [Dm Au Previous Month Cumulative Cum Distinct Cnt] ELSE&#10;[Dm Au Current Month Cumulative Cum Distinct Cnt] END)*/' />
            </column>
            <column caption='LS Active customers MTD vs PMTD' datatype='string' name='[Dmart Active customers MTD vs PMTD (copy)_6234530059695845382]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*if&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Dmart Active customers PMTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Dmart Active customers PMTD])})&#10;)&#10;* 100&#10;,1)&#10;)*/&#10;&#10;&#10;if&#10;(&#10;    [Dmart Active customers MTD (copy)_6234530059695394821]&#10;    -&#10;    [Dmart Active customers PMTD (copy)_6234530059696160775]&#10;)&#10;/&#10;(&#10;[Dmart Active customers PMTD (copy)_6234530059696160775]&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    [Dmart Active customers MTD (copy)_6234530059695394821]&#10;    -&#10;    [Dmart Active customers PMTD (copy)_6234530059696160775]&#10;)&#10;/&#10;(&#10;[Dmart Active customers PMTD (copy)_6234530059696160775]&#10;)&#10;* 100&#10;,1)&#10;)' />
            </column>
            <column caption='LS Active customers MTD vs PMTD(Indicator)' datatype='string' name='[Dmart Active customers MTD vs PMTD(Indicator) (copy)_6234530059696803848]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*if&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Dmart Active customers PMTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;endif&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Dmart Active customers PMTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;*/&#10;&#10;if&#10;(&#10;    [Dmart Active customers MTD (copy)_6234530059695394821]&#10;    -&#10;    [Dmart Active customers PMTD (copy)_6234530059696160775]&#10;)&#10;/&#10;(&#10;[Dmart Active customers PMTD (copy)_6234530059696160775]&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='LS Active customers PMTD' datatype='integer' name='[Dmart Active customers PMTD (copy)_6234530059696160775]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY() - 1))&#10;AND DAY([date]) &lt;= DAY(TODAY()-1)&#10;THEN [ls_au_previous_month_cumulative_cum_distinct_cnt] END)&#10;/*&#10;MAX(IF DATETRUNC(&apos;month&apos;, [Date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY() - 1))&#10;AND DAY([Date]) &lt;= DAY(TODAY()-2)&#10;THEN [Dm Au Previous Month Cumulative Cum Distinct Cnt] END)*/' />
