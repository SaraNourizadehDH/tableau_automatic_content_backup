    <worksheet name='EU Exec: Session -wo TR'>
      <table>
        <view>
          <datasources>
            <datasource caption='EU daily kpis(pandata)' name='federated.1c51twp19tsd9o12b8pgw0t7rtgu' />
          </datasources>
          <datasource-dependencies datasource='federated.1c51twp19tsd9o12b8pgw0t7rtgu'>
            <column caption='One' datatype='integer' name='[Calculation_1127588798567391234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='L1W (session)' datatype='boolean' name='[L1W (copy)_508766051992145923]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_same_day_last_week (copy)_3533636887903768587]' />
            </column>
            <column caption='MTD (session)' datatype='boolean' name='[MTD (copy)_3533636887910658068]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() /*- 2*/-1) = 0&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()/*-2*/-1)' />
            </column>
            <column caption='MTD Session % (Negative)' datatype='string' name='[MTD NC % (Negative) (copy)_508766051996835852]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;    SUM(&#10;        iif([MTD (copy)_3533636887910658068], [sessions], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (copy)_3533636887910744085], [sessions], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (copy)_3533636887910744085], [sessions], 0)&#10;) &lt; 0&#10;THEN &apos;▼ &apos; ELSE null END&#10;&#10;+ &#10;if&#10;(&#10;    SUM(&#10;        iif([MTD (copy)_3533636887910658068], [sessions], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (copy)_3533636887910744085], [sessions], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (copy)_3533636887910744085], [sessions], 0)&#10;) &lt; 0&#10;then&#10;STR(&#10;ROUND(&#10;   (&#10;    SUM(&#10;        iif([MTD (copy)_3533636887910658068], [sessions], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (copy)_3533636887910744085], [sessions], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (copy)_3533636887910744085], [sessions], 0)&#10;)* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='MTD Session % (Positive)' datatype='string' name='[MTD NC % (Positive) (copy)_508766051996266507]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;    SUM(&#10;        iif([MTD (copy)_3533636887910658068], [sessions], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (copy)_3533636887910744085], [sessions], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (copy)_3533636887910744085], [sessions], 0)&#10;) &gt;= 0&#10;THEN &apos;▲ &apos; ELSE null END&#10;&#10;+ &#10;if&#10;(&#10;    SUM(&#10;        iif([MTD (copy)_3533636887910658068], [sessions], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (copy)_3533636887910744085], [sessions], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (copy)_3533636887910744085], [sessions], 0)&#10;) &gt;= 0&#10;then&#10;STR(&#10;ROUND(&#10;   (&#10;    SUM(&#10;        iif([MTD (copy)_3533636887910658068], [sessions], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (copy)_3533636887910744085], [sessions], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (copy)_3533636887910744085], [sessions], 0)&#10;)* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='PMTD (session)' datatype='boolean' name='[PMTD (copy)_3533636887910744085]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() /*- 2*/-1) = 1&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()/*-2*/-1)' />
            </column>
            <column caption='W1 Session % (Indicator)' datatype='string' name='[W1 NC % (Indicator) (copy)_508766051992653832]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [W1 NC % (Value Only) (copy)_508766051992297476] &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='W1 Session % (L1W)' datatype='integer' name='[W1 NC % (L1W) (copy)_508766051992039426]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date], [global_entity_id]:&#10;MAX(IF [L1W (copy)_508766051992145923]&#10;THEN ([sessions])&#10;ELSE 0&#10;END)&#10;}' />
            </column>
            <column caption='W1 Session % (Negative)' datatype='string' name='[W1 NC % (Negative) (copy)_508766051992596487]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([W1 NC % (Indicator) (copy)_508766051992653832] = &apos;▼&apos;, [W1 NC % (copy 2)_508766051992723465]+&apos;%&apos;, NULL)' />
            </column>
            <column caption='W1 Session % (Positive)' datatype='string' name='[W1 NC % (Positive) (copy)_508766051992522758]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([W1 NC % (Indicator) (copy)_508766051992653832] = &apos;▲&apos;, [W1 NC % (copy 2)_508766051992723465]+&apos;%&apos;, NULL)' />
            </column>
            <column caption='W1 Session % (Value Only)' datatype='real' name='[W1 NC % (Value Only) (copy)_508766051992297476]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND(&#10;(SUM([W1 NC % (Yesterday) (copy 2)_508766051991678976]) - SUM([W1 NC % (L1W) (copy)_508766051992039426])) / SUM([W1 NC % (L1W) (copy)_508766051992039426])&#10;//    SUM(IF [L1W] THEN [total_number_of_successful_orders] ELSE 0 END) / SUM(IF [Yesterday] THEN [total_number_of_successful_orders] ELSE 0 END)&#10;* 100, 2)' />
            </column>
            <column caption='W1 Session % (Yesterday)' datatype='integer' name='[W1 NC % (Yesterday) (copy 2)_508766051991678976]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date], [global_entity_id]:&#10;MAX(IF [Yesterday (copy)_508766051991859201]&#10;THEN ([sessions])&#10;ELSE 0&#10;END)&#10;}' />
            </column>
            <column caption='W1 Session %' datatype='string' name='[W1 NC % (copy 2)_508766051992723465]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[W1 NC % (Indicator) (copy)_508766051992653832]&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR([W1 NC % (Value Only) (copy)_508766051992297476])' />
            </column>
            <column caption='Yesterday (session)' datatype='boolean' name='[Yesterday (copy)_508766051991859201]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[is_yesterday (copy)_3533636887883218944]' />
            </column>
            <column caption='Yesterday&apos;s Session Main' datatype='integer' name='[Yesterday&apos;s Customers Main (copy)_508766051995951114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday (copy)_3533636887883218944], [sessions], null))' />
            </column>
            <column-instance column='[Calculation_1127588798567391234]' derivation='Avg' name='[avg:Calculation_1127588798567391234:qk]' pivot='key' type='quantitative' />
