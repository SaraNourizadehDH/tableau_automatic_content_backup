    <worksheet name='EU Active Customer MTD YoY Growth'>
      <table>
        <view>
          <datasources>
            <datasource caption='EU daily kpis(pandata)' name='federated.1c51twp19tsd9o12b8pgw0t7rtgu' />
          </datasources>
          <datasource-dependencies datasource='federated.1c51twp19tsd9o12b8pgw0t7rtgu'>
            <column caption='1 MTD YoY Growth' datatype='integer' name='[1 MTD Growth (copy)_25192057161117700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD YoY' />
              </aliases>
            </column>
            <column caption='Active customers MTD vs PYTD' datatype='string' name='[Active customers MTD vs PMTD (copy)_25192057165705225]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*if&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Active customers PYTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Active customers PYTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Active customers PYTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Active customers PYTD])})&#10;)&#10;* 100&#10;,1)&#10;)&#10;*/&#10;&#10;if&#10;(&#10;    [Existing customers MTD (copy)_1516798309607297053]&#10;    -&#10;    [Active customers PMTD (copy)_25192057165565960]&#10;)&#10;/&#10;(&#10;[Active customers PMTD (copy)_25192057165565960]&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    [Existing customers MTD (copy)_1516798309607297053]&#10;    -&#10;    [Active customers PMTD (copy)_25192057165565960]&#10;)&#10;/&#10;(&#10;[Active customers PMTD (copy)_25192057165565960]&#10;)&#10;* 100&#10;,1)&#10;)' />
            </column>
            <column caption='Active customers MTD vs PYTD (Indicator)' datatype='string' name='[Active customers MTD vs PMTD(Indicator) (copy)_25192057165856778]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*if&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Active customers PYTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Active customers PYTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;*/&#10;&#10;if&#10;(&#10;    [Existing customers MTD (copy)_1516798309607297053]&#10;    -&#10;    [Active customers PMTD (copy)_25192057165565960]&#10;)&#10;/&#10;(&#10;[Active customers PMTD (copy)_25192057165565960]&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='Active customers PYTD' datatype='integer' name='[Active customers PMTD (copy)_25192057165565960]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(IF &#10;DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, TODAY()))&#10;AND DAY([date]) &lt;= DAY(TODAY()-1)&#10;THEN [au_yoy_month_cumulative_cum_distinct_cnt] END)&#10;/*&#10;MAX(IF &#10;DATETRUNC(&apos;month&apos;, [Date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, TODAY()))&#10;AND DAY([Date]) &lt;= DAY(TODAY()-2)&#10;THEN [Au Yoy Month Cumulative Cum Distinct Cnt] END)*/' />
            </column>
            <column caption='is_today' datatype='boolean' name='[Calculation_1790180856673083392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date]=TODAY()&#10;//[Date]=TODAY() or [Date]=TODAY()-1' />
            </column>
            <column caption='Active customers MTD' datatype='integer' name='[Existing customers MTD (copy)_1516798309607297053]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(IF DAY(TODAY()) = 1 THEN [au_previous_month_cumulative_cum_distinct_cnt] ELSE&#10;[au_current_month_cumulative_cum_distinct_cnt] END)&#10;/*MAX(IF DAY(TODAY()) = 2 THEN [Au Previous Month Cumulative Cum Distinct Cnt] ELSE&#10;[Au Current Month Cumulative Cum Distinct Cnt] END)*/' />
            </column>
