            </column>
            <column caption='T7D New Customer Growth %' datatype='string' name='[T7D Existing Customer Growth % (copy)_6831890293076443164]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([T7D New Customer (copy)_6068811604559134726] - [T7D New Customer (Previous L7D) (copy)_6068811604559147015]) / [T7D New Customer (Previous L7D) (copy)_6068811604559147015] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(&#10;round(([T7D New Customer (copy)_6068811604559134726] - [T7D New Customer (Previous L7D) (copy)_6068811604559147015]) / [T7D New Customer (Previous L7D) (copy)_6068811604559147015]*100,1)&#10;)' />
