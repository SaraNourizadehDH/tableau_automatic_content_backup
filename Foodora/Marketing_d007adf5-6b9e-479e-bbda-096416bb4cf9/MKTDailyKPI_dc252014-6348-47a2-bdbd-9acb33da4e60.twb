            <column caption='is_today' datatype='boolean' name='[Calculation_1790180856673083392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date]=TODAY()&#10;//[Date]=TODAY() or [Date]=TODAY()-1' />
            </column>
            <column caption='L1W (acq)' datatype='boolean' name='[L1W (session) (copy)_6068811604566020113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_same_day_last_week (session) (copy)_6068811604557815812]' />
            </column>
            <column caption='MTD (acq)' datatype='boolean' name='[MTD (session) (copy)_6068811604558938117]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 0&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD (acq)' datatype='boolean' name='[PMTD (session) (copy)_6068811604559745032]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 1&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='W1 NC % (Positive)' datatype='string' name='[W1 NC % (Indicator) (copy)_1217660785847345155]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([W1 NC % (copy 4)] = &apos;▲&apos;, [W1 Order % (copy 3)]+&apos;%&apos;, NULL)' />
            </column>
            <column caption='W1 NC % (Negative)' datatype='string' name='[W1 NC % (Indicator) (copy)_1217660785847476228]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([W1 NC % (copy 4)] = &apos;▼&apos;, [W1 Order % (copy 3)]+&apos;%&apos;, NULL)' />
            </column>
            <column caption='MTD NC % (Negative)' datatype='string' name='[W1 NC % (Negative) (copy)_3082432499823038465]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;    SUM(&#10;        iif([MTD (session) (copy)_6068811604558938117], [acquisitions_daily], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (session) (copy)_6068811604559745032], [acquisitions_daily], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (session) (copy)_6068811604559745032], [acquisitions_daily], 0)&#10;) &lt; 0&#10;THEN &apos;▼ &apos; ELSE null END&#10;&#10;+ &#10;if&#10;(&#10;    SUM(&#10;        iif([MTD (session) (copy)_6068811604558938117], [acquisitions_daily], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (session) (copy)_6068811604559745032], [acquisitions_daily], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (session) (copy)_6068811604559745032], [acquisitions_daily], 0)&#10;) &lt; 0&#10;then&#10;STR(&#10;ROUND(&#10;   (&#10;    SUM(&#10;        iif([MTD (session) (copy)_6068811604558938117], [acquisitions_daily], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (session) (copy)_6068811604559745032], [acquisitions_daily], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (session) (copy)_6068811604559745032], [acquisitions_daily], 0)&#10;)* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='MTD NC % (Positive)' datatype='string' name='[W1 NC % (Positive) (copy)_3082432499822981120]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;    SUM(&#10;        iif([MTD (session) (copy)_6068811604558938117], [acquisitions_daily], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (session) (copy)_6068811604559745032], [acquisitions_daily], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (session) (copy)_6068811604559745032], [acquisitions_daily], 0)&#10;) &gt;= 0&#10;THEN &apos;▲ &apos; ELSE null END&#10;&#10;+ &#10;if&#10;(&#10;    SUM(&#10;        iif([MTD (session) (copy)_6068811604558938117], [acquisitions_daily], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (session) (copy)_6068811604559745032], [acquisitions_daily], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (session) (copy)_6068811604559745032], [acquisitions_daily], 0)&#10;) &gt;= 0&#10;then&#10;STR(&#10;ROUND(&#10;   (&#10;    SUM(&#10;        iif([MTD (session) (copy)_6068811604558938117], [acquisitions_daily], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (session) (copy)_6068811604559745032], [acquisitions_daily], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (session) (copy)_6068811604559745032], [acquisitions_daily], 0)&#10;)* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='W1 NC % (L1W)' datatype='integer' name='[W1 NC % (Yesterday) (copy)]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date], [global_entity_id]:&#10;MAX(IF [L1W (session) (copy)_6068811604566020113]&#10;THEN ([acquisitions_daily])&#10;ELSE 0&#10;END)&#10;}' />
            </column>
            <column caption='W1 NC % (Value Only)' datatype='real' name='[W1 NC % (copy 3)_1217660785846964225]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND(&#10;(SUM([W1 NC % (copy)]) - SUM([W1 NC % (Yesterday) (copy)])) / SUM([W1 NC % (Yesterday) (copy)])&#10;//    SUM(IF [L1W] THEN [total_number_of_successful_orders] ELSE 0 END) / SUM(IF [Yesterday] THEN [total_number_of_successful_orders] ELSE 0 END)&#10;* 100, 2)' />
            </column>
            <column caption='W1 NC % (Indicator)' datatype='string' name='[W1 NC % (copy 4)]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [W1 NC % (copy 3)_1217660785846964225] &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='W1 NC % (Yesterday)' datatype='integer' name='[W1 NC % (copy)]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date], [global_entity_id]:&#10;MAX(IF [Yesterday (session) (copy)_6068811604565917712]&#10;THEN ([acquisitions_daily])&#10;ELSE 0&#10;END)&#10;}' />
            </column>
            <column caption='W1 NC %' datatype='string' name='[W1 Order % (copy 3)]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[W1 NC % (copy 4)]&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR([W1 NC % (copy 3)_1217660785846964225])' />
            </column>
            <column caption='Yesterday (acq)' datatype='boolean' name='[Yesterday (session) (copy)_6068811604565917712]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[is_yesterday (session) (copy)_6068811604556115968]' />
            </column>
            <column caption='Yesterday&apos;s Customers Main' datatype='integer' name='[Yesterday&apos;s Orders Main (copy)_746893858204606487]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday (session) (copy)_6068811604556115968], [acquisitions_daily], null))' />
            </column>
            <column caption='Acquisitions Daily' datatype='integer' name='[acquisitions_daily]' role='measure' type='quantitative' />
