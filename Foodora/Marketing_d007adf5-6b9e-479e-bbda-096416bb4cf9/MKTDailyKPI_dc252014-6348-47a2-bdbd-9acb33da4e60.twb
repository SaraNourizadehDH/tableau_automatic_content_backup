              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD MoM' />
              </aliases>
            </column>
            <column caption='Existing Customer MTD vs PMTD (Indicator)' datatype='string' name='[Existing Customer MTD vs PMTD (copy)_128141504431255728]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*if&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Existing customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;*/&#10;&#10;if&#10;(&#10;    [Existing Customer MTD vs PMTD (copy)_6831890293033697283]&#10;    -&#10;    [Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;/&#10;(&#10;[Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='Existing customers MTD' datatype='integer' name='[Existing Customer MTD vs PMTD (copy)_6831890293033697283]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(IF DAY(TODAY()) = 1 THEN [eu_previous_month_cumulative_cum_distinct_cnt] ELSE&#10;[eu_current_month_cumulative_cum_distinct_cnt] END)&#10;/*&#10;MAX(IF DAY(TODAY()) = 2 THEN [Eu Previous Month Cumulative Cum Distinct Cnt] ELSE&#10;[Eu Current Month Cumulative Cum Distinct Cnt] END)*/' />
            </column>
            <column caption='Existing customers PMTD' datatype='integer' name='[Existing customers MTD (copy)_6831890293033889796]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) &#10;AND DAY([date]) &lt;= DAY(TODAY()-1)&#10;THEN [eu_previous_month_cumulative_cum_distinct_cnt] END)&#10;/*&#10;MAX(IF DATETRUNC(&apos;month&apos;, [Date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()-1)) &#10;AND DAY([Date]) &lt;= DAY(TODAY()-2)&#10;THEN [Eu Previous Month Cumulative Cum Distinct Cnt] END)*/' />
            </column>
            <column caption='Existing Customer MTD vs PMTD' datatype='string' name='[NC MTD vs PMTD (copy)_128141504430923951]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*if&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Existing customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Existing customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;* 100&#10;,1)&#10;)&#10;*/&#10;&#10;&#10;&#10;if&#10;(&#10;    [Existing Customer MTD vs PMTD (copy)_6831890293033697283]&#10;    -&#10;    [Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;/&#10;(&#10;[Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    [Existing Customer MTD vs PMTD (copy)_6831890293033697283]&#10;    -&#10;    [Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;/&#10;(&#10;[Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;* 100&#10;,1)&#10;)' />
            </column>
