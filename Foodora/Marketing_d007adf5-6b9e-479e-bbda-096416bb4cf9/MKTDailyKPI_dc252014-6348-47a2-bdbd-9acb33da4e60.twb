        <calculation class='tableau' formula='if&#10;([Yesterday&apos;s Orders Main (copy)_746893858204606487] - [L7D Orders Main (copy)_746893858204786712]) / iif([L7D Orders Main (copy)_746893858204786712] = 0, 1, [L7D Orders Main (copy)_746893858204786712]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s Orders Main (copy)_746893858204606487] - [L7D Orders Main (copy)_746893858204786712]) / iif([L7D Orders Main (copy)_746893858204786712] = 0, 1, [L7D Orders Main (copy)_746893858204786712]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s Orders Main (copy)_746893858204606487] - [L7D Orders Main (copy)_746893858204786712]) / iif([L7D Orders Main (copy)_746893858204786712] = 0, 1, [L7D Orders Main (copy)_746893858204786712]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
