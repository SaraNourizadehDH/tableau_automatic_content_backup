    <worksheet name='EU Exec: Existing Customers-wo TR'>
      <table>
        <view>
          <datasources>
            <datasource caption='EU daily kpis(pandata)' name='federated.1c51twp19tsd9o12b8pgw0t7rtgu' />
          </datasources>
          <datasource-dependencies datasource='federated.1c51twp19tsd9o12b8pgw0t7rtgu'>
            <column caption='One' datatype='integer' name='[Calculation_1127588798567391234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='is_today' datatype='boolean' name='[Calculation_1790180856673083392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date]=TODAY()&#10;//[Date]=TODAY() or [Date]=TODAY()-1' />
            </column>
            <column caption='L1W' datatype='boolean' name='[Calculation_6180416436320313347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_yesterday (copy)_6831890293028139010]' />
            </column>
            <column caption='is_yesterday' datatype='boolean' name='[Calculation_6831890293018333185]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date]= TODAY()-1' />
            </column>
            <column caption='Existing customers MTD' datatype='integer' name='[Existing Customer MTD vs PMTD (copy)_6831890293033697283]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(IF DAY(TODAY()) = 1 THEN [eu_previous_month_cumulative_cum_distinct_cnt] ELSE&#10;[eu_current_month_cumulative_cum_distinct_cnt] END)&#10;/*&#10;MAX(IF DAY(TODAY()) = 2 THEN [Eu Previous Month Cumulative Cum Distinct Cnt] ELSE&#10;[Eu Current Month Cumulative Cum Distinct Cnt] END)*/' />
            </column>
            <column caption='Existing customers PMTD' datatype='integer' name='[Existing customers MTD (copy)_6831890293033889796]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) &#10;AND DAY([date]) &lt;= DAY(TODAY()-1)&#10;THEN [eu_previous_month_cumulative_cum_distinct_cnt] END)&#10;/*&#10;MAX(IF DATETRUNC(&apos;month&apos;, [Date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()-1)) &#10;AND DAY([Date]) &lt;= DAY(TODAY()-2)&#10;THEN [Eu Previous Month Cumulative Cum Distinct Cnt] END)*/' />
            </column>
            <column caption='Yesterday' datatype='boolean' name='[L1W (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[Calculation_6831890293018333185]' />
            </column>
            <column caption='MTD EC % (Negative)' datatype='string' name='[MTD NC % (Negative) (copy)_3082432499828023300]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*IF (&#10;    (&#10;    SUM({FIXED [Global Entity Id]:([Existing customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;) &lt; 0&#10;THEN &apos;▼ &apos; ELSE null END&#10;&#10;+ &#10;if&#10;(&#10; (&#10;    SUM({FIXED [Global Entity Id]:([Existing customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;) &lt; 0&#10;then&#10;STR(&#10;ROUND(&#10;   (&#10; (&#10;    SUM({FIXED [Global Entity Id]:([Existing customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;)* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end*/&#10;&#10;IF (&#10;    (&#10;   [Existing Customer MTD vs PMTD (copy)_6831890293033697283]&#10;    -&#10;   [Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;/&#10;(&#10;[Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;) &lt; 0&#10;THEN &apos;▼ &apos; ELSE null END&#10;&#10;+ &#10;if&#10;(&#10; (&#10;    [Existing Customer MTD vs PMTD (copy)_6831890293033697283]&#10;    -&#10;    [Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;/&#10;(&#10;[Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;) &lt; 0&#10;then&#10;STR(&#10;ROUND(&#10;   (&#10; (&#10;    [Existing Customer MTD vs PMTD (copy)_6831890293033697283]&#10;    -&#10;    [Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;/&#10;(&#10;[Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;)* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='MTD EC % (Positive)' datatype='string' name='[MTD NC % (Positive) (copy)_3082432499828015107]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*IF (&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Existing customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;&#10;) &gt;= 0&#10;THEN &apos;▲ &apos; ELSE null END&#10;&#10;+ &#10;if&#10;(&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Existing customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;) &gt;= 0&#10;then&#10;STR(&#10;ROUND(&#10;   (&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Existing customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Existing customers PMTD])})&#10;)&#10;)* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end*/&#10;&#10;IF (&#10;(&#10;    [Existing Customer MTD vs PMTD (copy)_6831890293033697283]&#10;    -&#10;    [Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;/&#10;(&#10;[Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;&#10;) &gt;= 0&#10;THEN &apos;▲ &apos; ELSE null END&#10;&#10;+ &#10;if&#10;(&#10;(&#10;    [Existing Customer MTD vs PMTD (copy)_6831890293033697283]&#10;    -&#10;    [Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;/&#10;(&#10;[Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;) &gt;= 0&#10;then&#10;STR(&#10;ROUND(&#10;   (&#10;(&#10;    [Existing Customer MTD vs PMTD (copy)_6831890293033697283]&#10;    -&#10;    [Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;/&#10;(&#10;[Existing customers MTD (copy)_6831890293033889796]&#10;)&#10;)* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='W1 Existing Customer % (Positive)' datatype='string' name='[W1 Existing Customer % (Indicator) (copy)_1217660785852301321]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([W1 Existing Customer % (copy)_5401364108307439648] = &apos;▲&apos;, [W1 NC % (copy 6)_5401364108298797077]+&apos;%&apos;, NULL)' />
            </column>
            <column caption='W1 Existing Customer % (Negative)' datatype='string' name='[W1 Existing Customer % (Indicator) (copy)_1217660785852526602]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([W1 Existing Customer % (copy)_5401364108307439648] = &apos;▼&apos;, [W1 NC % (copy 6)_5401364108298797077]+&apos;%&apos;, NULL)' />
            </column>
            <column caption='W1 Existing Customer % (Value Only)' datatype='real' name='[W1 Existing Customer % (copy)_1217660785850576904]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND(&#10;(SUM([W1 NC % (Yesterday) (copy 3)_5401364108301066263]) - SUM([W1 NC % (L1W) (copy 3)_5401364108300984342])) / SUM([W1 NC % (L1W) (copy 3)_5401364108300984342])&#10;//    SUM(IF [L1W] THEN [total_number_of_successful_orders] ELSE 0 END) / SUM(IF [Yesterday] THEN [total_number_of_successful_orders] ELSE 0 END)&#10;* 100, 2)' />
            </column>
            <column caption='W1 Existing Customer % (Indicator)' datatype='string' name='[W1 Existing Customer % (copy)_5401364108307439648]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [W1 Existing Customer % (copy)_1217660785850576904] &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='W1 Existing % (L1W)' datatype='integer' name='[W1 NC % (L1W) (copy 3)_5401364108300984342]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date], [global_entity_id]:&#10;MAX(IF [Calculation_6180416436320313347]&#10;THEN ([eu_daily])&#10;ELSE 0&#10;END)&#10;}' />
            </column>
            <column caption='W1 Existing Customer % (Yesterday)' datatype='integer' name='[W1 NC % (Yesterday) (copy 3)_5401364108301066263]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date], [global_entity_id]:&#10;MAX(IF [L1W (copy 2)]&#10;THEN ([eu_daily])&#10;ELSE 0&#10;END)&#10;}' />
            </column>
            <column caption='W1 Existing Customer %' datatype='string' name='[W1 NC % (copy 6)_5401364108298797077]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[W1 Existing Customer % (copy)_5401364108307439648]&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR([W1 Existing Customer % (copy)_1217660785850576904])' />
            </column>
            <column caption='Yesterday&apos;s Existing Customers Main' datatype='integer' name='[Yesterday&apos;s Customers Main (copy)_746893858211110940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_6831890293018333185], [eu_daily], null))' />
