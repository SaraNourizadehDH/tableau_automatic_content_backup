        <calculation class='tableau' formula='/*DATEDIFF(&apos;month&apos;, [Date], today() - 1) = 1&#10;AND&#10;DAY([Date]) &lt;= DAY(TODAY()-1)*/&#10;&#10;DATEDIFF(&apos;month&apos;, [date], today() - 2) = 1&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-2)' />
