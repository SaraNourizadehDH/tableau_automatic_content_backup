    <worksheet name='EU Exec: Incentivised Order-WO TR'>
      <table>
        <view>
          <datasources>
            <datasource caption='EU daily kpis(pandata)' name='federated.1c51twp19tsd9o12b8pgw0t7rtgu' />
          </datasources>
          <datasource-dependencies datasource='federated.1c51twp19tsd9o12b8pgw0t7rtgu'>
            <column caption='% Incentivised Orders PMTD' datatype='real' name='[% Incentivised Orders MTD (copy)_6784813611310219272]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SUM(iif([PMTD (copy)_3533636887910744085],[incentivised_orders],0))&#10;/&#10;SUM(iif([PMTD (copy)_3533636887910744085],[orders],0))' />
            </column>
            <column caption='% Incentivised Orders MTD' datatype='real' name='[% Incentivised Orders MTD vs PMTD (copy)_6784813611305295879]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SUM(iif([MTD (copy)_3533636887910658068],[incentivised_orders],0))&#10;/&#10;SUM(iif([MTD (copy)_3533636887910658068],[orders],0))' />
            </column>
            <column caption='One' datatype='integer' name='[Calculation_1127588798567391234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='MTD (session)' datatype='boolean' name='[MTD (copy)_3533636887910658068]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() /*- 2*/-1) = 0&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()/*-2*/-1)' />
            </column>
            <column caption='MTD Incentivised Orders (Negative)' datatype='string' name='[MTD Session % (Negative) (copy)_582371763066531865]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([% Incentivised Orders MTD vs PMTD (copy)_6784813611305295879] - [% Incentivised Orders MTD (copy)_6784813611310219272]) &lt; 0&#10;THEN &apos;▼&apos; ELSE null END&#10;&#10;+ &#10;if&#10;([% Incentivised Orders MTD vs PMTD (copy)_6784813611305295879] - [% Incentivised Orders MTD (copy)_6784813611310219272]) &lt; 0&#10;then&#10;STR(&#10;ROUND(&#10;   ([% Incentivised Orders MTD vs PMTD (copy)_6784813611305295879] - [% Incentivised Orders MTD (copy)_6784813611310219272])* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='MTD Incentivised Orders% (Positive)' datatype='string' name='[MTD Session % (Positive) (copy)_582371763065303063]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([% Incentivised Orders MTD vs PMTD (copy)_6784813611305295879] - [% Incentivised Orders MTD (copy)_6784813611310219272]) &gt;= 0&#10;THEN &apos;▲&apos; ELSE null END&#10;&#10;+ &#10;if&#10;([% Incentivised Orders MTD vs PMTD (copy)_6784813611305295879] - [% Incentivised Orders MTD (copy)_6784813611310219272]) &gt;= 0&#10;then&#10;STR(&#10;ROUND(&#10;   ([% Incentivised Orders MTD vs PMTD (copy)_6784813611305295879] - [% Incentivised Orders MTD (copy)_6784813611310219272])* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='PMTD (session)' datatype='boolean' name='[PMTD (copy)_3533636887910744085]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() /*- 2*/-1) = 1&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()/*-2*/-1)' />
            </column>
            <column caption='W1 Incentivised Orders % (Indicator)' datatype='string' name='[W1 Session % (Indicator) (copy)_582371763061469197]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [W1 Session % (Value Only) (copy)_582371763061751825] &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='W1 Incentivised Order % (L1W)' datatype='real' name='[W1 Session % (L1W) (copy)_582371763062607893]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date], [global_entity_id]:&#10;SUM(IF [is_same_day_last_week (copy)_3533636887903768587] THEN [incentivised_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week (copy)_3533636887903768587] THEN [orders] ELSE 0 END)&#10;}' />
            </column>
            <column caption='W1 Incentivised Orders % (Negative)' datatype='string' name='[W1 Session % (Negative) (copy)_582371763061612559]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([W1 Session % (Indicator) (copy)_582371763061469197] = &apos;▼&apos;, [W1 Session % (copy)_582371763062108179]+&apos;%&apos;, NULL)' />
            </column>
            <column caption='W1 Incentivised Orders % (Positive)' datatype='string' name='[W1 Session % (Positive) (copy)_582371763061551118]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([W1 Session % (Indicator) (copy)_582371763061469197] = &apos;▲&apos;, [W1 Session % (copy)_582371763062108179]+&apos;%&apos;, NULL)' />
            </column>
            <column caption='W1 Incentivised Orders % (Value Only)' datatype='real' name='[W1 Session % (Value Only) (copy)_582371763061751825]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND(&#10;(SUM([W1 Session % (Yesterday) (copy)_582371763061817362]) - SUM([W1 Session % (L1W) (copy)_582371763062607893])) / SUM([W1 Session % (L1W) (copy)_582371763062607893])&#10;//    SUM(IF [L1W] THEN [total_number_of_successful_orders] ELSE 0 END) / SUM(IF [Yesterday] THEN [total_number_of_successful_orders] ELSE 0 END)&#10;* 100, 2)' />
            </column>
            <column caption='W1 Incentivised Orders % (Yesterday)' datatype='real' name='[W1 Session % (Yesterday) (copy)_582371763061817362]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date], [global_entity_id]:&#10;SUM(IF [is_yesterday (copy)_3533636887883218944] THEN [incentivised_orders] ELSE 0 END) / SUM(IF [is_yesterday (copy)_3533636887883218944] THEN [orders] ELSE 0 END)&#10;}' />
            </column>
            <column caption='W1 Incentivised Orders' datatype='string' name='[W1 Session % (copy)_582371763062108179]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[W1 Session % (Indicator) (copy)_582371763061469197]&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR([W1 Session % (Value Only) (copy)_582371763061751825])' />
            </column>
            <column caption='Yesterday&apos;s Incentivised Orders Main' datatype='real' name='[Yesterday&apos;s Session Main (copy)_582371763061133324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_yesterday (copy)_3533636887883218944], [incentivised_orders], null))/SUM(IIF([is_yesterday (copy)_3533636887883218944], [orders], null))' />
            </column>
            <column-instance column='[Calculation_1127588798567391234]' derivation='Avg' name='[avg:Calculation_1127588798567391234:qk]' pivot='key' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;DJ_CZ&quot;' value='Czech Republic' />
                <alias key='&quot;FO_NO&quot;' value='Norway' />
                <alias key='&quot;FP_SK&quot;' value='Slovakia' />
                <alias key='&quot;HN_DK&quot;' value='Denmark' />
                <alias key='&quot;MJM_AT&quot;' value='Austria' />
                <alias key='&quot;NP_HU&quot;' value='Hungary' />
                <alias key='&quot;OP_SE&quot;' value='Sweden' />
