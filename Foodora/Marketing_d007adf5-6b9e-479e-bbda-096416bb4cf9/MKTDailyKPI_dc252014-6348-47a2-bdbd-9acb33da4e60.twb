              <calculation class='tableau' formula='[date]=TODAY()&#10;//[Date]=TODAY() or [Date]=TODAY()-1' />
            </column>
            <column caption='L7D &amp; Previous L7D ' datatype='string' name='[Calculation_3021493178923221021]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='/*IF [Date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [Date] &lt;= NOW() - 1&#10;THEN &apos;L7D&apos;&#10;ELSEIF [Date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [Date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END*/&#10;&#10;IF [date] &gt; DATEADD(&apos;day&apos;, -9, NOW()) AND [date] &lt;= NOW() - 2&#10;THEN &apos;L7D&apos;&#10;ELSEIF [date] &gt;= DATEADD(&apos;day&apos;, -16, NOW()) AND [date] &lt;= DATEADD(&apos;day&apos;, -9, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END' />
            </column>
            <column caption='Day of Day (Similar Scale)' datatype='datetime' name='[Calculation_3021493178923642910]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='/*IF [Date] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [Date])&#10;ELSE [Date]&#10;END*/&#10;IF [date] &lt; DATEADD(&apos;day&apos;, -9, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [date])&#10;ELSE [date]&#10;END' />
            </column>
            <column caption='DayofWeek' datatype='string' name='[Calculation_3021493178926415903]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [date])' />
