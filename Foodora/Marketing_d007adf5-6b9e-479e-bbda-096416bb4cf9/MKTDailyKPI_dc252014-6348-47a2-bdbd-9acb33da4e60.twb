            <column caption='Previous T7D % Incentivised Orders' datatype='real' name='[Previous T7D Orders (copy)_2177068240308617239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([date]&gt;= now() - 15 and [date]&lt; now() - 8, [incentivised_orders], 0))&#10;&#10; / &#10;&#10;SUM(iif([date]&gt;= now() - 15 and [date]&lt; now() - 8, [orders], 0))' />
            </column>
            <column caption='T7D % Incentivised Order Delta (Indicator)' datatype='string' name='[T7D Growth % (Indicator) (copy)_2177068240305717270]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([T7D Orders (copy)_2177068240304259092] - [Previous T7D Orders (copy)_2177068240308617239])  &lt;= 0&#10;then &apos;▼&apos; &#10;ELSE &apos;▲&apos; &#10;end' />
            </column>
            <column caption='T7D % Incentivised Delta' datatype='string' name='[T7D Growth % (copy)_2177068240305692693]' role='measure' type='nominal'>
