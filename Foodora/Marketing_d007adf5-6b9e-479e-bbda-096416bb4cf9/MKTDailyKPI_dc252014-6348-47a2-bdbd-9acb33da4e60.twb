        <calculation class='tableau' formula='SUM(IIF([Calculation_6831890293018333185], [eu_food_daily], null))' />
      </column>
      <column caption='% of total existing Customers-rest' datatype='real' name='[Calculation_4039658521607192586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum({fixed [global_entity_id]: sum(iif([Calculation_6831890293018333185], [eu_food_daily], 0))})/&#10;sum({fixed [global_entity_id]: sum(iif([Calculation_6831890293018333185], [eu_daily], 0))})' />
      </column>
