      <column caption='MTD' datatype='boolean' hidden='true' name='[Calculation_4464052437740544014]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='/*DATEDIFF(&apos;month&apos;, [Date], today() - 1) = 0&#10;AND&#10;DAY([Date]) &lt;= DAY(TODAY()-1)*/&#10;&#10;DATEDIFF(&apos;month&apos;, [date], today() - 2) = 0&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-2)' />
