            </column>
            <column caption='T7D % Incentivised Orders' datatype='real' name='[T7D Orders (copy)_2177068240304259092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([date]&gt;= now() - 8, [incentivised_orders], 0))&#10;&#10; / &#10;&#10;SUM(iif([date]&gt;= now() - 8, [orders], 0))' />
