        <calculation class='tableau' formula='if&#10;([Yesterday&apos;s Orders Main (copy)_746893858204606487] - [L7D Orders Main (copy)_746893858204786712]) / [L7D Orders Main (copy)_746893858204786712] &lt;= 0&#10;or isnull(([Yesterday&apos;s Orders Main (copy)_746893858204606487] - [L7D Orders Main (copy)_746893858204786712]) / [L7D Orders Main (copy)_746893858204786712])&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s Orders Main (copy)_746893858204606487] - [L7D Orders Main (copy)_746893858204786712]) / [L7D Orders Main (copy)_746893858204786712] &lt;= 0&#10;or isnull(([Yesterday&apos;s Orders Main (copy)_746893858204606487] - [L7D Orders Main (copy)_746893858204786712]) / [L7D Orders Main (copy)_746893858204786712])&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s Orders Main (copy)_746893858204606487] - [L7D Orders Main (copy)_746893858204786712]) / [L7D Orders Main (copy)_746893858204786712] * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
