            <column caption='Au Daily' datatype='integer' name='[au_daily]' role='measure' type='quantitative' />
            <column caption='Au Previous Month Cumulative Cum Distinct Cnt' datatype='integer' name='[au_previous_month_cumulative_cum_distinct_cnt]' role='measure' type='quantitative' />
