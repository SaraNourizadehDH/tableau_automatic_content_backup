            <column caption='Active customers PMTD' datatype='integer' name='[Active customers MTD (copy)_1516798309607886878]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(IF &#10;DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#10;AND DAY([date]) &lt;= DAY(TODAY()-1)&#10;THEN [au_previous_month_cumulative_cum_distinct_cnt] END)&#10;/*&#10;MAX(IF &#10;DATETRUNC(&apos;month&apos;, [Date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#10;AND DAY([Date]) &lt;= DAY(TODAY()-2)&#10;THEN [Au Previous Month Cumulative Cum Distinct Cnt] END)*/' />
            </column>
            <column caption='One' datatype='integer' name='[Calculation_1127588798567391234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='is_today' datatype='boolean' name='[Calculation_1790180856673083392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date]=TODAY()&#10;//[Date]=TODAY() or [Date]=TODAY()-1' />
            </column>
            <column caption='L1W' datatype='boolean' name='[Calculation_6180416436320313347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_yesterday (copy)_6831890293028139010]' />
            </column>
            <column caption='is_yesterday' datatype='boolean' name='[Calculation_6831890293018333185]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date]= TODAY()-1' />
            </column>
            <column caption='Active customers MTD' datatype='integer' name='[Existing customers MTD (copy)_1516798309607297053]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(IF DAY(TODAY()) = 1 THEN [au_previous_month_cumulative_cum_distinct_cnt] ELSE&#10;[au_current_month_cumulative_cum_distinct_cnt] END)&#10;/*MAX(IF DAY(TODAY()) = 2 THEN [Au Previous Month Cumulative Cum Distinct Cnt] ELSE&#10;[Au Current Month Cumulative Cum Distinct Cnt] END)*/' />
            </column>
            <column caption='Yesterday' datatype='boolean' name='[L1W (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[Calculation_6831890293018333185]' />
            </column>
            <column caption='MTD AC % (Negative)' datatype='string' name='[MTD EC % (Negative) (copy)_3082432499832119302]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*IF (&#10;    (&#10;    SUM({FIXED [Global Entity Id]:([Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;) &lt; 0&#10;THEN &apos;▼ &apos; ELSE null END&#10;&#10;+ &#10;if&#10;(&#10; (&#10;    SUM({FIXED [Global Entity Id]:([Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;) &lt; 0&#10;then&#10;STR(&#10;ROUND(&#10;   (&#10; (&#10;    SUM({FIXED [Global Entity Id]:([Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;)* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end*/&#10;&#10;&#10;IF (&#10;    (&#10;    [Existing customers MTD (copy)_1516798309607297053]&#10;    -&#10;    [Active customers MTD (copy)_1516798309607886878]&#10;)&#10;/&#10;(&#10;[Active customers MTD (copy)_1516798309607886878]&#10;)&#10;) &lt; 0&#10;THEN &apos;▼ &apos; ELSE null END&#10;&#10;+ &#10;if&#10;(&#10; (&#10;    [Existing customers MTD (copy)_1516798309607297053]&#10;    -&#10;    [Active customers MTD (copy)_1516798309607886878]&#10;)&#10;/&#10;(&#10;[Active customers MTD (copy)_1516798309607886878]&#10;)&#10;) &lt; 0&#10;then&#10;STR(&#10;ROUND(&#10;   (&#10; (&#10;    [Existing customers MTD (copy)_1516798309607297053]&#10;    -&#10;    [Active customers MTD (copy)_1516798309607886878]&#10;)&#10;/&#10;(&#10;[Active customers MTD (copy)_1516798309607886878]&#10;)&#10;)* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='MTD AC % (Positive)' datatype='string' name='[MTD EC % (Positive) (copy)_3082432499831808005]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*IF (&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;&#10;) &gt;= 0&#10;THEN &apos;▲ &apos; ELSE null END&#10;&#10;+ &#10;if&#10;(&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;) &gt;= 0&#10;then&#10;STR(&#10;ROUND(&#10;   (&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;)* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end*/&#10;&#10;&#10;IF (&#10;(&#10;    SUM({FIXED [global_entity_id]:([Existing customers MTD (copy)_1516798309607297053])})&#10;    -&#10;    SUM({FIXED [global_entity_id]:([Active customers MTD (copy)_1516798309607886878])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [global_entity_id]:([Active customers MTD (copy)_1516798309607886878])})&#10;)&#10;&#10;) &gt;= 0&#10;THEN &apos;▲ &apos; ELSE null END&#10;&#10;+ &#10;if&#10;(&#10;(&#10;    [Existing customers MTD (copy)_1516798309607297053]&#10;    -&#10;    [Active customers MTD (copy)_1516798309607886878]&#10;)&#10;/&#10;(&#10;[Active customers MTD (copy)_1516798309607886878]&#10;)&#10;) &gt;= 0&#10;then&#10;STR(&#10;ROUND(&#10;   (&#10;(&#10;    [Existing customers MTD (copy)_1516798309607297053]&#10;    -&#10;    [Active customers MTD (copy)_1516798309607886878]&#10;)&#10;/&#10;(&#10;[Active customers MTD (copy)_1516798309607886878]&#10;)&#10;)* 100, 2))&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='W1 Active % (L1W)' datatype='integer' name='[W1 Existing % (L1W) (copy)_2570851729315123204]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date], [global_entity_id]:&#10;MAX(IF [Calculation_6180416436320313347]&#10;THEN ([au_daily])&#10;ELSE 0&#10;END)&#10;}' />
            </column>
            <column caption='W1 Active Customer % (Indicator)' datatype='string' name='[W1 Existing Customer % (Indicator) (copy)_2570851729315667977]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [W1 Existing Customer % (Value Only) (copy)_2570851729315033091] &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='W1 Active Customer % (Negative)' datatype='string' name='[W1 Existing Customer % (Negative) (copy)_2570851729315573768]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([W1 Existing Customer % (Indicator) (copy)_2570851729315667977] = &apos;▼&apos;, [W1 Existing Customer % (copy)_2570851729315512327]+&apos;%&apos;, NULL)' />
            </column>
            <column caption='W1 Active Customer % (Positive)' datatype='string' name='[W1 Existing Customer % (Positive) (copy)_2570851729315438598]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF([W1 Existing Customer % (Indicator) (copy)_2570851729315667977] = &apos;▲&apos;, [W1 Existing Customer % (copy)_2570851729315512327]+&apos;%&apos;, NULL)' />
            </column>
            <column caption='W1 Active Customer % (Value Only)' datatype='real' name='[W1 Existing Customer % (Value Only) (copy)_2570851729315033091]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND(&#10;(SUM([W1 Existing Customer % (Yesterday) (copy)_2570851729314963458]) - SUM([W1 Existing % (L1W) (copy)_2570851729315123204])) / SUM([W1 Existing % (L1W) (copy)_2570851729315123204])&#10;//    SUM(IF [L1W] THEN [total_number_of_successful_orders] ELSE 0 END) / SUM(IF [Yesterday] THEN [total_number_of_successful_orders] ELSE 0 END)&#10;* 100, 2)' />
            </column>
            <column caption='W1 Active Customer % (Yesterday)' datatype='integer' name='[W1 Existing Customer % (Yesterday) (copy)_2570851729314963458]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [date], [global_entity_id]:&#10;MAX(IF [L1W (copy 2)]&#10;THEN ([au_daily])&#10;ELSE 0&#10;END)&#10;}' />
            </column>
            <column caption='W1 Active Customer %' datatype='string' name='[W1 Existing Customer % (copy)_2570851729315512327]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[W1 Existing Customer % (Indicator) (copy)_2570851729315667977]&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR([W1 Existing Customer % (Value Only) (copy)_2570851729315033091])' />
            </column>
            <column caption='Yesterday&apos;s Active Customers Main' datatype='integer' name='[Yesterday&apos;s Existing Customers Main (copy)_2570851729314803713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_6831890293018333185], [au_daily], null))' />
            </column>
