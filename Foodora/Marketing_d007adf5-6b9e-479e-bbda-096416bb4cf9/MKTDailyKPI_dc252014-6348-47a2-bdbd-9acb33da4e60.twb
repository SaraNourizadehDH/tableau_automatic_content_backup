            </column>
            <column caption='T7D Session' datatype='integer' name='[T7D New Customer (copy)_3533636887909036049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([date] &gt;= now() /*- 9*/-8, [sessions], 0))' />
