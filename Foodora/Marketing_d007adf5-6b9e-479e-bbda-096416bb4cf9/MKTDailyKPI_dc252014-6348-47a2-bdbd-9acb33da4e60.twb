              </aliases>
            </column>
            <column caption='Color - Session Count LW Growth' datatype='string' name='[Color - New Customer Count LW Growth (copy)_3533636887903612938]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [is_yesterday (copy)_3533636887883218944] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_week (copy)_3533636887903768587] THEN [sessions] ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_week (copy)_3533636887903768587] THEN [sessions] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='Session Count LW Growth' datatype='string' name='[New Customer Count LW Growth (copy)_3533636887904256012]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [is_yesterday (copy)_3533636887883218944] THEN [sessions] ELSE 0 END) - SUM(IF [is_same_day_last_week (copy)_3533636887903768587] THEN [sessions]  ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_week (copy)_3533636887903768587] THEN [sessions]  ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND( &#10;   (SUM(IF [is_yesterday (copy)_3533636887883218944] THEN [sessions]  ELSE 0 END) - SUM(IF [is_same_day_last_week (copy)_3533636887903768587] THEN [sessions]  ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week (copy)_3533636887903768587] THEN [sessions]  ELSE 0 END)* 100, 1))' />
            </column>
