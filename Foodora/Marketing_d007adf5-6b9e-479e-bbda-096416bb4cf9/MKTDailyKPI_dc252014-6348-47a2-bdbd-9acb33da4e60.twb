      <column caption='CVR' datatype='real' name='[% Incentivised Order (copy)_6784813611336192011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([transaction])/sum([sessions])' />
      </column>
      <column caption='CVR per Day' datatype='real' name='[% Incentivised Order per Day (copy)_6784813611338391564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date], [global_entity_id]:&#10;sum([transaction])/sum([sessions])&#10;}' />
      </column>
      <column caption='CVR MTD' datatype='real' name='[% Incentivised Orders MTD (copy)_582371763051900936]' role='measure' type='ordinal'>
