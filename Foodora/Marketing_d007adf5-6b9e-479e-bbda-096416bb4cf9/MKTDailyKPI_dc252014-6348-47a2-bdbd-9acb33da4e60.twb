      <column caption='Active customers MTD vs PYTD' datatype='string' name='[Active customers MTD vs PMTD (copy)_25192057165705225]' role='measure' type='nominal'>
        <calculation class='tableau' formula='/*if&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Active customers PYTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Active customers PYTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Active customers PYTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Active customers PYTD])})&#10;)&#10;* 100&#10;,1)&#10;)&#10;*/&#10;&#10;if&#10;(&#10;    [Existing customers MTD (copy)_1516798309607297053]&#10;    -&#10;    [Active customers PMTD (copy)_25192057165565960]&#10;)&#10;/&#10;(&#10;[Active customers PMTD (copy)_25192057165565960]&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    [Existing customers MTD (copy)_1516798309607297053]&#10;    -&#10;    [Active customers PMTD (copy)_25192057165565960]&#10;)&#10;/&#10;(&#10;[Active customers PMTD (copy)_25192057165565960]&#10;)&#10;* 100&#10;,1)&#10;)' />
      </column>
      <column caption='Dmart Active customers MTD vs PMTD(Indicator)' datatype='string' name='[Active customers MTD vs PMTD(Indicator) (copy)_1836624252160745483]' role='measure' type='nominal'>
        <calculation class='tableau' formula='/*if&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Dmart Active customers PMTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;endif&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Dmart Active customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Dmart Active customers PMTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;*/&#10;&#10;if&#10;(&#10;    [Active customers MTD (copy)_1836624252160053256]&#10;    -&#10;    [Active customers PMTD (copy)_1836624252160229385]&#10;)&#10;/&#10;(&#10;[Active customers PMTD (copy)_1836624252160229385]&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='Active customers MTD vs PYTD (Indicator)' datatype='string' name='[Active customers MTD vs PMTD(Indicator) (copy)_25192057165856778]' role='measure' type='nominal'>
        <calculation class='tableau' formula='/*if&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Active customers PYTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Active customers PYTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;*/&#10;&#10;if&#10;(&#10;    [Existing customers MTD (copy)_1516798309607297053]&#10;    -&#10;    [Active customers PMTD (copy)_25192057165565960]&#10;)&#10;/&#10;(&#10;[Active customers PMTD (copy)_25192057165565960]&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='Active customers MTD vs PMTD' datatype='string' name='[Active customers PMTD (copy)_1516798309608013855]' role='measure' type='nominal'>
        <calculation class='tableau' formula='/*if&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    SUM({FIXED [Global Entity Id]:([Active customers MTD])})&#10;    -&#10;    SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;/&#10;(&#10;SUM({FIXED [Global Entity Id]:([Active customers PMTD])})&#10;)&#10;* 100&#10;,1)&#10;)&#10;*/&#10;&#10;if&#10;(&#10;    [Existing customers MTD (copy)_1516798309607297053]&#10;    -&#10;    [Active customers MTD (copy)_1516798309607886878]&#10;)&#10;/&#10;(&#10;[Active customers MTD (copy)_1516798309607886878]&#10;)&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(round(&#10;(&#10;    [Existing customers MTD (copy)_1516798309607297053]&#10;    -&#10;    [Active customers MTD (copy)_1516798309607886878]&#10;)&#10;/&#10;(&#10;[Active customers MTD (copy)_1516798309607886878]&#10;)&#10;* 100&#10;,1)&#10;)' />
      </column>
      <column caption='Dmart Active customers PMTD' datatype='integer' name='[Active customers PMTD (copy)_1836624252160229385]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX(IF DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY() - 1))&#10;AND DAY([date]) &lt;= DAY(TODAY()-1)&#10;THEN [dm_au_previous_month_cumulative_cum_distinct_cnt] END)&#10;/*&#10;MAX(IF DATETRUNC(&apos;month&apos;, [Date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY() - 1))&#10;AND DAY([Date]) &lt;= DAY(TODAY()-2)&#10;THEN [Dm Au Previous Month Cumulative Cum Distinct Cnt] END)*/' />
      </column>
      <column caption='Active customers PYTD' datatype='integer' name='[Active customers PMTD (copy)_25192057165565960]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX(IF &#10;DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, TODAY()))&#10;AND DAY([date]) &lt;= DAY(TODAY()-1)&#10;THEN [au_yoy_month_cumulative_cum_distinct_cnt] END)&#10;/*&#10;MAX(IF &#10;DATETRUNC(&apos;month&apos;, [Date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, TODAY()))&#10;AND DAY([Date]) &lt;= DAY(TODAY()-2)&#10;THEN [Au Yoy Month Cumulative Cum Distinct Cnt] END)*/' />
      </column>
      <column caption='CVR MTD vs PYTD (Indicator)' datatype='string' name='[CVR MTD vs PMTD (Indicator) (copy)_25192057174245401]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    [% Incentivised Orders MTD (copy)_582371763051900936] - [CVR PMTD (copy)_25192057174339610]&#10;)&#10;&#10; &lt;= 0&#10;then &apos;▼ &apos;&#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='CVR MTD vs PYTD' datatype='string' name='[CVR MTD vs PMTD (copy)_25192057174134808]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;&#10;    ([% Incentivised Orders MTD (copy)_582371763051900936] - [CVR PMTD (copy)_25192057174339610])&#10; &gt;= 0&#10;then &apos;▲ &apos;&#10;ELSE &apos;▼ &apos; &#10;end&#10;&#10;+&#10;&#10;str(round(([% Incentivised Orders MTD (copy)_582371763051900936] - [CVR PMTD (copy)_25192057174339610]) * 100,1))' />
      </column>
      <column caption='CVR PYTD' datatype='real' name='[CVR PMTD (copy)_25192057174339610]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM(iif([PMTD (session) (copy)_25192057172156439],[transaction],0))&#10;/&#10;SUM(iif([PMTD (session) (copy)_25192057172156439],[sessions],0))' />
      </column>
      <column caption='One' datatype='integer' name='[Calculation_1127588798567391234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='% of Orders Restaurant' datatype='real' hidden='true' name='[Calculation_1277403829522935824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_6831890293018333185] and [vendor_type]=&apos;restaurants&apos; then [subscription_orders] ELSE 0 END)&#10;/&#10;sum(IF [Calculation_6831890293018333185] then [subscription_orders] end)' />
      </column>
      <column caption='yesterday_restaurant' datatype='integer' hidden='true' name='[Calculation_1277403829525180433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_6831890293018333185] and [vendor_type]=&apos;restaurants&apos; then [subscription_orders] ELSE 0 END)' />
      </column>
      <column caption='Total Subscription Orders Per Day' datatype='integer' hidden='true' name='[Calculation_143552245680594945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date]:&#13;&#10;SUM([subscription_orders])&#13;&#10;}' />
      </column>
      <column caption='is_today' datatype='boolean' name='[Calculation_1790180856673083392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date]=TODAY()&#10;//[Date]=TODAY() or [Date]=TODAY()-1' />
      </column>
      <column caption='Order Count LW Growth Ranking' datatype='real' hidden='true' name='[Calculation_192669667481686020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND( &#10;   (SUM(IF [Calculation_6831890293018333185] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [subscription_orders] ELSE 0 END))&#10;   / SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [subscription_orders] ELSE 0 END)*100, 2)' />
      </column>
      <column caption='% Incentivised Order' datatype='real' name='[Calculation_2177068240250802176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([incentivised_orders])/sum([orders])' />
      </column>
      <column caption='% Incentivised Order per Day' datatype='real' name='[Calculation_2177068240253972482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date], [global_entity_id]:&#10;sum([incentivised_orders])/sum([orders])&#10;}' />
      </column>
      <column caption='DayOfWeek' datatype='string' hidden='true' name='[Calculation_2636153901957091335]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [date])' />
      </column>
      <column caption='L7D &amp; Previous L7D ' datatype='string' name='[Calculation_3021493178923221021]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='/*IF [Date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [Date] &lt;= NOW() - 1&#10;THEN &apos;L7D&apos;&#10;ELSEIF [Date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [Date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END*/&#10;&#10;IF [date] &gt; DATEADD(&apos;day&apos;, -9, NOW()) AND [date] &lt;= NOW() - 2&#10;THEN &apos;L7D&apos;&#10;ELSEIF [date] &gt;= DATEADD(&apos;day&apos;, -16, NOW()) AND [date] &lt;= DATEADD(&apos;day&apos;, -9, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END' />
      </column>
      <column caption='Day of Day (Similar Scale)' datatype='datetime' name='[Calculation_3021493178923642910]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='/*IF [Date] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [Date])&#10;ELSE [Date]&#10;END*/&#10;IF [date] &lt; DATEADD(&apos;day&apos;, -9, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [date])&#10;ELSE [date]&#10;END' />
      </column>
      <column caption='DayofWeek' datatype='string' name='[Calculation_3021493178926415903]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [date])' />
      </column>
      <column caption='Calculation1' datatype='integer' hidden='true' name='[Calculation_3082432499859144713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [global_entity_id]&lt;&gt;&apos;YS_TR&apos; THEN [acquisitions_daily] END' />
      </column>
      <column caption='iCPRev' datatype='real' hidden='true' name='[Calculation_323485152793522185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([original_total_foodpanda_incentive_spent])&#10;/ [Calculation_4293126730636328963]' />
      </column>
      <column caption='Total Incentivised Orders' datatype='integer' hidden='true' name='[Calculation_3364681569114148866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(total_incentivised_orders)' />
      </column>
      <column caption='Total Orders' datatype='integer' hidden='true' name='[Calculation_3364681569117351939]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_number_of_orders])' />
      </column>
      <column caption='W1 % Incentivised Order Ranking' datatype='real' hidden='true' name='[Calculation_3605694491936407553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [L1W (copy 2)] THEN [total_incentivised_orders] ELSE 0 END)/SUM(IF [L1W (copy 2)] THEN [total_number_of_orders] ELSE 0 END)&#10; - SUM(IF [Calculation_6180416436320313347] THEN [total_incentivised_orders] ELSE 0 END)/SUM(IF [Calculation_6180416436320313347] THEN [total_number_of_orders] ELSE 0 END)' />
      </column>
      <column caption='iCPO' datatype='real' hidden='true' name='[Calculation_3605694492004945934]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([original_total_foodpanda_incentive_spent])/sum([total_number_of_orders])' />
      </column>
      <column caption='iCPO per Day' datatype='real' hidden='true' name='[Calculation_3605694492006170639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date]:&#10;[Calculation_3605694492004945934]&#10;}' />
      </column>
      <column caption='iCPO L7D Average' datatype='real' hidden='true' name='[Calculation_3605694492008632336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_3605694492004945934],first(),first()+7)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='iCPO (Indicator - New)' datatype='integer' hidden='true' name='[Calculation_3605694492008857617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if isnull([Calculation_3605694492004945934]) then 0&#10;elseif (([Calculation_3605694492004945934] - [Calculation_3605694492008632336])/abs([Calculation_3605694492008632336]) &gt;= 0.1)&#10;then -2&#10;elseif ([Calculation_3605694492004945934] - [Calculation_3605694492008632336])/abs([Calculation_3605694492008632336]) &lt;= -0.1 &#10;then 2&#10;elseif (([Calculation_3605694492004945934] - [Calculation_3605694492008632336])/abs([Calculation_3605694492008632336]) &gt;= 0.05)&#10;then -1&#10;elseif ([Calculation_3605694492004945934] - [Calculation_3605694492008632336])/abs([Calculation_3605694492008632336]) &lt;= -0.05&#10;then 1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='W1 iCPO' datatype='string' hidden='true' name='[Calculation_3605694492040044562]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[W1 % Incentivised Order (Indicator) (copy)_3605694492047790099]&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR([W1 iCPO (copy)_1217660785867313172])' />
      </column>
      <column caption='existing customers' datatype='integer' hidden='true' name='[Calculation_4039658521532092418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[customer]-[acquisition]' />
      </column>
      <column caption='Existing Customer Count LW Growth' datatype='string' name='[Calculation_4039658521532805123]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM(IF [Calculation_6831890293018333185] THEN [eu_daily] ELSE 0 END) - SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [eu_daily]  ELSE 0 END))&#10;/ SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [eu_daily]  ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND( &#10;   (SUM(IF [Calculation_6831890293018333185] THEN [eu_daily]  ELSE 0 END) - SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [eu_daily]  ELSE 0 END))&#10;   / SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [eu_daily]  ELSE 0 END)* 100, 1))' />
      </column>
      <column caption='Color - Existing Customer Count LW Growth' datatype='string' name='[Calculation_4039658521533349892]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM(IF [Calculation_6831890293018333185] THEN [eu_daily] ELSE 0 END) - SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [eu_daily] ELSE 0 END))&#10;/ SUM(IF [is_yesterday (copy)_6831890293028139010] THEN [eu_daily] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
