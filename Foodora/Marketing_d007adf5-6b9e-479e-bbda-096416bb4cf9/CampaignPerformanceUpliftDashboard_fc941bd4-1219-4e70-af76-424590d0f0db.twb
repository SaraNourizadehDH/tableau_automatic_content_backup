SELECT cg_tg.*
FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_gi_campaign_deals_users_cg_tg_performance_by_pfm` AS cg_tg
-- FROM pandata_ap_mktg.regional_apac_mkt_gi_campaign_deals_users_cg_tg_performance_by_pfm_zh_v5 AS cg_tg
INNER JOIN cg_tg_measurable_campaign
        ON cg_tg.global_entity_id = cg_tg_measurable_campaign.global_entity_id
       AND cg_tg.campaign_name = cg_tg_measurable_campaign.campaign_name
       AND cg_tg.campaign_vertical = cg_tg_measurable_campaign.campaign_vertical
       AND cg_tg.start_date_local = cg_tg_measurable_campaign.start_date_local
