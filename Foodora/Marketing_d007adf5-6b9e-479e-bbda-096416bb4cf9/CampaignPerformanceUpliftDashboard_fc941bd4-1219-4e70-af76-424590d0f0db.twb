            <column caption='Campaign Voucher Redemptions Updated' datatype='integer' name='[Campaign Voucher Users Updated (copy)_3298816384126148614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF([variant] = &quot;Treatment&quot;) THEN [campaign_voucher_redemptions] ELSE 0 END' />
            </column>
            <column caption='User Cannibalization Rate' datatype='real' name='[User Cannabalization Rate (copy)_3298816384121171970]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF([Calculation_3298816384117530625] = &quot;User Cannibalization&quot;)&#10;THEN ROUND(1-([all_users_incremental_orders (copy)_4520839990245449728]/SUM([Campaign Voucher Cost Fp Eur Updated (copy)_3298816384122978307])), 1) END' />
            </column>
            <column caption='Order Cannibalization Bucket' datatype='string' name='[User Cannibalization Bucket (copy)_3298816384125669380]' role='measure' type='nominal'>
