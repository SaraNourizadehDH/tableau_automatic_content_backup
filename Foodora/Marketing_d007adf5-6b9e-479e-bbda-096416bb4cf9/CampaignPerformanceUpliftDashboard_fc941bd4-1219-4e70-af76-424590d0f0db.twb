    </datasource>
    <datasource caption='Vouchers Campaign CG TG Performance' inline='true' name='federated.09nx7zp1qfxvrh10upifq0ohys08' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0u85os01rzgpei1fbkcn31ns6ckt'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='hailey.cheong@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0u85os01rzgpei1fbkcn31ns6ckt' name='Custom SQL Query' type='text'>WITH cg_tg_measurable_campaign AS (
  SELECT
    global_entity_id,
    voucher_uuid,
    voucher_code,
    campaign_voucher_vertical,
    start_date_local,
    end_date_local,
    SUM(campaign_voucher_cost_fp_eur) AS total_campaign_cost_eur
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_campaign_users_cg_tg_performance`

  WHERE user_tag = &quot;all_users&quot;
  GROUP BY 1,2,3,4,5,6
  HAVING total_campaign_cost_eur &gt;&gt;= 200 OR total_campaign_cost_eur = 0
)

SELECT cg_tg.*
FROM `fulfillment-dwh-production.pandata_report.regional_apac_campaign_users_cg_tg_performance` AS cg_tg
INNER JOIN cg_tg_measurable_campaign
        ON cg_tg.global_entity_id = cg_tg_measurable_campaign.global_entity_id
       AND cg_tg.voucher_uuid = cg_tg_measurable_campaign.voucher_uuid
       AND cg_tg.voucher_code = cg_tg_measurable_campaign.voucher_code
       AND cg_tg.campaign_voucher_vertical = cg_tg_measurable_campaign.campaign_voucher_vertical
       AND cg_tg.start_date_local = cg_tg_measurable_campaign.start_date_local
       AND cg_tg.end_date_local = cg_tg_measurable_campaign.end_date_local
WHERE cg_tg.voucher_code IS NOT NULL
  AND cg_tg.global_entity_id IS NOT NULL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0u85os01rzgpei1fbkcn31ns6ckt' name='Custom SQL Query' type='text'>WITH cg_tg_measurable_campaign AS (
  SELECT
    global_entity_id,
    voucher_uuid,
    voucher_code,
    campaign_voucher_vertical,
    start_date_local,
    end_date_local,
    SUM(campaign_voucher_cost_fp_eur) AS total_campaign_cost_eur
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_campaign_users_cg_tg_performance`

  WHERE user_tag = &quot;all_users&quot;
  GROUP BY 1,2,3,4,5,6
  HAVING total_campaign_cost_eur &gt;&gt;= 200 OR total_campaign_cost_eur = 0
)

SELECT cg_tg.*
FROM `fulfillment-dwh-production.pandata_report.regional_apac_campaign_users_cg_tg_performance` AS cg_tg
INNER JOIN cg_tg_measurable_campaign
        ON cg_tg.global_entity_id = cg_tg_measurable_campaign.global_entity_id
       AND cg_tg.voucher_uuid = cg_tg_measurable_campaign.voucher_uuid
       AND cg_tg.voucher_code = cg_tg_measurable_campaign.voucher_code
       AND cg_tg.campaign_voucher_vertical = cg_tg_measurable_campaign.campaign_voucher_vertical
       AND cg_tg.start_date_local = cg_tg_measurable_campaign.start_date_local
       AND cg_tg.end_date_local = cg_tg_measurable_campaign.end_date_local
WHERE cg_tg.voucher_code IS NOT NULL
  AND cg_tg.global_entity_id IS NOT NULL</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
