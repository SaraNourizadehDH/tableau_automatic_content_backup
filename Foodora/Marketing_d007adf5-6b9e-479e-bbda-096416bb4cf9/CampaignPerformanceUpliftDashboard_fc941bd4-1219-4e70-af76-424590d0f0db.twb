    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definitions'>
      <repository-location derived-from='http://ip-172-31-0-201:8679/t/Foodora/workbooks/CampaignPerformanceUpliftDashboard/Definitions?rev=' id='Definitions' path='/t/Foodora/workbooks/CampaignPerformanceUpliftDashboard' revision='' site='Foodora' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11' underline='true'>General Metrics</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>NC users</run>
              <run fontcolor='#000000'> = Newcomer users</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>% Active users</run>
              <run fontcolor='#000000'> = No. of users who placed order / Total users</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>icpgmv </run>
              <run fontcolor='#000000'>= total Incentive cost /total gmv</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>flgpo </run>
              <run fontcolor='#000000'>= flgp / num orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>CG% active users </run>
              <run fontcolor='#000000'>= num active CG users/ num CG users</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>TG% active users </run>
              <run fontcolor='#000000'>= num active TG users/ num TG users</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11' underline='true'>Uplift metrics</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>% active users uplift </run>
              <run fontcolor='#000000'>= TG % active users - CG % active users</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>% active users orders uplift </run>
              <run fontcolor='#000000'>= active users Order Frequency TG / active users Order Frequency CG-1</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>% active users GMV uplift </run>
              <run fontcolor='#000000'>= gmv per active user TG / gmv per active user CG - 1</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>% active users net GMV uplift </run>
              <run fontcolor='#000000'>= net GMV per active user TG / net GMV per active user CG - 1</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>% active users FLGP uplift </run>
              <run fontcolor='#000000'>=  FLGP per active user TG / FLGP per active user CG - 1</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>% reactivated 30d users uplift </run>
              <run fontcolor='#000000'>= % reactivated users TG - % reactivated users CG</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11' underline='true'>Incremental metrics</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>Incremental Net GMV </run>
              <run fontcolor='#000000'>= ( all users TG Net GMV per user - all users CG Net GMV per user)  * total users TG plus other vouchers CG</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>Incremental FLGP </run>
              <run fontcolor='#000000'>= ( all users TG FLGP per user - all users CG FLGP per user)  * total users TG plus other vouchers CG</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>Incremental Orders  </run>
              <run fontcolor='#000000'>= ( all users TG Order Frequency per user - all users CG Order Frequency per user)  * total users TG plus other vouchers CG</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11' underline='true'>Campaign costs metrics</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>Eligible spend </run>
              <run fontcolor='#000000'>= incentive mktg cost where user is addressable (qualify for AB testing)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>Measurable spend </run>
              <run fontcolor='#000000'>= incentive cost that is part of AB testing and is measured / eligible spend</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11' underline='true'>ROI metrics</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>Long Term </run>
              <run fontcolor='#000000'>= snapshot data of 60 days from campaign start date</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>NET GMV ROI </run>
              <run fontcolor='#000000'>= Incremental Net GMV in Campaign Duration / Total Campaign Cost</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>NET EBITDA ROI (campaign level) </run>
              <run fontcolor='#000000'>= Incremental Net GMV in Campaign Duration / Incremental FLGP</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>NET EBITDA ROI (country/channel level) </run>
              <run fontcolor='#000000'>= Incremental Net GMV in Campaign Duration / abs(Incremental FLGP)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Cost per Inc. GMV </run>
              <run fontcolor='#000000' fontname='Tableau Light'>=  Total Campaign Cost / Incremental Net GMV in Campaign Duration</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Cost per Inc. Users </run>
              <run fontcolor='#000000' fontname='Tableau Light'>=  Total Campaign Cost / Incremental Net Users in Campaign Duration</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11' underline='true'>Statistical significance metrics</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>nGMV Uplift Stat Sig. </run>
              <run fontcolor='#000000'>= 1 represents statistically significant, 0 represents not statistically significant. (set at a confidence level of 90%)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>*note: statistical significance at campaign/voucher level may be insignificant, however specific PFM segments for these vouchers may be significant or vice versa</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone fixed-size='217' forceUpdate='true' h='7750' id='39' is-fixed='true' type-v2='text' w='97300' x='1800' y='2250'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='16'>Metric Definitions</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='4' />
            <format attr='background-color' value='#d70f64' />
          </zone-style>
        </zone>
      </zones>
