            <properties context=''>
              <relation connection='bigquery.1cu2e6d0p4cc1f14tzkzv0amlztm (copy)' name='Custom SQL Query' type='text'>WITH cg_tg_measurable_campaign AS (
  SELECT
    global_entity_id,
    voucher_uuid,
    voucher_code,
    campaign_voucher_vertical,
    start_date_local,
    end_date_local,
    pro_user_flag,
    user_pfm_segment,
    SUM(campaign_voucher_cost_fp_eur) AS total_campaign_cost_eur
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_campaign_users_cg_tg_performance_by_pfm`
  WHERE user_tag = &quot;all_users&quot;
  GROUP BY 1,2,3,4,5,6,7,8
  HAVING total_campaign_cost_eur &gt;&gt;= 20  OR total_campaign_cost_eur = 0
)

SELECT cg_tg.*
FROM `fulfillment-dwh-production.pandata_report.regional_apac_campaign_users_cg_tg_performance_by_pfm` AS cg_tg
INNER JOIN cg_tg_measurable_campaign
        ON cg_tg.global_entity_id = cg_tg_measurable_campaign.global_entity_id
       AND cg_tg.voucher_uuid = cg_tg_measurable_campaign.voucher_uuid
       AND cg_tg.voucher_code = cg_tg_measurable_campaign.voucher_code
       AND cg_tg.campaign_voucher_vertical = cg_tg_measurable_campaign.campaign_voucher_vertical
       AND cg_tg.start_date_local = cg_tg_measurable_campaign.start_date_local
       AND cg_tg.end_date_local = cg_tg_measurable_campaign.end_date_local
       AND cg_tg.user_pfm_segment = cg_tg_measurable_campaign.user_pfm_segment
       AND cg_tg.pro_user_flag = cg_tg_measurable_campaign.pro_user_flag
WHERE cg_tg.voucher_code IS NOT NULL</relation>
            </properties>
