      <column caption='TG % active users' datatype='real' name='[CG % active users (copy)_2462413469992402945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_active_users_tg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_tg] ELSE 0 END)' />
      </column>
      <column caption='all_users_incremental_gmv_eur' datatype='real' name='[Calculation_1237082591307956233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([active_users_gmv_eur_per_user_tg (copy)_345792016310370308]-[active_users_gmv_eur_per_user_cg (copy)_345792016310358019])*[Calculation_789889184240115712]' />
      </column>
      <column caption='iCPiGMV (i = incremental)' datatype='real' name='[Calculation_1237082591347228698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[incremental_orders (copy)_1237082591311376405]/[Calculation_1237082591307956233]' />
      </column>
      <column caption='Net GMV ROI' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2234489115388375040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_6178657236105826305]) = 0 THEN NULL ELSE [incremental_gmv_eur (copy)_1237082591308341258]/SUM([Calculation_6178657236105826305]) END' />
      </column>
      <column caption='CG % active users' datatype='real' name='[Calculation_2462413469992157184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_active_users_cg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_cg] ELSE 0 END)' />
      </column>
      <column caption='% active users uplift' datatype='real' name='[Calculation_2462413469998272526]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CG % active users (copy)_2462413469992402945]-[Calculation_2462413469992157184]' />
      </column>
      <column caption='nGMV Uplift Stat Sig.' datatype='integer' name='[Calculation_4342033009122799620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [net_gmv_stat_sig] = &quot;Yes&quot; THEN 1&#10;ELSE 0 End' />
      </column>
      <column caption='pfm segment' datatype='string' name='[Calculation_5838846552383123467]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [user_pfm_segment] = &quot;H Bloodsuckers&quot; THEN &quot;H Deal Hunters&quot; ELSE [user_pfm_segment] END' />
      </column>
      <column caption='Campaign Discount Cost Fp Eur Updated' datatype='real' name='[Calculation_6178657236105826305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF([variant] = &quot;Treatment&quot;) THEN [campaign_discount_cost_fp_eur] ELSE 0 END' />
      </column>
      <column caption='EBITDA ROI' datatype='real' name='[Calculation_786159676791009281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_6178657236105826305]) = 0 THEN NULL ELSE [incremental_gmv_eur (copy)_1237082591308341258]/[incremental_orders (copy)_1237082591311503382] END' />
      </column>
      <column caption='total_users_tg_plus_other_vouchers_cg' datatype='integer' name='[Calculation_789889184240115712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[num_users_tg (copy)_345792016311758861] + MAX([num_users_others])' />
