    <worksheet name='Voucher Campaign Incremental Uplift (TG vs. CG)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#499894'>&lt;Sheet Name&gt; </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='7'>Note </run>
            <run fontcolor='#000000' fontsize='7'><![CDATA[: Pls be cautious to use ROI metric for Campaign with very low spend (<=1000 eur)]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Vouchers Campaign CG TG Performance' name='federated.09nx7zp1qfxvrh10upifq0ohys08' />
          </datasources>
          <datasource-dependencies datasource='federated.09nx7zp1qfxvrh10upifq0ohys08'>
            <column caption='CG % nc users' datatype='real' name='[CG % active users (copy)_1972084112936443905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_platform_nc_users_cg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_cg] ELSE 0 END)' />
            </column>
            <column caption='TG % active users' datatype='real' name='[CG % active users (copy)_2462413469992402945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_active_users_tg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_tg] ELSE 0 END)' />
            </column>
            <column caption='TG % nc users' datatype='real' name='[CG % nc users (copy)_1972084112936742914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_platform_nc_users_tg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_tg] ELSE 0 END)' />
            </column>
            <column caption='CG % reactivated 30d users' datatype='real' name='[CG % nc users (copy)_1972084112937443332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_platform_reactivated_30d_users_cg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_cg] ELSE 0 END)' />
            </column>
            <column caption='all_users_incremental_gmv_eur' datatype='real' name='[Calculation_1237082591307956233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([active_users_gmv_eur_per_user_tg (copy)_345792016310370308]-[active_users_gmv_eur_per_user_cg (copy)_345792016310358019])*[Calculation_789889184240115712]' />
            </column>
            <column caption='iCPiGMV (i = incremental)' datatype='real' name='[Calculation_1237082591347228698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[incremental_orders (copy)_1237082591311376405]/[Calculation_1237082591307956233]' />
            </column>
            <column caption='Net GMV ROI' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2234489115388375040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_6178657236105826305]) = 0 THEN NULL ELSE [incremental_gmv_eur (copy)_1237082591308341258]/SUM([Calculation_6178657236105826305]) END' />
            </column>
            <column caption='CG % active users' datatype='real' name='[Calculation_2462413469992157184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_active_users_cg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_cg] ELSE 0 END)' />
            </column>
            <column caption='nGMV Uplift Stat Sig.' datatype='integer' name='[Calculation_4342033009102254080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [net_gmv_stat_sig] = &quot;Yes&quot; THEN 1&#10;ELSE 0 End' />
            </column>
            <column caption='Campaign Voucher Cost Fp Eur Updated' datatype='real' name='[Calculation_6178657236105826305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF([variant] = &quot;Treatment&quot;) THEN [campaign_voucher_cost_fp_eur] ELSE 0 END' />
            </column>
            <column caption='EBITDA ROI' datatype='real' name='[Calculation_786159676789940224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_6178657236105826305]) = 0 THEN NULL ELSE [incremental_gmv_eur (copy)_1237082591308341258]/[incremental_orders (copy)_1237082591311503382] END' />
            </column>
            <column caption='total_users_tg_plus_other_vouchers_cg' datatype='integer' name='[Calculation_789889184240115712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[num_users_tg (copy)_345792016311758861] + MAX([num_users_others])' />
            </column>
            <column caption='TG % reactivated 30d users' datatype='real' name='[TG % nc users (copy)_1972084112937459717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_platform_reactivated_30d_users_tg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_tg] ELSE 0 END)' />
            </column>
            <column caption='all_users_flgp_per_user_cg' datatype='real' name='[active_users_flgp_per_user_cg (copy)_345792016311259146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [flgp_eur_cg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_cg] ELSE 0 END)' />
            </column>
            <column caption='all_users_flgp_per_user_tg' datatype='real' name='[active_users_flgp_per_user_tg (copy)_345792016311267339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [flgp_eur_tg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_tg] ELSE 0 END)' />
            </column>
            <column caption='all_users_gmv_eur_per_user_cg' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[active_users_gmv_eur_per_user_cg (copy)_345792016310358019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [gmv_eur_cg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_cg] ELSE 0 END)' />
            </column>
            <column caption='all_users_gmv_eur_per_user_tg' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[active_users_gmv_eur_per_user_tg (copy)_345792016310370308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [gmv_eur_tg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_tg] ELSE 0 END)' />
            </column>
            <column caption='all_users_incentive_cost_per_user_cg' datatype='real' name='[active_users_incentive_cost_per_user_cg (copy)_345792016310755334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [incentive_cost_fp_marketing_eur_cg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_cg] ELSE 0 END)' />
