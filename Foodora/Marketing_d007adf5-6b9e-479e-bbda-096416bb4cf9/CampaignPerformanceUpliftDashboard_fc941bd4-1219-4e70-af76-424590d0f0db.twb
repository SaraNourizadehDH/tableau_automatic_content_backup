      <column caption='% total' datatype='real' name='[% cont. by wallet (copy)_2926354643192008712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_measurable_spend_eur])/SUM([total_measurable_spend_eur])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.19l3jvt1gs39ub13g4tza0mb8ggv].[sum:cg_addressable_spend_eur:qk]&quot;' value='eligible spend €' />
          <alias key='&quot;[federated.19l3jvt1gs39ub13g4tza0mb8ggv].[sum:incentive_cost_fp_marketing_eur:qk]&quot;' value='total incentive spend €' />
          <alias key='&quot;[federated.19l3jvt1gs39ub13g4tza0mb8ggv].[usr:Calculation_2774147059430207488:qk]&quot;' value='% eligible spend of total spend' />
          <alias key='&quot;[federated.19l3jvt1gs39ub13g4tza0mb8ggv].[usr:Calculation_2926354643189338116:qk]&quot;' value='% measurable spend of eligible spend' />
        </aliases>
      </column>
      <column caption='% addressable spend' datatype='real' name='[Calculation_2774147059430207488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cg_addressable_spend_eur])/SUM([incentive_cost_fp_marketing_eur])' />
      </column>
      <column caption='% remaining opportunity for measurable spend' datatype='real' name='[Calculation_2774147059434008577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF(1- [Calculation_2926354643189338116])&lt;0 THEN 0 ELSE (1- [Calculation_2926354643189338116]) END' />
      </column>
      <column caption='% measurable spend of addressable spend' datatype='real' name='[Calculation_2926354643189338116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF(SUM([total_measurable_spend_eur])/SUM([cg_addressable_spend_eur]))&gt;=1 THEN 1 ELSE (SUM([total_measurable_spend_eur])/SUM([cg_addressable_spend_eur])) END' />
      </column>
      <column caption='% cont. by voucher' datatype='real' name='[Calculation_2926354643191545861]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([voucher_measurable_spend_eur])/SUM([total_measurable_spend_eur])' />
      </column>
