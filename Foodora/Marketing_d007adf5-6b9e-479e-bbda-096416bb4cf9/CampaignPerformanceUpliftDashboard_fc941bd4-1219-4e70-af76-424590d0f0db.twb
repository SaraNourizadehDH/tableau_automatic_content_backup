      <column caption='Campaign Discount Redemptions Updated' datatype='integer' name='[Campaign Voucher Users Updated (copy)_3298816384126148614]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF(LOWER([variant]) != &quot;control&quot;) THEN [campaign_discount_redemptions] ELSE 0 END' />
