      <column caption='User Cannibalization Rate' datatype='real' name='[User Cannabalization Rate (copy)_3298816384121171970]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF([Calculation_3298816384117530625] = &quot;User Cannibalization&quot;)&#10;THEN ROUND(1-([all_users_incremental_orders (copy)_4520839990245449728]/SUM([Campaign Voucher Cost Fp Eur Updated (copy)_3298816384122978307])), 1) END' />
      </column>
