      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_2E085B7CDA6746688C25A3343A3AFE31'>
            <properties context=''>
              <relation connection='bigquery.1w097jm04c1n2u1g0nhxn181kpxg' name='Custom SQL Query' type='text'><![CDATA[SELECT *,
CASE WHEN DATE_DIFF(CURRENT_DATE(), report_month, MONTH) <<= 6 
     THEN TRUE ELSE FALSE END AS is_last_6_months,
CASE WHEN DATE_DIFF(CURRENT_DATE(), report_month, MONTH) <<= 9 
     THEN TRUE ELSE FALSE END AS is_last_9_months,
CASE WHEN cg_addressable_spend_eur >> 0 THEN TRUE ELSE FALSE END AS is_addressable
FROM fulfillment-dwh-production.pandata_report.regional_apac_mkt_gi_measurable_spend_channel_info]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
