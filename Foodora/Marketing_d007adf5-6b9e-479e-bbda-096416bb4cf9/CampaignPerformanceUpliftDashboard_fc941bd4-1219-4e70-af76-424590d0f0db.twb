            <column caption='all_users_incentive_cost_per_user_tg' datatype='real' name='[active_users_incentive_cost_per_user_tg (copy)_345792016310771719]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN incentive_cost_fp_marketing_eur_tg ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_tg] ELSE 0 END)' />
            </column>
            <column caption='all_users_orders_per_user_cg' datatype='real' name='[active_users_orders_per_user_cg (copy)_345792016310063105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_orders_cg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_cg] ELSE 0 END)' />
            </column>
            <column caption='all_users_orders_per_user_tg' datatype='real' name='[active_users_orders_per_user_tg (copy)_345792016309673984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_orders_tg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_tg] ELSE 0 END)' />
            </column>
            <column caption='all_users_incremental_users' datatype='real' name='[all_users_incremental_orders (copy)_4520839990245449728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([CG % active users (copy)_2462413469992402945]-[Calculation_2462413469992157184])*[Calculation_789889184240115712]' />
            </column>
            <column caption='all_users_nc_incremental_users' datatype='real' name='[all_users_incremental_users (copy)_1972084112940126218]' role='measure' type='quantitative'>
