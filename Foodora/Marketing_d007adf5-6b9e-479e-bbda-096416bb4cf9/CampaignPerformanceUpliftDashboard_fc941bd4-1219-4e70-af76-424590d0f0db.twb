    <worksheet name='Discounts Campaign Performance Tab'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#499894'>Overall Performance</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Discounts Campaign Performance' name='federated.0g99q8q11yldcs1aistg30pvmxcu' />
          </datasources>
          <datasource-dependencies datasource='federated.0g99q8q11yldcs1aistg30pvmxcu'>
            <column caption='campaign discount cost fp (eur)' datatype='real' name='[campaign_discount_cost_fp_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[campaign_discount_flgp_eur]' role='measure' type='quantitative' />
            <column caption='campaign discount gmv (eur)' datatype='real' name='[campaign_discount_gmv_eur]' role='measure' type='quantitative' />
            <column caption='campaign discount gmv net (eur)' datatype='real' name='[campaign_discount_gmv_net_eur]' role='measure' type='quantitative' />
            <column caption='campaign discount redemptions' datatype='integer' name='[campaign_discount_redemptions]' role='measure' type='quantitative' />
            <column caption='campaign discount vertical' datatype='string' name='[campaign_discount_vertical]' role='dimension' type='nominal' />
            <column caption='end date local' datatype='date' name='[campaign_end_date_local]' role='dimension' type='ordinal' />
            <column caption='campaign name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column caption='start date local' datatype='date' name='[campaign_start_date_local]' role='dimension' type='ordinal' />
            <column caption='start month local' datatype='string' name='[campaign_start_month_local]' role='dimension' type='nominal' />
