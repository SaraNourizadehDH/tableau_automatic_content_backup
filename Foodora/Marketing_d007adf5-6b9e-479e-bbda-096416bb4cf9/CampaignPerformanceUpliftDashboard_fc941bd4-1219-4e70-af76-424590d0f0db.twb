      <column caption='Campaign Voucher Users Updated' datatype='integer' name='[Campaign Voucher Cost Fp Eur Updated (copy)_3298816384122978307 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF([variant] = &quot;Treatment&quot;) THEN [campaign_discount_users] ELSE 0 END' />
      </column>
      <column caption='Campaign Discount Users Updated' datatype='integer' name='[Campaign Voucher Cost Fp Eur Updated (copy)_3298816384122978307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF([variant] = &quot;Treatment&quot;) THEN [campaign_discount_users] ELSE 0 END' />
