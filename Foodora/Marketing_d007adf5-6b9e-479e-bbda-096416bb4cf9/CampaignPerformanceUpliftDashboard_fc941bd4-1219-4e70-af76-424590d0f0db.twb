      <table>
        <view>
          <datasources>
            <datasource caption='Vouchers Campaign CG TG Performance' name='federated.09nx7zp1qfxvrh10upifq0ohys08' />
          </datasources>
          <datasource-dependencies datasource='federated.09nx7zp1qfxvrh10upifq0ohys08'>
            <column caption='% reactivated 30d users uplift' datatype='real' name='[% nc users uplift (copy)_1972084112937472006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[TG % nc users (copy)_1972084112937459717]-[CG % nc users (copy)_1972084112937443332]' />
            </column>
            <column caption='TG % active users' datatype='real' name='[CG % active users (copy)_2462413469992402945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_active_users_tg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_tg] ELSE 0 END)' />
            </column>
            <column caption='CG % reactivated 30d users' datatype='real' name='[CG % nc users (copy)_1972084112937443332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_platform_reactivated_30d_users_cg] ELSE 0 END)/&#10;SUM(IF [user_tag] = &quot;all_users&quot; THEN [num_users_cg] ELSE 0 END)' />
