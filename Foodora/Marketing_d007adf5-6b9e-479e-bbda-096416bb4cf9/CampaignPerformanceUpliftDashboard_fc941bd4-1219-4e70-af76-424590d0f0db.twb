      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Aggregated Performance' id='_2830D481F4CB4C51BAE5F438CCD2CBCE'>
            <properties context=''>
              <relation connection='bigquery.1ieyggi04lvnwq14e5jlz15evim5' name='Custom SQL Query' type='text'><![CDATA[SELECT *, 
  CASE WHEN DATE_DIFF(CURRENT_DATE(), report_month, MONTH) <<= 6 THEN TRUE ELSE FALSE END AS is_last_6_months,
  CASE WHEN DATE_DIFF(CURRENT_DATE(), report_month, MONTH) <<= 9 THEN TRUE ELSE FALSE END AS is_last_9_months
FROM fulfillment-dwh-production.pandata_report.regional_apac_mkt_gi_campaign_cg_tg_aggregated_performance
