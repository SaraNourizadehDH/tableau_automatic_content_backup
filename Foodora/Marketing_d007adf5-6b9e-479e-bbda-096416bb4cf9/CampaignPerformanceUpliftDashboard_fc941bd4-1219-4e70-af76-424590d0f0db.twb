        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1cu2e6d0p4cc1f14tzkzv0amlztm (copy)' name='Custom SQL Query' type='text'>WITH cg_tg_measurable_campaign AS (
  SELECT
    global_entity_id,
    voucher_uuid,
    voucher_code,
    campaign_voucher_vertical,
    start_date_local,
    end_date_local,
    pro_user_flag,
    user_pfm_segment,
    SUM(campaign_voucher_cost_fp_eur) AS total_campaign_cost_eur
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_campaign_users_cg_tg_performance_by_pfm`
  WHERE user_tag = &quot;all_users&quot;
  GROUP BY 1,2,3,4,5,6,7,8
  HAVING total_campaign_cost_eur &gt;&gt;= 20  OR total_campaign_cost_eur = 0
)

