        <objects>
          <object caption='Discounts Campaign Performance' id='_6D6FC7240D76441AAF45C3F05BA95DE1'>
            <properties context=''>
              <relation connection='bigquery.0irzrrb05f53h115emujd05824bw' name='Custom SQL Query' type='text'>WITH discount_campaigns AS (
  SELECT
    global_entity_id,
    campaign_name,
    campaign_discount_vertical,
    campaign_start_date_local,
    campaign_end_date_local,
    SUM(campaign_discount_cost_fp_eur) AS total_campaign_cost_eur
  FROM fulfillment-dwh-production.pandata_report.regional_apac_mkt_gi_campaign_deals_performance_metrics
  -- FROM pandata_ap_mktg.regional_apac_mkt_gi_campaign_deals_performance_metrics_zh_v5
  GROUP BY 1,2,3,4,5
  HAVING total_campaign_cost_eur &gt;&gt;= 200 OR total_campaign_cost_eur = 0
)

SELECT discounts_full.*
FROM fulfillment-dwh-production.pandata_report.regional_apac_mkt_gi_campaign_deals_performance_metrics AS discounts_full
-- FROM pandata_ap_mktg.regional_apac_mkt_gi_campaign_deals_performance_metrics_zh_v5 AS discounts_full
INNER JOIN discount_campaigns
        ON discounts_full.global_entity_id = discount_campaigns.global_entity_id
       AND discounts_full.campaign_name = discount_campaigns.campaign_name
       AND discounts_full.campaign_discount_vertical = discount_campaigns.campaign_discount_vertical
       AND discounts_full.campaign_start_date_local = discount_campaigns.campaign_start_date_local
       AND discounts_full.campaign_end_date_local = discount_campaigns.campaign_end_date_local
WHERE discounts_full.campaign_name IS NOT NULL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
