        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1tklbm31ihl3ab19lb6k908jbpp8' name='Custom SQL Query' type='text'>WITH voucher_campaigns AS (
  SELECT
    global_entity_id,
    voucher_uuid,
    voucher_code,
    campaign_voucher_vertical,
    start_date_local,
    end_date_local,
    SUM(campaign_voucher_cost_fp_eur) AS total_campaign_cost_eur
  FROM fulfillment-dwh-production.pandata_report.regional_apac_campaign_performance_metrics
  WHERE global_entity_id IS NOT NULL
  GROUP BY 1,2,3,4,5,6
  HAVING total_campaign_cost_eur &gt;&gt;= 200 OR total_campaign_cost_eur = 0
)

SELECT vouchers_full.*
FROM fulfillment-dwh-production.pandata_report.regional_apac_campaign_performance_metrics AS vouchers_full
INNER JOIN voucher_campaigns
        ON vouchers_full.global_entity_id = voucher_campaigns.global_entity_id
       AND vouchers_full.voucher_uuid = voucher_campaigns.voucher_uuid
       AND vouchers_full.voucher_code = voucher_campaigns.voucher_code
       AND vouchers_full.campaign_voucher_vertical = voucher_campaigns.campaign_voucher_vertical
       AND vouchers_full.start_date_local = voucher_campaigns.start_date_local
       AND vouchers_full.end_date_local = voucher_campaigns.end_date_local
WHERE vouchers_full.voucher_code IS NOT NULL
  AND vouchers_full.global_entity_id IS NOT NULL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
