      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='PFM Discounts Campaign CG TG Performance' id='_DEA1F95564A24E4FBA7104D8A82B76F0'>
            <properties context=''>
              <relation connection='bigquery.1jqyt3i0vjol0517kbxa90hjz2l2' name='Custom SQL Query' type='text'>WITH cg_tg_measurable_campaign AS (
  SELECT
    global_entity_id,
    campaign_name,
    campaign_vertical,
    start_date_local,
    end_date_local,
    pro_user_flag,
    user_pfm_segment,
    SUM(campaign_discount_cost_fp_eur) AS total_campaign_cost_eur
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_gi_campaign_deals_users_cg_tg_performance_by_pfm`
  -- FROM pandata_ap_mktg.regional_apac_mkt_gi_campaign_deals_users_cg_tg_performance_by_pfm_zh_v5
  WHERE user_tag = &quot;all_users&quot;
  GROUP BY 1,2,3,4,5,6,7
  HAVING total_campaign_cost_eur &gt;&gt;= 20 OR total_campaign_cost_eur = 0
)

SELECT cg_tg.*
FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_gi_campaign_deals_users_cg_tg_performance_by_pfm` AS cg_tg
-- FROM pandata_ap_mktg.regional_apac_mkt_gi_campaign_deals_users_cg_tg_performance_by_pfm_zh_v5 AS cg_tg
INNER JOIN cg_tg_measurable_campaign
        ON cg_tg.global_entity_id = cg_tg_measurable_campaign.global_entity_id
       AND cg_tg.campaign_name = cg_tg_measurable_campaign.campaign_name
       AND cg_tg.campaign_vertical = cg_tg_measurable_campaign.campaign_vertical
       AND cg_tg.start_date_local = cg_tg_measurable_campaign.start_date_local
       AND cg_tg.end_date_local = cg_tg_measurable_campaign.end_date_local
       AND cg_tg.user_pfm_segment = cg_tg_measurable_campaign.user_pfm_segment
       AND cg_tg.pro_user_flag = cg_tg_measurable_campaign.pro_user_flag
WHERE cg_tg.campaign_name IS NOT NULL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
