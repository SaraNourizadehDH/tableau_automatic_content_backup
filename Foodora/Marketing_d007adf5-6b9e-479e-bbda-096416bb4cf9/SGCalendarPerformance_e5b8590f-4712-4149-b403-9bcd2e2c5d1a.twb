      <aliases enabled='yes' />
      <column caption='Dynamic Columns' datatype='real' name='[Calculation_3939383083897729041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(MONTH([month]))%(12/[Parameters].[Parameter 1])' />
      </column>
      <column caption='Dynamic Rows' datatype='integer' name='[Calculation_3939383083897872402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF AVG(MONTH([month]))&lt;=12/[Parameters].[Parameter 1] THEN 1&#10;&#10;ELSEIF AVG(MONTH([month]))&gt;12/[Parameters].[Parameter 1] AND AVG(MONTH([month]))&lt;=12/[Parameters].[Parameter 1]*2 THEN 2&#10;&#10;ELSEIF AVG(MONTH([month]))&gt;12/[Parameters].[Parameter 1] AND AVG(MONTH([month]))&lt;=12/[Parameters].[Parameter 1]*3 THEN 3&#10;&#10;ELSEIF AVG(MONTH([month]))&gt;12/[Parameters].[Parameter 1] THEN [Parameters].[Parameter 1] END' />
      </column>
      <column caption='Month Label' datatype='real' name='[Calculation_3939383083898806295]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-0.8' />
      </column>
      <column caption='Month Name' datatype='string' name='[Calculation_3939383083899015192]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER(DATENAME(&apos;month&apos;,[month]))' />
      </column>
      <column caption='Week Index' datatype='real' name='[Calculation_3939383083899600921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(DATEPART(&apos;week&apos;, [month]) - {FIXED DATEPART(&apos;month&apos;,[month]): MIN(DATEPART(&apos;week&apos;, [month]))})' />
      </column>
      <column caption='Orders' datatype='real' name='[Calculation_3939383083902775329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &apos;Restaurants&apos; THEN [total_resto_orders]&#10;WHEN &apos;Pickup&apos; THEN [total_pu_orders]&#10;WHEN &apos;Dmart&apos; THEN [total_dmart_orders]&#10;WHEN &apos;Shops&apos; THEN [total_shops_orders]&#10;&#10;END' />
      </column>
      <column caption='Sessions' datatype='real' name='[Calculation_3939383083905523747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &apos;Restaurants&apos; THEN [resto_sessions]&#10;WHEN &apos;Pickup&apos; THEN [pu_sessions]&#10;WHEN &apos;Dmart&apos; THEN [dmart_sessions]&#10;WHEN &apos;Shops&apos; THEN [shops_sessions]&#10;&#10;END' />
      </column>
      <column caption='Incentives' datatype='real' name='[Calculation_3939383083905597476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &apos;Restaurants&apos; THEN [total_resto_incentives]&#10;WHEN &apos;Pickup&apos; THEN [total_pu_incentives]&#10;WHEN &apos;Dmart&apos; THEN [total_dmart_incentives]&#10;WHEN &apos;Shops&apos; THEN [total_shops_incentives]&#10;&#10;END' />
      </column>
      <column caption='Selected Metric' datatype='real' name='[Calculation_3939383083905658917]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;&#10;WHEN &apos;Sessions&apos; THEN SUM([Calculation_3939383083905523747])&#10;WHEN &apos;Orders&apos; THEN SUM([Calculation_3939383083902775329])&#10;WHEN &apos;Incentives&apos; THEN SUM([Calculation_3939383083905597476])&#10;WHEN &apos;AFV&apos; THEN SUM([Orders (copy)_3939383083910144038])&#10;&#10;END' />
      </column>
      <column caption='AFV' datatype='real' name='[Orders (copy)_3939383083910144038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &apos;Restaurants&apos; THEN ROUND([total_resto_afv], 2)&#10;WHEN &apos;Pickup&apos; THEN ROUND([total_pu_afv], 2)&#10;WHEN &apos;Dmart&apos; THEN ROUND([total_dmart_afv], 2)&#10;WHEN &apos;Shops&apos; THEN ROUND([total_shops_afv], 2)&#10;&#10;END' />
      </column>
      <column datatype='integer' name='[Weekdays]' role='dimension' type='ordinal' user:agg-type='Weekday' user:base-field='month' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;, [month])' />
      </column>
