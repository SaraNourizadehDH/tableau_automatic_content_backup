  <worksheets>
    <worksheet name='Calendar View'>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily Calendar View' name='federated.1453vi80qdbv451eaywgg08i1mwp' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Number of Rows' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
            </column>
            <column caption='Vertical' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Pickup&quot;'>
              <calculation class='tableau' formula='&quot;Pickup&quot;' />
            </column>
            <column caption='Metric' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;AFV&quot;'>
              <calculation class='tableau' formula='&quot;AFV&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1453vi80qdbv451eaywgg08i1mwp'>
            <column caption='Dynamic Rows' datatype='integer' name='[Calculation_3939383083586973696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF AVG(MONTH([date]))&lt;=12/[Parameters].[Parameter 1] THEN 1&#10;&#10;ELSEIF AVG(MONTH([date]))&gt;12/[Parameters].[Parameter 1] AND AVG(MONTH([date]))&lt;=12/[Parameters].[Parameter 1]*2 THEN 2&#10;&#10;ELSEIF AVG(MONTH([date]))&gt;12/[Parameters].[Parameter 1] AND AVG(MONTH([date]))&lt;=12/[Parameters].[Parameter 1]*3 THEN 3&#10;&#10;ELSEIF AVG(MONTH([date]))&gt;12/[Parameters].[Parameter 1] THEN [Parameters].[Parameter 1] END' />
            </column>
            <column caption='Dynamic Columns' datatype='real' name='[Calculation_3939383083587112961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(MONTH([date]))%(12/[Parameters].[Parameter 1])' />
            </column>
            <column caption='Week Index' datatype='real' name='[Calculation_3939383083587411970]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(DATEPART(&apos;week&apos;, [date]) - {FIXED DATEPART(&apos;month&apos;,[date]): MIN(DATEPART(&apos;week&apos;, [date]))})' />
            </column>
            <column caption='Month Name' datatype='string' name='[Calculation_3939383083587731459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER(DATENAME(&apos;month&apos;,[date]))' />
            </column>
            <column caption='Month Label' datatype='real' name='[Calculation_3939383083587825668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF[Weekdays] = 4 THEN -1.5 END' />
            </column>
            <column caption='Sessions' datatype='integer' name='[Calculation_3939383083621650437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &apos;Restaurants&apos; THEN [resto_sessions]&#10;WHEN &apos;Pickup&apos; THEN [pu_sessions]&#10;WHEN &apos;Dmart&apos; THEN [dmart_sessions]&#10;WHEN &apos;Shops&apos; THEN [shops_sessions]&#10;&#10;END' />
            </column>
            <column caption='total_dmart_incentives' datatype='real' name='[Calculation_3939383083622346761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_dmart_discounts] + [total_dmart_vouchers]' />
            </column>
            <column caption='total_shops_incentives' datatype='real' name='[Calculation_3939383083622420490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_shops_discounts] + [total_shops_vouchers]' />
            </column>
            <column caption='total_resto_incentives' datatype='real' name='[Calculation_3939383083622649867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_resto_discounts] + [total_resto_vouchers]' />
            </column>
            <column caption='total_pu_incentives' datatype='real' name='[Calculation_3939383083622735884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_pu_discounts] + [total_pu_vouchers]' />
