              <bucket>&quot;YS_TR&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;FP_SG&quot;</bucket>
            </map>
            <map to='#f1ce63'>
              <bucket>&quot;FP_MY&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;FP_BD&quot;</bucket>
            </map>
            <map to='#fabfd2'>
              <bucket>&quot;OP_SE&quot;</bucket>
            </map>
            <map to='#ff9d9a'>
              <bucket>&quot;FP_TH&quot;</bucket>
            </map>
            <map to='#ffbe7d'>
              <bucket>&quot;FP_HK&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:hva_subcategory:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;Acquisition&quot;</bucket>
            </map>
            <map to='#59a14f'>
              <bucket>&quot;QC Early&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;Dormant Reactivation&quot;</bucket>
            </map>
            <map to='#9c755f'>
              <bucket>&quot;Co-funded&quot;</bucket>
            </map>
            <map to='#b07aa1'>
              <bucket>&quot;Mature&quot;</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>&quot;Non HVA&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;Early (Welcome flow)&quot;</bucket>
            </map>
            <map to='#edc948'>
              <bucket>&quot;Infrequent Reactivation&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;QC Trial&quot;</bucket>
            </map>
            <map to='#ff9da7'>
              <bucket>&quot;Subscription&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Taiwan&quot;' />
      </semantic-values>
      <default-sorts>
        <manual-sort column='[none:sub_category:nk]' direction='ASC'>
          <dictionary>
            <bucket>&quot;Vouchers&quot;</bucket>
            <bucket>&quot;Co-funded subsidy&quot;</bucket>
            <bucket>&quot;Vendor funded incentives&quot;</bucket>
            <bucket>&quot;DH funded incentives&quot;</bucket>
            <bucket>&quot;Free Delivery&quot;</bucket>
            <bucket>%null%</bucket>
          </dictionary>
        </manual-sort>
      </default-sorts>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Timeframe' datatype='string' name='[Metric Selection (copy)_4756927128371220482]' param-domain-type='list' role='measure' type='nominal' value='&quot;30 Days&quot;'>
          <calculation class='tableau' formula='&quot;30 Days&quot;' />
        </column>
        <column caption='Channel Display' datatype='boolean' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='true'>
          <calculation class='tableau' formula='true' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_9ED8F23866BF490085A6B2FCF80A96D2'>
            <properties context=''>
              <relation connection='bigquery.1jo2yrp0abb6vf16syntc15xtb8a' name='Custom SQL Query' type='text'><![CDATA[WITH incentives_pre AS (
  SELECT
    a.global_entity_id,
    a.order_code,
    CONCAT(a.global_entity_id,"_",a.order_code) AS order_uid,
    b.dps_customer_tag,
    e.delivery_type,
    IFNULL(e.dps_subscriber_delivery_discount, FALSE) AS dps_subscriber_delivery_discount,
    a.voucher_code,
    IF(c.is_free_delivery_subscription_voucher_order OR c.is_free_delivery_subscription_discount_order, TRUE, FALSE) AS is_free_delivery_subscription_order, 
    COALESCE(c.is_free_delivery_subscription_discount_order, FALSE) AS is_free_delivery_subscription_discount_order,

    a.gfv_eur AS gbv_eur,
    a.gfv_local AS gbv_local,
    CASE
      WHEN a.business_type = "concepts" THEN "SKC"
      WHEN a.business_type = "dmart" THEN "Dmart"
      WHEN a.business_type = "shops" THEN "Shops"
      WHEN a.business_type = "kitchens" THEN "SKC"
      WHEN a.business_type = "pandago" THEN "Pandago"
      WHEN a.business_type = "caterers" THEN "Caterers"
      WHEN a.business_type = "vouchers" THEN "Vouchers"
      WHEN a.delivery_type = "pickup" THEN "Pickup"
    ELSE "Food"
    END AS vertical_per_redemption,
    a.voucher_channel AS channel,
    a.voucher_purpose AS purpose,
    a.voucher_description,
    a.created_date_local,
    s.is_disco_campaign,
    c.is_subscription_discount_order,
    c.is_subscription_voucher_order,
    c.is_subscriber_pickup_order,
    IF(a.voucher_type = "free_delivery", TRUE, FALSE) AS is_fd_voucher, 
    IF(a.discount_type = "free_delivery", TRUE, FALSE) AS is_fd_discount, 
    a.pd_discount_uuid,
    a.pd_voucher_uuid,
    b.dps_basket_value_fee_eur, 
    a.cashback_utilized_amount_eur, 
    f.flgp_platform_eur,
    s.is_corporate_evergreen_voucher,
    p.is_corporate_evergreen_discount,
    COALESCE(m.voucher_cost_eur, 0) AS voucher_cost_eur,
    COALESCE(m.discount_cost_eur, 0) AS discount_cost_eur,

    COALESCE(m.voucher_cost_dh_eur, 0) AS voucher_cost_dh_eur,
    COALESCE(m.discount_cost_dh_eur, 0) AS discount_cost_dh_eur,

    COALESCE(m.voucher_cost_vendor_eur, 0) AS voucher_cost_vendor_eur,
    COALESCE(m.discount_cost_vendor_eur, 0) AS discount_cost_vendor_eur,

    COALESCE(m.pandapro_fd_revenue_reduction_eur, 0) AS pandapro_fd_revenue_reduction_eur,
    COALESCE(m.revenue_reduction_delivery_eur, 0) AS revenue_reduction_delivery_eur,
    a.voucher_budget_channel,
    a.discount_budget_channel,
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS a
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.preprocessing__marketing_hva_apac_costs` m    
         ON a.global_entity_id = m.global_entity_id
        AND a.order_code = m.order_id
        AND m.partition_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.preprocessing__marketing_hva_orders` AS e
         ON a.global_entity_id = e.global_entity_id
        AND a.order_code = e.order_id
        AND e.partition_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_dps` AS b
         ON a.global_entity_id = b.global_entity_id
        AND a.order_code = b.order_code
        AND b.order_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_subscriptions` AS c
         ON a.global_entity_id = c.global_entity_id
        AND a.order_code = c.order_code
        AND c.partition_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_vouchers` AS mic
         ON a.global_entity_id = mic.global_entity_id
        AND a.order_code = mic.order_code
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discounts` AS d
         ON a.global_entity_id = d.global_entity_id
        AND a.pd_discount_uuid = d.uuid
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_marketing_voucher_costs` s
         ON a.global_entity_id = s.global_entity_id
        AND a.order_code = s.order_code
        AND s.created_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_marketing_discount_costs` p
         ON a.global_entity_id = p.global_entity_id
        AND a.order_code = p.order_code
        AND p.created_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_finance_flgp_platform` f 
         ON a.global_entity_id = f.global_entity_id
        AND a.order_code = f.order_code
        AND f.created_date_local >>= "2025-01-01"
  WHERE a.created_date_local >>= "2025-01-01"
    AND a.global_entity_id NOT LIKE "ODR_%"
    AND a.is_successful
),

incentives AS (
  SELECT
    global_entity_id,
    order_code,
    order_uid,
    dps_customer_tag,
    is_free_delivery_subscription_order,
    is_free_delivery_subscription_discount_order,
    delivery_type,
    voucher_code,
    dps_subscriber_delivery_discount,
    gbv_eur,
    gbv_local,
    vertical_per_redemption,
    channel,
    purpose,
    voucher_description,
    created_date_local,
    is_disco_campaign,
    is_subscription_discount_order,
    is_subscription_voucher_order,
    is_subscriber_pickup_order,
    is_fd_voucher,
    is_fd_discount,
    pd_discount_uuid,
    pd_voucher_uuid,
    dps_basket_value_fee_eur,
    cashback_utilized_amount_eur,
    flgp_platform_eur,
    is_corporate_evergreen_voucher,
    is_corporate_evergreen_discount,
    voucher_cost_eur,
    discount_cost_eur,
    voucher_cost_dh_eur,
    discount_cost_dh_eur,
    voucher_cost_vendor_eur,
    discount_cost_vendor_eur,
    pandapro_fd_revenue_reduction_eur,
    revenue_reduction_delivery_eur,
    voucher_budget_channel,
    discount_budget_channel
  FROM incentives_pre
),

cnt_hva as (
  SELECT 
    global_entity_id, 
    order_id, 
    COUNT(order_id) as cnt
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__order_hva_costs`
  WHERE DATE_TRUNC(created_date, month) >>= '2025-01-01'
  GROUP BY ALL
),

pandora_source AS (
  SELECT
    hva.global_entity_id,
    hva.year_month,
    hva.created_date,
    hva.analytical_customer_id,
    hva.hva_subcategory,
    hva.hva_category,
    hva.customer_segment,
    mic.order_uid, 
    mic.vertical_per_redemption,
    mic.voucher_budget_channel, 
    mic.discount_budget_channel,

    CASE WHEN mic.voucher_budget_channel in ('CX Vouchers', 'Corporate Vouchers', 'Employee benefit / internal', 'Rider Vouchers') THEN 'Non-marketing'
        WHEN mic.voucher_budget_channel LIKE 'CRM%' AND mic.vertical_per_redemption in ('Dmart', 'Shops') THEN 'CRM (QC)'
        WHEN mic.voucher_budget_channel LIKE 'CRM%' AND mic.vertical_per_redemption NOT in ('Dmart', 'Shops') THEN 'CRM (non-QC)'
        WHEN mic.voucher_budget_channel in ('PandaPro Benefits') AND hva.dh_mkt_voucher_eur >>0 THEN 'Pro Benefits'
        WHEN mic.voucher_budget_channel in ('Co-funding') THEN 'Co-funding (vouchers)'
        WHEN mic.voucher_budget_channel in ('Traffic-driving Campaign') THEN 'Blockbuster (FP-funded)'
        WHEN mic.voucher_budget_channel in ('Loyalty Programme') THEN 'Loyalty'
        WHEN mic.voucher_budget_channel in ('NC Campaign', 'Refer A Friend') THEN 'NC vouchers'
        WHEN mic.voucher_budget_channel='Product HVA Voucher' THEN 'HVA Voucher'
        WHEN hva.dh_mkt_voucher_eur >>0 THEN 'Other FP-funded'
        END AS voucher_channel_grouped,

    CASE WHEN mic.discount_budget_channel = 'PandaPro Benefits' AND hva.dh_mkt_discount_eur>>0 THEN 'Pro Benefits'
        WHEN mic.discount_cost_dh_eur >> 0 AND mic.discount_cost_dh_eur <<>> mic.discount_cost_eur AND hva.dh_mkt_discount_eur>>0 THEN 'CF deals' 
        WHEN mic.discount_cost_dh_eur >> 0 AND mic.discount_cost_dh_eur = mic.discount_cost_eur AND hva.dh_mkt_discount_eur>>0 THEN 'FPF deals' 
        WHEN mic.discount_cost_dh_eur = 0 AND mic.discount_cost_eur >> 0 AND hva.vendor_mkt_discount_eur>>0 THEN 'VF deals'
        WHEN mic.is_fd_discount THEN 'Free delivery'
        WHEN mic.discount_cost_eur >>0 THEN 'Non-marketing'
        END as deals_channel_grouped,

    --all
    COALESCE(mic.voucher_cost_eur,0) / cnt_hva.cnt AS voucher_cost_eur,
    COALESCE(mic.discount_cost_eur,0) / cnt_hva.cnt AS discount_cost_eur,
    --dh
    COALESCE(mic.voucher_cost_dh_eur,0) / cnt_hva.cnt AS voucher_cost_fp_eur, 
    COALESCE(mic.discount_cost_dh_eur,0) / cnt_hva.cnt AS discount_cost_fp_eur,
    dh_mkt_voucher_eur AS voucher_cost_fp_marketing_eur,
    dh_mkt_discount_eur AS discount_cost_fp_marketing_eur,
    dh_mkt_contribution_excl_fd_eur AS incentive_cost_fp_marketing_eur,
    --vf
    vendor_mkt_voucher_eur AS voucher_cost_vf_eur,--incl
    COALESCE(mic.discount_cost_vendor_eur,0) / cnt_hva.cnt AS discount_cost_vf_eur, 
    COALESCE(mic.discount_cost_vendor_eur, 0) / cnt_hva.cnt + vendor_mkt_voucher_eur AS incentive_cost_vf_eur,
    vendor_mkt_discount_eur AS discount_cost_vf_eur_excl_pro_fd, 
    vendor_mkt_contribution_eur AS incentive_cost_vf_eur_excl_pro_fd,
    --fd
    dh_mkt_fdnc_eur AS total_fdnc_cost_eur,   

    CASE WHEN dh_mkt_fdnc_eur >> 0 THEN 0 
        WHEN mic.global_entity_id = 'FP_SG' AND mic.is_subscription_voucher_order AND mic.is_fd_voucher THEN 0   --remove mistagged pro FD cost for SG QC
        WHEN mic.pandapro_fd_revenue_reduction_eur >> 0 THEN 0
        WHEN mic.is_fd_voucher AND NOT mic.is_subscription_voucher_order AND NOT mic.is_corporate_evergreen_voucher THEN mic.revenue_reduction_delivery_eur
        WHEN mic.is_fd_discount AND NOT mic.is_subscription_discount_order THEN mic.revenue_reduction_delivery_eur
        WHEN ABS(mic.dps_basket_value_fee_eur) >> 0 THEN 0
        WHEN cdbo.is_qcommerce THEN mic.revenue_reduction_delivery_eur
        WHEN cdbo.is_meal_for_one THEN 0
        WHEN mic.revenue_reduction_delivery_eur >> 0 THEN mic.revenue_reduction_delivery_eur
        ELSE 0 END / cnt_hva.cnt as total_fd_cost_eur,

    COALESCE(mic.pandapro_fd_revenue_reduction_eur,0) / cnt_hva.cnt AS pandapro_fd_revenue_reduction_eur, 

    dps_basket_value_fee_eur / cnt_hva.cnt AS basket_df_revenue_reduction_eur,
    cashback_utilized_amount_eur / cnt_hva.cnt AS cashback_utilized_amount_eur,
    gmv_eur AS gmv_net_eur,
    flgp_platform_eur / cnt_hva.cnt AS fully_loaded_gross_profit_eur,

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__order_hva_costs` hva
  LEFT JOIN incentives mic
         ON hva.order_id = mic.order_code
        AND hva.global_entity_id = mic.global_entity_id
        AND mic.created_date_local >>='2025-01-01'
  LEFT JOIN cnt_hva
         ON hva.order_id = cnt_hva.order_id
        AND hva.global_entity_id = cnt_hva.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` cdbo
         ON hva.order_id = cdbo.order_id
        AND cdbo.partition_date_local >>= '2025-01-01'
        AND hva.global_entity_id = cdbo.global_entity_id
  WHERE DATE_TRUNC(hva.created_date, month) >>= '2025-01-01'
),

hva_orders_pre AS (
  SELECT
    global_entity_id,
    order_uid,
    year_month,
    created_date,
    analytical_customer_id,  
    CASE 
      WHEN hva_subcategory IN ('Acquisition','Early (Welcome flow)','QC Trial','Dormant Reactivation','QC Early','Infrequent Reactivation','Co-funded','Subscription','Non HVA') THEN hva_subcategory
      WHEN hva_category='Mature' THEN 'Mature' 
      END AS hva_subcategory,
    customer_segment,
    SUM(COALESCE(voucher_cost_fp_eur,0)) as voucher_cost_fp_eur,
    SUM(COALESCE(discount_cost_fp_eur,0)) as discount_cost_fp_eur,
    SUM(COALESCE(CASE WHEN incentive_channel_grouped <<>> 'Non-marketing' THEN incentive_cost_fp_marketing_eur END,0)) AS marketing_cost_eur,
    SUM(COALESCE(CASE WHEN incentive_channel_grouped <<>> 'Non-marketing' THEN total_fdnc_cost_eur END,0)) as total_fdnc_cost_eur,
    SUM(COALESCE(CASE WHEN incentive_channel_grouped <<>> 'Non-marketing' THEN total_fd_cost_eur END,0)) as total_fd_cost_eur,
    SUM(COALESCE(gmv_net_eur,0)) as gmv_net_eur,
    SUM(COALESCE(fully_loaded_gross_profit_eur,0)) as fully_loaded_gross_profit_eur,
    SUM(COALESCE(voucher_cost_vf_eur,0)) as voucher_cost_vf_eur,
    SUM(COALESCE(discount_cost_vf_eur,0)) as discount_cost_vf_eur,
    SUM(COALESCE(incentive_cost_vf_eur,0)) AS marketing_cost_vf_eur,
    SUM(COALESCE(discount_cost_vf_eur_excl_pro_fd,0)) as discount_cost_vf_eur_excl_pro_fd,  
    SUM(COALESCE(incentive_cost_vf_eur_excl_pro_fd,0)) AS marketing_cost_vf_eur_excl_pro_fd,  

  FROM (
    SELECT 
      *,
      CASE 
        WHEN voucher_cost_fp_marketing_eur=0 AND discount_cost_fp_marketing_eur=0 AND total_fdnc_cost_eur >>0 THEN 'FDNC'
        WHEN voucher_cost_fp_marketing_eur=0 AND discount_cost_fp_marketing_eur=0 AND total_fd_cost_eur>>0 THEN 'Free delivery'
        WHEN voucher_cost_fp_marketing_eur=0 AND discount_cost_fp_marketing_eur=0 AND incentive_cost_fp_marketing_eur >>0 THEN 'Cashback'
        WHEN voucher_cost_fp_marketing_eur=0 AND discount_cost_fp_marketing_eur>>0 THEN deals_channel_grouped
        ELSE IFNULL(COALESCE(voucher_channel_grouped, deals_channel_grouped),'Organic') 
        END AS incentive_channel_grouped
      FROM pandora_source
  )
  GROUP BY ALL
),

pm_orders AS (
  SELECT 
    global_entity_id,
    created_date_utc,
    order_uid,
    channel,
    channel_subchannel,
    platform,
    CASE
    WHEN channel_subchannel NOT IN ("APP_BRA", "APP_RMO", "CRM_BRA", "CRM_RMO", "CRM_UNKNOWN", "DISPLAY_BRA", "DISPLAY_RMO",
                          "PAIDSOCIAL_BRA", "PAIDSOCIAL_RMO", "PAIDSOCIAL_UNKNOWN", "REFERRAL", "SEM_RMO",
                          "SOCIALMEDIA_INFLUENCER", "SOCIALMEDIA_ENGAGEMENTNOTPROMOTED", "SOCIALMEDIA_ENGAGEMENTPROMOTED") THEN 'Acquisition'
    ELSE 'Existing' END AS channel_group,
    is_acquisition
  FROM `fulfillment-dwh-production.pandata_report.marketing__performance_channel_orders`
  WHERE created_date_utc >>= '2025-01-01'
    -- AND global_entity_id IN ('FP_BD', 'FP_HK', 'FP_KH', 'FP_LA', 'FP_MM', 'FP_MY', 'FP_PH', 'FP_PK', 'FP_SG', 'FP_TH', 'FP_TW')
    AND channel_subchannel NOT IN ('PROGRAMMATIC_BRA', 'APP_BRA', 'PAIDSOCIAL_BRA', 'DISPLAY_BRA')
    AND channel in ('APP', 'DISPLAY', 'PAIDSOCIAL', 'SEM')
),
            
pm_cost AS (
  SELECT
    global_entity_id,
    cost_date_utc,
    channel,
    channel_subchannel,
    CASE 
      WHEN channel_subchannel NOT IN ("APP_BRA", "APP_RMO", "CRM_BRA", "CRM_RMO", "CRM_UNKNOWN", "DISPLAY_BRA", "DISPLAY_RMO",
                                 "PAIDSOCIAL_BRA", "PAIDSOCIAL_RMO", "PAIDSOCIAL_UNKNOWN", "REFERRAL", "SEM_RMO",
                                 "SOCIALMEDIA_INFLUENCER", "SOCIALMEDIA_ENGAGEMENTNOTPROMOTED", "SOCIALMEDIA_ENGAGEMENTPROMOTED") THEN 'Acquisition'
      ELSE 'Existing' END AS channel_group,
    LOWER(platform) AS platform,
    SUM(cost_eur) AS pm_cost_eur
  FROM `fulfillment-dwh-production.pandata_report.marketing__channel_online_cost`
  WHERE DATE_TRUNC(cost_date_utc, MONTH) >>= "2023-06-01"
    -- AND global_entity_id IN ('FP_BD', 'FP_HK', 'FP_KH', 'FP_LA', 'FP_MM', 'FP_MY', 'FP_PH', 'FP_PK', 'FP_SG', 'FP_TH', 'FP_TW')
    AND channel_subchannel NOT IN ('PROGRAMMATIC_BRA', 'APP_BRA', 'PAIDSOCIAL_BRA', 'DISPLAY_BRA')
    AND channel in ('APP', 'DISPLAY', 'PAIDSOCIAL', 'SEM')
    AND platform NOT IN ("UNSPECIFIED", "Mix")
    AND cost_source NOT IN ("dv360-non-youtube", "dv360-with-youtube")
  GROUP BY ALL
),

pm_cost_per_order_acq AS (SELECT 
                a.global_entity_id,
                a.cost_date_utc,
                a.channel_group,
                a.channel,
                a.channel_subchannel,
                a.platform,
                a.pm_cost_eur,
                b.orders,
                SAFE_DIVIDE(pm_cost_eur, orders) AS pm_costs_per_order 
                FROM (SELECT * FROM pm_cost
                      WHERE channel_group='Acquisition') a 
                LEFT JOIN (SELECT global_entity_id,
                                  created_date_utc,
                                  channel_group,
                                  channel,
                                  channel_subchannel,
                                  platform,
                                  COUNT(DISTINCT order_uid) AS orders
                          FROM pm_orders
                          WHERE channel_group='Acquisition' AND is_acquisition
                          GROUP BY ALL) b 
                    ON a.global_entity_id=b.global_entity_id 
                    AND a.channel_group=b.channel_group  
                    AND a.channel=b.channel 
                    AND a.channel_subchannel=b.channel_subchannel
                    AND a.platform=b.platform 
                    AND a.cost_date_utc=b.created_date_utc),


pm_cost_per_order_exist AS (SELECT 
                a.global_entity_id,
                a.cost_date_utc,
                a.channel_group,
                a.channel,
                a.channel_subchannel,
                a.platform,
                a.pm_cost_eur,
                b.orders,
                SAFE_DIVIDE(pm_cost_eur, orders) AS pm_costs_per_order 
                FROM (SELECT * FROM pm_cost
                      WHERE channel_group<<>>'Acquisition') a 
                LEFT JOIN (SELECT global_entity_id,
                                  created_date_utc,
                                  channel_group,
                                  channel,
                                  channel_subchannel,
                                  platform,
                                  COUNT(DISTINCT order_uid) AS orders
                          FROM pm_orders
                          WHERE NOT is_acquisition
                          GROUP BY ALL) b 
                    ON a.global_entity_id=b.global_entity_id 
                    AND a.channel_group=b.channel_group 
                    AND a.channel=b.channel
                    AND a.channel_subchannel=b.channel_subchannel
                    AND a.platform=b.platform  
                    AND a.cost_date_utc=b.created_date_utc),

hva_orders_acq AS (SELECT 
            a.* except (customer_segment),
            b.channel,
            b.channel_subchannel,
            b.platform,
            CASE WHEN b.order_uid IS NOT NULL THEN 'PM' END AS pm_flag,
            c.pm_costs_per_order,
            CASE WHEN hva_subcategory='Dormant Reactivation' THEN a.customer_segment ELSE '' END AS customer_segment,
            FROM (SELECT * FROM hva_orders_pre WHERE hva_subcategory='Acquisition') a 
            LEFT JOIN (SELECT * FROM pm_orders WHERE channel_group='Acquisition' AND is_acquisition) b 
              ON a.order_uid=b.order_uid
            LEFT JOIN pm_cost_per_order_acq c 
              ON b.global_entity_id=c.global_entity_id 
              AND b.channel_group=c.channel_group
              AND b.channel=c.channel
              AND b.channel_subchannel=c.channel_subchannel
              AND b.platform=c.platform
              AND b.created_date_utc=c.cost_date_utc),

hva_orders_exist AS (SELECT 
            a.* except (customer_segment),
            b.channel,
            b.channel_subchannel,
            b.platform,
            CASE WHEN b.order_uid IS NOT NULL THEN 'PM' END AS pm_flag,
            c.pm_costs_per_order,
            CASE WHEN hva_subcategory='Dormant Reactivation' THEN a.customer_segment ELSE '' END AS customer_segment,
            FROM (SELECT * FROM hva_orders_pre WHERE hva_subcategory<<>>'Acquisition') a 
            LEFT JOIN (SELECT * FROM pm_orders WHERE NOT is_acquisition) b 
              ON a.order_uid=b.order_uid
            LEFT JOIN pm_cost_per_order_exist c 
              ON b.global_entity_id=c.global_entity_id 
              AND b.channel_group=c.channel_group
              AND b.channel=c.channel
              AND b.channel_subchannel=c.channel_subchannel
              AND b.platform=c.platform
              AND b.created_date_utc=c.cost_date_utc),

hva_orders AS (SELECT * FROM hva_orders_acq 
              UNION ALL
              SELECT * FROM hva_orders_exist),

agg AS( 
  SELECT 
    global_entity_id,
    order_uid,
    year_month,
    created_date,
    analytical_customer_id,  
    hva_subcategory, 
    customer_segment,
    channel,
    channel_subchannel,
    ROW_NUMBER() OVER (PARTITION BY analytical_customer_id, year_month, hva_subcategory ORDER BY created_date) AS first_order_rn,
    gmv_net_eur,
    fully_loaded_gross_profit_eur,
    voucher_cost_fp_eur,
    discount_cost_fp_eur,
    marketing_cost_eur,
    total_fdnc_cost_eur,
    total_fd_cost_eur,
    voucher_cost_vf_eur,
    discount_cost_vf_eur,
    marketing_cost_vf_eur,
    discount_cost_vf_eur_excl_pro_fd,  
    marketing_cost_vf_eur_excl_pro_fd,  
    pm_flag,
    COALESCE(pm_costs_per_order,0) AS pm_costs_per_order,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 2592000 FOLLOWING
        ) AS flgp_eur_30d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 2592000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_30d_before,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 5184000 FOLLOWING
        ) AS flgp_eur_60d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 5184000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_60d_before,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 7776000 FOLLOWING
        ) AS flgp_eur_90d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 7776000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_90d_before,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 10368000 FOLLOWING
        ) AS flgp_eur_120d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 10368000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_120d_before,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 12960000 FOLLOWING
        ) AS flgp_eur_150d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 12960000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_150d_before,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 15552000 FOLLOWING
        ) AS flgp_eur_180d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 15552000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_180d_before,

    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 2592000 FOLLOWING
        ) AS gmv_net_eur_30d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 2592000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_30d_before,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 5184000 FOLLOWING
        ) AS gmv_net_eur_60d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 5184000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_60d_before,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 7776000 FOLLOWING
        ) AS gmv_net_eur_90d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 7776000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_90d_before,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 10368000 FOLLOWING
        ) AS gmv_net_eur_120d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 10368000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_120d_before,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 12960000 FOLLOWING
        ) AS gmv_net_eur_150d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 12960000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_150d_before,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 15552000 FOLLOWING
        ) AS gmv_net_eur_180d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 15552000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_180d_before,

    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 2592000 FOLLOWING
        ) AS retained_orders_30d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 2592000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_30d_before,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 5184000 FOLLOWING
        ) AS retained_orders_60d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 5184000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_60d_before,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 7776000 FOLLOWING
        ) AS retained_orders_90d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 7776000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_90d_before,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 10368000 FOLLOWING
        ) AS retained_orders_120d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 10368000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_120d_before,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 12960000 FOLLOWING
        ) AS retained_orders_150d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 12960000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_150d_before,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 15552000 FOLLOWING
        ) AS retained_orders_180d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 15552000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_180d_before
  FROM hva_orders
  GROUP BY ALL
  ORDER BY created_date
)

, summary AS(
  SELECT  
    agg.global_entity_id,
    year_month,  
    hva_subcategory, 
    customer_segment,
    channel,
    channel_subchannel,
    CASE 
      WHEN voucher_cost_fp_eur + discount_cost_fp_eur + voucher_cost_vf_eur + discount_cost_vf_eur + total_fdnc_cost_eur + total_fd_cost_eur >>0 AND COALESCE(pm_costs_per_order,0) >>0 THEN 'Incentive + PM'
      WHEN voucher_cost_fp_eur + discount_cost_fp_eur + voucher_cost_vf_eur + discount_cost_vf_eur + total_fdnc_cost_eur + total_fd_cost_eur >>0 AND COALESCE(pm_costs_per_order,0)=0 THEN 'Incentive Only'
      WHEN voucher_cost_fp_eur + discount_cost_fp_eur + voucher_cost_vf_eur + discount_cost_vf_eur + total_fdnc_cost_eur + total_fd_cost_eur =0 AND COALESCE(pm_costs_per_order,0) >>0 THEN 'PM Only'
      WHEN voucher_cost_fp_eur + discount_cost_fp_eur + voucher_cost_vf_eur + discount_cost_vf_eur + total_fdnc_cost_eur + total_fd_cost_eur =0 AND COALESCE(pm_costs_per_order,0)=0 THEN 'Organic' 
      END AS category,
    CASE 
      WHEN voucher_cost_fp_eur + voucher_cost_vf_eur >> 0 THEN "Vouchers"
      WHEN discount_cost_fp_eur >> 0 AND discount_cost_vf_eur >> 0 THEN "Co-funded subsidy"
      WHEN discount_cost_fp_eur = 0 AND discount_cost_vf_eur >> 0 THEN "Vendor funded incentives"
      WHEN discount_cost_fp_eur >> 0 AND discount_cost_vf_eur = 0 THEN "DH funded incentives"
      WHEN total_fdnc_cost_eur + total_fd_cost_eur >> 0 THEN "Free Delivery"
      END AS sub_category,
    COUNT(DISTINCT agg.order_uid) AS orders,
    COUNT(DISTINCT analytical_customer_id) AS acid,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 THEN analytical_customer_id END) AS acid_first_order,
    SUM(COALESCE(pm_costs_per_order,0)) AS pm_costs_per_order,
    SUM(gmv_net_eur) AS gmv_net_eur,
    SUM(fully_loaded_gross_profit_eur) AS fully_loaded_gross_profit_eur,
    SUM(voucher_cost_fp_eur) AS voucher_cost_fp_eur,
    SUM(discount_cost_fp_eur) AS discount_cost_fp_eur,
    SUM(marketing_cost_eur) AS marketing_cost_eur,
    SUM(total_fdnc_cost_eur) AS total_fdnc_cost_eur,
    SUM(total_fd_cost_eur) AS total_fd_cost_eur,
    SUM(voucher_cost_vf_eur) AS voucher_cost_vf_eur,
    SUM(discount_cost_vf_eur) AS discount_cost_vf_eur,
    SUM(marketing_cost_vf_eur) AS marketing_cost_vf_eur,
    SUM(discount_cost_vf_eur_excl_pro_fd) AS discount_cost_vf_eur_excl_pro_fd,  
    SUM(marketing_cost_vf_eur_excl_pro_fd) AS marketing_cost_vf_eur_excl_pro_fd,  
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_30d END) AS flgp_eur_30d,
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_60d END) AS flgp_eur_60d,
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_90d END) AS flgp_eur_90d,
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_120d END) AS flgp_eur_120d,
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_150d END) AS flgp_eur_150d,
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_180d END) AS flgp_eur_180d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_30d END) AS gmv_net_eur_30d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_60d END) AS gmv_net_eur_60d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_90d END) AS gmv_net_eur_90d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_120d END) AS gmv_net_eur_120d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_150d END) AS gmv_net_eur_150d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_180d END) AS gmv_net_eur_180d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_30d END) AS retained_orders_30d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_60d END) AS retained_orders_60d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_90d END) AS retained_orders_90d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_120d END) AS retained_orders_120d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_150d END) AS retained_orders_150d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_180d END) AS retained_orders_180d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_30d >> 1 THEN analytical_customer_id END) retained_30d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_60d >> 1 THEN analytical_customer_id END) retained_60d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_90d >> 1 THEN analytical_customer_id END) retained_90d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_120d >> 1 THEN analytical_customer_id END) retained_120d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_150d >> 1 THEN analytical_customer_id END) retained_150d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_180d >> 1 THEN analytical_customer_id END) retained_180d,
  FROM agg
  GROUP BY ALL
)

SELECT *
FROM summary
WHERE hva_subcategory = "Acquisition"
  -- AND global_entity_id IN ('FP_BD', 'FP_HK', 'FP_KH', 'FP_LA', 'FP_MM', 'FP_MY', 'FP_PH', 'FP_PK', 'FP_SG', 'FP_TH', 'FP_TW')
  AND global_entity_id = 'FP_PK']]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Voucher_purpose' inline='true' name='federated.1vl16jw0mqnobb1gs1j9y0skimti' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1arzgz80utruuj16y5doh0w25j3r'>
            <connection CATALOG='pd-data--adhoc' EXECCATALOG='pd-data--adhoc' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandora Data Adhoc' schema='sandbox__pd_markets_apac' server='' server-oauth='' username='tina.hsieh@foodpanda.tw' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1arzgz80utruuj16y5doh0w25j3r' name='Custom SQL Query' type='text'><![CDATA[WITH incentives_pre AS (
  SELECT
    a.global_entity_id,
    a.order_code,
    CONCAT(a.global_entity_id,"_",a.order_code) AS order_uid,
    b.dps_customer_tag,
    e.delivery_type,
    IFNULL(e.dps_subscriber_delivery_discount, FALSE) AS dps_subscriber_delivery_discount,
    a.voucher_code,
    IF(c.is_free_delivery_subscription_voucher_order OR c.is_free_delivery_subscription_discount_order, TRUE, FALSE) AS is_free_delivery_subscription_order, 
    COALESCE(c.is_free_delivery_subscription_discount_order, FALSE) AS is_free_delivery_subscription_discount_order,

    a.gfv_eur AS gbv_eur,
    a.gfv_local AS gbv_local,
    CASE
      WHEN a.business_type = "concepts" THEN "SKC"
      WHEN a.business_type = "dmart" THEN "Dmart"
      WHEN a.business_type = "shops" THEN "Shops"
      WHEN a.business_type = "kitchens" THEN "SKC"
      WHEN a.business_type = "pandago" THEN "Pandago"
      WHEN a.business_type = "caterers" THEN "Caterers"
      WHEN a.business_type = "vouchers" THEN "Vouchers"
      WHEN a.delivery_type = "pickup" THEN "Pickup"
    ELSE "Food"
    END AS vertical_per_redemption,
    a.voucher_channel AS channel,
    a.voucher_purpose AS purpose,
    a.voucher_description,
    a.created_date_local,
    s.is_disco_campaign,
    c.is_subscription_discount_order,
    c.is_subscription_voucher_order,
    c.is_subscriber_pickup_order,
    IF(a.voucher_type = "free_delivery", TRUE, FALSE) AS is_fd_voucher, 
    IF(a.discount_type = "free_delivery", TRUE, FALSE) AS is_fd_discount, 
    a.pd_discount_uuid,
    a.pd_voucher_uuid,
    b.dps_basket_value_fee_eur, 
    a.cashback_utilized_amount_eur, 
    f.flgp_platform_eur,
    s.is_corporate_evergreen_voucher,
    p.is_corporate_evergreen_discount,
    COALESCE(m.voucher_cost_eur, 0) AS voucher_cost_eur,
    COALESCE(m.discount_cost_eur, 0) AS discount_cost_eur,

    COALESCE(m.voucher_cost_dh_eur, 0) AS voucher_cost_dh_eur,
    COALESCE(m.discount_cost_dh_eur, 0) AS discount_cost_dh_eur,

    COALESCE(m.voucher_cost_vendor_eur, 0) AS voucher_cost_vendor_eur,
    COALESCE(m.discount_cost_vendor_eur, 0) AS discount_cost_vendor_eur,

    COALESCE(m.pandapro_fd_revenue_reduction_eur, 0) AS pandapro_fd_revenue_reduction_eur,
    COALESCE(m.revenue_reduction_delivery_eur, 0) AS revenue_reduction_delivery_eur,
    a.voucher_budget_channel,
    a.discount_budget_channel,
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS a
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.preprocessing__marketing_hva_apac_costs` m    
         ON a.global_entity_id = m.global_entity_id
        AND a.order_code = m.order_id
        AND m.partition_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.preprocessing__marketing_hva_orders` AS e
         ON a.global_entity_id = e.global_entity_id
        AND a.order_code = e.order_id
        AND e.partition_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_dps` AS b
         ON a.global_entity_id = b.global_entity_id
        AND a.order_code = b.order_code
        AND b.order_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_subscriptions` AS c
         ON a.global_entity_id = c.global_entity_id
        AND a.order_code = c.order_code
        AND c.partition_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_vouchers` AS mic
         ON a.global_entity_id = mic.global_entity_id
        AND a.order_code = mic.order_code
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discounts` AS d
         ON a.global_entity_id = d.global_entity_id
        AND a.pd_discount_uuid = d.uuid
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_marketing_voucher_costs` s
         ON a.global_entity_id = s.global_entity_id
        AND a.order_code = s.order_code
        AND s.created_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_marketing_discount_costs` p
         ON a.global_entity_id = p.global_entity_id
        AND a.order_code = p.order_code
        AND p.created_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_finance_flgp_platform` f 
         ON a.global_entity_id = f.global_entity_id
        AND a.order_code = f.order_code
        AND f.created_date_local >>= "2025-01-01"
  WHERE a.created_date_local >>= "2025-01-01"
    AND a.global_entity_id NOT LIKE "ODR_%"
    AND a.is_successful
),

incentives AS (
  SELECT
    global_entity_id,
    order_code,
    order_uid,
    dps_customer_tag,
    is_free_delivery_subscription_order,
    is_free_delivery_subscription_discount_order,
    delivery_type,
    voucher_code,
    dps_subscriber_delivery_discount,
    gbv_eur,
    gbv_local,
    vertical_per_redemption,
    channel,
    purpose,
    voucher_description,
    created_date_local,
    is_disco_campaign,
    is_subscription_discount_order,
    is_subscription_voucher_order,
    is_subscriber_pickup_order,
    is_fd_voucher,
    is_fd_discount,
    pd_discount_uuid,
    pd_voucher_uuid,
    dps_basket_value_fee_eur,
    cashback_utilized_amount_eur,
    flgp_platform_eur,
    is_corporate_evergreen_voucher,
    is_corporate_evergreen_discount,
    voucher_cost_eur,
    discount_cost_eur,
    voucher_cost_dh_eur,
    discount_cost_dh_eur,
    voucher_cost_vendor_eur,
    discount_cost_vendor_eur,
    pandapro_fd_revenue_reduction_eur,
    revenue_reduction_delivery_eur,
    voucher_budget_channel,
    discount_budget_channel
  FROM incentives_pre
),

cnt_hva as (
  SELECT 
    global_entity_id, 
    order_id, 
    COUNT(order_id) as cnt
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__order_hva_costs`
  WHERE DATE_TRUNC(created_date, month) >>= '2025-01-01'
  GROUP BY ALL
),

pandora_source AS (
  SELECT
    hva.global_entity_id,
    hva.year_month,
    hva.created_date,
    hva.analytical_customer_id,
    hva.hva_subcategory,
    hva.hva_category,
    hva.customer_segment,
    mic.order_uid, 
    mic.vertical_per_redemption,
    mic.voucher_budget_channel, 
    mic.discount_budget_channel,
    mic.purpose,

    CASE WHEN mic.voucher_budget_channel in ('CX Vouchers', 'Corporate Vouchers', 'Employee benefit / internal', 'Rider Vouchers') THEN 'Non-marketing'
        WHEN mic.voucher_budget_channel LIKE 'CRM%' AND mic.vertical_per_redemption in ('Dmart', 'Shops') THEN 'CRM (QC)'
        WHEN mic.voucher_budget_channel LIKE 'CRM%' AND mic.vertical_per_redemption NOT in ('Dmart', 'Shops') THEN 'CRM (non-QC)'
        WHEN mic.voucher_budget_channel in ('PandaPro Benefits') AND hva.dh_mkt_voucher_eur >>0 THEN 'Pro Benefits'
        WHEN mic.voucher_budget_channel in ('Co-funding') THEN 'Co-funding (vouchers)'
        WHEN mic.voucher_budget_channel in ('Traffic-driving Campaign') THEN 'Blockbuster (FP-funded)'
        WHEN mic.voucher_budget_channel in ('Loyalty Programme') THEN 'Loyalty'
        WHEN mic.voucher_budget_channel in ('NC Campaign', 'Refer A Friend') THEN 'NC vouchers'
        WHEN mic.voucher_budget_channel='Product HVA Voucher' THEN 'HVA Voucher'
        WHEN hva.dh_mkt_voucher_eur >>0 THEN 'Other FP-funded'
        END AS voucher_channel_grouped,

    CASE WHEN mic.discount_budget_channel = 'PandaPro Benefits' AND hva.dh_mkt_discount_eur>>0 THEN 'Pro Benefits'
        WHEN mic.discount_cost_dh_eur >> 0 AND mic.discount_cost_dh_eur <<>> mic.discount_cost_eur AND hva.dh_mkt_discount_eur>>0 THEN 'CF deals' 
        WHEN mic.discount_cost_dh_eur >> 0 AND mic.discount_cost_dh_eur = mic.discount_cost_eur AND hva.dh_mkt_discount_eur>>0 THEN 'FPF deals' 
        WHEN mic.discount_cost_dh_eur = 0 AND mic.discount_cost_eur >> 0 AND hva.vendor_mkt_discount_eur>>0 THEN 'VF deals'
        WHEN mic.is_fd_discount THEN 'Free delivery'
        WHEN mic.discount_cost_eur >>0 THEN 'Non-marketing'
        END as deals_channel_grouped,

    --all
    COALESCE(mic.voucher_cost_eur,0) / cnt_hva.cnt AS voucher_cost_eur,
    COALESCE(mic.discount_cost_eur,0) / cnt_hva.cnt AS discount_cost_eur,
    --dh
    COALESCE(mic.voucher_cost_dh_eur,0) / cnt_hva.cnt AS voucher_cost_fp_eur, 
    COALESCE(mic.discount_cost_dh_eur,0) / cnt_hva.cnt AS discount_cost_fp_eur,
    dh_mkt_voucher_eur AS voucher_cost_fp_marketing_eur,
    dh_mkt_discount_eur AS discount_cost_fp_marketing_eur,
    dh_mkt_contribution_excl_fd_eur AS incentive_cost_fp_marketing_eur,
    --vf
    vendor_mkt_voucher_eur AS voucher_cost_vf_eur,--incl
    COALESCE(mic.discount_cost_vendor_eur,0) / cnt_hva.cnt AS discount_cost_vf_eur, 
    COALESCE(mic.discount_cost_vendor_eur, 0) / cnt_hva.cnt + vendor_mkt_voucher_eur AS incentive_cost_vf_eur,
    vendor_mkt_discount_eur AS discount_cost_vf_eur_excl_pro_fd, 
    vendor_mkt_contribution_eur AS incentive_cost_vf_eur_excl_pro_fd,
    --fd
    dh_mkt_fdnc_eur AS total_fdnc_cost_eur,   

    CASE WHEN dh_mkt_fdnc_eur >> 0 THEN 0 
        WHEN mic.global_entity_id = 'FP_SG' AND mic.is_subscription_voucher_order AND mic.is_fd_voucher THEN 0   --remove mistagged pro FD cost for SG QC
        WHEN mic.pandapro_fd_revenue_reduction_eur >> 0 THEN 0
        WHEN mic.is_fd_voucher AND NOT mic.is_subscription_voucher_order AND NOT mic.is_corporate_evergreen_voucher THEN mic.revenue_reduction_delivery_eur
        WHEN mic.is_fd_discount AND NOT mic.is_subscription_discount_order THEN mic.revenue_reduction_delivery_eur
        WHEN ABS(mic.dps_basket_value_fee_eur) >> 0 THEN 0
        WHEN cdbo.is_qcommerce THEN mic.revenue_reduction_delivery_eur
        WHEN cdbo.is_meal_for_one THEN 0
        WHEN mic.revenue_reduction_delivery_eur >> 0 THEN mic.revenue_reduction_delivery_eur
        ELSE 0 END / cnt_hva.cnt as total_fd_cost_eur,

    COALESCE(mic.pandapro_fd_revenue_reduction_eur,0) / cnt_hva.cnt AS pandapro_fd_revenue_reduction_eur, 

    dps_basket_value_fee_eur / cnt_hva.cnt AS basket_df_revenue_reduction_eur,
    cashback_utilized_amount_eur / cnt_hva.cnt AS cashback_utilized_amount_eur,
    gmv_eur AS gmv_net_eur,
    flgp_platform_eur / cnt_hva.cnt AS fully_loaded_gross_profit_eur,

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__order_hva_costs` hva
  LEFT JOIN incentives mic
         ON hva.order_id = mic.order_code
        AND hva.global_entity_id = mic.global_entity_id
        AND mic.created_date_local >>='2025-01-01'
  LEFT JOIN cnt_hva
         ON hva.order_id = cnt_hva.order_id
        AND hva.global_entity_id = cnt_hva.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` cdbo
         ON hva.order_id = cdbo.order_id
        AND cdbo.partition_date_local >>= '2025-01-01'
        AND hva.global_entity_id = cdbo.global_entity_id
  WHERE DATE_TRUNC(hva.created_date, month) >>= '2025-01-01'
),

hva_orders_pre AS (
  SELECT
    global_entity_id,
    order_uid,
    year_month,
    created_date,
    analytical_customer_id,
    purpose,
    CASE 
      WHEN hva_subcategory IN ('Acquisition','Early (Welcome flow)','QC Trial','Dormant Reactivation','QC Early','Infrequent Reactivation','Co-funded','Subscription','Non HVA') THEN hva_subcategory
      WHEN hva_category='Mature' THEN 'Mature' 
      END AS hva_subcategory,
    customer_segment,
    SUM(COALESCE(voucher_cost_fp_eur,0)) as voucher_cost_fp_eur,
    SUM(COALESCE(discount_cost_fp_eur,0)) as discount_cost_fp_eur,
    SUM(COALESCE(CASE WHEN incentive_channel_grouped <<>> 'Non-marketing' THEN incentive_cost_fp_marketing_eur END,0)) AS marketing_cost_eur,
    SUM(COALESCE(CASE WHEN incentive_channel_grouped <<>> 'Non-marketing' THEN total_fdnc_cost_eur END,0)) as total_fdnc_cost_eur,
    SUM(COALESCE(CASE WHEN incentive_channel_grouped <<>> 'Non-marketing' THEN total_fd_cost_eur END,0)) as total_fd_cost_eur,
    SUM(COALESCE(gmv_net_eur,0)) as gmv_net_eur,
    SUM(COALESCE(fully_loaded_gross_profit_eur,0)) as fully_loaded_gross_profit_eur,
    SUM(COALESCE(voucher_cost_vf_eur,0)) as voucher_cost_vf_eur,
    SUM(COALESCE(discount_cost_vf_eur,0)) as discount_cost_vf_eur,
    SUM(COALESCE(incentive_cost_vf_eur,0)) AS marketing_cost_vf_eur,
    SUM(COALESCE(discount_cost_vf_eur_excl_pro_fd,0)) as discount_cost_vf_eur_excl_pro_fd,  
    SUM(COALESCE(incentive_cost_vf_eur_excl_pro_fd,0)) AS marketing_cost_vf_eur_excl_pro_fd,  

  FROM (
    SELECT 
      *,
      CASE 
        WHEN voucher_cost_fp_marketing_eur=0 AND discount_cost_fp_marketing_eur=0 AND total_fdnc_cost_eur >>0 THEN 'FDNC'
        WHEN voucher_cost_fp_marketing_eur=0 AND discount_cost_fp_marketing_eur=0 AND total_fd_cost_eur>>0 THEN 'Free delivery'
        WHEN voucher_cost_fp_marketing_eur=0 AND discount_cost_fp_marketing_eur=0 AND incentive_cost_fp_marketing_eur >>0 THEN 'Cashback'
        WHEN voucher_cost_fp_marketing_eur=0 AND discount_cost_fp_marketing_eur>>0 THEN deals_channel_grouped
        ELSE IFNULL(COALESCE(voucher_channel_grouped, deals_channel_grouped),'Organic') 
        END AS incentive_channel_grouped
      FROM pandora_source
  )
  GROUP BY ALL
),

pm_orders AS (
  SELECT 
    global_entity_id,
    created_date_utc,
    order_uid,
    channel,
    channel_subchannel,
    platform,
    CASE
    WHEN channel_subchannel NOT IN ("APP_BRA", "APP_RMO", "CRM_BRA", "CRM_RMO", "CRM_UNKNOWN", "DISPLAY_BRA", "DISPLAY_RMO",
                          "PAIDSOCIAL_BRA", "PAIDSOCIAL_RMO", "PAIDSOCIAL_UNKNOWN", "REFERRAL", "SEM_RMO",
                          "SOCIALMEDIA_INFLUENCER", "SOCIALMEDIA_ENGAGEMENTNOTPROMOTED", "SOCIALMEDIA_ENGAGEMENTPROMOTED") THEN 'Acquisition'
    ELSE 'Existing' END AS channel_group,
    is_acquisition
  FROM `fulfillment-dwh-production.pandata_report.marketing__performance_channel_orders`
  WHERE created_date_utc >>= '2025-01-01'
    -- AND global_entity_id IN ('FP_BD', 'FP_HK', 'FP_KH', 'FP_LA', 'FP_MM', 'FP_MY', 'FP_PH', 'FP_PK', 'FP_SG', 'FP_TH', 'FP_TW')
    AND channel_subchannel NOT IN ('PROGRAMMATIC_BRA', 'APP_BRA', 'PAIDSOCIAL_BRA', 'DISPLAY_BRA')
    AND channel in ('APP', 'DISPLAY', 'PAIDSOCIAL', 'SEM')
),
            
pm_cost AS (
  SELECT
    global_entity_id,
    cost_date_utc,
    channel,
    channel_subchannel,
    CASE 
      WHEN channel_subchannel NOT IN ("APP_BRA", "APP_RMO", "CRM_BRA", "CRM_RMO", "CRM_UNKNOWN", "DISPLAY_BRA", "DISPLAY_RMO",
                                 "PAIDSOCIAL_BRA", "PAIDSOCIAL_RMO", "PAIDSOCIAL_UNKNOWN", "REFERRAL", "SEM_RMO",
                                 "SOCIALMEDIA_INFLUENCER", "SOCIALMEDIA_ENGAGEMENTNOTPROMOTED", "SOCIALMEDIA_ENGAGEMENTPROMOTED") THEN 'Acquisition'
      ELSE 'Existing' END AS channel_group,
    LOWER(platform) AS platform,
    SUM(cost_eur) AS pm_cost_eur
  FROM `fulfillment-dwh-production.pandata_report.marketing__channel_online_cost`
  WHERE DATE_TRUNC(cost_date_utc, MONTH) >>= "2023-06-01"
    -- AND global_entity_id IN ('FP_BD', 'FP_HK', 'FP_KH', 'FP_LA', 'FP_MM', 'FP_MY', 'FP_PH', 'FP_PK', 'FP_SG', 'FP_TH', 'FP_TW')
    AND channel_subchannel NOT IN ('PROGRAMMATIC_BRA', 'APP_BRA', 'PAIDSOCIAL_BRA', 'DISPLAY_BRA')
    AND channel in ('APP', 'DISPLAY', 'PAIDSOCIAL', 'SEM')
    AND platform NOT IN ("UNSPECIFIED", "Mix")
    AND cost_source NOT IN ("dv360-non-youtube", "dv360-with-youtube")
  GROUP BY ALL
),

pm_cost_per_order_acq AS (SELECT 
                a.global_entity_id,
                a.cost_date_utc,
                a.channel_group,
                a.channel,
                a.channel_subchannel,
                a.platform,
                a.pm_cost_eur,
                b.orders,
                SAFE_DIVIDE(pm_cost_eur, orders) AS pm_costs_per_order 
                FROM (SELECT * FROM pm_cost
                      WHERE channel_group='Acquisition') a 
                LEFT JOIN (SELECT global_entity_id,
                                  created_date_utc,
                                  channel_group,
                                  channel,
                                  channel_subchannel,
                                  platform,
                                  COUNT(DISTINCT order_uid) AS orders
                          FROM pm_orders
                          WHERE channel_group='Acquisition' AND is_acquisition
                          GROUP BY ALL) b 
                    ON a.global_entity_id=b.global_entity_id 
                    AND a.channel_group=b.channel_group  
                    AND a.channel=b.channel 
                    AND a.channel_subchannel=b.channel_subchannel
                    AND a.platform=b.platform 
                    AND a.cost_date_utc=b.created_date_utc),


pm_cost_per_order_exist AS (SELECT 
                a.global_entity_id,
                a.cost_date_utc,
                a.channel_group,
                a.channel,
                a.channel_subchannel,
                a.platform,
                a.pm_cost_eur,
                b.orders,
                SAFE_DIVIDE(pm_cost_eur, orders) AS pm_costs_per_order 
                FROM (SELECT * FROM pm_cost
                      WHERE channel_group<<>>'Acquisition') a 
                LEFT JOIN (SELECT global_entity_id,
                                  created_date_utc,
                                  channel_group,
                                  channel,
                                  channel_subchannel,
                                  platform,
                                  COUNT(DISTINCT order_uid) AS orders
                          FROM pm_orders
                          WHERE NOT is_acquisition
                          GROUP BY ALL) b 
                    ON a.global_entity_id=b.global_entity_id 
                    AND a.channel_group=b.channel_group 
                    AND a.channel=b.channel
                    AND a.channel_subchannel=b.channel_subchannel
                    AND a.platform=b.platform  
                    AND a.cost_date_utc=b.created_date_utc),

hva_orders_acq AS (SELECT 
            a.* except (customer_segment),
            b.channel,
            b.channel_subchannel,
            b.platform,
            CASE WHEN b.order_uid IS NOT NULL THEN 'PM' END AS pm_flag,
            c.pm_costs_per_order,
            CASE WHEN hva_subcategory='Dormant Reactivation' THEN a.customer_segment ELSE '' END AS customer_segment,
            FROM (SELECT * FROM hva_orders_pre WHERE hva_subcategory='Acquisition') a 
            LEFT JOIN (SELECT * FROM pm_orders WHERE channel_group='Acquisition' AND is_acquisition) b 
              ON a.order_uid=b.order_uid
            LEFT JOIN pm_cost_per_order_acq c 
              ON b.global_entity_id=c.global_entity_id 
              AND b.channel_group=c.channel_group
              AND b.channel=c.channel
              AND b.channel_subchannel=c.channel_subchannel
              AND b.platform=c.platform
              AND b.created_date_utc=c.cost_date_utc),

hva_orders_exist AS (SELECT 
            a.* except (customer_segment),
            b.channel,
            b.channel_subchannel,
            b.platform,
            CASE WHEN b.order_uid IS NOT NULL THEN 'PM' END AS pm_flag,
            c.pm_costs_per_order,
            CASE WHEN hva_subcategory='Dormant Reactivation' THEN a.customer_segment ELSE '' END AS customer_segment,
            FROM (SELECT * FROM hva_orders_pre WHERE hva_subcategory<<>>'Acquisition') a 
            LEFT JOIN (SELECT * FROM pm_orders WHERE NOT is_acquisition) b 
              ON a.order_uid=b.order_uid
            LEFT JOIN pm_cost_per_order_exist c 
              ON b.global_entity_id=c.global_entity_id 
              AND b.channel_group=c.channel_group
              AND b.channel=c.channel
              AND b.channel_subchannel=c.channel_subchannel
              AND b.platform=c.platform
              AND b.created_date_utc=c.cost_date_utc),

hva_orders AS (SELECT * FROM hva_orders_acq 
              UNION ALL
              SELECT * FROM hva_orders_exist),

agg AS( 
  SELECT 
    global_entity_id,
    order_uid,
    year_month,
    created_date,
    analytical_customer_id,  
    hva_subcategory, 
    customer_segment,
    channel,
    channel_subchannel,
    purpose,
    ROW_NUMBER() OVER (PARTITION BY analytical_customer_id, year_month, hva_subcategory ORDER BY created_date) AS first_order_rn,
    gmv_net_eur,
    fully_loaded_gross_profit_eur,
    voucher_cost_fp_eur,
    discount_cost_fp_eur,
    marketing_cost_eur,
    total_fdnc_cost_eur,
    total_fd_cost_eur,
    voucher_cost_vf_eur,
    discount_cost_vf_eur,
    marketing_cost_vf_eur,
    discount_cost_vf_eur_excl_pro_fd,  
    marketing_cost_vf_eur_excl_pro_fd,  
    pm_flag,
    COALESCE(pm_costs_per_order,0) AS pm_costs_per_order,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 2592000 FOLLOWING
        ) AS flgp_eur_30d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 2592000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_30d_before,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 5184000 FOLLOWING
        ) AS flgp_eur_60d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 5184000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_60d_before,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 7776000 FOLLOWING
        ) AS flgp_eur_90d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 7776000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_90d_before,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 10368000 FOLLOWING
        ) AS flgp_eur_120d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 10368000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_120d_before,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 12960000 FOLLOWING
        ) AS flgp_eur_150d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 12960000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_150d_before,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 15552000 FOLLOWING
        ) AS flgp_eur_180d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 15552000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_180d_before,

    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 2592000 FOLLOWING
        ) AS gmv_net_eur_30d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 2592000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_30d_before,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 5184000 FOLLOWING
        ) AS gmv_net_eur_60d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 5184000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_60d_before,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 7776000 FOLLOWING
        ) AS gmv_net_eur_90d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 7776000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_90d_before,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 10368000 FOLLOWING
        ) AS gmv_net_eur_120d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 10368000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_120d_before,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 12960000 FOLLOWING
        ) AS gmv_net_eur_150d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 12960000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_150d_before,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 15552000 FOLLOWING
        ) AS gmv_net_eur_180d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 15552000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_180d_before,

    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 2592000 FOLLOWING
        ) AS retained_orders_30d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 2592000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_30d_before,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 5184000 FOLLOWING
        ) AS retained_orders_60d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 5184000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_60d_before,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 7776000 FOLLOWING
        ) AS retained_orders_90d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 7776000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_90d_before,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 10368000 FOLLOWING
        ) AS retained_orders_120d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 10368000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_120d_before,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 12960000 FOLLOWING
        ) AS retained_orders_150d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 12960000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_150d_before,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 15552000 FOLLOWING
        ) AS retained_orders_180d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 15552000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_180d_before
  FROM hva_orders
  GROUP BY ALL
  ORDER BY created_date
)

, summary AS(
  SELECT  
    agg.global_entity_id,
    year_month,  
    hva_subcategory, 
    customer_segment,
    -- channel,
    -- channel_subchannel,
    -- CASE 
    --   WHEN voucher_cost_fp_eur + discount_cost_fp_eur + voucher_cost_vf_eur + discount_cost_vf_eur + total_fdnc_cost_eur + total_fd_cost_eur >>0 AND COALESCE(pm_costs_per_order,0) >>0 THEN 'Incentive + PM'
    --   WHEN voucher_cost_fp_eur + discount_cost_fp_eur + voucher_cost_vf_eur + discount_cost_vf_eur + total_fdnc_cost_eur + total_fd_cost_eur >>0 AND COALESCE(pm_costs_per_order,0)=0 THEN 'Incentive Only'
    --   WHEN voucher_cost_fp_eur + discount_cost_fp_eur + voucher_cost_vf_eur + discount_cost_vf_eur + total_fdnc_cost_eur + total_fd_cost_eur =0 AND COALESCE(pm_costs_per_order,0) >>0 THEN 'PM Only'
    --   WHEN voucher_cost_fp_eur + discount_cost_fp_eur + voucher_cost_vf_eur + discount_cost_vf_eur + total_fdnc_cost_eur + total_fd_cost_eur =0 AND COALESCE(pm_costs_per_order,0)=0 THEN 'Organic' 
    --   END AS category,
    -- CASE 
    --   WHEN voucher_cost_fp_eur + voucher_cost_vf_eur >> 0 THEN "Vouchers"
    --   WHEN discount_cost_fp_eur >> 0 AND discount_cost_vf_eur >> 0 THEN "Co-funded subsidy"
    --   WHEN discount_cost_fp_eur = 0 AND discount_cost_vf_eur >> 0 THEN "Vendor funded incentives"
    --   WHEN discount_cost_fp_eur >> 0 AND discount_cost_vf_eur = 0 THEN "DH funded incentives"
    --   WHEN total_fdnc_cost_eur + total_fd_cost_eur >> 0 THEN "Free Delivery"
    --   END AS sub_category,
    purpose AS voucher_purpose,
    COUNT(DISTINCT agg.order_uid) AS orders,
    COUNT(DISTINCT analytical_customer_id) AS acid,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 THEN analytical_customer_id END) AS acid_first_order,
    SUM(COALESCE(pm_costs_per_order,0)) AS pm_costs_per_order,
    SUM(gmv_net_eur) AS gmv_net_eur,
    SUM(fully_loaded_gross_profit_eur) AS fully_loaded_gross_profit_eur,
    SUM(voucher_cost_fp_eur) AS voucher_cost_fp_eur,
    SUM(discount_cost_fp_eur) AS discount_cost_fp_eur,
    SUM(marketing_cost_eur) AS marketing_cost_eur,
    SUM(total_fdnc_cost_eur) AS total_fdnc_cost_eur,
    SUM(total_fd_cost_eur) AS total_fd_cost_eur,
    SUM(voucher_cost_vf_eur) AS voucher_cost_vf_eur,
    SUM(discount_cost_vf_eur) AS discount_cost_vf_eur,
    SUM(marketing_cost_vf_eur) AS marketing_cost_vf_eur,
    SUM(discount_cost_vf_eur_excl_pro_fd) AS discount_cost_vf_eur_excl_pro_fd,  
    SUM(marketing_cost_vf_eur_excl_pro_fd) AS marketing_cost_vf_eur_excl_pro_fd,  
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_30d END) AS flgp_eur_30d,
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_60d END) AS flgp_eur_60d,
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_90d END) AS flgp_eur_90d,
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_120d END) AS flgp_eur_120d,
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_150d END) AS flgp_eur_150d,
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_180d END) AS flgp_eur_180d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_30d END) AS gmv_net_eur_30d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_60d END) AS gmv_net_eur_60d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_90d END) AS gmv_net_eur_90d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_120d END) AS gmv_net_eur_120d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_150d END) AS gmv_net_eur_150d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_180d END) AS gmv_net_eur_180d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_30d END) AS retained_orders_30d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_60d END) AS retained_orders_60d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_90d END) AS retained_orders_90d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_120d END) AS retained_orders_120d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_150d END) AS retained_orders_150d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_180d END) AS retained_orders_180d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_30d >> 1 THEN analytical_customer_id END) retained_30d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_60d >> 1 THEN analytical_customer_id END) retained_60d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_90d >> 1 THEN analytical_customer_id END) retained_90d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_120d >> 1 THEN analytical_customer_id END) retained_120d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_150d >> 1 THEN analytical_customer_id END) retained_150d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_180d >> 1 THEN analytical_customer_id END) retained_180d,
  FROM agg
  GROUP BY ALL
)

SELECT *
FROM summary
WHERE hva_subcategory = "Acquisition"
  -- AND global_entity_id IN ('FP_BD', 'FP_HK', 'FP_KH', 'FP_LA', 'FP_MM', 'FP_MY', 'FP_PH', 'FP_PK', 'FP_SG', 'FP_TH', 'FP_TW')
  AND global_entity_id = 'FP_PK']]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1arzgz80utruuj16y5doh0w25j3r' name='Custom SQL Query' type='text'><![CDATA[WITH incentives_pre AS (
  SELECT
    a.global_entity_id,
    a.order_code,
    CONCAT(a.global_entity_id,"_",a.order_code) AS order_uid,
    b.dps_customer_tag,
    e.delivery_type,
    IFNULL(e.dps_subscriber_delivery_discount, FALSE) AS dps_subscriber_delivery_discount,
    a.voucher_code,
    IF(c.is_free_delivery_subscription_voucher_order OR c.is_free_delivery_subscription_discount_order, TRUE, FALSE) AS is_free_delivery_subscription_order, 
    COALESCE(c.is_free_delivery_subscription_discount_order, FALSE) AS is_free_delivery_subscription_discount_order,

    a.gfv_eur AS gbv_eur,
    a.gfv_local AS gbv_local,
    CASE
      WHEN a.business_type = "concepts" THEN "SKC"
      WHEN a.business_type = "dmart" THEN "Dmart"
      WHEN a.business_type = "shops" THEN "Shops"
      WHEN a.business_type = "kitchens" THEN "SKC"
      WHEN a.business_type = "pandago" THEN "Pandago"
      WHEN a.business_type = "caterers" THEN "Caterers"
      WHEN a.business_type = "vouchers" THEN "Vouchers"
      WHEN a.delivery_type = "pickup" THEN "Pickup"
    ELSE "Food"
    END AS vertical_per_redemption,
    a.voucher_channel AS channel,
    a.voucher_purpose AS purpose,
    a.voucher_description,
    a.created_date_local,
    s.is_disco_campaign,
    c.is_subscription_discount_order,
    c.is_subscription_voucher_order,
    c.is_subscriber_pickup_order,
    IF(a.voucher_type = "free_delivery", TRUE, FALSE) AS is_fd_voucher, 
    IF(a.discount_type = "free_delivery", TRUE, FALSE) AS is_fd_discount, 
    a.pd_discount_uuid,
    a.pd_voucher_uuid,
    b.dps_basket_value_fee_eur, 
    a.cashback_utilized_amount_eur, 
    f.flgp_platform_eur,
    s.is_corporate_evergreen_voucher,
    p.is_corporate_evergreen_discount,
    COALESCE(m.voucher_cost_eur, 0) AS voucher_cost_eur,
    COALESCE(m.discount_cost_eur, 0) AS discount_cost_eur,

    COALESCE(m.voucher_cost_dh_eur, 0) AS voucher_cost_dh_eur,
    COALESCE(m.discount_cost_dh_eur, 0) AS discount_cost_dh_eur,

    COALESCE(m.voucher_cost_vendor_eur, 0) AS voucher_cost_vendor_eur,
    COALESCE(m.discount_cost_vendor_eur, 0) AS discount_cost_vendor_eur,

    COALESCE(m.pandapro_fd_revenue_reduction_eur, 0) AS pandapro_fd_revenue_reduction_eur,
    COALESCE(m.revenue_reduction_delivery_eur, 0) AS revenue_reduction_delivery_eur,
    a.voucher_budget_channel,
    a.discount_budget_channel,
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS a
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.preprocessing__marketing_hva_apac_costs` m    
         ON a.global_entity_id = m.global_entity_id
        AND a.order_code = m.order_id
        AND m.partition_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.preprocessing__marketing_hva_orders` AS e
         ON a.global_entity_id = e.global_entity_id
        AND a.order_code = e.order_id
        AND e.partition_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_dps` AS b
         ON a.global_entity_id = b.global_entity_id
        AND a.order_code = b.order_code
        AND b.order_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_subscriptions` AS c
         ON a.global_entity_id = c.global_entity_id
        AND a.order_code = c.order_code
        AND c.partition_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_vouchers` AS mic
         ON a.global_entity_id = mic.global_entity_id
        AND a.order_code = mic.order_code
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discounts` AS d
         ON a.global_entity_id = d.global_entity_id
        AND a.pd_discount_uuid = d.uuid
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_marketing_voucher_costs` s
         ON a.global_entity_id = s.global_entity_id
        AND a.order_code = s.order_code
        AND s.created_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_marketing_discount_costs` p
         ON a.global_entity_id = p.global_entity_id
        AND a.order_code = p.order_code
        AND p.created_date_local >>= "2025-01-01"
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_finance_flgp_platform` f 
         ON a.global_entity_id = f.global_entity_id
        AND a.order_code = f.order_code
        AND f.created_date_local >>= "2025-01-01"
  WHERE a.created_date_local >>= "2025-01-01"
    AND a.global_entity_id NOT LIKE "ODR_%"
    AND a.is_successful
),

incentives AS (
  SELECT
    global_entity_id,
    order_code,
    order_uid,
    dps_customer_tag,
    is_free_delivery_subscription_order,
    is_free_delivery_subscription_discount_order,
    delivery_type,
    voucher_code,
    dps_subscriber_delivery_discount,
    gbv_eur,
    gbv_local,
    vertical_per_redemption,
    channel,
    purpose,
    voucher_description,
    created_date_local,
    is_disco_campaign,
    is_subscription_discount_order,
    is_subscription_voucher_order,
    is_subscriber_pickup_order,
    is_fd_voucher,
    is_fd_discount,
    pd_discount_uuid,
    pd_voucher_uuid,
    dps_basket_value_fee_eur,
    cashback_utilized_amount_eur,
    flgp_platform_eur,
    is_corporate_evergreen_voucher,
    is_corporate_evergreen_discount,
    voucher_cost_eur,
    discount_cost_eur,
    voucher_cost_dh_eur,
    discount_cost_dh_eur,
    voucher_cost_vendor_eur,
    discount_cost_vendor_eur,
    pandapro_fd_revenue_reduction_eur,
    revenue_reduction_delivery_eur,
    voucher_budget_channel,
    discount_budget_channel
  FROM incentives_pre
),

cnt_hva as (
  SELECT 
    global_entity_id, 
    order_id, 
    COUNT(order_id) as cnt
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__order_hva_costs`
  WHERE DATE_TRUNC(created_date, month) >>= '2025-01-01'
  GROUP BY ALL
),

pandora_source AS (
  SELECT
    hva.global_entity_id,
    hva.year_month,
    hva.created_date,
    hva.analytical_customer_id,
    hva.hva_subcategory,
    hva.hva_category,
    hva.customer_segment,
    mic.order_uid, 
    mic.vertical_per_redemption,
    mic.voucher_budget_channel, 
    mic.discount_budget_channel,
    mic.purpose,

    CASE WHEN mic.voucher_budget_channel in ('CX Vouchers', 'Corporate Vouchers', 'Employee benefit / internal', 'Rider Vouchers') THEN 'Non-marketing'
        WHEN mic.voucher_budget_channel LIKE 'CRM%' AND mic.vertical_per_redemption in ('Dmart', 'Shops') THEN 'CRM (QC)'
        WHEN mic.voucher_budget_channel LIKE 'CRM%' AND mic.vertical_per_redemption NOT in ('Dmart', 'Shops') THEN 'CRM (non-QC)'
        WHEN mic.voucher_budget_channel in ('PandaPro Benefits') AND hva.dh_mkt_voucher_eur >>0 THEN 'Pro Benefits'
        WHEN mic.voucher_budget_channel in ('Co-funding') THEN 'Co-funding (vouchers)'
        WHEN mic.voucher_budget_channel in ('Traffic-driving Campaign') THEN 'Blockbuster (FP-funded)'
        WHEN mic.voucher_budget_channel in ('Loyalty Programme') THEN 'Loyalty'
        WHEN mic.voucher_budget_channel in ('NC Campaign', 'Refer A Friend') THEN 'NC vouchers'
        WHEN mic.voucher_budget_channel='Product HVA Voucher' THEN 'HVA Voucher'
        WHEN hva.dh_mkt_voucher_eur >>0 THEN 'Other FP-funded'
        END AS voucher_channel_grouped,

    CASE WHEN mic.discount_budget_channel = 'PandaPro Benefits' AND hva.dh_mkt_discount_eur>>0 THEN 'Pro Benefits'
        WHEN mic.discount_cost_dh_eur >> 0 AND mic.discount_cost_dh_eur <<>> mic.discount_cost_eur AND hva.dh_mkt_discount_eur>>0 THEN 'CF deals' 
        WHEN mic.discount_cost_dh_eur >> 0 AND mic.discount_cost_dh_eur = mic.discount_cost_eur AND hva.dh_mkt_discount_eur>>0 THEN 'FPF deals' 
        WHEN mic.discount_cost_dh_eur = 0 AND mic.discount_cost_eur >> 0 AND hva.vendor_mkt_discount_eur>>0 THEN 'VF deals'
        WHEN mic.is_fd_discount THEN 'Free delivery'
        WHEN mic.discount_cost_eur >>0 THEN 'Non-marketing'
        END as deals_channel_grouped,

    --all
    COALESCE(mic.voucher_cost_eur,0) / cnt_hva.cnt AS voucher_cost_eur,
    COALESCE(mic.discount_cost_eur,0) / cnt_hva.cnt AS discount_cost_eur,
    --dh
    COALESCE(mic.voucher_cost_dh_eur,0) / cnt_hva.cnt AS voucher_cost_fp_eur, 
    COALESCE(mic.discount_cost_dh_eur,0) / cnt_hva.cnt AS discount_cost_fp_eur,
    dh_mkt_voucher_eur AS voucher_cost_fp_marketing_eur,
    dh_mkt_discount_eur AS discount_cost_fp_marketing_eur,
    dh_mkt_contribution_excl_fd_eur AS incentive_cost_fp_marketing_eur,
    --vf
    vendor_mkt_voucher_eur AS voucher_cost_vf_eur,--incl
    COALESCE(mic.discount_cost_vendor_eur,0) / cnt_hva.cnt AS discount_cost_vf_eur, 
    COALESCE(mic.discount_cost_vendor_eur, 0) / cnt_hva.cnt + vendor_mkt_voucher_eur AS incentive_cost_vf_eur,
    vendor_mkt_discount_eur AS discount_cost_vf_eur_excl_pro_fd, 
    vendor_mkt_contribution_eur AS incentive_cost_vf_eur_excl_pro_fd,
    --fd
    dh_mkt_fdnc_eur AS total_fdnc_cost_eur,   

    CASE WHEN dh_mkt_fdnc_eur >> 0 THEN 0 
        WHEN mic.global_entity_id = 'FP_SG' AND mic.is_subscription_voucher_order AND mic.is_fd_voucher THEN 0   --remove mistagged pro FD cost for SG QC
        WHEN mic.pandapro_fd_revenue_reduction_eur >> 0 THEN 0
        WHEN mic.is_fd_voucher AND NOT mic.is_subscription_voucher_order AND NOT mic.is_corporate_evergreen_voucher THEN mic.revenue_reduction_delivery_eur
        WHEN mic.is_fd_discount AND NOT mic.is_subscription_discount_order THEN mic.revenue_reduction_delivery_eur
        WHEN ABS(mic.dps_basket_value_fee_eur) >> 0 THEN 0
        WHEN cdbo.is_qcommerce THEN mic.revenue_reduction_delivery_eur
        WHEN cdbo.is_meal_for_one THEN 0
        WHEN mic.revenue_reduction_delivery_eur >> 0 THEN mic.revenue_reduction_delivery_eur
        ELSE 0 END / cnt_hva.cnt as total_fd_cost_eur,

    COALESCE(mic.pandapro_fd_revenue_reduction_eur,0) / cnt_hva.cnt AS pandapro_fd_revenue_reduction_eur, 

    dps_basket_value_fee_eur / cnt_hva.cnt AS basket_df_revenue_reduction_eur,
    cashback_utilized_amount_eur / cnt_hva.cnt AS cashback_utilized_amount_eur,
    gmv_eur AS gmv_net_eur,
    flgp_platform_eur / cnt_hva.cnt AS fully_loaded_gross_profit_eur,

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__order_hva_costs` hva
  LEFT JOIN incentives mic
         ON hva.order_id = mic.order_code
        AND hva.global_entity_id = mic.global_entity_id
        AND mic.created_date_local >>='2025-01-01'
  LEFT JOIN cnt_hva
         ON hva.order_id = cnt_hva.order_id
        AND hva.global_entity_id = cnt_hva.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` cdbo
         ON hva.order_id = cdbo.order_id
        AND cdbo.partition_date_local >>= '2025-01-01'
        AND hva.global_entity_id = cdbo.global_entity_id
  WHERE DATE_TRUNC(hva.created_date, month) >>= '2025-01-01'
),

hva_orders_pre AS (
  SELECT
    global_entity_id,
    order_uid,
    year_month,
    created_date,
    analytical_customer_id,
    purpose,
    CASE 
      WHEN hva_subcategory IN ('Acquisition','Early (Welcome flow)','QC Trial','Dormant Reactivation','QC Early','Infrequent Reactivation','Co-funded','Subscription','Non HVA') THEN hva_subcategory
      WHEN hva_category='Mature' THEN 'Mature' 
      END AS hva_subcategory,
    customer_segment,
    SUM(COALESCE(voucher_cost_fp_eur,0)) as voucher_cost_fp_eur,
    SUM(COALESCE(discount_cost_fp_eur,0)) as discount_cost_fp_eur,
    SUM(COALESCE(CASE WHEN incentive_channel_grouped <<>> 'Non-marketing' THEN incentive_cost_fp_marketing_eur END,0)) AS marketing_cost_eur,
    SUM(COALESCE(CASE WHEN incentive_channel_grouped <<>> 'Non-marketing' THEN total_fdnc_cost_eur END,0)) as total_fdnc_cost_eur,
    SUM(COALESCE(CASE WHEN incentive_channel_grouped <<>> 'Non-marketing' THEN total_fd_cost_eur END,0)) as total_fd_cost_eur,
    SUM(COALESCE(gmv_net_eur,0)) as gmv_net_eur,
    SUM(COALESCE(fully_loaded_gross_profit_eur,0)) as fully_loaded_gross_profit_eur,
    SUM(COALESCE(voucher_cost_vf_eur,0)) as voucher_cost_vf_eur,
    SUM(COALESCE(discount_cost_vf_eur,0)) as discount_cost_vf_eur,
    SUM(COALESCE(incentive_cost_vf_eur,0)) AS marketing_cost_vf_eur,
    SUM(COALESCE(discount_cost_vf_eur_excl_pro_fd,0)) as discount_cost_vf_eur_excl_pro_fd,  
    SUM(COALESCE(incentive_cost_vf_eur_excl_pro_fd,0)) AS marketing_cost_vf_eur_excl_pro_fd,  

  FROM (
    SELECT 
      *,
      CASE 
        WHEN voucher_cost_fp_marketing_eur=0 AND discount_cost_fp_marketing_eur=0 AND total_fdnc_cost_eur >>0 THEN 'FDNC'
        WHEN voucher_cost_fp_marketing_eur=0 AND discount_cost_fp_marketing_eur=0 AND total_fd_cost_eur>>0 THEN 'Free delivery'
        WHEN voucher_cost_fp_marketing_eur=0 AND discount_cost_fp_marketing_eur=0 AND incentive_cost_fp_marketing_eur >>0 THEN 'Cashback'
        WHEN voucher_cost_fp_marketing_eur=0 AND discount_cost_fp_marketing_eur>>0 THEN deals_channel_grouped
        ELSE IFNULL(COALESCE(voucher_channel_grouped, deals_channel_grouped),'Organic') 
        END AS incentive_channel_grouped
      FROM pandora_source
  )
  GROUP BY ALL
),

pm_orders AS (
  SELECT 
    global_entity_id,
    created_date_utc,
    order_uid,
    channel,
    channel_subchannel,
    platform,
    CASE
    WHEN channel_subchannel NOT IN ("APP_BRA", "APP_RMO", "CRM_BRA", "CRM_RMO", "CRM_UNKNOWN", "DISPLAY_BRA", "DISPLAY_RMO",
                          "PAIDSOCIAL_BRA", "PAIDSOCIAL_RMO", "PAIDSOCIAL_UNKNOWN", "REFERRAL", "SEM_RMO",
                          "SOCIALMEDIA_INFLUENCER", "SOCIALMEDIA_ENGAGEMENTNOTPROMOTED", "SOCIALMEDIA_ENGAGEMENTPROMOTED") THEN 'Acquisition'
    ELSE 'Existing' END AS channel_group,
    is_acquisition
  FROM `fulfillment-dwh-production.pandata_report.marketing__performance_channel_orders`
  WHERE created_date_utc >>= '2025-01-01'
    -- AND global_entity_id IN ('FP_BD', 'FP_HK', 'FP_KH', 'FP_LA', 'FP_MM', 'FP_MY', 'FP_PH', 'FP_PK', 'FP_SG', 'FP_TH', 'FP_TW')
    AND channel_subchannel NOT IN ('PROGRAMMATIC_BRA', 'APP_BRA', 'PAIDSOCIAL_BRA', 'DISPLAY_BRA')
    AND channel in ('APP', 'DISPLAY', 'PAIDSOCIAL', 'SEM')
),
            
pm_cost AS (
  SELECT
    global_entity_id,
    cost_date_utc,
    channel,
    channel_subchannel,
    CASE 
      WHEN channel_subchannel NOT IN ("APP_BRA", "APP_RMO", "CRM_BRA", "CRM_RMO", "CRM_UNKNOWN", "DISPLAY_BRA", "DISPLAY_RMO",
                                 "PAIDSOCIAL_BRA", "PAIDSOCIAL_RMO", "PAIDSOCIAL_UNKNOWN", "REFERRAL", "SEM_RMO",
                                 "SOCIALMEDIA_INFLUENCER", "SOCIALMEDIA_ENGAGEMENTNOTPROMOTED", "SOCIALMEDIA_ENGAGEMENTPROMOTED") THEN 'Acquisition'
      ELSE 'Existing' END AS channel_group,
    LOWER(platform) AS platform,
    SUM(cost_eur) AS pm_cost_eur
  FROM `fulfillment-dwh-production.pandata_report.marketing__channel_online_cost`
  WHERE DATE_TRUNC(cost_date_utc, MONTH) >>= "2023-06-01"
    -- AND global_entity_id IN ('FP_BD', 'FP_HK', 'FP_KH', 'FP_LA', 'FP_MM', 'FP_MY', 'FP_PH', 'FP_PK', 'FP_SG', 'FP_TH', 'FP_TW')
    AND channel_subchannel NOT IN ('PROGRAMMATIC_BRA', 'APP_BRA', 'PAIDSOCIAL_BRA', 'DISPLAY_BRA')
    AND channel in ('APP', 'DISPLAY', 'PAIDSOCIAL', 'SEM')
    AND platform NOT IN ("UNSPECIFIED", "Mix")
    AND cost_source NOT IN ("dv360-non-youtube", "dv360-with-youtube")
  GROUP BY ALL
),

pm_cost_per_order_acq AS (SELECT 
                a.global_entity_id,
                a.cost_date_utc,
                a.channel_group,
                a.channel,
                a.channel_subchannel,
                a.platform,
                a.pm_cost_eur,
                b.orders,
                SAFE_DIVIDE(pm_cost_eur, orders) AS pm_costs_per_order 
                FROM (SELECT * FROM pm_cost
                      WHERE channel_group='Acquisition') a 
                LEFT JOIN (SELECT global_entity_id,
                                  created_date_utc,
                                  channel_group,
                                  channel,
                                  channel_subchannel,
                                  platform,
                                  COUNT(DISTINCT order_uid) AS orders
                          FROM pm_orders
                          WHERE channel_group='Acquisition' AND is_acquisition
                          GROUP BY ALL) b 
                    ON a.global_entity_id=b.global_entity_id 
                    AND a.channel_group=b.channel_group  
                    AND a.channel=b.channel 
                    AND a.channel_subchannel=b.channel_subchannel
                    AND a.platform=b.platform 
                    AND a.cost_date_utc=b.created_date_utc),


pm_cost_per_order_exist AS (SELECT 
                a.global_entity_id,
                a.cost_date_utc,
                a.channel_group,
                a.channel,
                a.channel_subchannel,
                a.platform,
                a.pm_cost_eur,
                b.orders,
                SAFE_DIVIDE(pm_cost_eur, orders) AS pm_costs_per_order 
                FROM (SELECT * FROM pm_cost
                      WHERE channel_group<<>>'Acquisition') a 
                LEFT JOIN (SELECT global_entity_id,
                                  created_date_utc,
                                  channel_group,
                                  channel,
                                  channel_subchannel,
                                  platform,
                                  COUNT(DISTINCT order_uid) AS orders
                          FROM pm_orders
                          WHERE NOT is_acquisition
                          GROUP BY ALL) b 
                    ON a.global_entity_id=b.global_entity_id 
                    AND a.channel_group=b.channel_group 
                    AND a.channel=b.channel
                    AND a.channel_subchannel=b.channel_subchannel
                    AND a.platform=b.platform  
                    AND a.cost_date_utc=b.created_date_utc),

hva_orders_acq AS (SELECT 
            a.* except (customer_segment),
            b.channel,
            b.channel_subchannel,
            b.platform,
            CASE WHEN b.order_uid IS NOT NULL THEN 'PM' END AS pm_flag,
            c.pm_costs_per_order,
            CASE WHEN hva_subcategory='Dormant Reactivation' THEN a.customer_segment ELSE '' END AS customer_segment,
            FROM (SELECT * FROM hva_orders_pre WHERE hva_subcategory='Acquisition') a 
            LEFT JOIN (SELECT * FROM pm_orders WHERE channel_group='Acquisition' AND is_acquisition) b 
              ON a.order_uid=b.order_uid
            LEFT JOIN pm_cost_per_order_acq c 
              ON b.global_entity_id=c.global_entity_id 
              AND b.channel_group=c.channel_group
              AND b.channel=c.channel
              AND b.channel_subchannel=c.channel_subchannel
              AND b.platform=c.platform
              AND b.created_date_utc=c.cost_date_utc),

hva_orders_exist AS (SELECT 
            a.* except (customer_segment),
            b.channel,
            b.channel_subchannel,
            b.platform,
            CASE WHEN b.order_uid IS NOT NULL THEN 'PM' END AS pm_flag,
            c.pm_costs_per_order,
            CASE WHEN hva_subcategory='Dormant Reactivation' THEN a.customer_segment ELSE '' END AS customer_segment,
            FROM (SELECT * FROM hva_orders_pre WHERE hva_subcategory<<>>'Acquisition') a 
            LEFT JOIN (SELECT * FROM pm_orders WHERE NOT is_acquisition) b 
              ON a.order_uid=b.order_uid
            LEFT JOIN pm_cost_per_order_exist c 
              ON b.global_entity_id=c.global_entity_id 
              AND b.channel_group=c.channel_group
              AND b.channel=c.channel
              AND b.channel_subchannel=c.channel_subchannel
              AND b.platform=c.platform
              AND b.created_date_utc=c.cost_date_utc),

hva_orders AS (SELECT * FROM hva_orders_acq 
              UNION ALL
              SELECT * FROM hva_orders_exist),

agg AS( 
  SELECT 
    global_entity_id,
    order_uid,
    year_month,
    created_date,
    analytical_customer_id,  
    hva_subcategory, 
    customer_segment,
    channel,
    channel_subchannel,
    purpose,
    ROW_NUMBER() OVER (PARTITION BY analytical_customer_id, year_month, hva_subcategory ORDER BY created_date) AS first_order_rn,
    gmv_net_eur,
    fully_loaded_gross_profit_eur,
    voucher_cost_fp_eur,
    discount_cost_fp_eur,
    marketing_cost_eur,
    total_fdnc_cost_eur,
    total_fd_cost_eur,
    voucher_cost_vf_eur,
    discount_cost_vf_eur,
    marketing_cost_vf_eur,
    discount_cost_vf_eur_excl_pro_fd,  
    marketing_cost_vf_eur_excl_pro_fd,  
    pm_flag,
    COALESCE(pm_costs_per_order,0) AS pm_costs_per_order,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 2592000 FOLLOWING
        ) AS flgp_eur_30d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 2592000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_30d_before,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 5184000 FOLLOWING
        ) AS flgp_eur_60d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 5184000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_60d_before,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 7776000 FOLLOWING
        ) AS flgp_eur_90d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 7776000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_90d_before,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 10368000 FOLLOWING
        ) AS flgp_eur_120d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 10368000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_120d_before,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 12960000 FOLLOWING
        ) AS flgp_eur_150d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 12960000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_150d_before,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 15552000 FOLLOWING
        ) AS flgp_eur_180d,
    SUM(fully_loaded_gross_profit_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 15552000 PRECEDING AND 1 PRECEDING
        ) AS flgp_eur_180d_before,

    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 2592000 FOLLOWING
        ) AS gmv_net_eur_30d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 2592000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_30d_before,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 5184000 FOLLOWING
        ) AS gmv_net_eur_60d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 5184000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_60d_before,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 7776000 FOLLOWING
        ) AS gmv_net_eur_90d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 7776000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_90d_before,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 10368000 FOLLOWING
        ) AS gmv_net_eur_120d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 10368000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_120d_before,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 12960000 FOLLOWING
        ) AS gmv_net_eur_150d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 12960000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_150d_before,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN CURRENT ROW AND 15552000 FOLLOWING
        ) AS gmv_net_eur_180d,
    SUM(gmv_net_eur) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 15552000 PRECEDING AND 1 PRECEDING
        ) AS gmv_net_eur_180d_before,

    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 2592000 FOLLOWING
        ) AS retained_orders_30d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 2592000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_30d_before,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 5184000 FOLLOWING
        ) AS retained_orders_60d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 5184000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_60d_before,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 7776000 FOLLOWING
        ) AS retained_orders_90d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 7776000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_90d_before,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 10368000 FOLLOWING
        ) AS retained_orders_120d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 10368000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_120d_before,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 12960000 FOLLOWING
        ) AS retained_orders_150d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 12960000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_150d_before,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 1 FOLLOWING AND 15552000 FOLLOWING
        ) AS retained_orders_180d,
    COUNT(order_uid) OVER (PARTITION BY analytical_customer_id ORDER BY UNIX_SECONDS(TIMESTAMP(created_date))
          RANGE BETWEEN 15552000 PRECEDING AND 1 PRECEDING
        ) AS retained_orders_180d_before
  FROM hva_orders
  GROUP BY ALL
  ORDER BY created_date
)

, summary AS(
  SELECT  
    agg.global_entity_id,
    year_month,  
    hva_subcategory, 
    customer_segment,
    -- channel,
    -- channel_subchannel,
    -- CASE 
    --   WHEN voucher_cost_fp_eur + discount_cost_fp_eur + voucher_cost_vf_eur + discount_cost_vf_eur + total_fdnc_cost_eur + total_fd_cost_eur >>0 AND COALESCE(pm_costs_per_order,0) >>0 THEN 'Incentive + PM'
    --   WHEN voucher_cost_fp_eur + discount_cost_fp_eur + voucher_cost_vf_eur + discount_cost_vf_eur + total_fdnc_cost_eur + total_fd_cost_eur >>0 AND COALESCE(pm_costs_per_order,0)=0 THEN 'Incentive Only'
    --   WHEN voucher_cost_fp_eur + discount_cost_fp_eur + voucher_cost_vf_eur + discount_cost_vf_eur + total_fdnc_cost_eur + total_fd_cost_eur =0 AND COALESCE(pm_costs_per_order,0) >>0 THEN 'PM Only'
    --   WHEN voucher_cost_fp_eur + discount_cost_fp_eur + voucher_cost_vf_eur + discount_cost_vf_eur + total_fdnc_cost_eur + total_fd_cost_eur =0 AND COALESCE(pm_costs_per_order,0)=0 THEN 'Organic' 
    --   END AS category,
    -- CASE 
    --   WHEN voucher_cost_fp_eur + voucher_cost_vf_eur >> 0 THEN "Vouchers"
    --   WHEN discount_cost_fp_eur >> 0 AND discount_cost_vf_eur >> 0 THEN "Co-funded subsidy"
    --   WHEN discount_cost_fp_eur = 0 AND discount_cost_vf_eur >> 0 THEN "Vendor funded incentives"
    --   WHEN discount_cost_fp_eur >> 0 AND discount_cost_vf_eur = 0 THEN "DH funded incentives"
    --   WHEN total_fdnc_cost_eur + total_fd_cost_eur >> 0 THEN "Free Delivery"
    --   END AS sub_category,
    purpose AS voucher_purpose,
    COUNT(DISTINCT agg.order_uid) AS orders,
    COUNT(DISTINCT analytical_customer_id) AS acid,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 THEN analytical_customer_id END) AS acid_first_order,
    SUM(COALESCE(pm_costs_per_order,0)) AS pm_costs_per_order,
    SUM(gmv_net_eur) AS gmv_net_eur,
    SUM(fully_loaded_gross_profit_eur) AS fully_loaded_gross_profit_eur,
    SUM(voucher_cost_fp_eur) AS voucher_cost_fp_eur,
    SUM(discount_cost_fp_eur) AS discount_cost_fp_eur,
    SUM(marketing_cost_eur) AS marketing_cost_eur,
    SUM(total_fdnc_cost_eur) AS total_fdnc_cost_eur,
    SUM(total_fd_cost_eur) AS total_fd_cost_eur,
    SUM(voucher_cost_vf_eur) AS voucher_cost_vf_eur,
    SUM(discount_cost_vf_eur) AS discount_cost_vf_eur,
    SUM(marketing_cost_vf_eur) AS marketing_cost_vf_eur,
    SUM(discount_cost_vf_eur_excl_pro_fd) AS discount_cost_vf_eur_excl_pro_fd,  
    SUM(marketing_cost_vf_eur_excl_pro_fd) AS marketing_cost_vf_eur_excl_pro_fd,  
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_30d END) AS flgp_eur_30d,
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_60d END) AS flgp_eur_60d,
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_90d END) AS flgp_eur_90d,
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_120d END) AS flgp_eur_120d,
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_150d END) AS flgp_eur_150d,
    SUM(CASE WHEN first_order_rn=1 THEN flgp_eur_180d END) AS flgp_eur_180d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_30d END) AS gmv_net_eur_30d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_60d END) AS gmv_net_eur_60d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_90d END) AS gmv_net_eur_90d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_120d END) AS gmv_net_eur_120d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_150d END) AS gmv_net_eur_150d,
    SUM(CASE WHEN first_order_rn=1 THEN gmv_net_eur_180d END) AS gmv_net_eur_180d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_30d END) AS retained_orders_30d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_60d END) AS retained_orders_60d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_90d END) AS retained_orders_90d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_120d END) AS retained_orders_120d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_150d END) AS retained_orders_150d,
    SUM(CASE WHEN first_order_rn=1 THEN retained_orders_180d END) AS retained_orders_180d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_30d >> 1 THEN analytical_customer_id END) retained_30d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_60d >> 1 THEN analytical_customer_id END) retained_60d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_90d >> 1 THEN analytical_customer_id END) retained_90d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_120d >> 1 THEN analytical_customer_id END) retained_120d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_150d >> 1 THEN analytical_customer_id END) retained_150d,
    COUNT(DISTINCT CASE WHEN first_order_rn=1 AND retained_orders_180d >> 1 THEN analytical_customer_id END) retained_180d,
  FROM agg
  GROUP BY ALL
)

SELECT *
FROM summary
WHERE hva_subcategory = "Acquisition"
  -- AND global_entity_id IN ('FP_BD', 'FP_HK', 'FP_KH', 'FP_LA', 'FP_MM', 'FP_MY', 'FP_PH', 'FP_PK', 'FP_SG', 'FP_TH', 'FP_TW')
  AND global_entity_id = 'FP_PK']]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
