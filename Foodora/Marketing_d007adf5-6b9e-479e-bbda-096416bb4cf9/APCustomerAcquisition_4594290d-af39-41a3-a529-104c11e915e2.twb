      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0kqeil30rxv9cn13ec0vg1pguz06].[pcto:sum:acid:qk:2]&quot;' value='% of Total Customers' />
          <alias key='&quot;[federated.0kqeil30rxv9cn13ec0vg1pguz06].[sum:acid:qk]&quot;' value='Customers' />
        </aliases>
      </column>
      <column caption='Orders / Customers' datatype='real' name='[Calculation_3059844121859145728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/SUM([acid])' />
      </column>
      <column caption='Channel (optional)' datatype='string' name='[Calculation_5712182852431458305]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] THEN [channel] ELSE NULL END' />
      </column>
      <column caption='Hva Subcategory with Segment' datatype='string' name='[Calculation_5892608293133479938]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [hva_subcategory]=&apos;Dormant Reactivation&apos; AND [customer_segment]=&apos;Churned&apos; THEN &apos;Dormant Reactivation-Churned&apos;&#10;ELSEIF [hva_subcategory]=&apos;Dormant Reactivation&apos; AND [customer_segment]=&apos;Inactive&apos; THEN &apos;Dormant Reactivation-Inactive&apos;&#10;ELSEIF [hva_subcategory]=&apos;Dormant Reactivation&apos; AND [customer_segment]=&apos;Lost&apos; THEN &apos;Dormant Reactivation-Lost&apos;&#10;ELSEIF [hva_subcategory]=&apos;Dormant Reactivation&apos; AND ISNULL([customer_segment]) THEN &apos;Dormant Reactivation-Null&apos;&#10;ELSE [hva_subcategory] END' />
      </column>
      <column caption='Cost (PM)' datatype='real' name='[Cost  (copy) (copy)_712413214871400450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pm_costs_per_order])' />
      </column>
      <column caption='Cost  (Incentive)' datatype='real' name='[Cost  (copy)_712413214871396353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([marketing_cost_eur]+[total_fd_cost_eur]+[total_fdnc_cost_eur])' />
      </column>
      <column caption='Net GMV / Customers* ' datatype='real' name='[Cost / Customers (copy)_3059844121863294980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;30 Days&apos; THEN SUM([gmv_net_eur_30d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;60 Days&apos; THEN SUM([gmv_net_eur_60d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;90 Days&apos; THEN SUM([gmv_net_eur_90d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;120 Days&apos; THEN SUM([gmv_net_eur_120d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;150 Days&apos; THEN SUM([gmv_net_eur_150d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;180 Days&apos; THEN SUM([gmv_net_eur_180d])/SUM([acid_first_order])&#10;END' />
      </column>
      <column caption='Cost ' datatype='real' name='[Cost / Customers (copy)_712413214866743296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([marketing_cost_eur]+[total_fd_cost_eur]+[total_fdnc_cost_eur]+zn([pm_costs_per_order]))' />
      </column>
      <column caption='Orders / Customers*' datatype='real' name='[FLGPO* (copy)_5712182852428529664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;30 Days&apos; THEN SUM([retained_orders_30d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;60 Days&apos; THEN SUM([retained_orders_60d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;90 Days&apos; THEN SUM([retained_orders_90d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;120 Days&apos; THEN SUM([retained_orders_120d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;150 Days&apos; THEN SUM([retained_orders_150d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;180 Days&apos; THEN SUM([retained_orders_180d])/SUM([acid_first_order])&#10;END' />
