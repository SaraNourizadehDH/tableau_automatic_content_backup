        <calculation class='tableau' formula='IF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;30 Days&apos; THEN &apos;30 Days&apos;&#10;ELSEIF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;60 Days&apos; THEN &apos;60 Days&apos;&#10;ELSEIF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;90 Days&apos; THEN &apos;90 Days&apos;&#10;ELSEIF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;150 Days&apos; THEN &apos;150 Days&apos;&#10;ELSEIF [Parameters].[Metric Selection (copy)_4756927128371220482]=&apos;180 Days&apos; THEN &apos;180 Days&apos;&#10;END' />
