    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Metric definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/PKCustomerAcquisitionWIP/Metricdefinitions?rev=' id='Metricdefinitions' path='/t/Foodora/workbooks/PKCustomerAcquisitionWIP' revision='' site='Foodora' />
      <style />
      <size maxheight='1800' maxwidth='1000' minheight='1800' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone h='7000' id='3' type-v2='text' w='92400' x='3300' y='4056'>
          <formatted-text>
            <run bold='true' fontcolor='#ff2f92' fontsize='14'>Definitions</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#333333' fontsize='11' underline='true'>HVA definitions</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333'>HVAs are taken from DH table `fulfillment-dwh-production.curated_data_shared_mkt._bima_hva_all_orders`</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#333333'>What are considered HVAs?</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='6667' id='5' type-v2='text' w='92100' x='3100' y='29556'>
          <formatted-text>
            <run bold='true' fontcolor='#333333' fontsize='11' underline='true'>Cost definitions</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333'>What Incentive spends are included in tracking?</run>
          </formatted-text>
        </zone>
        <zone h='15833' id='6' is-centered='0' is-scaled='1' param='Image/Screenshot 2024-10-04 at 10.49.29.png' type-v2='bitmap' w='73600' x='3000' y='11500' />
        <zone h='18500' id='7' is-centered='0' is-scaled='1' param='Image/Screenshot 2024-10-04 at 10.29.15.png' type-v2='bitmap' w='74600' x='3100' y='35944' />
        <zone forceUpdate='true' h='8889' id='1145' type-v2='text' w='92200' x='3200' y='58833'>
          <formatted-text>
            <run bold='true' fontcolor='#333333' fontsize='11' underline='true'>Subcategory definitions</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000'>Each Incentive is classified into one of the following subcategories based on the type of promotion or cost.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000'>Important:</run>
            <run fontcolor='#000000'> The classification follows a </run>
            <run bold='true' fontcolor='#000000'>top-to-bottom priority order</run>
            <run fontcolor='#000000'> — once a condition is met, the remaining rules are not checked.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>For example, if an order has both a voucher and free delivery, it will be classified as </run>
            <run bold='true' fontcolor='#000000'>Vouchers</run>
            <run fontcolor='#000000'> because that rule comes first.</run>
          </formatted-text>
        </zone>
        <zone h='29833' id='1148' is-scaled='1' param='Image/截圖 2025-08-14 下午3.29.39.png' type-v2='bitmap' w='60200' x='3500' y='67444' />
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='1100' minheight='1100' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='1188' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='1187' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone h='7000' id='3' type-v2='text' w='92400' x='3300' y='4056'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ff2f92' fontsize='14'>Definitions</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='11' underline='true'>HVA definitions</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333'>HVAs are taken from DH table `fulfillment-dwh-production.curated_data_shared_mkt._bima_hva_all_orders`</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#333333'>What are considered HVAs?</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='280' h='15833' id='6' is-centered='0' is-fixed='true' is-scaled='1' param='Image/Screenshot 2024-10-04 at 10.49.29.png' type-v2='bitmap' w='73600' x='3000' y='11500'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='6667' id='5' type-v2='text' w='92100' x='3100' y='29556'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333' fontsize='11' underline='true'>Cost definitions</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333'>What Incentive spends are included in tracking?</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='280' h='18500' id='7' is-centered='0' is-fixed='true' is-scaled='1' param='Image/Screenshot 2024-10-04 at 10.29.15.png' type-v2='bitmap' w='74600' x='3100' y='35944'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='8889' id='1145' type-v2='text' w='92200' x='3200' y='58833'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333' fontsize='11' underline='true'>Subcategory definitions</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000'>Each Incentive is classified into one of the following subcategories based on the type of promotion or cost.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>Important:</run>
                    <run fontcolor='#000000'> The classification follows a </run>
                    <run bold='true' fontcolor='#000000'>top-to-bottom priority order</run>
                    <run fontcolor='#000000'> — once a condition is met, the remaining rules are not checked.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>For example, if an order has both a voucher and free delivery, it will be classified as </run>
                    <run bold='true' fontcolor='#000000'>Vouchers</run>
                    <run fontcolor='#000000'> because that rule comes first.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='280' h='29833' id='1148' is-fixed='true' is-scaled='1' param='Image/截圖 2025-08-14 下午3.29.39.png' type-v2='bitmap' w='60200' x='3500' y='67444'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
