    <datasource caption='[SG] Growth Conversion by Zone Level - Dmart' inline='true' name='federated.19nmi421c6ul7117rqgnv03l9fja' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.04b35zb1vehmug0zjcajq1165fhu'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='foodpanda-sg-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='cheryl.yeo@foodpanda.sg' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.04b35zb1vehmug0zjcajq1165fhu' name='Custom SQL Query' type='text'>WITH vendor_codes AS (

  SELECT

    vdr.vendor_code,
    vdr.title AS vendor_name,

  FROM `fulfillment-dwh-production.pandata_curated.vdr_svc_vendors` vdr
  JOIN UNNEST(verticals) verticals

  JOIN `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` vendors
    ON vdr.vendor_code = vendors.vendor_code
    AND vendors.global_entity_id = &apos;FP_SG&apos;
    AND vendors.is_test = FALSE
    AND vendors.is_private = FALSE

  WHERE vdr.global_entity_id = &apos;FP_SG&apos;
    AND verticals.is_main
    AND verticals.global_code IN (&apos;darkstores&apos;)

  QUALIFY ROW_NUMBER() OVER(PARTITION BY vendor_code) = 1

),

ga_sessions AS (

  SELECT

    sessions.*,

  FROM `fulfillment-dwh-production.pandata_report.country_SG_qcommerce_perseus_sessions_pandora` sessions

  WHERE report_date &gt;&gt;= &apos;2023-01-01&apos;

)

SELECT

  report_date AS session_start_date_local,
  report_hour AS hour_,
  customer_location,
  das_zone,
  platform,
  -- COUNT(DISTINCT session_key) AS total_sessions,
  -- COUNT(DISTINCT CASE WHEN ds_transaction &gt;&gt; 0 THEN session_key END) AS total_sessions_w_transaction,

  COUNT(DISTINCT(IF(ds_shop_details_loaded &gt;&gt; 0, session_key, NULL))) AS total_sessions,
  COUNT(DISTINCT(IF((darkstore_shown &gt;&gt; 0 AND sh_shop_list_loaded &gt;&gt; 0) OR (ds_shop_details_loaded &gt;&gt; 0), session_key, NULL))) AS ds_intent_cvr_denom,
  COUNT(DISTINCT(IF(ds_transaction &gt;&gt; 0 AND ((darkstore_shown &gt;&gt; 0 AND sh_shop_list_loaded &gt;&gt; 0) OR (ds_shop_details_loaded &gt;&gt; 0)), session_key, NULL))) AS ds_intent_cvr_num,


FROM ga_sessions

WHERE (ds_shop_details_loaded &gt;&gt; 0 OR ds_add_cart_clicked &gt;&gt; 0 OR ds_cart_loaded &gt;&gt; 0 OR ds_checkout_loaded &gt;&gt; 0 OR ds_transaction &gt;&gt; 0 OR ds_shop_clicked &gt;&gt; 0 OR ds_reorder_clicked &gt;&gt; 0 OR darkstore_shown &gt;&gt; 0 OR hs_darkstore_clicked &gt;&gt; 0)

GROUP BY 1,2,3,4,5</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.04b35zb1vehmug0zjcajq1165fhu' name='Custom SQL Query' type='text'>WITH vendor_codes AS (

  SELECT

    vdr.vendor_code,
    vdr.title AS vendor_name,

  FROM `fulfillment-dwh-production.pandata_curated.vdr_svc_vendors` vdr
  JOIN UNNEST(verticals) verticals

  JOIN `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` vendors
    ON vdr.vendor_code = vendors.vendor_code
    AND vendors.global_entity_id = &apos;FP_SG&apos;
    AND vendors.is_test = FALSE
    AND vendors.is_private = FALSE

  WHERE vdr.global_entity_id = &apos;FP_SG&apos;
    AND verticals.is_main
    AND verticals.global_code IN (&apos;darkstores&apos;)

  QUALIFY ROW_NUMBER() OVER(PARTITION BY vendor_code) = 1

),

ga_sessions AS (

  SELECT

    sessions.*,

  FROM `fulfillment-dwh-production.pandata_report.country_SG_qcommerce_perseus_sessions_pandora` sessions

  WHERE report_date &gt;&gt;= &apos;2023-01-01&apos;

)

SELECT

  report_date AS session_start_date_local,
  report_hour AS hour_,
  customer_location,
  das_zone,
  platform,
  -- COUNT(DISTINCT session_key) AS total_sessions,
  -- COUNT(DISTINCT CASE WHEN ds_transaction &gt;&gt; 0 THEN session_key END) AS total_sessions_w_transaction,

  COUNT(DISTINCT(IF(ds_shop_details_loaded &gt;&gt; 0, session_key, NULL))) AS total_sessions,
  COUNT(DISTINCT(IF((darkstore_shown &gt;&gt; 0 AND sh_shop_list_loaded &gt;&gt; 0) OR (ds_shop_details_loaded &gt;&gt; 0), session_key, NULL))) AS ds_intent_cvr_denom,
  COUNT(DISTINCT(IF(ds_transaction &gt;&gt; 0 AND ((darkstore_shown &gt;&gt; 0 AND sh_shop_list_loaded &gt;&gt; 0) OR (ds_shop_details_loaded &gt;&gt; 0)), session_key, NULL))) AS ds_intent_cvr_num,


FROM ga_sessions

WHERE (ds_shop_details_loaded &gt;&gt; 0 OR ds_add_cart_clicked &gt;&gt; 0 OR ds_cart_loaded &gt;&gt; 0 OR ds_checkout_loaded &gt;&gt; 0 OR ds_transaction &gt;&gt; 0 OR ds_shop_clicked &gt;&gt; 0 OR ds_reorder_clicked &gt;&gt; 0 OR darkstore_shown &gt;&gt; 0 OR hs_darkstore_clicked &gt;&gt; 0)

GROUP BY 1,2,3,4,5</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
