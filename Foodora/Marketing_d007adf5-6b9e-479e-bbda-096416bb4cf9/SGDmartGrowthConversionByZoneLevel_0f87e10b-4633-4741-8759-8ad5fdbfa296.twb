    <worksheet name='Weekly Traffic'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold' fontsize='12'>Weekly Traffic</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[SG] Growth Conversion by Zone Level - Dmart' name='federated.19nmi421c6ul7117rqgnv03l9fja' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Customer Area or DAS Zone?' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;DAS Zone&quot;'>
              <calculation class='tableau' formula='&quot;DAS Zone&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19nmi421c6ul7117rqgnv03l9fja'>
            <column caption='WTD?' datatype='boolean' name='[Calculation_3354689180526071809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_3354689180526149634]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED :MAX([session_start_date_local]) - 1}' />
            </column>
            <column caption='Day of Week' datatype='integer' name='[Calculation_3354689180526280707]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='ISOWEEKDAY([session_start_date_local])' />
            </column>
            <column caption='Zone Name' datatype='string' name='[Calculation_3354689180528164869]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Customer Area&apos; THEN [customer_location]&#10;WHEN &apos;DAS Zone&apos; THEN [das_zone]&#10;&#10;END' />
            </column>
            <column caption='Zone Tier' datatype='string' name='[Calculation_3354689180528418822]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Customer Area&apos; THEN [Customer Area Tier]&#10;WHEN &apos;DAS Zone&apos; THEN [Das Zone Tier]&#10;END' />
            </column>
            <column caption='Traffic - WTD' datatype='integer' name='[Calculation_3354689180529020935]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])&#10;THEN [total_sessions]&#10;END&#10;)}' />
            </column>
            <column caption='Date Cap' datatype='boolean' name='[Calculation_5873467975197597697]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[session_start_date_local] &lt;= [Calculation_3354689180526149634]' />
            </column>
            <column datatype='string' name='[Customer Area Tier]' role='dimension' type='nominal'>
