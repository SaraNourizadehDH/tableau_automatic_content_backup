    <worksheet name='CVR Top N Bottom N'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold' fontsize='12'>CVR Performance (WoW)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[SG] Growth Conversion by Zone Level - Dmart' name='federated.19nmi421c6ul7117rqgnv03l9fja' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Customer Area or DAS Zone?' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;DAS Zone&quot;'>
              <calculation class='tableau' formula='&quot;DAS Zone&quot;' />
            </column>
            <column caption='Top N and Bottom N Selection' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
              <range granularity='1' max='13' min='1' />
            </column>
            <column caption='Last X Weeks' datatype='integer' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <range max='8' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19nmi421c6ul7117rqgnv03l9fja'>
            <column caption='WTD?' datatype='boolean' name='[Calculation_3354689180526071809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])' />
            </column>
            <column caption='Max Date' datatype='date' name='[Calculation_3354689180526149634]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED :MAX([session_start_date_local]) - 1}' />
            </column>
            <column caption='Day of Week' datatype='integer' name='[Calculation_3354689180526280707]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='ISOWEEKDAY([session_start_date_local])' />
            </column>
            <column caption='Zone Name' datatype='string' name='[Calculation_3354689180528164869]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Customer Area&apos; THEN [customer_location]&#10;WHEN &apos;DAS Zone&apos; THEN [das_zone]&#10;&#10;END' />
            </column>
            <column caption='CVR - WTD' datatype='real' name='[Calculation_3354689180530360328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])&#10;THEN [ds_intent_cvr_num]&#10;END&#10;)} / {INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])&#10;THEN [ds_intent_cvr_denom]&#10;END&#10;)}' />
            </column>
            <column caption='Top N and Bottom N Filter' datatype='string' name='[Calculation_3354689180536995849]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF FIRST() &gt; - [Parameters].[Parameter 2]&#10;THEN &apos;Top N&apos;&#10;&#10;ELSEIF last() &lt; [Parameters].[Parameter 2]&#10;THEN &apos;Bottom N&apos;&#10;&#10;ELSE &apos;Others&apos; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CVR - Past X WTD' datatype='real' name='[Calculation_3354689180539510801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=[Parameters].[Parameter 3]&#10;AND DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])&#10;THEN [ds_intent_cvr_num]&#10;END&#10;)} /&#10;{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=[Parameters].[Parameter 3]&#10;AND DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])&#10;THEN [ds_intent_cvr_denom]&#10;END&#10;)}' />
            </column>
            <column caption='WoW Change % Past X Weeks - CVR' datatype='real' name='[Calculation_3354689180541952018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_3354689180530360328]) - SUM([Calculation_3354689180539510801]))' />
            </column>
            <column caption='Customer Location' datatype='string' name='[customer_location]' role='dimension' type='nominal' />
            <column caption='Das Zone' datatype='string' name='[das_zone]' role='dimension' type='nominal' />
            <column datatype='integer' name='[ds_intent_cvr_denom]' role='measure' type='quantitative' />
            <column datatype='integer' name='[ds_intent_cvr_num]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3354689180526071809]' derivation='None' name='[none:Calculation_3354689180526071809:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3354689180526280707]' derivation='None' name='[none:Calculation_3354689180526280707:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_3354689180528164869]' derivation='None' name='[none:Calculation_3354689180528164869:nk]' pivot='key' type='nominal' />
            <column caption='Session Start Date Local' datatype='date' name='[session_start_date_local]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_3354689180536995849]' derivation='User' name='[usr:Calculation_3354689180536995849:nk:3]' pivot='key' type='nominal'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column-instance column='[Calculation_3354689180541952018]' derivation='User' name='[usr:Calculation_3354689180541952018:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
