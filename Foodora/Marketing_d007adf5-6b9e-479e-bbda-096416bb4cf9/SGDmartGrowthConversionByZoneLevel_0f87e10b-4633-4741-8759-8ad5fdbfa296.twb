      <aliases enabled='yes' />
      <column caption='CVR - Past Full Week' datatype='real' name='[CVR - PWTD (copy)_3813422988046626819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=1&#10;THEN ds_intent_cvr_num&#10;END&#10;)} / {INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=1&#10;THEN [ds_intent_cvr_denom]&#10;END&#10;)}' />
      </column>
      <column caption='CVR' datatype='real' name='[Calculation_3354689180525744128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ds_intent_cvr_num) / sum([ds_intent_cvr_denom])' />
      </column>
      <column caption='WTD?' datatype='boolean' name='[Calculation_3354689180526071809]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])' />
      </column>
      <column caption='Max Date' datatype='date' name='[Calculation_3354689180526149634]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED :MAX([session_start_date_local]) - 1}' />
      </column>
      <column caption='Day of Week' datatype='integer' name='[Calculation_3354689180526280707]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='ISOWEEKDAY([session_start_date_local])' />
      </column>
      <column caption='Zone Name' datatype='string' name='[Calculation_3354689180528164869]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Customer Area&apos; THEN [customer_location]&#10;WHEN &apos;DAS Zone&apos; THEN [das_zone]&#10;&#10;END' />
      </column>
      <column caption='Zone Tier' datatype='string' name='[Calculation_3354689180528418822]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Customer Area&apos; THEN [Customer Area Tier]&#10;WHEN &apos;DAS Zone&apos; THEN [Das Zone Tier]&#10;END' />
      </column>
      <column caption='Traffic - WTD' datatype='integer' name='[Calculation_3354689180529020935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])&#10;THEN [total_sessions]&#10;END&#10;)}' />
      </column>
      <column caption='CVR - WTD' datatype='real' name='[Calculation_3354689180530360328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])&#10;THEN [ds_intent_cvr_num]&#10;END&#10;)} / {INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])&#10;THEN [ds_intent_cvr_denom]&#10;END&#10;)}' />
      </column>
      <column caption='Top N and Bottom N Filter' datatype='string' name='[Calculation_3354689180536995849]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF FIRST() &gt; - [Parameters].[Parameter 2]&#10;THEN &apos;Top N&apos;&#10;&#10;ELSEIF last() &lt; [Parameters].[Parameter 2]&#10;THEN &apos;Bottom N&apos;&#10;&#10;ELSE &apos;Others&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Traffic - PWTD' datatype='integer' name='[Calculation_3354689180537307146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=1&#10;AND DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])&#10;THEN [total_sessions]&#10;END&#10;)}' />
      </column>
      <column caption='CVR - PWTD' datatype='real' name='[Calculation_3354689180537413643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=1&#10;AND DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])&#10;THEN [ds_intent_cvr_num]&#10;END&#10;)} / {INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=1&#10;AND DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])&#10;THEN [ds_intent_cvr_denom]&#10;END&#10;)}' />
      </column>
      <column caption='Traffic - Past X WTD' datatype='integer' name='[Calculation_3354689180539326480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=[Parameters].[Parameter 3]&#10;AND DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])&#10;THEN [total_sessions]&#10;END&#10;)}' />
      </column>
      <column caption='CVR - Past X WTD' datatype='real' name='[Calculation_3354689180539510801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=[Parameters].[Parameter 3]&#10;AND DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])&#10;THEN [ds_intent_cvr_num]&#10;END&#10;)} /&#10;{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[session_start_date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_3354689180526149634]))})=[Parameters].[Parameter 3]&#10;AND DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])&#10;THEN [ds_intent_cvr_denom]&#10;END&#10;)}' />
      </column>
      <column caption='WoW Change % Past X Weeks - CVR' datatype='real' name='[Calculation_3354689180541952018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_3354689180530360328]) - SUM([Calculation_3354689180539510801]))' />
      </column>
      <column caption='WoW Change % Past X Weeks - Traffic' datatype='real' name='[Calculation_3354689180542255124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_3354689180529020935]) - SUM([Calculation_3354689180539326480]))/ SUM([Calculation_3354689180539326480])' />
      </column>
      <column caption='Traffic - Parameter' datatype='integer' name='[Calculation_3813422988041715713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;&#10;WHEN &quot;Current Week&quot; THEN [Calculation_3354689180529020935]&#10;WHEN &quot;Last Week&quot; THEN [Traffic - PWTD (copy)_3813422988044324866]&#10;&#10;END' />
      </column>
      <column caption='Date Cap' datatype='boolean' name='[Calculation_5873467975197597697]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[session_start_date_local] &lt;= [Calculation_3354689180526149634]' />
      </column>
      <column datatype='string' name='[Customer Area Tier]' role='dimension' type='nominal'>
