      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Customer Area or DAS Zone?' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;DAS Zone&quot;'>
          <calculation class='tableau' formula='&quot;DAS Zone&quot;' />
          <members>
            <member value='&quot;Customer Area&quot;' />
            <member value='&quot;DAS Zone&quot;' />
          </members>
        </column>
        <column caption='Top N and Bottom N Selection' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='5'>
          <calculation class='tableau' formula='5' />
          <range granularity='1' max='13' min='1' />
        </column>
        <column caption='Date Period' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Current Week&quot;'>
          <calculation class='tableau' formula='&quot;Current Week&quot;' />
          <members>
            <member value='&quot;Current Week&quot;' />
            <member value='&quot;Last Week&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.19nmi421c6ul7117rqgnv03l9fja'>
        <column caption='WTD?' datatype='boolean' name='[Calculation_3354689180526071809]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[session_start_date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_3354689180526149634])' />
        </column>
        <column caption='Day of Week' datatype='integer' name='[Calculation_3354689180526280707]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='ISOWEEKDAY([session_start_date_local])' />
        </column>
        <column datatype='string' name='[Time of Day]' role='dimension' type='nominal'>
          <calculation class='categorical-bin' column='[hour_]' new-bin='true'>
            <bin default-name='false' value='&quot;Breakfast&quot;'>
              <value>7</value>
              <value>8</value>
              <value>9</value>
              <value>10</value>
            </bin>
            <bin default-name='false' value='&quot;Dinner&quot;'>
              <value>17</value>
              <value>18</value>
              <value>19</value>
            </bin>
            <bin default-name='false' value='&quot;Lunch&quot;'>
              <value>11</value>
              <value>12</value>
              <value>13</value>
            </bin>
            <bin default-name='false' value='&quot;Supper&quot;'>
              <value>20</value>
              <value>21</value>
              <value>22</value>
              <value>23</value>
            </bin>
            <bin default-name='false' value='&quot;Teabreak&quot;'>
              <value>14</value>
              <value>15</value>
              <value>16</value>
            </bin>
            <bin default-name='false' value='&quot;Wee hours&quot;'>
              <value>0</value>
              <value>1</value>
              <value>2</value>
              <value>3</value>
              <value>4</value>
              <value>5</value>
              <value>6</value>
            </bin>
          </calculation>
        </column>
        <column aggregation='Sum' caption='Hour' datatype='integer' name='[hour_]' role='dimension' type='ordinal' />
