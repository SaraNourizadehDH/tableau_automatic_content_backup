              <calculation class='tableau' formula='DATE(if [Parameters].[Parameter 1] = &quot;Monthly&quot; then [ordered_date]&#10;elseif [Parameters].[Parameter 1] = &quot;Quarterly&quot; then DATETRUNC(&apos;quarter&apos;, [ordered_date])&#10;elseif [Parameters].[Parameter 1] = &quot;Yearly&quot; then DATETRUNC(&apos;year&apos;, [ordered_date]) end)' />
