    <worksheet name='Cohort Retention Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#f5388f' fontname='Tableau Book' fontsize='22'>PARTNER RETENTION PERFORMANCE</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Affiliate Report' name='federated.1rpovv617trehn1g3a6k61b2s554' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Cohort Breakdown' datatype='string' name='[Breakdown (copy)_397724172766969856]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Publisher Name Top N Parameter Cohort' datatype='integer' name='[Publisher Name Top N Parameter (copy)_5523102054254866434]' param-domain-type='range' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <range granularity='10' max='50' min='10' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rpovv617trehn1g3a6k61b2s554'>
            <column caption='retention rate' datatype='real' name='[Calculation_3057521975529922562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ATTR([months_since_acquisition]) = 0, NULL,&#10;SUM([customers])/&#10;SUM({ FIXED [market], [customer_type], [cohort_month], [Calculation_397724172767473665]: SUM(iIF([months_since_acquisition] = 0, [customers], 0)) })&#10;)' />
            </column>
            <column caption='Cohort Breakdown' datatype='string' name='[Calculation_397724172767473665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Breakdown (copy)_397724172766969856]&#10;WHEN &quot;Country&quot; THEN [market]&#10;WHEN &quot;Partner&quot; THEN [publisher_name (Custom SQL Query5)]&#10;END' />
            </column>
            <column datatype='integer' name='[cohort_acquisitions]' role='measure' type='quantitative' />
            <column datatype='date' name='[cohort_month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[customer_type]' role='dimension' type='nominal' />
            <column datatype='integer' name='[customers]' role='measure' type='quantitative' />
            <column datatype='string' name='[market]' role='dimension' type='nominal' />
            <column datatype='integer' name='[months_since_acquisition]' role='measure' type='ordinal' />
            <column-instance column='[Calculation_397724172767473665]' derivation='None' name='[none:Calculation_397724172767473665:nk]' pivot='key' type='nominal' />
            <column-instance column='[cohort_month]' derivation='None' name='[none:cohort_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[customer_type]' derivation='None' name='[none:customer_type:nk]' pivot='key' type='nominal' />
