    <datasource caption='Affiliate Acquisition Fraud' inline='true' name='federated.0mziw3v0fxjjvj1amtqoc0dbdik5' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1pq3so61flu3d018xh5np1j31ihq'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='APAC Data Production' schema='pandata_ap_mktg' server-oauth='' username='joshua.yeo@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1pq3so61flu3d018xh5np1j31ihq' name='Custom SQL Query' type='text'>SELECT 
  conversion_date,
  global_entity_id,
  country_name,
  country,
  publisher_name,
  email_domain,
  city_name,
  vertical,
  chain_name,
  vendor_name,
  is_incentivised_order,
  count(distinct pd_customer_uuid) as acquisitions,
  sum(partnerize_order_value_eur) AS order_value_eur,
  sum(partnerize_commission_eur) AS cost_eur,
  SUM(gmv_eur) AS gmv_eur
 FROM `fulfillment-dwh-production.pandata_report.regional_apac_online_affiliate_report`
WHERE conversion_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR)
  AND is_acquisition_fraud
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1pq3so61flu3d018xh5np1j31ihq' name='Custom SQL Query' type='text'>SELECT 
  conversion_date,
  global_entity_id,
  country_name,
  country,
  publisher_name,
  email_domain,
  city_name,
  vertical,
  chain_name,
  vendor_name,
  is_incentivised_order,
  count(distinct pd_customer_uuid) as acquisitions,
  sum(partnerize_order_value_eur) AS order_value_eur,
  sum(partnerize_commission_eur) AS cost_eur,
  SUM(gmv_eur) AS gmv_eur
 FROM `fulfillment-dwh-production.pandata_report.regional_apac_online_affiliate_report`
WHERE conversion_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR)
  AND is_acquisition_fraud
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
