      <aliases enabled='yes' />
      <column caption='-&gt; reacq %' datatype='real' name='[-&gt; acquisition % (copy)_3205577820219535372]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reacquisitions])/SUM([orders])' />
      </column>
      <column caption='-&gt; reacq cost %' datatype='real' name='[-&gt; ec cost % (copy)_3205577819255255040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reacq_cost_eur])/SUM([cost_eur])' />
      </column>
      <column caption='-&gt; nc %' datatype='real' datatype-customized='true' name='[-&gt; nc cost % (copy)_3205577820219408395]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM([acquisitions])/SUM([orders])' />
      </column>
      <column caption='-&gt; other cost %' datatype='real' name='[-&gt; nc cost % (copy)_397724172783263749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([cost_eur]) - IFNULL(SUM([nc_cost_eur]), 0)  - IFNULL(SUM([reacq_cost_eur]),0)) /SUM([cost_eur])' />
      </column>
      <column caption='-&gt; other orders % ' datatype='real' name='[-&gt; reacq % (copy)_3205577820219711501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders]) - SUM([acquisitions]) - SUM([reacquisitions]))/SUM([orders])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1rpovv617trehn1g3a6k61b2s554].[pcdf:sum:acquisitions:qk]&quot;' value='%Δ in Acquisitions' />
