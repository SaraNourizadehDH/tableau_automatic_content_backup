      <column caption='region' datatype='string' name='[Calculation_4090675862243733505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;APAC&quot;' />
      </column>
      <column caption='MoM Customers % Diff' datatype='real' name='[Calculation_4268779194656866304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([customers])) - LOOKUP(ZN(SUM([customers])), -1)) / ABS(LOOKUP(ZN(SUM([customers])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Positive MoM Customers (#) % Diff' datatype='string' name='[Calculation_4268779194657697793]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4268779194656866304] &gt; 0 &#10;THEN &quot;▲&quot; + &quot; &quot; + STR(ROUND([Calculation_4268779194656866304] *100,2)) + &quot;%&quot; &#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Trend MoM Customers (#) % Diff' datatype='string' name='[Calculation_4268779194658410498]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4268779194656866304] &lt; 0 &#10;THEN &quot;▼&quot; + &quot; &quot; + STR(ROUND([Calculation_4268779194656866304]*-100,2)) + &quot;%&quot; &#10;ELSE &quot;▲&quot; + &quot; &quot; + STR(ROUND([Calculation_4268779194656866304] *100,2)) + &quot;%&quot; &#10;&#10;END'>
          <table-calc ordering-type='Rows' />
