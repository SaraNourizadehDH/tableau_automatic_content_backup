    <worksheet name='Overview Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='Affiliate Report' name='federated.1rpovv617trehn1g3a6k61b2s554' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension2' datatype='string' name='[Dimension 1 (copy)_3205577819329892358]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Dimension3' datatype='string' name='[Dimension2 (copy)_752523398535532544]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Period' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Dimension1' datatype='string' name='[Period (copy)_3205577819329712133]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rpovv617trehn1g3a6k61b2s554'>
            <column caption='-&gt; reacq %' datatype='real' name='[-&gt; acquisition % (copy)_3205577820219535372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reacquisitions])/SUM([orders])' />
            </column>
            <column caption='-&gt; reacq cost %' datatype='real' name='[-&gt; ec cost % (copy)_3205577819255255040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reacq_cost_eur])/SUM([cost_eur])' />
            </column>
            <column caption='-&gt; nc %' datatype='real' datatype-customized='true' name='[-&gt; nc cost % (copy)_3205577820219408395]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SUM([acquisitions])/SUM([orders])' />
            </column>
            <column caption='-&gt; other cost %' datatype='real' name='[-&gt; nc cost % (copy)_397724172783263749]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([cost_eur]) - IFNULL(SUM([nc_cost_eur]), 0)  - IFNULL(SUM([reacq_cost_eur]),0)) /SUM([cost_eur])' />
            </column>
            <column caption='-&gt; other orders % ' datatype='real' name='[-&gt; reacq % (copy)_3205577820219711501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders]) - SUM([acquisitions]) - SUM([reacquisitions]))/SUM([orders])' />
            </column>
            <column caption='BLANK1' datatype='integer' name='[BLANK (copy)_397724172783431686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='CPAR' datatype='real' default-format='c&quot; €&quot;#,##0.00;-&quot; €&quot;#,##0.00' name='[CPA (copy)_3205577819321630721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cost_eur])/(SUM([acquisitions]) + sum([reacquisitions]))' />
            </column>
            <column caption='CPA' datatype='real' default-format='c&quot; €&quot;#,##0.00;-&quot; €&quot;#,##0.00' name='[Calculation_147633663238516736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cost_eur])/SUM([acquisitions])' />
            </column>
            <column caption='Period' datatype='datetime' name='[Calculation_2034078946102345728]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;&#10;When &apos;Daily&apos; then DATETRUNC(&apos;day&apos;,[conversion_date])&#10;&#10;When &apos;Weekly&apos; then DATETRUNC(&apos;week&apos;,[conversion_date])&#10;&#10;When &apos;Monthly&apos; then DATETRUNC(&apos;month&apos;,[conversion_date])&#10;&#10;When &apos;Quarterly&apos; then DATETRUNC(&apos;quarter&apos;,[conversion_date])&#10;&#10;When &apos;Yearly&apos; then DATETRUNC(&apos;year&apos;,[conversion_date])&#10;&#10;end' />
            </column>
            <column caption='other orders' datatype='real' name='[Calculation_3205577820209041418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders]) - sum([acquisitions]) - sum([reacquisitions])' />
            </column>
            <column caption='other cost eur' datatype='real' name='[Calculation_3205577820225355792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost_eur]) - IFNULL(SUM([nc_cost_eur]), 0)  - IFNULL(SUM([reacq_cost_eur]),0)' />
            </column>
            <column caption='BLANK' datatype='integer' name='[Calculation_397724172777275395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='-&gt; nc cost %' datatype='real' name='[Calculation_397724172782804996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([nc_cost_eur]), 0)/SUM([cost_eur])' />
            </column>
            <column caption='region' datatype='string' name='[Calculation_4090675862243733505]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;APAC&quot;' />
