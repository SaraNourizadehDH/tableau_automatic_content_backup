        </calculation>
      </column>
      <column caption='Cohort Breakdown' datatype='string' name='[Calculation_397724172767473665]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Breakdown (copy)_397724172766969856]&#10;WHEN &quot;Country&quot; THEN [market]&#10;WHEN &quot;Partner&quot; THEN [publisher_name (Custom SQL Query5)]&#10;END' />
