      </column>
      <column caption='dimension1' datatype='string' name='[Cohort Metric (copy)_3205577819330093063]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Period (copy)_3205577819329712133]&#10;WHEN &quot;Country&quot; THEN [country_name]&#10;WHEN &quot;Platform&quot; THEN [platform]&#10;WHEN &quot;Partner&quot; THEN [publisher_name]&#10;END' />
