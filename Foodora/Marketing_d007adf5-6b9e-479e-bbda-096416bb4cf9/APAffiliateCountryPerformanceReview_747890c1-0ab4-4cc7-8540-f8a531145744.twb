      <column caption='Orders (Partnerize) vs Country' datatype='real' default-format='p0.00%' name='[Acquisitions (LC) Share (vs Country) (copy)_1254674747037253634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / SUM([country_orders])' />
      </column>
      <column caption='BLANK1' datatype='integer' name='[BLANK (copy)_397724172783431686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='CPAR' datatype='real' default-format='c&quot; €&quot;#,##0.00;-&quot; €&quot;#,##0.00' name='[CPA (copy)_3205577819321630721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cost_eur])/(SUM([acquisitions]) + sum([reacquisitions]))' />
      </column>
      <column caption='Acquisitions Metric' datatype='real' name='[CPA Metric (copy)_3205577819325677572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[CPA Metric (copy)_3205577819325542403]&#10;WHEN &quot;acquisitions&quot; THEN SUM([acquisitions])&#10;WHEN &quot;reacquisitions&quot; THEN SUM([reacquisitions])&#10;WHEN &quot;accquisitions + reacquisitions&quot; THEN SUM([acquisitions]) + SUM([reacquisitions])&#10;END' />
      </column>
      <column caption='conversion rate' datatype='real' name='[Calculation_1254674746971152385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / SUM([clicks])' />
      </column>
      <column caption='CPA' datatype='real' default-format='c&quot; €&quot;#,##0.00;-&quot; €&quot;#,##0.00' name='[Calculation_147633663238516736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cost_eur])/SUM([acquisitions])' />
      </column>
      <column caption='NC_Share (Partnerize)' datatype='real' default-format='p0.00%' name='[Calculation_147633663293792258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acquisitions]) / SUM([orders])' />
      </column>
      <column caption='Acquisitions (Partnerize) vs Country' datatype='real' default-format='p0.00%' name='[Calculation_147633663328649221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acquisitions]) / SUM([country_acquisitions])' />
      </column>
      <column caption='Period' datatype='datetime' name='[Calculation_2034078946102345728]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;&#10;When &apos;Daily&apos; then DATETRUNC(&apos;day&apos;,[conversion_date])&#10;&#10;When &apos;Weekly&apos; then DATETRUNC(&apos;week&apos;,[conversion_date])&#10;&#10;When &apos;Monthly&apos; then DATETRUNC(&apos;month&apos;,[conversion_date])&#10;&#10;When &apos;Quarterly&apos; then DATETRUNC(&apos;quarter&apos;,[conversion_date])&#10;&#10;When &apos;Yearly&apos; then DATETRUNC(&apos;year&apos;,[conversion_date])&#10;&#10;end' />
      </column>
      <column caption='Order Frequency' datatype='real' name='[Calculation_2303661616603144192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;30D&quot; THEN SUM([orders_30D])/SUM([cohort_acquisitions])&#10;WHEN &quot;60D&quot; THEN SUM([orders_60D])/SUM([cohort_acquisitions])&#10;WHEN &quot;90D&quot; THEN SUM([orders_90D])/SUM([cohort_acquisitions])&#10;END' />
      </column>
      <column caption='GMV ROI' datatype='real' name='[Calculation_2303661616603521025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;30D&quot; THEN SUM([gmv_eur_30D])/SUM([cost_eur])&#10;WHEN &quot;60D&quot; THEN SUM([gmv_eur_60D])/SUM([cost_eur])&#10;WHEN &quot;90D&quot; THEN SUM([gmv_eur_90D])/SUM([cost_eur])&#10;END' />
      </column>
      <column caption='Breakdown' datatype='string' name='[Calculation_3057521975527567360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &quot;Country&quot; THEN [country_name]&#10;WHEN &quot;Partner&quot; THEN [publisher_name]&#10;END' />
      </column>
      <column caption='retention rate' datatype='real' name='[Calculation_3057521975529922562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(ATTR([months_since_acquisition]) = 0, NULL,&#10;SUM([customers])/&#10;SUM({ FIXED [market], [customer_type], [cohort_month], [Calculation_397724172767473665]: SUM(iIF([months_since_acquisition] = 0, [customers], 0)) })&#10;)' />
      </column>
      <column caption='other orders' datatype='real' name='[Calculation_3205577820209041418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders]) - sum([acquisitions]) - sum([reacquisitions])' />
      </column>
      <column caption='other cost eur' datatype='real' name='[Calculation_3205577820225355792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cost_eur]) - IFNULL(SUM([nc_cost_eur]), 0)  - IFNULL(SUM([reacq_cost_eur]),0)' />
      </column>
      <column caption='Sort' datatype='integer' name='[Calculation_3348778167029366784]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='RANK(SUM([orders]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_3489656454469627904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
