      <datasource-dependencies datasource='Parameters'>
        <column caption='Period' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
          <calculation class='tableau' formula='&quot;Monthly&quot;' />
        </column>
        <column caption='Fraud Parameter' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
          <calculation class='tableau' formula='&quot;Country&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Acquisition Fraud' id='_B06B4602AEB848D2917F8201E8C42083'>
            <properties context=''>
              <relation connection='bigquery.1pq3so61flu3d018xh5np1j31ihq' name='Custom SQL Query' type='text'>SELECT 
  conversion_date,
  global_entity_id,
  country_name,
  country,
  publisher_name,
  email_domain,
  city_name,
  vertical,
  chain_name,
  vendor_name,
  is_incentivised_order,
  count(distinct pd_customer_uuid) as acquisitions,
  sum(partnerize_order_value_eur) AS order_value_eur,
  sum(partnerize_commission_eur) AS cost_eur,
  SUM(gmv_eur) AS gmv_eur
 FROM `fulfillment-dwh-production.pandata_report.regional_apac_online_affiliate_report`
WHERE conversion_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR)
  AND is_acquisition_fraud
GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Affiliate Report' inline='true' name='federated.1rpovv617trehn1g3a6k61b2s554' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.17suo131ljjeyt12kxpvu1vhsbvp'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='joshua.yeo@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.17suo131ljjeyt12kxpvu1vhsbvp' name='Custom SQL Query' type='text'>WITH marketing_orders AS (
SELECT  
   created_date_local AS conversion_date,
   global_entity_id,
   UPPER(country_code_iso) AS country,
   country_name,
   IF(frontend_client_type IN (&quot;android&quot;, &quot;ios&quot;), frontend_client_type, &quot;web&quot;) AS platform,
   IF(is_voucher_used OR is_discount_used, TRUE, FALSE) AS is_incentivised_order,
   COUNT(DISTINCT CASE WHEN is_acquisition THEN order_uid END) AS country_acquisitions,
   COUNT(DISTINCT order_uid) AS country_orders
FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` 
WHERE created_date_local  &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR)
 AND region = &quot;Asia&quot;
 AND business_type NOT IN (&quot;laas&quot;)
 AND is_successful
GROUP BY ALL
),


affiliate_campaign_mapping AS (
SELECT DISTINCT
  global_entity_id,
  country_name,
  country,
  publisher_name,
  campaign
 FROM `fulfillment-dwh-production.pandata_report.regional_apac_online_affiliate_report`
),

bima_orders AS (
SELECT
  order_date AS conversion_date,
  CASE
     WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_bd\\_|\\[bd\\_|\\(bd\\_|bd\\_smallsmartbanner|\\[bd\\_smallsmartbanner|\\(bd\\_smallsmartbanner|bd\\_email|\\(bd\\_email|\\[bd\\_email|\\_bd$&quot;) THEN &quot;FP_BD&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_hk\\_|\\[hk\\_|\\(hk\\_|hk\\_smallsmartbanner|\\[hk\\_smallsmartbanner|\\(hk\\_smallsmartbanner|hk\\_email|\\(hk\\_email|\\[hk\\_email|\\_hk$&quot;) THEN &quot;FP_HK&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_kh\\_|\\[kh\\_|\\(kh\\_|kh\\_email|\\(kh\\_email|\\[kh\\_email|\\_kh$&quot;) THEN &quot;FP_KH&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_la\\_|\\[la\\_|\\(la\\_|la\\_email|\\(la\\_email|\\[la\\_email|\\_la$&quot;) THEN &quot;FP_LA&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_mm\\_|\\[mm\\_|\\(mm\\_|mm\\_email|\\(mm\\_email|\\[mm\\_email|\\_mm$&quot;) THEN &quot;FP_MM&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_my\\_|\\[my\\_|\\(my\\_|my\\_smallsmartbanner|\\[my\\_smallsmartbanner|\\(my\\_smallsmartbanner|my\\_email|\\(my\\_email|\\[my\\_email|\\_my$&quot;) THEN &quot;FP_MY&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_ph\\_|\\[ph\\_|\\(ph\\_|ph\\_smallsmartbanner|\\[ph\\_smallsmartbanner|\\(ph\\_smallsmartbanner|ph\\_email|\\(ph\\_email|\\[ph\\_email|\\_ph$&quot;) THEN &quot;FP_PH&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_pk\\_|\\[pk\\_|\\(pk\\_|pk\\_smallsmartbanner|\\[pk\\_smallsmartbanner|\\(pk\\_smallsmartbanner|pk\\_email|\\(pk\\_email|\\[pk\\_email|\\_pk$&quot;) THEN &quot;FP_PK&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_sg\\_|\\[sg\\_|\\(sg\\_|sg\\_smallsmartbanner|\\[sg\\_smallsmartbanner|\\(sg\\_smallsmartbanner|sg\\_email|\\(sg\\_email|\\[pk\\_email|\\_sg$&quot;) THEN &quot;FP_SG&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_th\\_|\\[th\\_|\\(th\\_|th\\_smallsmartbanner|\\[th\\_smallsmartbanner|\\(th\\_smallsmartbanner|th\\_email|\\(th\\_email|\\[th\\_email|\\_th$&quot;) THEN &quot;FP_TH&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_tw\\_|\\[tw\\_|\\(tw\\_|tw\\_smallsmartbanner|\\[tw\\_smallsmartbanner|\\(tw\\_smallsmartbanner|tw\\_email|\\(tw\\_email|\\[tw\\_email|\\_tw$&quot;) THEN &quot;FP_TW&quot;
      ELSE global_entity_id
  END AS global_entity_id,
  campaign,
  IF(platform IN (&quot;android&quot;, &quot;ios&quot;), platform, &quot;web&quot;) AS platform,
  ROUND(SUM(acquisitions_calibration_ios14fix)) AS acquisitions
FROM `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_orders` 
WHERE order_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR)
  and channel_subchannel = &quot;AFFILIATE&quot;
GROUP BY ALL
),

affiliate_report AS (
SELECT 
  conversion_date,
  global_entity_id,
  country_name,
  country,
  publisher_name,
  platform,
  is_incentivised_order,
  count(distinct case when is_reacquisition then order_uid end) as reacquisitions,
  count(distinct order_uid) AS orders,
  sum(case when customer_type = &apos;new&apos; then partnerize_commission_eur end) AS nc_cost_eur,
  sum(case when customer_type = &apos;existing&apos; then partnerize_commission_eur end) AS ec_cost_eur,
  sum(case when is_reacquisition then partnerize_commission_eur end) AS reacq_cost_eur,
  sum(partnerize_commission_eur) AS cost_eur,
  sum(gmv_eur) AS gmv_eur
 FROM `fulfillment-dwh-production.pandata_report.regional_apac_online_affiliate_report` AS aff
WHERE conversion_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR)
  AND is_approved
GROUP BY ALL
),

final AS (
SELECT DATE_TRUNC(conversion_date, MONTH) as month,
       conversion_date,
       global_entity_id,
       country_name,
       country,
       publisher_name,
       platform,
       is_incentivised_order,
       NULL AS acquisitions,
       reacquisitions,
       orders,
       nc_cost_eur,
       ec_cost_eur,
       reacq_cost_eur,
       cost_eur,
       gmv_eur,
       NULL AS country_acquisitions,
       NULL AS country_orders
FROM affiliate_report


UNION ALL
SELECT  DATE_TRUNC(bima_orders.conversion_date, MONTH) as month,
       bima_orders.conversion_date,
       bima_orders.global_entity_id,
       affiliate_campaign_mapping.country_name,
       affiliate_campaign_mapping.country,
       affiliate_campaign_mapping.publisher_name,
       bima_orders.platform,
       FALSE AS is_incentivised_order,
       acquisitions,
       NULL AS reacquisitions,
       NULL AS orders,
       NULL AS nc_cost_eur,
       NULL AS ec_cost_eur,
       NULL AS reacq_cost_eur,
       NULL AS cost_eur,
       NULL AS gmv_eur,
       NULL AS country_acquisitions,
       NULL AS country_orders
FROM bima_orders
INNER JOIN affiliate_campaign_mapping
        ON bima_orders.global_entity_id = affiliate_campaign_mapping.global_entity_id
       AND bima_orders.campaign = affiliate_campaign_mapping.campaign

UNION ALL
SELECT  DATE_TRUNC(conversion_date, MONTH) as month,
       conversion_date,
       global_entity_id,
       country_name,
       country,
       NULL AS publisher_name,
       platform,
       is_incentivised_order,
       NULL AS acquisitions,
       NULL AS reacquisitions,
       NULL AS orders,
       NULL AS nc_cost_eur,
       NULL AS ec_cost_eur,
       NULL AS reacq_cost_eur,
       NULL AS cost_eur,
       NULL AS gmv_eur,
       country_acquisitions,
       country_orders
FROM marketing_orders
)

SELECT  month,
       conversion_date,
       global_entity_id,
       country_name,
       country,
       publisher_name,
       platform,
       is_incentivised_order,
       SUM(acquisitions) AS acquisitions,
       SUM(reacquisitions) AS reacquisitions,
       SUM(orders) AS orders,
       SUM(nc_cost_eur) AS nc_cost_eur,
       SUM(ec_cost_eur) AS ec_cost_eur,
       SUM(reacq_cost_eur) AS reacq_cost_eur,
       SUM(cost_eur) AS cost_eur,
       SUM(gmv_eur) AS gmv_eur,
       SUM(country_acquisitions) AS country_acquisitions,
       SUM(country_orders) AS country_orders
FROM final
GROUP BY ALL
HAVING orders &gt;&gt; 0</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.17suo131ljjeyt12kxpvu1vhsbvp' name='Custom SQL Query' type='text'>WITH marketing_orders AS (
SELECT  
   created_date_local AS conversion_date,
   global_entity_id,
   UPPER(country_code_iso) AS country,
   country_name,
   IF(frontend_client_type IN (&quot;android&quot;, &quot;ios&quot;), frontend_client_type, &quot;web&quot;) AS platform,
   IF(is_voucher_used OR is_discount_used, TRUE, FALSE) AS is_incentivised_order,
   COUNT(DISTINCT CASE WHEN is_acquisition THEN order_uid END) AS country_acquisitions,
   COUNT(DISTINCT order_uid) AS country_orders
FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` 
WHERE created_date_local  &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR)
 AND region = &quot;Asia&quot;
 AND business_type NOT IN (&quot;laas&quot;)
 AND is_successful
GROUP BY ALL
),


affiliate_campaign_mapping AS (
SELECT DISTINCT
  global_entity_id,
  country_name,
  country,
  publisher_name,
  campaign
 FROM `fulfillment-dwh-production.pandata_report.regional_apac_online_affiliate_report`
),

bima_orders AS (
SELECT
  order_date AS conversion_date,
  CASE
     WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_bd\\_|\\[bd\\_|\\(bd\\_|bd\\_smallsmartbanner|\\[bd\\_smallsmartbanner|\\(bd\\_smallsmartbanner|bd\\_email|\\(bd\\_email|\\[bd\\_email|\\_bd$&quot;) THEN &quot;FP_BD&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_hk\\_|\\[hk\\_|\\(hk\\_|hk\\_smallsmartbanner|\\[hk\\_smallsmartbanner|\\(hk\\_smallsmartbanner|hk\\_email|\\(hk\\_email|\\[hk\\_email|\\_hk$&quot;) THEN &quot;FP_HK&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_kh\\_|\\[kh\\_|\\(kh\\_|kh\\_email|\\(kh\\_email|\\[kh\\_email|\\_kh$&quot;) THEN &quot;FP_KH&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_la\\_|\\[la\\_|\\(la\\_|la\\_email|\\(la\\_email|\\[la\\_email|\\_la$&quot;) THEN &quot;FP_LA&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_mm\\_|\\[mm\\_|\\(mm\\_|mm\\_email|\\(mm\\_email|\\[mm\\_email|\\_mm$&quot;) THEN &quot;FP_MM&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_my\\_|\\[my\\_|\\(my\\_|my\\_smallsmartbanner|\\[my\\_smallsmartbanner|\\(my\\_smallsmartbanner|my\\_email|\\(my\\_email|\\[my\\_email|\\_my$&quot;) THEN &quot;FP_MY&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_ph\\_|\\[ph\\_|\\(ph\\_|ph\\_smallsmartbanner|\\[ph\\_smallsmartbanner|\\(ph\\_smallsmartbanner|ph\\_email|\\(ph\\_email|\\[ph\\_email|\\_ph$&quot;) THEN &quot;FP_PH&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_pk\\_|\\[pk\\_|\\(pk\\_|pk\\_smallsmartbanner|\\[pk\\_smallsmartbanner|\\(pk\\_smallsmartbanner|pk\\_email|\\(pk\\_email|\\[pk\\_email|\\_pk$&quot;) THEN &quot;FP_PK&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_sg\\_|\\[sg\\_|\\(sg\\_|sg\\_smallsmartbanner|\\[sg\\_smallsmartbanner|\\(sg\\_smallsmartbanner|sg\\_email|\\(sg\\_email|\\[pk\\_email|\\_sg$&quot;) THEN &quot;FP_SG&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_th\\_|\\[th\\_|\\(th\\_|th\\_smallsmartbanner|\\[th\\_smallsmartbanner|\\(th\\_smallsmartbanner|th\\_email|\\(th\\_email|\\[th\\_email|\\_th$&quot;) THEN &quot;FP_TH&quot;
    WHEN REGEXP_CONTAINS(LOWER(campaign), &quot;\\_tw\\_|\\[tw\\_|\\(tw\\_|tw\\_smallsmartbanner|\\[tw\\_smallsmartbanner|\\(tw\\_smallsmartbanner|tw\\_email|\\(tw\\_email|\\[tw\\_email|\\_tw$&quot;) THEN &quot;FP_TW&quot;
      ELSE global_entity_id
  END AS global_entity_id,
  campaign,
  IF(platform IN (&quot;android&quot;, &quot;ios&quot;), platform, &quot;web&quot;) AS platform,
  ROUND(SUM(acquisitions_calibration_ios14fix)) AS acquisitions
FROM `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_orders` 
WHERE order_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR)
  and channel_subchannel = &quot;AFFILIATE&quot;
GROUP BY ALL
),

affiliate_report AS (
SELECT 
  conversion_date,
  global_entity_id,
  country_name,
  country,
  publisher_name,
  platform,
  is_incentivised_order,
  count(distinct case when is_reacquisition then order_uid end) as reacquisitions,
  count(distinct order_uid) AS orders,
  sum(case when customer_type = &apos;new&apos; then partnerize_commission_eur end) AS nc_cost_eur,
  sum(case when customer_type = &apos;existing&apos; then partnerize_commission_eur end) AS ec_cost_eur,
  sum(case when is_reacquisition then partnerize_commission_eur end) AS reacq_cost_eur,
  sum(partnerize_commission_eur) AS cost_eur,
  sum(gmv_eur) AS gmv_eur
 FROM `fulfillment-dwh-production.pandata_report.regional_apac_online_affiliate_report` AS aff
WHERE conversion_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR)
  AND is_approved
GROUP BY ALL
),

final AS (
SELECT DATE_TRUNC(conversion_date, MONTH) as month,
       conversion_date,
       global_entity_id,
       country_name,
       country,
       publisher_name,
       platform,
       is_incentivised_order,
       NULL AS acquisitions,
       reacquisitions,
       orders,
       nc_cost_eur,
       ec_cost_eur,
       reacq_cost_eur,
       cost_eur,
       gmv_eur,
       NULL AS country_acquisitions,
       NULL AS country_orders
FROM affiliate_report


UNION ALL
SELECT  DATE_TRUNC(bima_orders.conversion_date, MONTH) as month,
       bima_orders.conversion_date,
       bima_orders.global_entity_id,
       affiliate_campaign_mapping.country_name,
       affiliate_campaign_mapping.country,
       affiliate_campaign_mapping.publisher_name,
       bima_orders.platform,
       FALSE AS is_incentivised_order,
       acquisitions,
       NULL AS reacquisitions,
       NULL AS orders,
       NULL AS nc_cost_eur,
       NULL AS ec_cost_eur,
       NULL AS reacq_cost_eur,
       NULL AS cost_eur,
       NULL AS gmv_eur,
       NULL AS country_acquisitions,
       NULL AS country_orders
FROM bima_orders
INNER JOIN affiliate_campaign_mapping
        ON bima_orders.global_entity_id = affiliate_campaign_mapping.global_entity_id
       AND bima_orders.campaign = affiliate_campaign_mapping.campaign

UNION ALL
SELECT  DATE_TRUNC(conversion_date, MONTH) as month,
       conversion_date,
       global_entity_id,
       country_name,
       country,
       NULL AS publisher_name,
       platform,
       is_incentivised_order,
       NULL AS acquisitions,
       NULL AS reacquisitions,
       NULL AS orders,
       NULL AS nc_cost_eur,
       NULL AS ec_cost_eur,
       NULL AS reacq_cost_eur,
       NULL AS cost_eur,
       NULL AS gmv_eur,
       country_acquisitions,
       country_orders
FROM marketing_orders
)

SELECT  month,
       conversion_date,
       global_entity_id,
       country_name,
       country,
       publisher_name,
       platform,
       is_incentivised_order,
       SUM(acquisitions) AS acquisitions,
       SUM(reacquisitions) AS reacquisitions,
       SUM(orders) AS orders,
       SUM(nc_cost_eur) AS nc_cost_eur,
       SUM(ec_cost_eur) AS ec_cost_eur,
       SUM(reacq_cost_eur) AS reacq_cost_eur,
       SUM(cost_eur) AS cost_eur,
       SUM(gmv_eur) AS gmv_eur,
       SUM(country_acquisitions) AS country_acquisitions,
       SUM(country_orders) AS country_orders
FROM final
GROUP BY ALL
HAVING orders &gt;&gt; 0</relation>
          <relation connection='bigquery.17suo131ljjeyt12kxpvu1vhsbvp' name='Custom SQL Query5' type='text'><![CDATA[WITH users AS (
SELECT 
   DATE_TRUNC(conversion_date, MONTH) AS cohort_month,
   conversion_date,
   global_entity_id,
   country,
   country_name,
   publisher_name,
   IF(is_acquisition, "new", "existing") AS customer_type,
   analytical_customer_id,
   pd_customer_uuid,
   order_uid
FROM `fulfillment-dwh-production.pandata_report.regional_apac_online_affiliate_report` 
WHERE conversion_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR)
  AND is_approved
QUALIFY ROW_NUMBER() OVER (PARTITION BY cohort_month, customer_type, pd_customer_uuid) = 1 
),


marketing_incentive_cost AS (
  SELECT 
      created_date_utc,
      pd_customer_uuid,
      order_uid,
      user_paid_gmv_eur AS gmv_eur
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` 
  WHERE created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR)
    AND region = "Asia"
    AND is_successful
),


transactions AS (
  SELECT
    users.global_entity_id,
    users.conversion_date,
    users.country,
    users.country_name,
    users.publisher_name,
    users.customer_type,
    users.analytical_customer_id,
    users.pd_customer_uuid,
    users.cohort_month,
    IF(users.customer_type = "new" AND users.order_uid = marketing_incentive_cost.order_uid, TRUE, FALSE) AS is_acquisition,
    marketing_incentive_cost.order_uid,
    marketing_incentive_cost.created_date_utc,
    DATETIME_DIFF(marketing_incentive_cost.created_date_utc, users.cohort_month, MONTH) AS months_since_acquisition,
    DATETIME_DIFF(marketing_incentive_cost.created_date_utc, users.conversion_date, DAY) AS days_since_acquisition,
    marketing_incentive_cost.gmv_eur
  FROM users
  LEFT JOIN marketing_incentive_cost
         ON marketing_incentive_cost.pd_customer_uuid = users.pd_customer_uuid 
  QUALIFY ROW_NUMBER() OVER (PARTITION BY marketing_incentive_cost.order_uid ORDER BY marketing_incentive_cost.created_date_utc DESC) = 1 
),

user_cohort AS (
  SELECT
    cohort_month,
    CAST(NULL AS DATE) AS conversion_date,
    global_entity_id,
    country,
    country_name,
    publisher_name,
    customer_type,
    months_since_acquisition,
    COUNT(DISTINCT pd_customer_uuid) AS customers,
    COUNT(DISTINCT order_uid) AS orders,
    SUM(gmv_eur) AS gmv_eur
  FROM transactions
  WHERE months_since_acquisition BETWEEN 0 AND 6
  GROUP BY
    cohort_month,
    conversion_date,
    global_entity_id,
    country,
    country_name,
    publisher_name,
    customer_type,
    months_since_acquisition
),

user_transactions AS (
  SELECT
    cohort_month,
    conversion_date,
    global_entity_id,
    country,
    country_name,
    publisher_name,
    customer_type,
    COUNT(DISTINCT CASE WHEN is_acquisition THEN pd_customer_uuid END) AS cohort_acquisitions,
    COUNT(DISTINCT CASE WHEN days_since_acquisition <<= 30 THEN order_uid END) AS orders_30D,
    COUNT(DISTINCT CASE WHEN days_since_acquisition <<= 60 THEN order_uid END) AS orders_60D,
    COUNT(DISTINCT CASE WHEN days_since_acquisition <<= 90 THEN order_uid END) AS orders_90D,
    SUM(CASE WHEN days_since_acquisition <<= 30 THEN gmv_eur END) AS gmv_eur_30D,
    SUM(CASE WHEN days_since_acquisition <<= 60 THEN gmv_eur END) AS gmv_eur_60D,
    SUM(CASE WHEN days_since_acquisition <<= 90 THEN gmv_eur END) AS gmv_eur_90D
  FROM transactions
  WHERE customer_type = "new"
  GROUP BY
    cohort_month,
    conversion_date,
    global_entity_id,
    country,
    country_name,
    publisher_name,
    customer_type
   
   UNION ALL
    SELECT
      cohort_month,
      conversion_date,
      global_entity_id,
      country,
      country_name,
      publisher_name,
      customer_type,
      0 AS cohort_acquisitions,
      0 AS orders_30D,
      0 AS orders_60D,
      0 AS orders_90D,
      0 AS gmv_eur_30D,
      0 AS gmv_eur_60D,
      0 AS gmv_eur_90D
  FROM transactions
  WHERE customer_type = "existing"

),

all_data AS (
 SELECT
    cohort_month,
    conversion_date,
    global_entity_id,
    country,
    country_name,
    publisher_name,
    customer_type,
    months_since_acquisition,
    customers,
    orders,
    gmv_eur,
    NULL AS cohort_acquisitions,
    NULL AS orders_30D,
    NULL AS orders_60D,
    NULL AS orders_90D,
    NULL AS gmv_eur_30D,
    NULL AS gmv_eur_60D,
    NULL AS gmv_eur_90D
  FROM user_cohort
 
 UNION ALL
 SELECT
    cohort_month,
    conversion_date,
    global_entity_id,
    country,
    country_name,
    publisher_name,
    customer_type,
    NULL AS months_since_acquisition,
    NULL AS customers,
    NULL AS orders,
    NULL AS gmv_eur,
    cohort_acquisitions,
    orders_30D,
    orders_60D,
    orders_90D,
    gmv_eur_30D,
    gmv_eur_60D,
    gmv_eur_90D
  FROM user_transactions
)

  SELECT
    cohort_month,
    conversion_date AS cohort_date,
    global_entity_id,
    country AS country_iso,
    country_name AS market,
    publisher_name,
    customer_type,
    months_since_acquisition,
    SUM(customers) AS customers,
    SUM(orders) AS orders,
    SUM(gmv_eur) AS gmv_eur,
    SUM(cohort_acquisitions) AS cohort_acquisitions,
    SUM(orders_30D) AS orders_30D,
    SUM(orders_60D) AS orders_60D,
    SUM(orders_90D) AS orders_90D,
    SUM(gmv_eur_30D) AS gmv_eur_30D,
    SUM(gmv_eur_60D) AS gmv_eur_60D,
    SUM(gmv_eur_90D) AS gmv_eur_90D
  FROM all_data
  GROUP BY ALL]]></relation>
          <relation connection='bigquery.17suo131ljjeyt12kxpvu1vhsbvp' name='Custom SQL Query1' type='text'>SELECT
   DATE_TRUNC(pz_clicks.date_local, MONTH) AS month,
   pz_clicks.date_local AS conversion_date,
   shared_countries.global_entity_id,
   shared_countries.country_code_iso AS country,
   shared_countries.name AS country_name,
   pz_clicks.publisher_name,
   COUNT(DISTINCT pz_clicks.click_ref_id) AS clicks
 FROM `fulfillment-dwh-production.pandata_curated.partnerize_brand_click` AS pz_clicks
 INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON UPPER(partnerize_campaign_country_code_iso) = UPPER(shared_countries.country_code_iso)
        AND shared_countries.region = &quot;Asia&quot;
        AND shared_countries.company_name = &quot;Foodpanda&quot;
 WHERE pz_clicks.date_local &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 YEAR), YEAR)
GROUP BY ALL</relation>
