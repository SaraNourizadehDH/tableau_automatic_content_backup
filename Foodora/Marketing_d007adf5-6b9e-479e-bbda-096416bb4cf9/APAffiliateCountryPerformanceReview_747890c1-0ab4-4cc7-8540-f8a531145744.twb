          <formatted-text>
            <run bold='true' fontcolor='#f5388f'>Cost vs Acquisitions Metric</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Affiliate Report' name='federated.1rpovv617trehn1g3a6k61b2s554' />
