      <column caption='-&gt; nc cost %' datatype='real' name='[Calculation_397724172782804996]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([nc_cost_eur]), 0)/SUM([cost_eur])' />
