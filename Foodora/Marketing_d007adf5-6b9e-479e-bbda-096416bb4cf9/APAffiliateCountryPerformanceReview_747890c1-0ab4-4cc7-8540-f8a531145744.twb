  <worksheets>
    <worksheet name='Acquisitions Chart Period'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#f5388f'>Acquisitions vs CPA</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Affiliate Report' name='federated.1rpovv617trehn1g3a6k61b2s554' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Period' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rpovv617trehn1g3a6k61b2s554'>
            <column caption='CPA' datatype='real' default-format='c&quot; €&quot;#,##0.00;-&quot; €&quot;#,##0.00' name='[Calculation_147633663238516736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cost_eur])/SUM([acquisitions])' />
            </column>
            <column caption='Period' datatype='datetime' name='[Calculation_2034078946102345728]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;&#10;When &apos;Daily&apos; then DATETRUNC(&apos;day&apos;,[conversion_date])&#10;&#10;When &apos;Weekly&apos; then DATETRUNC(&apos;week&apos;,[conversion_date])&#10;&#10;When &apos;Monthly&apos; then DATETRUNC(&apos;month&apos;,[conversion_date])&#10;&#10;When &apos;Quarterly&apos; then DATETRUNC(&apos;quarter&apos;,[conversion_date])&#10;&#10;When &apos;Yearly&apos; then DATETRUNC(&apos;year&apos;,[conversion_date])&#10;&#10;end' />
            </column>
            <column datatype='real' default-format='n#,##0;-#,##0' name='[acquisitions]' role='measure' type='quantitative' />
            <column datatype='date' name='[conversion_date]' role='dimension' type='ordinal' />
            <column datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[cost_eur]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[conversion_date]' derivation='None' name='[none:conversion_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[acquisitions]' derivation='Sum' name='[sum:acquisitions:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2034078946102345728]' derivation='Day-Trunc' name='[tdy:Calculation_2034078946102345728:ok]' pivot='key' type='ordinal' />
            <column-instance column='[conversion_date]' derivation='Month-Trunc' name='[tmn:conversion_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[conversion_date]' derivation='Month-Trunc' name='[tmn:conversion_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_147633663238516736]' derivation='User' name='[usr:Calculation_147633663238516736:qk]' pivot='key' type='quantitative' />
            <column-instance column='[conversion_date]' derivation='Year' name='[yr:conversion_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1rpovv617trehn1g3a6k61b2s554].[none:conversion_date:qk]' filter-group='12' included-values='non-null' />
          <filter class='categorical' column='[federated.1rpovv617trehn1g3a6k61b2s554].[none:country_name:nk]' filter-group='28'>
            <groupfilter function='level-members' level='[none:country_name:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1rpovv617trehn1g3a6k61b2s554].[none:global_entity_id:nk]' filter-group='38'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:global_entity_id:nk]' />
              <groupfilter function='member' level='[none:global_entity_id:nk]' member='%null%' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1rpovv617trehn1g3a6k61b2s554].[tmn:conversion_date:ok]' filter-group='11'>
            <groupfilter function='level-members' level='[tmn:conversion_date:ok]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.1rpovv617trehn1g3a6k61b2s554].[tmn:conversion_date:qk]' included-values='in-range' />
          <filter class='categorical' column='[federated.1rpovv617trehn1g3a6k61b2s554].[yr:conversion_date:ok]' filter-group='3'>
            <groupfilter function='level-members' level='[yr:conversion_date:ok]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
