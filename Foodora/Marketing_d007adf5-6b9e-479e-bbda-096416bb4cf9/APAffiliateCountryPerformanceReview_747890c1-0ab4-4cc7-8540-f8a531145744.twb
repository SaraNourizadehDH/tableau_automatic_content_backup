            <column caption='Acquisitions Metric' datatype='string' name='[CPA Metric (copy)_3205577819325542403]' param-domain-type='list' role='measure' type='nominal' value='&quot;acquisitions&quot;'>
              <calculation class='tableau' formula='&quot;acquisitions&quot;' />
            </column>
            <column caption='Period' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='CPA Metric' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;CPA&quot;'>
              <calculation class='tableau' formula='&quot;CPA&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rpovv617trehn1g3a6k61b2s554'>
            <column caption='CPAR' datatype='real' default-format='c&quot; €&quot;#,##0.00;-&quot; €&quot;#,##0.00' name='[CPA (copy)_3205577819321630721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cost_eur])/(SUM([acquisitions]) + sum([reacquisitions]))' />
            </column>
            <column caption='Acquisitions Metric' datatype='real' name='[CPA Metric (copy)_3205577819325677572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[CPA Metric (copy)_3205577819325542403]&#10;WHEN &quot;acquisitions&quot; THEN SUM([acquisitions])&#10;WHEN &quot;reacquisitions&quot; THEN SUM([reacquisitions])&#10;WHEN &quot;accquisitions + reacquisitions&quot; THEN SUM([acquisitions]) + SUM([reacquisitions])&#10;END' />
            </column>
            <column caption='CPA' datatype='real' default-format='c&quot; €&quot;#,##0.00;-&quot; €&quot;#,##0.00' name='[Calculation_147633663238516736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cost_eur])/SUM([acquisitions])' />
            </column>
            <column caption='Period' datatype='datetime' name='[Calculation_2034078946102345728]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;&#10;When &apos;Daily&apos; then DATETRUNC(&apos;day&apos;,[conversion_date])&#10;&#10;When &apos;Weekly&apos; then DATETRUNC(&apos;week&apos;,[conversion_date])&#10;&#10;When &apos;Monthly&apos; then DATETRUNC(&apos;month&apos;,[conversion_date])&#10;&#10;When &apos;Quarterly&apos; then DATETRUNC(&apos;quarter&apos;,[conversion_date])&#10;&#10;When &apos;Yearly&apos; then DATETRUNC(&apos;year&apos;,[conversion_date])&#10;&#10;end' />
            </column>
