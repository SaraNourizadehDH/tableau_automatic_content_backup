      <column caption='Cohort Metric' datatype='real' name='[GMV Eur per customer (copy)_2045689830306938881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Customer Value Parameter (copy)_2045689830305017856]&#10;WHEN &quot;Customers&quot; THEN SUM([customers])&#10;WHEN &quot;Orders&quot; THEN SUM([orders (Custom SQL Query5)])&#10;WHEN &quot;GMV Eur&quot; THEN SUM([gmv_eur (Custom SQL Query5)])&#10;WHEN &quot;Order Frequency&quot; THEN SUM([orders (Custom SQL Query5)])/SUM([customers])&#10;WHEN &quot;GMV Eur per Customer&quot; THEN SUM([gmv_eur (Custom SQL Query5)])/SUM([customers])&#10;END' />
      </column>
      <column caption='MoM Cohort Metric % Diff' datatype='real' name='[MoM Customers % Diff (copy)_2045689830314770434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Customer Value Parameter (copy)_2045689830305017856]&#10;WHEN &quot;Customers&quot; THEN&#10;(ZN(SUM([customers])) - LOOKUP(ZN(SUM([customers])), -1)) / ABS(LOOKUP(ZN(SUM([customers])), -1))&#10;WHEN &quot;Orders&quot; THEN&#10;(ZN(SUM([orders (Custom SQL Query5)])) - LOOKUP(ZN(SUM([orders (Custom SQL Query5)])), -1)) / ABS(LOOKUP(ZN(SUM([orders (Custom SQL Query5)])), -1))&#10;WHEN &quot;GMV Eur&quot; THEN&#10;(ZN(SUM([gmv_eur (Custom SQL Query5)])) - LOOKUP(ZN(SUM([gmv_eur (Custom SQL Query5)])), -1)) / ABS(LOOKUP(ZN(SUM([gmv_eur (Custom SQL Query5)])), -1))&#10;WHEN &quot;Orders per Customer&quot; THEN&#10;(ZN(SUM([orders (Custom SQL Query5)])/SUM([customers])) - LOOKUP(ZN(SUM([orders (Custom SQL Query5)])/SUM([customers])), -1)) / ABS(LOOKUP(ZN(SUM([orders (Custom SQL Query5)])/SUM([customers])), -1))&#10;WHEN &quot;GMV Eur per Customer&quot; THEN&#10;(ZN(SUM([gmv_eur (Custom SQL Query5)])/SUM([customers])) - LOOKUP(ZN(SUM([gmv_eur (Custom SQL Query5)])/SUM([customers])), -1)) / ABS(LOOKUP(ZN(SUM([gmv_eur (Custom SQL Query5)])/SUM([customers])), -1))&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
