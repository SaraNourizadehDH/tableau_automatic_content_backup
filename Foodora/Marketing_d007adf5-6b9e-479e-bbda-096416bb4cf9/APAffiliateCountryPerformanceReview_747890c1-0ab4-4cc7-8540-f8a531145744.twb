    <worksheet name='CPA vs CLV'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Verdana' fontsize='10'>*Hover over the circle to view more detail about the publisher</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Verdana' fontsize='10'>*GMV Eur Per Customer: Cumulative 30D/60D/90D GMV per customer from the cohort month </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Verdana' fontsize='10'>*Note that recent months may not have sufficient 60D/90D data. </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Affiliate Report' name='federated.1rpovv617trehn1g3a6k61b2s554' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Customer Value Parameter' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;30D&quot;'>
              <calculation class='tableau' formula='&quot;30D&quot;' />
            </column>
            <column caption='Publisher Name Top N Parameter Cohort' datatype='integer' name='[Publisher Name Top N Parameter (copy)_5523102054254866434]' param-domain-type='range' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <range granularity='10' max='50' min='10' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rpovv617trehn1g3a6k61b2s554'>
            <column caption='CPA' datatype='real' default-format='c&quot; €&quot;#,##0.00;-&quot; €&quot;#,##0.00' name='[Calculation_147633663238516736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cost_eur])/SUM([acquisitions])' />
            </column>
            <column caption='GMV Eur per customer' datatype='real' name='[acquisitions/orders (copy)_4056687799690293248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;30D&quot; THEN SUM([gmv_eur_30D])/SUM([cohort_acquisitions])&#10;WHEN &quot;60D&quot; THEN SUM([gmv_eur_60D])/SUM([cohort_acquisitions])&#10;WHEN &quot;90D&quot; THEN SUM([gmv_eur_90D])/SUM([cohort_acquisitions])&#10;END' />
            </column>
            <column datatype='real' default-format='n#,##0;-#,##0' name='[acquisitions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[cohort_acquisitions]' role='measure' type='quantitative' />
            <column datatype='date' name='[cohort_month]' role='dimension' type='ordinal' />
            <column datatype='date' name='[conversion_date]' role='dimension' type='ordinal' />
            <column datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[cost_eur]' role='measure' type='quantitative' />
            <column datatype='string' name='[customer_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='real' name='[gmv_eur_30D]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_eur_60D]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_eur_90D]' role='measure' type='quantitative' />
            <column datatype='string' name='[market]' role='dimension' type='nominal' />
            <column-instance column='[conversion_date]' derivation='None' name='[none:conversion_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[customer_type]' derivation='None' name='[none:customer_type:nk]' pivot='key' type='nominal' />
