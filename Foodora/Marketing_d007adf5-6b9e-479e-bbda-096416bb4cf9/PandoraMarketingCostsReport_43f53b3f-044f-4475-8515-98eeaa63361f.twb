      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date' datatype='date' name='[Month (copy) Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-01#'>
          <calculation class='tableau' formula='#2025-08-01#' />
        </column>
        <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
          <calculation class='tableau' formula='&quot;EUR&quot;' />
        </column>
        <column caption='Region &amp; Country' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Regional&quot;'>
          <calculation class='tableau' formula='&quot;Regional&quot;' />
        </column>
        <column caption='KPI' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Spend&quot;'>
          <calculation class='tableau' formula='&quot;Spend&quot;' />
        </column>
      </datasource-dependencies>
      <filter class='categorical' column='[country_name]' filter-group='2'>
        <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
          <groupfilter function='level-members' level='[country_name]' />
          <groupfilter function='member' level='[country_name]' member='&quot;Germany&quot;' />
        </groupfilter>
      </filter>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4C94EAD16BA54ABB9B689EBEB5802EAA'>
            <properties context=''>
              <relation connection='bigquery.0wg06wz0ra2cp411vfdx31dm5o9d' name='Custom SQL Query' type='text'><![CDATA[WITH re_acq_orders as (SELECT
  global_entity_id,
  created_date_local,
  order_code,
  TRUE AS is_reacquisition
  -- analytical_customer_id,
  -- DATE_DIFF(created_date_local, previous_order_date, DAY) AS days_since_previous_order,  

FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders`
WHERE created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 24 MONTH), MONTH)
  AND DATE_DIFF(created_date_local, previous_order_date, DAY) >>= 365  ----- matches Looker logic to use  >>=
  AND is_successful IS TRUE 
  AND country_name NOT IN ("Germany", "Denmark")
  AND global_entity_id NOT LIKE "ODR_%"
  ---- added following to resolve issue with customer have NULL previous orders
  AND analytical_customer_id IS NOT NULL
  AND business_type not in ("laas",'dmart'))

select *, 

case when account_name = 'Voucher Generic Retention' THEN 'CRC'
when account_name = 'Subscriptions' THEN 'CRC'
when account_name = 'CRM Activities' THEN 'CAC'
when account_name = 'CRM Rebates And Discounts' THEN 'CRC'
when account_name = 'Vouchers Generic Acquisition'  THEN 'CAC'
when account_name = 'Refer A Friend' THEN 'CAC' END AS account_group
 from (select 
o.region,
o.country_name,
o.global_entity_id,
o.year,
o.business_type,
DATE_TRUNC(o.created_date_local,month) as report_month,
o.budget_channel_2025,
case 
WHEN  (year = '2024' and o.region = 'Europe' and loyalty.coupon_usage_status = 'consumed') OR (year = '2024' and o.region = 'Europe'
  and voucher_purpose = 'loyalty') or (year = '2024' and o.region = 'Europe'
  and voucher_channel = 'channel_loyalty') THEN 'Voucher Generic Retention'
WHEN year = '2024' and o.region = 'Europe' and COALESCE(is_pandapro_non_evergreen_voucher,FALSE) THEN 'Subscriptions'

  WHEN  (year = '2024' and o.region = 'Europe' AND voucher_channel = 'channel_online' AND voucher_purpose = 'acquisition') OR
  (year = '2024' and o.region = 'Europe' AND voucher_channel in ("channel_crm_prospect","channel_crm_ad_hoc") AND voucher_purpose IN ("platform_ec",'local_shops_only','platform_nc','qc_general','dmart_only','platform_nc')) THEN 'CRM Activities'


  WHEN (year = '2024' and o.region = 'Europe' AND voucher_channel = "channel_online" AND voucher_purpose IN ("activation", "engagement", "reactivation")) OR 
  (year = '2024' and o.region = 'Europe' AND voucher_channel IN ("channel_crm_churn_prevention", "channel_crm_onboarding", "channel_crm_reactivation",'channel_crm_ad_hoc') AND voucher_purpose IN ("platform_ec",'local_shops_only','qc_general','dmart_only')) THEN 'CRM Rebates And Discounts'

  WHEN year = '2024' and o.region = 'Europe' AND  voucher_channel IN ('channel_referral_welcome','channel_referral_reward','channel_refer_a_friend') THEN 'Refer A Friend'


  WHEN year = '2024' and o.region = 'Europe' AND is_acquisition AND voucher_channel NOT IN ('channel_referral_welcome','channel_referral_reward','channel_online','channel_refer_a_friend','channel_crm_prospect','channel_crm_ad_hoc') and voucher_purpose NOT IN ('sorry_panda','loyalty','refund','benefits','revenue','corporate','customer_support')
  THEN 'Vouchers Generic Acquisition'

  WHEN (year = '2024' and o.region = 'Europe' AND NOT is_acquisition AND voucher_channel NOT IN ('channel_referral_welcome','channel_referral_reward','channel_online','channel_refer_a_friend',"channel_crm_churn_prevention", "channel_crm_onboarding", "channel_crm_reactivation",'channel_crm_prospect','channel_loyalty') and voucher_purpose NOT IN ('sorry_panda','loyalty','refund','benefits','revenue','corporate','customer_support'))
    THEN 'Voucher Generic Retention'

when  year = '2025' and ((COALESCE(is_pandapro_non_evergreen_voucher,FALSE)) OR voucher_budget_channel = "PandaPro Benefits") AND NOT (o.global_entity_id = "OP_SE" AND vendors.chain_name LIKE "McD%")  THEN 'Subscriptions'
when year = '2025' and   Reporting_Lines_MCR_2025 = 'Affiliate & Coop - EC' THEN 'Voucher Generic Retention'
when year = '2025' and   Reporting_Lines_MCR_2025 = 'Autocompensation Realtime' THEN 'Autocompensation Realtime'
when year = '2025' and Reporting_Lines_MCR_2025 = 'CF Vouchers' THEN 'Voucher Generic Retention'
when year = '2025' and Reporting_Lines_MCR_2025 = 'CRM RMA' THEN 'CRM Activities'
when year = '2025' and Reporting_Lines_MCR_2025 = 'CRM RMO' THEN 'CRM Rebates And Discounts'
when year = '2025' and Reporting_Lines_MCR_2025 = 'CX Vouchers' THEN 'CX Vouchers'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Compensation' THEN 'Compensation'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Corporate Vouchers' THEN 'Corporate Vouchers'
when year = '2025' and Reporting_Lines_MCR_2025 = 'DHF Vouchers' and budget_channel_new not in ('PandaPro Benefits','Subscription Benefit Vouchers') THEN 'Voucher Generic Retention'
when year = '2025' and Reporting_Lines_MCR_2025 ='Affiliate & Coop - NC' THEN 'Vouchers Generic Acquisition' 
when year = '2025' and Reporting_Lines_MCR_2025 = 'Employee Benefits' THEN 'Employee Benefits'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Loyalty & Cashback Platform' and budget_channel_new = 'Loyalty Programme' THEN 'Voucher Generic Retention'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Loyalty & Cashback Platform ' and budget_channel_new = 'Loyalty Programme' THEN 'Voucher Generic Retention'

when year = '2025' and Reporting_Lines_MCR_2025 in ('Refer-a-friend','Refer A Friend') THEN 'Refer A Friend'
when year = '2025' and Reporting_Lines_MCR_2025 in ('Vouchers - NC') THEN 'Vouchers Generic Acquisition'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Experimentation' THEN 'Voucher Generic Retention'
when year = '2025' and Reporting_Lines_MCR_2025 in ('Rider Rewards') THEN 'Rider Rewards'
when year = '2025' and Reporting_Lines_MCR_2025 in ('Refund') THEN 'Refund'
when year = '2025' and Reporting_Lines_MCR_2025 in ('Test Vouchers') THEN 'Test Vouchers'
WHEN year = '2025' and Reporting_Lines_MCR_2025 = 'HVA - NC' THEN 'Vouchers Generic Acquisition'

when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Affiliate & Coop - EC' THEN 'Voucher Generic Retention'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Autocompensation Realtime' THEN 'Autocompensation Realtime'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'CF Vouchers' THEN 'Voucher Generic Retention'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'CRM RMA' THEN 'CRM Activities'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'CRM RMO' THEN 'CRM Rebates And Discounts'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'CX Vouchers' THEN 'CX Vouchers'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Compensation' THEN 'Compensation'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Corporate Vouchers' THEN 'Corporate Vouchers'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'DHF Vouchers' and budget_channel_new not in ('PandaPro Benefits','Subscription Benefit Vouchers') THEN 'Voucher Generic Retention'
when year = '2024' and  o.region = 'APAC' and ((COALESCE(is_pandapro_non_evergreen_voucher,FALSE)) OR voucher_budget_channel = "PandaPro Benefits")  THEN 'Subscriptions'

when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 ='Affiliate & Coop - NC' THEN 'Vouchers Generic Acquisition' 
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Employee Benefits' THEN 'Employee Benefits'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Loyalty & Cashback Platform' and budget_channel_new = 'Loyalty Programme' THEN 'Voucher Generic Retention'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Loyalty & Cashback Platform ' and budget_channel_new = 'Loyalty Programme' THEN 'Voucher Generic Retention'
WHEN year = '2024' and o.region = 'APAC' and Reporting_Lines_MCR_2025 = 'HVA - NC' THEN 'Vouchers Generic Acquisition'


when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Refer-a-friend','Refer A Friend') THEN 'Refer A Friend'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Vouchers - NC') THEN 'Vouchers Generic Acquisition'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Experimentation' THEN 'Voucher Generic Retention'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Rider Rewards') THEN 'Rider Rewards'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Refund') THEN 'Refund'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Test Vouchers') THEN 'Test Vouchers'
ELSE 'Other Vouchers'


 end as account_name,

 case 
WHEN  (year = '2024' and o.region = 'Europe' and loyalty.coupon_usage_status = 'consumed') OR (year = '2024' and o.region = 'Europe'
  and voucher_purpose = 'loyalty') or (year = '2024' and o.region = 'Europe'
  and voucher_channel = 'channel_loyalty') THEN 'P61342'
WHEN year = '2024' and o.region = 'Europe' and COALESCE(is_pandapro_non_evergreen_voucher,FALSE) THEN 'P61347'

  WHEN  (year = '2024' and o.region = 'Europe' AND voucher_channel = 'channel_online' AND voucher_purpose = 'acquisition') OR
  (year = '2024' and o.region = 'Europe' AND voucher_channel in ("channel_crm_prospect","channel_crm_ad_hoc") AND voucher_purpose IN ("platform_ec",'local_shops_only','platform_nc','qc_general','dmart_only','platform_nc')) THEN 'P61310'


  WHEN (year = '2024' and o.region = 'Europe' AND voucher_channel = "channel_online" AND voucher_purpose IN ("activation", "engagement", "reactivation")) OR 
  (year = '2024' and o.region = 'Europe' AND voucher_channel IN ("channel_crm_churn_prevention", "channel_crm_onboarding", "channel_crm_reactivation",'channel_crm_ad_hoc') AND voucher_purpose IN ("platform_ec",'local_shops_only','qc_general','dmart_only')) THEN 'P61340'

  WHEN year = '2024' and o.region = 'Europe' AND  voucher_channel IN ('channel_referral_welcome','channel_referral_reward','channel_refer_a_friend') THEN 'P61312'


  WHEN year = '2024' and o.region = 'Europe' AND is_acquisition AND voucher_channel NOT IN ('channel_referral_welcome','channel_referral_reward','channel_online','channel_refer_a_friend','channel_crm_prospect','channel_crm_ad_hoc') and voucher_purpose NOT IN ('sorry_panda','loyalty','refund','benefits','revenue','corporate','customer_support')
  THEN 'P61316'

  WHEN (year = '2024' and o.region = 'Europe' AND NOT is_acquisition AND voucher_channel NOT IN ('channel_referral_welcome','channel_referral_reward','channel_online','channel_refer_a_friend',"channel_crm_churn_prevention", "channel_crm_onboarding", "channel_crm_reactivation",'channel_crm_prospect','channel_loyalty') and voucher_purpose NOT IN ('sorry_panda','loyalty','refund','benefits','revenue','corporate','customer_support'))
    THEN 'P61342'
  when year = '2025' and ((COALESCE(is_pandapro_non_evergreen_voucher,FALSE)) OR voucher_budget_channel = "PandaPro Benefits") AND NOT (o.global_entity_id = "OP_SE" AND vendors.chain_name LIKE "McD%")THEN 'P61347'
when year = '2025' and  Reporting_Lines_MCR_2025 = 'Affiliate & Coop - EC' THEN 'P61342'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Autocompensation Realtime' THEN 'Non-Carc'
when year = '2025' and Reporting_Lines_MCR_2025 = 'CF Vouchers' THEN 'P61342'
when year = '2025' and Reporting_Lines_MCR_2025 = 'CRM RMA' THEN 'P61310'
when year = '2025' and Reporting_Lines_MCR_2025 = 'CRM RMO' THEN 'P61340'
when year = '2025' and Reporting_Lines_MCR_2025 = 'CX Vouchers' THEN 'Non-Carc'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Compensation' THEN 'Non-Carc'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Corporate Vouchers' THEN 'Non-Carc'
when year = '2025' and Reporting_Lines_MCR_2025 = 'DHF Vouchers' and budget_channel_new not in ('PandaPro Benefits','Subscription Benefit Vouchers') THEN 'P61342'
when year = '2025' and Reporting_Lines_MCR_2025 ='Affiliate & Coop - NC' THEN 'P61316' 
when year = '2025' and Reporting_Lines_MCR_2025 = 'Employee Benefits' THEN 'Non-Carc'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Loyalty & Cashback Platform' and budget_channel_new = 'Loyalty Programme' THEN 'P61342'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Loyalty & Cashback Platform ' and budget_channel_new = 'Loyalty Programme' THEN 'P61342'

when year = '2025' and Reporting_Lines_MCR_2025 in ('Refer-a-friend','Refer A Friend') THEN 'P61312'
when year = '2025' and Reporting_Lines_MCR_2025 in ('Vouchers - NC') THEN 'P61316'
when year = '2025' and Reporting_Lines_MCR_2025 = 'Experimentation' THEN 'P61342'
when year = '2025' and Reporting_Lines_MCR_2025 in ('Rider Rewards') THEN 'Non-Carc'
when year = '2025' and Reporting_Lines_MCR_2025 in ('Refund') THEN 'Non-Carc'
when year = '2025' and Reporting_Lines_MCR_2025 in ('Test Vouchers') THEN 'Non-Carc'
WHEN year = '2025' and Reporting_Lines_MCR_2025 = 'HVA - NC' THEN 'P61316'

when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Affiliate & Coop - EC' THEN 'P61342'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Autocompensation Realtime' THEN 'Non-Carc'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'CF Vouchers' THEN 'P61342'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'CRM RMA' THEN 'P61310'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'CRM RMO' THEN 'P61340'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'CX Vouchers' THEN 'Non-Carc'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Compensation' THEN 'Non-Carc'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Corporate Vouchers' THEN 'Non-Carc'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'DHF Vouchers' and budget_channel_new not in ('PandaPro Benefits','Subscription Benefit Vouchers') THEN 'P61342'
when year = '2024' and  o.region = 'APAC' and ((COALESCE(is_pandapro_non_evergreen_voucher,FALSE)) OR voucher_budget_channel = "PandaPro Benefits")  THEN 'P61347'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 ='Affiliate & Coop - NC' THEN 'P61316' 
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Employee Benefits' THEN 'Non-Carc'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Loyalty & Cashback Platform' and budget_channel_new = 'Loyalty Programme' THEN 'P61342'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Loyalty & Cashback Platform ' and budget_channel_new = 'Loyalty Programme' THEN 'P61342'

when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Refer-a-friend','Refer A Friend') THEN 'P61312'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Vouchers - NC') THEN 'P61316'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Experimentation' THEN 'P61342'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Rider Rewards') THEN 'Non-Carc'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Refund') THEN 'Non-Carc'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Test Vouchers') THEN 'Non-Carc'
WHEN year = '2024' and o.region = 'APAC' and  Reporting_Lines_MCR_2025 = 'HVA - NC' THEN 'P61316'

ELSE 'Other Vouchers'

 end as account_id,
 Reporting_Lines_MCR_2025,
 voucher_channel,
 voucher_purpose,
 CASE WHEN re_acq.is_reacquisition THEN TRUE ELSE FALSE END AS is_reacquisition,
 count(distinct o.order_code) as order_count,
SUM(voucher_cost_dh_eur) as voucher_cost_dh_marketing_eur,
SUM(voucher_cost_dh_local) as voucher_cost_dh_marketing_local


 from `dhh---analytics-eu.bi_marketing.pandora_agg_mcr_orders` o
   LEFT JOIN
  `dhh---analytics-eu.bi_marketing.regional_eu_loyalty_vouchers` AS loyalty
ON
  loyalty.global_entity_id = o.global_entity_id
  AND loyalty.order_id = o.order_code
 left join re_acq_orders as re_acq on re_acq.global_entity_id = o.global_entity_id and o.order_code = re_acq.order_code
 LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` as vendors
 on o.global_entity_id= vendors.global_entity_id and o.vendor_code = vendors.vendor_code
 where o.created_date_local>>= '2024-01-01'

and o.business_type <<>> 'dmart'
group by all)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
