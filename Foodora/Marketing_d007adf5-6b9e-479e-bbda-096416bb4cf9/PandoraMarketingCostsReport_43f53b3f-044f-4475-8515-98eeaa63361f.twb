      <column caption='Retention Spend %' datatype='real' name='[Acquisition Spend % (copy)_8774067622121578500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_reacquisition] = FALSE and [account_group] = &apos;CRC&apos; THEN [voucher_cost_dh_marketing_eur] end) /SUM([voucher_cost_dh_marketing_eur])' />
      </column>
      <column caption='Retention Spend' datatype='real' name='[Acquisition Spend (copy)_8774067622121496579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_reacquisition] = FALSE and [account_group] = &apos;CRC&apos; THEN [voucher_cost_dh_marketing_eur] end)' />
      </column>
      <column caption='Actuals (copy)' datatype='real' name='[Actuals (copy)_3284953720195543053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;EUR&apos; THEN [voucher_cost_dh_marketing_eur]&#10;else [voucher_cost_dh_marketing_local]&#10;END' />
      </column>
