      <column caption='Selected Month' datatype='string' name='[Calculation_2412733140754042882]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[month]) = DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter])&#10;then &apos;Selected Month&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;Previous Month&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;2 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-3,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;3 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-4,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;4 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-5,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;5 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;6 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;7 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-8,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;8 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-9,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;9 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-10,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;10 Months Ago&a