      <column caption='Selected Month' datatype='string' name='[Calculation_3284953720247447568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[month]) = DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter])&#10;then &apos;Selected Month&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;Previous Month&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;2 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-3,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;3 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-4,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;4 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-5,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;5 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;6 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;7 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-8,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;8 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-9,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;9 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-10,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;10 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-11,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;11 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[month]) = dateadd(&apos;month&apos;,-12,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;12 Months Ago&apos;&#10;end' />
      </column>
      <column caption='Actuals' datatype='real' name='[Calculation_3284953720247971858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;EUR&apos; THEN [incentive_cost_dh_eur]&#10;else [incentive_cost_dh_local]&#10;end' />
      </column>
      <column caption='Region &amp; Country' datatype='string' name='[Calculation_3284953720248987667]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Country&apos; THEN [country_name]&#10;else [region] END' />
      </column>
      <column caption='Re-Acquistion Spend %' datatype='real' name='[Calculation_3284953720249790484]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_reacquisition] = TRUE THEN [incentive_cost_dh_eur] end) /SUM([incentive_cost_dh_eur])' />
      </column>
      <column caption='KPI' datatype='real' name='[Calculation_3284953720251842582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Order Count&apos; THEN [order_count]&#10;&#10;ELSE [Calculation_3284953720247971858] &#10;END' />
      </column>
      <column caption='Re-Acquistion Spend' datatype='real' name='[Re-Acquistion Spend (copy)_3284953720250855445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_reacquisition] = TRUE THEN [incentive_cost_dh_eur] end)' />
      </column>
