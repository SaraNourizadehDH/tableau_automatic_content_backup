    <worksheet name='Voucher Channel &amp; Purpose Level'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#6a2e60'>Voucher Channel &amp; Purpose Level</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#6a2e60' fontsize='9'>please expand Account Name</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='voucher view' name='federated.0tkxqf51m9g3xq11hixu60fihoo5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date' datatype='date' name='[Month (copy) Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-01#'>
              <calculation class='tableau' formula='#2025-08-01#' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column caption='Region &amp; Country' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Regional&quot;'>
              <calculation class='tableau' formula='&quot;Regional&quot;' />
            </column>
            <column caption='KPI' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Spend&quot;'>
              <calculation class='tableau' formula='&quot;Spend&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0tkxqf51m9g3xq11hixu60fihoo5'>
            <column caption='Country &amp; Region' datatype='string' name='[Calculation_3284953720120684544]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Country&apos; THEN [country_name]&#10;else [region] END' />
            </column>
            <column caption='CARC v Non - CARC' datatype='string' name='[Calculation_3284953720121167873]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [account_group]= &apos;CAC&apos; THEN &apos;CARC&apos;&#10;ELSEIF  [account_group] = &apos;CRC&apos; THEN &apos;CARC&apos;&#10;ELSE &apos;Non-Carc&apos;&#10;END' />
            </column>
            <column caption='Selected Month' datatype='string' name='[Calculation_3284953720121372674]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if DATETRUNC(&apos;month&apos;,[report_month]) = DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter])&#10;then &apos;Selected Month&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[report_month]) = dateadd(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;Previous Month&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[report_month]) = dateadd(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;2 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[report_month]) = dateadd(&apos;month&apos;,-3,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;3 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[report_month]) = dateadd(&apos;month&apos;,-4,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;4 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[report_month]) = dateadd(&apos;month&apos;,-5,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;5 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[report_month]) = dateadd(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;6 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[report_month]) = dateadd(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;7 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[report_month]) = dateadd(&apos;month&apos;,-8,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;8 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[report_month]) = dateadd(&apos;month&apos;,-9,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;9 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[report_month]) = dateadd(&apos;month&apos;,-10,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;10 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[report_month]) = dateadd(&apos;month&apos;,-11,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;11 Months Ago&apos;&#10;ELSEIF DATETRUNC(&apos;month&apos;,[report_month]) = dateadd(&apos;month&apos;,-12,DATETRUNC(&apos;month&apos;,[Parameters].[Month (copy) Parameter]))&#10;then &apos;12 Months Ago&apos;&#10;end' />
            </column>
            <column caption='Actuals' datatype='real' name='[Calculation_3284953720121434115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;EUR&apos; THEN [voucher_cost_dh_marketing_eur]&#10;else [voucher_cost_dh_marketing_local]&#10;END' />
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_3284953720121532420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Order Count&apos; THEN [Calculation_3284953720121585669]&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Spend Per Order&apos; THEN [Calculation_3284953720121790470]&#10;ELSE [Calculation_3284953720121434115] &#10;END' />
            </column>
            <column caption='Order Count' datatype='integer' name='[Calculation_3284953720121585669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;EUR&apos; THEN [order_count]&#10;else [order_count] end' />
            </column>
            <column caption='Spend Per Order' datatype='real' name='[Calculation_3284953720121790470]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3284953720121434115]/[Calculation_3284953720121585669]' />
            </column>
            <column caption='MCR Lines New' datatype='string' name='[Calculation_4519221533825126401]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [account_name] = &apos;Subscriptions&apos; THEN &apos;Subscriptions&apos; ELSE [Reporting_Lines_MCR_2025] END' />
            </column>
            <column caption='MCR Lines' datatype='string' name='[Reporting_Lines_MCR_2025]' role='dimension' type='nominal' />
            <column caption='Account Group' datatype='string' name='[account_group]' role='dimension' type='nominal' />
            <column caption='Account Name' datatype='string' name='[account_name]' role='dimension' type='nominal'>
