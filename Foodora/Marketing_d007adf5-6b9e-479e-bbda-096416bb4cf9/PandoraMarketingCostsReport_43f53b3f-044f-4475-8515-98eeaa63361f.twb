when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Loyalty & Cashback Platform ' and budget_channel_new = 'Loyalty Programme' THEN 'P61342'

when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Refer-a-friend','Refer A Friend') THEN 'P61312'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Vouchers - NC') THEN 'P61316'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 = 'Experimentation' THEN 'P61342'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Rider Rewards') THEN 'Non-Carc'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Refund') THEN 'Non-Carc'
when year = '2024' and o.region = 'APAC' and   Reporting_Lines_MCR_2025 in ('Test Vouchers') THEN 'Non-Carc'
WHEN year = '2024' and o.region = 'APAC' and  Reporting_Lines_MCR_2025 = 'HVA - NC' THEN 'P61316'

ELSE 'Other Vouchers'

 end as account_id,
 Reporting_Lines_MCR_2025,
 voucher_channel,
 voucher_purpose,
 CASE WHEN re_acq.is_reacquisition THEN TRUE ELSE FALSE END AS is_reacquisition,
 count(distinct o.order_code) as order_count,
SUM(voucher_cost_dh_eur) as voucher_cost_dh_marketing_eur,
SUM(voucher_cost_dh_local) as voucher_cost_dh_marketing_local


 from `dhh---analytics-eu.bi_marketing.pandora_agg_mcr_orders` o
   LEFT JOIN
  `dhh---analytics-eu.bi_marketing.regional_eu_loyalty_vouchers` AS loyalty
ON
  loyalty.global_entity_id = o.global_entity_id
  AND loyalty.order_id = o.order_code
 left join re_acq_orders as re_acq on re_acq.global_entity_id = o.global_entity_id and o.order_code = re_acq.order_code
 LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` as vendors
 on o.global_entity_id= vendors.global_entity_id and o.vendor_code = vendors.vendor_code
 where o.created_date_local>>= '2024-01-01'

and o.business_type <<>> 'dmart'
group by all)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
