      <aliases enabled='yes' />
      <column caption='BE Local' datatype='real' name='[BE EUR (copy)_1301681033935589382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([be_value_local])/SUM([Calculation_1301681033935237124])*SUM([Calculation_1301681033935163395]),SUM([be_value_local]))' />
      </column>
      <column caption='Monthly BE' datatype='real' name='[Calculation_1301681033933737984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;EUR&apos; THEN [be_value_eur]&#10;else [be_value_local] END' />
      </column>
      <column caption='RR' datatype='real' name='[Calculation_1301681033934360577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;EUR&apos; THEN [runrate_eur]&#10;ELSE [runrate_local]&#10;END' />
      </column>
      <column caption='day adj' datatype='integer' name='[Calculation_1301681033935163395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [day] = 0 then [Calculation_1301681033935237124] else [day] end' />
      </column>
      <column caption='Last Day Of Month' datatype='integer' name='[Calculation_1301681033935237124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DAY(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[report_month])))))' />
      </column>
      <column caption='BE EUR' datatype='real' name='[Calculation_1301681033935405061]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([be_value_eur])/SUM([Calculation_1301681033935237124])*SUM([Calculation_1301681033935163395]),SUM([be_value_eur]))' />
      </column>
      <column caption='BE MTD' datatype='real' name='[Calculation_1301681033935650823]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;EUR&apos; THEN [Calculation_1301681033935405061] else [BE EUR (copy)_1301681033935589382] END' />
      </column>
      <column caption='Prev Month' datatype='boolean' name='[Calculation_829647497987858437]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_month] = DATE(DATEADD(&apos;month&apos;, -1, [Parameters].[Month (copy) Parameter]))' />
      </column>
      <column caption='Actuals' datatype='real' name='[Calculation_829647497988198406]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;EUR&apos;  and [Parameters].[Parameter 5] = &apos;VAT Incl.&apos; THEN [total_eur]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;EUR&apos;  and [Parameters].[Parameter 5] = &apos;VAT Excl.&apos; THEN [total_net_eur]&#10;ELSEIF  [Parameters].[Parameter 2] = &apos;Local&apos; and [Parameters].[Parameter 5] = &apos;VAT Incl.&apos;  THEN [total_local]&#10;ELSEIF  [Parameters].[Parameter 2] = &apos;Local&apos; and [Parameters].[Parameter 5] = &apos;VAT Excl.&apos; THEN [total_net_local]&#10;END' />
      </column>
      <column caption='OS Actuals' datatype='real' name='[Calculation_829647497988354055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;EUR&apos; THEN [actual_value_eur]&#10;else [actual_value_local]&#10;END' />
