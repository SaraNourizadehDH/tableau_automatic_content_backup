      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_CD356AC9F08342E78131CA0196A1E376'>
            <properties context=''>
              <relation connection='bigquery.0f94maa1wymww7195n8h411clx9i' name='Custom SQL Query' type='text'><![CDATA[SELECT * ,
FORMAT_DATE('%Y-%m', created_date) AS month,
FORMAT_DATE('%Y-%U', created_date) AS week,

FROM `fulfillment-dwh-production.pandata_report.Country_BD_session_agg_campaign`
WHERE created_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE() + 1, MONTH), INTERVAL 4 MONTH)
AND created_date <<= CURRENT_DATE() - 1]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
