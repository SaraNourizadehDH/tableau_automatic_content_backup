      <table>
        <view>
          <datasources>
            <datasource caption='sessions deep dive perseus' name='federated.1y0upcb167qnjv14nqumi0i9brmf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1y0upcb167qnjv14nqumi0i9brmf'>
            <column caption='Platform Sessions' datatype='integer' name='[Calculation_1232860435949850631]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM (IF [vertical]=&quot;Platform&quot; THEN[sessions] END)' />
            </column>
            <column caption='Food  Sessions' datatype='integer' name='[Calculation_1232860435950088200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical]= &quot;Food&quot;  THEN [sessions] END)' />
            </column>
            <column caption='Pickup sessions' datatype='integer' name='[Calculation_1232860435951783945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vertical]= &quot;Pickup&quot; THEN[sessions] END)' />
            </column>
            <column caption='Shops Sessions' datatype='integer' name='[Calculation_1232860435957223435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM (IF [vertical] = &quot;Shops&quot; THEN[sessions] END)' />
            </column>
            <column caption='Date ' datatype='string' name='[Calculation_230809520955973632]' role='dimension' type='nominal'>
