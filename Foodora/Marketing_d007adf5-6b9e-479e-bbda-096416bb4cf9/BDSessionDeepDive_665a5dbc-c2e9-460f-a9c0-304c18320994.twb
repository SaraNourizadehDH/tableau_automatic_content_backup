      <table>
        <view>
          <datasources>
            <datasource caption='pandata_bd_marketing' name='federated.1m6f18c1ifsgal13vk9rz1sx6ka1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1m6f18c1ifsgal13vk9rz1sx6ka1'>
            <column caption='Selected Date Gran' datatype='string' name='[Calculation_69172522353295407]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN [Date (copy)_69172522343469102]&#10;WHEN &apos;Week&apos; THEN [week]&#10;WHEN &apos;Month&apos; THEN [month]&#10;END' />
            </column>
            <column caption='Traffic Type' datatype='string' name='[Calculation_69172522356260912]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([campaign_name]) THEN &apos;Organic&apos; ELSE &apos;Paid&apos; END' />
