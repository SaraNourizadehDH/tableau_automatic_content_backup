              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN STR(YEAR([date_local])) + &quot;-&quot; + STR(MONTH([date_local])) + &quot;-&quot; + STR(DAY([date_local]))&#13;&#10;WHEN &quot;Week&quot; THEN STR(YEAR([date_local])) + &quot;-W&quot; + STR(WEEK([date_local]))&#13;&#10;WHEN &quot;Month&quot; THEN STR(YEAR([date_local])) + &quot;-&quot; + STR(MONTH([date_local])) &#13;&#10;END' />
            </column>
            <column caption='MCVR2' datatype='real' name='[Calculation_230809520957124610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mcvr2_num])/SUM([mcvr2_denom])' />
