            <column caption='Acq PM Organic Share %' datatype='real' default-format='p0.0%' name='[Reg Android Share % (copy)_855683940291522584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[acq_pm_organic] / ([acq_pm_na] + [acq_pm_organic]+ [acq_pm_paid])' />
