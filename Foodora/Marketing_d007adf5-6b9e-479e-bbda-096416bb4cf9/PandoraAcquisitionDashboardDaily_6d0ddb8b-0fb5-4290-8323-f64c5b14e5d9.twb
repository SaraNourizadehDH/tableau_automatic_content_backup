      <table>
        <view>
          <datasources>
            <datasource caption='regional_acquisition_dashboard_metrics' name='federated.0e28mqi0jjscbj153hqr500ugpy2' />
          </datasources>
          <datasource-dependencies datasource='federated.0e28mqi0jjscbj153hqr500ugpy2'>
            <column caption='Current Date Exclusion' datatype='boolean' name='[Calculation_1799258426863525888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date]= TODAY() then TRUE else FALSE end' />
            </column>
            <column caption='WoW % Organic Installs' datatype='real' name='[WoW % Paid Installs (copy)_953918708537683990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(sum([installs_organic])) - LOOKUP(ZN(sum([installs_organic])), -7)) / ABS(LOOKUP(ZN(sum([installs_organic])), -7))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='WoW % Total Installs' datatype='real' default-format='p0.0%' name='[WoW % Total Reg (copy)_953918708486459402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(sum([num_of_installs])) - LOOKUP(ZN(sum([num_of_installs])), -7)) / ABS(LOOKUP(ZN(sum([num_of_installs])), -7))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='WoW % Paid Installs' datatype='real' name='[WoW % iOS Installs (copy)_953918708537118739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(sum([installs_paid])) - LOOKUP(ZN(sum([installs_paid])), -7)) / ABS(LOOKUP(ZN(sum([installs_paid])), -7))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[installs Organic Share % (copy)_953918708536778770]' derivation='Avg' name='[avg:installs Organic Share % (copy)_953918708536778770:qk]' pivot='key' type='quantitative' />
            <column-instance column='[installs iOS Share % (copy)_917326977481981954]' derivation='Avg' name='[avg:installs iOS Share % (copy)_917326977481981954:qk]' pivot='key' type='quantitative' />
            <column-instance column='[installs iOS Share % (copy)_953918708536623121]' derivation='Avg' name='[avg:installs iOS Share % (copy)_953918708536623121:qk]' pivot='key' type='quantitative' />
            <column-instance column='[reinstalls Paid Share % (copy)_917326977482850307]' derivation='Avg' name='[avg:reinstalls Paid Share % (copy)_917326977482850307:qk]' pivot='key' type='quantitative' />
            <column-instance column='[date]' derivation='Count' name='[cnt:date:qk]' pivot='key' type='quantitative' />
            <column caption='Date' datatype='date' default-format='*d.mm.yyyy' name='[date]' role='dimension' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='installs Paid Share %' datatype='real' name='[installs Organic Share % (copy)_953918708536778770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[installs_paid] / ([installs_organic] + [installs_paid])' />
            </column>
            <column caption='reinstalls Paid Share %' datatype='real' default-format='p0.0%' name='[installs iOS Share % (copy)_917326977481981954]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[reinstalls_paid] / ([reinstalls_organic] + [reinstalls_paid])' />
            </column>
            <column caption='installs Organic Share %' datatype='real' name='[installs iOS Share % (copy)_953918708536623121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[installs_organic] / ([installs_organic] + [installs_paid])' />
            </column>
            <column caption='Installs Organic' datatype='integer' name='[installs_organic]' role='measure' type='quantitative' />
            <column caption='Installs Paid' datatype='integer' name='[installs_paid]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1799258426863525888]' derivation='None' name='[none:Calculation_1799258426863525888:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column caption='Num Of Installs' datatype='integer' name='[num_of_installs]' role='measure' type='quantitative' />
