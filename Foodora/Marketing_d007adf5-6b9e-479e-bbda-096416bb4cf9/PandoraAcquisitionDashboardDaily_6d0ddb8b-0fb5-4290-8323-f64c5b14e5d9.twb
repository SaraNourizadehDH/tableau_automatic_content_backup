            <column aggregation='Max' caption='Current Month Days Past' datatype='integer' name='[Calculation_250231262897307662]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,Datetrunc(&apos;month&apos;,TODAY()),TODAY())' />
            </column>
            <column aggregation='Max' caption='Current Month Days Left' datatype='integer' name='[Calculation_250231262898290703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, TODAY(), DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY())))' />
            </column>
            <column caption='MOM Change % Total Installs' datatype='real' default-format='p0.0%' name='[MOM Change % New Installs (copy)_953918708230676482]' role='measure' type='quantitative' visual-totals='Sum'>
              <calculation class='tableau' formula='(&#13;&#10;(sum((if [date] &gt;= datetrunc(&apos;month&apos;,TODAY()) THEN [num_of_installs] END / [Calculation_250231262897307662]) * ([Calculation_250231262897307662] + [Calculation_250231262898290703])))&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;(sum(if date &gt;= datetrunc(&apos;month&apos;,IF DATEDIFF(&apos;month&apos;,[date],TODAY()) = 1 then date end) AND [date] &lt; datetrunc(&apos;month&apos;,TODAY()) then [num_of_installs] end))&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(sum(if date &gt;= datetrunc(&apos;month&apos;,IF DATEDIFF(&apos;month&apos;,[date],TODAY()) = 1 then date end) AND [date] &lt; datetrunc(&apos;month&apos;,TODAY()) then [num_of_installs] end))' />
            </column>
            <column caption='MOM Change % New Sessions' datatype='real' default-format='p0.0%' name='[MOM Change % New Installs (copy)_953918708238118915]' role='measure' type='quantitative' visual-totals='Sum'>
              <calculation class='tableau' formula='(&#13;&#10;(sum((if [date] &gt;= datetrunc(&apos;month&apos;,TODAY()) THEN [num_of_new_sessions] END / [Calculation_250231262897307662]) * ([Calculation_250231262897307662] + [Calculation_250231262898290703])))&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;(sum(if date &gt;= datetrunc(&apos;month&apos;,IF DATEDIFF(&apos;month&apos;,[date],TODAY()) = 1 then date end) AND [date] &lt; datetrunc(&apos;month&apos;,TODAY()) then [num_of_new_sessions] end))&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(sum(if date &gt;= datetrunc(&apos;month&apos;,IF DATEDIFF(&apos;month&apos;,[date],TODAY()) = 1 then date end) AND [date] &lt; datetrunc(&apos;month&apos;,TODAY()) then [num_of_new_sessions] end))' />
            </column>
            <column caption='MOM Change % Registrations' datatype='real' default-format='p0.0%' name='[MOM Change % New Sessions (copy)_953918708472762372]' role='measure' type='quantitative' visual-totals='Sum'>
              <calculation class='tableau' formula='(&#13;&#10;(sum((if [date] &gt;= datetrunc(&apos;month&apos;,TODAY()) THEN [Calculation_250231262508957697] END / [Calculation_250231262897307662]) * ([Calculation_250231262897307662] + [Calculation_250231262898290703])))&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;(sum(if date &gt;= datetrunc(&apos;month&apos;,IF DATEDIFF(&apos;month&apos;,[date],TODAY()) = 1 then date end) AND [date] &lt; datetrunc(&apos;month&apos;,TODAY()) then [Calculation_250231262508957697] end))&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(sum(if date &gt;= datetrunc(&apos;month&apos;,IF DATEDIFF(&apos;month&apos;,[date],TODAY()) = 1 then date end) AND [date] &lt; datetrunc(&apos;month&apos;,TODAY()) then [Calculation_250231262508957697] end))' />
            </column>
