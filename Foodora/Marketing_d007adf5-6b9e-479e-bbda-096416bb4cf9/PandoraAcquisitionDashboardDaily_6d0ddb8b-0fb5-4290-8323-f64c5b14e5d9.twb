              <calculation class='tableau' formula='(&#13;&#10;(sum((if [date] &gt;= datetrunc(&apos;month&apos;,TODAY()) THEN [acquisition_count] END / ([Calculation_250231262897307662])) * ([Calculation_250231262897307662] + [Calculation_250231262898290703])))&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;(sum(if date &gt;= datetrunc(&apos;month&apos;,IF DATEDIFF(&apos;month&apos;,[date],TODAY()) = 1 then date end) AND [date] &lt; datetrunc(&apos;month&apos;,TODAY()) then [acquisition_count] end))&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(sum(if date &gt;= datetrunc(&apos;month&apos;,IF DATEDIFF(&apos;month&apos;,[date],TODAY()) = 1 then date end) AND [date] &lt; datetrunc(&apos;month&apos;,TODAY()) then [acquisition_count] end))' />
