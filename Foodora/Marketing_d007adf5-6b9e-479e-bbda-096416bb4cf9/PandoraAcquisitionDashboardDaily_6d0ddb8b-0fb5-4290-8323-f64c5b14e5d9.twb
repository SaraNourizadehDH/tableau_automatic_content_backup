    <worksheet name='Daily Metrics'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ff2b85' fontsize='14'>Yemeksepeti Daily Performance Metrics</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>Data sources of metrics;&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold'>Sessions:</run>
            <run fontname='Tableau Bold'>Æ </run>
            <run fontcolor='#0d904f' fontname='Tableau Bold'>perseus_sessions_pandora</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold'>Installs:</run>
            <run fontname='Tableau Bold'>Æ </run>
            <run fontcolor='#0d904f' fontname='Tableau Bold'>mkt_adj_adjust_events</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Bold'>Registrations: </run>
            <run fontcolor='#0d904f' fontname='Tableau Bold'>customer_event_stream</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Bold'>Acquisitions: </run>
            <run fontcolor='#0d904f' fontname='Tableau Bold'>agg_orders_eu</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_acquisition_dashboard_metrics' name='federated.0e28mqi0jjscbj153hqr500ugpy2' />
          </datasources>
          <datasource-dependencies datasource='federated.0e28mqi0jjscbj153hqr500ugpy2'>
            <column caption='acq_count_real' datatype='integer' name='[Calculation_1507017072781991936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[acquisition_count] - [acq_count_fraud]' />
            </column>
            <column caption='Current Date Exclusion' datatype='boolean' name='[Calculation_1799258426863525888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date]= TODAY() then TRUE else FALSE end' />
            </column>
            <column caption='reg_total' datatype='integer' name='[Calculation_250231262508957697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[reg_android]+[reg_ios]+[reg_web]' />
            </column>
            <column caption='New Sessions vs Total Sessions' datatype='real' name='[Calculation_953918708504895504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[num_of_new_sessions] / [num_of_total_sessions]' />
            </column>
            <column caption='WoW % Total Real Acq' datatype='real' default-format='p0.0%' name='[WoW % Total Acq (copy)_156500138767179776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(sum([Calculation_1507017072781991936])) - LOOKUP(ZN(sum([Calculation_1507017072781991936])), -7)) / ABS(LOOKUP(ZN(sum([Calculation_1507017072781991936])), -7))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='WoW % Total Reg' datatype='real' default-format='p0.0%' name='[WoW % Total Acq (copy)_953918708485955592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(sum([Calculation_250231262508957697])) - LOOKUP(ZN(sum([Calculation_250231262508957697])), -7)) / ABS(LOOKUP(ZN(sum([Calculation_250231262508957697])), -7))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='WoW % Total New Sessions' datatype='real' name='[WoW % Total New Installs (copy)_953918708487364620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(sum([num_of_new_sessions])) - LOOKUP(ZN(sum([num_of_new_sessions])), -7)) / ABS(LOOKUP(ZN(sum([num_of_new_sessions])), -7))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
