            <column caption='Acq PM Paid Share %' datatype='real' default-format='p0.0%' name='[Acq Organic Share % (copy)_855683940292083737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[acq_pm_paid] / ([acq_pm_na] + [acq_pm_organic]+ [acq_pm_paid])' />
            </column>
            <column caption='Current Date Exclusion' datatype='boolean' name='[Calculation_1799258426863525888]' role='dimension' type='nominal'>
