      <column caption='Total RR' datatype='real' name='[Calculation_1139973680824090624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([acq_ct]) / ([Calculation_3196148426403037188])) * ([Calculation_3196148426403127301])' />
      </column>
      <column caption='MoM Change % Total Acq' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Calculation_1139973680826736642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;(SUM((if [date] &gt;= datetrunc(&apos;month&apos;,TODAY()) THEN [acq_ct] END / ([Calculation_250231262897307662]-1)) * ([Calculation_250231262897307662] + [Calculation_250231262898290703])))&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;(SUM(if date &gt;= datetrunc(&apos;month&apos;,IF DATEDIFF(&apos;month&apos;,[date],TODAY()) = 1 then date end) AND [date] &lt; datetrunc(&apos;month&apos;,TODAY()) then [acq_ct] end))&#13;&#10;)&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(SUM(if date &gt;= datetrunc(&apos;month&apos;,IF DATEDIFF(&apos;month&apos;,[date],TODAY()) = 1 then date end) AND [date] &lt; datetrunc(&apos;month&apos;,TODAY()) then [acq_ct] end))' />
      </column>
      <column caption='Current Month Days Past' datatype='integer' name='[Calculation_250231262897307662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,Datetrunc(&apos;month&apos;,TODAY()),TODAY())' />
      </column>
      <column caption='Current Month Days Left' datatype='integer' name='[Calculation_250231262898290703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, TODAY(), DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, TODAY())))' />
      </column>
      <column caption='Days left' datatype='real' name='[Calculation_3196148426402938883]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='//datada toplam kaç gün kaldı&#13;&#10;&#13;&#10;//data toplam kaç gün olacak&#13;&#10;DATEPART(&apos;day&apos;, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, MAX([date]))) - 1)&#13;&#10;-&#13;&#10;//datada kaç gün geçti&#13;&#10;avg(DATEPART(&apos;day&apos;, { FIXED DATETRUNC(&apos;month&apos;, [date]) : MAX([date]) }))' />
      </column>
      <column caption='Days Passed' datatype='real' name='[Calculation_3196148426403037188]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='//datada kaç gün geçti&#13;&#10;avg(DATEPART(&apos;day&apos;, { FIXED DATETRUNC(&apos;month&apos;, [date]) : MAX([date]) }))' />
      </column>
      <column caption='Days Total' datatype='integer' name='[Calculation_3196148426403127301]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='//data toplam kaç gün olacak&#13;&#10;DATEPART(&apos;day&apos;, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, MAX([date]))) - 1)' />
      </column>
      <column caption='T-1 Week' datatype='boolean' hidden='true' name='[Calculation_5963258510588952640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;week&apos;,TODAY()) &lt;= DATETRUNC(&apos;week&apos;,[date])&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
