        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='82500' id='3' type-v2='text' w='98400' x='800' y='16500'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='12'>Total Sessions: </run>
              <run fontcolor='#000000' fontsize='12'>Sum of Distinct Total Sessions </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Total Sessions WoW %: </run>
              <run fontcolor='#000000' fontsize='12'>Comparison of the total session data on the given date with the same day of the previous week</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>New Sessions: </run>
              <run fontcolor='#000000' fontsize='12'>Sum of First Visits by Client ID (A unique ID generated for the device)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>New Sessions WoW %:</run>
              <run fontcolor='#000000' fontsize='12'> Comparison of the new session data on the given date with the same day of the previous week</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>New Sessions RR: </run>
              <run fontcolor='#000000' fontsize='12'>Monthly Sum of First Visits&apos; Run Rate based on actuals in the current month</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>New Sessions vs Total Sessions: </run>
              <run fontcolor='#000000' fontsize='12'>The ratio of New Sessions within Total Sessions</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Total Installs: </run>
              <run fontcolor='#000000' fontsize='12'>Sum of Installs</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Total Installs WoW %: </run>
              <run fontcolor='#000000' fontsize='12'>Comparison of the total install data on the given date with the same day of the previous week</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Total Installs RR: </run>
              <run fontcolor='#000000' fontsize='12'>Monthly Total Installs Run Rate based on actuals in the current month</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Registrations: </run>
              <run fontcolor='#000000' fontsize='12'>Sum of Registrations</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Registrations WoW %: </run>
              <run fontcolor='#000000' fontsize='12'>Comparison of the sum of registrations on the given date with the same day of the previous week</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Registrations RR: </run>
              <run fontcolor='#000000' fontsize='12'>Monthly Registrations Run Rate based on actuals in the current month</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Acquisitions: </run>
              <run fontcolor='#000000' fontsize='12'>Sum of Acquisitions</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Acquisitions WoW %: </run>
              <run fontcolor='#000000' fontsize='12'>Comparison of the sum of acquisitions on the given date with the same day of the previous week</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Acquisitions RR: </run>
              <run fontcolor='#000000' fontsize='12'>Monthly Acquisitions Run Rate based on actuals in the current month</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>New Installs: </run>
              <run fontcolor='#000000' fontsize='12'>Sum of installs where a customer install the app for the first time</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Reinstalls:</run>
              <run fontcolor='#000000' fontsize='12'> Sum of installs where a customer reinstall the app</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Uninstalls: </run>
              <run fontcolor='#000000' fontsize='12'>Sum of uninstalls</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>PM Installs:</run>
              <run fontcolor='#000000' fontsize='12'> Sum of installs where the source is one of the PM channels</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>PM Acquisitions:</run>
              <run fontcolor='#000000' fontsize='12'> Sum of acquisitions where the source is one of the PM channels</run>
              <run>Æ&#10;</run>
