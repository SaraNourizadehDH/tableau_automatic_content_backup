    <worksheet name='RR Estimations'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ff2b85' fontsize='14'>Current Month Run Rates</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_acquisition_dashboard_metrics' name='federated.0e28mqi0jjscbj153hqr500ugpy2' />
          </datasources>
          <datasource-dependencies datasource='federated.0e28mqi0jjscbj153hqr500ugpy2'>
            <column caption='Current Date Exclusion' datatype='boolean' name='[Calculation_1799258426863525888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date]= TODAY() then TRUE else FALSE end' />
            </column>
            <column caption='reg_total' datatype='integer' name='[Calculation_250231262508957697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[reg_android]+[reg_ios]+[reg_web]' />
            </column>
            <column caption='new session rr estimation' datatype='real' name='[Calculation_250231262899425296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([num_of_new_sessions]) / [Days left (copy)_3196148426401583105]) * ([Calculation_3196148426401665026])' />
            </column>
            <column caption='Days Total' datatype='integer' name='[Calculation_3196148426401665026]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='//data toplam kaç gün olacak&#13;&#10;DATEPART(&apos;day&apos;, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, MAX([date]))) - 1)' />
            </column>
            <column caption='Days Passed' datatype='real' name='[Days left (copy)_3196148426401583105]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='//datada kaç gün geçti&#13;&#10;avg(DATEPART(&apos;day&apos;, { FIXED DATETRUNC(&apos;month&apos;, [date]) : MAX([date]) }))' />
            </column>
            <column caption='real acquisitions rr estimation' datatype='real' name='[acquisition rr estimation (copy)_1507017072955174916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([acquisition_count]) / [Days left (copy)_3196148426401583105]) * ([Calculation_3196148426401665026])&#13;&#10;-&#13;&#10;(sum([acq_count_fraud]) / [Days left (copy)_3196148426401583105]) * ([Calculation_3196148426401665026])' />
            </column>
            <column caption='Acquisition Count' datatype='integer' name='[acquisition_count]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' default-format='*d.mm.yyyy' name='[date]' role='dimension' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='acquisition rr estimation' datatype='real' name='[new session rr estimation (copy) (copy) (copy)_250231262902898707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([acquisition_count]) / ([Days left (copy)_3196148426401583105])) * ([Calculation_3196148426401665026])' />
            </column>
            <column caption='registrations rr estimation' datatype='real' name='[new session rr estimation (copy) (copy)_250231262902894610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_250231262508957697]) / [Days left (copy)_3196148426401583105]) * ([Calculation_3196148426401665026])' />
            </column>
            <column caption='acquisition fraud ratio rr estimation' datatype='real' name='[new session rr estimation (copy)_1507017072785616898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;(sum([acq_count_fraud]) / [Days left (copy)_3196148426401583105]) * ([Calculation_3196148426401665026])&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;(sum([acquisition_count]) / [Days left (copy)_3196148426401583105]) * ([Calculation_3196148426401665026])&#13;&#10;)' />
            </column>
            <column caption='installs rr estimation' datatype='real' name='[new session rr estimation (copy)_250231262902861841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([num_of_installs]) / [Days left (copy)_3196148426401583105]) * ([Calculation_3196148426401665026])' />
            </column>
            <column-instance column='[Calculation_1799258426863525888]' derivation='None' name='[none:Calculation_1799258426863525888:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column caption='Num Of Installs' datatype='integer' name='[num_of_installs]' role='measure' type='quantitative' />
            <column caption='Num Of New Sessions' datatype='integer' name='[num_of_new_sessions]' role='measure' type='quantitative' />
