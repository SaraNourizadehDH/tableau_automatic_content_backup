                <zone forceUpdate='true' h='7147' id='133' type-v2='text' w='49560' x='49853' y='27419'>
                  <formatted-text>
                    <run bold='true'>Uplift Calculation (Attribution Window)</run>
                    <run>&#10;1. </run>
                    <run bold='true'>Manual Ad-hoc</run>
                    <run>: </run>
                    <run bold='true' fontcolor='#4e79a7'>48 hours for EMAIL, 12 hours for PUSH and IAM</run>
                    <run>
2. Automation: Depends on the sub category
     - </run>
                    <run bold='true'>Lifecycle</run>
                    <run>: </run>
                    <run bold='true' fontcolor='#499894'>30 days</run>
                    <run>&#10;     - </run>
                    <run bold='true'>Journey Disruption</run>
                    <run> (Cart Abandonment), </run>
                    <run bold='true'>Vendor Discovery</run>
                    <run> (Probot): </run>
                    <run bold='true' fontcolor='#59a14f'>1 day</run>
                    <run>&#10;     - </run>
                    <run bold='true'>Other Automation</run>
                    <run>: </run>
                    <run bold='true' fontcolor='#4e79a7'>48 hours for EMAIL, 12 hours for PUSH and IAM</run>
                  </formatted-text>
