          <datasource-dependencies datasource='federated.0ydzp2p1si9tbv18dt24s000chug'>
            <column caption='APAC Automation %' datatype='real' default-format='p0%' name='[Automation % (copy)_2536793253373566990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [is_prospect_na], [partition_month]: SUM([Channel Auto % (copy)_2536793253373800464]) })/3' />
            </column>
            <column caption='Include Prospect NA' datatype='boolean' name='[Calculation_2536793253094424579]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 2], TRUE, NOT [is_prospect_na])' />
            </column>
            <column caption='Country' datatype='string' name='[Calculation_2536793253100609543]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([is_prospect_na], &quot;Prospect NA&quot;, SPLIT([global_entity_id], &quot;_&quot;, 2))' />
            </column>
            <column caption='APAC Channel Auto %' datatype='real' default-format='p0%' name='[Channel Auto % (copy)_2536793253373800464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 8] = &quot;No&quot;,&#10;{ FIXED [is_prospect_na], [partition_month], [channel_type]: SUM(IIF([comms_category]=&quot;Automation&quot;, [comms_received], 0))} / { FIXED [is_prospect_na], [partition_month], [channel_type]: SUM([comms_received])},&#10;{ FIXED [is_prospect_na], [partition_month], [channel_type],[vertical_type]: SUM(IIF([comms_category]=&quot;Automation&quot;, [comms_received], 0))} / { FIXED [is_prospect_na], [partition_month], [channel_type],[vertical_type]: SUM([comms_received])})' />
            </column>
            <column caption='Total Comms' datatype='integer' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Comms Received (copy)_2536793253101113352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[comms_received]' />
            </column>
            <column caption='Channel Type' datatype='string' name='[channel_type]' role='dimension' type='nominal' />
            <column caption='Comms Category' datatype='string' name='[comms_category]' role='dimension' type='nominal' />
            <column caption='Comms Received' datatype='integer' name='[comms_received]' role='measure' type='quantitative' />
            <column caption='Comms Sub Category' datatype='string' name='[comms_sub_category]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Is Prospect Na' datatype='boolean' name='[is_prospect_na]' role='dimension' type='nominal' />
            <column-instance column='[partition_month]' derivation='MY' name='[my:partition_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_2536793253094424579]' derivation='None' name='[none:Calculation_2536793253094424579:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2536793253100609543]' derivation='None' name='[none:Calculation_2536793253100609543:nk]' pivot='key' type='nominal' />
            <column-instance column='[channel_type]' derivation='None' name='[none:channel_type:nk]' pivot='key' type='nominal' />
