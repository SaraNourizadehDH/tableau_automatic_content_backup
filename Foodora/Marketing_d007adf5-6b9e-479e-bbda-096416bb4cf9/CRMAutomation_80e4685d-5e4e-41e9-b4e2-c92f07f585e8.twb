          <datasource-dependencies datasource='Parameters'>
            <column alias='Engaged User % of MAU' caption='Metric' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Engaged User % of MAU' />
                <alias key='&quot;2&quot;' value='Engaged vs Unengaged Net GMV/user' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mqrgou07pwfyq1a9t2qc0k9iovd'>
            <column caption='Engaged vs Unengaged Net GMV/user' datatype='real' name='[Calculation_2643331566399754252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IIF([segment] = &quot;Engaged User&quot;, [gmv_net_eur], 0)) / &#10;SUM(IIF([segment] = &quot;Engaged User&quot;, [customers], 0))) / &#10;(SUM(IIF([segment] IN (&quot;Interacted User&quot;, &quot;Uninteracted User&quot;), [gmv_net_eur], 0)) / &#10;SUM(IIF([segment] IN (&quot;Interacted User&quot;, &quot;Uninteracted User&quot;), [customers], 0)))' />
            </column>
            <column caption='Engaged vs Unengaged' datatype='real' name='[Calculation_2643331566401773581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 7] == &apos;2&apos;,&#10;[Calculation_2643331566399754252],&#10;NULL)' />
            </column>
            <column caption='Engaged User %' datatype='real' default-format='p0%' name='[Calculation_5816961928547008517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 7] == &apos;1&apos;,&#10;SUM(IIF([segment] = &quot;Engaged User&quot;, [customers], 0))/SUM([customers]),&#10;NULL)' />
            </column>
            <column caption='Exclude Rows' datatype='boolean' name='[Calculation_5816961928560885767]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[segment] = &quot;Engaged User&quot; AND [is_mau] = &quot;Non-MAU&quot;' />
            </column>
            <column caption='Customers' datatype='integer' name='[customers]' role='measure' type='quantitative' />
            <column caption='GEID' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Gmv Net Eur' datatype='real' name='[gmv_net_eur]' role='measure' type='quantitative' />
            <column caption='Is Mau' datatype='string' name='[is_mau]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5816961928560885767]' derivation='None' name='[none:Calculation_5816961928560885767:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
