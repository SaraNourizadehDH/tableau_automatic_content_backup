        <calculation class='tableau' formula='IIF([Parameters].[Parameter 4], &#10;IIF([comms_sub_category] IN (&quot;All&quot;, &quot;Lifecycle&quot;, &quot;Journey Disruption&quot;, &quot;Vendor Discovery&quot;, &quot;Lifecycle - pandapro&quot;, &quot;Opt-in&quot;), TRUE, [channel_type] != &quot;All Channels&quot;),&#10;[channel_type] = &quot;All Channels&quot;)' />
      </column>
      <column caption='Comms / Comms Receiver' datatype='real' name='[Calculation_3880976993149825026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([comms_received])/SUM([user_received_comms])' />
      </column>
      <column caption='Reach %' datatype='real' name='[Calculation_3880976993150074884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([user_received_comms])/SUM([all_users])' />
      </column>
      <column caption='User Base' datatype='integer' name='[Calculation_3880976993151717381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 1] = &quot;All Users&quot;, SUM([all_users]), SUM([buyer_p1y]))' />
      </column>
      <column caption='Country Breakdown' datatype='string' name='[Calculation_3880976993413697547]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 3] = &quot;APAC&quot;, &quot;APAC&quot;, [Calculation_1328984153156726784])' />
      </column>
      <column caption='Comms %' datatype='real' default-format='p0%' name='[Calculation_3880976993439232014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([comms_received])/&#10;SUM({ FIXED [global_entity_id], [partition_date_utc]: SUM(IIF([comms_category] = &quot;All&quot;, [comms_received], 0)) })' />
      </column>
      <column caption='iOrders/&apos;000 comms' datatype='real' name='[Calculation_4172796201164804096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_uplift])/(SUM([comms_received])/1000)' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_6798605907254595584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;iOrders/&apos;000 comms&quot; THEN [Calculation_4172796201164804096]&#10;    WHEN &quot;iNet GMV/&apos;000 comms&quot; THEN [iOrders/&apos;000 comms (copy)_2208452708767232000]&#10;    WHEN &quot;Comms / User Received Comms&quot; THEN [Calculation_3880976993149825026]&#10;END' />
      </column>
      <column caption='APAC Automation %' datatype='real' hidden='true' name='[Calculation_6881992836114481153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TOTAL(SUM({ FIXED [global_entity_id], [partition_date_utc]: SUM(&#10;IIF([comms_category] = &quot;Automation&quot; AND [lifecycle_segment] = &quot;All&quot; AND [comms_sub_category] = &quot;All&quot;, &#10;{ FIXED [global_entity_id], [partition_date_utc], [lifecycle_segment], [comms_category]: [comms_received] },&#10;0&#10;))&#10;})&#10;/&#10;SUM({ FIXED [global_entity_id], [partition_date_utc]: SUM(&#10;IIF([comms_category] = &quot;All&quot; AND [lifecycle_segment] = &quot;All&quot; AND [comms_sub_category] = &quot;All&quot;, &#10;{ FIXED [global_entity_id], [partition_date_utc], [lifecycle_segment], [comms_category]: [comms_received] },&#10;0&#10;))&#10;}))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Grouping' datatype='string' hidden='true' name='[Calculation_8041951211024637952]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [comms_category] = &quot;Manual Ad-hoc&quot; THEN &quot;Ad-hoc&quot;&#10;ELSEIF [comms_sub_category] != &quot;All&quot; THEN &quot;Automation&quot;&#10;ELSE &quot;Others&quot;&#10;END' />
      </column>
      <column caption='Metric (Abs)' datatype='real' name='[Metric (copy)_5854327729180266499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;iOrders&quot; THEN SUM([orders_uplift])&#10;    WHEN &quot;iNet GMV&quot; THEN SUM([gmv_net_eur_uplift])&#10;END' />
      </column>
      <column caption='Period (copy)' datatype='date' default-format='*mmm yy' hidden='true' name='[Period (copy)_3771131437706080258]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[partition_date_utc]' />
      </column>
      <column caption='Total Comms (copy)' datatype='integer' name='[Total Comms (copy)_6881992836110655488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 1] = &quot;All Users&quot;, SUM([user_total_comms]), SUM([buyer_total_comms]))' />
      </column>
