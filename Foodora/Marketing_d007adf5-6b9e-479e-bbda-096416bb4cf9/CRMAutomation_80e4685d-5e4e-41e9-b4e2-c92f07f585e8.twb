      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_mkt_crm_automation_overview (pandata_report)' name='federated.13zokoo0bby61x1fkkta909z7cz6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Country Breakdown' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;APAC&quot;'>
              <calculation class='tableau' formula='&quot;APAC&quot;' />
            </column>
            <column caption='Channel Breakdown' datatype='boolean' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13zokoo0bby61x1fkkta909z7cz6'>
            <column caption='Country' datatype='string' name='[Calculation_1328984153156726784]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT([global_entity_id], 2)' />
            </column>
            <column caption='Channel Breakdown' datatype='string' name='[Calculation_1328984153160495105]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 4], [channel_type], &quot;All Channels&quot;)' />
              <aliases>
                <alias key='&quot;All Channels&quot;' value='All' />
              </aliases>
            </column>
            <column caption='Channel Filter' datatype='boolean' name='[Calculation_1328984153160744962]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 4], &#10;IIF([comms_sub_category] IN (&quot;All&quot;, &quot;Lifecycle&quot;, &quot;Journey Disruption&quot;, &quot;Vendor Discovery&quot;, &quot;Lifecycle - pandapro&quot;, &quot;Opt-in&quot;), TRUE, [channel_type] != &quot;All Channels&quot;),&#10;[channel_type] = &quot;All Channels&quot;)' />
            </column>
            <column caption='Comms / Comms Receiver' datatype='real' name='[Calculation_3880976993149825026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([comms_received])/SUM([user_received_comms])' />
            </column>
            <column caption='Country Breakdown' datatype='string' name='[Calculation_3880976993413697547]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 3] = &quot;APAC&quot;, &quot;APAC&quot;, [Calculation_1328984153156726784])' />
            </column>
            <column caption='Comms %' datatype='real' default-format='p0%' name='[Calculation_3880976993439232014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([comms_received])/&#10;SUM({ FIXED [global_entity_id], [partition_date_utc]: SUM(IIF([comms_category] = &quot;All&quot;, [comms_received], 0)) })' />
            </column>
            <column caption='iOrders/&apos;000 comms' datatype='real' name='[Calculation_4172796201164804096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_uplift])/(SUM([comms_received])/1000)' />
            </column>
            <column caption='Channel Type' datatype='string' name='[channel_type]' role='dimension' type='nominal' />
            <column caption='Comms Category' datatype='string' name='[comms_category]' role='dimension' type='nominal'>
