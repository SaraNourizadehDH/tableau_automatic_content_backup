    <worksheet name='Savings to Cost Ratio'>
      <table>
        <view>
          <datasources>
            <datasource caption='[SG] LTP Churn' name='federated.1lgz5wb1mt41jc114148h1oncxvz' />
          </datasources>
          <datasource-dependencies datasource='federated.1lgz5wb1mt41jc114148h1oncxvz'>
            <column caption='Total Savings' datatype='real' name='[Calculation_5796766072610295808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [customer_code], [subscription_uuid], [is_latest_payment_cycle]: SUM([discount_amount]) + SUM([voucher_amount]) + SUM([dps_amount])}' />
            </column>
            <column caption='Savings vs Plan Cost' datatype='string' name='[Calculation_5796766072610398209]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5796766072610295808] &gt; [Calculation_5796766072611045378] THEN &apos;Savings &gt; Cost&apos;&#10;ELSEIF [Calculation_5796766072610295808] = [Calculation_5796766072611045378] THEN &apos;Neutral&apos;&#10;ELSE &apos;Savings &lt; Cost&apos;&#10;END' />
            </column>
            <column caption='Total Plan Cost' datatype='real' name='[Calculation_5796766072611045378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [customer_code], [subscription_uuid], [is_latest_payment_cycle]: SUM([total_amount_local])}' />
            </column>
            <column caption='Savings to Cost Ratio' datatype='real' name='[Calculation_6421921996198518785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_5796766072610398209] = &apos;Savings &gt; Cost&apos; THEN [Total Savings (copy)_6421921996197851136]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Savings / Cost' datatype='real' name='[Total Savings (copy)_6421921996197851136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [customer_code], [subscription_uuid], [is_latest_payment_cycle]: SUM([Calculation_5796766072610295808]) / SUM([Calculation_5796766072611045378])}' />
            </column>
            <column-instance column='[Calculation_6421921996198518785]' derivation='Avg' name='[avg:Calculation_6421921996198518785:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[churn_status]' role='dimension' type='nominal' />
            <column datatype='string' name='[corporate_flag]' role='dimension' type='nominal' />
            <column datatype='string' name='[customer_code]' role='dimension' type='nominal' />
