      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Singapore&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_14BF48B555134CC5B2EDDD4E1EEB4699'>
            <properties context=''>
              <relation connection='bigquery.1m4u3tc0hvgodm1biz2231hxwejg' name='Custom SQL Query' type='text'><![CDATA[WITH pro_new_cvp_orders AS (

  SELECT

    billing.order_code AS order_id,

    MAX(IFNULL(gross_delivery_fee_discount_platform_local, 0)) OVER(PARTITION BY billing.order_code) AS platform_incentive_gross,

    MAX(IFNULL(gross_delivery_fee_discount_vendor_local, 0)) OVER(PARTITION BY billing.order_code) AS vendor_incentive_gross,

    MAX(IFNULL(net_delivery_fee_discount_platform_local, 0)) OVER(PARTITION BY billing.order_code) AS platform_incentive_net,

    MAX(IFNULL(net_delivery_fee_discount_vendor_local, 0)) OVER(PARTITION BY billing.order_code) AS vendor_incentive_net

  FROM `fulfillment-dwh-production.pandata_curated.billing_engine_workflow_sap_orders` billing

  JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` pd
    ON billing.order_code = pd.code
    AND pd.global_entity_id = 'FP_SG'
    AND pd.ordered_at_date_local >>= '2024-06-01'

  JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` acc
    ON CONCAT(pd.global_entity_id, "_", pd.code) = CONCAT(acc.global_entity_id, "_", acc.order_code)
    AND acc.global_entity_id = 'FP_SG'
    AND acc.created_date_utc >>= '2024-06-01'

  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` dps
    ON billing.order_code = dps.platform_order_code
    AND dps.country_code = 'sg'
    AND dps.created_date >>= '2024-06-01'

  WHERE billing.global_entity_id = 'FP_SG'
    AND billing.created_date_utc >>= '2024-06-01'
    AND pd.is_valid_order = TRUE
    AND pd.is_subscriber_order = TRUE
    AND acc.pd_order_fees_delivery_fee_adjustment_plus_vat_local << 0
    AND IFNULL(has_new_customer_condition, FALSE) = FALSE
    AND pd.business_type_apac IN ('restaurants', 'street_food', 'caterers')

  QUALIFY ROW_NUMBER() OVER(PARTITION BY billing.order_code) = 1

),

customer_subscriptions AS (

  SELECT

    customer_code,
    cus.uuid AS customer_uuid,
    sb.uuid AS subscription_uuid,
    latest_plan_duration,
    DATE(sb.subscription_start_at_local) AS subscription_start_date,
    DATE(sb.subscription_end_at_local) AS subscription_end_date,
    sb.subscription_start_at_local AS subscription_start_time,
    sb.subscription_end_at_local AS subscription_end_time,
    DATE(payments.subscription_start_at_local) AS payment_start_date,
    DATE(payments.subscription_end_at_local) AS payment_end_date,
    payments.subscription_start_at_local AS payment_start_time,
    payments.subscription_end_at_local AS payment_end_time,
    DATE_TRUNC(DATE(sb.subscription_start_at_local), MONTH) AS subscription_start_month,
    DATE_TRUNC(DATE(sb.subscription_end_at_local), MONTH) AS subscription_end_month,

    MAX(payments.subscription_start_at_local) OVER(PARTITION BY customer_code, sb.uuid) AS max_payment_start_time,
    MAX(payments.subscription_end_at_local) OVER(PARTITION BY customer_code, sb.uuid) AS max_payment_end_time,

    payments.is_free_trial,
    payments.payment_plan_duration,

    CASE
      WHEN payments.voucher_code != "" THEN TRUE
      ELSE FALSE
    END AS is_voucher_applied,

    payments.total_amount_local,

    ROW_NUMBER() OVER(PARTITION BY sb.uuid ORDER BY DATE(payments.subscription_start_at_local)) AS payment_rank,

    CASE
      WHEN MAX(payments.subscription_start_at_local) OVER(PARTITION BY customer_code, sb.uuid) = payments.subscription_start_at_local THEN TRUE
      ELSE FALSE
    END AS is_latest_payment_cycle,

    CASE
      WHEN plan_code LIKE '%corporate%' THEN 'Corporate'
      ELSE 'Non-Corporate'
    END AS corporate_flag,

    CASE
      WHEN DATE(sb.subscription_end_at_local) << CURRENT_DATE() THEN 'Churn'
      ELSE 'Prospective Churn'
    END AS churn_status,

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_subscriptions` sb, 
  UNNEST(payments) AS payments

  JOIN `fulfillment-dwh-production.pandata_curated.cus_customers` cus
    ON sb.customer_code = cus.code
    AND cus.global_entity_id = 'FP_SG'

  WHERE sb.global_entity_id = 'FP_SG'
    AND created_date_local <<= CURRENT_DATE()
    AND payments.is_status_success = TRUE
    AND latest_plan_duration IN ('6M', '12M')
    -- AND DATE(sb.subscription_end_at_local) << CURRENT_DATE()
    AND DATE_TRUNC(DATE(sb.subscription_end_at_local), MONTH) BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH) AND LAST_DAY(CURRENT_DATE(), YEAR)

),

subsequent_subscriptions AS (

  SELECT

    sb.customer_code,
    sb.uuid AS subscription_uuid,
    initial_plan_duration,
    customer_subscriptions.subscription_end_time,

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_subscriptions` sb

  JOIN customer_subscriptions
    ON sb.customer_code = customer_subscriptions.customer_code
    AND sb.subscription_start_at_local >> customer_subscriptions.subscription_end_time
    AND DATE_DIFF(sb.subscription_start_at_local, customer_subscriptions.subscription_end_time, DAY) <<= 30

  WHERE sb.global_entity_id = 'FP_SG'
    AND created_date_local << CURRENT_DATE()

  QUALIFY ROW_NUMBER() OVER(PARTITION BY customer_code ORDER BY sb.subscription_start_at_local) = 1

),

subsequent_orders AS (

  SELECT

    customer_uuid,
    subscription_uuid,
    customer_subscriptions.payment_end_time,

    CASE
      WHEN COUNT(DISTINCT CASE WHEN is_subscriber_order = FALSE THEN pd.code END) OVER(PARTITION BY customer_uuid, payment_end_time) >> 0 THEN TRUE
      ELSE FALSE
    END AS has_non_subscriber_order,
  
    CASE
      WHEN COUNT(DISTINCT CASE WHEN is_subscriber_order = TRUE THEN pd.code END) OVER(PARTITION BY customer_uuid, payment_end_time) >> 0 THEN TRUE
      ELSE FALSE
    END AS has_subscriber_order,

    CASE
      WHEN COUNT(DISTINCT pd.code) OVER(PARTITION BY customer_uuid, payment_end_time) >> 0 THEN TRUE
      ELSE FALSE
    END AS has_order,

  FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` pd

  JOIN customer_subscriptions
    ON pd.pd_customer_uuid = customer_subscriptions.customer_uuid
    AND is_latest_payment_cycle = TRUE
    AND ordered_at_local >> customer_subscriptions.payment_end_time
    AND DATE_DIFF(ordered_at_local, customer_subscriptions.payment_end_time, DAY) <<= 30

  WHERE is_valid_order = TRUE
    AND is_test_order = FALSE

  QUALIFY ROW_NUMBER() OVER(PARTITION BY customer_uuid, subscription_uuid) = 1

),

subscription_activity AS (

  SELECT

    customer_uuid,
    subscription_uuid,
    customer_subscriptions.payment_end_date,

    COUNT(DISTINCT subscription_period) OVER(PARTITION BY customer_uuid, payment_end_date) AS subscription_days,
    COUNT(DISTINCT ordered_at_date_local) OVER(PARTITION BY customer_uuid, payment_end_date) AS active_days,

  FROM customer_subscriptions
  JOIN UNNEST(GENERATE_DATE_ARRAY(payment_start_date, payment_end_date, INTERVAL 1 DAY)) AS subscription_period

  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` pd
    ON ordered_at_date_local BETWEEN payment_start_date AND payment_end_date
    AND pd.pd_customer_uuid = customer_subscriptions.customer_uuid
    AND pd.is_valid_order = TRUE
    AND pd.is_test_order = FALSE
  
  WHERE is_latest_payment_cycle = TRUE

  QUALIFY ROW_NUMBER() OVER(PARTITION BY customer_code, payment_end_date) = 1

),

order_info AS (

  SELECT

    customer_subscriptions.customer_code,
    customer_subscriptions.customer_uuid,
    max_payment_start_time,
    max_payment_end_time,
    
    IFNULL(IFNULL(MAX(ordered_at_date_local), MAX(DATE(DATE_ADD(last_associated_order_placed_at_utc, INTERVAL 8 HOUR)))), MAX(DATE(DATE_ADD(first_associated_order_placed_at_utc, INTERVAL 8 HOUR)))) AS last_order_date,
    
    COUNT(DISTINCT code) AS orders,

    SUM(CASE
      WHEN is_subscription_discount_order = TRUE THEN pd.discount_amount_local
      ELSE 0
    END) AS discount_amount,

    SUM(CASE
      WHEN is_subscription_voucher_order = TRUE THEN pd.voucher_amount_local
      ELSE 0
    END) AS voucher_amount,

    SUM(IFNULL(platform_incentive_gross, 0)) + SUM(IFNULL(vendor_incentive_gross, 0)) AS dps_amount,

  FROM customer_subscriptions

  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` pd
    ON customer_subscriptions.customer_uuid = pd.pd_customer_uuid
    AND pd.ordered_at_local BETWEEN max_payment_start_time AND max_payment_end_time

  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__order_subscriptions` sb
    ON pd.code = sb.order_code
    AND sb.global_entity_id = 'FP_SG'

  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_cdp.customers` cdp
    ON customer_subscriptions.customer_code = cdp.customer_id
    AND cdp.global_entity_id = 'FP_SG'
    AND cdp.snapshot_date_utc = DATE(max_payment_start_time)
  
  LEFT JOIN pro_new_cvp_orders
    ON pd.code = pro_new_cvp_orders.order_id

  WHERE is_latest_payment_cycle = TRUE

  GROUP BY 1,2,3,4

)

SELECT

  customer_subscriptions.*,
  last_order_date,
  IFNULL(orders, 0) AS orders,
  IFNULL(discount_amount, 0) AS discount_amount,
  IFNULL(voucher_amount, 0) AS voucher_amount,
  IFNULL(dps_amount, 0) AS dps_amount,

  CASE
    WHEN last_order_date IS NULL THEN 1000000
    ELSE DATE_DIFF(DATE(customer_subscriptions.max_payment_end_time), last_order_date, DAY) 
  END AS last_order_duration,

  CASE
    WHEN subsequent_subscriptions.customer_code IS NOT NULL THEN TRUE
    ELSE FALSE
  END AS has_subsequent_plan,

  IFNULL(has_order, FALSE) AS has_order,
  IFNULL(has_subscriber_order, FALSE) AS has_subscriber_order,
  IFNULL(has_non_subscriber_order, FALSE) AS has_non_subscriber_order,
  initial_plan_duration AS subsequent_plan_duration,
  subscription_days,
  active_days,

FROM customer_subscriptions

LEFT JOIN order_info
  ON customer_subscriptions.customer_code = order_info.customer_code
  AND customer_subscriptions.payment_start_time = order_info.max_payment_start_time

LEFT JOIN subsequent_subscriptions
  ON customer_subscriptions.customer_code = subsequent_subscriptions.customer_code
  AND customer_subscriptions.subscription_end_time = subsequent_subscriptions.subscription_end_time

LEFT JOIN subsequent_orders
  ON customer_subscriptions.customer_uuid = subsequent_orders.customer_uuid
  AND customer_subscriptions.payment_end_time = subsequent_orders.payment_end_time

LEFT JOIN subscription_activity
  ON customer_subscriptions.customer_uuid = subscription_activity.customer_uuid
  AND customer_subscriptions.payment_end_date = subscription_activity.payment_end_date]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
