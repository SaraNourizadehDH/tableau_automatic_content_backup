      <column aggregation='Sum' caption='30 Day Window of Full Subscription Duration' datatype='integer' name='[Calculation_5796766072615321605]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='FLOOR([Calculation_5796766072615059460] / 30) * 30' />
      </column>
      <column caption='Savings to Cost Ratio' datatype='real' name='[Calculation_6421921996198518785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5796766072610398209] = &apos;Savings &gt; Cost&apos; THEN [Total Savings (copy)_6421921996197851136]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='% of Churned Resubed' datatype='real' name='[Calculation_6469420898528612352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [has_subsequent_plan] = TRUE THEN [customer_code] END) / COUNTD([customer_code])' />
