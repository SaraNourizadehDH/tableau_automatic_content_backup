          <named-connection caption='BigQuery' name='bigquery.0pcyu4q0lt0tbb1750dt40egr6g6'>
            <connection CATALOG='foodpanda-bd-bigquery' EXECCATALOG='foodpanda-bd-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata Country - BD' schema='pandata_bd_marketing' server-oauth='' username='fahim.anik@foodpanda.com.bd' workgroup-auth-mode='prompt' />
