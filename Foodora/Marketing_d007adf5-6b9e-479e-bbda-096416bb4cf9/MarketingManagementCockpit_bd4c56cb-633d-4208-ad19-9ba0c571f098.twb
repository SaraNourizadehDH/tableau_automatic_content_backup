    <worksheet name='M YoY (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='mkt_growth_sessions' name='federated.10urtvy15qc58513jeq8i0tjhqum (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.10urtvy15qc58513jeq8i0tjhqum (copy)].[Latest_Week (copy)_3320208505290743809]' _.fcp.ParameterDefaultValues.true...source-field='[federated.10urtvy15qc58513jeq8i0tjhqum (copy)].[order_month (copy)_1197113132473585665]' caption='Reporting Month' datatype='date' default-format='*MMM - YY' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-01#'>
              <calculation class='tableau' formula='#2025-08-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10urtvy15qc58513jeq8i0tjhqum (copy)'>
            <column caption='&lt;= Reporting Month (copy)' datatype='boolean' name='[&lt;= Reporting Month (copy)_902127355805708302]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_month]&lt;= [Parameters].[Parameter 1 1]' />
            </column>
            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_164873985239498753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sessions Existing Customers' datatype='integer' name='[Calculation_2543759774948323328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[sessions] - [sessions_new]' />
            </column>
            <column caption='ACVR' datatype='real' name='[Calculation_659284805081571342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acquisition]) / SUM([sessions_new])' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_659284805081706511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transaction]) / SUM([sessions])' />
            </column>
            <column caption='YoY Acquisition' datatype='real' name='[Calculation_659284805140566053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([acquisition])) - LOOKUP(ZN(SUM([acquisition])), -12)) / ABS(LOOKUP(ZN(SUM([acquisition])), -12))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='YoY Title' datatype='string' name='[LM YoY Title (copy)_3357222421324894246]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[Parameters].[Parameter 1 1]),3) + &quot; YoY&quot;' />
            </column>
            <column caption='Latest_Month' datatype='date' name='[Latest_Week (copy)_3320208505290743809]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([order_month])}' />
            </column>
            <column caption='dummy' datatype='integer' name='[Month Filter (copy)_5277374343931424775 1]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='YoY CVR' datatype='real' name='[YoY Acquisition (copy)_659284805142560806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(([Calculation_659284805081706511])) - LOOKUP(ZN(([Calculation_659284805081706511])), -12)) * 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='YoY ACVR' datatype='real' name='[YoY CVR (copy)_659284805415006258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(([Calculation_659284805081571342])) - LOOKUP(ZN(([Calculation_659284805081571342])), -12))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='YoY Sessions' datatype='real' name='[YoY CVR (copy)_659284805415493683]' role='measure' type='quantitative'>
