      <column caption='% Monthly Active of 90 Days Active (EOM)' datatype='real' hidden='true' name='[Calculation_1588926297467367429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([active_customers])/sum([active_customers_eom_90])' />
