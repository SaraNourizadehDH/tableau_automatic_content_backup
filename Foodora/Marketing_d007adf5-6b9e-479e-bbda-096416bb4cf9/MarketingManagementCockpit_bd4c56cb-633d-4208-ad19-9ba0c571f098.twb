        <view>
          <datasources>
            <datasource caption='mkt_growth_sessions' name='federated.10urtvy15qc58513jeq8i0tjhqum (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.10urtvy15qc58513jeq8i0tjhqum (copy)].[Calculation_3320208505289175040]' _.fcp.ParameterDefaultValues.true...source-field='[federated.10urtvy15qc58513jeq8i0tjhqum (copy)].[order_week (copy)_1197113132473868291]' caption='Reporting Week' datatype='date' default-format='*dd/mm/yyyy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-18#'>
              <calculation class='tableau' formula='#2025-08-18#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10urtvy15qc58513jeq8i0tjhqum (copy)'>
            <column caption='Sessions Existing Customers' datatype='integer' name='[Calculation_2543759774948323328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[sessions] - [sessions_new]' />
            </column>
            <column caption='Latest_Week' datatype='date' name='[Calculation_3320208505289175040]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([order_week])}' />
            </column>
            <column caption='WoW Sessions' datatype='real' name='[Calculation_659284804805369861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN((SUM([sessions]))) - LOOKUP(ZN(SUM([sessions])), -1)) / ABS(LOOKUP((SUM([sessions])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='INDEX WEEK' datatype='integer' name='[Calculation_659284804827303943]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='WoW Acquisition' datatype='real' name='[Calculation_659284805065400330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN((SUM([acquisition]))) - LOOKUP(ZN(SUM([acquisition])), -1)) / ABS(LOOKUP((SUM([acquisition])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='WoW Succesful Orders' datatype='real' name='[Calculation_659284805065580555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN((SUM([successful_orders]))) - LOOKUP(ZN(SUM([successful_orders])), -1)) / ABS(LOOKUP((SUM([successful_orders])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='ACVR' datatype='real' name='[Calculation_659284805081571342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acquisition]) / SUM([sessions_new])' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_659284805081706511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transaction]) / SUM([sessions])' />
            </column>
            <column caption='WoW Paid Search Sessions' datatype='real' hidden='true' name='[Calculation_659284805091958803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN((SUM([paid_search_sessions]))) - LOOKUP(ZN(SUM([paid_search_sessions])), -1)) / ABS(LOOKUP((SUM([paid_search_sessions])), -1))'>
