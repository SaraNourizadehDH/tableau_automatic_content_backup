    <datasource caption='mkt_growth_sessions' inline='true' name='federated.10urtvy15qc58513jeq8i0tjhqum (copy)' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0xts1xu13crpc919pgu9f12kld22 (copy)'>
            <connection CATALOG='dhh---analytics-eu' EXECCATALOG='dhh---analytics-eu' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata EU Production' schema='sandbox' server-oauth='' username='nur.keskin@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='left' type='join'>
          <clause type='join'>
            <expression op='AND'>
              <expression op='='>
                <expression op='[mkt_growth_sessions].[global_entity_id]' />
                <expression op='[Custom SQL Query].[global_entity_id]' />
              </expression>
              <expression op='='>
                <expression op='[mkt_growth_sessions].[order_month]' />
                <expression op='[Custom SQL Query].[order_date]' />
              </expression>
            </expression>
          </clause>
          <relation connection='bigquery.0xts1xu13crpc919pgu9f12kld22 (copy)' name='mkt_growth_sessions' table='[dhh---analytics-eu.sandbox].[mkt_growth_sessions]' type='table' />
          <relation connection='bigquery.0xts1xu13crpc919pgu9f12kld22 (copy)' name='Custom SQL Query' type='text'>WITH countries as &#13;
(&#13;
SELECT &#13;
   order_date,&#13;
	 global_entity_id&#13;
	,sum(orders_rr) orders_month_rr&#13;
	,sum(acquisitions_rr) acquisitions_month_rr&#13;
	,sum(gmv_eur_rr) gmv_eur_month_rr&#13;
        ,sum(rr_orders_dmart) orders_dmart_month_rr&#13;
FROM `dhh---analytics-eu.bl_europe.monthly_run_rate`&#13;
WHERE global_entity_id IN (&#13;
&quot;FP_SK&quot;,&#13;
&quot;DJ_CZ&quot;,&#13;
&quot;FO_NO&quot;,&#13;
&quot;MJM_AT&quot;,&#13;
&quot;OP_SE&quot;,&#13;
&quot;PO_FI&quot;,&#13;
&quot;NP_HU&quot;,&#13;
&quot;HN_DK&quot;,&#13;
&quot;YS_TR&quot;)&#13;
&#13;
group by 1,2 &#13;
),&#13;
total AS&#13;
(&#13;
SELECT &#13;
