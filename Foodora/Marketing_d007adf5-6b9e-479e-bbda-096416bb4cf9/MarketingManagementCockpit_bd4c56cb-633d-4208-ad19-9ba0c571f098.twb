    <worksheet name='M MTD Growth (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='mkt_growth_sessions' name='federated.10urtvy15qc58513jeq8i0tjhqum (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.10urtvy15qc58513jeq8i0tjhqum (copy)'>
            <column caption='Sessions Existing Customers' datatype='integer' name='[Calculation_2543759774948323328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[sessions] - [sessions_new]' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_659284805542473789]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[date_utc]) = DATETRUNC(&apos;month&apos;,today())&#10;OR DAY(TODAY()) = 1 AND MONTH([date_utc]) = MONTH(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_659284805542654014]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[date_utc]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,today())) &#10;    AND day([date_utc]) &lt;= day(today())-1&#10;OR DAY(TODAY()) = 1 AND MONTH([date_utc]) = MONTH(TODAY()-1)-1' />
            </column>
            <column caption='MTD growth % Acquisition ' datatype='real' name='[GMV MTD growth % (copy)_317996380369608704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_659284805542473789], [acquisition], 0))/&#10;SUM(iif([Calculation_659284805542654014], [acquisition], 0)))-1' />
            </column>
            <column caption='MTD  Growth Title' datatype='string' name='[MTD Title (copy)_21673596542980104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,TODAY()-1),3) + &quot; MTD Growth %&quot;' />
            </column>
            <column caption='MTD growth % ACVR 2' datatype='real' name='[MTD growth % ACVR (copy)_69805855358820357]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(iif([Calculation_659284805542473789], [acquisition], 0) / iif([Calculation_659284805542473789], [sessions_new], 0)) -&#10;(SUM(iif([PMTD (copy)_69805855358144513], [acquisition], 0) / iif([PMTD (copy)_69805855358144513], [sessions_new], 0))))-1)' />
            </column>
            <column caption='MTD growth % Orders' datatype='real' name='[MTD growth % Acquisition  (copy)_659284805545127999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_659284805542473789], [successful_orders], 0))/&#10;SUM(iif([Calculation_659284805542654014], [successful_orders], 0)))-1' />
            </column>
            <column caption='MTD growth % CVR 2' datatype='real' name='[MTD growth % CVR (copy)_69805855358521347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_659284805542473789], [transaction], 0) / iif([Calculation_659284805542473789], [sessions], 0)) -&#10;(SUM(iif([PMTD (copy)_69805855358144513], [transaction], 0) / iif([PMTD (copy)_69805855358144513], [sessions], 0))))-1' />
            </column>
            <column caption='MTD growth % New Session  2' datatype='real' name='[MTD growth % New Session  (copy)_69805855358734340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_659284805542473789], [sessions_new], 0))/&#10;SUM(iif([PMTD (copy)_69805855358144513], [sessions_new], 0)))-1' />
            </column>
            <column caption='MTD growth % Organic Sessions 2' datatype='real' name='[MTD growth % Organic Sessions (copy)_69805855359455240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_659284805542473789], [organic_search_sessions], 0))/&#10;SUM(iif([PMTD (copy)_69805855358144513], [organic_search_sessions], 0)))-1' />
            </column>
            <column caption='MTD growth % Social Sessions' datatype='real' hidden='true' name='[MTD growth % Paid Sessions (copy) (copy)_659284805545828419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_659284805542473789], [social_sessions], 0))/&#10;SUM(iif([Calculation_659284805542654014], [social_sessions], 0)))-1' />
            </column>
            <column caption='MTD growth % Paid Sessions 2' datatype='real' name='[MTD growth % Paid Sessions (copy)_69805855359311879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_659284805542473789], [paid_search_sessions], 0))/&#10;SUM(iif([PMTD (copy)_69805855358144513], [paid_search_sessions], 0)))-1' />
            </column>
            <column caption='MTD growth % Session 2' datatype='real' name='[MTD growth % Session  (copy)_69805855358251010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_659284805542473789], [sessions], 0))/&#10;SUM(iif([PMTD (copy)_69805855358144513], [sessions], 0)))-1' />
