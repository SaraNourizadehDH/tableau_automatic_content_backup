        </aliases>
      </column>
      <column caption='# 90 Days Active (EOM)' datatype='integer' hidden='true' name='[Calculation_123567568447447040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([active_customers_eom_90])' />
      </column>
      <column caption='# New Customers' datatype='integer' name='[Calculation_123567568449576967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([new_customer_count])' />
      </column>
      <column caption='# Reactivations' datatype='integer' name='[Calculation_123567568449675272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([reactivated_from_churn]) + SUM([reactivated_from_inactive])' />
      </column>
      <column caption='# Churn ( of BOM 90 Days Active)' datatype='integer' name='[Calculation_123567568450293769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-sum([churn])' />
      </column>
      <column caption='# Existing Customers' datatype='real' name='[Calculation_123567568450531338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([weekly_total_active_customer_count])-sum([new_customer_count])-sum([reactivated_from_churn])-SUM([reactivated_from_inactive])' />
      </column>
      <column caption='# Inactive (of BOM 90 Days Active)' datatype='integer' hidden='true' name='[Calculation_123567568450945035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([active_customers_eom_90])-sum([active_customers])' />
      </column>
      <column caption='% Churn (of BOM)' datatype='real' hidden='true' name='[Calculation_123567568458453017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-sum([churn90])/sum([active_customers_bom_90])' />
      </column>
      <column caption='% Reactivations (of EOM)' datatype='real' hidden='true' name='[Calculation_123567568458510362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([reactivations])/sum([active_customers_eom_90])' />
      </column>
      <column caption='# Net Growth' datatype='integer' hidden='true' name='[Calculation_123567568459264027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([new_customers])+sum([reactivations])-SUM([churn90])' />
      </column>
      <column caption='% Net Churn (of BOM)' datatype='real' hidden='true' name='[Calculation_123567568469499933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-(sum([churn90])-sum([reactivations]))/SUM([active_customers_bom_90])' />
      </column>
      <column caption='% New Customers (of EOM)' datatype='real' hidden='true' name='[Calculation_123567568476454942]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([new_customers])/sum([active_customers_eom_90])' />
      </column>
      <column caption='report_date_m_excl' datatype='date' hidden='true' name='[Calculation_1307451294419419149]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [report_date] &lt; DATETRUNC(&apos;month&apos;, TODAY()) then [report_date] END' />
