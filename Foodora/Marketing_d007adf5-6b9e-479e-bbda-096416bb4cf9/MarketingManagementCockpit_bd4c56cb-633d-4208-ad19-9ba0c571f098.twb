      <aliases enabled='yes' />
      <column caption='% Customer Reorder Rate - 60d' datatype='real' hidden='true' name='[% Customer Reorder Rate - 30d (copy)_226868887397466112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([active_customers_ro_60d])/sum(if [report_date]&lt;dateadd(&apos;month&apos;,-2,DATE(DATETRUNC(&apos;month&apos;,TODAY()))) THEN [active_customers_ro_60d_den] END)' />
      </column>
      <column caption='# Net Churn' datatype='integer' hidden='true' name='[% Net Churn (of BOM) (copy)_1588926297568903175]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-(sum([churn90])-sum([reactivations]))' />
      </column>
      <column caption='% Total Flow In (of EOM)' datatype='real' hidden='true' name='[% Reactivations (of EOM) (copy)_1588926297463193602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([new_customers])+sum([reactivations]))/sum([active_customers_eom_90])' />
      </column>
      <column caption='% Customer Reorder Rate - 30d' datatype='real' hidden='true' name='[% Retention (of Monthly Active) (copy)_123567568478666784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([active_customers_ro_30d])/sum(if [report_date]&lt;dateadd(&apos;month&apos;,-1,DATE(DATETRUNC(&apos;month&apos;,TODAY()))) THEN [active_customers_ro_30d_den] END)' />
      </column>
      <column caption='# Total Flow In' datatype='integer' hidden='true' name='[% Total Flow In (of EOM) (copy)_1588926297569333256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([new_customers])+sum([reactivations]))' />
      </column>
      <column caption='% Monthly Order Growth - YoY' datatype='real' hidden='true' name='[([blend_successful_orders]]/[blend_success_orders_ly_gdwh]])-1 (copy) (copy)_165507324687163423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1597089045361344521]/[blend_success_orders_ly (copy)_165507324686856220])-1' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.092rwen0upps2y1gauyef1ql24j3 (copy 2)].[usr:Calculation_123567568449576967:qk]&quot;' value='# New Customers - made their first successful order within the week' />
          <alias key='&quot;[federated.092rwen0upps2y1gauyef1ql24j3 (copy 2)].[usr:Calculation_123567568449675272:qk]&quot;' value='# Reactivations - were not active for 30 days before the week but made an order during week' />
          <alias key='&quot;[federated.092rwen0upps2y1gauyef1ql24j3 (copy 2)].[usr:Calculation_123567568450531338:qk]&quot;' value='# Existing Customers' />
