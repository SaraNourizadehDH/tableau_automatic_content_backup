            </column>
            <column caption='INDEX MONTH' datatype='integer' name='[Calculation_164873985239498753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sessions Existing Customers' datatype='integer' name='[Calculation_2543759774948323328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[sessions] - [sessions_new]' />
            </column>
            <column caption='ACVR' datatype='real' name='[Calculation_659284805081571342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acquisition]) / SUM([sessions_new])' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_659284805081706511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transaction]) / SUM([sessions])' />
            </column>
            <column caption='MTD Title' datatype='string' name='[Calculation_659284805539856444]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[date_utc]),3) + &quot; MTD&quot;' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_659284805542473789]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[date_utc]) = DATETRUNC(&apos;month&apos;,today())&#10;OR DAY(TODAY()) = 1 AND MONTH([date_utc]) = MONTH(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_659284805542654014]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[date_utc]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,today())) &#10;    AND day([date_utc]) &lt;= day(today())-1&#10;OR DAY(TODAY()) = 1 AND MONTH([date_utc]) = MONTH(TODAY()-1)-1' />
            </column>
            <column caption='Latest_Month' datatype='date' name='[Latest_Week (copy)_3320208505290743809]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([order_month])}' />
            </column>
            <column caption='MTD growth % Social Sessions' datatype='real' hidden='true' name='[MTD growth % Paid Sessions (copy) (copy)_659284805545828419]' role='measure' type='quantitative'>
