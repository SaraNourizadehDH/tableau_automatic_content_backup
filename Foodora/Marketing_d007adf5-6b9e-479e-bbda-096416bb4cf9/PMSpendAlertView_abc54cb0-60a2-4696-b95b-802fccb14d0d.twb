        <calculation class='tableau' formula='case [marketing_channel]&#13;&#10;when &apos;Organic&apos; then &apos;Organic&apos;&#13;&#10;when &apos;Affiliate&apos; then &apos;PM&apos;&#13;&#10;when &apos;App marketing - RMO&apos; then &apos;PM&apos;&#13;&#10;when &apos;App marketing - Reach/RMA&apos; then &apos;PM&apos;&#13;&#10;when &apos;Display - RMO&apos; then &apos;PM&apos;&#13;&#10;when &apos;Display - Reach/RMA&apos; then &apos;PM&apos;&#13;&#10;when &apos;Paid Social - RMO&apos; then &apos;PM&apos;&#13;&#10;when &apos;Paid Social - Reach/RMA&apos; then &apos;PM&apos;&#13;&#10;when &apos;SEM - RMO&apos; then &apos;PM&apos;&#13;&#10;when &apos;SEM Brand&apos; then &apos;PM&apos;&#13;&#10;when &apos;SEM non-brand&apos; then &apos;PM&apos;&#13;&#10;else &apos;Other&apos;&#13;&#10;end' />
