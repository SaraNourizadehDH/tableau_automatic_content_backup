      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='regional budgets' id='_2A5E9FD59B5448EEAF35B47609AE2BDD'>
            <properties context=''>
              <relation connection='bigquery.17trp3m0o7hkwt1f9sa8d122wnh2 (copy)' name='regional budgets query' type='text'>with raw as &#13;
(&#13;
SELECT global_entity_id,&#13;
month,&#13;
acquisitions total_acq_target,&#13;
reacquisitions total_reacq_target,&#13;
PM_acq_target,&#13;
acquisitions-PM_acq_target as nonPM_acq_target&#13;
FROM `dhh---analytics-eu.bi_marketing.KPIs_targets_OKRs_tableau`&#13;
&#13;
left join ( &#13;
          SELECT &#13;
        global_entity_id,&#13;
        date as month,&#13;
        sum(acquisition) PM_acq_target&#13;
        FROM `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_cs_targets_and_budgets_enriched`&#13;
        where date &gt;&gt;= &apos;2024-01-01&apos;&#13;
        and acquisition &gt;&gt;0&#13;
        and channel_targets in (&apos;App (Reach / RMA)&apos;,&apos;Display (Reach / RMA)&apos;,&apos;Paid Social (Reach / RMA)&apos;,&apos;SEM (non-brand)&apos;,&apos;SEM Brand&apos;) &#13;
        group by all)&#13;
&#13;
using (global_entity_id,month)&#13;
&#13;
where month = date_trunc(current_date(),month)&#13;
)&#13;
&#13;
&#13;
SELECT&#13;
  global_entity_id,&#13;
  month,&#13;
  pm_nonpm_total,&#13;
  acquisitions_target,&#13;
total_reacq_target&#13;
FROM (&#13;
  SELECT&#13;
    global_entity_id,&#13;
    month,&#13;
    &apos;total&apos; AS pm_nonpm_total,&#13;
    total_acq_target AS acquisitions_target,&#13;
    total_reacq_target&#13;
  FROM&#13;
    raw&#13;
  UNION ALL&#13;
  SELECT&#13;
    global_entity_id,&#13;
    month,&#13;
    pm_nonpm_total,&#13;
    acquisitions_target,&#13;
    null total_reacq_target&#13;
  FROM&#13;
    raw&#13;
  UNPIVOT(acquisitions_target FOR pm_nonpm_total IN (&#13;
    PM_acq_target AS &apos;PM&apos;,&#13;
    nonPM_acq_target AS &apos;nonPM&apos;&#13;
  ))&#13;
)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='bima_cs' inline='true' name='federated.1vv0wqm14enmn51gzkkhj1s8fgwm' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0gkhfo1178hvoz10x5wkd10gcqkk'>
            <connection CATALOG='dhh---analytics-eu' EXECCATALOG='dhh---analytics-eu' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='EU Data Production' schema='pandata_report' server-oauth='server-custom' username='aykut.sezen@yemeksepeti.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0gkhfo1178hvoz10x5wkd10gcqkk' name='regional overview query' type='text'><![CDATA[WITH 
  bima AS (
  SELECT
    global_entity_id,
    CASE
      WHEN lower(platform) LIKE 'mobile web' THEN 'web'
    ELSE
    lower(platform)
  END
    AS platform,
    date,
    CASE
      WHEN ( (channel LIKE 'BRAND' AND sub_channel IN ('APPDIRECT', 'WEBDIRECT', 'SEO')) OR (channel LIKE 'SEO') ) THEN 'Organic'
      when channel = 'AFFILIATE' THEN 'Affiliate'
    ELSE
    'Other'
  END
    AS marketing_channel,
    'Other/Organic' as sub_channel,
    CASE
      WHEN ( (channel LIKE 'BRAND' AND sub_channel IN ('APPDIRECT', 'WEBDIRECT', 'SEO')) OR (channel LIKE 'SEO') ) THEN 'organic'
      when channel = 'AFFILIATE' THEN 'affiliate'
    ELSE
    'other'
  END
    AS SOURCE,
    SUM(case when channel = 'AFFILIATE' then 0 else costs_eur end) cost,
    SUM(new_sessions) new_sessions,
    0 impressions,
    0 installs,
    0 skan_installs,
    0 signups,
    0 projected_cost,
    0 projected_acq,
    SUM(acquisitions_calibration_ios14fix) acquisitions_calibration_ios14fix
  FROM
    `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_l2_detailed`
  WHERE
    date between '2023-01-01' and DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
AND channel NOT IN ('SEM','APP','DISPLAY','PAIDSOCIAL')
AND NOT ( channel LIKE 'BRAND' AND sub_channel LIKE 'SEM' )
  GROUP BY all),

apac_aff as (
  SELECT  
   global_entity_id,
   lower(platform) as platform,
   conversion_date AS date,
  "Affiliate" AS marketing_channel,
  'Other/Organic' as sub_channel,
   "affiliate" AS source,
   SUM(cost_eur) spend,
    0 new_sessions,
    0 impressions,
    0 installs,
    0 skan_installs,
    0 signups,
    0 projected_cost,
    0 projected_acq,
    0 acquisitions_calibration_ios14fix
FROM `fulfillment-dwh-production.pandata_report.regional_apac_online_clarisights_affiliate_cost` 
WHERE conversion_date  between '2023-01-01'  and DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
GROUP BY ALL
HAVING spend >> 1
),

  cs_cost AS (
  SELECT
    global_entity_id,
    CASE 
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_and_") THEN "android"
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_ios_") THEN "ios"
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_web_") THEN "web"
      when REGEXP_CONTAINS(LOWER(campaign), r"_mix_") THEN "mix"
      ELSE LOWER(platform)
  END AS os_name,
    date,
CASE
    	WHEN (LOWER(campaign) LIKE '%dv360%' or LOWER(campaign) LIKE '%mob_bra%') and not (LOWER(campaign) LIKE '%_rma_%' or LOWER(campaign) LIKE '%_reach_%') THEN 'Online branding - App'
	    WHEN LOWER(campaign) LIKE '%dis_bra%' THEN 'Online branding - Display'
	    WHEN LOWER(campaign) LIKE '%dis_xrea%' THEN 'Extended reach - Display'
      WHEN (LOWER(campaign) LIKE '%ps_bra%' OR LOWER(campaign) LIKE '%smartly_bra%' OR LOWER(campaign) LIKE '%tiktok_bra%') THEN 'Online branding - PS'
      WHEN (LOWER(campaign) LIKE '%smartly_xrea%' OR LOWER(campaign) LIKE '%ps_xrea%') THEN 'Extended reach - PS'
      WHEN campaign LIKE 'dis_rmo%' THEN 'Display - RMO'
      WHEN campaign LIKE 'mob_rmo%' THEN 'App marketing - RMO'
      WHEN campaign LIKE 'mob_%' THEN 'App marketing - Reach/RMA'
      WHEN campaign LIKE 'dis_r%' THEN 'Display - Reach/RMA'
      WHEN campaign LIKE 'sem_rmo%' THEN 'SEM - RMO'
      WHEN (campaign LIKE '%sem%' AND campaign NOT LIKE 'sem_bra%') THEN 'SEM non-brand'
      WHEN campaign LIKE 'sem_bra%' THEN 'SEM Brand'
      WHEN (campaign LIKE 'ps_rmo%' OR campaign LIKE 'smartly_rmo%') THEN 'Paid Social - RMO'
      WHEN (campaign LIKE 'ps_reach%' OR campaign LIKE 'smartly_reach%' OR campaign LIKE 'ps_rma%' OR campaign LIKE 'smartly_rma%') THEN 'Paid Social - Reach/RMA'
    ELSE
    'Other'
  END
    AS marketing_channel,
    CASE
    	WHEN STARTS_WITH(LOWER(campaign), r"aff_aff") THEN "Other/Organic"
      WHEN (LOWER(campaign) LIKE '%dv360%' or LOWER(campaign) LIKE '%mob_bra%') and not (LOWER(campaign) LIKE '%_rma_%' or LOWER(campaign) LIKE '%_reach_%') THEN 'Brand'
	    WHEN LOWER(campaign) LIKE '%dis_bra%' THEN 'Brand'
	    WHEN LOWER(campaign) LIKE '%dis_xrea%' THEN 'Extended reach'
      WHEN (LOWER(campaign) LIKE '%ps_bra%' OR LOWER(campaign) LIKE '%smartly_bra%' OR LOWER(campaign) LIKE '%tiktok_bra%') THEN 'Brand'
      WHEN (LOWER(campaign) LIKE '%smartly_xrea%' OR LOWER(campaign) LIKE '%ps_xrea%') THEN 'Extended reach'
      WHEN campaign LIKE 'dis_rmo%' THEN 'RMO'
      WHEN campaign LIKE 'mob_rmo%' THEN 'RMO'
      WHEN campaign LIKE 'dis_reach%' THEN 'Reach'
      WHEN campaign LIKE 'dis_rma%' THEN 'RMA'
      WHEN campaign LIKE 'sem_rmo%' THEN 'SEM - RMO'
      WHEN (campaign LIKE '%sem%' AND campaign NOT LIKE 'sem_bra%') THEN 'Non-brand'
      WHEN campaign LIKE 'sem_bra%' THEN 'Brand'
      WHEN campaign LIKE 'mob_reach%' THEN 'Reach'
      WHEN campaign LIKE 'mob_rma%' THEN 'RMA'
      WHEN (campaign LIKE 'ps_rmo%' OR campaign LIKE 'smartly_rmo%') THEN 'RMO'
      WHEN (campaign LIKE 'ps_reach%' OR campaign LIKE 'smartly_reach%') THEN 'Reach'
      WHEN (campaign LIKE 'ps_rma%' OR campaign LIKE 'smartly_rma%') THEN 'RMA'
    ELSE
    'Other/Organic'
    end as sub_channel,
    cost_source AS network,
    SUM(cost_eur) cost,
    SUM(clicks) clicks,
    SUM(impressions) impressions,
    0 AS installs,
    0 skan_installs,
    0 AS signups,
    0 AS projected_cost,
    0 projected_acq,
    0 acquisitions
  FROM
    `fulfillment-dwh-production.curated_data_shared_coda_datamart.clarisights_camp_costs`
  WHERE
    1=1
    AND date BETWEEN '2023-01-01'
    AND DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
    AND (
      (marketing_channel NOT IN ('Social Engagement','SEM - Restaurant Recruiting (SSU)', 'Paid Social - Restaurant Recruiting','Cooperations','Paid Social - Riders','Partner ads')
      or marketing_channel is null)
    AND lower(campaign) NOT LIKE "%_rid_%" AND lower(campaign) NOT LIKE "%_rider_%" and lower(campaign) not like '%some_promo%')
  GROUP BY all
  having marketing_channel != 'Other'),

  cs_acq AS (
  SELECT
    global_entity_id,
    CASE 
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_and_") THEN "android"
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_ios_") THEN "ios"
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_web_") THEN "web"
      ELSE LOWER(platform)
  END AS platform,
    order_date,
CASE
    	WHEN (LOWER(campaign) LIKE '%dv360%' or LOWER(campaign) LIKE '%mob_bra%') and not (LOWER(campaign) LIKE '%_rma_%' or LOWER(campaign) LIKE '%_reach_%') THEN 'Online branding - App'
	    WHEN LOWER(campaign) LIKE '%dis_bra%' THEN 'Online branding - Display'
	    WHEN LOWER(campaign) LIKE '%dis_xrea%' THEN 'Extended reach - Display'
      WHEN (LOWER(campaign) LIKE '%ps_bra%' OR LOWER(campaign) LIKE '%smartly_bra%' OR LOWER(campaign) LIKE '%tiktok_bra%') THEN 'Online branding - PS'
      WHEN (LOWER(campaign) LIKE '%smartly_xrea%' OR LOWER(campaign) LIKE '%ps_xrea%') THEN 'Extended reach - PS'
      WHEN campaign LIKE 'dis_rmo%' THEN 'Display - RMO'
      WHEN campaign LIKE 'mob_rmo%' THEN 'App marketing - RMO'
      WHEN campaign LIKE 'mob_%' THEN 'App marketing - Reach/RMA'
      WHEN campaign LIKE 'dis_r%' THEN 'Display - Reach/RMA'
      WHEN campaign LIKE 'sem_rmo%' THEN 'SEM - RMO'
      WHEN (campaign LIKE '%sem%' AND campaign NOT LIKE 'sem_bra%') THEN 'SEM non-brand'
      WHEN campaign LIKE 'sem_bra%' THEN 'SEM Brand'
      WHEN (campaign LIKE 'ps_rmo%' OR campaign LIKE 'smartly_rmo%') THEN 'Paid Social - RMO'
      WHEN (campaign LIKE 'ps_reach%' OR campaign LIKE 'smartly_reach%' OR campaign LIKE 'ps_rma%' OR campaign LIKE 'smartly_rma%') THEN 'Paid Social - Reach/RMA'
    ELSE
    'Other'
  END
    AS marketing_channel,
    CASE
    	WHEN STARTS_WITH(LOWER(campaign), r"aff_aff") THEN "Other/Organic"
      WHEN (LOWER(campaign) LIKE '%dv360%' or LOWER(campaign) LIKE '%mob_bra%') and not (LOWER(campaign) LIKE '%_rma_%' or LOWER(campaign) LIKE '%_reach_%') THEN 'Brand'
	    WHEN LOWER(campaign) LIKE '%dis_bra%' THEN 'Brand'
	    WHEN LOWER(campaign) LIKE '%dis_xrea%' THEN 'Extended reach'
      WHEN (LOWER(campaign) LIKE '%ps_bra%' OR LOWER(campaign) LIKE '%smartly_bra%' OR LOWER(campaign) LIKE '%tiktok_bra%') THEN 'Brand'
      WHEN (LOWER(campaign) LIKE '%smartly_xrea%' OR LOWER(campaign) LIKE '%ps_xrea%') THEN 'Extended reach'
      WHEN campaign LIKE 'dis_rmo%' THEN 'RMO'
      WHEN campaign LIKE 'mob_rmo%' THEN 'RMO'
      WHEN campaign LIKE 'dis_reach%' THEN 'Reach'
      WHEN campaign LIKE 'dis_rma%' THEN 'RMA'
      WHEN campaign LIKE 'sem_rmo%' THEN 'SEM - RMO'
      WHEN (campaign LIKE '%sem%' AND campaign NOT LIKE 'sem_bra%') THEN 'Non-brand'
      WHEN campaign LIKE 'sem_bra%' THEN 'Brand'
      WHEN campaign LIKE 'mob_reach%' THEN 'Reach'
      WHEN campaign LIKE 'mob_rma%' THEN 'RMA'
      WHEN (campaign LIKE 'ps_rmo%' OR campaign LIKE 'smartly_rmo%') THEN 'RMO'
      WHEN (campaign LIKE 'ps_reach%' OR campaign LIKE 'smartly_reach%') THEN 'Reach'
      WHEN (campaign LIKE 'ps_rma%' OR campaign LIKE 'smartly_rma%') THEN 'RMA'
    ELSE
    'Other/Organic'
    end as sub_channel,
    coalesce(mapped_column,lower(source),'other') as cost_source,
    0 cost,
    0 clicks,
    0 impressions,
    0 installs,
    0 skan_installs,
    0 signups,
    0 proj_cost,
    0 proj_acq,
    SUM(acquisitions_calibration_ios14fix) Acquisitions
  FROM
    `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_orders`
left join (select source_column,mapped_column from `dhh---analytics-eu.bi_marketing.regional_eu_source_mapping`) on source = source_column  
WHERE
    1=1
    AND order_date between '2023-01-01' and DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
  GROUP BY all
  having marketing_channel != 'Other'),

  cs AS (
  SELECT * FROM cs_cost
  UNION ALL
  SELECT * FROM cs_acq
  union all
  select * from bima
  union all
  select * from apac_aff
),
  
  adj_eu AS (
  SELECT
    global_entity_id,
    os_name,
    date,
    marketing_channel,
    CASE
    	WHEN STARTS_WITH(LOWER(campaign_name), r"aff_aff") THEN "Other/Organic"
      WHEN (LOWER(campaign_name) LIKE '%dv360%' or LOWER(campaign_name) LIKE '%mob_bra%') and not (LOWER(campaign_name) LIKE '%_rma_%' or LOWER(campaign_name) LIKE '%_reach_%') THEN 'Brand'
	    WHEN LOWER(campaign_name) LIKE '%dis_bra%' THEN 'Brand'
	    WHEN LOWER(campaign_name) LIKE '%dis_xrea%' THEN 'Extended reach'
      WHEN (LOWER(campaign_name) LIKE '%ps_bra%' OR LOWER(campaign_name) LIKE '%smartly_bra%' OR LOWER(campaign_name) LIKE '%tiktok_bra%') THEN 'Brand'
      WHEN (LOWER(campaign_name) LIKE '%smartly_xrea%' OR LOWER(campaign_name) LIKE '%ps_xrea%') THEN 'Extended reach'
      WHEN campaign_name LIKE 'dis_rmo%' THEN 'RMO'
      WHEN campaign_name LIKE 'mob_rmo%' THEN 'RMO'
      WHEN campaign_name LIKE 'dis_reach%' THEN 'Reach'
      WHEN campaign_name LIKE 'dis_rma%' THEN 'RMA'
      WHEN campaign_name LIKE 'sem_rmo%' THEN 'SEM - RMO'
      WHEN (campaign_name LIKE '%sem%' AND campaign_name NOT LIKE 'sem_bra%') THEN 'Non-brand'
      WHEN campaign_name LIKE 'sem_bra%' THEN 'Brand'
      WHEN campaign_name LIKE 'mob_reach%' THEN 'Reach'
      WHEN campaign_name LIKE 'mob_rma%' THEN 'RMA'
      WHEN (campaign_name LIKE 'ps_rmo%' OR campaign_name LIKE 'smartly_rmo%') THEN 'RMO'
      WHEN (campaign_name LIKE 'ps_reach%' OR campaign_name LIKE 'smartly_reach%') THEN 'Reach'
      WHEN (campaign_name LIKE 'ps_rma%' OR campaign_name LIKE 'smartly_rma%') THEN 'RMA'
    ELSE
    'Other/Organic'
    end as sub_channel,
    network,
    0 cost,
    0 clicks,
    0 impressions,
    installs,
    skan_installs,
    signups,
    0 projected_cost,
    0 projected_acq,
    0 acquisitions
  FROM
    `dhh---analytics-eu.bi_marketing.regional_eu_adj_agg_events` 
    where date between '2023-01-01'  and DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
    group by all
    ),

    adj_apac as (
      select
    global_entity_id,
    device.os_name,
    event_date_utc date,
CASE
    	WHEN (LOWER(source.campaign_name) LIKE '%dv360%' or LOWER(source.campaign_name) LIKE '%mob_bra%') and not (LOWER(source.campaign_name) LIKE '%_rma_%' or LOWER(source.campaign_name) LIKE '%_reach_%') THEN 'Online branding - App'
	    WHEN LOWER(source.campaign_name) LIKE '%dis_bra%' THEN 'Online branding - Display'
	    WHEN LOWER(source.campaign_name) LIKE '%dis_xrea%' THEN 'Extended reach - Display'
      WHEN (LOWER(source.campaign_name) LIKE '%ps_bra%' OR LOWER(source.campaign_name) LIKE '%smartly_bra%' OR LOWER(source.campaign_name) LIKE '%tiktok_bra%') THEN 'Online branding - PS'
      WHEN (LOWER(source.campaign_name) LIKE '%smartly_xrea%' OR LOWER(source.campaign_name) LIKE '%ps_xrea%') THEN 'Extended reach - PS'
      WHEN source.campaign_name LIKE 'dis_rmo%' THEN 'Display - RMO'
      WHEN source.campaign_name LIKE 'mob_rmo%' THEN 'App marketing - RMO'
      WHEN source.campaign_name LIKE 'mob_%' THEN 'App marketing - Reach/RMA'
      WHEN source.campaign_name LIKE 'dis_r%' THEN 'Display - Reach/RMA'
      WHEN source.campaign_name LIKE 'sem_rmo%' THEN 'SEM - RMO'
      WHEN (source.campaign_name LIKE '%sem%' AND source.campaign_name NOT LIKE 'sem_bra%') THEN 'SEM non-brand'
      WHEN source.campaign_name LIKE 'sem_bra%' THEN 'SEM Brand'
      WHEN (source.campaign_name LIKE 'ps_rmo%' OR source.campaign_name LIKE 'smartly_rmo%') THEN 'Paid Social - RMO'
      WHEN (source.campaign_name LIKE 'ps_reach%' OR source.campaign_name LIKE 'smartly_reach%' OR source.campaign_name LIKE 'ps_rma%' OR source.campaign_name LIKE 'smartly_rma%') THEN 'Paid Social - Reach/RMA'
    ELSE
    'Other'
  END
    AS marketing_channel,
    
    CASE
    	WHEN DATE_DIFF(DATE(adj.created_at_utc), DATE(COALESCE(adj.reattributed_at_utc, adj.clicked_at_utc, adj.installed_at_utc, adj.created_at_utc)), DAY) >> 7 THEN 'Other/Organic'
      WHEN STARTS_WITH(LOWER(source.campaign_name), r"aff_aff") THEN "Other/Organic"
      WHEN (LOWER(source.campaign_name) LIKE '%dv360%' or LOWER(source.campaign_name) LIKE '%mob_bra%') and not (LOWER(source.campaign_name) LIKE '%_rma_%' or LOWER(source.campaign_name) LIKE '%_reach_%') THEN 'Brand'
	    WHEN LOWER(source.campaign_name) LIKE '%dis_bra%' THEN 'Brand'
	    WHEN LOWER(source.campaign_name) LIKE '%dis_xrea%' THEN 'Extended reach'
      WHEN (LOWER(source.campaign_name) LIKE '%ps_bra%' OR LOWER(source.campaign_name) LIKE '%smartly_bra%' OR LOWER(source.campaign_name) LIKE '%tiktok_bra%') THEN 'Brand'
      WHEN (LOWER(source.campaign_name) LIKE '%smartly_xrea%' OR LOWER(source.campaign_name) LIKE '%ps_xrea%') THEN 'Extended reach'
      WHEN source.campaign_name LIKE 'dis_rmo%' THEN 'RMO'
      WHEN source.campaign_name LIKE 'mob_rmo%' THEN 'RMO'
      WHEN source.campaign_name LIKE 'dis_reach%' THEN 'Reach'
      WHEN source.campaign_name LIKE 'dis_rma%' THEN 'RMA'
      WHEN source.campaign_name LIKE 'sem_rmo%' THEN 'SEM - RMO'
      WHEN (source.campaign_name LIKE '%sem%' AND source.campaign_name NOT LIKE 'sem_bra%') THEN 'Non-brand'
      WHEN source.campaign_name LIKE 'sem_bra%' THEN 'Brand'
      WHEN source.campaign_name LIKE 'mob_reach%' THEN 'Reach'
      WHEN source.campaign_name LIKE 'mob_rma%' THEN 'RMA'
      WHEN (source.campaign_name LIKE 'ps_rmo%' OR source.campaign_name LIKE 'smartly_rmo%') THEN 'RMO'
      WHEN (source.campaign_name LIKE 'ps_reach%' OR source.campaign_name LIKE 'smartly_reach%') THEN 'Reach'
      WHEN (source.campaign_name LIKE 'ps_rma%' OR source.campaign_name LIKE 'smartly_rma%') THEN 'RMA'
    ELSE
    'Other/Organic'
    end as sub_channel,
    source.network_name network,
    0 cost,
    0 clicks,
    0 impressions,
    COUNTif(activity_kind like 'install%') AS installs,
    COUNTif(activity_kind = 'sk_install') skan_installs,
    COUNT(event_name = 'signup') signups,
    0 projected_cost,
    0 projected_acq,
    0 acquisitions

      FROM `fulfillment-dwh-production.pandata_report.regional_apac_adjust_installs`  adj
      where event_date_utc between '2023-01-01'  and DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
      and activity_kind IN ('install')
      group by all
    ),

    adj as (
      select * from adj_eu
      union all
      select * from adj_apac),


  calendar AS (
  SELECT
    DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL day DAY) AS date
  FROM
    UNNEST(GENERATE_ARRAY(0, DATE_DIFF(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 MONTH), DATE_TRUNC(CURRENT_DATE(), MONTH), DAY)-1)) AS day),

  avg_spend_acq_last_7_days AS (
  SELECT
    global_entity_id,
    os_name,
    marketing_channel,
    sub_channel,
    network,
    SUM(cost)/7 avg_spend_7d,
    SUM(acquisitions)/7 avg_acq_7d
  FROM
    cs
  WHERE
    date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 8 DAY)
    AND DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
  GROUP BY all),

  proj_spend_acq_stg AS (
  SELECT
    *
  FROM
    calendar
  CROSS JOIN
    avg_spend_acq_last_7_days),

  proj_spend_acq AS (
  SELECT
    global_entity_id,
    os_name,
    date,
    marketing_channel,
    sub_channel,
    network,
    0 cost,
    0 clicks,
    0 impressions,
    0 installs,
    0 skan_installs,
    0 signups,
    avg_spend_7d projected_cost,
    avg_acq_7d projected_acq,
    0 acquisitions
  FROM
    proj_spend_acq_stg ),

  cs_adj_proj_stg AS (
  SELECT
    *
  FROM
    cs
  UNION ALL
  SELECT
    *
  FROM
    adj
  UNION ALL
  SELECT
    *
  FROM
    proj_spend_acq),

  cs_adj_proj AS (
  SELECT
    date,
    global_entity_id,
    marketing_channel,
    sub_channel,
    coalesce(mapped_column,network) network,
    os_name,
    SUM(cost) cost,
    SUM(clicks) clicks,
    SUM(impressions) impressions,
    SUM(installs) installs,
    sum(skan_installs) skan_installs,
    SUM(signups) signups,
    SUM(acquisitions) acquisitions,
    SUM(projected_cost) projected_cost,
    SUM(projected_acq) projected_acq
  FROM
    cs_adj_proj_stg
      LEFT JOIN
    `dhh---analytics-eu.bi_marketing.regional_eu_source_mapping` m
  ON lower(network) = lower(source_column)
  GROUP BY all)

,final as (

SELECT
  date,
  global_entity_id,
  marketing_channel,
  sub_channel,
  network,
  case
  when lower(os_name) like '%web%' then 'web'
  when lower(os_name) like '%ios%' then 'ios'
  when lower(os_name) like '%android%' then 'android'
  else 'other'
  end as os_name,
CASE
  when marketing_channel in ('Affiliate','App marketing - RMO','App marketing - Reach/RMA','Display - RMO','Display - Reach/RMA','Paid Social - RMO','Paid Social - Reach/RMA','SEM - RMO','SEM Brand','SEM non-brand') then 'PM'
else 'nonPM'
END
  AS PM_nonPM,
  DATE_TRUNC(date,MONTH) AS month,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 9 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS last_7d,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 16 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 10 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS previous_7d_before_last_7d,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS last_30d,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 58 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 31 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS previous_30d_before_last_30d,
  SUM(cost) cost,
  SUM(clicks) clicks,
  SUM(impressions) impressions,
  SUM(installs) installs,
  sum(skan_installs) skan_installs,
  SUM(signups) signups,
  SUM(acquisitions) acquisitions,
  SUM(CASE
      WHEN date <<= (CURRENT_DATE()-2) THEN cost
    ELSE
    projected_cost
  END
    ) projected_cost,
  SUM(CASE
      WHEN date <<= (CURRENT_DATE()-2) THEN acquisitions
    ELSE
    projected_acq
  END
    ) projected_acq
FROM
  cs_adj_proj
WHERE global_entity_id not in ('HN_DK','FP_SK','FP_DE')
and (
  cost >>0 or
clicks >>0 or
impressions >>0 or
installs >>0 or
skan_installs >>0 or
signups >>0 or
acquisitions >>0 or
projected_cost >>0 or
projected_acq >>0
)
GROUP BY all
ORDER BY
  date DESC

)

select *, null reacquisition_calibrated from final
union all
select 
date,
global_entity_id,
marketing_channel,
sub_channel,
network,
  case
  when lower(os_name) like '%web%' then 'web'
  when lower(os_name) like '%ios%' then 'ios'
  when lower(os_name) like '%android%' then 'android'
  else 'other'
  end as os_name,
CASE
  when marketing_channel in ('Affiliate','App marketing - RMO','App marketing - Reach/RMA','Display - RMO','Display - Reach/RMA','Paid Social - RMO','Paid Social - Reach/RMA','SEM - RMO','SEM Brand','SEM non-brand') then 'PM'
else 'nonPM'
END
  AS PM_nonPM,
date_trunc(date,month) month,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 9 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS last_7d,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 16 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 10 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS previous_7d_before_last_7d,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS last_30d,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 58 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 31 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS previous_30d_before_last_30d,
null cost,
null clicks,
null impressions,
null installs,
null skan_installs,
null signups,
null acquisitions,
null projected_cost,
null projected_acq,
reacquisition_calibrated

from  `dhh---analytics-eu.bi_marketing.regional_eu_reacquisitions_agg_KPIs`]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0gkhfo1178hvoz10x5wkd10gcqkk' name='regional overview query' type='text'><![CDATA[WITH 
  bima AS (
  SELECT
    global_entity_id,
    CASE
      WHEN lower(platform) LIKE 'mobile web' THEN 'web'
    ELSE
    lower(platform)
  END
    AS platform,
    date,
    CASE
      WHEN ( (channel LIKE 'BRAND' AND sub_channel IN ('APPDIRECT', 'WEBDIRECT', 'SEO')) OR (channel LIKE 'SEO') ) THEN 'Organic'
      when channel = 'AFFILIATE' THEN 'Affiliate'
    ELSE
    'Other'
  END
    AS marketing_channel,
    'Other/Organic' as sub_channel,
    CASE
      WHEN ( (channel LIKE 'BRAND' AND sub_channel IN ('APPDIRECT', 'WEBDIRECT', 'SEO')) OR (channel LIKE 'SEO') ) THEN 'organic'
      when channel = 'AFFILIATE' THEN 'affiliate'
    ELSE
    'other'
  END
    AS SOURCE,
    SUM(case when channel = 'AFFILIATE' then 0 else costs_eur end) cost,
    SUM(new_sessions) new_sessions,
    0 impressions,
    0 installs,
    0 skan_installs,
    0 signups,
    0 projected_cost,
    0 projected_acq,
    SUM(acquisitions_calibration_ios14fix) acquisitions_calibration_ios14fix
  FROM
    `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_l2_detailed`
  WHERE
    date between '2023-01-01' and DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
AND channel NOT IN ('SEM','APP','DISPLAY','PAIDSOCIAL')
AND NOT ( channel LIKE 'BRAND' AND sub_channel LIKE 'SEM' )
  GROUP BY all),

apac_aff as (
  SELECT  
   global_entity_id,
   lower(platform) as platform,
   conversion_date AS date,
  "Affiliate" AS marketing_channel,
  'Other/Organic' as sub_channel,
   "affiliate" AS source,
   SUM(cost_eur) spend,
    0 new_sessions,
    0 impressions,
    0 installs,
    0 skan_installs,
    0 signups,
    0 projected_cost,
    0 projected_acq,
    0 acquisitions_calibration_ios14fix
FROM `fulfillment-dwh-production.pandata_report.regional_apac_online_clarisights_affiliate_cost` 
WHERE conversion_date  between '2023-01-01'  and DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
GROUP BY ALL
HAVING spend >> 1
),

  cs_cost AS (
  SELECT
    global_entity_id,
    CASE 
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_and_") THEN "android"
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_ios_") THEN "ios"
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_web_") THEN "web"
      when REGEXP_CONTAINS(LOWER(campaign), r"_mix_") THEN "mix"
      ELSE LOWER(platform)
  END AS os_name,
    date,
CASE
    	WHEN (LOWER(campaign) LIKE '%dv360%' or LOWER(campaign) LIKE '%mob_bra%') and not (LOWER(campaign) LIKE '%_rma_%' or LOWER(campaign) LIKE '%_reach_%') THEN 'Online branding - App'
	    WHEN LOWER(campaign) LIKE '%dis_bra%' THEN 'Online branding - Display'
	    WHEN LOWER(campaign) LIKE '%dis_xrea%' THEN 'Extended reach - Display'
      WHEN (LOWER(campaign) LIKE '%ps_bra%' OR LOWER(campaign) LIKE '%smartly_bra%' OR LOWER(campaign) LIKE '%tiktok_bra%') THEN 'Online branding - PS'
      WHEN (LOWER(campaign) LIKE '%smartly_xrea%' OR LOWER(campaign) LIKE '%ps_xrea%') THEN 'Extended reach - PS'
      WHEN campaign LIKE 'dis_rmo%' THEN 'Display - RMO'
      WHEN campaign LIKE 'mob_rmo%' THEN 'App marketing - RMO'
      WHEN campaign LIKE 'mob_%' THEN 'App marketing - Reach/RMA'
      WHEN campaign LIKE 'dis_r%' THEN 'Display - Reach/RMA'
      WHEN campaign LIKE 'sem_rmo%' THEN 'SEM - RMO'
      WHEN (campaign LIKE '%sem%' AND campaign NOT LIKE 'sem_bra%') THEN 'SEM non-brand'
      WHEN campaign LIKE 'sem_bra%' THEN 'SEM Brand'
      WHEN (campaign LIKE 'ps_rmo%' OR campaign LIKE 'smartly_rmo%') THEN 'Paid Social - RMO'
      WHEN (campaign LIKE 'ps_reach%' OR campaign LIKE 'smartly_reach%' OR campaign LIKE 'ps_rma%' OR campaign LIKE 'smartly_rma%') THEN 'Paid Social - Reach/RMA'
    ELSE
    'Other'
  END
    AS marketing_channel,
    CASE
    	WHEN STARTS_WITH(LOWER(campaign), r"aff_aff") THEN "Other/Organic"
      WHEN (LOWER(campaign) LIKE '%dv360%' or LOWER(campaign) LIKE '%mob_bra%') and not (LOWER(campaign) LIKE '%_rma_%' or LOWER(campaign) LIKE '%_reach_%') THEN 'Brand'
	    WHEN LOWER(campaign) LIKE '%dis_bra%' THEN 'Brand'
	    WHEN LOWER(campaign) LIKE '%dis_xrea%' THEN 'Extended reach'
      WHEN (LOWER(campaign) LIKE '%ps_bra%' OR LOWER(campaign) LIKE '%smartly_bra%' OR LOWER(campaign) LIKE '%tiktok_bra%') THEN 'Brand'
      WHEN (LOWER(campaign) LIKE '%smartly_xrea%' OR LOWER(campaign) LIKE '%ps_xrea%') THEN 'Extended reach'
      WHEN campaign LIKE 'dis_rmo%' THEN 'RMO'
      WHEN campaign LIKE 'mob_rmo%' THEN 'RMO'
      WHEN campaign LIKE 'dis_reach%' THEN 'Reach'
      WHEN campaign LIKE 'dis_rma%' THEN 'RMA'
      WHEN campaign LIKE 'sem_rmo%' THEN 'SEM - RMO'
      WHEN (campaign LIKE '%sem%' AND campaign NOT LIKE 'sem_bra%') THEN 'Non-brand'
      WHEN campaign LIKE 'sem_bra%' THEN 'Brand'
      WHEN campaign LIKE 'mob_reach%' THEN 'Reach'
      WHEN campaign LIKE 'mob_rma%' THEN 'RMA'
      WHEN (campaign LIKE 'ps_rmo%' OR campaign LIKE 'smartly_rmo%') THEN 'RMO'
      WHEN (campaign LIKE 'ps_reach%' OR campaign LIKE 'smartly_reach%') THEN 'Reach'
      WHEN (campaign LIKE 'ps_rma%' OR campaign LIKE 'smartly_rma%') THEN 'RMA'
    ELSE
    'Other/Organic'
    end as sub_channel,
    cost_source AS network,
    SUM(cost_eur) cost,
    SUM(clicks) clicks,
    SUM(impressions) impressions,
    0 AS installs,
    0 skan_installs,
    0 AS signups,
    0 AS projected_cost,
    0 projected_acq,
    0 acquisitions
  FROM
    `fulfillment-dwh-production.curated_data_shared_coda_datamart.clarisights_camp_costs`
  WHERE
    1=1
    AND date BETWEEN '2023-01-01'
    AND DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
    AND (
      (marketing_channel NOT IN ('Social Engagement','SEM - Restaurant Recruiting (SSU)', 'Paid Social - Restaurant Recruiting','Cooperations','Paid Social - Riders','Partner ads')
      or marketing_channel is null)
    AND lower(campaign) NOT LIKE "%_rid_%" AND lower(campaign) NOT LIKE "%_rider_%" and lower(campaign) not like '%some_promo%')
  GROUP BY all
  having marketing_channel != 'Other'),

  cs_acq AS (
  SELECT
    global_entity_id,
    CASE 
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_and_") THEN "android"
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_ios_") THEN "ios"
      WHEN REGEXP_CONTAINS(LOWER(campaign), r"_web_") THEN "web"
      ELSE LOWER(platform)
  END AS platform,
    order_date,
CASE
    	WHEN (LOWER(campaign) LIKE '%dv360%' or LOWER(campaign) LIKE '%mob_bra%') and not (LOWER(campaign) LIKE '%_rma_%' or LOWER(campaign) LIKE '%_reach_%') THEN 'Online branding - App'
	    WHEN LOWER(campaign) LIKE '%dis_bra%' THEN 'Online branding - Display'
	    WHEN LOWER(campaign) LIKE '%dis_xrea%' THEN 'Extended reach - Display'
      WHEN (LOWER(campaign) LIKE '%ps_bra%' OR LOWER(campaign) LIKE '%smartly_bra%' OR LOWER(campaign) LIKE '%tiktok_bra%') THEN 'Online branding - PS'
      WHEN (LOWER(campaign) LIKE '%smartly_xrea%' OR LOWER(campaign) LIKE '%ps_xrea%') THEN 'Extended reach - PS'
      WHEN campaign LIKE 'dis_rmo%' THEN 'Display - RMO'
      WHEN campaign LIKE 'mob_rmo%' THEN 'App marketing - RMO'
      WHEN campaign LIKE 'mob_%' THEN 'App marketing - Reach/RMA'
      WHEN campaign LIKE 'dis_r%' THEN 'Display - Reach/RMA'
      WHEN campaign LIKE 'sem_rmo%' THEN 'SEM - RMO'
      WHEN (campaign LIKE '%sem%' AND campaign NOT LIKE 'sem_bra%') THEN 'SEM non-brand'
      WHEN campaign LIKE 'sem_bra%' THEN 'SEM Brand'
      WHEN (campaign LIKE 'ps_rmo%' OR campaign LIKE 'smartly_rmo%') THEN 'Paid Social - RMO'
      WHEN (campaign LIKE 'ps_reach%' OR campaign LIKE 'smartly_reach%' OR campaign LIKE 'ps_rma%' OR campaign LIKE 'smartly_rma%') THEN 'Paid Social - Reach/RMA'
    ELSE
    'Other'
  END
    AS marketing_channel,
    CASE
    	WHEN STARTS_WITH(LOWER(campaign), r"aff_aff") THEN "Other/Organic"
      WHEN (LOWER(campaign) LIKE '%dv360%' or LOWER(campaign) LIKE '%mob_bra%') and not (LOWER(campaign) LIKE '%_rma_%' or LOWER(campaign) LIKE '%_reach_%') THEN 'Brand'
	    WHEN LOWER(campaign) LIKE '%dis_bra%' THEN 'Brand'
	    WHEN LOWER(campaign) LIKE '%dis_xrea%' THEN 'Extended reach'
      WHEN (LOWER(campaign) LIKE '%ps_bra%' OR LOWER(campaign) LIKE '%smartly_bra%' OR LOWER(campaign) LIKE '%tiktok_bra%') THEN 'Brand'
      WHEN (LOWER(campaign) LIKE '%smartly_xrea%' OR LOWER(campaign) LIKE '%ps_xrea%') THEN 'Extended reach'
      WHEN campaign LIKE 'dis_rmo%' THEN 'RMO'
      WHEN campaign LIKE 'mob_rmo%' THEN 'RMO'
      WHEN campaign LIKE 'dis_reach%' THEN 'Reach'
      WHEN campaign LIKE 'dis_rma%' THEN 'RMA'
      WHEN campaign LIKE 'sem_rmo%' THEN 'SEM - RMO'
      WHEN (campaign LIKE '%sem%' AND campaign NOT LIKE 'sem_bra%') THEN 'Non-brand'
      WHEN campaign LIKE 'sem_bra%' THEN 'Brand'
      WHEN campaign LIKE 'mob_reach%' THEN 'Reach'
      WHEN campaign LIKE 'mob_rma%' THEN 'RMA'
      WHEN (campaign LIKE 'ps_rmo%' OR campaign LIKE 'smartly_rmo%') THEN 'RMO'
      WHEN (campaign LIKE 'ps_reach%' OR campaign LIKE 'smartly_reach%') THEN 'Reach'
      WHEN (campaign LIKE 'ps_rma%' OR campaign LIKE 'smartly_rma%') THEN 'RMA'
    ELSE
    'Other/Organic'
    end as sub_channel,
    coalesce(mapped_column,lower(source),'other') as cost_source,
    0 cost,
    0 clicks,
    0 impressions,
    0 installs,
    0 skan_installs,
    0 signups,
    0 proj_cost,
    0 proj_acq,
    SUM(acquisitions_calibration_ios14fix) Acquisitions
  FROM
    `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_orders`
left join (select source_column,mapped_column from `dhh---analytics-eu.bi_marketing.regional_eu_source_mapping`) on source = source_column  
WHERE
    1=1
    AND order_date between '2023-01-01' and DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
  GROUP BY all
  having marketing_channel != 'Other'),

  cs AS (
  SELECT * FROM cs_cost
  UNION ALL
  SELECT * FROM cs_acq
  union all
  select * from bima
  union all
  select * from apac_aff
),
  
  adj_eu AS (
  SELECT
    global_entity_id,
    os_name,
    date,
    marketing_channel,
    CASE
    	WHEN STARTS_WITH(LOWER(campaign_name), r"aff_aff") THEN "Other/Organic"
      WHEN (LOWER(campaign_name) LIKE '%dv360%' or LOWER(campaign_name) LIKE '%mob_bra%') and not (LOWER(campaign_name) LIKE '%_rma_%' or LOWER(campaign_name) LIKE '%_reach_%') THEN 'Brand'
	    WHEN LOWER(campaign_name) LIKE '%dis_bra%' THEN 'Brand'
	    WHEN LOWER(campaign_name) LIKE '%dis_xrea%' THEN 'Extended reach'
      WHEN (LOWER(campaign_name) LIKE '%ps_bra%' OR LOWER(campaign_name) LIKE '%smartly_bra%' OR LOWER(campaign_name) LIKE '%tiktok_bra%') THEN 'Brand'
      WHEN (LOWER(campaign_name) LIKE '%smartly_xrea%' OR LOWER(campaign_name) LIKE '%ps_xrea%') THEN 'Extended reach'
      WHEN campaign_name LIKE 'dis_rmo%' THEN 'RMO'
      WHEN campaign_name LIKE 'mob_rmo%' THEN 'RMO'
      WHEN campaign_name LIKE 'dis_reach%' THEN 'Reach'
      WHEN campaign_name LIKE 'dis_rma%' THEN 'RMA'
      WHEN campaign_name LIKE 'sem_rmo%' THEN 'SEM - RMO'
      WHEN (campaign_name LIKE '%sem%' AND campaign_name NOT LIKE 'sem_bra%') THEN 'Non-brand'
      WHEN campaign_name LIKE 'sem_bra%' THEN 'Brand'
      WHEN campaign_name LIKE 'mob_reach%' THEN 'Reach'
      WHEN campaign_name LIKE 'mob_rma%' THEN 'RMA'
      WHEN (campaign_name LIKE 'ps_rmo%' OR campaign_name LIKE 'smartly_rmo%') THEN 'RMO'
      WHEN (campaign_name LIKE 'ps_reach%' OR campaign_name LIKE 'smartly_reach%') THEN 'Reach'
      WHEN (campaign_name LIKE 'ps_rma%' OR campaign_name LIKE 'smartly_rma%') THEN 'RMA'
    ELSE
    'Other/Organic'
    end as sub_channel,
    network,
    0 cost,
    0 clicks,
    0 impressions,
    installs,
    skan_installs,
    signups,
    0 projected_cost,
    0 projected_acq,
    0 acquisitions
  FROM
    `dhh---analytics-eu.bi_marketing.regional_eu_adj_agg_events` 
    where date between '2023-01-01'  and DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
    group by all
    ),

    adj_apac as (
      select
    global_entity_id,
    device.os_name,
    event_date_utc date,
CASE
    	WHEN (LOWER(source.campaign_name) LIKE '%dv360%' or LOWER(source.campaign_name) LIKE '%mob_bra%') and not (LOWER(source.campaign_name) LIKE '%_rma_%' or LOWER(source.campaign_name) LIKE '%_reach_%') THEN 'Online branding - App'
	    WHEN LOWER(source.campaign_name) LIKE '%dis_bra%' THEN 'Online branding - Display'
	    WHEN LOWER(source.campaign_name) LIKE '%dis_xrea%' THEN 'Extended reach - Display'
      WHEN (LOWER(source.campaign_name) LIKE '%ps_bra%' OR LOWER(source.campaign_name) LIKE '%smartly_bra%' OR LOWER(source.campaign_name) LIKE '%tiktok_bra%') THEN 'Online branding - PS'
      WHEN (LOWER(source.campaign_name) LIKE '%smartly_xrea%' OR LOWER(source.campaign_name) LIKE '%ps_xrea%') THEN 'Extended reach - PS'
      WHEN source.campaign_name LIKE 'dis_rmo%' THEN 'Display - RMO'
      WHEN source.campaign_name LIKE 'mob_rmo%' THEN 'App marketing - RMO'
      WHEN source.campaign_name LIKE 'mob_%' THEN 'App marketing - Reach/RMA'
      WHEN source.campaign_name LIKE 'dis_r%' THEN 'Display - Reach/RMA'
      WHEN source.campaign_name LIKE 'sem_rmo%' THEN 'SEM - RMO'
      WHEN (source.campaign_name LIKE '%sem%' AND source.campaign_name NOT LIKE 'sem_bra%') THEN 'SEM non-brand'
      WHEN source.campaign_name LIKE 'sem_bra%' THEN 'SEM Brand'
      WHEN (source.campaign_name LIKE 'ps_rmo%' OR source.campaign_name LIKE 'smartly_rmo%') THEN 'Paid Social - RMO'
      WHEN (source.campaign_name LIKE 'ps_reach%' OR source.campaign_name LIKE 'smartly_reach%' OR source.campaign_name LIKE 'ps_rma%' OR source.campaign_name LIKE 'smartly_rma%') THEN 'Paid Social - Reach/RMA'
    ELSE
    'Other'
  END
    AS marketing_channel,
    
    CASE
    	WHEN DATE_DIFF(DATE(adj.created_at_utc), DATE(COALESCE(adj.reattributed_at_utc, adj.clicked_at_utc, adj.installed_at_utc, adj.created_at_utc)), DAY) >> 7 THEN 'Other/Organic'
      WHEN STARTS_WITH(LOWER(source.campaign_name), r"aff_aff") THEN "Other/Organic"
      WHEN (LOWER(source.campaign_name) LIKE '%dv360%' or LOWER(source.campaign_name) LIKE '%mob_bra%') and not (LOWER(source.campaign_name) LIKE '%_rma_%' or LOWER(source.campaign_name) LIKE '%_reach_%') THEN 'Brand'
	    WHEN LOWER(source.campaign_name) LIKE '%dis_bra%' THEN 'Brand'
	    WHEN LOWER(source.campaign_name) LIKE '%dis_xrea%' THEN 'Extended reach'
      WHEN (LOWER(source.campaign_name) LIKE '%ps_bra%' OR LOWER(source.campaign_name) LIKE '%smartly_bra%' OR LOWER(source.campaign_name) LIKE '%tiktok_bra%') THEN 'Brand'
      WHEN (LOWER(source.campaign_name) LIKE '%smartly_xrea%' OR LOWER(source.campaign_name) LIKE '%ps_xrea%') THEN 'Extended reach'
      WHEN source.campaign_name LIKE 'dis_rmo%' THEN 'RMO'
      WHEN source.campaign_name LIKE 'mob_rmo%' THEN 'RMO'
      WHEN source.campaign_name LIKE 'dis_reach%' THEN 'Reach'
      WHEN source.campaign_name LIKE 'dis_rma%' THEN 'RMA'
      WHEN source.campaign_name LIKE 'sem_rmo%' THEN 'SEM - RMO'
      WHEN (source.campaign_name LIKE '%sem%' AND source.campaign_name NOT LIKE 'sem_bra%') THEN 'Non-brand'
      WHEN source.campaign_name LIKE 'sem_bra%' THEN 'Brand'
      WHEN source.campaign_name LIKE 'mob_reach%' THEN 'Reach'
      WHEN source.campaign_name LIKE 'mob_rma%' THEN 'RMA'
      WHEN (source.campaign_name LIKE 'ps_rmo%' OR source.campaign_name LIKE 'smartly_rmo%') THEN 'RMO'
      WHEN (source.campaign_name LIKE 'ps_reach%' OR source.campaign_name LIKE 'smartly_reach%') THEN 'Reach'
      WHEN (source.campaign_name LIKE 'ps_rma%' OR source.campaign_name LIKE 'smartly_rma%') THEN 'RMA'
    ELSE
    'Other/Organic'
    end as sub_channel,
    source.network_name network,
    0 cost,
    0 clicks,
    0 impressions,
    COUNTif(activity_kind like 'install%') AS installs,
    COUNTif(activity_kind = 'sk_install') skan_installs,
    COUNT(event_name = 'signup') signups,
    0 projected_cost,
    0 projected_acq,
    0 acquisitions

      FROM `fulfillment-dwh-production.pandata_report.regional_apac_adjust_installs`  adj
      where event_date_utc between '2023-01-01'  and DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
      and activity_kind IN ('install')
      group by all
    ),

    adj as (
      select * from adj_eu
      union all
      select * from adj_apac),


  calendar AS (
  SELECT
    DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL day DAY) AS date
  FROM
    UNNEST(GENERATE_ARRAY(0, DATE_DIFF(DATE_ADD(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 MONTH), DATE_TRUNC(CURRENT_DATE(), MONTH), DAY)-1)) AS day),

  avg_spend_acq_last_7_days AS (
  SELECT
    global_entity_id,
    os_name,
    marketing_channel,
    sub_channel,
    network,
    SUM(cost)/7 avg_spend_7d,
    SUM(acquisitions)/7 avg_acq_7d
  FROM
    cs
  WHERE
    date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 8 DAY)
    AND DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY)
  GROUP BY all),

  proj_spend_acq_stg AS (
  SELECT
    *
  FROM
    calendar
  CROSS JOIN
    avg_spend_acq_last_7_days),

  proj_spend_acq AS (
  SELECT
    global_entity_id,
    os_name,
    date,
    marketing_channel,
    sub_channel,
    network,
    0 cost,
    0 clicks,
    0 impressions,
    0 installs,
    0 skan_installs,
    0 signups,
    avg_spend_7d projected_cost,
    avg_acq_7d projected_acq,
    0 acquisitions
  FROM
    proj_spend_acq_stg ),

  cs_adj_proj_stg AS (
  SELECT
    *
  FROM
    cs
  UNION ALL
  SELECT
    *
  FROM
    adj
  UNION ALL
  SELECT
    *
  FROM
    proj_spend_acq),

  cs_adj_proj AS (
  SELECT
    date,
    global_entity_id,
    marketing_channel,
    sub_channel,
    coalesce(mapped_column,network) network,
    os_name,
    SUM(cost) cost,
    SUM(clicks) clicks,
    SUM(impressions) impressions,
    SUM(installs) installs,
    sum(skan_installs) skan_installs,
    SUM(signups) signups,
    SUM(acquisitions) acquisitions,
    SUM(projected_cost) projected_cost,
    SUM(projected_acq) projected_acq
  FROM
    cs_adj_proj_stg
      LEFT JOIN
    `dhh---analytics-eu.bi_marketing.regional_eu_source_mapping` m
  ON lower(network) = lower(source_column)
  GROUP BY all)

,final as (

SELECT
  date,
  global_entity_id,
  marketing_channel,
  sub_channel,
  network,
  case
  when lower(os_name) like '%web%' then 'web'
  when lower(os_name) like '%ios%' then 'ios'
  when lower(os_name) like '%android%' then 'android'
  else 'other'
  end as os_name,
CASE
  when marketing_channel in ('Affiliate','App marketing - RMO','App marketing - Reach/RMA','Display - RMO','Display - Reach/RMA','Paid Social - RMO','Paid Social - Reach/RMA','SEM - RMO','SEM Brand','SEM non-brand') then 'PM'
else 'nonPM'
END
  AS PM_nonPM,
  DATE_TRUNC(date,MONTH) AS month,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 9 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS last_7d,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 16 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 10 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS previous_7d_before_last_7d,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS last_30d,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 58 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 31 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS previous_30d_before_last_30d,
  SUM(cost) cost,
  SUM(clicks) clicks,
  SUM(impressions) impressions,
  SUM(installs) installs,
  sum(skan_installs) skan_installs,
  SUM(signups) signups,
  SUM(acquisitions) acquisitions,
  SUM(CASE
      WHEN date <<= (CURRENT_DATE()-2) THEN cost
    ELSE
    projected_cost
  END
    ) projected_cost,
  SUM(CASE
      WHEN date <<= (CURRENT_DATE()-2) THEN acquisitions
    ELSE
    projected_acq
  END
    ) projected_acq
FROM
  cs_adj_proj
WHERE global_entity_id not in ('HN_DK','FP_SK','FP_DE')
and (
  cost >>0 or
clicks >>0 or
impressions >>0 or
installs >>0 or
skan_installs >>0 or
signups >>0 or
acquisitions >>0 or
projected_cost >>0 or
projected_acq >>0
)
GROUP BY all
ORDER BY
  date DESC

)

select *, null reacquisition_calibrated from final
union all
select 
date,
global_entity_id,
marketing_channel,
sub_channel,
network,
  case
  when lower(os_name) like '%web%' then 'web'
  when lower(os_name) like '%ios%' then 'ios'
  when lower(os_name) like '%android%' then 'android'
  else 'other'
  end as os_name,
CASE
  when marketing_channel in ('Affiliate','App marketing - RMO','App marketing - Reach/RMA','Display - RMO','Display - Reach/RMA','Paid Social - RMO','Paid Social - Reach/RMA','SEM - RMO','SEM Brand','SEM non-brand') then 'PM'
else 'nonPM'
END
  AS PM_nonPM,
date_trunc(date,month) month,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 9 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS last_7d,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 16 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 10 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS previous_7d_before_last_7d,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS last_30d,
  CASE
    WHEN date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 58 DAY) AND DATE_SUB(CURRENT_DATE(), INTERVAL 31 DAY) THEN TRUE
  ELSE
  FALSE
END
  AS previous_30d_before_last_30d,
null cost,
null clicks,
null impressions,
null installs,
null skan_installs,
null signups,
null acquisitions,
null projected_cost,
null projected_acq,
reacquisition_calibrated

from  `dhh---analytics-eu.bi_marketing.regional_eu_reacquisitions_agg_KPIs`]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
