    <datasource caption='budgets' inline='true' name='federated.1emzea40hkqeoi16v38a50e71obl' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.17trp3m0o7hkwt1f9sa8d122wnh2'>
            <connection CATALOG='dhh---analytics-eu' EXECCATALOG='dhh---analytics-eu' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='EU Data Production' schema='pandata_shared' server-oauth='server-custom' username='aykut.sezen@yemeksepeti.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.17trp3m0o7hkwt1f9sa8d122wnh2' name='regional budgets query' type='text'>with raw as (&#13;
&#13;
SELECT &#13;
global_entity_id,&#13;
date as month,&#13;
case&#13;
when channel_targets like &apos;App - Branding&apos; then &apos;Online branding - App&apos;&#13;
when channel_targets like &apos;App (Reach / RMA)&apos; then &apos;App marketing - Reach/RMA&apos;&#13;
when channel_targets like &apos;Display - Branding&apos; then &apos;Online branding - Display&apos;&#13;
when channel_targets like &apos;Paid Social (Reach / RMA)&apos; then &apos;Paid Social - Reach/RMA&apos;&#13;
when channel_targets like &apos;Display (Reach / RMA)&apos; then &apos;Display - Reach/RMA&apos;&#13;
when channel_targets like &apos;Paid Social - Branding&apos; then &apos;Online branding - PS&apos;&#13;
when channel_targets like &apos;SEM (non-brand)&apos; then &apos;SEM non-brand&apos;&#13;
when channel_targets like &apos;App RMO&apos; then &apos;App - RMO&apos;&#13;
when channel_targets like &apos;Display RMO&apos; then &apos;Display - RMO&apos;&#13;
when channel_targets like &apos;Paid Social RMO&apos; then &apos;Paid Social - RMO&apos;&#13;
&#13;
else channel_targets&#13;
end as marketing_channel,&#13;
cost as budget,&#13;
acquisition acq_target&#13;
 FROM `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_cs_targets_and_budgets_enriched`&#13;
where date &gt;&gt;= &apos;2024-03-01&apos;&#13;
and (cost &gt;&gt; 0 or acquisition &gt;&gt;0)&#13;
and channel_targets in (&apos;App - Branding&apos;,&apos;App (Reach / RMA)&apos;,&apos;Display - Branding&apos;,&apos;Display (Reach / RMA)&apos;,&#13;
&apos;Paid Social - Branding&apos;,&apos;Paid Social (Reach / RMA)&apos;,&apos;SEM (non-brand)&apos;,&apos;SEM Brand&apos;,&apos;Affiliate&apos;,&#13;
&apos;App RMO&apos;,&apos;Display RMO&apos;,&apos;Paid Social RMO&apos;)&#13;
)&#13;
&#13;
select *,&#13;
CASE&#13;
  when marketing_channel in (&apos;Affiliate&apos;,&apos;App marketing - RMO&apos;,&apos;App marketing - Reach/RMA&apos;,&apos;Display - RMO&apos;,&apos;Display - Reach/RMA&apos;,&apos;Paid Social - RMO&apos;,&apos;Paid Social - Reach/RMA&apos;,&apos;SEM - RMO&apos;,&apos;SEM Brand&apos;,&apos;SEM non-brand&apos;) then &apos;PM&apos;&#13;
else &apos;nonPM&apos;&#13;
END&#13;
  AS PM_nonPM&#13;
&#13;
from raw</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.17trp3m0o7hkwt1f9sa8d122wnh2' name='regional budgets query' type='text'>with raw as (&#13;
&#13;
