    <worksheet name='FP_PH Delta'>
      <layout-options>
        <title>
          <formatted-text>
            <run>DoD Changes</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_cs' name='federated.1vv0wqm14enmn51gzkkhj1s8fgwm' />
            <datasource caption='budgets' name='federated.1emzea40hkqeoi16v38a50e71obl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Stack Dimension' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Channel&quot;'>
              <calculation class='tableau' formula='&quot;Channel&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1emzea40hkqeoi16v38a50e71obl'>
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vv0wqm14enmn51gzkkhj1s8fgwm'>
            <column caption='Stacked_dimension' datatype='string' name='[Calculation_1252563665207750656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 4]&#13;&#10;when &apos;OS&apos; then [os_name]&#13;&#10;when &apos;Market&apos; then [global_entity_id]&#13;&#10;when &apos;PM_nonPM&apos; then [PM_nonPM]&#13;&#10;when &apos;Channel&apos; then [marketing_channel]&#13;&#10;when &apos;Network&apos; then [network]&#13;&#10;end' />
            </column>
            <column caption='Daily CPI Coloring' datatype='string' name='[Calculation_3652137825847595008]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4720827942300364817] &gt; 0.3 THEN &quot;Red&quot;&#10;ELSEIF [Calculation_4720827942300364817] &lt; -0.3 THEN &quot;Green&quot;&#10;ELSE &quot;Grey&quot;&#10;END' />
            </column>
            <column caption='Latest Day' datatype='datetime' name='[Calculation_4720827942243012611]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -2, TODAY())' />
            </column>
            <column caption='Previous Day' datatype='datetime' name='[Calculation_4720827942281207816]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -3, TODAY())' />
            </column>
            <column caption='Daily Spend Delta' datatype='real' name='[Calculation_4720827942291185676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;        SUM(IF [date] = [Calculation_4720827942243012611] THEN [cost] END)&#10;        -&#10;        SUM(IF [date] = [Calculation_4720827942281207816] THEN [cost] END)&#10;    )&#10;    /&#10;    IFNULL(SUM(IF [date] = [Calculation_4720827942281207816] THEN [cost] END), 0)' />
            </column>
            <column caption='Daily CPI Delta' datatype='real' name='[Calculation_4720827942300364817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;        SUM(IF [date] = [Calculation_4720827942243012611] AND ([os_name] = &apos;ios&apos; OR [os_name] = &apos;android&apos;) THEN [cost] ELSE 0 END)&#10;        /&#10;        SUM(IF [date] = [Calculation_4720827942243012611] THEN [installs] ELSE 0 END)&#10;        -&#10;        SUM(IF [date] = [Calculation_4720827942281207816] AND ([os_name] = &apos;ios&apos; OR [os_name] = &apos;android&apos;) THEN [cost] ELSE 0 END)&#10;        /&#10;        SUM(IF [date] = [Calculation_4720827942281207816] THEN [installs] ELSE 0 END)&#10;    )&#10;    /&#10;    IFNULL(&#10;        SUM(IF [date] = [Calculation_4720827942281207816] AND ([os_name] = &apos;ios&apos; OR [os_name] = &apos;android&apos;) THEN [cost] ELSE 0 END)&#10;        /&#10;        SUM(IF [date] = [Calculation_4720827942281207816] THEN [installs] ELSE 0 END)&#10;    , 0)' />
            </column>
            <column caption='Latest Day Spend Flag' datatype='real' name='[Calculation_4720827942663942170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date] = [Calculation_4720827942243012611] THEN [cost] END)' />
            </column>
            <column caption='Daily CPA Delta' datatype='real' name='[Daily CPC Delta (copy)_2799409383593476098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;        SUM(IF [date] = [Calculation_4720827942243012611] THEN [cost] ELSE 0 END)&#10;        /&#10;        SUM(IF [date] = [Calculation_4720827942243012611] AND ([PM_nonPM]= &apos;PM&apos;) THEN [acquisitions] ELSE 0 END)&#10;        -&#10;        SUM(IF [date] = [Calculation_4720827942281207816] THEN [cost] ELSE 0 END)&#10;        /&#10;        SUM(IF [date] = [Calculation_4720827942281207816] AND ([PM_nonPM]= &apos;PM&apos;) THEN [acquisitions] ELSE 0 END)&#10;    )&#10;    /&#10;    IFNULL(&#10;        SUM(IF [date] = [Calculation_4720827942281207816] THEN [cost] ELSE 0 END)&#10;        /&#10;        SUM(IF [date] = [Calculation_4720827942281207816] AND ([PM_nonPM]= &apos;PM&apos;) THEN [acquisitions] ELSE 0 END)&#10;    , 0)' />
            </column>
            <column caption='Daily Spend Coloring' datatype='string' name='[Daily CPI Coloring (copy)_3652137825848074241]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4720827942291185676] &gt; 0.35 THEN &quot;Green&quot;&#10;ELSEIF [Calculation_4720827942291185676] &gt; 0.3 THEN &quot;Yellow&quot;&#10;ELSEIF [Calculation_4720827942291185676] &lt; -0.35 THEN &quot;Red&quot;&#10;ELSEIF [Calculation_4720827942291185676] &lt; -0.3 THEN &quot;Yellow&quot;&#10;ELSE &quot;Grey&quot;&#10;END' />
            </column>
            <column caption='Daily CPC Coloring' datatype='string' name='[Daily CPI Coloring (copy)_3652137825848946690]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Daily CPM Delta (copy)_4720827942303567893] &gt; 0.3 THEN &quot;Red&quot;&#10;ELSEIF [Daily CPM Delta (copy)_4720827942303567893] &lt; -0.3 THEN &quot;Green&quot;&#10;ELSE &quot;Grey&quot;&#10;END' />
            </column>
            <column caption='Daily CPM Coloring' datatype='string' name='[Daily CPI Coloring (copy)_3652137825849184259]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Daily CPI Delta (copy)_4720827942300913683] &gt; 0.3 THEN &quot;Red&quot;&#10;ELSEIF [Daily CPI Delta (copy)_4720827942300913683] &lt; -0.3 THEN &quot;Green&quot;&#10;ELSE &quot;Grey&quot;&#10;END' />
            </column>
            <column caption='Daily CPM Delta' datatype='real' name='[Daily CPI Delta (copy)_4720827942300913683]' role='measure' type='quantitative'>
