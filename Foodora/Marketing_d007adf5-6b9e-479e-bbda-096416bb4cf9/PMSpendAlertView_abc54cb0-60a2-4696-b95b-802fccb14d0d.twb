        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.17trp3m0o7hkwt1f9sa8d122wnh2 (copy)' name='regional budgets query' type='text'>with raw as &#13;
(&#13;
SELECT global_entity_id,&#13;
month,&#13;
acquisitions total_acq_target,&#13;
reacquisitions total_reacq_target,&#13;
PM_acq_target,&#13;
acquisitions-PM_acq_target as nonPM_acq_target&#13;
FROM `dhh---analytics-eu.bi_marketing.KPIs_targets_OKRs_tableau`&#13;
&#13;
left join ( &#13;
          SELECT &#13;
        global_entity_id,&#13;
        date as month,&#13;
        sum(acquisition) PM_acq_target&#13;
        FROM `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_cs_targets_and_budgets_enriched`&#13;
        where date &gt;&gt;= &apos;2024-01-01&apos;&#13;
        and acquisition &gt;&gt;0&#13;
        and channel_targets in (&apos;App (Reach / RMA)&apos;,&apos;Display (Reach / RMA)&apos;,&apos;Paid Social (Reach / RMA)&apos;,&apos;SEM (non-brand)&apos;,&apos;SEM Brand&apos;) &#13;
        group by all)&#13;
&#13;
using (global_entity_id,month)&#13;
&#13;
where month = date_trunc(current_date(),month)&#13;
)&#13;
&#13;
&#13;
SELECT&#13;
  global_entity_id,&#13;
  month,&#13;
  pm_nonpm_total,&#13;
  acquisitions_target,&#13;
total_reacq_target&#13;
FROM (&#13;
  SELECT&#13;
    global_entity_id,&#13;
    month,&#13;
    &apos;total&apos; AS pm_nonpm_total,&#13;
    total_acq_target AS acquisitions_target,&#13;
    total_reacq_target&#13;
  FROM&#13;
    raw&#13;
  UNION ALL&#13;
  SELECT&#13;
    global_entity_id,&#13;
    month,&#13;
    pm_nonpm_total,&#13;
    acquisitions_target,&#13;
    null total_reacq_target&#13;
  FROM&#13;
    raw&#13;
  UNPIVOT(acquisitions_target FOR pm_nonpm_total IN (&#13;
    PM_acq_target AS &apos;PM&apos;,&#13;
    nonPM_acq_target AS &apos;nonPM&apos;&#13;
  ))&#13;
)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
