      <repository-location id='AcquisitionsPerCustomerMetrics' path='/t/Foodora/workbooks/APUserCohorts' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='acquisition_cohorts' name='federated.0gqyjin1s8cywz1fnzv4k0nubbyz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Per Customer Metrics' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders Per Customer&quot;'>
              <calculation class='tableau' formula='&quot;Orders Per Customer&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gqyjin1s8cywz1fnzv4k0nubbyz'>
            <column caption='Total Incentivised Orders' datatype='integer' name='[% Incentivised Orders (copy)_5452381417832648721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incentivised_orders])' />
            </column>
            <column caption='Per Customer Metrics (change)' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Per Customer Metrics (copy)_5452381418067443738]) - LOOKUP(ZN([Per Customer Metrics (copy)_5452381418067443738]), -1)) / ABS(LOOKUP(ZN([Per Customer Metrics (copy)_5452381418067443738]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='GMV Per Customer' datatype='real' name='[Calculation_5452381417793110018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Customers (copy)_5452381417831809037]/[Total Orders (copy)_5452381417831706636]' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Calculation_5452381417831649291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_count])' />
            </column>
            <column caption='1' datatype='integer' name='[Calculation_5452381418166063134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Date' datatype='date' datatype-customized='true' name='[Cohort 30D (copy)_674977009287499797]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;yyyy-MM-dd&quot;, [cohort_30d] ))' />
            </column>
            <column caption='Cohort Period Since Acquisition' datatype='integer' name='[Cohort Type (copy)_5452381417791332353]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[months_since_acquisition]' />
            </column>
            <column caption='Vendor Incentive Cost Per Customer' datatype='real' name='[FP Incentive Cost Per Customer (copy)_5452381418066419735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total FP Incentive Cost (copy)_5452381418055602195]/[Total Orders (copy)_5452381417831706636]' />
            </column>
            <column caption='Orders Per Customer' datatype='real' name='[GFV/Customer (copy)_5452381417793986564]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5452381417831649291]/[Total Orders (copy)_5452381417831706636]' />
            </column>
            <column caption='GFV Per Customer' datatype='real' name='[GMV/Customer (copy)_5452381417793912835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total GMV (copy)_5452381417831886862]/[Total Orders (copy)_5452381417831706636]' />
            </column>
            <column caption='FP Incentive Cost Per Customer' datatype='real' name='[Incentivised Orders Per Customer (copy)_5452381418066046998]' role='measure' type='quantitative'>
