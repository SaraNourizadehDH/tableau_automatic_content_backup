      <table>
        <view>
          <datasources>
            <datasource caption='acquisition_cohorts' name='federated.0gqyjin1s8cywz1fnzv4k0nubbyz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Platform Metrics' datatype='string' name='[Metrics (copy)_6192449502642462729]' param-domain-type='list' role='measure' type='nominal' value='&quot;Customers&quot;'>
              <calculation class='tableau' formula='&quot;Customers&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gqyjin1s8cywz1fnzv4k0nubbyz'>
            <column caption='Total Incentivised Orders' datatype='integer' name='[% Incentivised Orders (copy)_5452381417832648721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incentivised_orders])' />
            </column>
            <column caption='Metrics (change)' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Metrics (copy)_5452381418057154580]) / LOOKUP(ZN([Metrics (copy)_5452381418057154580]), FIRST())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Metrics' datatype='string' datatype-customized='true' name='[Calculation_5452381417804259337]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(CASE [Parameters].[Metrics (copy)_6192449502642462729]&#10;WHEN &apos;Customers&apos; THEN REGEXP_REPLACE(STR([Total Orders (copy)_5452381417831706636]),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;Orders&apos; THEN REGEXP_REPLACE(STR([Calculation_5452381417831649291]),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;GMV&apos; THEN REGEXP_REPLACE(STR(ROUND([Total Customers (copy)_5452381417831809037],0)),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;GFV&apos; THEN REGEXP_REPLACE(STR(ROUND([Total GMV (copy)_5452381417831886862],0)),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;Incentivised Orders&apos; THEN REGEXP_REPLACE(STR([% Incentivised Orders (copy)_5452381417832648721]),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;FP Incentive Cost&apos; THEN REGEXP_REPLACE(STR(ROUND([Total Orders (copy)_5452381418055487506],0)),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;Vendor Incentive Cost&apos; THEN REGEXP_REPLACE(STR(ROUND([Total FP Incentive Cost (copy)_5452381418055602195],0)),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;% Incentivised Orders&apos; THEN STR(ROUND([Total Incentivised Orders (copy)_5452381417832202256]*100,2))&#10;WHEN &apos;AFV&apos; THEN STR(ROUND([Orders Count (copy)_5452381417832079375],2))&#10;END)' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Calculation_5452381417831649291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_count])' />
            </column>
            <column caption='1' datatype='integer' name='[Calculation_5452381418166063134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Date' datatype='date' datatype-customized='true' name='[Cohort 30D (copy)_674977009287499797]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;yyyy-MM-dd&quot;, [cohort_30d] ))' />
            </column>
            <column caption='Cohort Period Since Acquisition' datatype='integer' name='[Cohort Type (copy)_5452381417791332353]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[months_since_acquisition]' />
            </column>
            <column caption='Metrics (numeric)' datatype='real' name='[Metrics (copy)_5452381418057154580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Metrics (copy)_6192449502642462729]&#10;WHEN &apos;Customers&apos; THEN [Total Orders (copy)_5452381417831706636]&#10;WHEN &apos;Orders&apos; THEN [Calculation_5452381417831649291]&#10;WHEN &apos;GMV&apos; THEN [Total Customers (copy)_5452381417831809037]&#10;WHEN &apos;GFV&apos; THEN [Total GMV (copy)_5452381417831886862]&#10;WHEN &apos;Incentivised Orders&apos; THEN [% Incentivised Orders (copy)_5452381417832648721]&#10;WHEN &apos;FP Incentive Cost&apos; THEN [Total Orders (copy)_5452381418055487506]&#10;WHEN &apos;Vendor Incentive Cost&apos; THEN [Total FP Incentive Cost (copy)_5452381418055602195]&#10;WHEN &apos;% Incentivised Orders&apos; THEN [Total Incentivised Orders (copy)_5452381417832202256]&#10;WHEN &apos;AFV&apos; THEN [Orders Count (copy)_5452381417832079375]&#10;END' />
            </column>
            <column caption='AFV' datatype='real' name='[Orders Count (copy)_5452381417832079375]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total GMV (copy)_5452381417831886862] / [Calculation_5452381417831649291]' />
