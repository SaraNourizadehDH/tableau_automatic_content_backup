      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='acquisitions_by_channel' id='acquisitions_by_channel_F39A83DC12624FA6982CFE84BB1605FC'>
            <properties context=''>
              <relation connection='bigquery.11v8f5m0unrhnw104g3nt02hdpge' name='Custom SQL Query' type='text'>SELECT
  marketing_orders.global_entity_id,
  shared_countries.name AS country_name,
  marketing_orders.platform_type,
  DATE_TRUNC(marketing_orders.order_date, MONTH) AS order_month,
  marketing_orders.order_date,
  marketing_orders.channel_subchannel,
  marketing_orders.platform,
  marketing_orders.source,
  marketing_orders.medium,
  marketing_orders.campaign,
  marketing_orders.acquisitions_calibration,
  -- marketing_orders.acquisitions_qc_calibration,
  -- marketing_orders.acquisitions_food_calibration,
  
FROM `fulfillment-dwh-production.curated_data_shared_mkt.bima_marketing_orders` AS marketing_orders
LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
       ON shared_countries.global_entity_id = marketing_orders.global_entity_id
WHERE DATE_TRUNC(order_date, MONTH) &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 12 MONTH)
  AND shared_countries.region = &apos;Asia&apos;
  AND shared_countries.company_name = &apos;Foodpanda&apos;</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
