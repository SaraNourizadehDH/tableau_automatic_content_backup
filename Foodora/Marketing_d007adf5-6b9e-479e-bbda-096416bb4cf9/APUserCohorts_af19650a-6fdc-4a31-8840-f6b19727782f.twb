    <worksheet name='Adoption'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f4d5d' fontsize='12'>Cohort Performance X Month After Adoption</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>&lt;Data Update Time&gt;</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dg_adoption_cohorts (dbt)' name='federated.1rc18ih03d4hep16es8h81k1d47f' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metrics' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Customers&quot;'>
              <calculation class='tableau' formula='&quot;Customers&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rc18ih03d4hep16es8h81k1d47f'>
            <column caption='% Vouchered Orders' datatype='real' name='[% Incentivised Orders (copy)_6192449502636163072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Incentivised Orders (copy)_6192449502636244993] / [Total Customers (copy)_1481332447366516740]' />
            </column>
            <column caption='% Orders w/ VF' datatype='real' name='[% Incentivised Orders (copy)_6192449502636670979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Vouchered Orders (copy)_6192449502636380162] / [Total Customers (copy)_1481332447366516740]' />
            </column>
            <column caption='1' datatype='integer' name='[Calculation_1481332447366152193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Metrics' datatype='string' datatype-customized='true' name='[Calculation_1481332447366262786]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Customers&apos; THEN REGEXP_REPLACE(STR([Calculation_1481332447366377475]),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;Orders&apos; THEN REGEXP_REPLACE(STR([Total Customers (copy)_1481332447366516740]),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;GMV&apos; THEN REGEXP_REPLACE(STR(ROUND([Calculation_1481332447366742021],0)),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;GFV&apos; THEN REGEXP_REPLACE(STR(ROUND([Total GMV (copy)_1481332447366770694],0)),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;Comm Rev Net Incentives&apos; THEN REGEXP_REPLACE(STR(ROUND([Total GFV (copy)_6192449502637162501],0)),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;Incentivised Orders&apos; THEN REGEXP_REPLACE(STR([Total Customers (copy)_1481332447366897671]),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;FP Incentive Cost&apos; THEN REGEXP_REPLACE(STR(ROUND([Total Customers (copy)_1481332447367200777],0)),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;Vendor Incentive Cost&apos; THEN REGEXP_REPLACE(STR(ROUND([Total FP Incentive Cost (copy)_1481332447367364618],0)),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;% Incentivised Orders&apos; THEN STR(ROUND([Calculation_1481332447367004168]*100,2))&#10;WHEN &apos;Vouchered Orders&apos; THEN REGEXP_REPLACE(STR([Total Incentivised Orders (copy)_6192449502636244993]),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;Orders w/ VF&apos; THEN REGEXP_REPLACE(STR([Total Vouchered Orders (copy)_6192449502636380162]),&apos;(\d{1,3}|\G\d{3})(?=(?:\d{3})+(?!\d))&apos;,&apos;$1,&apos;)&#10;WHEN &apos;% Vouchered Orders&apos; THEN STR(ROUND([% Incentivised Orders (copy)_6192449502636163072]*100,2))&#10;WHEN &apos;% Orders w/ VF&apos; THEN STR(ROUND([% Incentivised Orders (copy)_6192449502636670979]*100,2))&#10;WHEN &apos;AFV&apos; THEN STR(ROUND([Calculation_1481332447367454731],2))&#10;WHEN &apos;FP iCPO&apos; THEN STR(ROUND([Total Orders w/ VF (copy)_6192449502637252614],2))&#10;END)' />
            </column>
            <column caption='Total Customers' datatype='integer' name='[Calculation_1481332447366377475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_count])' />
            </column>
            <column caption='Total GMV' datatype='real' name='[Calculation_1481332447366742021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])' />
            </column>
            <column caption='% Incentivised Orders' datatype='real' name='[Calculation_1481332447367004168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Customers (copy)_1481332447366897671] / [Total Customers (copy)_1481332447366516740]' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_1481332447367454731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total GMV (copy)_1481332447366770694]/[Total Customers (copy)_1481332447366516740]' />
            </column>
            <column caption='Metrics (change)' datatype='real' name='[Calculation_1481332447367614476]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_1481332447367716877]) / LOOKUP(ZN([Calculation_1481332447367716877]), FIRST())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Metrics (numeric)' datatype='real' name='[Calculation_1481332447367716877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Customers&apos; THEN [Calculation_1481332447366377475]&#10;WHEN &apos;Orders&apos; THEN [Total Customers (copy)_1481332447366516740]&#10;WHEN &apos;GMV&apos; THEN [Calculation_1481332447366742021]&#10;WHEN &apos;GFV&apos; THEN [Total GMV (copy)_1481332447366770694]&#10;WHEN &apos;Comm Rev Net Incentives&apos; THEN [Total GFV (copy)_6192449502637162501]&#10;WHEN &apos;Incentivised Orders&apos; THEN [Total Customers (copy)_1481332447366897671]&#10;WHEN &apos;FP Incentive Cost&apos; THEN [Total Customers (copy)_1481332447367200777]&#10;WHEN &apos;Vendor Incentive Cost&apos; THEN [Total FP Incentive Cost (copy)_1481332447367364618]&#10;WHEN &apos;% Incentivised Orders&apos; THEN [Calculation_1481332447367004168]&#10;WHEN &apos;Vouchered Orders&apos; THEN [Total Incentivised Orders (copy)_6192449502636244993]&#10;WHEN &apos;Orders w/ VF&apos; THEN [Total Vouchered Orders (copy)_6192449502636380162]&#10;WHEN &apos;% Vouchered Orders&apos; THEN [% Incentivised Orders (copy)_6192449502636163072]&#10;WHEN &apos;% Orders w/ VF&apos; THEN [% Incentivised Orders (copy)_6192449502636670979]&#10;WHEN &apos;AFV&apos; THEN [Calculation_1481332447367454731]&#10;WHEN &apos;FP iCPO&apos; THEN [Total Orders w/ VF (copy)_6192449502637252614]&#10;END' />
            </column>
            <column caption='Cohort Period Since Adoption' datatype='integer' name='[Calculation_1481332447369891859]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[months_since_acquisition]' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Total Customers (copy)_1481332447366516740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_count])' />
            </column>
            <column caption='Total Incentivised Orders' datatype='integer' name='[Total Customers (copy)_1481332447366897671]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incentivised_orders])' />
            </column>
            <column caption='Total FP Incentive Cost' datatype='real' name='[Total Customers (copy)_1481332447367200777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discount_cost_fp_eur]) + SUM([voucher_cost_fp_eur])' />
            </column>
            <column caption='Total Vendor Incentive Cost' datatype='real' name='[Total FP Incentive Cost (copy)_1481332447367364618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discount_cost_vendor_eur]) + SUM([voucher_cost_vendor_eur])' />
            </column>
            <column caption='Total Commission Rev' datatype='real' name='[Total GFV (copy)_6192449502636965892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_eur])' />
            </column>
            <column caption='FLGP' datatype='real' name='[Total GFV (copy)_6192449502637162501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total GFV (copy)_6192449502636965892] - [Total Customers (copy)_1481332447367200777]' />
            </column>
            <column caption='Total GFV' datatype='real' name='[Total GMV (copy)_1481332447366770694]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_eur])' />
            </column>
            <column caption='Total Vouchered Orders' datatype='integer' name='[Total Incentivised Orders (copy)_6192449502636244993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vouchered_orders])' />
            </column>
            <column caption='FP iCPO' datatype='real' name='[Total Orders w/ VF (copy)_6192449502637252614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Customers (copy)_1481332447367200777]/[Total Customers (copy)_1481332447366516740]' />
            </column>
            <column caption='Total Orders w/ VF' datatype='integer' name='[Total Vouchered Orders (copy)_6192449502636380162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([has_vendor_funding_orders])' />
            </column>
            <column caption='Adoption Source' datatype='string' name='[adoption_source]' role='dimension' type='nominal' />
            <column caption='Adoption Vertical' datatype='string' name='[adoption_vertical]' role='dimension' type='nominal' />
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Cohort Month' datatype='string' datatype-customized='true' name='[cohort_30d]' role='dimension' type='nominal' />
            <column caption='Commission Eur' datatype='real' name='[commission_eur]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Customer Count' datatype='integer' name='[customer_count]' role='measure' type='quantitative' />
            <column caption='Discount Budget Channel' datatype='string' name='[discount_budget_channel]' role='dimension' type='nominal' />
            <column caption='Discount Cost Fp Eur' datatype='real' name='[discount_cost_fp_eur]' role='measure' type='quantitative' />
            <column caption='Discount Cost Vendor Eur' datatype='real' name='[discount_cost_vendor_eur]' role='measure' type='quantitative' />
            <column caption='Gfv Eur' datatype='real' name='[gfv_eur]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column caption='Has Vendor Funding Orders' datatype='integer' name='[has_vendor_funding_orders]' role='measure' type='quantitative' />
            <column caption='Incentivised Orders' datatype='integer' name='[incentivised_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1481332447366152193]' derivation='Min' name='[min:Calculation_1481332447366152193:qk]' pivot='key' type='quantitative' />
            <column caption='Months Since Acquisition' datatype='integer' name='[months_since_acquisition]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1481332447369891859]' derivation='None' name='[none:Calculation_1481332447369891859:ok]' pivot='key' type='ordinal' />
            <column-instance column='[adoption_source]' derivation='None' name='[none:adoption_source:nk]' pivot='key' type='nominal' />
            <column-instance column='[adoption_vertical]' derivation='None' name='[none:adoption_vertical:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[cohort_30d]' derivation='None' name='[none:cohort_30d:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[discount_budget_channel]' derivation='None' name='[none:discount_budget_channel:nk]' pivot='key' type='nominal' />
            <column-instance column='[voucher_budget_channel]' derivation='None' name='[none:voucher_budget_channel:nk]' pivot='key' type='nominal' />
            <column caption='Orders Count' datatype='integer' name='[orders_count]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1481332447367716877]' derivation='User' name='[pcdf:usr:Calculation_1481332447367716877:qk]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='PctDiff'>
