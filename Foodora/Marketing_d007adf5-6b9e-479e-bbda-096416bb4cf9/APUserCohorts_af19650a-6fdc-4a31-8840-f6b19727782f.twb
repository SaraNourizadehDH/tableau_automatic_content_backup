              <calculation class='tableau' formula='([Total Customers (copy)_5452381417831809037] &#10;- SUM([voucher_cost_fp_eur]) &#10;- SUM([voucher_cost_vendor_eur]) &#10;- SUM([discount_cost_fp_eur])&#10;- SUM([discount_cost_vendor_eur])) / [Total Orders (copy)_5452381417831706636]' />
