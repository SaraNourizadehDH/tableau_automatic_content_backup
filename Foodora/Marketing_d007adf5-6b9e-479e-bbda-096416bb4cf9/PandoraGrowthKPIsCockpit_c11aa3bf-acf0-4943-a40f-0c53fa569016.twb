              <calculation class='tableau' formula='//IF [report_date] = DATE(DATEADD(&quot;day&quot;, -1, [last_updated_timestamp])) THEN TRUE ELSE FALSE END&#10;&#10;IF ISNULL([Calculation_1285848104949071872]) THEN&#10;    // Row from Main table → match its latest real date&#10;    [report_date] = { FIXED : MAX([report_date]) }&#10;ELSE&#10;    // Row from HVA table → match its latest aligned date&#10;    [Calculation_1285848104949071872] = { FIXED : MAX([Calculation_1285848104949071872]) }&#10;END' />
