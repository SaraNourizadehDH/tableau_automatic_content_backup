          <datasource-dependencies datasource='federated.04f6kp11txjhzi136hde207tv4su'>
            <column caption='Compare Header Label' datatype='string' name='[Calculation_6867848729497247761]' role='measure' type='nominal'>
              <calculation class='tableau' formula='//&quot;Selected Period: &quot; + STR(MIN([report_date])) + &quot; to &quot; + STR(MAX([report_date]))&#10;&#10;&quot;Comparing: &quot; +&#10;IF MIN([date_grain]) = &apos;weekly&apos; THEN&#10;    &quot;Wk of &quot; +&#10;    STR(DAY(MIN([report_date]))) + &quot;-&quot; +&#10;    LEFT(DATENAME(&apos;month&apos;, MIN([report_date])), 3) + &quot;-&quot; +&#10;    RIGHT(STR(YEAR(MIN([report_date]))), 2)&#10;ELSE&#10;    STR(DAY(MIN([report_date]))) + &quot;-&quot; +&#10;    LEFT(DATENAME(&apos;month&apos;, MIN([report_date])), 3) + &quot;-&quot; +&#10;    RIGHT(STR(YEAR(MIN([report_date]))), 2)&#10;END&#10;+&#10;&quot; vs &quot; +&#10;IF MAX([date_grain]) = &apos;weekly&apos; THEN&#10;    &quot;Wk of &quot; +&#10;    STR(DAY(MAX([report_date]))) + &quot;-&quot; +&#10;    LEFT(DATENAME(&apos;month&apos;, MAX([report_date])), 3) + &quot;-&quot; +&#10;    RIGHT(STR(YEAR(MAX([report_date]))), 2)&#10;ELSE&#10;    STR(DAY(MAX([report_date]))) + &quot;-&quot; +&#10;    LEFT(DATENAME(&apos;month&apos;, MAX([report_date])), 3) + &quot;-&quot; +&#10;    RIGHT(STR(YEAR(MAX([report_date]))), 2)&#10;END' />
            </column>
