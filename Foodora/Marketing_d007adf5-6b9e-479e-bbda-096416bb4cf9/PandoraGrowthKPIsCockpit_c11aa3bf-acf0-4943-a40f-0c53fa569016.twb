      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_9C39A12C4EF0457B8B2CF69CC31E8BB4'>
            <properties context=''>
              <relation connection='bigquery.1t79pd11x5gswc12bfuni1ibap5p' name='Custom SQL Query' type='text'><![CDATA[-- create table then change to incremental

-- metrics needed -- MONTHLY AND WEEKLY ANALYSIS + MTD FILTERs
/*
daily metrics are simply (MTD values / Days passed)--- MTD will be challenging with Acids

daily orders
frequency -- can be derived later
active users
daily acquisition
daily 30D reactivations -- need to check base code from (1) Reactivations

daily GMV
GMV/order -- can be derived
daily Acqusition GMV
daily Acqusition GMV/order -- can be derived

GMV LOCAL TO BE ADDED---------------------------- for overall and Acquisition -- not in base table, need to query separately
*/

WITH params AS (
  SELECT
    DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY) AS today,
    EXTRACT(DAY FROM DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)) AS days_covered_in_month
),

base_orders AS (
  SELECT
    o.global_entity_id,
    c.name AS country,
    o.report_date,
    o.is_acquisition,
    o.is_reacquisition,
    CASE WHEN o.customer_segmentation = "Churn Risk Reactivation" THEN TRUE ELSE FALSE END AS is_churn_risk_reactivation,
    o.order_uid,
    o.analytical_customer_id,
    o.total_user_paid_gmv_eur
  FROM `fulfillment-dwh-production.pandata_report.marketing__growth_kpi_dashboard_orders_raw` o
  JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` c
    ON o.global_entity_id = c.global_entity_id
  WHERE o.global_entity_id <<>> "FP_TH"
    AND o.report_date >>= "2024-01-01"
),

monthly_data AS (
  SELECT
    'monthly' AS date_grain,
    DATE_TRUNC(report_date, MONTH) AS report_date,
    EXTRACT(DAY FROM LAST_DAY(report_date)) AS days_in_month,
    global_entity_id,
    country,
    COUNT(DISTINCT order_uid) AS orders,
    COUNT(DISTINCT analytical_customer_id) AS active_users,
    COUNT(DISTINCT IF(is_acquisition, analytical_customer_id, NULL)) AS acquisition_users,
    COUNT(DISTINCT IF(is_reacquisition, analytical_customer_id, NULL)) AS reacquisition_users,
    COUNT(DISTINCT IF(is_churn_risk_reactivation, analytical_customer_id, NULL)) AS churn_risk_reactivation_users,
    SUM(total_user_paid_gmv_eur) AS gmv,
    SUM(IF(is_acquisition, total_user_paid_gmv_eur, 0)) AS acquisition_gmv
  FROM base_orders
  GROUP BY ALL
),

weekly_data AS (
  SELECT
    'weekly' AS date_grain,
    DATE_TRUNC(report_date, WEEK(MONDAY)) AS report_date,
    7 AS days_in_month,
    global_entity_id,
    country,
    COUNT(DISTINCT order_uid) AS orders,
    COUNT(DISTINCT analytical_customer_id) AS active_users,
    COUNT(DISTINCT IF(is_acquisition, analytical_customer_id, NULL)) AS acquisition_users,
    COUNT(DISTINCT IF(is_reacquisition, analytical_customer_id, NULL)) AS reacquisition_users,
    COUNT(DISTINCT IF(is_churn_risk_reactivation, analytical_customer_id, NULL)) AS churn_risk_reactivation_users,
    SUM(total_user_paid_gmv_eur) AS gmv,
    SUM(IF(is_acquisition, total_user_paid_gmv_eur, 0)) AS acquisition_gmv
  FROM base_orders
  GROUP BY ALL
),

mtd_data AS (
  SELECT
    'mtd' AS date_grain,
    DATE_TRUNC(o.report_date, MONTH) AS report_date,
    p.days_covered_in_month AS days_in_month,
    o.global_entity_id,
    o.country,
    COUNT(DISTINCT o.order_uid) AS orders,
    COUNT(DISTINCT o.analytical_customer_id) AS active_users,
    COUNT(DISTINCT IF(o.is_acquisition, o.analytical_customer_id, NULL)) AS acquisition_users,
    COUNT(DISTINCT IF(o.is_reacquisition, o.analytical_customer_id, NULL)) AS reacquisition_users,
    COUNT(DISTINCT IF(o.is_churn_risk_reactivation, o.analytical_customer_id, NULL)) AS churn_risk_reactivation_users,
    SUM(o.total_user_paid_gmv_eur) AS gmv,
    SUM(IF(o.is_acquisition, o.total_user_paid_gmv_eur, 0)) AS acquisition_gmv
  FROM base_orders o
  JOIN params p ON TRUE
  WHERE EXTRACT(DAY FROM o.report_date) <<= EXTRACT(DAY FROM DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY))
  GROUP BY ALL
)

SELECT * FROM monthly_data
UNION ALL
SELECT * FROM weekly_data
UNION ALL
SELECT * FROM mtd_data]]></relation>
