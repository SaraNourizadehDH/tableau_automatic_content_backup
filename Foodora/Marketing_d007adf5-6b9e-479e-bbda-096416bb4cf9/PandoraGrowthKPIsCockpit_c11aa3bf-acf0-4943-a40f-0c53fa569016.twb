              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='&lt;&lt; HVA &gt;&gt; ' datatype='integer' name='[&lt;&lt; INCENTIVES &gt;&gt;  (copy)_6377800823414820864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='&lt;&lt; CUSTOMERS &gt;&gt;' datatype='integer' name='[&lt;&lt; ORDERS &gt;&gt; (copy)_2111906790595817486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='&lt;&lt; Q-COMM &gt;&gt;' datatype='integer' name='[&lt;&lt; ORDERS &gt;&gt; (copy)_2111906790596149263]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='&lt;&lt; ACQUISITIONS &gt;&gt;' datatype='integer' name='[&lt;&lt; Q-COMM &gt;&gt; (copy)_1578933925940781078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='&lt;&lt; PANDA PRO &gt;&gt;' datatype='integer' name='[&lt;&lt; Q-COMM &gt;&gt; (copy)_2111906790596395024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='Fraud Acquisition % - Daily' datatype='real' default-format='p0.00%' name='[Calculation_1275363159646851073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[fraud_acq_acids_daily]/[all_acquisition_acids_daily]' />
            </column>
            <column caption='% HVA Incentives Spend Daily' datatype='real' default-format='p0.00%' name='[Calculation_1275363159670214659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[hva_incentive_spend]/[total_incentives_spend]' />
            </column>
            <column caption='daily conversion rate' datatype='real' name='[Calculation_1578933925652799488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([daily_sessions_w_orders]) / SUM([daily_sessions])' />
            </column>
            <column caption='QC L30D Active Users % of L30D Active Users' datatype='real' name='[Calculation_1578933926035263519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([l30d_qc_active_users])/SUM([l30d_active_users])' />
            </column>
            <column caption='Last 8 Days Filter' datatype='boolean' name='[Calculation_2111906790593949707]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] &gt;= DATEADD(&apos;day&apos;,-8,[last_updated_timestamp])' />
            </column>
            <column caption='&lt;&lt; ORDERS &gt;&gt;' datatype='integer' name='[Calculation_2111906790594646028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='AFV Daily' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2590414232597995538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_food_value_eur_daily])/SUM([platform_orders_daily])' />
            </column>
            <column caption='User paid GMV per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2590414232763297841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_user_paid_gmv_eur_daily])/SUM([platform_orders_daily])' />
            </column>
            <column caption='Non Pro Active Users Daily' datatype='integer' name='[Calculation_264867997561032704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_users_daily])-SUM([pro_active_users_daily])' />
            </column>
            <column caption='Pro Join Rate Daily' datatype='real' name='[Calculation_264867997561344001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([first_and_returning_subscription_activations_daily]) / [Calculation_264867997561032704]' />
            </column>
            <column caption='DH+VF Incentives Cost Daily' datatype='real' name='[Calculation_6377800823417225217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_dh_incentives_eur_daily]+[total_vf_incentives_eur_daily]' />
            </column>
            <column caption='DH+VF as % of GMV Daily' datatype='real' default-format='p0.00%' name='[Calculation_6377800823418941449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6377800823417225217]/[total_user_paid_gmv_eur_daily]' />
            </column>
            <column caption='Pro AU % of  Platform AU' datatype='real' name='[QC L30D Active Users % of L30D Active Users (copy)_1578933926039679010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_active_users_daily])/SUM([active_users_daily])' />
            </column>
            <column caption='User paid GMV per Order (Local)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[User paid GMV per Order (copy)_1285848105104154713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_user_paid_gmv_local_daily])/SUM([platform_orders_daily])' />
            </column>
            <column caption='DF+SF per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[User paid GMV per Order (copy)_1285848105112215660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_df_user_paid_eur_daily])+SUM([total_service_fee_eur_daily]))&#10;/SUM([platform_orders_daily])' />
            </column>
