      <column caption='User Paid GMV (Local) per Order' datatype='real' name='[Calculation_1285848105118449779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_user_paid_gmv_local_daily])/SUM([platform_orders_daily])' />
      </column>
      <column caption='Date Range Filter' datatype='boolean' name='[Calculation_1639451022254837761]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] &gt;= [Parameters].[Parameter 1] AND [report_date] &lt;= [Parameters].[Start Date (copy)_1639451022254514176]' />
      </column>
      <column caption='AFV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2590414232751677480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_food_value_eur_daily])/SUM([platform_orders_daily])' />
      </column>
      <column caption='Pro AU % of Platform AU' datatype='real' default-format='p0.0%' name='[Calculation_2590414232752082985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_active_users_daily])/SUM([active_users_daily])' />
      </column>
      <column caption='User paid GMV per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2590414232762413104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_user_paid_gmv_eur_daily])/SUM([platform_orders_daily])' />
      </column>
      <column caption='Daily Conversion Rate' datatype='real' default-format='p0.00%' name='[Calculation_402368495696363520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([daily_sessions_w_orders]) / SUM([daily_sessions])' />
      </column>
      <column caption='DH+VF Incentives Cost Daily' datatype='real' name='[Calculation_402368495696764929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_dh_incentives_eur_daily]+[total_vf_incentives_eur_daily]' />
      </column>
      <column caption='DH+VF Inc as % of GMV Daily ' datatype='real' default-format='p0.00%' name='[Calculation_402368495697072130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_402368495696764929])/SUM([total_user_paid_gmv_eur_daily])' />
      </column>
      <column caption='&lt;&lt; ORDERS &gt;&gt;' datatype='integer' name='[Calculation_402368496025829380]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
      </column>
      <column caption='Pandora' datatype='string' name='[Calculation_4958181731971682305]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Pandora&quot;' />
      </column>
      <column caption='HVA % of Incentive Spend' datatype='real' default-format='p0.00%' name='[Calculation_5484258485010345985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hva_incentive_spend])/SUM([total_incentives_spend])' />
      </column>
      <column caption='Fraud Acquisition % Daily' datatype='real' default-format='p0.0%' name='[Calculation_575686738377793536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fraud_acq_acids_daily])/SUM([all_acquisition_acids_daily])' />
      </column>
      <column caption='DF+SF per Order Daily' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[User paid GMV per Order (copy)_1285848105119617141]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_df_user_paid_eur_daily]) + SUM([total_service_fee_eur_daily]))&#10;/SUM([platform_orders_daily])' />
      </column>
