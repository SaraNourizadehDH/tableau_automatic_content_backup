            <column-instance column='[incentive_type_mapped (marketing__master_dashboard_table)]' derivation='None' name='[none:incentive_type_mapped (marketing__master_dashboard_table):nk]' pivot='key' type='nominal' />
            <column-instance column='[order_type_mapping (marketing__master_dashboard_table)]' derivation='None' name='[none:order_type_mapping (marketing__master_dashboard_table):nk]' pivot='key' type='nominal' />
            <column caption='Order_Type_Mapping' datatype='string' name='[order_type_mapping (marketing__master_dashboard_table)]' role='dimension' type='nominal' />
