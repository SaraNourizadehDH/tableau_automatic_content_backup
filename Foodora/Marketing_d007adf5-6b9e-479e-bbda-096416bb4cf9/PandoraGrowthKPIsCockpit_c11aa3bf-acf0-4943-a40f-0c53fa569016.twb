      <column caption='Incentives Early Weekly Delta' datatype='real' default-format='p0.0%' name='[Calculation_1285848104963928068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(SUM([Incentives Early]) - LOOKUP(SUM([Incentives Early]), -7)) / LOOKUP(SUM([Incentives Early]), -7)&#10;&#10;(&#10;  LOOKUP(SUM([incentives_early]), -2) &#10;  - LOOKUP(SUM([incentives_early]), -9)&#10;) &#10;/ LOOKUP(SUM([incentives_early]), -9)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='HVA Incentive Spend Weekly Delta' datatype='real' default-format='p0.0%' name='[Calculation_1285848104966213647]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(SUM([Hva Incentive Spend]) - LOOKUP(SUM([Hva Incentive Spend]), -7)) / LOOKUP(SUM([Hva Incentive Spend]), -7)&#10;&#10;// adjusting for lag in HVA data. -9 instead of -7 due to 2-day lag&#10;(&#10;  LOOKUP(SUM([Calculation_1275363159670214659]), -2) &#10;  - LOOKUP(SUM([Calculation_1275363159670214659]), -9)&#10;) &#10;/ LOOKUP(SUM([Calculation_1275363159670214659]), -9)'>
