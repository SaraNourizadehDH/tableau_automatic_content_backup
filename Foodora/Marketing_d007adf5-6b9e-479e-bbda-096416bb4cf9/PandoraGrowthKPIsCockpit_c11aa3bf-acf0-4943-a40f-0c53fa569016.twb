              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='&lt;&lt; PANDA PRO &gt;&gt;' datatype='integer' name='[&lt;&lt; Q-COMM &gt;&gt; (copy)_2111906790596395024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='daily conversion rate' datatype='real' name='[Calculation_1578933925652799488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([daily_sessions_w_orders]) / SUM([daily_sessions])' />
            </column>
            <column caption='QC L30D Active Users % of L30D Active Users' datatype='real' name='[Calculation_1578933926035263519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([l30d_qc_active_users])/SUM([l30d_active_users])' />
            </column>
