      <column caption='report_date_aligned' datatype='date' name='[Calculation_1285848104949071872]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// adding a 3-day window to match the latest report date for calculation columns&#10;//DATEADD(&apos;day&apos;, 3, [report_date (Custom SQL Query2)])&#10;&#10;// creating a dynamic field to match the latest date in the main table&#10;DATE(&#10;    DATEADD(&#10;        &apos;day&apos;,&#10;        DATEDIFF(&apos;day&apos;, &#10;            { FIXED : MAX([report_date (Custom SQL Query2)]) },&#10;            { FIXED : MAX([report_date]) }&#10;        ),&#10;        [report_date (Custom SQL Query2)]&#10;    )&#10;)' />
