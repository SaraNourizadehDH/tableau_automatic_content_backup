    <worksheet name='Master dash - Overview'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontsize='14'>Overview</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Master Dash - MTD Daily' name='federated.0ia28kx19esz4a1c9sdn40eff329' />
          </datasources>
          <datasource-dependencies datasource='federated.0ia28kx19esz4a1c9sdn40eff329'>
            <column caption='Days in Current Month' datatype='integer' name='[Calculation_6367386204941508610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Calculates the total number of days in the month of the latest date&#10;DAY(DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Calculation_6367386204989767689]))))' />
            </column>
            <column caption='Run Rate' datatype='real' name='[Calculation_6367386204941881347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// (Actual MTD Orders / Days Passed) * Total Days in Month&#10;(SUM([L7D Orders (copy)_6367386204990308364]) / MAX([Calculation_6367386204942065668])) * MAX([Calculation_6367386204941508610])' />
            </column>
            <column caption='Current Day of Month' datatype='integer' name='[Calculation_6367386204942065668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Gets the day number from the latest date in the data (e.g., 10 for June 10th)&#10;DAY([Calculation_6367386204989767689])' />
            </column>
            <column caption='Latest Date in Data' datatype='date' name='[Calculation_6367386204989767689]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([report_date (marketing__master_dashboard_table)])}' />
            </column>
            <column caption='L7D Orders' datatype='integer' name='[Calculation_6367386204989964298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Sum of orders from the last 7 days, ending on the latest date in the data&#10;IF [report_date (marketing__master_dashboard_table)] &gt; DATEADD(&apos;day&apos;, -7, [Calculation_6367386204989767689])&#10;THEN [orders (marketing__master_dashboard_table)]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='L7D %' datatype='real' default-format='p0.0%' name='[Calculation_6367386205001273365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Calculates the percentage growth or decline. Handles division by zero.&#10;IF ZN(SUM([L7D Orders (copy)_6367386204990173195])) = 0 THEN&#10;    NULL&#10;ELSE&#10;    (SUM([Calculation_6367386204989964298]) - SUM([L7D Orders (copy)_6367386204990173195])) / SUM([L7D Orders (copy)_6367386204990173195])&#10;END' />
            </column>
            <column caption='MTD MoM %' datatype='real' default-format='p0.0%' name='[Calculation_6367386205002231830]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Calculates the MTD percentage growth or decline vs the previous month.&#10;IF ZN(SUM([MTD Orders (copy)_6367386204990423053])) = 0 THEN&#10;    NULL&#10;ELSE&#10;    (SUM([L7D Orders (copy)_6367386204990308364]) - SUM([MTD Orders (copy)_6367386204990423053])) / SUM([MTD Orders (copy)_6367386204990423053])&#10;END' />
            </column>
            <column caption='MTD YoY %' datatype='real' default-format='p0.0%' name='[Calculation_6367386205002981399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Calculates the MTD percentage growth or decline vs. last year.&#10;IF ZN(SUM([Prev MTD Orders (copy)_6367386204990582798])) = 0 THEN&#10;    NULL&#10;ELSE&#10;    (SUM([L7D Orders (copy)_6367386204990308364]) - SUM([Prev MTD Orders (copy)_6367386204990582798])) / SUM([Prev MTD Orders (copy)_6367386204990582798])&#10;END' />
            </column>
            <column caption='Prev Month Total' datatype='integer' name='[Calculation_6367386205003845656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Sums all orders from the entire previous calendar month&#10;IF DATETRUNC(&apos;month&apos;, [report_date (marketing__master_dashboard_table)]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Calculation_6367386204989767689]))&#10;THEN [orders (marketing__master_dashboard_table)]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Run Rate MoM %' datatype='real' default-format='p0.0%' name='[Calculation_6367386205003960345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Calculates the percentage difference between the projected run rate and last month&apos;s total.&#10;IF ZN(SUM([Calculation_6367386205003845656])) = 0 THEN&#10;    NULL&#10;ELSE&#10;    ([Calculation_6367386204941881347] - SUM([Calculation_6367386205003845656])) / SUM([Calculation_6367386205003845656])&#10;END' />
            </column>
            <column caption='L8-14D Orders' datatype='integer' name='[L7D Orders (copy)_6367386204990173195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Sum of orders from 8 to 14 days ago, relative to the latest date&#10;IF [report_date (marketing__master_dashboard_table)] &lt;= DATEADD(&apos;day&apos;, -7, [Calculation_6367386204989767689]) AND [report_date (marketing__master_dashboard_table)] &gt; DATEADD(&apos;day&apos;, -14, [Calculation_6367386204989767689])&#10;THEN [orders (marketing__master_dashboard_table)]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='MTD Orders' datatype='integer' name='[L7D Orders (copy)_6367386204990308364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// MTD sum for the month of the latest date&#10;IF DATETRUNC(&apos;month&apos;, [report_date (marketing__master_dashboard_table)]) = DATETRUNC(&apos;month&apos;, [Calculation_6367386204989767689])&#10;THEN [orders (marketing__master_dashboard_table)]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Prev MTD Orders' datatype='integer' name='[MTD Orders (copy)_6367386204990423053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// MTD sum for the same period in the previous month, relative to the latest date&#10;IF DATETRUNC(&apos;month&apos;, [report_date (marketing__master_dashboard_table)]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Calculation_6367386204989767689]))&#10;AND DAY([report_date (marketing__master_dashboard_table)]) &lt;= DAY([Calculation_6367386204989767689])&#10;THEN [orders (marketing__master_dashboard_table)]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Prev Year MTD Orders' datatype='integer' name='[Prev MTD Orders (copy)_6367386204990582798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// MTD sum for the same period in the previous year, relative to the latest date&#10;IF DATETRUNC(&apos;month&apos;, [report_date (marketing__master_dashboard_table)]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;year&apos;, -1, [Calculation_6367386204989767689]))&#10;AND DAY([report_date (marketing__master_dashboard_table)]) &lt;= DAY([Calculation_6367386204989767689])&#10;THEN [orders (marketing__master_dashboard_table)]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country (marketing__master_dashboard_table)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Incentive_Type_Mapped' datatype='string' name='[incentive_type_mapped (marketing__master_dashboard_table)]' role='dimension' type='nominal' />
