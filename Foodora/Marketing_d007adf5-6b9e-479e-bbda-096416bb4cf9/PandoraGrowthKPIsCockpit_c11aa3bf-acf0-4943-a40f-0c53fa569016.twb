      <datasource-dependencies datasource='Parameters'>
        <column caption='Period 1' datatype='date' default-format='*dd-mmm-yy' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='#2025-02-24#'>
          <calculation class='tableau' formula='#2025-02-24#' />
        </column>
        <column caption='Period 2' datatype='date' default-format='*dd-mmm-yy' name='[Period 1 (copy)_6867848728816394242]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-14#'>
