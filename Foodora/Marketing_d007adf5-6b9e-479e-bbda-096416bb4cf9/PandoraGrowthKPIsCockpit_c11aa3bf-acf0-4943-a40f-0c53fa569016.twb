            <column caption='&lt;&lt; NEW METRICS &gt;&gt;' datatype='integer' name='[&lt;&lt; Q-COMM &gt;&gt; (copy)_1275363159405527040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='&lt;&lt; ACQUISITIONS &gt;&gt;' datatype='integer' name='[&lt;&lt; Q-COMM &gt;&gt; (copy)_1578933925940781078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='&lt;&lt; PANDA PRO &gt;&gt;' datatype='integer' name='[&lt;&lt; Q-COMM &gt;&gt; (copy)_2111906790596395024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='AFV P30D' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AFV P7D (copy)_2590414232600027160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([p30d_total_food_value_eur_daily])/SUM([p30d_platform_orders_daily])' />
            </column>
            <column caption='L30D Qc Active Users (placeholder)' datatype='integer' name='[Active Customer RR (placeholder) (copy)_1578933926030381086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='report_date_aligned' datatype='date' name='[Calculation_1285848104949071872]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// adding a 3-day window to match the latest report date for calculation columns&#10;//DATEADD(&apos;day&apos;, 3, [report_date (Custom SQL Query2)])&#10;&#10;// creating a dynamic field to match the latest date in the main table&#10;DATE(&#10;    DATEADD(&#10;        &apos;day&apos;,&#10;        DATEDIFF(&apos;day&apos;, &#10;            { FIXED : MAX([report_date (Custom SQL Query2)]) },&#10;            { FIXED : MAX([report_date]) }&#10;        ),&#10;        [report_date (Custom SQL Query2)]&#10;    )&#10;)' />
            </column>
            <column caption='Conversion rate P30D' datatype='real' name='[Calculation_1578933925657948168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([p30d_daily_sessions_w_orders])/SUM([p30d_daily_sessions])' />
            </column>
            <column caption='&lt;&lt; ORDERS &gt;&gt;' datatype='integer' name='[Calculation_2111906790594646028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='&quot;P30D&quot;' datatype='string' name='[Calculation_2382896843537776659]' role='dimension' type='nominal' user:unnamed='P30D'>
              <calculation class='tableau' formula='&quot;P30D&quot;' />
            </column>
            <column caption='DH+VF Incentives Cost P30D' datatype='real' name='[DH+VF Incentives Cost MTD (copy)_6377800823418281989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[p30d_total_dh_incentives_eur_daily]+[p30d_total_vf_incentives_eur_daily]' />
            </column>
            <column caption='DH+VF as % of GMV P30D' datatype='real' default-format='p0.00%' name='[DH+VF as % of GMV MTD (copy)_45669378926096385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DH+VF Incentives Cost MTD (copy)_6377800823418281989])/SUM([p30d_total_user_paid_gmv_eur_daily])' />
            </column>
            <column caption='Fraud Acquisition % - P30D' datatype='real' default-format='p0.00%' name='[Fraud Acquisition % - L7D (copy) (copy) (copy)_4121004807249063988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[fraud_acq_acids_p30d]/[all_acquisition_acids_p30d]' />
            </column>
            <column caption='Latest Date Filter' datatype='boolean' name='[Last 8 Days Filter (copy)_2111906790601916433]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [report_date] = DATE(DATEADD(&quot;day&quot;, -1, [last_updated_timestamp])) THEN TRUE ELSE FALSE END&#10;&#10;IF ISNULL([Calculation_1285848104949071872]) THEN&#10;    // Row from Main table → match its latest real date&#10;    [report_date] = { FIXED : MAX([report_date]) }&#10;ELSE&#10;    // Row from HVA table → match its latest aligned date&#10;    [Calculation_1285848104949071872] = { FIXED : MAX([Calculation_1285848104949071872]) }&#10;END' />
            </column>
            <column caption='Non Pro Active Users P30D' datatype='integer' name='[Non Pro Active Users L30D (copy)_264867997566418959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([p30d_active_users])-SUM([p30d_pro_active_users])' />
            </column>
            <column caption='P30D User paid GMV per Order (Local)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[P30D User paid GMV per Order (copy)_1285848105103585365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_user_paid_gmv_local_p30d])/SUM([p30d_platform_orders_daily])' />
            </column>
            <column caption='P30D DF+SF per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[P30D User paid GMV per Order (copy)_1285848105111220328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_df_user_paid_eur_p30d])+SUM([total_service_fee_eur_p30d]))&#10;/&#10;SUM([p30d_platform_orders_daily])' />
            </column>
            <column caption='P30D User paid GMV per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[P7D User paid GMV per Order (copy)_2590414232766607413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([p30d_total_user_paid_gmv_eur_daily])/SUM([p30d_platform_orders_daily])' />
            </column>
            <column caption='Pro Join Rate P30D' datatype='real' name='[Pro Join Rate L30D (copy)_264867997566013453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([p30d_first_and_returning_subscription_activations_daily]) / [Non Pro Active Users L30D (copy)_264867997566418959]' />
