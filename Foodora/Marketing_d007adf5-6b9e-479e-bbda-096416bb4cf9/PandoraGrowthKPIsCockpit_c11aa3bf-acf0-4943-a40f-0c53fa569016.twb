    <worksheet name='Month RR'>
      <table>
        <view>
          <datasources>
            <datasource caption='marketing__growth_kpi_dashboard_table' name='federated.06li0si10axl3x16edo8t0s49qwo' />
          </datasources>
          <datasource-dependencies datasource='federated.06li0si10axl3x16edo8t0s49qwo'>
            <column caption='&lt;&lt; INCENTIVES &gt;&gt; ' datatype='integer' name='[&lt;&lt; CUSTOMERS &gt;&gt; (copy)_2382896843527163905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='&lt;&lt; HVA &gt;&gt; ' datatype='integer' name='[&lt;&lt; INCENTIVES &gt;&gt;  (copy)_6377800823414820864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='&lt;&lt; CUSTOMERS &gt;&gt;' datatype='integer' name='[&lt;&lt; ORDERS &gt;&gt; (copy)_2111906790595817486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='&lt;&lt; Q-COMM &gt;&gt;' datatype='integer' name='[&lt;&lt; ORDERS &gt;&gt; (copy)_2111906790596149263]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='Active Customer RR (placeholder)' datatype='integer' name='[&lt;&lt; ORDERS &gt;&gt; (copy)_2111906791129624670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='&lt;&lt; NEW METRICS &gt;&gt;' datatype='integer' name='[&lt;&lt; Q-COMM &gt;&gt; (copy)_1275363159405527040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='&lt;&lt; ACQUISITIONS &gt;&gt;' datatype='integer' name='[&lt;&lt; Q-COMM &gt;&gt; (copy)_1578933925940781078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='&lt;&lt; PANDA PRO &gt;&gt;' datatype='integer' name='[&lt;&lt; Q-COMM &gt;&gt; (copy)_2111906790596395024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='NC Voucher Cost RR' datatype='real' name='[Acquisition RR (copy)_2382896843542564901]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([mtd_nc_voucher_cost_eur_daily])/MAX([Calculation_2111906791127609434])) * MAX([Calculation_2111906791128363099])' />
            </column>
            <column caption='Conversion Rate RR' datatype='real' default-format='p0.0%' name='[Active Customer RR (placeholder) (copy)_1578933925662154772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Sessions RR (copy)_2590414232606244900]/[Platform Orders RR (copy)_1578933925661769747]' />
            </column>
            <column caption='L30D Qc Active Users (placeholder)' datatype='integer' name='[Active Customer RR (placeholder) (copy)_1578933926030381086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='Pro L30D Active Customer(placeholder)' datatype='integer' name='[Active Customer RR (placeholder) (copy)_2111906791130923109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='report_date_aligned' datatype='date' name='[Calculation_1285848104949071872]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// adding a 3-day window to match the latest report date for calculation columns&#10;//DATEADD(&apos;day&apos;, 3, [report_date (Custom SQL Query2)])&#10;&#10;// creating a dynamic field to match the latest date in the main table&#10;DATE(&#10;    DATEADD(&#10;        &apos;day&apos;,&#10;        DATEDIFF(&apos;day&apos;, &#10;            { FIXED : MAX([report_date (Custom SQL Query2)]) },&#10;            { FIXED : MAX([report_date]) }&#10;        ),&#10;        [report_date (Custom SQL Query2)]&#10;    )&#10;)' />
            </column>
            <column caption='&lt;&lt; ORDERS &gt;&gt;' datatype='integer' name='[Calculation_2111906790594646028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='Day of report date' datatype='integer' name='[Calculation_2111906791127609434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DAY([report_date])' />
            </column>
            <column caption='Day of eom' datatype='integer' name='[Calculation_2111906791128363099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DAY(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[report_date])))))' />
            </column>
            <column caption='Platform Orders RR' datatype='real' name='[Calculation_2111906791128596572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([mtd_platform_orders_daily])/MAX([Calculation_2111906791127609434])) * MAX([Calculation_2111906791128363099])' />
            </column>
            <column caption='&quot;Full Month RR&quot;' datatype='string' name='[Calculation_2382896843542429732]' role='dimension' type='nominal' user:unnamed='Month RR'>
              <calculation class='tableau' formula='&quot;Full Month RR&quot;' />
            </column>
            <column caption='AFV RR' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2590414232605122595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Platform Orders RR (copy)_2590414232604508194]/[Calculation_2111906791128596572]' />
            </column>
            <column caption='Mau All Reactivations Orders RR' datatype='real' name='[Calculation_4121004807246446633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([mau_all_reactivations_orders_mtd])/MAX([Calculation_2111906791127609434])) * MAX([Calculation_2111906791128363099])' />
            </column>
            <column caption='Fraud Acq Acids RR' datatype='real' name='[Calculation_4121004807255502909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([fraud_acq_acids_daily])/MAX([Calculation_2111906791127609434])) * MAX([Calculation_2111906791128363099])' />
            </column>
            <column caption='Fraud Acquisition % RR' datatype='real' default-format='p0.0%' name='[Calculation_4121004807255961664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4121004807255502909]/[Fraud Acq Acids RR (copy)_4121004807255699519]' />
            </column>
            <column caption='Pro Join Rate RR (placeholder)' datatype='integer' name='[Conversion Rate RR (placeholder) (copy)_264867997568094230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = DATE(01-01-9999) THEN 0 ELSE NULL END' />
            </column>
            <column caption='GMV RR' datatype='real' name='[DH HVA Incentives RR (copy)_45669378950103065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([mtd_total_user_paid_gmv_eur_daily])/MAX([Calculation_2111906791127609434])) * MAX([Calculation_2111906791128363099])' />
            </column>
            <column caption='VF Incentives RR' datatype='real' name='[DH Incentives RR (copy)_2382896843543212071]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([mtd_total_vf_incentives_eur_daily])/MAX([Calculation_2111906791127609434])) * MAX([Calculation_2111906791128363099])' />
            </column>
            <column caption='DH+VF Incentives RR' datatype='real' name='[DH Incentives RR (copy)_45669378949484567]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([DH+VF Incentives Cost L7D (copy)_6377800823418187780])/MAX([Calculation_2111906791127609434])) * MAX([Calculation_2111906791128363099])' />
            </column>
            <column caption='DH+VF Incentives Cost MTD' datatype='real' name='[DH+VF Incentives Cost L7D (copy)_6377800823418187780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[mtd_total_dh_incentives_eur_daily]+[mtd_total_vf_incentives_eur_daily]' />
            </column>
            <column caption='DH+VF as % of GMV RR' datatype='real' default-format='p0.00%' name='[DH+VF Incentives RR (copy)_45669378949763096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[DH Incentives RR (copy)_45669378949484567]/[DH HVA Incentives RR (copy)_45669378950103065]' />
            </column>
            <column caption='DF+SF Eur MTD RR' datatype='real' name='[Df User Paid Eur RR (copy)_1285848105115324529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([total_df_user_paid_eur_mtd])+SUM([total_service_fee_eur_mtd]))&#10;/MAX([Calculation_2111906791127609434])) * MAX([Calculation_2111906791128363099])' />
            </column>
            <column caption='first_time_subscription_activations RR' datatype='real' name='[Downloads RR (copy)_1578933926307651628]' role='measure' type='quantitative'>
