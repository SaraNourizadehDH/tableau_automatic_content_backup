        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0tj3z5y1obxm4u1b1y44v02114n0' name='Custom SQL Query' type='text'><![CDATA[WITH base_data AS (
  SELECT
    o.global_entity_id,
    c.name AS country,
    o.report_date,
    o.analytical_customer_id,
    o.order_uid,
    o.total_user_paid_gmv_eur,
    o.is_acquisition,
    o.is_reacquisition,
    CASE 
      WHEN o.customer_segmentation = 'Churn Risk Reactivation' THEN TRUE
      ELSE FALSE
    END AS is_churn_risk_reactivation
  FROM `fulfillment-dwh-production.pandata_report.marketing__growth_kpi_dashboard_orders_raw` o
  JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` c
    ON o.global_entity_id = c.global_entity_id
  WHERE o.global_entity_id != 'FP_TH'
    AND o.report_date >>= DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH)
),

-- ========== DAILY ========== --
daily AS (
  SELECT
    country,
    report_date AS report_period,
    'daily' AS grain,
    COUNT(DISTINCT order_uid) AS orders,
    COUNT(DISTINCT analytical_customer_id) AS active_users,
    COUNT(DISTINCT IF(is_acquisition, analytical_customer_id, NULL)) AS acquisition_users,
    COUNT(DISTINCT IF(is_reacquisition, analytical_customer_id, NULL)) AS reacquisition_users,
    COUNT(DISTINCT IF(is_churn_risk_reactivation, analytical_customer_id, NULL)) AS churn_risk_reactivation_users,
    SUM(total_user_paid_gmv_eur) AS gmv,
    SUM(IF(is_acquisition, total_user_paid_gmv_eur, 0)) AS acquisition_gmv
  FROM base_data
  GROUP BY 1, 2
),

-- ========== WEEKLY ========== --
weekly AS (
  SELECT
    country,
    DATE_TRUNC(report_date, WEEK(MONDAY)) AS report_period,
    'weekly' AS grain,
    COUNT(DISTINCT order_uid) AS orders,
    COUNT(DISTINCT analytical_customer_id) AS active_users,
    COUNT(DISTINCT IF(is_acquisition, analytical_customer_id, NULL)) AS acquisition_users,
    COUNT(DISTINCT IF(is_reacquisition, analytical_customer_id, NULL)) AS reacquisition_users,
    COUNT(DISTINCT IF(is_churn_risk_reactivation, analytical_customer_id, NULL)) AS churn_risk_reactivation_users,
    SUM(total_user_paid_gmv_eur) AS gmv,
    SUM(IF(is_acquisition, total_user_paid_gmv_eur, 0)) AS acquisition_gmv
  FROM base_data
  GROUP BY 1, 2
),

-- ========== MTD ========== --
mtd AS (
  SELECT
    country,
    DATE_TRUNC(report_date, MONTH) AS report_period,
    'mtd' AS grain,
    COUNT(DISTINCT order_uid) AS orders,
    COUNT(DISTINCT analytical_customer_id) AS active_users,
    COUNT(DISTINCT IF(is_acquisition, analytical_customer_id, NULL)) AS acquisition_users,
    COUNT(DISTINCT IF(is_reacquisition, analytical_customer_id, NULL)) AS reacquisition_users,
    COUNT(DISTINCT IF(is_churn_risk_reactivation, analytical_customer_id, NULL)) AS churn_risk_reactivation_users,
    SUM(total_user_paid_gmv_eur) AS gmv,
    SUM(IF(is_acquisition, total_user_paid_gmv_eur, 0)) AS acquisition_gmv,
    -- EXTRACT(DAY FROM DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)) AS days_covered_in_month
  FROM base_data
  WHERE report_date <<= DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
    AND report_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY), MONTH)
  GROUP BY 1, 2
),

-- ========== MONTHLY ========== --
monthly AS (
  SELECT
    country,
    DATE_TRUNC(report_date, MONTH) AS report_period,
    'monthly' AS grain,
    COUNT(DISTINCT order_uid) AS orders,
    COUNT(DISTINCT analytical_customer_id) AS active_users,
    COUNT(DISTINCT IF(is_acquisition, analytical_customer_id, NULL)) AS acquisition_users,
    COUNT(DISTINCT IF(is_reacquisition, analytical_customer_id, NULL)) AS reacquisition_users,
    COUNT(DISTINCT IF(is_churn_risk_reactivation, analytical_customer_id, NULL)) AS churn_risk_reactivation_users,
    SUM(total_user_paid_gmv_eur) AS gmv,
    SUM(IF(is_acquisition, total_user_paid_gmv_eur, 0)) AS acquisition_gmv
  FROM base_data
  GROUP BY 1, 2
),

-- ========== UNION ALL GRAINS ========== --
union_all_grains AS (
  SELECT * FROM daily
  UNION ALL
  SELECT * FROM weekly
  UNION ALL
  SELECT * FROM mtd
  UNION ALL
  SELECT * FROM monthly
),

-- ========== UNPIVOT FOR TABLEAU ========== --
final AS (
  SELECT
    country,
    grain,
    report_period,
    'orders' AS metric_name,
    orders AS metric_value
  FROM union_all_grains
  UNION ALL
  SELECT country, grain, report_period, 'active_users', active_users FROM union_all_grains
  UNION ALL
  SELECT country, grain, report_period, 'acquisition_users', acquisition_users FROM union_all_grains
  UNION ALL
  SELECT country, grain, report_period, 'reacquisition_users', reacquisition_users FROM union_all_grains
  UNION ALL
  SELECT country, grain, report_period, 'churn_risk_reactivation_users', churn_risk_reactivation_users FROM union_all_grains
  UNION ALL
  SELECT country, grain, report_period, 'gmv', gmv FROM union_all_grains
  UNION ALL
  SELECT country, grain, report_period, 'acquisition_gmv', acquisition_gmv FROM union_all_grains
)

SELECT * FROM final]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0tj3z5y1obxm4u1b1y44v02114n0' name='Custom SQL Query' type='text'><![CDATA[WITH base_data AS (
