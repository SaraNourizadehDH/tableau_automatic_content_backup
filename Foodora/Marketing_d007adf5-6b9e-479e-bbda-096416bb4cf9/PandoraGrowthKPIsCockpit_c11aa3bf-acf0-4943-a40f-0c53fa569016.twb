    COUNT(DISTINCT order_uid) AS orders,
    COUNT(DISTINCT analytical_customer_id) AS active_users,
    COUNT(DISTINCT IF(is_acquisition, analytical_customer_id, NULL)) AS acquisition_users,
    COUNT(DISTINCT IF(is_reacquisition, analytical_customer_id, NULL)) AS reacquisition_users,
    COUNT(DISTINCT IF(is_churn_risk_reactivation, analytical_customer_id, NULL)) AS churn_risk_reactivation_users,
    SUM(total_user_paid_gmv_eur) AS gmv,
    SUM(IF(is_acquisition, total_user_paid_gmv_eur, 0)) AS acquisition_gmv
  FROM base_orders
  GROUP BY ALL
),

mtd_data AS (
  SELECT
    'mtd' AS date_grain,
    DATE_TRUNC(o.report_date, MONTH) AS report_date,
    p.days_covered_in_month AS days_in_month,
    o.global_entity_id,
    o.country,
    COUNT(DISTINCT o.order_uid) AS orders,
    COUNT(DISTINCT o.analytical_customer_id) AS active_users,
    COUNT(DISTINCT IF(o.is_acquisition, o.analytical_customer_id, NULL)) AS acquisition_users,
    COUNT(DISTINCT IF(o.is_reacquisition, o.analytical_customer_id, NULL)) AS reacquisition_users,
    COUNT(DISTINCT IF(o.is_churn_risk_reactivation, o.analytical_customer_id, NULL)) AS churn_risk_reactivation_users,
    SUM(o.total_user_paid_gmv_eur) AS gmv,
    SUM(IF(o.is_acquisition, o.total_user_paid_gmv_eur, 0)) AS acquisition_gmv
  FROM base_orders o
  JOIN params p ON TRUE
  WHERE EXTRACT(DAY FROM o.report_date) <<= EXTRACT(DAY FROM DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY))
  GROUP BY ALL
)

SELECT * FROM monthly_data
UNION ALL
SELECT * FROM weekly_data
UNION ALL
SELECT * FROM mtd_data]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
