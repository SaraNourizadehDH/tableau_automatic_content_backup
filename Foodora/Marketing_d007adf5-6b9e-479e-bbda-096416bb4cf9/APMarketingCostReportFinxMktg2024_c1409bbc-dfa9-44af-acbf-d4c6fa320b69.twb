    <worksheet name='Discount (Finance)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#cb0051'>Discount Cost Report (GL Account Level)</run>
            <run bold='true' fontcolor='#666666'>Æ </run>
            <run fontcolor='#cb0051' fontsize='11'>| Countries:</run>
            <run fontcolor='#000000' fontsize='11' underline='true'><![CDATA[<[federated.05sf7xp1bf10ys1dv5wjc1wcsp3q].[country]>]]></run>
            <run fontsize='11'>Æ </run>
            <run fontcolor='#cb0051' fontsize='11'>| Month: </run>
            <run fontcolor='#000000' fontsize='11' underline='true'><![CDATA[<[federated.05sf7xp1bf10ys1dv5wjc1wcsp3q].[my:Month:ok]>]]></run>
            <run fontcolor='#000000' fontsize='11'>Æ </run>
            <run fontcolor='#cb0051' fontsize='11'>| Source: </run>
            <run fontcolor='#1b1b1b' fontsize='11' underline='true'><![CDATA[<[federated.05sf7xp1bf10ys1dv5wjc1wcsp3q].[none:cost_source:nk]>]]></run>
            <run fontcolor='#1b1b1b' fontsize='11'>Æ </run>
            <run fontcolor='#cb0051' fontsize='11'>| Vat: </run>
            <run fontcolor='#000000' fontsize='11' underline='true'>&lt;[Parameters].[Parameter 5]&gt;</run>
            <run fontcolor='#000000' fontsize='11'>Æ </run>
            <run fontcolor='#cb0051' fontsize='11'>| Currency: </run>
            <run fontcolor='#000000' fontsize='11' underline='true'>&lt;[Parameters].[Parameter 1]&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Cost Overall' name='federated.05sf7xp1bf10ys1dv5wjc1wcsp3q' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
            <column alias='vat_included' caption='VAT' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;vat_included&quot;'>
              <calculation class='tableau' formula='&quot;vat_included&quot;' />
              <aliases>
                <alias key='&quot;vat_included&quot;' value='vat_included' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05sf7xp1bf10ys1dv5wjc1wcsp3q'>
            <column caption='CARC' datatype='real' name='[Calculation_3457849764102094854]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE TRUE&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;    THEN [carc_plus_vat_eur]&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;    THEN [carc_eur]&#10;&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;     THEN [carc_plus_vat_local]&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;     THEN [carc_local]&#10;END' />
            </column>
            <column caption='Revenue Reduction' datatype='real' name='[Calculation_3457849764102258695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE TRUE&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;    THEN [revenue_reduction_plus_vat_eur]&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;    THEN [revenue_reduction_eur]&#10;&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;     THEN [revenue_reduction_plus_vat_local]&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;     THEN [revenue_reduction_local]&#10;END' />
            </column>
            <column caption='Del. Non Personnel Cost' datatype='real' name='[Calculation_3457849764102320136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE TRUE&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;    THEN [del_non_personnel_cost_plus_vat_eur]&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;    THEN [del_non_personnel_cost_eur]&#10;&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;     THEN [del_non_personnel_cost_plus_vat_local]&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;     THEN [del_non_personnel_cost_local]&#10;END' />
            </column>
            <column caption='GL Account' datatype='string' name='[Calculation_4192710561699475457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Month]&lt;=DATE(&quot;2024-12-31&quot;)&#10;then [gl_code] + &quot; &quot; + [gl_acc_name]&#10;else [gl_code] end' />
            </column>
            <column caption='SAP GL Account' datatype='string' name='[Calculation_5789025525321592935]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4192710561699475457] = &apos;P70020 - Delivery Service - end customer fees (PF_KIT)&apos; and [cost_source] = &quot;Discounts&quot; THEN &apos;70020200 Delivery Service - end customer fees - Kitchens and Concept&apos;&#10;ELSEIF [Calculation_4192710561699475457] = &apos;P70020 - Delivery Service - end customer fees (PF_QCD)&apos; and [cost_source] = &quot;Discounts&quot; THEN &apos;70020300 Delivery Services - Dark Store&apos;&#10;ELSEIF [Calculation_4192710561699475457] = &apos;P70020 - Delivery Service - end customer fees (PF_QCL)&apos; and [cost_source] = &quot;Discounts&quot;  THEN &apos;70020400 Delivery service - Groceries&apos;&#10;ELSEIF [Calculation_4192710561699475457] = &apos;P70020 - Delivery Service - end customer fees&apos; and [cost_source] = &quot;Discounts&quot;  THEN &apos;70020000 Delivery Service - end customer fees&apos;&#10;ELSEIF [Calculation_4192710561699475457] = &apos;P61347 - Subscriptions Specific Incentives&apos; and [cost_source] = &quot;Discounts&quot; THEN &apos;61380500 Subscription Specific Incentives&apos;&#10;ELSEIF [Calculation_4192710561699475457] = &apos;P70012 - Commission revenues - user subsidies and incentives&apos; and [cost_source] = &quot;Discounts&quot; THEN &apos;70012100 User sub pick up inc&apos;&#10;ELSEIF [Calculation_4192710561699475457] = &apos;P70580 - Other revenues - reductions&apos; and [cost_source] = &quot;Discounts&quot; THEN &apos;70901800 Online Food Ordering - Other reduction of revenue&apos;&#10;ELSEIF [Calculation_4192710561699475457] = &apos;P61314 - DH funded Discounts - Acquisition&apos; and [cost_source] = &quot;Discounts&quot; THEN &apos;61341500 DH funded Discounts - Acquisition&apos;&#10;ELSEIF [Calculation_4192710561699475457] = &apos;P61344 - DH funded Discounts - Retention&apos; and [cost_source] = &quot;Discounts&quot; THEN &apos;61341300 DH funded Discounts - Retention&apos;&#10;&#10;ELSEIF [Calculation_4192710561699475457