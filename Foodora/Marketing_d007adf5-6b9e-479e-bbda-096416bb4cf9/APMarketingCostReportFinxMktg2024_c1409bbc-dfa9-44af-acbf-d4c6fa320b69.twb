      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APMarketingCostReportFinxMktg2024/ReleaseNotes?rev=' id='ReleaseNotes' path='/t/Foodora/workbooks/APMarketingCostReportFinxMktg2024' revision='' site='Foodora' />
      <style />
      <size maxheight='700' maxwidth='1250' minheight='700' minwidth='1250' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='8' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97714' id='7' is-centered='0' is-scaled='1' param='Image/release notes page.png' type-v2='bitmap' w='98720' x='640' y='1143'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
