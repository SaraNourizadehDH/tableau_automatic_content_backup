    <worksheet name='CT vs Actuals (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#cd0051' fontname='Tableau Bold'>QT vs Actuals</run>
            <run>Æ </run>
            <run bold='true' fontcolor='#cd0051'>|</run>
            <run bold='true' fontcolor='#555555' fontsize='12'><![CDATA[ <[federated.0crg0fr1vae3qu13mstuo1h5auf1].[none:country:nk]>]]></run>
            <run bold='true' fontcolor='#555555' fontsize='11'>Æ </run>
            <run bold='true' fontcolor='#cd0051'>| </run>
            <run bold='true' fontcolor='#cd0051' fontsize='12'><![CDATA[<[federated.0crg0fr1vae3qu13mstuo1h5auf1].[none:sub_channel:nk]>]]></run>
            <run bold='true' fontcolor='#555555' fontsize='12'>, </run>
            <run bold='true' fontcolor='#cf0051' fontsize='12'><![CDATA[ <[federated.0crg0fr1vae3qu13mstuo1h5auf1].[none:month:ok]> ]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Overall Budget vs Costs (monthly)' name='federated.0crg0fr1vae3qu13mstuo1h5auf1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Overall Currency' datatype='string' name='[Currency 4 (copy)_3232669771013398529]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0crg0fr1vae3qu13mstuo1h5auf1'>
            <column caption='Budget Toggle' datatype='real' name='[Calculation_1620029292626370563 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Currency 4 (copy)_3232669771013398529]&#10;WHEN &apos;EUR&apos; THEN IFNULL([budget_eur],0)&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Actuals vs QT' datatype='real' name='[Calculation_1620029292627349508 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3232669771013201920]) - ABS(SUM([best_estimate (copy)_1405193487126290434]))' />
            </column>
            <column caption='% QT Spent' datatype='real' default-format='p0.0%' name='[Calculation_1620029292629532678]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Calculation_3232669771013201920])/ABS(SUM([best_estimate (copy)_1405193487126290434])))' />
            </column>
            <column caption='Runrate' datatype='real' name='[Calculation_1620029292629925895]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Currency 4 (copy)_3232669771013398529]&#10;WHEN &apos;EUR&apos; THEN [runrate_fp_eur]&#10;ELSE IFNULL([runrate_fp_lc],0)&#10;END' />
            </column>
            <column caption='QT version' datatype='string' name='[Calculation_2150961458777194496]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REGEXP_EXTRACT([qt_version], &apos;(APAC country targets)+&apos;) + &apos; &apos; &#10;+ LEFT(DATENAME(&apos;month&apos;, [month]), 3) + &apos;-&apos; + STR(YEAR([month]))' />
            </column>
            <column caption='Null_2023_Actuals' datatype='real' name='[Calculation_2150961458786988033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([month]) &lt; 2024 THEN 0 ELSE [Calculation_3232669771013201920] END' />
            </column>
            <column caption='ABS(quarterly_target)' datatype='real' name='[Calculation_3049781407991599104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS([best_estimate (copy)_1405193487126290434])' />
            </column>
            <column caption='Actuals Toggle' datatype='real' name='[Calculation_3232669771013201920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Currency 4 (copy)_3232669771013398529]&#10;WHEN &apos;EUR&apos; THEN [costs_fp_eur]&#10;WHEN &apos;LC&apos; THEN [costs_fp_lc]&#10;END' />
            </column>
            <column caption='RR vs CT' datatype='real' name='[Calculation_4417468290163068932]' role='measure' type='quantitative'>
