      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Overall Currency' datatype='string' name='[Currency 4 (copy)_3232669771013398529]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
          <calculation class='tableau' formula='&quot;EUR&quot;' />
        </column>
        <column caption='View' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Finance&quot;'>
          <calculation class='tableau' formula='&quot;Finance&quot;' />
        </column>
        <column caption='Expand Cost Types' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;No&quot;'>
          <calculation class='tableau' formula='&quot;No&quot;' />
        </column>
        <column alias='BR' caption='Budget Type' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;BR&quot;'>
          <calculation class='tableau' formula='&quot;BR&quot;' />
          <aliases>
            <alias key='&quot;BE&quot;' value='BE' />
            <alias key='&quot;BR&quot;' value='BR' />
            <alias key='&quot;QT&quot;' value='QT' />
          </aliases>
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_CB63B68E796A491EABB61B9704D60FF8'>
            <properties context=''>
              <relation connection='bigquery.1557fkq1er61ea1gi41s1144ak3p' name='Custom SQL Query' type='text'>------ Updated 22 Jan 2025

WITH cost_raw AS (
  SELECT

      mkt.global_entity_id,
      countries.name AS country,
      mkt.month AS created_month_local,
      mkt.cost_type,
      mkt.marketing_share,
      CASE WHEN mkt.budget_channel IN (&quot;Other Incentives&quot;, &quot;Other Vouchers&quot;, &quot;Cashback&quot;) THEN &quot;Incentives&quot;
      ELSE mapping.sub_channel END AS sub_channel,
      mkt.campaign,
      IF(mkt.budget_channel = &quot;CX Vouchers&quot;, 0, mkt.costs_fp_eur) AS costs_fp_eur,
      mkt.costs_fp_nc_eur,
      mkt.costs_vendor_eur,
      IF(mkt.budget_channel = &quot;CX Vouchers&quot;, 0, mkt.runrate_fp_eur) AS runrate_fp_eur,
      mkt.runrate_vendor_eur,
      IF(mkt.budget_channel = &quot;CX Vouchers&quot;, 0, mkt.costs_fp_lc) AS costs_fp_lc,
      mkt.costs_vendor_lc,
      IF(mkt.budget_channel = &quot;CX Vouchers&quot;, 0, mkt.runrate_fp_lc) AS runrate_fp_lc,
      mkt.runrate_vendor_lc,
      mkt.orders AS order_count,
      mkt.acquisitions,
      mkt.ticket,
      mkt.start_date,
      mkt.end_date,
      mkt.costs_ticket_eur,
      mkt.costs_ticket_lc,
      mkt.costs_accumulated_eur,
      mkt.costs_accumulated_lc,
      mkt.costs_remaining_eur,
      mkt.costs_remaining_lc,
      mkt.cost_source,
      mkt.original_bc,
      mkt.budget_channel,
      mkt.vertical_per_redemption,
      mkt.vertical AS vertical_per_budget, 
      mkt.vertical_per_origin,
      &quot;Marketing&quot; AS table_source
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_cost_report_tableau_reporting` AS mkt
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS countries
        ON mkt.global_entity_id = countries.global_entity_id
        AND countries.region = &quot;Asia&quot;
        AND countries.company_name = &quot;Foodpanda&quot;
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_budget_channel_aggregation` AS mapping
         ON mkt.budget_channel = mapping.budget_channel_new
         AND mapping.budget_channel IS NOT NULL
         AND mapping.year = 2024
  WHERE mkt.month &gt;&gt;= &quot;2025-01-01&quot;
    AND mkt.budget_channel NOT IN (&quot;Employee benefit / internal&quot;, &quot;Rider Vouchers&quot;)
),

cost_with_rr AS (
  SELECT
      global_entity_id,
      country,
      created_month_local,
      sub_channel,
      campaign,
      COALESCE(costs_fp_eur * marketing_share, 0) AS costs_fp_eur,
      costs_fp_nc_eur,
      costs_vendor_eur,
      COALESCE(runrate_fp_eur * marketing_share, 0) AS runrate_fp_eur,
      runrate_vendor_eur,
      COALESCE(costs_fp_lc * marketing_share, 0) AS costs_fp_lc,
      costs_vendor_lc,
      COALESCE(runrate_fp_lc * marketing_share, 0) AS runrate_fp_lc,
      runrate_vendor_lc,
      order_count,
      acquisitions,
      ticket,
      start_date,
      end_date,
      costs_ticket_eur,
      costs_ticket_lc,
      costs_accumulated_eur,
      costs_accumulated_lc,
      costs_remaining_eur,
      costs_remaining_lc,
      cost_source,
      original_bc,
      budget_channel,
      vertical_per_redemption,
      vertical_per_budget,
      vertical_per_origin,
      table_source
  FROM cost_raw
),

---- 2025 BR ONLY
br_2025_raw AS (
  SELECT
    country,
    month,
    &quot;budget_round&quot; AS record_type,
     report_type AS br_version,
     CAST(NULL AS STRING) AS be_version,
     CAST(NULL AS STRING) AS qt_version,
     &quot;Food&quot; AS vertical,
     --- ToM
     flyer_costs_P61378, -----Flyers
     influencers_marketing_P61377, ----Influencers
     out_of_home_outdoor_P61373, ----OOH
     online_branding_P61382, ----Online Branding
     rider_equipment__advertising_P61370, ----Rider Branding
     public_relation_P61380, ---PR
     radio_p61372, ---Radio
     vendor_branding_P61381, ---Vendor Branding
     vendor_packaging_P61383, ---Vendor Packaging
     sem_brand_P61374, -----SEM Brand
     social_media_engagement_P61375, ----Social Engagement (SoMe)
     tv_advertising_cost_P61371, -----TV - media
     other_campaign_costs_P61388, ---Events and activations
    ----- Other Marketing Cost
    creative_production_P61360, ----Creative production
    sponsorship_P61362, ------Sponsorships
    other_marketing_P61368, ---- other marketing costs
    ----- Performance Marketing
    app_rmo_P61330, ----PM for retention
    affiliate_marketing_P61300, ----PM for acquisition
    ------ Incentives: Acquisition
    crm_activities_P61310, ----CRM RMA – Vouchers
    other__wom_rebates_and_discounts_voucher_cost_P61312, ----Refer a Friend
    dh_funded_discounts__acquisition_P61314,-----DH funded Discounts – Acquisition
    vouchers_generic__acquisition_P61316, -----Vouchers Generic – Acquisition
    ------ Incentives: Retention
    crm_rebates_and_discounts_P61340, -----CRM RMO - Vouchers
    dh_funded_discounts__retention_P61344,-----DH funded Discounts – Retention
    voucher_generic__retention_P61342,-----Vouchers Generic – Retention
    subscriptions_specific_incentives_P61347, -----Subscription Specific Incentives
    revenue_subscription_vendor_subsidy__incentives_P61348 -----Revenue Subscription Vendor Subsidy - Incentives
  FROM `dhh---analytics-eu.fd_finance.pandora_finance_onestream_mkt_cost_act23_act24_bu25`
  WHERE report_type = &quot;BUDGET2025&quot;
    AND currency = &quot;EUR&quot;
    AND country IN (&quot; DH APAC&quot;,&quot;Laos&quot;, &quot;Taiwan&quot;, &quot;Myanmar&quot;, &quot;Cambodia&quot;, &quot;Malaysia&quot;, &quot;Pakistan&quot;, &quot;Thailand&quot;, &quot;Hong Kong	&quot;, &quot;Singapore&quot;, &quot;Bangladesh&quot;, &quot;Philippines&quot;)
),

br_2025_pivot AS (
  SELECT
    *
  FROM br_2025_raw
  UNPIVOT(
    value FOR budget_channel IN (
      --- ToM
     flyer_costs_P61378, -----Flyers
     influencers_marketing_P61377, ----Influencers
     out_of_home_outdoor_P61373, ----OOH
     online_branding_P61382, ----Online Branding
     rider_equipment__advertising_P61370, ----Rider Branding
     public_relation_P61380, ---PR
     radio_p61372, ---Radio
     vendor_branding_P61381, ---Vendor Branding
     vendor_packaging_P61383, ---Vendor Packaging
     sem_brand_P61374, -----SEM Brand
     social_media_engagement_P61375, ----Social Engagement (SoMe)
     tv_advertising_cost_P61371, -----TV - media
     other_campaign_costs_P61388, ---Events and activations
    ----- Other Marketing Cost
    creative_production_P61360, ----Creative production
    sponsorship_P61362, ------Sponsorships
    other_marketing_P61368, ---- other marketing costs
    ----- Performance Marketing
    app_rmo_P61330, ----PM for retention
    affiliate_marketing_P61300, ----PM for acquisition
    ------ Incentives: Acquisition
    crm_activities_P61310, ----CRM RMA – Vouchers
    other__wom_rebates_and_discounts_voucher_cost_P61312, ----Refer a Friend
    dh_funded_discounts__acquisition_P61314,-----DH funded Discounts – Acquisition
    vouchers_generic__acquisition_P61316, -----Vouchers Generic – Acquisition
    ------ Incentives: Retention
    crm_rebates_and_discounts_P61340, -----CRM RMO - Vouchers
    dh_funded_discounts__retention_P61344,-----DH funded Discounts – Retention
    voucher_generic__retention_P61342,-----Vouchers Generic – Retention
    subscriptions_specific_incentives_P61347, -----Subscription Specific Incentives
    revenue_subscription_vendor_subsidy__incentives_P61348 -----Revenue Subscription Vendor Subsidy - Incentives
    )
  )
),

br_2025_final AS (
  SELECT
    country,
    month,
    record_type,
    br_version,
    be_version,
    qt_version,
    vertical,
    CASE WHEN budget_channel IN (
               &quot;flyer_costs_P61378&quot;, -----Flyers
               &quot;influencers_marketing_P61377&quot;, ----Influencers
               &quot;out_of_home_outdoor_P61373&quot;, ----OOH
               &quot;online_branding_P61382&quot;, ----Online Branding
               &quot;rider_equipment__advertising_P61370&quot;, ----Rider Branding
               &quot;public_relation_P61380&quot;, ---PR
               &quot;radio_p61372&quot;, ---Radio
               &quot;vendor_branding_P61381&quot;, ---Vendor Branding
               &quot;vendor_packaging_P61383&quot;, ---Vendor Packaging
               &quot;sem_brand_P61374&quot;, -----SEM Brand
               &quot;social_media_engagement_P61375&quot;, ----Social Engagement (SoMe)
               &quot;tv_advertising_cost_P61371&quot;, -----TV - media
               &quot;other_campaign_costs_P61388&quot;) THEN &quot;ToM&quot;
        WHEN budget_channel = &quot;affiliate_marketing_P61300&quot; THEN &quot;PM - Acquisition&quot;
        WHEN budget_channel = &quot;app_rmo_P61330&quot; THEN &quot;PM - Retention&quot;
        WHEN budget_channel IN (
              &quot;creative_production_P61360&quot;, ----Creative production
              &quot;sponsorship_P61362&quot;, ------Sponsorships
              &quot;other_marketing_P61368&quot;) THEN &quot;Other Marketing Cost&quot;
        WHEN budget_channel IN (
              &quot;crm_activities_P61310&quot;, ----CRM RMA – Vouchers
              &quot;other__wom_rebates_and_discounts_voucher_cost_P61312&quot;, ----Refer a Friend
              &quot;dh_funded_discounts__acquisition_P61314&quot;,-----DH funded Discounts – Acquisition
              &quot;vouchers_generic__acquisition_P61316&quot;) THEN &quot;Incentives - Acquisition&quot;
        WHEN budget_channel IN (
              &quot;crm_rebates_and_discounts_P61340&quot;, -----CRM RMO - Vouchers
              &quot;dh_funded_discounts__retention_P61344&quot;,-----DH funded Discounts – Retention
              &quot;voucher_generic__retention_P61342&quot;,-----Vouchers Generic – Retention
              &quot;subscriptions_specific_incentives_P61347&quot;, -----Subscription Specific Incentives
              &quot;revenue_subscription_vendor_subsidy__incentives_P61348&quot;) THEN &quot;Incentives - Retention&quot;
    END AS sub_channel,
    SUM(ABS(value)) AS budget_eur
  FROM br_2025_pivot
  GROUP BY ALL
),

budget_final AS (
  SELECT
    country,
    month,
    record_type,
    br_version,
    be_version,
    qt_version,
    FALSE AS is_dmart,
    CASE WHEN sub_channel = &quot;ToM&quot; THEN &quot;Top of Mind (ToM)&quot;
         WHEN sub_channel IN (&quot;PM - Acquisition&quot;, &quot;PM - Retention&quot;) THEN &quot;Performance Marketing&quot;
         WHEN sub_channel = &quot;Other Marketing Cost&quot; THEN &quot;Other Marketing Cost&quot;
         WHEN sub_channel IN (&quot;Incentives - Acquisition&quot;, &quot;Incentives - Retention&quot;) THEN &quot;Incentives&quot;
    END AS report_aggregation,
    sub_channel,
    budget_eur 
  FROM br_2025_final
),

cost_monthly_2025 AS (
  SELECT
    country,
    created_month_local AS month,
    FALSE AS is_dmart,
    table_source,
    CASE WHEN budget_channel IN (&quot;Refer A Friend&quot;, &quot;NC Campaign&quot;, &quot;CRM Prospect&quot;, &quot;Activations / Flyers Vouchers&quot;) THEN &quot;Incentives - Acquisition&quot;
         WHEN sub_channel = &quot;Incentives&quot; AND budget_channel NOT IN (&quot;Refer A Friend&quot;, &quot;NC Campaign&quot;, &quot;CRM Prospect&quot;, &quot;Activations / Flyers Vouchers&quot;) THEN &quot;Incentives - Retention&quot;
         WHEN budget_channel IN (&quot;Regional Creative Production&quot;, &quot;Local Creative Production&quot;, &quot;Regional Sponsorships&quot;, &quot;Local Sponsorships&quot;, &quot;Corporate Leads Acquisition&quot;) THEN &quot;Other Marketing Cost&quot;
         WHEN sub_channel = &quot;RMA&quot; THEN &quot;PM - Retention&quot;
         WHEN sub_channel = &quot;RMO&quot; THEN &quot;PM - Acquisition&quot;
         WHEN sub_channel IN (&quot;ATL&quot;, &quot;BTL&quot;, &quot;Productions&quot;, &quot;Partnerships&quot;) THEN &quot;ToM&quot;
         ELSE sub_channel 
    END AS sub_channel,
    SUM(costs_fp_eur) AS  costs_fp_eur,
    SUM(costs_fp_lc) AS costs_fp_lc,
    SUM(runrate_fp_eur) AS runrate_fp_eur,
    SUM(runrate_fp_lc) AS runrate_fp_lc,
    SUM(acquisitions) AS acquisitions,
    SUM(order_count) AS order_count
  FROM cost_with_rr
  WHERE LOWER(vertical_per_redemption) != &quot;dmart&quot;
    AND created_month_local &gt;&gt;= &quot;2025-01-01&quot;
  GROUP BY ALL

  UNION ALL

  SELECT
    country,
    created_month_local AS month,
    TRUE AS is_dmart,
    table_source,
     CASE WHEN budget_channel IN (&quot;Refer A Friend&quot;, &quot;NC Campaign&quot;, &quot;CRM Prospect&quot;, &quot;Activations / Flyers Vouchers&quot;) THEN &quot;Incentives - Acquisition&quot;
         WHEN sub_channel = &quot;Incentives&quot; AND budget_channel NOT IN (&quot;Refer A Friend&quot;, &quot;NC Campaign&quot;, &quot;CRM Prospect&quot;, &quot;Activations / Flyers Vouchers&quot;) THEN &quot;Incentives - Retention&quot;
         WHEN budget_channel IN (&quot;Regional Creative Production&quot;, &quot;Local Creative Production&quot;, &quot;Regional Sponsorships&quot;, &quot;Local Sponsorships&quot;, &quot;Corporate Leads Acquisition&quot;) THEN &quot;Other Marketing Cost&quot;
         WHEN sub_channel = &quot;RMA&quot; THEN &quot;PM - Retention&quot;
         WHEN sub_channel = &quot;RMO&quot; THEN &quot;PM - Acquisition&quot;
         WHEN sub_channel IN (&quot;ATL&quot;, &quot;BTL&quot;, &quot;Productions&quot;, &quot;Partnerships&quot;) THEN &quot;ToM&quot;
         ELSE sub_channel 
    END AS sub_channel,
    SUM(costs_fp_eur) AS  costs_fp_eur,
    SUM(costs_fp_lc) AS costs_fp_lc,
    SUM(runrate_fp_eur) AS runrate_fp_eur,
    SUM(runrate_fp_lc) AS runrate_fp_lc,
    SUM(acquisitions) AS acquisitions,
    SUM(order_count) AS order_count
  FROM cost_with_rr
  WHERE LOWER(vertical_per_redemption) = &quot;dmart&quot;
    AND created_month_local &gt;&gt;= &quot;2025-01-01&quot;
  GROUP BY ALL
),

cost_final AS (
  SELECT
    country,
    month,
    is_dmart,
    table_source,
    CASE WHEN sub_channel = &quot;ToM&quot; THEN &quot;Top of Mind (ToM)&quot;
         WHEN sub_channel IN (&quot;PM - Acquisition&quot;, &quot;PM - Retention&quot;) THEN &quot;Performance Marketing&quot;
         WHEN sub_channel = &quot;Other Marketing Cost&quot; THEN &quot;Other Marketing Cost&quot;
         WHEN sub_channel IN (&quot;Incentives - Acquisition&quot;, &quot;Incentives - Retention&quot;) THEN &quot;Incentives&quot;
    END AS report_aggregation,
    sub_channel,
    SUM(costs_fp_eur) AS costs_fp_eur,
    SUM(costs_fp_lc) AS costs_fp_lc,
    SUM(runrate_fp_eur) AS runrate_fp_eur,
    SUM(runrate_fp_lc) AS runrate_fp_lc,
    SUM(acquisitions) AS acquisitions,
    SUM(order_count) AS order_count
  FROM cost_monthly_2025
  GROUP BY ALL
),

mic_monthly AS (
   SELECT
    country,
    partition_month_local AS month,
    FALSE AS is_dmart,
    &quot;Incentives&quot; AS report_aggregation,
    CASE WHEN voucher_budget_channel IN (&quot;Refer A Friend&quot;, &quot;NC Campaign&quot;, &quot;CRM Prospect&quot;, &quot;Activations / Flyers Vouchers&quot;)
           OR discount_budget_channel IN (&quot;NC Campaign&quot;) THEN &quot;Incentives - Acquisition&quot;
         WHEN voucher_budget_channel = &quot;Product HVA Voucher&quot; AND purpose = &quot;acquisition&quot; THEN &quot;Incentives - Acquisition&quot;
         WHEN (voucher_budget_channel IS NOT NULL OR discount_budget_channel IS NOT NULL) AND is_acquisition THEN &quot;Incentives - Acquisition&quot;
         WHEN voucher_budget_channel NOT IN (&quot;Employee benefit / internal&quot;, &quot;Rider Vouchers&quot;, &quot;Refer A Friend&quot;, &quot;NC Campaign&quot;, &quot;CRM Prospect&quot;, &quot;Activations / Flyers Vouchers&quot;)
           OR discount_budget_channel NOT IN (&quot;NC Campaign&quot;)
         THEN &quot;Incentives - Retention&quot;
         WHEN (voucher_budget_channel IS NOT NULL OR discount_budget_channel IS NOT NULL) AND NOT is_acquisition THEN &quot;Incentives - Retention&quot; 
    END AS sub_channel,
    SUM(gmv_eur) AS gmv_eur,
    SUM(gmv_net_eur) AS gmv_net_eur,
    SUM(gmv_local) AS gmv_local,
    SUM(incentive_cost_fp_marketing_eur) AS incentive_cost_fp_marketing_eur,
    SUM(incentive_cost_fp_marketing_local) AS incentive_cost_fp_marketing_local
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_incentive_cost`
  WHERE partition_month &gt;&gt;= &quot;2024-12-01&quot;
    AND partition_month_local &gt;&gt;= &quot;2025-01-01&quot;
    AND is_billable
    AND LOWER(vertical_per_redemption) != &quot;dmart&quot;
    AND incentive_cost_fp_marketing_local &gt;&gt; 0
  GROUP BY ALL
),

cost_vs_budget_2025 AS (
  SELECT
    budget.country,
    COALESCE(budget.month, cost.month) AS month,
    COALESCE(budget.report_aggregation, cost.report_aggregation) AS report_aggregation,
    COALESCE(budget.sub_channel, cost.sub_channel) AS sub_channel,
    CASE WHEN budget.record_type IS NOT NULL THEN &quot;Lucanet&quot;
         ELSE cost.table_source END AS table_source,
    budget.record_type,
    budget.br_version,
    budget.qt_version,
    budget.be_version,
    budget_eur,
    budget.is_dmart,
    cost.costs_fp_eur,
    cost.costs_fp_lc,
    cost.runrate_fp_eur,
    cost.runrate_fp_lc,
    cost.acquisitions,
    cost.order_count,
    mic.gmv_eur,
    mic.gmv_net_eur,
    NULL AS gmv_net_target_eur,
    mic.gmv_local,
    NULL AS gmv_net_target_local,
    mic.incentive_cost_fp_marketing_eur,
    mic.incentive_cost_fp_marketing_local
  FROM budget_final AS budget
  FULL JOIN cost_final AS cost
          ON cost.country = budget.country
          AND cost.month = budget.month
          AND cost.report_aggregation = budget.report_aggregation
          AND cost.sub_channel = budget.sub_channel
          AND cost.is_dmart = budget.is_dmart
  LEFT JOIN mic_monthly AS mic
         ON mic.country = cost.country
        AND mic.month = cost.month
        AND mic.report_aggregation = cost.report_aggregation
        AND mic.sub_channel = cost.sub_channel
        AND mic.is_dmart = cost.is_dmart
)

SELECT
  &quot;2024&quot; AS report_year,
  *
FROM `dhh---analytics-apac.pandata_ap_mktg.mcr_cost_vs_budgets_2024`
WHERE country IS NOT NULL
  AND month &gt;&gt;= &quot;2024-01-01&quot;

UNION ALL

SELECT
  &quot;2025&quot; AS report_year,
  *
FROM cost_vs_budget_2025</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <datasource-relationships>
    <datasource-dependencies datasource='federated.05sf7xp1bf10ys1dv5wjc1wcsp3q'>
      <column caption='Budget Channel' datatype='string' name='[budget_channel]' role='dimension' type='nominal' />
      <column-instance column='[budget_channel]' derivation='None' name='[none:budget_channel:nk]' pivot='key' type='nominal' />
    </datasource-dependencies>
    <datasource-relationship source='federated.05sf7xp1bf10ys1dv5wjc1wcsp3q' target='federated.05sf7xp1bf10ys1dv5wjc1wcsp3q'>
      <column-mapping>
        <map key='[federated.05sf7xp1bf10ys1dv5wjc1wcsp3q].[none:budget_channel:nk]' value='[federated.05sf7xp1bf10ys1dv5wjc1wcsp3q].[none:budget_channel:nk]' />
      </column-mapping>
    </datasource-relationship>
    <datasource-relationship source='federated.0crg0fr1vae3qu13mstuo1h5auf1' target='federated.0crg0fr1vae3qu13mstuo1h5auf1'>
      <column-mapping />
    </datasource-relationship>
  </datasource-relationships>
  <mapsources>
    <mapsource name='Tableau' />
  </mapsources>
  <shared-views>
    <shared-view name='federated.05sf7xp1bf10ys1dv5wjc1wcsp3q'>
      <datasources>
        <datasource caption='Cost Overall' name='federated.05sf7xp1bf10ys1dv5wjc1wcsp3q' />
      </datasources>
      <datasource-dependencies datasource='federated.05sf7xp1bf10ys1dv5wjc1wcsp3q' />
      <filter class='categorical' column='[federated.05sf7xp1bf10ys1dv5wjc1wcsp3q].[Country Filter Groups (copy) 1]' context='true' />
    </shared-view>
    <shared-view name='federated.0crg0fr1vae3qu13mstuo1h5auf1'>
      <datasources>
        <datasource caption='Overall Budget vs Costs (monthly)' name='federated.0crg0fr1vae3qu13mstuo1h5auf1' />
      </datasources>
      <datasource-dependencies datasource='federated.0crg0fr1vae3qu13mstuo1h5auf1' />
      <filter class='categorical' column='[federated.0crg0fr1vae3qu13mstuo1h5auf1].[APAC User Filter]' context='true' />
      <filter class='categorical' column='[federated.0crg0fr1vae3qu13mstuo1h5auf1].[Country Filter Groups (copy) 1]' context='true' />
    </shared-view>
