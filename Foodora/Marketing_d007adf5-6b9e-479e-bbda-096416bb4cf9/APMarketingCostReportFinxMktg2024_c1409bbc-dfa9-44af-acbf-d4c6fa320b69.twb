      <table>
        <view>
          <datasources>
            <datasource caption='Cost Overall' name='federated.05sf7xp1bf10ys1dv5wjc1wcsp3q' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Overall Currency' datatype='string' name='[Currency 4 (copy)_3232669771013398529]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
            <column alias='vat_included' caption='VAT' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;vat_included&quot;'>
              <calculation class='tableau' formula='&quot;vat_included&quot;' />
              <aliases>
                <alias key='&quot;vat_included&quot;' value='vat_included' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05sf7xp1bf10ys1dv5wjc1wcsp3q'>
            <column caption='Actuals Toggle' datatype='real' name='[Calculation_3232669771013201920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Currency 4 (copy)_3232669771013398529]&#10;WHEN &apos;EUR&apos; THEN IFNULL([costs_fp_eur]*[marketing_share],0)&#10;WHEN &apos;LC&apos; THEN IFNULL([costs_fp_lc]*[marketing_share],0)&#10;END' />
            </column>
            <column caption='Costs (Ticket)' datatype='real' name='[Calculation_3457849764105162761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE TRUE&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;    THEN [costs_ticket_eur]&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;    THEN [costs_ticket_eur]&#10;&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;     THEN [costs_ticket_lc]&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;     THEN [costs_ticket_lc]&#10;END' />
            </column>
            <column caption='Costs (Accumulated)' datatype='real' name='[Calculation_3457849764105326602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE TRUE&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;    THEN [costs_remaining_eur]&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;    THEN [costs_remaining_eur]&#10;&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;     THEN [costs_remaining_lc]&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;     THEN [costs_remaining_lc]&#10;END' />
            </column>
            <column caption='Costs (Remaining)' datatype='real' name='[Calculation_3457849764105625611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE TRUE&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;    THEN [costs_remaining_eur]&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;    THEN [costs_remaining_eur]&#10;&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;     THEN [costs_remaining_lc]&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;     THEN [costs_remaining_lc]&#10;END' />
