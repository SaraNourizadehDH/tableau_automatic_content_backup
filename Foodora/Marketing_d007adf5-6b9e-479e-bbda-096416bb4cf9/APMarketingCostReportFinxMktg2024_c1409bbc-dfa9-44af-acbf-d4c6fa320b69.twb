    <datasource caption='Cost Overall' inline='true' name='federated.05sf7xp1bf10ys1dv5wjc1wcsp3q' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1w249kx16vmbkm1gzcov50br4s6r'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='dhh---analytics-eu' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='dhh---analytics-apac' schema='pandata_ap_mktg' server-oauth='' username='ozan.kir@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1w249kx16vmbkm1gzcov50br4s6r' name='Custom SQL Query' type='text'>--- Updated 28 May

SELECT

    cost.global_entity_id,
    CASE WHEN cost.global_entity_id = &quot;FP_BD&quot; THEN &quot;Bangladesh&quot;
         WHEN cost.global_entity_id = &quot;FP_MY&quot; THEN &quot;Malaysia&quot;
         WHEN cost.global_entity_id = &quot;FP_MM&quot; THEN &quot;Myanmar&quot;
         WHEN cost.global_entity_id = &quot;FP_HK&quot; THEN &quot;Hong Kong&quot;
         WHEN cost.global_entity_id = &quot;FP_KH&quot; THEN &quot;Cambodia&quot;
         WHEN cost.global_entity_id = &quot;FP_LA&quot; THEN &quot;Laos&quot;
         WHEN cost.global_entity_id = &quot;FP_PK&quot; THEN &quot;Pakistan&quot;
         WHEN cost.global_entity_id = &quot;FP_SG&quot; THEN &quot;Singapore&quot;
         WHEN cost.global_entity_id = &quot;FP_PH&quot; THEN &quot;Philippines&quot;
         WHEN cost.global_entity_id = &quot;FP_TH&quot; THEN &quot;Thailand&quot;
         WHEN cost.global_entity_id = &quot;FP_TW&quot; THEN &quot;Taiwan&quot;
    END AS country,
    cost.created_month_local AS Month,
    cost.cost_type,
    NULL AS marketing_share,
    CASE WHEN cost.budget_channel IN (&quot;Other Incentives&quot;, &quot;Other Vouchers&quot;, &quot;Cashback&quot;) THEN &quot;Incentives&quot; 
         ELSE mapping.report_aggregation END AS report_aggregation,
    CASE WHEN cost.budget_channel IN (&quot;Other Incentives&quot;, &quot;Other Vouchers&quot;, &quot;Cashback&quot;) THEN &quot;Incentives&quot;
         ELSE mapping.sub_channel END AS sub_channel,
    NULL AS campaign,
    cost.fp_cost_plus_vat_eur AS costs_fp_eur,
    0 AS costs_fp_nc_eur,
    0 AS costs_vendor_eur,
    0 AS runrate_fp_eur,
    0 AS runrate_vendor_eur,
    cost.fp_cost_plus_vat_local AS costs_fp_lc,
    0	AS costs_vendor_lc,
    0	AS runrate_fp_lc,
    0	AS runrate_vendor_lc,
    cost.order_count,
    NULL AS	acquisitions,
    NULL AS	ticket,
    NULL AS	start_date,
    NULL AS	end_date,
    costs_ticket_eur AS	costs_ticket_eur,
    costs_ticket_lc AS	costs_ticket_lc,
    costs_accumulated_eur AS	costs_accumulated_eur,
    costs_accumulated_lc AS	costs_accumulated_lc,
    costs_remaining_eur AS	costs_remaining_eur,
    costs_remaining_lc AS	costs_remaining_lc,
    cost.cost_source,
    NULL AS original_bc,
    cost.budget_channel,
    CASE WHEN cost.budget_channel = &quot;Cashback&quot; THEN &quot;Food&quot;
         WHEN cost.vertical_per_redemption = &quot;food&quot; THEN &quot;Food&quot;
         WHEN cost.vertical_per_redemption IN (&quot;Concepts&quot;, &quot;Caterers&quot;, &quot;Concepts/Kitchens&quot;) THEN &quot;SKC&quot;
         ELSE cost.vertical_per_redemption END AS vertical_per_redemption,
    CASE WHEN cost.budget_channel = &quot;Cashback&quot; THEN &quot;Food&quot;
    ELSE cost.vertical_per_budget END AS vertical_per_budget,
    cost.gl_code,
    cost.gl_acc_name,
    cost.is_own_delivery,
    cost.delivery_method,
    cost.event_type,
    cost.refund_type,
    CASE WHEN cost.cost_type != &quot;free_delivery&quot; THEN NULL 
    ELSE cost.is_fd_less_then_30_days
    END AS is_fd_less_then_30_days,
    cost.carc_local,
    cost.carc_plus_vat_local,
    cost.revenue_reduction_local,
    cost.revenue_reduction_plus_vat_local,
    cost.del_non_personnel_cost_local,
    cost.del_non_personnel_cost_plus_vat_local,
    cost.carc_eur,
    cost.carc_plus_vat_eur,
    cost.revenue_reduction_eur,
    cost.revenue_reduction_plus_vat_eur,
    cost.del_non_personnel_cost_eur,
    cost.del_non_personnel_cost_plus_vat_eur,
    cost.tableau_view AS table_source,
    CASE WHEN cost.budget_channel = &quot;Cashback&quot; THEN &quot;Food&quot;
    ELSE cost.voucher_vertical_per_origin END AS vertical_per_origin,
    cost.vertical_types_categorised
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_finance_cost_report_tableau_reporting` AS cost
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_budget_channel_aggregation` AS mapping
         ON cost.budget_channel = mapping.budget_channel_new
        AND mapping.budget_channel IS NOT NULL
        AND mapping.year = 2024
 WHERE cost.created_month_local &gt;&gt;= &quot;2023-12-01&quot;

  UNION ALL

  SELECT
      mkt.global_entity_id,
      countries.name AS country,
      mkt.month AS Month,
      mkt.cost_type,
      mkt.marketing_share,
      CASE WHEN mkt.budget_channel IN (&quot;Other Incentives&quot;, &quot;Other Vouchers&quot;, &quot;Cashback&quot;) THEN &quot;Incentives&quot; 
         ELSE mapping.report_aggregation END AS report_aggregation,
      CASE WHEN mkt.budget_channel IN (&quot;Other Incentives&quot;, &quot;Other Vouchers&quot;, &quot;Cashback&quot;) THEN &quot;Incentives&quot;
         ELSE mapping.sub_channel END AS sub_channel,
      mkt.campaign,
      IF(mkt.budget_channel = &quot;CX Vouchers&quot;, 0, mkt.costs_fp_eur) AS costs_fp_eur,
      mkt.costs_fp_nc_eur,
      mkt.costs_vendor_eur,
      IF(mkt.budget_channel = &quot;CX Vouchers&quot;, 0, mkt.runrate_fp_eur) AS runrate_fp_eur,
      mkt.runrate_vendor_eur,
      IF(mkt.budget_channel = &quot;CX Vouchers&quot;, 0, mkt.costs_fp_lc) AS costs_fp_lc,
      mkt.costs_vendor_lc,
      IF(mkt.budget_channel = &quot;CX Vouchers&quot;, 0, mkt.runrate_fp_lc) AS runrate_fp_lc,
      mkt.runrate_vendor_lc,
      mkt.orders AS order_count,
      mkt.acquisitions,
      mkt.ticket,
      mkt.start_date,
      mkt.end_date,
      mkt.costs_ticket_eur,
      mkt.costs_ticket_lc,
      mkt.costs_accumulated_eur,
      mkt.costs_accumulated_lc,
      mkt.costs_remaining_eur,
      mkt.costs_remaining_lc,
      mkt.cost_source,
      mkt.original_bc,
      mkt.budget_channel,
      CASE WHEN mkt.budget_channel = &quot;Cashback&quot; THEN &quot;Food&quot; 
           WHEN mkt.vertical_per_redemption = &quot;food&quot; THEN &quot;Food&quot;
           WHEN mkt.vertical_per_redemption IN (&quot;Concepts&quot;, &quot;Caterers&quot;, &quot;Concepts/Kitchens&quot;) THEN &quot;SKC&quot;
      ELSE mkt.vertical_per_redemption END AS vertical_per_redemption,
      CASE WHEN mkt.budget_channel = &quot;Cashback&quot; THEN &quot;Food&quot; 
      ELSE mkt.vertical END AS vertical_per_budget,
      NULL AS gl_code,
      NULL AS gl_acc_name,
      NULL AS is_own_delivery,
      NULL AS delivery_method,
      NULL AS event_type,
      NULL AS refund_type,
      NULL AS is_fd_less_then_30_days,
      0 AS carc_local,
      0 AS carc_plus_vat_local,
      0 AS revenue_reduction_local,
      mkt.revenue_reduction_plus_vat_local,
      0 AS del_non_personnel_cost_local,
      0 AS del_non_personnel_cost_plus_vat_local,
      0 AS carc_eur,
      0 AS carc_plus_vat_eur,
      0 AS revenue_reduction_eur,
      mkt.revenue_reduction_plus_vat_eur,
      0 AS del_non_personnel_cost_eur,
      0 AS del_non_personnel_cost_plus_vat_eur,
      &quot;Marketing&quot; AS table_source,
      CASE WHEN mkt.budget_channel = &quot;Cashback&quot; THEN &quot;Food&quot; 
      ELSE mkt.vertical_per_origin END AS vertical_per_origin,
      NULL AS vertical_types_categorised
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_cost_report_tableau_reporting` AS mkt
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS countries
        ON mkt.global_entity_id = countries.global_entity_id
        AND countries.region = &quot;Asia&quot;
        AND countries.company_name = &quot;Foodpanda&quot;
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_budget_channel_aggregation` AS mapping
         ON mkt.budget_channel = mapping.budget_channel_new
        AND mapping.budget_channel IS NOT NULL
        AND mapping.year = 2024
 WHERE mkt.month &gt;&gt;= &quot;2023-12-01&quot;
  AND mkt.budget_channel NOT IN (&quot;Employee benefit / internal&quot;, &quot;Rider Vouchers&quot;)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1w249kx16vmbkm1gzcov50br4s6r' name='Custom SQL Query' type='text'>--- Updated 28 May

SELECT

    cost.global_entity_id,
    CASE WHEN cost.global_entity_id = &quot;FP_BD&quot; THEN &quot;Bangladesh&quot;
         WHEN cost.global_entity_id = &quot;FP_MY&quot; THEN &quot;Malaysia&quot;
         WHEN cost.global_entity_id = &quot;FP_MM&quot; THEN &quot;Myanmar&quot;
         WHEN cost.global_entity_id = &quot;FP_HK&quot; THEN &quot;Hong Kong&quot;
         WHEN cost.global_entity_id = &quot;FP_KH&quot; THEN &quot;Cambodia&quot;
         WHEN cost.global_entity_id = &quot;FP_LA&quot; THEN &quot;Laos&quot;
         WHEN cost.global_entity_id = &quot;FP_PK&quot; THEN &quot;Pakistan&quot;
         WHEN cost.global_entity_id = &quot;FP_SG&quot; THEN &quot;Singapore&quot;
         WHEN cost.global_entity_id = &quot;FP_PH&quot; THEN &quot;Philippines&quot;
         WHEN cost.global_entity_id = &quot;FP_TH&quot; THEN &quot;Thailand&quot;
         WHEN cost.global_entity_id = &quot;FP_TW&quot; THEN &quot;Taiwan&quot;
    END AS country,
    cost.created_month_local AS Month,
    cost.cost_type,
    NULL AS marketing_share,
    CASE WHEN cost.budget_channel IN (&quot;Other Incentives&quot;, &quot;Other Vouchers&quot;, &quot;Cashback&quot;) THEN &quot;Incentives&quot; 
         ELSE mapping.report_aggregation END AS report_aggregation,
    CASE WHEN cost.budget_channel IN (&quot;Other Incentives&quot;, &quot;Other Vouchers&quot;, &quot;Cashback&quot;) THEN &quot;Incentives&quot;
         ELSE mapping.sub_channel END AS sub_channel,
    NULL AS campaign,
    cost.fp_cost_plus_vat_eur AS costs_fp_eur,
    0 AS costs_fp_nc_eur,
    0 AS costs_vendor_eur,
    0 AS runrate_fp_eur,
    0 AS runrate_vendor_eur,
    cost.fp_cost_plus_vat_local AS costs_fp_lc,
    0	AS costs_vendor_lc,
    0	AS runrate_fp_lc,
    0	AS runrate_vendor_lc,
    cost.order_count,
    NULL AS	acquisitions,
    NULL AS	ticket,
    NULL AS	start_date,
    NULL AS	end_date,
    costs_ticket_eur AS	costs_ticket_eur,
    costs_ticket_lc AS	costs_ticket_lc,
    costs_accumulated_eur AS	costs_accumulated_eur,
    costs_accumulated_lc AS	costs_accumulated_lc,
    costs_remaining_eur AS	costs_remaining_eur,
    costs_remaining_lc AS	costs_remaining_lc,
    cost.cost_source,
    NULL AS original_bc,
    cost.budget_channel,
    CASE WHEN cost.budget_channel = &quot;Cashback&quot; THEN &quot;Food&quot;
         WHEN cost.vertical_per_redemption = &quot;food&quot; THEN &quot;Food&quot;
         WHEN cost.vertical_per_redemption IN (&quot;Concepts&quot;, &quot;Caterers&quot;, &quot;Concepts/Kitchens&quot;) THEN &quot;SKC&quot;
         ELSE cost.vertical_per_redemption END AS vertical_per_redemption,
    CASE WHEN cost.budget_channel = &quot;Cashback&quot; THEN &quot;Food&quot;
    ELSE cost.vertical_per_budget END AS vertical_per_budget,
    cost.gl_code,
    cost.gl_acc_name,
    cost.is_own_delivery,
    cost.delivery_method,
    cost.event_type,
    cost.refund_type,
    CASE WHEN cost.cost_type != &quot;free_delivery&quot; THEN NULL 
    ELSE cost.is_fd_less_then_30_days
    END AS is_fd_less_then_30_days,
    cost.carc_local,
    cost.carc_plus_vat_local,
    cost.revenue_reduction_local,
    cost.revenue_reduction_plus_vat_local,
    cost.del_non_personnel_cost_local,
    cost.del_non_personnel_cost_plus_vat_local,
    cost.carc_eur,
    cost.carc_plus_vat_eur,
    cost.revenue_reduction_eur,
    cost.revenue_reduction_plus_vat_eur,
    cost.del_non_personnel_cost_eur,
    cost.del_non_personnel_cost_plus_vat_eur,
    cost.tableau_view AS table_source,
    CASE WHEN cost.budget_channel = &quot;Cashback&quot; THEN &quot;Food&quot;
    ELSE cost.voucher_vertical_per_origin END AS vertical_per_origin,
    cost.vertical_types_categorised
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_finance_cost_report_tableau_reporting` AS cost
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_budget_channel_aggregation` AS mapping
         ON cost.budget_channel = mapping.budget_channel_new
        AND mapping.budget_channel IS NOT NULL
        AND mapping.year = 2024
 WHERE cost.created_month_local &gt;&gt;= &quot;2023-12-01&quot;

  UNION ALL

  SELECT
      mkt.global_entity_id,
      countries.name AS country,
      mkt.month AS Month,
      mkt.cost_type,
      mkt.marketing_share,
      CASE WHEN mkt.budget_channel IN (&quot;Other Incentives&quot;, &quot;Other Vouchers&quot;, &quot;Cashback&quot;) THEN &quot;Incentives&quot; 
         ELSE mapping.report_aggregation END AS report_aggregation,
      CASE WHEN mkt.budget_channel IN (&quot;Other Incentives&quot;, &quot;Other Vouchers&quot;, &quot;Cashback&quot;) THEN &quot;Incentives&quot;
         ELSE mapping.sub_channel END AS sub_channel,
      mkt.campaign,
      IF(mkt.budget_channel = &quot;CX Vouchers&quot;, 0, mkt.costs_fp_eur) AS costs_fp_eur,
      mkt.costs_fp_nc_eur,
      mkt.costs_vendor_eur,
      IF(mkt.budget_channel = &quot;CX Vouchers&quot;, 0, mkt.runrate_fp_eur) AS runrate_fp_eur,
      mkt.runrate_vendor_eur,
      IF(mkt.budget_channel = &quot;CX Vouchers&quot;, 0, mkt.costs_fp_lc) AS costs_fp_lc,
      mkt.costs_vendor_lc,
      IF(mkt.budget_channel = &quot;CX Vouchers&quot;, 0, mkt.runrate_fp_lc) AS runrate_fp_lc,
      mkt.runrate_vendor_lc,
      mkt.orders AS order_count,
      mkt.acquisitions,
      mkt.ticket,
      mkt.start_date,
      mkt.end_date,
      mkt.costs_ticket_eur,
      mkt.costs_ticket_lc,
      mkt.costs_accumulated_eur,
      mkt.costs_accumulated_lc,
      mkt.costs_remaining_eur,
      mkt.costs_remaining_lc,
      mkt.cost_source,
      mkt.original_bc,
      mkt.budget_channel,
      CASE WHEN mkt.budget_channel = &quot;Cashback&quot; THEN &quot;Food&quot; 
           WHEN mkt.vertical_per_redemption = &quot;food&quot; THEN &quot;Food&quot;
           WHEN mkt.vertical_per_redemption IN (&quot;Concepts&quot;, &quot;Caterers&quot;, &quot;Concepts/Kitchens&quot;) THEN &quot;SKC&quot;
      ELSE mkt.vertical_per_redemption END AS vertical_per_redemption,
      CASE WHEN mkt.budget_channel = &quot;Cashback&quot; THEN &quot;Food&quot; 
      ELSE mkt.vertical END AS vertical_per_budget,
      NULL AS gl_code,
      NULL AS gl_acc_name,
      NULL AS is_own_delivery,
      NULL AS delivery_method,
      NULL AS event_type,
      NULL AS refund_type,
      NULL AS is_fd_less_then_30_days,
      0 AS carc_local,
      0 AS carc_plus_vat_local,
      0 AS revenue_reduction_local,
      mkt.revenue_reduction_plus_vat_local,
      0 AS del_non_personnel_cost_local,
      0 AS del_non_personnel_cost_plus_vat_local,
      0 AS carc_eur,
      0 AS carc_plus_vat_eur,
      0 AS revenue_reduction_eur,
      mkt.revenue_reduction_plus_vat_eur,
      0 AS del_non_personnel_cost_eur,
      0 AS del_non_personnel_cost_plus_vat_eur,
      &quot;Marketing&quot; AS table_source,
      CASE WHEN mkt.budget_channel = &quot;Cashback&quot; THEN &quot;Food&quot; 
      ELSE mkt.vertical_per_origin END AS vertical_per_origin,
      NULL AS vertical_types_categorised
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_cost_report_tableau_reporting` AS mkt
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS countries
        ON mkt.global_entity_id = countries.global_entity_id
        AND countries.region = &quot;Asia&quot;
        AND countries.company_name = &quot;Foodpanda&quot;
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_budget_channel_aggregation` AS mapping
         ON mkt.budget_channel = mapping.budget_channel_new
        AND mapping.budget_channel IS NOT NULL
        AND mapping.year = 2024
 WHERE mkt.month &gt;&gt;= &quot;2023-12-01&quot;
  AND mkt.budget_channel NOT IN (&quot;Employee benefit / internal&quot;, &quot;Rider Vouchers&quot;)</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
