      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APMarketingCostReportFinxMktg2024/FinDiscountCostReport?rev=' id='FinDiscountCostReport' path='/t/Foodora/workbooks/APMarketingCostReportFinxMktg2024' revision='' site='Foodora' />
      <style />
      <size maxheight='800' maxwidth='1500' minheight='800' minwidth='1500' preset-index='0' sizing-mode='fixed' />
