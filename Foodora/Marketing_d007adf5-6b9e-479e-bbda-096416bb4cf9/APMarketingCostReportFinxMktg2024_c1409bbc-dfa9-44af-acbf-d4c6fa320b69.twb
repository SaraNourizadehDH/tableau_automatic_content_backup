    <worksheet name='Online Cost (Mkt)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#cb0051'>Clarisights, Affiliates &amp; Preinstalls Costs (by Budget Channel) | </run>
            <run fontsize='11'><![CDATA[ <[federated.05sf7xp1bf10ys1dv5wjc1wcsp3q].[country]> ]]></run>
            <run fontcolor='#cb0051' fontsize='11'>| Month:</run>
            <run fontcolor='#000000' fontsize='11'><![CDATA[ <[federated.05sf7xp1bf10ys1dv5wjc1wcsp3q].[none:Month:ok]> ]]></run>
            <run fontcolor='#cb0051' fontsize='11'>|  Currency: </run>
            <run fontcolor='#1b1b1b' fontsize='11'><![CDATA[<[Parameters].[Currency 4 (copy)_3232669771013398529]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Cost Overall' name='federated.05sf7xp1bf10ys1dv5wjc1wcsp3q' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Overall Currency' datatype='string' name='[Currency 4 (copy)_3232669771013398529]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05sf7xp1bf10ys1dv5wjc1wcsp3q'>
            <column caption='Actuals Toggle' datatype='real' name='[Calculation_3232669771013201920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Currency 4 (copy)_3232669771013398529]&#10;WHEN &apos;EUR&apos; THEN IFNULL([costs_fp_eur]*[marketing_share],0)&#10;WHEN &apos;LC&apos; THEN IFNULL([costs_fp_lc]*[marketing_share],0)&#10;END' />
            </column>
            <column caption='Costs' datatype='real' name='[Calculation_3457849764096270336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Euro&apos; THEN IFNULL([costs_fp_eur]*[marketing_share],0)&#10;ELSE IFNULL([costs_fp_lc]*[marketing_share],0)&#10;END' />
            </column>
            <column caption='Run Rate' datatype='real' name='[Calculation_3457849764097024003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Currency 4 (copy)_3232669771013398529]&#10;WHEN &apos;EUR&apos; THEN IFNULL([runrate_fp_eur] * [marketing_share],0)&#10;ELSE IFNULL([runrate_fp_lc] * [marketing_share],0)&#10;END' />
            </column>
            <column datatype='date' default-format='*mmm yy' name='[Month]' role='dimension' type='ordinal' />
            <column-instance column='[Month]' derivation='Attribute' name='[attr:Month:ok]' pivot='key' type='ordinal' />
            <column caption='Budget Channel' datatype='string' name='[budget_channel]' role='dimension' type='nominal' />
            <column datatype='string' name='[campaign]' role='dimension' type='nominal' />
            <column caption='Cost Source' datatype='string' name='[cost_source]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Offline&quot;' value='Ariba / Jira PR tickets' />
                <alias key='&quot;Online&quot;' value='Clarisights, Preinstalls &amp; Affiliates (Online)' />
              </aliases>
            </column>
            <column datatype='real' name='[costs_fp_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[costs_fp_lc]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
