      <table>
        <view>
          <datasources>
            <datasource caption='Cost Overall' name='federated.05sf7xp1bf10ys1dv5wjc1wcsp3q' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
            <column alias='vat_included' caption='VAT' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;vat_included&quot;'>
              <calculation class='tableau' formula='&quot;vat_included&quot;' />
              <aliases>
                <alias key='&quot;vat_included&quot;' value='vat_included' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05sf7xp1bf10ys1dv5wjc1wcsp3q'>
            <column caption='CARC' datatype='real' name='[Calculation_3457849764102094854]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE TRUE&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;    THEN [carc_plus_vat_eur]&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;    THEN [carc_eur]&#10;&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;     THEN [carc_plus_vat_local]&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;     THEN [carc_local]&#10;END' />
            </column>
            <column caption='Revenue Reduction' datatype='real' name='[Calculation_3457849764102258695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE TRUE&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;    THEN [revenue_reduction_plus_vat_eur]&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;    THEN [revenue_reduction_eur]&#10;&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;     THEN [revenue_reduction_plus_vat_local]&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;     THEN [revenue_reduction_local]&#10;END' />
            </column>
            <column caption='Del. Non Personnel Cost' datatype='real' name='[Calculation_3457849764102320136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE TRUE&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;    THEN [del_non_personnel_cost_plus_vat_eur]&#10;  WHEN [Parameters].[Parameter 1] = &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;    THEN [del_non_personnel_cost_eur]&#10;&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) = &apos;vat_included&apos;&#10;     THEN [del_non_personnel_cost_plus_vat_local]&#10;  WHEN [Parameters].[Parameter 1] != &apos;Euro&apos; AND LOWER([Parameters].[Parameter 5]) != &apos;vat_included&apos;&#10;     THEN [del_non_personnel_cost_local]&#10;END' />
            </column>
            <column caption='GL Account' datatype='string' name='[Calculation_4192710561699475457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Month]&lt;=DATE(&quot;2024-12-31&quot;)&#10;then [gl_code] + &quot; &quot; + [gl_acc_name]&#10;else [gl_code] end' />
            </column>
