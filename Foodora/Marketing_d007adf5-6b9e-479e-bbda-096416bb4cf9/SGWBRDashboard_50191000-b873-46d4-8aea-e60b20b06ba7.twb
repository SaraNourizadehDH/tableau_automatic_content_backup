              <calculation class='tableau' formula='(SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [fp_df_cost] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; AND vertical &lt;&gt; &apos;PU&apos; THEN [orders] END))/(SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [fp_df_cost] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; AND vertical &lt;&gt; &apos;PU&apos; THEN [orders] END))-1' />
            </column>
            <column caption='SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [gmv_net] END)/SUM(IF [Weekly...' datatype='real' name='[Calculation_260997732836528194]' role='measure' type='quantitative' user:unnamed='Weekly - LW vs L2W - QC'>
              <calculation class='tableau' formula='SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [gmv_net] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [gmv_net] END)-1' />
            </column>
            <column caption='((SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [total_incentive] END)/SUM(...' datatype='real' name='[Calculation_260997735050289388]' role='measure' type='quantitative' user:unnamed='Weekly - LW vs L2W - QC'>
              <calculation class='tableau' formula='((SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [Calculation_3636234545997357058] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [gmv] END))-(SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [Calculation_3636234545997357058] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [gmv] END)))*100' />
