      , COUNT(DISTINCT CASE WHEN has_75_orders THEN vendor_code END) AS vendor_w_75o
  FROM ab_acq_details_60
  WHERE EXTRACT(DAY FROM completion_date) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1
  GROUP BY 1,2
),
*/

ab_acq_details_30 AS (  
  SELECT DISTINCT activation_date
      , DATE_ADD(activation_date, INTERVAL 30 DAY) AS completion_date

      , date_trunc(DATE_ADD(activation_date, INTERVAL 30 DAY), ISOWEEK) as completion_week
      , date_trunc(DATE_ADD(activation_date, INTERVAL 30 DAY), MONTH) as completion_month
      
      , opp.global_vendor_id
      , sf.vendor_code 

      , case when count(distinct code) over(partition by sf.vendor_code) >>= 1 THEN TRUE ELSE FALSE end as has_1_orders

      , count(distinct code) over(partition by sf.vendor_code) as orders
      , sum(ifnull(gmv_local, 0)) over(partition by sf.vendor_code) as gmv

  FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_lead_account_opp_aggregated_metrics_mart_mgmt_cut` opp
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_sf_accounts` sf
    ON opp.global_vendor_id = sf.global_vendor_id
    AND sf.global_entity_id = 'FP_SG'

  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` pd
    on sf.vendor_code = pd.vendor_code
    and pd.ordered_at_date_local between date(opp.activation_date) and date_add(date(opp.activation_date), interval 30 day)
    and is_valid_order = true
    and is_test_order = false

  WHERE country = 'Singapore'
    AND vendor_type = 'Restaurants'
    AND opportunity_business_type IN ("New Business", "Win Back")
    -- AND sf.vendor_grade IS NOT NULL AND sf.vendor_grade IN ('A','B','AAA')
  
  qualify row_number() over(partition by vendor_code) = 1
),

onboarding_agg_30 AS (
  SELECT 'Weekly' AS granularity
      , completion_week AS date_
      , COUNT(DISTINCT vendor_code) AS total_onboard_vendor
      , COUNT(DISTINCT CASE WHEN has_1_orders THEN vendor_code END) AS vendor_w_1o
  FROM ab_acq_details_30
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'Monthly' AS granularity
      , completion_month AS date_
      , COUNT(DISTINCT vendor_code) AS total_onboard_vendor
      , COUNT(DISTINCT CASE WHEN has_1_orders THEN vendor_code END) AS vendor_w_1o
  FROM ab_acq_details_30
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'MTD' AS granularity
      , completion_month AS date_
      , COUNT(DISTINCT vendor_code) AS total_onboard_vendor
      , COUNT(DISTINCT CASE WHEN has_1_orders THEN vendor_code END) AS vendor_w_1o
  FROM ab_acq_details_30
  WHERE EXTRACT(DAY FROM completion_date) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1
  GROUP BY 1,2
),

zombie_weekly_data AS (
  WITH base AS (
    SELECT
      report_week,
      vendor_code,
      vendor_type_classification,
      lead_source,
      zombie_age_group,
      last_30days_valid_order,
      days_activated,
      LAG(last_30days_valid_order) OVER (PARTITION BY vendor_code ORDER BY report_week ASC) AS previous_last_30days_valid_order,
      LAG(is_zombie) OVER (PARTITION BY vendor_code ORDER BY report_week ASC) AS previous_is_zombie,
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_ops_info_weekly`
    WHERE 1=1
      AND global_entity_id = 'FP_SG'
      AND is_last_day_of_week
      AND is_active
      AND is_private IS FALSE
      AND is_test IS FALSE
      AND report_week >>= '2025-01-01'
  ),

  daily_ AS (
    SELECT 
      report_date + 29 AS match_report_date,
      report_date,
      vendor_code,
      last_30days_valid_orders AS last_30days_valid_orders_30d_ago
    FROM fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_ops_performance_daily
    WHERE 1=1
      AND global_entity_id = 'FP_SG'
      AND report_date >>= '2024-12-01'

  ),


  terminated AS (
    SELECT
      DATE_TRUNC(date,isoweek) AS terminated_week,
      vendor_code,
      TRUE AS has_terminated
    FROM `fulfillment-dwh-production.pandata_report.vendor_pe_terminated_vendors`
    WHERE 1=1
      AND global_entity_id = 'FP_SG'
      AND date >>= '2025-01-01'

  ),

  base_int AS (
    SELECT
      base.*,
      CASE
        WHEN vendor_type_classification = 'Incubation Vendor' AND days_activated <<=30 AND (last_30days_valid_order = 0 OR last_30days_valid_order IS NULL) THEN 'new_activated_vendor_without_order'
        WHEN vendor_type_classification = 'Incubation Vendor' AND days_activated <<=30 AND last_30days_valid_order >> 0 THEN 'new_activated_vendor_with_order'
        WHEN last_30days_valid_order = 0 AND previous_last_30days_valid_order >> 0 THEN 'zombie_formed'
        WHEN last_30days_valid_order >> 0 AND previous_last_30days_valid_order = 0 THEN 'zombie_revived'
        WHEN last_30days_valid_order = 0 THEN 'zombie_continued'
        WHEN last_30days_valid_order >> 0 THEN 'order_generating'
        WHEN last_30days_valid_order = 0 THEN 'zombie_terminated'
      ELSE 'zombie_continued' END AS vendor_status,
      has_terminated,
    FROM base
    LEFT JOIN terminated
      ON base.vendor_code = terminated.vendor_code
      AND report_week = terminated_week

  ),

  base_int2 AS (
    SELECT
      *,
      LAG(vendor_status) OVER (PARTITION BY vendor_code ORDER BY report_week ASC) AS previous_vendor_status
  FROM base_int

  ),

  base_int3 AS (
  SELECT
  *,
  CASE
  WHEN previous_vendor_status = 'new_activated_vendor_without_order' AND vendor_status = 'zombie_continued' THEN 'new_activated_vendor_zombie_formed' ELSE vendor_status END vendor_statusv2
  FROM base_int2

  ),

  base_int4 AS(
    SELECT 
      base_int3.*,
      report_date,
      daily_.last_30days_valid_orders_30d_ago
    FROM base_int3
    LEFT JOIN daily_
      ON daily_.vendor_code = base_int3.vendor_code
      AND report_week = match_report_date

  ),

  base_int5 AS (

  SELECT 
    *,
    CASE 
    
      -- WHEN (zombie_age_group NOT IN ('7 Days Zombie','14 Days Zombie') OR zombie_age_group IS NOT NULL) AND last_30days_valid_orders_30d_ago >>0 THEN 'zombie_formed' 
      -- WHEN (zombie_age_group IN ('7 Days Zombie','14 Days Zombie') OR zombie_age_group IS NULL) AND  last_30days_valid_orders_30d_ago =0 THEN 'zombie_revived'
      WHEN has_terminated AND last_30days_valid_order >> 0 THEN 'non_zombie_terminated' 
      WHEN has_terminated AND last_30days_valid_order = 0 THEN 'zombie_terminated' 
      WHEN vendor_statusv2 = 'new_activated_vendor_without_order' THEN 'new_activated_vendor_without_order' 
      WHEN vendor_statusv2 = 'new_activated_vendor_with_order' THEN 'new_activated_vendor_with_order' 
      WHEN last_30days_valid_order >> 0 AND last_30days_valid_orders_30d_ago IS NULL AND vendor_type_classification = 'Incubation Vendor' THEN 'order_generating'
      WHEN last_30days_valid_order >> 0 AND last_30days_valid_orders_30d_ago = 0 AND vendor_type_classification = 'Incubation Vendor' THEN 'zombie_revived'
      WHEN last_30days_valid_order = 0 AND last_30days_valid_orders_30d_ago = 0 AND vendor_statusv2 <<>> 'zombie_formed' THEN 'zombie_continued'
      WHEN last_30days_valid_order >> 0 AND last_30days_valid_orders_30d_ago = 0 THEN 'zombie_revived'
      WHEN last_30days_valid_order = 0 AND last_30days_valid_orders_30d_ago >> 0 THEN 'zombie_formed'
      WHEN last_30days_valid_order >> 0 AND last_30days_valid_orders_30d_ago >> 0 THEN 'order_generating'
      ELSE vendor_statusv2
      END R30D_vendor_status,
  FROM base_int4
  ORDER BY vendor_code, report_week ASC
  ),

  combined AS (

    SELECT
      report_week,
      vendor_statusv2 AS vendor_status,
      R30D_vendor_status,
      vendor_type_classification,
      lead_source,
      COUNT(DISTINCT vendor_code) AS number_of_unique_vendors
    FROM base_int5
    GROUP BY ALL

  )

  SELECT  
    *
  FROM combined
),

zombie_data AS (
  SELECT DISTINCT 'Weekly' AS granularity
     , report_week AS report_month
     , SUM(DISTINCT CASE WHEN R30D_vendor_status IN ("zombie_formed") THEN number_of_unique_vendors END) AS zombie_formed
     , SUM(DISTINCT CASE WHEN R30D_vendor_status IN ("zombie_revived") THEN number_of_unique_vendors END) AS zombie_revived
  FROM zombie_weekly_data
  WHERE R30D_vendor_status IN ("zombie_revived", "zombie_formed")
  GROUP BY 1,2

  UNION DISTINCT
    
  SELECT DISTINCT 'Monthly' AS granularity 
     , m.report_month
     , COUNT(DISTINCT CASE WHEN m.vendor_status = 'Zombie Formed' THEN m.vendor_code END) AS zombie_formed
     , COUNT(DISTINCT CASE WHEN m.vendor_status = 'Zombie Revived' THEN m.vendor_code END) AS zombie_revived
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_vendor_status_monthly` m
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_ops_performance_monthly` t
    ON m.vendor_code = t.vendor_code
    AND m.global_entity_id = t.global_entity_id
    AND m.report_month = t.report_month
  WHERE m.global_entity_id = 'FP_SG'
    AND m.report_month >>= DATE("2025-01-01")
    AND m.vendor_status IN ('Zombie Formed', 'Zombie Revived')
  GROUP BY 1,2

  UNION DISTINCT

  SELECT DISTINCT 'MTD' AS granularity 
     , m.report_month
     , COUNT(DISTINCT CASE WHEN m.vendor_status = 'Zombie Formed' THEN m.vendor_code END) AS zombie_formed
     , COUNT(DISTINCT CASE WHEN m.vendor_status = 'Zombie Revived' THEN m.vendor_code END) AS zombie_revived
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_vendor_status_monthly` m
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_ops_performance_monthly` t
    ON m.vendor_code = t.vendor_code
    AND m.global_entity_id = t.global_entity_id
    AND m.report_month = t.report_month
  WHERE m.global_entity_id = 'FP_SG'
    AND m.report_month >>= DATE("2025-01-01")
    AND m.vendor_status IN ('Zombie Formed', 'Zombie Revived')
  GROUP BY 1,2
),

acquisition_data AS (  
  SELECT DISTINCT activation_date
       , DATE_ADD(activation_date, INTERVAL 30 DAY) AS activation_date_30d
       , sf.vendor_code 
       , sf.vendor_grade

       , opp.sf_opportunity_id
       , opp.global_vendor_id

       , email_internal_non_pii

  FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_lead_account_opp_aggregated_metrics_mart_mgmt_cut` opp
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_sf_accounts` sf
    ON opp.global_vendor_id = sf.global_vendor_id
    AND sf.global_entity_id = 'FP_SG'
  WHERE country = 'Singapore'
    AND vendor_type = 'Restaurants'
    AND opportunity_business_type IN ("New Business", "Win Back")
    AND activation_date IS NOT NULL
    AND ((DATE_TRUNC(activation_date, MONTH) <<= DATE("2025-03-01") AND email_internal_non_pii IN ('h.jamil@foodpanda.sg','h.tan@foodpanda.sg','a.gacayan@foodpanda.sg','michelle.chan@foodpanda.sg')) OR (DATE_TRUNC(activation_date, MONTH) >> DATE("2025-04-01") AND email_internal_non_pii IN ('h.jamil@foodpanda.sg','h.tan@foodpanda.sg','a.gacayan@foodpanda.sg','michelle.chan@foodpanda.sg','akshay.sabnani@foodpanda.sg','maggie.lim@foodpanda.sg','wei.khaw@foodpanda.sg','willie.chia@foodpanda.sg')) OR (DATE_TRUNC(activation_date, MONTH) >> DATE("2025-03-01") AND email_internal_non_pii IN ('h.jamil@foodpanda.sg','h.tan@foodpanda.sg','a.gacayan@foodpanda.sg','michelle.chan@foodpanda.sg','akshay.sabnani@foodpanda.sg')))
),

sales_agg AS (
  SELECT 'Weekly' AS granularity
      , DATE_TRUNC(activation_date, ISOWEEK) AS date_
      , COUNT(DISTINCT sf_opportunity_id) AS acquired_vendor
      , COUNT(DISTINCT email_internal_non_pii) AS sales_rep 
      , SAFE_DIVIDE(COUNT(DISTINCT sf_opportunity_id), COUNT(DISTINCT email_internal_non_pii)) AS sales_rep_productivity
  FROM acquisition_data
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'Monthly' AS granularity
      , DATE_TRUNC(activation_date, MONTH) AS date_
      , COUNT(DISTINCT sf_opportunity_id) AS acquired_vendor
      , COUNT(DISTINCT email_internal_non_pii) AS sales_rep 
      , SAFE_DIVIDE(COUNT(DISTINCT sf_opportunity_id), COUNT(DISTINCT email_internal_non_pii)) AS sales_rep_productivity
  FROM acquisition_data
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'MTD' AS granularity
      , DATE_TRUNC(activation_date, MONTH) AS date_
      , COUNT(DISTINCT sf_opportunity_id) AS acquired_vendor
      , COUNT(DISTINCT email_internal_non_pii) AS sales_rep 
      , SAFE_DIVIDE(COUNT(DISTINCT sf_opportunity_id), COUNT(DISTINCT email_internal_non_pii)) AS sales_rep_productivity
  FROM acquisition_data 
  WHERE ( (activation_date BETWEEN DATE_SUB(CURRENT_DATE() - 1, INTERVAL 6 MONTH) AND CURRENT_DATE()) OR
          (activation_date BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE() - 1, INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR)))
    AND ((EXTRACT(DAY FROM activation_date) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1) OR
        (EXTRACT(DAY FROM activation_date) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1))
  GROUP BY 1,2
),

incubation_vendor AS (
  SELECT
    i.activation_date AS activation_date,
    i.incubated_date_30_days AS activation_date_30d,
    i.vendor_code,
    CASE
      WHEN i.vendor_grade IN ("A", "B", "AA", "AAA") THEN "AB"
      WHEN i.vendor_grade IN ("C", "D") THEN "CD"
      ELSE "Ungraded"
    END AS vendor_grade
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_lead_account_opp_incubation_cut` AS i
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS c
    ON i.country = c.name
  WHERE i.opportunity_business_type IN ("New Business", "Win Back")
    AND COALESCE(i.key_account_sub_category, "") NOT IN ("Global KA", "National KA")
    AND i.vendor_type IN ("Restaurants")
    AND NOT i.is_terminated_within_60_days
    AND i.activation_date >>= "2024-01-01"
    AND i.country = 'Singapore'
),

deal_agg AS (
  SELECT  
    d.uuid,
    d.global_entity_id,
    e.vendor_code,
    d.start_date_utc AS start_date,
    d.end_date_utc AS end_date
  FROM `fulfillment-dwh-production.pandata_curated.offers_discounts` AS d
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discount_vendor_entries` AS e
         ON d.uuid = e.offers_discount_uuid
  WHERE d.created_date_utc >>= "2024-01-01"
    AND NOT d.is_deleted
    AND d.foodpanda_ratio <<>> 100
    AND d.global_entity_id = 'FP_SG'

  UNION ALL 

  -- vouchers
  SELECT
    v.uuid,
    v.global_entity_id,
    e.vendor_code,
    v.start_date_local AS start_date,
    v.stop_date_local AS end_date
  FROM `fulfillment-dwh-production.pandata_curated.offers_vouchers` AS v
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_voucher_vendor_entries` AS e
         ON v.uuid = e.offers_voucher_uuid
  WHERE v.created_date_utc >>= "2024-01-01"
    AND NOT v.is_deleted
    AND v.foodpanda_ratio <<>> 100
    AND v.global_entity_id = 'FP_SG'
),

ads_agg AS (
  -- CPC
  SELECT
    global_entity_id,
    vendor_code,
    campaign_date_local AS ad_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__cpc_campaigns_daily`
  WHERE campaign_date_local >>= "2024-01-01"
    AND status = "active"
    AND business_type = "restaurants"
    AND global_entity_id = 'FP_SG'

  UNION ALL

  -- Display ads
  SELECT
    da.global_entity_id,
    CASE
      WHEN advertiser_type = "chain" THEN v.vendor_code
      WHEN advertiser_type = "restaurants" THEN da.advertiser_vendor_code
      ELSE da.advertiser_vendor_code
    END AS vendor_code,
    campaign_date_local AS ad_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__display_ads_campaigns_daily` AS da
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS v
      ON da.global_entity_id = v.global_entity_id
      AND da.advertiser_chain_code = v.chain_code
      AND advertiser_type = "chain"
  WHERE campaign_date_local >>= "2024-01-01"
    AND status = "active"
    AND advertiser_type IN ("restaurants", "chain")
    AND da.global_entity_id = 'FP_SG'

  UNION ALL

  -- Joker
  SELECT
    global_entity_id,
    vendor_code,
    campaign_date_utc AS ad_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__joker_campaigns_daily`
  WHERE campaign_date_utc >>= "2024-01-01"
    AND status = "active"
    AND global_entity_id = 'FP_SG'
),


f30d_deal_ncr_details AS (
  SELECT a.*
       , COALESCE(MAX(a.activation_date_30d BETWEEN d.start_date AND d.end_date), FALSE) AS has_30d_deal
       , COALESCE(MAX(a.activation_date_30d = ads.ad_date), FALSE) AS has_30d_ncr
  FROM incubation_vendor a
  LEFT JOIN deal_agg d
    ON a.vendor_code = d.vendor_code 
    --AND a.activation_date = d.activation_date
  LEFT JOIN ads_agg ads
    ON a.vendor_code = ads.vendor_code
  WHERE a.vendor_grade IN ('AB')
  GROUP BY ALL
),

f30d_deal_ncr_agg AS (
  SELECT 'Weekly' AS granularity
      , DATE_TRUNC(activation_date_30d, ISOWEEK) AS date_
      , COUNT(DISTINCT vendor_code) AS total_ab
      , COUNT(DISTINCT CASE WHEN has_30d_deal AND has_30d_ncr THEN vendor_code END) AS f30d_w_deal_ncr
  FROM f30d_deal_ncr_details
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'Monthly' AS granularity
      , DATE_TRUNC(activation_date_30d, MONTH) AS date_
      , COUNT(DISTINCT vendor_code) AS total_ab
      , COUNT(DISTINCT CASE WHEN has_30d_deal AND has_30d_ncr THEN vendor_code END) AS f30d_w_deal_ncr
  FROM f30d_deal_ncr_details
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'MTD' AS granularity
      , DATE_TRUNC(activation_date_30d, MONTH) AS date_
      , COUNT(DISTINCT vendor_code) AS total_ab
      , COUNT(DISTINCT CASE WHEN has_30d_deal AND has_30d_ncr THEN vendor_code END) AS f30d_w_deal_ncr
  FROM f30d_deal_ncr_details
  WHERE ( (activation_date_30d BETWEEN DATE_SUB(CURRENT_DATE() - 1, INTERVAL 6 MONTH) AND CURRENT_DATE()) OR
          (activation_date_30d BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE() - 1, INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR)))
    AND ((EXTRACT(DAY FROM activation_date_30d) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1) OR
        (EXTRACT(DAY FROM activation_date_30d) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1))
  GROUP BY 1,2
)



SELECT DISTINCT t.*
     , COALESCE(o30.vendor_w_1o, 0) AS onboard_vendor_w_1o
     , COALESCE(o30.total_onboard_vendor,0) AS total_onboard_vendor_1o
     , COALESCE(z.zombie_formed,0) AS zombie_formed
     , COALESCE(z.zombie_revived,0) AS zombie_revived
     , COALESCE(s.acquired_vendor,0) AS acquired_vendor
     , COALESCE(s.sales_rep,0) AS sales_rep_count
     , COALESCE(s.sales_rep_productivity,0) AS sales_rep_productivity
     , COALESCE(dncr.total_ab) AS f30d_total_ab
     , COALESCE(dncr.f30d_w_deal_ncr) AS f30d_ab_w_deal_ncr
FROM transaction_agg t
LEFT JOIN onboarding_agg_30 o30
  ON t.granularity = o30.granularity
  AND t.date_ = o30.date_
LEFT JOIN zombie_data z
  ON t.granularity = z.granularity
  AND t.date_ = z.report_month
LEFT JOIN sales_agg s
  ON t.granularity = s.granularity
  AND t.date_ = s.date_
LEFT JOIN f30d_deal_ncr_agg dncr
  ON t.granularity = dncr.granularity
  AND t.date_ = dncr.date_
ORDER BY 1,2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0j8rpyf1xsydsv1bgov0m0n2xo3t' name='Custom SQL Query' type='text'><![CDATA[WITH vendor_inventory AS (
  SELECT DISTINCT v.report_date
       , DATE_TRUNC(v.report_date, ISOWEEK) AS report_week
       , DATE_SUB(DATE_ADD(DATE_TRUNC(v.report_date, ISOWEEK), INTERVAL 1 WEEK), INTERVAL 1 DAY) AS report_week_last_date
       , DATE_TRUNC(v.report_date, MONTH) AS report_month
       
       , v.vendor_code
       , COALESCE(sf_vendor_grade IN ('A', 'B', 'AAA'), FALSE) AS is_ab_vendor
       , COALESCE(last_30days_valid_order >> 0, FALSE) AS is_active_vendor
       , is_zombie
       
       , COALESCE(EXTRACT(DAY FROM DATE_SUB(DATE_TRUNC(CURRENT_DATE(), ISOWEEK), INTERVAL 1 DAY)) = EXTRACT(DAY FROM report_date), FALSE) AS is_mtd
       , DATE_SUB(DATE_ADD(DATE_TRUNC(v.report_date, MONTH), INTERVAL 1 MONTH), INTERVAL 1 DAY) = v.report_date AS is_monthly
       --, ROW_NUMBER() OVER(PARTITION BY DATE_TRUNC(v.report_date, MONTH) ORDER BY report_date DESC) = 1 AS is_monthly
       , DATE_SUB(DATE_ADD(DATE_TRUNC(v.report_date, ISOWEEK), INTERVAL 1 WEEK), INTERVAL 1 DAY) = v.report_date AS is_weekly
       --, ROW_NUMBER() OVER(PARTITION BY DATE_TRUNC(v.report_date, ISOWEEK) ORDER BY report_date DESC) = 1 AS is_weekly
  
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_vendors_inventory` v
  LEFT JOIN `fulfillment-dwh-production.pandata_report.vendor_pe_terminated_vendors` t
    ON v.vendor_code = t.vendor_code 
    AND v.global_entity_id = t.global_entity_id 
    AND v.report_date = t.date
  WHERE v.global_entity_id = 'FP_SG'
    AND t.vendor_code IS NULL
),

transaction_agg AS (
  SELECT 'Weekly' AS granularity
      , report_week AS date_ 
      , COUNT(DISTINCT CASE WHEN is_active_vendor THEN vendor_code END) AS active_vendor
      , COUNT(DISTINCT CASE WHEN is_ab_vendor AND is_zombie THEN vendor_code END) AS zombie_ab
  FROM vendor_inventory
  WHERE is_weekly
  GROUP BY 1,2

  UNION DISTINCT

  SELECT 'Monthly' AS granularity
      , report_month AS date_ 
      , COUNT(DISTINCT CASE WHEN is_active_vendor THEN vendor_code END) AS active_vendor
      , COUNT(DISTINCT CASE WHEN is_ab_vendor AND is_zombie THEN vendor_code END) AS zombie_ab
  FROM vendor_inventory
  WHERE is_monthly
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'MTD' AS granularity
      , report_month AS date_ 
      , COUNT(DISTINCT CASE WHEN is_active_vendor THEN vendor_code END) AS active_vendor
      , COUNT(DISTINCT CASE WHEN is_ab_vendor AND is_zombie THEN vendor_code END) AS zombie_ab
  FROM vendor_inventory
  WHERE is_mtd
  GROUP BY 1,2
),
/*
ab_acq_details_60 AS (  
  SELECT DISTINCT activation_date
      , DATE_ADD(activation_date, INTERVAL 60 DAY) AS completion_date

      , date_trunc(DATE_ADD(activation_date, INTERVAL 60 DAY), ISOWEEK) as completion_week
      , date_trunc(DATE_ADD(activation_date, INTERVAL 60 DAY), MONTH) as completion_month
      
      , opp.global_vendor_id
      , sf.vendor_code 

      , case when count(distinct code) over(partition by sf.vendor_code) >>= 75 THEN TRUE ELSE FALSE end as has_75_orders

      , count(distinct code) over(partition by sf.vendor_code) as orders
      , sum(ifnull(gmv_local, 0)) over(partition by sf.vendor_code) as gmv

  FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_lead_account_opp_aggregated_metrics_mart_mgmt_cut` opp
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_sf_accounts` sf
    ON opp.global_vendor_id = sf.global_vendor_id
    AND sf.global_entity_id = 'FP_SG'

  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` pd
    on sf.vendor_code = pd.vendor_code
    and pd.ordered_at_date_local between date(opp.activation_date) and date_add(date(opp.activation_date), interval 60 day)
    and is_valid_order = true
    and is_test_order = false

  WHERE country = 'Singapore'
    AND vendor_type = 'Restaurants'
    AND opportunity_business_type IN ("New Business", "Win Back")
    AND sf.vendor_grade IS NOT NULL AND sf.vendor_grade IN ('A','B','AAA')
  
  qualify row_number() over(partition by vendor_code) = 1
),

onboarding_agg_60 AS (
  SELECT 'Weekly' AS granularity
      , completion_week AS date_
      , COUNT(DISTINCT vendor_code) AS total_onboard_vendor
      , COUNT(DISTINCT CASE WHEN has_75_orders THEN vendor_code END) AS vendor_w_75o
  FROM ab_acq_details_60
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'Monthly' AS granularity
      , completion_month AS date_
      , COUNT(DISTINCT vendor_code) AS total_onboard_vendor
      , COUNT(DISTINCT CASE WHEN has_75_orders THEN vendor_code END) AS vendor_w_75o
  FROM ab_acq_details_60
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'MTD' AS granularity
      , completion_month AS date_
      , COUNT(DISTINCT vendor_code) AS total_onboard_vendor
      , COUNT(DISTINCT CASE WHEN has_75_orders THEN vendor_code END) AS vendor_w_75o
  FROM ab_acq_details_60
  WHERE EXTRACT(DAY FROM completion_date) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1
  GROUP BY 1,2
),
*/

ab_acq_details_30 AS (  
  SELECT DISTINCT activation_date
      , DATE_ADD(activation_date, INTERVAL 30 DAY) AS completion_date

      , date_trunc(DATE_ADD(activation_date, INTERVAL 30 DAY), ISOWEEK) as completion_week
      , date_trunc(DATE_ADD(activation_date, INTERVAL 30 DAY), MONTH) as completion_month
      
      , opp.global_vendor_id
      , sf.vendor_code 

      , case when count(distinct code) over(partition by sf.vendor_code) >>= 1 THEN TRUE ELSE FALSE end as has_1_orders

      , count(distinct code) over(partition by sf.vendor_code) as orders
      , sum(ifnull(gmv_local, 0)) over(partition by sf.vendor_code) as gmv

  FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_lead_account_opp_aggregated_metrics_mart_mgmt_cut` opp
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_sf_accounts` sf
    ON opp.global_vendor_id = sf.global_vendor_id
    AND sf.global_entity_id = 'FP_SG'

  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` pd
    on sf.vendor_code = pd.vendor_code
    and pd.ordered_at_date_local between date(opp.activation_date) and date_add(date(opp.activation_date), interval 30 day)
    and is_valid_order = true
    and is_test_order = false

  WHERE country = 'Singapore'
    AND vendor_type = 'Restaurants'
    AND opportunity_business_type IN ("New Business", "Win Back")
    -- AND sf.vendor_grade IS NOT NULL AND sf.vendor_grade IN ('A','B','AAA')
  
  qualify row_number() over(partition by vendor_code) = 1
),

onboarding_agg_30 AS (
  SELECT 'Weekly' AS granularity
      , completion_week AS date_
      , COUNT(DISTINCT vendor_code) AS total_onboard_vendor
      , COUNT(DISTINCT CASE WHEN has_1_orders THEN vendor_code END) AS vendor_w_1o
  FROM ab_acq_details_30
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'Monthly' AS granularity
      , completion_month AS date_
      , COUNT(DISTINCT vendor_code) AS total_onboard_vendor
      , COUNT(DISTINCT CASE WHEN has_1_orders THEN vendor_code END) AS vendor_w_1o
  FROM ab_acq_details_30
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'MTD' AS granularity
      , completion_month AS date_
      , COUNT(DISTINCT vendor_code) AS total_onboard_vendor
      , COUNT(DISTINCT CASE WHEN has_1_orders THEN vendor_code END) AS vendor_w_1o
  FROM ab_acq_details_30
  WHERE EXTRACT(DAY FROM completion_date) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1
  GROUP BY 1,2
),

zombie_weekly_data AS (
  WITH base AS (
    SELECT
      report_week,
      vendor_code,
      vendor_type_classification,
      lead_source,
      zombie_age_group,
      last_30days_valid_order,
      days_activated,
      LAG(last_30days_valid_order) OVER (PARTITION BY vendor_code ORDER BY report_week ASC) AS previous_last_30days_valid_order,
      LAG(is_zombie) OVER (PARTITION BY vendor_code ORDER BY report_week ASC) AS previous_is_zombie,
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_ops_info_weekly`
    WHERE 1=1
      AND global_entity_id = 'FP_SG'
      AND is_last_day_of_week
      AND is_active
      AND is_private IS FALSE
      AND is_test IS FALSE
      AND report_week >>= '2025-01-01'
  ),

  daily_ AS (
    SELECT 
      report_date + 29 AS match_report_date,
      report_date,
      vendor_code,
      last_30days_valid_orders AS last_30days_valid_orders_30d_ago
    FROM fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_ops_performance_daily
    WHERE 1=1
      AND global_entity_id = 'FP_SG'
      AND report_date >>= '2024-12-01'

  ),


  terminated AS (
    SELECT
      DATE_TRUNC(date,isoweek) AS terminated_week,
      vendor_code,
      TRUE AS has_terminated
    FROM `fulfillment-dwh-production.pandata_report.vendor_pe_terminated_vendors`
    WHERE 1=1
      AND global_entity_id = 'FP_SG'
      AND date >>= '2025-01-01'

  ),

  base_int AS (
    SELECT
      base.*,
      CASE
        WHEN vendor_type_classification = 'Incubation Vendor' AND days_activated <<=30 AND (last_30days_valid_order = 0 OR last_30days_valid_order IS NULL) THEN 'new_activated_vendor_without_order'
        WHEN vendor_type_classification = 'Incubation Vendor' AND days_activated <<=30 AND last_30days_valid_order >> 0 THEN 'new_activated_vendor_with_order'
        WHEN last_30days_valid_order = 0 AND previous_last_30days_valid_order >> 0 THEN 'zombie_formed'
        WHEN last_30days_valid_order >> 0 AND previous_last_30days_valid_order = 0 THEN 'zombie_revived'
        WHEN last_30days_valid_order = 0 THEN 'zombie_continued'
        WHEN last_30days_valid_order >> 0 THEN 'order_generating'
        WHEN last_30days_valid_order = 0 THEN 'zombie_terminated'
      ELSE 'zombie_continued' END AS vendor_status,
      has_terminated,
    FROM base
    LEFT JOIN terminated
      ON base.vendor_code = terminated.vendor_code
      AND report_week = terminated_week

  ),

  base_int2 AS (
    SELECT
      *,
      LAG(vendor_status) OVER (PARTITION BY vendor_code ORDER BY report_week ASC) AS previous_vendor_status
  FROM base_int

  ),

  base_int3 AS (
  SELECT
  *,
  CASE
  WHEN previous_vendor_status = 'new_activated_vendor_without_order' AND vendor_status = 'zombie_continued' THEN 'new_activated_vendor_zombie_formed' ELSE vendor_status END vendor_statusv2
  FROM base_int2

  ),

  base_int4 AS(
    SELECT 
      base_int3.*,
      report_date,
      daily_.last_30days_valid_orders_30d_ago
    FROM base_int3
    LEFT JOIN daily_
      ON daily_.vendor_code = base_int3.vendor_code
      AND report_week = match_report_date

  ),

  base_int5 AS (

  SELECT 
    *,
    CASE 
    
      -- WHEN (zombie_age_group NOT IN ('7 Days Zombie','14 Days Zombie') OR zombie_age_group IS NOT NULL) AND last_30days_valid_orders_30d_ago >>0 THEN 'zombie_formed' 
      -- WHEN (zombie_age_group IN ('7 Days Zombie','14 Days Zombie') OR zombie_age_group IS NULL) AND  last_30days_valid_orders_30d_ago =0 THEN 'zombie_revived'
      WHEN has_terminated AND last_30days_valid_order >> 0 THEN 'non_zombie_terminated' 
      WHEN has_terminated AND last_30days_valid_order = 0 THEN 'zombie_terminated' 
      WHEN vendor_statusv2 = 'new_activated_vendor_without_order' THEN 'new_activated_vendor_without_order' 
      WHEN vendor_statusv2 = 'new_activated_vendor_with_order' THEN 'new_activated_vendor_with_order' 
      WHEN last_30days_valid_order >> 0 AND last_30days_valid_orders_30d_ago IS NULL AND vendor_type_classification = 'Incubation Vendor' THEN 'order_generating'
      WHEN last_30days_valid_order >> 0 AND last_30days_valid_orders_30d_ago = 0 AND vendor_type_classification = 'Incubation Vendor' THEN 'zombie_revived'
      WHEN last_30days_valid_order = 0 AND last_30days_valid_orders_30d_ago = 0 AND vendor_statusv2 <<>> 'zombie_formed' THEN 'zombie_continued'
      WHEN last_30days_valid_order >> 0 AND last_30days_valid_orders_30d_ago = 0 THEN 'zombie_revived'
      WHEN last_30days_valid_order = 0 AND last_30days_valid_orders_30d_ago >> 0 THEN 'zombie_formed'
      WHEN last_30days_valid_order >> 0 AND last_30days_valid_orders_30d_ago >> 0 THEN 'order_generating'
      ELSE vendor_statusv2
      END R30D_vendor_status,
  FROM base_int4
  ORDER BY vendor_code, report_week ASC
  ),

  combined AS (

    SELECT
      report_week,
      vendor_statusv2 AS vendor_status,
      R30D_vendor_status,
      vendor_type_classification,
      lead_source,
      COUNT(DISTINCT vendor_code) AS number_of_unique_vendors
    FROM base_int5
    GROUP BY ALL

  )

  SELECT  
    *
  FROM combined
),

zombie_data AS (
  SELECT DISTINCT 'Weekly' AS granularity
     , report_week AS report_month
     , SUM(DISTINCT CASE WHEN R30D_vendor_status IN ("zombie_formed") THEN number_of_unique_vendors END) AS zombie_formed
     , SUM(DISTINCT CASE WHEN R30D_vendor_status IN ("zombie_revived") THEN number_of_unique_vendors END) AS zombie_revived
  FROM zombie_weekly_data
  WHERE R30D_vendor_status IN ("zombie_revived", "zombie_formed")
  GROUP BY 1,2

  UNION DISTINCT
    
  SELECT DISTINCT 'Monthly' AS granularity 
     , m.report_month
     , COUNT(DISTINCT CASE WHEN m.vendor_status = 'Zombie Formed' THEN m.vendor_code END) AS zombie_formed
     , COUNT(DISTINCT CASE WHEN m.vendor_status = 'Zombie Revived' THEN m.vendor_code END) AS zombie_revived
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_vendor_status_monthly` m
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_ops_performance_monthly` t
    ON m.vendor_code = t.vendor_code
    AND m.global_entity_id = t.global_entity_id
    AND m.report_month = t.report_month
  WHERE m.global_entity_id = 'FP_SG'
    AND m.report_month >>= DATE("2025-01-01")
    AND m.vendor_status IN ('Zombie Formed', 'Zombie Revived')
  GROUP BY 1,2

  UNION DISTINCT

  SELECT DISTINCT 'MTD' AS granularity 
     , m.report_month
     , COUNT(DISTINCT CASE WHEN m.vendor_status = 'Zombie Formed' THEN m.vendor_code END) AS zombie_formed
     , COUNT(DISTINCT CASE WHEN m.vendor_status = 'Zombie Revived' THEN m.vendor_code END) AS zombie_revived
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_vendor_status_monthly` m
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_ops_performance_monthly` t
    ON m.vendor_code = t.vendor_code
    AND m.global_entity_id = t.global_entity_id
    AND m.report_month = t.report_month
  WHERE m.global_entity_id = 'FP_SG'
    AND m.report_month >>= DATE("2025-01-01")
    AND m.vendor_status IN ('Zombie Formed', 'Zombie Revived')
  GROUP BY 1,2
),

acquisition_data AS (  
  SELECT DISTINCT activation_date
       , DATE_ADD(activation_date, INTERVAL 30 DAY) AS activation_date_30d
       , sf.vendor_code 
       , sf.vendor_grade

       , opp.sf_opportunity_id
       , opp.global_vendor_id

       , email_internal_non_pii

  FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_lead_account_opp_aggregated_metrics_mart_mgmt_cut` opp
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_sf_accounts` sf
    ON opp.global_vendor_id = sf.global_vendor_id
    AND sf.global_entity_id = 'FP_SG'
  WHERE country = 'Singapore'
    AND vendor_type = 'Restaurants'
    AND opportunity_business_type IN ("New Business", "Win Back")
    AND activation_date IS NOT NULL
    AND ((DATE_TRUNC(activation_date, MONTH) <<= DATE("2025-03-01") AND email_internal_non_pii IN ('h.jamil@foodpanda.sg','h.tan@foodpanda.sg','a.gacayan@foodpanda.sg','michelle.chan@foodpanda.sg')) OR (DATE_TRUNC(activation_date, MONTH) >> DATE("2025-04-01") AND email_internal_non_pii IN ('h.jamil@foodpanda.sg','h.tan@foodpanda.sg','a.gacayan@foodpanda.sg','michelle.chan@foodpanda.sg','akshay.sabnani@foodpanda.sg','maggie.lim@foodpanda.sg','wei.khaw@foodpanda.sg','willie.chia@foodpanda.sg')) OR (DATE_TRUNC(activation_date, MONTH) >> DATE("2025-03-01") AND email_internal_non_pii IN ('h.jamil@foodpanda.sg','h.tan@foodpanda.sg','a.gacayan@foodpanda.sg','michelle.chan@foodpanda.sg','akshay.sabnani@foodpanda.sg')))
),

sales_agg AS (
  SELECT 'Weekly' AS granularity
      , DATE_TRUNC(activation_date, ISOWEEK) AS date_
      , COUNT(DISTINCT sf_opportunity_id) AS acquired_vendor
      , COUNT(DISTINCT email_internal_non_pii) AS sales_rep 
      , SAFE_DIVIDE(COUNT(DISTINCT sf_opportunity_id), COUNT(DISTINCT email_internal_non_pii)) AS sales_rep_productivity
  FROM acquisition_data
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'Monthly' AS granularity
      , DATE_TRUNC(activation_date, MONTH) AS date_
      , COUNT(DISTINCT sf_opportunity_id) AS acquired_vendor
      , COUNT(DISTINCT email_internal_non_pii) AS sales_rep 
      , SAFE_DIVIDE(COUNT(DISTINCT sf_opportunity_id), COUNT(DISTINCT email_internal_non_pii)) AS sales_rep_productivity
  FROM acquisition_data
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'MTD' AS granularity
      , DATE_TRUNC(activation_date, MONTH) AS date_
      , COUNT(DISTINCT sf_opportunity_id) AS acquired_vendor
      , COUNT(DISTINCT email_internal_non_pii) AS sales_rep 
      , SAFE_DIVIDE(COUNT(DISTINCT sf_opportunity_id), COUNT(DISTINCT email_internal_non_pii)) AS sales_rep_productivity
  FROM acquisition_data 
  WHERE ( (activation_date BETWEEN DATE_SUB(CURRENT_DATE() - 1, INTERVAL 6 MONTH) AND CURRENT_DATE()) OR
          (activation_date BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE() - 1, INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR)))
    AND ((EXTRACT(DAY FROM activation_date) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1) OR
        (EXTRACT(DAY FROM activation_date) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1))
  GROUP BY 1,2
),

incubation_vendor AS (
  SELECT
    i.activation_date AS activation_date,
    i.incubated_date_30_days AS activation_date_30d,
    i.vendor_code,
    CASE
      WHEN i.vendor_grade IN ("A", "B", "AA", "AAA") THEN "AB"
      WHEN i.vendor_grade IN ("C", "D") THEN "CD"
      ELSE "Ungraded"
    END AS vendor_grade
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_lead_account_opp_incubation_cut` AS i
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS c
    ON i.country = c.name
  WHERE i.opportunity_business_type IN ("New Business", "Win Back")
    AND COALESCE(i.key_account_sub_category, "") NOT IN ("Global KA", "National KA")
    AND i.vendor_type IN ("Restaurants")
    AND NOT i.is_terminated_within_60_days
    AND i.activation_date >>= "2024-01-01"
    AND i.country = 'Singapore'
),

deal_agg AS (
  SELECT  
    d.uuid,
    d.global_entity_id,
    e.vendor_code,
    d.start_date_utc AS start_date,
    d.end_date_utc AS end_date
  FROM `fulfillment-dwh-production.pandata_curated.offers_discounts` AS d
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discount_vendor_entries` AS e
         ON d.uuid = e.offers_discount_uuid
  WHERE d.created_date_utc >>= "2024-01-01"
    AND NOT d.is_deleted
    AND d.foodpanda_ratio <<>> 100
    AND d.global_entity_id = 'FP_SG'

  UNION ALL 

  -- vouchers
  SELECT
    v.uuid,
    v.global_entity_id,
    e.vendor_code,
    v.start_date_local AS start_date,
    v.stop_date_local AS end_date
  FROM `fulfillment-dwh-production.pandata_curated.offers_vouchers` AS v
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_voucher_vendor_entries` AS e
         ON v.uuid = e.offers_voucher_uuid
  WHERE v.created_date_utc >>= "2024-01-01"
    AND NOT v.is_deleted
    AND v.foodpanda_ratio <<>> 100
    AND v.global_entity_id = 'FP_SG'
),

ads_agg AS (
  -- CPC
  SELECT
    global_entity_id,
    vendor_code,
    campaign_date_local AS ad_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__cpc_campaigns_daily`
  WHERE campaign_date_local >>= "2024-01-01"
    AND status = "active"
    AND business_type = "restaurants"
    AND global_entity_id = 'FP_SG'

  UNION ALL

  -- Display ads
  SELECT
    da.global_entity_id,
    CASE
      WHEN advertiser_type = "chain" THEN v.vendor_code
      WHEN advertiser_type = "restaurants" THEN da.advertiser_vendor_code
      ELSE da.advertiser_vendor_code
    END AS vendor_code,
    campaign_date_local AS ad_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__display_ads_campaigns_daily` AS da
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS v
      ON da.global_entity_id = v.global_entity_id
      AND da.advertiser_chain_code = v.chain_code
      AND advertiser_type = "chain"
  WHERE campaign_date_local >>= "2024-01-01"
    AND status = "active"
    AND advertiser_type IN ("restaurants", "chain")
    AND da.global_entity_id = 'FP_SG'

  UNION ALL

  -- Joker
  SELECT
    global_entity_id,
    vendor_code,
    campaign_date_utc AS ad_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__joker_campaigns_daily`
  WHERE campaign_date_utc >>= "2024-01-01"
    AND status = "active"
    AND global_entity_id = 'FP_SG'
),


f30d_deal_ncr_details AS (
  SELECT a.*
       , COALESCE(MAX(a.activation_date_30d BETWEEN d.start_date AND d.end_date), FALSE) AS has_30d_deal
       , COALESCE(MAX(a.activation_date_30d = ads.ad_date), FALSE) AS has_30d_ncr
  FROM incubation_vendor a
  LEFT JOIN deal_agg d
    ON a.vendor_code = d.vendor_code 
    --AND a.activation_date = d.activation_date
  LEFT JOIN ads_agg ads
    ON a.vendor_code = ads.vendor_code
  WHERE a.vendor_grade IN ('AB')
  GROUP BY ALL
),

f30d_deal_ncr_agg AS (
  SELECT 'Weekly' AS granularity
      , DATE_TRUNC(activation_date_30d, ISOWEEK) AS date_
      , COUNT(DISTINCT vendor_code) AS total_ab
      , COUNT(DISTINCT CASE WHEN has_30d_deal AND has_30d_ncr THEN vendor_code END) AS f30d_w_deal_ncr
  FROM f30d_deal_ncr_details
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'Monthly' AS granularity
      , DATE_TRUNC(activation_date_30d, MONTH) AS date_
      , COUNT(DISTINCT vendor_code) AS total_ab
      , COUNT(DISTINCT CASE WHEN has_30d_deal AND has_30d_ncr THEN vendor_code END) AS f30d_w_deal_ncr
  FROM f30d_deal_ncr_details
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'MTD' AS granularity
      , DATE_TRUNC(activation_date_30d, MONTH) AS date_
      , COUNT(DISTINCT vendor_code) AS total_ab
      , COUNT(DISTINCT CASE WHEN has_30d_deal AND has_30d_ncr THEN vendor_code END) AS f30d_w_deal_ncr
  FROM f30d_deal_ncr_details
  WHERE ( (activation_date_30d BETWEEN DATE_SUB(CURRENT_DATE() - 1, INTERVAL 6 MONTH) AND CURRENT_DATE()) OR
          (activation_date_30d BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE() - 1, INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR)))
    AND ((EXTRACT(DAY FROM activation_date_30d) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1) OR
        (EXTRACT(DAY FROM activation_date_30d) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1))
  GROUP BY 1,2
)



SELECT DISTINCT t.*
     , COALESCE(o30.vendor_w_1o, 0) AS onboard_vendor_w_1o
     , COALESCE(o30.total_onboard_vendor,0) AS total_onboard_vendor_1o
     , COALESCE(z.zombie_formed,0) AS zombie_formed
     , COALESCE(z.zombie_revived,0) AS zombie_revived
     , COALESCE(s.acquired_vendor,0) AS acquired_vendor
     , COALESCE(s.sales_rep,0) AS sales_rep_count
     , COALESCE(s.sales_rep_productivity,0) AS sales_rep_productivity
     , COALESCE(dncr.total_ab) AS f30d_total_ab
     , COALESCE(dncr.f30d_w_deal_ncr) AS f30d_ab_w_deal_ncr
FROM transaction_agg t
LEFT JOIN onboarding_agg_30 o30
  ON t.granularity = o30.granularity
  AND t.date_ = o30.date_
LEFT JOIN zombie_data z
  ON t.granularity = z.granularity
  AND t.date_ = z.report_month
LEFT JOIN sales_agg s
  ON t.granularity = s.granularity
  AND t.date_ = s.date_
LEFT JOIN f30d_deal_ncr_agg dncr
  ON t.granularity = dncr.granularity
  AND t.date_ = dncr.date_
ORDER BY 1,2]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
