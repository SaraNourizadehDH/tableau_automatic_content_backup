              <calculation class='tableau' formula='SUM(IF [Calculation_260997733530288275] = &apos;MTD&apos; THEN [ab_gtc] END)/SUM(IF [Calculation_260997733530288275] &lt;&gt; &apos;MTD&apos; THEN [ab_gtc] END)-1' />
            </column>
            <column caption='ROUND(SUM(IF [MTD Tag] = &apos;MTD&apos; AND [source_] = &apos;BD&apos; THEN [tot...' datatype='real' name='[Calculation_260997733533610176]' role='measure' type='quantitative' user:unnamed='Sales - % YoY MTD'>
              <calculation class='tableau' formula='ROUND(SUM(IF [Calculation_260997733530288275] = &apos;MTD&apos; AND [source_] = &apos;BD&apos; THEN [total_activation] END)/ATTR(IF DATETRUNC(&apos;month&apos;,[date_]) &lt;= DATE(&quot;2025-03-01&quot;) THEN 4 ELSE 5 END))/&#10;ROUND(SUM(IF [Calculation_260997733530288275] &lt;&gt; &apos;MTD&apos; AND [source_] = &apos;BD&apos; THEN [total_activation] END)/ATTR(IF DATETRUNC(&apos;month&apos;,[date_]) &lt;= DATE(&quot;2025-03-01&quot;) THEN 4 ELSE 5 END))-1' />
            </column>
