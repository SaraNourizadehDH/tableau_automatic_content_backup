    <worksheet name='VFD - CM vs LM - ALL'>
      <table>
        <view>
          <datasources>
            <datasource caption='VFD' name='federated.0vpf0xs1ynwb3s1f3cyfm071eo4w' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Anchor Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-07-14#'>
              <calculation class='tableau' formula='#2025-07-14#' />
              <range min='#2025-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vpf0xs1ynwb3s1f3cyfm071eo4w'>
            <column caption='Category' datatype='string' name='[Calculation_260997737472418213]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [deal_type] = &apos;AO&apos; OR [deal_type] = &apos;PRO&apos; THEN &apos;Exclude&apos;&#10;ELSEIF [deal_type] = &apos;ALL DEALS&apos; THEN &apos;Deal Util&apos;&#10;ELSEIF [deal_type] = &apos;Penetration - Monthly&apos; OR [deal_type] = &apos;Penetration - Weekly&apos; THEN &apos;Penetration&apos;&#10;ELSEIF CONTAINS([deal_type],&apos;AO&apos;) OR CONTAINS([deal_type], &apos;MANUAL&apos;) OR ([deal_type] = &apos;TIER 1 CAMPAIGN&apos;) THEN &apos;Always On&apos;&#10;ELSEIF CONTAINS([deal_type], &apos;PRO&apos;) OR CONTAINS([deal_type], &apos;DPS FD&apos;) THEN &apos;PRO&apos; &#10;ELSEIF [deal_type] = &apos;JOKER&apos; OR [deal_type] = &apos;DT&apos; THEN &apos;Ad&apos;&#10;ELSE &apos;Exclude&apos; END' />
            </column>
            <column caption='Metrics' datatype='string' name='[Calculation_260997737474687398]' role='dimension' type='nominal'>
