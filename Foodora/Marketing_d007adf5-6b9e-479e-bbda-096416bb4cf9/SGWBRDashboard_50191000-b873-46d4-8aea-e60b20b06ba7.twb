            <column datatype='string' name='[user_tag_platform]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Delivery&quot;' value='OD + VD' />
                <alias key='&quot;Pickup&quot;' value='PU' />
              </aliases>
            </column>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1x8r83q1weqjos1bkxx4g1fmkz1m].[none:Calculation_260997732892627031:nk]'>
