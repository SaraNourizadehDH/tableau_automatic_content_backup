    <worksheet name='MKT - YoY - User'>
      <table>
        <view>
          <datasources>
            <datasource caption='User' name='federated.1x8r83q1weqjos1bkxx4g1fmkz1m' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Anchor Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-07-14#'>
              <calculation class='tableau' formula='#2025-07-14#' />
              <range min='#2025-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1x8r83q1weqjos1bkxx4g1fmkz1m'>
            <column caption='MTD' datatype='boolean' name='[Calculation_260997732892397653]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Current Month for last year&#10;( YEAR([date_]) = YEAR([Parameters].[Parameter 1]) - 1 AND &#10;  DAY([date_]) &gt;= DAY(DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])) AND // ini yg first date&#10;  DAY([date_]) &lt; DAY([Parameters].[Parameter 1]) AND // ini yg end date&#10;  MONTH([date_]) = MONTH([Parameters].[Parameter 1]) ) OR &#10;( [date_] &gt;= DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]) AND // ini yg first date&#10;  [date_] &lt; [Parameters].[Parameter 1])' />
            </column>
            <column caption='MTD Tag' datatype='string' name='[Calculation_260997732892549206]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([date_]) = YEAR(TODAY()) AND [Calculation_260997732892397653] THEN &apos;MTD&apos; ELSE &apos;Last Year&apos; END' />
            </column>
            <column caption='&apos;% YoY Comparison&apos;' datatype='string' name='[Calculation_260997735173702001]' role='dimension' type='nominal' user:unnamed='MKT - YoY - User'>
              <calculation class='tableau' formula='&apos;% YoY Comparison&apos;' />
            </column>
            <column caption='SUM(IF [data_tag] = &apos;QC Trial&apos; AND [MTD Tag] = &apos;MTD&apos; THEN [us...' datatype='real' name='[Calculation_260997735173906804]' role='measure' type='quantitative' user:unnamed='MKT - YoY - User'>
              <calculation class='tableau' formula='SUM(IF [data_tag] = &apos;QC Trial&apos; AND [Calculation_260997732892549206] = &apos;MTD&apos; THEN [user_count] END)/&#10;SUM(IF [data_tag] = &apos;QC Trial&apos; AND [Calculation_260997732892549206] &lt;&gt; &apos;MTD&apos; THEN [user_count] END) -1 ' />
            </column>
            <column caption='SUM(IF CONTAINS([user_tag_platform],&apos;NC&apos;) AND [MTD Tag] = &apos;MT...' datatype='real' name='[Calculation_260997735173992821]' role='measure' type='quantitative' user:unnamed='MKT - YoY - User'>
              <calculation class='tableau' formula='SUM(IF CONTAINS([user_tag_platform],&apos;NC&apos;) AND [Calculation_260997732892549206] = &apos;MTD&apos; THEN [user_count] END)/&#10;SUM(IF CONTAINS([user_tag_platform],&apos;NC&apos;) AND [Calculation_260997732892549206] &lt;&gt; &apos;MTD&apos; THEN [user_count] END) - 1' />
            </column>
            <column caption='SUM(IF CONTAINS([user_tag_platform],&apos;Lost&apos;) AND [MTD Tag] = &apos;...' datatype='real' name='[Calculation_260997735174058358]' role='measure' type='quantitative' user:unnamed='MKT - YoY - User'>
              <calculation class='tableau' formula='SUM(IF CONTAINS([user_tag_platform],&apos;Lost&apos;) AND [Calculation_260997732892549206] = &apos;MTD&apos; THEN [user_count] END)/&#10;SUM(IF CONTAINS([user_tag_platform],&apos;Lost&apos;) AND [Calculation_260997732892549206] &lt;&gt; &apos;MTD&apos; THEN [user_count] END) - 1' />
            </column>
            <column caption='SUM(IF CONTAINS([user_tag_platform],&apos;Churn&apos;) OR  CONTAINS([us...' datatype='real' name='[Calculation_260997735174168951]' role='measure' type='quantitative' user:unnamed='MKT - YoY - User'>
              <calculation class='tableau' formula='SUM(IF CONTAINS([user_tag_platform],&apos;Churn&apos;) OR  CONTAINS([user_tag_platform],&apos;Inactive&apos;) AND [Calculation_260997732892549206] = &apos;MTD&apos; THEN [user_count] END)/&#10;SUM(IF CONTAINS([user_tag_platform],&apos;Churn&apos;) OR  CONTAINS([user_tag_platform],&apos;Inactive&apos;) AND [Calculation_260997732892549206] &lt;&gt; &apos;MTD&apos; THEN [user_count] END) - 1' />
            </column>
            <column caption='((SUM(IF [data_tag] = &apos;EC Reorder Rate&apos; AND [MTD Tag] = &apos;MTD&apos;...' datatype='real' name='[Calculation_260997735174435192]' role='measure' type='quantitative' user:unnamed='MKT - YoY - User'>
              <calculation class='tableau' formula='((SUM(IF [data_tag] = &apos;EC Reorder Rate&apos; AND [Calculation_260997732892549206] = &apos;MTD&apos; THEN [user_count] END)/SUM(IF [data_tag] = &apos;User Tag&apos; AND [Calculation_260997732892549206] = &apos;MTD&apos; THEN [user_count] END))-&#10;(SUM(IF [data_tag] = &apos;EC Reorder Rate&apos; AND [Calculation_260997732892549206] &lt;&gt; &apos;MTD&apos; THEN [user_count] END)/SUM(IF [data_tag] = &apos;User Tag&apos; AND [Calculation_260997732892549206] &lt;&gt; &apos;MTD&apos; THEN [user_count] END)))*100' />
            </column>
            <column caption='SUM(IF [data_tag] = &apos;MAU&apos; AND [MTD Tag] = &apos;MTD&apos; THEN [user_co...' datatype='real' name='[Calculation_260997735672529302]' role='measure' type='quantitative' user:unnamed='MKT - YoY - User'>
              <calculation class='tableau' formula='SUM(IF [data_tag] = &apos;MAU&apos; AND [Calculation_260997732892549206] = &apos;MTD&apos; THEN [user_count] END)/&#10;SUM(IF [data_tag] = &apos;MAU&apos; AND [Calculation_260997732892549206] &lt;&gt; &apos;MTD&apos; THEN [user_count] END) - 1' />
            </column>
