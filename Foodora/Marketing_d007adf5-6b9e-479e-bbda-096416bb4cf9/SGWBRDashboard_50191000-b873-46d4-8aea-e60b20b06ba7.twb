              <calculation class='tableau' formula='#2025-07-14#' />
              <range min='#2025-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nqq65a1ay3fz816klzfl16frlo9'>
            <column caption='Vertical' datatype='string' name='[Calculation_3331678620594413594]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [vertical] = &apos;OD&apos; OR [vertical] = &apos;VD&apos; THEN &apos;OD + VD&apos; &#10;ELSE [vertical] END' />
            </column>
            <column caption='SUM(IF [vertical] = &apos;OD&apos; THEN [delivery_fee] ELSE 0 END)/SUM(...' datatype='real' name='[Calculation_3331678620594675740]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='SUM(IF [vertical] = &apos;OD&apos; THEN [delivery_fee] ELSE 0 END)/SUM(IF [vertical] = &apos;OD&apos; THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='LM Boolean' datatype='boolean' name='[Calculation_3331678620595990561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[ordered_at_date_local]) = DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='&apos;Last Month&apos;' datatype='string' name='[Calculation_3331678620596695077]' role='dimension' type='nominal' user:unnamed='Weekly (2)'>
              <calculation class='tableau' formula='&apos;Last Month&apos;' />
            </column>
            <column caption='SUM([fp_df_cost])/SUM(IF vertical &lt;&gt; &apos;PU&apos; THEN [orders] END)' datatype='real' name='[Calculation_3331678620748722249]' role='measure' type='quantitative' user:unnamed='Last Month'>
              <calculation class='tableau' formula='SUM([fp_df_cost])/SUM(IF vertical &lt;&gt; &apos;PU&apos; THEN [orders] END)' />
            </column>
            <column caption='SUM(IF [vertical] &lt;&gt; &apos;PU&apos; THEN [fp_deal_cost] ELSE 0 END + [f...' datatype='real' name='[Calculation_3331678620840448134]' role='measure' type='quantitative' user:unnamed='Last Month - Food'>
              <calculation class='tableau' formula='SUM(IF [vertical] &lt;&gt; &apos;PU&apos; THEN [fp_deal_cost] ELSE 0 END + [fp_funded_voucher])/SUM([orders])' />
            </column>
            <column caption='total_incentive' datatype='real' name='[Calculation_3636234545997357058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical] &lt;&gt; &apos;PU&apos; THEN [fp_funded_voucher] + [fp_deal_cost] ELSE [fp_funded_voucher] END' />
            </column>
            <column caption='SUM([total_incentive])/SUM([gmv])' datatype='real' name='[Calculation_3636234546003775501]' role='measure' type='quantitative' user:unnamed='Last Month - Food'>
