            <column caption='Weekly Tag' datatype='string' name='[Calculation_260997732892627031]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[date_]) = DATEADD(&apos;week&apos;,-1,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;LW&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[date_]) = DATEADD(&apos;week&apos;,-2,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L2W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[date_]) = DATEADD(&apos;week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L5W&apos;&#10;ELSE &apos;Exclude&apos; END' />
            </column>
            <column caption='SUM(IF CONTAINS([user_tag_platform],&apos;NC&apos;) THEN [user_count] END)' datatype='real' name='[Calculation_260997735154831659]' role='measure' type='quantitative' user:unnamed='MKT - LM - User'>
              <calculation class='tableau' formula='SUM(IF CONTAINS([user_tag_platform],&apos;NC&apos;) THEN [user_count] END)' />
            </column>
            <column caption='SUM(IF CONTAINS([user_tag_platform],&apos;Churn&apos;) OR  CONTAINS([us...' datatype='real' name='[Calculation_260997735155495218]' role='measure' type='quantitative' user:unnamed='MKT - LM - User'>
              <calculation class='tableau' formula='SUM(IF CONTAINS([user_tag_platform],&apos;Churn&apos;) OR  CONTAINS([user_tag_platform],&apos;Inactive&apos;) THEN [user_count] END)' />
