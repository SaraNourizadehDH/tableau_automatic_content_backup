            <column-instance column='[Blank 1 (copy) (copy) (copy) (copy)_3331678620810285184]' derivation='Sum' name='[sum:Blank 1 (copy) (copy) (copy) (copy)_3331678620810285184:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Blank 1 (copy) (copy) (copy)_3331678620810281087]' derivation='Sum' name='[sum:Blank 1 (copy) (copy) (copy)_3331678620810281087:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Blank 1 (copy) (copy)_3331678620810268798]' derivation='Sum' name='[sum:Blank 1 (copy) (copy)_3331678620810268798:qk]' pivot='key' type='quantitative' />
