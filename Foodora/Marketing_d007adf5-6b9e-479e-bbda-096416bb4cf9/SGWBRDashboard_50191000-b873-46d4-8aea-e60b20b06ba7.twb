      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0vpf0xs1ynwb3s1f3cyfm071eo4w].[sum:Calculation_444167579270340638:qk]&quot;' value='% VFD / GMV Penetration' />
          <alias key='&quot;[federated.0vpf0xs1ynwb3s1f3cyfm071eo4w].[usr:Calculation_2095862693068894222:qk]&quot;' value='% VFD / GMV ' />
          <alias key='&quot;[federated.0vpf0xs1ynwb3s1f3cyfm071eo4w].[usr:Calculation_444167579275538480:qk]&quot;' value='% VFD / GMV Always On' />
          <alias key='&quot;[federated.0vpf0xs1ynwb3s1f3cyfm071eo4w].[usr:Calculation_444167579275714610:qk]&quot;' value='% VFD / GMV' />
          <alias key='&quot;[federated.0vpf0xs1ynwb3s1f3cyfm071eo4w].[usr:Calculation_5395030895103901697:qk]&quot;' value='% VFD / GMV Penetration ' />
          <alias key='&quot;[federated.0vpf0xs1ynwb3s1f3cyfm071eo4w].[usr:Calculation_55239491561807904:qk]&quot;' value='% PRO VFD / PRO GMV' />
          <alias key='&quot;[federated.0vpf0xs1ynwb3s1f3cyfm071eo4w].[usr:Calculation_55239491988848710:qk]&quot;' value='% PRO VFD / PRO GMV ' />
          <alias key='&quot;[federated.0vpf0xs1ynwb3s1f3cyfm071eo4w].[usr:Calculation_55239492308250762:qk]&quot;' value='% Deal Utilisation' />
        </aliases>
      </column>
      <column caption='Weekly Tag' datatype='string' name='[CW (copy)_3331678620590084106]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[created_date]) = DATEADD(&apos;week&apos;,-1,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;LW&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[created_date]) = DATEADD(&apos;week&apos;,-2,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L2W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[created_date]) = DATEADD(&apos;week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L5W&apos;&#10;ELSE &apos;Exclude&apos; END' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_2095862693066792965]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [deal_type] = &apos;Penetration - Monthly&apos; OR [deal_type] = &apos;Penetration - Weekly&apos; THEN [vfd] END)/SUM(IF [deal_type] = &apos;Penetration - Monthly&apos; OR [deal_type] = &apos;Penetration - Weekly&apos; THEN [gmv] END)' />
      </column>
      <column caption='Category' datatype='string' name='[Calculation_260997737472418213]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [deal_type] = &apos;AO&apos; OR [deal_type] = &apos;PRO&apos; THEN &apos;Exclude&apos;&#10;ELSEIF [deal_type] = &apos;ALL DEALS&apos; THEN &apos;Deal Util&apos;&#10;ELSEIF [deal_type] = &apos;Penetration - Monthly&apos; OR [deal_type] = &apos;Penetration - Weekly&apos; THEN &apos;Penetration&apos;&#10;ELSEIF CONTAINS([deal_type],&apos;AO&apos;) OR CONTAINS([deal_type], &apos;MANUAL&apos;) OR ([deal_type] = &apos;TIER 1 CAMPAIGN&apos;) THEN &apos;Always On&apos;&#10;ELSEIF CONTAINS([deal_type], &apos;PRO&apos;) OR CONTAINS([deal_type], &apos;DPS FD&apos;) THEN &apos;PRO&apos; &#10;ELSEIF [deal_type] = &apos;JOKER&apos; OR [deal_type] = &apos;DT&apos; THEN &apos;Ad&apos;&#10;ELSE &apos;Exclude&apos; END' />
      </column>
      <column caption='Metrics' datatype='string' name='[Calculation_260997737474687398]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [deal_type] &#10;WHEN &apos;AO - CATEGORY&apos; THEN &apos;Menu + FD + Category&apos;&#10;WHEN &apos;AO - FREE DELIVERY&apos; THEN &apos;Menu + FD + Category&apos;&#10;WHEN &apos;AO - FULL MENU&apos; THEN &apos;Menu + FD + Category&apos;&#10;WHEN &apos;AO - VOUCHER&apos; THEN &apos;Menu + FD + Category&apos;&#10;WHEN &apos;MANUAL - DF CAMPAIGN&apos; THEN &apos;$1.99&apos;&#10;WHEN &apos;TIER 1 CAMPAIGN&apos; THEN &apos;Tier 1 Campaign&apos;&#10;WHEN &apos;MANUAL - DEAL STRIKETHROUGH&apos; THEN &apos;Deal Strikethrough&apos;&#10;WHEN &apos;DPS FD&apos; THEN &apos;Delivery Fee Discount&apos;&#10;WHEN &apos;PRO - DISCOUNT&apos; THEN &apos;Menu&apos;&#10;WHEN &apos;PRO - VOUCHER&apos; THEN &apos;Menu&apos;&#10;WHEN &apos;JOKER&apos; THEN &apos;Joker&apos;&#10;WHEN &apos;DT&apos; THEN &apos;Targeted&apos;&#10;END' />
      </column>
      <column caption='LM Boolean' datatype='boolean' name='[Calculation_3331678620595990561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[created_date]) = DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='MTD' datatype='boolean' name='[Calculation_3331678620596895782]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Previous Month for Current Year&#10;( // YEAR([created_date]) = YEAR([Anchor Date]) - 1 AND &#10;  DAY([created_date]) &gt;= DAY(DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])) AND // ini yg first date&#10;  DAY([created_date]) &lt; DAY([Parameters].[Parameter 1]) AND // ini yg end date&#10;  MONTH([created_date]) = MONTH(DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])) ) OR &#10;( [created_date] &gt;= DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]) AND // ini yg first date&#10;  [created_date] &lt; [Parameters].[Parameter 1])' />
      </column>
      <column caption='MTD Tag' datatype='string' name='[Calculation_3331678620598308904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF MONTH([created_date]) = MONTH(TODAY()) AND [Calculation_3331678620596895782] THEN &apos;MTD&apos; ELSE &apos;LM&apos; END' />
      </column>
      <column aggregation='Sum' caption='Monthly GMV' datatype='real' name='[Calculation_444167579233705984]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED  DATETRUNC(&apos;month&apos;, created_date), [deal_type], [Calculation_260997737472418213], [Calculation_3331678620595990561] : SUM(gmv) }' />
      </column>
      <column caption='Daily GMV' datatype='real' name='[Calculation_444167579240620038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [created_date] : MAX([gmv]) }' />
      </column>
      <column caption='Blank' datatype='integer' name='[Calculation_444167579270340638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Daily GMV PRO' datatype='real' name='[Daily GMV (copy)_55239491561705502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [created_date] : MAX([gmv_pro]) }' />
      </column>
