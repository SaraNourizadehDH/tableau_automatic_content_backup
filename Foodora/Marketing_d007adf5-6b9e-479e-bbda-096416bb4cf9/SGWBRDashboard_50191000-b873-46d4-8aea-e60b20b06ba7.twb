      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_BEA23E084FD6476E9ADEB9104CDCE137'>
            <properties context=''>
              <relation connection='bigquery.1qwtwce052qfqn17npslm01ewyw1' name='Custom SQL Query' type='text'><![CDATA[-- last month tag
-- weekly tag
-- MTD

WITH pro_new_cvp_orders AS (
  SELECT billing.order_code AS order_id
       , MAX(IFNULL(gross_delivery_fee_discount_platform_local, 0)) OVER(PARTITION BY billing.order_code) AS platform_incentive_gross
       , MAX(IFNULL(gross_delivery_fee_discount_vendor_local, 0)) OVER(PARTITION BY billing.order_code) AS vendor_incentive_gross
       , MAX(IFNULL(net_delivery_fee_discount_platform_local, 0)) OVER(PARTITION BY billing.order_code) AS platform_incentive_net
       , MAX(IFNULL(net_delivery_fee_discount_vendor_local, 0)) OVER(PARTITION BY billing.order_code) AS vendor_incentive_net

  FROM `fulfillment-dwh-production.pandata_curated.billing_engine_workflow_sap_orders` billing

  JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` pd
    ON billing.order_code = pd.code
    AND pd.global_entity_id = 'FP_SG'
    AND pd.ordered_at_date_local >>= DATE("2023-01-01")

  JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` acc
    ON CONCAT(pd.global_entity_id, "_", pd.code) = CONCAT(acc.global_entity_id, "_", acc.order_code)
    AND acc.global_entity_id = 'FP_SG'
    AND acc.created_date_utc  >>= DATE("2023-01-01")

  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` dps
    ON billing.order_code = dps.platform_order_code
    AND dps.country_code = 'sg'
    AND dps.created_date  >>= DATE("2023-01-01")

  WHERE billing.global_entity_id = 'FP_SG'
    AND billing.created_date_utc >>= DATE("2023-01-01")
    AND pd.is_valid_order = TRUE
    AND pd.is_subscriber_order = TRUE
    AND acc.pd_order_fees_delivery_fee_adjustment_plus_vat_local << 0
    AND IFNULL(has_new_customer_condition, FALSE) = FALSE
    AND pd.business_type_apac IN ('restaurants', 'street_food', 'caterers')

  QUALIFY ROW_NUMBER() OVER(PARTITION BY billing.order_code) = 1
),

dps_df AS (
  SELECT DISTINCT dps.platform_order_code 
      , o.uuid AS order_uuid
      , CASE WHEN (ROUND(o.delivery_fee_original_local + IFNULL(ABS(pd_order_fees_delivery_fee_adjustment_plus_vat_local), 0), 2) = 1.99) OR
                  (v.vendor_name LIKE ("%Burger King%") AND DATE_TRUNC(o.ordered_at_date_local, MONTH) = DATE("2024-11-01")) THEN 2 + ROUND(o.delivery_fee_original_local + IFNULL(ABS(pd_order_fees_delivery_fee_adjustment_plus_vat_local), 0), 2)
          ELSE ROUND(o.delivery_fee_original_local + IFNULL(ABS(pd_order_fees_delivery_fee_adjustment_plus_vat_local), 0), 2) END AS original_df 
      , campaign_id
      , o.business_type_apac IN ('restaurant','restaurants','street_food') AS is_resto
      , a.is_first_valid_order_platform AND o.delivery_fee_local = 0 AS is_resto_fdntv

  FROM `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` dps
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` o 
    ON dps.platform_order_code = o.code
    AND dps.entity_id = o.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders_agg_acquisition` a 
    ON o.uuid = a.uuid 
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` v 
    ON o.vendor_code = v.vendor_code
    AND o.global_entity_id = v.global_entity_id 
  LEFT JOIN (`fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` acc
  JOIN UNNEST(accounting) AS accounting)
    ON o.code = acc.order_code
    AND o.global_entity_id = acc.global_entity_id
    AND acc.global_entity_id = 'FP_SG'
    AND  acc.created_date_utc >>= '2022-12-01'
    AND accounting.is_order_last_entry = TRUE
  WHERE o.is_valid_order 
    AND dps.entity_id = 'FP_SG'
    AND o.ordered_at_date_local >>= DATE("2023-01-01")
    AND o.global_entity_id = 'FP_SG'
    AND NOT o.is_pickup
),

dmart_hva_fd AS (
  SELECT DISTINCT order_uuid, original_df
  FROM dps_df 
  WHERE campaign_id = 1246
),

shop_hva_fd AS (
  SELECT order_uuid, original_df / 2 AS original_df 
  FROM dps_df 
  WHERE campaign_id IN (1230, 1287)
),

food_hva_fd AS (
  SELECT order_uuid, original_df 
  FROM dps_df 
  WHERE campaign_id = 1229
),

food_hva_fdnc AS (
  SELECT order_uuid, original_df 
  FROM dps_df 
  WHERE is_resto AND is_resto_fdntv
),

voucher_vert_count AS (
  SELECT DISTINCT crm_campaign_id
       , COUNT(DISTINCT vt) AS vertical_count
       , STRING_AGG(DISTINCT vt) AS vertical_list
       , CASE WHEN COUNT(DISTINCT vt) = 1 AND  STRING_AGG(DISTINCT vt) = 'darkstores' THEN TRUE ELSE FALSE END AS dmart_tag
  FROM `fulfillment-dwh-production.pandata_curated.offers_vouchers` v, UNNEST(vertical_types) vt
  WHERE v.created_date_utc >> "2022-12-31"
    AND v.global_entity_id = 'FP_SG'
    AND v.channel NOT IN ("channel_customer_service","channel_rider_rewards","channel_influencers")
    AND v.purpose <<>> 'sorry_panda'
  GROUP BY 1
),

voucher_list_dmart_only AS (
  SELECT * 
  FROM (
    SELECT DISTINCT v.uuid AS pd_voucher_uuid
          , CASE WHEN ((LOWER(v.description) LIKE "%mart%" AND LOWER(v.description) NOT LIKE "%shops%") OR LOWER(v.voucher_code) LIKE "martday" OR LOWER(v.voucher_code) LIKE "%tengah%" OR LOWER(v.voucher_code) LIKE "%bright%" OR vc.dmart_tag = TRUE OR UPPER(v.voucher_code) = 'MARTFEST' OR UPPER(v.voucher_code) = 'MARTXL') THEN TRUE ELSE FALSE END AS is_dmart_only

    FROM `fulfillment-dwh-production.pandata_curated.offers_vouchers` v
    LEFT JOIN voucher_vert_count vc
      ON v.crm_campaign_id = vc.crm_campaign_id

    WHERE v.created_date_utc >> "2021-12-20"
      AND v.global_entity_id = 'FP_SG'
      AND v.channel NOT IN ("channel_customer_service","channel_rider_rewards","channel_influencers")
      AND v.purpose not in ('sorry_panda', 'compensation', 'autocompensation_realtime')
  ) WHERE  is_dmart_only
),

pro_dmart_voucher AS (
  SELECT DISTINCT uuid
  FROM `fulfillment-dwh-production.pandata_curated.offers_vouchers`
  WHERE global_entity_id = 'FP_SG'
    AND created_Date_utc >> DATE("2024-01-01")
    AND is_subscription_voucher
    AND type = 'free_delivery'
    AND description = 'pandamart vouchers'
),

order_details AS (
  SELECT DISTINCT o.ordered_at_date_local
        , DATE_TRUNC(o.ordered_at_date_local, ISOWEEK) AS week_
        , DATE_TRUNC(o.ordered_at_date_local, MONTH) AS month_

        , o.uuid AS order_uuid 
        , o.is_own_delivery
        , o.business_type_apac
        , CASE WHEN o.business_type_apac = 'darkstores' THEN 'Dmart'
                WHEN o.is_pickup THEN 'PU'
                WHEN o.business_type_apac IN ('restaurant', 'restaurants', 'street_food') AND o.is_own_delivery THEN 'OD'
                WHEN o.business_type_apac IN ('restaurant', 'restaurants', 'street_food') AND NOT o.is_own_delivery THEN 'VD'
            ELSE 'Shops' END AS vertical

        , a.gmv_net_local
        , a.gmv_local

        , COALESCE(CASE WHEN o.voucher_type <<>> 'free_delivery' THEN o.voucher_amount_local*(o.voucher_attributions_foodpanda_ratio/100) ELSE 0 END,0) AS fp_funded_voucher
        , COALESCE(CASE WHEN o.discount_type <<>> 'free_delivery' THEN o.discount_amount_local*(o.discount_attributions_foodpanda_ratio/100) ELSE 0 END,0) AS fp_funded_deal

        , COALESCE(CASE WHEN o.voucher_type = 'free_delivery' THEN o.voucher_amount_local*(o.voucher_attributions_foodpanda_ratio/100) ELSE 0 END,0) AS fp_funded_voucher_df
        , COALESCE(CASE WHEN o.discount_type = 'free_delivery' THEN o.discount_amount_local*(o.discount_attributions_foodpanda_ratio/100) ELSE 0 END,0) AS fp_funded_deal_df
        , COALESCE(pro.platform_incentive_net,0) AS fp_funded_deal_df_pro

        , COALESCE(dmart_fd.original_df,0) AS fp_funded_dmart_df
        , COALESCE(shop_fd.original_df,0) AS fp_funded_shop_df 
        , COALESCE(food_fd.original_df,0) + COALESCE(food_fdnc.original_df,0) AS fp_funded_food_df

        , o.is_subscriber_order
        , o.pd_customer_uuid

        , vd.pd_voucher_uuid IS NOT NULL AS voucher_is_dmart_only 

        , o.delivery_fee_local -- + CASE WHEN onn.code IS NOT NULL THEN onn.df_campaign_vf_gross ELSE 0 END AS delivery_fee_local -- + CASE WHEN dp.uuid IS NOT NULL THEN o.voucher_amount_local*(o.voucher_attributions_foodpanda_ratio/100) ELSE 0 END AS delivery_fee_local

    FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` o
    LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` a 
      ON o.uuid = a.uuid 
      AND o.global_entity_id = a.global_entity_id
      AND a.created_date_utc >> DATE("2023-12-01")
    LEFT JOIN pro_new_cvp_orders pro
      ON o.code = pro.order_id

    --LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_additional_vf_df_revenue` onn 
    --  ON o.code = onn.code 

    LEFT JOIN dmart_hva_fd AS dmart_fd
      ON o.uuid = dmart_fd.order_uuid
    LEFT JOIN shop_hva_fd AS shop_fd
      ON o.uuid = shop_fd.order_uuid
    LEFT JOIN food_hva_fd AS food_fd
      ON o.uuid = food_fd.order_uuid
    LEFT JOIN food_hva_fdnc AS food_fdnc
      ON o.uuid = food_fdnc.order_uuid

    LEFT JOIN voucher_list_dmart_only vd
      ON o.pd_voucher_uuid = vd.pd_voucher_uuid
    /*
    LEFT JOIN dmart_pro_voucher dp 
      ON o.pd_voucher_uuid = dp.uuid
    */

    WHERE is_valid_order 
      AND ( (o.ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
            (o.ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
),

dmart_voucher_roo_details AS (
  SELECT ordered_at_date_local
       , voucher_is_dmart_only
       , SUM(fp_funded_voucher) AS dmart_fp_voucher
  FROM order_details
  WHERE vertical = 'Dmart'
  GROUP BY 1,2
),

shops_voucher_cost AS (
  SELECT o.ordered_at_date_local 
      , SUM(fp_funded_voucher) AS shops_fp_voucher
  FROM order_details o
  WHERE o.vertical = 'Shops'
  GROUP BY 1
),

roo_voucher AS (
  SELECT DISTINCT s.ordered_at_date_local
      , s.shops_fp_voucher + r.dmart_fp_voucher AS shop_voucher_cost
      , dmart_only.dmart_fp_voucher AS dmart_voucher_cost
  FROM shops_voucher_cost s
  LEFT JOIN dmart_voucher_roo_details r
    ON s.ordered_at_date_local = r.ordered_at_date_local 
    AND NOT r.voucher_is_dmart_only
  LEFT JOIN dmart_voucher_roo_details dmart_only
    ON s.ordered_at_date_local = dmart_only.ordered_at_date_local 
    AND dmart_only.voucher_is_dmart_only
),

daily_agg AS (
  SELECT ordered_at_date_local
      , vertical 
      , COUNT(DISTINCT order_uuid) AS orders
      , SUM(gmv_net_local) AS gmv_net
      , SUM(gmv_local) AS gmv
      -- SUM(CASE WHEN vertical IN ('Dmart') AND voucher_is_dmart_only THEN fp_funded_voucher END) + SUM(CASE WHEN vertical IN ('Dmart') THEN fp_funded_deal END)
      --, SUM(CASE WHEN vertical = 'Dmart' AND voucher_is_dmart_only THEN fp_funded_voucher ELSE 0 END) AS 
      , SUM(fp_funded_voucher) AS fp_funded_voucher
      , SUM(fp_funded_deal) AS fp_deal_cost
      , SUM(fp_funded_voucher_df + fp_funded_deal_df + fp_funded_deal_df_pro + IF(vertical NOT IN ('Dmart', 'Shops'), fp_funded_food_df,0) + IF(vertical IN ('Dmart'), fp_funded_dmart_df,0) +IF(vertical IN ('Shops'), fp_funded_shop_df,0)) AS fp_df_cost
      , SUM(delivery_fee_local) AS delivery_fee
      , SUM(CASE WHEN is_subscriber_order THEN gmv_local END) AS pro_gmv
      , SUM(CASE WHEN is_subscriber_order THEN gmv_net_local END) AS pro_gmv_net

  FROM order_details
  GROUP BY 1,2
)

SELECT d.* EXCEPT(fp_funded_voucher)
     , CASE WHEN d.vertical = 'Shops' THEN roo.shop_voucher_cost 
            WHEN d.vertical = 'Dmart' THEN roo.dmart_voucher_cost
        ELSE d.fp_funded_voucher END AS fp_funded_voucher
FROM daily_agg d
LEFT JOIN roo_voucher roo
  ON d.ordered_at_date_local = roo.ordered_at_date_local]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
