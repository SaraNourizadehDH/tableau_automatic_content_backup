            <column caption='SUM(IF [Vertical (copy)] = &apos;QC&apos; THEN [gmv_net] END)/SUM([gmv_...' datatype='real' name='[Calculation_55239492003213390]' role='measure' type='quantitative' user:unnamed='[ABC] Last Month - QC'>
              <calculation class='tableau' formula='SUM(IF [Vertical (copy)_260997735705039265] = &apos;QC&apos; THEN [gmv_net] END)/SUM([gmv_net])' />
            </column>
            <column caption='SUM([pro_gmv_net])/SUM([gmv_net])' datatype='real' name='[Calculation_942589353584164876]' role='measure' type='quantitative' user:unnamed='[ABC] Last Month - QC'>
              <calculation class='tableau' formula='SUM([pro_gmv_net])/SUM([gmv_net])' />
            </column>
            <column caption='Vertical (copy)' datatype='string' name='[Vertical (copy)_260997735705039265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [vertical] = &apos;Shops&apos; OR [vertical] = &apos;Dmart&apos; THEN &apos;QC&apos; &#10;ELSE [vertical] END' />
            </column>
