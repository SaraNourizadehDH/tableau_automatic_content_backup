            <column caption='SUM(IF [Vertical (copy)] = &apos;QC&apos; THEN [gmv_net] END)/SUM([gmv_...' datatype='real' name='[Calculation_55239492005879908]' role='measure' type='quantitative' user:unnamed='[ABC] YoY Comparison - QC'>
              <calculation class='tableau' formula='SUM(IF [Vertical (copy)_260997735705039265] = &apos;QC&apos; THEN [gmv_net] END)/SUM([gmv_net])' />
            </column>
            <column caption='SUM([pro_gmv_net])/SUM([gmv_net])' datatype='real' name='[Calculation_942589353584496656]' role='measure' type='quantitative' user:unnamed='[ABC] YoY Comparison - QC'>
