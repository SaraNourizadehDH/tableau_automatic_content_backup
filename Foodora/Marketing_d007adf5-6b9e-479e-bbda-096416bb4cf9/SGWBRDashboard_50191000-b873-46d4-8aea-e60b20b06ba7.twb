            <column caption='(SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [fp_deal_cost] + [fp_funded_...' datatype='real' name='[Calculation_260997732593205303]' role='measure' type='quantitative' user:unnamed='Weekly - LW vs L2W - QC'>
              <calculation class='tableau' formula='(SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [fp_deal_cost] + [fp_funded_voucher] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [orders] END))&#10;/&#10;(SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [fp_deal_cost] + [fp_funded_voucher] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [orders] END))-1' />
