      <column caption='LM Boolean' datatype='boolean' name='[Calculation_260997732892278868]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;,[date_]) = DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='MTD' datatype='boolean' name='[Calculation_260997732892397653]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Current Month for last year&#10;( YEAR([date_]) = YEAR([Parameters].[Parameter 1]) - 1 AND &#10;  DAY([date_]) &gt;= DAY(DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])) AND // ini yg first date&#10;  DAY([date_]) &lt; DAY([Parameters].[Parameter 1]) AND // ini yg end date&#10;  MONTH([date_]) = MONTH([Parameters].[Parameter 1]) ) OR &#10;( [date_] &gt;= DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]) AND // ini yg first date&#10;  [date_] &lt; [Parameters].[Parameter 1])' />
      </column>
      <column caption='MTD Tag' datatype='string' name='[Calculation_260997732892549206]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF YEAR([date_]) = YEAR(TODAY()) AND [Calculation_260997732892397653] THEN &apos;MTD&apos; ELSE &apos;Last Year&apos; END' />
      </column>
      <column caption='Weekly Tag' datatype='string' name='[Calculation_260997732892627031]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[date_]) = DATEADD(&apos;week&apos;,-1,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;LW&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[date_]) = DATEADD(&apos;week&apos;,-2,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L2W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[date_]) = DATEADD(&apos;week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L5W&apos;&#10;ELSE &apos;Exclude&apos; END' />
      </column>
      <column caption='Blank 1' datatype='integer' name='[Calculation_260997735160664376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
