              <calculation class='tableau' formula='SUM(IF [Calculation_260997732892549206] = &apos;MTD&apos; AND [data_tag] = &apos;MAU by Vertical&apos; AND [user_tag_platform] = &apos;Pickup&apos; THEN [user_count] END)/&#10;SUM(IF [Calculation_260997732892549206] &lt;&gt; &apos;MTD&apos; AND [data_tag] = &apos;MAU by Vertical&apos; AND [user_tag_platform] = &apos;Pickup&apos; THEN [user_count] END)-1' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_260997732892397653]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Current Month for last year&#10;( YEAR([date_]) = YEAR([Parameters].[Parameter 1]) - 1 AND &#10;  DAY([date_]) &gt;= DAY(DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])) AND // ini yg first date&#10;  DAY([date_]) &lt; DAY([Parameters].[Parameter 1]) AND // ini yg end date&#10;  MONTH([date_]) = MONTH([Parameters].[Parameter 1]) ) OR &#10;( [date_] &gt;= DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]) AND // ini yg first date&#10;  [date_] &lt; [Parameters].[Parameter 1])' />
            </column>
            <column caption='MTD Tag' datatype='string' name='[Calculation_260997732892549206]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([date_]) = YEAR(TODAY()) AND [Calculation_260997732892397653] THEN &apos;MTD&apos; ELSE &apos;Last Year&apos; END' />
            </column>
            <column caption='((SUM(IF [MTD Tag] = &apos;MTD&apos; AND [data_tag] = &apos;MAU&apos; AND [user_t...' datatype='real' name='[Calculation_260997735052390658]' role='measure' type='quantitative' user:unnamed='[ABC] MAU - YoY'>
              <calculation class='tableau' formula='((SUM(IF [Calculation_260997732892549206] = &apos;MTD&apos; AND [data_tag] = &apos;MAU&apos; AND [user_tag_platform] = &apos;Has QC&apos; THEN [user_count] END)/SUM(IF [Calculation_260997732892549206] = &apos;MTD&apos; AND data_tag = &apos;MAU&apos; THEN [user_count] END)) - &#10;(SUM(IF [Calculation_260997732892549206] &lt;&gt; &apos;MTD&apos; AND [data_tag] = &apos;MAU&apos; AND [user_tag_platform] = &apos;Has QC&apos; THEN [user_count] END)/SUM(IF [Calculation_260997732892549206] &lt;&gt; &apos;MTD&apos; AND data_tag = &apos;MAU&apos; THEN [user_count] END)))*100' />
            </column>
