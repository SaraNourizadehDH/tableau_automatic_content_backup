            <column caption='MTD' datatype='boolean' name='[Calculation_260997733530214546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Current Month for last year&#10;( YEAR([date_]) = YEAR([Parameters].[Parameter 1]) - 1 AND &#10;  DAY([date_]) &gt;= DAY(DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])) AND // ini yg first date&#10;  DAY([date_]) &lt; DAY([Parameters].[Parameter 1]) AND // ini yg end date&#10;  MONTH([date_]) = MONTH([Parameters].[Parameter 1]) ) OR &#10;( [date_] &gt;= DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]) AND // ini yg first date&#10;  [date_] &lt; [Parameters].[Parameter 1])' />
            </column>
            <column caption='MTD Tag' datatype='string' name='[Calculation_260997733530288275]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([date_]) = YEAR(TODAY()) AND [Calculation_260997733530214546] THEN &apos;MTD&apos; ELSE &apos;Last Year&apos; END' />
            </column>
            <column caption='ROUND(SUM(IF [source_] = &apos;BD&apos; THEN [total_activation] END)/AT...' datatype='real' name='[Calculation_260997733533122743]' role='measure' type='quantitative' user:unnamed='Sales - MTD'>
              <calculation class='tableau' formula='ROUND(SUM(IF [source_] = &apos;BD&apos; THEN [total_activation] END)/ATTR(IF DATETRUNC(&apos;month&apos;,[date_]) &lt;= DATE(&quot;2024-03-01&quot;) THEN 4 ELSE 5 END))' />
            </column>
            <column caption='ROUND(SUM(IF [source_] = &apos;BD&apos; THEN [total_activation] END)' datatype='real' name='[Calculation_260997735417872775]' role='measure' type='quantitative' user:unnamed='Sales - MTD'>
              <calculation class='tableau' formula='ROUND(SUM(IF [source_] = &apos;BD&apos; THEN [total_activation] END)' />
            </column>
            <column caption='ROUND(SUM(IF [source_] = &apos;BD&apos; THEN [total_activation] END)/SU...' datatype='real' name='[Calculation_4265401457456435210]' role='measure' type='quantitative' user:unnamed='Sales - MTD'>
              <calculation class='tableau' formula='ROUND(SUM(IF [source_] = &apos;BD&apos; THEN [total_activation] END)/SUM(8))' />
            </column>
