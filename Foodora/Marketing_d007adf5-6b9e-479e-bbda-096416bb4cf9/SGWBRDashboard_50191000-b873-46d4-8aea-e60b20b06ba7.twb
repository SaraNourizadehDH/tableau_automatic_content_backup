    <worksheet name='[ABC] MAU - L2W vs LW'>
      <table>
        <view>
          <datasources>
            <datasource caption='User' name='federated.1x8r83q1weqjos1bkxx4g1fmkz1m' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Anchor Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-07-14#'>
              <calculation class='tableau' formula='#2025-07-14#' />
              <range min='#2025-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1x8r83q1weqjos1bkxx4g1fmkz1m'>
            <column caption='SUM(IF [Weekly Tag] = &apos;LW&apos; AND data_tag = &apos;MAU by Vertical&apos; A...' datatype='real' name='[Calculation_123919383785418763]' role='measure' type='quantitative' user:unnamed='[ABC] MAU - L2W vs LW'>
              <calculation class='tableau' formula='SUM(IF [Calculation_260997732892627031] = &apos;LW&apos; AND data_tag = &apos;MAU by Vertical&apos; AND [user_tag_platform] = &apos;Pickup&apos; THEN [user_count] END)/&#10;SUM(IF [Calculation_260997732892627031] = &apos;L2W&apos; AND data_tag = &apos;MAU by Vertical&apos; AND [user_tag_platform] = &apos;Pickup&apos; THEN [user_count] END)-1' />
            </column>
            <column caption='Weekly Tag' datatype='string' name='[Calculation_260997732892627031]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[date_]) = DATEADD(&apos;week&apos;,-1,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;LW&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[date_]) = DATEADD(&apos;week&apos;,-2,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L2W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[date_]) = DATEADD(&apos;week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L5W&apos;&#10;ELSE &apos;Exclude&apos; END' />
            </column>
            <column caption='&quot;LW vs L2W&quot;' datatype='string' name='[Calculation_260997732900286568]' role='dimension' type='nominal' user:unnamed='[ABC] MAU - L2W vs LW'>
              <calculation class='tableau' formula='&quot;LW vs L2W&quot;' />
