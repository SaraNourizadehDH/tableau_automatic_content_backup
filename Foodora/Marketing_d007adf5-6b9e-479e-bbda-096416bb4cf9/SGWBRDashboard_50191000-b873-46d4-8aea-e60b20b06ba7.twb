    <worksheet name='YoY Comparison Perc - Food'>
      <table>
        <view>
          <datasources>
            <datasource caption='Order' name='federated.1nqq65a1ay3fz816klzfl16frlo9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Anchor Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-07-14#'>
              <calculation class='tableau' formula='#2025-07-14#' />
              <range min='#2025-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nqq65a1ay3fz816klzfl16frlo9'>
            <column caption='SUM(IF [MTD Tag] = &apos;MTD&apos; THEN [gmv_net] END)/SUM(IF [MTD Tag]...' datatype='real' name='[Calculation_260997732836872263]' role='measure' type='quantitative' user:unnamed='YoY Comparison Perc - Food'>
              <calculation class='tableau' formula='SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [gmv_net] END)/SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [gmv_net] END)-1' />
            </column>
            <column caption='((SUM(IF [MTD Tag] = &apos;MTD&apos; THEN [total_incentive] END)/SUM(IF...' datatype='real' name='[Calculation_260997735049928937]' role='measure' type='quantitative' user:unnamed='YoY Comparison Perc - Food'>
              <calculation class='tableau' formula='((SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [Calculation_3636234545997357058] END)/SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [gmv] END))-(SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [Calculation_3636234545997357058] END)/SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [gmv] END)))*100' />
            </column>
            <column caption='Vertical' datatype='string' name='[Calculation_3331678620594413594]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [vertical] = &apos;OD&apos; OR [vertical] = &apos;VD&apos; THEN &apos;OD + VD&apos; &#10;ELSE [vertical] END' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_3331678620596895782]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Current Month for last year&#10;( YEAR([ordered_at_date_local]) = YEAR([Parameters].[Parameter 1]) - 1 AND &#10;  DAY([ordered_at_date_local]) &gt;= DAY(DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])) AND // ini yg first date&#10;  DAY([ordered_at_date_local]) &lt; DAY([Parameters].[Parameter 1]) AND // ini yg end date&#10;  MONTH([ordered_at_date_local]) = MONTH([Parameters].[Parameter 1]) ) OR &#10;( [ordered_at_date_local] &gt;= DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]) AND // ini yg first date&#10;  [ordered_at_date_local] &lt; [Parameters].[Parameter 1])' />
            </column>
            <column caption='MTD Tag' datatype='string' name='[Calculation_3331678620598308904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([ordered_at_date_local]) = YEAR(TODAY()) AND [Calculation_3331678620596895782] THEN &apos;MTD&apos; ELSE &apos;Last Year&apos; END' />
            </column>
            <column caption='SUM(IF [MTD Tag] = &apos;MTD&apos; THEN [orders] END)/SUM(IF [MTD Tag] ...' datatype='real' name='[Calculation_3331678620600234030]' role='measure' type='quantitative' user:unnamed='YoY Comparison Perc'>
              <calculation class='tableau' formula='SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [orders] END)/SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [orders] END)-1' />
            </column>
            <column caption='(SUM(IF [MTD Tag] = &apos;MTD&apos; AND [vertical] = &apos;OD&apos; THEN [deliver...' datatype='real' name='[Calculation_3331678620601675842]' role='measure' type='quantitative' user:unnamed='YoY Comparison Perc'>
              <calculation class='tableau' formula='(SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; AND [vertical] = &apos;OD&apos; THEN [delivery_fee] END)&#10;/SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; AND [vertical] = &apos;OD&apos; THEN [orders] END))&#10;/&#10;(SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; AND [vertical] = &apos;OD&apos; THEN [delivery_fee] END)&#10;/SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; AND [vertical] = &apos;OD&apos; THEN [orders] END)) - 1' />
            </column>
            <column caption='(SUM(IF [MTD Tag] = &apos;MTD&apos; THEN [fp_df_cost] END)/SUM(IF [MTD ...' datatype='real' name='[Calculation_3331678620749840471]' role='measure' type='quantitative' user:unnamed='YoY Comparison Perc'>
              <calculation class='tableau' formula='(SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [fp_df_cost] END)/SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; AND vertical &lt;&gt; &apos;PU&apos; THEN [orders] END))/(SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [fp_df_cost] END)/SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; AND vertical &lt;&gt; &apos;PU&apos; THEN [orders] END))-1' />
            </column>
            <column caption='&apos;% YoY Comparison&apos;' datatype='string' name='[Calculation_3331678620761743451]' role='dimension' type='nominal' user:unnamed='YoY Comparison Perc'>
              <calculation class='tableau' formula='&apos;% YoY Comparison&apos;' />
            </column>
            <column caption='(SUM(IF [MTD Tag] = &apos;MTD&apos; THEN IF [vertical] &lt;&gt; &apos;PU&apos; THEN [fp...' datatype='real' name='[Calculation_3331678620841152651]' role='measure' type='quantitative' user:unnamed='YoY Comparison Perc - Food'>
              <calculation class='tableau' formula='(SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN IF [vertical] &lt;&gt; &apos;PU&apos; THEN [fp_deal_cost] ELSE 0 END + [fp_funded_voucher] END)/SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [orders] END))&#10;/&#10;(SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN IF [vertical] &lt;&gt; &apos;PU&apos; THEN [fp_deal_cost] ELSE 0 END + [fp_funded_voucher] END)/SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [orders] END))-1' />
            </column>
            <column caption='total_incentive' datatype='real' name='[Calculation_3636234545997357058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical] &lt;&gt; &apos;PU&apos; THEN [fp_funded_voucher] + [fp_deal_cost] ELSE [fp_funded_voucher] END' />
            </column>
