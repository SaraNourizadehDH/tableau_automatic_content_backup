    <worksheet name='[ABC] Weekly - QC L5W vs LW'>
      <table>
        <view>
          <datasources>
            <datasource caption='Order' name='federated.1nqq65a1ay3fz816klzfl16frlo9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Anchor Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-07-14#'>
              <calculation class='tableau' formula='#2025-07-14#' />
              <range min='#2025-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nqq65a1ay3fz816klzfl16frlo9'>
            <column caption='Weekly Tag' datatype='string' name='[CW (copy)_3331678620590084106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-1,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;LW&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-2,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L2W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L5W&apos;&#10;ELSE &apos;Exclude&apos; END' />
            </column>
            <column caption='&apos;LW vs L5W&apos;' datatype='string' name='[Calculation_260997732842479699]' role='dimension' type='nominal' user:unnamed='[ABC] Weekly - QC L5W vs LW'>
              <calculation class='tableau' formula='&apos;LW vs L5W&apos;' />
            </column>
            <column caption='SUM(IF [Weekly Tag] = &apos;LW&apos; AND [Vertical (copy)] = &apos;QC&apos; THEN ...' datatype='real' name='[Calculation_55239492005281884]' role='measure' type='quantitative' user:unnamed='[ABC] Weekly - QC L5W vs LW'>
              <calculation class='tableau' formula='SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; AND [Vertical (copy)_260997735705039265] = &apos;QC&apos; THEN [gmv_net] END)/&#10;SUM(IF [CW (copy)_3331678620590084106] = &apos;L5W&apos; AND [Vertical (copy)_260997735705039265] = &apos;QC&apos; THEN [gmv_net] END)-1' />
            </column>
            <column caption='((SUM(IF [Weekly Tag] = &apos;LW&apos; AND [Vertical (copy)] = &apos;QC&apos; THE...' datatype='real' name='[Calculation_55239492005544031]' role='measure' type='quantitative' user:unnamed='[ABC] Weekly - QC L5W vs LW'>
              <calculation class='tableau' formula='((SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; AND [Vertical (copy)_260997735705039265] = &apos;QC&apos; THEN [gmv_net] END)/&#10;  SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [gmv_net] END))-&#10; (SUM(IF [CW (copy)_3331678620590084106] = &apos;L5W&apos; AND [Vertical (copy)_260997735705039265] = &apos;QC&apos; THEN [gmv_net] END)/&#10;  SUM(IF [CW (copy)_3331678620590084106] = &apos;L5W&apos; THEN [gmv_net] END)))*100&#10;' />
            </column>
            <column caption='((SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [pro_gmv_net] END)/SUM(IF [...' datatype='real' name='[Calculation_942589353584447503]' role='measure' type='quantitative' user:unnamed='[ABC] Weekly - QC L5W vs LW'>
              <calculation class='tableau' formula='((SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [pro_gmv_net] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [gmv_net] END))-&#10; (SUM(IF [CW (copy)_3331678620590084106] = &apos;L5W&apos; THEN [pro_gmv_net] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L5W&apos; THEN [gmv_net] END)))*100' />
            </column>
            <column caption='Vertical (copy)' datatype='string' name='[Vertical (copy)_260997735705039265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [vertical] = &apos;Shops&apos; OR [vertical] = &apos;Dmart&apos; THEN &apos;QC&apos; &#10;ELSE [vertical] END' />
            </column>
            <column datatype='real' name='[gmv_net]' role='measure' type='quantitative' />
            <column-instance column='[CW (copy)_3331678620590084106]' derivation='None' name='[none:CW (copy)_3331678620590084106:nk]' pivot='key' type='nominal' />
