            <column caption='SUM(IF CONTAINS([user_tag_platform],&apos;Lost&apos;) THEN [user_count]...' datatype='real' name='[Calculation_260997735155527987]' role='measure' type='quantitative' user:unnamed='MKT - LM - User'>
              <calculation class='tableau' formula='SUM(IF CONTAINS([user_tag_platform],&apos;Lost&apos;) THEN [user_count] END)' />
            </column>
            <column caption='SUM(IF [data_tag] = &apos;QC Trial&apos; THEN [user_count] END)' datatype='real' name='[Calculation_260997735160492343]' role='measure' type='quantitative' user:unnamed='MKT - LM - User'>
