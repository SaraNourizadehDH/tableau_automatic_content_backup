    <datasource caption='Commercial Transaction' inline='true' name='federated.0bf373719ftilt156jyp70qic3yq' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0j8rpyf1xsydsv1bgov0m0n2xo3t'>
            <connection CATALOG='foodpanda-sg-bigquery' EXECCATALOG='foodpanda-sg-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='APAC Country - SG' schema='pandata_sg' server-oauth='' username='grace.nathania@foodpanda.sg' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0j8rpyf1xsydsv1bgov0m0n2xo3t' name='Custom SQL Query' type='text'><![CDATA[WITH vendor_inventory AS (
  SELECT DISTINCT v.report_date
       , DATE_TRUNC(v.report_date, ISOWEEK) AS report_week
       , DATE_SUB(DATE_ADD(DATE_TRUNC(v.report_date, ISOWEEK), INTERVAL 1 WEEK), INTERVAL 1 DAY) AS report_week_last_date
       , DATE_TRUNC(v.report_date, MONTH) AS report_month
       
       , v.vendor_code
       , COALESCE(sf_vendor_grade IN ('A', 'B', 'AAA'), FALSE) AS is_ab_vendor
       , COALESCE(last_30days_valid_order >> 0, FALSE) AS is_active_vendor
       , is_zombie
       
       , COALESCE(EXTRACT(DAY FROM DATE_SUB(DATE_TRUNC(CURRENT_DATE(), ISOWEEK), INTERVAL 1 DAY)) = EXTRACT(DAY FROM report_date), FALSE) AS is_mtd
       , DATE_SUB(DATE_ADD(DATE_TRUNC(v.report_date, MONTH), INTERVAL 1 MONTH), INTERVAL 1 DAY) = v.report_date AS is_monthly
       --, ROW_NUMBER() OVER(PARTITION BY DATE_TRUNC(v.report_date, MONTH) ORDER BY report_date DESC) = 1 AS is_monthly
       , DATE_SUB(DATE_ADD(DATE_TRUNC(v.report_date, ISOWEEK), INTERVAL 1 WEEK), INTERVAL 1 DAY) = v.report_date AS is_weekly
       --, ROW_NUMBER() OVER(PARTITION BY DATE_TRUNC(v.report_date, ISOWEEK) ORDER BY report_date DESC) = 1 AS is_weekly
  
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_vendors_inventory` v
  LEFT JOIN `fulfillment-dwh-production.pandata_report.vendor_pe_terminated_vendors` t
    ON v.vendor_code = t.vendor_code 
    AND v.global_entity_id = t.global_entity_id 
    AND v.report_date = t.date
  WHERE v.global_entity_id = 'FP_SG'
    AND t.vendor_code IS NULL
),

transaction_agg AS (
  SELECT 'Weekly' AS granularity
      , report_week AS date_ 
      , COUNT(DISTINCT CASE WHEN is_active_vendor THEN vendor_code END) AS active_vendor
      , COUNT(DISTINCT CASE WHEN is_ab_vendor AND is_zombie THEN vendor_code END) AS zombie_ab
  FROM vendor_inventory
  WHERE is_weekly
  GROUP BY 1,2

  UNION DISTINCT

  SELECT 'Monthly' AS granularity
      , report_month AS date_ 
      , COUNT(DISTINCT CASE WHEN is_active_vendor THEN vendor_code END) AS active_vendor
      , COUNT(DISTINCT CASE WHEN is_ab_vendor AND is_zombie THEN vendor_code END) AS zombie_ab
  FROM vendor_inventory
  WHERE is_monthly
  GROUP BY 1,2

  UNION DISTINCT 

  SELECT 'MTD' AS granularity
      , report_month AS date_ 
      , COUNT(DISTINCT CASE WHEN is_active_vendor THEN vendor_code END) AS active_vendor
      , COUNT(DISTINCT CASE WHEN is_ab_vendor AND is_zombie THEN vendor_code END) AS zombie_ab
  FROM vendor_inventory
  WHERE is_mtd
  GROUP BY 1,2
),
/*
ab_acq_details_60 AS (  
  SELECT DISTINCT activation_date
      , DATE_ADD(activation_date, INTERVAL 60 DAY) AS completion_date

      , date_trunc(DATE_ADD(activation_date, INTERVAL 60 DAY), ISOWEEK) as completion_week
      , date_trunc(DATE_ADD(activation_date, INTERVAL 60 DAY), MONTH) as completion_month
      
      , opp.global_vendor_id
      , sf.vendor_code 

      , case when count(distinct code) over(partition by sf.vendor_code) >>= 75 THEN TRUE ELSE FALSE end as has_75_orders

      , count(distinct code) over(partition by sf.vendor_code) as orders
      , sum(ifnull(gmv_local, 0)) over(partition by sf.vendor_code) as gmv

