            </column>
            <column caption='((SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [pro_gmv] END)/SUM(IF [Week...' datatype='real' name='[Calculation_260997735169405258]' role='measure' type='quantitative' user:unnamed='MKT - Weekly - L2W vs LW'>
              <calculation class='tableau' formula='((SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [pro_gmv] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [gmv] END))-&#10; (SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [pro_gmv] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;2LW&apos; THEN [gmv] END)))*100' />
            </column>
            <column caption='((SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [total_incentive] END)/SUM(...' datatype='real' name='[Calculation_260997735169630543]' role='measure' type='quantitative' user:unnamed='MKT - Weekly - L2W vs LW'>
              <calculation class='tableau' formula='((SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [Calculation_3636234545997357058] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [gmv] END))-&#10; (SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [Calculation_3636234545997357058] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [gmv] END)))*100' />
            </column>
            <column caption='&apos;LW vs L2W&apos;' datatype='string' name='[Calculation_260997735169765714]' role='dimension' type='nominal' user:unnamed='MKT - Weekly - L2W vs LW'>
