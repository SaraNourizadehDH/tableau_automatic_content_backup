            <column caption='SUM(IF [Category] &lt;&gt; &apos;Penetration&apos; THEN [vfd] END)/SUM([Daily...' datatype='real' name='[Calculation_5395030895105646605]' role='measure' type='quantitative' user:unnamed='[ABC] VFD - MTD'>
