            <column-instance column='[CW (copy)_3331678620590084106]' derivation='None' name='[none:CW (copy)_3331678620590084106:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_260997737472418213]' derivation='None' name='[none:Calculation_260997737472418213:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_55239492308942991]' derivation='None' name='[none:Calculation_55239492308942991:qk]' pivot='key' type='quantitative' />
            <column-instance column='[deal_type]' derivation='None' name='[none:deal_type:nk]' pivot='key' type='nominal' />
