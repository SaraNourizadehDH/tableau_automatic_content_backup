        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , 'QC' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
