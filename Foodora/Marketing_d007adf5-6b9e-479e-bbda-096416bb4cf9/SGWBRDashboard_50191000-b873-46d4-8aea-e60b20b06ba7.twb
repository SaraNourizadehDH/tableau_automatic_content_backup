    <datasource caption='User' inline='true' name='federated.1x8r83q1weqjos1bkxx4g1fmkz1m' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0qh8jf507fej150zsolwh01kl3la'>
            <connection CATALOG='foodpanda-sg-bigquery' EXECCATALOG='foodpanda-sg-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='APAC Country - SG' schema='pandata_sg' server-oauth='' username='grace.nathania@foodpanda.sg' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0qh8jf507fej150zsolwh01kl3la' name='Custom SQL Query' type='text'><![CDATA[WITH order_details AS (
  SELECT ordered_at_date_local
       , o.customer_code
       , o.pd_customer_uuid 
       , CASE WHEN previous_order_gap_platform IS NULL AND NOT (DATE(DATE_ADD(first_associated_order_placed_at_utc, INTERVAL 8 HOUR)) << o.ordered_at_date_local) THEN 'NC'
              WHEN previous_order_gap_platform IS NULL AND first_associated_order_placed_at_utc IS NULL THEN 'NC'
              WHEN previous_order_gap_platform IS NULL AND (DATE(DATE_ADD(first_associated_order_placed_at_utc, INTERVAL 8 HOUR)) << o.ordered_at_date_local) THEN 
                    CASE WHEN DATE_DIFF(o.ordered_at_date_local, (DATE(DATE_ADD(first_associated_order_placed_at_utc, INTERVAL 8 HOUR))), DAY) BETWEEN 0 AND 65 THEN 'EC : 30 - 65'
                         WHEN DATE_DIFF(o.ordered_at_date_local, (DATE(DATE_ADD(first_associated_order_placed_at_utc, INTERVAL 8 HOUR))), DAY) BETWEEN 66 AND 150 THEN 'Churn : 66 - 150'
                         WHEN DATE_DIFF(o.ordered_at_date_local, (DATE(DATE_ADD(first_associated_order_placed_at_utc, INTERVAL 8 HOUR))), DAY) BETWEEN 151 AND 365 THEN 'Inactive : 151 - 365'
                         WHEN DATE_DIFF(o.ordered_at_date_local, (DATE(DATE_ADD(first_associated_order_placed_at_utc, INTERVAL 8 HOUR))), DAY) >> 365 THEN 'Lost : >> 365' END
              WHEN previous_order_gap_platform BETWEEN 0 AND 65 THEN 'EC : 30 - 65'
              WHEN previous_order_gap_platform BETWEEN 66 AND 150 THEN 'Churn : 66 - 150'
              WHEN previous_order_gap_platform BETWEEN 151 AND 365 THEN 'Inactive : 151 - 365'
              WHEN previous_order_gap_platform >> 365 THEN 'Lost : >> 365' END AS user_tag_platform
       , o.order_code 
       , o.vertical
       , o.ordered_at_local
       , ROW_NUMBER() OVER(PARTITION BY o.pd_customer_uuid, DATE_TRUNC(o.ordered_at_date_local, MONTH) ORDER BY o.ordered_at_local) AS rn_monthly
       , ROW_NUMBER() OVER(PARTITION BY o.pd_customer_uuid, DATE_TRUNC(o.ordered_at_date_local, MONTH) ORDER BY o.ordered_at_local DESC) AS rn_monthly_last
       , LEAD(o.ordered_at_date_local,1) OVER(PARTITION BY o.pd_customer_uuid ORDER BY o.ordered_at_local) AS next_order_date  

  FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders_agg_previous_order` o
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_cdp.customers` cdp
    ON o.customer_code = cdp.customer_id
    AND cdp.global_entity_id = 'FP_SG'
    AND snapshot_date_utc = CURRENT_DATE() - 2
  --QUALIFY ROW_NUMBER() OVER(PARTITION BY o.pd_customer_uuid, DATE_TRUNC(o.ordered_at_date_local, MONTH) ORDER BY o.ordered_at_local) = 1
),

user_tag_agg AS (
  SELECT DISTINCT 'Weekly' AS granularity
        , 'User Tag' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, ISOWEEK) AS date_
        , user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND rn_monthly = 1
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Monthly' AS granularity
        , 'User Tag' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND rn_monthly = 1
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'MTD' AS granularity
        , 'User Tag' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND rn_monthly = 1
    AND ( ( (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 ) OR--AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH)) OR
          (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 )) ) --AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 YEAR))))
  GROUP BY 1,2,3,4

),

user_tag_agg_by_vertical AS (
  SELECT DISTINCT 'Weekly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, ISOWEEK) AS date_
        , vertical AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Monthly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , vertical AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'MTD' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , vertical AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE() - 1, INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE() - 1, INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND ( ( (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 ) OR--AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH)) OR
            (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 )) ) --AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 YEAR))))
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Weekly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, ISOWEEK) AS date_
        , 'Platform' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Monthly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , 'Platform' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'MTD' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , 'Platform' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND ( ( (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 ) OR--AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH)) OR
          (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 )) ) --AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 YEAR))))
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Weekly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, ISOWEEK) AS date_
        , 'Food' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND vertical IN ("Delivery", "Pickup")
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Monthly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , 'Food' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND vertical IN ("Delivery", "Pickup")
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'MTD' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , 'Food' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND ( ( (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 ) OR--AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH)) OR
          (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 )) ) --AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 YEAR))))
    AND vertical IN ("Delivery", "Pickup")
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Weekly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, ISOWEEK) AS date_
        , 'QC' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND vertical NOT IN ("Delivery", "Pickup")
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Monthly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , 'QC' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND vertical NOT IN ("Delivery", "Pickup")
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'MTD' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , 'QC' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND ( ( (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 ) OR--AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH)) OR
          (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 )) ) --AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 YEAR))))
    AND vertical NOT IN ("Delivery", "Pickup")
  GROUP BY 1,2,3,4

),

user_order_details AS (
  SELECT DISTINCT 'Weekly' AS granularity
      , DATE_TRUNC(ordered_at_date_local, ISOWEEK) AS date_
      , pd_customer_uuid 
      , COUNT(DISTINCT CASE WHEN vertical NOT IN ('Pickup', 'Delivery') THEN order_code END) AS qc_order
      , COUNT(DISTINCT CASE WHEN vertical NOT IN ('Pickup', 'Delivery') THEN order_code END) >> 0 AS has_qc_order
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3

  UNION DISTINCT

  SELECT DISTINCT 'Monthly' AS granularity
      , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
      , pd_customer_uuid 
      , COUNT(DISTINCT CASE WHEN vertical NOT IN ('Pickup', 'Delivery') THEN order_code END) AS qc_order
      , COUNT(DISTINCT CASE WHEN vertical NOT IN ('Pickup', 'Delivery') THEN order_code END) >> 0 AS has_qc_order
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3

  UNION DISTINCT 

  SELECT DISTINCT 'MTD' AS granularity
      , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
      , pd_customer_uuid 
      , COUNT(DISTINCT CASE WHEN vertical NOT IN ('Pickup', 'Delivery') THEN order_code END) AS qc_order
      , COUNT(DISTINCT CASE WHEN vertical NOT IN ('Pickup', 'Delivery') THEN order_code END) >> 0 AS has_qc_order
  FROM order_details
  WHERE (
    (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE())
    OR
    (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))
)
AND
(
    (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1)
    OR
    (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1)
)
  GROUP BY 1,2,3
),

user_order_agg AS (
  SELECT granularity 
      , 'MAU' AS data_tag
      , date_ 
      , CASE WHEN has_qc_order THEN 'Has QC' ELSE 'Non QC' END AS has_qc
      , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM user_order_details
  GROUP BY 1,2,3,4
),

first_dmart_order AS (
  SELECT DISTINCT pd_customer_uuid
      , order_code AS order_uuid
      , ordered_at_local AS ordered_at_date_local
  FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders_agg_previous_order`
  WHERE vertical = 'Dmart'
    AND previous_order_date_vertical IS NULL
),

first_shops_order AS (
  SELECT DISTINCT pd_customer_uuid
      , order_code AS order_uuid
      , ordered_at_local AS ordered_at_date_local
      , ROW_NUMBER() OVER(PARTITION BY pd_customer_uuid ORDER BY ordered_at_local) AS shop_rn
  FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders_agg_previous_order`
  WHERE vertical IN ('Shops', 'DFI')
    AND previous_order_date_vertical IS NULL
  QUALIFY ROW_NUMBER() OVER(PARTITION BY pd_customer_uuid ORDER BY ordered_at_local) = 1
),

first_qc_order AS (
  SELECT COALESCE(fd.pd_customer_uuid, fs.pd_customer_uuid) AS pd_customer_uuid
      , fd.order_uuid AS dmart_uuid
      , fd.ordered_at_date_local AS dmart_date
      , fs.order_uuid AS shops_uuid
      , fs.ordered_at_date_local AS shops_date
      
      , CASE WHEN fd.order_uuid IS NULL THEN fs.order_uuid 
              WHEN fs.order_uuid IS NULL THEN fd.order_uuid 
          ELSE IF(fd.ordered_at_date_local << fs.ordered_at_date_local, fd.order_uuid, fs.order_uuid) END AS first_qc_order_uuid 
      
      , CASE WHEN fd.order_uuid IS NULL THEN fs.ordered_at_date_local
              WHEN fs.order_uuid IS NULL THEN fd.ordered_at_date_local
          ELSE IF(fd.ordered_at_date_local << fs.ordered_at_date_local, fd.ordered_at_date_local, fs.ordered_at_date_local) END AS first_qc_date
      
  FROM first_dmart_order fd
  FULL OUTER JOIN first_shops_order fs
    ON fd.pd_customer_uuid = fs.pd_customer_uuid
),

qc_trial_agg AS (
  SELECT DISTINCT 'Weekly' AS granularity
        , 'QC Trial' AS data_tag
        , DATE_TRUNC(DATE(first_qc_date), ISOWEEK) AS date_
        , 'First QC' AS order_tag
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM first_qc_order
  WHERE ( (first_qc_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (first_qc_date BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Monthly' AS granularity
        , 'QC Trial' AS data_tag
        , DATE_TRUNC(DATE(first_qc_date), MONTH) AS date_
        , 'First QC' AS order_tag
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM first_qc_order
  WHERE ( (first_qc_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (first_qc_date BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'MTD' AS granularity
        , 'QC Trial' AS data_tag
        , DATE_TRUNC(DATE(first_qc_date), MONTH) AS date_
        , 'First QC' AS order_tag
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM first_qc_order
  WHERE ( (first_qc_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (first_qc_date BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND ( ((EXTRACT(DAY FROM first_qc_date) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 ) OR
           (EXTRACT(DAY FROM first_qc_date) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 )) ) 
  GROUP BY 1,2,3,4
),

ec_monthly_users AS (
  SELECT DISTINCT pd_customer_uuid 
      , order_code 
      , ordered_at_local
      , ordered_at_Date_local
      , DATE_TRUNC(ordered_at_date_local, MONTH) AS month_
  FROM order_details
  WHERE rn_monthly = 1
    AND user_tag_platform = 'EC : 30 - 65'
),

ec_latest_monthly_order AS (
  SELECT *
       , DATE_TRUNC(ordered_at_date_local, MONTH) AS month_
       , COALESCE(DATE_DIFF(next_order_date, ordered_at_date_local, MONTH) = 1, FALSE) AS retained_1mo
  FROM order_details 
  WHERE rn_monthly_last = 1
),

ec_retention_details AS (
  SELECT DISTINCT m.pd_customer_uuid
      , m.month_ 
      , l.retained_1mo
  FROM ec_monthly_users m
  LEFT JOIN ec_latest_monthly_order l
    ON m.pd_customer_uuid = l.pd_customer_uuid
    AND m.month_ = l.month_
),

ec_reorder_agg AS (
  SELECT 'Monthly' AS granularity
       , 'EC Reorder Rate' AS data_tag
       , month_ AS date_
       , 'Reorder EC' AS user_tag_platform
       , COUNT(DISTINCT CASE WHEN retained_1mo THEN pd_customer_uuid END) AS user_count
  FROM ec_retention_details
  GROUP BY 1,2,3,4
),

monthly_users AS (
  SELECT DISTINCT pd_customer_uuid 
      , order_code 
      , ordered_at_local
      , ordered_at_Date_local
      , DATE_TRUNC(ordered_at_date_local, MONTH) AS month_
  FROM order_details
  WHERE rn_monthly = 1
),

user_latest_monthly_order AS (
  SELECT *
       , DATE_TRUNC(ordered_at_date_local, MONTH) AS month_
       , COALESCE(DATE_DIFF(next_order_date, ordered_at_date_local, MONTH) = 1, FALSE) AS retained_1mo
  FROM order_details 
  WHERE rn_monthly_last = 1
),

retention_details AS (
  SELECT DISTINCT m.pd_customer_uuid
      , m.month_ 
      , l.retained_1mo
  FROM monthly_users m
  LEFT JOIN user_latest_monthly_order l
    ON m.pd_customer_uuid = l.pd_customer_uuid
    AND m.month_ = l.month_
),

reorder_agg AS (
  SELECT 'Monthly' AS granularity
       , 'Reorder Rate' AS data_tag
       , month_ AS date_
       , 'Reorder ALL' AS user_tag_platform
       , COUNT(DISTINCT CASE WHEN retained_1mo THEN pd_customer_uuid END) AS user_count
  FROM retention_details
  GROUP BY 1,2,3,4
),

pro_dps_savings AS (

  SELECT

    pandora__agg_orders.created_date_local,
    billing_engine_workflow_sap_orders.order_code,
    country_SG_pd_orders.initial_gfv_local AS gfv,
    IFNULL(gross_delivery_fee_discount_platform_local, 0) AS platform_incentive_gross,
    IFNULL(gross_delivery_fee_discount_vendor_local, 0) AS vendor_incentive_gross,

    CASE
      -- DFI
      WHEN pandora__agg_vendors.chain_code IN ('ce2ua', 'cx9nw') AND country_SG_pd_orders.initial_gfv_local >>= 50 AND country_SG_pd_orders.initial_gfv_local << 80 AND pandora__agg_orders.created_date_local >>= '2025-06-01' THEN IFNULL(gross_delivery_fee_discount_platform_local, 0)
      -- Dmart
      WHEN pandora__agg_vendors.chain_code IN ('cj4zz', 'cl5jl') AND country_SG_pd_orders.initial_gfv_local >>= 32 AND country_SG_pd_orders.initial_gfv_local << 60 AND pandora__agg_orders.created_date_local >>= '2025-07-01' THEN IFNULL(gross_delivery_fee_discount_platform_local, 0)
      ELSE IFNULL(gross_delivery_fee_discount_platform_local, 0) + IFNULL(gross_delivery_fee_discount_vendor_local, 0) 
    END AS total_incentive_gross,

  FROM `fulfillment-dwh-production.pandata_curated.billing_engine_workflow_sap_orders` billing_engine_workflow_sap_orders

  JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` pandora__agg_orders
    ON pandora__agg_orders.order_code = billing_engine_workflow_sap_orders.order_code
    AND pandora__agg_orders.global_entity_id = 'FP_SG'
    AND pandora__agg_orders.created_date_local >>= '2024-10-01'
    AND pandora__agg_orders.is_successful = TRUE
    AND pandora__agg_orders.is_subscriber_order = TRUE
    
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` country_SG_pd_orders
    ON country_SG_pd_orders.code = pandora__agg_orders.order_code
    
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` pandora__agg_vendors
    ON pandora__agg_vendors.vendor_code = pandora__agg_orders.vendor_code
    AND pandora__agg_vendors.global_entity_id = 'FP_SG'

  JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` regional_apac_pd_orders_agg_accounting
    ON CONCAT(pandora__agg_orders.global_entity_id, "_", pandora__agg_orders.order_code) = CONCAT(regional_apac_pd_orders_agg_accounting.global_entity_id, "_", regional_apac_pd_orders_agg_accounting.order_code)
    AND regional_apac_pd_orders_agg_accounting.global_entity_id = 'FP_SG'
    AND regional_apac_pd_orders_agg_accounting.created_date_utc >>= '2024-06-01'

  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` dps_sessions_mapped_to_orders
    ON billing_engine_workflow_sap_orders.order_code = dps_sessions_mapped_to_orders.platform_order_code
    AND dps_sessions_mapped_to_orders.country_code = 'sg'
    AND dps_sessions_mapped_to_orders.created_date >>= '2024-06-01'

  WHERE billing_engine_workflow_sap_orders.global_entity_id = 'FP_SG'
    AND billing_engine_workflow_sap_orders.created_date_utc >>= '2024-06-01'
    AND regional_apac_pd_orders_agg_accounting.pd_order_fees_delivery_fee_adjustment_plus_vat_local << 0
    AND IFNULL(has_new_customer_condition, FALSE) = FALSE
    AND pandora__agg_orders.created_date_local >>= '2024-07-01'

  QUALIFY ROW_NUMBER() OVER(PARTITION BY billing_engine_workflow_sap_orders.order_code) = 1

),

orders AS (

SELECT

  DATE_TRUNC(pandora__agg_orders.created_date_local, MONTH) AS order_month,
  pandora__agg_orders.customer_code,

  CASE
    WHEN pandora__agg_orders.df_user_paid_incl_vat_local = 0 THEN TRUE
    ELSE FALSE
  END AS is_free_delivery,

  CASE
    WHEN country_SG_pd_orders.gfv_local >>= 15 THEN TRUE
    ELSE FALSE
  END AS is_eligible_for_fd,

  CASE
    WHEN is_subscription_discount_order = TRUE THEN IFNULL(discount_value_local, 0)
    ELSE 0
  END AS discount_savings,

  CASE
    WHEN is_subscription_voucher_order = TRUE THEN IFNULL(voucher_value_local, 0)
    WHEN is_subscription_voucher_order = FALSE AND pandora__agg_vendors.chain_code IN ('ce2ua', 'cx9nw') AND LOWER(pandora__agg_orders.voucher_code) LIKE '%pro4offdfi%' THEN IFNULL(voucher_value_local, 0)
    WHEN is_subscription_voucher_order = FALSE AND pandora__agg_vendors.chain_code IN ('cj4zz', 'cl5jl') AND LOWER(pandora__agg_orders.voucher_code) LIKE '%profdmart%' THEN IFNULL(voucher_value_local, 0)
    ELSE 0
  END AS voucher_savings,

  CASE
    WHEN total_incentive_gross >> 0 THEN total_incentive_gross
    ELSE 0
  END AS dps_savings,

  pandora__agg_orders.order_code,

FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` pandora__agg_orders

LEFT JOIN pro_dps_savings
  ON pro_dps_savings.order_code = pandora__agg_orders.order_code

LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` country_SG_pd_orders
  ON country_SG_pd_orders.code = pandora__agg_orders.order_code

LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` pandora__agg_vendors
  ON pandora__agg_vendors.vendor_code = pandora__agg_orders.vendor_code
  AND pandora__agg_vendors.global_entity_id = 'FP_SG'

WHERE pandora__agg_orders.global_entity_id = 'FP_SG'
  AND pandora__agg_orders.is_successful = TRUE
  AND pandora__agg_orders.created_date_local >>= '2024-10-01'
  AND pandora__agg_orders.is_subscriber_order = TRUE

QUALIFY ROW_NUMBER() OVER(PARTITION BY pandora__agg_orders.order_code) = 1

),

pro_savings_agg AS (
  /*
  SELECT 'Monthly' AS granularity
       , 'EC Reorder Rate' AS data_tag
       , month_ AS date_
       , 'Reorder EC' AS user_tag_platform
       , COUNT(DISTINCT CASE WHEN retained_1mo THEN pd_customer_uuid END) AS user_count
  FROM retention_details
  GROUP BY 1,2,3,4
  */


  SELECT
    'Monthly' AS granularity,
    'PRO Savings' AS data_tag,
    order_month,
    'PRO Savings' AS user_tag_platform,
    SAFE_DIVIDE(SAFE_DIVIDE(SUM(COALESCE(discount_savings,0)) + SUM(COALESCE(voucher_savings,0)) + SUM(COALESCE(dps_savings,0)), COUNT(DISTINCT customer_code)), 5.99) AS total_savings_perc
    --SUM(COALESCE(discount_savings,0)) + SUM(COALESCE(voucher_savings,0)) + SUM(COALESCE(dps_savings,0)) AS total_savings,
   --COUNT(DISTINCT customer_code) AS customers,

  FROM orders
  GROUP BY 1,2,3,4
)

SELECT * 
FROM user_tag_agg

UNION DISTINCT 

SELECT * 
FROM user_tag_agg_by_vertical

UNION DISTINCT 

SELECT * 
FROM user_order_agg

UNION DISTINCT 

SELECT * 
FROM qc_trial_agg

UNION DISTINCT 

SELECT * 
FROM ec_reorder_agg

UNION DISTINCT 

SELECT * 
FROM reorder_agg

UNION DISTINCT 

SELECT * 
FROM pro_savings_agg]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0qh8jf507fej150zsolwh01kl3la' name='Custom SQL Query' type='text'><![CDATA[WITH order_details AS (
  SELECT ordered_at_date_local
       , o.customer_code
       , o.pd_customer_uuid 
       , CASE WHEN previous_order_gap_platform IS NULL AND NOT (DATE(DATE_ADD(first_associated_order_placed_at_utc, INTERVAL 8 HOUR)) << o.ordered_at_date_local) THEN 'NC'
              WHEN previous_order_gap_platform IS NULL AND first_associated_order_placed_at_utc IS NULL THEN 'NC'
              WHEN previous_order_gap_platform IS NULL AND (DATE(DATE_ADD(first_associated_order_placed_at_utc, INTERVAL 8 HOUR)) << o.ordered_at_date_local) THEN 
                    CASE WHEN DATE_DIFF(o.ordered_at_date_local, (DATE(DATE_ADD(first_associated_order_placed_at_utc, INTERVAL 8 HOUR))), DAY) BETWEEN 0 AND 65 THEN 'EC : 30 - 65'
                         WHEN DATE_DIFF(o.ordered_at_date_local, (DATE(DATE_ADD(first_associated_order_placed_at_utc, INTERVAL 8 HOUR))), DAY) BETWEEN 66 AND 150 THEN 'Churn : 66 - 150'
                         WHEN DATE_DIFF(o.ordered_at_date_local, (DATE(DATE_ADD(first_associated_order_placed_at_utc, INTERVAL 8 HOUR))), DAY) BETWEEN 151 AND 365 THEN 'Inactive : 151 - 365'
                         WHEN DATE_DIFF(o.ordered_at_date_local, (DATE(DATE_ADD(first_associated_order_placed_at_utc, INTERVAL 8 HOUR))), DAY) >> 365 THEN 'Lost : >> 365' END
              WHEN previous_order_gap_platform BETWEEN 0 AND 65 THEN 'EC : 30 - 65'
              WHEN previous_order_gap_platform BETWEEN 66 AND 150 THEN 'Churn : 66 - 150'
              WHEN previous_order_gap_platform BETWEEN 151 AND 365 THEN 'Inactive : 151 - 365'
              WHEN previous_order_gap_platform >> 365 THEN 'Lost : >> 365' END AS user_tag_platform
       , o.order_code 
       , o.vertical
       , o.ordered_at_local
       , ROW_NUMBER() OVER(PARTITION BY o.pd_customer_uuid, DATE_TRUNC(o.ordered_at_date_local, MONTH) ORDER BY o.ordered_at_local) AS rn_monthly
       , ROW_NUMBER() OVER(PARTITION BY o.pd_customer_uuid, DATE_TRUNC(o.ordered_at_date_local, MONTH) ORDER BY o.ordered_at_local DESC) AS rn_monthly_last
       , LEAD(o.ordered_at_date_local,1) OVER(PARTITION BY o.pd_customer_uuid ORDER BY o.ordered_at_local) AS next_order_date  

  FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders_agg_previous_order` o
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_cdp.customers` cdp
    ON o.customer_code = cdp.customer_id
    AND cdp.global_entity_id = 'FP_SG'
    AND snapshot_date_utc = CURRENT_DATE() - 2
  --QUALIFY ROW_NUMBER() OVER(PARTITION BY o.pd_customer_uuid, DATE_TRUNC(o.ordered_at_date_local, MONTH) ORDER BY o.ordered_at_local) = 1
),

user_tag_agg AS (
  SELECT DISTINCT 'Weekly' AS granularity
        , 'User Tag' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, ISOWEEK) AS date_
        , user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND rn_monthly = 1
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Monthly' AS granularity
        , 'User Tag' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND rn_monthly = 1
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'MTD' AS granularity
        , 'User Tag' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND rn_monthly = 1
    AND ( ( (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 ) OR--AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH)) OR
          (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 )) ) --AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 YEAR))))
  GROUP BY 1,2,3,4

),

user_tag_agg_by_vertical AS (
  SELECT DISTINCT 'Weekly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, ISOWEEK) AS date_
        , vertical AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Monthly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , vertical AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'MTD' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , vertical AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE() - 1, INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE() - 1, INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND ( ( (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 ) OR--AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH)) OR
            (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 )) ) --AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 YEAR))))
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Weekly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, ISOWEEK) AS date_
        , 'Platform' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Monthly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , 'Platform' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'MTD' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , 'Platform' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND ( ( (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 ) OR--AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH)) OR
          (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 )) ) --AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 YEAR))))
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Weekly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, ISOWEEK) AS date_
        , 'Food' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND vertical IN ("Delivery", "Pickup")
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Monthly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , 'Food' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND vertical IN ("Delivery", "Pickup")
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'MTD' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , 'Food' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND ( ( (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 ) OR--AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH)) OR
          (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 )) ) --AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 YEAR))))
    AND vertical IN ("Delivery", "Pickup")
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Weekly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, ISOWEEK) AS date_
        , 'QC' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND vertical NOT IN ("Delivery", "Pickup")
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Monthly' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , 'QC' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND vertical NOT IN ("Delivery", "Pickup")
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'MTD' AS granularity
        , 'MAU by Vertical' AS data_tag
        , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
        , 'QC' AS user_tag_platform
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND ( ( (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 ) OR--AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH)) OR
          (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 )) ) --AND DATE_TRUNC(ordered_at_date_local,MONTH) = DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 YEAR))))
    AND vertical NOT IN ("Delivery", "Pickup")
  GROUP BY 1,2,3,4

),

user_order_details AS (
  SELECT DISTINCT 'Weekly' AS granularity
      , DATE_TRUNC(ordered_at_date_local, ISOWEEK) AS date_
      , pd_customer_uuid 
      , COUNT(DISTINCT CASE WHEN vertical NOT IN ('Pickup', 'Delivery') THEN order_code END) AS qc_order
      , COUNT(DISTINCT CASE WHEN vertical NOT IN ('Pickup', 'Delivery') THEN order_code END) >> 0 AS has_qc_order
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3

  UNION DISTINCT

  SELECT DISTINCT 'Monthly' AS granularity
      , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
      , pd_customer_uuid 
      , COUNT(DISTINCT CASE WHEN vertical NOT IN ('Pickup', 'Delivery') THEN order_code END) AS qc_order
      , COUNT(DISTINCT CASE WHEN vertical NOT IN ('Pickup', 'Delivery') THEN order_code END) >> 0 AS has_qc_order
  FROM order_details
  WHERE ( (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3

  UNION DISTINCT 

  SELECT DISTINCT 'MTD' AS granularity
      , DATE_TRUNC(ordered_at_date_local, MONTH) AS date_
      , pd_customer_uuid 
      , COUNT(DISTINCT CASE WHEN vertical NOT IN ('Pickup', 'Delivery') THEN order_code END) AS qc_order
      , COUNT(DISTINCT CASE WHEN vertical NOT IN ('Pickup', 'Delivery') THEN order_code END) >> 0 AS has_qc_order
  FROM order_details
  WHERE (
    (ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE())
    OR
    (ordered_at_date_local BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))
)
AND
(
    (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1)
    OR
    (EXTRACT(DAY FROM ordered_at_date_local) BETWEEN 1 AND EXTRACT(DAY FROM DATE_TRUNC(CURRENT_DATE(), ISOWEEK)) - 1)
)
  GROUP BY 1,2,3
),

user_order_agg AS (
  SELECT granularity 
      , 'MAU' AS data_tag
      , date_ 
      , CASE WHEN has_qc_order THEN 'Has QC' ELSE 'Non QC' END AS has_qc
      , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM user_order_details
  GROUP BY 1,2,3,4
),

first_dmart_order AS (
  SELECT DISTINCT pd_customer_uuid
      , order_code AS order_uuid
      , ordered_at_local AS ordered_at_date_local
  FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders_agg_previous_order`
  WHERE vertical = 'Dmart'
    AND previous_order_date_vertical IS NULL
),

first_shops_order AS (
  SELECT DISTINCT pd_customer_uuid
      , order_code AS order_uuid
      , ordered_at_local AS ordered_at_date_local
      , ROW_NUMBER() OVER(PARTITION BY pd_customer_uuid ORDER BY ordered_at_local) AS shop_rn
  FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders_agg_previous_order`
  WHERE vertical IN ('Shops', 'DFI')
    AND previous_order_date_vertical IS NULL
  QUALIFY ROW_NUMBER() OVER(PARTITION BY pd_customer_uuid ORDER BY ordered_at_local) = 1
),

first_qc_order AS (
  SELECT COALESCE(fd.pd_customer_uuid, fs.pd_customer_uuid) AS pd_customer_uuid
      , fd.order_uuid AS dmart_uuid
      , fd.ordered_at_date_local AS dmart_date
      , fs.order_uuid AS shops_uuid
      , fs.ordered_at_date_local AS shops_date
      
      , CASE WHEN fd.order_uuid IS NULL THEN fs.order_uuid 
              WHEN fs.order_uuid IS NULL THEN fd.order_uuid 
          ELSE IF(fd.ordered_at_date_local << fs.ordered_at_date_local, fd.order_uuid, fs.order_uuid) END AS first_qc_order_uuid 
      
      , CASE WHEN fd.order_uuid IS NULL THEN fs.ordered_at_date_local
              WHEN fs.order_uuid IS NULL THEN fd.ordered_at_date_local
          ELSE IF(fd.ordered_at_date_local << fs.ordered_at_date_local, fd.ordered_at_date_local, fs.ordered_at_date_local) END AS first_qc_date
      
  FROM first_dmart_order fd
  FULL OUTER JOIN first_shops_order fs
    ON fd.pd_customer_uuid = fs.pd_customer_uuid
),

qc_trial_agg AS (
  SELECT DISTINCT 'Weekly' AS granularity
        , 'QC Trial' AS data_tag
        , DATE_TRUNC(DATE(first_qc_date), ISOWEEK) AS date_
        , 'First QC' AS order_tag
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM first_qc_order
  WHERE ( (first_qc_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (first_qc_date BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'Monthly' AS granularity
        , 'QC Trial' AS data_tag
        , DATE_TRUNC(DATE(first_qc_date), MONTH) AS date_
        , 'First QC' AS order_tag
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM first_qc_order
  WHERE ( (first_qc_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (first_qc_date BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
  GROUP BY 1,2,3,4

  UNION DISTINCT 

  SELECT DISTINCT 'MTD' AS granularity
        , 'QC Trial' AS data_tag
        , DATE_TRUNC(DATE(first_qc_date), MONTH) AS date_
        , 'First QC' AS order_tag
        , COUNT(DISTINCT pd_customer_uuid) AS user_count
  FROM first_qc_order
  WHERE ( (first_qc_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH) AND CURRENT_DATE()) OR 
          (first_qc_date BETWEEN DATE_SUB(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), INTERVAL 1 YEAR) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR))  )
    AND ( ((EXTRACT(DAY FROM first_qc_date) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 ) OR
           (EXTRACT(DAY FROM first_qc_date) BETWEEN 1 AND EXTRACT(DAY FROM CURRENT_DATE()) - 1 )) ) 
  GROUP BY 1,2,3,4
),

ec_monthly_users AS (
  SELECT DISTINCT pd_customer_uuid 
      , order_code 
      , ordered_at_local
      , ordered_at_Date_local
      , DATE_TRUNC(ordered_at_date_local, MONTH) AS month_
  FROM order_details
  WHERE rn_monthly = 1
    AND user_tag_platform = 'EC : 30 - 65'
),

ec_latest_monthly_order AS (
  SELECT *
       , DATE_TRUNC(ordered_at_date_local, MONTH) AS month_
       , COALESCE(DATE_DIFF(next_order_date, ordered_at_date_local, MONTH) = 1, FALSE) AS retained_1mo
  FROM order_details 
  WHERE rn_monthly_last = 1
),

ec_retention_details AS (
  SELECT DISTINCT m.pd_customer_uuid
      , m.month_ 
      , l.retained_1mo
  FROM ec_monthly_users m
  LEFT JOIN ec_latest_monthly_order l
    ON m.pd_customer_uuid = l.pd_customer_uuid
    AND m.month_ = l.month_
),

ec_reorder_agg AS (
  SELECT 'Monthly' AS granularity
       , 'EC Reorder Rate' AS data_tag
       , month_ AS date_
       , 'Reorder EC' AS user_tag_platform
       , COUNT(DISTINCT CASE WHEN retained_1mo THEN pd_customer_uuid END) AS user_count
  FROM ec_retention_details
  GROUP BY 1,2,3,4
),

monthly_users AS (
  SELECT DISTINCT pd_customer_uuid 
      , order_code 
      , ordered_at_local
      , ordered_at_Date_local
      , DATE_TRUNC(ordered_at_date_local, MONTH) AS month_
  FROM order_details
  WHERE rn_monthly = 1
),

user_latest_monthly_order AS (
  SELECT *
       , DATE_TRUNC(ordered_at_date_local, MONTH) AS month_
       , COALESCE(DATE_DIFF(next_order_date, ordered_at_date_local, MONTH) = 1, FALSE) AS retained_1mo
  FROM order_details 
  WHERE rn_monthly_last = 1
),

retention_details AS (
  SELECT DISTINCT m.pd_customer_uuid
      , m.month_ 
      , l.retained_1mo
  FROM monthly_users m
  LEFT JOIN user_latest_monthly_order l
    ON m.pd_customer_uuid = l.pd_customer_uuid
    AND m.month_ = l.month_
),

reorder_agg AS (
  SELECT 'Monthly' AS granularity
       , 'Reorder Rate' AS data_tag
       , month_ AS date_
       , 'Reorder ALL' AS user_tag_platform
       , COUNT(DISTINCT CASE WHEN retained_1mo THEN pd_customer_uuid END) AS user_count
  FROM retention_details
  GROUP BY 1,2,3,4
),

pro_dps_savings AS (

  SELECT

    pandora__agg_orders.created_date_local,
    billing_engine_workflow_sap_orders.order_code,
    country_SG_pd_orders.initial_gfv_local AS gfv,
    IFNULL(gross_delivery_fee_discount_platform_local, 0) AS platform_incentive_gross,
    IFNULL(gross_delivery_fee_discount_vendor_local, 0) AS vendor_incentive_gross,

    CASE
      -- DFI
      WHEN pandora__agg_vendors.chain_code IN ('ce2ua', 'cx9nw') AND country_SG_pd_orders.initial_gfv_local >>= 50 AND country_SG_pd_orders.initial_gfv_local << 80 AND pandora__agg_orders.created_date_local >>= '2025-06-01' THEN IFNULL(gross_delivery_fee_discount_platform_local, 0)
      -- Dmart
      WHEN pandora__agg_vendors.chain_code IN ('cj4zz', 'cl5jl') AND country_SG_pd_orders.initial_gfv_local >>= 32 AND country_SG_pd_orders.initial_gfv_local << 60 AND pandora__agg_orders.created_date_local >>= '2025-07-01' THEN IFNULL(gross_delivery_fee_discount_platform_local, 0)
      ELSE IFNULL(gross_delivery_fee_discount_platform_local, 0) + IFNULL(gross_delivery_fee_discount_vendor_local, 0) 
    END AS total_incentive_gross,

  FROM `fulfillment-dwh-production.pandata_curated.billing_engine_workflow_sap_orders` billing_engine_workflow_sap_orders

  JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` pandora__agg_orders
    ON pandora__agg_orders.order_code = billing_engine_workflow_sap_orders.order_code
    AND pandora__agg_orders.global_entity_id = 'FP_SG'
    AND pandora__agg_orders.created_date_local >>= '2024-10-01'
    AND pandora__agg_orders.is_successful = TRUE
    AND pandora__agg_orders.is_subscriber_order = TRUE
    
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` country_SG_pd_orders
    ON country_SG_pd_orders.code = pandora__agg_orders.order_code
    
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` pandora__agg_vendors
    ON pandora__agg_vendors.vendor_code = pandora__agg_orders.vendor_code
    AND pandora__agg_vendors.global_entity_id = 'FP_SG'

  JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` regional_apac_pd_orders_agg_accounting
    ON CONCAT(pandora__agg_orders.global_entity_id, "_", pandora__agg_orders.order_code) = CONCAT(regional_apac_pd_orders_agg_accounting.global_entity_id, "_", regional_apac_pd_orders_agg_accounting.order_code)
    AND regional_apac_pd_orders_agg_accounting.global_entity_id = 'FP_SG'
    AND regional_apac_pd_orders_agg_accounting.created_date_utc >>= '2024-06-01'

  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` dps_sessions_mapped_to_orders
    ON billing_engine_workflow_sap_orders.order_code = dps_sessions_mapped_to_orders.platform_order_code
    AND dps_sessions_mapped_to_orders.country_code = 'sg'
    AND dps_sessions_mapped_to_orders.created_date >>= '2024-06-01'

  WHERE billing_engine_workflow_sap_orders.global_entity_id = 'FP_SG'
    AND billing_engine_workflow_sap_orders.created_date_utc >>= '2024-06-01'
    AND regional_apac_pd_orders_agg_accounting.pd_order_fees_delivery_fee_adjustment_plus_vat_local << 0
    AND IFNULL(has_new_customer_condition, FALSE) = FALSE
    AND pandora__agg_orders.created_date_local >>= '2024-07-01'

  QUALIFY ROW_NUMBER() OVER(PARTITION BY billing_engine_workflow_sap_orders.order_code) = 1

),

orders AS (

SELECT

  DATE_TRUNC(pandora__agg_orders.created_date_local, MONTH) AS order_month,
  pandora__agg_orders.customer_code,

  CASE
    WHEN pandora__agg_orders.df_user_paid_incl_vat_local = 0 THEN TRUE
    ELSE FALSE
  END AS is_free_delivery,

  CASE
    WHEN country_SG_pd_orders.gfv_local >>= 15 THEN TRUE
    ELSE FALSE
  END AS is_eligible_for_fd,

  CASE
    WHEN is_subscription_discount_order = TRUE THEN IFNULL(discount_value_local, 0)
    ELSE 0
  END AS discount_savings,

  CASE
    WHEN is_subscription_voucher_order = TRUE THEN IFNULL(voucher_value_local, 0)
    WHEN is_subscription_voucher_order = FALSE AND pandora__agg_vendors.chain_code IN ('ce2ua', 'cx9nw') AND LOWER(pandora__agg_orders.voucher_code) LIKE '%pro4offdfi%' THEN IFNULL(voucher_value_local, 0)
    WHEN is_subscription_voucher_order = FALSE AND pandora__agg_vendors.chain_code IN ('cj4zz', 'cl5jl') AND LOWER(pandora__agg_orders.voucher_code) LIKE '%profdmart%' THEN IFNULL(voucher_value_local, 0)
    ELSE 0
  END AS voucher_savings,

  CASE
    WHEN total_incentive_gross >> 0 THEN total_incentive_gross
    ELSE 0
  END AS dps_savings,

  pandora__agg_orders.order_code,

FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` pandora__agg_orders

LEFT JOIN pro_dps_savings
  ON pro_dps_savings.order_code = pandora__agg_orders.order_code

LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` country_SG_pd_orders
  ON country_SG_pd_orders.code = pandora__agg_orders.order_code

LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` pandora__agg_vendors
  ON pandora__agg_vendors.vendor_code = pandora__agg_orders.vendor_code
  AND pandora__agg_vendors.global_entity_id = 'FP_SG'

WHERE pandora__agg_orders.global_entity_id = 'FP_SG'
  AND pandora__agg_orders.is_successful = TRUE
  AND pandora__agg_orders.created_date_local >>= '2024-10-01'
  AND pandora__agg_orders.is_subscriber_order = TRUE

QUALIFY ROW_NUMBER() OVER(PARTITION BY pandora__agg_orders.order_code) = 1

),

pro_savings_agg AS (
  /*
  SELECT 'Monthly' AS granularity
       , 'EC Reorder Rate' AS data_tag
       , month_ AS date_
       , 'Reorder EC' AS user_tag_platform
       , COUNT(DISTINCT CASE WHEN retained_1mo THEN pd_customer_uuid END) AS user_count
  FROM retention_details
  GROUP BY 1,2,3,4
  */


  SELECT
    'Monthly' AS granularity,
    'PRO Savings' AS data_tag,
    order_month,
    'PRO Savings' AS user_tag_platform,
    SAFE_DIVIDE(SAFE_DIVIDE(SUM(COALESCE(discount_savings,0)) + SUM(COALESCE(voucher_savings,0)) + SUM(COALESCE(dps_savings,0)), COUNT(DISTINCT customer_code)), 5.99) AS total_savings_perc
    --SUM(COALESCE(discount_savings,0)) + SUM(COALESCE(voucher_savings,0)) + SUM(COALESCE(dps_savings,0)) AS total_savings,
   --COUNT(DISTINCT customer_code) AS customers,

  FROM orders
  GROUP BY 1,2,3,4
)

SELECT * 
FROM user_tag_agg

UNION DISTINCT 

SELECT * 
FROM user_tag_agg_by_vertical

UNION DISTINCT 

SELECT * 
FROM user_order_agg

UNION DISTINCT 

SELECT * 
FROM qc_trial_agg

UNION DISTINCT 

SELECT * 
FROM ec_reorder_agg

UNION DISTINCT 

SELECT * 
FROM reorder_agg

UNION DISTINCT 

SELECT * 
FROM pro_savings_agg]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
