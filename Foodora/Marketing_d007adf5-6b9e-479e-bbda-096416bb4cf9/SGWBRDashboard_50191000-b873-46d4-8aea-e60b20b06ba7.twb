              <calculation class='tableau' formula='SUM(IF [deal_type] = &apos;Penetration - Monthly&apos; THEN [vfd] END)/SUM(IF [deal_type] = &apos;Penetration - Monthly&apos; THEN [gmv] END)' />
            </column>
