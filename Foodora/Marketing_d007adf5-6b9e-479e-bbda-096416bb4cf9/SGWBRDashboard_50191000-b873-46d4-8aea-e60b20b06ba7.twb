            <column caption='SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [gmv_net] END)/SUM(IF [Weekly...' datatype='real' name='[Calculation_260997735168983365]' role='measure' type='quantitative' user:unnamed='MKT - Weekly - L2W vs LW'>
              <calculation class='tableau' formula='SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [gmv_net] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [gmv_net] END)-1' />
            </column>
            <column caption='SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [orders] END)/SUM(IF [Weekly ...' datatype='real' name='[Calculation_260997735169028422]' role='measure' type='quantitative' user:unnamed='MKT - Weekly - L2W vs LW'>
