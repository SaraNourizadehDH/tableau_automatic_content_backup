              <calculation class='tableau' formula='&apos;LW vs L2W&apos;' />
            </column>
            <column caption='SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [orders] END)/SUM(IF [Weekly ...' datatype='real' name='[Calculation_260997732592607280]' role='measure' type='quantitative' user:unnamed='Weekly - LW vs L2W - QC'>
              <calculation class='tableau' formula='SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [orders] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [orders] END)-1' />
            </column>
            <column caption='(SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [delivery_fee] END) /SUM(IF ...' datatype='real' name='[Calculation_260997732592820274]' role='measure' type='quantitative' user:unnamed='Weekly - LW vs L2W - QC'>
              <calculation class='tableau' formula='(SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [delivery_fee] END)&#10;/SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [orders] END))&#10;/&#10;(SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [delivery_fee] END)&#10;/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [orders] END)) - 1' />
