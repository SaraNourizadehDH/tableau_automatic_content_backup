    <worksheet name='Weekly - LW vs L2W - Food'>
      <table>
        <view>
          <datasources>
            <datasource caption='Order' name='federated.1nqq65a1ay3fz816klzfl16frlo9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Anchor Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-07-14#'>
              <calculation class='tableau' formula='#2025-07-14#' />
              <range min='#2025-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nqq65a1ay3fz816klzfl16frlo9'>
            <column caption='Weekly Tag' datatype='string' name='[CW (copy)_3331678620590084106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-1,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;LW&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-2,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L2W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L5W&apos;&#10;ELSE &apos;Exclude&apos; END' />
            </column>
            <column caption='&apos;LW vs L2W&apos;' datatype='string' name='[Calculation_260997732589166609]' role='dimension' type='nominal' user:unnamed='Weekly - WoW LW vs L2W'>
              <calculation class='tableau' formula='&apos;LW vs L2W&apos;' />
            </column>
            <column caption='SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [orders] END)/SUM(IF [Weekly ...' datatype='real' name='[Calculation_260997732589445139]' role='measure' type='quantitative' user:unnamed='Weekly - WoW LW vs L2W'>
              <calculation class='tableau' formula='SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [orders] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [orders] END)-1' />
            </column>
            <column caption='(SUM(IF [Weekly Tag] = &apos;LW&apos; AND [vertical] = &apos;OD&apos; THEN [deliv...' datatype='real' name='[Calculation_260997732589744151]' role='measure' type='quantitative' user:unnamed='Weekly - WoW LW vs L2W'>
              <calculation class='tableau' formula='(SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; AND [vertical] = &apos;OD&apos; THEN [delivery_fee] END)&#10;/SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; AND [vertical] = &apos;OD&apos; THEN [orders] END))&#10;/&#10;(SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; AND [vertical] = &apos;OD&apos; THEN [delivery_fee] END)&#10;/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; AND [vertical] = &apos;OD&apos; THEN [orders] END)) - 1' />
            </column>
            <column caption='(SUM(IF [Weekly Tag] = &apos;LW&apos; THEN IF [vertical] &lt;&gt; &apos;PU&apos; THEN [...' datatype='real' name='[Calculation_260997732590231579]' role='measure' type='quantitative' user:unnamed='Weekly - WoW LW vs L2W'>
              <calculation class='tableau' formula='(SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN IF [vertical] &lt;&gt; &apos;PU&apos; THEN [fp_deal_cost] ELSE 0 END + [fp_funded_voucher] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [orders] END))&#10;/&#10;(SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN IF [vertical] &lt;&gt; &apos;PU&apos; THEN [fp_deal_cost] ELSE 0 END + [fp_funded_voucher] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [orders] END))-1' />
            </column>
            <column caption='(SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [fp_df_cost] END)/SUM(IF [We...' datatype='real' name='[Calculation_260997732590456861]' role='measure' type='quantitative' user:unnamed='Weekly - LW vs L2W - Food'>
              <calculation class='tableau' formula='(SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [fp_df_cost] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; AND vertical &lt;&gt; &apos;PU&apos; THEN [orders] END))/(SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [fp_df_cost] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; AND vertical &lt;&gt; &apos;PU&apos; THEN [orders] END))-1' />
            </column>
            <column caption='SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [gmv_net] END)/SUM(IF [Weekly...' datatype='real' name='[Calculation_260997732836687940]' role='measure' type='quantitative' user:unnamed='Weekly - LW vs L2W - Food'>
              <calculation class='tableau' formula='SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [gmv_net] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [gmv_net] END)-1' />
            </column>
            <column caption='((SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [total_incentive] END)/SUM(...' datatype='real' name='[Calculation_260997735048327399]' role='measure' type='quantitative' user:unnamed='Weekly - LW vs L2W - Food'>
              <calculation class='tableau' formula='((SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [Calculation_3636234545997357058] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [gmv] END))-(SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [Calculation_3636234545997357058] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [gmv] END)))*100' />
            </column>
            <column caption='Vertical' datatype='string' name='[Calculation_3331678620594413594]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [vertical] = &apos;OD&apos; OR [vertical] = &apos;VD&apos; THEN &apos;OD + VD&apos; &#10;ELSE [vertical] END' />
            </column>
            <column caption='total_incentive' datatype='real' name='[Calculation_3636234545997357058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical] &lt;&gt; &apos;PU&apos; THEN [fp_funded_voucher] + [fp_deal_cost] ELSE [fp_funded_voucher] END' />
            </column>
            <column datatype='real' name='[delivery_fee]' role='measure' type='quantitative' />
