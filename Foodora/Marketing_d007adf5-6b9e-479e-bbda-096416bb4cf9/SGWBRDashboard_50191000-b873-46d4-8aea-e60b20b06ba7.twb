    <worksheet name='[ABC] Sales - L2W vs LW'>
      <table>
        <view>
          <datasources>
            <datasource caption='Commercial Acquisition' name='federated.15qnir30fhfeq61e4xrdx1myzgsf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Anchor Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-07-14#'>
              <calculation class='tableau' formula='#2025-07-14#' />
              <range min='#2025-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15qnir30fhfeq61e4xrdx1myzgsf'>
            <column caption='ROUND(SUM(IF [source_] = &apos;BD&apos; THEN [total_activation] END)/AT...' datatype='real' name='[Calculation_260997733527658622]' role='measure' type='quantitative' user:unnamed='Sales - LM'>
              <calculation class='tableau' formula='ROUND(SUM(IF [source_] = &apos;BD&apos; THEN [total_activation] END)/ATTR(IF [date_] &lt;= DATE(&quot;2025-02-02&quot;) THEN 4 ELSE 5 END))' />
            </column>
            <column caption='Weekly Tag' datatype='string' name='[Calculation_260997733528051839]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[date_]) = DATEADD(&apos;week&apos;,-1,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;LW&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[date_]) = DATEADD(&apos;week&apos;,-2,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L2W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[date_]) = DATEADD(&apos;week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L5W&apos;&#10;ELSE &apos;Exclude&apos; END' />
            </column>
            <column caption='SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [total_activation] END)/SUM(I...' datatype='real' name='[Calculation_260997733528756353]' role='measure' type='quantitative' user:unnamed='Sales - L2W vs L5W'>
              <calculation class='tableau' formula='SUM(IF [Calculation_260997733528051839] = &apos;LW&apos; THEN [total_activation] END)/SUM(IF [Calculation_260997733528051839] = &apos;L2W&apos; THEN [total_activation] END)-1' />
            </column>
            <column caption='&apos;LW vs L2W&apos;' datatype='string' name='[Calculation_260997733528854658]' role='dimension' type='nominal' user:unnamed='Sales - L2W vs L5W'>
              <calculation class='tableau' formula='&apos;LW vs L2W&apos;' />
            </column>
            <column caption='SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [ab_activation] END)/SUM(IF [...' datatype='real' name='[Calculation_260997733528961156]' role='measure' type='quantitative' user:unnamed='Sales - L2W vs L5W'>
              <calculation class='tableau' formula='SUM(IF [Calculation_260997733528051839] = &apos;LW&apos; THEN [ab_activation] END)/SUM(IF [Calculation_260997733528051839] = &apos;L2W&apos; THEN [ab_activation] END)-1' />
            </column>
            <column caption='SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [cd_activation] END)/SUM(IF [...' datatype='real' name='[Calculation_260997733529071750]' role='measure' type='quantitative' user:unnamed='Sales - L2W vs L5W'>
              <calculation class='tableau' formula='SUM(IF [Calculation_260997733528051839] = &apos;LW&apos; THEN [cd_activation] END)/SUM(IF [Calculation_260997733528051839] = &apos;L2W&apos; THEN [cd_activation] END)-1' />
            </column>
            <column caption='SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [ab_gtc] END)/SUM(IF [Weekly ...' datatype='real' name='[Calculation_260997733529178249]' role='measure' type='quantitative' user:unnamed='Sales - L2W vs L5W'>
              <calculation class='tableau' formula='SUM(IF [Calculation_260997733528051839] = &apos;LW&apos; THEN [ab_gtc] END)/SUM(IF [Calculation_260997733528051839] = &apos;L2W&apos; THEN [ab_gtc] END)-1' />
            </column>
            <column caption='ROUND(SUM(IF [Weekly Tag] = &apos;LW&apos; AND [source_] = &apos;BD&apos; THEN [t...' datatype='real' name='[Calculation_4265401457455865859]' role='measure' type='quantitative' user:unnamed='[ABC] Sales - L2W vs LW'>
              <calculation class='tableau' formula='ROUND(SUM(IF [Calculation_260997733528051839] = &apos;LW&apos; AND [source_] = &apos;BD&apos; THEN [total_activation] END)/SUM(IF [Calculation_260997733528051839] = &apos;LW&apos; AND [source_] = &apos;BD&apos; THEN 8 END))/&#10;ROUND(SUM(IF [Calculation_260997733528051839] = &apos;L2W&apos; AND [source_] = &apos;BD&apos; THEN [total_activation] END)/SUM(IF [Calculation_260997733528051839] = &apos;L2W&apos; AND [source_] = &apos;BD&apos; THEN 8 END))-1' />
            </column>
