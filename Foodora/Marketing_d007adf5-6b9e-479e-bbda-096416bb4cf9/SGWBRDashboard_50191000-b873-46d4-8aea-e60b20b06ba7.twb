              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1nqq65a1ay3fz816klzfl16frlo9].[sum:Calculation_3331678620810207356:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1nqq65a1ay3fz816klzfl16frlo9].[sum:Blank 1 (copy)_3331678620810252413:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1nqq65a1ay3fz816klzfl16frlo9].[sum:Blank 1 (copy) (copy)_3331678620810268798:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1nqq65a1ay3fz816klzfl16frlo9].[sum:Blank 1 (copy) (copy) (copy)_3331678620810281087:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1nqq65a1ay3fz816klzfl16frlo9].[sum:Blank 1 (copy) (copy) (copy) (copy)_3331678620810285184:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1nqq65a1ay3fz816klzfl16frlo9].[sum:Blank 5 (copy)_3636234546005020696:qk]&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1nqq65a1ay3fz816klzfl16frlo9].[none:Calculation_3331678620594413594:nk]' filter-group='6'>
            <groupfilter function='member' level='[none:Calculation_3331678620594413594:nk]' member='&quot;OD + VD&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
