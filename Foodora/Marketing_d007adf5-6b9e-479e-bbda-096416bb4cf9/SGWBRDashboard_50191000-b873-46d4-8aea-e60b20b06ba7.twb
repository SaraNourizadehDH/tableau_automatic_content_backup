            </column>
            <column caption='SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [gmv] END)/SUM(IF [Weekly Tag...' datatype='real' name='[Calculation_260997735168946500]' role='measure' type='quantitative' user:unnamed='MKT - Weekly - L2W vs LW'>
