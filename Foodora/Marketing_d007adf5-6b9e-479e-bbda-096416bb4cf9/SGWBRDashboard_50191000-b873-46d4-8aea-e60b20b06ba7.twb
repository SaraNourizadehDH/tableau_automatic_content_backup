    <worksheet name='[ABC] % YoY Comparison - QC'>
      <table>
        <view>
          <datasources>
            <datasource caption='Order' name='federated.1nqq65a1ay3fz816klzfl16frlo9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Anchor Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-07-14#'>
              <calculation class='tableau' formula='#2025-07-14#' />
              <range min='#2025-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nqq65a1ay3fz816klzfl16frlo9'>
            <column caption='MTD' datatype='boolean' name='[Calculation_3331678620596895782]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Current Month for last year&#10;( YEAR([ordered_at_date_local]) = YEAR([Parameters].[Parameter 1]) - 1 AND &#10;  DAY([ordered_at_date_local]) &gt;= DAY(DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])) AND // ini yg first date&#10;  DAY([ordered_at_date_local]) &lt; DAY([Parameters].[Parameter 1]) AND // ini yg end date&#10;  MONTH([ordered_at_date_local]) = MONTH([Parameters].[Parameter 1]) ) OR &#10;( [ordered_at_date_local] &gt;= DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]) AND // ini yg first date&#10;  [ordered_at_date_local] &lt; [Parameters].[Parameter 1])' />
            </column>
            <column caption='MTD Tag' datatype='string' name='[Calculation_3331678620598308904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([ordered_at_date_local]) = YEAR(TODAY()) AND [Calculation_3331678620596895782] THEN &apos;MTD&apos; ELSE &apos;Last Year&apos; END' />
            </column>
            <column caption='&apos;% YoY Comparison&apos;' datatype='string' name='[Calculation_3331678620761743451]' role='dimension' type='nominal' user:unnamed='YoY Comparison Perc'>
              <calculation class='tableau' formula='&apos;% YoY Comparison&apos;' />
            </column>
            <column caption='SUM(IF [MTD Tag] = &apos;MTD&apos; AND [Vertical (copy)] = &apos;QC&apos; THEN [g...' datatype='real' name='[Calculation_55239492006154344]' role='measure' type='quantitative' user:unnamed='[ABC] % YoY Comparison - QC'>
              <calculation class='tableau' formula='SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; AND [Vertical (copy)_260997735705039265] = &apos;QC&apos; THEN [gmv_net] END)/&#10;SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; AND [Vertical (copy)_260997735705039265] = &apos;QC&apos; THEN [gmv_net] END)-1' />
            </column>
            <column caption='((SUM(IF [MTD Tag] = &apos;MTD&apos; AND [Vertical (copy)] = &apos;QC&apos; THEN ...' datatype='real' name='[Calculation_55239492006396010]' role='measure' type='quantitative' user:unnamed='[ABC] % YoY Comparison - QC'>
              <calculation class='tableau' formula='((SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; AND [Vertical (copy)_260997735705039265] = &apos;QC&apos; THEN [gmv_net] END)/&#10;  SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [gmv_net] END))-&#10; (SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; AND [Vertical (copy)_260997735705039265] = &apos;QC&apos; THEN [gmv_net] END)/&#10;  SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [gmv_net] END)))*100&#10;' />
            </column>
            <column caption='((SUM(IF [MTD Tag] = &apos;MTD&apos; THEN [pro_gmv_net] END)/SUM(IF [MT...' datatype='real' name='[Calculation_942589353584640018]' role='measure' type='quantitative' user:unnamed='[ABC] % YoY Comparison - QC'>
              <calculation class='tableau' formula='((SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [pro_gmv_net] END)/SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [gmv_net] END))-&#10; (SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [pro_gmv_net] END)/SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [gmv_net] END)))*100' />
            </column>
            <column caption='Vertical (copy)' datatype='string' name='[Vertical (copy)_260997735705039265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [vertical] = &apos;Shops&apos; OR [vertical] = &apos;Dmart&apos; THEN &apos;QC&apos; &#10;ELSE [vertical] END' />
            </column>
            <column datatype='real' name='[gmv_net]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3331678620596895782]' derivation='None' name='[none:Calculation_3331678620596895782:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3331678620761743451]' derivation='None' name='[none:Calculation_3331678620761743451:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[ordered_at_date_local]' role='dimension' type='ordinal' />
            <column datatype='real' name='[pro_gmv_net]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_55239492006154344]' derivation='User' name='[usr:Calculation_55239492006154344:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_55239492006396010]' derivation='User' name='[usr:Calculation_55239492006396010:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_942589353584640018]' derivation='User' name='[usr:Calculation_942589353584640018:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[vertical]' role='dimension' type='nominal' />
