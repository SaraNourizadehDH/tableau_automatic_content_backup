    <worksheet name='MKT - YoY - Order'>
      <table>
        <view>
          <datasources>
            <datasource caption='Order' name='federated.1nqq65a1ay3fz816klzfl16frlo9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Anchor Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-07-14#'>
              <calculation class='tableau' formula='#2025-07-14#' />
              <range min='#2025-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nqq65a1ay3fz816klzfl16frlo9'>
            <column caption='Weekly Tag' datatype='string' name='[CW (copy)_3331678620590084106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-1,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;LW&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-2,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L2W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[ordered_at_date_local]) = DATEADD(&apos;week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L5W&apos;&#10;ELSE &apos;Exclude&apos; END' />
            </column>
            <column caption='((SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [total_incentive] END)/SUM(...' datatype='real' name='[Calculation_260997735170015575]' role='measure' type='quantitative' user:unnamed='MKT - Weekly - L5W vs LW'>
              <calculation class='tableau' formula='((SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [Calculation_3636234545997357058] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [gmv] END))-&#10; (SUM(IF [CW (copy)_3331678620590084106] = &apos;L5W&apos; THEN [Calculation_3636234545997357058] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L5W&apos; THEN [gmv] END)))*100' />
            </column>
            <column caption='SUM(IF [MTD Tag] = &apos;MTD&apos; THEN [gmv] END)/SUM(IF [MTD Tag] &lt;&gt; ...' datatype='real' name='[Calculation_260997735170711898]' role='measure' type='quantitative' user:unnamed='MKT - YoY - Order'>
              <calculation class='tableau' formula='SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [gmv] END)/SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [gmv] END)-1' />
            </column>
            <column caption='SUM(IF [MTD Tag] = &apos;MTD&apos; THEN [gmv_net] END)/SUM(IF [MTD Tag]...' datatype='real' name='[Calculation_260997735170777435]' role='measure' type='quantitative' user:unnamed='MKT - YoY - Order'>
              <calculation class='tableau' formula='SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [gmv_net] END)/SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [gmv_net] END)-1' />
            </column>
            <column caption='SUM(IF [MTD Tag] = &apos;MTD&apos; THEN [orders] END)/SUM(IF [MTD Tag] ...' datatype='real' name='[Calculation_260997735170830684]' role='measure' type='quantitative' user:unnamed='MKT - YoY - Order'>
              <calculation class='tableau' formula='SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [orders] END)/SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [orders] END)-1' />
            </column>
            <column caption='((SUM(IF [MTD Tag] = &apos;MTD&apos; THEN [pro_gmv] END)/SUM(IF [MTD Ta...' datatype='real' name='[Calculation_260997735170969949]' role='measure' type='quantitative' user:unnamed='MKT - YoY - Order'>
              <calculation class='tableau' formula='((SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [pro_gmv] END)/SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [gmv] END))-&#10; (SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [pro_gmv] END)/SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [gmv] END)))*100' />
            </column>
            <column caption='((SUM(IF [MTD Tag] = &apos;MTD&apos; THEN [total_incentive] END)/SUM(IF...' datatype='real' name='[Calculation_260997735171236192]' role='measure' type='quantitative' user:unnamed='MKT - YoY - Order'>
              <calculation class='tableau' formula='((SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [Calculation_3636234545997357058] END)/SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [gmv] END))-&#10; (SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [Calculation_3636234545997357058] END)/SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [gmv] END)))*100' />
            </column>
            <column caption='&apos;% YoY Comparison&apos;' datatype='string' name='[Calculation_260997735171297633]' role='dimension' type='nominal' user:unnamed='MKT - YoY - Order'>
              <calculation class='tableau' formula='&apos;% YoY Comparison&apos;' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_3331678620596895782]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Current Month for last year&#10;( YEAR([ordered_at_date_local]) = YEAR([Parameters].[Parameter 1]) - 1 AND &#10;  DAY([ordered_at_date_local]) &gt;= DAY(DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])) AND // ini yg first date&#10;  DAY([ordered_at_date_local]) &lt; DAY([Parameters].[Parameter 1]) AND // ini yg end date&#10;  MONTH([ordered_at_date_local]) = MONTH([Parameters].[Parameter 1]) ) OR &#10;( [ordered_at_date_local] &gt;= DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]) AND // ini yg first date&#10;  [ordered_at_date_local] &lt; [Parameters].[Parameter 1])' />
            </column>
            <column caption='MTD Tag' datatype='string' name='[Calculation_3331678620598308904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([ordered_at_date_local]) = YEAR(TODAY()) AND [Calculation_3331678620596895782] THEN &apos;MTD&apos; ELSE &apos;Last Year&apos; END' />
            </column>
            <column caption='total_incentive' datatype='real' name='[Calculation_3636234545997357058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical] &lt;&gt; &apos;PU&apos; THEN [fp_funded_voucher] + [fp_deal_cost] ELSE [fp_funded_voucher] END' />
            </column>
            <column caption='((SUM(IF [MTD Tag] = &apos;MTD&apos; THEN [pro_gmv_net] END)/SUM(IF [MT...' datatype='real' name='[Calculation_55239492239315080]' role='measure' type='quantitative' user:unnamed='MKT - YoY - Order'>
              <calculation class='tableau' formula='((SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [pro_gmv_net] END)/SUM(IF [Calculation_3331678620598308904] = &apos;MTD&apos; THEN [gmv_net] END))-&#10; (SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [pro_gmv_net] END)/SUM(IF [Calculation_3331678620598308904] &lt;&gt; &apos;MTD&apos; THEN [gmv_net] END)))*100' />
            </column>
            <column datatype='real' name='[fp_deal_cost]' role='measure' type='quantitative' />
