          <datasource-dependencies datasource='federated.15qnir30fhfeq61e4xrdx1myzgsf'>
            <column caption='ROUND(SUM(IF [source_] = &apos;BD&apos; THEN [total_activation] END)/AT...' datatype='real' name='[Calculation_260997733527658622]' role='measure' type='quantitative' user:unnamed='Sales - LM'>
              <calculation class='tableau' formula='ROUND(SUM(IF [source_] = &apos;BD&apos; THEN [total_activation] END)/ATTR(IF [date_] &lt;= DATE(&quot;2025-02-02&quot;) THEN 4 ELSE 5 END))' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_260997733530214546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Current Month for last year&#10;( YEAR([date_]) = YEAR([Parameters].[Parameter 1]) - 1 AND &#10;  DAY([date_]) &gt;= DAY(DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])) AND // ini yg first date&#10;  DAY([date_]) &lt; DAY([Parameters].[Parameter 1]) AND // ini yg end date&#10;  MONTH([date_]) = MONTH([Parameters].[Parameter 1]) ) OR &#10;( [date_] &gt;= DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]) AND // ini yg first date&#10;  [date_] &lt; [Parameters].[Parameter 1])' />
            </column>
            <column caption='MTD Tag' datatype='string' name='[Calculation_260997733530288275]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([date_]) = YEAR(TODAY()) AND [Calculation_260997733530214546] THEN &apos;MTD&apos; ELSE &apos;Last Year&apos; END' />
            </column>
            <column caption='SUM(IF [MTD Tag] = &apos;MTD&apos; THEN [total_activation] END)/SUM(IF ...' datatype='real' name='[Calculation_260997733530751126]' role='measure' type='quantitative' user:unnamed='Sales - % YoY MTD'>
              <calculation class='tableau' formula='SUM(IF [Calculation_260997733530288275] = &apos;MTD&apos; THEN [total_activation] END)/SUM(IF [Calculation_260997733530288275] &lt;&gt; &apos;MTD&apos; THEN [total_activation] END)-1' />
            </column>
            <column caption='SUM(IF [MTD Tag] = &apos;MTD&apos; THEN [ab_activation] END)/SUM(IF [MT...' datatype='real' name='[Calculation_260997733530972312]' role='measure' type='quantitative' user:unnamed='Sales - % YoY MTD'>
