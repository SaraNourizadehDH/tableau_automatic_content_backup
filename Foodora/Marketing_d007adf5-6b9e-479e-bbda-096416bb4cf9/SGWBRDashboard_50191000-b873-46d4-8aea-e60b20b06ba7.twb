    <worksheet name='[ABC] VFD - L2W vs LW'>
      <table>
        <view>
          <datasources>
            <datasource caption='VFD' name='federated.0vpf0xs1ynwb3s1f3cyfm071eo4w' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Anchor Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2025-07-14#'>
              <calculation class='tableau' formula='#2025-07-14#' />
              <range min='#2025-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vpf0xs1ynwb3s1f3cyfm071eo4w'>
            <column caption='Weekly Tag' datatype='string' name='[CW (copy)_3331678620590084106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[created_date]) = DATEADD(&apos;week&apos;,-1,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;LW&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[created_date]) = DATEADD(&apos;week&apos;,-2,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L2W&apos;&#10;ELSEIF DATETRUNC(&apos;iso-week&apos;,[created_date]) = DATEADD(&apos;week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,[Parameters].[Parameter 1])) THEN &apos;L5W&apos;&#10;ELSE &apos;Exclude&apos; END' />
            </column>
            <column caption='Category' datatype='string' name='[Calculation_260997737472418213]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [deal_type] = &apos;AO&apos; OR [deal_type] = &apos;PRO&apos; THEN &apos;Exclude&apos;&#10;ELSEIF [deal_type] = &apos;ALL DEALS&apos; THEN &apos;Deal Util&apos;&#10;ELSEIF [deal_type] = &apos;Penetration - Monthly&apos; OR [deal_type] = &apos;Penetration - Weekly&apos; THEN &apos;Penetration&apos;&#10;ELSEIF CONTAINS([deal_type],&apos;AO&apos;) OR CONTAINS([deal_type], &apos;MANUAL&apos;) OR ([deal_type] = &apos;TIER 1 CAMPAIGN&apos;) THEN &apos;Always On&apos;&#10;ELSEIF CONTAINS([deal_type], &apos;PRO&apos;) OR CONTAINS([deal_type], &apos;DPS FD&apos;) THEN &apos;PRO&apos; &#10;ELSEIF [deal_type] = &apos;JOKER&apos; OR [deal_type] = &apos;DT&apos; THEN &apos;Ad&apos;&#10;ELSE &apos;Exclude&apos; END' />
            </column>
            <column caption='Daily GMV' datatype='real' name='[Calculation_444167579240620038]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [created_date] : MAX([gmv]) }' />
            </column>
            <column caption='(SUM(IF [Category] &lt;&gt; &apos;Penetration&apos; AND [Weekly Tag] = &apos;LW&apos; T...' datatype='real' name='[Calculation_5395030895104643079]' role='measure' type='quantitative' user:unnamed='[ABC] VFD - L2W vs LW'>
              <calculation class='tableau' formula='(SUM(IF [Calculation_260997737472418213] &lt;&gt; &apos;Penetration&apos; AND [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [vfd] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [Calculation_444167579240620038] END) -&#10;SUM(IF [Calculation_260997737472418213] &lt;&gt; &apos;Penetration&apos; AND [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [vfd] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [Calculation_444167579240620038] END))*100' />
            </column>
            <column caption='(SUM(IF [deal_type] = &apos;Penetration - Weekly&apos; AND [Weekly Tag]...' datatype='real' name='[Calculation_5395030895105044489]' role='measure' type='quantitative' user:unnamed='[ABC] VFD - L2W vs LW'>
              <calculation class='tableau' formula='(SUM(IF [deal_type] = &apos;Penetration - Weekly&apos; AND [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [vfd] END)/SUM(IF [deal_type] = &apos;Penetration - Weekly&apos; AND [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [gmv] END)-&#10;SUM(IF [deal_type] = &apos;Penetration - Weekly&apos; AND [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [vfd] END)/SUM(IF [deal_type] = &apos;Penetration - Weekly&apos; AND [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [gmv] END))*100&#10;' />
            </column>
            <column caption='(SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [gmv_deal] END)/SUM(IF [Week...' datatype='real' name='[Calculation_55239492308942991]' role='measure' type='quantitative' user:unnamed='[ABC] VFD - L2W vs LW'>
              <calculation class='tableau' formula='(SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [gmv_deal] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [[Daily GMV] END))-&#10;(SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [gmv_deal] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [[Daily GMV] END))&#10;' />
            </column>
            <column caption='((SUM(IF [Weekly Tag] = &apos;LW&apos; THEN [gmv_deal] END)/SUM(IF [Wee...' datatype='real' name='[Calculation_55239492311810200]' role='measure' type='quantitative' user:unnamed='[ABC] VFD - L2W vs LW'>
              <calculation class='tableau' formula='((SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [gmv_deal] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;LW&apos; THEN [Calculation_444167579240620038] END))-&#10;(SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [gmv_deal] END)/SUM(IF [CW (copy)_3331678620590084106] = &apos;L2W&apos; THEN [Calculation_444167579240620038] END)))*100' />
            </column>
            <column datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[deal_type]' role='dimension' type='nominal' />
            <column datatype='real' name='[gmv]' role='measure' type='quantitative' />
