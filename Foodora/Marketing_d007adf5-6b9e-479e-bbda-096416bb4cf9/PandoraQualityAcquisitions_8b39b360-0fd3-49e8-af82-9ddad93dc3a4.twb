            <column caption='acq_4_high_loss_acids %' datatype='real' default-format='p0.0%' name='[acq_3_lvc_acids % (copy)_6467169096599162884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acq_4_high_loss_acids])/SUM([all_acquisition_acids])' />
