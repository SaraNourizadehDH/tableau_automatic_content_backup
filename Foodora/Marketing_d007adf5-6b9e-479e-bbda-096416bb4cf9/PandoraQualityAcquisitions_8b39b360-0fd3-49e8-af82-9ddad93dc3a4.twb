          <datasource-dependencies datasource='federated.01e8ipu1pjiksd1h39qec17gi46s'>
            <column caption='acq_1_hvc_acids %' datatype='real' default-format='p0.0%' name='[Calculation_6467169096598011904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acq_1_hvc_acids])/SUM([all_acquisition_acids])' />
            </column>
            <column caption='&quot;YoY MTD %&quot;' datatype='string' name='[Calculation_6475261499367276554]' role='dimension' type='nominal' user:unnamed='YoY MTD - Pandora'>
              <calculation class='tableau' formula='&quot;YoY MTD %&quot;' />
            </column>
            <column caption='Fraud Acq %' datatype='real' default-format='p0.00%' name='[Fraud Acq placeholder (copy)_822821752492957698]' role='measure' type='quantitative'>
