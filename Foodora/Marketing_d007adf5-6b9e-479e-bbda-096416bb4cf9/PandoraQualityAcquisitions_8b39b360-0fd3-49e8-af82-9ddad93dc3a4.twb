            </column>
            <column caption='YoY MTD Filter' datatype='boolean' name='[MTD Last Year Flag (copy)_6475261499363463176]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[granularity] = &apos;monthly&apos;&#10;AND [reporting_mode] = &apos;mtd&apos;&#10;AND (&#10;    (&#10;      [report_date] &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, TODAY()))&#10;      AND [report_date] &lt;= DATEADD(&apos;day&apos;, -1, TODAY())&#10;    )&#10;    OR&#10;    (&#10;      [report_date] &gt;= DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, TODAY())))&#10;      AND [report_date] &lt;= DATEADD(&apos;year&apos;, -1, DATEADD(&apos;day&apos;, -1, TODAY()))&#10;    )&#10;)' />
            </column>
            <column caption='acq_2_mvc_acids %' datatype='real' default-format='p0.0%' name='[acq_1_hvc_acids % (copy)_6467169096598663169]' role='measure' type='quantitative'>
