      <column caption='Data Freshness - Rolling Avg Acqs (Last 14 Days)' datatype='real' name='[Calculation_5486862127050153984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Average of the last 14 days (excluding the latest date)&#10;{ FIXED : AVG(&#10;    IF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, { FIXED : MAX([report_date]) })&#10;       AND [report_date] &lt; { FIXED : MAX([report_date]) }&#10;    THEN [all_acquisition_acids]&#10;    END&#10;) }' />
      </column>
      <column caption='Data Freshness - Latest Day Acqs' datatype='integer' name='[Calculation_5486862127050416129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Total acquisitions on the latest date&#10;{ FIXED : MAX(&#10;    IF [report_date] = { FIXED : MAX([report_date]) }&#10;    THEN [all_acquisition_acids]&#10;    END&#10;) }' />
      </column>
      <column caption='Data Freshness - Flag' datatype='string' name='[Calculation_5486862127050625026]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5486862127050416129] &gt;= 0.5 * [Calculation_5486862127050153984] THEN&#10;    &quot;Complete&quot;&#10;ELSE&#10;    &quot;Incomplete&quot;&#10;END' />
      </column>
      <column caption='acq_1_hvc_acids %' datatype='real' default-format='p0.0%' name='[Calculation_6467169096598011904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acq_1_hvc_acids])/SUM([all_acquisition_acids])' />
      </column>
      <column caption='YoY Complete Filter' datatype='boolean' name='[Calculation_6475261499368255499]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[granularity] = &apos;monthly&apos;&#10;AND [reporting_mode] = &apos;full&apos;&#10;AND (&#10;  [report_date] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) // latest full month&#10;  OR&#10;  [report_date] = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))) // same month last year&#10;)' />
      </column>
      <column caption='granularity Filter' datatype='boolean' name='[Calculation_822821752498425859]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[granularity] = [Parameters].[granularity Parameter]' />
      </column>
      <column caption='Show in vs Prev Comparison' datatype='boolean' name='[Calculation_822821752504139781]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[granularity Parameter] = &apos;daily&apos; THEN&#10;    [report_date] = { FIXED [granularity] : MAX([report_date]) }&#10;    OR [report_date] = DATEADD(&apos;day&apos;, -7, { FIXED [granularity] : MAX([report_date]) })&#10;&#10;ELSEIF [Parameters].[granularity Parameter] = &apos;weekly&apos; THEN&#10;    [report_date] = { FIXED [granularity] : MAX([report_date]) }&#10;    OR [report_date] = DATEADD(&apos;week&apos;, -1, { FIXED [granularity] : MAX([report_date]) })&#10;&#10;ELSEIF [Parameters].[granularity Parameter] = &apos;monthly&apos; THEN&#10;    [report_date] = { FIXED [granularity] : MAX([report_date]) }&#10;    OR [report_date] = DATEADD(&apos;month&apos;, -1, { FIXED [granularity] : MAX([report_date]) })&#10;&#10;ELSE&#10;    FALSE&#10;END' />
      </column>
      <column caption='Pandora' datatype='string' name='[Calculation_822821752722911244]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Pandora&quot;' />
      </column>
      <column caption='Fraud Acq %' datatype='real' default-format='p0.00%' name='[Fraud Acq placeholder (copy)_822821752492957698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fraud_acq_acids])/SUM([all_acquisition_acids])' />
      </column>
      <column caption='YoY MTD Filter' datatype='boolean' name='[MTD Last Year Flag (copy)_6475261499363463176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[granularity] = &apos;monthly&apos;&#10;AND [reporting_mode] = &apos;mtd&apos;&#10;AND (&#10;    (&#10;      [report_date] &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, TODAY()))&#10;      AND [report_date] &lt;= DATEADD(&apos;day&apos;, -1, TODAY())&#10;    )&#10;    OR&#10;    (&#10;      [report_date] &gt;= DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, TODAY())))&#10;      AND [report_date] &lt;= DATEADD(&apos;year&apos;, -1, DATEADD(&apos;day&apos;, -1, TODAY()))&#10;    )&#10;)' />
      </column>
