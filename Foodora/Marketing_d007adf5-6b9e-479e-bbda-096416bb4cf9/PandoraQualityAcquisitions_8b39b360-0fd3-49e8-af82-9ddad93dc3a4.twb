    <worksheet name='Data Freshness'>
      <table>
        <view>
          <datasources>
            <datasource caption='marketing__quality_acquisitions_dashboard_table' name='federated.01e8ipu1pjiksd1h39qec17gi46s' />
          </datasources>
          <datasource-dependencies datasource='federated.01e8ipu1pjiksd1h39qec17gi46s'>
            <column caption='Data Freshness - Rolling Avg Acqs (Last 14 Days)' datatype='real' name='[Calculation_5486862127050153984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Average of the last 14 days (excluding the latest date)&#10;{ FIXED : AVG(&#10;    IF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, { FIXED : MAX([report_date]) })&#10;       AND [report_date] &lt; { FIXED : MAX([report_date]) }&#10;    THEN [all_acquisition_acids]&#10;    END&#10;) }' />
            </column>
            <column caption='Data Freshness - Latest Day Acqs' datatype='integer' name='[Calculation_5486862127050416129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Total acquisitions on the latest date&#10;{ FIXED : MAX(&#10;    IF [report_date] = { FIXED : MAX([report_date]) }&#10;    THEN [all_acquisition_acids]&#10;    END&#10;) }' />
            </column>
            <column caption='Data Freshness - Flag' datatype='string' name='[Calculation_5486862127050625026]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5486862127050416129] &gt;= 0.5 * [Calculation_5486862127050153984] THEN&#10;    &quot;Complete&quot;&#10;ELSE&#10;    &quot;Incomplete&quot;&#10;END' />
            </column>
            <column datatype='integer' name='[all_acquisition_acids]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_5486862127050625026]' derivation='None' name='[none:Calculation_5486862127050625026:nk]' pivot='key' type='nominal' />
            <column datatype='date' default-format='*dd-mmm-yy' name='[report_date]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' value='387' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.01e8ipu1pjiksd1h39qec17gi46s].[none:Calculation_5486862127050625026:nk]' />
              <text column='[federated.01e8ipu1pjiksd1h39qec17gi46s].[none:Calculation_5486862127050625026:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#787878'>Data Freshness - Flag:&#9;</run>
                <run bold='true'><![CDATA[<[federated.01e8ipu1pjiksd1h39qec17gi46s].[none:Calculation_5486862127050625026:nk]>]]></run>
                <run>Æ&#10;&#10;</run>
                <run bold='true'>🔍 How this works:</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true'>If the T-1 date&apos;s acquisition count is ≥ 50% of the 14-day average (excluding T-1), we mark it as &quot;</run>
                <run bold='true' fontcolor='#59a14f'>Complete</run>
                <run bold='true'>&quot;, otherwise &quot;</run>
                <run bold='true' fontcolor='#e15759'>Incomplete</run>
                <run bold='true'>&quot;</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run bold='true' fontalignment='2' fontsize='10'>Data for T-1 date is &lt;</run>
                <run bold='true' fontalignment='2' fontsize='10'>[federated.01e8ipu1pjiksd1h39qec17gi46s].[none:Calculation_5486862127050625026:nk]</run>
                <run bold='true' fontalignment='2' fontsize='10'>&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-labels-show' value='true' />
              </style-rule>
              <style-rule element='pane'>
                <format attr='minwidth' value='-1' />
                <format attr='maxwidth' value='-1' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{3E8CBBF7-7EFE-4C6F-91AC-AAE583BCD90E}' />
    </worksheet>
