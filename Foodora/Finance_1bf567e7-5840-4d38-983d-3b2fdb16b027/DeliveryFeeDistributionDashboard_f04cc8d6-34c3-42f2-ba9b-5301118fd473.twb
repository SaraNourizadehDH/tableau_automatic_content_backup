          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Date Part' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;mtd&quot;' value='Mtd' />
                <alias key='&quot;week&quot;' value='Weekly' />
                <alias key='&quot;wtd&quot;' value='Wtd' />
              </aliases>
            </column>
            <column caption='Delivery Fee Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Original Delivery Fee&quot;'>
              <calculation class='tableau' formula='&quot;Original Delivery Fee&quot;' />
            </column>
            <column caption='Main KPIs' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Order Share&quot;'>
              <calculation class='tableau' formula='&quot;Order Share&quot;' />
            </column>
            <column caption='Switch City &amp; Date' datatype='boolean' datatype-customized='true' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1dbskcr0b3ekbh1020unq1i458ec'>
            <column caption='switch' datatype='boolean' name='[Calculation_1335880291147239425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5]' />
            </column>
            <column caption='display main_kpi' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1510957729699176452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;Order Share&apos; THEN ROUND([Calculation_524106458837094415]*100,2)&#13;&#10;WHEN &apos;Valid Order&apos; THEN ROUND([Calculation_524106458837094415]/1000,2)&#13;&#10;WHEN &apos;Avg Delivery Fee&apos; THEN ROUND([Calculation_524106458837094415],2)&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='display unit' datatype='string' name='[Calculation_1510957729699958789]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;Order Share&apos; THEN &apos;%&apos;&#13;&#10;WHEN &apos;Valid Order&apos; THEN &apos;K&apos;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='updated to' datatype='date' name='[Calculation_524106458832814080]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([report_date])}' />
            </column>
            <column aggregation='Sum' caption='wtd report_date' datatype='integer' name='[Calculation_524106458832900097]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if DATEPART(&apos;weekday&apos;,[report_date]) = 1 then 7&#13;&#10;else DATEPART(&apos;weekday&apos;,[report_date]) - 1&#13;&#10;end' />
            </column>
            <column aggregation='Sum' caption='wtd updated to' datatype='integer' name='[Calculation_524106458832957442]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if DATEPART(&apos;weekday&apos;,[Calculation_524106458832814080]) = 1 then 7&#13;&#10;else DATEPART(&apos;weekday&apos;,[Calculation_524106458832814080]) - 1&#13;&#10;end' />
            </column>
            <column aggregation='Sum' caption='mtd report_date' datatype='integer' name='[Calculation_524106458833530883]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [report_date])' />
            </column>
            <column aggregation='Sum' caption='mtd updated to' datatype='integer' name='[Calculation_524106458833575940]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [Calculation_524106458832814080])' />
            </column>
            <column caption='datename report_date' datatype='string' name='[Calculation_524106458833780743]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) then &#13;&#10;left(DATENAME(&apos;month&apos;, [report_date]),3)&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;) then &#13;&#10;&apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [report_date])&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; then&#13;&#10;str([Calculation_524106458833846280])&#13;&#10;end' />
            </column>
            <column caption='datetrunc report_date' datatype='date' name='[Calculation_524106458833846280]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;month&apos;, [report_date]))&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;iso-week&apos;, [report_date]))&#13;&#10;else date(DATETRUNC(&apos;day&apos;, [report_date]))&#13;&#10;end' />
            </column>
            <column caption='datename(2) report_date' datatype='string' name='[Calculation_524106458833936393]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;day&apos;&#13;&#10;then left(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#13;&#10;else str(year([Calculation_524106458833846280]))&#13;&#10;end' />
            </column>
            <column caption='delivery fee type' datatype='real' name='[Calculation_524106458834640907]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Net Delivery Fee&apos; THEN [net_delivery_fee]&#13;&#10;WHEN &apos;Eff Delivery Fee&apos; THEN [eff_delivery_fee]&#13;&#10;WHEN &apos;Original Delivery Fee&apos; THEN [original_delivery_fee]&#13;&#10;WHEN &apos;Vendor Delivery Fee&apos; THEN [vendor_delivery_fee]&#13;&#10;END' />
            </column>
            <column caption='main_kpi' datatype='real' name='[Calculation_524106458837094415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;Order Share&apos; THEN SUM([orders])/TOTAL(SUM(orders))&#13;&#10;WHEN &apos;Valid Order&apos; THEN SUM([orders])&#13;&#10;WHEN &apos;Avg Delivery Fee&apos; THEN SUM([orders]*INT([Calculation_524106458834640907]))/TOTAL(SUM(orders))&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='datefilter report_date' datatype='boolean' name='[Calculation_526358213878312964]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(week)|(day)&apos;)&#13;&#10;then TRUE&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;mtd&apos;&#13;&#10;then [Calculation_524106458833530883] &lt;= [Calculation_524106458833575940]&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;wtd&apos;&#13;&#10;then [Calculation_524106458832900097] &lt;= [Calculation_524106458832957442]&#13;&#10;end' />
            </column>
