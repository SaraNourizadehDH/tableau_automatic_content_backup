            </column>
            <column aggregation='Sum' caption='wtd report_date' datatype='integer' name='[Calculation_524106458832900097]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if DATEPART(&apos;weekday&apos;,[report_date]) = 1 then 7&#13;&#10;else DATEPART(&apos;weekday&apos;,[report_date]) - 1&#13;&#10;end' />
            </column>
            <column aggregation='Sum' caption='wtd updated to' datatype='integer' name='[Calculation_524106458832957442]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if DATEPART(&apos;weekday&apos;,[Calculation_524106458832814080]) = 1 then 7&#13;&#10;else DATEPART(&apos;weekday&apos;,[Calculation_524106458832814080]) - 1&#13;&#10;end' />
            </column>
            <column aggregation='Sum' caption='mtd report_date' datatype='integer' name='[Calculation_524106458833530883]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [report_date])' />
            </column>
            <column aggregation='Sum' caption='mtd updated to' datatype='integer' name='[Calculation_524106458833575940]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [Calculation_524106458832814080])' />
            </column>
            <column caption='datename report_date' datatype='string' name='[Calculation_524106458833780743]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) then &#13;&#10;left(DATENAME(&apos;month&apos;, [report_date]),3)&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;) then &#13;&#10;&apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [report_date])&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; then&#13;&#10;str([Calculation_524106458833846280])&#13;&#10;end' />
            </column>
            <column caption='datetrunc report_date' datatype='date' name='[Calculation_524106458833846280]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;month&apos;, [report_date]))&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;iso-week&apos;, [report_date]))&#13;&#10;else date(DATETRUNC(&apos;day&apos;, [report_date]))&#13;&#10;end' />
            </column>
