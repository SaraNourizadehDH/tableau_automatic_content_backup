    <worksheet name='Active Customers QTD %'>
      <table>
        <view>
          <datasources>
            <datasource caption='eu_apac_weekly_monthly_dashboard (shared_eu)' name='federated.0o8z4j10mdnvs71h0vv4p0krv0fg' />
          </datasources>
          <datasource-dependencies datasource='federated.0o8z4j10mdnvs71h0vv4p0krv0fg'>
            <column caption='Active Customers QTD growth %' datatype='real' name='[Active Customers LY MTD growth % (copy)_3966334270610436111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Active Customers QTD growth % (copy)_3521463102127538183]/ [Active Customers PMTD (copy)_1982006086407024640] -1' />
            </column>
            <column caption='Active Customers PQTD' datatype='integer' name='[Active Customers PMTD (copy)_1982006086407024640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(IF &#10;DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, DATEADD(&apos;quarter&apos;, -1, TODAY()))&#10;AND DAY([order_day]) &lt;= DAY(TODAY()-1) and month([order_day]) = month(DATEADD(&apos;month&apos;, -3, TODAY()))&#10;THEN [au_previous_quarter_cumulative_cum_distinct_cnt] END)' />
            </column>
            <column caption='Active Customers QTD' datatype='integer' name='[Active Customers QTD growth % (copy)_3521463102127538183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM(iif([QTD], [Active Customers Daily], 0))&#10;MAX(IF DAY(TODAY()) = 1 and QUARTER(today()) &lt;&gt; QUARTER(today()-1) THEN [au_previous_quarter_cumulative_cum_distinct_cnt] ELSE&#10;[au_current_quarter_cumulative_cum_distinct_cnt] END)' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_78461151869382693]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF   [global_entity_id] in (&apos;YS_TR&apos;,&#10;&apos;total&apos;,&#10;&apos;PO_FI&apos;,&#10;&apos;OP_SE&apos;,&#10;&apos;NP_HU&apos;,&#10;&apos;MJM_AT&apos;,&#10;&apos;total_with_TR&apos;,&#10;&apos;FO_NO&apos;,&#10;&apos;DJ_CZ&apos;,) then &apos;EU &amp; Yemeksepeti&apos;&#10;ELSEIF  [global_entity_id] in(&#10;&#10;&#10;&apos;FP_TW&apos;,&#10;&apos;FP_TH&apos;,&#10;&apos;FP_SG&apos;,&#10;&apos;FP_PK&apos;,&#10;&apos;FP_PH&apos;,&#10;&apos;FP_MY&apos;,&#10;&apos;FP_MM&apos;,&#10;&apos;FP_LA&apos;,&#10;&apos;FP_KH&apos;,&#10;&apos;FP_HK&apos;,&#10;&apos;FP_BD&apos;,&#10;&apos;APAC&apos;) then &apos;APAC&apos;&#10;ELSEIF  [global_entity_id] =&#10;&apos;Total APAC_EU_TR&apos; then &apos;Pandora&apos; end' />
            </column>
            <column caption='QTD Growth Title' datatype='string' name='[MTD Growth Title (copy)_1931270242856280068]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;QTD QoQ&quot;' />
              <aliases>
                <alias key='&quot;QTD QoQ&quot;' value='QTD           QoQ' />
              </aliases>
            </column>
            <column caption='Au Current Quarter Cumulative Cum Distinct Cnt' datatype='integer' name='[au_current_quarter_cumulative_cum_distinct_cnt]' role='measure' type='quantitative' />
            <column caption='Au Previous Quarter Cumulative Cum Distinct Cnt' datatype='integer' name='[au_previous_quarter_cumulative_cum_distinct_cnt]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;APAC&quot;' value='       APAC' />
                <alias key='&quot;DH EU + Turkey&quot;' value='       DH EU + Turkey' />
                <alias key='&quot;DH Europe&quot;' value='      DH Europe' />
                <alias key='&quot;Total APAC_EU_TR&quot;' value='       PANDORA' />
              </aliases>
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
