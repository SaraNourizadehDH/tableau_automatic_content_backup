            <column-instance column='[monthly_pro_rate]' derivation='Avg' name='[avg:monthly_pro_rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[monthly_qc_active_customers]' derivation='Avg' name='[avg:monthly_qc_active_customers:qk]' pivot='key' type='quantitative' />
            <column-instance column='[monthly_total_active_customer_count]' derivation='Avg' name='[avg:monthly_total_active_customer_count:qk]' pivot='key' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;APAC&quot;' value='       APAC' />
                <alias key='&quot;DH EU + Turkey&quot;' value='       DH EU + Turkey' />
                <alias key='&quot;DH Europe&quot;' value='      DH Europe' />
                <alias key='&quot;Total APAC_EU_TR&quot;' value='       PANDORA' />
              </aliases>
            </column>
            <column datatype='integer' name='[daily_reactivations]' role='measure' type='quantitative' />
            <column datatype='real' name='[dh_mkt_contribution_eur]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='real' name='[gmv_net_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[hva_incentived_eur]' role='measure' type='quantitative' />
            <column caption='Main Total New Customer Count' datatype='integer' name='[main_total_new_customer_count]' role='measure' type='quantitative' />
            <column-instance column='[monthly_reactivations]' derivation='Max' name='[max:monthly_reactivations:qk]' pivot='key' type='quantitative' />
            <column caption='max_order_month_pandora ' datatype='date' name='[max_order_week_pandora (copy)_78461151866597412]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, [order_day])))))}&#10;&#10;&#10;//DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day]))' />
            </column>
