    <worksheet name='Orders LY MTD % (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='eu_apac_weekly_monthly_dashboard (shared_eu)' name='federated.0o8z4j10mdnvs71h0vv4p0krv0fg' />
          </datasources>
          <datasource-dependencies datasource='federated.0o8z4j10mdnvs71h0vv4p0krv0fg'>
            <column caption='MTD' datatype='boolean' name='[Calculation_21673596520853506]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,today())&#10;//OR DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1)&#10;&#10;&#10;//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,[Reporting Week]) and day([Order Day]) &lt;= day([Reporting Week])&#10;//OR (DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1))&#10;&#10;//if you pick last week of month it brings full month&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,{MAX([order_day])}) &#10;    AND ([order_day] &lt;= {MAX([order_day])})&#10;    // OR DATEPART(&apos;week&apos;, [Reporting Week]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day])))) ))&#10;//OR (DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1) AND YEAR([Order Day]) = YEAR(TODAY()-1))' />
            </column>
            <column caption='Successful Orders MTD YoY Growth' datatype='real' name='[Calculation_5629710700377182214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [total_number_of_successful_orders], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149], [total_number_of_successful_orders], 0)))-1' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_78461151869382693]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF   [global_entity_id] in (&apos;YS_TR&apos;,&#10;&apos;total&apos;,&#10;&apos;PO_FI&apos;,&#10;&apos;OP_SE&apos;,&#10;&apos;NP_HU&apos;,&#10;&apos;MJM_AT&apos;,&#10;&apos;total_with_TR&apos;,&#10;&apos;FO_NO&apos;,&#10;&apos;DJ_CZ&apos;,) then &apos;EU &amp; Yemeksepeti&apos;&#10;ELSEIF  [global_entity_id] in(&#10;&#10;&#10;&apos;FP_TW&apos;,&#10;&apos;FP_TH&apos;,&#10;&apos;FP_SG&apos;,&#10;&apos;FP_PK&apos;,&#10;&apos;FP_PH&apos;,&#10;&apos;FP_MY&apos;,&#10;&apos;FP_MM&apos;,&#10;&apos;FP_LA&apos;,&#10;&apos;FP_KH&apos;,&#10;&apos;FP_HK&apos;,&#10;&apos;FP_BD&apos;,&#10;&apos;APAC&apos;) then &apos;APAC&apos;&#10;ELSEIF  [global_entity_id] =&#10;&apos;Total APAC_EU_TR&apos; then &apos;Pandora&apos; end' />
            </column>
            <column caption='LY MTD' datatype='boolean' name='[MTD (copy)_1931270242863067149]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [last_sunday_of_month] &lt;&gt; [Reporting Week] THEN&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;, [Reporting Week]))&#10;    //AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, [Reporting Week])&#10;//ELSE&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;, [Reporting Week]))&#10;   // AND DATEPART(&apos;week&apos;, [Reporting Week] + 6) = &#10;     //   DATEPART(&apos;week&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day]))))&#10;//END&#10;&#10;&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,{MAX([order_day])})) &#10;    AND day([order_day]) &lt;= day({MAX([order_day])})&#10;    AND month([order_day]) &lt;= month({MAX([order_day])})' />
            </column>
            <column caption='LY MTD Growth Title' datatype='string' name='[MTD Growth Title (copy)_1931270242864181263]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;MTD YoY&quot;' />
              <aliases>
                <alias key='&quot;MTD YoY&quot;' value='MTD                  YoY' />
              </aliases>
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;APAC&quot;' value='       APAC' />
                <alias key='&quot;DH EU + Turkey&quot;' value='       DH EU + Turkey' />
                <alias key='&quot;DH Europe&quot;' value='      DH Europe' />
                <alias key='&quot;Total APAC_EU_TR&quot;' value='       PANDORA' />
              </aliases>
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_78461151869382693]' derivation='None' name='[none:Calculation_78461151869382693:nk]' pivot='key' type='nominal' />
            <column-instance column='[MTD Growth Title (copy)_1931270242864181263]' derivation='None' name='[none:MTD Growth Title (copy)_1931270242864181263:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column caption='Order Day' datatype='date' name='[order_day]' role='dimension' type='ordinal' />
            <column caption='Successful Orders' datatype='integer' name='[total_number_of_successful_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_5629710700377182214]' derivation='User' name='[usr:Calculation_5629710700377182214:qk]' pivot='key' type='quantitative' />
