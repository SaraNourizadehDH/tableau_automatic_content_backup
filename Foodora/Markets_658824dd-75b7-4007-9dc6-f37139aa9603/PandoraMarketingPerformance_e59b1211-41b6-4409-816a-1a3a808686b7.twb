      <column caption='Month Order Day' datatype='date' datatype-customized='true' name='[Calculation_2120351041781501953]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[order_day]))' />
      </column>
      <column caption='Successful Orders Budget vs RR Monthly' datatype='real' name='[Calculation_2120351041790136325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Successful Orders LY MTD (copy)_122441650265354240] / [Orders RR MTD (copy)_2120351041787789314] - 1' />
      </column>
      <column caption='MTD' datatype='boolean' name='[Calculation_21673596520853506]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,today())&#10;//OR DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1)&#10;&#10;&#10;//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,[Reporting Week]) and day([Order Day]) &lt;= day([Reporting Week])&#10;//OR (DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1))&#10;&#10;//if you pick last week of month it brings full month&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1]) &#10;    AND ([order_day] &lt;= [Parameters].[Parameter 1] OR DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;OR (DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1) AND YEAR([order_day]) = YEAR(TODAY()-1))' />
      </column>
      <column caption='PMTD' datatype='boolean' name='[Calculation_21673596521619459]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[Order Day]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,today())) &#10;  //  AND day([Order Day]) &lt;= day(today())-1&#10;//OR DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1)-1&#10;&#10;//IF  [Max Order Week] = [Reporting Week]  AND &#10;//MONTH([Order Day]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([Reporting Week])}))&#10;//AND YEAR([Order Day]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([Reporting Week])}))&#10;//AND [Order Day] &lt;= DATEADD(&apos;month&apos;, -1, {MAX([Reporting Week])})&#10;//AND day([Order Day]) &lt;= day(TODAY()-1) THEN TRUE&#10;//ELSEIF &#10;//[Max Order Week] &lt;&gt; [Reporting Week]  &#10;//AND MONTH([Order Day]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([Reporting Week])}))&#10;//AND YEAR([Order Day]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([Reporting Week])}))&#10;//AND day([Order Day]) &lt;= day([Reporting Week]) &#10;//THEN TRUE&#10;//END&#10;&#10;&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,(DATEADD(&apos;month&apos;, -1,[Parameters].[Parameter 1])))&#10;   AND [order_day] &lt;= DATEADD(&apos;month&apos;, -1,[Parameters].[Parameter 1]) &#10;OR&#10;(DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,(DATEADD(&apos;month&apos;, -1,[Parameters].[Parameter 1])))&#10;and&#10; DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, (DATETRUNC(&apos;month&apos;, [order_day])))))))' />
      </column>
      <column caption='Successful Orders MTD growth %' datatype='real' name='[Calculation_21673596522942468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [total_number_of_successful_orders], 0))/&#10;SUM(iif([Calculation_21673596521619459], [total_number_of_successful_orders], 0)))-1' />
      </column>
      <column caption='LY Last Day' datatype='datetime' name='[Calculation_3521463102118662148]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX(dateadd(&apos;year&apos;,-1,TODAY()-1))' />
      </column>
      <column caption='Exec Week Filter' datatype='string' name='[Calculation_3648126839559774208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Order Day (copy)_5361464990301970432] = DATEADD(&apos;week&apos;,-52,[Parameters].[Parameter 1]) then &apos;LY last week&apos;&#10;ELSEIF &#10;[Order Day (copy)_5361464990301970432] = [Parameters].[Parameter 1] then &apos;TY last week&apos; else &apos;No&apos; end' />
      </column>
      <column caption='LY MTD Title Exec' datatype='string' name='[Calculation_3648126839571107849]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;LY MTD&apos;' />
      </column>
      <column caption='DATE(DATETRUNC(&apos;week&apos;, [Order Day], &apos;Monday&apos;))' datatype='date' name='[Calculation_5361464990308225028]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [order_day], &apos;Monday&apos;))' />
      </column>
      <column caption='Date Range' datatype='boolean' name='[Calculation_5520850258285051904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Last 3 months&quot; THEN [Last 3 months]&#10;WHEN &quot;Last 1 month&quot; THEN [Last 3 months (copy)]&#10;WHEN &quot;Last 6 months&quot; THEN [Last 3 months (copy 2)]&#10;END' />
      </column>
      <column caption='RANK_PERCENTILE(AVG([Successful Orders Pickup%]))' datatype='real' name='[Calculation_909656760086589442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE(AVG([Successful Orders Pickup (copy)_909656760085172224]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Revenue' datatype='real' name='[Commission Revenue Eur (copy)_5515220700249513994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//[Commission Revenue Eur] + ZN([Delivery Fee Eur])&#10; [commission_revenue_eur] + [df_user_paid_exclude_vat_eur] + [df_service_fee_exclude_vat_eur] + [df_difference_to_minimum_order_value_exclude_vat_eur] + [df_priority_deliery_exclude_vat_eur]' />
      </column>
      <column caption='Commission Revenue RR M' datatype='integer' name='[Commission Revenue Eur (copy)_6996060553082118144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(SUM(iif([Calculation_21673596520853506], [commission_revenue_eur], 0))&#10;+ SUM(iif([Successful Orders OD RR (copy)_2744381027666284546], [commission_revenue_eur], 0))&#10;/ 21&#10;* ([Successful Orders OD RR (copy)_2744381027679891459] - DAY(TODAY()-1)))' />
