      <column caption='GMV Net YoY' datatype='real' name='[Successful Orders YoY (copy)_5858901647274610689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then &#10;(SUM(iif([MTD (copy)_3521463102101921795], [gmv_net_eur], 0))/&#10;SUM(iif([Previous Month (copy)_78461151781773327], [gmv_net_eur], 0)))-1&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;(SUM(iif([Calculation_21673596520853506], [gmv_net_eur], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149],[gmv_net_eur], 0)))-1&#10;END' />
      </column>
