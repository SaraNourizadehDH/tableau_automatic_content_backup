    <worksheet name='Acq YTD &amp; PYTD (4)'>
      <table>
        <view>
          <datasources>
            <datasource caption='eu_apac_weekly_monthly_dashboard (shared_eu)' name='federated.0o8z4j10mdnvs71h0vv4p0krv0fg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0o8z4j10mdnvs71h0vv4p0krv0fg].[max_order_week_pandora (copy)_5997316964600938500]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0o8z4j10mdnvs71h0vv4p0krv0fg].[Order Day (copy)_5361464990301970432]' caption='Reporting Week' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-03-24#'>
              <calculation class='tableau' formula='#2025-03-24#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o8z4j10mdnvs71h0vv4p0krv0fg'>
            <column caption='Acquisitions YTD' datatype='integer' name='[Acquisitions QTD (copy)_132574750955360304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([MTD (copy)_6569414853215997956], [main_total_new_customer_count], 0))' />
            </column>
            <column caption='Acquisitions LY YTD' datatype='integer' name='[Acquisitions YTD (copy)_132574750955466801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([PMTD (copy)_6569414853216116741], [main_total_new_customer_count], 0))' />
            </column>
            <column caption='Active Customers YTD' datatype='integer' name='[Active Customers MTD  (copy)_132574750950314025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM(iif([YTD], [Active Customers Daily], 0))&#10;&#10;&#10;MAX(IF DAY(TODAY()) = 1 and year(today()) &lt;&gt; year(today()-1) THEN [au_previous_year_cumulative_cum_distinct_cnt] ELSE&#10;[au_current_year_cumulative_cum_distinct_cnt] END)' />
            </column>
            <column caption='Active Customers LY YTD' datatype='integer' name='[Active Customers YTD (copy)_132574750950453290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//SUM(iif([PYTD], [Active Customers Daily], 0))&#10;&#10;//MAX(&#10;//IF DAY([Reporting Week]) = 1 and YEAR([Reporting Week]) &lt;&gt; year([Reporting Week]-1) and year([Order Day]) &lt; year(TODAY()-1)&#10;// THEN [au_2y_ago_ytd_cumulative_cum_distinct_cnt] &#10;//ELSEIF  DATEPART(&apos;day&apos;,[Order Day]) &lt;= DATEPART(&apos;day&apos;,DATEADD(&apos;year&apos;, -1, TODAY()-1)) &#10;//THEN&#10;//[Au Previous Year Cumulative Cum Distinct Cnt] else null END)&#10;&#10;MAX(&#10;IF  DATEPART(&apos;day&apos;,[order_day]) &lt;= DATEPART(&apos;day&apos;,DATEADD(&apos;year&apos;, -1, TODAY()-1)) &#10;and DATEPART(&apos;month&apos;,[order_day]) = DATEPART(&apos;month&apos;,DATEADD(&apos;year&apos;, -1, TODAY()-1)) &#10;THEN &#10;[au_previous_year_cumulative_cum_distinct_cnt] else null END)&#10;&#10;&#10;//MAX(&#10;//IF DAY(TODAY()) = 1 and YEAR(today()) &lt;&gt; year(TODAY()-1) and year([Order Day]) &lt; year(TODAY()-1)&#10; //THEN [au_2y_ago_ytd_cumulative_cum_distinct_cnt] &#10;//ELSEIF  DATEPART(&apos;day&apos;,[Order Day]) &lt;= DATEPART(&apos;day&apos;,DATEADD(&apos;year&apos;, -1, [Reporting Week])) &#10;//THEN&#10;//[Au Previous Year Cumulative Cum Distinct Cnt] else null END)' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_78461151869382693]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF   [global_entity_id] in (&apos;YS_TR&apos;,&#10;&apos;total&apos;,&#10;&apos;PO_FI&apos;,&#10;&apos;OP_SE&apos;,&#10;&apos;NP_HU&apos;,&#10;&apos;MJM_AT&apos;,&#10;&apos;total_with_TR&apos;,&#10;&apos;FO_NO&apos;,&#10;&apos;DJ_CZ&apos;,) then &apos;EU &amp; Yemeksepeti&apos;&#10;ELSEIF  [global_entity_id] in(&#10;&#10;&#10;&apos;FP_TW&apos;,&#10;&apos;FP_TH&apos;,&#10;&apos;FP_SG&apos;,&#10;&apos;FP_PK&apos;,&#10;&apos;FP_PH&apos;,&#10;&apos;FP_MY&apos;,&#10;&apos;FP_MM&apos;,&#10;&apos;FP_LA&apos;,&#10;&apos;FP_KH&apos;,&#10;&apos;FP_HK&apos;,&#10;&apos;FP_BD&apos;,&#10;&apos;APAC&apos;) then &apos;APAC&apos;&#10;ELSEIF  [global_entity_id] =&#10;&apos;Total APAC_EU_TR&apos; then &apos;Pandora&apos; end' />
            </column>
            <column caption='YTD' datatype='boolean' name='[MTD (copy)_6569414853215997956]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;,[order_day]) = DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])&#10;AND [order_day] &lt;= [Parameters].[Parameter 1]&#10; or (DATETRUNC(&apos;year&apos;,[order_day]) = DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])&#10; and DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;&#10;&#10;&#10;&#10;//IF &#10;//[Max Order Week] = [Reporting Week] and &#10;//DATETRUNC(&apos;year&apos;,[Order Day]) = DATETRUNC(&apos;year&apos;,[Reporting Week])&#10;//and &#10;//[Order Day] &lt;= [Reporting Week]&#10;//THEN TRUE ELSEIF&#10;//[Max Order Week] &lt;&gt; [Reporting Week] and  DATETRUNC(&apos;year&apos;,[Order Day]) = DATETRUNC(&apos;year&apos;,[Reporting Week]) and [Order Day] &lt;= [Reporting Week]&#10;//THEN TRUE END' />
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;))' />
            </column>
            <column caption='PYTD' datatype='boolean' name='[PMTD (copy)_6569414853216116741]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [Max Order Week] = [Reporting Week] and &#10;//DATETRUNC(&apos;year&apos;,[Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Reporting Week])) &#10;  //  AND DATEPART(&apos;dayofyear&apos;, [Order Day]) &lt;= DATEPART(&apos;dayofyear&apos;, today()-1)&#10;//THEN TRUE&#10;//ELSEIF  &#10;//[Max Order Week] &lt;&gt; [Reporting Week] and &#10;//DATETRUNC(&apos;year&apos;,[Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Reporting Week])) &#10;  //  AND DATEPART(&apos;dayofyear&apos;, [Order Day]) &lt;= DATEPART(&apos;dayofyear&apos;, [Reporting Week])&#10;//THEN TRUE &#10;//END&#10;&#10;&#10;&#10;DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])) &#10;AND [order_day] &lt;= dateadd(&apos;year&apos;,-1,[Parameters].[Parameter 1])&#10;or (DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])) &#10;and DATEPART(&apos;week&apos;,  (DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])+6)) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))' />
            </column>
            <column caption='YTD Title' datatype='string' name='[QTD Title (copy)_1369798010025598979]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, DATEADD(&apos;year&apos;, -1,[Parameters].[Parameter 1]))) + &quot;                         &quot; +&#10;STR(DATEPART(&apos;year&apos;,[Parameters].[Parameter 1]))' />
              <aliases>
                <alias key='&quot;W51/ W50&quot;' value='LW WoW' />
              </aliases>
            </column>
            <column caption='Au Current Year Cumulative Cum Distinct Cnt' datatype='integer' name='[au_current_year_cumulative_cum_distinct_cnt]' role='measure' type='quantitative' />
            <column caption='Au Previous Year Cumulative Cum Distinct Cnt' datatype='integer' name='[au_previous_year_cumulative_cum_distinct_cnt]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;APAC&quot;' value='       APAC' />
                <alias key='&quot;DH EU + Turkey&quot;' value='       DH EU + Turkey' />
                <alias key='&quot;DH Europe&quot;' value='      DH Europe' />
                <alias key='&quot;Total APAC_EU_TR&quot;' value='       PANDORA' />
              </aliases>
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Main Total New Customer Count' datatype='integer' name='[main_total_new_customer_count]' role='measure' type='quantitative' />
            <column caption='-1 max_order_week_pandora' datatype='date' name='[max_order_week_pandora (copy)_5997316964600938500]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))-1}' />
            </column>
            <column-instance column='[Calculation_78461151869382693]' derivation='None' name='[none:Calculation_78461151869382693:nk]' pivot='key' type='nominal' />
            <column-instance column='[QTD Title (copy)_1369798010025598979]' derivation='None' name='[none:QTD Title (copy)_1369798010025598979:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column caption='Order Day' datatype='date' name='[order_day]' role='dimension' type='ordinal' />
            <column-instance column='[Acquisitions QTD (copy)_132574750955360304]' derivation='User' name='[usr:Acquisitions QTD (copy)_132574750955360304:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Acquisitions YTD (copy)_132574750955466801]' derivation='User' name='[usr:Acquisitions YTD (copy)_132574750955466801:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Active Customers MTD  (copy)_132574750950314025]' derivation='User' name='[usr:Active Customers MTD  (copy)_132574750950314025:qk]' pivot='key' type='quantitative' />
