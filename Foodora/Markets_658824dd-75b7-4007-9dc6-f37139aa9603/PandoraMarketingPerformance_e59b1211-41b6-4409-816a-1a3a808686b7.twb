    <worksheet name='PRO Rate MTD &amp; LY MTD 2 (4)'>
      <table>
        <view>
          <datasources>
            <datasource caption='eu_apac_weekly_monthly_dashboard (shared_eu)' name='federated.0o8z4j10mdnvs71h0vv4p0krv0fg' />
          </datasources>
          <datasource-dependencies datasource='federated.0o8z4j10mdnvs71h0vv4p0krv0fg'>
            <column caption='Pro Join Rate MTD' datatype='real' name='[Calculation_5997316964570660864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([new_subscription_activations_mtd]+ [returning_subscription_activations_mtd]) / [non_pro_users_mtd]' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_78461151869382693]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF   [global_entity_id] in (&apos;YS_TR&apos;,&#10;&apos;total&apos;,&#10;&apos;PO_FI&apos;,&#10;&apos;OP_SE&apos;,&#10;&apos;NP_HU&apos;,&#10;&apos;MJM_AT&apos;,&#10;&apos;total_with_TR&apos;,&#10;&apos;FO_NO&apos;,&#10;&apos;DJ_CZ&apos;,) then &apos;EU &amp; Yemeksepeti&apos;&#10;ELSEIF  [global_entity_id] in(&#10;&#10;&#10;&apos;FP_TW&apos;,&#10;&apos;FP_TH&apos;,&#10;&apos;FP_SG&apos;,&#10;&apos;FP_PK&apos;,&#10;&apos;FP_PH&apos;,&#10;&apos;FP_MY&apos;,&#10;&apos;FP_MM&apos;,&#10;&apos;FP_LA&apos;,&#10;&apos;FP_KH&apos;,&#10;&apos;FP_HK&apos;,&#10;&apos;FP_BD&apos;,&#10;&apos;APAC&apos;) then &apos;APAC&apos;&#10;ELSEIF  [global_entity_id] =&#10;&apos;Total APAC_EU_TR&apos; then &apos;Pandora&apos; end' />
            </column>
            <column caption='Highlighted ' datatype='string' name='[Calculation_932808133706829827]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name] in (&quot;APAC&quot; , &quot;DH Europe&quot;, &quot;DH EU + Turkey&quot;, &quot;Total APAC_EU_TR&quot; )THEN &quot;Highlighted&quot;&#10;ELSE &quot;Normal&quot;&#10;END' />
            </column>
            <column caption='LY MTD Title without RR' datatype='string' name='[LY MTD Title (copy)_1369798010026901509]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;month&apos;, DATEADD(&apos;year&apos;, -1,{MAX([order_day])}))) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, DATEADD(&apos;year&apos;, -1,{MAX([order_day])})))&#10;+&#10;&quot;                     &quot;&#10;+&#10;STR(DATEPART(&apos;month&apos;, {MAX([order_day])})) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;,{MAX([order_day])}))' />
              <aliases>
                <alias key='&quot;W51/ W50&quot;' value='LW WoW' />
              </aliases>
            </column>
            <column caption='PRO Rate  LY MTD' datatype='real' name='[PRO Active Customers LY MTD (copy)_453456248036270081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//MAX(IF &#10;//DATETRUNC(&apos;year&apos;, [Order Day]) = DATETRUNC(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, TODAY()))&#10;//AND DAY([Date]) &lt;= DAY(TODAY()-1)&#10;//THEN [au_ly_current_month_cumulative_cum_distinct_cnt] END)&#10;&#10;&#10;//MAX(IF DAY(TODAY()) = 1 and DATETRUNC(&apos;year&apos;, [Order Day]) = DATETRUNC(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, TODAY()))&#10; //THEN [Au Ly Pmtd Cumulative Pro Rate] &#10;//ELSEIF DATEPART(&apos;day&apos;,[Order Day]) = DATEPART(&apos;day&apos;,DATEADD(&apos;year&apos;, -1, TODAY()-1)) &#10;//THEN&#10;//[Au Ly Current Month Cumulative Pro Rate] else null END)&#10;&#10;max(IF [is_max_order_day (copy)_746401337486544896] then [au_ly_current_month_cumulative_pro_rate]  end)' />
            </column>
            <column caption='PRO Rate MTD' datatype='real' name='[PRO Active Customers MTD (copy)_453456248035921920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum(iif([MTD], [Active Customers Monthly], 0))&#10;&#10;///((sum(iif([Is Yesterday], [Active Customers Monthly], 0))&#10;&#10;//SUM(iif([MTD], [Active Customers Daily], 0))&#10;max(IF [max_order_date -1 (copy)_659144087537639425] then [au_current_month_cumulative_pro_rate]  end)&#10;&#10;&#10;//MAX(iif([MTD], [Au Current Month Cumulative Pro Rate], 0))' />
            </column>
            <column caption='Pro Join Rate LY MTD' datatype='real' name='[Pro Join Rate PMTD (copy)_5997316964571025410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([new_subscription_activations_lymtd]+ [returning_subscription_activations_lymtd]) / [non_pro_users_lymtd]' />
            </column>
            <column caption='Au Current Month Cumulative Pro Rate' datatype='real' name='[au_current_month_cumulative_pro_rate]' role='measure' type='quantitative' />
            <column caption='Au Ly Current Month Cumulative Pro Rate' datatype='real' name='[au_ly_current_month_cumulative_pro_rate]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;APAC&quot;' value='       APAC' />
                <alias key='&quot;DH EU + Turkey&quot;' value='       DH EU + Turkey' />
                <alias key='&quot;DH Europe&quot;' value='      DH Europe' />
                <alias key='&quot;Total APAC_EU_TR&quot;' value='       PANDORA' />
              </aliases>
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='is_ly_max_order_day' datatype='boolean' datatype-customized='true' name='[is_max_order_day (copy)_746401337486544896]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_day] = (DATEADD(&apos;year&apos;, -1, {MAX(DATE([order_day]))}))' />
            </column>
            <column caption='is_max_order_day' datatype='boolean' name='[max_order_date -1 (copy)_659144087537639425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//[Order Day] = {MAX(DATE([Reporting Week]))}&#10;[order_day] = {MAX(DATE([order_day]))}' />
            </column>
            <column datatype='integer' name='[new_subscription_activations_lymtd]' role='measure' type='quantitative' />
            <column datatype='integer' name='[new_subscription_activations_mtd]' role='measure' type='quantitative' />
