        <calculation class='tableau' formula='((SUM(iif([order_day] = [Parameters].[Order Date Parameter], [daily_qc_active_customers], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter], [daily_total_active_customer_count], 0)))&#10;-&#10;&#10;(SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 7, [daily_qc_active_customers], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 7, [daily_total_active_customer_count], 0))))&#10; * 100' />
