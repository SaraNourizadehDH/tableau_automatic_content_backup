          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0o8z4j10mdnvs71h0vv4p0krv0fg].[max_order_week_pandora (copy)_78461151866597412]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0o8z4j10mdnvs71h0vv4p0krv0fg].[Order Week (copy)_78461151772839940]' caption='Reporting Month' datatype='date' name='[Reporting Week (copy)_78461151772667907]' param-domain-type='list' role='measure' type='quantitative' value='#2025-02-01#'>
              <calculation class='tableau' formula='#2025-02-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o8z4j10mdnvs71h0vv4p0krv0fg'>
            <column caption='Reporting Month Filter' datatype='boolean' name='[Calculation_123989787767152646]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Order Week (copy)_78461151772839940] &gt;= DATEADD(&apos;month&apos;,-12,[Parameters].[Reporting Week (copy)_78461151772667907])&#10;AND&#10;[Order Week (copy)_78461151772839940] &lt;= [Parameters].[Reporting Week (copy)_78461151772667907]' />
            </column>
            <column caption='Monthly Pro Customer % ' datatype='real' name='[Calculation_3379177467587899392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([monthly_pro_customer]) / AVG([monthly_total_active_customer_count])' />
            </column>
            <column caption='% HVA Incentive' datatype='real' name='[Calculation_525795258617450496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(hva_incentived_eur) /&#10;SUM(dh_mkt_contribution_eur)' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_78461151869382693]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF   [global_entity_id] in (&apos;YS_TR&apos;,&#10;&apos;total&apos;,&#10;&apos;PO_FI&apos;,&#10;&apos;OP_SE&apos;,&#10;&apos;NP_HU&apos;,&#10;&apos;MJM_AT&apos;,&#10;&apos;total_with_TR&apos;,&#10;&apos;FO_NO&apos;,&#10;&apos;DJ_CZ&apos;,) then &apos;EU &amp; Yemeksepeti&apos;&#10;ELSEIF  [global_entity_id] in(&#10;&#10;&#10;&apos;FP_TW&apos;,&#10;&apos;FP_TH&apos;,&#10;&apos;FP_SG&apos;,&#10;&apos;FP_PK&apos;,&#10;&apos;FP_PH&apos;,&#10;&apos;FP_MY&apos;,&#10;&apos;FP_MM&apos;,&#10;&apos;FP_LA&apos;,&#10;&apos;FP_KH&apos;,&#10;&apos;FP_HK&apos;,&#10;&apos;FP_BD&apos;,&#10;&apos;APAC&apos;) then &apos;APAC&apos;&#10;ELSEIF  [global_entity_id] =&#10;&apos;Total APAC_EU_TR&apos; then &apos;Pandora&apos; end' />
            </column>
            <column caption='Highlighted ' datatype='string' name='[Calculation_932808133706829827]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name] in (&quot;APAC&quot; , &quot;DH Europe&quot;, &quot;DH EU + Turkey&quot;, &quot;Total APAC_EU_TR&quot; )THEN &quot;Highlighted&quot;&#10;ELSE &quot;Normal&quot;&#10;END' />
            </column>
            <column caption='% QC Customer' datatype='real' name='[Monthly Pro Customer %  (copy)_3379177467592249345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([monthly_qc_active_customers]) / avg([monthly_total_active_customer_count])' />
            </column>
            <column caption='Order Month' datatype='date' name='[Order Week (copy)_78461151772839940]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[order_day]))' />
            </column>
            <column caption='untill max day' datatype='boolean' name='[PMTD (copy)_748230860981755904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [last_sunday_of_month] &lt;&gt; [Reporting Week] THEN&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Reporting Week]))&#10;   // AND [Order Day] &lt;= DATEADD(&apos;month&apos;, -1, [Reporting Week])&#10;//ELSE&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Reporting Week]))&#10;   // AND DATEPART(&apos;week&apos;, [Reporting Week] + 6) = DATEPART(&apos;week&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day]))))&#10;//END&#10;&#10;DAY([order_day]) &lt;=  DAY({MAX([order_day])})' />
            </column>
            <column caption='PRO Rate  PMTD' datatype='real' name='[PRO Active Customers PMTD (copy)_453456248036909059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//MAX(IF &#10;//DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#10;//AND DAY([Order Day]) = DAY(TODAY()-1)&#10;//THEN [Au Previous Month Cumulative Pro Rate] END)&#10;&#10;//IF [is_max_order_day] then [Au Previous Month Cumulative Pro Rate] end&#10;&#10;//max(iif([PMTD], [Au Previous Month Cumulative Pro Rate] , 0))&#10;max(IF [is_ly_max_order_day (copy)_746401337487560705] then [au_previous_month_cumulative_pro_rate]  end)' />
            </column>
            <column caption='PRO Active Customers PMTD' datatype='integer' name='[QC Active Customers PMTD (copy)_123989787758460932]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//MAX(IF &#10;//DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#10;//AND DAY([Order Day]) &lt;= DAY(TODAY()-1)&#10;//THEN [Au Previous Month Cumulative Cum Distinct Cnt (Weekly Monthly Mkt Mtd Qtd Ytd Kpi Eu Apac Pro Mau)] END)&#10;&#10;&#10;max(iif([is_ly_max_order_day (copy)_746401337487560705], [au_previous_month_cumulative_cum_distinct_cnt (weekly_monthly_mkt_mtd_qtd_ytd_kpi_eu_apac_pro_mau)] , 0))' />
            </column>
            <column caption='Au Previous Month Cumulative Cum Distinct Cnt (Weekly Monthly Mkt Mtd Qtd Ytd Kpi Eu Apac Pro Mau)' datatype='integer' name='[au_previous_month_cumulative_cum_distinct_cnt (weekly_monthly_mkt_mtd_qtd_ytd_kpi_eu_apac_pro_mau)]' role='measure' type='quantitative' />
            <column caption='Au Previous Month Cumulative Pro Rate' datatype='real' name='[au_previous_month_cumulative_pro_rate]' role='measure' type='quantitative' />
            <column-instance column='[monthly_pro_customer]' derivation='Avg' name='[avg:monthly_pro_customer:qk]' pivot='key' type='quantitative' />
            <column-instance column='[monthly_pro_rate]' derivation='Avg' name='[avg:monthly_pro_rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[monthly_qc_active_customers]' derivation='Avg' name='[avg:monthly_qc_active_customers:qk]' pivot='key' type='quantitative' />
