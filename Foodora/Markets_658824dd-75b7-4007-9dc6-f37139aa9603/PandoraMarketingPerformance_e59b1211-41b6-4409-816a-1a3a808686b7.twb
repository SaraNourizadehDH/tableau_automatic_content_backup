            <column caption=' % HVA Incentive MoM' datatype='real' name='[Pro Rate MoM (copy)_951315054967836674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(avg(iif([This month], [% HVA Incentive], null))-&#10;//avg(iif([Previous Month], [% HVA Incentive], null))) * 100&#10;&#10;if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then &#10;((SUM(iif([MTD (copy)_3521463102101921795], hva_incentived_eur,0)) / SUM(iif([MTD (copy)_3521463102101921795], dh_mkt_contribution_eur,0)))&#10;-&#10;(SUM(iif([is_pm_max_order_day (copy)_78461151772184578], hva_incentived_eur,0)) / SUM(iif([is_pm_max_order_day (copy)_78461151772184578], dh_mkt_contribution_eur,0))))&#10;* 100&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;((SUM(iif([Calculation_21673596520853506], hva_incentived_eur,0)) / SUM(iif([Calculation_21673596520853506], dh_mkt_contribution_eur,0)))&#10;-&#10;(SUM(iif([Calculation_21673596521619459], hva_incentived_eur,0)) / SUM(iif([Calculation_21673596521619459], dh_mkt_contribution_eur,0))))&#10;* 100&#10;END' />
            </column>
