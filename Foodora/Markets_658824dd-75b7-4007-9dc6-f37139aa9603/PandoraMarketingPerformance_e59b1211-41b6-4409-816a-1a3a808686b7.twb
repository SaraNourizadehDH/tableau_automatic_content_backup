    <worksheet name='Monthly MoM'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='eu_apac_weekly_monthly_dashboard (shared_eu)' name='federated.0o8z4j10mdnvs71h0vv4p0krv0fg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0o8z4j10mdnvs71h0vv4p0krv0fg].[max_order_week_pandora (copy)_78461151866597412]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0o8z4j10mdnvs71h0vv4p0krv0fg].[Order Week (copy)_78461151772839940]' caption='Reporting Month' datatype='date' name='[Reporting Week (copy)_78461151772667907]' param-domain-type='list' role='measure' type='quantitative' value='#2025-02-01#'>
              <calculation class='tableau' formula='#2025-02-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o8z4j10mdnvs71h0vv4p0krv0fg'>
            <column caption=' % Monthly Pro Customer MoM' datatype='real' name='[ % HVA Incentive MoM (copy)_3379177467598913540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(avg(iif([This month], [% HVA Incentive], null))-&#10;//avg(iif([Previous Month], [% HVA Incentive], null))) * 100&#10;&#10;if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then &#10;((SUM(iif([MTD (copy)_3521463102101921795], [monthly_pro_customer],0)) / SUM(iif([MTD (copy)_3521463102101921795], [monthly_total_active_customer_count],0)))&#10;-&#10;(SUM(iif([is_pm_max_order_day (copy)_78461151772184578], [monthly_pro_customer],0)) / SUM(iif([is_pm_max_order_day (copy)_78461151772184578], [monthly_total_active_customer_count],0))))&#10;* 100&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;//((SUM(iif([MTD], [Monthly Pro Customer],0)) / SUM(iif([MTD], [monthly_total_active_customer_count],0)))&#10;//-&#10;//(SUM(iif([PMTD], [Monthly Pro Customer],0)) / SUM(iif([PMTD], [monthly_total_active_customer_count],0))))&#10;//* 100&#10;(AVG([active_subscribers_mtd])/ [Active Customers MTD growth % (copy) (copy)_132574750947786791]&#10;-&#10;AVG([active_subscribers_pmtd])/ [Calculation_1238419566430437376]) * 100&#10;&#10;END' />
            </column>
            <column caption=' % QC Active Customers MoM' datatype='real' name='[ % HVA Incentive MoM (copy)_3379177467599167493]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(avg(iif([This month], [% HVA Incentive], null))-&#10;//avg(iif([Previous Month], [% HVA Incentive], null))) * 100&#10;&#10;if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then &#10;((SUM(iif([MTD (copy)_3521463102101921795], [monthly_qc_active_customers],0)) / SUM(iif([MTD (copy)_3521463102101921795], [monthly_total_active_customer_count],0)))&#10;-&#10;(SUM(iif([is_pm_max_order_day (copy)_78461151772184578], [monthly_qc_active_customers],0)) / SUM(iif([is_pm_max_order_day (copy)_78461151772184578], [monthly_total_active_customer_count],0))))&#10;* 100&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;//((SUM(iif([MTD], [monthly_qc_active_customers],0)) / SUM(iif([MTD], [monthly_total_active_customer_count],0)))&#10;//-&#10;//(SUM(iif([PMTD], [monthly_qc_active_customers],0)) / SUM(iif([PMTD], [monthly_total_active_customer_count],0))))&#10;(([Active Customers MTD (copy 2)_126030480943054851] / [Active Customers MTD growth % (copy) (copy)_132574750947786791])&#10;-&#10;([Active Customers PMTD (copy)_126030480944484358] / [Calculation_1238419566430437376]))*100&#10;&#10;END' />
            </column>
            <column caption='Recquisitions MoM' datatype='real' name='[Acquisitions MoM (copy)_951315054966890496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then &#10;(SUM(iif([MTD (copy)_3521463102101921795], [reacquisiton], 0))/&#10;SUM(iif([is_pm_max_order_day (copy)_78461151772184578], [reacquisiton], 0)))-1&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;(SUM(iif([Calculation_21673596520853506], [reacquisiton], 0))/&#10;SUM(iif([Calculation_21673596521619459], [reacquisiton], 0)))-1&#10;END' />
            </column>
            <column caption='PM Acquisitions MoM' datatype='real' name='[Acquisitions MoM (copy)_951315054967005185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then &#10;(SUM(iif([MTD (copy)_3521463102101921795], [pm_acquisitions], 0))/&#10;SUM(iif([is_pm_max_order_day (copy)_78461151772184578], [pm_acquisitions], 0)))-1&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;(SUM(iif([Calculation_21673596520853506], [pm_acquisitions], 0))/&#10;SUM(iif([PMTD (copy)_6390256043387498496], [pm_acquisitions], 0)))-1&#10;END' />
            </column>
            <column caption='QC Active Customers MTD' datatype='integer' name='[Active Customers MTD (copy 2)_126030480943054851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum(iif([MTD], [Active Customers Monthly], 0))&#10;&#10;///((sum(iif([Is Yesterday], [Active Customers Monthly], 0))&#10;&#10;//SUM(iif([MTD], [Active Customers Daily], 0))&#10;&#10;//MAX(IF DAY(TODAY()) = 1 THEN [Au Previous Month Cumulative Cum Distinct Cnt (Weekly Monthly Mkt Mtd Qtd Ytd Kpi Pandora Qc)] ELSE&#10;//[Au Current Month Cumulative Cum Distinct Cnt (Weekly Monthly Mkt Mtd Qtd Ytd Kpi Pandora Qc)] END)&#10;&#10;&#10;MAX(iif([Calculation_21673596520853506], [au_current_month_cumulative_cum_distinct_cnt (weekly_monthly_mkt_mtd_qtd_ytd_kpi_pandora_qc)] , 0))' />
            </column>
            <column caption='Active Customers MTD' datatype='integer' name='[Active Customers MTD growth % (copy) (copy)_132574750947786791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum(iif([MTD], [Active Customers Monthly], 0))&#10;&#10;///((sum(iif([Is Yesterday], [Active Customers Monthly], 0))&#10;&#10;//SUM(iif([MTD], [Active Customers Daily], 0))&#10;&#10;//MAX(IF DAY([Reporting Week]) = 1 THEN [Au Previous Month Cumulative Cum Distinct Cnt]  &#10;//else [Au Current Month Cumulative Cum Distinct Cnt] END)&#10;&#10;MAX(iif([Calculation_21673596520853506], [au_current_month_cumulative_cum_distinct_cnt] , 0))' />
            </column>
            <column caption='QC Active Customers MTD growth %' datatype='real' name='[Active Customers MTD growth % (copy)_126030480944377861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Active Customers MTD (copy 2)_126030480943054851]/ [Active Customers PMTD (copy)_126030480944484358] -1' />
            </column>
            <column caption='QC Active Customers MoM' datatype='real' name='[Active Customers MoM (copy)_78461151825514519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then&#10;(avg(iif([MTD (copy)_3521463102101921795], [monthly_qc_active_customers], null))/&#10;avg(iif([is_pm_max_order_day (copy)_78461151772184578], [monthly_qc_active_customers], null)))-1&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;[Active Customers MTD growth % (copy)_126030480944377861]&#10;END' />
            </column>
            <column caption='Pro Active Customers MoM' datatype='real' name='[Active Customers MoM (copy)_78461151863492640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then &#10;(avg(iif([MTD (copy)_3521463102101921795], [monthly_pro_customer], null))/&#10;avg(iif([is_pm_max_order_day (copy)_78461151772184578], [monthly_pro_customer], null)))-1&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;[QC Active Customers MTD growth % (copy)_123989787758170114]&#10;END' />
            </column>
            <column caption='QC Active Customers PMTD' datatype='integer' name='[Active Customers PMTD (copy)_126030480944484358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//MAX(IF &#10;//DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#10;//AND DAY([Order Day]) &lt;= DAY(TODAY()-1)&#10;//THEN [Au Previous Month Cumulative Cum Distinct Cnt (Weekly Monthly Mkt Mtd Qtd Ytd Kpi Pandora Qc)] END)&#10;&#10;max(iif([Calculation_21673596521619459], [au_previous_month_cumulative_cum_distinct_cnt (weekly_monthly_mkt_mtd_qtd_ytd_kpi_pandora_qc)] , 0))' />
            </column>
            <column caption='Active Customers MTD growth %' datatype='real' name='[Active Riders MTD growth % (copy)_2076511279464325121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Active Customers MTD growth % (copy) (copy)_132574750947786791]/ [Calculation_1238419566430437376] -1' />
            </column>
            <column caption='Active Customers PMTD' datatype='integer' name='[Calculation_1238419566430437376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//MAX(IF &#10;//DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#10;//AND DAY([Order Day]) &lt;= DAY(TODAY()-1)&#10;//THEN [Au Previous Month Cumulative Cum Distinct Cnt] END)&#10;&#10;max(iif([Calculation_21673596521619459], [au_previous_month_cumulative_cum_distinct_cnt] , 0))' />
            </column>
            <column caption='Reporting Month Filter' datatype='boolean' name='[Calculation_123989787767152646]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Order Week (copy)_78461151772839940] &gt;= DATEADD(&apos;month&apos;,-12,[Parameters].[Reporting Week (copy)_78461151772667907])&#10;AND&#10;[Order Week (copy)_78461151772839940] &lt;= [Parameters].[Reporting Week (copy)_78461151772667907]' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_21673596520853506]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,today())&#10;//OR DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1)&#10;&#10;&#10;//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,[Reporting Week]) and day([Order Day]) &lt;= day([Reporting Week])&#10;//OR (DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1))&#10;&#10;//if you pick last week of month it brings full month&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,{MAX([order_day])}) &#10;    AND ([order_day] &lt;= {MAX([order_day])})&#10;    // OR DATEPART(&apos;week&apos;, [Reporting Week]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day])))) ))&#10;//OR (DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1) AND YEAR([Order Day]) = YEAR(TODAY()-1))' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_21673596521619459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [last_sunday_of_month] &lt;&gt; [Reporting Week] THEN&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Reporting Week]))&#10;   // AND [Order Day] &lt;= DATEADD(&apos;month&apos;, -1, [Reporting Week])&#10;//ELSE&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Reporting Week]))&#10;   // AND DATEPART(&apos;week&apos;, [Reporting Week] + 6) = DATEPART(&apos;week&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day]))))&#10;//END&#10;&#10;IF MONTH([order_day]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND YEAR([order_day]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND [order_day] &lt;= DATEADD(&apos;month&apos;, -1, {MAX([order_day])})&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='Pro Join Rate MTD' datatype='real' name='[Calculation_5997316964570660864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([new_subscription_activations_mtd]+ [returning_subscription_activations_mtd]) / [non_pro_users_mtd]' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_78461151869382693]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF   [global_entity_id] in (&apos;YS_TR&apos;,&#10;&apos;total&apos;,&#10;&apos;PO_FI&apos;,&#10;&apos;OP_SE&apos;,&#10;&apos;NP_HU&apos;,&#10;&apos;MJM_AT&apos;,&#10;&apos;total_with_TR&apos;,&#10;&apos;FO_NO&apos;,&#10;&apos;DJ_CZ&apos;,) then &apos;EU &amp; Yemeksepeti&apos;&#10;ELSEIF  [global_entity_id] in(&#10;&#10;&#10;&apos;FP_TW&apos;,&#10;&apos;FP_TH&apos;,&#10;&apos;FP_SG&apos;,&#10;&apos;FP_PK&apos;,&#10;&apos;FP_PH&apos;,&#10;&apos;FP_MY&apos;,&#10;&apos;FP_MM&apos;,&#10;&apos;FP_LA&apos;,&#10;&apos;FP_KH&apos;,&#10;&apos;FP_HK&apos;,&#10;&apos;FP_BD&apos;,&#10;&apos;APAC&apos;) then &apos;APAC&apos;&#10;ELSEIF  [global_entity_id] =&#10;&apos;Total APAC_EU_TR&apos; then &apos;Pandora&apos; end' />
            </column>
            <column caption='Mom Title' datatype='string' name='[Entity (copy)_78461151778439181]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;Then&#10;LEFT(DATENAME(&apos;month&apos;,[Parameters].[Reporting Week (copy)_78461151772667907]),3) + &quot; MoM&quot;&#10;ELSEIF month([Parameters].[Reporting Week (copy)_78461151772667907]) = month(TODAY()-1)&#10;THEN&#10;LEFT(DATENAME(&apos;month&apos;,[Parameters].[Reporting Week (copy)_78461151772667907]),3) + &quot; MTD MoM&quot;&#10;END' />
            </column>
            <column caption='This month' datatype='boolean' name='[MTD (copy)_3521463102101921795]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([order_day]) = MONTH([Parameters].[Reporting Week (copy)_78461151772667907])&#10;and&#10;YEAR([order_day]) = YEAR(([Parameters].[Reporting Week (copy)_78461151772667907]))' />
            </column>
            <column caption='Order Month' datatype='date' name='[Order Week (copy)_78461151772839940]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[order_day]))' />
            </column>
            <column caption='PM Acquisitions Spend MoM' datatype='real' name='[PM Acquisitions MoM (copy)_2553048418450046976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then &#10;(SUM(iif([MTD (copy)_3521463102101921795], [pm_acquisition_spend], 0))/&#10;SUM(iif([is_pm_max_order_day (copy)_78461151772184578], [pm_acquisition_spend], 0)))-1&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;(SUM(iif([Calculation_21673596520853506], [pm_acquisition_spend], 0))/&#10;SUM(iif([PMTD (copy)_6390256043387498496], [pm_acquisition_spend], 0)))-1&#10;END' />
            </column>
            <column caption='Acquisitions Spend MoM' datatype='real' name='[PM Acquisitions Spend MoM (copy)_2553048418450239490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then &#10;(SUM(iif([MTD (copy)_3521463102101921795], [acquisition_spend_eur], 0))/&#10;SUM(iif([is_pm_max_order_day (copy)_78461151772184578], [acquisition_spend_eur], 0)))-1&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;(SUM(iif([Calculation_21673596520853506], [acquisition_spend_eur], 0))/&#10;SUM(iif([Calculation_21673596521619459], [acquisition_spend_eur], 0)))-1&#10;END' />
            </column>
            <column caption='PMTD -1' datatype='boolean' name='[PMTD (copy)_6390256043387498496]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [last_sunday_of_month] &lt;&gt; [Reporting Week] THEN&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Reporting Week]))&#10;   // AND [Order Day] &lt;= DATEADD(&apos;month&apos;, -1, [Reporting Week])&#10;//ELSE&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Reporting Week]))&#10;   // AND DATEPART(&apos;week&apos;, [Reporting Week] + 6) = DATEPART(&apos;week&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day]))))&#10;//END&#10;&#10;IF MONTH([order_day]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND YEAR([order_day]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND [order_day] &lt;= DATEADD(&apos;month&apos;, -1, {MAX([order_day])}-1)&#10;THEN TRUE&#10;END' />
            </column>
            <column caption='PRO Rate MTD growth %' datatype='real' name='[PRO Active Customers MTD growth % (copy)_453456248036872194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_5997316964570660864])- sum([Pro Join Rate MTD (copy)_5997316964570943489]) )* 100' />
            </column>
            <column caption='Pro Rate MoM' datatype='real' name='[Pro Active Customers MoM (copy)_78461151863713825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then&#10;(avg(iif([MTD (copy)_3521463102101921795], [monthly_pro_rate], null))-&#10;avg(iif([is_pm_max_order_day (copy)_78461151772184578], [monthly_pro_rate], null))) * 100&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;[PRO Active Customers MTD growth % (copy)_453456248036872194]&#10;END' />
            </column>
            <column caption='Pro Join Rate PMTD' datatype='real' name='[Pro Join Rate MTD (copy)_5997316964570943489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([new_subscription_activations_pmtd]+ [returning_subscription_activations_pmtd]) / [non_pro_users_pmtd]' />
