              <calculation class='tableau' formula='//if month([Reporting Month]) &lt;&gt; month(TODAY()-1)&#10;//then&#10;//(avg(iif([This month], [monthly_reactivations], null))/&#10;//avg(iif([Previous Month], [monthly_reactivations], null)))-1&#10;//ELSEIF &#10;//month([Reporting Month])  = month(TODAY()-1)&#10;//THEN&#10;//(AVG(iif([MTD], [monthly_reactivations], 0))/&#10;//AVG(iif([PMTD],[monthly_reactivations], 0)))-1&#10;//END&#10;&#10;&#10;if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then&#10;(SUM(iif([MTD (copy)_3521463102101921795], [daily_reactivations], null))/&#10;SUM(iif([is_pm_max_order_day (copy)_78461151772184578], [daily_reactivations], null)))-1&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;(SUM(iif([Calculation_21673596520853506], [daily_reactivations], 0))/&#10;SUM(iif([PMTD (copy)_6390256043387498496],[daily_reactivations], 0)))-1&#10;END' />
