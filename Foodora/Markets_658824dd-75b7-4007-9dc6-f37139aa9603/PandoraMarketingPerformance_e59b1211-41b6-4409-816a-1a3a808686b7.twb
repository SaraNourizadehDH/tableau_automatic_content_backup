    <worksheet name='Monthly YoY'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='eu_apac_weekly_monthly_dashboard (shared_eu)' name='federated.0o8z4j10mdnvs71h0vv4p0krv0fg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0o8z4j10mdnvs71h0vv4p0krv0fg].[max_order_week_pandora (copy)_78461151866597412]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0o8z4j10mdnvs71h0vv4p0krv0fg].[Order Week (copy)_78461151772839940]' caption='Reporting Month' datatype='date' name='[Reporting Week (copy)_78461151772667907]' param-domain-type='list' role='measure' type='quantitative' value='#2025-02-01#'>
              <calculation class='tableau' formula='#2025-02-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o8z4j10mdnvs71h0vv4p0krv0fg'>
            <column caption=' % HVA Incentive YoY' datatype='real' name='[ % HVA Incentive MoM (copy)_951315054968819717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(avg(iif([This month], [% HVA Incentive], null))-&#10;//avg(iif([Previous Month], [% HVA Incentive], null))) * 100&#10;&#10;&#10;if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then &#10;((SUM(iif([MTD (copy)_3521463102101921795], hva_incentived_eur,0)) / SUM(iif([MTD (copy)_3521463102101921795], dh_mkt_contribution_eur,0)))&#10;-&#10;(SUM(iif([Previous Month (copy)_78461151781773327], hva_incentived_eur,0)) / SUM(iif([Previous Month (copy)_78461151781773327], dh_mkt_contribution_eur,0))))&#10;* 100&#10;&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;((SUM(iif([Calculation_21673596520853506], hva_incentived_eur,0)) / SUM(iif([Calculation_21673596520853506], dh_mkt_contribution_eur,0)))&#10;-&#10;(SUM(iif([MTD (copy)_1931270242863067149], hva_incentived_eur,0)) / SUM(iif([MTD (copy)_1931270242863067149], dh_mkt_contribution_eur,0))))&#10;* 100&#10;&#10;END' />
            </column>
            <column caption=' % Monthly Pro Customer YoY' datatype='real' name='[ % Monthly Pro Customer MoM (copy)_3379177467601784838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(avg(iif([This month], [% HVA Incentive], null))-&#10;//avg(iif([Previous Month], [% HVA Incentive], null))) * 100&#10;&#10;if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then &#10;((SUM(iif([MTD (copy)_3521463102101921795], [monthly_pro_customer],0)) / SUM(iif([MTD (copy)_3521463102101921795], [monthly_total_active_customer_count],0)))&#10;-&#10;(SUM(iif([Previous Month (copy)_78461151781773327], [monthly_pro_customer],0)) / SUM(iif([Previous Month (copy)_78461151781773327], [monthly_total_active_customer_count],0))))&#10;* 100&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;//((SUM(iif([MTD], [Monthly Pro Customer],0)) / SUM(iif([MTD], [monthly_total_active_customer_count],0)))&#10;//-&#10;//(SUM(iif([LY MTD], [Monthly Pro Customer],0)) / SUM(iif([LY MTD], [monthly_total_active_customer_count],0))))&#10;//* 100&#10;(AVG([active_subscribers_mtd])/ [Active Customers MTD growth % (copy) (copy)_132574750947786791]&#10;-&#10;AVG([active_subscribers_lymtd])/ [Active Customers PMTD new (copy)_1397171453351776256]) * 100&#10;END' />
            </column>
            <column caption=' % QC Active Customers YoY' datatype='real' name='[ % QC Active Customers MoM (copy)_3379177467601915911]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//(avg(iif([This month], [% HVA Incentive], null))-&#10;//avg(iif([Previous Month], [% HVA Incentive], null))) * 100&#10;&#10;if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then &#10;((avg(iif([MTD (copy)_3521463102101921795], [monthly_qc_active_customers],0)) / avg(iif([MTD (copy)_3521463102101921795], [monthly_total_active_customer_count],0)))&#10;-&#10;(avg(iif([Previous Month (copy)_78461151781773327], [monthly_qc_active_customers],0)) / avg(iif([Previous Month (copy)_78461151781773327], [monthly_total_active_customer_count],0))))&#10;* 100&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;//((avg(iif([MTD], [monthly_qc_active_customers],0)) / avg(iif([MTD], [monthly_total_active_customer_count],0)))&#10;//-&#10;//(avg(iif([LY MTD], [monthly_qc_active_customers],0)) / avg(iif([LY MTD], [monthly_total_active_customer_count],0))))&#10;//* 100&#10;(([Active Customers MTD (copy 2)_126030480943054851] / [Active Customers MTD growth % (copy) (copy)_132574750947786791])&#10;-&#10;([Active Customers LY MTD (copy)_126030480943329284] / [Active Customers PMTD new (copy)_1397171453351776256]))*100&#10;END' />
            </column>
            <column caption='Acquisitions YoY' datatype='real' name='[Acquisitions MoM (copy)_78461151782768660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then &#10;(SUM(iif([MTD (copy)_3521463102101921795], [main_total_new_customer_count], 0))/&#10;SUM(iif([Previous Month (copy)_78461151781773327], [main_total_new_customer_count], 0)))-1&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;(SUM(iif([Calculation_21673596520853506], [main_total_new_customer_count], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149],[main_total_new_customer_count], 0)))-1&#10;END' />
            </column>
            <column caption='QC Active Customers LY MTD' datatype='integer' name='[Active Customers LY MTD (copy)_126030480943329284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//MAX(IF &#10;//DATETRUNC(&apos;year&apos;, [Order Day]) = DATETRUNC(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, TODAY()))&#10;//AND DAY([Date]) &lt;= DAY(TODAY()-1)&#10;//THEN [au_ly_current_month_cumulative_cum_distinct_cnt] END)&#10;&#10;&#10;//MAX(IF DAY(TODAY()) = 1 and DATETRUNC(&apos;year&apos;, [Order Day]) = DATETRUNC(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, TODAY()))&#10; //THEN [Au Ly Pmtd Cumulative Cum Distinct Cnt (Weekly Monthly Mkt Mtd Qtd Ytd Kpi Pandora Qc)] &#10;//ELSEIF DATEPART(&apos;day&apos;,[Order Day]) = DATEPART(&apos;day&apos;,DATEADD(&apos;year&apos;, -1, TODAY()-1)) &#10;//THEN&#10;//[Au Ly Current Month Cumulative Cum Distinct Cnt (Weekly Monthly Mkt Mtd Qtd Ytd Kpi Pandora Qc)] else null END)&#10;&#10;&#10;&#10;&#10;MAX(iif([MTD (copy)_1931270242863067149], [au_ly_current_month_cumulative_cum_distinct_cnt (weekly_monthly_mkt_mtd_qtd_ytd_kpi_pandora_qc)] , 0))' />
            </column>
            <column caption='QC Active Customers LY MTD growth %' datatype='real' name='[Active Customers LY MTD growth % (copy)_126030480945119239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//IF &#10;//(SUM(iif([MTD], [Active Customers Daily], 0))/&#10;//SUM(iif([LY MTD], [Active Customers Daily], 0)))-1 &gt;= 5&#10;//THEN NULL&#10;//ELSE&#10;//(SUM(iif([MTD], [Active Customers Daily], 0))/&#10;//SUM(iif([LY MTD], [Active Customers Daily], 0)))-1&#10;//END&#10;&#10;[Active Customers MTD (copy 2)_126030480943054851]/ [Active Customers LY MTD (copy)_126030480943329284] -1' />
            </column>
            <column caption='QC Active Customers MTD' datatype='integer' name='[Active Customers MTD (copy 2)_126030480943054851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum(iif([MTD], [Active Customers Monthly], 0))&#10;&#10;///((sum(iif([Is Yesterday], [Active Customers Monthly], 0))&#10;&#10;//SUM(iif([MTD], [Active Customers Daily], 0))&#10;&#10;//MAX(IF DAY(TODAY()) = 1 THEN [Au Previous Month Cumulative Cum Distinct Cnt (Weekly Monthly Mkt Mtd Qtd Ytd Kpi Pandora Qc)] ELSE&#10;//[Au Current Month Cumulative Cum Distinct Cnt (Weekly Monthly Mkt Mtd Qtd Ytd Kpi Pandora Qc)] END)&#10;&#10;&#10;MAX(iif([Calculation_21673596520853506], [au_current_month_cumulative_cum_distinct_cnt (weekly_monthly_mkt_mtd_qtd_ytd_kpi_pandora_qc)] , 0))' />
            </column>
            <column caption='Active Customers MTD' datatype='integer' name='[Active Customers MTD growth % (copy) (copy)_132574750947786791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum(iif([MTD], [Active Customers Monthly], 0))&#10;&#10;///((sum(iif([Is Yesterday], [Active Customers Monthly], 0))&#10;&#10;//SUM(iif([MTD], [Active Customers Daily], 0))&#10;&#10;//MAX(IF DAY([Reporting Week]) = 1 THEN [Au Previous Month Cumulative Cum Distinct Cnt]  &#10;//else [Au Current Month Cumulative Cum Distinct Cnt] END)&#10;&#10;MAX(iif([Calculation_21673596520853506], [au_current_month_cumulative_cum_distinct_cnt] , 0))' />
            </column>
            <column caption='Active Customers LY MTD growth %' datatype='real' name='[Active Customers MTD growth % (copy)_3966334270609727502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//IF &#10;//(SUM(iif([MTD], [Active Customers Daily], 0))/&#10;//SUM(iif([LY MTD], [Active Customers Daily], 0)))-1 &gt;= 5&#10;//THEN NULL&#10;//ELSE&#10;//(SUM(iif([MTD], [Active Customers Daily], 0))/&#10;//SUM(iif([LY MTD], [Active Customers Daily], 0)))-1&#10;//END&#10;&#10;[Active Customers MTD growth % (copy) (copy)_132574750947786791]/ [Active Customers PMTD new (copy)_1397171453351776256] -1' />
            </column>
            <column caption='Active Customers YoY' datatype='real' name='[Active Customers MoM (copy)_78461151826505752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;then &#10;(avg(iif([MTD (copy)_3521463102101921795], [monthly_total_active_customer_count], null))/&#10;avg(iif([Previous Month (copy)_78461151781773327], [monthly_total_active_customer_count], null)))-1&#10;ELSEIF &#10;month([Parameters].[Reporting Week (copy)_78461151772667907])  = month(TODAY()-1)&#10;THEN&#10;[Active Customers MTD growth % (copy)_3966334270609727502]&#10;END' />
            </column>
            <column caption='Active Customers LY MTD' datatype='integer' name='[Active Customers PMTD new (copy)_1397171453351776256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//MAX(IF &#10;//DATETRUNC(&apos;year&apos;, [Order Day]) = DATETRUNC(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, TODAY()))&#10;//AND DAY([Date]) &lt;= DAY(TODAY()-1)&#10;//THEN [au_ly_current_month_cumulative_cum_distinct_cnt] END)&#10;&#10;&#10;//MAX(IF DAY(TODAY()) = 1 and DATETRUNC(&apos;year&apos;, [Order Day]) = DATETRUNC(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, TODAY()))&#10; //THEN [Au Ly Pmtd Cumulative Cum Distinct Cnt] &#10;//ELSEIF DATEPART(&apos;day&apos;,[Order Day]) = DATEPART(&apos;day&apos;,DATEADD(&apos;year&apos;, -1, TODAY()-1)) &#10;//THEN&#10;//[Au Ly Current Month Cumulative Cum Distinct Cnt] else null END)&#10;&#10;&#10;MAX(iif([MTD (copy)_1931270242863067149], [au_ly_current_month_cumulative_cum_distinct_cnt] , 0))' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_21673596520853506]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,today())&#10;//OR DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1)&#10;&#10;&#10;//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,[Reporting Week]) and day([Order Day]) &lt;= day([Reporting Week])&#10;//OR (DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1))&#10;&#10;//if you pick last week of month it brings full month&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,{MAX([order_day])}) &#10;    AND ([order_day] &lt;= {MAX([order_day])})&#10;    // OR DATEPART(&apos;week&apos;, [Reporting Week]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day])))) ))&#10;//OR (DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1) AND YEAR([Order Day]) = YEAR(TODAY()-1))' />
            </column>
            <column caption='Pro Join Rate MTD' datatype='real' name='[Calculation_5997316964570660864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([new_subscription_activations_mtd]+ [returning_subscription_activations_mtd]) / [non_pro_users_mtd]' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_78461151869382693]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF   [global_entity_id] in (&apos;YS_TR&apos;,&#10;&apos;total&apos;,&#10;&apos;PO_FI&apos;,&#10;&apos;OP_SE&apos;,&#10;&apos;NP_HU&apos;,&#10;&apos;MJM_AT&apos;,&#10;&apos;total_with_TR&apos;,&#10;&apos;FO_NO&apos;,&#10;&apos;DJ_CZ&apos;,) then &apos;EU &amp; Yemeksepeti&apos;&#10;ELSEIF  [global_entity_id] in(&#10;&#10;&#10;&apos;FP_TW&apos;,&#10;&apos;FP_TH&apos;,&#10;&apos;FP_SG&apos;,&#10;&apos;FP_PK&apos;,&#10;&apos;FP_PH&apos;,&#10;&apos;FP_MY&apos;,&#10;&apos;FP_MM&apos;,&#10;&apos;FP_LA&apos;,&#10;&apos;FP_KH&apos;,&#10;&apos;FP_HK&apos;,&#10;&apos;FP_BD&apos;,&#10;&apos;APAC&apos;) then &apos;APAC&apos;&#10;ELSEIF  [global_entity_id] =&#10;&apos;Total APAC_EU_TR&apos; then &apos;Pandora&apos; end' />
            </column>
            <column caption='LY MTD -1' datatype='boolean' name='[LY MTD (copy)_6390256043393650689]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [last_sunday_of_month] &lt;&gt; [Reporting Week] THEN&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;, [Reporting Week]))&#10;    //AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, [Reporting Week])&#10;//ELSE&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;, [Reporting Week]))&#10;   // AND DATEPART(&apos;week&apos;, [Reporting Week] + 6) = &#10;     //   DATEPART(&apos;week&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day]))))&#10;//END&#10;&#10;&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,{MAX([order_day])})) &#10;    AND day([order_day]) &lt;= day({MAX([order_day])}-1)&#10;    AND month([order_day]) &lt;= month({MAX([order_day])})' />
            </column>
            <column caption='LY MTD' datatype='boolean' name='[MTD (copy)_1931270242863067149]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [last_sunday_of_month] &lt;&gt; [Reporting Week] THEN&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;, [Reporting Week]))&#10;    //AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, [Reporting Week])&#10;//ELSE&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;, [Reporting Week]))&#10;   // AND DATEPART(&apos;week&apos;, [Reporting Week] + 6) = &#10;     //   DATEPART(&apos;week&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day]))))&#10;//END&#10;&#10;&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,{MAX([order_day])})) &#10;    AND day([order_day]) &lt;= day({MAX([order_day])})&#10;    AND month([order_day]) &lt;= month({MAX([order_day])})' />
            </column>
            <column caption='This month' datatype='boolean' name='[MTD (copy)_3521463102101921795]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='MONTH([order_day]) = MONTH([Parameters].[Reporting Week (copy)_78461151772667907])&#10;and&#10;YEAR([order_day]) = YEAR(([Parameters].[Reporting Week (copy)_78461151772667907]))' />
            </column>
            <column caption='YoY Title' datatype='string' name='[Mom Title (copy)_78461151782879253]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;Then&#10;LEFT(DATENAME(&apos;month&apos;,[Parameters].[Reporting Week (copy)_78461151772667907]),3) + &quot; YoY&quot;&#10;ELSEIF month([Parameters].[Reporting Week (copy)_78461151772667907]) = month(TODAY()-1)&#10;THEN&#10;LEFT(DATENAME(&apos;month&apos;,[Parameters].[Reporting Week (copy)_78461151772667907]),3) + &quot; MTD YoY&quot;&#10;END' />
            </column>
            <column caption='Order Month' datatype='date' name='[Order Week (copy)_78461151772839940]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[order_day]))' />
            </column>
