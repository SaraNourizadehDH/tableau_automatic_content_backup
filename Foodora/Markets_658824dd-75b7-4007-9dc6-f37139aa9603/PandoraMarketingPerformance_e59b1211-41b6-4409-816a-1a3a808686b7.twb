      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Monthly RR' id='_619D2BD0975E4FFFB247B9AB62141117'>
            <properties context=''>
              <relation connection='bigquery.0okpkzp01f337a1e6frc006dm9av' name='Custom SQL Query' type='text'>SELECT
  global_entity_id,
  DATE_TRUNC(order_day, month) month,
  max_order_day,
  SUM(gmv_net_eur) / EXTRACT (day FROM max_order_day) * EXTRACT(DAY FROM LAST_DAY(max_order_day)) AS gmv_net_eur_rr,
    SUM(hva_incentived_eur) / EXTRACT (day FROM max_order_day) * EXTRACT(DAY FROM LAST_DAY(max_order_day)) AS hva_incentived_eur_rr,
    SUM(dh_mkt_contribution_eur) / EXTRACT (day FROM max_order_day) * EXTRACT(DAY FROM LAST_DAY(max_order_day)) AS dh_mkt_contribution_eur_rr,
    SUM(main_total_new_customer_count) / EXTRACT (day FROM max_order_day) * EXTRACT(DAY FROM LAST_DAY(max_order_day)) AS main_total_new_customer_count_rr,
 SUM(reacquisiton) / EXTRACT (day FROM max_order_day) * EXTRACT(DAY FROM LAST_DAY(max_order_day)) AS 	reacquisiton_rr,
 SUM(pm_acquisitions) / EXTRACT (day FROM max_order_day-1) * EXTRACT(DAY FROM LAST_DAY(max_order_day)) AS 	pm_acquisitions_rr,
 SUM(pm_acquisition_spend) / EXTRACT (day FROM max_order_day) * EXTRACT(DAY FROM LAST_DAY(max_order_day)) AS 	pm_acquisition_spend_rr,
 SUM(acquisition_spend_eur) / EXTRACT (day FROM max_order_day) * EXTRACT(DAY FROM LAST_DAY(max_order_day)) AS acquisition_spend_eur_rr,
 SUM(total_number_of_successful_orders_qc) / EXTRACT (day FROM max_order_day) * EXTRACT(DAY FROM LAST_DAY(max_order_day)) AS total_number_of_successful_orders_qc_rr,
 --qc active
 --qc active %
 SUM(qc_gmv_eur) / EXTRACT (day FROM max_order_day) * EXTRACT(DAY FROM LAST_DAY(max_order_day)) AS qc_gmv_eur_rr,
 SUM(qc_trials) / EXTRACT (day FROM max_order_day) * EXTRACT(DAY FROM LAST_DAY(max_order_day)) AS qc_trials_rr,
 SUM(pro_order_gmv_eur) / EXTRACT (day FROM max_order_day) * EXTRACT(DAY FROM LAST_DAY(max_order_day)) AS pro_order_gmv_eur_rr,
  SUM(daily_reactivations) / EXTRACT (day FROM max_order_day-1) * EXTRACT(DAY FROM LAST_DAY(max_order_day)) AS daily_reactivations_rr,



FROM
  `dhub-yemek.shared_eu.eu_apac_weekly_monthly_dashboard`
WHERE
  DATE_TRUNC(order_day, month) = DATE_TRUNC(CURRENT_DATE() -1, month)
GROUP BY
  1,
  2,
  3</relation>
            </properties>
            <properties context='extract'>
              <relation name='_619D2BD0975E4FFFB247B9AB62141117' table='[Extract].[_619D2BD0975E4FFFB247B9AB62141117]' type='table' />
            </properties>
          </object>
