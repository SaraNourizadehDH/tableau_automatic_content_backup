      <column caption='PY' datatype='boolean' name='[PM (copy)_2387470757550784515]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,today()))' />
      </column>
      <column caption='PM' datatype='boolean' name='[PMTD (copy)_2744381027682492421]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,today())) &#10;OR DAY(TODAY()) = 1 AND MONTH([order_day]) = MONTH(TODAY()-1)-1' />
      </column>
      <column caption='PYTD' datatype='boolean' name='[PMTD (copy)_6569414853216116741]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF [Max Order Week] = [Reporting Week] and &#10;//DATETRUNC(&apos;year&apos;,[Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Reporting Week])) &#10;  //  AND DATEPART(&apos;dayofyear&apos;, [Order Day]) &lt;= DATEPART(&apos;dayofyear&apos;, today()-1)&#10;//THEN TRUE&#10;//ELSEIF  &#10;//[Max Order Week] &lt;&gt; [Reporting Week] and &#10;//DATETRUNC(&apos;year&apos;,[Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Reporting Week])) &#10;  //  AND DATEPART(&apos;dayofyear&apos;, [Order Day]) &lt;= DATEPART(&apos;dayofyear&apos;, [Reporting Week])&#10;//THEN TRUE &#10;//END&#10;&#10;&#10;&#10;DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])) &#10;AND [order_day] &lt;= dateadd(&apos;year&apos;,-1,[Parameters].[Parameter 1])&#10;or (DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])) &#10;and DATEPART(&apos;week&apos;,  (DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])+6)) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))' />
      </column>
      <column caption='LY QTD' datatype='boolean' name='[PQTD (copy)_1931270242855862274]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF &#10;//[Max Order Week] = [Reporting Week] and&#10;//[Order Day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;year&apos;, -1, [Reporting Week]))&#10;//AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, TODAY()-1)&#10;//THEN TRUE&#10;//ELSEIF&#10;//[Max Order Week] &lt;&gt; [Reporting Week] and&#10;//[Order Day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;year&apos;, -1, [Reporting Week]))&#10;//AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, [Reporting Week])&#10;//THEN TRUE&#10;//END&#10;&#10;&#10;[order_day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1]))&#10;AND [order_day] &lt;= DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1])&#10;OR (&#10;DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, (DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]))) &#10;//AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, [Reporting Week]))&#10;and DATEPART(&apos;week&apos;,  (DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])+6)) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;&#10;//DATETRUNC(&apos;quarter&apos;, [Order Day]) = DATETRUNC(&apos;quarter&apos;, (DATEADD(&apos;year&apos;,-1,[Reporting Week]))) &#10;//AND [Order Day] &lt;= [Reporting Week]&#10; //or (DATETRUNC(&apos;quarter&apos;, [Order Day]) = DATETRUNC(&apos;quarter&apos;, (DATEADD(&apos;year&apos;,-1,[Reporting Week]))) &#10; //and DATEPART(&apos;week&apos;, (DATEADD(&apos;year&apos;,-1,[Reporting Week])+6)) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day])))) ))' />
      </column>
