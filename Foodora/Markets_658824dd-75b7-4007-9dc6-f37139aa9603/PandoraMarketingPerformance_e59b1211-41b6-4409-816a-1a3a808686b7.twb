        <calculation class='tableau' formula='RANK_PERCENTILE(avg([Total Gfv Eur (copy)_5515220700253798419]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='RANK_PERCENTILE(SUM([Successful Orders Local Shops]))' datatype='real' name='[Calculation_2029223480295538708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE(SUM([count_successful_orders_local_shops]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
