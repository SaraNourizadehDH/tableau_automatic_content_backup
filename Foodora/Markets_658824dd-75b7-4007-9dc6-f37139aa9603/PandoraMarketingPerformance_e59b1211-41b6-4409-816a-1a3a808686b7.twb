          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0o8z4j10mdnvs71h0vv4p0krv0fg].[max_order_week_pandora (copy)_5997316964600938500]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0o8z4j10mdnvs71h0vv4p0krv0fg].[Order Day (copy)_5361464990301970432]' caption='Reporting Week' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2025-03-24#'>
              <calculation class='tableau' formula='#2025-03-24#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o8z4j10mdnvs71h0vv4p0krv0fg'>
            <column caption='Entity' datatype='string' name='[Calculation_78461151869382693]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF   [global_entity_id] in (&apos;YS_TR&apos;,&#10;&apos;total&apos;,&#10;&apos;PO_FI&apos;,&#10;&apos;OP_SE&apos;,&#10;&apos;NP_HU&apos;,&#10;&apos;MJM_AT&apos;,&#10;&apos;total_with_TR&apos;,&#10;&apos;FO_NO&apos;,&#10;&apos;DJ_CZ&apos;,) then &apos;EU &amp; Yemeksepeti&apos;&#10;ELSEIF  [global_entity_id] in(&#10;&#10;&#10;&apos;FP_TW&apos;,&#10;&apos;FP_TH&apos;,&#10;&apos;FP_SG&apos;,&#10;&apos;FP_PK&apos;,&#10;&apos;FP_PH&apos;,&#10;&apos;FP_MY&apos;,&#10;&apos;FP_MM&apos;,&#10;&apos;FP_LA&apos;,&#10;&apos;FP_KH&apos;,&#10;&apos;FP_HK&apos;,&#10;&apos;FP_BD&apos;,&#10;&apos;APAC&apos;) then &apos;APAC&apos;&#10;ELSEIF  [global_entity_id] =&#10;&apos;Total APAC_EU_TR&apos; then &apos;Pandora&apos; end' />
            </column>
            <column caption='INDEX WEEK AUX -1' datatype='boolean' name='[INDEX WEEK AUX (copy)_3648126839560245249]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() = 0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Order Week' datatype='date' name='[Order Day (copy)_5361464990301970432]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;))' />
            </column>
            <column caption='Week Filter' datatype='boolean' name='[Order Week (copy)_5361464990307966979]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Order Day (copy)_5361464990301970432] &gt;= DATEADD(&apos;week&apos;,-4,[Parameters].[Parameter 1])&#10;AND&#10;[Order Day (copy)_5361464990301970432] &lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='Acquisitions WoW' datatype='real' name='[Successful Orders Dmart WoW (copy)_2076511279473115148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([main_total_new_customer_count])) - LOOKUP(ZN(SUM([main_total_new_customer_count])), -1)) / ABS(LOOKUP(ZN(SUM([main_total_new_customer_count])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='WoW Title  Exec' datatype='string' name='[WoW Title  (copy)_122441650321903623]' role='dimension' type='nominal'>
