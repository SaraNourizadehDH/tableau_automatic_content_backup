      <column caption='YoY Title' datatype='string' name='[Mom Title (copy)_78461151782879253]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;Then&#10;LEFT(DATENAME(&apos;month&apos;,[Parameters].[Reporting Week (copy)_78461151772667907]),3) + &quot; YoY&quot;&#10;ELSEIF month([Parameters].[Reporting Week (copy)_78461151772667907]) = month(TODAY()-1)&#10;THEN&#10;LEFT(DATENAME(&apos;month&apos;,[Parameters].[Reporting Week (copy)_78461151772667907]),3) + &quot; MTD YoY&quot;&#10;END' />
      </column>
      <column caption='Daily Pro Customer % ' datatype='real' name='[Monthly Pro Customer %  (copy)_2864781970310750209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([daily_active_subscribers]) / AVG([daily_total_active_customer_count])' />
