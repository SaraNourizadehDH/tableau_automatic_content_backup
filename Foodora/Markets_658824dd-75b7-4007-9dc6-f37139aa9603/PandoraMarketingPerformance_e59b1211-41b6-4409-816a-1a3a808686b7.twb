              <calculation class='tableau' formula='(SUM(iif([order_day] = [Parameters].[Order Date Parameter]-1, [pm_acquisition_spend], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 8, [pm_acquisition_spend], 0)))-1' />
            </column>
            <column caption='Reacquisitions DoD' datatype='real' name='[Acquisitions DoD (copy)_5566449176149782550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([order_day] = [Parameters].[Order Date Parameter], [reacquisiton], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 7, [reacquisiton], 0)))-1' />
            </column>
            <column caption='PM Acquisitions DoD' datatype='real' name='[Acquisitions DoD (copy)_5566449176149872663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([order_day] = [Parameters].[Order Date Parameter]-1, [pm_acquisitions], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 8, [pm_acquisitions], 0)))-1' />
            </column>
            <column caption='QC Orders DoD ' datatype='real' name='[Acquisitions DoD (copy)_5566449176150470681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([order_day] = [Parameters].[Order Date Parameter], [total_number_of_successful_orders_qc], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 7, [total_number_of_successful_orders_qc], 0)))-1' />
            </column>
            <column caption='% QC Active Customers DoD' datatype='real' name='[Acquisitions DoD (copy)_5566449176150777883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(iif([order_day] = [Parameters].[Order Date Parameter], [daily_qc_active_customers], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter], [daily_total_active_customer_count], 0)))&#10;-&#10;&#10;(SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 7, [daily_qc_active_customers], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 7, [daily_total_active_customer_count], 0))))&#10; * 100' />
            </column>
            <column caption='QC GMV Eur DoD ' datatype='real' name='[Acquisitions DoD (copy)_5566449176151728156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([order_day] = [Parameters].[Order Date Parameter], [qc_gmv_eur], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 7, [qc_gmv_eur], 0)))-1' />
            </column>
            <column caption='Acquisitions DoD' datatype='real' name='[Active Customers DoD (copy)_5566449176149540884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([order_day] = [Parameters].[Order Date Parameter], [main_total_new_customer_count], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 7, [main_total_new_customer_count], 0)))-1' />
            </column>
            <column caption='Pro Active Customers DoD' datatype='real' name='[Active Customers DoD (copy)_5566449176151945246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([order_day] = [Parameters].[Order Date Parameter], [daily_active_subscribers], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 7, [daily_active_subscribers], 0)))-1' />
            </column>
            <column caption='PRO Order GMV Eur DoD' datatype='real' name='[Active Customers DoD (copy)_5566449176152104992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([order_day] = [Parameters].[Order Date Parameter], [pro_order_gmv_eur], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 7, [pro_order_gmv_eur], 0)))-1' />
            </column>
            <column caption='Pro Rate DoD' datatype='real' name='[Active Customers DoD (copy)_5566449176152289313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(iif([order_day] = [Parameters].[Order Date Parameter], [daily_new_subscription_activations], 0)) +&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter], [daily_returning_subscription_activations], 0)))&#10;/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter], [daily_non_pro_users], 0))&#10;-&#10;(SUM(iif([order_day] = [Parameters].[Order Date Parameter]-7, [daily_new_subscription_activations], 0)) +&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter]-7, [daily_returning_subscription_activations], 0)))&#10;/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter]-7, [daily_non_pro_users], 0)))&#10;*100&#10;//-&#10;//(SUM(iif([Order Day] = [Reporting Day]-7, [daily_new_subscription_activations], 0)) +&#10;//(SUM(iif([Order Day] = [Reporting Day]-7, [daily_returning_subscription_activations], 0)))&#10;///&#10;//SUM(iif([Order Day] = [Reporting Day]-7, [daily_non_pro_users], 0)))) &#10;//* 100' />
            </column>
            <column caption='Order Date' datatype='date' name='[Calculation_5566449176146984975]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='Date([order_day])' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_78461151869382693]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF   [global_entity_id] in (&apos;YS_TR&apos;,&#10;&apos;total&apos;,&#10;&apos;PO_FI&apos;,&#10;&apos;OP_SE&apos;,&#10;&apos;NP_HU&apos;,&#10;&apos;MJM_AT&apos;,&#10;&apos;total_with_TR&apos;,&#10;&apos;FO_NO&apos;,&#10;&apos;DJ_CZ&apos;,) then &apos;EU &amp; Yemeksepeti&apos;&#10;ELSEIF  [global_entity_id] in(&#10;&#10;&#10;&apos;FP_TW&apos;,&#10;&apos;FP_TH&apos;,&#10;&apos;FP_SG&apos;,&#10;&apos;FP_PK&apos;,&#10;&apos;FP_PH&apos;,&#10;&apos;FP_MY&apos;,&#10;&apos;FP_MM&apos;,&#10;&apos;FP_LA&apos;,&#10;&apos;FP_KH&apos;,&#10;&apos;FP_HK&apos;,&#10;&apos;FP_BD&apos;,&#10;&apos;APAC&apos;) then &apos;APAC&apos;&#10;ELSEIF  [global_entity_id] =&#10;&apos;Total APAC_EU_TR&apos; then &apos;Pandora&apos; end' />
            </column>
            <column caption='HVA Incentive % DoD' datatype='real' name='[GMV EUR DoD (copy)_5566449176148602898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(iif([order_day] = [Parameters].[Order Date Parameter]-1, [hva_incentived_eur], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter]-1, [dh_mkt_contribution_eur], 0)))&#10;-&#10;&#10;(SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 8, [hva_incentived_eur], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 8, [dh_mkt_contribution_eur], 0)))) &#10;* 100' />
            </column>
            <column caption='QC Trials DoD' datatype='real' name='[GMV EUR DoD (copy)_5566449176151826461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([order_day] = [Parameters].[Order Date Parameter], [qc_trials], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 7, [qc_trials], 0)))-1' />
            </column>
            <column caption='Reactivations DoD ' datatype='real' name='[PM Acquisition Spend DoD  (copy)_5566449176152875042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([order_day] = [Parameters].[Order Date Parameter]-1, [daily_reactivations], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 8, [daily_reactivations], 0)))-1' />
            </column>
            <column caption='Acquisition Spend Eur DoD' datatype='real' name='[PM Acquisition Spend DoD  (copy)_5566449176153976867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(iif([order_day] = [Parameters].[Order Date Parameter]-1, [acquisition_spend_eur], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 8, [acquisition_spend_eur], 0)))-1' />
            </column>
