      <column caption='PMTD -1' datatype='boolean' name='[PMTD (copy)_6390256043387498496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF [last_sunday_of_month] &lt;&gt; [Reporting Week] THEN&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Reporting Week]))&#10;   // AND [Order Day] &lt;= DATEADD(&apos;month&apos;, -1, [Reporting Week])&#10;//ELSE&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Reporting Week]))&#10;   // AND DATEPART(&apos;week&apos;, [Reporting Week] + 6) = DATEPART(&apos;week&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day]))))&#10;//END&#10;&#10;IF MONTH([order_day]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND YEAR([order_day]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND [order_day] &lt;= DATEADD(&apos;month&apos;, -1, {MAX([order_day])}-1)&#10;THEN TRUE&#10;END' />
      </column>
      <column caption='PYTD' datatype='boolean' name='[PMTD (copy)_6569414853216116741]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF [Max Order Week] = [Reporting Week] and &#10;//DATETRUNC(&apos;year&apos;,[Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Reporting Week])) &#10;  //  AND DATEPART(&apos;dayofyear&apos;, [Order Day]) &lt;= DATEPART(&apos;dayofyear&apos;, today()-1)&#10;//THEN TRUE&#10;//ELSEIF  &#10;//[Max Order Week] &lt;&gt; [Reporting Week] and &#10;//DATETRUNC(&apos;year&apos;,[Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Reporting Week])) &#10;  //  AND DATEPART(&apos;dayofyear&apos;, [Order Day]) &lt;= DATEPART(&apos;dayofyear&apos;, [Reporting Week])&#10;//THEN TRUE &#10;//END&#10;&#10;&#10;&#10;DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])) &#10;AND [order_day] &lt;= dateadd(&apos;year&apos;,-1,[Parameters].[Parameter 1])&#10;or (DATETRUNC(&apos;year&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])) &#10;and DATEPART(&apos;week&apos;,  (DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])+6)) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))' />
      </column>
      <column caption='untill max day' datatype='boolean' name='[PMTD (copy)_748230860981755904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF [last_sunday_of_month] &lt;&gt; [Reporting Week] THEN&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Reporting Week]))&#10;   // AND [Order Day] &lt;= DATEADD(&apos;month&apos;, -1, [Reporting Week])&#10;//ELSE&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Reporting Week]))&#10;   // AND DATEPART(&apos;week&apos;, [Reporting Week] + 6) = DATEPART(&apos;week&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day]))))&#10;//END&#10;&#10;DAY([order_day]) &lt;=  DAY({MAX([order_day])})' />
      </column>
      <column caption='LY QTD' datatype='boolean' name='[PQTD (copy)_1931270242855862274]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF &#10;//[Max Order Week] = [Reporting Week] and&#10;//[Order Day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;year&apos;, -1, [Reporting Week]))&#10;//AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, TODAY()-1)&#10;//THEN TRUE&#10;//ELSEIF&#10;//[Max Order Week] &lt;&gt; [Reporting Week] and&#10;//[Order Day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;year&apos;, -1, [Reporting Week]))&#10;//AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, [Reporting Week])&#10;//THEN TRUE&#10;//END&#10;&#10;&#10;[order_day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1]))&#10;AND [order_day] &lt;= DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1])&#10;OR (&#10;DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, (DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]))) &#10;//AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, [Reporting Week]))&#10;and DATEPART(&apos;week&apos;,  (DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])+6)) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;&#10;//DATETRUNC(&apos;quarter&apos;, [Order Day]) = DATETRUNC(&apos;quarter&apos;, (DATEADD(&apos;year&apos;,-1,[Reporting Week]))) &#10;//AND [Order Day] &lt;= [Reporting Week]&#10; //or (DATETRUNC(&apos;quarter&apos;, [Order Day]) = DATETRUNC(&apos;quarter&apos;, (DATEADD(&apos;year&apos;,-1,[Reporting Week]))) &#10; //and DATEPART(&apos;week&apos;, (DATEADD(&apos;year&apos;,-1,[Reporting Week])+6)) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day])))) ))' />
      </column>
      <column caption='PRO Rate  LY MTD' datatype='real' name='[PRO Active Customers LY MTD (copy)_453456248036270081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//MAX(IF &#10;//DATETRUNC(&apos;year&apos;, [Order Day]) = DATETRUNC(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, TODAY()))&#10;//AND DAY([Date]) &lt;= DAY(TODAY()-1)&#10;//THEN [au_ly_current_month_cumulative_cum_distinct_cnt] END)&#10;&#10;&#10;//MAX(IF DAY(TODAY()) = 1 and DATETRUNC(&apos;year&apos;, [Order Day]) = DATETRUNC(&apos;year&apos;, DATEADD(&apos;year&apos;, -1, TODAY()))&#10; //THEN [Au Ly Pmtd Cumulative Pro Rate] &#10;//ELSEIF DATEPART(&apos;day&apos;,[Order Day]) = DATEPART(&apos;day&apos;,DATEADD(&apos;year&apos;, -1, TODAY()-1)) &#10;//THEN&#10;//[Au Ly Current Month Cumulative Pro Rate] else null END)&#10;&#10;max(IF [is_max_order_day (copy)_746401337486544896] then [au_ly_current_month_cumulative_pro_rate]  end)' />
      </column>
      <column caption='PRO Rate LY MTD growth %' datatype='real' name='[PRO Active Customers LY MTD growth %  (copy)_453456248038031364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IF &#10;//(SUM(iif([MTD], [Active Customers Daily], 0))/&#10;//SUM(iif([LY MTD], [Active Customers Daily], 0)))-1 &gt;= 5&#10;//THEN NULL&#10;//ELSE&#10;//(SUM(iif([MTD], [Active Customers Daily], 0))/&#10;//SUM(iif([LY MTD], [Active Customers Daily], 0)))-1&#10;//END&#10;&#10;(sum([Calculation_5997316964570660864])- sum([Pro Join Rate PMTD (copy)_5997316964571025410])) * 100' />
      </column>
      <column caption='PRO Rate MTD' datatype='real' name='[PRO Active Customers MTD (copy)_453456248035921920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum(iif([MTD], [Active Customers Monthly], 0))&#10;&#10;///((sum(iif([Is Yesterday], [Active Customers Monthly], 0))&#10;&#10;//SUM(iif([MTD], [Active Customers Daily], 0))&#10;max(IF [max_order_date -1 (copy)_659144087537639425] then [au_current_month_cumulative_pro_rate]  end)&#10;&#10;&#10;//MAX(iif([MTD], [Au Current Month Cumulative Pro Rate], 0))' />
