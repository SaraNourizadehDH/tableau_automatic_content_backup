    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glossary'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/PandoraMarketingPreformance/Glossary?rev=' id='Glossary' path='/t/Foodora/workbooks/PandoraMarketingPerformance_17429950146330' revision='' site='Foodora' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#b8209c' fontname='Tableau Medium' fontsize='12'>Glossary</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Successful Orders :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> # of orders which ended up in a successful state.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>% HVA Incentive :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  #  HVA Incentived Eur /  # Total DH Spend EUR</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Active Customers:</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  # Customers placing an order on the platform</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Acquisitions </run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>: # of customers placing their very first order on the platform</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>Reacquisitions :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> # reorder of inactive users after 365 days</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>PM Acquisitions :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> # Acquisitions with Performance Marketing Channel</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>PRO Customers :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> #  Pro Active Subscribers</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>% PRO Customers :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  #  Active Subscribers /  # Active Customers</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>PRO Orders :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> # Active Subscribers Total Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>PRO GMV :</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>  # PRO Orders Gross Merchandise Value [</run>
              <run fontcolor='#4d5156' fontname='Tableau Medium' fontsize='11'>€]</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='11'>PRO Rate : </run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='11'> (#  First Time Subscriber Activations +  # Returning Subscriber Activations ) / # Non-PRO Active Customers</run>
              <run>Æ&#10;</run>
