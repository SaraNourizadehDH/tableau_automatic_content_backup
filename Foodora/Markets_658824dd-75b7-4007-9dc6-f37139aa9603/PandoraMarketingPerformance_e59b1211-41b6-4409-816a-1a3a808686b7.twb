            <column caption='is_pm_max_order_day' datatype='boolean' datatype-customized='true' name='[is_ly_max_order_day (copy)_746401337487560705]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_day] = (DATEADD(&apos;month&apos;, -1, {MAX(DATE([order_day]))}))' />
