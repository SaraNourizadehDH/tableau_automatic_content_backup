              <calculation class='tableau' formula='MONTH([order_day]) = MONTH(DATEADD(&apos;month&apos;, -1, [Parameters].[Reporting Week (copy)_78461151772667907]))&#10;and&#10;YEAR([order_day]) = YEAR(DATEADD(&apos;month&apos;, -1, [Parameters].[Reporting Week (copy)_78461151772667907]))' />
            </column>
            <column-instance column='[acquisitions_rr]' derivation='Max' name='[max:acquisitions_rr:qk]' pivot='key' type='quantitative' />
