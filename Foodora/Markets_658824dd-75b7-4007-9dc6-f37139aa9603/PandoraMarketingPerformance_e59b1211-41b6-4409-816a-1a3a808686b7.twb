            <column caption='Total Number Of Successful Orders Qc' datatype='integer' name='[total_number_of_successful_orders_qc]' role='measure' type='quantitative' />
            <column-instance column='[Successful Orders LY MTD (copy)_5629710700383358986]' derivation='User' name='[usr:Successful Orders LY MTD (copy)_5629710700383358986:qk]' pivot='key' type='quantitative' />
