      <column caption='PRO Rate  PMTD' datatype='real' name='[PRO Active Customers PMTD (copy)_453456248036909059]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//MAX(IF &#10;//DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#10;//AND DAY([Order Day]) = DAY(TODAY()-1)&#10;//THEN [Au Previous Month Cumulative Pro Rate] END)&#10;&#10;//IF [is_max_order_day] then [Au Previous Month Cumulative Pro Rate] end&#10;&#10;//max(iif([PMTD], [Au Previous Month Cumulative Pro Rate] , 0))&#10;max(IF [is_ly_max_order_day (copy)_746401337487560705] then [au_previous_month_cumulative_pro_rate]  end)' />
      </column>
      <column caption='PRO Rate MTD (copy)' datatype='real' name='[PRO Rate MTD (copy)_659144087306264576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum(iif([MTD], [Active Customers Monthly], 0))&#10;&#10;///((sum(iif([Is Yesterday], [Active Customers Monthly], 0))&#10;&#10;//SUM(iif([MTD], [Active Customers Daily], 0))&#10;&#10;//(IF DAY(TODAY()) = 1 THEN [Au Previous Month Cumulative Pro Rate] ELSE&#10;//[Au Current Month Cumulative Pro Rate] END)&#10;&#10;&#10;&#10;//IF [Reporting Week] = { FIXED : MAX(DATETRUNC(&apos;week&apos;,[Order Day],&apos;monday&apos;)) }&#10;//THEN [Au Current Month Cumulative Pro Rate] END&#10;&#10;IF [max_order_date -1 (copy)_659144087537639425] then [au_current_month_cumulative_pro_rate]  end' />
      </column>
