      <column caption='Active Customers WoW' datatype='real' name='[Active Riders WoW (copy)_2076511279463653376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(AVG([weekly_total_active_customer_count])) - LOOKUP(ZN(AVG([weekly_total_active_customer_count])), -1)) / ABS(LOOKUP(ZN(AVG([weekly_total_active_customer_count])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Active Customers YTD growth %' datatype='real' name='[Active Riders YTD growth % (copy)_2076511279465291782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Active Customers MTD  (copy)_132574750950314025]/ [Active Customers YTD (copy)_132574750950453290] -1' />
      </column>
      <column caption='Active Customers PMTD' datatype='integer' name='[Calculation_1238419566430437376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//MAX(IF &#10;//DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#10;//AND DAY([Order Day]) &lt;= DAY(TODAY()-1)&#10;//THEN [Au Previous Month Cumulative Cum Distinct Cnt] END)&#10;&#10;max(iif([Calculation_21673596521619459], [au_previous_month_cumulative_cum_distinct_cnt] , 0))' />
      </column>
      <column caption='Reporting Month Filter' datatype='boolean' name='[Calculation_123989787767152646]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Order Week (copy)_78461151772839940] &gt;= DATEADD(&apos;month&apos;,-12,[Parameters].[Reporting Week (copy)_78461151772667907])&#10;AND&#10;[Order Week (copy)_78461151772839940] &lt;= [Parameters].[Reporting Week (copy)_78461151772667907]' />
      </column>
      <column caption='Max Orders Week -1' datatype='date' name='[Calculation_126030481015160846]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}-1' />
      </column>
      <column caption='max_order_week_pandora' datatype='date' name='[Calculation_1347913357035454464]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
      </column>
      <column caption='[Yesterday] + 1' datatype='date' name='[Calculation_1705808738253815808]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[yesterday] + 1' />
      </column>
      <column caption='last_sunday_of_month' datatype='datetime' datatype-customized='true' name='[Calculation_2148920775172698112]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//DATEADD(&apos;day&apos;, &#10;  //  -1 * (DATEPART(&apos;weekday&apos;, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Reporting Week]))) % 7), &#10;    //DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Reporting Week]))&#10;&#10;&#10;//(DATEPART(&apos;weekday&apos;, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Reporting Week]))) - 1) &#10;&#10;// 1. Ayın ilk gününü al&#10;// 2. Son gününü bulmak için bir sonraki ayın ilk gününe git ve -1 ekle&#10;// 3. O günün haftanın hangi gün olduğunu bul&#10;// 4. Pazar&apos;a ulaşmak için gerekli gün sayısını çıkar&#10;//DATE(DATEADD(&apos;day&apos;, &#10;   //-1 * (DATEPART(&apos;weekday&apos;, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Reporting Week]))) - 1) % 7,&#10;   // DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Reporting Week]))&#10;//))&#10;&#10;&#10;&#10;DATEADD(&apos;day&apos;, &#10;    -1 * (DATEPART(&apos;weekday&apos;, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 1]))) % 7), &#10;    DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 1])) - 1&#10;)' />
      </column>
      <column caption='test' datatype='integer' name='[Calculation_2148920775184932866]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//DATEPART(&apos;week&apos;, [Reporting Week] + 6) &#10;//DATEPART(&apos;week&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day]))))&#10;&#10;// AND DATEPART(&apos;week&apos;, [Reporting Week] + 6) = &#10;        DATEPART(&apos;week&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day]))))' />
      </column>
      <column caption='MTD' datatype='boolean' name='[Calculation_21673596520853506]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,today())&#10;//OR DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1)&#10;&#10;&#10;//DATETRUNC(&apos;month&apos;,[Order Day]) = DATETRUNC(&apos;month&apos;,[Reporting Week]) and day([Order Day]) &lt;= day([Reporting Week])&#10;//OR (DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1))&#10;&#10;//if you pick last week of month it brings full month&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATETRUNC(&apos;month&apos;,{MAX([order_day])}) &#10;    AND ([order_day] &lt;= {MAX([order_day])})&#10;    // OR DATEPART(&apos;week&apos;, [Reporting Week]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day])))) ))&#10;//OR (DAY(TODAY()) = 1 AND MONTH([Order Day]) = MONTH(TODAY()-1) AND YEAR([Order Day]) = YEAR(TODAY()-1))' />
      </column>
      <column caption='PMTD' datatype='boolean' name='[Calculation_21673596521619459]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF [last_sunday_of_month] &lt;&gt; [Reporting Week] THEN&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Reporting Week]))&#10;   // AND [Order Day] &lt;= DATEADD(&apos;month&apos;, -1, [Reporting Week])&#10;//ELSE&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Reporting Week]))&#10;   // AND DATEPART(&apos;week&apos;, [Reporting Week] + 6) = DATEPART(&apos;week&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day]))))&#10;//END&#10;&#10;IF MONTH([order_day]) = MONTH(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND YEAR([order_day]) = YEAR(DATEADD(&apos;month&apos;, -1, {MAX([order_day])}))&#10;AND [order_day] &lt;= DATEADD(&apos;month&apos;, -1, {MAX([order_day])})&#10;THEN TRUE&#10;END' />
      </column>
      <column caption='daily_pro_rate' datatype='real' name='[Calculation_2864781970311102466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([daily_new_subscription_activations]) + sum([daily_returning_subscription_activations]))&#10;/&#10;sum([daily_non_pro_users])' />
      </column>
      <column caption='Monthly Pro Customer % ' datatype='real' name='[Calculation_3379177467587899392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([monthly_pro_customer]) / AVG([monthly_total_active_customer_count])' />
      </column>
      <column caption='yoy test' datatype='integer' name='[Calculation_3379177467645374473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//(SUM(iif([This month], [Successful Orders], 0)))&#10;SUM(iif([Previous Month (copy)_78461151781773327], [total_number_of_successful_orders], 0))&#10;//-1' />
      </column>
      <column caption='Exec Week Filter' datatype='string' name='[Calculation_3648126839559774208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Order Day (copy)_5361464990301970432] = DATEADD(&apos;week&apos;,-52,[Parameters].[Parameter 1]) then &apos;LY last week&apos;&#10;ELSEIF &#10;[Order Day (copy)_5361464990301970432] = [Parameters].[Parameter 1] then &apos;TY last week&apos; else &apos;No&apos; end' />
      </column>
      <column caption='in 7 days' datatype='boolean' name='[Calculation_4254775772338524160]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_day] &gt;= [Parameters].[Order Date Parameter]-7&#10;and&#10;[order_day] &lt;= [Parameters].[Order Date Parameter]' />
      </column>
      <column caption='Active Customer RR' datatype='real' name='[Calculation_4637933574461173760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Active Customers MTD growth % (copy) (copy)_132574750947786791])  /([Calculation_1238419566430437376])&#10;* &#10;MAX(IIF([is_pm_max_order_day (copy)_78461151772184578], [monthly_total_active_customer_count], 0))&#10;&#10;&#10;//current MTD / last MTD X last full month' />
      </column>
      <column caption='% HVA Incentive' datatype='real' name='[Calculation_525795258617450496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(hva_incentived_eur) /&#10;SUM(dh_mkt_contribution_eur)' />
      </column>
      <column caption='DATE(DATETRUNC(&apos;week&apos;, [Order Day], &apos;Monday&apos;))' datatype='date' name='[Calculation_5361464990308225028]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [order_day], &apos;Monday&apos;))' />
      </column>
      <column caption='Calculation1' datatype='boolean' name='[Calculation_5566449176129589252]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_day] = [max_order_day]' />
      </column>
      <column caption='1' datatype='integer' name='[Calculation_5566449176131014662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='test suc' datatype='integer' name='[Calculation_5566449176143630343]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM([total_number_of_successful_orders]), 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='max' datatype='boolean' name='[Calculation_5566449176145022984]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] = { FIXED : MAX([date]) }' />
      </column>
      <column caption='max test' datatype='boolean' name='[Calculation_5566449176145141769]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() = 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Order Date' datatype='date' name='[Calculation_5566449176146984975]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='Date([order_day])' />
      </column>
      <column caption='test week' datatype='date' name='[Calculation_5629710700311048192]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//DATETRUNC(&apos;week&apos;, [Order Week])&#10;DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)+6)' />
      </column>
      <column caption='Successful Orders WoW' datatype='real' name='[Calculation_5629710700374478849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([total_number_of_successful_orders])) - LOOKUP(ZN(SUM([total_number_of_successful_orders])), -1)) / ABS(LOOKUP(ZN(SUM([total_number_of_successful_orders])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Successful Orders LW YoY' datatype='real' name='[Calculation_5629710700375760898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([total_number_of_successful_orders])) - LOOKUP(ZN(SUM([total_number_of_successful_orders])), -52)) / ABS(LOOKUP(ZN(SUM([total_number_of_successful_orders])), -52))&#10;&#10;//LOOKUP(ZN(SUM([Successful Orders])), -52)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Successful Orders MTD' datatype='integer' name='[Calculation_5629710700376436739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([Calculation_21673596520853506], [total_number_of_successful_orders], 0))' />
      </column>
      <column caption='Successful Orders MTD Growth' datatype='real' name='[Calculation_5629710700377047045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [total_number_of_successful_orders], 0))/&#10;SUM(iif([Calculation_21673596521619459], [total_number_of_successful_orders], 0)))-1' />
      </column>
      <column caption='Successful Orders MTD YoY Growth' datatype='real' name='[Calculation_5629710700377182214]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [total_number_of_successful_orders], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149], [total_number_of_successful_orders], 0)))-1' />
      </column>
      <column caption='Pro Join Rate MTD' datatype='real' name='[Calculation_5997316964570660864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([new_subscription_activations_mtd]+ [returning_subscription_activations_mtd]) / [non_pro_users_mtd]' />
      </column>
      <column caption='&lt;_last_week' datatype='boolean' name='[Calculation_5997316964587335683]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_day] &lt;  {MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}' />
      </column>
      <column caption='max_order_date -1' datatype='date' name='[Calculation_617345052876218368]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{MAX(DATE(DATETRUNC(&apos;week&apos;,[order_day], &apos;Monday&apos;)))}-1' />
      </column>
      <column caption='last updated day' datatype='date' name='[Calculation_6511219934464581632]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='max([max_order_day])' />
      </column>
      <column caption='same_day_week' datatype='boolean' name='[Calculation_6511219934466797571]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//WEEKDAY(DATE([Order Day])) = WEEKDAY(DATE([last_updated_day_pandora]))&#10;DATENAME(&apos;weekday&apos;, DATE([order_day])) = DATENAME(&apos;weekday&apos;, DATE([max_order_week_pandora (copy)_951315054989074438]))&#10;AND&#10;([order_day] = [max_order_week_pandora (copy)_951315054989074438] -8 or [order_day] = [max_order_week_pandora (copy)_951315054989074438])' />
      </column>
      <column caption='HVA Incentive Eur RR %' datatype='real' name='[Calculation_6511219934497587211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([hva_incentived_eur_rr])/sum([dh_mkt_contribution_eur_rr])' />
      </column>
      <column caption='QC Active Customers RR' datatype='real' name='[Calculation_6511219934499205132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Active Customers MTD (copy 2)_126030480943054851] / [Active Customers PMTD (copy)_126030480944484358] * &#10;MAX(iif([is_pm_max_order_day (copy)_78461151772184578], [monthly_qc_active_customers] , 0))' />
      </column>
      <column caption='Pro Rate RR' datatype='real' name='[Calculation_6511219934504153106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([Calculation_5997316964570660864]) / sum([Pro Join Rate MTD (copy)_5997316964570943489]) ) *&#10;avg(iif([is_pm_max_order_day (copy)_78461151772184578], [monthly_pro_rate], null))' />
      </column>
      <column caption='Reactivations RR' datatype='real' name='[Calculation_6511219934504562707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(iif([Calculation_21673596520853506], [monthly_reactivations], 0))/&#10;AVG(iif([Calculation_21673596521619459],[monthly_reactivations], 0)) *&#10;avg(iif([is_pm_max_order_day (copy)_78461151772184578], [monthly_reactivations], null))' />
      </column>
      <column caption='test PMTD Monthly Pro Customer' datatype='integer' name='[Calculation_7020408168014749696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([Calculation_21673596521619459], [monthly_pro_customer],0))' />
      </column>
      <column caption='Entity' datatype='string' name='[Calculation_78461151869382693]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF   [global_entity_id] in (&apos;YS_TR&apos;,&#10;&apos;total&apos;,&#10;&apos;PO_FI&apos;,&#10;&apos;OP_SE&apos;,&#10;&apos;NP_HU&apos;,&#10;&apos;MJM_AT&apos;,&#10;&apos;total_with_TR&apos;,&#10;&apos;FO_NO&apos;,&#10;&apos;DJ_CZ&apos;,) then &apos;EU &amp; Yemeksepeti&apos;&#10;ELSEIF  [global_entity_id] in(&#10;&#10;&#10;&apos;FP_TW&apos;,&#10;&apos;FP_TH&apos;,&#10;&apos;FP_SG&apos;,&#10;&apos;FP_PK&apos;,&#10;&apos;FP_PH&apos;,&#10;&apos;FP_MY&apos;,&#10;&apos;FP_MM&apos;,&#10;&apos;FP_LA&apos;,&#10;&apos;FP_KH&apos;,&#10;&apos;FP_HK&apos;,&#10;&apos;FP_BD&apos;,&#10;&apos;APAC&apos;) then &apos;APAC&apos;&#10;ELSEIF  [global_entity_id] =&#10;&apos;Total APAC_EU_TR&apos; then &apos;Pandora&apos; end' />
      </column>
      <column caption='Highlighted ' datatype='string' name='[Calculation_932808133706829827]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country_name] in (&quot;APAC&quot; , &quot;DH Europe&quot;, &quot;DH EU + Turkey&quot;, &quot;Total APAC_EU_TR&quot; )THEN &quot;Highlighted&quot;&#10;ELSE &quot;Normal&quot;&#10;END' />
      </column>
      <column caption='Mom Title' datatype='string' name='[Entity (copy)_78461151778439181]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF month([Parameters].[Reporting Week (copy)_78461151772667907]) &lt;&gt; month(TODAY()-1)&#10;Then&#10;LEFT(DATENAME(&apos;month&apos;,[Parameters].[Reporting Week (copy)_78461151772667907]),3) + &quot; MoM&quot;&#10;ELSEIF month([Parameters].[Reporting Week (copy)_78461151772667907]) = month(TODAY()-1)&#10;THEN&#10;LEFT(DATENAME(&apos;month&apos;,[Parameters].[Reporting Week (copy)_78461151772667907]),3) + &quot; MTD MoM&quot;&#10;END' />
      </column>
      <column caption='HVA Incentive % DoD' datatype='real' name='[GMV EUR DoD (copy)_5566449176148602898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(iif([order_day] = [Parameters].[Order Date Parameter]-1, [hva_incentived_eur], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter]-1, [dh_mkt_contribution_eur], 0)))&#10;-&#10;&#10;(SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 8, [hva_incentived_eur], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 8, [dh_mkt_contribution_eur], 0)))) &#10;* 100' />
      </column>
      <column caption='QC Trials DoD' datatype='real' name='[GMV EUR DoD (copy)_5566449176151826461]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(iif([order_day] = [Parameters].[Order Date Parameter], [qc_trials], 0))/&#10;SUM(iif([order_day] = [Parameters].[Order Date Parameter] - 7, [qc_trials], 0)))-1' />
      </column>
      <column caption='Pro GMV LW YoY' datatype='real' name='[GMV QC LW YoY (copy)_1347913357037301762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([pro_order_gmv_eur])) - LOOKUP(ZN(SUM([pro_order_gmv_eur])), -52)) / ABS(LOOKUP(ZN(SUM([pro_order_gmv_eur])), -52))&#10;&#10;//LOOKUP(ZN(SUM([Successful Orders])), -52)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Pro GMV LY MTD' datatype='real' name='[GMV QC LY MTD (copy)_1347913357038055428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([MTD (copy)_1931270242863067149], [pro_order_gmv_eur], 0))' />
      </column>
      <column caption='Pro GMV MTD' datatype='real' name='[GMV QC MTD (copy)_1347913357037961219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([Calculation_21673596520853506], [pro_order_gmv_eur], 0))' />
      </column>
      <column caption='Pro GMV MTD Growth' datatype='real' name='[GMV QC MTD Growth (copy)_1347913357038297093]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [pro_order_gmv_eur], 0))/&#10;SUM(iif([Calculation_21673596521619459], [pro_order_gmv_eur], 0)))-1' />
      </column>
      <column caption='Pro GMV MTD YoY Growth' datatype='real' name='[GMV QC MTD YoY Growth (copy)_1347913357038657542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(iif([Calculation_21673596520853506], [pro_order_gmv_eur], 0))/&#10;SUM(iif([MTD (copy)_1931270242863067149], [pro_order_gmv_eur], 0)))-1' />
      </column>
      <column caption='GMV LY QTD' datatype='real' name='[GMV QTD (copy)_132574750861291526]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([PQTD (copy)_1931270242855862274], [total_gmv_eur], 0))' />
      </column>
      <column caption='GMV LY YTD ' datatype='real' name='[GMV YTD  (copy)_132574750862934024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([PMTD (copy)_6569414853216116741], [total_gmv_eur], 0))' />
      </column>
      <column caption='INDEX WEEK AUX' datatype='boolean' name='[INDEX WEEK (copy)_140033822718402568]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST() = 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='INDEX WEEK AUX -1' datatype='boolean' name='[INDEX WEEK AUX (copy)_3648126839560245249]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST() = 0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='LY MTD new' datatype='boolean' name='[LY MTD (copy)_2148920775187431427]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF [last_sunday_of_month] &lt;&gt; [Reporting Week] THEN&#10;  // DATETRUNC(&apos;month&apos;, [Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;, [Reporting Week]))&#10;  // AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, [Reporting Week])&#10;//ELSE&#10;IF [Calculation_2148920775172698112] = [Parameters].[Parameter 1] THEN&#10;&#10;[order_day] &lt; DATEADD(&apos;month&apos;, 1 , DATEADD(&apos;year&apos;, -1, datetrunc(&apos;month&apos;,[Parameters].[Parameter 1])))&#10;AND month([order_day]) = month([Parameters].[Parameter 1])&#10;ELSE&#10; DATETRUNC(&apos;month&apos;, [order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 1]))&#10;   AND [order_day] &lt;= DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 1])&#10;END' />
      </column>
      <column caption='LY MTD -1' datatype='boolean' name='[LY MTD (copy)_6390256043393650689]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF [last_sunday_of_month] &lt;&gt; [Reporting Week] THEN&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;, [Reporting Week]))&#10;    //AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, [Reporting Week])&#10;//ELSE&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;, [Reporting Week]))&#10;   // AND DATEPART(&apos;week&apos;, [Reporting Week] + 6) = &#10;     //   DATEPART(&apos;week&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day]))))&#10;//END&#10;&#10;&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,{MAX([order_day])})) &#10;    AND day([order_day]) &lt;= day({MAX([order_day])}-1)&#10;    AND month([order_day]) &lt;= month({MAX([order_day])})' />
      </column>
      <column caption='QTD Title' datatype='string' name='[LY MTD Title (copy)_1369798010024394754]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;QTD &quot; + &#10;STR(DATEPART(&apos;year&apos;, DATEADD(&apos;year&apos;, -1,[Parameters].[Parameter 1]))) + &quot;    &quot; +&quot;        QTD &quot;+ &#10;STR(DATEPART(&apos;year&apos;, [Parameters].[Parameter 1]))' />
        <aliases>
          <alias key='&quot;W51/ W50&quot;' value='LW WoW' />
        </aliases>
      </column>
      <column caption='LY MTD Title without RR' datatype='string' name='[LY MTD Title (copy)_1369798010026901509]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATEPART(&apos;month&apos;, DATEADD(&apos;year&apos;, -1,{MAX([order_day])}))) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;, DATEADD(&apos;year&apos;, -1,{MAX([order_day])})))&#10;+&#10;&quot;                     &quot;&#10;+&#10;STR(DATEPART(&apos;month&apos;, {MAX([order_day])})) + &quot;-&quot; + STR(DATEPART(&apos;year&apos;,{MAX([order_day])}))' />
        <aliases>
          <alias key='&quot;W51/ W50&quot;' value='LW WoW' />
        </aliases>
      </column>
      <column caption='YTD Growth Title' datatype='string' name='[MTD  Growth Title (copy)_6569414853230739463]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;YTD YoY&quot;' />
        <aliases>
          <alias key='&quot;YTD YoY&quot;' value='YTD                        YoY' />
        </aliases>
      </column>
      <column caption='QTD' datatype='boolean' name='[MTD (copy)_1931270242855276544]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//DATETRUNC(&apos;quarter&apos;,[Order Day]) = DATETRUNC(&apos;quarter&apos;, TODAY() - 1)&#10;&#10; DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, [Parameters].[Parameter 1]) &#10;AND [order_day] &lt;= [Parameters].[Parameter 1]&#10; or (DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, [Parameters].[Parameter 1]) &#10; and DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;&#10;//IF &#10;//[Max Order Week] = [Reporting Week] AND&#10;//DATETRUNC(&apos;quarter&apos;,[Order Day]) = DATETRUNC(&apos;quarter&apos;, [Reporting Week])&#10;//and &#10;//([Order Day]) &lt;= (TODAY()-1) &#10;//THEN TRUE&#10;//ELSEIF &#10;//[Max Order Week] &lt;&gt; [Reporting Week] AND&#10;//DATETRUNC(&apos;quarter&apos;,[Order Day]) = DATETRUNC(&apos;quarter&apos;, [Reporting Week])&#10;//and &#10;//([Order Day]) &lt;= ([Reporting Week]) THEN TRUE&#10;//ELSE False END' />
      </column>
      <column caption='PQTD' datatype='boolean' name='[MTD (copy)_1931270242855424001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF &#10;//[Max Order Week] = [Reporting Week] and &#10;//[Order Day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;quarter&apos;, -1, [Reporting Week]))&#10;//AND [Order Day] &lt;= DATEADD(&apos;quarter&apos;, -1, TODAY()-1)&#10;//THEN TRUE&#10;//ELSEIF &#10;//[Max Order Week] &lt;&gt; [Reporting Week] and &#10;//[Order Day] &gt;= DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;quarter&apos;, -1, [Reporting Week]))&#10;//AND [Order Day] &lt;= DATEADD(&apos;quarter&apos;, -1, [Reporting Week])&#10;//THEN TRUE&#10;//END&#10;&#10;&#10; DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, DATEADD(&apos;quarter&apos;, -1, [Parameters].[Parameter 1])) &#10;AND [order_day] &lt;= DATEADD(&apos;quarter&apos;, -1, [Parameters].[Parameter 1])&#10; or ( DATETRUNC(&apos;quarter&apos;, [order_day]) = DATETRUNC(&apos;quarter&apos;, DATEADD(&apos;quarter&apos;, -1, [Parameters].[Parameter 1])) &#10; and DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;&#10;&#10;&#10;&#10;//DATETRUNC(&apos;quarter&apos;,[Order Day]) = DATETRUNC(&apos;quarter&apos;, [Reporting Week])&#10;//and &#10;//([Order Day]) &lt;= ([Reporting Week]) + 6' />
      </column>
      <column caption='LY MTD' datatype='boolean' name='[MTD (copy)_1931270242863067149]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF [last_sunday_of_month] &lt;&gt; [Reporting Week] THEN&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;, [Reporting Week]))&#10;    //AND [Order Day] &lt;= DATEADD(&apos;year&apos;, -1, [Reporting Week])&#10;//ELSE&#10;  //  DATETRUNC(&apos;month&apos;, [Order Day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;, [Reporting Week]))&#10;   // AND DATEPART(&apos;week&apos;, [Reporting Week] + 6) = &#10;     //   DATEPART(&apos;week&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Order Day]))))&#10;//END&#10;&#10;&#10;DATETRUNC(&apos;month&apos;,[order_day]) = DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;month&apos;,{MAX([order_day])})) &#10;    AND day([order_day]) &lt;= day({MAX([order_day])})&#10;    AND month([order_day]) &lt;= month({MAX([order_day])})' />
      </column>
      <column caption='This month' datatype='boolean' name='[MTD (copy)_3521463102101921795]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='MONTH([order_day]) = MONTH([Parameters].[Reporting Week (copy)_78461151772667907])&#10;and&#10;YEAR([order_day]) = YEAR(([Parameters].[Reporting Week (copy)_78461151772667907]))' />
      </column>
      <column caption='YTD' datatype='boolean' name='[MTD (copy)_6569414853215997956]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;,[order_day]) = DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])&#10;AND [order_day] &lt;= [Parameters].[Parameter 1]&#10; or (DATETRUNC(&apos;year&apos;,[order_day]) = DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])&#10; and DATEPART(&apos;week&apos;, [Parameters].[Parameter 1]+6) = DATEPART(&apos;week&apos;, (DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [order_day])))) ))&#10;&#10;&#10;&#10;&#10;//IF &#10;//[Max Order Week] = [Reporting Week] and &#10;//DATETRUNC(&apos;year&apos;,[Order Day]) = DATETRUNC(&apos;year&apos;,[Reporting Week])&#10;//and &#10;//[Order Day] &lt;= [Reporting Week]&#10;//THEN TRUE ELSEIF&#10;//[Max Order Week] &lt;&gt; [Reporting Week] and  DATETRUNC(&apos;year&apos;,[Order Day]) = DATETRUNC(&apos;year&apos;,[Reporting Week]) and [Order Day] &lt;= [Reporting Week]&#10;//THEN TRUE END' />
      </column>
      <column caption='QTD Growth Title' datatype='string' name='[MTD Growth Title (copy)_1931270242856280068]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;QTD QoQ&quot;' />
        <aliases>
