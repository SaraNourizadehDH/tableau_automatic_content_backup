              <relation connection='bigquery.1eqkgr60pzle461exbcsa1depb4e' name='RR - month' type='text'>WITH countries as 
(
SELECT 
   order_date,
	 global_entity_id
	,sum(orders_rr) orders_month_rr
	,sum(acquisitions_rr) acquisitions_month_rr
	,sum(gmv_eur_rr) gmv_eur_month_rr
        ,sum(rr_orders_dmart) orders_dmart_month_rr
FROM `dhh---analytics-eu.bl_europe.monthly_run_rate`
WHERE global_entity_id IN (
&quot;FP_SK&quot;,
&quot;DJ_CZ&quot;,
&quot;FO_NO&quot;,
&quot;MJM_AT&quot;,
&quot;OP_SE&quot;,
&quot;PO_FI&quot;,
&quot;NP_HU&quot;,
&quot;HN_DK&quot;,
&quot;YS_TR&quot;)

group by 1,2 
),

total_with_TR AS
(
SELECT 
   order_date,
	&apos;total_with_TR&apos; global_entity_id
	,sum(orders_rr) orders_month_rr
	,sum(acquisitions_rr) acquisitions_month_rr
	,sum(gmv_eur_rr) gmv_eur_month_rr
        ,sum(rr_orders_dmart) orders_dmart_month_rr
FROM `dhh---analytics-eu.bl_europe.monthly_run_rate`
WHERE global_entity_id IN (
&quot;FP_SK&quot;,
&quot;DJ_CZ&quot;,
&quot;FO_NO&quot;,
&quot;MJM_AT&quot;,
&quot;OP_SE&quot;,
&quot;PO_FI&quot;,
&quot;NP_HU&quot;,
&quot;HN_DK&quot;,
&quot;YS_TR&quot;)
group by 1,2
),

total AS
(
SELECT 
   order_date,
	&apos;total&apos; global_entity_id
	,sum(orders_rr) orders_month_rr
	,sum(acquisitions_rr) acquisitions_month_rr
	,sum(gmv_eur_rr) gmv_eur_month_rr
        ,sum(rr_orders_dmart) orders_dmart_month_rr
FROM `dhh---analytics-eu.bl_europe.monthly_run_rate`
WHERE global_entity_id IN (
&quot;FP_SK&quot;,
&quot;DJ_CZ&quot;,
&quot;FO_NO&quot;,
&quot;MJM_AT&quot;,
&quot;OP_SE&quot;,
&quot;PO_FI&quot;,
&quot;NP_HU&quot;,
&quot;HN_DK&quot;)
group by 1,2
)

SELECT * FROM countries
UNION ALL 
SELECT * FROM total
UNION ALL 
SELECT * FROM total_with_TR</relation>
