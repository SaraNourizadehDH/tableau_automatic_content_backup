        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0u8to7s052b07d1915xqb09ckc23'>
            <connection CATALOG='foodpanda-sg-bigquery' EXECCATALOG='foodpanda-sg-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata Country - SG' schema='ops_sg' server-oauth='' username='timothy.yeo@foodpanda.sg' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0u8to7s052b07d1915xqb09ckc23' name='Custom SQL Query' type='text'>with singapore_zone_geo as (&#13;
    select z.name as zone_name, z.shape.geo&#13;
    from &#13;
    `fulfillment-dwh-production.pandata_curated.lg_countries` lc&#13;
    left join unnest(cities) as c&#13;
    left join unnest(zones) as z &#13;
    where global_entity_id = &quot;FP_SG&quot;&#13;
    and c.is_active = true&#13;
    and c.id = 200&#13;
    and z.is_active=true&#13;
),&#13;
&#13;
distance_from_zone_border as (&#13;
select &#13;
        lv.code as vendor_code, &#13;
        lv.name as vendor_name,&#13;
        lv.location_geo as vendor_loc,&#13;
        ST_X(lv.location_geo) as vendor_loc_long, &#13;
        ST_Y(lv.location_geo) as vendor_loc_lat,&#13;
        z.zone_name,&#13;
        if(&#13;
            ST_WITHIN(lv.location_geo, z.geo),&#13;
            null,&#13;
            ST_DISTANCE(lv.location_geo, ST_CLOSESTPOINT(z.geo, lv.location_geo))) as distance_m_from_zone_border&#13;
    from &#13;
        `fulfillment-dwh-production.pandata_curated.lg_vendors` lv&#13;
        cross join singapore_zone_geo z&#13;
    -- left join &#13;
    --     unnest(delivery_areas) as da&#13;
    -- left join&#13;
    --     unnest(history) as h&#13;
    where &#13;
        lg_entity_id = &quot;FP_SG&quot;&#13;
        and &quot;OWN_DELIVERY&quot; in unnest(lv.delivery_provider)&#13;
        and is_active&#13;
        and lower(name) not like &quot;%test%&quot;&#13;
        and lower(name) not like &quot;%islandwide%&quot;&#13;
        and vertical_type = &quot;restaurants&quot;&#13;
        -- and da.is_deleted = false&#13;
        -- and h.active_to_utc is null&#13;
 )&#13;
&#13;
select &#13;
    *,&#13;
    case &#13;
    when distance_m_from_zone_border is not NULL then rank() over(partition by if(distance_m_from_zone_border is NULL,true, false), vendor_code order by distance_m_from_zone_border)&#13;
    else NULL&#13;
    end as zone_distance_rank&#13;
from &#13;
    distance_from_zone_border&#13;
order by &#13;
    vendor_code</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0u8to7s052b07d1915xqb09ckc23' name='Custom SQL Query' type='text'>with singapore_zone_geo as (&#13;
