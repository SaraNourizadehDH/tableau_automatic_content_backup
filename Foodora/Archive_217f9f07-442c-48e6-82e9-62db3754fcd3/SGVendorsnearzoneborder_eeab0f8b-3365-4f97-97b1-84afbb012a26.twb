    <datasource caption='zone border clean up monitoring' inline='true' name='federated.136zb9w0gwchzg1aqjuyz0fdvkzm' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1xvrp5j06wy5h60zymk2201nwobm'>
            <connection CATALOG='foodpanda-sg-bigquery' EXECCATALOG='foodpanda-sg-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata Country - SG' schema='ops_sg' server-oauth='' username='timothy.yeo@foodpanda.sg' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1xvrp5j06wy5h60zymk2201nwobm' name='Custom SQL Query' type='text'>with sg_zone_geo as(&#13;
  select z.lg_zone_uuid, z.name, z.shape.geo&#13;
  from &#13;
  `fulfillment-dwh-production.pandata_curated.lg_countries` lc&#13;
  left join unnest(cities) as c&#13;
  left join unnest(zones) as z &#13;
  where global_entity_id = &quot;FP_SG&quot;&#13;
  and c.is_active = true&#13;
  and c.id = 200&#13;
  and z.is_active=true),&#13;
&#13;
delivery_transitions AS (												&#13;
SELECT 																						&#13;
lo.order_code, t.state&#13;
FROM fulfillment-dwh-production.pandata_curated.lg_orders AS lo,&#13;
UNNEST(lo.rider.deliveries) AS d,&#13;
UNNEST(d.transitions) AS t																																										&#13;
WHERE lo.created_date_utc &gt;&gt; &quot;2021-01-01&quot;&#13;
AND lo.global_entity_id = &quot;FP_SG&quot;&#13;
AND lo.delivery_type = &apos;OWN_DELIVERY&apos;&#13;
AND t.state IN (&apos;courier_notified&apos;, &apos;accepted&apos;)												&#13;
),&#13;
												&#13;
rider_notification AS (&#13;
select order_code, count(*) as n_notified																								&#13;
FROM delivery_transitions												&#13;
WHERE state = &apos;courier_notified&apos;&#13;
group by order_code				&#13;
),												&#13;
												&#13;
rider_acceptance AS (												&#13;
SELECT order_code, count(*) as n_accepted								&#13;
FROM delivery_transitions												&#13;
WHERE state = &apos;accepted&apos;&#13;
group by order_code								&#13;
),												&#13;
												&#13;
n_notified_accepted AS (												&#13;
SELECT order_code, n_notified, n_accepted&#13;
from rider_notification&#13;
left join&#13;
rider_acceptance using (order_code)					&#13;
),&#13;
&#13;
delivery_distance as(&#13;
    SELECT&#13;
    lo.order_code,&#13;
    max(d.delivery_distance_in_meters) as delivery_distance_m&#13;
    FROM &#13;
    fulfillment-dwh-production.pandata_curated.lg_orders as lo,&#13;
    unnest(rider.deliveries) as d&#13;
    WHERE lo.created_date_local &gt;&gt;= &quot;2022-01-01&quot; &#13;
    and created_date_utc &gt;&gt;= &quot;2021-12-01&quot;&#13;
    and lo.global_entity_id = &quot;FP_SG&quot;&#13;
    AND lo.delivery_type = &apos;OWN_DELIVERY&apos;&#13;
    group by order_code&#13;
),&#13;
&#13;
vendor_orders as (&#13;
  select &#13;
  order_code, &#13;
  case &#13;
    when (ST_WITHIN(rider.customer_location_geo, z1.geo) and not ST_WITHIN(rider.customer_location_geo, z2.geo)) then TRUE&#13;
    else FALSE&#13;
  end as is_new_customer,&#13;
  zbcut.current_zone, &#13;
  zbcut.expanded_zone, &#13;
  vendor_code, &#13;
  created_date_local, &#13;
  batch, &#13;
  created_date_local &gt;&gt;= zbcut.date as after_expansion, &#13;
  rider.order_status,&#13;
    if(is_preorder,lo.rider.actual_delivery_time_in_seconds-lo.rider.hold_back_time_in_seconds,lo.rider.actual_delivery_time_in_seconds)/60 as DT_mins,&#13;
  n_notified_accepted.* except(order_code),&#13;
  delivery_distance.* except(order_code),&#13;
  from `fulfillment-dwh-production.pandata_curated.lg_orders` lo&#13;
  left join (SELECT * FROM `logistics-sg-cloud-4435.logs_sg.zone_border_clean_up`) zbcut using (vendor_code)&#13;
  left join sg_zone_geo z1 on zbcut.expanded_zone = z1.name&#13;
  left join sg_zone_geo z2 on zbcut.current_zone = z2.name&#13;
  left join n_notified_accepted using (order_code)&#13;
  left join delivery_distance using (order_code)&#13;
  where &#13;
  created_date_utc &gt;&gt;= &quot;2021-12-01&quot;&#13;
  and created_date_local &gt;&gt;=&quot;2022-01-01&quot;&#13;
  and global_entity_id = &quot;FP_SG&quot;&#13;
  and delivery_type = &quot;OWN_DELIVERY&quot;&#13;
  -- and rider.order_status = &quot;completed&quot;&#13;
  and rider.vendor.vertical_type = &quot;restaurants&quot;&#13;
  and rider.vendor.name not like &quot;%islandwide%&quot;&#13;
  and batch is not null&#13;
)&#13;
&#13;
select * from vendor_orders where is_new_customer=true and vendor_orders.after_expansion=true</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
