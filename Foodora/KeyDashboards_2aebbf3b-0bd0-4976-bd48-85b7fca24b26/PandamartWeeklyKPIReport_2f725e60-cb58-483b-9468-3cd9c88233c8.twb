      <column caption='Avg Subsidy Per Voucher MoM%' datatype='string' name='[Avg Basket Value MoM% (copy)_2103040309029896233]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (&#10;([Fail Rate (MTD)  (copy)_2103040309029613607] - [Fail Rate (Prev MTD) (copy)_2103040309029752872])&#10;/ [Fail Rate (Prev MTD) (copy)_2103040309029752872]&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;(&#10;([Fail Rate (MTD)  (copy)_2103040309029613607] - [Fail Rate (Prev MTD) (copy)_2103040309029752872])&#10;/ [Fail Rate (Prev MTD) (copy)_2103040309029752872]&#10;)*100, 2)&#10;)' />
