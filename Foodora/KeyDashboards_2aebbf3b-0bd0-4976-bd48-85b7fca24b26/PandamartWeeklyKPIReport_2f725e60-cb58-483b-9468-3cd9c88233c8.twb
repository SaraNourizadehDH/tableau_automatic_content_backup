    <worksheet name='GMV Per Store'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='18'>GMV Per Store</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='9'>(average gmv per store per day)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__weekly_kpi_dashboard' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='Is not this week' datatype='boolean' name='[Calculation_1161717639168991233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[report_date]) &lt; DATETRUNC(&apos;iso-week&apos;,TODAY()) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_2261440339125497858]' role='measure' type='quantitative' user:unnamed='Successful Orders'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column caption='L7 GMV Per Store AVG' datatype='real' name='[L7 Orders Per Store AVG (copy)_3506122716870500354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(SUM([Orders Per Store Per Day (copy)_3506122716870500352]), first(), first()+5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='GMV Per Store Per Day' datatype='real' name='[Orders Per Store Per Day (copy)_3506122716870500352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='({FIXED [country_name], [vendor_type], [report_date] : SUM([gmv_eur])})&#10;/&#10;({FIXED [country_name], [vendor_type], [report_date] : SUM([daily_active_vendors])})' />
            </column>
            <column caption='GMV Per Store color code' datatype='integer' name='[Orders Per Store color code (copy)_3506122716870500359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (SUM([Orders Per Store Per Day (copy)_3506122716870500352]) - [L7 Orders Per Store AVG (copy)_3506122716870500354]) / [L7 Orders Per Store AVG (copy)_3506122716870500354] &gt;= 0.2 then 2&#10;elseif (SUM([Orders Per Store Per Day (copy)_3506122716870500352]) - [L7 Orders Per Store AVG (copy)_3506122716870500354]) / [L7 Orders Per Store AVG (copy)_3506122716870500354] &lt;= -0.2 then -2&#10;elseif (SUM([Orders Per Store Per Day (copy)_3506122716870500352]) - [L7 Orders Per Store AVG (copy)_3506122716870500354]) / [L7 Orders Per Store AVG (copy)_3506122716870500354] &lt;= -0.1 then -1&#10;elseif (SUM([Orders Per Store Per Day (copy)_3506122716870500352]) - [L7 Orders Per Store AVG (copy)_3506122716870500354]) / [L7 Orders Per Store AVG (copy)_3506122716870500354] &gt;= 0.1 then 1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[Orders Per Store Per Day (copy)_3506122716870500352]' derivation='Avg' name='[avg:Orders Per Store Per Day (copy)_3506122716870500352:qk]' pivot='key' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Daily Active Vendors' datatype='integer' name='[daily_active_vendors]' role='measure' type='quantitative' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2261440339125497858]' derivation='Min' name='[min:Calculation_2261440339125497858:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1161717639168991233]' derivation='None' name='[none:Calculation_1161717639168991233:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[week]' derivation='None' name='[none:week:nk]' pivot='key' type='nominal' />
            <column caption='rank gmv per store per day' datatype='real' name='[rank gmv (copy)_1943092178312466433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_name], [vendor_type], [report_date] : SUM(&#10;    IF [Calculation_3491345310664937529] THEN [gmv_eur]&#10;    ELSE 0&#10;    END&#10;  )}&#10;&#10;/&#10;({FIXED [country_name], [vendor_type], [report_date] : SUM(&#10;IF [Calculation_3491345310664937529] THEN&#10;[daily_active_vendors] ELSE 0&#10;    END)})' />
            </column>
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[rank gmv (copy)_1943092178312466433]' derivation='Sum' name='[sum:rank gmv (copy)_1943092178312466433:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Orders Per Store color code (copy)_3506122716870500359]' derivation='User' name='[usr:Orders Per Store color code (copy)_3506122716870500359:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.1vwzzdx1ipz2aa1cjrceo0bb96ua].[L7 Orders Per Store AVG (copy)_3506122716870500354]' ordering-type='Rows' />
            </column-instance>
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
            <column caption='Week' datatype='string' name='[week]' role='dimension' type='nominal' />
          </datasource-dependencies>
