            <column caption='Orders Per Store color code' datatype='integer' name='[orders color code (sample) (copy)_1650991490474930177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (SUM([Calculation_1650991490474319872]) - [L7 Order AVG (copy)_1650991490475114498]) / [L7 Order AVG (copy)_1650991490475114498] &gt;= 0.2 then 2&#10;elseif (SUM([Calculation_1650991490474319872]) - [L7 Order AVG (copy)_1650991490475114498]) / [L7 Order AVG (copy)_1650991490475114498] &lt;= -0.2 then -2&#10;elseif (SUM([Calculation_1650991490474319872]) - [L7 Order AVG (copy)_1650991490475114498]) / [L7 Order AVG (copy)_1650991490475114498] &lt;= -0.1 then -1&#10;elseif (SUM([Calculation_1650991490474319872]) - [L7 Order AVG (copy)_1650991490475114498]) / [L7 Order AVG (copy)_1650991490475114498] &gt;= 0.1 then 1&#10;else 0&#10;end'>
