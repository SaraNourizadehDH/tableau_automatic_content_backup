  <worksheets>
    <worksheet name='% Orders EC'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='18'> % Orders from Existing Customers</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='9'>(% of Pandamart Orders)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__weekly_kpi_dashboard' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='% EC PM Orders color code' datatype='integer' name='[% NC Orders color code (copy)_4761290003305553938]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='if ([% Orders (NC) (copy)_4761290003305103374] - [L7 % of Orders (NC) AVG (copy)_4761290003305754645]) / [L7 % of Orders (NC) AVG (copy)_4761290003305754645] &gt;= 0.025 then 2&#10;elseif ([% Orders (NC) (copy)_4761290003305103374] - [L7 % of Orders (NC) AVG (copy)_4761290003305754645]) / [L7 % of Orders (NC) AVG (copy)_4761290003305754645] &lt;= -0.025 then -2&#10;elseif ([% Orders (NC) (copy)_4761290003305103374] - [L7 % of Orders (NC) AVG (copy)_4761290003305754645]) / [L7 % of Orders (NC) AVG (copy)_4761290003305754645] &lt;= -0.0125 then -1&#10;elseif ([% Orders (NC) (copy)_4761290003305103374] - [L7 % of Orders (NC) AVG (copy)_4761290003305754645]) / [L7 % of Orders (NC) AVG (copy)_4761290003305754645] &gt;= 0.0125 then 1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% Orders (EC PM)' datatype='real' name='[% Orders (NC) (copy)_4761290003305103374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_valid_orders_ec_pm])/sum([num_of_valid_orders])' />
            </column>
            <column caption='Is not this week' datatype='boolean' name='[Calculation_1161717639168991233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[report_date]) &lt; DATETRUNC(&apos;iso-week&apos;,TODAY()) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_2261440339125497858]' role='measure' type='quantitative' user:unnamed='Successful Orders'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column caption='L7 % of Orders (EC PM) AVG' datatype='real' name='[L7 % of Orders (NC) AVG (copy)_4761290003305754645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(([% Orders (NC) (copy)_4761290003305103374]), first(), first()+5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_2261440339125497858]' derivation='Min' name='[min:Calculation_2261440339125497858:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1161717639168991233]' derivation='None' name='[none:Calculation_1161717639168991233:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[week]' derivation='None' name='[none:week:nk]' pivot='key' type='nominal' />
            <column caption='Num Of Valid Orders' datatype='integer' name='[num_of_valid_orders]' role='measure' type='quantitative' />
            <column caption='Num Of Valid Orders Ec Pm' datatype='integer' name='[num_of_valid_orders_ec_pm]' role='measure' type='quantitative' />
            <column caption='rank orders ec pm' datatype='real' name='[rank orders nc pm (copy)_1943092178323288079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [Calculation_3491345310664937529] THEN [num_of_valid_orders_ec_pm]&#10;    ELSE 0&#10;    END&#10;  )&#10;&#10;/&#10;SUM(&#10;IF [Calculation_3491345310664937529] THEN&#10;[num_of_valid_orders] ELSE 0&#10;    END)' />
            </column>
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[% NC Orders color code (copy)_4761290003305553938]' derivation='User' name='[usr:% NC Orders color code (copy)_4761290003305553938:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.1vwzzdx1ipz2aa1cjrceo0bb96ua].[L7 % of Orders (NC) AVG (copy)_4761290003305754645]' ordering-type='Rows' />
            </column-instance>
            <column-instance column='[% Orders (NC) (copy)_4761290003305103374]' derivation='User' name='[usr:% Orders (NC) (copy)_4761290003305103374:qk]' pivot='key' type='quantitative' />
