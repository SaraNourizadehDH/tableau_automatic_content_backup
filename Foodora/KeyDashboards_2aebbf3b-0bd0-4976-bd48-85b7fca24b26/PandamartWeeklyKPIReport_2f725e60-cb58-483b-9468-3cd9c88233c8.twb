            <column caption='Indicator_LW_Orders_Per_Store' datatype='string' name='[Indicator_LW_total_successful_order (copy)_1650991491434352644]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [daily_active_vendors] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [daily_active_vendors] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [daily_active_vendors] END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='LW_Orders_Per_Store' datatype='string' name='[LW_total_successful_orders (copy)_1650991490488709123]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [daily_active_vendors] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [daily_active_vendors] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [daily_active_vendors] END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;(&#10;(&#10;(SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [daily_active_vendors] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END) &#10;/SUM(IF [Calculation_1993476221387321345] THEN [daily_active_vendors] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [daily_active_vendors] END)) )&#10;* 100, 2)&#10;)' />
