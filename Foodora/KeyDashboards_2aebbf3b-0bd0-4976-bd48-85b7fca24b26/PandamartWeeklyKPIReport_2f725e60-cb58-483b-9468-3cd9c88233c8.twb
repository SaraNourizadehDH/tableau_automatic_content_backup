            <column caption='Indicator_LW_%_of_Orders' datatype='string' name='[Indicator_LW_Orders_Per_Store (copy)_1650991491439239176]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN {fixed[country_name],[week] : sum([num_of_valid_orders])} END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN {fixed[country_name],[week] : sum([num_of_valid_orders])} END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN {fixed[country_name],[week] : sum([num_of_valid_orders])} END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='LW_%_of_Orders' datatype='string' name='[LW_Orders_Per_Store (copy)_1650991491437191174]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN ({fixed[country_name],[week] : sum([num_of_valid_orders])}) END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN ({fixed[country_name],[week] : sum([num_of_valid_orders])}) END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN ({fixed[country_name],[week] : sum([num_of_valid_orders])}) END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;(&#10;(&#10;(SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN ({fixed[country_name],[week] : sum([num_of_valid_orders])}) END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END) &#10;/SUM(IF [Calculation_1993476221387321345] THEN ({fixed[country_name],[week] : sum([num_of_valid_orders])}) END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN ({fixed[country_name],[week] : sum([num_of_valid_orders])}) END)) )&#10;* 100, 2)&#10;)' />
