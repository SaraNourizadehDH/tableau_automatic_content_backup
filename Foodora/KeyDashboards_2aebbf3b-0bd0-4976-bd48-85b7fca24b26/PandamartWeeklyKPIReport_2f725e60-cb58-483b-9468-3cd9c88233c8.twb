    <worksheet name='MTD % - % of Orders (NV)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#d80b63' fontsize='18'>y</run>
            <run>Æ&#10;</run>
            <run fontcolor='#d80b63' fontsize='9'>y</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__weekly_kpi_dashboard' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='Indicator MoM % % Orders' datatype='string' name='[% Orders MoM% (copy)_1017109847024734208]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(sum([Valid Orders (MTD) (copy)_2103040309002211338]) - sum([Valid Orders (Previous MTD) (copy)_2103040309002887179]))&#10;/ sum([Valid Orders (Previous MTD) (copy)_2103040309002887179])&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column aggregation='Sum' caption='MTD' datatype='integer' name='[1 (copy)_557250104628985863]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_557250104596926464]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([report_date])}' />
            </column>
            <column caption='Latest Month' datatype='date' name='[Calculation_557250104597061633]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [Calculation_557250104596926464]))' />
            </column>
            <column caption='Previous Month' datatype='date' name='[Calculation_557250104597192706]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, -1, [Calculation_557250104597061633]))' />
            </column>
            <column caption='Valid Orders (Previous MTD)' datatype='integer' name='[Calculation_557250104597385219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;[num_of_valid_orders]&#10;END' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='% of Orders (MTD)' datatype='real' name='[Valid Orders (MTD) (copy)_2103040309002211338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF  DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN ([num_of_valid_orders]) END)&#10;&#10;/ &#10;&#10;(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN {fixed [country_name], MONTH([report_date]): SUM([Valid Orders (Previous MTD) (copy)_557250104597786628])} END)' />
            </column>
            <column caption='% of Orders (Previous MTD)' datatype='real' name='[Valid Orders (Previous MTD) (copy)_2103040309002887179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF  DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN [num_of_valid_orders] END)&#10;&#10;/ &#10;&#10;(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN {fixed [country_name]: SUM([Calculation_557250104597385219])}END)' />
            </column>
            <column caption='Valid Orders (MTD)' datatype='integer' name='[Valid Orders (Previous MTD) (copy)_557250104597786628]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;[num_of_valid_orders]&#10;END' />
            </column>
            <column caption='% Orders MoM%' datatype='string' name='[Valid Orders MoM% (copy)_2103040309003296780]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(sum([Valid Orders (MTD) (copy)_2103040309002211338]) - sum([Valid Orders (Previous MTD) (copy)_2103040309002887179]))&#10;/ sum([Valid Orders (Previous MTD) (copy)_2103040309002887179])&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;&#10;ROUND(&#10;(&#10;(sum([Valid Orders (MTD) (copy)_2103040309002211338]) - sum([Valid Orders (Previous MTD) (copy)_2103040309002887179]))&#10;/ sum([Valid Orders (Previous MTD) (copy)_2103040309002887179])),2&#10;))' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Number of Records]' derivation='Min' name='[min:Number of Records:qk]' pivot='key' type='quantitative' />
            <column-instance column='[1 (copy)_557250104628985863]' derivation='None' name='[none:1 (copy)_557250104628985863:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column caption='Num Of Valid Orders' datatype='integer' name='[num_of_valid_orders]' role='measure' type='quantitative' />
            <column caption='rank order contribution' datatype='real' name='[rank gmv per store per day (copy)_1943092178315104260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_name], [vendor_type], [report_date] : SUM(&#10;    IF [Calculation_3491345310664937529] THEN [num_of_valid_orders]&#10;    ELSE 0&#10;    END&#10;  )}&#10;&#10;/&#10;({FIXED [country_name], [report_date] : SUM(&#10;IF [Calculation_3491345310664937529] THEN&#10;[num_of_valid_orders] ELSE 0&#10;    END)})' />
            </column>
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[rank gmv per store per day (copy)_1943092178315104260]' derivation='Sum' name='[sum:rank gmv per store per day (copy)_1943092178315104260:qk]' pivot='key' type='quantitative' />
            <column-instance column='[% Orders MoM% (copy)_1017109847024734208]' derivation='User' name='[usr:% Orders MoM% (copy)_1017109847024734208:nk]' pivot='key' type='nominal' />
            <column-instance column='[Valid Orders MoM% (copy)_2103040309003296780]' derivation='User' name='[usr:Valid Orders MoM% (copy)_2103040309003296780:nk]' pivot='key' type='nominal' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
