    <worksheet name='Avg Delivery Time'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='18'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='9'>(average delivery time per order)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__weekly_kpi_dashboard' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='Average Delivery Time color code' datatype='integer' name='[Average Basket Size color code (copy)_1650991491452362776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  (([Calculation_6320239186696593411]) - [L7 Orders Per Store AVG (copy)_1650991491452280855]) / [L7 Orders Per Store AVG (copy)_1650991491452280855] &gt;= 0.10 then -2&#10;elseif (([Calculation_6320239186696593411]) - [L7 Orders Per Store AVG (copy)_1650991491452280855]) / [L7 Orders Per Store AVG (copy)_1650991491452280855]  &lt;= -0.10 then 2&#10;elseif (([Calculation_6320239186696593411]) - [L7 Orders Per Store AVG (copy)_1650991491452280855]) / [L7 Orders Per Store AVG (copy)_1650991491452280855]  &lt;= -0.05 then 1&#10;elseif (([Calculation_6320239186696593411]) - [L7 Orders Per Store AVG (copy)_1650991491452280855]) / [L7 Orders Per Store AVG (copy)_1650991491452280855]  &gt;= 0.05 then -1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Is not this week' datatype='boolean' name='[Calculation_1161717639168991233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[report_date]) &lt; DATETRUNC(&apos;iso-week&apos;,TODAY()) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_2261440339125497858]' role='measure' type='quantitative' user:unnamed='Successful Orders'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' name='[Calculation_6320239186696593411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_time_non_preorder])/sum([num_of_non_preorders])/60.0' />
            </column>
            <column caption='L7 Avg Delivery time AVG' datatype='real' name='[L7 Orders Per Store AVG (copy)_1650991491452280855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(([Calculation_6320239186696593411]), first(), first()+5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Time Non Preorder' datatype='integer' name='[delivery_time_non_preorder]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2261440339125497858]' derivation='Min' name='[min:Calculation_2261440339125497858:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1161717639168991233]' derivation='None' name='[none:Calculation_1161717639168991233:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[week]' derivation='None' name='[none:week:nk]' pivot='key' type='nominal' />
            <column caption='Num Of Non Preorders' datatype='integer' name='[num_of_non_preorders]' role='measure' type='quantitative' />
            <column caption='rank avg delivery time' datatype='real' name='[rank avg basket size (copy)_1943092178318503944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [Calculation_3491345310664937529] THEN [delivery_time_non_preorder]&#10;    ELSE 0&#10;    END&#10;  )&#10;&#10;/&#10;SUM(&#10;IF [Calculation_3491345310664937529] THEN&#10;[num_of_non_preorders] ELSE 0&#10;    END)&#10;&#10;/60.0' />
            </column>
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[Average Basket Size color code (copy)_1650991491452362776]' derivation='User' name='[usr:Average Basket Size color code (copy)_1650991491452362776:qk]' pivot='key' type='quantitative'>
