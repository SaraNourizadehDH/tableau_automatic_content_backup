            <column-instance column='[rank avg basket size (copy)_1943092178318503944]' derivation='User' name='[usr:rank avg basket size (copy)_1943092178318503944:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
            <column caption='Week' datatype='string' name='[week]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1vwzzdx1ipz2aa1cjrceo0bb96ua].[none:Calculation_1161717639168991233:nk]'>
            <groupfilter function='member' level='[none:Calculation_1161717639168991233:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
