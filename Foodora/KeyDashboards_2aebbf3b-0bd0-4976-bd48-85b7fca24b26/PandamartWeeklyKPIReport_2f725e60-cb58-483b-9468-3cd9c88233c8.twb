            </column>
            <column caption='GMV (MTD)' datatype='real' name='[Valid Orders (MTD) (copy)_3506122716875075600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;[gmv_eur]&#10;END' />
            </column>
            <column caption='GMV (Previous MTD)' datatype='real' name='[Valid Orders (Previous MTD) (copy)_3506122716875075599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;[gmv_eur]&#10;END' />
            </column>
            <column caption='GMV MoM%' datatype='string' name='[Valid Orders MoM% (copy)_3506122716875239441]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(sum([Valid Orders (MTD) (copy)_3506122716875075600]) - sum([Valid Orders (Previous MTD) (copy)_3506122716875075599]) )&#10;/ sum([Valid Orders (Previous MTD) (copy)_3506122716875075599])&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;(&#10;(sum([Valid Orders (MTD) (copy)_3506122716875075600]) - sum([Valid Orders (Previous MTD) (copy)_3506122716875075599]) )&#10;/ sum([Valid Orders (Previous MTD) (copy)_3506122716875075599])&#10;)*100, 2)&#10;)' />
            </column>
