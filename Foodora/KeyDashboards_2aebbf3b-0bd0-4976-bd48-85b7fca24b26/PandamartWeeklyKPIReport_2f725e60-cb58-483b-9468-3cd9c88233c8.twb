    <worksheet name='MTD % - GMV Per Store'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#d80b63' fontsize='18'>y</run>
            <run>Æ&#10;</run>
            <run fontcolor='#d80b63' fontsize='9'>y</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__weekly_kpi_dashboard' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column aggregation='Sum' caption='MTD' datatype='integer' name='[1 (copy)_557250104628985863]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_557250104596926464]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([report_date])}' />
            </column>
            <column caption='Latest Month' datatype='date' name='[Calculation_557250104597061633]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [Calculation_557250104596926464]))' />
            </column>
            <column caption='Previous Month' datatype='date' name='[Calculation_557250104597192706]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, -1, [Calculation_557250104597061633]))' />
            </column>
            <column caption='Indicator MoM GMV Per Store Per Day' datatype='string' name='[Indicator MoM Orders Per Store Per Day (copy)_3506122716870500353]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(sum([Orders Per Store Per Day (MTD) (copy)_3506122716870500356]) - sum([Orders Per Store Per Day (Previous MTD) (copy)_3506122716870500357]) )&#10;/ sum([Orders Per Store Per Day (Previous MTD) (copy)_3506122716870500357])&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='GMV Per Store (Monthly)' datatype='real' name='[Orders Per Store (Monthly) (copy)_3506122716870500355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([gmv_eur])/({FIXED [country_name], [vendor_type], MONTH([report_date]): MAX([daily_active_vendors])})' />
            </column>
            <column caption='GMV Per Store Per Day (MTD)' datatype='real' name='[Orders Per Store Per Day (MTD) (copy)_3506122716870500356]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;[Orders Per Store (Monthly) (copy)_3506122716870500355] &#10;END' />
            </column>
            <column caption='GMV Per Store Per Day (Previous MTD)' datatype='real' name='[Orders Per Store Per Day (Previous MTD) (copy)_3506122716870500357]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;[Orders Per Store (Monthly) (copy)_3506122716870500355]&#10;END' />
            </column>
            <column caption='GMV Per Store Per Day MoM%' datatype='string' name='[Orders Per Store Per Day MoM% (copy)_3506122716870500358]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(sum([Orders Per Store Per Day (MTD) (copy)_3506122716870500356]) - sum([Orders Per Store Per Day (Previous MTD) (copy)_3506122716870500357]) )&#10;/ sum([Orders Per Store Per Day (Previous MTD) (copy)_3506122716870500357])&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;(&#10;(sum([Orders Per Store Per Day (MTD) (copy)_3506122716870500356]) - sum([Orders Per Store Per Day (Previous MTD) (copy)_3506122716870500357]) )&#10;/ sum([Orders Per Store Per Day (Previous MTD) (copy)_3506122716870500357])&#10;)*100, 2)&#10;)' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Daily Active Vendors' datatype='integer' name='[daily_active_vendors]' role='measure' type='quantitative' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[Number of Records]' derivation='Min' name='[min:Number of Records:qk]' pivot='key' type='quantitative' />
            <column-instance column='[1 (copy)_557250104628985863]' derivation='None' name='[none:1 (copy)_557250104628985863:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column caption='rank gmv per store per day' datatype='real' name='[rank gmv (copy)_1943092178312466433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [country_name], [vendor_type], [report_date] : SUM(&#10;    IF [Calculation_3491345310664937529] THEN [gmv_eur]&#10;    ELSE 0&#10;    END&#10;  )}&#10;&#10;/&#10;({FIXED [country_name], [vendor_type], [report_date] : SUM(&#10;IF [Calculation_3491345310664937529] THEN&#10;[daily_active_vendors] ELSE 0&#10;    END)})' />
            </column>
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[rank gmv (copy)_1943092178312466433]' derivation='Sum' name='[sum:rank gmv (copy)_1943092178312466433:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Indicator MoM Orders Per Store Per Day (copy)_3506122716870500353]' derivation='User' name='[usr:Indicator MoM Orders Per Store Per Day (copy)_3506122716870500353:nk]' pivot='key' type='nominal' />
            <column-instance column='[Orders Per Store Per Day MoM% (copy)_3506122716870500358]' derivation='User' name='[usr:Orders Per Store Per Day MoM% (copy)_3506122716870500358:nk]' pivot='key' type='nominal' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1vwzzdx1ipz2aa1cjrceo0bb96ua].[none:country_name:nk]' filter-group='3'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
