    <dashboard name='Metric Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APNewVerticalsWeeklyKPIReport_16000647216320/MetricDefinitions?rev=' id='MetricDefinitions' path='/t/Foodora/workbooks/PandamartWeeklyKPIReport' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_3' value='top' />
        </style-rule>
      </style>
      <size maxheight='500' maxwidth='1250' minheight='500' minwidth='1250' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='76600' id='3' type-v2='text' w='98720' x='640' y='21800'>
            <formatted-text>
              <run bold='true' fontcolor='#333333' fontsize='10'>KPI Summary:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(1) GMV (€) - Gross Merchandise Value. This is GFV + Delivery Fee + Service Fee + Difference to MOV + Packaging Fee. In Euro currency.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(2) GMV (€) Per Store Per Day (Avg) - Avg GMV (€) per store per day in the week</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(3) Orders - All valid orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(4) Orders Per Store Per Day (Avg) - Average orders per store per day in the week</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(5) Order Contribution % - Percentage of platform orders contributed by Pandamart</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(6) Average Basket Size - GFV (EUR) / Valid Orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'><![CDATA[(7) Seamless Orders % - Percentage of delivery orders which are not failed, not partially fulfilled, no incidents, DT within +5/-15 of PDT, DT <40min for SDD]]></run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(8) Fail Rate - Percentage of gross orders that were not successful</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(9) Average Delivery Time - Average delivery time taken for each order on a weekly basis</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(10) % Orders with Vouchers - Percentage of orders made with vouchers</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(11) Avg FP Subsidy Per Order - Total Voucher Value Subsidised by FP over total Valid Orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(12) iCPGMV % - Percentage of FP subsidized voucher value over total GMV</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(13) GMV Contribution % - Percentage of platform GMV contributed by Pandamart</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(14) New Customers - Customers who made their first purchase from Pandamart</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(15) Existing Customers - Number of returning customers</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(16) Reorder Rate - Percentage of new customers who made an order again within 30 days</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(17) % Orders from New Customers - Percentage orders from new customers vs total customers in Pandamart</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'>(18) % Orders from Existing Customers - Percentage orders from existing customers vs total customers in Pandamart</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontsize='10'><![CDATA[(19) Partially Fulfilled Orders - Percentage of orders that had delivered quantity < ordered quantity]]></run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='13797' id='133' layout-strategy-id='distribute-evenly' param='vert' type-v2='layout-flow' w='82588' x='16772' y='1600'>
            <zone forceUpdate='true' h='13800' id='135' type-v2='text' w='82560' x='16800' y='1600'>
