    <worksheet name='LW % - % Orders EC'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#d80b63' fontsize='18'>y</run>
            <run>Æ&#10;</run>
            <run fontcolor='#d80b63' fontsize='9'>y</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__weekly_kpi_dashboard' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='is_last_week' datatype='boolean' name='[Calculation_1993476221386768384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;) = DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;, -1, TODAY()), &apos;monday&apos;)' />
            </column>
            <column caption='is_last_2week' datatype='boolean' name='[Calculation_1993476221387321345]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;) = DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;, -2, TODAY()), &apos;monday&apos;)' />
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column aggregation='Sum' caption='LW' datatype='integer' name='[Calculation_5437533659915653121]' role='dimension' type='ordinal'>
