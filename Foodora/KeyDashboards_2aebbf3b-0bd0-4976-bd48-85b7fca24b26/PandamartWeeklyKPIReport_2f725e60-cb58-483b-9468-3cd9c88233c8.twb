          <filter class='categorical' column='[federated.1vwzzdx1ipz2aa1cjrceo0bb96ua].[none:vendor_type:nk]' filter-group='10'>
            <groupfilter function='member' level='[none:vendor_type:nk]' member='&quot;pandamart&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <natural-sort column='[federated.1vwzzdx1ipz2aa1cjrceo0bb96ua].[none:week:nk]' direction='DESC' />
          <slices>
