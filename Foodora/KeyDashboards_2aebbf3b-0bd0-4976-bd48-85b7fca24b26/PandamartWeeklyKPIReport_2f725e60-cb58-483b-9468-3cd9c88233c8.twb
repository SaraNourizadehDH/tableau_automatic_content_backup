            <column caption='Avg Basket Value (MTD) ' datatype='real' name='[% of Orders (MTD) (copy)_2103040309006073871]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN [gfv_eur] END)) &#10;/&#10;(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN [num_of_valid_orders] END) )' />
            </column>
            <column aggregation='Sum' caption='MTD' datatype='integer' name='[1 (copy)_557250104628985863]' role='dimension' type='ordinal'>
