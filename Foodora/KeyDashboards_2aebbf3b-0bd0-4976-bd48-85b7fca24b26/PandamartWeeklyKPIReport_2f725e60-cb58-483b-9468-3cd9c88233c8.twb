          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column aggregation='Sum' caption='MTD' datatype='integer' name='[1 (copy)_557250104628985863]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='Partially Fulfilled Orders MTD' datatype='real' name='[Calculation_1160521350952226819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#13;&#10;AND&#13;&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#13;&#10;THEN [num_of_partially_fulfilled_orders] END)) &#13;&#10;/&#13;&#10;(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#13;&#10;AND&#13;&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#13;&#10;THEN [num_of_valid_orders] END) )' />
            </column>
            <column caption='Partially Fulfilled Orders (Prev MTD)' datatype='real' name='[Calculation_1160521350953361412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#13;&#10;AND&#13;&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#13;&#10;THEN [num_of_partially_fulfilled_orders] END)) &#13;&#10;/&#13;&#10;(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#13;&#10;AND&#13;&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#13;&#10;THEN [num_of_valid_orders] END) )' />
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column caption='rank partially fulfilled order' datatype='real' name='[Calculation_514817754612649987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_3491345310664937529] THEN [num_of_partially_fulfilled_orders]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;  )&#13;&#10;&#13;&#10;/&#13;&#10;SUM(&#13;&#10;IF [Calculation_3491345310664937529] THEN&#13;&#10;[num_of_valid_orders] ELSE 0&#13;&#10;    END)' />
            </column>
            <column caption='Indicator MoM Partially Fulfilled Orders' datatype='string' name='[Calculation_514817754614153221]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#13;&#10;([Calculation_1160521350952226819] - [Calculation_1160521350953361412])&#13;&#10;/ [Calculation_1160521350953361412]&#13;&#10;) &gt;=0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='Partially Fulfilled Orders MoM%' datatype='string' name='[Calculation_514817754615201798]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#13;&#10;([Calculation_1160521350952226819] - [Calculation_1160521350953361412] )&#13;&#10;/ [Calculation_1160521350953361412]&#13;&#10;) &gt;=0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;+ STR(&#13;&#10;ROUND(&#13;&#10;(&#13;&#10;([Calculation_1160521350952226819] - [Calculation_1160521350953361412])&#13;&#10;/ [Calculation_1160521350953361412]&#13;&#10;)*100, 2)&#13;&#10;)' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_557250104596926464]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([report_date])}' />
