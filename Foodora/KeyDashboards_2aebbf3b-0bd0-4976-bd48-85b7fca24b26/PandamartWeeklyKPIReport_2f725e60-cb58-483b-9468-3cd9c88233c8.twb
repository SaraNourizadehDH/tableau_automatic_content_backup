            <column caption='rank fail rate' datatype='real' name='[rank magical orders (copy)_1943092178318090247]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [Calculation_3491345310664937529] THEN [num_of_failed_orders]&#10;    ELSE 0&#10;    END&#10;  )&#10;&#10;/&#10;SUM(&#10;IF [Calculation_3491345310664937529] THEN&#10;[num_of_orders] ELSE 0&#10;    END)' />
