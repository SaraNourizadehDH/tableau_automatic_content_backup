              <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, -1, [Calculation_557250104597061633]))' />
            </column>
            <column caption='Indicator MoM Fail Rate' datatype='string' name='[Indicator MoM Valid Orders   (copy)_2103040309017350174]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;([Avg Basket Value (MTD)  (copy)_2103040309016989723] - [Avg Basket Value (Prev MTD)  (copy)_2103040309017100316])&#10;/ [Avg Basket Value (Prev MTD)  (copy)_2103040309017100316]&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='Fail Rate MoM%' datatype='string' name='[Magical Orders MoM% (copy)_2103040309017231389]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;([Avg Basket Value (MTD)  (copy)_2103040309016989723] - [Avg Basket Value (Prev MTD)  (copy)_2103040309017100316])&#10;/ [Avg Basket Value (Prev MTD)  (copy)_2103040309017100316]&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;(&#10;([Avg Basket Value (MTD)  (copy)_2103040309016989723] - [Avg Basket Value (Prev MTD)  (copy)_2103040309017100316])&#10;/ [Avg Basket Value (Prev MTD)  (copy)_2103040309017100316]&#10;)*100, 2)&#10;)' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
