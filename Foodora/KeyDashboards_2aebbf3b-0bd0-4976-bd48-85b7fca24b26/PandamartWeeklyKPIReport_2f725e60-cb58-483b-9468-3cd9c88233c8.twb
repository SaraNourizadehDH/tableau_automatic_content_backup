            </column>
            <column caption='LW_Fail_Rate' datatype='string' name='[LW_Magical_Orders (copy)_1650991491451174933]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_1993476221386768384] THEN [num_of_failed_orders] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [num_of_orders] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [num_of_failed_orders] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_orders] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [num_of_failed_orders] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_orders] END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;(&#10;(&#10;(SUM(IF [Calculation_1993476221386768384] THEN [num_of_failed_orders] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [num_of_orders] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [num_of_failed_orders] END) &#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_orders] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [num_of_failed_orders] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_orders] END)) )&#10;* 100, 2)&#10;)' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
