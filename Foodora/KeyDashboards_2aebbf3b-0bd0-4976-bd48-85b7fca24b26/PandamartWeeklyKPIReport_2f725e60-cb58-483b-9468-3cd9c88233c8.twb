            <column caption='Indicator_LW_Existing_Customers' datatype='string' name='[Indicator_LW_Avg_Subsidy_Per_Voucher (copy)_1650991491459231788]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;AVG(IF [Calculation_1993476221386768384] THEN [num_of_existing_customers_weekly] END)&#10;-&#10;AVG(IF [Calculation_1993476221387321345] THEN [num_of_existing_customers_weekly] END) &#10;)&#10;/ AVG(IF [Calculation_1993476221387321345] THEN [num_of_existing_customers_weekly] END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
