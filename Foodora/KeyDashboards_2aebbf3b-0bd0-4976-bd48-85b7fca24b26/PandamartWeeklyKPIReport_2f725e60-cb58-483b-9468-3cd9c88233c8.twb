    <worksheet name='Reorder Rate 30D'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='18'>Reorder Rate</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='9'>(new customers 30 days ago that made an order again)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__weekly_kpi_dashboard' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='Is not this week' datatype='boolean' name='[Calculation_1161717639168991233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[report_date]) &lt; DATETRUNC(&apos;iso-week&apos;,TODAY()) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_2261440339125497858]' role='measure' type='quantitative' user:unnamed='Successful Orders'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column caption='L7 30D Reorder Rate AVG ' datatype='real' name='[L7 Reorder Rate AVG (copy)_3514144767867019267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(([reorder_rate (copy)_3514144767866720257]), first(), first()+5)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Reorder Rate 30D color code' datatype='integer' name='[Reorder Rate color code (copy)_3514144767866867714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (([reorder_rate (copy)_3514144767866720257]) - [L7 Reorder Rate AVG (copy)_3514144767867019267]) / [L7 Reorder Rate AVG (copy)_3514144767867019267] &gt;= 0.2 then 2&#10;elseif (([reorder_rate (copy)_3514144767866720257]) - [L7 Reorder Rate AVG (copy)_3514144767867019267]) / [L7 Reorder Rate AVG (copy)_3514144767867019267] &lt;= -0.2 then -2&#10;elseif (([reorder_rate (copy)_3514144767866720257]) - [L7 Reorder Rate AVG (copy)_3514144767867019267]) / [L7 Reorder Rate AVG (copy)_3514144767867019267] &lt;= -0.1 then -1&#10;elseif (([reorder_rate (copy)_3514144767866720257]) - [L7 Reorder Rate AVG (copy)_3514144767867019267]) / [L7 Reorder Rate AVG (copy)_3514144767867019267] &gt;= 0.1 then 1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_2261440339125497858]' derivation='Min' name='[min:Calculation_2261440339125497858:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1161717639168991233]' derivation='None' name='[none:Calculation_1161717639168991233:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[week]' derivation='None' name='[none:week:nk]' pivot='key' type='nominal' />
            <column caption='Num Of New Customers 31 Days Ago' datatype='integer' name='[num_of_new_customers_31_days_ago]' role='measure' type='quantitative' />
            <column caption='Num Of New Customers 31 Days Ago Who Reorder' datatype='integer' name='[num_of_new_customers_31_days_ago_who_reorder]' role='measure' type='quantitative' />
            <column caption='rank reorder rate 30d' datatype='real' name='[rank reorder rate (copy)_3514144767867412485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [Calculation_3491345310664937529] THEN [num_of_new_customers_31_days_ago_who_reorder]&#10;    ELSE 0&#10;    END&#10;  )&#10;&#10;/&#10;SUM(&#10;IF [Calculation_3491345310664937529] THEN&#10;[num_of_new_customers_31_days_ago] ELSE 0&#10;    END)' />
            </column>
            <column caption='reorder_rate 30d' datatype='real' default-format='p0.00%' name='[reorder_rate (copy)_3514144767866720257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_new_customers_31_days_ago_who_reorder])/sum([num_of_new_customers_31_days_ago])' />
            </column>
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
