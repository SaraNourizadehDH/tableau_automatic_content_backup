          <filter class='relative-date' column='[federated.1vwzzdx1ipz2aa1cjrceo0bb96ua].[none:report_date:qk]' filter-group='4' first-period='-5' include-future='true' include-null='false' last-period='0' period-type-v2='iso-week' />
