              <calculation class='tableau' formula='SUM (IF  DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN ([num_of_valid_orders_ec_pm]) END)&#10;&#10;/ &#10;&#10;SUM (IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN ([Valid Orders (Previous MTD) (copy)_557250104597786628]) END)' />
            </column>
            <column caption='% Orders EC PM (Previous MTD)' datatype='real' name='[% Orders NC (Previous MTD) (copy)_4761290003305259024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM (IF  DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN ([num_of_valid_orders_ec_pm]) END)&#10;&#10;/ &#10;&#10;SUM (IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN ([Calculation_557250104597385219]) END)' />
            </column>
            <column caption='% Orders EC PM MoM%' datatype='string' name='[% Orders NC MoM% (copy)_4761290003305365521]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;([% Orders NC (MTD) (copy)_4761290003305185295] - [% Orders NC (Previous MTD) (copy)_4761290003305259024])&#10;/ ([% Orders NC (Previous MTD) (copy)_4761290003305259024])&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;&#10;ROUND(&#10;(&#10;([% Orders NC (MTD) (copy)_4761290003305185295] - [% Orders NC (Previous MTD) (copy)_4761290003305259024])&#10;/ ([% Orders NC (Previous MTD) (copy)_4761290003305259024])&#10;)*100, 2)&#10;)' />
