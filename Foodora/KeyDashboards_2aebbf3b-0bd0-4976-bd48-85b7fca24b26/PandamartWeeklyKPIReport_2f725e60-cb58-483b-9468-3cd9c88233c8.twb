              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_1993476221386768384] THEN [fp_voucher_marketing_eur] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [fp_voucher_marketing_eur] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [fp_voucher_marketing_eur] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='LW_Avg_Subsidy_Per_Voucher' datatype='string' name='[LW_Avg_Delivery_Time (copy)_1650991491456151586]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_1993476221386768384] THEN [fp_voucher_marketing_eur] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [fp_voucher_marketing_eur] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [fp_voucher_marketing_eur] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;(&#10;(&#10;(SUM(IF [Calculation_1993476221386768384] THEN [fp_voucher_marketing_eur] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [fp_voucher_marketing_eur] END) &#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [fp_voucher_marketing_eur] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)) )&#10;* 100, 2)&#10;)' />
            </column>
