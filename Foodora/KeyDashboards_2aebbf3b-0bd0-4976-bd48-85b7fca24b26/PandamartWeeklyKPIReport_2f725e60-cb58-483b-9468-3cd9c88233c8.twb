    <worksheet name='LW% - Avg Basket Size (NV)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#d80b63' fontsize='18'>y</run>
            <run>Æ&#10;</run>
            <run fontcolor='#d80b63' fontsize='9'>y</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__weekly_kpi_dashboard' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua'>
            <column caption='is_last_week' datatype='boolean' name='[Calculation_1993476221386768384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;) = DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;, -1, TODAY()), &apos;monday&apos;)' />
            </column>
            <column caption='is_last_2week' datatype='boolean' name='[Calculation_1993476221387321345]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;) = DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;, -2, TODAY()), &apos;monday&apos;)' />
            </column>
            <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
            </column>
            <column aggregation='Sum' caption='LW' datatype='integer' name='[Calculation_5437533659915653121]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='LW % Δ' />
              </aliases>
            </column>
            <column caption='Indicator_LW_Avg_Basket_Size' datatype='string' name='[Indicator_LW_Orders_Per_Store (copy)_1650991491447341069]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_1993476221386768384] THEN [gfv_eur] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [gfv_eur] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [gfv_eur] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='LW_Avg_Basket_Size' datatype='string' name='[LW_Orders_Per_Store (copy)_1650991491446964236]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_1993476221386768384] THEN [gfv_eur] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [gfv_eur] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [gfv_eur] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;(&#10;(&#10;(SUM(IF [Calculation_1993476221386768384] THEN [gfv_eur] END)&#10;/SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders] END))&#10;-&#10;(SUM(IF [Calculation_1993476221387321345] THEN [gfv_eur] END) &#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END))&#10;)&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [gfv_eur] END)&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)) )&#10;* 100, 2)&#10;)' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Gfv Eur' datatype='real' name='[gfv_eur]' role='measure' type='quantitative' />
