        <calculation class='tableau' formula='WINDOW_AVG(([Calculation_1160521350950625280]), first(), first()+5)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Partially Fulfilled Orders MTD' datatype='real' name='[Calculation_1160521350952226819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#13;&#10;AND&#13;&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#13;&#10;THEN [num_of_partially_fulfilled_orders] END)) &#13;&#10;/&#13;&#10;(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#13;&#10;AND&#13;&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#13;&#10;THEN [num_of_valid_orders] END) )' />
      </column>
      <column caption='Partially Fulfilled Orders (Prev MTD)' datatype='real' name='[Calculation_1160521350953361412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#13;&#10;AND&#13;&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#13;&#10;THEN [num_of_partially_fulfilled_orders] END)) &#13;&#10;/&#13;&#10;(SUM(IF DATETRUNC(&apos;month&apos;, [report_date]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#13;&#10;AND&#13;&#10;DATEPART(&apos;day&apos;, [report_date]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#13;&#10;THEN [num_of_valid_orders] END) )' />
      </column>
      <column caption='Partially Fulfilled Orders color code' datatype='integer' name='[Calculation_1160521350954000389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_1160521350950625280] &gt;= 0.95 then 2 &#13;&#10;elseif ([Calculation_1160521350950625280] - [Calculation_1160521350951092226]) / [Calculation_1160521350951092226] &gt;= 0.2 then 2&#13;&#10;elseif ([Calculation_1160521350950625280] - [Calculation_1160521350951092226]) / [Calculation_1160521350951092226]  &lt;= -0.1 then -2&#13;&#10;elseif ([Calculation_1160521350950625280] - [Calculation_1160521350951092226]) / [Calculation_1160521350951092226] &lt;= -0.05 then -1&#13;&#10;elseif ([Calculation_1160521350950625280] - [Calculation_1160521350951092226]) / [Calculation_1160521350951092226]  &gt;= 0.1 then 1&#13;&#10;ELSEIF  [Calculation_1160521350950625280] &gt;= 0.80 then 1&#13;&#10;else 0&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='LW_Partially Fulfilled Orders' datatype='string' name='[Calculation_1160521350955962374]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (&#13;&#10;(SUM(IF [Calculation_1993476221386768384] THEN [num_of_partially_fulfilled_orders] END)&#13;&#10;/SUM(IF [Calculation_1993476221386768384] THEN [num_of_orders] END))&#13;&#10;-&#13;&#10;(SUM(IF [Calculation_1993476221387321345] THEN [num_of_partially_fulfilled_orders] END)&#13;&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_orders] END))&#13;&#10;)&#13;&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [num_of_partially_fulfilled_orders] END)&#13;&#10;/SUM(IF [Calculation_1993476221387321345] THEN  [num_of_orders] END)) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;+ STR(&#13;&#10;ROUND(&#13;&#10;(&#13;&#10;(&#13;&#10;(SUM(IF [Calculation_1993476221386768384] THEN [num_of_partially_fulfilled_orders] END)&#13;&#10;/SUM(IF [Calculation_1993476221386768384] THEN [num_of_orders] END))&#13;&#10;-&#13;&#10;(SUM(IF [Calculation_1993476221387321345] THEN [num_of_partially_fulfilled_orders] END) &#13;&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_orders] END))&#13;&#10;)&#13;&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [num_of_partially_fulfilled_orders] END)&#13;&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_orders] END)) )&#13;&#10;* 100, 2)&#13;&#10;)' />
      </column>
      <column caption='Indicator_LW_Partially Fulfilled Orders' datatype='string' name='[Calculation_1160521350957441032]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (&#13;&#10;(SUM(IF [Calculation_1993476221386768384] THEN [num_of_partially_fulfilled_orders] END)&#13;&#10;/SUM(IF [Calculation_1993476221386768384] THEN [num_of_valid_orders] END))&#13;&#10;-&#13;&#10;(SUM(IF [Calculation_1993476221387321345] THEN [num_of_partially_fulfilled_orders] END)&#13;&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END))&#13;&#10;)&#13;&#10;/ (SUM(IF [Calculation_1993476221387321345] THEN [num_of_partially_fulfilled_orders] END)&#13;&#10;/SUM(IF [Calculation_1993476221387321345] THEN [num_of_valid_orders] END)) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='Is not this week' datatype='boolean' name='[Calculation_1161717639168991233]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;,[report_date]) &lt; DATETRUNC(&apos;iso-week&apos;,TODAY()) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Weight Commission' datatype='real' name='[Calculation_1174595117297557509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_weighted_commission_gfv_eur_value])/SUM([total_gfv_eur])' />
      </column>
      <column caption='Non-Weighted Commission' datatype='real' name='[Calculation_1174595117298634758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission_non_weighted])/SUM([active_vendors])' />
      </column>
      <column caption='Total Orders Without Issues' datatype='integer' name='[Calculation_118430664336367616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[num_of_cx_gross_orders]-[total_orders_with_issues]' />
      </column>
      <column caption='Orders Per Store Per Day' datatype='real' name='[Calculation_1650991490474319872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='({FIXED [country_name], [vendor_type], [report_date] : SUM([num_of_valid_orders])})&#10;/&#10;({FIXED [country_name], [vendor_type], [report_date] : SUM([daily_active_vendors])})' />
      </column>
      <column caption='%_orders_w_vouchers' datatype='real' name='[Calculation_1893693317859909640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([num_of_valid_orders_w_vouchers])/sum([num_of_valid_orders])' />
      </column>
      <column caption='is_last_week' datatype='boolean' name='[Calculation_1993476221386768384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;) = DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;, -1, TODAY()), &apos;monday&apos;)' />
      </column>
      <column caption='is_last_2week' datatype='boolean' name='[Calculation_1993476221387321345]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;) = DATETRUNC(&apos;week&apos;,DATEADD(&apos;week&apos;, -2, TODAY()), &apos;monday&apos;)' />
      </column>
      <column caption='week test' datatype='integer' name='[Calculation_224335604637212672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ISOWEEK(today())' />
      </column>
      <column caption='L7 Order AVG' datatype='real' name='[Calculation_2261440339122278400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(sum([num_of_valid_orders]), first(), first()+5)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orders color code' datatype='integer' name='[Calculation_2261440339122642945]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='if (sum([num_of_valid_orders]) - [Calculation_2261440339122278400]) / [Calculation_2261440339122278400] &gt;= 0.2 then 2&#10;elseif (sum([num_of_valid_orders]) - [Calculation_2261440339122278400]) / [Calculation_2261440339122278400] &lt;= -0.2 then -2&#10;elseif (sum([num_of_valid_orders]) - [Calculation_2261440339122278400]) / [Calculation_2261440339122278400] &lt;= -0.1 then -1&#10;elseif (sum([num_of_valid_orders]) - [Calculation_2261440339122278400]) / [Calculation_2261440339122278400] &gt;= 0.1 then 1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='reorder_rate' datatype='real' name='[Calculation_274719600049917956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([new_customers_8_days_ago_who_reorder])/sum([new_customers_8_days_ago])' />
      </column>
      <column caption='% of total orders' datatype='real' name='[Calculation_277675072037953537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([num_of_valid_orders]) / SUM({fixed[country_name],[week] : sum([num_of_valid_orders])})' />
      </column>
      <column caption='Within Last 6 Isoweeks' datatype='boolean' name='[Calculation_3491345310664937529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &lt;= 5 AND DATEDIFF(&apos;week&apos;, [report_date], NOW(), &apos;monday&apos;) &gt; 0' />
      </column>
      <column caption='% Orders (NC PM)' datatype='real' name='[Calculation_4761290002484600832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([num_of_valid_orders_nc_pm])/sum([num_of_valid_orders])' />
      </column>
      <column caption='rank partially fulfilled order' datatype='real' name='[Calculation_514817754612649987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Calculation_3491345310664937529] THEN [num_of_partially_fulfilled_orders]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;  )&#13;&#10;&#13;&#10;/&#13;&#10;SUM(&#13;&#10;IF [Calculation_3491345310664937529] THEN&#13;&#10;[num_of_valid_orders] ELSE 0&#13;&#10;    END)' />
      </column>
      <column caption='Indicator MoM Partially Fulfilled Orders' datatype='string' name='[Calculation_514817754614153221]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (&#13;&#10;([Calculation_1160521350952226819] - [Calculation_1160521350953361412])&#13;&#10;/ [Calculation_1160521350953361412]&#13;&#10;) &gt;=0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='Partially Fulfilled Orders MoM%' datatype='string' name='[Calculation_514817754615201798]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (&#13;&#10;([Calculation_1160521350952226819] - [Calculation_1160521350953361412] )&#13;&#10;/ [Calculation_1160521350953361412]&#13;&#10;) &gt;=0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;+ STR(&#13;&#10;ROUND(&#13;&#10;(&#13;&#10;([Calculation_1160521350952226819] - [Calculation_1160521350953361412])&#13;&#10;/ [Calculation_1160521350953361412]&#13;&#10;)*100, 2)&#13;&#10;)' />
      </column>
      <column caption='rank gmv contribution' datatype='real' name='[Calculation_514817754620792841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_name], [vendor_type], [report_date] : SUM(&#13;&#10;    IF [Calculation_3491345310664937529] THEN [gmv_eur]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;  )}&#13;&#10;&#13;&#10;/&#13;&#10;({FIXED [country_name], [report_date] : SUM(&#13;&#10;IF [Calculation_3491345310664937529] THEN&#13;&#10;[gmv_eur] ELSE 0&#13;&#10;    END)})' />
      </column>
