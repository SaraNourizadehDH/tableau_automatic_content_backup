    <worksheet name='Marketing Metrics (MoM)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>Marketing Metrics</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_vendor_kpi_dashboard' name='federated.04gxr5y0scqev818b18la0wamhu8' />
          </datasources>
          <datasource-dependencies datasource='federated.04gxr5y0scqev818b18la0wamhu8'>
            <column caption='% Orders with Vouchers' datatype='real' name='[Calculation_1089589691930456121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_orders_w_vouchers])/sum([valid_orders])' />
            </column>
            <column caption='% Orders from New Customers' datatype='real' name='[Calculation_1089589691936477247]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_nc_pm_n2v] + [num_of_nc_pm_platform_n2p])/SUM([valid_orders])' />
            </column>
            <column caption='% Orders new to platform' datatype='real' name='[Calculation_564638866391064577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_from_new_platform_customers])/SUM([valid_orders])' />
            </column>
            <column caption='is_m1' datatype='string' name='[Calculation_81346327835394048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH(TODAY()) = MONTH([report_date_local]) THEN &quot;Current month&quot; else &quot;Previous 2 months&quot; END' />
            </column>
            <column caption='Voucher per Order' datatype='real' name='[Calculation_886927708376944647]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([voucher_value_eur])/sum([valid_orders])' />
            </column>
            <column caption='Orders/Day/Store' datatype='real' name='[Calculation_886927708377710601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([valid_orders])/COUNTD([vendor_name])/countd([report_date_local])' />
            </column>
            <column-instance column='[pct_voucher_of_gmv_in_voucher_orders]' derivation='Avg' name='[avg:pct_voucher_of_gmv_in_voucher_orders:qk]' pivot='key' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[orders_per_user_m]' derivation='Min' name='[min:orders_per_user_m:qk]' pivot='key' type='quantitative' />
            <column-instance column='[report_date_local]' derivation='Month' name='[mn:report_date_local:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_81346327835394048]' derivation='None' name='[none:Calculation_81346327835394048:nk]' pivot='key' type='nominal' />
