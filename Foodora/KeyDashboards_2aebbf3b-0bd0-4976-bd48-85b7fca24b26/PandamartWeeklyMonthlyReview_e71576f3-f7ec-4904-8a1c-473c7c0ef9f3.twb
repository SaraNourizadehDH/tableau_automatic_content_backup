            <column caption='WoW Avg Basket Size - GFV (€)' datatype='real' name='[Avg Basket Size - GFV (€) (copy)_1089589691861897226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gfv_eur])/sum([valid_orders])' />
            </column>
            <column caption='WoW Avg Delivery Time' datatype='real' name='[Avg Delivery Time (copy)_1089589691862196236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([actual_delivery_time])/sum([total_non_preorders])/60.0' />
            </column>
            <column caption='APAC_title' datatype='string' name='[Calculation_126100795270144002]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
            </column>
            <column caption='Year-Isoweek' datatype='string' name='[Calculation_3651152711424458752]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(ISOYEAR([report_date_local])) + &apos;-W&apos; + STR(ISOWEEK([report_date_local]))' />
            </column>
            <column caption='index' datatype='integer' name='[Calculation_46724908129513472]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='index()'>
