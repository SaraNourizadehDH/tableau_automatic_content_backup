    <worksheet name='Key Metrics WoW'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>Æ </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_vendor_kpi_dashboard' name='federated.04gxr5y0scqev818b18la0wamhu8' />
          </datasources>
          <datasource-dependencies datasource='federated.04gxr5y0scqev818b18la0wamhu8'>
            <column caption='WoW Avg Basket Size - GFV (€)' datatype='real' name='[Avg Basket Size - GFV (€) (copy)_1089589691861897226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gfv_eur])/sum([valid_orders])' />
            </column>
            <column caption='WoW Avg Delivery Time' datatype='real' name='[Avg Delivery Time (copy)_1089589691862196236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([actual_delivery_time])/sum([total_non_preorders])/60.0' />
            </column>
            <column caption='Year-Isoweek' datatype='string' name='[Calculation_3651152711424458752]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(ISOYEAR([report_date_local])) + &apos;-W&apos; + STR(ISOWEEK([report_date_local]))' />
            </column>
            <column caption='index' datatype='integer' name='[Calculation_46724908129513472]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='index()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Orders from New Customers' datatype='integer' name='[Calculation_6092314772007075841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_nc_pm_n2v]) + sum([num_of_nc_pm_platform_n2p])' />
            </column>
            <column caption='is_w1' datatype='string' name='[Calculation_81346327841480706]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISOWEEK(TODAY()) = ISOWEEK([report_date_local]) THEN &quot;False&quot; else &quot;True&quot; END' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_886927708370219012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders])/sum([num_of_orders])' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' name='[Calculation_886927708372246533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([actual_delivery_time])/sum([total_non_preorders])' />
            </column>
            <column caption='Avg Basket Size - GFV (€)' datatype='real' name='[Calculation_886927708373835782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gfv_eur])/sum([valid_orders])' />
            </column>
            <column caption='Voucher per Order' datatype='real' name='[Calculation_886927708376944647]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([voucher_value_eur])/sum([valid_orders])' />
            </column>
            <column caption='Units per Order' datatype='real' name='[Calculation_886927708377333768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_delivered_quantity])/SUM([valid_orders])' />
            </column>
            <column caption='Orders/Day/Store' datatype='real' name='[Calculation_886927708377710601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([valid_orders])/COUNTD([vendor_name])/countd([report_date_local])' />
            </column>
            <column caption='WoW Fail Rate' datatype='real' name='[Fail Rate (copy)_1089589691859714051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders])/sum([num_of_orders])' />
            </column>
            <column caption='WoW Units per Order' datatype='real' name='[Units per Order (copy)_1089589691861270535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_delivered_quantity])/SUM([valid_orders])' />
            </column>
            <column caption='WoW Voucher per Order' datatype='real' name='[Voucher per Order (copy)_1089589691862814736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([voucher_value_eur])/sum([valid_orders])' />
            </column>
            <column caption='Actual Delivery Time' datatype='real' name='[actual_delivery_time]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
