    <worksheet name='Metrics (GR)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APPandaMartWeeklyMonthlyReview/MetricsGR?rev=' id='MetricsGR' path='/t/Foodora/workbooks/PandamartWeeklyMonthlyReview' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_vendor_kpi_dashboard' name='federated.04gxr5y0scqev818b18la0wamhu8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Start Day of Week' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monday&quot;'>
              <calculation class='tableau' formula='&quot;Monday&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04gxr5y0scqev818b18la0wamhu8'>
            <column caption='Avg at_vendor_time_cleaned' datatype='real' name='[Calculation_1021472747883577346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([at_vendor_time_cleaned])/sum([total_non_preorders])' />
            </column>
            <column caption='Assignment Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1021472747927379974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([assignment_time])/sum([valid_orders])' />
            </column>
            <column caption='Shrinkage' datatype='real' default-format='p0.0%' name='[Calculation_1021472747961839625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(sum([shrink_adjustment_value]*-1),0)/sum([gfv_pelican_local])' />
            </column>
            <column caption='Avg created_to_rider_accepted_time' datatype='real' name='[Calculation_1089589691878674450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([created_to_rider_accepted_time])/sum([total_non_preorders])' />
            </column>
            <column caption='Avg to_vendor_time' datatype='real' name='[Calculation_1089589691880472596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([to_vendor_time])/sum([total_non_preorders])' />
            </column>
            <column caption='Avg at_vendor_time' datatype='real' name='[Calculation_1089589691881013269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([at_vendor_time])/sum([total_non_preorders])' />
            </column>
            <column caption='Avg to_customer_time' datatype='real' name='[Calculation_1089589691881349142]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([to_customer_time])/sum([total_non_preorders])' />
            </column>
            <column caption='Avg at_customer_time' datatype='real' name='[Calculation_1089589691881762839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([at_customer_time])/sum([total_non_preorders])' />
            </column>
            <column caption='% Stacked Deliveries' datatype='real' name='[Calculation_1089589691882078232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_stacked_deliveries])/sum([num_of_deliveries])' />
            </column>
            <column caption='Delivery&lt;15mins' datatype='real' name='[Calculation_1089589691883450393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([deliveries_less_than_15_mins])/sum([total_non_preorders])' />
            </column>
            <column caption='Delivery&gt;30mins' datatype='real' name='[Calculation_1089589691883638810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([deliveries_more_than_30_mins])/sum([total_non_preorders])' />
            </column>
            <column caption='Logistic Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_1089589691922333740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([traffic_manager_fail])/SUM([num_of_orders])' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_1089589691923148847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_failed_vendor_orders])/sum([num_of_orders])' />
            </column>
            <column caption='Customer Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_1089589691923636275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_failed_customer_orders])/sum([num_of_orders])' />
            </column>
            <column caption='Post Delivery Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_1089589691923976244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([post_delivery_fail])/sum([num_of_orders])' />
            </column>
            <column caption='% Orders with Vouchers' datatype='real' name='[Calculation_1089589691930456121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_orders_w_vouchers])/sum([valid_orders])' />
            </column>
            <column caption='% Orders from New Customers' datatype='real' name='[Calculation_1089589691936477247]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_nc_pm_n2v] + [num_of_nc_pm_platform_n2p])/SUM([valid_orders])' />
            </column>
            <column caption='% of Grocery Orders' datatype='real' name='[Calculation_1375568269313519617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([valid_orders])/SUM([grocery_valid_orders])' />
            </column>
            <column caption='% Orders new to platform' datatype='real' name='[Calculation_564638866391064577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_from_new_platform_customers])/SUM([valid_orders])' />
            </column>
            <column caption='Picking Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_606015682384859136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([picking_time_in_seconds_remove_picking])/sum([orders_remove_picking])' />
            </column>
            <column caption='Orders from New Customers' datatype='integer' name='[Calculation_6092314772007075841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_nc_pm_n2v]) + sum([num_of_nc_pm_platform_n2p])' />
            </column>
            <column caption='Availability' datatype='real' default-format='p0.0%' name='[Calculation_6372382383751852032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([available_hours])/SUM([total_hours])' />
            </column>
            <column caption='Date-Grau' datatype='datetime' name='[Calculation_886927708360470528]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='datetrunc([Parameters].[Parameter 1],[report_date_local],[Parameters].[Parameter 2])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_886927708370219012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders])/sum([num_of_orders])' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' name='[Calculation_886927708372246533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([actual_delivery_time])/sum([total_non_preorders])' />
            </column>
            <column caption='Avg Basket Size - GFV (€)' datatype='real' name='[Calculation_886927708373835782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gfv_eur])/sum([valid_orders])' />
            </column>
            <column caption='Voucher per Order' datatype='real' name='[Calculation_886927708376944647]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([voucher_value_eur])/sum([valid_orders])' />
            </column>
            <column caption='Units per Order' datatype='real' name='[Calculation_886927708377333768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_delivered_quantity])/SUM([valid_orders])' />
            </column>
