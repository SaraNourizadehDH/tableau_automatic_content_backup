            <column caption='WoW % Orders from New Customers' datatype='real' name='[% Orders from New Customers (copy)_1089589691937329216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_nc_pm_n2v]+[num_of_nc_pm_platform_n2p])/SUM([valid_orders])' />
            </column>
            <column caption='WoW % Orders with Vouchers' datatype='real' name='[% Orders with Vouchers (copy)_1089589691930705978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_orders_w_vouchers])/sum([valid_orders])' />
