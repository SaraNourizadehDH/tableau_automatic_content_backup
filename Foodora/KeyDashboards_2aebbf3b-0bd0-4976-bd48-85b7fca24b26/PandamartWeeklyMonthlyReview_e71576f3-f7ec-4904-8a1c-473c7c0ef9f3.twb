      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_vendor_kpi_dashboard' name='federated.04gxr5y0scqev818b18la0wamhu8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metrics View' datatype='string' datatype-customized='true' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Picking Time&quot;'>
              <calculation class='tableau' formula='&quot;Picking Time&quot;' />
            </column>
            <column caption='View Level' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Store&quot;'>
              <calculation class='tableau' formula='&quot;Store&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04gxr5y0scqev818b18la0wamhu8'>
            <column caption='Assignment Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1021472747927379974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([assignment_time])/sum([valid_orders])' />
            </column>
            <column caption='Shrinkage' datatype='real' default-format='p0.0%' name='[Calculation_1021472747961839625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(sum([shrink_adjustment_value]*-1),0)/sum([gfv_pelican_local])' />
            </column>
            <column caption='Picking Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_606015682384859136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([picking_time_in_seconds_remove_picking])/sum([orders_remove_picking])' />
            </column>
            <column caption='Metrics' datatype='string' name='[Calculation_639792689016147970]' role='measure' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 4]&#13;&#10;when &quot;Fail Rate&quot; then str(round([Calculation_886927708370219012]*100,2)) + &quot;%&quot;&#13;&#10;when &quot;Assignment Time&quot; then str(round([Calculation_1021472747927379974],2))&#13;&#10;when &quot;Picking Time&quot; then str(round([Calculation_606015682384859136],2))&#13;&#10;when &quot;Shrinkage&quot; then str(round([Calculation_1021472747961839625]*100,2)) + &quot;%&quot;&#10;when &quot;Sales Weighted Availability&quot; then str(round(AVG([sales_weighted_availability])*100,2)) + &quot;%&quot;&#13;&#10;end' />
            </column>
            <column caption='View level cal' datatype='string' name='[Calculation_639792689052663813]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 5]&#13;&#10;when &quot;Country&quot; then [country_name]&#13;&#10;when &quot;Store&quot; then [vendor_name]&#13;&#10;END' />
            </column>
            <column caption='Metrics (measure)' datatype='real' name='[Calculation_789255901996621829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 4]&#13;&#10;when &quot;Fail Rate&quot; then [Calculation_886927708370219012]*100&#13;&#10;when &quot;Assignment Time&quot; then [Calculation_1021472747927379974]&#13;&#10;when &quot;Picking Time&quot; then [Calculation_606015682384859136]&#13;&#10;when &quot;Shrinkage&quot; then [Calculation_1021472747961839625]*100&#10;when &quot;Sales Weighted Availability&quot; then AVG([sales_weighted_availability])*100&#13;&#10;end' />
            </column>
            <column caption='is_w1' datatype='string' name='[Calculation_81346327841480706]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISOWEEK(TODAY()) = ISOWEEK([report_date_local]) THEN &quot;False&quot; else &quot;True&quot; END' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_886927708370219012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders])/sum([num_of_orders])' />
            </column>
