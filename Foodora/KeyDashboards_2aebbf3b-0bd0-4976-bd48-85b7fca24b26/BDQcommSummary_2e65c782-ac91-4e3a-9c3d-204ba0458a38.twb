            <run bold='true' fontcolor='#bf005a' fontname='Tableau Semibold'>&gt; KPI</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (pandata_bd_local)' name='federated.109n0m20zzm9x81gd0ebl09iiqzm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Vertical' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Qcomm&quot;'>
              <calculation class='tableau' formula='&quot;Qcomm&quot;' />
            </column>
            <column caption='KPI' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;GMV/Day&quot;'>
              <calculation class='tableau' formula='&quot;GMV/Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.109n0m20zzm9x81gd0ebl09iiqzm'>
            <column caption='MAU' datatype='integer' name='[Calculation_2768306410177945606]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;dmart&quot; THEN SUM([dmart_mau])&#10;WHEN &quot;shops&quot; THEN SUM([shops_mau])&#10;WHEN &quot;Qcomm&quot; THEN SUM([qcomm_mau])&#10;END' />
            </column>
            <column caption='iCPGMV %' datatype='real' name='[Calculation_2768306410178359303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;dmart&quot; THEN [dmart_ICPGMV]&#10;WHEN &quot;shops&quot; THEN [shops_ICPGMV]&#10;WHEN &quot;Qcomm&quot; THEN [qcomm_ICPGMV]&#10;END' />
            </column>
            <column caption='KPI Selected' datatype='real' name='[Calculation_2768306410188238864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;GMV/Day&quot; THEN SUM([GMV (copy)_2768306410182148107])&#10;WHEN &quot;GFV/Day&quot; THEN SUM([GMV (copy) (copy)_2768306410182164492])&#10;WHEN &quot;MAU&quot; THEN ([Calculation_2768306410177945606])&#10;WHEN &quot;NC&quot; THEN ([Orders (copy)_2768306410171441156])&#10;WHEN &quot;NTV&quot; THEN ([Orders (copy) (copy)_2768306410171449349])&#10;WHEN &quot;iCPGMV %&quot; THEN ROUND(AVG([Calculation_2768306410178359303])*100,3)&#10;END' />
            </column>
            <column caption='GFV/Day' datatype='real' name='[GMV (copy) (copy)_2768306410182164492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;dmart&quot; THEN [dmart_gfv_day]&#10;WHEN &quot;shops&quot; THEN [shops_gfv_day]&#10;WHEN &quot;Qcomm&quot; THEN [dmart_gfv_day] + [shops_gfv_day]&#10;END' />
            </column>
            <column caption='GMV/Day' datatype='real' name='[GMV (copy)_2768306410182148107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;dmart&quot; THEN [dmart_gmv_day]&#10;WHEN &quot;shops&quot; THEN [shops_gmv_day]&#10;WHEN &quot;Qcomm&quot; THEN [dmart_gmv_day] + [shops_gmv_day]&#10;END' />
            </column>
            <column caption='NTV' datatype='integer' name='[Orders (copy) (copy)_2768306410171449349]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;dmart&quot; THEN SUM([dmart_ntv])&#10;WHEN &quot;shops&quot; THEN SUM([shops_ntv])&#10;WHEN &quot;Qcomm&quot; THEN SUM([dmart_ntv]) + SUM([shops_ntv])&#10;END' />
            </column>
            <column caption='NC' datatype='integer' name='[Orders (copy)_2768306410171441156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;dmart&quot; THEN SUM([dmart_nc])&#10;WHEN &quot;shops&quot; THEN SUM([shops_nc])&#10;WHEN &quot;Qcomm&quot; THEN SUM([dmart_nc]) + SUM([shops_nc])&#10;END' />
            </column>
            <column caption='OPD' datatype='real' name='[Orders (copy)_2768306410181947402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;dmart&quot; THEN [dmart_opd]&#10;WHEN &quot;shops&quot; THEN [shops_opd]&#10;WHEN &quot;Qcomm&quot; THEN [dmart_opd] + [shops_opd]&#10;END' />
            </column>
