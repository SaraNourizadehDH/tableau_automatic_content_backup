            </column>
            <column caption='AFV' datatype='real' name='[Calculation_2768306410180034569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV (copy)_2768306410171301891]/[Calculation_2768306410170597377]' />
