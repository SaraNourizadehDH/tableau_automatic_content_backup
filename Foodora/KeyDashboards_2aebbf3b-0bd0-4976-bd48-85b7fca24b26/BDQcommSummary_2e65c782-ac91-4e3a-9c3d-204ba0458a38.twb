      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_BEFA921677E04EB7A9FED1FA1F611A94'>
            <properties context=''>
              <relation connection='bigquery.1w37e941lva6hq1aso2jp06zvqfb' name='Custom SQL Query' type='text'>SELECT
DATE_TRUNC(bd.order_date, MONTH) AS month,
COUNT(CASE WHEN bd.business_type_apac = &quot;shops&quot; THEN bd.order_code END) AS shops_orders,
COUNT(CASE WHEN bd.business_type_apac = &quot;dmart&quot; THEN bd.order_code END) AS dmart_orders,
COUNT(bd.order_code) AS total_orders,

COUNT(CASE WHEN bd.business_type_apac = &quot;shops&quot; THEN bd.order_code END)/COUNT(DISTINCT CASE WHEN bd.business_type_apac = &quot;shops&quot; THEN bd.order_date END) AS shops_opd,
COUNT(CASE WHEN bd.business_type_apac = &quot;dmart&quot; THEN bd.order_code END)/COUNT(DISTINCT CASE WHEN bd.business_type_apac = &quot;dmart&quot; THEN bd.order_date END) AS dmart_opd,
COUNT(bd.order_code)/COUNT(DISTINCT bd.order_date)  AS total_opd,

SUM(CASE WHEN bd.business_type_apac = &quot;shops&quot; THEN bd.gmv_gross_local END) AS shops_gmv,
SUM(CASE WHEN bd.business_type_apac = &quot;dmart&quot; THEN bd.gmv_gross_local END) AS dmart_gmv,
SUM(bd.gmv_gross_local) AS total_gmv,

SUM(CASE WHEN bd.business_type_apac = &quot;shops&quot; THEN bd.gmv_gross_local END)/COUNT(DISTINCT CASE WHEN bd.business_type_apac = &quot;shops&quot; THEN bd.order_date END) AS shops_gmv_day,
SUM(CASE WHEN bd.business_type_apac = &quot;dmart&quot; THEN bd.gmv_gross_local END)/COUNT(DISTINCT CASE WHEN bd.business_type_apac = &quot;dmart&quot; THEN bd.order_date END) AS dmart_gmv_day,
SUM(bd.gmv_gross_local)/COUNT(DISTINCT bd.order_date) AS total_gmv_day,

SUM(CASE WHEN bd.business_type_apac = &quot;shops&quot; THEN bd.gfv_gross_local END) AS shops_gfv,
SUM(CASE WHEN bd.business_type_apac = &quot;dmart&quot; THEN bd.gfv_gross_local END) AS dmart_gfv,
SUM(bd.gfv_gross_local) AS total_gfv,

SUM(CASE WHEN bd.business_type_apac = &quot;shops&quot; THEN bd.gfv_gross_local END)/COUNT(DISTINCT CASE WHEN bd.business_type_apac = &quot;shops&quot; THEN bd.order_date END) AS shops_gfv_day,
SUM(CASE WHEN bd.business_type_apac = &quot;dmart&quot; THEN bd.gfv_gross_local END)/COUNT(DISTINCT CASE WHEN bd.business_type_apac = &quot;dmart&quot; THEN bd.order_date END) AS dmart_gfv_day,
SUM(bd.gfv_gross_local)/COUNT(DISTINCT bd.order_date) AS total_gfv_day,

COUNT(DISTINCT CASE WHEN bd.business_type_apac = &quot;shops&quot; THEN bd.pd_customer_id END) AS shops_mau,
COUNT(DISTINCT CASE WHEN bd.business_type_apac = &quot;dmart&quot; THEN bd.pd_customer_id END) AS dmart_mau,
COUNT(DISTINCT CASE WHEN bd.business_type_apac IN (&quot;dmart&quot;, &quot;shops&quot;) THEN bd.pd_customer_id END) AS qcomm_mau,
COUNT(DISTINCT bd.pd_customer_id) AS total_mau,

COUNT(DISTINCT CASE WHEN bd.business_type_apac = &quot;shops&quot; AND fo.first_valid_order THEN bd.pd_customer_id END) AS shops_nc,
COUNT(DISTINCT CASE WHEN bd.business_type_apac = &quot;dmart&quot; AND fo.first_valid_order THEN bd.pd_customer_id END) AS dmart_nc,
COUNT(DISTINCT CASE WHEN fo.first_valid_order THEN bd.pd_customer_id END) AS total_nc,

COUNT(DISTINCT CASE WHEN bd.business_type_apac = &quot;shops&quot; AND fo.first_valid_order IS FALSE AND fo.first_valid_order_shops THEN bd.pd_customer_id END) AS shops_ntv,
COUNT(DISTINCT CASE WHEN bd.business_type_apac = &quot;dmart&quot; AND fo.first_valid_order IS FALSE AND fo.first_valid_order_dmart THEN bd.pd_customer_id END) AS dmart_ntv,

SAFE_DIVIDE (SUM(IFNULL((CASE WHEN NOT ((bd.voucher_channel = &quot;channel_partnership&quot; AND bd.voucher_purpose = &quot;activation&quot;)
                                        OR (bd.voucher_channel = &quot;channel_employee_benefits&quot; AND bd.voucher_purpose = &quot;benefits&quot;)
                                        OR (bd.voucher_channel = &quot;channel_online&quot; AND bd.voucher_purpose = &quot;autocompensation_realtime&quot;)
                                        OR (bd.voucher_channel = &quot;channel_customer_service&quot; AND bd.voucher_purpose = &quot;refund&quot;)
                                        OR (bd.voucher_channel = &quot;channel_partnership&quot; AND bd.voucher_purpose = &quot;revenue&quot;)
                                        OR (bd.voucher_channel = &quot;channel_corporate&quot; AND bd.voucher_purpose = &quot;revenue&quot;)
                                        OR (bd.voucher_channel = &quot;channel_customer_service&quot; AND bd.voucher_purpose = &quot;sorry_panda&quot;)
                                        ) AND bd.business_type_apac = &quot;shops&quot; THEN bd.voucher_value_foodpanda_subsidized END),0)
+IFNULL(CASE WHEN bd.business_type_apac = &quot;shops&quot; THEN bd.discount_value_foodpanda_subsidized END,0)),SUM(CASE WHEN bd.business_type_apac = &quot;shops&quot; then gmv_gross_local else 0 end)
) as shops_ICPGMV,
SAFE_DIVIDE (SUM(IFNULL((CASE WHEN NOT ((bd.voucher_channel = &quot;channel_partnership&quot; AND bd.voucher_purpose = &quot;activation&quot;)
                                        OR (bd.voucher_channel = &quot;channel_employee_benefits&quot; AND bd.voucher_purpose = &quot;benefits&quot;)
                                        OR (bd.voucher_channel = &quot;channel_online&quot; AND bd.voucher_purpose = &quot;autocompensation_realtime&quot;)
                                        OR (bd.voucher_channel = &quot;channel_customer_service&quot; AND bd.voucher_purpose = &quot;refund&quot;)
                                        OR (bd.voucher_channel = &quot;channel_partnership&quot; AND bd.voucher_purpose = &quot;revenue&quot;)
                                        OR (bd.voucher_channel = &quot;channel_corporate&quot; AND bd.voucher_purpose = &quot;revenue&quot;)
                                        OR (bd.voucher_channel = &quot;channel_customer_service&quot; AND bd.voucher_purpose = &quot;sorry_panda&quot;)
                                        ) AND bd.business_type_apac = &quot;dmart&quot; THEN bd.voucher_value_foodpanda_subsidized END),0)
+IFNULL(CASE WHEN bd.business_type_apac = &quot;dmart&quot; THEN bd.discount_value_foodpanda_subsidized END,0)),SUM(CASE WHEN bd.business_type_apac = &quot;dmart&quot; then gmv_gross_local else 0 end)
) as dmart_ICPGMV,
SAFE_DIVIDE (SUM(IFNULL((CASE WHEN NOT ((bd.voucher_channel = &quot;channel_partnership&quot; AND bd.voucher_purpose = &quot;activation&quot;)
                                        OR (bd.voucher_channel = &quot;channel_employee_benefits&quot; AND bd.voucher_purpose = &quot;benefits&quot;)
                                        OR (bd.voucher_channel = &quot;channel_online&quot; AND bd.voucher_purpose = &quot;autocompensation_realtime&quot;)
                                        OR (bd.voucher_channel = &quot;channel_customer_service&quot; AND bd.voucher_purpose = &quot;refund&quot;)
                                        OR (bd.voucher_channel = &quot;channel_partnership&quot; AND bd.voucher_purpose = &quot;revenue&quot;)
                                        OR (bd.voucher_channel = &quot;channel_corporate&quot; AND bd.voucher_purpose = &quot;revenue&quot;)
                                        OR (bd.voucher_channel = &quot;channel_customer_service&quot; AND bd.voucher_purpose = &quot;sorry_panda&quot;)
                                        ) AND bd.business_type_apac IN (&quot;dmart&quot;, &quot;shops&quot;) THEN bd.voucher_value_foodpanda_subsidized END),0)
+IFNULL(CASE WHEN bd.business_type_apac  IN (&quot;dmart&quot;, &quot;shops&quot;) THEN bd.discount_value_foodpanda_subsidized END,0)),SUM(CASE WHEN bd.business_type_apac  IN (&quot;dmart&quot;, &quot;shops&quot;) then gmv_gross_local else 0 end)
) as qcomm_ICPGMV


FROM `fulfillment-dwh-production.pandata_report.country_BD_bd_analytics` AS bd
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_BD_customer_first_orders` AS fo
       ON bd.order_code = fo.code
WHERE bd.is_valid_order
AND bd.order_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)

GROUP BY 1
ORDER BY 1 DESC</relation>
            </properties>
