      <column caption='Orders' datatype='integer' name='[Calculation_2768306410170597377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;dmart&quot; THEN SUM([dmart_orders])&#10;WHEN &quot;shops&quot; THEN SUM([shops_orders])&#10;WHEN &quot;Qcomm&quot; THEN SUM([dmart_orders]) + SUM([shops_orders])&#10;END' />
