      </column>
      <column caption='New Customers to Vertical' datatype='integer' hidden='true' name='[Calculation_2967942561220022272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [vendor_type] when &apos;pandamart&apos; then [num_of_nc_pm_n2v]&#10;when &apos;shops&apos; then [num_of_nc_shops_n2v] else null end' />
