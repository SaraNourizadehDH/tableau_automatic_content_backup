    <worksheet name='Shops Chart 3'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__kpi_dashboard`' name='federated.0z205h31jg5mur135c09z0qd3uvd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Shops Metric 3' datatype='string' name='[Choose Metric 5 (copy)_108790131173998606]' param-domain-type='list' role='measure' type='nominal' value='&quot;Gross Orders&quot;'>
              <calculation class='tableau' formula='&quot;Gross Orders&quot;' />
            </column>
            <column alias='Monthly' caption='Date Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Select Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0z205h31jg5mur135c09z0qd3uvd'>
            <column caption='% of Platform GMV' datatype='real' name='[%_of_total_orders (copy)_1560849173003051008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])/SUM({FIXED [country_name],[report_date_local]:SUM([gmv_eur])})' />
            </column>
            <column caption='Avg Basket Size - GMV (Voucher)' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[ABV (Vouchered Orders) (copy)_1404771287100366849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV (Non-voucher) (copy)_254171966859681795])/SUM([num_of_orders_w_vouchers])' />
            </column>
            <column caption='Avg Basket Size - GFV (Local)' datatype='real' name='[Avg Basket Size - GFV (€) (copy)_3065966242992746496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_local])/SUM([valid_orders])' />
            </column>
            <column caption='Avg Basket Size - GMV (Local)' datatype='real' name='[Avg Basket Size - GMV (€) (copy)_3065966242992844801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_local])/SUM([valid_orders])' />
            </column>
            <column caption='Avg Basket Size - GFV (Non-voucher)' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Avg Basket Value (Voucher) (copy)_1404771287101366276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV (Non-voucher) (copy)_254171966860001285])/sum([Calculation_1404771287101485061])' />
            </column>
            <column caption='Avg Basket Size - GMV (Non-voucher)' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Avg. Order Value (Voucher) (copy)_1404771287101726726]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1404771287101038595])/SUM([Calculation_1404771287101485061])' />
            </column>
            <column caption='Avg Basket Size - GFV (Voucher)' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_1404771287100080128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV (Voucher) (copy)_254171966859767812])/sum([num_of_orders_w_vouchers])' />
            </column>
            <column caption='GMV (Non-voucher)' datatype='real' name='[Calculation_1404771287101038595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Euro&apos; THEN [gmv_eur] - [gmv_eur_voucher_orders]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Local&apos; THEN [gmv_local] - [gmv_local_voucher_orders]&#10;END' />
            </column>
            <column caption='Non Voucher Orders' datatype='integer' name='[Calculation_1404771287101485061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[valid_orders]-[num_of_orders_w_vouchers]' />
            </column>
            <column caption='Delivery &gt; 30 mins' datatype='real' name='[Calculation_159737109277237248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([deliveries_more_than_30_mins])/sum([num_of_non_preorders])' />
            </column>
            <column caption='% Orders with Vouchers' datatype='real' name='[Calculation_189221559184879616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_orders_w_vouchers])/SUM([valid_orders])' />
            </column>
            <column caption='% Voucher of GFV' datatype='real' name='[Calculation_2041115797208952833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voucher_value_eur])/SUM([gfv_eur])' />
            </column>
            <column caption='Date-Gran' datatype='string' name='[Calculation_2052867440901128193]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;day&apos; THEN&#10;STR(DATEPART(&apos;year&apos;,DATETRUNC(&apos;day&apos;,[report_date_local])))&#10;+ &apos;-&apos;&#10;+ STR(DATEPART(&apos;month&apos;,DATETRUNC(&apos;day&apos;,[report_date_local])))&#10;+ &apos;-&apos;&#10;+ STR(DATEPART(&apos;day&apos;,DATETRUNC(&apos;day&apos;,[report_date_local])))&#10;ELSEIF [Parameters].[Parameter 2] = &apos;month&apos;&#10;THEN&#10;STR(DATEPART(&apos;year&apos;,DATETRUNC(&apos;day&apos;,[report_date_local])))&#10;+ &apos;-&apos;&#10;+ STR(DATEPART(&apos;month&apos;,DATETRUNC(&apos;day&apos;,[report_date_local])))&#10;ELSE&#10;STR(DATEPART(&apos;iso-year&apos;,DATETRUNC(&apos;day&apos;,[report_date_local])))&#10;+ &apos;-&apos;&#10;+ STR(DATEPART(&apos;iso-week&apos;,DATETRUNC(&apos;iso-week&apos;,[report_date_local])))&#10;END' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_254171966849855488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Euro&apos; THEN [gmv_eur]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Local&apos; THEN [gmv_local]&#10;END' />
            </column>
            <column caption='Delivery Fee' datatype='real' name='[Calculation_254171966893760518]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Euro&apos; THEN [delivery_fee_eur]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Local&apos; THEN [delivery_fee_local]&#10;END' />
            </column>
            <column caption='mCVR2' datatype='real' name='[Calculation_254171966901649415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([list_and_menu_sessions])/SUM([list_sessions])' />
            </column>
            <column caption='mCVR3' datatype='real' name='[Calculation_254171966901723144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([menu_and_checkout_sessions])/SUM([menu_sessions])' />
            </column>
            <column caption='mCVR3a' datatype='real' name='[Calculation_254171966901833737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([menu_and_atc_sessions])/SUM([menu_sessions])' />
            </column>
            <column caption='mCVR3b' datatype='real' name='[Calculation_254171966901907466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([atc_and_checkout_sessions])/SUM([atc_sessions])' />
            </column>
            <column caption='mCVR4' datatype='real' name='[Calculation_254171966901985291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkout_and_transact_sessions])/SUM([checkout_sessions])' />
            </column>
            <column caption='% New Customers' datatype='real' name='[Calculation_3319715882001833987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_853080290247380992]) / SUM([num_of_customers])' />
            </column>
            <column caption='Total Existing Customers' datatype='integer' name='[Calculation_333266441085362176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[num_of_customers] - [Calculation_853080290247380992]' />
            </column>
            <column caption='% of Total Valid Orders' datatype='real' name='[Calculation_3514918829224706053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_orders])/SUM({FIXED [country_name],[report_date_local]:SUM([valid_orders])})' />
            </column>
            <column caption='Preorder %' datatype='real' name='[Calculation_3863173736620650496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([valid_orders]) - SUM([num_of_non_preorders])) / SUM([valid_orders])' />
            </column>
            <column caption='% Closed' datatype='real' default-format='p0.00%' name='[Calculation_418060773972127745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([closed_hours])/SUM([total_hours])' />
            </column>
            <column caption='% NC Orders w Voucher' datatype='real' name='[Calculation_509540080764792832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;CASE [vendor_type] WHEN &apos;pandamart&apos; THEN&#10;[orders_from_new_pandamart_customers_with_vouchers]&#10;WHEN &apos;shops&apos; THEN [orders_from_new_shops_customers_with_vouchers] END&#10;)&#10;/&#10;SUM(&#10;CASE [vendor_type] WHEN &apos;pandamart&apos; THEN&#10;([num_of_nc_pm_n2v] + [num_of_nc_pm_platform_n2p])&#10;WHEN &apos;shops&apos; THEN &#10;([num_of_nc_shops_n2v] + [num_of_nc_shops_platform_n2p]) END&#10;)' />
            </column>
            <column caption='Voucher Value Per Order' datatype='real' name='[Calculation_5773825839971024896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Euro&apos; THEN SUM([voucher_value_eur])/SUM([valid_orders])&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Local&apos; THEN SUM([voucher_value_local])/SUM([valid_orders])&#10;END' />
            </column>
            <column caption='Vendor Fail Rate (incl. Vendor Technical Failure)' datatype='real' name='[Calculation_58898640101056513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_fail])/SUM([num_of_orders])' />
            </column>
            <column caption='Customer Fail Rate' datatype='real' name='[Calculation_58898640101474307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_fail])/SUM([num_of_orders])' />
            </column>
            <column caption='Avg Basket Size - GMV' datatype='real' name='[Calculation_6320239186696458242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_254171966849855488])/SUM([valid_orders])' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_6320239186696593411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_time_non_preorder_mins])/sum([num_of_non_preorders])' />
            </column>
            <column caption='Avg Basket Size - Products ' datatype='real' name='[Calculation_6320239186698784772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_unique_product])/SUM([valid_orders])' />
            </column>
            <column caption='Avg Basket Size - Units' datatype='real' name='[Calculation_6320239186698997765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_quantity])/SUM([valid_orders])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_6320239186720763911]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([num_of_orders])' />
            </column>
            <column caption='% Voucher of GMV' datatype='real' name='[Calculation_6814861080460566531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voucher_value_eur]) / SUM([gmv_eur])' />
            </column>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_803259244545556481]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
            </column>
            <column caption='Total New Customers' datatype='integer' name='[Calculation_853080290247380992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [vendor_type] &#10;WHEN &apos;pandamart&apos;&#10;THEN [num_of_nc_pm_n2v] + [num_of_nc_pm_platform_n2p]&#10;WHEN &apos;shops&apos;&#10;THEN [num_of_nc_shops_n2v] + [num_of_nc_shops_platform_n2p]&#10;END' />
            </column>
            <column caption='Active Vendor' datatype='real' name='[Calculation_8847251163247329280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name],[report_date_local],[vendor_type] : avg([vendor_count_per_vendor_type])}' />
            </column>
            <column caption='Delivery &lt; 15 mins' datatype='real' name='[Calculation_967218450101059584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([deliveries_less_than_15_mins])/sum([num_of_non_preorders])' />
            </column>
            <column caption='Avg Basket Size - GFV' datatype='real' name='[Calculation_967218450116943873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV (copy)_254171966858235905])/sum([valid_orders])' />
            </column>
            <column caption='Country ' datatype='string' name='[Country (copy)_2211760058589491203]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country_name]' />
            </column>
            <column caption='Date-Gran ' datatype='string' name='[Date-Gran (copy)_3514918829220184064]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;day&apos; THEN&#10;STR(DATEPART(&apos;year&apos;,DATETRUNC(&apos;day&apos;,[report_date_local])))&#10;+ &apos;-&apos;&#10;+ STR(DATEPART(&apos;month&apos;,DATETRUNC(&apos;day&apos;,[report_date_local])))&#10;+ &apos;-&apos;&#10;+ STR(DATEPART(&apos;day&apos;,DATETRUNC(&apos;day&apos;,[report_date_local])))&#10;ELSEIF [Parameters].[Parameter 2] = &apos;month&apos;&#10;THEN&#10;STR(DATEPART(&apos;year&apos;,DATETRUNC(&apos;day&apos;,[report_date_local])))&#10;+ &apos;-&apos;&#10;+ STR(DATEPART(&apos;month&apos;,DATETRUNC(&apos;day&apos;,[report_date_local])))&#10;ELSE&#10;STR(DATEPART(&apos;iso-year&apos;,DATETRUNC(&apos;day&apos;,[report_date_local])))&#10;+ &apos;-&apos;&#10;+ STR(DATEPART(&apos;iso-week&apos;,DATETRUNC(&apos;iso-week&apos;,[report_date_local])))&#10;END' />
            </column>
            <column caption='Delivery &lt; 10 mins' datatype='real' default-format='p0%' name='[Delivery &gt; 30 mins (copy)_1280077847464747008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([deliveries_less_than_10_mins])/sum([num_of_non_preorders])' />
            </column>
            <column caption='Delivery &lt; 20 mins' datatype='real' default-format='p0%' name='[Delivery &gt; 30 mins (copy)_1280077847464861697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([deliveries_less_than_20_mins])/sum([num_of_non_preorders])' />
            </column>
            <column caption='Delivery Fee Per Order' datatype='real' name='[Delivery Fee Per Store (copy)_700872742603866112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_254171966893760518]) / SUM([valid_orders]) / COUNTD([Calculation_2052867440901128193])' />
            </column>
            <column caption='GMV (Voucher)' datatype='real' name='[GMV (Non-voucher) (copy)_254171966859681795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Euro&apos; THEN [gmv_eur_voucher_orders]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Local&apos; THEN [gmv_local_voucher_orders]&#10;END' />
            </column>
            <column caption='GFV (Non-voucher)' datatype='real' name='[GMV (Non-voucher) (copy)_254171966860001285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Euro&apos; THEN [gfv_eur] - [gfv_eur_voucher_orders]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Local&apos; THEN [gfv_local] - [gfv_local_voucher_orders]&#10;END' />
            </column>
            <column caption='GFV (Voucher)' datatype='real' name='[GMV (Voucher) (copy)_254171966859767812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Euro&apos; THEN [gfv_eur_voucher_orders]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Local&apos; THEN [gfv_local_voucher_orders]&#10;END' />
            </column>
            <column caption='GMV Net' datatype='real' default-format='c#,##0;(#,##0)' name='[GMV (copy)_1395975160654020608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Euro&apos; THEN [gmv_net_eur]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Local&apos; THEN [gmv_net_local]&#10;END' />
