              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Euro&apos; THEN [gmv_net_eur]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Local&apos; THEN [gmv_net_local]&#10;END' />
            </column>
            <column caption='GFV' datatype='real' name='[GMV (copy)_254171966858235905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Euro&apos; THEN [gfv_eur]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Local&apos; THEN [gfv_local]&#10;END' />
            </column>
            <column caption='GMV Net Per Store' datatype='real' name='[GMV Per Store (copy)_1395975160655147010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Euro&apos; THEN [gmv_net_per_store]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Local&apos; THEN [gmv_net_local_per_store]&#10;END' />
            </column>
            <column caption='Dmart Metric 3' datatype='real' name='[Metric 1 (copy)_108790131169210377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Metric 2 (copy)_108790131169173512]&#10;WHEN &apos;Gross Orders&apos; THEN SUM([num_of_orders])&#10;WHEN &apos;% of Platform Orders&apos; THEN [Calculation_3514918829224706053]&#10;WHEN &apos;Valid Orders&apos; THEN SUM([valid_orders])&#10;WHEN &apos;Orders Per Active Store Per Day&apos; THEN AVG([order_per_store])&#10;WHEN &apos;Preorder %&apos; THEN [Calculation_3863173736620650496]&#10;WHEN &apos;Failed Orders&apos; THEN SUM([failed_orders]) &#10;WHEN &apos;Fail Rate&apos; THEN [Calculation_6320239186720763911]&#10;WHEN &apos;Vendor Fail Rate&apos; THEN [Calculation_58898640101056513]&#10;WHEN &apos;Customer Fail Rate&apos; THEN [Calculation_58898640101474307]&#10;WHEN &apos;Total Customers&apos; THEN SUM([num_of_customers])&#10;WHEN &apos;Total Existing Customers&apos; THEN SUM([Calculation_333266441085362176])&#10;WHEN &apos;Total New Customers&apos; THEN SUM([Calculation_853080290247380992])&#10;WHEN &apos;New Customers to Vertical&apos; THEN SUM([num_of_nc_pm_n2v])&#10;WHEN &apos;New Customers to Platform&apos; THEN SUM([num_of_nc_pm_platform_n2p])&#10;WHEN &apos;% New Customers&apos; THEN [Calculation_3319715882001833987]&#10;WHEN &apos;GMV&apos; THEN SUM([Calculation_254171966849855488])&#10;WHEN &apos;GMV Net&apos; THEN SUM([GMV (copy)_1395975160654020608])&#10;WHEN &apos;GMV Per Active Store Per Day&apos; THEN AVG([Calculation_254171966858604546])&#10;WHEN &apos;GMV Net Per Active Store Per Day&apos; THEN AVG([GMV Per Store (copy)_1395975160655147010])&#10;WHEN &apos;GFV&apos; THEN SUM([GMV (copy)_254171966858235905])&#10;WHEN &apos;Avg Basket Size - GMV&apos; THEN [Calculation_6320239186696458242]&#10;WHEN &apos;Avg Basket Size - GFV&apos; THEN [Calculation_967218450116943873]&#10;WHEN &apos;Avg Basket Size - Products&apos; THEN [Calculation_6320239186698784772]&#10;WHEN &apos;Avg Basket Size - Units&apos; THEN [Calculation_6320239186698997765]&#10;WHEN &apos;% Voucher of GMV&apos; THEN [Calculation_6814861080460566531]&#10;WHEN &apos;% Voucher of GFV&apos; THEN [Calculation_2041115797208952833]&#10;WHEN &apos;% Orders with Vouchers&apos; THEN [Calculation_189221559184879616]&#10;WHEN &apos;Voucher Value Per Order&apos; THEN [Calculation_5773825839971024896]&#10;WHEN &apos;Avg Basket Size - GMV (Non-voucher)&apos; THEN [Avg. Order Value (Voucher) (copy)_1404771287101726726]&#10;WHEN &apos;Avg Basket Size - GMV (Voucher)&apos; THEN [ABV (Vouchered Orders) (copy)_1404771287100366849]&#10;WHEN &apos;Avg Basket Size - GFV (Non-voucher)&apos; THEN [Avg Basket Value (Voucher) (copy)_1404771287101366276]&#10;WHEN &apos;Avg Basket Size - GFV (Voucher)&apos; THEN [Calculation_1404771287100080128]&#10;WHEN &apos;% NC Orders w Voucher&apos; THEN [Calculation_509540080764792832]&#10;WHEN &apos;Delivery Fee&apos; THEN SUM([Calculation_254171966893760518])&#10;WHEN &apos;Delivery Fee Per Order&apos; THEN [Delivery Fee Per Store (copy)_700872742603866112]&#10;WHEN &apos;Delivery Fee Per Store Per Day&apos; THEN AVG([Order Per Day Per Store (Updated) (copy)_6814861080459087873])&#10;WHEN &apos;Avg Delivery Time&apos; THEN [Calculation_6320239186696593411]&#10;WHEN &apos;Delivery &lt; 10 mins&apos; THEN [Delivery &gt; 30 mins (copy)_1280077847464747008]&#10;WHEN &apos;Delivery &lt; 15 mins&apos; THEN [Calculation_967218450101059584]&#10;WHEN &apos;Delivery &lt; 20 mins&apos; THEN [Delivery &gt; 30 mins (copy)_1280077847464861697]&#10;WHEN &apos;Delivery &gt; 30 mins&apos; THEN [Calculation_159737109277237248]&#10;WHEN &apos;% Closed&apos; THEN [Calculation_418060773972127745]&#10;WHEN &apos;Menu Sessions&apos; THEN SUM([menu_sessions])&#10;WHEN &apos;mCVR2&apos; THEN [Calculation_254171966901649415]&#10;WHEN &apos;mCVR3&apos; THEN [Calculation_254171966901723144]&#10;WHEN &apos;mCVR3a&apos; THEN [Calculation_254171966901833737]&#10;WHEN &apos;mCVR3b&apos; THEN [Calculation_254171966901907466]&#10;WHEN &apos;mCVR4&apos; THEN [Calculation_254171966901985291]&#10;END' />
            </column>
            <column caption='Delivery Fee Per Store' datatype='real' name='[Order Per Day Per Store (Updated) (copy)_6814861080459087873]' role='measure' type='quantitative'>
