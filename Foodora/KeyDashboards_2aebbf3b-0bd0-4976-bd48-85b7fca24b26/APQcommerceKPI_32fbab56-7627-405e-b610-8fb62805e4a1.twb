    <worksheet name='Qcomm Quarterly'>
      <layout-options>
        <title>
          <formatted-text>
            <run>QC Quarterly KPIs&#10;</run>
            <run fontsize='10' italic='true'>(Note: To see breakdown by pandamart vendors, hover over Country Name and click on &apos;+&apos;. </run>
            <run>Æ&#10;</run>
            <run fontsize='10' italic='true'>Inaccurate new /existing customer figures from Dec 2021 - issue pending resolution by APAC data team</run>
            <run>Æ&#10;</run>
            <run fontsize='10' italic='true'>Customer metrics are aggregated on vendor level for pandamart. i.e. </run>
            <run fontcolor='#1d1c1d' fontsize='10' italic='true'>if customer shops from &gt; 1 pandamart, it will be counted more than once on country level.)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__kpi_monthly_dashboard (quarterly)' name='federated.05mnfha01jq8gx160djn916jgcuv (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.05mnfha01jq8gx160djn916jgcuv (copy)'>
            <column caption='% Total GMV Net' datatype='real' default-format='p0.00%' name='[% Total GMV (copy)_1395975160658411524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_net_eur])/sum({FIXED [country_name],[month_local]:sum([gmv_net_eur])})' />
            </column>
            <column caption='% Total GMV' datatype='real' name='[%_of_total_orders (copy)_7169167701252616192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur])/sum({FIXED [country_name],[month_local]:sum([gmv_eur])})' />
            </column>
            <column caption='Avg Basket Size - GFV (€) (Voucher) ' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Avg Basket Size (Voucher) (copy)_3975763724382658561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gfv_eur_voucher_orders])/sum([num_of_orders_w_vouchers])' />
            </column>
            <column caption='Avg Basket Size - GFV (€) (Non Voucher) ' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Avg Basket Size - GFV (Voucher)  (copy)_3975763724383162373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV (Non voucher) (copy)_3975763724382793731])/sum([GFV (Non voucher) (copy)_3975763724382896132])' />
            </column>
            <column caption='Avg Basket Size - GMV (€) (Non Voucher)' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Avg Basket Size - GMV (Voucher) (copy)_3975763724383256582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_3975763724382691330])/sum([GFV (Non voucher) (copy)_3975763724382896132])' />
            </column>
            <column caption='Total Customers' datatype='integer' hidden='true' name='[Calculation_1184165253833183232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[num_of_customers]' />
            </column>
            <column caption='Delivery &gt; 30 mins' datatype='real' name='[Calculation_159737109277237248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([deliveries_more_than_30_mins])/sum([num_of_non_preorders])' />
            </column>
            <column caption='% Orders with Vouchers' datatype='real' name='[Calculation_189221559184879616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_orders_w_vouchers])/sum([valid_orders])' />
            </column>
            <column caption='Voucher % Of GFV' datatype='real' name='[Calculation_2041115797208952833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([voucher_value_eur])/sum([gfv_eur])' />
            </column>
            <column caption='Total Customers Quarterly' datatype='real' name='[Calculation_235383468699992066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [country_name],[quarter_local],[vendor_type],[vendor_code]:AVG([num_of_customers_quarterly])})' />
            </column>
            <column caption='Avg Order/Store/Day Quarterly' datatype='real' name='[Calculation_235383468702707716]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([order_per_store_quarterly])' />
            </column>
            <column caption='Existing Customers Orders' datatype='integer' name='[Calculation_3319715882009714692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_from_existing_customers_pm])&#10;+&#10;sum([orders_from_existing_customers_sh])' />
            </column>
            <column caption='% Total Orders' datatype='real' name='[Calculation_3514918829224706053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([valid_orders])/sum({FIXED [country_name],[month_local]:sum([valid_orders])})' />
            </column>
            <column caption='Preorder %' datatype='real' name='[Calculation_3863173736620650496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([valid_orders]) - sum([num_of_non_preorders])) /sum([valid_orders])' />
            </column>
            <column caption='Avg Basket Size - GMV (€) (Voucher)' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_3975763724382478336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur_voucher_orders])/sum([num_of_orders_w_vouchers])' />
            </column>
            <column caption='GMV (Non voucher)' datatype='real' hidden='true' name='[Calculation_3975763724382691330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv_eur]-[gmv_eur_voucher_orders]' />
            </column>
            <column caption='voucher_per_order' datatype='real' name='[Calculation_5773825839971024896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([voucher_value_eur])/sum([valid_orders])' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_58898640101056513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_fail])/sum([num_of_orders])' />
            </column>
            <column caption='Customer Fail Rate' datatype='real' name='[Calculation_58898640101474307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customer_fail])/sum([num_of_orders])' />
            </column>
            <column caption='% Partially Fulfilled Orders' datatype='real' name='[Calculation_6140165557986004992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_partially_fulfilled_orders])/sum([valid_orders])' />
            </column>
            <column caption='Avg Basket Size - GMV (€)' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_6320239186696458242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur])/sum([valid_orders])' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' name='[Calculation_6320239186696593411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_time])/sum([num_of_non_preorders])' />
            </column>
            <column caption='Avg Basket Size - Products ' datatype='real' name='[Calculation_6320239186698784772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_unique_product])/sum([valid_orders])' />
            </column>
            <column caption='Avg Basket Size - Units' datatype='real' name='[Calculation_6320239186698997765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_quantity])/SUM([valid_orders])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_6320239186720763911]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders])/sum([num_of_orders])' />
            </column>
            <column caption='% NC Orders' datatype='real' name='[Calculation_6341138653890166786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_853080290247380992]) /&#10;sum([valid_orders])' />
            </column>
            <column caption='Order Frequency' datatype='real' name='[Calculation_8018236947336515584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([valid_orders])/sum([Calculation_1184165253833183232])' />
            </column>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_803259244546269186]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
            </column>
            <column caption='Total New Customers' datatype='integer' name='[Calculation_853080290247380992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [vendor_type] WHEN &apos;pandamart&apos;&#10;THEN [num_of_nc_pm_n2v] + [num_of_nc_pm_platform_n2p]&#10;WHEN &apos;shops&apos;&#10;THEN [num_of_nc_shops_n2v] + [num_of_nc_shops_platform_n2p]&#10;END' />
            </column>
            <column caption='Delivery &lt; 15 mins' datatype='real' name='[Calculation_967218450101059584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([deliveries_less_than_15_mins])/sum([num_of_non_preorders])' />
            </column>
            <column caption='Avg Basket Size - GFV (€)' datatype='real' default-format='c&quot;€&quot;#,##0.0;(&quot;€&quot;#,##0.0)' name='[Calculation_967218450116943873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gfv_eur])/sum([valid_orders])' />
            </column>
            <column caption='Existing Customers Quarterly' datatype='real' name='[Existing Customers (copy)_235383468698718208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [country_name],[quarter_local],[vendor_type],[vendor_code]:AVG([num_of_customers_quarterly])})&#10;-sum([Calculation_853080290247380992])' />
            </column>
            <column caption='Orders (Non voucher)' datatype='integer' hidden='true' name='[GFV (Non voucher) (copy)_3975763724382896132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[valid_orders]-[num_of_orders_w_vouchers]' />
            </column>
            <column caption='GFV (Non voucher)' datatype='real' hidden='true' name='[GMV (Non voucher) (copy)_3975763724382793731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gfv_eur]-[gfv_eur_voucher_orders]' />
            </column>
            <column caption='Avg Quarterly Orders Per Customer' datatype='real' name='[Total Customers (copy)_1184165253833433089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([valid_orders]) / SUM({FIXED [country_name],[quarter_local],[vendor_type],[vendor_code]:AVG([num_of_customers_quarterly])})' />
            </column>
            <column caption='% NC Orders w Vouchers' datatype='real' name='[Total New Customers (copy)_6341138653889163265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;CASE [vendor_type] WHEN &apos;pandamart&apos; THEN&#10;[orders_from_new_pandamart_customers_with_vouchers]&#10;WHEN &apos;shops&apos; THEN [orders_from_new_shops_customers_with_vouchers] END&#10;)&#10;/&#10;SUM(&#10;CASE [vendor_type] WHEN &apos;pandamart&apos; THEN&#10;([num_of_nc_pm_n2v] + [num_of_nc_pm_platform_n2p])&#10;WHEN &apos;shops&apos; THEN &#10;([num_of_nc_shops_n2v] + [num_of_nc_shops_platform_n2p]) END&#10;)' />
            </column>
            <column caption='Total New Customers to Platform' datatype='integer' name='[Total New Customers (copy)_853080290247749633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [vendor_type] WHEN &apos;pandamart&apos;&#10;THEN [num_of_nc_pm_platform_n2p]&#10;WHEN &apos;shops&apos;&#10;THEN [num_of_nc_shops_platform_n2p]&#10;END' />
            </column>
            <column caption='Total New Customers (to Vertical)' datatype='integer' name='[Total New Customers (copy)_853080290247839746]' role='measure' type='quantitative'>
