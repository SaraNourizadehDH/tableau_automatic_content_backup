            </column>
            <column caption='Week' datatype='string' name='[Date (copy)_1119566786243088386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;,DATETRUNC(&apos;day&apos;,[report_date_local],&apos;Monday&apos;)))&#10;+ &apos;-&apos;&#10;+ STR(DATEPART(&apos;week&apos;,DATETRUNC(&apos;day&apos;,[report_date_local],&apos;Monday&apos;)))' />
