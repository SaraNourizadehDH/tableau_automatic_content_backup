            <column caption='mCVR4' datatype='real' name='[Calculation_254171966901985291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkout_and_transact_sessions])/SUM([checkout_sessions])' />
            </column>
            <column caption='Global Entity ID Dmart set' datatype='boolean' name='[Calculation_2700963558609375233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id] = &apos;FP_BD&apos;&#10;OR [global_entity_id] = &apos;FP_HK&apos;&#10;OR [global_entity_id] = &apos;FP_MY&apos;&#10;OR [global_entity_id] = &apos;FP_PH&apos;&#10;OR [global_entity_id] = &apos;FP_PK&apos;&#10;OR [global_entity_id] = &apos;FP_SG&apos;' />
            </column>
            <column caption='% New Customers' datatype='real' name='[Calculation_3319715882001833987]' role='measure' type='quantitative'>
