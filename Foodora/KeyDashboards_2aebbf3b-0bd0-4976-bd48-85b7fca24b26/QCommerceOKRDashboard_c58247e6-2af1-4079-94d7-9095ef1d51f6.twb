      <column caption='6. [Formatting] Healthy QC NTV Customers' datatype='string' name='[Calculation_1216464540346331138]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([num_of_healthy_qc_ntv_customers_diff]) &lt; 0 THEN &apos;Below Target&apos;&#10;ELSEIF SUM([num_of_healthy_qc_ntv_customers_diff]) &gt;= 0 THEN &apos;Meets Target&apos;&#10;ELSEIF ISNULL(SUM([num_of_healthy_qc_ntv_customers_diff])) THEN &apos;No Target&apos;&#10;END' />
      </column>
      <column caption='[Dmart Deviation] AQS' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%' name='[Calculation_2066096759676473346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[dmart_aqs_diff] / [dmart_aqs_target]' />
      </column>
      <column caption='Display View' datatype='string' name='[Calculation_2066096759749357580]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='IF ZN(SUM([3. [Actual]] Dmart On Time %])) - LOOKUP(ZN(SUM([3...' datatype='string' name='[Calculation_3022126523730305032]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ZN(SUM([1. [Actual]] On Time % (copy)_3022126523729309701])) - LOOKUP(ZN(SUM([1. [Actual]] On Time % (copy)_3022126523729309701])), -1) &lt; 0 THEN &apos;Decrease&apos; ELSEIF ZN(SUM([1. [Actual]] On Time % (copy)_3022126523729309701])) - LOOKUP(ZN(SUM([1. [Actual]] On Time % (copy)_3022126523729309701])), -1) &gt;= 0 THEN &apos;Increase&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Max Date' datatype='date' name='[Calculation_3256946959023554560]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [date_period]: MAX([date_value])}' />
      </column>
      <column caption='Reference Date' datatype='date' name='[Calculation_3256946959057907713]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF NOW() &lt; MAKEDATETIME(TODAY(), #14:00:00#) &#10;THEN TODAY()-2&#10;ELSE TODAY()-1 &#10;END' />
