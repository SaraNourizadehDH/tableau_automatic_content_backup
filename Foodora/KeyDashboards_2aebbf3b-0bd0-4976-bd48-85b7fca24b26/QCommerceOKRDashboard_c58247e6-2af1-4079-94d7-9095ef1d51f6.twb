      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__okr_dashboard (sandbox_qcommerce)' name='federated.1oy58fq084ey6m1gn11g61fzhok2' />
          </datasources>
          <datasource-dependencies datasource='federated.1oy58fq084ey6m1gn11g61fzhok2'>
            <column caption='3. [Actual] Dmart On Time %' datatype='real' name='[1. [Actual]] On Time % (copy)_3022126523729309701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vendor_type] = &quot;pandamart&quot; &#10;THEN [perc_on_time_orders]&#10;ELSE NULL END' />
            </column>
            <column caption='2. [Actual] Dmart On Time Orders' datatype='integer' name='[Calculation_90986852793647147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;    [vendor_type] = &quot;pandamart&quot; &#10;THEN &#10;    [gross_order_platform]&#10;        - [num_of_order_delay_more_than_5min_platform] &#10;        - [num_of_order_delay_less_than_minus_15min_platform]&#10;END' />
            </column>
            <column caption='1. [Actual] Dmart Gross Orders' datatype='integer' name='[[Actual]] Dmart On Time Orders (copy)_90986852899860527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vendor_type] = &quot;pandamart&quot; THEN [gross_order_platform] END' />
            </column>
            <column caption='[Formatting] Dmart On Time %' datatype='string' name='[[Formatting]] On Time % (copy)_5144447790803873792]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    [dmart_perc_on_time_orders_platform_diff] &lt; 0 &#10;THEN &apos;Below Target&apos;&#10;ELSEIF &#10;    [dmart_perc_on_time_orders_platform_diff] &gt;= 0 &#10;THEN &apos;Meets Target&apos;&#10;ELSEIF &#10;    ISNULL([dmart_perc_on_time_orders_platform_diff]) &#10;THEN &apos;No Target&apos;&#10;END' />
            </column>
            <column caption='Date Period' datatype='string' name='[date_period]' role='dimension' type='nominal' />
            <column caption='Date Value' datatype='date' name='[date_value]' role='dimension' type='ordinal' />
            <column-instance column='[1. [Actual]] On Time % (copy)_3022126523729309701]' derivation='Sum' name='[diff:sum:1. [Actual]] On Time % (copy)_3022126523729309701:qk]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='Difference'>
                <address>
                  <value>-1</value>
                </address>
              </table-calc>
            </column-instance>
            <column caption='4. [Target] Dmart On Time %' datatype='real' name='[dmart_on_time_target]' role='measure' type='quantitative' />
            <column caption='5. [Actual vs Target] Dmart On Time %' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%' name='[dmart_perc_on_time_orders_platform_diff]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[global_entity_id]' role='dimension' type='nominal'>
