            <zone fixed-size='80' h='2857' id='115' is-fixed='true' param='horz' type-v2='layout-flow' w='98934' x='533' y='286'>
              <zone fixed-size='92' h='2857' id='116' is-fixed='true' is-scaled='1' param='Image/foodpanda_app icon-RGB.jpg' type-v2='bitmap' w='6666' x='533' y='286'>
