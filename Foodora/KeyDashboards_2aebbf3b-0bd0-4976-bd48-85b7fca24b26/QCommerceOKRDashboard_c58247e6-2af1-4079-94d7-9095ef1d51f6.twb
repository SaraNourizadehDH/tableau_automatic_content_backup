                <formatted-text>
                  <run fontcolor='#000000' fontname='Tableau Medium' fontsize='8' underline='true'>Table Legend</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='8'>Dmart Assortment Quality Score</run>
                  <run fontcolor='#000000' fontsize='8'>, </run>
                  <run bold='true' fontcolor='#000000' fontsize='8'>Weighted Availability %</run>
                  <run fontcolor='#000000' fontsize='8'> &amp; </run>
                  <run bold='true' fontcolor='#000000' fontsize='8'>On Time %</run>
                  <run fontcolor='#000000' fontsize='8'> Tables: </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#8eb21b' fontsize='8'>■</run>
                  <run fontcolor='#000000' fontsize='8'> Meets Target     </run>
                  <run fontcolor='#d03c53' fontsize='8'>■</run>
                  <run fontcolor='#000000' fontsize='8'> Below Target     </run>
                  <run fontcolor='#6b6b6b' fontsize='8'>■</run>
                  <run fontcolor='#d03c53' fontsize='8'>Æ </run>
                  <run fontcolor='#000000' fontsize='8'>No Target</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>Remaining Tables: </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#8eb21b' fontsize='8'>■</run>
