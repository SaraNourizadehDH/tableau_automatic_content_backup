              <zone fixed-size='1392' forceUpdate='true' h='2857' id='41' is-fixed='true' type-v2='text' w='92268' x='7199' y='286'>
                <formatted-text>
                  <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Bold' fontsize='16'>Shops OKR Overview</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
