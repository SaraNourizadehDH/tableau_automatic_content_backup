            <zone fixed-size='57' forceUpdate='true' h='2500' id='198' is-fixed='true' type-v2='text' w='98934' x='533' y='10616'>
              <formatted-text>
                <run fontcolor='#000000' fontsize='8'>The following tables show the </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>Actuals vs Target</run>
                <run fontcolor='#000000' fontsize='8'> (if applicable), </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>MoM Percentage Change</run>
                <run fontcolor='#000000' fontsize='8'>Æ </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>or</run>
                <run fontcolor='#000000' fontsize='8'>Æ </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>Percent Point Change in Actuals</run>
                <run fontcolor='#000000' fontsize='8'>, and the </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>Percentage </run>
                <run fontcolor='#000000' fontsize='8'>or</run>
                <run bold='true' fontcolor='#000000' fontsize='8'> Percent Point Deviation from Target</run>
                <run fontcolor='#000000' fontsize='8'> over the </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>last 6 months</run>
                <run fontcolor='#000000' fontsize='8'> (</run>
                <run fontcolor='#000000' fontsize='8' italic='true'>inclusive of the current month</run>
                <run fontcolor='#000000' fontsize='8'>). </run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000' fontsize='8'>For a longer lookback period (beginning from </run>
                <run fontcolor='#000000' fontsize='8' italic='true'>Jan 23</run>
                <run fontcolor='#000000' fontsize='8'> onwards), use the &apos;</run>
                <run bold='true' fontcolor='#000000' fontsize='8'>Date Filter</run>
                <run fontcolor='#000000' fontsize='8'>&apos; to filter accordingly. </run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
