            <zone fixed-size='32' forceUpdate='true' h='1539' id='380' is-fixed='true' type-v2='text' w='98934' x='533' y='75658'>
              <formatted-text>
                <run bold='true' fontcolor='#ed4183' fontname='Tableau Light' fontsize='10'>⚠</run>
                <run fontcolor='#1f1f1f' fontname='Tableau Light' fontsize='8'>Æ </run>
                <run bold='true' fontcolor='#1f1f1f' fontname='Tableau Light' fontsize='8'>QC MAU Coverage</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> is defined as </run>
                <run bold='true' fontcolor='#1f1f1f' fontname='Tableau Light' fontsize='8'>QC MAUs / Total MAUs</run>
                <run fontcolor='#1f1f1f' fontname='Tableau Light' fontsize='8'>.</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> It is selected by Central ABC as a </run>
                <run bold='true' fontcolor='#ed4183' fontname='Tableau Light' fontsize='8'>KPI</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> for Q-Commerce on APAC level.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='padding' value='4' />
                <format attr='background-color' value='#f0eae8' />
              </zone-style>
            </zone>
            <zone fixed-size='350' friendly-name='QC MAU Coverage' h='13462' id='375' is-fixed='true' param='horz' type-v2='layout-flow' w='98934' x='533' y='77197'>
              <zone h='13462' id='373' name='9 | Q-Commerce MAU Coverage' show-title='false' w='98934' x='533' y='77197'>
                <layout-cache cell-count-h='12' fixed-size-w='3297' non-cell-size-h='40' type-h='cell' type-w='fixed' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone fixed-size='57' forceUpdate='true' h='2500' id='192' is-fixed='true' type-v2='text' w='98934' x='533' y='90659'>
              <formatted-text>
                <run fontcolor='#000000' fontsize='8'>The following section shows the </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>country that</run>
                <run fontcolor='#000000' fontsize='8'>Æ </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>outperforms</run>
                <run fontcolor='#000000' fontsize='8'>Æ </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>the target</run>
                <run fontcolor='#000000' fontsize='8'>Æ </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>by the most</run>
                <run fontcolor='#000000' fontsize='8'> and the country that underperforms and deviates the most from the target. The numbers either represent the </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>percentage deviation of actual vs target</run>
                <run fontcolor='#000000' fontsize='8'> for </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>absolute metrics</run>
                <run fontcolor='#000000' fontsize='8'> or the </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>percentage point deviation</run>
                <run fontcolor='#000000' fontsize='8'> for </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>percentage metrics</run>
                <run fontcolor='#000000' fontsize='8'> in the </run>
                <run bold='true' fontcolor='#000000' fontsize='8'>previous month</run>
                <run fontcolor='#000000' fontsize='8'>. </run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
