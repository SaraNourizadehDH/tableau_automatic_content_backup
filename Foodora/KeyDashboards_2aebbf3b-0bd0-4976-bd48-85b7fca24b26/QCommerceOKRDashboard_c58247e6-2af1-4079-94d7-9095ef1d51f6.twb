            <zone fixed-size='32' forceUpdate='true' h='1539' id='377' is-fixed='true' type-v2='text' w='98934' x='533' y='30655'>
              <formatted-text>
                <run bold='true' fontcolor='#ed4183' fontname='Tableau Light' fontsize='10'>⚠</run>
                <run fontcolor='#1f1f1f' fontname='Tableau Light' fontsize='8'>Æ </run>
                <run bold='true' fontcolor='#333333' fontname='Tableau Light' fontsize='8'>QC Weekly Shoppers</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> is defined as </run>
                <run bold='true' fontcolor='#333333' fontname='Tableau Light' fontsize='8'>Customers with 3+ grocery orders per month</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'>, selected by the </run>
                <run bold='true' fontcolor='#ed4183' fontname='Tableau Light' fontsize='8'>APAC</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> team as a </run>
                <run bold='true' fontcolor='#ed4183' fontname='Tableau Light' fontsize='8'>KPI</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> for all APAC countries.</run>
