            <zone fixed-size='32' forceUpdate='true' h='1539' id='378' is-fixed='true' type-v2='text' w='98934' x='533' y='45656'>
              <formatted-text>
                <run bold='true' fontcolor='#ed4183' fontname='Tableau Light' fontsize='10'>⚠</run>
                <run fontcolor='#1f1f1f' fontname='Tableau Light' fontsize='8'>Æ </run>
                <run bold='true' fontcolor='#333333' fontname='Tableau Light' fontsize='8'>Healthy QC NTV</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> is defined as the </run>
                <run bold='true' fontcolor='#333333' fontname='Tableau Light' fontsize='8'>number of New-To-Verticals (NTV) customers that make &gt;= 3 orders (inclusive of first order) across any Q-Commerce (QC) vertical within first 60 days</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'>. It is selected as part of the </run>
                <run bold='true' fontcolor='#ed4183' fontname='Tableau Light' fontsize='8'>Country Strategy</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> and is a </run>
                <run bold='true' fontcolor='#ed4183' fontname='Tableau Light' fontsize='8'>Top OKR</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> for BD and PK.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='padding' value='4' />
                <format attr='background-color' value='#f0eae8' />
              </zone-style>
            </zone>
            <zone fixed-size='350' friendly-name='QC Healthy QC NTV' h='13462' id='284' is-fixed='true' param='horz' type-v2='layout-flow' w='98934' x='533' y='47195'>
              <zone fixed-size='1092' h='13462' id='285' is-fixed='true' name='1 | Q-Commerce Healthy New-To-Vertical Customers' show-title='false' w='73333' x='533' y='47195'>
                <layout-cache cell-count-h='12' non-cell-size-h='40' type-h='cell' type-w='fixed' />
