            <zone fixed-size='32' forceUpdate='true' h='1739' id='374' is-fixed='true' type-v2='text' w='98934' x='533' y='60608'>
              <formatted-text>
                <run bold='true' fontcolor='#ed4183' fontname='Tableau Light' fontsize='10'>⚠</run>
                <run fontcolor='#1f1f1f' fontname='Tableau Light' fontsize='8'>Æ </run>
                <run bold='true' fontcolor='#333333' fontname='Tableau Light' fontsize='8'>Assortment Quality Score</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> is a </run>
                <run bold='true' fontcolor='#333333' fontname='Tableau Light' fontsize='8'>composite score computed by Central using multiple metrics with varying weightage</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'>. It is selected as part of </run>
                <run bold='true' fontcolor='#ed4183' fontname='Tableau Light' fontsize='8'>Country Strategy</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'>, and is a </run>
                <run bold='true' fontcolor='#ed4183' fontname='Tableau Light' fontsize='8'>KPI</run>
                <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> for all APAC countries.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='padding' value='4' />
                <format attr='background-color' value='#f0eae8' />
              </zone-style>
            </zone>
            <zone fixed-size='320' friendly-name='Dmart AQS' h='13913' id='132' is-fixed='true' param='horz' type-v2='layout-flow' w='98934' x='533' y='62347'>
              <zone fixed-size='992' h='13913' id='133' is-fixed='true' name='5 | Dmart AQS' show-title='false' w='65601' x='533' y='62347'>
                <layout-cache cell-count-h='9' non-cell-size-h='40' type-h='cell' type-w='fixed' />
                <zone-style>
