            <zone fixed-size='80' friendly-name='Header' h='3478' id='115' is-fixed='true' param='horz' type-v2='layout-flow' w='98934' x='533' y='348'>
              <zone fixed-size='92' h='3478' id='116' is-fixed='true' is-scaled='1' param='Image/foodpanda_app icon-RGB.jpg' type-v2='bitmap' w='6666' x='533' y='348'>
                <zone-style>
