              <zone fixed-size='492' h='13913' id='95' is-fixed='true' name='6 | Dmart Weighted Availability % Chart' w='33333' x='66134' y='77999'>
                <layout-cache minheight='151' type-h='scalable' type-w='cell' />
                <zone-style>
