                <zone fixed-size='32' forceUpdate='true' h='1429' id='386' type-v2='text' w='98934' x='533' y='72106'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ed4183' fontname='Tableau Light' fontsize='10'>⚠</run>
                    <run fontcolor='#1f1f1f' fontname='Tableau Light' fontsize='8'>Æ </run>
                    <run bold='true' fontcolor='#1f1f1f' fontname='Tableau Light' fontsize='8'>% items not delivered for SA supermarkets</run>
                    <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> is defined as </run>
                    <run bold='true' fontcolor='#333333' fontname='Tableau Light' fontsize='8'>(Ordered Quantity - Sent Quantity) / Ordered Quantity</run>
                    <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'>. It is selected by </run>
