                <zone fixed-size='57' forceUpdate='true' h='2500' id='192' type-v2='text' w='98934' x='533' y='90659'>
                  <formatted-text>
                    <run fontcolor='#000000' fontsize='8'>The following section shows the </run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>country that</run>
                    <run fontcolor='#000000' fontsize='8'>Æ </run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>outperforms</run>
                    <run fontcolor='#000000' fontsize='8'>Æ </run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>the target</run>
                    <run fontcolor='#000000' fontsize='8'>Æ </run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>by the most</run>
                    <run fontcolor='#000000' fontsize='8'> and the country that underperforms and deviates the most from the target. The numbers either represent the </run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>percentage deviation of actual vs target</run>
                    <run fontcolor='#000000' fontsize='8'> for </run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>absolute metrics</run>
                    <run fontcolor='#000000' fontsize='8'> or the </run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>percentage point deviation</run>
                    <run fontcolor='#000000' fontsize='8'> for </run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>percentage metrics</run>
                    <run fontcolor='#000000' fontsize='8'> in the </run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>previous month</run>
                    <run fontcolor='#000000' fontsize='8'>. </run>
                  </formatted-text>
