    <worksheet name='2 | Shops vs Q-Commerce MoM % ▲ in 30 Day Adjusted GMV'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>&lt;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>[federated.1oy58fq084ey6m1gn11g61fzhok2].[none:global_entity_id:nk]</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='7'>Benchmark Shops </run>
            <run bold='true' fontalignment='1' fontsize='7' italic='true'>(bar)</run>
            <run bold='true' fontalignment='1' fontsize='7'> MoM % Change in Net GMV against Q-Commerce </run>
            <run bold='true' fontalignment='1' fontsize='7' italic='true'>(line)</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='7'>MoM % ▲ in 30 Day Adjusted Shops Net GMV </run>
            <run fontalignment='1' fontcolor='#555555' fontsize='7'>←</run>
            <run fontalignment='1' fontsize='7'>Æ </run>
            <run fontalignment='1' fontcolor='#555555' fontsize='7' italic='true'>How many % of the change in QC GMV is caused by Shops?</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__okr_dashboard (sandbox_qcommerce)' name='federated.1oy58fq084ey6m1gn11g61fzhok2' />
          </datasources>
          <datasource-dependencies datasource='federated.1oy58fq084ey6m1gn11g61fzhok2'>
            <column caption='Reference Date' datatype='date' name='[Calculation_3256946959057907713]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF NOW() &lt; MAKEDATETIME(TODAY(), #14:00:00#) &#10;THEN TODAY()-2&#10;ELSE TODAY()-1 &#10;END' />
            </column>
            <column caption='6b. [Actual Adj] 30D Adj Dmart Net GMV (€)' datatype='real' default-format='c&quot;€&quot;#,##0,,.00M;-&quot;€&quot;#,##0,,.00M' name='[Calculation_45880486373609483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vendor_type] = &quot;pandamart&quot; &#10;THEN [Calculation_5479825279424167937] * 30&#10;ELSE 0 &#10;END' />
            </column>
            <column caption='No. of Days in Month' datatype='integer' name='[Calculation_5479825279421440000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/* Calculates the no. of days in a given month */ &#10;/* Only applicable for Date Type that is &apos;Month&apos; */ &#10;/* Purpose is to calculate 30 Day Adjusted metrics */ &#10;&#10;IF &#10;    [date_period] = &apos;Month&apos; AND DATETRUNC(&apos;month&apos;, TODAY()) &lt;&gt; [date_value]&#10;THEN&#10;    DATEDIFF(&apos;day&apos;, [date_value], DATEADD(&apos;month&apos;, 1, [date_value]))&#10;&#10;ELSEIF&#10;    [date_period] = &apos;Month&apos; AND DATETRUNC(&apos;month&apos;, TODAY()) = [date_value]&#10;THEN&#10;    DATEDIFF(&apos;day&apos;, [date_value], [Calculation_3256946959057907713]+1)&#10;&#10;END' />
            </column>
            <column caption='5a. [Actual Adj] Daily Average Net GMV (€)' datatype='real' name='[Calculation_5479825279424167937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv_net_eur] / &#10;[Calculation_5479825279421440000]' />
            </column>
            <column caption='6a. [Actual Adj] 30D Adj Q-Commerce Net GMV (€)' datatype='real' name='[Calculation_5479825279468851202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vendor_type] = &quot;QCommerce&quot; &#10;THEN [Calculation_5479825279424167937] * 30&#10;ELSE 0 &#10;END' />
            </column>
            <column caption='IF (ZN(SUM([6c. [Actual Adj]] 30D Adj Shops Net GMV (€)])) - ...' datatype='string' name='[Calculation_90986852745617433]' role='measure' type='nominal' user:unnamed='2 | Shops vs Q-Commerce MoM % ▲ in 30 Day Adjusted GMV'>
              <calculation class='tableau' formula='IF (ZN(SUM([[Actual Adj]] 30 Day Adjusted Dmart GMV (copy)_90986852705890316])) - LOOKUP(ZN(SUM([[Actual Adj]] 30 Day Adjusted Dmart GMV (copy)_90986852705890316])), -1)) / ABS(LOOKUP(ZN(SUM([[Actual Adj]] 30 Day Adjusted Dmart GMV (copy)_90986852705890316])), -1)) &lt; 0 THEN &apos;Decrease&apos; ELSEIF (ZN(SUM([[Actual Adj]] 30 Day Adjusted Dmart GMV (copy)_90986852705890316])) - LOOKUP(ZN(SUM([[Actual Adj]] 30 Day Adjusted Dmart GMV (copy)_90986852705890316])), -1)) / ABS(LOOKUP(ZN(SUM([[Actual Adj]] 30 Day Adjusted Dmart GMV (copy)_90986852705890316])), -1)) &gt; 0 THEN &apos;Increase&apos; ELSEIF (ZN(SUM([[Actual Adj]] 30 Day Adjusted Dmart GMV (copy)_90986852705890316])) - LOOKUP(ZN(SUM([[Actual Adj]] 30 Day Adjusted Dmart GMV (copy)_90986852705890316])), -1)) / ABS(LOOKUP(ZN(SUM([[Actual Adj]] 30 Day Adjusted Dmart GMV (copy)_90986852705890316])), -1)) = 0 THEN &apos;No Change&apos; ELSEIF ISNULL((ZN(SUM([[Actual Adj]] 30 Day Adjusted Dmart GMV (copy)_90986852705890316])) - LOOKUP(ZN(SUM([[Actual Adj]] 30 Day Adjusted Dmart GMV (copy)_90986852705890316])), -1)) / ABS(LOOKUP(ZN(SUM([[Actual Adj]] 30 Day Adjusted Dmart GMV (copy)_90986852705890316])), -1))) THEN &apos;Null&apos; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='6c. [Actual Adj] 30D Adj Shops Net GMV (€)' datatype='real' default-format='c&quot;€&quot;#,##0,,.00M;-&quot;€&quot;#,##0,,.00M' name='[[Actual Adj]] 30 Day Adjusted Dmart GMV (copy)_90986852705890316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vendor_type] = &quot;shops&quot; &#10;THEN [Calculation_5479825279424167937] * 30&#10;ELSE 0 &#10;END' />
            </column>
            <column caption='8a. [Actual Adj] MoM Absolute ▲ in 30D Adj Q-Commerce Net GMV' datatype='real' name='[[Actual Adj]] 30 Day Adjusted Q-Commerce GMV (copy)_90986852712738832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Calculation_5479825279468851202])) &#10;    - LOOKUP(ZN(SUM([Calculation_5479825279468851202])), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='9b. [Actual Adj] Shops Attribution Ratio for MoM ▲ in 30D Adj Q-Commerce Net GMV' datatype='real' name='[[Actual Adj]] Dmart Attribution Ratio for MoM ▲ in 30 Day Adjusted Q-Commerce GMV (copy)_90986852715769877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;    [[Actual Adj]] MoM Absolute ▲ in 30 Day Adjusted Dmart GMV (copy)_90986852713418771] &lt; 0&#10;        AND [[Actual Adj]] 30 Day Adjusted Q-Commerce GMV (copy)_90986852712738832] &lt; 0 &#10;        AND [[Actual Adj]] MoM Absolute ▲ in 30 Day Adjusted Q-Commerce GMV (copy)_90986852713328658] &gt; 0&#10;THEN 1&#10;ELSEIF&#10;    [[Actual Adj]] MoM Absolute ▲ in 30 Day Adjusted Dmart GMV (copy)_90986852713418771] &lt; 0&#10;        AND [[Actual Adj]] 30 Day Adjusted Q-Commerce GMV (copy)_90986852712738832] &gt; 0 &#10;        AND [[Actual Adj]] MoM Absolute ▲ in 30 Day Adjusted Q-Commerce GMV (copy)_90986852713328658] &gt; 0&#10;THEN 0 &#10;ELSEIF &#10;    [[Actual Adj]] MoM Absolute ▲ in 30 Day Adjusted Dmart GMV (copy)_90986852713418771] &gt; 0&#10;        AND [[Actual Adj]] MoM Absolute ▲ in 30 Day Adjusted Q-Commerce GMV (copy)_90986852713328658] &lt; 0 &#10;        AND [[Actual Adj]] 30 Day Adjusted Q-Commerce GMV (copy)_90986852712738832] &lt; 0&#10;THEN 0&#10;ELSE&#10;    [[Actual Adj]] MoM Absolute ▲ in 30 Day Adjusted Dmart GMV (copy)_90986852713418771] &#10;        / [[Actual Adj]] 30 Day Adjusted Q-Commerce GMV (copy)_90986852712738832]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='8c. [Actual Adj] MoM Absolute ▲ in 30D Adj Shops Net GMV' datatype='real' name='[[Actual Adj]] MoM Absolute ▲ in 30 Day Adjusted Dmart GMV (copy)_90986852713418771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([[Actual Adj]] 30 Day Adjusted Dmart GMV (copy)_90986852705890316])) &#10;    - LOOKUP(ZN(SUM([[Actual Adj]] 30 Day Adjusted Dmart GMV (copy)_90986852705890316])), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='8b. [Actual Adj] MoM Absolute ▲ in 30D Adj Dmart Net GMV' datatype='real' name='[[Actual Adj]] MoM Absolute ▲ in 30 Day Adjusted Q-Commerce GMV (copy)_90986852713328658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Calculation_45880486373609483])) &#10;    - LOOKUP(ZN(SUM([Calculation_45880486373609483])), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Date Period' datatype='string' name='[date_period]' role='dimension' type='nominal' />
            <column caption='Date Value' datatype='date' name='[date_value]' role='dimension' type='ordinal' />
            <column caption='Country' datatype='string' name='[global_entity_id]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;FP_AP&quot;' value='APAC' />
                <alias key='&quot;FP_APAC&quot;' value='APAC ' />
