            <column caption='1e. [Actual] Restaurant Net GMV (€)' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[[QC]] GMV (€) (copy)_45880485544493056]' role='measure' type='quantitative'>
