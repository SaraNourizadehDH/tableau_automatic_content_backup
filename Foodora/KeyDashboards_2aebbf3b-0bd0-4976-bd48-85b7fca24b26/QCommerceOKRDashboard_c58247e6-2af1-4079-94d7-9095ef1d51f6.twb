            <column caption='[Dmart Actual vs Target - Performing] Dmart On Time %' datatype='string' name='[[Dmart Actual vs Target - Performing]] AQS (copy)_5144447790918434832]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [dmart_perc_on_time_orders_platform_diff]&#10;    = {FIXED [date_value]: MAX([dmart_perc_on_time_orders_platform_diff])} &#10;THEN [global_entity_id]&#10;END' />
