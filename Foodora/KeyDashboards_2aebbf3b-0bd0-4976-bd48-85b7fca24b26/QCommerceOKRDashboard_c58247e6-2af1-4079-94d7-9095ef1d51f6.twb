                <zone fixed-size='280' h='13571' id='97' is-fixed='true' name='8 | Shops Promo GPV Contribution for SA Supermarket Chart' w='32265' x='67199' y='58535'>
                  <layout-cache cell-count-w='6' has-max-size-h='true' maxheight='31' minheight='31' non-cell-size-w='49' type-h='scalable' type-w='cell' />
