              <calculation class='tableau' formula='IF NOW() &lt; MAKEDATETIME(TODAY(), #14:00:00#) &#10;THEN TODAY()-2&#10;ELSE TODAY()-1 &#10;END' />
            </column>
            <column caption='IF (ZN(SUM([1c. [Actual]] 30D Adj Healthy QC NTV Customers - ...' datatype='string' name='[Calculation_3256946959068258307]' role='measure' type='nominal' user:unnamed='1 | Q-Commerce 30D Adj Healthy New-To-Vertical Customers Chart'>
              <calculation class='tableau' formula='IF (ZN(SUM([1b. [Actual]] Daily Average Healthy QC NTV Customers - Monthly (copy)_2837056726197620737])) - LOOKUP(ZN(SUM([1b. [Actual]] Daily Average Healthy QC NTV Customers - Monthly (copy)_2837056726197620737])), -1)) / ABS(LOOKUP(ZN(SUM([1b. [Actual]] Daily Average Healthy QC NTV Customers - Monthly (copy)_2837056726197620737])), -1)) &lt; 0 THEN &apos;Decrease&apos; ELSEIF (ZN(SUM([1b. [Actual]] Daily Average Healthy QC NTV Customers - Monthly (copy)_2837056726197620737])) - LOOKUP(ZN(SUM([1b. [Actual]] Daily Average Healthy QC NTV Customers - Monthly (copy)_2837056726197620737])), -1)) / ABS(LOOKUP(ZN(SUM([1b. [Actual]] Daily Average Healthy QC NTV Customers - Monthly (copy)_2837056726197620737])), -1)) &gt;= 0 THEN &apos;Increase&apos; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='No. of Days in Month' datatype='integer' name='[Calculation_5479825279421440000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/* Calculates the no. of days in a given month */ &#10;/* Only applicable for Date Type that is &apos;Month&apos; */ &#10;/* Purpose is to calculate 30 Day Adjusted metrics */ &#10;&#10;IF &#10;    [date_period] = &apos;Month&apos; AND DATETRUNC(&apos;month&apos;, TODAY()) &lt;&gt; [date_value]&#10;THEN&#10;    DATEDIFF(&apos;day&apos;, [date_value], DATEADD(&apos;month&apos;, 1, [date_value]))&#10;&#10;ELSEIF&#10;    [date_period] = &apos;Month&apos; AND DATETRUNC(&apos;month&apos;, TODAY()) = [date_value]&#10;THEN&#10;    DATEDIFF(&apos;day&apos;, [date_value], [Calculation_3256946959057907713]+1)&#10;&#10;END' />
            </column>
