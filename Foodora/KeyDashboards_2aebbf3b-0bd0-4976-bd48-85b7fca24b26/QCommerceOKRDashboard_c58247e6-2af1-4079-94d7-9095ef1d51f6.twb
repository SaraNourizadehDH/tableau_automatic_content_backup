              <calculation class='tableau' formula='IF [shops_sa_promo_gpv_cont_diff] &#10;    = {FIXED [date_value]: MAX([shops_sa_promo_gpv_cont_diff])} &#10;THEN [global_entity_id]&#10;END' />
