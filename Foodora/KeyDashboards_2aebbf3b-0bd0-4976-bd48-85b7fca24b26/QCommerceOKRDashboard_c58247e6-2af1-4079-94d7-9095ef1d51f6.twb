            <zone h='100000' id='400' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='99384' id='399' param='vert' type-v2='layout-flow' w='98934' x='533' y='308'>
                <zone fixed-size='72' h='3077' id='116' is-fixed='true' is-scaled='1' param='Image/foodpanda_app icon-RGB.jpg' type-v2='bitmap' w='6666' x='533' y='308'>
                  <zone-style>
