              <zone fixed-size='1392' forceUpdate='true' h='3478' id='41' is-fixed='true' type-v2='text' w='92268' x='7199' y='348'>
                <formatted-text>
                  <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Bold' fontsize='16'>Dmart OKR Overview</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='padding' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
            </zone>
            <zone fixed-size='122' forceUpdate='true' h='5652' id='147' is-fixed='true' type-v2='text' w='98934' x='533' y='3826'>
              <formatted-text>
                <run bold='true' fontcolor='#eb4384' fontname='Tableau Bold' fontsize='12'>ⓘ</run>
                <run fontcolor='#1b1b1b' fontsize='12'>Æ </run>
                <run fontcolor='#333333' fontsize='8'>This tab consist of 3 sets of </run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Dmart</run>
                <run fontcolor='#333333' fontsize='8'> metrics (</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>MD OKRs</run>
                <run fontcolor='#333333' fontsize='8'>, </run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Top OKRs</run>
                <run fontcolor='#333333' fontsize='8'>, and </run>
                <run bold='true' fontcolor='#333333' fontsize='8'>KPIs</run>
                <run fontcolor='#333333' fontsize='8'>) that the business would like to track in 2024. </run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#333333' fontsize='8'>1. The </run>
                <run bold='true' fontcolor='#333333' fontsize='8'>targets</run>
                <run fontcolor='#333333' fontsize='8'> are only applicable for the </run>
                <run bold='true' fontcolor='#333333' fontsize='8'>monthly view</run>
                <run fontcolor='#333333' fontsize='8'>, and for </run>
                <run bold='true' fontcolor='#333333' fontsize='8'>selected countries</run>
                <run fontcolor='#333333' fontsize='8'>. </run>
                <run>Æ&#10;</run>
                <run fontcolor='#333333' fontsize='8'>2. Targets shown here reflects whatever that is entered manually by the respective POCs in a separate google spreadsheet. For more information on the targets, please reach out to calvin.ying@foodpanda.com.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#333333' fontsize='8'>3. To deep dive on the metric on a weekly date or Month-To-Date granularity, please refer to the Weekly Overview and MTD Overview. </run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='padding' value='4' />
                <format attr='padding-right' value='10' />
                <format attr='padding-left' value='10' />
                <format attr='background-color' value='#ffffff' />
              </zone-style>
            </zone>
            <zone fixed-size='58' friendly-name='Filter Panel' h='2522' id='36' is-fixed='true' layout-strategy-id='distribute-evenly' param='horz' type-v2='layout-flow' w='98934' x='533' y='9478'>
              <zone h='2522' id='138' name='5 | Dmart AQS' param='[federated.1oy58fq084ey6m1gn11g61fzhok2].[none:date_value:qk]' type-v2='filter' values='database' w='49467' x='533' y='9478'>
