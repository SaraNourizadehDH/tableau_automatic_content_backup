          <datasource-dependencies datasource='federated.1oy58fq084ey6m1gn11g61fzhok2'>
            <column caption='6e. [Actual Adj] 30D Adj Platform Net GMV (€)' datatype='real' name='[30 Day Adjusted GMV (copy)_5479825279469760516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Daily Average GMV (copy)_5479825279469133827] * 30' />
            </column>
            <column caption='Reference Date' datatype='date' name='[Calculation_3256946959057907713]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF NOW() &lt; MAKEDATETIME(TODAY(), #14:00:00#) &#10;THEN TODAY()-2&#10;ELSE TODAY()-1 &#10;END' />
            </column>
            <column caption='IF (ZN(SUM([6a. [Actual Adj]] 30D Adj Q-Commerce Net GMV (€)]...' datatype='string' name='[Calculation_45880486348660741]' role='measure' type='nominal' user:unnamed='QC vs Restaurant MoM % △ in 30 Day Adjusted GMV'>
              <calculation class='tableau' formula='IF (ZN(SUM([Calculation_5479825279468851202])) - LOOKUP(ZN(SUM([Calculation_5479825279468851202])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_5479825279468851202])), -1)) &lt; 0 THEN &apos;Decrease&apos; ELSEIF (ZN(SUM([Calculation_5479825279468851202])) - LOOKUP(ZN(SUM([Calculation_5479825279468851202])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_5479825279468851202])), -1)) &gt; 0 THEN &apos;Increase&apos; ELSEIF (ZN(SUM([Calculation_5479825279468851202])) - LOOKUP(ZN(SUM([Calculation_5479825279468851202])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_5479825279468851202])), -1)) = 0 THEN &apos;No Change&apos; ELSE NULL END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='6d. [Actual Adj] 30D Adj Restaurant Net GMV (€)' datatype='real' name='[Calculation_45880486348824582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[30 Day Adjusted GMV (copy)_5479825279469760516] &#10;    - [Calculation_5479825279468851202]' />
            </column>
            <column caption='No. of Days in Month' datatype='integer' name='[Calculation_5479825279421440000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/* Calculates the no. of days in a given month */ &#10;/* Only applicable for Date Type that is &apos;Month&apos; */ &#10;/* Purpose is to calculate 30 Day Adjusted metrics */ &#10;&#10;IF &#10;    [date_period] = &apos;Month&apos; AND DATETRUNC(&apos;month&apos;, TODAY()) &lt;&gt; [date_value]&#10;THEN&#10;    DATEDIFF(&apos;day&apos;, [date_value], DATEADD(&apos;month&apos;, 1, [date_value]))&#10;&#10;ELSEIF&#10;    [date_period] = &apos;Month&apos; AND DATETRUNC(&apos;month&apos;, TODAY()) = [date_value]&#10;THEN&#10;    DATEDIFF(&apos;day&apos;, [date_value], [Calculation_3256946959057907713]+1)&#10;&#10;END' />
            </column>
            <column caption='5a. [Actual Adj] Daily Average Net GMV (€)' datatype='real' name='[Calculation_5479825279424167937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv_net_eur] / &#10;[Calculation_5479825279421440000]' />
            </column>
            <column caption='6a. [Actual Adj] 30D Adj Q-Commerce Net GMV (€)' datatype='real' name='[Calculation_5479825279468851202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vendor_type] = &quot;QCommerce&quot; &#10;THEN [Calculation_5479825279424167937] * 30&#10;ELSE 0 &#10;END' />
            </column>
            <column caption='5b. [Actual Adj] Daily Average Platform Net GMV (€)' datatype='real' name='[Daily Average GMV (copy)_5479825279469133827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[platform_gmv_net_eur] / &#10;[Calculation_5479825279421440000]' />
            </column>
