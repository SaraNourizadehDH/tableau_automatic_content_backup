                <zone fixed-size='280' h='13571' id='27' is-fixed='true' name='8 | Shops Promo GPV Contribution for SA Supermarket' show-title='false' w='66666' x='533' y='58535'>
                  <layout-cache cell-count-h='12' non-cell-size-h='40' type-h='cell' type-w='fixed' />
