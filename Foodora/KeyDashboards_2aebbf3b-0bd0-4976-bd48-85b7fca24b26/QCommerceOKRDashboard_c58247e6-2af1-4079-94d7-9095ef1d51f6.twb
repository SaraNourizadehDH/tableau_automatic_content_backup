            <column caption='1b. [Actual] Dmart Weekly Shoppers' datatype='integer' name='[1. [Actual]] Weekly Shoppers (copy)_3022126523724677122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vendor_type] = &quot;pandamart&quot;&#10;THEN [num_of_qc_weekly_shoppers]&#10;ELSE NULL END' />
            </column>
            <column caption='IF (ZN(SUM([1b. [Actual]] Dmart Weekly Shoppers])) - LOOKUP(Z...' datatype='string' name='[Calculation_3022126523725840388]' role='measure' type='nominal' user:unnamed='3 | Dmart Weekly Shoppers'>
              <calculation class='tableau' formula='IF (ZN(SUM([1. [Actual]] Weekly Shoppers (copy)_3022126523724677122])) - LOOKUP(ZN(SUM([1. [Actual]] Weekly Shoppers (copy)_3022126523724677122])), -1)) / ABS(LOOKUP(ZN(SUM([1. [Actual]] Weekly Shoppers (copy)_3022126523724677122])), -1)) &lt; 0 THEN &apos;Decrease&apos; ELSEIF (ZN(SUM([1. [Actual]] Weekly Shoppers (copy)_3022126523724677122])) - LOOKUP(ZN(SUM([1. [Actual]] Weekly Shoppers (copy)_3022126523724677122])), -1)) / ABS(LOOKUP(ZN(SUM([1. [Actual]] Weekly Shoppers (copy)_3022126523724677122])), -1)) &gt;= 0 THEN &apos;Increase&apos; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
