      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_qcommerce__okr_dashboard (sandbox_qcommerce)' name='federated.1oy58fq084ey6m1gn11g61fzhok2' />
          </datasources>
          <datasource-dependencies datasource='federated.1oy58fq084ey6m1gn11g61fzhok2'>
            <column caption='6e. [Actual Adj] 30D Adj Platform Net GMV (€)' datatype='real' name='[30 Day Adjusted GMV (copy)_5479825279469760516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Daily Average GMV (copy)_5479825279469133827] * 30' />
            </column>
            <column caption='Reference Date' datatype='date' name='[Calculation_3256946959057907713]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF NOW() &lt; MAKEDATETIME(TODAY(), #14:00:00#) &#10;THEN TODAY()-2&#10;ELSE TODAY()-1 &#10;END' />
            </column>
            <column caption='6d. [Actual Adj] 30D Adj Restaurant Net GMV (€)' datatype='real' name='[Calculation_45880486348824582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[30 Day Adjusted GMV (copy)_5479825279469760516] &#10;    - [Calculation_5479825279468851202]' />
            </column>
            <column caption='No. of Days in Month' datatype='integer' name='[Calculation_5479825279421440000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/* Calculates the no. of days in a given month */ &#10;/* Only applicable for Date Type that is &apos;Month&apos; */ &#10;/* Purpose is to calculate 30 Day Adjusted metrics */ &#10;&#10;IF &#10;    [date_period] = &apos;Month&apos; AND DATETRUNC(&apos;month&apos;, TODAY()) &lt;&gt; [date_value]&#10;THEN&#10;    DATEDIFF(&apos;day&apos;, [date_value], DATEADD(&apos;month&apos;, 1, [date_value]))&#10;&#10;ELSEIF&#10;    [date_period] = &apos;Month&apos; AND DATETRUNC(&apos;month&apos;, TODAY()) = [date_value]&#10;THEN&#10;    DATEDIFF(&apos;day&apos;, [date_value], [Calculation_3256946959057907713]+1)&#10;&#10;END' />
            </column>
            <column caption='5a. [Actual Adj] Daily Average Net GMV (€)' datatype='real' name='[Calculation_5479825279424167937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv_net_eur] / &#10;[Calculation_5479825279421440000]' />
            </column>
            <column caption='6a. [Actual Adj] 30D Adj Q-Commerce Net GMV (€)' datatype='real' name='[Calculation_5479825279468851202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vendor_type] = &quot;QCommerce&quot; &#10;THEN [Calculation_5479825279424167937] * 30&#10;ELSE 0 &#10;END' />
            </column>
            <column caption='5b. [Actual Adj] Daily Average Platform Net GMV (€)' datatype='real' name='[Daily Average GMV (copy)_5479825279469133827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[platform_gmv_net_eur] / &#10;[Calculation_5479825279421440000]' />
            </column>
            <column caption='4b. [Actual vs Target] QC Net GMV as % of Platform Net GMV' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%' name='[[Actual vs Target]] QC Net GMV as % of Platform Net GMV (copy)_2498864541435187202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[[Actual]] 8. Net GMV as % of Platform Net GMV *By Vendor Type* (copy)_2498864541434384385]&#10;- &#10;[qc_perc_platform_net_gmv_target]' />
            </column>
            <column caption='2b. [Actual] QC Net GMV as % of Platform Net GMV' datatype='real' name='[[Actual]] 8. Net GMV as % of Platform Net GMV *By Vendor Type* (copy)_2498864541434384385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[[Actual]] Dmart Net GMV (€) (copy)_2498864541433753600] / &#10;[platform_gmv_net_eur]' />
            </column>
            <column caption='1b. [Actual] QC Net GMV (€)' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[[Actual]] Dmart Net GMV (€) (copy)_2498864541433753600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vendor_type] = &quot;QCommerce&quot; &#10;THEN [gmv_net_eur]&#10;ELSE 0 END' />
            </column>
            <column caption='1d. [Actual] Shops Net GMV (€)' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[[Actual]] Dmart Net GMV (€) (copy)_90986853152727099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vendor_type] = &quot;shops&quot; &#10;THEN [gmv_net_eur]&#10;ELSE NULL END' />
            </column>
            <column caption='3. [Actual] Q-Commerce On Time Orders' datatype='integer' name='[[Actual]] Dmart On Time Orders (copy)_90986852794589228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gross_order_platform] &#10;    - [num_of_order_delay_more_than_5min_platform] &#10;    - [num_of_order_delay_less_than_minus_15min_platform]' />
            </column>
            <column caption='1c. [Actual] Dmart Net GMV (€)' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[[Actual]] Net GMV (€) (copy)_90986853152481338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vendor_type] = &quot;pandamart&quot;&#10;THEN [gmv_net_eur]&#10;ELSE NULL END' />
            </column>
            <column caption='[Formatting] QC Net GMV as % of Total Platform Net GMV' datatype='string' name='[[QC]] Healthy QC NTV Customers Conditional Formatting (copy)_1216464540443906064]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    [[Actual vs Target]] QC Net GMV as % of Platform Net GMV (copy)_2498864541435187202] &lt; 0 &#10;THEN &apos;Below Target&apos;&#10;ELSEIF &#10;    [[Actual vs Target]] QC Net GMV as % of Platform Net GMV (copy)_2498864541435187202]  &gt;= 0 &#10;THEN &apos;Meets Target&apos;&#10;ELSEIF &#10;    ISNULL([[Actual vs Target]] QC Net GMV as % of Platform Net GMV (copy)_2498864541435187202]) &#10;THEN &apos;No Target&apos;&#10;END' />
