      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0jad3np1j1hh6k19i6nms0d1o0bk].[pcto:sum:num_of_issues:qk:2]&quot;' value='% of Total Issues' />
        </aliases>
      </column>
      <column datatype='integer' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum({fixed [vendor_type], [Calculation_4260686789848379392],[country_name]: sum([total_orders])})' />
      </column>
      <column caption='WoW % ' datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_1262907854350143490]) - LOOKUP(ZN([Calculation_1262907854350143490]), 1)) / ABS(LOOKUP(ZN([Calculation_1262907854350143490]), 1))'>
          <table-calc ordering-field='[federated.0jad3np1j1hh6k19i6nms0d1o0bk].[none:date (copy)_1119566786243506179:ok]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='issue_rate' datatype='real' name='[Calculation_1262907854350143490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([issue_orders])/sum([total_orders])' />
      </column>
      <column caption='week test' datatype='datetime' name='[Calculation_1280711200970756096]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;iso-week&apos;,[order_date])' />
      </column>
      <column caption='Incident Rate' datatype='real' default-format='p0.00%' name='[Calculation_1430385502805938176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([num_of_issues])/sum({fixed [vendor_type], [Calculation_4260686789848379392],[country_name]: sum([total_orders])})' />
      </column>
      <column caption='failed_orders_w_0s' datatype='integer' name='[Calculation_1986439346384474117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(lookup(sum([issue_orders]), 0))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='failrate_2 indicator' datatype='string' name='[Calculation_3757409469231435776]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF((ZN([Calculation_1262907854350143490]) - LOOKUP(ZN([Calculation_1262907854350143490]), 1)) / ABS(LOOKUP(ZN([Calculation_1262907854350143490]), 1))&#10;)&gt;= 0 THEN &apos;Increase&apos; ELSE &apos;Decrease&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='issue_rate_calculated' datatype='real' name='[Calculation_3757409469242171398]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(([issue_orders])) / SUM({EXCLUDE [ccr1],[ccr2],[ccr3] : SUM([total_orders])})' />
      </column>
      <column caption='Date Filter ' datatype='string' name='[Calculation_4260686789848379392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;day&apos; THEN &#10;STR(DATEPART(&apos;year&apos;,DATETRUNC(&apos;day&apos;,[order_date],&apos;Monday&apos;)))&#10;+ &apos;-&apos;&#10;+ STR(DATEPART(&apos;month&apos;,DATETRUNC(&apos;day&apos;,[order_date],&apos;Monday&apos;)))&#10;+ &apos;-&apos;&#10;+ STR(DATEPART(&apos;day&apos;,DATETRUNC(&apos;day&apos;,[order_date],&apos;Monday&apos;)))&#10;ELSEIF [Parameters].[Parameter 2] = &apos;month&apos; THEN &#10;STR(DATEPART(&apos;year&apos;,DATETRUNC(&apos;day&apos;,[order_date],&apos;Monday&apos;)))&#10;+ &apos;-&apos;&#10;+ STR(DATEPART(&apos;month&apos;,DATETRUNC(&apos;day&apos;,[order_date],&apos;Monday&apos;)))&#10;ELSE&#10;STR(DATEPART(&apos;year&apos;,DATETRUNC(&apos;week&apos;,[order_date],&apos;Monday&apos;)))&#10;+ &apos;-&apos;&#10;+ STR(DATEPART(&apos;iso-week&apos;,DATETRUNC(&apos;day&apos;,[order_date],&apos;Monday&apos;)))&#10;END' />
      </column>
      <column caption='Calculation2' datatype='integer' name='[Calculation_7937875862991478785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum({fixed [vendor_type], [date (copy)_1119566786243506179],[country_name]: sum([total_orders])})' />
      </column>
      <column datatype='string' name='[Country (group)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='categorical-bin' column='[country_name]' new-bin='true'>
          <bin default-name='false' value='&quot;APAC&quot;'>
            <value>&quot;Bangladesh&quot;</value>
