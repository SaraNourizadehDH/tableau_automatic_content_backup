          </bin>
        </calculation>
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Week ' datatype='string' name='[Week (copy)_302655975213355009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;,DATETRUNC(&apos;iso-week&apos;,[order_date])))&#10;+ &apos;-&apos;&#10;+ STR(DATEPART(&apos;iso-week&apos;,DATETRUNC(&apos;day&apos;,[order_date],&apos;Monday&apos;)))' />
      </column>
      <column caption='Date-Regional View' datatype='datetime' name='[Week (copy)_3757409469251465226]' role='dimension' type='ordinal'>
