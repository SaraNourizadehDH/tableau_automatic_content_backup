      <column caption='incident rate' datatype='real' name='[Calculation_217087637762953227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(1/[total_unique_skus] *[num_of_issues])&#10;/COUNTD([order_ref])' />
      </column>
      <column caption='distinct orders' datatype='integer' name='[Calculation_217087637774557196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([order_ref])' />
      </column>
      <column caption='non_distinct_orders' datatype='integer' name='[Calculation_217087637788090381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([order_ref])' />
      </column>
      <column caption='incident_rate' datatype='real' name='[Calculation_8857032398215385089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([issues_aggregated])/sum(orders)' />
      </column>
