      <aliases enabled='yes' />
      <column caption='% On Time Orders' datatype='real' default-format='p0.0%' name='[% CVR (copy)_1809250803602374677]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cx_on_time_order_count])/ SUM([cx_on_time_order_den])' />
      </column>
      <column caption='% Fresh and UF Basket Penetration' datatype='real' default-format='p0.0%' name='[% CVR (copy)_1809250803646672922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fresh_order_count]) / SUM([successful_order_count])' />
      </column>
      <column caption='% Stacked Deliveries' datatype='real' default-format='p0.0%' name='[% Customer Fail Rate (copy)_5325928801710776330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stacked_delivery_count])/ SUM([completed_delivery_count])' />
      </column>
      <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.0%' name='[% Fail Rate (copy)_1809250803602620439]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_order_count])/ SUM([gross_order_count])' />
      </column>
      <column caption='% Incident Rate' datatype='real' default-format='p0.0%' name='[% Fail Rate (copy)_1809250803602903065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([issue_count])/ SUM([gross_order_count])' />
      </column>
      <column caption='% Weighted Availability' datatype='real' default-format='p0.0%' name='[% Fail Rate (copy)_1809250803650719776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_wa_num])/ SUM([dmart_wa_den])' />
      </column>
      <column caption='% GFV Share: Fresh and UF ' datatype='real' default-format='p0.0%' name='[% Fresh and UF Basket Penetration (copy)_1809250803649646621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fresh_gfv_eur]) / SUM([Calculation_6150720857530941442])' />
      </column>
      <column caption='% ZM/SM Book Value' datatype='real' default-format='p0.0%' name='[% Fresh and UF Basket Penetration (copy)_1809250803650105375]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;ZN([dmart_zero_mover_stock_value_eur]) + ZN([dmart_slow_mover_stock_value_eur])&#10;)&#10; / &#10;SUM([dmart_total_stock_value_eur])' />
      </column>
      <column caption='% GFV Share: Private Label ' datatype='real' default-format='p0.0%' name='[% Fresh and UF GFV Share (copy)_1809250803649753118]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_pl_gfv_eur]) / SUM([Calculation_6150720857530941442])' />
      </column>
      <column caption='% Promo GPV' datatype='real' default-format='p0.0%' name='[% GFV Share: Private Label  (copy)_1809250803655127076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shops_promo_gpv_contribution_num]) / SUM([shops_promo_gpv_contribution_den])' />
      </column>
      <column caption='% GMV Net from Subscriber Benefits' datatype='real' default-format='p0.0%' name='[% GMV Net from Subscribers (copy)_1809250803600158734]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([subscriber_benefit_gmv_net_eur]) / SUM([Calculation_6150720857530372096])' />
      </column>
      <column caption='% Orders with Promo Tool Discount' datatype='real' default-format='p0.0%' name='[% Incentivised Orders (copy)_5325928801668182017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_promo_order_count]) / SUM([successful_order_count])' />
      </column>
      <column caption='iCPGMV' datatype='real' default-format='p0.0%' name='[% Incentivised Orders (copy)_5325928801668939778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6150720857531834374]) / SUM([Calculation_6150720857530372096])' />
      </column>
      <column caption='% Fail Rate' datatype='real' default-format='p0.0%' name='[% On Time (copy)_1809250803602554902]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_order_count])/ SUM([gross_order_count])' />
      </column>
      <column caption='% Items Not Delivered' datatype='real' default-format='p0.0%' name='[% On Time (copy)_1809250803659169833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shops_items_not_delivered_excl_post_delivery_num])/ SUM([shops_items_not_delivered_den])' />
      </column>
      <column caption='% Orders from QC Trials' datatype='real' default-format='p0.0%' name='[% Orders with Promo Tool Discount (copy)_5325928801670729735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_qc_trial_order_count]) / SUM([successful_order_count])' />
      </column>
      <column caption='% Subscriber Customers' datatype='real' default-format='p0.0%' name='[% Platform Customers (copy)_1809250803599368203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([country_vendor_type_subscriber_customer_count]) / SUM([country_vendor_type_customer_count])' />
      </column>
      <column caption='% Platform Successful Orders' datatype='real' default-format='p0.0%' name='[% Platform GMV Net (copy)_1809250803596935171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_order_count]) / SUM([platform_successful_order_count])' />
      </column>
      <column caption='% Platform Customers' datatype='real' default-format='p0.0%' name='[% Platform GMV Net (copy)_1809250803598745606]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([country_vendor_type_customer_count]) / SUM([platform_customer_count])' />
