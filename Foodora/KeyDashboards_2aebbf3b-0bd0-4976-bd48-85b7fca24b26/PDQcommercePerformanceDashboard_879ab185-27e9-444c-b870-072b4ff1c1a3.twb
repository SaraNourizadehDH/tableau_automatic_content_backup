    <worksheet name='QC Performance Sheet'>
      <table>
        <view>
          <datasources>
            <datasource caption='qcomm__perf_country_performance_dashboard (pandata_report)' name='federated.1msodj70uyugi61eohodj0pwwhfl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1msodj70uyugi61eohodj0pwwhfl'>
            <column caption='% On Time Orders' datatype='real' default-format='p0.0%' name='[% CVR (copy)_1809250803602374677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cx_on_time_order_count])/ SUM([cx_on_time_order_den])' />
            </column>
            <column caption='% Stacked Deliveries' datatype='real' default-format='p0.0%' name='[% Customer Fail Rate (copy)_5325928801710776330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_delivery_count])/ SUM([completed_delivery_count])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.0%' name='[% Fail Rate (copy)_1809250803602620439]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_order_count])/ SUM([gross_order_count])' />
            </column>
            <column caption='% Incident Rate' datatype='real' default-format='p0.0%' name='[% Fail Rate (copy)_1809250803602903065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([issue_count])/ SUM([gross_order_count])' />
            </column>
            <column caption='% GMV Net from Subscriber Benefits' datatype='real' default-format='p0.0%' name='[% GMV Net from Subscribers (copy)_1809250803600158734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([subscriber_benefit_gmv_net_eur]) / SUM([Calculation_6150720857530372096])' />
            </column>
            <column caption='% Orders with Promo Tool Discount' datatype='real' default-format='p0.0%' name='[% Incentivised Orders (copy)_5325928801668182017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_promo_order_count]) / SUM([successful_order_count])' />
            </column>
            <column caption='iCPGMV' datatype='real' default-format='p0.0%' name='[% Incentivised Orders (copy)_5325928801668939778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6150720857531834374]) / SUM([Calculation_6150720857530372096])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.0%' name='[% On Time (copy)_1809250803602554902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_order_count])/ SUM([gross_order_count])' />
            </column>
            <column caption='% Orders from QC Trials' datatype='real' default-format='p0.0%' name='[% Orders with Promo Tool Discount (copy)_5325928801670729735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_qc_trial_order_count]) / SUM([successful_order_count])' />
            </column>
            <column caption='% Subscriber Customers' datatype='real' default-format='p0.0%' name='[% Platform Customers (copy)_1809250803599368203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([country_vendor_type_subscriber_customer_count]) / SUM([country_vendor_type_customer_count])' />
            </column>
            <column caption='% Platform Successful Orders' datatype='real' default-format='p0.0%' name='[% Platform GMV Net (copy)_1809250803596935171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_order_count]) / SUM([platform_successful_order_count])' />
            </column>
            <column caption='% Platform Customers' datatype='real' default-format='p0.0%' name='[% Platform GMV Net (copy)_1809250803598745606]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([country_vendor_type_customer_count]) / SUM([platform_customer_count])' />
            </column>
            <column caption='% GMV Net from Subscribers' datatype='real' default-format='p0.0%' name='[% Platform GMV Net (copy)_1809250803600003085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([subscriber_gmv_net_eur]) / SUM([Calculation_6150720857530372096])' />
            </column>
            <column caption='% Platform GMV Net' datatype='real' default-format='p0.0%' name='[% Platform Sessions (copy)_1809250803596509186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6150720857530372096]) / SUM([Calculation_6150720857530716161])' />
            </column>
            <column caption='% Subscriber Orders' datatype='real' default-format='p0.0%' name='[% Subscriber Customers (copy)_1809250803599470604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([country_vendor_type_successful_subscriber_order_count]) / SUM([successful_order_count])' />
            </column>
            <column caption='% Incentivised Orders' datatype='real' default-format='p0.0%' name='[% Subscriber Orders (copy)_1809250803600744465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_incentivised_order_count]) / SUM([successful_order_count])' />
            </column>
            <column caption='% Customer Fail Rate' datatype='real' default-format='p0.0%' name='[% Vendor Fail Rate (copy)_5325928801710665737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_customer_order_count])/ SUM([gross_order_count])' />
            </column>
            <column caption='ABS: Pro' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[ABS (copy)_6150720857538596879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([subscriber_backend_delivered_quantity]) / SUM([country_vendor_type_successful_subscriber_order_count])' />
            </column>
            <column caption='ABS: Non Pro' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[ABS: Pro (copy)_6150720857538707472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([backend_delivered_quantity] - ZN([subscriber_backend_delivered_quantity])) / SUM([successful_order_count] - ZN([country_vendor_type_successful_subscriber_order_count]))' />
            </column>
            <column caption='ABS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ABV EUR (copy)_1809250803599122441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([backend_delivered_quantity]) / SUM([successful_order_count])' />
            </column>
            <column caption='ABV: Incentivised' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ABV EUR (copy)_5325928801669865477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6150720857531125763]) / SUM([successful_incentivised_order_count])' />
            </column>
            <column caption='ABV: Organic' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ABV EUR: Incentivised (copy)_5325928801669951494]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6150720857531576325]) / SUM([successful_organic_order_count])' />
            </column>
            <column caption='ABV: Non Pro' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[ABV EUR: Pro (copy)_1674424300027363329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6150720857530941442] - [Calculation_6150720857531404292])/ SUM([successful_order_count] - [country_vendor_type_successful_subscriber_order_count])' />
            </column>
            <column caption='ABV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV EUR (copy)_1809250803599007752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6150720857530941442]) / SUM([successful_order_count])' />
            </column>
            <column caption='Avg Daily Customers (copy)' datatype='real' name='[Avg Daily Customers (copy)_6150720857535455246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([country_vendor_type_customer_count]) / MAX([day_count])' />
            </column>
            <column caption='Avg Daily Successful Orders' datatype='real' name='[Avg Daily GMV Net (copy 2)_6150720857534431243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_order_count]) / MAX([day_count])' />
            </column>
            <column caption='Avg Daily GMV Net (copy)' datatype='real' name='[Avg Daily GMV Net (copy)_6150720857533788170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6150720857530372096]) / MAX([day_count])' />
            </column>
            <column caption='Avg Daily Customers' datatype='real' name='[Avg Daily Successful Orders (copy 2)_6150720857535291405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([country_vendor_type_customer_count]) / MAX([day_count])' />
            </column>
            <column caption='Avg Daily Successful Orders (copy)' datatype='real' name='[Avg Daily Successful Orders (copy)_6150720857534619660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_order_count]) / MAX([day_count])' />
            </column>
            <column caption='% Platform Sessions' datatype='real' default-format='p0.0%' name='[CVR % (copy)_1809250803595268097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([country_vendor_type_session_count]) / SUM([platform_session_count])' />
            </column>
            <column caption='ABV: Pro' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1674424300026580992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6150720857531404292])/ SUM([country_vendor_type_successful_subscriber_order_count])' />
            </column>
            <column caption='% CVR' datatype='real' name='[Calculation_1809250803595091968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([country_vendor_type_transact_session_count]) / SUM([country_vendor_type_session_count])' />
            </column>
            <column caption='Order Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1809250803597320196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_order_count]) / SUM([country_vendor_type_customer_count])' />
            </column>
            <column caption='Whitespace' datatype='integer' default-format='*&quot; &quot;' name='[Calculation_1809250803597570053]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SUM(0)' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1809250803598897159]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6150720857530372096]) / SUM([successful_order_count])' />
            </column>
            <column caption='Existing Customers' datatype='integer' name='[Calculation_1809250803600609296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([country_vendor_type_customer_count]) - SUM([country_vendor_type_ntv_customer_count]) - SUM([country_vendor_type_trial_customer_count])' />
            </column>
            <column caption='Delivery Fee per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1809250803600871442]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6150720857532432391]) / SUM([successful_order_count])' />
            </column>
            <column caption='Avg Delivery Time in Minutes' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1809250803602718744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time_in_minutes]) / SUM([actual_delivery_time_in_minutes_count])' />
            </column>
            <column caption='Iso Weekday' datatype='integer' name='[Calculation_3816941458652409856]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [date_type] = &quot;day&quot; THEN ISOWEEKDAY([report_date]) END' />
            </column>
            <column caption='% GMV Net YoY' datatype='real' default-format='p0.0%' name='[Calculation_5325928801666424832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([gmv_net_eur] - [previous_year_gmv_net_eur])/ [previous_year_gmv_net_eur]' />
            </column>
            <column caption='GMV Net' datatype='real' name='[Calculation_6150720857530372096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;EUR&quot; THEN [gmv_net_eur] ELSE [gmv_net_local] END' />
            </column>
            <column caption='Platform GMV Net' datatype='real' name='[Calculation_6150720857530716161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;EUR&quot; THEN [platform_gmv_net_eur] ELSE [platform_gmv_net_local] END' />
            </column>
            <column caption='GFV' datatype='real' name='[Calculation_6150720857530941442]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;EUR&quot; THEN [gfv_eur] ELSE [gfv_local] END' />
            </column>
            <column caption='Incentivised GFV' datatype='real' name='[Calculation_6150720857531125763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;EUR&quot; THEN [incentivised_gfv_eur] ELSE [incentivised_gfv_local] END' />
            </column>
            <column caption='Subscriber GFV' datatype='real' name='[Calculation_6150720857531404292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;EUR&quot; THEN [subscriber_gfv_eur] ELSE [subscriber_gfv_local] END' />
            </column>
            <column caption='Organic GFV' datatype='real' name='[Calculation_6150720857531576325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;EUR&quot; THEN [organic_gfv_eur] ELSE [organic_gfv_local] END' />
