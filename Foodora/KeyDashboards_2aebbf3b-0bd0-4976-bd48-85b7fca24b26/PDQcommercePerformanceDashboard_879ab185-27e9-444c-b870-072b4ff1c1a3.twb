                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#bb209d1b' />
                  </zone-style>
                </zone>
                <zone fixed-size='140' forceUpdate='true' h='9866' id='112' type-v2='text' w='14000' x='667' y='81264'>
                  <formatted-text>
                    <run fontalignment='1' fontcolor='#bb209d' fontname='Tableau Bold'>Operations</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#bb209d0e' />
                  </zone-style>
                </zone>
                <zone fixed-size='180' forceUpdate='true' h='6200' id='137' type-v2='text' w='84666' x='14667' y='93267'>
                  <formatted-text>
                    <run fontcolor='#bb209d' fontname='Tableau Semibold' fontsize='8'>% CVR, Sessions: </run>
                    <run>Æ&#10;</run>
                    <run fontsize='8'>For Vendor Granularities (&quot;QC&quot;, &quot;dmart&quot;, &quot;shops&quot;) , these are the overall unique sessions across vendors. </run>
                    <run>Æ&#10;</run>
                    <run fontsize='8'>For Shops&apos; AAA Breakdown, these are the sum of Vendor Menu Sessions and Store level CVR (Open)</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#bb209d' fontname='Tableau Semibold' fontsize='8'>*% Offline</run>
                    <run fontname='Tableau Semibold' fontsize='8'>Æ </run>
                    <run fontsize='8'>shows Order Weighted % Offline when </run>
                    <run bold='true' fontsize='8'>Vendor Granularity</run>
                    <run fontsize='8'> &quot;QC Teams&quot; is chosen. Using the &quot;AAA Breakdown&quot; view, this metric is not Weighted.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#bb209d' fontname='Tableau Semibold' fontsize='8'>NTV, NTP, EC</run>
                    <run fontname='Tableau Semibold' fontsize='8'>Æ </run>
                    <run fontsize='8'>is not available for Shops&apos; AAA Breakdown.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='122' h='5400' id='151' type-v2='text' w='14000' x='667' y='94067'>
