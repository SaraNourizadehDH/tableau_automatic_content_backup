            <column caption='Vendor IO: XoX' datatype='real' default-format='p0.00%' name='[Total Incident Count: XoX (copy)_464222634289131552 1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(([All Gross Orders: Current (copy)_6207086224582873149]/[Total Cases: Current (copy)_6207086224303718435]),4)&#10;-&#10;ROUND(([All Gross Orders: Previous (copy)_6207086224583139390]/[Total Cases: Previous (copy)_6207086224303947812]),4)' />
            </column>
            <column caption='Vendor IO Denominator: Current Prep' datatype='integer' name='[Vendor IO Denominator: Current (copy)_6207086225219940451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM({&#10;        EXCLUDE &#10;            [contact_language],&#10;            [fraud_flag],&#10;            [agent_category],&#10;            [agent_center],&#10;            [channel] :&#10;            SUM(&#10;                IF &#10;                    [class_date] = &quot;monthly&quot; AND&#10;                    [all_gross_orders] &gt; 0 AND&#10;                    DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;                        { FIXED : MAX(&#10;                            IF &#10;                                [class_date] = &quot;monthly&quot; AND &#10;                                [all_gross_orders] &gt; 0&#10;                            THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                            END&#10;                        ) }&#10;                THEN&#10;                    { FIXED &#10;                        [Calculation_464222634176716803],&#10;                        [company_name],&#10;                        [country_name],&#10;                        [vertical] :&#10;                        SUM([all_gross_orders])&#10;                    }&#10;                ELSE 0&#10;                END&#10;            )&#10;    })&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM({&#10;        EXCLUDE &#10;            [contact_language],&#10;            [fraud_flag],&#10;            [agent_category],&#10;            [agent_center],&#10;            [channel] :&#10;            SUM(&#10;                IF &#10;                    [class_date] = &quot;weekly&quot; AND&#10;                    [all_gross_orders] &gt; 0 AND&#10;                    DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;                        { FIXED : MAX(&#10;                            IF &#10;                                [class_date] = &quot;weekly&quot; AND &#10;                                [all_gross_orders] &gt; 0&#10;                            THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                            END&#10;                        ) }&#10;                THEN&#10;                    { FIXED &#10;                        [Calculation_464222634176716803],&#10;                        [company_name],&#10;                        [country_name],&#10;                        [vertical] :&#10;                        SUM([all_gross_orders])&#10;                    }&#10;                ELSE 0&#10;                END&#10;            )&#10;    })&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM({&#10;        EXCLUDE &#10;            [contact_language],&#10;            [fraud_flag],&#10;            [agent_category],&#10;            [agent_center],&#10;            [channel] :&#10;            SUM(&#10;                IF &#10;                    [class_date] = &quot;daily&quot; AND&#10;                    [all_gross_orders] &gt; 0 AND&#10;                    [report_date_local] = &#10;                        { FIXED : MAX(&#10;                            IF &#10;                                [class_date] = &quot;daily&quot; AND &#10;                                [all_gross_orders] &gt; 0&#10;                            THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;                            END&#10;                        ) }&#10;                THEN&#10;                    { FIXED &#10;                        [Calculation_464222634176716803],&#10;                        [company_name],&#10;                        [country_name],&#10;                        [vertical] :&#10;                        SUM([all_gross_orders])&#10;                    }&#10;                ELSE 0&#10;                END&#10;            )&#10;    })&#10;&#10;END' />
            </column>
            <column caption='Vendor IO Denominator: Previous Prep' datatype='integer' name='[Vendor IO Denominator: Previous (copy)_6207086225220010084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM({&#10;        EXCLUDE &#10;            [contact_language],&#10;            [fraud_flag],&#10;            [agent_category],&#10;            [agent_center],&#10;            [channel] :&#10;            SUM(&#10;                IF &#10;                    [class_date] = &quot;monthly&quot; AND&#10;                    [all_gross_orders] &gt; 0 AND&#10;                    DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;                        DATEADD(&#10;                            &apos;month&apos;, -1,&#10;                            { FIXED : MAX(&#10;                                IF &#10;                                    [class_date] = &quot;monthly&quot; AND &#10;                                    [all_gross_orders] &gt; 0&#10;                                THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                                END&#10;                            )}&#10;                        )&#10;                THEN&#10;                    { FIXED &#10;                        [Calculation_464222634176716803],&#10;                        [company_name],&#10;                        [country_name],&#10;                        [vertical] :&#10;                        SUM([all_gross_orders])&#10;                    }&#10;                ELSE 0&#10;                END&#10;            )&#10;    })&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM({&#10;        EXCLUDE &#10;            [contact_language],&#10;            [fraud_flag],&#10;            [agent_category],&#10;            [agent_center],&#10;            [channel] :&#10;            SUM(&#10;                IF &#10;                    [class_date] = &quot;weekly&quot; AND&#10;                    [all_gross_orders] &gt; 0 AND&#10;                    DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;                        DATEADD(&#10;                            &apos;week&apos;, -1,&#10;                            { FIXED : MAX(&#10;                                IF &#10;                                    [class_date] = &quot;weekly&quot; AND &#10;                                    [all_gross_orders] &gt; 0&#10;                                THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                                END&#10;                            )}&#10;                        )&#10;                THEN&#10;                    { FIXED &#10;                        [Calculation_464222634176716803],&#10;                        [company_name],&#10;                        [country_name],&#10;                        [vertical] :&#10;                        SUM([all_gross_orders])&#10;                    }&#10;                ELSE 0&#10;                END&#10;            )&#10;    })&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM({&#10;        EXCLUDE &#10;            [contact_language],&#10;            [fraud_flag],&#10;            [agent_category],&#10;            [agent_center],&#10;            [channel] :&#10;            SUM(&#10;                IF &#10;                    [class_date] = &quot;daily&quot; AND&#10;                    [all_gross_orders] &gt; 0 AND&#10;                    [report_date_local] = &#10;                        DATEADD(&#10;                            &apos;day&apos;, -1,&#10;                            { FIXED : MAX(&#10;                                IF &#10;                                    [class_date] = &quot;daily&quot; AND &#10;                                    [all_gross_orders] &gt; 0&#10;                                THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;                                END&#10;                            )}&#10;                        )&#10;                THEN&#10;                    { FIXED &#10;                        [Calculation_464222634176716803],&#10;                        [company_name],&#10;                        [country_name],&#10;                        [vertical] :&#10;                        SUM([all_gross_orders])&#10;                    }&#10;                ELSE 0&#10;                END&#10;            )&#10;    })&#10;&#10;END' />
