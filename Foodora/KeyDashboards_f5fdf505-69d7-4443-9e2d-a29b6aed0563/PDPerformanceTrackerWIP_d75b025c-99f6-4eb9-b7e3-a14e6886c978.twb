    <worksheet name='RS: Non-live Case AHT (XoX)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='service_operations__opex_performance_tracker_service_ops_metrics (pandata_report)' name='federated.0ut9g2v1truf2b1cci4xh1uh7rp9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Dimension Selection' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country - Company&quot;'>
              <calculation class='tableau' formula='&quot;Country - Company&quot;' />
            </column>
            <column caption='Exclude Latest Date' datatype='boolean' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ut9g2v1truf2b1cci4xh1uh7rp9'>
            <column caption='Dimension Selection - Category' datatype='string' name='[Calculation_464222634198482949]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Country - Company&quot; THEN [company_name]&#10;WHEN &quot;Agent Category - Agent Center&quot; THEN [agent_category]&#10;END' />
            </column>
            <column caption='Parameter Filter: Granularity' datatype='boolean' name='[Calculation_464222634215763979]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN [class_date] = &quot;daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [class_date] = &quot;weekly&quot;&#10;WHEN &quot;Monthly&quot; THEN [class_date] = &quot;monthly&quot;&#10;END' />
            </column>
            <column caption='Report Date Local - 1' datatype='datetime' name='[Calculation_464222634225758221]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    DATEADD(&apos;month&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;monthly&quot;&#10;          THEN DATETRUNC(&apos;month&apos;, [report_date_local])&#10;          END&#10;        ) }&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    DATEADD(&apos;week&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;weekly&quot; &#10;          THEN DATETRUNC(&apos;week&apos;, [report_date_local])&#10;          END&#10;        ) }&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    DATEADD(&apos;day&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;daily&quot;&#10;          THEN [report_date_local]&#10;          END&#10;        ) }&#10;    )&#10;&#10;END' />
            </column>
            <column caption='Parameter Filter: Exclude Latest Date' datatype='boolean' name='[Calculation_464222634230087696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] THEN&#10;    IF [Parameters].[Parameter 1] = &quot;Monthly&quot; AND [class_date] = &quot;monthly&quot; THEN&#10;        DATETRUNC(&apos;month&apos;, [report_date_local]) &lt;= [Calculation_464222634225758221]&#10;&#10;    ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; AND [class_date] = &quot;weekly&quot; THEN&#10;        DATETRUNC(&apos;week&apos;, [report_date_local]) &lt;= [Calculation_464222634225758221]&#10;&#10;    ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; AND [class_date] = &quot;daily&quot; THEN&#10;        [report_date_local] &lt;= [Calculation_464222634225758221]&#10;&#10;    END&#10;ELSE&#10;    TRUE&#10;END' />
            </column>
            <column caption='Display: XoX' datatype='string' name='[Date (copy)_464222634222354444]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN &quot;DoD&quot;&#10;WHEN &apos;Weekly&apos; THEN &quot;WoW&quot;&#10;WHEN &apos;Monthly&apos; THEN &quot;MoM&quot;&#10;END' />
            </column>
            <column caption='Dimension Selection - SubCategory' datatype='string' name='[Dimension Selection - Category (copy)_464222634200711174]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Country - Company&quot; THEN [country_name]&#10;WHEN &quot;Agent Category - Agent Center&quot; THEN [agent_center]&#10;END' />
            </column>
            <column caption='Report Date Local (formula)' datatype='datetime' name='[Parameter Filter: Exclude Latest Date (copy)_464222634262208537]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] THEN [Calculation_464222634225758221]&#10;ELSE [report_date_local]&#10;END' />
            </column>
            <column caption='Aht Denominator: Current' datatype='integer' name='[Total Handling Time Minutes: Current (copy)_464222634288275486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [aht_denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;monthly&quot; AND [aht_denominator] &gt; 0&#10;               THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [aht_denominator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [aht_denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;weekly&quot; AND [aht_denominator] &gt; 0&#10;               THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [aht_denominator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [aht_denominator] &gt; 0 AND&#10;           [report_date_local] = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;daily&quot; AND [aht_denominator] &gt; 0&#10;               THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;               END&#10;             ) }&#10;        THEN [aht_denominator]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Aht Denominator: Previous' datatype='integer' name='[Total Handling Time Minutes: Previous (copy)_464222634288898079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [aht_denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;           DATEADD(&apos;month&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;monthly&quot; AND [aht_denominator] &gt; 0&#10;                 THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [aht_denominator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [aht_denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;           DATEADD(&apos;week&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;weekly&quot; AND [aht_denominator] &gt; 0&#10;                 THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [aht_denominator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [aht_denominator] &gt; 0 AND&#10;           [report_date_local] = &#10;           DATEADD(&apos;day&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;daily&quot; AND [aht_denominator] &gt; 0&#10;                 THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [aht_denominator]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Total Handling Time Minutes: Current' datatype='real' name='[Total Incident Count: Current (copy)_464222634287456283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [aht_denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;monthly&quot; AND [aht_denominator] &gt; 0&#10;               THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [total_handling_time_minutes]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [aht_denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;weekly&quot; AND [aht_denominator] &gt; 0&#10;               THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [total_handling_time_minutes]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [aht_denominator] &gt; 0 AND&#10;           [report_date_local] = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;daily&quot; AND [aht_denominator] &gt; 0&#10;               THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;               END&#10;             ) }&#10;        THEN [total_handling_time_minutes]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Total Handling Time Minutes: Previous' datatype='real' name='[Total Incident Count: Previous (copy)_464222634287910940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [aht_denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;           DATEADD(&apos;month&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;monthly&quot; AND [aht_denominator] &gt; 0&#10;                 THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [total_handling_time_minutes]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [aht_denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;           DATEADD(&apos;week&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;weekly&quot; AND [aht_denominator] &gt; 0&#10;                 THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [total_handling_time_minutes]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [aht_denominator] &gt; 0 AND&#10;           [report_date_local] = &#10;           DATEADD(&apos;day&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;daily&quot; AND [aht_denominator] &gt; 0&#10;                 THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [total_handling_time_minutes]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='AHT: XoX' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Total Incident Count: XoX (copy)_464222634289131552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Total Incident Count: Current (copy)_464222634287456283]/[Total Handling Time Minutes: Current (copy)_464222634288275486])&#10;-&#10;([Total Incident Count: Previous (copy)_464222634287910940]/[Total Handling Time Minutes: Previous (copy)_464222634288898079])' />
            </column>
            <column caption='AHT: XoX Color' datatype='integer' name='[Total Incident Count: XoX Color (copy)_464222634289541153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Total Incident Count: XoX (copy)_464222634289131552] &gt; 0 THEN 1 &#10;ELSEIF [Total Incident Count: XoX (copy)_464222634289131552] &lt; 0 THEN -1&#10;ELSE 0&#10;END' />
            </column>
