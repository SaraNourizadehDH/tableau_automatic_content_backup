            <column caption='Report Date Local - 1' datatype='datetime' name='[Calculation_464222634225758221]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    DATEADD(&apos;month&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;monthly&quot;&#10;          THEN DATETRUNC(&apos;month&apos;, [report_date_local])&#10;          END&#10;        ) }&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    DATEADD(&apos;week&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;weekly&quot; &#10;          THEN DATETRUNC(&apos;week&apos;, [report_date_local])&#10;          END&#10;        ) }&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    DATEADD(&apos;day&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;daily&quot;&#10;          THEN [report_date_local]&#10;          END&#10;        ) }&#10;    )&#10;&#10;END' />
