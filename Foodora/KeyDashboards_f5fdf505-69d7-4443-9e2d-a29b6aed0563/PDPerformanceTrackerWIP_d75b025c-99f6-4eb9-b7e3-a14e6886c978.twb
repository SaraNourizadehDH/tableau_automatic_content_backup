          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1yiu12b05j78gk19pmgbc0kjnepw'>
            <column caption='Granularity - Month' datatype='string' name='[Calculation_464222634176135169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;monthly&quot; THEN &#10;&#10;IF month([report_date_local]) &lt; 10 THEN STR(YEAR([report_date_local])) + &quot;-0&quot; + STR(MONTH([report_date_local]))&#10;ELSE STR(YEAR([report_date_local])) + &quot;-&quot; + STR(MONTH([report_date_local]))&#10;END&#10;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Granularity - Week' datatype='string' name='[Calculation_464222634176548866]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;weekly&quot; THEN &#10;STR([report_date_local]) + &#10; IF ISOWEEK([report_date_local]) &lt; 10&#10;   THEN &quot; (W0&quot; + STR(ISOWEEK([report_date_local])) + &quot;)&quot;&#10;   ELSE &quot; (W&quot; + STR(ISOWEEK([report_date_local])) + &quot;)&quot;&#10;   END&#10;  ELSE NULL&#10;&#10; //IF ISOWEEK([Report Date Local]) &lt; 10&#10;   //THEN STR(ISOYEAR([Report Date Local])) + &quot;-W0&quot; + STR(ISOWEEK([Report Date Local]))&#10;   //ELSE STR(ISOYEAR([Report Date Local])) + &quot;-W&quot; + STR(ISOWEEK([Report Date Local]))&#10;   //END&#10;  //ELSE NULL&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_464222634176716803]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN [Calculation_464222634176843780]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_464222634176548866]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_464222634176135169]&#10;END' />
            </column>
            <column caption='Granularity - Day' datatype='string' name='[Calculation_464222634176843780]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;daily&quot; THEN &#10;&#10;STR(DATE([report_date_local]))&#10;ELSE NULL&#10;&#10;END' />
            </column>
            <column caption='Parameter Filter: Granularity' datatype='boolean' name='[Calculation_464222634215763979]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN [class_date] = &quot;daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [class_date] = &quot;weekly&quot;&#10;WHEN &quot;Monthly&quot; THEN [class_date] = &quot;monthly&quot;&#10;END' />
            </column>
            <column caption='Report Date Local - 1' datatype='datetime' name='[Calculation_464222634225758221]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    DATEADD(&apos;month&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;monthly&quot;&#10;          THEN DATETRUNC(&apos;month&apos;, [report_date_local])&#10;          END&#10;        ) }&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    DATEADD(&apos;week&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;weekly&quot; &#10;          THEN DATETRUNC(&apos;week&apos;, [report_date_local])&#10;          END&#10;        ) }&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    DATEADD(&apos;day&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;daily&quot;&#10;          THEN [report_date_local]&#10;          END&#10;        ) }&#10;    )&#10;&#10;END' />
            </column>
            <column caption='Parameter Filter: Exclude Latest Date' datatype='boolean' name='[Calculation_464222634230087696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] THEN&#10;    IF [Parameters].[Parameter 1] = &quot;Monthly&quot; AND [class_date] = &quot;monthly&quot; THEN&#10;        DATETRUNC(&apos;month&apos;, [report_date_local]) &lt;= [Calculation_464222634225758221]&#10;&#10;    ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; AND [class_date] = &quot;weekly&quot; THEN&#10;        DATETRUNC(&apos;week&apos;, [report_date_local]) &lt;= [Calculation_464222634225758221]&#10;&#10;    ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; AND [class_date] = &quot;daily&quot; THEN&#10;        [report_date_local] &lt;= [Calculation_464222634225758221]&#10;&#10;    END&#10;ELSE&#10;    TRUE&#10;END' />
            </column>
            <column caption='Display: Trendline' datatype='string' name='[Calculation_464222634243031060]' role='dimension' type='nominal'>
