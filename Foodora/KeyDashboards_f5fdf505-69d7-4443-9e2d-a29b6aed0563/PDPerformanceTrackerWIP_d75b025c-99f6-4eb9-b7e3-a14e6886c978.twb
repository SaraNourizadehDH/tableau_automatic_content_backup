              <calculation class='tableau' formula='SUM({ EXCLUDE &#10;        [contact_language],&#10;        [fraud_flag],&#10;        [agent_category],&#10;        [agent_center],&#10;        [channel] :&#10;    SUM(&#10;        { FIXED&#10;            [Calculation_464222634176716803],&#10;            [company_name],&#10;            [country_name],&#10;            [vertical]:&#10;            [Rider IO Denominator: Current (copy)_6207086225204650077]&#10;        }&#10;      )&#10;   }&#10;)' />
