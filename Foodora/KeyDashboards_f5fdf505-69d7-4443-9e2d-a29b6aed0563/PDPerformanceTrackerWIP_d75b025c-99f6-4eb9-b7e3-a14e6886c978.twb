      <table>
        <view>
          <datasources>
            <datasource caption='service_operations__opex_performance_tracker_io_metrics (pandata_report)' name='federated.0hb3mml0kzg4461gkbpjs1h52xfq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Dimension Selection' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country - Company&quot;'>
              <calculation class='tableau' formula='&quot;Country - Company&quot;' />
            </column>
            <column caption='Exclude Latest Date' datatype='boolean' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hb3mml0kzg4461gkbpjs1h52xfq'>
            <column caption='Customer IO: XoX Color' datatype='integer' name='[AHT: XoX Color (copy)_464222634606571570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Total Incident Count: XoX (copy)_464222634289131552] &gt; 0 THEN 1&#10;ELSEIF [Total Incident Count: XoX (copy)_464222634289131552] &lt; 0 THEN -1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Granularity - Month' datatype='string' name='[Calculation_464222634176135169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;monthly&quot; THEN &#10;&#10;IF month([report_date_local]) &lt; 10 THEN STR(YEAR([report_date_local])) + &quot;-0&quot; + STR(MONTH([report_date_local]))&#10;ELSE STR(YEAR([report_date_local])) + &quot;-&quot; + STR(MONTH([report_date_local]))&#10;END&#10;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Granularity - Week' datatype='string' name='[Calculation_464222634176548866]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;weekly&quot; THEN &#10;STR([report_date_local]) + &#10; IF ISOWEEK([report_date_local]) &lt; 10&#10;   THEN &quot; (W0&quot; + STR(ISOWEEK([report_date_local])) + &quot;)&quot;&#10;   ELSE &quot; (W&quot; + STR(ISOWEEK([report_date_local])) + &quot;)&quot;&#10;   END&#10;  ELSE NULL&#10;&#10; //IF ISOWEEK([Report Date Local]) &lt; 10&#10;   //THEN STR(ISOYEAR([Report Date Local])) + &quot;-W0&quot; + STR(ISOWEEK([Report Date Local]))&#10;   //ELSE STR(ISOYEAR([Report Date Local])) + &quot;-W&quot; + STR(ISOWEEK([Report Date Local]))&#10;   //END&#10;  //ELSE NULL&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_464222634176716803]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN [Calculation_464222634176843780]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_464222634176548866]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_464222634176135169]&#10;END' />
            </column>
            <column caption='Granularity - Day' datatype='string' name='[Calculation_464222634176843780]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;daily&quot; THEN &#10;&#10;STR(DATE([report_date_local]))&#10;ELSE NULL&#10;&#10;END' />
            </column>
            <column caption='Dimension Selection - Category' datatype='string' name='[Calculation_464222634198482949]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Country - Company&quot; THEN [company_name]&#10;WHEN &quot;Agent Category - Agent Center&quot; THEN [agent_category]&#10;END' />
            </column>
            <column caption='Parameter Filter: Granularity' datatype='boolean' name='[Calculation_464222634215763979]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN [class_date] = &quot;daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [class_date] = &quot;weekly&quot;&#10;WHEN &quot;Monthly&quot; THEN [class_date] = &quot;monthly&quot;&#10;END' />
            </column>
            <column caption='Report Date Local - 1' datatype='datetime' name='[Calculation_464222634225758221]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    DATEADD(&apos;month&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;monthly&quot;&#10;          THEN DATETRUNC(&apos;month&apos;, [report_date_local])&#10;          END&#10;        ) }&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    DATEADD(&apos;week&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;weekly&quot; &#10;          THEN DATETRUNC(&apos;week&apos;, [report_date_local])&#10;          END&#10;        ) }&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    DATEADD(&apos;day&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;daily&quot;&#10;          THEN [report_date_local]&#10;          END&#10;        ) }&#10;    )&#10;&#10;END' />
            </column>
            <column caption='Parameter Filter: Exclude Latest Date' datatype='boolean' name='[Calculation_464222634230087696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] THEN&#10;    IF [Parameters].[Parameter 1] = &quot;Monthly&quot; AND [class_date] = &quot;monthly&quot; THEN&#10;        DATETRUNC(&apos;month&apos;, [report_date_local]) &lt;= [Calculation_464222634225758221]&#10;&#10;    ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; AND [class_date] = &quot;weekly&quot; THEN&#10;        DATETRUNC(&apos;week&apos;, [report_date_local]) &lt;= [Calculation_464222634225758221]&#10;&#10;    ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; AND [class_date] = &quot;daily&quot; THEN&#10;        [report_date_local] &lt;= [Calculation_464222634225758221]&#10;&#10;    END&#10;ELSE&#10;    TRUE&#10;END' />
            </column>
            <column caption='Channel (Hidden)' datatype='string' name='[Channel (copy)_2837901123767726081]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[channel]' />
            </column>
            <column caption='Customer IO Denominator: Current Prep' datatype='integer' name='[Customer IO Denominator: Current (copy)_6207086225189945435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM({&#10;        EXCLUDE &#10;            [contact_language],&#10;            [fraud_flag],&#10;            [agent_category],&#10;            [agent_center],&#10;            [channel] :&#10;            SUM(&#10;                IF &#10;                    [class_date] = &quot;monthly&quot; AND&#10;                    [gross_orders_excld_odr] &gt; 0 AND&#10;                    DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;                        { FIXED : MAX(&#10;                            IF &#10;                                [class_date] = &quot;monthly&quot; AND &#10;                                [gross_orders_excld_odr] &gt; 0&#10;                            THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                            END&#10;                        ) }&#10;                THEN&#10;                    { FIXED &#10;                        [Calculation_464222634176716803],&#10;                        [company_name],&#10;                        [country_name],&#10;                        [vertical] :&#10;                        SUM([gross_orders_excld_odr])&#10;                    }&#10;                ELSE 0&#10;                END&#10;            )&#10;    })&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM({&#10;        EXCLUDE &#10;            [contact_language],&#10;            [fraud_flag],&#10;            [agent_category],&#10;            [agent_center],&#10;            [channel] :&#10;            SUM(&#10;                IF &#10;                    [class_date] = &quot;weekly&quot; AND&#10;                    [gross_orders_excld_odr] &gt; 0 AND&#10;                    DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;                        { FIXED : MAX(&#10;                            IF &#10;                                [class_date] = &quot;weekly&quot; AND &#10;                                [gross_orders_excld_odr] &gt; 0&#10;                            THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                            END&#10;                        ) }&#10;                THEN&#10;                    { FIXED &#10;                        [Calculation_464222634176716803],&#10;                        [company_name],&#10;                        [country_name],&#10;                        [vertical] :&#10;                        SUM([gross_orders_excld_odr])&#10;                    }&#10;                ELSE 0&#10;                END&#10;            )&#10;    })&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM({&#10;        EXCLUDE &#10;            [contact_language],&#10;            [fraud_flag],&#10;            [agent_category],&#10;            [agent_center],&#10;            [channel] :&#10;            SUM(&#10;                IF &#10;                    [class_date] = &quot;daily&quot; AND&#10;                    [gross_orders_excld_odr] &gt; 0 AND&#10;                    [report_date_local] = &#10;                        { FIXED : MAX(&#10;                            IF &#10;                                [class_date] = &quot;daily&quot; AND &#10;                                [gross_orders_excld_odr] &gt; 0&#10;                            THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;                            END&#10;                        ) }&#10;                THEN&#10;                    { FIXED &#10;                        [Calculation_464222634176716803],&#10;                        [company_name],&#10;                        [country_name],&#10;                        [vertical] :&#10;                        SUM([gross_orders_excld_odr])&#10;                    }&#10;                ELSE 0&#10;                END&#10;            )&#10;    })&#10;&#10;END' />
            </column>
            <column caption='Customer IO Denominator: Previous Prep' datatype='integer' name='[Customer IO Denominator: Previous (copy)_6207086225192788060]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM({&#10;        EXCLUDE &#10;            [contact_language],&#10;            [fraud_flag],&#10;            [agent_category],&#10;            [agent_center],&#10;            [channel] :&#10;            SUM(&#10;                IF &#10;                    [class_date] = &quot;monthly&quot; AND&#10;                    [gross_orders_excld_odr] &gt; 0 AND&#10;                    DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;                        DATEADD(&#10;                            &apos;month&apos;, -1,&#10;                            { FIXED : MAX(&#10;                                IF &#10;                                    [class_date] = &quot;monthly&quot; AND &#10;                                    [gross_orders_excld_odr] &gt; 0&#10;                                THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                                END&#10;                            )}&#10;                        )&#10;                THEN&#10;                    { FIXED &#10;                        [Calculation_464222634176716803],&#10;                        [company_name],&#10;                        [country_name],&#10;                        [vertical] :&#10;                        SUM([gross_orders_excld_odr])&#10;                    }&#10;                ELSE 0&#10;                END&#10;            )&#10;    })&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM({&#10;        EXCLUDE &#10;            [contact_language],&#10;            [fraud_flag],&#10;            [agent_category],&#10;            [agent_center],&#10;            [channel] :&#10;            SUM(&#10;                IF &#10;                    [class_date] = &quot;weekly&quot; AND&#10;                    [gross_orders_excld_odr] &gt; 0 AND&#10;                    DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;                        DATEADD(&#10;                            &apos;week&apos;, -1,&#10;                            { FIXED : MAX(&#10;                                IF &#10;                                    [class_date] = &quot;weekly&quot; AND &#10;                                    [gross_orders_excld_odr] &gt; 0&#10;                                THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                                END&#10;                            )}&#10;                        )&#10;                THEN&#10;                    { FIXED &#10;                        [Calculation_464222634176716803],&#10;                        [company_name],&#10;                        [country_name],&#10;                        [vertical] :&#10;                        SUM([gross_orders_excld_odr])&#10;                    }&#10;                ELSE 0&#10;                END&#10;            )&#10;    })&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM({&#10;        EXCLUDE &#10;            [contact_language],&#10;            [fraud_flag],&#10;            [agent_category],&#10;            [agent_center],&#10;            [channel] :&#10;            SUM(&#10;                IF &#10;                    [class_date] = &quot;daily&quot; AND&#10;                    [gross_orders_excld_odr] &gt; 0 AND&#10;                    [report_date_local] = &#10;                        DATEADD(&#10;                            &apos;day&apos;, -1,&#10;                            { FIXED : MAX(&#10;                                IF &#10;                                    [class_date] = &quot;daily&quot; AND &#10;                                    [gross_orders_excld_odr] &gt; 0&#10;                                THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;                                END&#10;                            )}&#10;                        )&#10;                THEN&#10;                    { FIXED &#10;                        [Calculation_464222634176716803],&#10;                        [company_name],&#10;                        [country_name],&#10;                        [vertical] :&#10;                        SUM([gross_orders_excld_odr])&#10;                    }&#10;                ELSE 0&#10;                END&#10;            )&#10;    })&#10;&#10;END' />
            </column>
            <column caption='Display: XoX' datatype='string' name='[Date (copy)_464222634222354444]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN &quot;DoD&quot;&#10;WHEN &apos;Weekly&apos; THEN &quot;WoW&quot;&#10;WHEN &apos;Monthly&apos; THEN &quot;MoM&quot;&#10;END' />
            </column>
            <column caption='Date: Gross Orders Excld Odr' datatype='integer' name='[Date: Od Gross Orders (copy)_6207086225209409632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_464222634176716803]: SUM([gross_orders_excld_odr]) }' />
            </column>
            <column caption='Dimension Selection - SubCategory' datatype='string' name='[Dimension Selection - Category (copy)_464222634200711174]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Country - Company&quot; THEN [country_name]&#10;WHEN &quot;Agent Category - Agent Center&quot; THEN [agent_center]&#10;END' />
            </column>
            <column caption='Customer Incidents: Current' datatype='integer' name='[Gross Orders Excld Odr: Current (copy)_6207086224585732163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [customer_incidents] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;monthly&quot; AND [customer_incidents] &gt; 0&#10;               THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [customer_incidents]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [customer_incidents] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;weekly&quot; AND [customer_incidents] &gt; 0&#10;               THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [customer_incidents]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [customer_incidents] &gt; 0 AND&#10;           [report_date_local] = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;daily&quot; AND [customer_incidents] &gt; 0&#10;               THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;               END&#10;             ) }&#10;        THEN [customer_incidents]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Customer Incidents: Previous' datatype='integer' name='[Gross Orders Excld Odr: Previous (copy)_6207086224585961540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [customer_incidents] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;           DATEADD(&apos;month&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;monthly&quot; AND [customer_incidents] &gt; 0&#10;                 THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [customer_incidents]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [customer_incidents] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;           DATEADD(&apos;week&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;weekly&quot; AND [customer_incidents] &gt; 0&#10;                 THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [customer_incidents]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [customer_incidents] &gt; 0 AND&#10;           [report_date_local] = &#10;           DATEADD(&apos;day&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;daily&quot; AND [customer_incidents] &gt; 0&#10;                 THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [customer_incidents]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Customer IO Denominator: Current' datatype='integer' name='[Od Gross Orders: Current (copy)_6207086224584155201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ EXCLUDE &#10;        [contact_language],&#10;        [fraud_flag],&#10;        [agent_category],&#10;        [agent_center],&#10;        [channel] :&#10;    SUM(&#10;        { FIXED&#10;            [Calculation_464222634176716803],&#10;            [company_name],&#10;            [country_name],&#10;            [vertical]:&#10;            [Customer IO Denominator: Current (copy)_6207086225189945435]&#10;        }&#10;      )&#10;   }&#10;)' />
            </column>
            <column caption='Customer IO Denominator: Previous' datatype='integer' name='[Od Gross Orders: Previous (copy)_6207086224584822850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ EXCLUDE &#10;        [contact_language],&#10;        [fraud_flag],&#10;        [agent_category],&#10;        [agent_center],&#10;        [channel] :&#10;    SUM(&#10;        { FIXED&#10;            [Calculation_464222634176716803],&#10;            [company_name],&#10;            [country_name],&#10;            [vertical]:&#10;            [Customer IO Denominator: Previous (copy)_6207086225192788060]&#10;        }&#10;      )&#10;   }&#10;)' />
            </column>
            <column caption='Report Date Local (formula)' datatype='datetime' name='[Parameter Filter: Exclude Latest Date (copy)_464222634262208537]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] THEN [Calculation_464222634225758221]&#10;ELSE [report_date_local]&#10;END' />
