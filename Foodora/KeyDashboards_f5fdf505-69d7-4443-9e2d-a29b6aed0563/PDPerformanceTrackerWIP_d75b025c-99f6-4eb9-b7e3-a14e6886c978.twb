te_local]) = &#10;                        DATEADD(&#10;                            &apos;week&apos;, -1,&#10;                            { FIXED : MAX(&#10;                                IF &#10;                                    [class_date] = &quot;weekly&quot; AND &#10;                                    [od_gross_orders] &gt; 0&#10;                                THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                                END&#10;                            )}&#10;                        )&#10;                THEN&#10;                    { FIXED &#10;                        [Calculation_464222634176716803],&#10;                        [company_name],&#10;                        [country_name],&#10;                        [vertical] :&#10;                        SUM([od_gross_orders])&#10;                    }&#10;                ELSE 0&#10;                END&#10;            )&#10;    })&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM({&#10;        EXCLUDE &#10;            [contact_language],&#10;            [fraud_flag],&#10;            [agent_category],&#10;            [agent_center],&#10;            [channel] :&#10;            SUM(&#10;                IF &#10;                    [class_date] = &quot;daily&quot; AND&#10;                    [od_gross_orders] &gt; 0 AND&#10;                    [report_date_local] = &#10;                        DATEADD(&#10;                            &apos;day&apos;, -1,&#10;                            { FIXED : MAX(&#10;                                IF &#10;                                    [class_date] = &quot;daily&quot; AND &#10;                                    [od_gross_orders] &gt; 0&#10;                                THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;                                END&#10;                            )}&#10;                        )&#10;                THEN&#10;                    { FIXED &#10;                        [Calculation_464222634176716803],&#10;                        [company_name],&#10;                        [country_name],&#10;                        [vertical] :&#10;                        SUM([od_gross_orders])&#10;                    }&#10;                ELSE 0&#10;                END&#10;            )&#10;    })&#10;&#10;END' />
