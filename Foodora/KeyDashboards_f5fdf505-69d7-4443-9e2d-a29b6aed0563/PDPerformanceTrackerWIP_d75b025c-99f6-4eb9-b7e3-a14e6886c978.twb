            <column caption='Total Closed Cases: Current' datatype='integer' name='[Total Cases: Current (copy)_6207086224438661169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [total_closed_cases] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;monthly&quot; AND [total_closed_cases] &gt; 0&#10;               THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [total_closed_cases]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [total_closed_cases] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;weekly&quot; AND [total_closed_cases] &gt; 0&#10;               THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [total_closed_cases]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [total_closed_cases] &gt; 0 AND&#10;           [report_date_local] = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;daily&quot; AND [total_closed_cases] &gt; 0&#10;               THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;               END&#10;             ) }&#10;        THEN [total_closed_cases]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Total Closed Cases: Previous' datatype='integer' name='[Total Cases: Previous (copy)_6207086224439332914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [total_closed_cases] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;           DATEADD(&apos;month&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;monthly&quot; AND [total_closed_cases] &gt; 0&#10;                 THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [total_closed_cases]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [total_closed_cases] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;           DATEADD(&apos;week&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;weekly&quot; AND [total_closed_cases] &gt; 0&#10;                 THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [total_closed_cases]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [total_closed_cases] &gt; 0 AND&#10;           [report_date_local] = &#10;           DATEADD(&apos;day&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;daily&quot; AND [total_closed_cases] &gt; 0&#10;                 THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [total_closed_cases]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Total Rejected Cases: Current' datatype='integer' name='[Total Closed Cases: Current (copy)_6207086224439705651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [total_closed_cases] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;monthly&quot; AND [total_closed_cases] &gt; 0&#10;               THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [total_rejected_cases]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [total_closed_cases] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;weekly&quot; AND [total_closed_cases] &gt; 0&#10;               THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [total_rejected_cases]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [total_closed_cases] &gt; 0 AND&#10;           [report_date_local] = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;daily&quot; AND [total_closed_cases] &gt; 0&#10;               THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;               END&#10;             ) }&#10;        THEN [total_rejected_cases]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Rejection Rate: XoX' datatype='real' default-format='p0.00%' name='[Total Incident Count: XoX (copy)_464222634289131552 3]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Total Closed Cases: Current (copy)_6207086224439705651]/[Total Cases: Current (copy)_6207086224438661169])&#10;-&#10;([Total Successful Cases: Previous (copy)_6207086224440221748]/[Total Cases: Previous (copy)_6207086224439332914])' />
            </column>
            <column caption='Rejection Rate: XoX%' datatype='real' default-format='p0.00%' name='[Total Incident Count: XoX% (copy)_464222634290319394 3]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Incident Count: XoX (copy)_464222634289131552 3]/&#10;([Total Successful Cases: Previous (copy)_6207086224440221748]/[Total Cases: Previous (copy)_6207086224439332914])' />
