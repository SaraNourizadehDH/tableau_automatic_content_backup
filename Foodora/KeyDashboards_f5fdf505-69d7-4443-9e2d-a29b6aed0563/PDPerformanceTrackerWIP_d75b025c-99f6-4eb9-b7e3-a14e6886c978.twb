            <column caption='Customer Incidents: Current' datatype='integer' name='[Gross Orders Excld Odr: Current (copy)_6207086224585732163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [customer_incidents] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;monthly&quot; AND [customer_incidents] &gt; 0&#10;               THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [customer_incidents]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [customer_incidents] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;weekly&quot; AND [customer_incidents] &gt; 0&#10;               THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [customer_incidents]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [customer_incidents] &gt; 0 AND&#10;           [report_date_local] = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;daily&quot; AND [customer_incidents] &gt; 0&#10;               THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;               END&#10;             ) }&#10;        THEN [customer_incidents]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Customer Incidents: Previous' datatype='integer' name='[Gross Orders Excld Odr: Previous (copy)_6207086224585961540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [customer_incidents] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;           DATEADD(&apos;month&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;monthly&quot; AND [customer_incidents] &gt; 0&#10;                 THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [customer_incidents]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [customer_incidents] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;           DATEADD(&apos;week&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;weekly&quot; AND [customer_incidents] &gt; 0&#10;                 THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [customer_incidents]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [customer_incidents] &gt; 0 AND&#10;           [report_date_local] = &#10;           DATEADD(&apos;day&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;daily&quot; AND [customer_incidents] &gt; 0&#10;                 THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [customer_incidents]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Customer IO Denominator: Current' datatype='integer' name='[Od Gross Orders: Current (copy)_6207086224584155201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ EXCLUDE &#10;        [contact_language],&#10;        [fraud_flag],&#10;        [agent_category],&#10;        [agent_center],&#10;        [channel] :&#10;    SUM(&#10;        { FIXED&#10;            [Calculation_464222634176716803],&#10;            [company_name],&#10;            [country_name],&#10;            [vertical]:&#10;            [Customer IO Denominator: Current (copy)_6207086225189945435]&#10;        }&#10;      )&#10;   }&#10;)' />
            </column>
            <column caption='Customer IO Denominator: Previous' datatype='integer' name='[Od Gross Orders: Previous (copy)_6207086224584822850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ EXCLUDE &#10;        [contact_language],&#10;        [fraud_flag],&#10;        [agent_category],&#10;        [agent_center],&#10;        [channel] :&#10;    SUM(&#10;        { FIXED&#10;            [Calculation_464222634176716803],&#10;            [company_name],&#10;            [country_name],&#10;            [vertical]:&#10;            [Customer IO Denominator: Previous (copy)_6207086225192788060]&#10;        }&#10;      )&#10;   }&#10;)' />
            </column>
            <column caption='Report Date Local (formula)' datatype='datetime' name='[Parameter Filter: Exclude Latest Date (copy)_464222634262208537]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] THEN [Calculation_464222634225758221]&#10;ELSE [report_date_local]&#10;END' />
            </column>
            <column caption='Parameter Filter: Available Dates - Customer IO' datatype='boolean' name='[Parameter Filter: Exclude Latest Date (copy)_6207086225010876498]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; AND [class_date] = &quot;monthly&quot; THEN&#10;    DATETRUNC(&apos;month&apos;, [report_date_local]) &lt;= [Report Date Local - 1 (copy)_6207086225012142163]&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; AND [class_date] = &quot;weekly&quot; THEN&#10;    DATETRUNC(&apos;week&apos;, [report_date_local]) &lt;= [Report Date Local - 1 (copy)_6207086225012142163]&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; AND [class_date] = &quot;daily&quot; THEN&#10;    [report_date_local] &lt;= [Report Date Local - 1 (copy)_6207086225012142163]&#10;&#10;END' />
            </column>
            <column caption='Max Date: Gross Orders Excld Odr' datatype='datetime' name='[Report Date Local - 1 (copy)_6207086225012142163]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    { FIXED : MAX(&#10;        IF [class_date] = &quot;monthly&quot;&#10;        AND [Date: Od Gross Orders (copy)_6207086225209409632] &gt; 0&#10;        THEN DATETRUNC(&apos;month&apos;, [report_date_local])&#10;        END&#10;    ) }&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    { FIXED : MAX(&#10;        IF [class_date] = &quot;weekly&quot;&#10;        AND [Date: Od Gross Orders (copy)_6207086225209409632] &gt; 0&#10;        THEN DATETRUNC(&apos;week&apos;, [report_date_local])&#10;        END&#10;    ) }&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    { FIXED : MAX(&#10;        IF [class_date] = &quot;daily&quot;&#10;        AND [Date: Od Gross Orders (copy)_6207086225209409632] &gt; 0&#10;        THEN [report_date_local]&#10;        END&#10;    ) }&#10;&#10;END' />
