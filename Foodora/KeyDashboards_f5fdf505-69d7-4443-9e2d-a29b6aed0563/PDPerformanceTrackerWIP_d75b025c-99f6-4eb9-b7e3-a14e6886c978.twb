            <column caption='Rider IO: XoX' datatype='real' default-format='p0.00%' name='[Total Incident Count: XoX (copy)_464222634289131552 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(([Customer Incidents: Current (copy)_6207086224583376959]/[Od Gross Orders: Current (copy)_6207086224584155201 1]),4)&#10;-&#10;ROUND(([Od Gross Orders: Previous (copy)_6207086224583958592]/[Od Gross Orders: Previous (copy)_6207086224584822850 1]),4)' />
