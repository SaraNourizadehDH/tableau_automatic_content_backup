            <column caption='SLA: XoX Color' datatype='integer' name='[AHT: XoX Color (copy)_6207086223476760580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Escalation Rate: XoX (copy)_6207086223474049024] &gt; 0 THEN 1 &#10;ELSEIF [Escalation Rate: XoX (copy)_6207086223474049024] &lt; 0 THEN -1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='SLA: XoX%' datatype='real' default-format='p0.00%' name='[AHT: XoX% (copy)_6207086223476535299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Escalation Rate: XoX (copy)_6207086223474049024]/([Total Handling Time Minutes: Previous (copy)_464222634356494372]/[Aht Denominator: Previous (copy)_6207086223762001926])' />
            </column>
            <column caption='Sla Denominator: Current' datatype='integer' name='[Aht Denominator: Current (copy)_6207086223761743877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [sla_denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;monthly&quot; AND [sla_denominator] &gt; 0&#10;               THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [sla_denominator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [sla_denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;weekly&quot; AND [sla_denominator] &gt; 0&#10;               THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [sla_denominator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [sla_denominator] &gt; 0 AND&#10;           [report_date_local] = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;daily&quot; AND [sla_denominator] &gt; 0&#10;               THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;               END&#10;             ) }&#10;        THEN [sla_denominator]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Sla Denominator: Previous' datatype='integer' name='[Aht Denominator: Previous (copy)_6207086223762001926]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [sla_denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;           DATEADD(&apos;month&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;monthly&quot; AND [sla_denominator] &gt; 0&#10;                 THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [sla_denominator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [sla_denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;           DATEADD(&apos;week&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;weekly&quot; AND [sla_denominator] &gt; 0&#10;                 THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [sla_denominator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [sla_denominator] &gt; 0 AND&#10;           [report_date_local] = &#10;           DATEADD(&apos;day&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;daily&quot; AND [sla_denominator] &gt; 0&#10;                 THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [sla_denominator]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Dimension Selection - Category' datatype='string' name='[Calculation_464222634198482949]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Country - Company&quot; THEN [company_name]&#10;WHEN &quot;Agent Category - Agent Center&quot; THEN [agent_category]&#10;END' />
            </column>
            <column caption='Parameter Filter: Granularity' datatype='boolean' name='[Calculation_464222634215763979]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN [class_date] = &quot;daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [class_date] = &quot;weekly&quot;&#10;WHEN &quot;Monthly&quot; THEN [class_date] = &quot;monthly&quot;&#10;END' />
            </column>
            <column caption='Report Date Local - 1' datatype='datetime' name='[Calculation_464222634225758221]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    DATEADD(&apos;month&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;monthly&quot;&#10;          THEN DATETRUNC(&apos;month&apos;, [report_date_local])&#10;          END&#10;        ) }&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    DATEADD(&apos;week&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;weekly&quot; &#10;          THEN DATETRUNC(&apos;week&apos;, [report_date_local])&#10;          END&#10;        ) }&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    DATEADD(&apos;day&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;daily&quot;&#10;          THEN [report_date_local]&#10;          END&#10;        ) }&#10;    )&#10;&#10;END' />
            </column>
            <column caption='Parameter Filter: Exclude Latest Date' datatype='boolean' name='[Calculation_464222634230087696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] THEN&#10;    IF [Parameters].[Parameter 1] = &quot;Monthly&quot; AND [class_date] = &quot;monthly&quot; THEN&#10;        DATETRUNC(&apos;month&apos;, [report_date_local]) &lt;= [Calculation_464222634225758221]&#10;&#10;    ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; AND [class_date] = &quot;weekly&quot; THEN&#10;        DATETRUNC(&apos;week&apos;, [report_date_local]) &lt;= [Calculation_464222634225758221]&#10;&#10;    ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; AND [class_date] = &quot;daily&quot; THEN&#10;        [report_date_local] &lt;= [Calculation_464222634225758221]&#10;&#10;    END&#10;ELSE&#10;    TRUE&#10;END' />
            </column>
            <column caption='Dimension Selection - SubCategory' datatype='string' name='[Dimension Selection - Category (copy)_464222634200711174]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Country - Company&quot; THEN [country_name]&#10;WHEN &quot;Agent Category - Agent Center&quot; THEN [agent_center]&#10;END' />
            </column>
            <column caption='Display: XoX%' datatype='string' name='[Display: XoX (copy)_464222634236555283]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN &quot;DoD%&quot;&#10;WHEN &apos;Weekly&apos; THEN &quot;WoW%&quot;&#10;WHEN &apos;Monthly&apos; THEN &quot;MoM%&quot;&#10;END' />
            </column>
            <column caption='SLA: XoX' datatype='real' default-format='p0.00%' name='[Escalation Rate: XoX (copy)_6207086223474049024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Total Handling Time Minutes: Current (copy)_464222634356158499]/[Aht Denominator: Current (copy)_6207086223761743877])&#10;-&#10;([Total Handling Time Minutes: Previous (copy)_464222634356494372]/[Aht Denominator: Previous (copy)_6207086223762001926])' />
            </column>
            <column caption='Report Date Local (formula)' datatype='datetime' name='[Parameter Filter: Exclude Latest Date (copy)_464222634262208537]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] THEN [Calculation_464222634225758221]&#10;ELSE [report_date_local]&#10;END' />
            </column>
            <column caption='Incident Count Within Sla: Current' datatype='integer' name='[Total Handling Time Minutes: Current (copy)_464222634356158499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [sla_denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;monthly&quot; AND [sla_denominator] &gt; 0&#10;               THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [incident_count_within_sla]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [sla_denominator]&gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;weekly&quot; AND [sla_denominator] &gt; 0&#10;               THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [incident_count_within_sla]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [sla_denominator] &gt; 0 AND&#10;           [report_date_local] = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;daily&quot; AND [sla_denominator] &gt; 0&#10;               THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;               END&#10;             ) }&#10;        THEN [incident_count_within_sla]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Incident Count Within Sla: Previous' datatype='integer' name='[Total Handling Time Minutes: Previous (copy)_464222634356494372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [sla_denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date_local]) = &#10;           DATEADD(&apos;month&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;monthly&quot; AND [sla_denominator] &gt; 0&#10;                 THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [incident_count_within_sla]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [sla_denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date_local]) = &#10;           DATEADD(&apos;week&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;weekly&quot; AND [sla_denominator] &gt; 0&#10;                 THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [incident_count_within_sla]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [sla_denominator] &gt; 0 AND&#10;           [report_date_local] = &#10;           DATEADD(&apos;day&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;daily&quot; AND [sla_denominator] &gt; 0&#10;                 THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [incident_count_within_sla]&#10;        END&#10;    )&#10;END' />
