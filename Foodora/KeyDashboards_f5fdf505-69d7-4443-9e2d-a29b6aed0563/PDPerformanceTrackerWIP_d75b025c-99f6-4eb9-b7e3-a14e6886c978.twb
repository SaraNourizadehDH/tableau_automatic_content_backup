              <calculation class='tableau' formula='([Total Handling Time Minutes: Current (copy)_464222634288275486]/[Numerator: Current (copy)_6207086223805902861])&#10;-&#10;([Denominator: Previous (copy)_6207086223806418958]/[Total Handling Time Minutes: Previous (copy)_464222634288898079])' />
