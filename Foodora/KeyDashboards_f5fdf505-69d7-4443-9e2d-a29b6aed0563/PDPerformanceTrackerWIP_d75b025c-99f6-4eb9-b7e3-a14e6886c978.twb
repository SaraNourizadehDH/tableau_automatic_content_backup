      <aliases enabled='yes' />
      <column caption='Numerator: XoX Color' datatype='integer' name='[AHT: XoX Color (copy)_464222634606571570 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Total Incident Count: XoX (copy)_464222634289131552 1] &gt; 0 THEN 1&#10;ELSEIF [Total Incident Count: XoX (copy)_464222634289131552 1] &lt; 0 THEN -1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Metric Figure: XoX Color' datatype='integer' name='[AHT: XoX Color (copy)_464222634606571570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Total Incident Count: XoX (copy)_464222634289131552] &gt; 0 THEN 1&#10;ELSEIF [Total Incident Count: XoX (copy)_464222634289131552] &lt; 0 THEN -1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Numerator: XoX Symbol' datatype='string' name='[AHT: XoX Symbol (copy)_464222634605854769 1]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Total Incident Count: XoX (copy)_464222634289131552 1] &gt; 0 THEN &quot;▲&quot; &#10;ELSEIF [Total Incident Count: XoX (copy)_464222634289131552 1]&lt; 0 THEN &quot;▼&quot;&#10;ELSEIF [Total Incident Count: XoX (copy)_464222634289131552 1] = 0 THEN &quot;=&quot;&#10;END' />
      </column>
      <column caption='Metric Figure: XoX Symbol' datatype='string' name='[AHT: XoX Symbol (copy)_464222634605854769]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Total Incident Count: XoX (copy)_464222634289131552] &gt; 0 THEN &quot;▲&quot; &#10;ELSEIF [Total Incident Count: XoX (copy)_464222634289131552]&lt; 0 THEN &quot;▼&quot;&#10;ELSEIF [Total Incident Count: XoX (copy)_464222634289131552] = 0 THEN &quot;=&quot;&#10;END' />
      </column>
      <column caption='Granularity - Month' datatype='string' name='[Calculation_464222634176135169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [class_date] = &quot;monthly&quot; THEN &#10;&#10;IF month([report_date]) &lt; 10 THEN STR(YEAR([report_date])) + &quot;-0&quot; + STR(MONTH([report_date]))&#10;ELSE STR(YEAR([report_date])) + &quot;-&quot; + STR(MONTH([report_date]))&#10;END&#10;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Granularity - Week' datatype='string' name='[Calculation_464222634176548866]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [class_date] = &quot;weekly&quot; THEN &#10;STR([report_date]) + &#10; IF ISOWEEK([report_date]) &lt; 10&#10;   THEN &quot; (W0&quot; + STR(ISOWEEK([report_date])) + &quot;)&quot;&#10;   ELSE &quot; (W&quot; + STR(ISOWEEK([report_date])) + &quot;)&quot;&#10;   END&#10;  ELSE NULL&#10;&#10; //IF ISOWEEK([Report Date Local]) &lt; 10&#10;   //THEN STR(ISOYEAR([Report Date Local])) + &quot;-W0&quot; + STR(ISOWEEK([Report Date Local]))&#10;   //ELSE STR(ISOYEAR([Report Date Local])) + &quot;-W&quot; + STR(ISOWEEK([Report Date Local]))&#10;   //END&#10;  //ELSE NULL&#10;END' />
      </column>
      <column caption='Granularity - Day' datatype='string' name='[Calculation_464222634176843780]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [class_date] = &quot;daily&quot; THEN &#10;&#10;STR(DATE([report_date]))&#10;ELSE NULL&#10;&#10;END' />
      </column>
      <column caption='Parameter Filter: Granularity' datatype='boolean' name='[Calculation_464222634215763979]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN [class_date] = &quot;daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [class_date] = &quot;weekly&quot;&#10;WHEN &quot;Monthly&quot; THEN [class_date] = &quot;monthly&quot;&#10;END' />
      </column>
      <column caption='Report Date - 1' datatype='datetime' name='[Calculation_464222634225758221]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    DATEADD(&apos;month&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;monthly&quot;&#10;          THEN DATETRUNC(&apos;month&apos;, [report_date])&#10;          END&#10;        ) }&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    DATEADD(&apos;week&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;weekly&quot; &#10;          THEN DATETRUNC(&apos;week&apos;, [report_date])&#10;          END&#10;        ) }&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    DATEADD(&apos;day&apos;, -1,&#10;      { FIXED : MAX(&#10;          IF [class_date] = &quot;daily&quot;&#10;          THEN [report_date]&#10;          END&#10;        ) }&#10;    )&#10;&#10;END' />
      </column>
      <column caption='Parameter Filter: Exclude Latest Date' datatype='boolean' name='[Calculation_464222634230087696]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] THEN&#10;    IF [Parameters].[Parameter 1] = &quot;Monthly&quot; AND [class_date] = &quot;monthly&quot; THEN&#10;        DATETRUNC(&apos;month&apos;, [report_date]) &lt;= [Calculation_464222634225758221]&#10;&#10;    ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; AND [class_date] = &quot;weekly&quot; THEN&#10;        DATETRUNC(&apos;week&apos;, [report_date]) &lt;= [Calculation_464222634225758221]&#10;&#10;    ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; AND [class_date] = &quot;daily&quot; THEN&#10;        [report_date] &lt;= [Calculation_464222634225758221]&#10;&#10;    END&#10;ELSE&#10;    TRUE&#10;END' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_6207086223791054855]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN [Calculation_464222634176843780]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_464222634176548866]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_464222634176135169]&#10;END' />
      </column>
      <column caption='Display: Trendline' datatype='string' name='[Calculation_6207086223791165449]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Trendline&quot;' />
      </column>
      <column caption='Display: XoX' datatype='string' name='[Calculation_6207086223791296522]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN &quot;DoD&quot;&#10;WHEN &apos;Weekly&apos; THEN &quot;WoW&quot;&#10;WHEN &apos;Monthly&apos; THEN &quot;MoM&quot;&#10;END' />
      </column>
      <column caption='Display: XoX Symbol' datatype='string' name='[Calculation_6207086223791513611]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Display: XoX%' datatype='string' name='[Calculation_6207086223791616012]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN &quot;DoD%&quot;&#10;WHEN &apos;Weekly&apos; THEN &quot;WoW%&quot;&#10;WHEN &apos;Monthly&apos; THEN &quot;MoM%&quot;&#10;END' />
      </column>
      <column caption='Metric Figure' datatype='real' default-format='p0.00%' name='[Calculation_6207086223807463439]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([numerator])/SUM([denominator])' />
      </column>
      <column caption='Numerator: Previous' datatype='integer' name='[Denominator: Previous (copy)_6207086223806418958]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [numerator] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date]) = &#10;           DATEADD(&apos;month&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;monthly&quot; AND [numerator] &gt; 0&#10;                 THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [numerator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [numerator] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date]) = &#10;           DATEADD(&apos;week&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;weekly&quot; AND [numerator] &gt; 0&#10;                 THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [numerator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [numerator] &gt; 0 AND&#10;           [report_date] = &#10;           DATEADD(&apos;day&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;daily&quot; AND [numerator] &gt; 0&#10;                 THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [numerator]&#10;        END&#10;    )&#10;END' />
      </column>
      <column caption='Denominator: Current' datatype='integer' name='[Numerator: Current (copy)_6207086223805902861]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;monthly&quot; AND [denominator] &gt; 0&#10;               THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [denominator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;weekly&quot; AND [denominator] &gt; 0&#10;               THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [denominator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [denominator] &gt; 0 AND&#10;           [report_date] = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;daily&quot; AND [denominator] &gt; 0&#10;               THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;               END&#10;             ) }&#10;        THEN [denominator]&#10;        END&#10;    )&#10;END' />
      </column>
      <column caption='Report Date (formula)' datatype='datetime' name='[Parameter Filter: Exclude Latest Date (copy)_464222634262208537]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] THEN [Calculation_464222634225758221]&#10;ELSE [report_date]&#10;END' />
