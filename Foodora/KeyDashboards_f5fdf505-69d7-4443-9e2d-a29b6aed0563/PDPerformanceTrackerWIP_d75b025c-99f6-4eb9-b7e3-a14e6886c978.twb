              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; AND [class_date] = &quot;monthly&quot; THEN&#10;    DATETRUNC(&apos;month&apos;, [report_date_local]) &lt;= [Max Date: Od Gross Orders (copy)_6207086225222004838]&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; AND [class_date] = &quot;weekly&quot; THEN&#10;    DATETRUNC(&apos;week&apos;, [report_date_local]) &lt;= [Max Date: Od Gross Orders (copy)_6207086225222004838]&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; AND [class_date] = &quot;daily&quot; THEN&#10;    [report_date_local] &lt;= [Max Date: Od Gross Orders (copy)_6207086225222004838]&#10;&#10;END' />
