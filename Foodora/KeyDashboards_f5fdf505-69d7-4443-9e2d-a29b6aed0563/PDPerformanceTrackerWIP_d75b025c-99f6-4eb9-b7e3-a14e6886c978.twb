              <calculation class='tableau' formula='[Total Incident Count: XoX (copy)_464222634289131552]/ROUND(([Denominator: Previous (copy)_6207086223806418958]/[Total Handling Time Minutes: Previous (copy)_464222634288898079]), 4)' />
