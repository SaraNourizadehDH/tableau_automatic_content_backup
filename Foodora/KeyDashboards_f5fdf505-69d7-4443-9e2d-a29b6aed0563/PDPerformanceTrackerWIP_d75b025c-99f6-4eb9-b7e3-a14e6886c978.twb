              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;monthly&quot; AND [denominator] &gt; 0&#10;               THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [numerator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date]) = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;weekly&quot; AND [denominator] &gt; 0&#10;               THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;               END&#10;             ) }&#10;        THEN [numerator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [denominator] &gt; 0 AND&#10;           [report_date] = &#10;           { FIXED : MAX(&#10;               IF [class_date] = &quot;daily&quot; AND [denominator] &gt; 0&#10;               THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;               END&#10;             ) }&#10;        THEN [numerator]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Denominator: Previous' datatype='integer' name='[Total Handling Time Minutes: Previous (copy)_464222634288898079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;monthly&quot; AND&#10;           [denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;month&apos;, [report_date]) = &#10;           DATEADD(&apos;month&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;monthly&quot; AND [denominator] &gt; 0&#10;                 THEN DATETRUNC(&apos;month&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [denominator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Weekly&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;weekly&quot; AND&#10;           [denominator] &gt; 0 AND&#10;           DATETRUNC(&apos;week&apos;, [report_date]) = &#10;           DATEADD(&apos;week&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;weekly&quot; AND [denominator] &gt; 0&#10;                 THEN DATETRUNC(&apos;week&apos;, [Parameter Filter: Exclude Latest Date (copy)_464222634262208537])&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [denominator]&#10;        END&#10;    )&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Daily&quot; THEN&#10;    SUM(&#10;        IF [class_date] = &quot;daily&quot; AND&#10;           [denominator] &gt; 0 AND&#10;           [report_date] = &#10;           DATEADD(&apos;day&apos;, -1,&#10;             { FIXED : MAX(&#10;                 IF [class_date] = &quot;daily&quot; AND [denominator] &gt; 0&#10;                 THEN [Parameter Filter: Exclude Latest Date (copy)_464222634262208537]&#10;                 END&#10;               ) }&#10;           )&#10;        THEN [denominator]&#10;        END&#10;    )&#10;END' />
            </column>
            <column caption='Metric Figure: XoX' datatype='real' default-format='p0.00%' name='[Total Incident Count: XoX (copy)_464222634289131552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Total Handling Time Minutes: Current (copy)_464222634288275486]/[Numerator: Current (copy)_6207086223805902861])&#10;-&#10;([Denominator: Previous (copy)_6207086223806418958]/[Total Handling Time Minutes: Previous (copy)_464222634288898079])' />
