              <calculation class='tableau' formula='IF ISNULL(ATTR([case_type])) OR ATTR([case_type]) = &quot;*&quot; THEN&#10;    [Success Rate Prep (copy)_6207086224310984742]&#10;ELSEIF ATTR([case_type]) = &quot;Contract QC&quot; THEN&#10;    [Qc Total Closed Cases: Current (copy)_6207086224302043168]&#10;ELSE&#10;    [Success Rate Prep (copy)_6207086224310984742]&#10;END' />
