            <column caption='Parameter Filter: Granularity' datatype='boolean' name='[Calculation_464222634215763979]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN [class_date] = &quot;daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [class_date] = &quot;weekly&quot;&#10;WHEN &quot;Monthly&quot; THEN [class_date] = &quot;monthly&quot;&#10;END' />
