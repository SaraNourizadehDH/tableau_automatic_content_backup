        <calculation class='tableau' formula='COUNTD(IF DATETRUNC(&apos;month&apos;, [term_start_date]) = DATETRUNC(&apos;month&apos;,[month_local])&#10;THEN [global_entity_id]+[Calculation_2377830254028222469]&#10;ELSE NULL&#10;END)' />
