      <column caption='DIP $ vs OKR' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_854769155856097281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monthly_recurring_amount_eur])-SUM([federated.0l7rzap1m1lsgf11jzanj0rwpxtx].[NMR (€) through Data Insights Portal])' />
      </column>
      <column caption='DIP $ Highlight' datatype='string' name='[Calculation_854769155857543170]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;SUM([federated.0l7rzap1m1lsgf11jzanj0rwpxtx].[NMR (€) through Data Insights Portal]) = 0 THEN &quot;No Target&quot;&#10;ELSEIF SUM([monthly_recurring_amount_eur]) &lt; SUM([federated.0l7rzap1m1lsgf11jzanj0rwpxtx].[NMR (€) through Data Insights Portal])&#10;THEN &quot;Below Target&quot; &#10;ELSE &quot;Above Target&quot;&#10;END' />
