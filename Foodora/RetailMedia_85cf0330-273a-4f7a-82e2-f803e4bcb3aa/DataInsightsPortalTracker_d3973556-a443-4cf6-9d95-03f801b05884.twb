      <column caption='CPG / Supplier' datatype='string' name='[Calculation_2377830254028222469]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([srm_principal] = &quot;-&quot;, [account_name], [srm_principal])' />
      </column>
      <column caption='Contract Duration' datatype='integer' name='[Calculation_2377830254051246087]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[term_start_date],[term_end_date])+1' />
      </column>
      <column caption='Regional / Local Deal' datatype='string' name='[Calculation_2377830254144503821]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(ISNULL([is_regional]), &quot;Local&quot;, &quot;Regional&quot;)' />
      </column>
      <column aggregation='Attribute' caption='Current Month (DIP $)' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_2377830254146629646]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [month_local]: SUM(IIF([month_local] = DATETRUNC(&apos;month&apos;,TODAY()-1) AND [global_term_name] = &quot;Data Sharing Allowance&quot;,[monthly_recurring_amount_eur],NULL))}' />
      </column>
      <column caption='% Change in DIP Amount' datatype='real' default-format='*▲+0.00%;▼-0.00%; -' name='[Calculation_2377830254149230608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2377830254146629646]-[Current Month (DIP $) (copy)_2377830254148956175])/[Current Month (DIP $) (copy)_2377830254148956175]' />
      </column>
      <column caption='Access Type' datatype='string' name='[Calculation_4206010259325091840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([srm_principal] = &quot;-&quot;, &quot;Supplier&quot;, &quot;Principal&quot;)' />
      </column>
      <column caption='Previous Total Sign Ups' datatype='integer' name='[Calculation_5805351085661327360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='/*{FIXED [Month Local]: IIF(MIN([Month Local]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-1)), [Number of Active DIP Sign Ups], NULL)}&#10;*/&#10;&#10;LOOKUP([Calculation_6790161652780298242], -1)&#10;/*IIF(MIN([Month Local]) = DATETRUNC(&apos;month&apos;,TODAY()-1),[Number of Active DIP Sign Ups],NULL)*/'>
          <table-calc ordering-type='Rows' />
        </calculation>
