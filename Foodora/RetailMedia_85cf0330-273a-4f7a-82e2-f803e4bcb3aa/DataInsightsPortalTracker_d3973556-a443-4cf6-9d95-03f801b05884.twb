            <column caption='CPG / Supplier' datatype='string' name='[Calculation_2377830254028222469]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([srm_principal] = &quot;-&quot;, [account_name], [srm_principal])' />
            </column>
            <column caption='Previous Total Sign Ups' datatype='integer' name='[Calculation_5805351085661327360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*{FIXED [Month Local]: IIF(MIN([Month Local]) = DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-1)), [Number of Active DIP Sign Ups], NULL)}&#10;*/&#10;&#10;LOOKUP([Calculation_6790161652780298242], -1)&#10;/*IIF(MIN([Month Local]) = DATETRUNC(&apos;month&apos;,TODAY()-1),[Number of Active DIP Sign Ups],NULL)*/'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Change in Sign Ups' datatype='integer' name='[Calculation_5805351085661605889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Number of New Sign Ups (copy)_2377830253997887490] - [Calculation_5805351085661327360]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_605030505212329984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [User Filter 1]&#10;END' />
            </column>
            <column caption='Number of Active DIP Sign Ups' datatype='integer' name='[Calculation_6790161652780298242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IIF([Calculation_854769155859800068] IN(&quot;Active&quot;), [global_entity_id]+[Calculation_2377830254028222469],NULL))' />
            </column>
            <column caption='Monthly Status' datatype='string' name='[Calculation_854769155859800068]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(&#10;DATETRUNC(&apos;month&apos;, [month_local])&gt;=DATETRUNC(&apos;month&apos;, [term_start_date] )&#10;AND DATETRUNC(&apos;month&apos;, [month_local])&lt;= [rebate_calculation_end_date]&#10;AND [contract_status] != &quot;Inactive&quot;&#10;, &quot;Active&quot;, &quot;Inactive&quot;)' />
            </column>
            <column caption='Current Total Sign Ups' datatype='integer' name='[Number of New Sign Ups (copy)_2377830253997887490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(MIN([month_local]) = DATETRUNC(&apos;month&apos;,TODAY()-1),[Calculation_6790161652780298242],NULL)' />
            </column>
