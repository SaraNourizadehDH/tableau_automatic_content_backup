              <calculation class='tableau' formula='IIF([srm_principal] = &quot;-&quot;, [account_name], [srm_principal])' />
            </column>
            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_605030505212329984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [User Filter 1]&#10;END' />
            </column>
            <column caption='Number of Active DIP Sign Ups' datatype='integer' name='[Calculation_6790161652780298242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IIF([Calculation_854769155859800068] IN(&quot;Active&quot;), [global_entity_id]+[Calculation_2377830254028222469],NULL))' />
            </column>
            <column caption='Monthly Status' datatype='string' name='[Calculation_854769155859800068]' role='dimension' type='nominal'>
