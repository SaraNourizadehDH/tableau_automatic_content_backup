        <calculation class='tableau' formula='{EXCLUDE [month_local]: SUM(IIF([month_local] = DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())) AND [global_term_name] = &quot;Data Sharing Allowance&quot;,[monthly_recurring_amount_eur],NULL))}' />
