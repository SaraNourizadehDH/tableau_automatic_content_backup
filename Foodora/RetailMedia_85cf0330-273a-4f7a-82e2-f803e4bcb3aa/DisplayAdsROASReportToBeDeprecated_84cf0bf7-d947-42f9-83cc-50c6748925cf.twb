      <column caption='Base Metric' datatype='real' name='[ATTR (copy)_901775522533441537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &quot;GFV&quot;&#10;THEN [gfv]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Quantity&quot;&#10;THEN [quantity]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Orders&quot;&#10;THEN [orders]&#10;END' />
      </column>
      <column caption='New' datatype='real' name='[Calculation_3327034231257460736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &quot;GFV&quot;&#10;THEN [new_gfv]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Quantity&quot;&#10;THEN [new_quantity]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Orders&quot;&#10;THEN [new_orders]&#10;END' />
      </column>
      <column caption='% New' datatype='real' default-format='p0%' name='[Calculation_3327034231258697731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3327034231257460736])/SUM([Calculation_901775522533081088])' />
      </column>
      <column caption='Zero' datatype='integer' name='[Calculation_3327034231265669127]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Existing' datatype='real' name='[Calculation_3327034231267319816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_901775522533081088]-[Calculation_3327034231257460736]' />
      </column>
      <column caption='Five' datatype='integer' name='[Calculation_3327034231268569101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='5' />
      </column>
      <column caption='Three' datatype='integer' name='[Calculation_3327034231268753422]' role='measure' type='quantitative'>
