      <column caption='Four' datatype='integer' name='[Calculation_3327034231268798479]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='4' />
      </column>
      <column caption='is pandamart' datatype='boolean' name='[Calculation_4080894605829836800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS(lower([chain_name]),&quot;pandamart&quot;)' />
      </column>
      <column caption='Chain Code Concat' datatype='string' name='[Calculation_47569275137515521]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_513551098813304842] = 1 THEN ATTR([chain_code])&#10;ELSE PREVIOUS_VALUE(ATTR([chain_code])) + &apos;, &apos; + ATTR([chain_code])&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Size' datatype='integer' name='[Calculation_47569275143036932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SIZE()'>
