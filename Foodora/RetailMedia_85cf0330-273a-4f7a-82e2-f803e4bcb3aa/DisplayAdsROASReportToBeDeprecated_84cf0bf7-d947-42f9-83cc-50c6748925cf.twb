              <zone forceUpdate='true' h='8100' id='7' type-v2='text' w='38702' x='60498' y='43100'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#82ba63' fontsize='11'>Summary Cards for Selected Metric</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run bold='true' fontalignment='1' fontsize='10'>Comparison of Selected Metric with Pre, During &amp; Post Campaign Period</run>
                  <run fontalignment='1'>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='28499' id='8' type-v2='text' w='26201' x='72999' y='63400'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#ff2783' fontsize='11'>% attributed:</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run bold='true' fontalignment='1' fontsize='10'>% of contribution to total metric, by attribution from campaign</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run fontalignment='1' italic='true'>* values shown directly on the bar graph</run>
                  <run fontalignment='1'>Æ&#10;&#10;</run>
                  <run bold='true' fontalignment='1' fontcolor='#b8209d' fontsize='12'>% new: </run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run bold='true' fontalignment='1' fontsize='10'>% of attributed metric that are new to chain/vendor/product</run>
                  <run fontalignment='1'>Æ&#10;&#10;</run>
                  <run fontalignment='1' italic='true'>*Hover over the bars to reveal the raw values and percentages of the attributed and new-to metrics in the tool-tip</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='7702' id='12' type-v2='text' w='38806' x='60394' y='20498'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#ff2783' fontsize='10'>% New to chain/vendor/sku </run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run bold='true' fontalignment='1' fontcolor='#ff2783' fontsize='10'>= (Total New Metric/ Total Attributed Metric) *100</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='8000' id='13' type-v2='text' w='38702' x='60498' y='51200'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#ffc600' fontsize='11'>Summary Cards for Attributed Metric</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run bold='true' fontalignment='1' fontsize='10'>Review of Attributed Metric During &amp; Post Campaign</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='7702' id='14' type-v2='text' w='38996' x='21398' y='20498'>
                <formatted-text>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run bold='true' fontalignment='1' fontcolor='#ff2783' fontsize='10'>ROAS = Total GFV of Attributed Orders / Campaign Budget*</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run fontalignment='1' fontcolor='#ff2783' fontsize='8' italic='true'>*Campaign budget = Total impressions delivered * CPM/1000</run>
                  <run fontalignment='1'>Æ&#10;&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='7800' id='15' type-v2='text' w='38806' x='60394' y='12698'>
                <formatted-text>
                  <run bold='true' fontalignment='1'>New sales are attributed sales coming from customers who have not purchased the SKU or purchased from the chain/vendor in the last 6 weeks before the start of the campaign</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='10900' id='6' type-v2='text' w='38702' x='60498' y='32200'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#28947f' fontsize='11'>Metrics available:</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run bold='true' fontalignment='1' fontsize='10'>GFV, Quantity Sold, Orders </run>
                  <run bold='true' fontalignment='1' fontsize='8'>(Exclusive to ROAS Chain and Vendors)</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run bold='true' fontalignment='1' fontsize='8' italic='true'>*Select Campaign_Id and Metric in the dropdown box to customise view.</run>
                </formatted-text>
                <zone-style>
