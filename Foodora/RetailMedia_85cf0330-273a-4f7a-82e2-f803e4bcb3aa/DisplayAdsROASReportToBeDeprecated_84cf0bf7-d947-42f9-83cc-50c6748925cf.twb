          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Chain Name Concat' datatype='string' name='[Calculation_47569275144044550]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_513551098813304842] = 1 THEN ATTR([chain_name])&#10;ELSE PREVIOUS_VALUE(ATTR([chain_name])) + &apos;, &apos; + ATTR([chain_name])&#10;END'>
          <table-calc ordering-type='Rows' />
