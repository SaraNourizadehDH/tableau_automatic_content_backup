              <calculation class='tableau' formula='IF [Calculation_3327034231333347350] = 1 THEN ATTR([vendor_code])&#10;ELSE PREVIOUS_VALUE(ATTR([vendor_code])) + &apos;, &apos; + ATTR([vendor_code])&#10;END'>
