            <column caption='Legit ID' datatype='boolean' name='[Calculation_6837238355044876289]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [new_campaign_id]: sum(attr_orders) &gt; 0}' />
