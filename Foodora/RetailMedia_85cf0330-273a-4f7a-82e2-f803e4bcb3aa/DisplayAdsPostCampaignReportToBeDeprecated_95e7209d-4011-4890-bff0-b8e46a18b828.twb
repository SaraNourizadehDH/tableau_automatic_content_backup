      <aliases enabled='yes' />
      <column caption='Segment Classification' datatype='string' name='[Calculation_1074249285328699392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([classification], &quot;bank&quot;) THEN &quot;Bank&quot;&#10;ELSEIF CONTAINS([classification], &quot;cuisine&quot;) THEN &quot;Cuisine&quot;&#10;ELSEIF CONTAINS([classification], &quot;handset&quot;) THEN &quot;Handset&quot;&#10;ELSEIF CONTAINS([classification], &quot;location&quot;) THEN &quot;Location&quot;&#10;ELSEIF CONTAINS([classification], &quot;payment&quot;) THEN &quot;Payment&quot;&#10;ELSEIF CONTAINS([classification], &quot;telco&quot;) THEN &quot;Telco&quot;&#10;END' />
      </column>
      <column caption='Ranking' datatype='integer' name='[Calculation_1100144986049880064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([total_clicked_customers]) ,&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Test' datatype='integer' name='[Calculation_1100144986052608001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [classification] = &quot;frequent_cuisine_recent&quot; THEN [total_clicked_customers] ELSE 0 END)' />
      </column>
      <column caption='Behavioural Profile Descriptions' datatype='string' name='[Calculation_1433552121103896576]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [segment] &#10;WHEN &quot;Intentional Buyer&quot;&#10;    THEN &quot; Users who browse and land on transaction pages (users are spending a lot of time on pages nearing the end of order)&quot;&#10;WHEN &quot;Indecisive Buyer&quot;&#10;    THEN &quot;Users who browse and land on cancel order pages (users are spending majority of time exiting the order process)&quot;&#10;WHEN  &quot;Deal Seeker&quot;&#10;    THEN &quot;Users who have spent a larger proportion of their app/web time exploring deal pages &amp; attempting to utilise vouchers &amp; discounts in last 30d&quot;&#10;WHEN &quot;Restaurant Explorer&quot;&#10;    THEN &quot;Users who have spent a larger proportion of their app/web time exploring restaurant-related pages&quot;&#10;WHEN  &quot;pandamart Vertical Explorer&quot;&#10;    THEN &quot;Users who have spent a larger proportion of their app/web time exploring pandamart-related pages&quot;&#10;WHEN &quot;pandaGo Explorer&quot;&#10;    THEN &quot;Users who have spent a larger proportion of their app/web time exploring pandaGo-related pages&quot;&#10;WHEN  &quot;Shops Vertical Explorer&quot;&#10;    THEN &quot;Users who have spent a larger proportion of their app/web time exploring shops-related pages&quot;&#10;WHEN &quot;Pickup Explorer&quot;&#10;    THEN &quot;Users who have spent a larger proportion of their app/web time exploring pickup-related pages&quot;&#10;WHEN &quot;Dine-in Explorer&quot;&#10;    THEN &quot;Users who have spent a larger proportion of their app/web time exploring dine-in-related pages&quot;&#10;WHEN &quot;Gamification Engaged Consumer&quot;&#10;    THEN &quot;Users who have spent a larger proportion of their app/web time exploring challenges &amp; rewards pages &amp; looking into utilising scratch card &amp; joker tier vouchers in last 30d&quot;&#10;WHEN &quot;pandaPro Enthusiast&quot;&#10;    THEN &quot;Users who spent a larger proportion of time on subscription related pages&quot;&#10;WHEN &quot;Review Seekers&quot;&#10;    THEN &quot;Users who have spent a larger proportion of their app/web time with review-related pages in last 30d&quot;&#10;END' />
      </column>
      <column caption='CTR' datatype='real' name='[Calculation_3184396815245103104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_clicks]) / sum([total_impressions])' />
      </column>
      <column caption='empty' datatype='integer' name='[Calculation_5417267422240296960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='min(1)' />
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_5862138622993850368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [segment] &lt;&gt; &apos;others&apos; and [segment] &lt;&gt; &apos;irrelevant&apos; THEN [total_clicked_customers]&#10;ELSEIF [segment] = &apos;irrelevant&apos; THEN -1 &#10;ELSE -2 END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='regional_apac_partnerships_panda_ads_pcr' datatype='table' name='[__tableau_internal_object_id__].[regional_apac_partnerships_panda_ads_pcr_9B07D5B5D2D84DE8A0AE65E12E0834F3]' role='measure' type='quantitative' />
      <column caption='Classification' datatype='string' name='[classification]' role='dimension' type='nominal' />
      <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
      <column caption='New Campaign Id' datatype='string' name='[new_campaign_id]' role='dimension' type='nominal' />
      <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
      <column caption='Customers' datatype='integer' name='[total_clicked_customers]' role='measure' type='quantitative' />
      <column caption='Total Clicks' datatype='integer' name='[total_clicks]' role='measure' type='quantitative' />
      <column caption='Total Customers' datatype='integer' name='[total_customers]' role='measure' type='quantitative' />
      <column caption='Total Impressions' datatype='integer' name='[total_impressions]' role='measure' type='quantitative' />
      <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
      <group name='[APAC User Filter]' name-style='unqualified' user:ui-builder='identity-set'>
        <groupfilter function='intersection'>
          <groupfilter function='level-members' level='[global_entity_id]' />
          <groupfilter function='union'>
            <groupfilter expression='false' function='filter'>
              <groupfilter function='level-members' level='[global_entity_id]' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_partnerships_FP_BD&apos;)' function='filter'>
              <groupfilter function='member' level='[global_entity_id]' member='&quot;FP_BD&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_partnerships_FP_HK&apos;)' function='filter'>
