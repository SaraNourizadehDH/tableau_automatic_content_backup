      <aliases enabled='yes' />
      <column caption='Campaign Period' datatype='string' name='[Calculation_1548042011704844288]' role='measure' type='nominal'>
        <calculation class='tableau' formula='str(MIN(DATE([started_at_local]))) + &quot; - &quot; + str(max(DATE([ended_at_local])))' />
      </column>
      <column caption='Ad Spend (Local)' datatype='real' name='[Calculation_1548042011706249217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[impressions] * [bid_local]/1000' />
      </column>
      <column caption='Reach' datatype='integer' name='[Calculation_2647553638336528384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [campaign_id]: Max([total_reach])}' />
      </column>
      <column caption='CTR' datatype='real' name='[Calculation_2647553638337658881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([clicks])/ SUM([impressions])' />
      </column>
      <column caption='Campaign' datatype='string' name='[Calculation_2647553638356758531]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([campaign_name_basic],[advertiser_name]) + &quot; (&quot; + [campaign_id] + &quot;)&quot;' />
      </column>
      <column caption='Click to Conversion' datatype='real' name='[Calculation_366761904270417920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([leads])/sum([clicks])' />
      </column>
      <column caption='Impression Ratio' datatype='real' name='[Calculation_366761904271007745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([impressions])/sum([Calculation_2647553638336528384])' />
      </column>
      <column caption='VCR 100%' datatype='real' name='[Calculation_366761904271151106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vcr_100])/sum([vcr_0])' />
      </column>
      <column caption='Lead Gen Campaign Filter' datatype='boolean' name='[Calculation_366761904274460676]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [campaign_id]: sum(leads)} &gt;1' />
      </column>
      <column caption='Video Campaign Filter' datatype='boolean' name='[Calculation_366761904275845125]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [campaign_id]: sum([vcr_0])} &gt;0' />
      </column>
      <column caption='Ad Format' datatype='string' name='[Calculation_4331336958607327233]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([leads]) &gt; 1 THEN &quot;Lead Generation&quot;&#10;ELSEIF SUM([vcr_0]) &gt; 1 THEN &quot;Video&quot;&#10;ELSE &quot;Static&quot; END' />
      </column>
      <column caption='Campaign Budget' datatype='real' name='[Calculation_4331336958632185858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_id]: max([budget_local])}' />
      </column>
      <column caption='Campaign Pricing' datatype='real' name='[Campaign Budget (copy)_4331336958632439811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_id]: max([bid_local])}' />
      </column>
      <column caption='Campaign Days' datatype='integer' name='[Campaign Period (copy)_4331336958580932608]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&quot;day&quot;, MIN(DATE([started_at_local])), MAX(DATE([ended_at_local])))' />
      </column>
      <column caption='VCR 50%' datatype='real' name='[VCR 100% (copy)_4331336958634229764]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vcr_50])/sum([vcr_0])' />
      </column>
