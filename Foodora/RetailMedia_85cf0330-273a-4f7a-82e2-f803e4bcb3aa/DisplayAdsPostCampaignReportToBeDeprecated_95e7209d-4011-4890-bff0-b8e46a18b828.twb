    <worksheet name='Incentive Sensitivity'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Medium' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pcr table' name='federated.1eafg980ermwki0zqn9ci0eijrcr' />
            <datasource caption='panda ads daily' name='federated.1xwowan0d1eist1falfdh12ir2b8' />
          </datasources>
          <datasource-dependencies datasource='federated.1eafg980ermwki0zqn9ci0eijrcr'>
            <column caption='CTR' datatype='real' name='[Calculation_3184396815245103104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_clicks]) / sum([total_impressions])' />
            </column>
            <column caption='Rank' datatype='integer' name='[Calculation_5862138622993850368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [segment] &lt;&gt; &apos;others&apos; and [segment] &lt;&gt; &apos;irrelevant&apos; THEN [total_clicked_customers]&#10;ELSEIF [segment] = &apos;irrelevant&apos; THEN -1 &#10;ELSE -2 END' />
            </column>
            <column caption='Classification' datatype='string' name='[classification]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='New Campaign Id' datatype='string' name='[new_campaign_id]' role='dimension' type='nominal' />
            <column-instance column='[classification]' derivation='None' name='[none:classification:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[new_campaign_id]' derivation='None' name='[none:new_campaign_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[total_clicked_customers]' derivation='Sum' name='[pcto:sum:total_clicked_customers:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5862138622993850368]' derivation='Sum' name='[sum:Calculation_5862138622993850368:qk]' pivot='key' type='quantitative' />
            <column caption='Customers' datatype='integer' name='[total_clicked_customers]' role='measure' type='quantitative' />
            <column caption='Total Clicks' datatype='integer' name='[total_clicks]' role='measure' type='quantitative' />
            <column caption='Total Impressions' datatype='integer' name='[total_impressions]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3184396815245103104]' derivation='User' name='[usr:Calculation_3184396815245103104:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xwowan0d1eist1falfdh12ir2b8'>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1eafg980ermwki0zqn9ci0eijrcr].[none:classification:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:classification:nk]' member='&quot;Bank&quot;' />
              <groupfilter function='member' level='[none:classification:nk]' member='&quot;incentive_value_sensitivity_group_recent&quot;' />
            </groupfilter>
          </filter>
          <computed-sort column='[federated.1eafg980ermwki0zqn9ci0eijrcr].[none:segment:nk]' direction='DESC' using='[federated.1eafg980ermwki0zqn9ci0eijrcr].[sum:Calculation_5862138622993850368:qk]' />
          <slices>
            <column>[federated.1eafg980ermwki0zqn9ci0eijrcr].[APAC User Filter]</column>
            <column>[federated.1eafg980ermwki0zqn9ci0eijrcr].[none:classification:nk]</column>
            <column>[federated.1eafg980ermwki0zqn9ci0eijrcr].[none:new_campaign_id:nk]</column>
            <column>[federated.1xwowan0d1eist1falfdh12ir2b8].[none:global_entity_id:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.1eafg980ermwki0zqn9ci0eijrcr].[pcto:sum:total_clicked_customers:qk]' field-type='quantitative' major-origin='0.0' major-spacing='0.5' scope='cols' type='space' />
            <format attr='display' class='0' field='[federated.1eafg980ermwki0zqn9ci0eijrcr].[pcto:sum:total_clicked_customers:qk]' scope='cols' value='false' />
            <format attr='tick-color' value='#00000000' />
            <format attr='stroke-size' value='0' />
