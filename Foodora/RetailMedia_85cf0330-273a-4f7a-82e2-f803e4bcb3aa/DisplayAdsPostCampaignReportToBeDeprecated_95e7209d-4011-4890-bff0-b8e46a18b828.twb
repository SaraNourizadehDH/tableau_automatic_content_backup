    <worksheet name='Creative Details (Static Lead)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Medium' fontsize='11'>Creative Details</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='panda ads creative agg' name='federated.0a8audt0oebdlz14upx0n1g69kwn' />
            <datasource caption='panda ads daily' name='federated.1xwowan0d1eist1falfdh12ir2b8' />
          </datasources>
          <datasource-dependencies datasource='federated.0a8audt0oebdlz14upx0n1g69kwn'>
            <column caption='Creative Link' datatype='string' name='[Calculation_2443273209727098880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([creative_image], &quot;&quot;)' />
            </column>
            <column caption='Creative Device Extract' datatype='string' name='[Calculation_2443273209742299137]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REGEXP_EXTRACT( [creative_name], &quot;^(?:[^_]+_){2}([^_ ]+)&quot;)' />
