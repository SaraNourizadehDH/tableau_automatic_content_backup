          <datasource-dependencies datasource='Parameters'>
            <column alias='Quarter' caption='Date Level Utilisation' datatype='string' name='[Date Level (copy)_4286512095165743104]' param-domain-type='list' role='measure' type='nominal' value='&quot;quarter&quot;'>
              <calculation class='tableau' formula='&quot;quarter&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;quarter&quot;' value='Quarter' />
