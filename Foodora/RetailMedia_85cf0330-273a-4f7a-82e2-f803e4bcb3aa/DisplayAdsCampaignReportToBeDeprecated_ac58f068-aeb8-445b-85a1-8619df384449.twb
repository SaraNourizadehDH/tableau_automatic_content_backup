            <column-instance column='[local_date]' derivation='Year' name='[yr:local_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <computed-sort column='[federated.0j3q2li1la2380107fhkw0slyyq3].[none:Calculation_5077104923982229509:nk]' direction='ASC' using='[federated.0j3q2li1la2380107fhkw0slyyq3].[min:Calculation_6456543401193967616:qk]' />
