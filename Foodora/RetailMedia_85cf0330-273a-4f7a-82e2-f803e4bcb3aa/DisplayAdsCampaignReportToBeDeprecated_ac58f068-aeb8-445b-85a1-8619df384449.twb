      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1p34e7l0380fyw0zob1ow1rn3t03].[max:total_requests:qk]&quot;' value='Total Requests' />
        </aliases>
      </column>
      <column caption='Date Format' datatype='string' name='[Calculation_1846968464968609794]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[End Date Parameter]&#10;WHEN &apos;year&apos; THEN DATENAME(&apos;year&apos;,[local_date])&#10;WHEN &apos;quarter&apos; THEN DATENAME(&apos;year&apos;,[local_date]) + &apos;-Q&apos; + DATENAME(&apos;quarter&apos;,[local_date])&#10;WHEN &apos;month&apos; THEN left(DATENAME(&apos;month&apos;,[local_date]),3) + &apos;-&apos; + STR(YEAR([local_date]))&#10;WHEN &apos;day&apos; THEN STR(DAY([local_date])) + &apos;-&apos; + left(DATENAME(&apos;month&apos;,[local_date]),3) + &apos;-&apos; + STR(YEAR([local_date]))&#10;WHEN &apos;week&apos; THEN DATENAME(&apos;year&apos;,[local_date]) + &apos;-&apos; + DATENAME(&apos;week&apos;,[local_date])&#10;END' />
      </column>
      <column caption='Utilisation' datatype='real' name='[Calculation_1846968465302188035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_impressions]) / sum([Calculation_2615043336293834753])' />
      </column>
      <column caption='Updated Placement' datatype='string' name='[Calculation_2033938227340177408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [ad_placement] IN (&quot;RLP&quot;, &quot;Homescreen&quot;) THEN &quot;Homescreen&quot;&#10;ELSE [ad_placement]&#10;end' />
      </column>
      <column caption='Is Today Filter' datatype='boolean' name='[Calculation_2033938227372695553]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[local_date] = DATE(today())' />
      </column>
      <column caption='Ad Type' datatype='string' name='[Calculation_2615043336293122048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([ad_type], &quot;Partnerships&quot;)' />
      </column>
      <column caption='Requests' datatype='integer' name='[Calculation_2615043336293834753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [Calculation_2033938227340177408], [local_date]: MAX([total_requests])}' />
      </column>
      <column caption='Date Format Daily' datatype='string' name='[Date Format (copy)_4867546800249212928]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Level (copy)_4286512095165743104]&#10;WHEN &apos;year&apos; THEN DATENAME(&apos;year&apos;,[local_date])&#10;WHEN &apos;quarter&apos; THEN DATENAME(&apos;year&apos;,[local_date]) + &apos;-Q&apos; + DATENAME(&apos;quarter&apos;,[local_date])&#10;WHEN &apos;month&apos; THEN left(DATENAME(&apos;month&apos;,[local_date]),3) + &apos;-&apos; + STR(YEAR([local_date]))&#10;WHEN &apos;day&apos; THEN STR(DAY([local_date])) + &apos;-&apos; + left(DATENAME(&apos;month&apos;,[local_date]),3) + &apos;-&apos; + STR(YEAR([local_date]))&#10;WHEN &apos;week&apos; THEN DATENAME(&apos;year&apos;,[local_date]) + &apos;-&apos; + DATENAME(&apos;week&apos;,[local_date])&#10;END' />
      </column>
