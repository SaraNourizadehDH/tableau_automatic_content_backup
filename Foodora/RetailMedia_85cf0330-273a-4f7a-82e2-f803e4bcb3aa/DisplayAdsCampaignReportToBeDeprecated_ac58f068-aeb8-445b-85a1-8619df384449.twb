    <worksheet name='Audience Segments'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='13'>Use of Audience Segments </run>
            <run fontsize='9' italic='true'>(advertisers per country per month)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='panda ads overview ' name='federated.0j3q2li1la2380107fhkw0slyyq3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Quarter' caption='Date Level' datatype='string' name='[End Date Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;quarter&quot;'>
              <calculation class='tableau' formula='&quot;quarter&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;quarter&quot;' value='Quarter' />
                <alias key='&quot;year&quot;' value='Year' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0j3q2li1la2380107fhkw0slyyq3'>
            <column caption='Updated Placement' datatype='string' name='[Calculation_1687653645309579264]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [ad_placement] = &quot;RLP&quot; THEN &quot;Homescreen&quot;&#10;ELSE [ad_placement] END' />
            </column>
            <column caption='Date Format' datatype='string' name='[Calculation_5077104923982229509]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[End Date Parameter]&#10;WHEN &apos;year&apos; THEN DATENAME(&apos;year&apos;,[local_date])&#10;WHEN &apos;quarter&apos; THEN DATENAME(&apos;year&apos;,[local_date]) + &apos;-Q&apos; + DATENAME(&apos;quarter&apos;,[local_date])&#10;WHEN &apos;month&apos; THEN left(DATENAME(&apos;month&apos;,[local_date]),3) + &apos;-&apos; + STR(YEAR([local_date]))&#10;WHEN &apos;day&apos; THEN STR(DAY([local_date])) + &apos;-&apos; + left(DATENAME(&apos;month&apos;,[local_date]),3) + &apos;-&apos; + STR(YEAR([local_date]))&#10;WHEN &apos;week&apos; THEN DATENAME(&apos;year&apos;,[local_date]) + &apos;-&apos; + DATENAME(&apos;week&apos;,[local_date])&#10;END' />
            </column>
            <column caption='Audience' datatype='string' name='[Calculation_5179561819065045000]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([audience_targeting_used],&apos;is_payment_type&apos;) THEN &apos;is_payment_type&apos;&#10;ELSEIF CONTAINS([audience_targeting_used],&apos;is_source&apos;) THEN &apos;is_source&apos;&#10;ELSEIF [audience_targeting_used] = &quot;&quot; THEN &apos;No Segment&apos;&#10;ELSE [audience_targeting_used]&#10;END' />
            </column>
            <column caption='Country Advertiser' datatype='string' name='[Calculation_5179561819065552905]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id] + &quot;_&quot; + [advertiser_name]' />
            </column>
            <column caption='Start Date Month' datatype='datetime' name='[Calculation_6456543401193967616]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;,[started_at_local])' />
            </column>
            <column caption='Placement' datatype='string' name='[ad_placement]' role='dimension' type='nominal' />
            <column caption='Advertiser' datatype='string' name='[advertiser_name]' role='dimension' type='nominal' />
            <column caption='Audience Segments' datatype='string' name='[audience_targeting_used]' role='dimension' type='nominal' />
            <column caption='Campaign Source' datatype='string' name='[campaign_source]' role='dimension' type='nominal' />
            <column caption='Total Days' datatype='real' name='[campaign_total_days]' role='measure' type='quantitative' />
