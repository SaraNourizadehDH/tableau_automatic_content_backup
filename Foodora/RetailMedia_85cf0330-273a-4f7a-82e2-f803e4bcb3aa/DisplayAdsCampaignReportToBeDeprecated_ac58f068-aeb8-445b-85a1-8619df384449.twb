          <datasource-dependencies datasource='federated.1p34e7l0380fyw0zob1ow1rn3t03'>
            <column caption='Utilisation' datatype='real' name='[Calculation_1846968465302188035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_impressions]) / sum([Calculation_2615043336293834753])' />
            </column>
            <column caption='Updated Placement' datatype='string' name='[Calculation_2033938227340177408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [ad_placement] IN (&quot;RLP&quot;, &quot;Homescreen&quot;) THEN &quot;Homescreen&quot;&#10;ELSE [ad_placement]&#10;end' />
            </column>
            <column caption='Is Today Filter' datatype='boolean' name='[Calculation_2033938227372695553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[local_date] = DATE(today())' />
            </column>
            <column caption='Ad Type' datatype='string' name='[Calculation_2615043336293122048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([ad_type], &quot;Partnerships&quot;)' />
            </column>
            <column caption='Requests' datatype='integer' name='[Calculation_2615043336293834753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [Calculation_2033938227340177408], [local_date]: MAX([total_requests])}' />
