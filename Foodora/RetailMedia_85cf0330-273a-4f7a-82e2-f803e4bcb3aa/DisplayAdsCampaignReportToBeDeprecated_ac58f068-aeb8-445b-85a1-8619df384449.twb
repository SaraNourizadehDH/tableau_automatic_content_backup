      <aliases enabled='yes' />
      <column caption='Active Campaign' datatype='boolean' name='[Calculation_1556556687504310272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='date(today()) &lt; [ended_at_local]' />
      </column>
      <column caption='CTR' datatype='real' name='[Calculation_1556556687506132993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([clicks])/sum([impressions])' />
      </column>
      <column caption='Campaign Status' datatype='string' name='[Calculation_1556556687507255298]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF&#10;    [Calculation_1556556687504310272] = TRUE&#10;    AND status = &apos;active&apos;&#10;THEN &apos;Active&apos;&#10;Else &apos;Inactive&apos;&#10;END' />
      </column>
      <column caption='Daily Impression' datatype='real' name='[Calculation_1556556687523299331]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='([booked_impressions])/([campaign_total_days])' />
      </column>
      <column caption='Days since start' datatype='real' name='[Calculation_1556556687524913157]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[local_date] - [started_at_local]' />
      </column>
      <column caption='Target Impression' datatype='real' name='[Calculation_1556556687528366086]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1556556687523299331]) * ([single_day_calc])' />
      </column>
      <column caption='Daily Run Rate' datatype='real' name='[Calculation_1556556687528509447]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([impressions]) / ([Calculation_1556556687528366086])' />
      </column>
      <column caption='Overall Run Rate' datatype='real' name='[Calculation_1556556687530405896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([impressions]) / max([booked_impressions])' />
      </column>
      <column caption='Run Rate Target' datatype='integer' name='[Calculation_1556556687530692617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Current Run Rate' datatype='real' name='[Calculation_1556556687531409418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if max([days_to_end]) &gt;= 0&#10;THEN sum([impressions]) / (max([Calculation_1556556687523299331]) * max([days_from_start]))&#10;end' />
      </column>
      <column caption='Updated Placement' datatype='string' name='[Calculation_1687653645309579264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [ad_placement] = &quot;RLP&quot; THEN &quot;Homescreen&quot;&#10;ELSE [ad_placement] END' />
      </column>
      <column caption='Campaign' datatype='string' name='[Calculation_2621095002882691072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([campaign_name_basic],[campaign_id])' />
      </column>
      <column caption='Fx Rate' datatype='real' name='[Calculation_315674215476666368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [global_entity_id] = &quot;FP_BD&quot; THEN 97.41728&#10;ELSEIF [global_entity_id] = &quot;FP_HK&quot; THEN 8.2167&#10;ELSEIF [global_entity_id] = &quot;FP_LA&quot; THEN 18094.42&#10;ELSEIF [global_entity_id] = &quot;FP_MM&quot; THEN 2170.43&#10;ELSEIF [global_entity_id] = &quot;FP_MY&quot; THEN 4.64&#10;ELSEIF [global_entity_id] = &quot;FP_PH&quot; THEN 59.17&#10;ELSEIF [global_entity_id] = &quot;FP_PK&quot; THEN 245.43049&#10;ELSEIF [global_entity_id] = &quot;FP_SG&quot; THEN 1.43611&#10;ELSEIF [global_entity_id] = &quot;FP_TH&quot; THEN 36.22&#10;ELSEIF [global_entity_id] = &quot;FP_TW&quot; THEN 30.72149&#10;ELSEIF [global_entity_id] = &quot;FP_TH&quot; THEN 36.22&#10;ELSEIF [global_entity_id] = &quot;FP_KH&quot; THEN 1.05&#10;END' />
      </column>
      <column caption='Bid (Eur)' datatype='real' name='[Calculation_315674215477551107]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[bid_local] /[Calculation_315674215476666368]' />
      </column>
      <column caption='Estimated AT Revenue' datatype='real' name='[Calculation_315674215490224132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([impressions] * [Calculation_315674215477551107]/1000)/1.2*0.2' />
      </column>
      <column caption='Campaign Run Rate' datatype='real' name='[Calculation_5025665345074163712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_id]: sum([impressions])/ sum([Calculation_1556556687528366086])}' />
      </column>
      <column caption='Total Run Rate' datatype='real' name='[Calculation_5077104923937419266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([impressions]) / sum([Calculation_1556556687528366086])' />
      </column>
      <column caption='Date Format' datatype='string' name='[Calculation_5077104923982229509]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[End Date Parameter]&#10;WHEN &apos;year&apos; THEN DATENAME(&apos;year&apos;,[local_date])&#10;WHEN &apos;quarter&apos; THEN DATENAME(&apos;year&apos;,[local_date]) + &apos;-Q&apos; + DATENAME(&apos;quarter&apos;,[local_date])&#10;WHEN &apos;month&apos; THEN left(DATENAME(&apos;month&apos;,[local_date]),3) + &apos;-&apos; + STR(YEAR([local_date]))&#10;WHEN &apos;day&apos; THEN STR(DAY([local_date])) + &apos;-&apos; + left(DATENAME(&apos;month&apos;,[local_date]),3) + &apos;-&apos; + STR(YEAR([local_date]))&#10;WHEN &apos;week&apos; THEN DATENAME(&apos;year&apos;,[local_date]) + &apos;-&apos; + DATENAME(&apos;week&apos;,[local_date])&#10;END' />
      </column>
      <column caption='VCR 50%' datatype='real' name='[Calculation_5134736911622373379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vcr_50]) / sum([vcr_0])' />
      </column>
      <column caption='Audience' datatype='string' name='[Calculation_5179561819065045000]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([audience_targeting_used],&apos;is_payment_type&apos;) THEN &apos;is_payment_type&apos;&#10;ELSEIF CONTAINS([audience_targeting_used],&apos;is_source&apos;) THEN &apos;is_source&apos;&#10;ELSEIF [audience_targeting_used] = &quot;&quot; THEN &apos;No Segment&apos;&#10;ELSE [audience_targeting_used]&#10;END' />
      </column>
      <column caption='Country Advertiser' datatype='string' name='[Calculation_5179561819065552905]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[global_entity_id] + &quot;_&quot; + [advertiser_name]' />
      </column>
      <column caption='Daily Country Impressions' datatype='real' name='[Calculation_6150298627661627392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id]: Avg({ FIXED [global_entity_id],[local_date]: sum([impressions])})}' />
      </column>
      <column caption='Start Date Month' datatype='datetime' name='[Calculation_6456543401193967616]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;,[started_at_local])' />
      </column>
      <column caption='Blank' datatype='string' name='[Calculation_6456543401200025601]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='VCR 100%' datatype='real' name='[VCR 50% (copy)_5134736911622418436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vcr_100]) / sum([vcr_0])' />
      </column>
