    <worksheet name='Overview Run Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='13'>Run Rate </run>
            <run fontsize='9' italic='true'>(for campaigns that were not cancelled)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='panda ads overview ' name='federated.0j3q2li1la2380107fhkw0slyyq3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Quarter' caption='Date Level' datatype='string' name='[End Date Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;quarter&quot;'>
              <calculation class='tableau' formula='&quot;quarter&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;quarter&quot;' value='Quarter' />
                <alias key='&quot;year&quot;' value='Year' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0j3q2li1la2380107fhkw0slyyq3'>
            <column caption='Daily Impression' datatype='real' name='[Calculation_1556556687523299331]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='([booked_impressions])/([campaign_total_days])' />
            </column>
            <column caption='Target Impression' datatype='real' name='[Calculation_1556556687528366086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1556556687523299331]) * ([single_day_calc])' />
            </column>
            <column caption='Updated Placement' datatype='string' name='[Calculation_1687653645309579264]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [ad_placement] = &quot;RLP&quot; THEN &quot;Homescreen&quot;&#10;ELSE [ad_placement] END' />
            </column>
            <column caption='Total Run Rate' datatype='real' name='[Calculation_5077104923937419266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([impressions]) / sum([Calculation_1556556687528366086])' />
            </column>
            <column caption='Date Format' datatype='string' name='[Calculation_5077104923982229509]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[End Date Parameter]&#10;WHEN &apos;year&apos; THEN DATENAME(&apos;year&apos;,[local_date])&#10;WHEN &apos;quarter&apos; THEN DATENAME(&apos;year&apos;,[local_date]) + &apos;-Q&apos; + DATENAME(&apos;quarter&apos;,[local_date])&#10;WHEN &apos;month&apos; THEN left(DATENAME(&apos;month&apos;,[local_date]),3) + &apos;-&apos; + STR(YEAR([local_date]))&#10;WHEN &apos;day&apos; THEN STR(DAY([local_date])) + &apos;-&apos; + left(DATENAME(&apos;month&apos;,[local_date]),3) + &apos;-&apos; + STR(YEAR([local_date]))&#10;WHEN &apos;week&apos; THEN DATENAME(&apos;year&apos;,[local_date]) + &apos;-&apos; + DATENAME(&apos;week&apos;,[local_date])&#10;END' />
            </column>
            <column caption='Start Date Month' datatype='datetime' name='[Calculation_6456543401193967616]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;,[started_at_local])' />
            </column>
            <column caption='Placement' datatype='string' name='[ad_placement]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Booked Impressions' datatype='real' name='[booked_impressions]' role='dimension' type='ordinal' />
            <column caption='Campaign Source' datatype='string' name='[campaign_source]' role='dimension' type='nominal' />
            <column caption='Total Days' datatype='real' name='[campaign_total_days]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Total Impressions' datatype='integer' name='[impressions]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[local_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_6456543401193967616]' derivation='Min' name='[min:Calculation_6456543401193967616:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1687653645309579264]' derivation='None' name='[none:Calculation_1687653645309579264:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5077104923982229509]' derivation='None' name='[none:Calculation_5077104923982229509:nk]' pivot='key' type='nominal' />
            <column-instance column='[campaign_source]' derivation='None' name='[none:campaign_source:nk]' pivot='key' type='nominal' />
            <column-instance column='[campaign_total_days]' derivation='None' name='[none:campaign_total_days:qk]' pivot='key' type='quantitative' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column caption='Single Day Calc' datatype='real' name='[single_day_calc]' role='measure' type='quantitative' />
            <column caption='Start Date' datatype='datetime' name='[started_at_local]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5077104923937419266]' derivation='User' name='[usr:Calculation_5077104923937419266:qk]' pivot='key' type='quantitative' />
            <column-instance column='[local_date]' derivation='Year' name='[yr:local_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
