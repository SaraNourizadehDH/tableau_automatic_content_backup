            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>total_gmv_eur</remote-alias>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_2AD458DC428648E38838177DDB87935E]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>pro_gmv_percentage</remote-name>
            <remote-type>5</remote-type>
            <local-name>[pro_gmv_percentage]</local-name>
