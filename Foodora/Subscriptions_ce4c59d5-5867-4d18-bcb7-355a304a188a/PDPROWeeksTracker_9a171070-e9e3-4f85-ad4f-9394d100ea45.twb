            <column caption='(ZN([PRO Orders Share%]) - LOOKUP(ZN([PRO Orders Share%]), -1...' datatype='real' name='[Calculation_2523775045174161412]' role='measure' type='quantitative' user:unnamed='Monthly KPIs MoM'>
              <calculation class='tableau' formula='(ZN([Calculation_5314247594534141979]) - LOOKUP(ZN([Calculation_5314247594534141979]), -1))*100'>
