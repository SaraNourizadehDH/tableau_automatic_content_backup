            <column caption='DH Funding CPIO' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_5182869150229860363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[pro_week_item_deals_dh_funding_cost] / [pro_weeks_item_deal_orders]' />
            </column>
            <column caption='Total Subscribers' datatype='integer' name='[Calculation_5314247593842167811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Daily&quot; THEN [active_subscribers_end_of_month]&#10;    WHEN &quot;Weekly&quot; THEN IF ISOWEEKDAY([report_month]) = 7 OR [report_month] = (TODAY())-1 THEN [active_subscribers_end_of_month] ELSE 0 END&#10;    WHEN &quot;Monthly&quot; THEN IF [report_month] = DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[report_month]))) OR [report_month] = (TODAY())-1 THEN [active_subscribers_end_of_month] ELSE 0 END&#10;END' />
            </column>
            <column caption='Join Rate%' datatype='real' default-format='p0.0%' name='[Calculation_5314247593913008133]' role='measure' type='quantitative'>
