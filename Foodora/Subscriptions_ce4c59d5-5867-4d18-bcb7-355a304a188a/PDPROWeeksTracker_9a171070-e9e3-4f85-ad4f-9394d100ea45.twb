    <worksheet name='Weekly KPIs'>
      <table>
        <view>
          <datasources>
            <datasource caption='Weekly KPIs' name='federated.1nf0uxe1lppcfm1a1t7jb006dqf2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1nf0uxe1lppcfm1a1t7jb006dqf2].[Calculation_5354076304144232478]' caption='Start Date Selection' datatype='date' name='[Parameter 8]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1nf0uxe1lppcfm1a1t7jb006dqf2].[Calculation_5354076304144834591]' caption='End Date Selection' datatype='date' name='[Parameter 9]' param-domain-type='any' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nf0uxe1lppcfm1a1t7jb006dqf2'>
            <column caption='Activity Rate %' datatype='real' default-format='p0.0%' name='[Calculation_1025483745557057539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([active_subscribers_l30d_order]) / sum([active_subscribers])' />
            </column>
            <column caption='PRO Order Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1841127861389209611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5314247593914826758] / SUM([Calculation_5314247593842167811])' />
            </column>
            <column caption='PRO Week Incremental Orders%' datatype='real' default-format='p0.0%' name='[Calculation_3379951554611609602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5314247594111860758] / [Calculation_5314247593914826758]' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_3379951554621964294]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name] IN (&quot;Malaysia&quot;, &quot;Hong Kong&quot;, &quot;Singapore&quot;, &quot;Taiwan&quot;, &quot;Bangladesh&quot;, &quot;Pakistan&quot;, &quot;Cambodia&quot;, &quot;Philippines&quot;) THEN &quot;Asia&quot;&#10;ELSEIF  [country_name] IN (&quot;Germany&quot;, &quot;Finland&quot;, &quot;Sweden&quot;, &quot;Norway&quot;, &quot;Czech Republic&quot;, &quot;Hungary&quot;, &quot;Austria&quot;) THEN &quot;Europe&quot;&#10;ELSE &quot;MENA&quot;&#10;END' />
            </column>
            <column caption='DH Funding CPIO' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_5182869150228172810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[pro_week_item_deals_dh_funding_cost] / [pro_weeks_item_deal_orders]' />
            </column>
            <column caption='Date Granularity' datatype='datetime' name='[Calculation_5314247593825308672]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;,[report_week])&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[report_week],&apos;Monday&apos;)&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[report_week])&#10;END' />
            </column>
            <column caption='Total Subscribers' datatype='integer' name='[Calculation_5314247593842167811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Daily&quot; THEN [active_subscribers]&#10;    WHEN &quot;Weekly&quot; THEN IF ISOWEEKDAY([report_week]) = 7 OR [report_week] = (TODAY())-1 THEN [active_subscribers] ELSE 0 END&#10;    WHEN &quot;Monthly&quot; THEN IF [report_week] = DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[report_week]))) OR [report_week] = (TODAY())-1 THEN [active_subscribers] ELSE 0 END&#10;END' />
            </column>
            <column caption='Join Rate%' datatype='real' default-format='p0.0%' name='[Calculation_5314247593913008133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([weekly_join_rate])' />
            </column>
            <column caption='PRO Orders' datatype='integer' name='[Calculation_5314247593914826758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_orders])' />
            </column>
            <column caption='Platform Orders' datatype='integer' name='[Calculation_5314247594088501255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders])' />
            </column>
            <column caption='New to PRO Customers' datatype='integer' name='[Calculation_5314247594088665096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[new_to_pro_customers]' />
            </column>
            <column caption='PRO DEAL UTR' datatype='real' default-format='p0.0%' name='[Calculation_5314247594089123849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_discount_orders]) / SUM([pro_orders])' />
            </column>
            <column caption='DH Funding Cost' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_5314247594099355662]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[dh_funding_cost]' />
            </column>
            <column caption='DH Funding Cost Per Order' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_5314247594100871185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5314247594099355662]) / [Calculation_5314247594088501255]' />
            </column>
            <column caption='PRO Week Incremental Orders' datatype='integer' name='[Calculation_5314247594111860758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_weeks_item_deal_orders])' />
            </column>
            <column caption='PRO Orders Share%' datatype='real' default-format='p0.0%' name='[Calculation_5314247594534141979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5314247593914826758] / [Calculation_5314247594088501255]' />
            </column>
            <column caption='PRO GMV %' datatype='real' default-format='p0.0%' name='[Calculation_5314247594542694431]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_gmv_eur]) / SUM([total_gmv_eur])' />
            </column>
            <column caption='PRO MAU Penetration%' datatype='real' default-format='p0.0%' name='[Calculation_5314247594543530016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_5314247593842167811])/ sum([platform_users])' />
            </column>
            <column caption='Savings%' datatype='real' default-format='p0.0%' name='[Calculation_5354076304111099924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[savings_numerator] / [savings_denominator]' />
            </column>
            <column caption='Custom Dates' datatype='boolean' name='[Calculation_5354076304143810589]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_week] &gt;= [Parameters].[Parameter 8]&#10;AND&#10;[report_week] &lt;= [Parameters].[Parameter 9]' />
            </column>
            <column caption='Last Month' datatype='datetime' name='[Calculation_5354076304144232478]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, DATETRUNC(&apos;month&apos;, TODAY() - 1) - 1)' />
            </column>
            <column caption='Today - 1' datatype='date' name='[Calculation_5354076304144834591]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY() - 1' />
            </column>
            <column datatype='integer' name='[active_subscribers]' role='measure' type='quantitative' />
            <column datatype='integer' name='[active_subscribers_l30d_order]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[dh_funding_cost]' role='measure' type='quantitative' />
