    <worksheet name='L7D vs Previous 7D'>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily KPIs' name='federated.0zi3fsl0jpd6lw1083tzg0lmbr13' />
            <datasource caption='Weekly KPIs' name='federated.1nf0uxe1lppcfm1a1t7jb006dqf2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;PRO Order Frequency&quot;'>
              <calculation class='tableau' formula='&quot;PRO Order Frequency&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zi3fsl0jpd6lw1083tzg0lmbr13'>
            <column caption='Region' datatype='string' name='[Calculation_3379951554621890565]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name] IN (&quot;Malaysia&quot;, &quot;Hong Kong&quot;, &quot;Singapore&quot;, &quot;Taiwan&quot;, &quot;Bangladesh&quot;, &quot;Pakistan&quot;, &quot;Cambodia&quot;, &quot;Philippines&quot;) THEN &quot;Asia&quot;&#10;ELSEIF  [country_name] IN (&quot;Germany&quot;, &quot;Finland&quot;, &quot;Sweden&quot;, &quot;Norway&quot;, &quot;Czech Republic&quot;, &quot;Hungary&quot;, &quot;Austria&quot;) THEN &quot;Europe&quot;&#10;ELSE &quot;MENA&quot;&#10;END' />
            </column>
            <column caption='Day of Day' datatype='real' name='[Calculation_5354076303992287235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-&#10;(TODAY() - &#10;IF [report_date] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [report_date])&#10;ELSE [report_date]&#10;END&#10;)' />
            </column>
            <column caption='L7D vs Previous 7D' datatype='string' name='[Calculation_5354076303992451076]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [report_date] &lt;= NOW() - 1&#10;THEN &apos;Last 7D&apos;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [report_date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous 7D&apos;&#10;END' />
            </column>
            <column caption='L7DvsP7D Dynamic Metric' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5354076303995777030]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;PRO Order Frequency&quot; THEN [pro_orders]/[active_subscribers]&#10;WHEN &quot;PRO Orders%&quot; THEN [pro_orders_percentage]&#10;WHEN &quot;Join Rate%&quot; THEN [join_rate]&#10;WHEN &quot;PRO Week Discounted Orders&quot; THEN [pro_weeks_item_deal_orders]&#10;WHEN &quot;New to PRO Customers&quot; THEN [new_to_pro_customers]&#10;END' />
            </column>
            <column datatype='integer' name='[active_subscribers]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' default-format='p0.0%' name='[join_rate]' role='measure' type='quantitative' />
            <column datatype='integer' name='[new_to_pro_customers]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3379951554621890565]' derivation='None' name='[none:Calculation_3379951554621890565:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5354076303992287235]' derivation='None' name='[none:Calculation_5354076303992287235:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_5354076303992451076]' derivation='None' name='[none:Calculation_5354076303992451076:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[pro_orders]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.0%' name='[pro_orders_percentage]' role='measure' type='quantitative' />
            <column datatype='integer' name='[pro_weeks_item_deal_orders]' role='measure' type='quantitative' />
            <column datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5354076303995777030]' derivation='Sum' name='[sum:Calculation_5354076303995777030:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nf0uxe1lppcfm1a1t7jb006dqf2'>
            <column caption='Region' datatype='string' name='[Calculation_3379951554621964294]' role='dimension' type='nominal'>
