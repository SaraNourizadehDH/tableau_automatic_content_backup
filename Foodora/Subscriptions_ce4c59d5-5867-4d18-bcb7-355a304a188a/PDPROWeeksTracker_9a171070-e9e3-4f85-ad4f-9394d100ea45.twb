            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[pro_week_item_deals_dh_funding_cost]' role='measure' type='quantitative' />
            <column datatype='integer' name='[pro_weeks_item_deal_orders]' role='measure' type='quantitative' />
            <column datatype='date' default-format='*MMM-YYYY' name='[report_month]' role='dimension' type='ordinal' />
          </datasource-dependencies>
