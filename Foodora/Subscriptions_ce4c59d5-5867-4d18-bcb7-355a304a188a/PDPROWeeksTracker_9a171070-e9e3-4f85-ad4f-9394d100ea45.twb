      </column>
      <column caption='Last 2 Days' datatype='boolean' name='[Calculation_5314247594112598039]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_week] &gt;=  TODAY() - 2' />
      </column>
      <column caption='PRO Orders Share%' datatype='real' default-format='p0.0%' name='[Calculation_5314247594534141979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5314247593914826758] / [Calculation_5314247594088501255]' />
      </column>
      <column caption='PRO FD DEAL UTR' datatype='real' default-format='p0.0%' name='[Calculation_5314247594540998685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pro_fd_discount_orders]) / sum([pro_orders])' />
      </column>
      <column caption='PRO GMV %' datatype='real' default-format='p0.0%' name='[Calculation_5314247594542694431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_gmv_eur]) / SUM([total_gmv_eur])' />
      </column>
      <column caption='PRO MAU Penetration%' datatype='real' default-format='p0.0%' name='[Calculation_5314247594543530016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_5314247593842167811])/ sum([platform_users])' />
      </column>
      <column caption='PRO GMV of Vendors Participating PRO Weeks' datatype='real' default-format='C1031%' name='[Calculation_5314247594545545249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_weeks_vendors_gmv_eur])' />
      </column>
      <column caption='Day of Day' datatype='real' name='[Calculation_5354076303992287235]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-&#10;(TODAY() - &#10;IF [report_date] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [report_date])&#10;ELSE [report_date]&#10;END&#10;)' />
      </column>
      <column caption='L7D vs Previous 7D' datatype='string' name='[Calculation_5354076303992451076]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [report_date] &lt;= NOW() - 1&#10;THEN &apos;L7D&apos;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [report_date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END' />
      </column>
      <column caption='L7DvsP7D Dynamic Metric' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5354076303995777030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;PRO Orders&quot; THEN [pro_orders]&#10;WHEN &quot;PRO Orders%&quot; THEN [pro_orders_percentage]&#10;WHEN &quot;Join Rate%&quot; THEN [join_rate]&#10;WHEN &quot;PRO Week Discounted Orders&quot; THEN [pro_weeks_item_deal_orders]&#10;WHEN &quot;New to PRO Customers&quot; THEN [new_to_pro_customers]&#10;END' />
      </column>
      <column caption='Pre Date Selection' datatype='boolean' name='[Calculation_5354076304047562760]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] &gt;= [Parameters].[Parameter 3] AND [report_date] &lt;= [Parameters].[Parameter 4]' />
      </column>
      <column caption='Pre Metric Selection' datatype='real' name='[Calculation_5354076304058339341]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [report_date] &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1,TODAY())) and [report_date] &lt;= DATETRUNC(&apos;month&apos;,TODAY()) - 1&#10;THEN&#10;CASE [Parameters].[Parameter 10]&#10;&#10;WHEN &apos;Join Rate%&apos; THEN [join_rate]&#10;WHEN &apos;PRO Orders&apos; THEN [pro_orders]&#10;WHEN &apos;PRO Orders Share%&apos; THEN [pro_orders_percentage] &#10;WHEN &apos;PRO Week Discounted Orders&apos; THEN [pro_weeks_item_deal_orders] &#10;WHEN &apos;New to PRO Customers&apos; THEN [new_to_pro_customers]&#10;WHEN &apos;PRO DEAL UTR&apos; THEN [pro_discount_orders] / [pro_orders]&#10;WHEN &apos;PRO GMV&apos; THEN [pro_gmv_eur]&#10;WHEN &apos;PRO GMV %&apos; THEN [pro_gmv_eur] / [total_gmv_eur]&#10;WHEN &apos;Total Subscribers&apos; THEN [active_subscribers]&#10;END&#10;END' />
      </column>
      <column caption='Pro Deal Value from PRO Week vendors ' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_5354076304110977043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_deal_value_from_pro_week_vendors])' />
      </column>
      <column caption='Savings%' datatype='real' default-format='p0.0%' name='[Calculation_5354076304111099924]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[savings_numerator] / [savings_denominator]' />
      </column>
      <column caption='PRO Deal Value from PRO Week Vendors' datatype='real' name='[Calculation_5354076304130629654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_deal_value_from_pro_week_vendors])' />
      </column>
      <column caption='Custom Date' datatype='boolean' name='[Calculation_5354076304143110172]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] &gt;= [Parameters].[Parameter 11]&#10;AND&#10;[report_date] &lt;= [Parameters].[Parameter 9]' />
