            </column>
            <column caption='Region' datatype='string' name='[Calculation_3379951554621550596]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name] IN (&quot;Malaysia&quot;, &quot;Hong Kong&quot;, &quot;Singapore&quot;, &quot;Taiwan&quot;, &quot;Bangladesh&quot;, &quot;Pakistan&quot;, &quot;Cambodia&quot;, &quot;Philippines&quot;) THEN &quot;Asia&quot;&#10;ELSEIF  [country_name] IN (&quot;Germany&quot;, &quot;Finland&quot;, &quot;Sweden&quot;, &quot;Norway&quot;, &quot;Czech Republic&quot;, &quot;Hungary&quot;, &quot;Austria&quot;) THEN &quot;Europe&quot;&#10;ELSE &quot;MENA&quot;&#10;END' />
            </column>
            <column caption='(ZN([PRO DEAL UTR]) - LOOKUP(ZN([PRO DEAL UTR]), -1))*100' datatype='real' name='[Calculation_3927983337127342086]' role='measure' type='quantitative' user:unnamed='Monthly KPIs MoM'>
              <calculation class='tableau' formula='(ZN([Calculation_5314247594089123849]) - LOOKUP(ZN([Calculation_5314247594089123849]), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='(ZN(SUM([Activity Rate %])) - LOOKUP(ZN(SUM([Activity Rate %]...' datatype='real' name='[Calculation_3927983337132044295]' role='measure' type='quantitative' user:unnamed='Monthly KPIs MoM'>
              <calculation class='tableau' formula='(ZN(SUM([Calculation_1025483745596731397])) - LOOKUP(ZN(SUM([Calculation_1025483745596731397])), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Savings %' datatype='real' name='[Calculation_3927983337138032667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[savings_numerator] /[savings_denominator]' />
            </column>
            <column caption='(ZN(SUM([Savings %])) - LOOKUP(ZN(SUM([Savings %])), -1))*100' datatype='real' name='[Calculation_3927983337138466844]' role='measure' type='quantitative' user:unnamed='Monthly KPIs MoM'>
              <calculation class='tableau' formula='(ZN(SUM([Calculation_3927983337138032667])) - LOOKUP(ZN(SUM([Calculation_3927983337138032667])), -1))*100'>
