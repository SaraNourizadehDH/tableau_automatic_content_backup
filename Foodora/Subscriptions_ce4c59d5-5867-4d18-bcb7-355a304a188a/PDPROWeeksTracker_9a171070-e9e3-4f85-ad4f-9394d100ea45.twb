    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Pre vs Post Views'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/PROWeeksDashboard-WIP/PrevsPostViews?rev=' id='PrevsPostViews' path='/t/Foodora/workbooks/PROWeeksDashboard-WIP' revision='' site='Foodora' />
      <style />
      <size maxheight='1200' maxwidth='1500' minheight='1200' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Daily KPIs' name='federated.0zi3fsl0jpd6lw1083tzg0lmbr13' />
        <datasource caption='Weekly KPIs' name='federated.1nf0uxe1lppcfm1a1t7jb006dqf2' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Trend Metric Selection 1' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;PRO Order Frequency&quot;'>
          <calculation class='tableau' formula='&quot;PRO Order Frequency&quot;' />
          <members>
            <member value='&quot;Join Rate\%&quot;' />
            <member value='&quot;PRO Order Frequency&quot;' />
            <member value='&quot;PRO Orders Share\%&quot;' />
            <member value='&quot;PRO Week Incremental Orders&quot;' />
            <member value='&quot;New to PRO Customers&quot;' />
            <member value='&quot;PRO DEAL UTR&quot;' />
            <member value='&quot;PRO GMV&quot;' />
            <member value='&quot;PRO GMV \%&quot;' />
            <member value='&quot;Total Subscribers&quot;' />
          </members>
        </column>
        <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
          <calculation class='tableau' formula='&quot;Daily&quot;' />
          <members>
            <member value='&quot;Daily&quot;' />
            <member value='&quot;Weekly&quot;' />
            <member value='&quot;Monthly&quot;' />
          </members>
        </column>
        <column caption='Pre Start Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2025-06-13#'>
          <calculation class='tableau' formula='#2025-06-13#' />
        </column>
        <column caption='Pre End Date' datatype='date' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='#2025-06-22#'>
          <calculation class='tableau' formula='#2025-06-22#' />
        </column>
        <column caption='Post Start Date' datatype='date' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-11#'>
          <calculation class='tableau' formula='#2025-07-11#' />
        </column>
        <column caption='Post End Date' datatype='date' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-20#'>
          <calculation class='tableau' formula='#2025-07-20#' />
        </column>
        <column caption='Trend Metric Selection 2' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Join Rate\%&quot;'>
          <calculation class='tableau' formula='&quot;Join Rate%&quot;' />
          <members>
            <member value='&quot;Join Rate\%&quot;' />
            <member value='&quot;PRO Order Frequency&quot;' />
            <member value='&quot;PRO Orders Share\%&quot;' />
            <member value='&quot;PRO Week Incremental Orders&quot;' />
