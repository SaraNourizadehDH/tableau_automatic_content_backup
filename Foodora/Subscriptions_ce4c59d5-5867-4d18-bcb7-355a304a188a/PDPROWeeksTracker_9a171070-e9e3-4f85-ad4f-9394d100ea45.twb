          <datasource-dependencies datasource='federated.17w1nq41tn4f6x162cm8p1nlxp1i'>
            <column caption='Activity Rate %' datatype='real' default-format='p0.0%' name='[Calculation_1025483745596731397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[active_subscribers_l30d_order] / [active_subscribers_end_of_month]' />
