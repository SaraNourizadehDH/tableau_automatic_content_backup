      <column caption='DElta' datatype='boolean' name='[Calculation_3927983337108094978]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([report_date] &gt;= [Parameters].[Parameter 3] AND [report_date] &lt;= [Parameters].[Parameter 4])&#10;OR&#10;([report_date] &gt;= [Parameters].[Parameter 5] AND [report_date] &lt;= [Parameters].[Parameter 6])' />
      </column>
      <column caption='PRE' datatype='date' name='[Calculation_3927983337110265859]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [report_date] &gt;= [Parameters].[Parameter 3] AND [report_date] &lt;= [Parameters].[Parameter 4]&#10;THEN [report_date] END' />
