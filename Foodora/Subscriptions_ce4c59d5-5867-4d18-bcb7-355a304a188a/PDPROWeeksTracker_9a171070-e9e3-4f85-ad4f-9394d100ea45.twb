      <column caption='Previous  Week' datatype='boolean' name='[Calculation_5314247594110742549 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_week] &gt;= DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;,-2,TODAY()-1), &apos;monday&apos;)&#10;AND&#10;[report_week] &lt; DATETRUNC(&apos;week&apos;, TODAY()-1, &apos;monday&apos;)' />
