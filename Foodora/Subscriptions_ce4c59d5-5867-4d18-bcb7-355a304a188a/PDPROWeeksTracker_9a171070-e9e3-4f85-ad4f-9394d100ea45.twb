      <column caption='Activity Rate %' datatype='real' default-format='p0.0%' name='[Calculation_1025483745596731397]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[active_subscribers_l30d_order] / [active_subscribers_end_of_month]' />
      </column>
      <column caption='PRO Order Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1841127861389529100]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5314247593914826758] / SUM([Calculation_5314247593842167811])' />
      </column>
      <column caption='PRO Week Incremental Orders' datatype='integer' name='[Calculation_3379951554610581505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [has_pro_week] THEN [pro_weeks_item_deal_orders] END)' />
      </column>
      <column caption='PRO Week Incremental Orders%' datatype='real' default-format='p0.0%' name='[Calculation_3379951554612097027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3379951554610581505] / [Calculation_5314247593914826758]' />
      </column>
      <column caption='Region' datatype='string' name='[Calculation_3379951554621550596]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country_name] IN (&quot;Malaysia&quot;, &quot;Hong Kong&quot;, &quot;Singapore&quot;, &quot;Taiwan&quot;, &quot;Bangladesh&quot;, &quot;Pakistan&quot;, &quot;Cambodia&quot;, &quot;Philippines&quot;) THEN &quot;Asia&quot;&#10;ELSEIF  [country_name] IN (&quot;Germany&quot;, &quot;Finland&quot;, &quot;Sweden&quot;, &quot;Norway&quot;, &quot;Czech Republic&quot;, &quot;Hungary&quot;, &quot;Austria&quot;) THEN &quot;Europe&quot;&#10;ELSE &quot;MENA&quot;&#10;END' />
      </column>
      <column caption='Savings %' datatype='real' name='[Calculation_3927983337138032667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[savings_numerator] /[savings_denominator]' />
      </column>
      <column caption='Previous PRO Week Month ' datatype='datetime' name='[Calculation_476959384091828253]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [report_month]&#10;WHEN [Calculation_5314247594110742549 1]&#10;THEN DATEADD(&quot;month&quot;, -1,[report_month])&#10;END' />
      </column>
      <column caption='PRO Week Month' datatype='boolean' name='[Calculation_476959384095793184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[has_pro_week] = TRUE' />
      </column>
      <column caption='Next Month' datatype='datetime' name='[Calculation_476959384096112673]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&quot;month&quot;, 1, [report_month])' />
      </column>
      <column caption='Lastest PRO Week Month' datatype='date' name='[Calculation_476959384099704867]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name] : &#10;    MAX(IF [Calculation_476959384095793184] THEN [report_month] END)&#10;}' />
      </column>
      <column caption='Month Type' datatype='string' name='[Calculation_476959384100106276]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [report_month]&#10;    WHEN [Calculation_476959384099704867] &#10;        THEN &quot;Latest Pro Week Month&quot;&#10;    WHEN  DATEADD(&apos;month&apos;, -1, [Calculation_476959384099704867]) &#10;        THEN &quot;Previous Month&quot;&#10;    ELSE &quot;Other Months&quot;&#10;END' />
      </column>
      <column caption='DH Funding CPIO' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_5182869150229860363]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[pro_week_item_deals_dh_funding_cost] / [pro_weeks_item_deal_orders]' />
      </column>
      <column caption='Last PRO Month Period' datatype='boolean' name='[Calculation_5182869150230249484]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_month] = { FIXED [country_name]: MAX( IF [has_pro_week] THEN [report_month] END)}' />
      </column>
      <column caption='Date Granularity' datatype='datetime' name='[Calculation_5314247593825308672]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;,[report_month])&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[report_month],&apos;Monday&apos;)&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[report_month])&#10;END' />
      </column>
      <column caption='Total Subscribers' datatype='integer' name='[Calculation_5314247593842167811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Daily&quot; THEN [active_subscribers_end_of_month]&#10;    WHEN &quot;Weekly&quot; THEN IF ISOWEEKDAY([report_month]) = 7 OR [report_month] = (TODAY())-1 THEN [active_subscribers_end_of_month] ELSE 0 END&#10;    WHEN &quot;Monthly&quot; THEN IF [report_month] = DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[report_month]))) OR [report_month] = (TODAY())-1 THEN [active_subscribers_end_of_month] ELSE 0 END&#10;END' />
      </column>
      <column caption='Join Rate%' datatype='real' default-format='p0.0%' name='[Calculation_5314247593913008133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([monthly_join_rate])' />
