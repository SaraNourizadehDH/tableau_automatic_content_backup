    <worksheet name='Delta KPIs'>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily KPIs' name='federated.0zi3fsl0jpd6lw1083tzg0lmbr13' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Pre Start Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2025-06-13#'>
              <calculation class='tableau' formula='#2025-06-13#' />
            </column>
            <column caption='Pre End Date' datatype='date' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='#2025-06-22#'>
              <calculation class='tableau' formula='#2025-06-22#' />
            </column>
            <column caption='Post Start Date' datatype='date' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-11#'>
              <calculation class='tableau' formula='#2025-07-11#' />
            </column>
            <column caption='Post End Date' datatype='date' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-20#'>
              <calculation class='tableau' formula='#2025-07-20#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zi3fsl0jpd6lw1083tzg0lmbr13'>
            <column caption='Activity Rate %' datatype='real' default-format='p0.0%' name='[Calculation_1025483745556353026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([active_subscribers_l30d_order]) / sum([active_subscribers])' />
            </column>
            <column caption='PRO Order Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1841127861388673034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5314247593914826758] / SUM([Calculation_5314247593842167811])' />
            </column>
            <column caption='(ZN([Activity Rate %]) - LOOKUP(ZN([Activity Rate %]), -1))*100' datatype='real' name='[Calculation_1841127861399326734]' role='measure' type='quantitative' user:unnamed='Delta KPIs'>
              <calculation class='tableau' formula='(ZN([Calculation_1025483745556353026]) - LOOKUP(ZN([Calculation_1025483745556353026]), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='(ZN([Join Rate%]) - LOOKUP(ZN([Join Rate%]), -1))*100' datatype='real' name='[Calculation_1869345726410723332]' role='measure' type='quantitative' user:unnamed='Delta KPIs'>
              <calculation class='tableau' formula='(ZN([Calculation_5314247593913008133]) - LOOKUP(ZN([Calculation_5314247593913008133]), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='(ZN([PRO Orders Share%]) - LOOKUP(ZN([PRO Orders Share%]), -1...' datatype='real' name='[Calculation_1869345726410838021]' role='measure' type='quantitative' user:unnamed='Delta KPIs'>
              <calculation class='tableau' formula='(ZN([Calculation_5314247594534141979]) - LOOKUP(ZN([Calculation_5314247594534141979]), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='(ZN([PRO DEAL UTR]) - LOOKUP(ZN([PRO DEAL UTR]), -1))*100' datatype='real' name='[Calculation_1869345726411366406]' role='measure' type='quantitative' user:unnamed='Delta KPIs'>
              <calculation class='tableau' formula='(ZN([Calculation_5314247594089123849]) - LOOKUP(ZN([Calculation_5314247594089123849]), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='(ZN([PRO GMV %]) - LOOKUP(ZN([PRO GMV %]), -1))*100' datatype='real' name='[Calculation_1869345726411395079]' role='measure' type='quantitative' user:unnamed='Delta KPIs'>
              <calculation class='tableau' formula='(ZN([Calculation_5314247594542694431]) - LOOKUP(ZN([Calculation_5314247594542694431]), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='(ZN([Savings%]) - LOOKUP(ZN([Savings%]), -1))*100' datatype='real' name='[Calculation_1869345726423568394]' role='measure' type='quantitative' user:unnamed='Delta KPIs'>
              <calculation class='tableau' formula='(ZN([Calculation_5354076304111099924]) - LOOKUP(ZN([Calculation_5354076304111099924]), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='PRO MAU Penetration Last Day Post' datatype='real' default-format='p0.0%' name='[Calculation_2238781638512623616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [report_date] = [Parameters].[Parameter 6] THEN [Calculation_5314247593842167811] END) / sum([platform_users])' />
            </column>
            <column caption='Delta PRO MAU Penetaration' datatype='real' default-format='n#,##0.00&quot; pp&quot;;-#,##0.00&quot; pp&quot;' name='[Calculation_2238781638514094082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2238781638512623616] - [Calculation_394557590980284416])' />
            </column>
            <column caption='Delta Total Subscribers' datatype='integer' name='[Calculation_2238781638515126275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3927983337101770753] - [Calculation_3927983337100820480]) * 100' />
            </column>
            <column caption='PRO Week Incremental Orders%' datatype='real' default-format='p0.0%' name='[Calculation_3379951554609590272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5314247594111860758] / [Calculation_5314247593914826758]' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_3379951554621890565]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name] IN (&quot;Malaysia&quot;, &quot;Hong Kong&quot;, &quot;Singapore&quot;, &quot;Taiwan&quot;, &quot;Bangladesh&quot;, &quot;Pakistan&quot;, &quot;Cambodia&quot;, &quot;Philippines&quot;) THEN &quot;Asia&quot;&#10;ELSEIF  [country_name] IN (&quot;Germany&quot;, &quot;Finland&quot;, &quot;Sweden&quot;, &quot;Norway&quot;, &quot;Czech Republic&quot;, &quot;Hungary&quot;, &quot;Austria&quot;) THEN &quot;Europe&quot;&#10;ELSE &quot;MENA&quot;&#10;END' />
            </column>
            <column caption='PRE End Date Total Subscribers' datatype='integer' name='[Calculation_3927983337100820480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = [Parameters].[Parameter 4] THEN [Calculation_5314247593842167811] END' />
            </column>
            <column caption='Post End date Total Subscribers' datatype='integer' name='[Calculation_3927983337101770753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [report_date] = [Parameters].[Parameter 6] THEN [Calculation_5314247593842167811] END' />
            </column>
            <column caption='DElta' datatype='boolean' name='[Calculation_3927983337108094978]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([report_date] &gt;= [Parameters].[Parameter 3] AND [report_date] &lt;= [Parameters].[Parameter 4])&#10;OR&#10;([report_date] &gt;= [Parameters].[Parameter 5] AND [report_date] &lt;= [Parameters].[Parameter 6])' />
            </column>
            <column caption='PRE' datatype='date' name='[Calculation_3927983337110265859]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [report_date] &gt;= [Parameters].[Parameter 3] AND [report_date] &lt;= [Parameters].[Parameter 4]&#10;THEN [report_date] END' />
            </column>
            <column caption='Post' datatype='date' name='[Calculation_3927983337110528004]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [report_date] &gt;= [Parameters].[Parameter 5] AND [report_date] &lt;= [Parameters].[Parameter 6]&#10;THEN [report_date] ELSE NULL END' />
            </column>
            <column caption='PRO MAU Penetration (Last Day)' datatype='real' default-format='p0.0%' name='[Calculation_394557590980284416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [report_date] = [Parameters].[Parameter 4] THEN [Calculation_5314247593842167811] END) / sum([platform_users])' />
            </column>
            <column caption='DH Funding CPIO' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_5182869150219186183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[pro_week_item_deals_dh_funding_cost] / [pro_weeks_item_deal_orders]' />
            </column>
            <column caption='Total Subscribers' datatype='integer' name='[Calculation_5314247593842167811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Daily&quot; THEN [active_subscribers]&#10;    WHEN &quot;Weekly&quot; THEN IF ISOWEEKDAY([report_date]) = 7 OR [report_date] = (TODAY())-1 THEN [active_subscribers] ELSE 0 END&#10;    WHEN &quot;Monthly&quot; THEN IF [report_date] = DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[report_date]))) OR [report_date] = (TODAY())-1 THEN [active_subscribers] ELSE 0 END&#10;END' />
            </column>
            <column caption='Join Rate%' datatype='real' default-format='p0.0%' name='[Calculation_5314247593913008133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([join_rate])' />
            </column>
            <column caption='PRO Orders' datatype='integer' name='[Calculation_5314247593914826758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_orders])' />
            </column>
            <column caption='Platform Orders' datatype='integer' name='[Calculation_5314247594088501255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders])' />
            </column>
            <column caption='New to PRO Customers' datatype='integer' name='[Calculation_5314247594088665096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[new_to_pro_customers]' />
            </column>
            <column caption='PRO DEAL UTR' datatype='real' default-format='p0.0%' name='[Calculation_5314247594089123849]' role='measure' type='quantitative'>
