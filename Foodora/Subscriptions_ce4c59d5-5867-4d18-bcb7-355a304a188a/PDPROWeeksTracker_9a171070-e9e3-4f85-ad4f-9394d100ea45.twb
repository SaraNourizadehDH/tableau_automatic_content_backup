      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_09CEC3B22FF1422EBAF8F23327FA5EE7'>
            <properties context=''>
              <relation connection='bigquery.00ad52504xxmbm17pikvk0tswa68' name='Custom SQL Query' type='text'><![CDATA[-- PRO WEEKS DASHBOARD - VIEW 1: GENERAL TRENDS WITH MONTHLY PERFORMANCE
-- CHANGED: Aggregated from daily to monthly level

WITH pro_weeks_calendar AS (
  -- Define Pro Weeks periods
  SELECT
    c.global_entity_id,
    start_date as pro_week_start_date,
    end_date as pro_week_end_date,
    EXTRACT(QUARTER FROM start_date) AS quarter,
    EXTRACT(YEAR FROM start_date) AS year,
    EXTRACT(MONTH FROM start_date) AS month,
    DATE_DIFF(end_date, start_date, DAY) + 1 AS duration_days
  FROM `dhh---analytics-eu.pandata_report.pro_weeks_calendar_1` p
  INNER JOIN `fulfillment-dwh-production.pandata_datamart.pandora__core_countries` AS c
    ON p.countries = c.name
  WHERE start_date >>= '2025-05-01'
),

pro_weeks_item_deal AS (
    SELECT
    DISTINCT
    i.global_entity_id,
    i.vendor_code,
    i.order_code,
    i.report_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS o
  LEFT JOIN `dhh---analytics-eu.bi_marketing.temp_na_pro_item_level_deal_table` AS i
    ON o.global_entity_id = i.global_entity_id
    AND o.order_code = i.order_code
  LEFT JOIN pro_weeks_calendar pwc
    ON o.global_entity_id = pwc.global_entity_id
  WHERE created_date_local >>= '2025-05-01'
    AND is_pro_item_deal
    --AND o.is_subscriber_order
    AND i.report_date >>= '2025-05-01'
    AND o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date
  GROUP BY ALL
),

savings AS
(
  SELECT
  sav.global_entity_id,
  sav.report_date,
  sav.order_code,
  SUM((sav.pro_fd_savings + sav.pro_deal_savings)) AS savings_numerator,
  SUM(pro_deal_vendor_savings) as pro_deal_vendor_savings
  FROM `dhh---analytics-eu.pandata_report.temp_na_pro_weeks_dash_savings` sav
  WHERE sav.report_date >>= '2025-05-01'
  GROUP BY ALL
),

-- Get monthly Pro orders and GMV (changed from daily)
monthly_pro_metrics AS (
  SELECT
    DATE_TRUNC(o.created_date_local, MONTH) AS report_month,
    o.global_entity_id,
    o.country_name,
    EXTRACT(QUARTER FROM DATE_TRUNC(o.created_date_local, MONTH)) AS quarter,
    EXTRACT(YEAR FROM DATE_TRUNC(o.created_date_local, MONTH)) AS year,
    EXTRACT(MONTH FROM DATE_TRUNC(o.created_date_local, MONTH)) AS month,
    
    -- Pro Week flags - check if ANY day in the month falls within pro week period
    MAX(CASE WHEN o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date THEN 1 ELSE 0 END) = 1 AS has_pro_week,
    
    -- Count number of pro week days in the month
    COUNT(DISTINCT CASE WHEN o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date THEN o.created_date_local END) AS pro_week_days_count,

    -- Core metrics (monthly aggregation)
    COUNT(DISTINCT IF(o.is_subscriber_order, o.order_code, NULL)) AS pro_orders,
    COUNT(DISTINCT o.order_code) AS total_orders,
    SUM(IF(o.is_subscriber_order, o.user_paid_gmv_eur, 0)) AS pro_gmv_eur,
    SUM(o.user_paid_gmv_eur) AS total_gmv_eur,
    
    -- Discount metrics
    COUNT(DISTINCT IF(o.is_subscription_discount_order, o.order_code, NULL)) AS pro_discount_orders,
    COUNT(DISTINCT IF(o.is_discounted_delivery_subscription_order, o.order_code, NULL)) AS pro_fd_discount_orders,
    SUM(IF(o.is_subscription_discount_order, o.user_paid_gmv_eur, 0)) AS pro_discount_gmv_eur,
    SUM(IF(o.is_subscription_discount_order, o.discount_value_eur, 0)) AS pro_discount_value_eur,
    SUM(o.discount_value_eur) AS platform_discount_value_eur,
    
    -- Customer metrics - COUNT DISTINCT ensures no duplication
    COUNT(DISTINCT IF(o.is_subscriber_order, o.pd_customer_uuid, NULL)) AS pro_users_with_order,
    COUNT(DISTINCT IF(NOT o.is_subscriber_order, o.pd_customer_uuid, NULL)) AS non_pro_users_with_order,
    COUNT(DISTINCT o.pd_customer_uuid) AS platform_users,

    --PRO Weeks Metrics (only during pro week periods)
    COUNT(DISTINCT IF((o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date), pwi.order_code, NULL)) AS pro_weeks_item_deal_orders,
    SUM(IF((o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date) AND pwd.vendor_code IS NOT NULL, o.discount_value_eur, 0)) AS pro_weeks_vendors_discount_value_eur,
    SUM(IF((o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date) AND o.is_subscription_discount_order, o.user_paid_gmv_eur, 0)) AS pro_weeks_vendors_gmv_eur,
    
    -- Vendor metrics
    COUNT(DISTINCT IF(o.is_subscription_discount_order, o.vendor_code, NULL)) AS vendors_with_pro_deals,

    -- Saving Cost
    SUM(IF(pwd.vendor_code IS NOT NULL, sav.pro_deal_vendor_savings, NULL)) AS pro_deal_value_from_pro_week_vendors,
    SUM(sav.savings_numerator) AS savings_numerator, 
    SUM(IF(o.is_subscriber_order, o.gfv_eur, NULL)) AS savings_denominator,
    SUM(o.discount_cost_dh_eur + o.voucher_cost_dh_eur) AS dh_funding_cost,
    SUM(IF(pwi.order_code Is NOT NULL, o.discount_cost_dh_eur + o.voucher_cost_dh_eur, NULL)) AS pro_week_item_deals_dh_funding_cost,
    SUM(o.discount_cost_vendor_eur + o.voucher_cost_vendor_eur) AS vendor_funding_cost,
    
    -- Monthly averages for comparison
    COUNT(DISTINCT o.created_date_local) AS active_days_in_month

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` o
  LEFT JOIN pro_weeks_calendar pwc
    ON o.global_entity_id = pwc.global_entity_id
    AND o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date
  LEFT JOIN pro_weeks_item_deal pwi
    ON o.global_entity_id = pwi.global_entity_id
    AND o.order_code = pwi.order_code
  LEFT JOIN (SELECT DISTINCT pro_weeks_item_deal.global_entity_id, pro_weeks_item_deal.report_date, pro_weeks_item_deal.vendor_code FROM pro_weeks_item_deal) pwd
    ON o.global_entity_id = pwd.global_entity_id
    AND o.vendor_code = pwd.vendor_code
  LEFT JOIN savings AS sav
    ON sav.global_entity_id = o.global_entity_id
    AND sav.order_code = o.order_code
  WHERE o.is_successful
    AND o.created_date_local >>= '2025-05-01'
    --AND o.global_entity_id = 'NP_HU'
  GROUP BY 
    ALL
),

-- Business type metrics (monthly aggregation)
business_type_metrics AS (
  SELECT
    DATE_TRUNC(o.created_date_local, MONTH) AS report_month,
    o.global_entity_id,
    o.business_type,
    
    -- Metrics by business type
    COUNT(DISTINCT IF(o.is_subscriber_order, o.order_code, NULL)) AS pro_orders,
    SUM(IF(o.is_subscriber_order, o.user_paid_gmv_eur, 0)) AS pro_gmv_eur,
    COUNT(DISTINCT IF(o.is_subscription_discount_order, o.vendor_code, NULL)) AS vendors_with_pro_deals
    
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` o
  WHERE o.is_successful
    AND o.created_date_local >>= '2025-05-01'
    --AND o.global_entity_id = 'NP_HU'
  GROUP BY 1, 2, 3
),

-- Get subscriber metrics from the subscription table (monthly aggregation)
monthly_subscriber_metrics AS (
  SELECT
    DATE_TRUNC(s.report_date, MONTH) AS report_month,
    s.global_entity_id,
    s.country_name,

    -- Monthly movements (sum daily movements)
    SUM(s.daily_signup_count) AS monthly_signups,
    SUM(s.daily_cancelling_count) AS monthly_cancellations,
    SUM(s.daily_payment_fail_count) AS monthly_payment_failures,
    
    -- New customer acquisition
    SUM(s.signup_count_new_sub) AS new_to_pro_customers,
    SUM(s.newly_active_subscriber) AS newly_active_subscribers,
    SUM(s.signup_count_new_sub) AS new_subscriber_activations,
    SUM(s.daily_signup_count) - SUM(s.signup_count_new_sub) AS returning_subscriber_activations,
    
    -- Net subscriber change
    SUM(s.daily_signup_count) - SUM(s.daily_cancelling_count) AS net_subscriber_change

  FROM `fulfillment-dwh-production.pandata_report.marketing__pandora_subscription_subscriber_acquisition_churn` s
  WHERE s.report_date >>= '2025-05-01'
    --AND s.global_entity_id = 'NP_HU'
  GROUP BY 1, 2, 3
),

monthly_subscriber_count_metrics AS (
    SELECT
      report_date as report_month,
      s.global_entity_id,
      s.country_name,
      sum(s.active_subscribers) as  total_active_subscribers_end_of_month,
      sum(s.active_subscribers_with_l30d_order) as active_subscribers_l30d_order_end_of_month,
    FROM `fulfillment-dwh-production.pandata_report.marketing__pandora_subscription_subscriber_acquisition_churn` s
    WHERE s.report_date >>= '2025-05-01' and s.report_date <<= CURRENT_DATE() - 1
    AND  (report_date = LAST_DAY(report_date, MONTH) OR report_date = CURRENT_DATE() - 1)
    group by all
),

-- Get vendor participation metrics (monthly aggregation)

vendor_participation AS (
  SELECT
    DATE_TRUNC(v.report_date, MONTH) AS report_month,
    v.global_entity_id,
    
    -- Vendor counts (average for the month)
    SUM(IF((report_date = LAST_DAY(report_date, month) OR report_date = CURRENT_DATE() - 1) AND v.vendor_type = 'pro', v.vendors, 0)) AS avg_vendors_with_pro_deals,
    SUM(IF(v.vendor_type = 'platform', v.vendors, 0)) AS avg_total_vendors,
    
    -- GMV from Pro deal vendors (sum for the month)
    SUM(IF(v.vendor_type = 'pro', v.gmv_eur_subscription_discount, 0)) AS pro_deal_gmv,
    SUM(IF(v.vendor_type = 'pro', v.gmv_eur, 0)) AS total_gmv_from_pro_vendors
    
  FROM `fulfillment-dwh-production.pandata_report.marketing__subscription_pro_deals_overview` v
  WHERE v.report_date >>= '2025-05-01'
    --AND v.global_entity_id = 'NP_HU'
    AND v.expedition_type_category = 'all'
  GROUP BY ALL
),

-- Calculate month-over-month and year-over-year metrics
monthly_comparison AS (
  SELECT
    m.*,
    -- Previous month metrics
    LAG(m.pro_orders, 1) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_month) AS pro_orders_prev_month,
    LAG(m.pro_gmv_eur, 1) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_month) AS pro_gmv_prev_month,
    LAG(m.platform_users, 1) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_month) AS platform_users_prev_month,
    
    -- Same month previous year (12 months ago)
    LAG(m.pro_orders, 12) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_month) AS pro_orders_yoy,
    LAG(m.pro_gmv_eur, 12) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_month) AS pro_gmv_yoy,
    LAG(m.platform_users, 12) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_month) AS platform_users_yoy,
    
    -- 3-month rolling averages
    AVG(m.pro_orders) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_month ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS pro_orders_3m_avg,
    AVG(m.pro_gmv_eur) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_month ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS pro_gmv_3m_avg
    
  FROM monthly_pro_metrics m
),

-- Final aggregation
final_metrics AS (
  SELECT
    mc.report_month,
    mc.global_entity_id,
    mc.country_name,
    mc.quarter,
    mc.year,
    mc.month,
    mc.has_pro_week,
    mc.pro_week_days_count,
    mc.active_days_in_month,
    
    -- Month identification
    FORMAT_DATE('%B %Y', mc.report_month) AS month_name,
    CONCAT('Q', CAST(mc.quarter AS STRING), ' ', CAST(mc.year AS STRING)) AS quarter_label,
    
    -- Pro Orders Metrics
    mc.pro_orders,
    mc.total_orders,
    SAFE_DIVIDE(mc.pro_orders, mc.total_orders) AS pro_orders_percentage,
    mc.pro_weeks_item_deal_orders,
    -- Daily averages
    SAFE_DIVIDE(mc.pro_orders, mc.active_days_in_month) AS avg_daily_pro_orders,
    SAFE_DIVIDE(mc.total_orders, mc.active_days_in_month) AS avg_daily_total_orders,

    -- Pro GMV Metrics
    mc.pro_gmv_eur,
    mc.total_gmv_eur,
    SAFE_DIVIDE(mc.pro_gmv_eur, mc.total_gmv_eur) AS pro_gmv_percentage,
    -- Daily averages
    SAFE_DIVIDE(mc.pro_gmv_eur, mc.active_days_in_month) AS avg_daily_pro_gmv,
    SAFE_DIVIDE(mc.total_gmv_eur, mc.active_days_in_month) AS avg_daily_total_gmv,
    
    -- Pro Deal Metrics
    mc.pro_discount_orders,
    mc.pro_fd_discount_orders,
    mc.pro_discount_gmv_eur,
    mc.pro_discount_value_eur,
    SAFE_DIVIDE(mc.pro_discount_orders, mc.pro_orders) AS pro_deal_penetration,
    
    -- Customer Metrics
    mc.pro_users_with_order,
    mc.non_pro_users_with_order,
    mc.platform_users,
    
    -- Subscriber Metrics
    COALESCE(msc.total_active_subscribers_end_of_month, 0) AS active_subscribers_end_of_month,
    COALESCE(msc.active_subscribers_l30d_order_end_of_month, 0) AS active_subscribers_l30d_order,
    SAFE_DIVIDE(msc.active_subscribers_l30d_order_end_of_month, msc.total_active_subscribers_end_of_month) AS mau_penetration,
    COALESCE(ms.monthly_signups, 0) AS monthly_signups,
    COALESCE(ms.monthly_cancellations, 0) AS monthly_cancellations,
    COALESCE(ms.net_subscriber_change, 0) AS net_subscriber_change,
    COALESCE(ms.new_to_pro_customers, 0) AS new_to_pro_customers,
    COALESCE(ms.new_subscriber_activations, 0) AS new_subscriber_activations,
    COALESCE(ms.returning_subscriber_activations, 0) AS returning_subscriber_activations,
    
    -- Vendor Metrics
    mc.vendors_with_pro_deals AS vendors_with_pro_deals_from_orders,
    COALESCE(vp.avg_vendors_with_pro_deals, 0) AS avg_vendors_with_pro_deals,
    COALESCE(vp.avg_total_vendors, 0) AS avg_total_vendors,
    SAFE_DIVIDE(mc.vendors_with_pro_deals, vp.avg_total_vendors) AS vendor_participation_rate,
    COALESCE(vp.pro_deal_gmv, 0) AS pro_deal_gmv_from_vendor_table,
    COALESCE(mc.pro_weeks_vendors_discount_value_eur, 0) AS pro_weeks_vendors_discount_value_eur,
    COALESCE(mc.pro_weeks_vendors_gmv_eur, 0) AS pro_weeks_vendors_gmv_eur,
    COALESCE(vp.total_gmv_from_pro_vendors, 0) AS total_gmv_from_pro_vendors,
    
    -- Month-over-month comparisons
    mc.pro_orders_prev_month,
    SAFE_DIVIDE(mc.pro_orders - mc.pro_orders_prev_month, mc.pro_orders_prev_month) AS pro_orders_mom_change,
    mc.pro_gmv_prev_month,
    SAFE_DIVIDE(mc.pro_gmv_eur - mc.pro_gmv_prev_month, mc.pro_gmv_prev_month) AS pro_gmv_mom_change,
    
    -- Year-over-year comparisons
    mc.pro_orders_yoy,
    SAFE_DIVIDE(mc.pro_orders - mc.pro_orders_yoy, mc.pro_orders_yoy) AS pro_orders_yoy_change,
    mc.pro_gmv_yoy,
    SAFE_DIVIDE(mc.pro_gmv_eur - mc.pro_gmv_yoy, mc.pro_gmv_yoy) AS pro_gmv_yoy_change,
    
    -- Customer growth
    mc.platform_users_prev_month,
    SAFE_DIVIDE(mc.platform_users - mc.platform_users_prev_month, mc.platform_users_prev_month) AS platform_users_mom_change,
    mc.platform_users_yoy,
    SAFE_DIVIDE(mc.platform_users - mc.platform_users_yoy, mc.platform_users_yoy) AS platform_users_yoy_change,
    
    -- Rolling averages
    mc.pro_orders_3m_avg,
    mc.pro_gmv_3m_avg,
    
    -- Monthly join rate calculation
    SAFE_DIVIDE(ms.monthly_signups, mc.non_pro_users_with_order) AS monthly_join_rate,
    
    -- Join rate previous month
    LAG(SAFE_DIVIDE(ms.monthly_signups, mc.non_pro_users_with_order), 1) 
      OVER (PARTITION BY mc.global_entity_id ORDER BY mc.report_month) AS join_rate_prev_month,
    
    -- Savings metrics
    SAFE_DIVIDE(mc.pro_discount_value_eur, mc.pro_discount_gmv_eur) AS avg_discount_percentage,
    mc.pro_deal_value_from_pro_week_vendors,
    mc.savings_numerator,
    mc.savings_denominator,
    mc.pro_discount_value_eur AS total_pro_weeks_savings,
    mc.platform_discount_value_eur,
    mc.dh_funding_cost,
    mc.pro_week_item_deals_dh_funding_cost,
    mc.vendor_funding_cost,

  FROM monthly_comparison mc
  LEFT JOIN monthly_subscriber_metrics ms
    ON mc.report_month = ms.report_month
    AND mc.global_entity_id = ms.global_entity_id
  LEFT JOIN monthly_subscriber_count_metrics msc
    ON mc.report_month = DATE_TRUNC(msc.report_month, month)
    AND mc.global_entity_id = msc.global_entity_id
  LEFT JOIN vendor_participation vp
    ON mc.report_month = vp.report_month
    AND mc.global_entity_id = vp.global_entity_id
)

SELECT 
  *,
  -- Additional calculated fields for Tableau
  CASE 
    WHEN has_pro_week THEN 'Month with Pro Week'
    ELSE 'Regular Month'
  END AS period_type,
  
  -- Create period labels for easy filtering
  CASE
    WHEN has_pro_week THEN CONCAT(month_name, ' (', pro_week_days_count, ' Pro Week days)')
    ELSE CONCAT(month_name, ' (No Pro Week)')
  END AS pro_week_label,
  
  -- Join rate change (important metric)
  SAFE_DIVIDE(monthly_join_rate - join_rate_prev_month, join_rate_prev_month) AS join_rate_mom_change,
  
  -- Month boundaries for reference
  report_month AS month_start_date,
  LAST_DAY(report_month) AS month_end_date,
  
  -- Performance vs 3-month average
  SAFE_DIVIDE(pro_orders - pro_orders_3m_avg, pro_orders_3m_avg) AS pro_orders_vs_3m_avg,
  SAFE_DIVIDE(pro_gmv_eur - pro_gmv_3m_avg, pro_gmv_3m_avg) AS pro_gmv_vs_3m_avg
  
FROM final_metrics
ORDER BY report_month DESC, global_entity_id]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Weekly KPIs' inline='true' name='federated.1nf0uxe1lppcfm1a1t7jb006dqf2' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1blovlt183wmb712tyvme1oyhra0'>
            <connection CATALOG='dhh---analytics-eu' EXECCATALOG='dhh---analytics-eu' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='EU Data Production' schema='bi_marketing' server-oauth='' username='nazmi.aydin@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1blovlt183wmb712tyvme1oyhra0' name='Custom SQL Query' type='text'>-- PRO WEEKS DASHBOARD - VIEW 1: GENERAL TRENDS WITH WEEKLY PERFORMANCE
-- CHANGED: Aggregated from daily to weekly level

WITH pro_weeks_calendar AS (
  -- Define Pro Weeks periods
  SELECT
    c.global_entity_id,
    start_date as pro_week_start_date,
    end_date as pro_week_end_date,
    EXTRACT(QUARTER FROM start_date) AS quarter,
    EXTRACT(YEAR FROM start_date) AS year,
    DATE_DIFF(end_date, start_date, DAY) + 1 AS duration_days
  FROM `dhh---analytics-eu.pandata_report.pro_weeks_calendar_1` p
  INNER JOIN `fulfillment-dwh-production.pandata_datamart.pandora__core_countries` AS c
    ON p.countries = c.name
  WHERE start_date &gt;&gt;= &apos;2025-06-16&apos;
),

pro_weeks_item_deal AS (
    SELECT
    DISTINCT
    i.global_entity_id,
    i.vendor_code,
    i.order_code,
    i.report_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS o
  LEFT JOIN `dhh---analytics-eu.bi_marketing.temp_na_pro_item_level_deal_table` AS i
    ON o.global_entity_id = i.global_entity_id
    AND o.order_code = i.order_code
  LEFT JOIN pro_weeks_calendar pwc
    ON o.global_entity_id = pwc.global_entity_id
  WHERE created_date_local &gt;&gt;= &apos;2025-06-16&apos;
    AND is_pro_item_deal
    AND i.report_date &gt;&gt;= &apos;2025-06-16&apos;
    AND o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date
  GROUP BY ALL
),

savings AS
(
  SELECT
  sav.global_entity_id,
  sav.report_date,
  sav.order_code,
  SUM((sav.pro_fd_savings + sav.pro_deal_savings)) AS savings_numerator,
  SUM(pro_deal_vendor_savings) as pro_deal_vendor_savings
  FROM `dhh---analytics-eu.pandata_report.temp_na_pro_weeks_dash_savings` sav
  WHERE sav.report_date &gt;&gt;= &apos;2025-06-16&apos;
  GROUP BY ALL
),

-- Get weekly Pro orders and GMV (changed from daily)
weekly_pro_metrics AS (
  SELECT
    DATE_TRUNC(o.created_date_local, ISOWEEK) AS report_week,
    o.global_entity_id,
    o.country_name,
    -- Pro Week flags - check if ANY day in the week falls within pro week period
    --MAX(CASE WHEN o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date THEN 1 ELSE 0 END) = 1 AS is_pro_week,

    -- Core metrics (weekly aggregation)
    COUNT(DISTINCT IF(o.is_subscriber_order, o.order_code, NULL)) AS pro_orders,
    COUNT(DISTINCT o.order_code) AS total_orders,
    SUM(IF(o.is_subscriber_order, o.user_paid_gmv_eur, 0)) AS pro_gmv_eur,
    SUM(o.user_paid_gmv_eur) AS total_gmv_eur,
    
    -- Discount metrics
    COUNT(DISTINCT IF(o.is_subscription_discount_order, o.order_code, NULL)) AS pro_discount_orders,
    COUNT(DISTINCT IF(o.is_discounted_delivery_subscription_order, o.order_code, NULL)) AS pro_fd_discount_orders,
    SUM(IF(o.is_subscription_discount_order, o.user_paid_gmv_eur, 0)) AS pro_discount_gmv_eur,
    SUM(IF(o.is_subscription_discount_order, o.discount_value_eur, 0)) AS pro_discount_value_eur,
    SUM(o.discount_value_eur) AS platform_discount_value_eur,
    
    -- Customer metrics - COUNT DISTINCT ensures no duplication
    COUNT(DISTINCT IF(o.is_subscriber_order, o.pd_customer_uuid, NULL)) AS pro_users_with_order,
    COUNT(DISTINCT IF(NOT o.is_subscriber_order, o.pd_customer_uuid, NULL)) AS non_pro_users_with_order,
    COUNT(DISTINCT o.pd_customer_uuid) AS platform_users,

    --PRO Weeks Metrics
    COUNT(DISTINCT IF((o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date), pwi.order_code, NULL)) AS pro_weeks_item_deal_orders,
    SUM(IF((o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date) AND pwd.vendor_code IS NOT NULL, o.discount_value_eur, 0)) AS pro_weeks_vendors_discount_value_eur,
    SUM(IF((o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date) AND o.is_subscription_discount_order, o.user_paid_gmv_eur, 0)) AS pro_weeks_vendors_gmv_eur,
    
    -- Vendor metrics
    COUNT(DISTINCT IF(o.is_subscription_discount_order, o.vendor_code, NULL)) AS vendors_with_pro_deals,

    -- Saving Cost
    SUM(IF(pwd.vendor_code IS NOT NULL, sav.pro_deal_vendor_savings, NULL)) AS pro_deal_value_from_pro_week_vendors,
    SUM(sav.savings_numerator) AS savings_numerator,
    SUM(IF(o.is_subscriber_order, o.gfv_eur, NULL)) AS savings_denominator,
    SUM(COALESCE(o.voucher_cost_dh_eur, 0) + COALESCE(o.discount_cost_dh_eur, 0)) AS dh_funding_cost,
    SUM(IF(pwi.order_code Is NOT NULL, COALESCE(o.discount_cost_dh_eur, 0) + COALESCE(o.voucher_cost_dh_eur, 0), NULL)) AS pro_week_item_deals_dh_funding_cost,
    SUM(o.discount_cost_vendor_eur + o.voucher_cost_vendor_eur) AS vendor_funding_cost

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` o
  LEFT JOIN pro_weeks_calendar pwc
    ON o.global_entity_id = pwc.global_entity_id
    AND o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date
  LEFT JOIN pro_weeks_item_deal pwi
    ON o.global_entity_id = pwi.global_entity_id
    AND o.order_code = pwi.order_code
  LEFT JOIN (SELECT DISTINCT pro_weeks_item_deal.global_entity_id, pro_weeks_item_deal.report_date, pro_weeks_item_deal.vendor_code FROM pro_weeks_item_deal) pwd
    ON o.global_entity_id = pwd.global_entity_id
    AND o.vendor_code = pwd.vendor_code
  LEFT JOIN savings AS sav
    ON sav.global_entity_id = o.global_entity_id
    AND sav.order_code = o.order_code
  WHERE o.is_successful
    AND o.created_date_local &gt;&gt;= &apos;2025-06-16&apos;
    --AND o.global_entity_id = &apos;FP_MY&apos;
  GROUP BY 
    ALL
),

-- Business type metrics (weekly aggregation)
business_type_metrics AS (
  SELECT
    DATE_TRUNC(o.created_date_local, ISOWEEK) AS report_week,
    o.global_entity_id,
    o.business_type,
    
    -- Metrics by business type
    COUNT(DISTINCT IF(o.is_subscriber_order, o.order_code, NULL)) AS pro_orders,
    SUM(IF(o.is_subscriber_order, o.user_paid_gmv_eur, 0)) AS pro_gmv_eur,
    COUNT(DISTINCT IF(o.is_subscription_discount_order, o.vendor_code, NULL)) AS vendors_with_pro_deals
    
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` o
  WHERE o.is_successful
    AND o.created_date_local &gt;&gt;= &apos;2025-06-16&apos;
    --AND o.global_entity_id = &apos;FP_MY&apos;
  GROUP BY 1, 2, 3
),

-- Get subscriber metrics from the subscription table (weekly aggregation)
weekly_subscriber_metrics AS (
  SELECT
    DATE_TRUNC(s.report_date, ISOWEEK) AS report_week,
    s.global_entity_id,
    s.country_name,
    
    -- Weekly movements (sum daily movements)
    SUM(s.daily_signup_count) AS weekly_signups,
    SUM(s.daily_cancelling_count) AS weekly_cancellations,
    SUM(s.daily_payment_fail_count) AS weekly_payment_failures,
    
    -- New customer acquisition
    SUM(s.signup_count_new_sub) AS new_to_pro_customers,
    SUM(s.newly_active_subscriber) AS newly_active_subscribers,
    SUM(s.signup_count_new_sub) AS new_subscriber_activations,
    SUM(s.daily_signup_count) - SUM(s.signup_count_new_sub) AS returning_subscriber_activations

  FROM `fulfillment-dwh-production.pandata_report.marketing__pandora_subscription_subscriber_acquisition_churn` s
  WHERE s.report_date &gt;&gt;= &apos;2025-06-16&apos;
    --AND s.global_entity_id = &apos;FP_MY&apos;
  GROUP BY 1, 2, 3
),

weekly_subscriber_count_metrics AS (

  SELECT
    s.report_date,
    s.global_entity_id,
    s.country_name,
    
    -- Active subscribers (take Monday values for snapshot metrics)
    SUM(CASE WHEN EXTRACT(DAYOFWEEK FROM s.report_date) = 2 THEN s.active_subscribers END) AS total_active_subscribers,
    SUM(CASE WHEN EXTRACT(DAYOFWEEK FROM s.report_date) = 2 THEN s.active_subscribers_with_l30d_order END) AS active_subscribers_l30d_order,

FROM fulfillment-dwh-production.pandata_report.marketing__pandora_subscription_subscriber_acquisition_churn s
WHERE s.report_date &gt;&gt;= &apos;2025-06-16&apos;
   AND EXTRACT(DAYOFWEEK FROM s.report_date) = 2
    --AND s.global_entity_id = &apos;FP_MY&apos;
GROUP BY 1, 2, 3
),

-- Get vendor participation metrics (weekly aggregation)
vendor_participation AS (
  SELECT
    DATE_TRUNC(v.report_date, ISOWEEK) AS report_week,
    v.global_entity_id,
    
    -- Vendor counts (average for the week)
    MAX(IF(v.vendor_type = &apos;pro&apos;, v.vendors, 0)) AS vendors_with_pro_deals,
    MAX(IF(v.vendor_type = &apos;platform&apos;, v.vendors, 0)) AS total_vendors,
    
    -- GMV from Pro deal vendors (sum for the week)
    SUM(IF(v.vendor_type = &apos;pro&apos;, v.gmv_eur_subscription_discount, 0)) AS pro_deal_gmv,
    SUM(IF(v.vendor_type = &apos;pro&apos;, v.gmv_eur, 0)) AS total_gmv_from_pro_vendors
    
  FROM `fulfillment-dwh-production.pandata_report.marketing__subscription_pro_deals_overview` v
  WHERE v.report_date &gt;&gt;= &apos;2025-06-16&apos;
    --AND v.global_entity_id = &apos;FP_MY&apos;
  GROUP BY ALL
),

-- Calculate week-over-week metrics
weekly_comparison AS (
  SELECT
    m.*,
    -- Previous week metrics
    LAG(m.pro_orders, 1) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_week) AS pro_orders_prev_week,
    LAG(m.pro_gmv_eur, 1) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_week) AS pro_gmv_prev_week,
    LAG(m.platform_users, 1) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_week) AS platform_users_prev_week,
    
    -- Same week previous year (52 weeks ago)
    LAG(m.pro_orders, 52) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_week) AS pro_orders_yoy,
    LAG(m.pro_gmv_eur, 52) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_week) AS pro_gmv_yoy
    
  FROM weekly_pro_metrics m
),

-- Final aggregation
final_metrics AS (
  SELECT
    wc.report_week,
    wc.global_entity_id,
    wc.country_name,
    --wc.is_pro_week,
    
    -- Pro Orders Metrics
    wc.pro_orders,
    wc.total_orders,
    SAFE_DIVIDE(wc.pro_orders, wc.total_orders) AS pro_orders_percentage,
    wc.pro_weeks_item_deal_orders,

    -- Pro GMV Metrics
    wc.pro_gmv_eur,
    wc.total_gmv_eur,
    SAFE_DIVIDE(wc.pro_gmv_eur, wc.total_gmv_eur) AS pro_gmv_percentage,
    
    -- Pro Deal Metrics
    wc.pro_discount_orders,
    wc.pro_fd_discount_orders,
    wc.pro_discount_gmv_eur,
    wc.pro_discount_value_eur,
    SAFE_DIVIDE(wc.pro_discount_orders, wc.pro_orders) AS pro_deal_penetration,
    
    -- Customer Metrics
    wc.pro_users_with_order,
    wc.non_pro_users_with_order,
    wc.platform_users,
    
    -- Subscriber Metrics
    COALESCE(wsc.total_active_subscribers, 0) AS active_subscribers,
    COALESCE(wsc.active_subscribers_l30d_order, 0) AS active_subscribers_l30d_order,
    SAFE_DIVIDE(wsc.active_subscribers_l30d_order, wsc.total_active_subscribers) AS activity_rate,
    COALESCE(ws.weekly_signups, 0) AS weekly_signups,
    COALESCE(ws.new_to_pro_customers, 0) AS new_to_pro_customers,
    COALESCE(ws.new_subscriber_activations, 0) AS new_subscriber_activations,
    COALESCE(ws.returning_subscriber_activations, 0) AS returning_subscriber_activations,
    
    -- Vendor Metrics
    wc.vendors_with_pro_deals AS vendors_with_pro_deals_from_orders,
    COALESCE(vp.vendors_with_pro_deals, 0) AS vendors_with_pro_deals_from_vendor_table,
    COALESCE(vp.total_vendors, 0) AS total_vendors,
    SAFE_DIVIDE(wc.vendors_with_pro_deals, vp.total_vendors) AS vendor_participation_rate,
    COALESCE(vp.pro_deal_gmv, 0) AS pro_deal_gmv_from_vendor_table,
    COALESCE(wc.pro_weeks_vendors_discount_value_eur, 0) AS pro_weeks_vendors_discount_value_eur,
    COALESCE(wc.pro_weeks_vendors_gmv_eur, 0) AS pro_weeks_vendors_gmv_eur,
    COALESCE(vp.total_gmv_from_pro_vendors, 0) AS total_gmv_from_pro_vendors,
    
    -- Week-over-week comparisons
    wc.pro_orders_prev_week,
    SAFE_DIVIDE(wc.pro_orders - wc.pro_orders_prev_week, wc.pro_orders_prev_week) AS pro_orders_wow_change,
    wc.pro_gmv_prev_week,
    SAFE_DIVIDE(wc.pro_gmv_eur - wc.pro_gmv_prev_week, wc.pro_gmv_prev_week) AS pro_gmv_wow_change,
    
    -- Year-over-year comparisons
    wc.pro_orders_yoy,
    SAFE_DIVIDE(wc.pro_orders - wc.pro_orders_yoy, wc.pro_orders_yoy) AS pro_orders_yoy_change,
    wc.pro_gmv_yoy,
    SAFE_DIVIDE(wc.pro_gmv_eur - wc.pro_gmv_yoy, wc.pro_gmv_yoy) AS pro_gmv_yoy_change,
    
    -- Customer growth
    wc.platform_users_prev_week,
    SAFE_DIVIDE(wc.platform_users - wc.platform_users_prev_week, wc.platform_users_prev_week) AS platform_users_wow_change,
    
    -- Weekly join rate calculation
    SAFE_DIVIDE(ws.weekly_signups, wc.non_pro_users_with_order) AS weekly_join_rate,
    
    -- Join rate previous week
    LAG(SAFE_DIVIDE(ws.weekly_signups, wc.non_pro_users_with_order), 1) 
      OVER (PARTITION BY wc.global_entity_id ORDER BY wc.report_week) AS join_rate_prev_week,
    
    -- Savings metrics
    SAFE_DIVIDE(wc.pro_discount_value_eur, wc.pro_discount_gmv_eur) AS avg_discount_percentage,
    wc.pro_deal_value_from_pro_week_vendors,
    wc.savings_numerator,
    wc.savings_denominator,
    wc.pro_discount_value_eur AS total_pro_weeks_savings,
    wc.platform_discount_value_eur,
    wc.dh_funding_cost,
    wc.pro_week_item_deals_dh_funding_cost,
    wc.vendor_funding_cost

  FROM weekly_comparison wc
  LEFT JOIN weekly_subscriber_metrics ws
    ON wc.report_week = ws.report_week
    AND wc.global_entity_id = ws.global_entity_id
  LEFT JOIN weekly_subscriber_count_metrics wsc
    ON wc.report_week = wsc.report_date
    AND wc.global_entity_id = wsc.global_entity_id
  LEFT JOIN vendor_participation vp
    ON wc.report_week = vp.report_week
    AND wc.global_entity_id = vp.global_entity_id
)

SELECT 
  *,
  -- Additional calculated fields for Tableau
  --CASE 
    --WHEN is_pro_week THEN &apos;Pro Week&apos;
    --ELSE &apos;Regular Period&apos;
  --END AS period_type,
  
  -- Create period labels for easy filtering
  --CASE
    --WHEN is_pro_week THEN CONCAT(&apos;Q&apos;, CAST(quarter AS STRING), &apos; &apos;, CAST(year AS STRING), &apos; Pro Week&apos;)
    --ELSE &apos;Non-Pro Week&apos;
  --END AS pro_week_label,
  
  -- Join rate change (important metric)
  SAFE_DIVIDE(weekly_join_rate - join_rate_prev_week, join_rate_prev_week) AS join_rate_wow_change,
  
  -- Week start/end dates for reference
  report_week AS week_start_date,
  DATE_ADD(report_week, INTERVAL 6 DAY) AS week_end_date
  
FROM final_metrics</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1blovlt183wmb712tyvme1oyhra0' name='Custom SQL Query' type='text'>-- PRO WEEKS DASHBOARD - VIEW 1: GENERAL TRENDS WITH WEEKLY PERFORMANCE
-- CHANGED: Aggregated from daily to weekly level

WITH pro_weeks_calendar AS (
  -- Define Pro Weeks periods
  SELECT
    c.global_entity_id,
    start_date as pro_week_start_date,
    end_date as pro_week_end_date,
    EXTRACT(QUARTER FROM start_date) AS quarter,
    EXTRACT(YEAR FROM start_date) AS year,
    DATE_DIFF(end_date, start_date, DAY) + 1 AS duration_days
  FROM `dhh---analytics-eu.pandata_report.pro_weeks_calendar_1` p
  INNER JOIN `fulfillment-dwh-production.pandata_datamart.pandora__core_countries` AS c
    ON p.countries = c.name
  WHERE start_date &gt;&gt;= &apos;2025-06-16&apos;
),

pro_weeks_item_deal AS (
    SELECT
    DISTINCT
    i.global_entity_id,
    i.vendor_code,
    i.order_code,
    i.report_date
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS o
  LEFT JOIN `dhh---analytics-eu.bi_marketing.temp_na_pro_item_level_deal_table` AS i
    ON o.global_entity_id = i.global_entity_id
    AND o.order_code = i.order_code
  LEFT JOIN pro_weeks_calendar pwc
    ON o.global_entity_id = pwc.global_entity_id
  WHERE created_date_local &gt;&gt;= &apos;2025-06-16&apos;
    AND is_pro_item_deal
    AND i.report_date &gt;&gt;= &apos;2025-06-16&apos;
    AND o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date
  GROUP BY ALL
),

savings AS
(
  SELECT
  sav.global_entity_id,
  sav.report_date,
  sav.order_code,
  SUM((sav.pro_fd_savings + sav.pro_deal_savings)) AS savings_numerator,
  SUM(pro_deal_vendor_savings) as pro_deal_vendor_savings
  FROM `dhh---analytics-eu.pandata_report.temp_na_pro_weeks_dash_savings` sav
  WHERE sav.report_date &gt;&gt;= &apos;2025-06-16&apos;
  GROUP BY ALL
),

-- Get weekly Pro orders and GMV (changed from daily)
weekly_pro_metrics AS (
  SELECT
    DATE_TRUNC(o.created_date_local, ISOWEEK) AS report_week,
    o.global_entity_id,
    o.country_name,
    -- Pro Week flags - check if ANY day in the week falls within pro week period
    --MAX(CASE WHEN o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date THEN 1 ELSE 0 END) = 1 AS is_pro_week,

    -- Core metrics (weekly aggregation)
    COUNT(DISTINCT IF(o.is_subscriber_order, o.order_code, NULL)) AS pro_orders,
    COUNT(DISTINCT o.order_code) AS total_orders,
    SUM(IF(o.is_subscriber_order, o.user_paid_gmv_eur, 0)) AS pro_gmv_eur,
    SUM(o.user_paid_gmv_eur) AS total_gmv_eur,
    
    -- Discount metrics
    COUNT(DISTINCT IF(o.is_subscription_discount_order, o.order_code, NULL)) AS pro_discount_orders,
    COUNT(DISTINCT IF(o.is_discounted_delivery_subscription_order, o.order_code, NULL)) AS pro_fd_discount_orders,
    SUM(IF(o.is_subscription_discount_order, o.user_paid_gmv_eur, 0)) AS pro_discount_gmv_eur,
    SUM(IF(o.is_subscription_discount_order, o.discount_value_eur, 0)) AS pro_discount_value_eur,
    SUM(o.discount_value_eur) AS platform_discount_value_eur,
    
    -- Customer metrics - COUNT DISTINCT ensures no duplication
    COUNT(DISTINCT IF(o.is_subscriber_order, o.pd_customer_uuid, NULL)) AS pro_users_with_order,
    COUNT(DISTINCT IF(NOT o.is_subscriber_order, o.pd_customer_uuid, NULL)) AS non_pro_users_with_order,
    COUNT(DISTINCT o.pd_customer_uuid) AS platform_users,

    --PRO Weeks Metrics
    COUNT(DISTINCT IF((o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date), pwi.order_code, NULL)) AS pro_weeks_item_deal_orders,
    SUM(IF((o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date) AND pwd.vendor_code IS NOT NULL, o.discount_value_eur, 0)) AS pro_weeks_vendors_discount_value_eur,
    SUM(IF((o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date) AND o.is_subscription_discount_order, o.user_paid_gmv_eur, 0)) AS pro_weeks_vendors_gmv_eur,
    
    -- Vendor metrics
    COUNT(DISTINCT IF(o.is_subscription_discount_order, o.vendor_code, NULL)) AS vendors_with_pro_deals,

    -- Saving Cost
    SUM(IF(pwd.vendor_code IS NOT NULL, sav.pro_deal_vendor_savings, NULL)) AS pro_deal_value_from_pro_week_vendors,
    SUM(sav.savings_numerator) AS savings_numerator,
    SUM(IF(o.is_subscriber_order, o.gfv_eur, NULL)) AS savings_denominator,
    SUM(COALESCE(o.voucher_cost_dh_eur, 0) + COALESCE(o.discount_cost_dh_eur, 0)) AS dh_funding_cost,
    SUM(IF(pwi.order_code Is NOT NULL, COALESCE(o.discount_cost_dh_eur, 0) + COALESCE(o.voucher_cost_dh_eur, 0), NULL)) AS pro_week_item_deals_dh_funding_cost,
    SUM(o.discount_cost_vendor_eur + o.voucher_cost_vendor_eur) AS vendor_funding_cost

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` o
  LEFT JOIN pro_weeks_calendar pwc
    ON o.global_entity_id = pwc.global_entity_id
    AND o.created_date_local BETWEEN pwc.pro_week_start_date AND pwc.pro_week_end_date
  LEFT JOIN pro_weeks_item_deal pwi
    ON o.global_entity_id = pwi.global_entity_id
    AND o.order_code = pwi.order_code
  LEFT JOIN (SELECT DISTINCT pro_weeks_item_deal.global_entity_id, pro_weeks_item_deal.report_date, pro_weeks_item_deal.vendor_code FROM pro_weeks_item_deal) pwd
    ON o.global_entity_id = pwd.global_entity_id
    AND o.vendor_code = pwd.vendor_code
  LEFT JOIN savings AS sav
    ON sav.global_entity_id = o.global_entity_id
    AND sav.order_code = o.order_code
  WHERE o.is_successful
    AND o.created_date_local &gt;&gt;= &apos;2025-06-16&apos;
    --AND o.global_entity_id = &apos;FP_MY&apos;
  GROUP BY 
    ALL
),

-- Business type metrics (weekly aggregation)
business_type_metrics AS (
  SELECT
    DATE_TRUNC(o.created_date_local, ISOWEEK) AS report_week,
    o.global_entity_id,
    o.business_type,
    
    -- Metrics by business type
    COUNT(DISTINCT IF(o.is_subscriber_order, o.order_code, NULL)) AS pro_orders,
    SUM(IF(o.is_subscriber_order, o.user_paid_gmv_eur, 0)) AS pro_gmv_eur,
    COUNT(DISTINCT IF(o.is_subscription_discount_order, o.vendor_code, NULL)) AS vendors_with_pro_deals
    
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` o
  WHERE o.is_successful
    AND o.created_date_local &gt;&gt;= &apos;2025-06-16&apos;
    --AND o.global_entity_id = &apos;FP_MY&apos;
  GROUP BY 1, 2, 3
),

-- Get subscriber metrics from the subscription table (weekly aggregation)
weekly_subscriber_metrics AS (
  SELECT
    DATE_TRUNC(s.report_date, ISOWEEK) AS report_week,
    s.global_entity_id,
    s.country_name,
    
    -- Weekly movements (sum daily movements)
    SUM(s.daily_signup_count) AS weekly_signups,
    SUM(s.daily_cancelling_count) AS weekly_cancellations,
    SUM(s.daily_payment_fail_count) AS weekly_payment_failures,
    
    -- New customer acquisition
    SUM(s.signup_count_new_sub) AS new_to_pro_customers,
    SUM(s.newly_active_subscriber) AS newly_active_subscribers,
    SUM(s.signup_count_new_sub) AS new_subscriber_activations,
    SUM(s.daily_signup_count) - SUM(s.signup_count_new_sub) AS returning_subscriber_activations

  FROM `fulfillment-dwh-production.pandata_report.marketing__pandora_subscription_subscriber_acquisition_churn` s
  WHERE s.report_date &gt;&gt;= &apos;2025-06-16&apos;
    --AND s.global_entity_id = &apos;FP_MY&apos;
  GROUP BY 1, 2, 3
),

weekly_subscriber_count_metrics AS (

  SELECT
    s.report_date,
    s.global_entity_id,
    s.country_name,
    
    -- Active subscribers (take Monday values for snapshot metrics)
    SUM(CASE WHEN EXTRACT(DAYOFWEEK FROM s.report_date) = 2 THEN s.active_subscribers END) AS total_active_subscribers,
    SUM(CASE WHEN EXTRACT(DAYOFWEEK FROM s.report_date) = 2 THEN s.active_subscribers_with_l30d_order END) AS active_subscribers_l30d_order,

FROM fulfillment-dwh-production.pandata_report.marketing__pandora_subscription_subscriber_acquisition_churn s
WHERE s.report_date &gt;&gt;= &apos;2025-06-16&apos;
   AND EXTRACT(DAYOFWEEK FROM s.report_date) = 2
    --AND s.global_entity_id = &apos;FP_MY&apos;
GROUP BY 1, 2, 3
),

-- Get vendor participation metrics (weekly aggregation)
vendor_participation AS (
  SELECT
    DATE_TRUNC(v.report_date, ISOWEEK) AS report_week,
    v.global_entity_id,
    
    -- Vendor counts (average for the week)
    MAX(IF(v.vendor_type = &apos;pro&apos;, v.vendors, 0)) AS vendors_with_pro_deals,
    MAX(IF(v.vendor_type = &apos;platform&apos;, v.vendors, 0)) AS total_vendors,
    
    -- GMV from Pro deal vendors (sum for the week)
    SUM(IF(v.vendor_type = &apos;pro&apos;, v.gmv_eur_subscription_discount, 0)) AS pro_deal_gmv,
    SUM(IF(v.vendor_type = &apos;pro&apos;, v.gmv_eur, 0)) AS total_gmv_from_pro_vendors
    
  FROM `fulfillment-dwh-production.pandata_report.marketing__subscription_pro_deals_overview` v
  WHERE v.report_date &gt;&gt;= &apos;2025-06-16&apos;
    --AND v.global_entity_id = &apos;FP_MY&apos;
  GROUP BY ALL
),

-- Calculate week-over-week metrics
weekly_comparison AS (
  SELECT
    m.*,
    -- Previous week metrics
    LAG(m.pro_orders, 1) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_week) AS pro_orders_prev_week,
    LAG(m.pro_gmv_eur, 1) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_week) AS pro_gmv_prev_week,
    LAG(m.platform_users, 1) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_week) AS platform_users_prev_week,
    
    -- Same week previous year (52 weeks ago)
    LAG(m.pro_orders, 52) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_week) AS pro_orders_yoy,
    LAG(m.pro_gmv_eur, 52) OVER (PARTITION BY m.global_entity_id ORDER BY m.report_week) AS pro_gmv_yoy
    
  FROM weekly_pro_metrics m
),

-- Final aggregation
final_metrics AS (
  SELECT
    wc.report_week,
    wc.global_entity_id,
    wc.country_name,
    --wc.is_pro_week,
    
    -- Pro Orders Metrics
    wc.pro_orders,
    wc.total_orders,
    SAFE_DIVIDE(wc.pro_orders, wc.total_orders) AS pro_orders_percentage,
    wc.pro_weeks_item_deal_orders,

    -- Pro GMV Metrics
    wc.pro_gmv_eur,
    wc.total_gmv_eur,
    SAFE_DIVIDE(wc.pro_gmv_eur, wc.total_gmv_eur) AS pro_gmv_percentage,
    
    -- Pro Deal Metrics
    wc.pro_discount_orders,
    wc.pro_fd_discount_orders,
    wc.pro_discount_gmv_eur,
    wc.pro_discount_value_eur,
    SAFE_DIVIDE(wc.pro_discount_orders, wc.pro_orders) AS pro_deal_penetration,
    
    -- Customer Metrics
    wc.pro_users_with_order,
    wc.non_pro_users_with_order,
    wc.platform_users,
    
    -- Subscriber Metrics
    COALESCE(wsc.total_active_subscribers, 0) AS active_subscribers,
    COALESCE(wsc.active_subscribers_l30d_order, 0) AS active_subscribers_l30d_order,
    SAFE_DIVIDE(wsc.active_subscribers_l30d_order, wsc.total_active_subscribers) AS activity_rate,
    COALESCE(ws.weekly_signups, 0) AS weekly_signups,
    COALESCE(ws.new_to_pro_customers, 0) AS new_to_pro_customers,
    COALESCE(ws.new_subscriber_activations, 0) AS new_subscriber_activations,
    COALESCE(ws.returning_subscriber_activations, 0) AS returning_subscriber_activations,
    
    -- Vendor Metrics
    wc.vendors_with_pro_deals AS vendors_with_pro_deals_from_orders,
    COALESCE(vp.vendors_with_pro_deals, 0) AS vendors_with_pro_deals_from_vendor_table,
    COALESCE(vp.total_vendors, 0) AS total_vendors,
    SAFE_DIVIDE(wc.vendors_with_pro_deals, vp.total_vendors) AS vendor_participation_rate,
    COALESCE(vp.pro_deal_gmv, 0) AS pro_deal_gmv_from_vendor_table,
    COALESCE(wc.pro_weeks_vendors_discount_value_eur, 0) AS pro_weeks_vendors_discount_value_eur,
    COALESCE(wc.pro_weeks_vendors_gmv_eur, 0) AS pro_weeks_vendors_gmv_eur,
    COALESCE(vp.total_gmv_from_pro_vendors, 0) AS total_gmv_from_pro_vendors,
    
    -- Week-over-week comparisons
    wc.pro_orders_prev_week,
    SAFE_DIVIDE(wc.pro_orders - wc.pro_orders_prev_week, wc.pro_orders_prev_week) AS pro_orders_wow_change,
    wc.pro_gmv_prev_week,
    SAFE_DIVIDE(wc.pro_gmv_eur - wc.pro_gmv_prev_week, wc.pro_gmv_prev_week) AS pro_gmv_wow_change,
    
    -- Year-over-year comparisons
    wc.pro_orders_yoy,
    SAFE_DIVIDE(wc.pro_orders - wc.pro_orders_yoy, wc.pro_orders_yoy) AS pro_orders_yoy_change,
    wc.pro_gmv_yoy,
    SAFE_DIVIDE(wc.pro_gmv_eur - wc.pro_gmv_yoy, wc.pro_gmv_yoy) AS pro_gmv_yoy_change,
    
    -- Customer growth
    wc.platform_users_prev_week,
    SAFE_DIVIDE(wc.platform_users - wc.platform_users_prev_week, wc.platform_users_prev_week) AS platform_users_wow_change,
    
    -- Weekly join rate calculation
    SAFE_DIVIDE(ws.weekly_signups, wc.non_pro_users_with_order) AS weekly_join_rate,
    
    -- Join rate previous week
    LAG(SAFE_DIVIDE(ws.weekly_signups, wc.non_pro_users_with_order), 1) 
      OVER (PARTITION BY wc.global_entity_id ORDER BY wc.report_week) AS join_rate_prev_week,
    
    -- Savings metrics
    SAFE_DIVIDE(wc.pro_discount_value_eur, wc.pro_discount_gmv_eur) AS avg_discount_percentage,
    wc.pro_deal_value_from_pro_week_vendors,
    wc.savings_numerator,
    wc.savings_denominator,
    wc.pro_discount_value_eur AS total_pro_weeks_savings,
    wc.platform_discount_value_eur,
    wc.dh_funding_cost,
    wc.pro_week_item_deals_dh_funding_cost,
    wc.vendor_funding_cost

  FROM weekly_comparison wc
  LEFT JOIN weekly_subscriber_metrics ws
    ON wc.report_week = ws.report_week
    AND wc.global_entity_id = ws.global_entity_id
  LEFT JOIN weekly_subscriber_count_metrics wsc
    ON wc.report_week = wsc.report_date
    AND wc.global_entity_id = wsc.global_entity_id
  LEFT JOIN vendor_participation vp
    ON wc.report_week = vp.report_week
    AND wc.global_entity_id = vp.global_entity_id
)

SELECT 
  *,
  -- Additional calculated fields for Tableau
  --CASE 
    --WHEN is_pro_week THEN &apos;Pro Week&apos;
    --ELSE &apos;Regular Period&apos;
  --END AS period_type,
  
  -- Create period labels for easy filtering
  --CASE
    --WHEN is_pro_week THEN CONCAT(&apos;Q&apos;, CAST(quarter AS STRING), &apos; &apos;, CAST(year AS STRING), &apos; Pro Week&apos;)
    --ELSE &apos;Non-Pro Week&apos;
  --END AS pro_week_label,
  
  -- Join rate change (important metric)
  SAFE_DIVIDE(weekly_join_rate - join_rate_prev_week, join_rate_prev_week) AS join_rate_wow_change,
  
  -- Week start/end dates for reference
  report_week AS week_start_date,
  DATE_ADD(report_week, INTERVAL 6 DAY) AS week_end_date
  
FROM final_metrics</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
