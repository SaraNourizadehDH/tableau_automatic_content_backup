      <aliases enabled='yes' />
      <column caption='Calculation1' datatype='real' name='[Calculation_4380454366361829376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='max?' datatype='boolean' name='[Calculation_4380454366361849857]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[pro_week_end_date] = {FIXED: MAX([pro_week_end_date])}' />
      </column>
      <column caption='Last Period' datatype='boolean' name='[Calculation_4380454366366351364]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[pro_week_start_date] = { FIXED [country_name]: MAX( [pro_week_start_date])}' />
      </column>
      <column caption='Last PRO Week Period' datatype='boolean' name='[Calculation_5182869150252560401]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[pro_week_start_date] &gt;= [Parameters].[Parameter 8] AND [pro_week_end_date] &lt;= [Parameters].[Parameter 9]&#10;OR&#10;[pro_week_start_date] &gt;= [Parameters].[Parameter 8]' />
      </column>
      <column caption='PRO Orders' datatype='integer' name='[Calculation_5182869150255628306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[pro_orders]' />
      </column>
      <column caption='Join Rate%' datatype='real' default-format='p0.0%' name='[Calculation_5182869150255771667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[period_join_rate]' />
      </column>
      <column caption='New to PRO Customers' datatype='integer' name='[Calculation_5182869150256037908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[new_to_pro_customers]' />
      </column>
      <column caption='PRO Week Discounted Orders' datatype='integer' name='[Calculation_5182869150256205845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[pro_weeks_item_deal_orders]' />
      </column>
      <column caption='DH Funding Cost Per Order' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_5182869150256365590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[dh_funding_cost] / [total_orders]' />
      </column>
      <column caption='DH Funding Incremental Cost Per Order' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_5182869150256934935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[pro_week_item_deals_dh_funding_cost] / [pro_weeks_item_deal_orders]' />
      </column>
      <column caption='Region' datatype='string' name='[Calculation_5182869150258294808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [country_name] IN (&quot;Malaysia&quot;, &quot;Hong Kong&quot;, &quot;Singapore&quot;, &quot;Taiwan&quot;, &quot;Bangladesh&quot;, &quot;Pakistan&quot;, &quot;Cambodia&quot;, &quot;Philippines&quot;) THEN &quot;Asia&quot;&#10;ELSEIF  [country_name] IN (&quot;Germany&quot;, &quot;Finland&quot;, &quot;Sweden&quot;, &quot;Norway&quot;, &quot;Czech Republic&quot;, &quot;Hungary&quot;, &quot;Austria&quot;) THEN &quot;Europe&quot;&#10;ELSE &quot;MENA&quot;&#10;END' />
      </column>
      <column caption='Join Rate Change' datatype='real' default-format='n#,##0.00&quot; pp&quot;;-#,##0.00&quot; pp&quot;' name='[Calculation_5182869150259474457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([period_join_rate] - [period_join_rate_comparison]) * 100' />
      </column>
      <column caption='PRO Orders Change' datatype='real' default-format='p0.0%' name='[Calculation_5182869150261985306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[pro_orders_percentage_comparison]' />
      </column>
      <column caption='New to PRO Customers Change%' datatype='real' default-format='p0.0%' name='[Calculation_5182869150262308891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([new_to_pro_customers] - [new_to_pro_customers_comparison]) / [new_to_pro_customers_comparison]' />
      </column>
      <column caption='PRO Week Discounted Orders Change%' datatype='real' default-format='p0.0%' name='[Calculation_5182869150265499678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([pro_weeks_item_deal_orders] - [pro_weeks_item_deal_orders_comparison]) / [pro_weeks_item_deal_orders_comparison]' />
      </column>
      <column caption='DH Funding Cost Per Order Comparison' datatype='real' name='[Calculation_5182869150266064927]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[dh_funding_cost_comparison] / [total_orders_comparison]' />
      </column>
      <column caption='DH Funding Incremental Cost Per Order Comparison' datatype='real' name='[Calculation_5182869150266277920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[pro_week_item_deals_dh_funding_cost_comparison] / [pro_weeks_item_deal_orders_comparison]' />
      </column>
      <column caption='DH Funding Incremental Cost Per Order Change' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_5182869150267244579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5182869150256934935] - [Calculation_5182869150266277920]) / [Calculation_5182869150266277920]' />
      </column>
      <column caption='DH Funded Cost Per Order Change' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5182869150272180260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( [Calculation_5182869150256365590] - [Calculation_5182869150266064927] )' />
      </column>
