            <column datatype='integer' name='[pro_orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[pro_week_item_deals_dh_funding_cost]' role='measure' type='quantitative' />
            <column datatype='integer' name='[pro_weeks_item_deal_orders]' role='measure' type='quantitative' />
            <column datatype='date' name='[report_week]' role='dimension' type='ordinal' />
