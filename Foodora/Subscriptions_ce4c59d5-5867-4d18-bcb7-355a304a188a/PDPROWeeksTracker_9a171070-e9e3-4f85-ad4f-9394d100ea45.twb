        <groupfilter function='member' level='[none:country_name:nk]' member='&quot;Hungary&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
      </filter>
    </shared-view>
    <shared-view name='federated.1nf0uxe1lppcfm1a1t7jb006dqf2'>
      <datasources>
        <datasource caption='Weekly KPIs' name='federated.1nf0uxe1lppcfm1a1t7jb006dqf2' />
      </datasources>
      <datasource-dependencies datasource='federated.1nf0uxe1lppcfm1a1t7jb006dqf2' />
      <filter class='categorical' column='[federated.1nf0uxe1lppcfm1a1t7jb006dqf2].[Region Set]' />
    </shared-view>
  </shared-views>
  <worksheets>
    <worksheet name='DH Funding Cost Per Order'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#b91e9c' fontname='Tableau Book' fontsize='10'>Last Day Numbers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily KPIs' name='federated.0zi3fsl0jpd6lw1083tzg0lmbr13' />
            <datasource caption='PRO Weeks Calendar' name='federated.05gsrh203rwtsv1257o2l1b7ocwv' />
          </datasources>
          <datasource-dependencies datasource='federated.05gsrh203rwtsv1257o2l1b7ocwv'>
            <column caption='End Date' datatype='date' name='[End_Date]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zi3fsl0jpd6lw1083tzg0lmbr13'>
            <column caption='Region' datatype='string' name='[Calculation_3379951554621890565]' role='dimension' type='nominal'>
