            <column caption='(ZN([Join Rate%]) - LOOKUP(ZN([Join Rate%]), -1))*100' datatype='real' name='[Calculation_2523775045196050445]' role='measure' type='quantitative' user:unnamed='Monthly KPIs MoM'>
