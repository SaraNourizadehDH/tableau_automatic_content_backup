            <column caption='PRO Week Incremental Orders' datatype='integer' name='[Calculation_3379951554610581505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IF [has_pro_week] THEN [pro_weeks_item_deal_orders] END)' />
