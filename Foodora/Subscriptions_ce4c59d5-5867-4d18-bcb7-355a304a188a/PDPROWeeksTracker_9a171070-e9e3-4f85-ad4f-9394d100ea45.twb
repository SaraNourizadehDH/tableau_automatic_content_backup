        <calculation class='tableau' formula='IF [report_date] &gt;= [Parameters].[Parameter 3] and [report_date] &lt;= [Parameters].[Parameter 6]&#10;    THEN&#10;        CASE [Parameters].[Parameter 10]&#10;&#10;        WHEN &apos;Join Rate%&apos; THEN [join_rate]&#10;        WHEN &apos;PRO Order Frequency&apos; THEN [pro_orders] / [active_subscribers]&#10;        WHEN &apos;PRO Orders Share%&apos; THEN [pro_orders_percentage] &#10;        WHEN &apos;PRO Week Incremental Orders&apos; THEN [pro_weeks_item_deal_orders] &#10;        WHEN &apos;New to PRO Customers&apos; THEN [new_to_pro_customers]&#10;        WHEN &apos;PRO DEAL UTR&apos; THEN [pro_discount_orders] / [pro_orders]&#10;        WHEN &apos;PRO GMV&apos; THEN [pro_gmv_eur]&#10;        WHEN &apos;PRO GMV %&apos; THEN [pro_gmv_eur] / [total_gmv_eur]&#10;        WHEN &apos;Total Subscribers&apos; THEN [active_subscribers]&#10;    END&#10;&#10;ELSE&#10;        CASE [Parameters].[Parameter 10]&#10;        WHEN &apos;Join Rate%&apos; THEN [join_rate]&#10;        WHEN &apos;PRO Orders&apos; THEN [pro_orders]&#10;        WHEN &apos;PRO Orders Share%&apos; THEN [pro_orders_percentage] &#10;        WHEN &apos;PRO Week Discounted Orders&apos; THEN [pro_weeks_item_deal_orders] &#10;        WHEN &apos;New to PRO Customers&apos; THEN [new_to_pro_customers]&#10;        WHEN &apos;PRO DEAL UTR&apos; THEN [pro_discount_orders] / [pro_orders]&#10;        WHEN &apos;PRO GMV&apos; THEN [pro_gmv_eur]&#10;        WHEN &apos;PRO GMV %&apos; THEN [pro_gmv_eur] / [total_gmv_eur]&#10;        WHEN &apos;Total Subscribers&apos; THEN [active_subscribers]&#10;    END&#10;END' />
      </column>
      <column caption='metrics alignment' datatype='boolean' name='[Calculation_2039004766155395074]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 7] = [Parameters].[Parameter 10]' />
