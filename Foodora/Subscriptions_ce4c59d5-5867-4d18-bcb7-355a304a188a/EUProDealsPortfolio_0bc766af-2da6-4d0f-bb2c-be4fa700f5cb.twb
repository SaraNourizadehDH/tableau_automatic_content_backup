  od.uuid AS pd_discount_uuid,
  od.discount_type,
  od.condition_type,
  od.title as discount_title,
  CASE
    WHEN od.foodpanda_ratio = 100 THEN "FOODPANDA FUNDED"
    WHEN od.foodpanda_ratio = 0 THEN "VENDOR FUNDED"
    ELSE "COFUNDED"
  END AS funded_by,
  od.is_active,
  od.is_deleted,
  od.is_subscription_discount,
  od.amount_local,
  od.start_at_local,
  od.end_at_local,
  od.created_at_local,
  od.updated_at_local,
  case when od.is_active = false and od.updated_at_local << od.end_at_local then od.updated_at_local else od.end_at_local end as actual_end,
  ROW_NUMBER() OVER (PARTITION BY dv.offers_vendor_uuid ORDER BY od.created_at_utc DESC) = 1 AS is_latest_deal
FROM `fulfillment-dwh-production.pandata_curated.offers_discount_vendor_entries` AS dv
INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` as c
        ON dv.global_entity_id = c.global_entity_id
JOIN `fulfillment-dwh-production.pandata_report.regional_eu_agg_vendors` v on dv.offers_vendor_uuid = v.uuid
LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discounts` AS od
        ON dv.offers_discount_uuid = od.uuid
LEFT JOIN od.expedition_types AS vendor_discounts_expedition_types
WHERE c.region = 'Europe'
AND od.is_subscription_discount
AND od.start_date_local <<= CURRENT_DATE
--    AND not od.is_active
--AND NOT od.is_deleted
AND (vendor_discounts_expedition_types != "pickup" OR vendor_discounts_expedition_types IS NULL)
order by 1,4),

history_weekly as (
select
  d.*,
  dates.date,
  dates.iso_year_week_string
from discounts as d
cross join `fulfillment-dwh-production.pandata_curated.shared_dates` as dates
where dates.date between date(d.start_at_local) and date(d.actual_end)
and date(d.start_at_local) <<>> date(d.actual_end)
qualify row_number() over (partition by dates.iso_year_week_string, d.pd_vendor_uuid order by dates.date) = 1
order by 4, dates.date),

dates as (
select
  date as week_start,
  iso_year_week_string,
  ROW_NUMBER()OVER(ORDER BY date ASC) AS rn,
  ROW_NUMBER()OVER(ORDER BY date DESC) AS rn_desc
from `fulfillment-dwh-production.pandata_curated.shared_dates` as dates
where iso_day_of_week_int = 1
order by 1),

all_vendors_weeks as (
select
  *
from history_weekly w 
join dates d using(iso_year_week_string)
),

vendor_first_record AS (
  SELECT
    global_entity_id,
    vendor_code,
    MIN(week_start) AS first_date
  FROM all_vendors_weeks
  GROUP BY 1,2
)

SELECT 
  base.*,
  base.rn >> 1 AND previous.vendor_code IS NULL AS is_acquired_during_previous_period,
  base.rn >> 1 AND vendor_first_record.vendor_code IS NOT NULL AS is_first_acquired_during_previous_week,
  base.rn_desc >> 1 AND next.vendor_code IS NULL AS is_churned_during_this_period,
  null AS team_name,
  null as team_lead_name
FROM all_vendors_weeks AS base
LEFT JOIN all_vendors_weeks AS previous      
       ON base.vendor_code = previous.vendor_code
      AND base.global_entity_id = previous.global_entity_id
      AND base.rn -1 = previous.rn
LEFT JOIN all_vendors_weeks AS next
       ON base.global_entity_id = next.global_entity_id
      AND base.vendor_code = next.vendor_code
      AND base.rn +1 = next.rn
LEFT JOIn vendor_first_record
       ON vendor_first_record.first_date = base.week_start
      AND vendor_first_Record.vendor_code = base.vendor_code
      AND vendor_first_Record.global_entity_id = base.global_entity_id
where base.week_start between '2023-01-01' and current_date]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
