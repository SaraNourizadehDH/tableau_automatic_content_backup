      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_FC7EBAB925DA4A61BBD80E93D16DF452'>
            <properties context=''>
              <relation connection='bigquery.1tbuuas1r5qe7d1h9n6ox1j1ol51' name='Custom SQL Query' type='text'><![CDATA[with discounts as (
SELECT DISTINCT
  dv.offers_vendor_uuid AS pd_vendor_uuid,
  dv.vendor_code,
  v.vendor_name,
  v.gmv_class,
  v.business_type_eu,
  dv.global_entity_id,
  c.name as country_name,
  od.uuid AS pd_discount_uuid,
  od.discount_type,
  od.condition_type,
  od.title as discount_title,
  CASE
    WHEN od.foodpanda_ratio = 100 THEN "FOODPANDA FUNDED"
    WHEN od.foodpanda_ratio = 0 THEN "VENDOR FUNDED"
    ELSE "COFUNDED"
  END AS funded_by,
  od.is_active,
  od.is_deleted,
  od.is_subscription_discount,
  od.amount_local,
  od.start_at_local,
  od.end_at_local,
  od.created_at_local,
  od.updated_at_local,
  case when od.is_active = false and od.updated_at_local << od.end_at_local then od.updated_at_local else od.end_at_local end as actual_end,
  ROW_NUMBER() OVER (PARTITION BY dv.offers_vendor_uuid ORDER BY od.created_at_utc DESC) = 1 AS is_latest_deal
FROM `fulfillment-dwh-production.pandata_curated.offers_discount_vendor_entries` AS dv
INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` as c
        ON dv.global_entity_id = c.global_entity_id
JOIN `fulfillment-dwh-production.pandata_report.regional_eu_agg_vendors` v on dv.offers_vendor_uuid = v.uuid
LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discounts` AS od
        ON dv.offers_discount_uuid = od.uuid
LEFT JOIN od.expedition_types AS vendor_discounts_expedition_types
WHERE c.region = 'Europe'
AND od.is_subscription_discount
AND od.start_date_local <<= CURRENT_DATE
--    AND not od.is_active
--AND NOT od.is_deleted
AND (vendor_discounts_expedition_types != "pickup" OR vendor_discounts_expedition_types IS NULL)
order by 1,4),

history_weekly as (
select
  d.*,
  dates.date,
  dates.iso_year_week_string
from discounts as d
cross join `fulfillment-dwh-production.pandata_curated.shared_dates` as dates
where dates.date between date(d.start_at_local) and date(d.actual_end)
and date(d.start_at_local) <<>> date(d.actual_end)
qualify row_number() over (partition by dates.iso_year_week_string, d.pd_vendor_uuid order by dates.date) = 1
order by 4, dates.date),

dates as (
select
  date as week_start,
  iso_year_week_string,
  ROW_NUMBER()OVER(ORDER BY date ASC) AS rn,
  ROW_NUMBER()OVER(ORDER BY date DESC) AS rn_desc
from `fulfillment-dwh-production.pandata_curated.shared_dates` as dates
where iso_day_of_week_int = 1
order by 1),

all_vendors_weeks as (
select
  *
from history_weekly w 
join dates d using(iso_year_week_string)
),

vendor_first_record AS (
  SELECT
    global_entity_id,
    vendor_code,
    MIN(week_start) AS first_date
  FROM all_vendors_weeks
  GROUP BY 1,2
)

SELECT 
  base.*,
  base.rn >> 1 AND previous.vendor_code IS NULL AS is_acquired_during_previous_period,
  base.rn >> 1 AND vendor_first_record.vendor_code IS NOT NULL AS is_first_acquired_during_previous_week,
  base.rn_desc >> 1 AND next.vendor_code IS NULL AS is_churned_during_this_period,
  null AS team_name,
  null as team_lead_name
FROM all_vendors_weeks AS base
LEFT JOIN all_vendors_weeks AS previous      
       ON base.vendor_code = previous.vendor_code
      AND base.global_entity_id = previous.global_entity_id
      AND base.rn -1 = previous.rn
LEFT JOIN all_vendors_weeks AS next
       ON base.global_entity_id = next.global_entity_id
      AND base.vendor_code = next.vendor_code
      AND base.rn +1 = next.rn
LEFT JOIn vendor_first_record
       ON vendor_first_record.first_date = base.week_start
      AND vendor_first_Record.vendor_code = base.vendor_code
      AND vendor_first_Record.global_entity_id = base.global_entity_id
where base.week_start between '2023-01-01' and current_date]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Platform Vendors' inline='true' name='federated.0s776wr0r02r3u186e51g0wc23f6' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1f15usl04xdyk91c2g7961fac4s2'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='dhh---analytics-eu' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata APAC Production' schema='pandata_ap_commercial' server-oauth='' username='eustacia.chua@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1f15usl04xdyk91c2g7961fac4s2' name='Custom SQL Query' type='text'>WITH orders AS (
  SELECT
    o.vertical_type,
    o.global_entity_id,
    o.pd_vendor_uuid,
    COUNT(o.order_uuid) AS L6M_orders,
    SUM(o.gmv_eur) AS gmv_eur,
    SUM(o.gfv_eur) AS gfv_eur
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_agg_orders` o
  WHERE is_valid_order
    AND o.created_at_local &gt;&gt;= DATE_SUB(CURRENT_DATE - 1, INTERVAL 6 MONTH)
    AND o.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE - 2, INTERVAL 6 MONTH)
    GROUP BY 1,2,3
),
  
portal_deals AS (
  SELECT
    uuid
  FROM `fulfillment-dwh-production`.pandata_curated.offers_discounts
  WHERE REGEXP_CONTAINS(discount_mgmt_created_by, &quot;(?i)v-panda_pro_deals&quot;)
),

portal_acquisitions AS (
SELECT
  v.vendor_code,
  v.global_entity_id
FROM `fulfillment-dwh-production`.pandata_report.regional_eu_agg_vendors v, UNNEST(discounts) AS d
INNER JOIN portal_deals
        ON portal_deals.uuid = d.pd_discount_uuid
),

teams AS (
  SELECT
    country,
    user_id,
    user_name,
    team_name,
    team_lead_name,
  FROM `fulfillment-dwh-production`.pandata_report.regional_apac_am_org_structure
  QUALIFY ROW_NUMBER()OVER(PARTITION BY country,user_name) = 1
),

vendor_orders AS (
  SELECT
    orders.global_entity_id,
    orders.pd_vendor_uuid,
    CASE
      WHEN orders.business_type_apac IN(&quot;restaurants&quot;, &quot;concepts&quot;, &quot;kitchens&quot;) THEN &quot;restaurants_concepts_kitchens&quot;
      ELSE orders.business_type_apac
    END AS business_type_group,
    COUNT(IF(orders.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 30 DAY), orders.order_uuid, NULL)) AS vendor_l1m_orders
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_agg_orders` AS orders
  WHERE orders.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 35 DAY)
    AND orders.is_valid_order
  GROUP BY 1, 2, 3
)

SELECT
  v.vertical_type,
  bt.business_type_eu,
  v.global_entity_id,
  v.vendor_city,
  v.lg_zone_name,
  CASE
    WHEN v.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 30 DAY) THEN &quot;NEW VENDOR&quot;
    WHEN (vendor_orders.pd_vendor_uuid IS NULL OR vendor_orders.vendor_l1m_orders = 0) THEN &quot;ZOMBIE VENDOR&quot;
    ELSE &quot;NORMAL VENDOR&quot;
  END AS zombie_flag,
  CASE
    WHEN (vendor_orders.pd_vendor_uuid IS NULL OR vendor_orders.vendor_l1m_orders = 0) THEN false
    ELSE true
  END AS has_order_in_last_30d,
  IF(portal_acquisitions.vendor_code IS NOT NULL,&apos;PORTAL&apos;,teams.team_name) AS team_name,
  SUM(L6M_orders) AS L6M_orders,  
  SUM(gmv_eur) AS L6M_gmv_eur,
  SUM(gfv_eur) AS L6M_gfv_eur,
  COUNT(DISTINCT IF(v.vendor_flags.is_active AND NOT v.vendor_flags.is_private AND NOT v.vendor_flags.is_test, v.uuid, NULL)) AS platform_vendors,
  count(Distinct CASE WHEN IFNULL(vendor_orders.vendor_l1m_orders,0) &gt;&gt; 0 then v.uuid end) as active_vendors  
FROM `fulfillment-dwh-production`.pandata_report.regional_eu_agg_vendors v
LEFT JOIN `fulfillment-dwh-production`.pandata_curated.shared_countries c
       ON c.global_entity_id = v.global_entity_id
LEFT JOIN `fulfillment-dwh-production`.curated_data_shared_salesforce.account acc
       ON SPLIT(acc.backend_id__c, &quot;-&quot;)[SAFE_OFFSET(1)] = v.vendor_code
      AND acc.global_entity_id = v.global_entity_id
LEFT JOIN teams
       ON teams.user_id = acc.ownerid 
      AND teams.country = c.name
LEFT JOIN portal_acquisitions
       ON portal_acquisitions.vendor_code = v.vendor_code
      AND portal_acquisitions.global_entity_id = v.global_entity_id
LEFT JOIN vendor_orders
       ON v.uuid = vendor_orders.pd_vendor_uuid 
LEFT JOIN `fulfillment-dwh-production`.pandata_report.regional_eu__pd_vendors_agg_business_types bt
       ON bt.uuid = v.uuid
LEFT JOIN orders
       ON orders.pd_vendor_uuid = v.uuid
GROUP BY 1,2,3,4,5,6,7,8</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1f15usl04xdyk91c2g7961fac4s2' name='Custom SQL Query' type='text'>WITH orders AS (
  SELECT
    o.vertical_type,
    o.global_entity_id,
    o.pd_vendor_uuid,
    COUNT(o.order_uuid) AS L6M_orders,
    SUM(o.gmv_eur) AS gmv_eur,
    SUM(o.gfv_eur) AS gfv_eur
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_agg_orders` o
  WHERE is_valid_order
    AND o.created_at_local &gt;&gt;= DATE_SUB(CURRENT_DATE - 1, INTERVAL 6 MONTH)
    AND o.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE - 2, INTERVAL 6 MONTH)
    GROUP BY 1,2,3
),
  
portal_deals AS (
  SELECT
    uuid
  FROM `fulfillment-dwh-production`.pandata_curated.offers_discounts
  WHERE REGEXP_CONTAINS(discount_mgmt_created_by, &quot;(?i)v-panda_pro_deals&quot;)
),

portal_acquisitions AS (
SELECT
  v.vendor_code,
  v.global_entity_id
FROM `fulfillment-dwh-production`.pandata_report.regional_eu_agg_vendors v, UNNEST(discounts) AS d
INNER JOIN portal_deals
        ON portal_deals.uuid = d.pd_discount_uuid
),

teams AS (
  SELECT
    country,
    user_id,
    user_name,
    team_name,
    team_lead_name,
  FROM `fulfillment-dwh-production`.pandata_report.regional_apac_am_org_structure
  QUALIFY ROW_NUMBER()OVER(PARTITION BY country,user_name) = 1
),

vendor_orders AS (
  SELECT
    orders.global_entity_id,
    orders.pd_vendor_uuid,
    CASE
      WHEN orders.business_type_apac IN(&quot;restaurants&quot;, &quot;concepts&quot;, &quot;kitchens&quot;) THEN &quot;restaurants_concepts_kitchens&quot;
      ELSE orders.business_type_apac
    END AS business_type_group,
    COUNT(IF(orders.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 30 DAY), orders.order_uuid, NULL)) AS vendor_l1m_orders
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_agg_orders` AS orders
  WHERE orders.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 35 DAY)
    AND orders.is_valid_order
  GROUP BY 1, 2, 3
)

