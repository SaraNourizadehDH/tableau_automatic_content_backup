              <calculation class='tableau' formula='If [discount_type] = &apos;percentage&apos; THEN &#10;&#10;IF [Calculation_2390004061147049987] &gt;=95 THEN &apos;&gt;=95%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=5 THEN &apos;&lt;=5%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=10 THEN &apos;10%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=15 THEN &apos;15%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=20 THEN &apos;20%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=25 THEN &apos;25%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=30 THEN &apos;30%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=35 THEN &apos;35%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=40 THEN &apos;40%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=45 THEN &apos;45%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=50 THEN &apos;50%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=55 THEN &apos;55%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=60 THEN &apos;60%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=65 THEN &apos;65%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=70 THEN &apos;70%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=75 THEN &apos;75%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=80 THEN &apos;80%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=85 THEN &apos;85%&apos;&#10;ELSEIF [Calculation_2390004061147049987] &lt;=90 THEN &apos;90%&apos;&#10;&#10;&#10;END&#10;&#10;ELSE [discount_type]&#10;&#10;END' />
            </column>
            <column caption='L1M Deal Utilisation%' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_5215590616137392140]' role='measure' type='quantitative'>
