FROM `fulfillment-dwh-production`.pandata_report.regional_eu_agg_vendors v
LEFT JOIN `fulfillment-dwh-production`.pandata_curated.shared_countries c
       ON c.global_entity_id = v.global_entity_id
LEFT JOIN `fulfillment-dwh-production`.curated_data_shared_salesforce.account acc
       ON SPLIT(acc.backend_id__c, &quot;-&quot;)[SAFE_OFFSET(1)] = v.vendor_code
