      WHEN live_pro.city = eu_city.non_competitive_city THEN &quot;Non-Competitive City&quot;
      WHEN live_pro.city = eu_city.competitive_city THEN &quot;Competitive City&quot;
      WHEN live_pro.city = eu_city.winning_city THEN &quot;Winning City&quot;
