      <datasource-dependencies datasource='Parameters'>
        <column caption='HK Target' datatype='real' default-format='p0%' folder-name='Penetration Targets' name='[Level 2 (copy)]' param-domain-type='range' role='measure' type='quantitative' value='0.2'>
          <calculation class='tableau' formula='0.2' />
          <range max='1.0' min='0.0' />
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1ihrt870l9zczz163b98l1tow6ac'>
        <column caption='Pro Vendors' datatype='integer' name='[Calculation_2390004061144883200]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='COUNT([vendor_code])' />
        </column>
        <column caption='Pro Vendors (VF &amp; CF)' datatype='integer' name='[Vendor Count (copy)_2390004061145120769]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='COUNTD(IF [funded_by] &lt;&gt; &apos;FOODPANDA FUNDED&apos; THEN [vendor_code]ELSE NULL END)' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_0891E5969F634CA98D51D835C004EFDC'>
            <properties context=''>
              <relation connection='bigquery.1f15usl04xdyk91c2g7961fac4s2' name='Custom SQL Query' type='text'>WITH orders AS (
  SELECT
    o.vertical_type,
    o.global_entity_id,
    o.pd_vendor_uuid,
    COUNT(o.order_uuid) AS L6M_orders,
    SUM(o.gmv_eur) AS gmv_eur,
    SUM(o.gfv_eur) AS gfv_eur
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_agg_orders` o
  WHERE is_valid_order
    AND o.created_at_local &gt;&gt;= DATE_SUB(CURRENT_DATE - 1, INTERVAL 6 MONTH)
    AND o.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE - 2, INTERVAL 6 MONTH)
    GROUP BY 1,2,3
),
  
portal_deals AS (
  SELECT
    uuid
  FROM `fulfillment-dwh-production`.pandata_curated.offers_discounts
  WHERE REGEXP_CONTAINS(discount_mgmt_created_by, &quot;(?i)v-panda_pro_deals&quot;)
),

portal_acquisitions AS (
SELECT
  v.vendor_code,
  v.global_entity_id
FROM `fulfillment-dwh-production`.pandata_report.regional_eu_agg_vendors v, UNNEST(discounts) AS d
INNER JOIN portal_deals
        ON portal_deals.uuid = d.pd_discount_uuid
),

teams AS (
  SELECT
    country,
    user_id,
    user_name,
    team_name,
    team_lead_name,
  FROM `fulfillment-dwh-production`.pandata_report.regional_apac_am_org_structure
  QUALIFY ROW_NUMBER()OVER(PARTITION BY country,user_name) = 1
),

vendor_orders AS (
  SELECT
    orders.global_entity_id,
    orders.pd_vendor_uuid,
    CASE
      WHEN orders.business_type_apac IN(&quot;restaurants&quot;, &quot;concepts&quot;, &quot;kitchens&quot;) THEN &quot;restaurants_concepts_kitchens&quot;
      ELSE orders.business_type_apac
    END AS business_type_group,
    COUNT(IF(orders.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 30 DAY), orders.order_uuid, NULL)) AS vendor_l1m_orders
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_agg_orders` AS orders
  WHERE orders.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 35 DAY)
    AND orders.is_valid_order
  GROUP BY 1, 2, 3
)

SELECT
  v.vertical_type,
  bt.business_type_eu,
  v.global_entity_id,
  v.vendor_city,
  v.lg_zone_name,
  CASE
    WHEN v.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 30 DAY) THEN &quot;NEW VENDOR&quot;
    WHEN (vendor_orders.pd_vendor_uuid IS NULL OR vendor_orders.vendor_l1m_orders = 0) THEN &quot;ZOMBIE VENDOR&quot;
    ELSE &quot;NORMAL VENDOR&quot;
  END AS zombie_flag,
  CASE
    WHEN (vendor_orders.pd_vendor_uuid IS NULL OR vendor_orders.vendor_l1m_orders = 0) THEN false
    ELSE true
  END AS has_order_in_last_30d,
  IF(portal_acquisitions.vendor_code IS NOT NULL,&apos;PORTAL&apos;,teams.team_name) AS team_name,
  SUM(L6M_orders) AS L6M_orders,  
  SUM(gmv_eur) AS L6M_gmv_eur,
  SUM(gfv_eur) AS L6M_gfv_eur,
  COUNT(DISTINCT IF(v.vendor_flags.is_active AND NOT v.vendor_flags.is_private AND NOT v.vendor_flags.is_test, v.uuid, NULL)) AS platform_vendors,
  count(Distinct CASE WHEN IFNULL(vendor_orders.vendor_l1m_orders,0) &gt;&gt; 0 then v.uuid end) as active_vendors  
FROM `fulfillment-dwh-production`.pandata_report.regional_eu_agg_vendors v
LEFT JOIN `fulfillment-dwh-production`.pandata_curated.shared_countries c
       ON c.global_entity_id = v.global_entity_id
LEFT JOIN `fulfillment-dwh-production`.curated_data_shared_salesforce.account acc
       ON SPLIT(acc.backend_id__c, &quot;-&quot;)[SAFE_OFFSET(1)] = v.vendor_code
      AND acc.global_entity_id = v.global_entity_id
LEFT JOIN teams
       ON teams.user_id = acc.ownerid 
      AND teams.country = c.name
LEFT JOIN portal_acquisitions
       ON portal_acquisitions.vendor_code = v.vendor_code
      AND portal_acquisitions.global_entity_id = v.global_entity_id
LEFT JOIN vendor_orders
       ON v.uuid = vendor_orders.pd_vendor_uuid 
LEFT JOIN `fulfillment-dwh-production`.pandata_report.regional_eu__pd_vendors_agg_business_types bt
       ON bt.uuid = v.uuid
LEFT JOIN orders
       ON orders.pd_vendor_uuid = v.uuid
GROUP BY 1,2,3,4,5,6,7,8</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Live Pro Vendors' inline='true' name='federated.1ihrt870l9zczz163b98l1tow6ac' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1qu8iak05h7jof1gmizou1ph3bhm'>
            <connection CATALOG='damejidlo-cz-bigquery' EXECCATALOG='dhh---analytics-eu' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='damejidlo-cz-bigquery' schema='keboola_ex_google_bigquery_v2_us' server-oauth='' username='eustacia.chua@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1qu8iak05h7jof1gmizou1ph3bhm' name='Custom SQL Query' type='text'>WITH live_pro AS (
  SELECT t.*,
    d.amount_local,
  FROM  `dhh---analytics-eu.sandbox.subscriptions_live_pro_deals` t
  LEFT JOIN `fulfillment-dwh-production`.pandata_curated.offers_discounts d
         ON d.uuid = t.pd_discount_uuid
  WHERE country_name IS NOT NULL
    AND is_private = FALSE
    AND deal_status = &apos;LIVE DEAL&apos; 
),
teams AS (
  SELECT
    country,
    user_name,
    team_name,
    team_lead_name,
  FROM `fulfillment-dwh-production`.pandata_report.regional_apac_am_org_structure
  QUALIFY ROW_NUMBER()OVER(PARTITION BY country,user_name) = 1
),
portal_deals AS (
  SELECT
    uuid
  FROM `fulfillment-dwh-production`.pandata_curated.offers_discounts
  WHERE REGEXP_CONTAINS(discount_mgmt_created_by, &quot;(?i)v-panda_pro_deals&quot;)
),
portal_acquisitions AS (
SELECT
  pd_vendors.vendor_code,
  pd_vendors.global_entity_id
FROM `fulfillment-dwh-production`.pandata_report.regional_eu_agg_vendors AS pd_vendors, UNNEST(discounts) AS d
INNER JOIN portal_deals
        ON portal_deals.uuid = d.pd_discount_uuid
),
deal_utilisation AS (
  SELECT
    left(o.order_code,4) as vendor_code,
    o.global_entity_id,
    SAFE_DIVIDE(COUNT(IF(is_discount_subscription_order, o.uuid, NULL)), COUNT(IF(is_subscriber_order, o.uuid, NULL))) AS L1M_deal_utilisation,
  FROM `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_sb_subscriptions` o
  INNER JOIN live_pro
          ON live_pro.vendor_code = left(o.order_code,4)
         AND live_pro.global_entity_id = o.global_entity_id
  WHERE o.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE - 1, INTERVAL 1 MONTH)
    AND o.created_date_local &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 1 MONTH)
  GROUP BY 1,2
)
SELECT 
  live_pro.* EXCEPT(is_private,order_contribution),
  CASE
      WHEN live_pro.city = eu_city.battleground_city THEN &quot;Battleground City&quot;
      WHEN live_pro.city = eu_city.non_competitive_city THEN &quot;Non-Competitive City&quot;
      WHEN live_pro.city = eu_city.competitive_city THEN &quot;Competitive City&quot;
      WHEN live_pro.city = eu_city.winning_city THEN &quot;Winning City&quot;
      ELSE NULL
    END AS eu_city_classification,
  teams.team_lead_name,
  IF(portal_acquisitions.vendor_code IS NOT NULL,&apos;PORTAL VENDOR&apos;,teams.team_name) AS team_name,
  deal_utilisation.L1M_deal_utilisation
FROM live_pro
LEFT JOIN teams
       ON teams.user_name = live_pro.owner_name
      AND teams.country = live_pro.country_name
LEFT JOIN deal_utilisation
       ON deal_utilisation.vendor_code = live_pro.vendor_code
      AND deal_utilisation.global_entity_id = live_pro.global_entity_id
LEFT JOIN portal_acquisitions
       ON portal_acquisitions.vendor_code = live_pro.vendor_code
      AND portal_acquisitions.global_entity_id = live_pro.global_entity_id
LEFT JOIN `dhh---analytics-apac.pandata_ap_mktg.logistic_city_tags_gsheet` as eu_city
       ON live_pro.global_entity_id = eu_city.global_entity_id
      AND (live_pro.city = eu_city.battleground_city
        OR live_pro.city = eu_city.non_competitive_city
        OR live_pro.city = eu_city.competitive_city
        OR live_pro.city = eu_city.winning_city)
WHERE live_pro.is_private = FALSE
  AND live_pro.deal_status = &apos;LIVE DEAL&apos;
QUALIFY ROW_NUMBER()OVER(PARTITION BY vendor_code,global_entity_id) = 1</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
