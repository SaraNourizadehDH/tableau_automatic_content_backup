      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.04yd69x1qlejju1b4fwrv0ygdodi].[usr:Acquired Vendors Last Period (copy) (copy)_5215590615945035783:qk]&quot;' value='    (a) Newly Acquired' />
          <alias key='&quot;[federated.04yd69x1qlejju1b4fwrv0ygdodi].[usr:Acquired Vendors Vendors (copy)_5215590615944609797:qk]&quot;' value='Acquired Vendors (a)+(b)' />
          <alias key='&quot;[federated.04yd69x1qlejju1b4fwrv0ygdodi].[usr:Calculation_5215590615945543688:qk]&quot;' value='    (b) Reacquired Vendors' />
        </aliases>
      </column>
      <column caption='Newly Acquired' datatype='integer' name='[Acquired Vendors Last Period (copy) (copy)_5215590615945035783]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP([Acquired Vendors Last Period (copy)_5215590615944990726],1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Newly Acquired Vendors Last Period' datatype='integer' name='[Acquired Vendors Last Period (copy)_5215590615944990726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [is_first_acquired_during_previous_week] THEN [vendor_code] ELSE NULL END)' />
      </column>
      <column caption='Acquired Vendors' datatype='integer' name='[Acquired Vendors Vendors (copy)_5215590615944609797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP([Churned Vendors (copy)_5215590615928070148],1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GMV' datatype='string' name='[Calculation_4234157743232008192]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='(IF [gmv_class] = &apos;NULL&apos; THEN &quot;Z&quot; ELSE [gmv_class] END)' />
        <aliases>
          <alias key='%null%' value='?' />
        </aliases>
      </column>
      <column caption='Transferred Vendors' datatype='integer' name='[Calculation_4234157743233245185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP([Calculation_5215590615925624832],1)-[Calculation_5215590615925624832]-[Acquired Vendors Vendors (copy)_5215590615944609797]+[Live Vendors (copy)_5215590615927902211]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Churn By' datatype='string' name='[Calculation_4277786369660211208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Sort By (copy)]&#10;WHEN &quot;GMV&quot; THEN [Calculation_4234157743232008192]&#10;WHEN &quot;Team&quot; THEN [team_name]&#10;WHEN &quot;Discount Type&quot; THEN [discount_type]&#10;WHEN &quot;Country&quot; THEN [global_entity_id]&#10;WHEN &quot;Funded by&quot; THEN [funded_by]&#10;END' />
      </column>
      <column caption='Live Vendors' datatype='integer' name='[Calculation_5215590615925624832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([vendor_code])' />
      </column>
      <column caption='Level 1' datatype='string' name='[Calculation_5215590615927746562]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[is_private Parameter]&#10;WHEN &quot;None&quot; THEN &quot;&quot;&#10;WHEN &quot;Country&quot; THEN [country_name]&#10;WHEN &quot;Business Type APAC&quot; THEN [business_type_apac]&#10;WHEN &quot;GMV Class&quot; THEN [gmv_class]&#10;WHEN &quot;Discount Type&quot; THEN [discount_type]&#10;WHEN &quot;Discount Title&quot; THEN [discount_title]&#10;WHEN &quot;Vendor Code&quot; THEN [vendor_code]&#10;WHEN &quot;Vendor Name&quot; THEN [vendor_name]&#10;WHEN &quot;Chain Name&quot; THEN [chain_name]&#10;WHEN &quot;Acct Owner Name&quot; THEN [owner_name]&#10;WHEN &quot;Acct Owner Team&quot; THEN [team]&#10;WHEN &quot;Discount Start Date&quot; THEN STR([discount_start_date_local])&#10;WHEN &quot;Discount End Date&quot; THEN STR([discount_end_date_local])&#10;WHEN &quot;Zombie Flag&quot; THEN [zombie_flag]&#10;WHEN &quot;Funded By&quot; THEN [funded_by]&#10;WHEN &quot;Discount Ratio&quot; THEN STR([discount_ratio])&#10;WHEN &quot;City&quot; THEN [city]&#10;WHEN &quot;Delivery Zone Name&quot; THEN [delivery_zone_name]&#10;WHEN &quot;Expedition Types&quot; THEN [expedition_types]&#10;&#10;END' />
      </column>
      <column caption='Reacquired Vendors' datatype='integer' name='[Calculation_5215590615945543688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Acquired Vendors Vendors (copy)_5215590615944609797] - [Acquired Vendors Last Period (copy) (copy)_5215590615945035783]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Acquired Vendors Last Period' datatype='integer' name='[Churned Vendors (copy)_5215590615928070148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [is_acquired_during_previous_period] THEN [vendor_code] ELSE NULL END)' />
