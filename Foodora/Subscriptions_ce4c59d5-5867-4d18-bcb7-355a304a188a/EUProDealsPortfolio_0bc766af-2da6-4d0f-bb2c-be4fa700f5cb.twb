      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_0EFA102C04654DDC921EA45CE7D783B2'>
            <properties context=''>
              <relation connection='bigquery.1qu8iak05h7jof1gmizou1ph3bhm' name='Custom SQL Query' type='text'>WITH live_pro AS (
  SELECT t.*,
    d.amount_local,
  FROM  `dhh---analytics-eu.sandbox.subscriptions_live_pro_deals` t
  LEFT JOIN `fulfillment-dwh-production`.pandata_curated.offers_discounts d
         ON d.uuid = t.pd_discount_uuid
  WHERE country_name IS NOT NULL
    AND is_private = FALSE
    AND deal_status = &apos;LIVE DEAL&apos; 
),
teams AS (
  SELECT
    country,
    user_name,
    team_name,
    team_lead_name,
  FROM `fulfillment-dwh-production`.pandata_report.regional_apac_am_org_structure
  QUALIFY ROW_NUMBER()OVER(PARTITION BY country,user_name) = 1
),
portal_deals AS (
  SELECT
    uuid
  FROM `fulfillment-dwh-production`.pandata_curated.offers_discounts
  WHERE REGEXP_CONTAINS(discount_mgmt_created_by, &quot;(?i)v-panda_pro_deals&quot;)
),
portal_acquisitions AS (
SELECT
  pd_vendors.vendor_code,
  pd_vendors.global_entity_id
FROM `fulfillment-dwh-production`.pandata_report.regional_eu_agg_vendors AS pd_vendors, UNNEST(discounts) AS d
INNER JOIN portal_deals
        ON portal_deals.uuid = d.pd_discount_uuid
),
deal_utilisation AS (
  SELECT
    left(o.order_code,4) as vendor_code,
    o.global_entity_id,
    SAFE_DIVIDE(COUNT(IF(is_discount_subscription_order, o.uuid, NULL)), COUNT(IF(is_subscriber_order, o.uuid, NULL))) AS L1M_deal_utilisation,
  FROM `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_sb_subscriptions` o
  INNER JOIN live_pro
          ON live_pro.vendor_code = left(o.order_code,4)
         AND live_pro.global_entity_id = o.global_entity_id
  WHERE o.created_date_utc &gt;&gt;= DATE_SUB(CURRENT_DATE - 1, INTERVAL 1 MONTH)
    AND o.created_date_local &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 1 MONTH)
  GROUP BY 1,2
)
SELECT 
  live_pro.* EXCEPT(is_private,order_contribution),
  CASE
      WHEN live_pro.city = eu_city.battleground_city THEN &quot;Battleground City&quot;
      WHEN live_pro.city = eu_city.non_competitive_city THEN &quot;Non-Competitive City&quot;
      WHEN live_pro.city = eu_city.competitive_city THEN &quot;Competitive City&quot;
      WHEN live_pro.city = eu_city.winning_city THEN &quot;Winning City&quot;
      ELSE NULL
    END AS eu_city_classification,
  teams.team_lead_name,
  IF(portal_acquisitions.vendor_code IS NOT NULL,&apos;PORTAL VENDOR&apos;,teams.team_name) AS team_name,
  deal_utilisation.L1M_deal_utilisation
FROM live_pro
LEFT JOIN teams
       ON teams.user_name = live_pro.owner_name
      AND teams.country = live_pro.country_name
LEFT JOIN deal_utilisation
       ON deal_utilisation.vendor_code = live_pro.vendor_code
      AND deal_utilisation.global_entity_id = live_pro.global_entity_id
LEFT JOIN portal_acquisitions
       ON portal_acquisitions.vendor_code = live_pro.vendor_code
      AND portal_acquisitions.global_entity_id = live_pro.global_entity_id
LEFT JOIN `dhh---analytics-apac.pandata_ap_mktg.logistic_city_tags_gsheet` as eu_city
       ON live_pro.global_entity_id = eu_city.global_entity_id
      AND (live_pro.city = eu_city.battleground_city
        OR live_pro.city = eu_city.non_competitive_city
        OR live_pro.city = eu_city.competitive_city
        OR live_pro.city = eu_city.winning_city)
WHERE live_pro.is_private = FALSE
  AND live_pro.deal_status = &apos;LIVE DEAL&apos;
QUALIFY ROW_NUMBER()OVER(PARTITION BY vendor_code,global_entity_id) = 1</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
