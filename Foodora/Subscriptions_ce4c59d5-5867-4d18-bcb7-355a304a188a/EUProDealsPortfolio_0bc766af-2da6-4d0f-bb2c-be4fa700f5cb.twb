            </column>
            <column caption='GMV' datatype='string' name='[Calculation_4234157743235739650]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(IF [zombie_flag] = &apos;ZOMBIE VENDOR&apos; THEN &quot;Z&quot; ELSE [gmv_class] END)' />
              <aliases>
