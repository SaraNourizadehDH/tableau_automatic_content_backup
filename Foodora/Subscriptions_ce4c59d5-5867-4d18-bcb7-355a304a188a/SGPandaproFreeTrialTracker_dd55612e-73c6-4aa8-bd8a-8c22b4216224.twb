    <worksheet name='Trial Status'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>Subscription Status of Customers in Free Trial</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#f52a85' fontname='Tableau Regular' fontsize='10' underline='true'>Definitions:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#59a14f' fontname='Tableau Regular' fontsize='10'>Completed</run>
            <run fontcolor='#000000' fontname='Tableau Regular' fontsize='10'> - Customers who have completed the 14D free trial.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#f28e2b' fontname='Tableau Regular' fontsize='10'>Ongoing</run>
            <run fontcolor='#000000' fontname='Tableau Regular' fontsize='10'> - Customers who are still in the midst of the 14D free trial.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#a41137' fontname='Tableau Regular' fontsize='10'>Revoked</run>
