            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='foodpanda-sg-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='cheryl.yeo@foodpanda.sg' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1gv1u7c05d19x2195l2j518ads7e' name='Custom SQL Query' type='text'><![CDATA[WITH subs_entry_points AS (
  
  SELECT
    
    partition_date,
    CONCAT(userId, global_entity_id) AS user_uuid,
    platform,
    DATE_ADD(payload_timestamp, INTERVAL 8 HOUR) AS event_time_local,
    eventAction,
    eventOrigin,

    CASE
      WHEN eventAction = "subscription_benefit_overlay.loaded" AND eventOrigin IN ("view_cart", "checkout", "rdp_view_cart", "rdp_checkout", "rdp_pro_banner") THEN "RDP one-click subscribe" -- previously named "One-click subscribe"
      WHEN eventAction = "subscription_benefit_overlay.loaded" AND eventOrigin IN ("sdp_view_cart", "sdp_checkout") THEN "SDP one-click subscribe"
      WHEN eventAction = "subscription_benefit_overlay.loaded" AND eventOrigin IN ("OTP_dynamic") THEN "OTP banner one-click subscribe"
      WHEN eventAction = "subscription_benefit.loaded" AND eventOrigin IN ("rdp_pro_banner") THEN "RDP pro sticky banner" -- previously named "Pro sticky banner"
      WHEN eventOrigin IN ("rdp_offers_carousel") THEN "RDP offers carousel"
      WHEN eventOrigin IN ("restaurants_carousel", "rlp_carousel", "home_marketing_carousel") THEN "RLP marketing carousel"
      WHEN eventOrigin IN ("pickup_carousel") THEN "RLP marketing carousel (Pickup)"  -- previously named "Pickup RLP marketing carousel"
      WHEN eventOrigin IN ("SLP_marketing_carousel", "shop") THEN "SLP marketing carousel"
      WHEN eventOrigin IN ("side_navigation", "home_screen_side_menu") THEN "Account screen" -- previously named "Side navigation"
      WHEN eventOrigin IN ("cart_banner", "cart_pro_banner") THEN "Cart pro banner"
      WHEN eventOrigin IN ("home", "home_banner", "home_growth_banner", "homescreen_banner", "home_marketing_carousel", "homescreen_carousel") THEN "Old home entry points"
      WHEN eventOrigin IN ("home_hero_banner", "home_hero_banner_dynamic", "home_hero_banner_static", "home_global_ads_atf", "home_screen_entry_points") THEN "Home hero banner"
      WHEN eventOrigin IN ("OTP_dynamic") THEN "OTP banner"
      WHEN eventOrigin IN ("voucher_wallet") THEN "Voucher wallet"
      WHEN eventOrigin IN ("deeplink", "enrolment_deeplink", "braze") THEN "Deeplink"
      WHEN eventOrigin IN ("account_banner") THEN "Account Banner"
      WHEN eventOrigin IN ("payment_banner") THEN NULL --For grace period users: to identify that the user enters APTC page from home screen banner because APTC is non recurring. To remove since they're not new subs
      WHEN eventAction = "subscription_benefit.loaded" AND eventOrigin IN ("checkbox", "textBox", "payment_retry_ongoing", "checkout_deeplink") THEN NULL --Web inherits eventOrigin from unrelated events
      WHEN eventAction = "subscription_benefit.loaded" AND eventOrigin IS NULL THEN NULL -- Web fires extra subscription_benefit.loaded without eventOrigin, removing this.
      WHEN eventAction = "subscription_benefit.loaded" AND eventOrigin IN ("view_cart") THEN NULL --iOS fires both subscription_benefit.loaded and subscription_benefit_overlay.loaded, removing the former.
      ELSE LOWER(REGEXP_REPLACE(eventOrigin, '_', ' '))
    END AS entry_point

  FROM `fulfillment-dwh-production.curated_data_shared_coredata_tracking.perseus_events_pandora`
  
  WHERE partition_date >>= '2024-10-01'
    AND eventAction IN ("subscription_benefit.loaded", "subscription_benefit_overlay.loaded")
    AND global_entity_id = 'FP_SG'
  
  QUALIFY ROW_NUMBER() OVER(PARTITION BY partition_date, user_uuid, platform, event_time_local, eventAction, eventOrigin, entry_point) = 1

),

subscription_history AS (

  SELECT

    customer_uuid,
    MIN(DATE(sb.subscription_start_at_local)) AS earliest_subscription_start_date

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_subscriptions` sb, UNNEST(payments) AS payments

  WHERE global_entity_id = 'FP_SG'
    AND created_date_local <<= CURRENT_DATE()
    AND payments.is_status_success = TRUE
    AND DATE(sb.subscription_start_at_local) <<= CURRENT_DATE()

  GROUP BY 1

),

free_trial_base AS (

  SELECT

    sb.customer_uuid,
    CONCAT(sb.customer_code, sb.global_entity_id) AS user_uuid,
    uuid AS subscription_uuid,

    CASE
      WHEN DATE(payments.subscription_start_at_local) = earliest_subscription_start_date THEN TRUE
      WHEN earliest_subscription_start_date IS NULL THEN TRUE
      ELSE FALSE
    END AS is_first_subscription,

    DATE(sb.subscription_start_at_local) AS subs_start_date,
    sb.subscription_start_at_local AS subs_start_timestamp,
    DATE(sb.subscription_end_at_local) AS subs_end_date,
    DATE(payments.subscription_start_at_local) AS trial_start_date,
    DATE(payments.subscription_end_at_local) AS trial_end_date,
    payments.subscription_start_at_local AS trial_start_time,
    payments.subscription_end_at_local AS trial_end_time,

    CASE
      WHEN payments.is_free_trial = TRUE AND status = 'revoked' THEN DATE_DIFF(DATE(payments.subscription_end_at_local), DATE(payments.subscription_start_at_local), DAY)
      WHEN DATE(payments.subscription_end_at_local) >> (CURRENT_DATE()) THEN DATE_DIFF((CURRENT_DATE()), DATE(payments.subscription_start_at_local), DAY)
      WHEN DATE_DIFF(DATE(payments.subscription_end_at_local), DATE(payments.subscription_start_at_local), DAY) >> 14 THEN 14
      ELSE DATE_DIFF(DATE(payments.subscription_end_at_local), DATE(payments.subscription_start_at_local), DAY)
    END AS free_trial_duration,

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_subscriptions` sb, UNNEST(payments) AS payments

  LEFT JOIN subscription_history
    ON sb.customer_uuid = subscription_history.customer_uuid

  WHERE global_entity_id = 'FP_SG'
    AND created_date_local <<= CURRENT_DATE()
    AND payments.is_status_success = TRUE
    AND DATE(sb.subscription_start_at_local) >>= '2024-10-01'
    AND DATE(sb.subscription_start_at_local) <<= CURRENT_DATE()
    AND payments.is_free_trial = TRUE
    -- AND payments.payment_plan_duration = '0M'

  QUALIFY ROW_NUMBER() OVER(PARTITION BY customer_uuid) = 1

),

cleaned_free_trial_base AS (

  SELECT

    free_trial_base.*,

    CASE
      WHEN free_trial_base.free_trial_duration << 14 AND trial_end_date << (CURRENT_DATE()) THEN 'revoked'
      WHEN free_trial_base.free_trial_duration << 14 AND trial_end_date >>= (CURRENT_DATE()) THEN 'ongoing'
      ELSE 'completed'
    END AS trial_status

  FROM free_trial_base

),

pro_new_cvp_orders AS (

  SELECT

    billing.order_code AS order_id,

    MAX(IFNULL(gross_delivery_fee_discount_platform_local, 0)) OVER(PARTITION BY billing.order_code) AS platform_incentive_gross,

    MAX(IFNULL(gross_delivery_fee_discount_vendor_local, 0)) OVER(PARTITION BY billing.order_code) AS vendor_incentive_gross,

  FROM `fulfillment-dwh-production.pandata_curated.billing_engine_workflow_sap_orders` billing

  JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` pd
    ON pd.code = billing.order_code
    AND pd.ordered_at_date_local >>= '2024-09-01'

  JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` acc
    ON CONCAT(pd.global_entity_id, '_', pd.code) = CONCAT(acc.global_entity_id, "_", acc.order_code)
    AND acc.created_date_utc >>= '2024-06-01'

  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` dps
    ON billing.order_code = dps.platform_order_code
    AND dps.country_code = 'sg'
    AND dps.created_date >>= '2024-06-01'

  WHERE billing.global_entity_id = 'FP_SG'
    AND billing.created_date_utc >>= '2024-06-30'
    AND pd_order_fees_delivery_fee_adjustment_local << 0
    AND IFNULL(has_new_customer_condition, FALSE) = FALSE
    AND pd.business_type_apac IN ('restaurants', 'street_food', 'caterers')

  QUALIFY ROW_NUMBER() OVER(PARTITION BY billing.order_code) = 1

),

orders AS (

  SELECT

    customer_uuid,
    COUNT(DISTINCT code) AS total_orders,
    SUM(IFNULL(discount_amount_local, 0) + IFNULL(voucher_amount_local, 0) + IFNULL(platform_incentive_gross, 0) + IFNULL(vendor_incentive_gross, 0)) AS total_savings

  FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` pd

  JOIN cleaned_free_trial_base
    ON pd.pd_customer_uuid = cleaned_free_trial_base.customer_uuid
    AND pd.ordered_at_local BETWEEN cleaned_free_trial_base.trial_start_time AND cleaned_free_trial_base.trial_end_time

  LEFT JOIN pro_new_cvp_orders
    ON pd.code = pro_new_cvp_orders.order_id

  WHERE ordered_at_date_local >>= '2024-10-01'
    AND is_valid_order = TRUE
    AND is_test_order = FALSE

  GROUP BY 1

),

following_subs AS (

  SELECT

    sb.customer_uuid,
    DATE(payments.subscription_start_at_local) AS following_sub_start_date,
    DATE(payments.subscription_end_at_local) AS following_sub_end_date,

    CASE
      WHEN payments.voucher_code IS NOT NULL AND payments.voucher_code != '' THEN TRUE
      ELSE FALSE
    END AS is_voucher_used,

    payments.payment_plan_duration

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_subscriptions` sb, UNNEST(payments) AS payments

  JOIN cleaned_free_trial_base
    ON cleaned_free_trial_base.customer_uuid = sb.customer_uuid
    AND DATE(payments.subscription_start_at_local) >> trial_start_date

  WHERE global_entity_id = 'FP_SG'
    AND created_date_local <<= CURRENT_DATE()
    AND payments.is_status_success = TRUE
    AND DATE(sb.subscription_start_at_local) >>= '2024-10-01'
    AND DATE(sb.subscription_start_at_local) <<= CURRENT_DATE()

  QUALIFY ROW_NUMBER() OVER(PARTITION BY customer_uuid, following_sub_start_date) = 1

)

SELECT

  cleaned_free_trial_base.*EXCEPT(trial_start_time, trial_end_time),
  following_subs.*EXCEPT(customer_uuid, is_voucher_used),
  IFNULL(is_voucher_used, FALSE) AS is_voucher_used,
  IFNULL(total_orders, 0) total_orders,
  IFNULL(total_savings, 0) total_savings,
  entry_point

FROM cleaned_free_trial_base

LEFT JOIN following_subs
  ON following_subs.customer_uuid = cleaned_free_trial_base.customer_uuid

LEFT JOIN orders
  ON orders.customer_uuid = cleaned_free_trial_base.customer_uuid

LEFT JOIN subs_entry_points
  ON cleaned_free_trial_base.user_uuid = subs_entry_points.user_uuid
  AND subs_entry_points.event_time_local << TIMESTAMP(subs_start_timestamp)

QUALIFY ROW_NUMBER() OVER(PARTITION BY customer_uuid, user_uuid, subscription_uuid, following_sub_start_date ORDER BY subs_entry_points.event_time_local DESC) = 1]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1gv1u7c05d19x2195l2j518ads7e' name='Custom SQL Query' type='text'><![CDATA[WITH subs_entry_points AS (
  
  SELECT
    
    partition_date,
    CONCAT(userId, global_entity_id) AS user_uuid,
    platform,
    DATE_ADD(payload_timestamp, INTERVAL 8 HOUR) AS event_time_local,
    eventAction,
    eventOrigin,

    CASE
      WHEN eventAction = "subscription_benefit_overlay.loaded" AND eventOrigin IN ("view_cart", "checkout", "rdp_view_cart", "rdp_checkout", "rdp_pro_banner") THEN "RDP one-click subscribe" -- previously named "One-click subscribe"
      WHEN eventAction = "subscription_benefit_overlay.loaded" AND eventOrigin IN ("sdp_view_cart", "sdp_checkout") THEN "SDP one-click subscribe"
      WHEN eventAction = "subscription_benefit_overlay.loaded" AND eventOrigin IN ("OTP_dynamic") THEN "OTP banner one-click subscribe"
      WHEN eventAction = "subscription_benefit.loaded" AND eventOrigin IN ("rdp_pro_banner") THEN "RDP pro sticky banner" -- previously named "Pro sticky banner"
      WHEN eventOrigin IN ("rdp_offers_carousel") THEN "RDP offers carousel"
      WHEN eventOrigin IN ("restaurants_carousel", "rlp_carousel", "home_marketing_carousel") THEN "RLP marketing carousel"
      WHEN eventOrigin IN ("pickup_carousel") THEN "RLP marketing carousel (Pickup)"  -- previously named "Pickup RLP marketing carousel"
      WHEN eventOrigin IN ("SLP_marketing_carousel", "shop") THEN "SLP marketing carousel"
      WHEN eventOrigin IN ("side_navigation", "home_screen_side_menu") THEN "Account screen" -- previously named "Side navigation"
      WHEN eventOrigin IN ("cart_banner", "cart_pro_banner") THEN "Cart pro banner"
      WHEN eventOrigin IN ("home", "home_banner", "home_growth_banner", "homescreen_banner", "home_marketing_carousel", "homescreen_carousel") THEN "Old home entry points"
      WHEN eventOrigin IN ("home_hero_banner", "home_hero_banner_dynamic", "home_hero_banner_static", "home_global_ads_atf", "home_screen_entry_points") THEN "Home hero banner"
      WHEN eventOrigin IN ("OTP_dynamic") THEN "OTP banner"
      WHEN eventOrigin IN ("voucher_wallet") THEN "Voucher wallet"
      WHEN eventOrigin IN ("deeplink", "enrolment_deeplink", "braze") THEN "Deeplink"
      WHEN eventOrigin IN ("account_banner") THEN "Account Banner"
      WHEN eventOrigin IN ("payment_banner") THEN NULL --For grace period users: to identify that the user enters APTC page from home screen banner because APTC is non recurring. To remove since they're not new subs
      WHEN eventAction = "subscription_benefit.loaded" AND eventOrigin IN ("checkbox", "textBox", "payment_retry_ongoing", "checkout_deeplink") THEN NULL --Web inherits eventOrigin from unrelated events
      WHEN eventAction = "subscription_benefit.loaded" AND eventOrigin IS NULL THEN NULL -- Web fires extra subscription_benefit.loaded without eventOrigin, removing this.
      WHEN eventAction = "subscription_benefit.loaded" AND eventOrigin IN ("view_cart") THEN NULL --iOS fires both subscription_benefit.loaded and subscription_benefit_overlay.loaded, removing the former.
      ELSE LOWER(REGEXP_REPLACE(eventOrigin, '_', ' '))
    END AS entry_point

  FROM `fulfillment-dwh-production.curated_data_shared_coredata_tracking.perseus_events_pandora`
  
  WHERE partition_date >>= '2024-10-01'
    AND eventAction IN ("subscription_benefit.loaded", "subscription_benefit_overlay.loaded")
    AND global_entity_id = 'FP_SG'
  
  QUALIFY ROW_NUMBER() OVER(PARTITION BY partition_date, user_uuid, platform, event_time_local, eventAction, eventOrigin, entry_point) = 1

),

subscription_history AS (

  SELECT

    customer_uuid,
    MIN(DATE(sb.subscription_start_at_local)) AS earliest_subscription_start_date

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_subscriptions` sb, UNNEST(payments) AS payments

  WHERE global_entity_id = 'FP_SG'
    AND created_date_local <<= CURRENT_DATE()
    AND payments.is_status_success = TRUE
    AND DATE(sb.subscription_start_at_local) <<= CURRENT_DATE()

  GROUP BY 1

),

free_trial_base AS (

  SELECT

    sb.customer_uuid,
    CONCAT(sb.customer_code, sb.global_entity_id) AS user_uuid,
    uuid AS subscription_uuid,

    CASE
      WHEN DATE(payments.subscription_start_at_local) = earliest_subscription_start_date THEN TRUE
      WHEN earliest_subscription_start_date IS NULL THEN TRUE
      ELSE FALSE
    END AS is_first_subscription,

    DATE(sb.subscription_start_at_local) AS subs_start_date,
    sb.subscription_start_at_local AS subs_start_timestamp,
    DATE(sb.subscription_end_at_local) AS subs_end_date,
    DATE(payments.subscription_start_at_local) AS trial_start_date,
    DATE(payments.subscription_end_at_local) AS trial_end_date,
    payments.subscription_start_at_local AS trial_start_time,
    payments.subscription_end_at_local AS trial_end_time,

    CASE
      WHEN payments.is_free_trial = TRUE AND status = 'revoked' THEN DATE_DIFF(DATE(payments.subscription_end_at_local), DATE(payments.subscription_start_at_local), DAY)
      WHEN DATE(payments.subscription_end_at_local) >> (CURRENT_DATE()) THEN DATE_DIFF((CURRENT_DATE()), DATE(payments.subscription_start_at_local), DAY)
      WHEN DATE_DIFF(DATE(payments.subscription_end_at_local), DATE(payments.subscription_start_at_local), DAY) >> 14 THEN 14
      ELSE DATE_DIFF(DATE(payments.subscription_end_at_local), DATE(payments.subscription_start_at_local), DAY)
    END AS free_trial_duration,

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_subscriptions` sb, UNNEST(payments) AS payments

  LEFT JOIN subscription_history
    ON sb.customer_uuid = subscription_history.customer_uuid

  WHERE global_entity_id = 'FP_SG'
    AND created_date_local <<= CURRENT_DATE()
    AND payments.is_status_success = TRUE
    AND DATE(sb.subscription_start_at_local) >>= '2024-10-01'
    AND DATE(sb.subscription_start_at_local) <<= CURRENT_DATE()
    AND payments.is_free_trial = TRUE
    -- AND payments.payment_plan_duration = '0M'

  QUALIFY ROW_NUMBER() OVER(PARTITION BY customer_uuid) = 1

),

cleaned_free_trial_base AS (

  SELECT

    free_trial_base.*,

    CASE
      WHEN free_trial_base.free_trial_duration << 14 AND trial_end_date << (CURRENT_DATE()) THEN 'revoked'
      WHEN free_trial_base.free_trial_duration << 14 AND trial_end_date >>= (CURRENT_DATE()) THEN 'ongoing'
      ELSE 'completed'
    END AS trial_status

  FROM free_trial_base

),

pro_new_cvp_orders AS (

  SELECT

    billing.order_code AS order_id,

    MAX(IFNULL(gross_delivery_fee_discount_platform_local, 0)) OVER(PARTITION BY billing.order_code) AS platform_incentive_gross,

    MAX(IFNULL(gross_delivery_fee_discount_vendor_local, 0)) OVER(PARTITION BY billing.order_code) AS vendor_incentive_gross,

  FROM `fulfillment-dwh-production.pandata_curated.billing_engine_workflow_sap_orders` billing

  JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` pd
    ON pd.code = billing.order_code
    AND pd.ordered_at_date_local >>= '2024-09-01'

  JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` acc
    ON CONCAT(pd.global_entity_id, '_', pd.code) = CONCAT(acc.global_entity_id, "_", acc.order_code)
    AND acc.created_date_utc >>= '2024-06-01'

  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` dps
    ON billing.order_code = dps.platform_order_code
    AND dps.country_code = 'sg'
    AND dps.created_date >>= '2024-06-01'

  WHERE billing.global_entity_id = 'FP_SG'
    AND billing.created_date_utc >>= '2024-06-30'
    AND pd_order_fees_delivery_fee_adjustment_local << 0
    AND IFNULL(has_new_customer_condition, FALSE) = FALSE
    AND pd.business_type_apac IN ('restaurants', 'street_food', 'caterers')

  QUALIFY ROW_NUMBER() OVER(PARTITION BY billing.order_code) = 1

),

orders AS (

  SELECT

    customer_uuid,
    COUNT(DISTINCT code) AS total_orders,
    SUM(IFNULL(discount_amount_local, 0) + IFNULL(voucher_amount_local, 0) + IFNULL(platform_incentive_gross, 0) + IFNULL(vendor_incentive_gross, 0)) AS total_savings

  FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` pd

  JOIN cleaned_free_trial_base
    ON pd.pd_customer_uuid = cleaned_free_trial_base.customer_uuid
    AND pd.ordered_at_local BETWEEN cleaned_free_trial_base.trial_start_time AND cleaned_free_trial_base.trial_end_time

  LEFT JOIN pro_new_cvp_orders
    ON pd.code = pro_new_cvp_orders.order_id

  WHERE ordered_at_date_local >>= '2024-10-01'
    AND is_valid_order = TRUE
    AND is_test_order = FALSE

  GROUP BY 1

),

following_subs AS (

  SELECT

    sb.customer_uuid,
    DATE(payments.subscription_start_at_local) AS following_sub_start_date,
    DATE(payments.subscription_end_at_local) AS following_sub_end_date,

    CASE
      WHEN payments.voucher_code IS NOT NULL AND payments.voucher_code != '' THEN TRUE
      ELSE FALSE
    END AS is_voucher_used,

    payments.payment_plan_duration

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_subscriptions` sb, UNNEST(payments) AS payments

  JOIN cleaned_free_trial_base
    ON cleaned_free_trial_base.customer_uuid = sb.customer_uuid
    AND DATE(payments.subscription_start_at_local) >> trial_start_date

  WHERE global_entity_id = 'FP_SG'
    AND created_date_local <<= CURRENT_DATE()
    AND payments.is_status_success = TRUE
    AND DATE(sb.subscription_start_at_local) >>= '2024-10-01'
    AND DATE(sb.subscription_start_at_local) <<= CURRENT_DATE()

  QUALIFY ROW_NUMBER() OVER(PARTITION BY customer_uuid, following_sub_start_date) = 1

)

SELECT

  cleaned_free_trial_base.*EXCEPT(trial_start_time, trial_end_time),
  following_subs.*EXCEPT(customer_uuid, is_voucher_used),
  IFNULL(is_voucher_used, FALSE) AS is_voucher_used,
  IFNULL(total_orders, 0) total_orders,
  IFNULL(total_savings, 0) total_savings,
  entry_point

FROM cleaned_free_trial_base

LEFT JOIN following_subs
  ON following_subs.customer_uuid = cleaned_free_trial_base.customer_uuid

LEFT JOIN orders
  ON orders.customer_uuid = cleaned_free_trial_base.customer_uuid

LEFT JOIN subs_entry_points
  ON cleaned_free_trial_base.user_uuid = subs_entry_points.user_uuid
  AND subs_entry_points.event_time_local << TIMESTAMP(subs_start_timestamp)

QUALIFY ROW_NUMBER() OVER(PARTITION BY customer_uuid, user_uuid, subscription_uuid, following_sub_start_date ORDER BY subs_entry_points.event_time_local DESC) = 1]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
