        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0wvla3h0j3r1fq1988cqr1l1sjzl' name='Custom SQL Query' type='text'><![CDATA[-- CREATE OR REPLACE TABLE `dhh---analytics-eu.sandbox.eu_bin_mapping` AS

WITH l1m_orders AS(
SELECT
    o.order_code,
    o.pd_customer_uuid,
    ft.card_issuer_name AS issuer_name,
    ft.card_bin,
    ft.card_scheme AS payment_method,
    o.global_entity_id,
    (o.gfv_eur) AS gfv_eur,
    (o.gmv_eur) AS gmv_eur
FROM `fulfillment-dwh-production`.pandata_report.regional_eu_agg_orders o
INNER JOIN `dhh---analytics-eu.sandbox.regional_eu_fintech_pd_orders_agg_payments` AS ft
        ON ft.order_code = o.order_code
       AND ft.global_entity_id = o.global_entity_id
WHERe o.is_valid_order
AND o.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 1 MONTH)
AND ft.created_date_utc >>= DATE_SUB(CURRENT_DATE, INTERVAL 1 MONTH)

),

order_freq AS(
  SELECT
    pd_customer_uuid,
    COUNT(order_code) AS orders,
    SUM(gfv_eur)/COUNT(order_code) AS AFV_eur,
    SUM(gmv_eur) AS gmv_eur,
    SUM(gfv_eur) AS gfv_eur
  FROM l1m_orders
  GROUP BY 1
),
max_date AS(
    SELECT MAX(active_date) AS latest_date
    FROM `fulfillment-dwh-production`.pandata_report.regional_apac_subscriptions_active_subscribers
    WHERE active_date << CURRENT_DATE
),
active_subs AS(
SELECT
  global_entity_id,
  customer_code
FROM `fulfillment-dwh-production`.pandata_report.regional_apac_subscriptions_active_subscribers
WHERE active_date = (SELECT latest_date FROM max_date)
AND active_date << CURRENT_DATE
),

base_users AS (
    SELECT DISTINCT
        issuer_name,
        card_bin,
        global_entity_id,
        payment_method,
        pd_customer_uuid
    FROM l1m_orders
)

SELECT
  base_users.issuer_name,
  base_users.card_bin,
  base_users.global_entity_id,
  base_users.payment_method,
  binbase.card_type,
  binbase.card_category,
  binbase.issuing_organization,
  active_subs.customer_code IS NOT NULL AS is_current_subscriber,
  SUM(orders)/COUNT(DISTINCT order_freq.pd_customer_uuid) AS avg_order_freq,
  SUM(gfv_eur)/COUNT(DISTINCT order_freq.pd_customer_uuid) AS avg_afv_eur,
  COUNT(DISTINCT order_freq.pd_customeR_uuid) AS users,
  SUM(gfv_eur) AS gfv_eur,
  SUM(order_freq.orders) AS total_orders,
  SUM(order_freq.gmv_eur) AS total_gmv_opportunity
FROM base_users
LEFT JOIN `fulfillment-dwh-production`.curated_data_shared_fintech.binbase_all binbase
       ON CAST(binbase.bin AS STRING) = base_users.card_bin
LEFT JOIN `fulfillment-dwh-production`.pandata_curated.cus_customers
       ON cus_customers.uuid = base_users.pd_customer_uuid
LEFT JOIN active_subs
       ON active_subs.customer_code = cus_customers.code
      AND active_subs.global_entity_id = cus_Customers.global_entity_id
LEFT JOIN order_Freq
       ON order_Freq.pd_customer_uuid = base_users.pd_customer_uuid
GROUP BY 1,2,3,4,5,6,7,8]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0wvla3h0j3r1fq1988cqr1l1sjzl' name='Custom SQL Query' type='text'><![CDATA[-- CREATE OR REPLACE TABLE `dhh---analytics-eu.sandbox.eu_bin_mapping` AS

