          <datasource-dependencies datasource='federated.13vf5oi0sq5lwu152oyu80lc0ihb'>
            <column caption='filtered_date' datatype='date' name='[Calculation_5453577677820911618]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;2024&quot; THEN&#10;    IF YEAR([Month])=2024&#10;    THEN [Month]&#10;    ELSE NULL&#10;    END&#10;ELSE&#10;    IF YEAR([Month])=2025&#10;    THEN [Month]&#10;    ELSE NULL&#10;    END&#10;END' />
            </column>
            <column caption='Global Entity Id' datatype='string' name='[Calculation_6035808722371362817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(&apos;BD, HK, KH, MY, PH, PK, SG, TH, TW, APAC&apos;, [Countries]) THEN &quot;FP_&quot;+[Countries]&#10;ELSEIF [Countries] = &apos;FI&apos; THEN &quot;PO_&quot;+[Countries]&#10;ELSEIF [Countries] = &apos;HU&apos; THEN &quot;NP_&quot;+[Countries] &#10;ELSEIF [Countries] = &apos;AT&apos; THEN &quot;MJM_&quot;+[Countries]&#10;ELSEIF [Countries] = &apos;NO&apos; THEN &quot;FO_&quot;+[Countries]&#10;ELSEIF [Countries] = &apos;CZ&apos; THEN &quot;DJ_&quot;+[Countries]&#10;ELSEIF [Countries] = &apos;SE&apos;  THEN &quot;OP_&quot;+[Countries]&#10;ELSE [Countries]&#10;END' />
            </column>
            <column caption='L12M' datatype='boolean' name='[Calculation_6035808722383380485]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Month] &gt;= DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-12,TODAY()))' />
            </column>
            <column caption='Placeholder' datatype='integer' name='[Calculation_6035808722685620234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
