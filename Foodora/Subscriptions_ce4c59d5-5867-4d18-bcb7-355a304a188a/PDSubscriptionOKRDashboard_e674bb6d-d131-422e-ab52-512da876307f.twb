      <column caption='L12M' datatype='boolean' name='[Calculation_6035808722383380485]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Month] &gt;= DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-12,TODAY()))' />
