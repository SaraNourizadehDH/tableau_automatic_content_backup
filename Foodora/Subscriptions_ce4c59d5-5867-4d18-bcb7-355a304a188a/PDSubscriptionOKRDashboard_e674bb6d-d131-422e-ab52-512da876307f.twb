          <datasource-dependencies datasource='federated.0f9fbr81nvqpmn128kx400qiiho2'>
            <column caption='% Achievement (PRO FLGPO)' datatype='real' default-format='p0.0%' name='[Calculation_5282863156643696641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR([federated.1koc8am0n53ee91gd68w60s482ty].[Calculation_5282863156646461442])/ATTR([federated.13vf5oi0sq5lwu152oyu80lc0ihb].[Target])' />
