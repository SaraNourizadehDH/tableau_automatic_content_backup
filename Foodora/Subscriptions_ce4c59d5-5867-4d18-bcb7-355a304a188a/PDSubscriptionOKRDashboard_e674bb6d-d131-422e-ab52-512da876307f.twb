              <calculation class='tableau' formula='(IF SUM(ZN([Calculation_5282863156705652741]))!=0 THEN SUM(ZN([Calculation_5282863156646461442])) / SUM(ZN([Calculation_5282863156705652741])) - 1 ELSE 0 END)' />
