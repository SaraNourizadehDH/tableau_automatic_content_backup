              <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;, ATTR([federated.13vf5oi0sq5lwu152oyu80lc0ihb].[Month]), TODAY()) = 2 THEN TRUE END' />
            </column>
            <column-instance column='[Calculation_5282863156643696641]' derivation='User' name='[usr:Calculation_5282863156643696641:qk]' pivot='key' type='quantitative' />
