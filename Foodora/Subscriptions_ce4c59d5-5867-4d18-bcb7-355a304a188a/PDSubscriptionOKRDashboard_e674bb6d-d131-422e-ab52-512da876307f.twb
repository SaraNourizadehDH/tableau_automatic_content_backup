            <column caption='PRO FLGPO Actual' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5282863156646461442]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [actual_kpi]&#10;WHEN &apos;PRO FLGPO&apos;&#10;THEN ZN(FLOAT(([actual_number]))) END' />
