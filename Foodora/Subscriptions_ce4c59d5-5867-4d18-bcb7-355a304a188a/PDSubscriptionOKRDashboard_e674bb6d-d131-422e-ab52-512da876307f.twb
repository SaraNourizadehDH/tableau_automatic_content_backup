      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_2D0167315FE5455B891061CEEC459C30'>
            <properties context=''>
              <relation connection='bigquery.1mgsex11remmu417xmleb0ky766m' name='Custom SQL Query' type='text'><![CDATA[WITH date_window AS (
  SELECT 
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 28 MONTH),MONTH) AS date_floor,
    DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL 6 MONTH),MONTH) AS date_ceiling,

),

month_dates AS (
SELECT
  DATE_TRUNC(date,MONTH) AS month_floor,
  MAX(date) AS month_ceiling
FROM  `fulfillment-dwh-production.pandata_curated.shared_dates`
WHERE date >>= (SELECT date_floor FROM date_window)
  AND date <<= DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
GROUP BY 1
),

eom_subs AS (
  SELECT 
    subs_count.global_entity_id,
    DATE_TRUNC(subs_count.active_Date, MONTH) AS active_date,
    COUNT(DISTINCT IF(subs_count.active_date >>= '2024-01-01' AND subs_count.active_date >> DATE_SUB(month_dates.month_ceiling, INTERVAL 30 DAY), l30d.customer_code, subs_count.customer_code)) AS eom_subscribers,
    COUNT(DISTINCT IF(subs_count.active_date >> DATE_SUB(month_dates.month_ceiling, INTERVAL 30 DAY), l30d.customer_code, NULL)) AS active_subscribers,
    COUNT(DISTINCT IF(subs_count.active_date >> DATE_SUB(month_dates.month_ceiling, INTERVAL 30 DAY), subs_count.customer_code, NULL)) AS total_subscribers
  FROM `fulfillment-dwh-production`.pandata_report.regional_apac_subscriptions_active_subscribers AS subs_count
  LEFT JOIN `fulfillment-dwh-production`.pandata_report.regional_apac_subscriptions_active_subscribers_l30d_orders AS l30d
         ON l30d.global_entity_id = subs_count.global_entity_id
        AND l30d.customer_code = subs_count.customer_code
        AND l30d.active_date = subs_count.active_date
        AND l30d.l30d_orders >> 0 
  LEFT JOIN month_dates
         ON month_dates.month_floor = DATE_TRUNC(subs_count.active_Date, MONTH)
  WHERE (subs_count.active_date = (SELECT MAX(active_date) FROM `fulfillment-dwh-production`.pandata_report.regional_apac_subscriptions_active_subscribers WHERE active_date <<= CURRENT_DATE)
          OR subs_count.active_date = DATE_ADD(DATE_TRUNC(subs_count.active_date, MONTH), INTERVAL 1 MONTH) - 1
           )
  AND subs_count.active_date <<= CURRENT_DATE
  GROUP BY 1,2
),

monthly_mau AS (
  SELECT
    DATE_TRUNC(placed_at_local,MONTH) AS order_month,
    global_entity_id,
    COUNT(DISTINCT IF(placed_at_local >> DATE_SUB(month_dates.month_ceiling, INTERVAL 30 DAY), COALESCE(analytical_customer_id, customer_id), NULL)) AS MAU
  FROM `fulfillment-dwh-production`.curated_data_shared_coredata_business.orders
  LEFT JOIN month_dates
         ON month_dates.month_floor = DATE_TRUNC(placed_at_local, MONTH)
  WHERE DATE(partition_date_local) >>= (SELECT date_floor FROM date_window)
    AND global_entity_id IN(SELECT DISTINCT global_entity_id FROM eom_subs)
    AND is_successful
  GROUP BY 1,2
),

L30D_mau AS (
  SELECT
    global_entity_id,
    COUNT(DISTINCT customer_id) AS L1M
  FROM `fulfillment-dwh-production`.curated_data_shared_coredata_business.orders
  WHERE DATE(partition_date_local) >> DATE_SUB(CURRENT_DATE, INTERVAL 30 DAY)
    AND global_entity_id IN(SELECT DISTINCT global_entity_id FROM eom_subs)
    AND is_successful
  GROUP BY 1
),

monthly_gmv AS (
  SELECT 
    DATE_TRUNC(created_date_local,MONTH) AS order_month,
    global_entity_id,
    SUM(IF(created_date_local >> DATE_SUB(month_dates.month_ceiling, INTERVAL 30 DAY) AND is_subscriber_order, user_paid_gmv_eur, 0)) AS pro_gmv_eur,
    SUM(IF(created_date_local >> DATE_SUB(month_dates.month_ceiling, INTERVAL 30 DAY), user_paid_gmv_eur, 0)) AS total_gmv_eur
  FROM fulfillment-dwh-production.pandata_datamart.pandora__agg_orders
  LEFT JOIN month_dates
         ON month_dates.month_floor = DATE_TRUNC(created_date_local, MONTH)
  WHERE created_date_local >>= (SELECT date_floor FROM date_window)
    AND global_entity_id IN(SELECT DISTINCT global_entity_id FROM eom_subs)
    AND is_successful
  GROUP BY 1,2
),

L30D_gmv AS (
  SELECT
    global_entity_id,
    SUM(IF(is_subscriber_order, user_paid_gmv_eur, 0)) AS L1M_pro_gmv_eur,
    SUM(user_paid_gmv_eur) AS L1M_total_gmv_eur
  FROM fulfillment-dwh-production.pandata_datamart.pandora__agg_orders
  WHERE created_date_local >> DATE_SUB(CURRENT_DATE, INTERVAL 30 DAY)
    AND global_entity_id IN(SELECT DISTINCT global_entity_id FROM eom_subs)
    AND is_successful
  GROUP BY 1
),

final AS (
SELECT
  month_dates.month_floor,
  DATE_TRUNC(CURRENT_DATE-1,MONTH) = month_floor AS is_TM,
  eom_subs.global_entity_id,
  shared_countries.name AS country_name,
  IFNULL(L30D_mau.L1M,monthly_mau.MAU) AS MAU,
  IFNULL(L30D_gmv.L1M_total_gmv_eur,monthly_gmv.total_gmv_eur) AS total_gmv,
  IFNULL(L30D_gmv.L1M_pro_gmv_eur,monthly_gmv.pro_gmv_eur) AS pro_gmv,
  eom_subs.eom_subscribers AS subscribers,
  eom_subs.active_subscribers,
  eom_subs.total_subscribers
FROM month_dates
LEFT JOIN eom_subs
       ON eom_subs.active_date = month_floor
LEFT JOIN monthly_mau
       ON monthly_mau.global_entity_id = eom_subs.global_entity_id
      AND monthly_mau.order_month = month_dates.month_floor
LEFT JOIN L30D_mau
       ON L30D_mau.global_entity_id = eom_subs.global_entity_id
      AND month_dates.month_floor = DATE_TRUNC(CURRENT_DATE-1,MONTH)
LEFT JOIN monthly_gmv
       ON monthly_gmv.global_entity_id = eom_subs.global_entity_id
      AND monthly_gmv.order_month = month_dates.month_floor
LEFT JOIN L30D_gmv
       ON L30D_gmv.global_entity_id = eom_subs.global_entity_id
      AND month_dates.month_floor = DATE_TRUNC(CURRENT_DATE-1,MONTH) 
LEFT JOIN `fulfillment-dwh-production`.pandata_curated.shared_countries
       ON shared_countries.global_entity_id = eom_subs.global_entity_id
)

SELECT
    *
FROM final

UNION ALL

SELECT
    month_floor,
    is_TM,
    "FP_APAC" AS global_entity_id,
    "APAC" AS country_name,
    SUM(MAU) AS MAU,
    SUM(total_gmv) AS total_gmv,
    SUM(pro_gmv) AS pro_gmv,
    SUM(subscribers) AS subscribers,
    SUM(active_subscribers) AS active_subscribers,
    SUM(total_subscribers) AS total_subscribers
FROM final
LEFT JOIN `fulfillment-dwh-production`.pandata_curated.shared_countries
       ON shared_countries.global_entity_id = final.global_entity_id
WHERE shared_countries.region = 'Asia'
GROUP BY 1,2,3,4

UNION ALL

SELECT
    month_floor,
    is_TM,
    "EU" AS global_entity_id,
    "EU" AS country_name,
    SUM(MAU) AS MAU,
    SUM(total_gmv) AS total_gmv,
    SUM(pro_gmv) AS pro_gmv,
    SUM(subscribers) AS subscribers,
    SUM(active_subscribers) AS active_subscribers,
    SUM(total_subscribers) AS total_subscribers
FROM final
LEFT JOIN `fulfillment-dwh-production`.pandata_curated.shared_countries
       ON shared_countries.global_entity_id = final.global_entity_id
WHERE shared_countries.region != 'Asia' and shared_countries.global_entity_id != 'YS_TR'
GROUP BY 1,2,3,4]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
