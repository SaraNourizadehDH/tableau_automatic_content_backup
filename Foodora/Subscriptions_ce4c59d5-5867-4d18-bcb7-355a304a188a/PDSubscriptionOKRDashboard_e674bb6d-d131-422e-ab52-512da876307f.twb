    <datasource caption='Live Vendors and Platform' inline='true' name='federated.1n6xb3e0950jzz0zwmho30aa5mu8' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1atkyxr0z18qas15g89l01ngb6wt'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='dhub-yemek' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata APAC Production' schema='pandata_ap_commercial' server-oauth='' username='nazmi.aydin@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1atkyxr0z18qas15g89l01ngb6wt' name='Custom SQL Query' type='text'><![CDATA[WITH date_window AS (
  SELECT 
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH),MONTH) AS date_floor,
    DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL 6 MONTH),MONTH) AS date_ceiling,

),

month_dates AS (
SELECT
  DATE_TRUNC(date,MONTH) AS month_floor,
  MAX(date)- 1 AS month_ceiling
FROM  `fulfillment-dwh-production.pandata_curated.shared_dates`
WHERE date >>= (SELECT date_floor FROM date_window)
  AND date <<= DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
GROUP BY 1
),

deal_value AS(
  SELECT
    global_entity_id,
    report_month,
    SUM(total_pro_deals_vf_deals_value) AS total_pro_deals_vf_deals_value,
    SUM(total_pro_orders_gfv_eur) AS total_pro_orders_gfv_eur
  FROM `fulfillment-dwh-production`.pandata_report.regional_apac_deals_performance_report
  INNER JOIN month_dates
          ON month_dates.month_floor = regional_apac_deals_performance_report.report_month
  WHERE expedition_type = 'delivery'
  GROUP BY 1, 2
),

vendor_counts AS (
  SELECT
    global_entity_id,
    month_dates.month_ceiling,
    month_dates.month_floor,
    COUNT(DISTINCT vendor_code) AS pro_vendors,
    SUM(vendor_L6M_orders) AS L6M_orders,
    MIN(platform_business_type_group_L6M_orders) AS platform_business_type_group_L6M_orders,
  FROM fulfillment-dwh-production.pandata_report.regional_apac_subscriptions_live_pro_deals_historical deals
  INNER JOIN month_dates
          ON month_dates.month_ceiling = deals.updated_at_date
  WHERE updated_at_date << CURRENT_DATE
    AND is_private = FALSE
    AND deal_status = 'LIVE DEAL'
    AND funded_by <<>> 'FOODPANDA FUNDED'
    AND business_type_apac IN('restaurants','concepts','kitchens')
  GROUP BY 1,2,3
),

latest_month AS (
    SELECT
    MAX(month_floor) AS latest_month_floor
    FROM vendor_counts
),

platform_vendors AS(
  SELECT
    pandora_vendor_offline.report_date,
    pandora_vendor_offline.global_entity_id,
    COUNT(DISTINCT pandora_vendor_offline.vendor_code) AS platform_vendor_count
  FROM  `fulfillment-dwh-production.pandata_report.pandora_vendor_offline` AS pandora_vendor_offline
  LEFT JOIN  `fulfillment-dwh-production`.pandata_report.regional_apac_pd_vendors_agg_business_types bt
         ON bt.uuid = pandora_vendor_offline.pd_vendor_uuid
  WHERE is_active
    AND NOT is_private
    AND NOT is_test
    ANd report_date >>= (SELECT date_floor FROM date_window)
    AND bt.business_type_apac IN('restaurants','concepts','kitchens')
  GROUP BY 1,2
),

final AS (
SELECT
  vendor_counts.global_entity_id,
  vendor_counts.month_floor,
  month_floor = (SELECT latest_month_floor FROM latest_month) AS is_TM,
  vendor_counts.pro_vendors,
  vendor_counts.L6M_orders,
  vendor_counts.platform_business_type_group_L6M_orders,
  platform_vendors.platform_vendor_count,
  deal_value.total_pro_deals_vf_deals_value,
  deal_value.total_pro_orders_gfv_eur
FROM vendor_counts
LEFT JOIN deal_value
       ON deal_value.global_entity_id = vendor_counts.global_entity_id
      AND deal_value.report_month = vendor_counts.month_floor
LEFT JOIN platform_vendors
       ON platform_vendors.global_entity_id = vendor_counts.global_entity_id
      AND platform_vendors.report_date = vendor_counts.month_ceiling
)

SELECT
    *
FROM final

UNION DISTINCT

SELECT
    "FP_APAC" AS global_entity_id,
    month_floor,
    is_TM,
    SUM(pro_vendors) AS pro_vendors,
    SUM(L6M_orders) AS L6M_orders,
    SUM(platform_business_type_group_L6M_orders) AS platform_business_type_group_L6M_orders,
    SUM(platform_vendor_count) AS platform_vendor_count,
    SUM(total_pro_deals_vf_deals_value) AS total_pro_deals_vf_deals_value,
    SUM(total_pro_orders_gfv_eur) AS total_pro_orders_gfv_eur
FROM final
GROUP BY 1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
