      <aliases enabled='yes' />
      <column caption='% Pro Deals LW Growth (nonfpfund)' datatype='string' name='[% Pro Deals LW Growth (copy)_3973793403829854212]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;((SUM(IF [is_yesterday] THEN [non_fp_fund_pro_vendor_count] ELSE 0 END) / SUM(IF [is_yesterday] THEN [total_vendors] ELSE 0 END))&#10;- (SUM(IF [is_same_day_last_week] THEN [non_fp_fund_pro_vendor_count] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [total_vendors] ELSE 0 END)))&#10;/ (SUM(IF [is_same_day_last_week] THEN [non_fp_fund_pro_vendor_count] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [total_vendors] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;    ROUND(&#10;    (ROUND( (SUM(IF [is_yesterday] THEN [non_fp_fund_pro_vendor_count] ELSE 0 END) / SUM(IF [is_yesterday] THEN [total_vendors] ELSE 0 END)), 3)&#10;    - ROUND( (SUM(IF [is_same_day_last_week] THEN [non_fp_fund_pro_vendor_count] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [total_vendors] ELSE 0 END)), 3)) &#10;    / ROUND( (SUM(IF [is_same_day_last_week] THEN [non_fp_fund_pro_vendor_count] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [total_vendors] ELSE 0 END)), 3)&#10;    * 100, 2)&#10;)' />
      </column>
      <column caption='% Pro Deals MTD (nonfpfund)' datatype='real' default-format='p0.0%' name='[% Pro Deals MTD (copy)_3973793403831574538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([is_yesterday],[non_fp_fund_pro_vendor_count],0))&#10;/&#10;SUM(iif([is_yesterday], [total_vendors],0))' />
      </column>
      <column caption='SAM % Pro Deals MTD (nonfpfund)' datatype='real' name='[% Pro Deals MTD (nonfpfund) (copy)_5815343422053404679]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([is_yesterday],[pro_sam_non_fp_fund_vendor_count],0))&#10;/&#10;SUM(iif([is_yesterday], [total_sam_vendors],0))' />
      </column>
      <column caption='% Pro Deals T7D (nonfpfund)' datatype='real' default-format='p0.0%' name='[% Pro Deals T7D (copy)_3973793403830444038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([date]= DATE(now()-1), [non_fp_fund_pro_vendor_count], 0)) &#10;&#10;/&#10;&#10;SUM(iif([date]= DATE(now()-1),[total_vendors], 0))' />
      </column>
      <column caption='SAM % Pro Deals T7D (nonfpfund)' datatype='real' name='[% Pro Deals T7D (nonfpfund) (copy)_5815343422054010889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([date]= DATE(now()-1), [pro_sam_non_fp_fund_vendor_count], 0)) &#10;&#10;/&#10;&#10;SUM(iif([date]= DATE(now()-1),[total_sam_vendors], 0))' />
      </column>
      <column caption='% SAM Pro Vendor (NonFpFund)' datatype='real' default-format='p0.00%' name='[% Pro Vendor (NonFpFund) (copy)_5815343422051733505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_sam_non_fp_fund_vendor_count])/SUM([total_sam_vendors])' />
      </column>
      <column caption='% Pro Vendor (NonFpFund)' datatype='real' default-format='p0.00%' name='[% Pro Vendor (copy)_3973793403829014529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([non_fp_fund_pro_vendor_count])/SUM([total_vendors])' />
      </column>
      <column caption='% Pro Vendors 7D Avg (nonfpfund)' datatype='real' name='[% Pro Vendors 7D Avg (copy)_3973793403829219331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([% Pro Vendor (copy)_3973793403829014529],first(),first()+7)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% SAM Pro Vendors 7D Avg (nonfpfund)' datatype='real' name='[% Pro Vendors 7D Avg (nonfpfund) (copy)_5815343422051934210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([% Pro Vendor (NonFpFund) (copy)_5815343422051733505],first(),first()+7)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='1 Total Platform Vendors' datatype='integer' name='[1 VF+CF Pro Vendors (copy)_5815343422051213312]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='1' />
        <aliases>
          <alias key='1' value='Total Platform Vendors' />
        </aliases>
      </column>
      <column caption='Ranking % Pro Vendor' datatype='real' name='[Calculation_1299781119976185856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF(date &gt;= now() - 8, [pro_vendor_count], 0)) / SUM(IIF(date &gt;= now() - 8, [total_vendors], 0))' />
      </column>
      <column caption='% Pro Vendor LW Growth Ranking' datatype='real' name='[Calculation_192669667480772611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(&#10;    (ROUND( (SUM(IF [is_yesterday] THEN [pro_vendor_count] ELSE 0 END) / SUM(IF [is_yesterday] THEN [total_vendors] ELSE 0 END)), 3)&#10;    - ROUND( (SUM(IF [is_same_day_last_week] THEN [pro_vendor_count] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [total_vendors] ELSE 0 END)), 3)) &#10;    / ROUND( (SUM(IF [is_same_day_last_week] THEN [pro_vendor_count] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [total_vendors] ELSE 0 END)), 3)&#10;    * 100, 2)' />
      </column>
      <column caption='% Pro Vendor' datatype='real' name='[Calculation_2037315925590573058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_vendor_count])/SUM([total_vendors])' />
      </column>
      <column caption='% Pro Vendors 7D Avg' datatype='real' name='[Calculation_2037315925593427971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_2037315925590573058],first(),first()+7)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Color - % Pro Vendor' datatype='integer' name='[Calculation_2037315925593550852]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if isnull([Calculation_2037315925590573058]) then 0&#10;elseif ([Calculation_2037315925590573058] - [Calculation_2037315925593427971])/abs([Calculation_2037315925593427971]) &gt;= 0.03&#10;then 2&#10;elseif ([Calculation_2037315925590573058] - [Calculation_2037315925593427971])/abs([Calculation_2037315925593427971]) &lt;= -0.03&#10;then -2&#10;elseif ([Calculation_2037315925590573058] - [Calculation_2037315925593427971])/abs([Calculation_2037315925593427971]) &gt;= 0.01&#10;then 1&#10;elseif ([Calculation_2037315925590573058] - [Calculation_2037315925593427971])/abs([Calculation_2037315925593427971]) &lt;= -0.01&#10;then -1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Number of Records' datatype='integer' name='[Calculation_2037315925597986822]' role='measure' type='quantitative'>
