    <worksheet name='New Subscribers Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='Subscribers Acquisition Churn' name='federated.0t0qnra0scoza111r7ctq0zofkzx' />
          </datasources>
          <datasource-dependencies datasource='federated.0t0qnra0scoza111r7ctq0zofkzx'>
            <column caption='L7D &amp; Previous L7D ' datatype='string' name='[Calculation_3021493178923221021]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [report_date] &lt;= NOW() - 1&#10;THEN &apos;L7D&apos;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [report_date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END' />
            </column>
            <column caption='Day of Day (Similar Scale)' datatype='real' name='[Calculation_3021493178923642910]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='-&#10;(TODAY() - &#10;IF [report_date] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [report_date])&#10;ELSE [report_date]&#10;END&#10;)' />
            </column>
            <column caption='DayofWeek' datatype='string' name='[Calculation_3021493178926415903]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [report_date])' />
            </column>
            <column caption='New Subscribers ' datatype='integer' name='[Calculation_743938370268053506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[signup_count_8_to_30d]+[signup_count_new_sub]+[signup_count_more_than_30d]+[signup_count_within_7d]' />
            </column>
            <column-instance column='[Calculation_3021493178926415903]' derivation='Attribute' name='[attr:Calculation_3021493178926415903:nk]' pivot='key' type='nominal' />
