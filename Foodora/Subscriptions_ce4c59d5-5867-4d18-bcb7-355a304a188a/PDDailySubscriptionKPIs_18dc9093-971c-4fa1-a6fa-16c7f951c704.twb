      <column caption='% LT Plan vs LW (+)' datatype='string' name='[LT Plan vs LW% (-) (copy)_3000171461627437071]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;[Calculation_5449777771077869586] &gt; 0&#10;then &apos;▲ &apos; &#10;+ STR(ROUND([Calculation_5449777771077869586]*100,1))+&apos;%&apos;&#10;ELSE null&#10;end' />
      </column>
