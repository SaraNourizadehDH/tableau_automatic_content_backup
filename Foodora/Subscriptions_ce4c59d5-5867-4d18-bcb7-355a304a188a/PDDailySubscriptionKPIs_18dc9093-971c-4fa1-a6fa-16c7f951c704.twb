        <calculation class='tableau' formula='if&#10;(&#10;    [Calculation_4464052437762793508] - [Calculation_4464052437762895909]&#10;)&#10;&#10;/&#10;&#10;[Calculation_4464052437762895909] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
