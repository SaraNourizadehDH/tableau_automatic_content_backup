        <calculation class='tableau' formula='if isnull([Calculation_2558044618674647040]) then 0&#10;elseif [Calculation_2558044618674647040] &lt;= -0.02&#10;then -2&#10;elseif ([Calculation_2558044618674647040] - [% Order Contributions L7D Average (copy)_2558044618678394888])/abs([% Order Contributions L7D Average (copy)_2558044618678394888]) &gt;= 0.02&#10;then 2&#10;elseif (([Calculation_2558044618674647040] - [% Order Contributions L7D Average (copy)_2558044618678394888])/abs([% Order Contributions L7D Average (copy)_2558044618678394888]) &gt;= 0.01)&#10;then 1&#10;elseif ([Calculation_2558044618674647040] - [% Order Contributions L7D Average (copy)_2558044618678394888])/abs([% Order Contributions L7D Average (copy)_2558044618678394888]) &lt;= -0.01&#10;then -1&#10;else 0&#10;end'>
