    <worksheet name='Order Contribution % MTD Growth'>
      <table>
        <view>
          <datasources>
            <datasource caption='Subscription Performance' name='federated.09mi0qj0mcgdim18r56im05w0ob5' />
          </datasources>
          <datasource-dependencies datasource='federated.09mi0qj0mcgdim18r56im05w0ob5'>
            <column caption='MTD' datatype='boolean' name='[Calculation_4464052437740544014]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 0&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_4464052437740621839]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 1&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='1 MTD Growth' datatype='integer' name='[Calculation_4464052437741768722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth' />
              </aliases>
            </column>
            <column caption='% Order Contribution (MTD)' datatype='real' name='[Calculation_4464052437762793508]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([Calculation_4464052437740544014],[subscription_orders],0))&#10;/&#10;SUM(iif([Calculation_4464052437740544014],[order_count],0))' />
            </column>
            <column caption='% Order Contribution (PMTD)' datatype='real' name='[Calculation_4464052437762895909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([Calculation_4464052437740621839],[subscription_orders],0))&#10;/&#10;SUM(iif([Calculation_4464052437740621839],[order_count],0))' />
            </column>
            <column caption='% Order Contribution MTD vs. PMTD' datatype='real' default-format='*▲ 0.00ppt;▼ 0.00ppt' name='[Calculation_4464052437763248166]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='([Calculation_4464052437762793508] - [Calculation_4464052437762895909]) * 100' />
            </column>
            <column caption='Color - % Contribition MTD vs. PMTD' datatype='string' name='[Calculation_4464052437763518503]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    [Calculation_4464052437762793508] - [Calculation_4464052437762895909]&#10;)&#10;&#10;/&#10;&#10;[Calculation_4464052437762895909] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_4464052437741768722]' derivation='None' name='[none:Calculation_4464052437741768722:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[order_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[subscription_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_4464052437763248166]' derivation='User' name='[usr:Calculation_4464052437763248166:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_4464052437763518503]' derivation='User' name='[usr:Calculation_4464052437763518503:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' field='[federated.09mi0qj0mcgdim18r56im05w0ob5].[none:Calculation_4464052437741768722:ok]' value='363' />
            <format attr='cell-w' value='60' />
            <format attr='cell-h' value='40' />
            <format attr='cell' value='20' />
            <format attr='cell-q' value='100' />
            <format attr='text-align' value='center' />
          </style-rule>
          <style-rule element='header'>
            <format attr='height' field='[federated.09mi0qj0mcgdim18r56im05w0ob5].[none:Calculation_4464052437741768722:ok]' value='40' />
            <format attr='background-color' field='[federated.09mi0qj0mcgdim18r56im05w0ob5].[none:Calculation_4464052437741768722:ok]' value='#ca0052' />
