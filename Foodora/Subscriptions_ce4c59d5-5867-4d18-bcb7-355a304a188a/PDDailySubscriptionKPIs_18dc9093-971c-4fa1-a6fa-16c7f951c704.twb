      <column caption='Benefit Utilisation % (fd)' datatype='real' default-format='p0.0%' name='[Benefit Utilisation % (copy)_2558044618676359170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([fd_subscription_order])/sum([subscription_orders])' />
      </column>
      <column caption='Benefit Utilisation % (voucher)' datatype='real' default-format='p0.0%' name='[Benefit Utilisation % (fd) (copy)_2558044618677510148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([voucher_subscription_order])/sum([dmart_subscriber_orders])' />
      </column>
      <column caption='Ranking % Order Contributions' datatype='real' name='[Calculation_1299781119976767489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF(date &gt;= now() - 8, [subscription_orders], 0)) / SUM(IIF(date &gt;= now() - 8, [order_count], 0))' />
      </column>
      <column caption='Order Count LW Growth Ranking' datatype='real' name='[Calculation_192669667481686020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(&#10;IF SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) &gt;= 0&#10;THEN &#10;   (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END)&#10;ELSE&#10;   (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END)&#10;END * 100, 2)' />
      </column>
      <column caption='% Order Contrubutions LW Growth Ranking' datatype='real' name='[Calculation_192669667482079237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(&#10;&#10;(ROUND( (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_yesterday] THEN [order_count] ELSE 0 END)) , 3)&#10;- ROUND( (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)), 3))&#10;/ ROUND( (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)) , 3) &#10;&#10;* 100&#10;, 2)' />
      </column>
      <column caption='Color - Total  Orders' datatype='integer' name='[Calculation_2037315926015705123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if isnull(sum([subscription_orders])) then 0&#10;elseif ((sum([subscription_orders]) - [Calculation_2037315926016102436])/abs([Calculation_2037315926016102436]) &gt;= 0.05)&#10;then 2&#10;elseif (sum([subscription_orders]) - [Calculation_2037315926016102436])/abs([Calculation_2037315926016102436]) &lt;= -0.05&#10;then -2&#10;elseif ((sum([subscription_orders]) - [Calculation_2037315926016102436])/abs([Calculation_2037315926016102436]) &gt;= 0.025)&#10;then 1&#10;elseif (sum([subscription_orders]) - [Calculation_2037315926016102436])/abs([Calculation_2037315926016102436]) &lt;= -0.025&#10;then -1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Order Count L7D AVG' datatype='real' name='[Calculation_2037315926016102436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(sum([subscription_orders]),first(),first()+7)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Number of Records' datatype='integer' name='[Calculation_2037315926016372773]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Benefit Utilisation %' datatype='real' default-format='p0.0%' name='[Calculation_2558044618674647040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([subscription_benefit_orders])/sum([subscription_orders])' />
      </column>
      <column aggregation='Sum' caption='1 Benefit Utilisation%' datatype='integer' name='[Calculation_2558044618675335169]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='1' />
        <aliases>
          <alias key='1' value='All Benefit Utilisation%' />
        </aliases>
      </column>
      <column caption='GMV Contribution%' datatype='real' default-format='p0.0%' name='[Calculation_3641582512769089536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([subscriber_gmv])/SUM([gmv])' />
      </column>
      <column caption='Order Count LW Growth' datatype='string' name='[Calculation_4464052437733662720]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;IF SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) &gt;= 0&#10;THEN &#10;   (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END)&#10;ELSE&#10;   (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END)&#10;END * 100, 2))' />
      </column>
      <column caption='Color - Order Count LW Growth' datatype='string' name='[Calculation_4464052437733945347]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='1 LW' datatype='integer' name='[Calculation_4464052437734023172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
        <aliases>
