      <column caption='% Pro Deals LW Growth' datatype='string' name='[Calculation_2037315925601902601]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;((SUM(IF [is_yesterday] THEN [pro_vendor_count] ELSE 0 END) / SUM(IF [is_yesterday] THEN [total_vendors] ELSE 0 END))&#10;- (SUM(IF [is_same_day_last_week] THEN [pro_vendor_count] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [total_vendors] ELSE 0 END)))&#10;/ (SUM(IF [is_same_day_last_week] THEN [pro_vendor_count] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [total_vendors] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;    ROUND(&#10;    (ROUND( (SUM(IF [is_yesterday] THEN [pro_vendor_count] ELSE 0 END) / SUM(IF [is_yesterday] THEN [total_vendors] ELSE 0 END)), 3)&#10;    - ROUND( (SUM(IF [is_same_day_last_week] THEN [pro_vendor_count] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [total_vendors] ELSE 0 END)), 3)) &#10;    / ROUND( (SUM(IF [is_same_day_last_week] THEN [pro_vendor_count] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [total_vendors] ELSE 0 END)), 3)&#10;    * 100, 2)&#10;)' />
      </column>
      <column caption='Color - % Pro Deals LW Growth' datatype='string' name='[Calculation_2037315925605978123]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;((SUM(IF [is_yesterday] THEN [pro_vendor_count] ELSE 0 END) / SUM(IF [is_yesterday] THEN [total_vendors] ELSE 0 END))&#10;- (SUM(IF [is_same_day_last_week] THEN [pro_vendor_count] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [total_vendors] ELSE 0 END)))&#10;/ (SUM(IF [is_same_day_last_week] THEN [pro_vendor_count] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [total_vendors] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='% Pro Deals T7D' datatype='real' name='[Calculation_2037315925631672332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([date]&gt;= now()-8, [pro_vendor_count], 0)) &#10;&#10;/&#10;&#10;SUM(iif([date]&gt;= now()-8,[total_vendors], 0))' />
