        <calculation class='tableau' formula='SUM(IIF([report_date] &gt;= now() - 15 AND [report_date] &lt; now() - 8 AND [plan_duration] &lt;&gt; &quot;1&quot;, [active_subscribers], 0))&#10;/&#10;SUM(IIF([report_date] &gt;= now() - 15 AND [report_date] &lt; now() - 8, [active_subscribers], 0))' />
