            <column caption='Number of Records' datatype='integer' name='[Calculation_3021493178557628419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Color - Payments' datatype='integer' name='[Color - Total Subscribers (copy)_687643432250253313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if isnull(sum([daily_amortized_payment_eur])) then 0&#10;elseif ((sum([daily_amortized_payment_eur]) - [Total Subscribers L7D AVG (copy)_687643432250335234])/abs([Total Subscribers L7D AVG (copy)_687643432250335234]) &gt;= 0.005)&#10;then 2&#10;elseif (sum([daily_amortized_payment_eur]) - [Total Subscribers L7D AVG (copy)_687643432250335234])/abs([Total Subscribers L7D AVG (copy)_687643432250335234]) &lt;= -0.005&#10;then -2&#10;elseif ((sum([daily_amortized_payment_eur]) - [Total Subscribers L7D AVG (copy)_687643432250335234])/abs([Total Subscribers L7D AVG (copy)_687643432250335234]) &gt;= 0.0025)&#10;then 1&#10;elseif (sum([daily_amortized_payment_eur]) - [Total Subscribers L7D AVG (copy)_687643432250335234])/abs([Total Subscribers L7D AVG (copy)_687643432250335234]) &lt;= -0.0025&#10;then -1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Payments L7D AVG' datatype='real' name='[Total Subscribers L7D AVG (copy)_687643432250335234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(sum([daily_amortized_payment_eur]),first(),first()+7)'>
                <table-calc ordering-type='Rows' />
