        <field-sort-custom-order field='sub_enabled_wallet_users' />
      </field-sort-info>
      <filter class='categorical' column='[global_entity_id]' filter-group='2'>
        <groupfilter function='level-members' level='[global_entity_id]' user:ui-enumeration='all' user:ui-exclude='true' user:ui-marker='enumerate' />
      </filter>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_BB9C58343CFE418CB99A610F0A5E3B35'>
            <properties context=''>
              <relation connection='bigquery.05b3v9r0vsce0314nvecw15ezuh2' name='Custom SQL Query' type='text'><![CDATA[WITH
countries AS(
  SELECT DISTINCT
    global_entity_id
  FROM `fulfillment-dwh-production`.pandata_curated.shared_countries
),

user_orders AS (
  SELECT
    pd_orders.pd_customer_uuid,
    pd_orders.global_entity_id,
    pd_orders.order_uid AS uuid,
    pd_orders.vendor_code,
    pd_orders.payment_method AS payment_method_type,
    pd_orders.created_at_local AS ordered_at_local,
    DATE(pd_orders.created_at_local) >>= DATE_SUB(CURRENT_DATE, INTERVAL 1 MONTH) AS is_L1M
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS pd_orders
  INNER JOIN countries
          ON countries.global_entity_id = pd_orders.global_entity_id
  WHERE pd_orders.is_successful
    AND pd_orders.created_date_local >>= DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH)
),

current_subscribers AS(
  SELECT DISTINCT
    customer_uuid
  FROM `fulfillment-dwh-production`.pandata_curated.sb_subscriptions, UNNEST(payments) p
  INNER JOIN countries
          ON countries.global_entity_id = sb_subscriptions.global_entity_id  
  WHERE p.is_status_success
   AND DATE(p.subscription_start_at_local) << CURRENT_DATE
   AND DATE(p.subscription_end_at_local) >>= CURRENT_DATE
   AND sb_subscriptions.created_date_utc <<= CURRENT_DATE
),

all_card_users AS (
  SELECT
    pd_customer_uuid
  FROM user_orders
  WHERE REGEXP_CONTAINS(payment_method_type, "(?i)(credit)")
    OR payment_method_type IN ("visa", "jcb", "mastercard", "americanexpress", "card")
  GROUP BY
    pd_customer_uuid
),

all_cash_users AS (
  SELECT
    pd_customer_uuid
  FROM user_orders
  WHERE payment_method_type IN ("cash", "cod")
  GROUP BY
    pd_customer_uuid
),

all_wallet_users AS (
  SELECT
    pd_customer_uuid
  FROM user_orders
  WHERE NOT REGEXP_CONTAINS(payment_method_type, "(?i)(credit)")
    AND payment_method_type NOT IN ("cash", "invoice", "cod", "visa", "jcb", "mastercard", "americanexpress", "card")
  GROUP BY
    pd_customer_uuid
),

sub_enabled_wallet_users AS (
  SELECT
    pd_customer_uuid
  FROM user_orders
  WHERE (payment_method_type LIKE "%antfinancial%" --FILTERS SUB ENABLED WALLETS
    OR payment_method_type IN ("bkash", "gcash", "truemoney"))
    AND payment_method_type NOT IN ("cash", "invoice", "cod", "visa", "jcb", "mastercard", "americanexpress", "card")
  GROUP BY
    pd_customer_uuid
),

all_users AS(
  SELECT 
    global_entity_id,
    pd_customer_uuid,
    COUNT(uuid) AS orders
  FROM user_orders
  WHERE user_orders.is_L1M
  GROUP BY 1,2
),

user_agg AS(
SELECT
  all_users.pd_customer_uuid,
  all_users.global_entity_id,
  all_users.orders,
  current_subscribers.customer_uuid IS NOT NULL AS is_current_subscriber,
  all_cash_users.pd_customer_uuid IS NOT NULL AS is_l1m_cash_user,
  all_card_users.pd_customer_uuid IS NOT NULL AS is_l1m_card_user,
  all_wallet_users.pd_customer_uuid IS NOT NULL AS is_l1m_wallet_user,
  all_cash_users.pd_customer_uuid IS NOT NULL AND all_card_users.pd_customer_uuid IS NULL AND all_wallet_users.pd_customer_uuid IS NULL AS is_l1m_exclusive_cash_user,
  all_card_users.pd_customer_uuid IS NOT NULL AND all_cash_users.pd_customer_uuid IS NULL AND all_wallet_users.pd_customer_uuid IS NULL AS is_l1m_exclusive_card_user,
  all_wallet_users.pd_customer_uuid IS NOT NULL AND all_card_users.pd_customer_uuid IS NULL AND all_cash_users.pd_customer_uuid IS NULL AS is_l1m_exclusive_wallet_user,
  sub_enabled_wallet_users.pd_customer_uuid IS NOT NULL AS is_l1m_sub_enabled_wallet_user
FROM all_users
LEFT JOIN current_subscribers
       ON current_subscribers.customer_uuid = all_users.pd_customer_uuid
LEFT JOIN all_wallet_users
       ON all_wallet_users.pd_customer_uuid = all_users.pd_customer_uuid
LEFT JOIN all_cash_users
       ON all_cash_users.pd_customer_uuid = all_users.pd_customer_uuid
LEFT JOIN all_card_users
       ON all_card_users.pd_customer_uuid = all_users.pd_customer_uuid
LEFT JOIN sub_enabled_wallet_users
       ON sub_enabled_wallet_users.pd_customer_uuid = all_users.pd_customer_uuid
)

SELECT
  user_agg.global_entity_id,
  is_current_subscriber,
  shared_countries.name AS country_name,
  CASE WHEN orders <<= 3 THEN '1) 1-3'
    WHEN orders <<= 6 THEN '2) 4-6'
    WHEN orders <<= 9 THEN '3) 7-9'
    WHEN orders <<= 12 THEN '4) 10-12'
    ELSE '5) >>=13'
    END AS of_bucket,
  COUNT(IF(is_l1m_cash_user AND is_l1m_card_user AND is_l1m_wallet_user,pd_customer_uuid,NULL)) AS cash_wallet_card_users,
  COUNT(IF(is_l1m_cash_user AND NOT is_l1m_card_user AND is_l1m_wallet_user,pd_customer_uuid,NULL)) AS cash_wallet_users,
  COUNT(IF(is_l1m_cash_user AND NOT is_l1m_card_user AND NOT is_l1m_wallet_user,pd_customer_uuid,NULL)) AS cash_users,

  COUNT(IF(NOT is_l1m_cash_user AND is_l1m_card_user AND is_l1m_wallet_user,pd_customer_uuid,NULL)) AS wallet_card_users,
  COUNT(IF(is_l1m_cash_user AND is_l1m_card_user AND NOT is_l1m_wallet_user,pd_customer_uuid,NULL)) AS cash_card_users,
  COUNT(IF(is_l1m_card_user AND NOT is_l1m_cash_user AND NOT is_l1m_wallet_user,pd_customer_uuid,NULL)) AS card_users,
  COUNT(IF(is_l1m_wallet_user AND NOT is_l1m_cash_user AND NOT is_l1m_card_user,pd_customer_uuid,NULL)) AS wallet_users,
  COUNT(IF(is_l1m_sub_enabled_wallet_user,pd_customer_uuid, NULL)) AS sub_enabled_wallet_users

FROM user_agg
INNER JOIN `fulfillment-dwh-production`.pandata_curated.shared_countries
ON shared_countries.global_entity_id = user_agg.global_entity_id
GROUP BY 1,2,3,4]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
