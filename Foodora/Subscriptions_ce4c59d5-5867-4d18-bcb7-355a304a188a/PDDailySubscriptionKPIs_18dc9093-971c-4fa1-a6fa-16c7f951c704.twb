              <calculation class='tableau' formula='if isnull(sum([subscription_orders])) then 0&#10;elseif ((sum([subscription_orders]) - [Calculation_2037315926016102436])/abs([Calculation_2037315926016102436]) &gt;= 0.05)&#10;then 2&#10;elseif (sum([subscription_orders]) - [Calculation_2037315926016102436])/abs([Calculation_2037315926016102436]) &lt;= -0.05&#10;then -2&#10;elseif ((sum([subscription_orders]) - [Calculation_2037315926016102436])/abs([Calculation_2037315926016102436]) &gt;= 0.025)&#10;then 1&#10;elseif (sum([subscription_orders]) - [Calculation_2037315926016102436])/abs([Calculation_2037315926016102436]) &lt;= -0.025&#10;then -1&#10;else 0&#10;end'>
