    <worksheet name='Total Order Contribution %'>
      <table>
        <view>
          <datasources>
            <datasource caption='Subscription Performance' name='federated.09mi0qj0mcgdim18r56im05w0ob5' />
          </datasources>
          <datasource-dependencies datasource='federated.09mi0qj0mcgdim18r56im05w0ob5'>
            <column caption='Day (Similar Scale)' datatype='datetime' name='[Calculation_4464052437742661651]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [date] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [date])&#10;ELSE [date]&#10;END' />
            </column>
            <column caption='DayOfWeek' datatype='string' name='[Calculation_4464052437742923796]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [date])' />
            </column>
            <column caption='L7D &amp; Previous L7D' datatype='string' name='[Calculation_4464052437743263765]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [date] &lt;= NOW() - 1&#10;THEN &apos;L7D&apos;&#10;ELSEIF [date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END' />
            </column>
            <column caption='% Order Contributions' datatype='real' default-format='p0.0%' name='[Calculation_4464052437751812120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([subscription_orders])/SUM([order_count])' />
            </column>
            <column-instance column='[Calculation_4464052437742923796]' derivation='Attribute' name='[attr:Calculation_4464052437742923796:nk]' pivot='key' type='nominal' />
