    <worksheet name='Order Contribution % Low Growth'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>Lowest Growth</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Subscription Performance' name='federated.09mi0qj0mcgdim18r56im05w0ob5' />
          </datasources>
          <datasource-dependencies datasource='federated.09mi0qj0mcgdim18r56im05w0ob5'>
            <column caption='% Order Contrubutions LW Growth Ranking' datatype='real' name='[Calculation_192669667482079237]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(&#10;&#10;(ROUND( (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_yesterday] THEN [order_count] ELSE 0 END)) , 3)&#10;- ROUND( (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)), 3))&#10;/ ROUND( (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)) , 3) &#10;&#10;* 100&#10;, 2)' />
            </column>
            <column caption='Number of Records' datatype='integer' name='[Calculation_2037315926016372773]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='INDEX' datatype='integer' name='[Calculation_4464052437749858327]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Color - Order Contributions % LW Growth' datatype='string' name='[Color - Order Count LW Growth (copy)_4464052437757181980]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;((SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_yesterday] THEN [order_count] ELSE 0 END))&#10;- (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)))&#10;/ (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='% Order Contributions LW Growth' datatype='string' name='[Order Count LW Growth (copy)_4464052437756911643]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;((SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_yesterday] THEN [order_count] ELSE 0 END))&#10;- (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)))&#10;/ (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ &#10;STR(&#10;ROUND(&#10;&#10;(ROUND( (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_yesterday] THEN [order_count] ELSE 0 END)) , 3)&#10;- ROUND( (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)), 3))&#10;/ ROUND( (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)) , 3) &#10;&#10;* 100&#10;, 2)&#10;)' />
            </column>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='boolean' name='[is_same_day_last_week]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2037315926016372773]' derivation='Min' name='[min:Calculation_2037315926016372773:qk]' pivot='key' type='quantitative' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[order_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[subscription_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_192669667482079237]' derivation='User' name='[usr:Calculation_192669667482079237:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4464052437749858327]' derivation='User' name='[usr:Calculation_4464052437749858327:ok]' pivot='key' type='ordinal'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column-instance column='[Color - Order Count LW Growth (copy)_4464052437757181980]' derivation='User' name='[usr:Color - Order Count LW Growth (copy)_4464052437757181980:nk]' pivot='key' type='nominal' />
            <column-instance column='[Order Count LW Growth (copy)_4464052437756911643]' derivation='User' name='[usr:Order Count LW Growth (copy)_4464052437756911643:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
