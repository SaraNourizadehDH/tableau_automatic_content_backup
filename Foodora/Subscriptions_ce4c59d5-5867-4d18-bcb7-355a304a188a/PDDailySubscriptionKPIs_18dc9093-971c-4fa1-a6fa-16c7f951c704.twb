            <column-instance column='[is_today]' derivation='None' name='[none:is_today:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[order_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[subscription_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_4464052437742661651]' derivation='Day-Trunc' name='[tdy:Calculation_4464052437742661651:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4464052437751812120]' derivation='User' name='[usr:Calculation_4464052437751812120:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.09mi0qj0mcgdim18r56im05w0ob5].[Exclusions (DAY(Day (Similar Scale)),L7D &amp; Previous L7D)]'>
