      <column caption='Color - L7D Growth Order Contribution %' datatype='string' name='[Color - L7D Growth Total Orders (copy)_4464052437761462306]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([T7D Total Orders (copy)_4464052437758599197] - [T7D Order Contributions % (copy)_4464052437760069664])&#10;/&#10;[T7D Order Contributions % (copy)_4464052437760069664] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='Color - Order Contributions % LW Growth' datatype='string' name='[Color - Order Count LW Growth (copy)_4464052437757181980]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;((SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_yesterday] THEN [order_count] ELSE 0 END))&#10;- (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)))&#10;/ (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column caption='Color - % Order Contributions' datatype='integer' name='[Color - Total  Orders (copy)_4464052437754794009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if isnull([Calculation_4464052437751812120]) then 0&#10;elseif [Calculation_4464052437751812120] &lt;= -0.2&#10;then -2&#10;elseif ([Calculation_4464052437751812120] - [Calculation_4464052437755097114])/abs([Calculation_4464052437755097114]) &gt;= 0.2&#10;then 2&#10;elseif (([Calculation_4464052437751812120] - [Calculation_4464052437755097114])/abs([Calculation_4464052437755097114]) &gt;= 0.1)&#10;then 1&#10;elseif ([Calculation_4464052437751812120] - [Calculation_4464052437755097114])/abs([Calculation_4464052437755097114]) &lt;= -0.1&#10;then -1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MTD GMV% Growth' datatype='real' default-format='p0.0%' name='[GMV Contribution% (copy)_3641582512772104196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(( SUM(IF [Calculation_4464052437740544014] THEN ([subscriber_gmv]) ELSE 0 END) / SUM(IF [Calculation_4464052437740544014] THEN ([gmv]) ELSE 0 END ))&#10;-&#10;(SUM(IF [Calculation_4464052437740621839] THEN ([subscriber_gmv]) ELSE 0 END) / SUM(IF [Calculation_4464052437740621839] THEN ([gmv]) ELSE 0 END ))&#10;) * 100' />
      </column>
      <column caption='L7D Growth Total Orders (copy)' datatype='string' name='[L7D Growth Total Orders (copy)_4464052437759365150]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Calculation_4464052437736493063] - [Calculation_4464052437737721864]) / [Calculation_4464052437737721864] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(&#10;round(([Calculation_4464052437736493063] - [Calculation_4464052437737721864]) / [Calculation_4464052437737721864]*100,2)&#10;)' />
      </column>
      <column caption='L7D GMV% Growth' datatype='real' default-format='p0.0%' name='[MTD GMV% Growth (copy)_3641582512776957958]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;( SUM(IF [Calculation_4464052437743263765] = &quot;L7D&quot; THEN ([subscriber_gmv]) ELSE 0 END) / SUM(IF [Calculation_4464052437743263765] = &quot;L7D&quot; THEN ([gmv]) ELSE 0 END ))&#10;-&#10;(SUM(IF [Calculation_4464052437743263765] = &quot;Previous L7D&quot; THEN ([subscriber_gmv]) ELSE 0 END) / SUM(IF [Calculation_4464052437743263765] = &quot;Previous L7D&quot; THEN ([gmv]) ELSE 0 END ))&#10;) * 100' />
      </column>
      <column caption='% Order Contributions LW Growth' datatype='string' name='[Order Count LW Growth (copy)_4464052437756911643]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;((SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_yesterday] THEN [order_count] ELSE 0 END))&#10;- (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)))&#10;/ (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ &#10;STR(&#10;ROUND(&#10;&#10;(ROUND( (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_yesterday] THEN [order_count] ELSE 0 END)) , 3)&#10;- ROUND( (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)), 3))&#10;/ ROUND( (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)) , 3) &#10;&#10;* 100&#10;, 2)&#10;)' />
