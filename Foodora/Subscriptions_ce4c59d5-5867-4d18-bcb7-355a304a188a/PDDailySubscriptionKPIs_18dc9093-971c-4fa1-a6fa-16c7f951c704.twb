            <column caption='LW LT Plan%' datatype='real' default-format='p0.0%' name='[L1D LT Plan% (copy)_5449777771077496849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_743938370268401668] AND [plan_duration] &lt;&gt; &quot;1M&quot;, [active_subscribers], 0))&#10;/&#10;SUM(IIF([Calculation_743938370268401668] , [active_subscribers], 0))' />
            </column>
            <column caption='% LT Plan vs LW (+)' datatype='string' name='[LT Plan vs LW% (-) (copy)_3000171461627437071]' role='measure' type='nominal'>
