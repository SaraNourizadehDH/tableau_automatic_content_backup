              <calculation class='tableau' formula='-&#10;(TODAY() - &#10;IF [report_date] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [report_date])&#10;ELSE [report_date]&#10;END&#10;)' />
