      </column>
      <column caption='Ranking Churned Subscribers' datatype='integer' name='[Calculation_1299781119978463235]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([report_date] &gt;= NOW() - 8, [Calculation_743938370275590154], 0)' />
      </column>
      <column caption='% Active Subs' datatype='real' default-format='p0.0%' name='[Calculation_1460573701534838786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_subscribers_with_l30d_order])/SUM([active_subscribers])' />
      </column>
      <column caption='Active Subs LW Growth' datatype='real' default-format='*▲ 0.0%; ▼ 0.0%' name='[Calculation_1460573701549563910]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_743938370266841088] THEN [active_subscribers_with_l30d_order] ELSE 0 END)&#10;   / SUM(IF [Calculation_743938370268401668] THEN [active_subscribers_with_l30d_order] ELSE 0 END)&#10;-1' />
      </column>
      <column caption='T7D Growth Churn from PF' datatype='real' default-format='*▲ 0.0; ▼ 0.0' name='[Calculation_1865616214289985546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([T7D Churned Subscribers (copy)_1865616214286315528]/[T7D Churned from PF (copy)_1865616214289788937] -1) * 100' />
      </column>
      <column caption='Yesterday Subscribers' datatype='integer' name='[Calculation_3000171461621948423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE 0 END' />
      </column>
      <column caption='placeholder' datatype='integer' name='[Calculation_3000171461622910984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column caption='is_8d_ago' datatype='boolean' name='[Calculation_3000171461623435273]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] = TODAY() - 8' />
      </column>
      <column caption='Subscribers WoW' datatype='real' name='[Calculation_3000171461623533578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(   SUM(IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE NULL END)&#10;    /&#10;    SUM(IF [Calculation_3000171461623435273]  THEN [active_subscribers] ELSE NULL END)&#10;&#10;) -1&#10;&#10;)*100' />
      </column>
      <column caption='Subscribers WoW (-)' datatype='string' name='[Calculation_3000171461623676939]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;[Calculation_3000171461623533578] &lt;= 0&#10;then &apos;▼ &apos; &#10;+ STR(ROUND([Calculation_3000171461623533578],1))+&apos;%&apos;&#10;ELSE null&#10;end' />
      </column>
      <column caption='Subscribers Avg Color' datatype='boolean' name='[Calculation_3000171461625073677]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SuM([active_subscribers])*ATTR({EXCLUDE [report_date]: COUNTD([report_date])}) &gt;= WINDOW_SUM(SUM([active_subscribers]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='LT Plan vs LW% (-)' datatype='string' name='[Calculation_3000171461627330574]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;[Calculation_5449777771077869586] &lt;= 0&#10;then &apos;▼ &apos; &#10;+ STR(ROUND([Calculation_5449777771077869586]*100,1))+&apos;%&apos;&#10;ELSE null&#10;end' />
      </column>
      <column caption='Yesterday new subs' datatype='integer' name='[Calculation_3000171461631873040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Calculation_743938370266841088] THEN [Calculation_743938370268053506] ELSE 0 END' />
      </column>
      <column caption='New Subs vs LW' datatype='real' name='[Calculation_3000171461632040978]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [Calculation_743938370266841088] THEN [Calculation_743938370268053506] ELSE 0 END) - SUM(IF [Calculation_743938370268401668] THEN [Calculation_743938370268053506] ELSE 0 END))&#10;/ SUM(IF [Calculation_743938370268401668] THEN [Calculation_743938370268053506] ELSE 0 END)' />
      </column>
      <column caption='Yesterday Churned subs' datatype='integer' name='[Calculation_3000171461634957336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_743938370266841088] THEN [Calculation_743938370275590154] ELse 0 END' />
      </column>
      <column caption='Color - Total Subscribers' datatype='real' datatype-customized='true' name='[Calculation_3021493178555977728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([active_subscribers]) - [Calculation_3021493178556649473])/abs([Calculation_3021493178556649473])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Subscribers L7D AVG' datatype='real' name='[Calculation_3021493178556649473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(sum([active_subscribers]),first(),first()+7)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Number of Records' datatype='integer' name='[Calculation_3021493178557628419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Total Subscribers LW Growth' datatype='string' name='[Calculation_3021493178883756045]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM(IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE 0 END) - SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END))&#10;/ SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;IF SUM(IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE 0 END) - SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END) &gt;= 0&#10;THEN &#10;   (SUM(IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE 0 END) - SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END))&#10;   / SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END)&#10;ELSE&#10;   (SUM(IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE 0 END) - SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END))&#10;   / SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END)&#10;END * 100, 2))' />
      </column>
      <column caption='Color - Total Subscribers LW Growth' datatype='string' name='[Calculation_3021493178887413775]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM(IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE 0 END) - SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END))&#10;/ SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
      </column>
      <column aggregation='Sum' caption='1 LW' datatype='integer' name='[Calculation_3021493178887995410]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='1' />
        <aliases>
          <alias key='1' value='LW Growth %' />
        </aliases>
      </column>
      <column caption='T7D Growth Total Subscribers' datatype='string' name='[Calculation_3021493178889342995]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Calculation_3021493178889560084] - [Calculation_3021493178890625045]) / [Calculation_3021493178890625045] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(&#10;round(([Calculation_3021493178889560084] - [Calculation_3021493178890625045]) / [Calculation_3021493178890625045]*100,2)&#10;)' />
      </column>
      <column caption='T7D Total Subscribers' datatype='real' name='[Calculation_3021493178889560084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([report_date] &gt;= now() - 8, [active_subscribers], 0))/7' />
      </column>
      <column caption='Previous T7D Total Subscribers' datatype='real' name='[Calculation_3021493178890625045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([report_date] &gt;= now() - 15 AND [report_date] &lt; now() - 8, [active_subscribers], 0))/7' />
      </column>
      <column caption='Color - T7D Growth Total Subscribers' datatype='string' name='[Calculation_3021493178891124758]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Calculation_3021493178889560084] - [Calculation_3021493178890625045]) / [Calculation_3021493178890625045] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='Total Subscribers MTD  vs. PMTD' datatype='string' name='[Calculation_3021493178918617111]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_3021493178918760472], [active_subscribers], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_3021493178918862873], [active_subscribers], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_3021493178918862873], [active_subscribers], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([Calculation_3021493178918760472], [active_subscribers], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_3021493178918862873], [active_subscribers], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_3021493178918862873], [active_subscribers], 0)&#10;) * 100&#10;,2)&#10;)' />
      </column>
      <column caption='MTD' datatype='boolean' name='[Calculation_3021493178918760472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date], today() - 1) = 0&#10;AND&#10;DAY([report_date]) &lt;= DAY(TODAY()-1)' />
      </column>
      <column caption='PMTD' datatype='boolean' name='[Calculation_3021493178918862873]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date], today() - 1) = 1&#10;AND&#10;DAY([report_date]) &lt;= DAY(TODAY()-1)' />
      </column>
      <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[Calculation_3021493178919657498]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='1' />
        <aliases>
          <alias key='1' value='MTD Growth %' />
        </aliases>
      </column>
      <column caption='1 T7D Total' datatype='integer' name='[Calculation_3021493178919915547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
        <aliases>
          <alias key='1' value='T7D Total' />
        </aliases>
      </column>
      <column caption='L7D &amp; Previous L7D ' datatype='string' name='[Calculation_3021493178923221021]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [report_date] &lt;= NOW() - 1&#10;THEN &apos;L7D&apos;&#10;ELSEIF [report_date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [report_date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END' />
      </column>
      <column caption='Day of Day (Similar Scale)' datatype='real' name='[Calculation_3021493178923642910]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='-&#10;(TODAY() - &#10;IF [report_date] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [report_date])&#10;ELSE [report_date]&#10;END&#10;)' />
      </column>
      <column caption='DayofWeek' datatype='string' name='[Calculation_3021493178926415903]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [report_date])' />
      </column>
      <column caption='Total Subscribers Per Day' datatype='integer' name='[Calculation_3021493178932604960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [report_date]:&#10;SUM([active_subscribers])&#10;}' />
      </column>
      <column caption='INDEX' datatype='integer' name='[Calculation_3021493179170107425]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Ranking - LW Total Subscribers' datatype='real' name='[Calculation_3021493179170353186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;  SUM(IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE 0 END) - &#10;  SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END)&#10;)&#10;/ &#10;&#10;SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END)' />
      </column>
      <column caption='Total' datatype='string' name='[Calculation_3973793404151541787]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Grand Total&quot;' />
      </column>
      <column caption='MTD % Churned Subscribers' datatype='real' name='[Calculation_5368994490619645961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([Calculation_3021493178918760472],[Calculation_743938370275590154],0))&#10;/&#10;SUM(iif([Calculation_3021493178918760472], [daily_plans_ending],0))' />
      </column>
      <column caption='MTD vs. PMTD % Churned Subscribers' datatype='real' default-format='*▲ 0.0ppt;▼ 0.0ppt' name='[Calculation_5368994490619850763]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='([Calculation_5368994490619645961] - [MTD % Churned Subscribers (copy)_5368994490619772938])*100' />
      </column>
      <column caption='Ranking - % Churned Subscribers' datatype='real' name='[Calculation_5368994490658025488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([report_date] &gt;= now() - 8, [Calculation_743938370275590154], 0)) / SUM(IIF([report_date] &gt;= now() - 8, [previous_day_active_subscribers], 0))' />
      </column>
      <column caption='L7D Avg New subscribers' datatype='real' name='[Calculation_5449777771056992258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(sum([Calculation_743938370268053506]),first(),first()+7)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Active on LT Plan' datatype='real' name='[Calculation_5449777771064217605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [plan_duration] &lt;&gt; &quot;1M&quot; THEN [active_subscribers] ELSE 0 END )&#10;/&#10;SUM([active_subscribers])' />
      </column>
      <column caption='first' datatype='integer' name='[Calculation_5449777771065294854]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FIRST()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% L1M' datatype='real' name='[Calculation_5449777771067174922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_subscribers])/SUM([% of Subscribers (copy)_5449777771065688072])' />
      </column>
      <column caption='Plan Duration' datatype='string' name='[Calculation_5449777771067990027]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([plan_duration]) + &quot; MONTH PLAN&quot;' />
      </column>
      <column caption='LT Plan% vs LW' datatype='real' name='[Calculation_5449777771077869586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([T7D Churned from PF (copy)_5449777771076481040]/[L1D LT Plan% (copy)_5449777771077496849])-1' />
      </column>
      <column aggregation='Sum' caption='1 LT Plan%' datatype='integer' name='[Calculation_5449777771078348819]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='1' />
        <aliases>
          <alias key='1' value='% on LT Plans' />
        </aliases>
      </column>
      <column caption='T7D' datatype='boolean' name='[Calculation_6214263851148541953]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] &gt;= now() - 8' />
      </column>
      <column caption='is_yesterday ' datatype='boolean' name='[Calculation_743938370266841088]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] = [last_run_date] - 1' />
      </column>
      <column caption='excl today and future' datatype='boolean' name='[Calculation_743938370267455489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] &lt; TODAY()' />
      </column>
      <column caption='New Subscribers ' datatype='integer' name='[Calculation_743938370268053506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[signup_count_8_to_30d]+[signup_count_new_sub]+[signup_count_more_than_30d]+[signup_count_within_7d]' />
      </column>
      <column caption='is_same_day_last_week ' datatype='boolean' name='[Calculation_743938370268401668]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] = TODAY()-8' />
      </column>
      <column caption='active_t1' datatype='integer' name='[Calculation_743938370274185223]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([l1m_active_country_customers])' />
      </column>
      <column caption='active_t2' datatype='integer' name='[Calculation_743938370274263048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE [global_entity_id], [Calculation_743938370266841088]:&#10;COUNTD([Calculation_5449777771067990027] +[corporate_flag]+[plan_code]+[global_entity_id]+[payment_method])}' />
      </column>
      <column caption='Churned subscribers' datatype='integer' name='[Calculation_743938370275590154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[daily_cancellation_count]+[daily_payment_fail_count]' />
      </column>
      <column caption='1 Yesterday Plans Ending' datatype='string' name='[Calculation_743938370278166541]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Plans Ending&quot;' />
        <aliases>
          <alias key='&quot;Plans Ending&quot;' value='T7D Plans Ending' />
        </aliases>
      </column>
      <column caption='%Churned Subscribers L7D AVG (copy)' datatype='real' name='[Churned Subscribers L7D AVG (copy)_743938370276507659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(sum([Calculation_743938370275590154])/SUM([daily_plans_ending]),first(),first()+7)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Churned Subscribers LW Growth (+)' datatype='string' default-format='*▲0.0%;▼0.0%' name='[Churned Subscribers LW Growth (-) (copy)_3000171461639708698]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;[Total Subscribers LW Growth (copy)_3021493179230326831] &gt; 0&#10;then &apos;▲ &apos; &#10;+ STR(ROUND([Total Subscribers LW Growth (copy)_3021493179230326831],1))+&apos;%&apos;&#10;ELSE null&#10;end' />
      </column>
      <column caption='Churned Subscribers LW Growth (-)' datatype='string' default-format='*▲0.0%;▼0.0%' name='[Churned Subscribers LW Growth (copy)_3000171461639626777]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;[Total Subscribers LW Growth (copy)_3021493179230326831] &lt;= 0&#10;then &apos;▼ &apos; &#10;+ STR(ROUND([Total Subscribers LW Growth (copy)_3021493179230326831],1))+&apos;%&apos;&#10;ELSE null&#10;end' />
      </column>
      <column caption='Color - MTD Growth New Subscribers' datatype='string' name='[Color - MTD Growth Total Subscribers (copy)_3021493179203219500]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_3021493178918760472], [Calculation_743938370268053506], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_3021493178918862873], [Calculation_743938370268053506], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_3021493178918862873], [Calculation_743938370268053506], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='Color - MTD Growth Churned Subscribers' datatype='string' name='[Color - MTD Growth Total Subscribers (copy)_3021493179233476665]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_3021493178918760472], [Calculation_743938370275590154], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_3021493178918862873], [Calculation_743938370275590154], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_3021493178918862873], [Calculation_743938370275590154], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='Color - Churned Subscribers' datatype='integer' name='[Color - New Subscribers (copy)_3021493178837037066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if isnull(sum([Calculation_743938370275590154])) then 0&#10;elseif ((sum([Calculation_743938370275590154]) - [New Subscribers L7D AVG (copy)_3021493178837352459])/abs([New Subscribers L7D AVG (copy)_3021493178837352459]) &gt;= 0.2)&#10;then 2&#10;elseif (sum([Calculation_743938370275590154]) - [New Subscribers L7D AVG (copy)_3021493178837352459])/abs([New Subscribers L7D AVG (copy)_3021493178837352459]) &lt;= -0.2&#10;then -2&#10;elseif ((sum([Calculation_743938370275590154]) - [New Subscribers L7D AVG (copy)_3021493178837352459])/abs([New Subscribers L7D AVG (copy)_3021493178837352459]) &gt;= 0.1)&#10;then 1&#10;elseif (sum([Calculation_743938370275590154]) - [New Subscribers L7D AVG (copy)_3021493178837352459])/abs([New Subscribers L7D AVG (copy)_3021493178837352459]) &lt;= -0.1&#10;then -1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Color - T7D Growth % Churned Subscribers' datatype='string' name='[Color - T7D Growth Churned Subscribers (copy)_5368994490616688647]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([T7D Churned Subscribers (copy)_5368994490613006339] - [T7D % Churned Subscribers (copy)_5368994490615332870]) / [T7D % Churned Subscribers (copy)_5368994490615332870] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='Color - T7D Growth Churned Subscribers' datatype='string' name='[Color - T7D Growth New Subscribers (copy)_3021493179232190519]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([T7D New Subscribers (copy)_3021493179231178802] - [Previous T7D New Subscribers (copy)_3021493179231883317]) / [Previous T7D New Subscribers (copy)_3021493179231883317] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='Color - MTD Growth Total Subscribers' datatype='string' name='[Color - T7D Growth Total Subscribers (copy)_3021493178920452124]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_3021493178918760472], [active_subscribers], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_3021493178918862873], [active_subscribers], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_3021493178918862873], [active_subscribers], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='Color - T7D Growth New Subscribers' datatype='string' name='[Color - T7D Growth Total Subscribers (copy)_3021493179199975466]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([T7D Total Subscribers (copy)_3021493179199127591] - [Previous T7D Total Subscribers (copy)_3021493179199647785]) / [Previous T7D Total Subscribers (copy)_3021493179199647785] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='Color - Active Subscribers' datatype='real' datatype-customized='true' name='[Color - Total Subscribers (copy)_1460573701534117888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([active_subscribers_with_l30d_order]) - [Total Subscribers L7D AVG (copy)_1460573701534175233])/abs([Total Subscribers L7D AVG (copy)_1460573701534175233])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Color - New Subscribers' datatype='integer' name='[Color - Total Subscribers (copy)_3021493178827124740]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if isnull(sum([Calculation_743938370268053506])) then 0&#10;elseif ((sum([Calculation_743938370268053506]) - [Calculation_5449777771056992258])/abs([Calculation_5449777771056992258]) &gt;= 0.4)&#10;then 2&#10;elseif (sum([Calculation_743938370268053506]) - [Calculation_5449777771056992258])/abs([Calculation_5449777771056992258]) &lt;= -0.4&#10;then -2&#10;elseif ((sum([Calculation_743938370268053506]) - [Calculation_5449777771056992258])/abs([Calculation_5449777771056992258]) &gt;= 0.2)&#10;then 1&#10;elseif (sum([Calculation_743938370268053506]) - [Calculation_5449777771056992258])/abs([Calculation_5449777771056992258]) &lt;= -0.2&#10;then -1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Color - % Churned Subs' datatype='real' datatype-customized='true' name='[Color - Total Subscribers (copy)_743938370276610060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Yest. % of Churned Subscribers (copy)_5368994490600181760] - [Churned Subscribers L7D AVG (copy)_743938370276507659])/abs([Churned Subscribers L7D AVG (copy)_743938370276507659])'>
          <table-calc ordering-type='Rows' />
        </calculation>
