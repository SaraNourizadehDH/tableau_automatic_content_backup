        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1vu4b630ack5jz11z3sra0zv3t9m' name='Custom_SQL_Query' type='text'><![CDATA[WITH pro_deals AS(
  SELECt
    regional_apac_subscriptions_live_pro_deals_historical.global_entity_id,
    regional_apac_subscriptions_live_pro_deals_historical.country_name,
    updated_at_date  AS date,
    COUNT(DISTINCT vendor_code) AS pro_vendor_count,
    COUNT(DISTINCT IF(discount_ratio << 100,vendor_code, NULL)) AS non_fp_fund_pro_vendor_count,
    -- COUNT(DISTINCT IF(LOWER(team) = "sam", vendor_code, NULL)) AS pro_sam_vendor_count,
    -- COUNT(DISTINCT IF(discount_ratio << 100 AND LOWER(team) = "sam", vendor_code, NULL)) AS pro_sam_non_fp_fund_vendor_count,
  FROM  `fulfillment-dwh-production`.pandata_report.regional_apac_subscriptions_live_pro_deals_historical
  INNER JOIN `fulfillment-dwh-production`.pandata_curated.shared_countries
          ON shared_countries.global_entity_id = regional_apac_subscriptions_live_pro_deals_historical.global_entity_id
         -- AND shared_countries.region = 'Asia'
         -- AND shared_countries.company_name = 'Foodpanda'
  WHERE updated_at_date <<= CURRENT_DATE
    AND deal_status = 'LIVE DEAL'
    AND is_private = FALSE
    AND business_type_apac IN('restaurants','concepts','kitchens')
    
  GROUP BY 1,2,3
),

vendor_status_by_day AS (
  SELECT
   *
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__vendor_status_historical` 
  WHERE report_date >>= DATE_SUB(CURRENT_DATE, INTERVAL 45 DAY)
  ),

active_vendors AS (
  SELECT
    vendor_status_by_day.report_date AS date,
    vendor_status_by_day.global_entity_id,
    COUNT(DISTINCT pd_vendors.vendor_code) as total_vendors,
    -- COUNT(DISTINCT IF(LOWER(pd_vendors.owner_team_name) = "sam", pd_vendors.pd_vendor_uuid, NULL)) AS total_sam_vendors
  FROM vendor_status_by_day
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS pd_vendors
         ON pd_vendors.global_entity_id = vendor_status_by_day.global_entity_id
        AND pd_vendors.vendor_code = vendor_status_by_day.vendor_code
  WHERE TRUE
        AND vendor_status_by_day.is_active
        AND NOT vendor_status_by_day.is_private
        AND NOT vendor_status_by_day.is_test
        AND pd_vendors.business_type IN('restaurants','concepts','kitchens')
        
  GROUP BY 1,2
)  

SELECT
  pro_deals.global_entity_id,
  pro_deals.country_name,
  pro_deals.date,
  pro_deals.pro_vendor_count,
  pro_deals.non_fp_fund_pro_vendor_count,
  -- pro_deals.pro_sam_non_fp_fund_vendor_count,
  -- pro_deals.pro_sam_vendor_count,
  active_vendors.total_vendors,
  -- active_vendors.total_sam_vendors,
  pro_deals.date = DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY) AS is_yesterday,
  pro_deals.date = DATE_SUB(CURRENT_DATE, INTERVAL 8 DAY) AS is_same_day_last_week,
  pro_deals.date = CURRENT_DATE() AS is_today,
FROM pro_deals
LEFT JOIN active_vendors
       ON active_vendors.date = pro_deals.date
      AND active_vendors.global_entity_id = pro_deals.global_entity_id]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
