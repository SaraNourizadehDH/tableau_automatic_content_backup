    <worksheet name='Order Contribution % Top Growth'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>Top Growth</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Subscription Performance' name='federated.09mi0qj0mcgdim18r56im05w0ob5' />
          </datasources>
          <datasource-dependencies datasource='federated.09mi0qj0mcgdim18r56im05w0ob5'>
            <column caption='% Order Contrubutions LW Growth Ranking' datatype='real' name='[Calculation_192669667482079237]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(&#10;&#10;(ROUND( (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_yesterday] THEN [order_count] ELSE 0 END)) , 3)&#10;- ROUND( (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)), 3))&#10;/ ROUND( (SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) / SUM(IF [is_same_day_last_week] THEN [order_count] ELSE 0 END)) , 3) &#10;&#10;* 100&#10;, 2)' />
