      <aliases enabled='yes' />
      <column caption='% New on LT Plan' datatype='real' name='[% Active on LT Plan (copy)_5449777771338498072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [plan_duration] &lt;&gt; &quot;1&quot; THEN [Calculation_743938370268053506] ELSE 0 END )&#10;/&#10;SUM([Calculation_743938370268053506])' />
      </column>
      <column caption='% Churn from PF PMTD' datatype='real' name='[% Churn from PF MTD (copy)_3787808767072342019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_3021493178918862873]  THEN ([payment_failure_subscribers])ELSE 0 END )&#10;    /&#10;        SUM(IF [Calculation_3021493178918862873] THEN    ([Calculation_743938370275590154]+[renewal_subscribers]) ELSE 0 END)' />
      </column>
      <column caption='% of Churn from Payment Failure' datatype='real' default-format='p0.0%' name='[% Churned Subscribers (copy)_1865616214276575232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([payment_failure_subscribers])&#10;/&#10;(SUM([Calculation_743938370275590154])+SUM([renewal_subscribers]))' />
      </column>
      <column caption='Yest. % of Churned Subscribers' datatype='real' name='[% of Subscribers (copy)_1299781119980236806]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Calculation_743938370266841088], [Calculation_743938370275590154], 0))&#10;/ &#10;SUM(IIF([is_two_days_ago], [active_subscribers], 0))' />
      </column>
      <column caption='Total Active Customers' datatype='real' name='[% of Subscribers (copy)_5449777771065688072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE [global_entity_id (regional_apac_subscriptions_daily_subscription_revenue)], [Calculation_743938370266841088]:&#10;SUM([l1m_active_country_customers])/COUNTD([Calculation_5449777771067990027] +[corporate_flag]+[plan_code]+[global_entity_id (regional_apac_subscriptions_daily_subscription_revenue)]+[payment_method])}' />
      </column>
