              <calculation class='tableau' formula='(([% Pro Deals T7D (copy)_3973793403830444038]- [Pro Deals % Growth Previous T7D (copy)_3973793403830812680]) &#10;) * 100' />
            </column>
            <column caption='T7D Pro Deals % Growth (nonfpfund) (-)' datatype='real' default-format='*&quot;&quot;;▼ 0.0ppt;&quot;&quot;' name='[T7D Pro Deals % Growth (nonfpfund) (+) (copy)_3771623962215583760]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [% Pro Deals T7D (copy)_3973793403830444038]&lt; [Pro Deals % Growth Previous T7D (copy)_3973793403830812680]&#10;THEN [% Pro Deals T7D (copy)_3973793403830444038]- [Pro Deals % Growth Previous T7D (copy)_3973793403830812680]&#10;ELSE 0&#10;END&#10;* 100' />
