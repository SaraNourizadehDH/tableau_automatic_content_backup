            <datasource caption='Pro Deals' name='federated.1tnwrx10cjt15f11nsyel0iaat05' />
          </datasources>
          <datasource-dependencies datasource='federated.1tnwrx10cjt15f11nsyel0iaat05'>
            <column caption='% Pro Deals MTD (nonfpfund)' datatype='real' default-format='p0.0%' name='[% Pro Deals MTD (copy)_3973793403831574538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([is_yesterday],[non_fp_fund_pro_vendor_count],0))&#10;/&#10;SUM(iif([is_yesterday], [total_vendors],0))' />
            </column>
            <column caption='% Pro Deals T7D (nonfpfund)' datatype='real' default-format='p0.0%' name='[% Pro Deals T7D (copy)_3973793403830444038]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([date]= DATE(now()-1), [non_fp_fund_pro_vendor_count], 0)) &#10;&#10;/&#10;&#10;SUM(iif([date]= DATE(now()-1),[total_vendors], 0))' />
            </column>
            <column caption='placeholder 1' datatype='integer' name='[Calculation_3771623962214531085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(1)' />
