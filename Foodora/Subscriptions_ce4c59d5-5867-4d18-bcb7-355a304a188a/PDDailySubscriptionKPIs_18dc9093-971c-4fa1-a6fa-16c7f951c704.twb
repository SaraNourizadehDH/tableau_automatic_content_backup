    <worksheet name='Total Orders Top Growth'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>Top Growth</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Subscription Performance' name='federated.09mi0qj0mcgdim18r56im05w0ob5' />
          </datasources>
          <datasource-dependencies datasource='federated.09mi0qj0mcgdim18r56im05w0ob5'>
            <column caption='Order Count LW Growth Ranking' datatype='real' name='[Calculation_192669667481686020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(&#10;IF SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) &gt;= 0&#10;THEN &#10;   (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END)&#10;ELSE&#10;   (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END)&#10;END * 100, 2)' />
            </column>
            <column caption='Number of Records' datatype='integer' name='[Calculation_2037315926016372773]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Order Count LW Growth' datatype='string' name='[Calculation_4464052437733662720]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;IF SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) &gt;= 0&#10;THEN &#10;   (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END)&#10;ELSE&#10;   (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END)&#10;END * 100, 2))' />
            </column>
            <column caption='Color - Order Count LW Growth' datatype='string' name='[Calculation_4464052437733945347]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='INDEX' datatype='integer' name='[Calculation_4464052437749858327]' role='measure' type='ordinal'>
