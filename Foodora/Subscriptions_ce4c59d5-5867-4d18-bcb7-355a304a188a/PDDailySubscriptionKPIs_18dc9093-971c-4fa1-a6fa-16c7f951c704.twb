            <column-instance column='[Color - MTD Growth New Subscribers (copy)_687643432258850827]' derivation='User' name='[usr:Color - MTD Growth New Subscribers (copy)_687643432258850827:nk]' pivot='key' type='nominal' />
            <column-instance column='[Total Subscribers MTD  vs. PMTD (copy)_687643432258699274]' derivation='User' name='[usr:Total Subscribers MTD  vs. PMTD (copy)_687643432258699274:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <manual-sort column='[federated.0t0qnra0scoza111r7ctq0zofkzx (copy)].[none:Calculation_2906018043226947584:nk]' direction='ASC'>
