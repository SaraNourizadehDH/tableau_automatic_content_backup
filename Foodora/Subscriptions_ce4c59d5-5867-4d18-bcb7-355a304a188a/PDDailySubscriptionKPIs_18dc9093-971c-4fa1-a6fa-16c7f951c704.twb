      <aliases enabled='yes' />
      <column caption='Card Subscribers' datatype='integer' name='[Calculation_3771623962148311041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [is_current_subscriber] THEN [cash_card_users] ELSE 0 END +&#10;If [is_current_subscriber] THEN [card_users] ELSE 0 END +&#10;If [is_current_subscriber] THEN [cash_wallet_card_users] ELSE 0 END +&#10;If [is_current_subscriber] THEN [wallet_card_users] ELSE 0 END&#10;)' />
      </column>
      <column caption='Card Users' datatype='integer' name='[Calculation_3771623962148614146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cash_card_users]+[cash_wallet_card_users]+[wallet_card_users]+[card_users])' />
      </column>
