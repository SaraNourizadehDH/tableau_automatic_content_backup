    <worksheet name='% Order Contribution T7D Growth'>
      <table>
        <view>
          <datasources>
            <datasource caption='Subscription Performance' name='federated.09mi0qj0mcgdim18r56im05w0ob5' />
          </datasources>
          <datasource-dependencies datasource='federated.09mi0qj0mcgdim18r56im05w0ob5'>
            <column caption='17D Growth' datatype='integer' name='[Calculation_4464052437739151372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='T7D Growth %' />
              </aliases>
            </column>
            <column caption='T7D Growth Order Contribution' datatype='real' default-format='*▲ 0.00ppt;▼ 0.00ppt' name='[Calculation_4464052437760811041]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='([T7D Total Orders (copy)_4464052437758599197] - [T7D Order Contributions % (copy)_4464052437760069664])&#10;* 100' />
            </column>
            <column caption='Color - L7D Growth Order Contribution %' datatype='string' name='[Color - L7D Growth Total Orders (copy)_4464052437761462306]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([T7D Total Orders (copy)_4464052437758599197] - [T7D Order Contributions % (copy)_4464052437760069664])&#10;/&#10;[T7D Order Contributions % (copy)_4464052437760069664] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='Previous T7D Order Contributions %' datatype='real' name='[T7D Order Contributions % (copy)_4464052437760069664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([date]&gt;= now() - 15 and [date]&lt; now() - 8, [subscription_orders], 0))&#10;&#10; / &#10;&#10;SUM(iif([date]&gt;= now() - 15 and [date]&lt; now() - 8, [order_count], 0))' />
            </column>
            <column caption='T7D Orders Contribution %' datatype='real' name='[T7D Total Orders (copy)_4464052437758599197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([date]&gt;= now() - 8, [subscription_orders], 0))&#10;&#10; / &#10;&#10;SUM(iif([date]&gt;= now() - 8, [order_count], 0))' />
            </column>
