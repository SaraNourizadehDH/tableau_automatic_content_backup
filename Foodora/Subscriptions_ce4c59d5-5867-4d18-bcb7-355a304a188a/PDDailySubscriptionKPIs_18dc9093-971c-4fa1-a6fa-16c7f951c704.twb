    <worksheet name='GMV% Low Growth'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>Lowest Growth</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Subscription Performance' name='federated.09mi0qj0mcgdim18r56im05w0ob5' />
          </datasources>
          <datasource-dependencies datasource='federated.09mi0qj0mcgdim18r56im05w0ob5'>
            <column caption='Order Count LW Growth Ranking' datatype='real' name='[Calculation_192669667481686020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(&#10;IF SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END) &gt;= 0&#10;THEN &#10;   (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END)&#10;ELSE&#10;   (SUM(IF [is_yesterday] THEN [subscription_orders] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [subscription_orders] ELSE 0 END)&#10;END * 100, 2)' />
            </column>
            <column caption='Number of Records' datatype='integer' name='[Calculation_2037315926016372773]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='L7D &amp; Previous L7D' datatype='string' name='[Calculation_4464052437743263765]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [date] &lt;= NOW() - 1&#10;THEN &apos;L7D&apos;&#10;ELSEIF [date] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [date] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END' />
            </column>
            <column caption='INDEX' datatype='integer' name='[Calculation_4464052437749858327]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='L7D GMV% Growth' datatype='real' default-format='p0.0%' name='[MTD GMV% Growth (copy)_3641582512776957958]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;( SUM(IF [Calculation_4464052437743263765] = &quot;L7D&quot; THEN ([subscriber_gmv]) ELSE 0 END) / SUM(IF [Calculation_4464052437743263765] = &quot;L7D&quot; THEN ([gmv]) ELSE 0 END ))&#10;-&#10;(SUM(IF [Calculation_4464052437743263765] = &quot;Previous L7D&quot; THEN ([subscriber_gmv]) ELSE 0 END) / SUM(IF [Calculation_4464052437743263765] = &quot;Previous L7D&quot; THEN ([gmv]) ELSE 0 END ))&#10;) * 100' />
            </column>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[gmv]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_same_day_last_week]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2037315926016372773]' derivation='Min' name='[min:Calculation_2037315926016372773:qk]' pivot='key' type='quantitative' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[subscriber_gmv]' role='measure' type='quantitative' />
            <column datatype='integer' name='[subscription_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_192669667481686020]' derivation='User' name='[usr:Calculation_192669667481686020:qk]' pivot='key' type='quantitative' />
