  sub_enabled_wallet_users.pd_customer_uuid IS NOT NULL AS is_l1m_sub_enabled_wallet_user
FROM all_users
LEFT JOIN current_subscribers
       ON current_subscribers.customer_uuid = all_users.pd_customer_uuid
