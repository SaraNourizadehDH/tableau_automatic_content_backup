      <column caption='Previous T7D Total Orders' datatype='integer' name='[Calculation_4464052437737721864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([date] &gt;= now() - 15 AND [date] &lt; now() - 8, [subscription_orders], 0))' />
      </column>
      <column caption='L7D Growth Total Orders' datatype='string' name='[Calculation_4464052437738762250]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Calculation_4464052437736493063] - [Calculation_4464052437737721864]) / [Calculation_4464052437737721864] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(&#10;round(([Calculation_4464052437736493063] - [Calculation_4464052437737721864]) / [Calculation_4464052437737721864]*100,2)&#10;)' />
      </column>
      <column caption='Color - L7D Growth Total Orders' datatype='string' name='[Calculation_4464052437738958859]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Calculation_4464052437736493063] - [Calculation_4464052437737721864]) / [Calculation_4464052437737721864] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='17D Growth' datatype='integer' name='[Calculation_4464052437739151372]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
        <aliases>
          <alias key='1' value='T7D Growth %' />
        </aliases>
      </column>
      <column caption='MTD' datatype='boolean' name='[Calculation_4464052437740544014]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 0&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
      </column>
      <column caption='PMTD' datatype='boolean' name='[Calculation_4464052437740621839]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 1&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
      </column>
      <column caption='Total Orders MTD vs. PMTD' datatype='string' name='[Calculation_4464052437741006864]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_4464052437740544014], [subscription_orders], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_4464052437740621839], [subscription_orders], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_4464052437740621839], [subscription_orders], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([Calculation_4464052437740544014], [subscription_orders], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_4464052437740621839], [subscription_orders], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_4464052437740621839], [subscription_orders], 0)&#10;) * 100&#10;,2)&#10;)' />
      </column>
      <column caption='Color - MTD Growth Order Count' datatype='string' name='[Calculation_4464052437741191185]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_4464052437740544014], [subscription_orders], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_4464052437740621839], [subscription_orders], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_4464052437740621839], [subscription_orders], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
