    <datasource caption='Subscription Performance' inline='true' name='federated.09mi0qj0mcgdim18r56im05w0ob5' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0zyr2oy1lgvw2d1gjg1is1ka6b56'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='adam.arent@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
