          <datasource-dependencies datasource='federated.0t0qnra0scoza111r7ctq0zofkzx'>
            <column caption='Number of Records' datatype='integer' name='[Calculation_3021493178557628419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Total Subscribers LW Growth' datatype='string' name='[Calculation_3021493178883756045]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE 0 END) - SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END))&#10;/ SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;IF SUM(IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE 0 END) - SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END) &gt;= 0&#10;THEN &#10;   (SUM(IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE 0 END) - SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END))&#10;   / SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END)&#10;ELSE&#10;   (SUM(IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE 0 END) - SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END))&#10;   / SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END)&#10;END * 100, 2))' />
            </column>
            <column caption='Color - Total Subscribers LW Growth' datatype='string' name='[Calculation_3021493178887413775]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE 0 END) - SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END))&#10;/ SUM(IF [Calculation_743938370268401668] THEN [active_subscribers] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='INDEX' datatype='integer' name='[Calculation_3021493179170107425]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Ranking - LW Total Subscribers' datatype='real' name='[Calculation_3021493179170353186]' role='measure' type='quantitative'>
