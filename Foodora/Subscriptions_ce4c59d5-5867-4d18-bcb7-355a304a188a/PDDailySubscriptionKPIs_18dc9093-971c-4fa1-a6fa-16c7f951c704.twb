            <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
            <column caption='Payment Method' datatype='string' name='[payment_method]' role='dimension' type='nominal' />
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column caption='Signup Count 8 To 30D' datatype='integer' name='[signup_count_8_to_30d]' role='measure' type='quantitative' />
            <column caption='Signup Count More Than 30D' datatype='integer' name='[signup_count_more_than_30d]' role='measure' type='quantitative' />
            <column caption='Signup Count New Sub' datatype='integer' name='[signup_count_new_sub]' role='measure' type='quantitative' />
            <column caption='Signup Count Within 7D' datatype='integer' name='[signup_count_within_7d]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_743938370268053506]' derivation='Sum' name='[sum:Calculation_743938370268053506:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0t0qnra0scoza111r7ctq0zofkzx].[none:payment_method:nk]' filter-group='6'>
            <groupfilter expression='STARTSWITH(LOWER([payment_method]), LOWER(&apos;cart&apos;))' function='filter' user:ui-enumeration='inclusive' user:ui-pattern-include-all-when-empty='true' user:ui-pattern_text='cart' user:ui-pattern_type='starts-with'>
              <groupfilter function='level-members' level='[none:payment_method:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
