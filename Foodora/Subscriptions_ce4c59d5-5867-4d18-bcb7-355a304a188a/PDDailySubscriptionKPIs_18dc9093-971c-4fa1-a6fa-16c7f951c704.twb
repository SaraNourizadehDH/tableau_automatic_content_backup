    <worksheet name='Payments MTD Growth (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily Subs Revenue' name='federated.0t0qnra0scoza111r7ctq0zofkzx (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.0t0qnra0scoza111r7ctq0zofkzx (copy)'>
            <column caption='Country Name' datatype='string' name='[Calculation_2906018043226947584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [global_entity_id (regional_apac_subscriptions_daily_subscription_revenue)]&#10;WHEN &quot;FP_HK&quot; THEN &quot;Hong Kong&quot;&#10;WHEN &quot;FP_TW&quot; THEN &quot;Taiwan&quot;&#10;WHEN &quot;FP_PH&quot; THEN &quot;Philippines&quot;&#10;WHEN &quot;FP_MY&quot; THEN &quot;Malaysia&quot;&#10;WHEN &quot;FP_SG&quot; THEN &quot;Singapore&quot;&#10;WHEN &quot;FP_KH&quot; THEN &quot;Cambodia&quot;&#10;WHEN &quot;FP_BD&quot; THEN &quot;Bangladesh&quot;&#10;WHEN &quot;FP_PK&quot; THEN &quot;Pakistan&quot;&#10;WHEN &quot;FP_MM&quot; THEN &quot;Myanmar&quot;&#10;WHEN &quot;FP_TH&quot; THEN &quot;Thailand&quot;&#10;WHEN &quot;DJ_CZ&quot; THEN &quot;Czech Republic&quot;&#10;WHEN &quot;NP_HU&quot; THEN &quot;Hungary&quot;&#10;WHEN &quot;MJM_AT&quot; THEN &quot;Austria&quot;&#10;WHEN &quot;OP_SE&quot; THEN &quot;Sweden&quot;&#10;WHEN &quot;FO_NO&quot; THEN &quot;Norway&quot;&#10;WHEN &quot;PO_FI&quot; THEN &quot;Finland&quot;&#10;WHEN &quot;YS_TR&quot; THEN &quot;Turkey&quot;&#10;ELSE [global_entity_id (regional_apac_subscriptions_daily_subscription_revenue)]&#10;END' />
            </column>
            <column caption='MTD' datatype='boolean' name='[Calculation_3021493178918760472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 0&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_3021493178918862873]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 1&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[Calculation_3021493178919657498]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='Color - MTD Growth Payments' datatype='string' name='[Color - MTD Growth New Subscribers (copy)_687643432258850827]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_3021493178918760472], [daily_amortized_payment_eur], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_3021493178918862873], [daily_amortized_payment_eur], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_3021493178918862873], [daily_amortized_payment_eur], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='Payments MTD  vs. PMTD' datatype='string' name='[Total Subscribers MTD  vs. PMTD (copy)_687643432258699274]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_3021493178918760472], [daily_amortized_payment_eur], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_3021493178918862873], [daily_amortized_payment_eur], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_3021493178918862873], [daily_amortized_payment_eur], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([Calculation_3021493178918760472], [daily_amortized_payment_eur], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_3021493178918862873], [daily_amortized_payment_eur], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_3021493178918862873], [daily_amortized_payment_eur], 0)&#10;) * 100&#10;,2)&#10;)' />
            </column>
            <column caption='Daily Amortized Payment Eur' datatype='real' name='[daily_amortized_payment_eur]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Global Entity Id (Regional Apac Subscriptions Daily Subscription Revenue)' datatype='string' name='[global_entity_id (regional_apac_subscriptions_daily_subscription_revenue)]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2906018043226947584]' derivation='None' name='[none:Calculation_2906018043226947584:nk]' pivot='key' type='nominal' />
