    <worksheet name='% Churned Subscribers MTD Growth'>
      <table>
        <view>
          <datasources>
            <datasource caption='Subscribers Acquisition Churn' name='federated.0t0qnra0scoza111r7ctq0zofkzx' />
          </datasources>
          <datasource-dependencies datasource='federated.0t0qnra0scoza111r7ctq0zofkzx'>
            <column caption='MTD' datatype='boolean' name='[Calculation_3021493178918760472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date], today() - 1) = 0&#10;AND&#10;DAY([report_date]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_3021493178918862873]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date], today() - 1) = 1&#10;AND&#10;DAY([report_date]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[Calculation_3021493178919657498]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='MTD % Churned Subscribers' datatype='real' name='[Calculation_5368994490619645961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([Calculation_3021493178918760472],[Calculation_743938370275590154],0))&#10;/&#10;SUM(iif([Calculation_3021493178918760472], [daily_plans_ending],0))' />
            </column>
            <column caption='MTD vs. PMTD % Churned Subscribers' datatype='real' default-format='*▲ 0.0ppt;▼ 0.0ppt' name='[Calculation_5368994490619850763]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='([Calculation_5368994490619645961] - [MTD % Churned Subscribers (copy)_5368994490619772938])*100' />
            </column>
            <column caption='Churned subscribers' datatype='integer' name='[Calculation_743938370275590154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[daily_cancellation_count]+[daily_payment_fail_count]' />
            </column>
            <column caption='PMTD % Churned Subscribers' datatype='real' name='[MTD % Churned Subscribers (copy)_5368994490619772938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([Calculation_3021493178918862873],[Calculation_743938370275590154],0))&#10;/&#10;SUM(iif([Calculation_3021493178918862873], [daily_plans_ending],0))' />
            </column>
            <column caption='Color - MTD vs. PMTD % Churned Subscribers' datatype='string' name='[MTD vs. PMTD Churned Subscribers (copy)_5368994490620334092]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    [Calculation_5368994490619645961] - [MTD % Churned Subscribers (copy)_5368994490619772938]&#10;)&#10;&#10;/&#10;&#10;[MTD % Churned Subscribers (copy)_5368994490619772938] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Daily Cancellation Count' datatype='integer' name='[daily_cancellation_count]' role='measure' type='quantitative' />
            <column caption='Daily Payment Fail Count' datatype='integer' name='[daily_payment_fail_count]' role='measure' type='quantitative' />
            <column caption='Daily Plans Ending' datatype='integer' name='[daily_plans_ending]' role='measure' type='quantitative' />
