              <calculation class='tableau' formula='SUM(iif([Calculation_3021493178918760472], [Calculation_743938370275590154], 0))&#10;    &#10;/&#10;    SUM(iif([Calculation_3021493178918862873], [Calculation_743938370275590154], 0))&#10;    &#10;&#10;-1' />
