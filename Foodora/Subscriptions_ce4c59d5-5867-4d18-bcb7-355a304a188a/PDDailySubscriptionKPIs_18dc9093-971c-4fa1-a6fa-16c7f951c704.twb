            </column>
            <column caption='L1D LT Plan%' datatype='real' default-format='p0.0%' name='[T7D Churned from PF (copy)_5449777771076481040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_743938370266841088] AND [plan_duration] &lt;&gt; &quot;1M&quot;, [active_subscribers], 0))&#10;/&#10;SUM(IIF([Calculation_743938370266841088] , [active_subscribers], 0))' />
            </column>
