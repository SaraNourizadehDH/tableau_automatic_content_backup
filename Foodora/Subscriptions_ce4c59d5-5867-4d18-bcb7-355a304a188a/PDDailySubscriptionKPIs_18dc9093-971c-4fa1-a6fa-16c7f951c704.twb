        <calculation class='tableau' formula='IF (SUM(IF [Calculation_743938370266841088] THEN [Calculation_743938370275590154] ELSE 0 END) - SUM(IF [Calculation_743938370268401668] THEN [Calculation_743938370275590154] ELSE 0 END))&#10;/ SUM(IF [Calculation_743938370268401668] THEN [Calculation_743938370275590154] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
