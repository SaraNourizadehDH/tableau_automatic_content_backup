      <aliases enabled='yes' />
      <column caption='% New on LT Plan' datatype='real' name='[% Active on LT Plan (copy)_5449777771338498072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [plan_duration] &lt;&gt; &quot;1M&quot; THEN [Calculation_743938370268053506] ELSE 0 END )&#10;/&#10;SUM([Calculation_743938370268053506])' />
      </column>
      <column caption='% L1M (Active Subs)' datatype='real' name='[% L1M (copy)_6146217272597360640]' role='measure' type='quantitative'>
