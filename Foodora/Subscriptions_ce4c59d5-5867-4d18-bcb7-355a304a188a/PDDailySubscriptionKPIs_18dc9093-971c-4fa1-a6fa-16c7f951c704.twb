    <worksheet name='Exec Subs'>
      <table>
        <view>
          <datasources>
            <datasource caption='Subscribers Acquisition Churn' name='federated.0t0qnra0scoza111r7ctq0zofkzx' />
          </datasources>
          <datasource-dependencies datasource='federated.0t0qnra0scoza111r7ctq0zofkzx'>
            <column caption='Yesterday Subscribers' datatype='integer' name='[Calculation_3000171461621948423]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE 0 END' />
            </column>
            <column caption='placeholder' datatype='integer' name='[Calculation_3000171461622910984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
            <column caption='is_8d_ago' datatype='boolean' name='[Calculation_3000171461623435273]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] = TODAY() - 8' />
            </column>
            <column caption='Subscribers WoW' datatype='real' name='[Calculation_3000171461623533578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(   SUM(IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE NULL END)&#10;    /&#10;    SUM(IF [Calculation_3000171461623435273]  THEN [active_subscribers] ELSE NULL END)&#10;&#10;) -1&#10;&#10;)*100' />
            </column>
            <column caption='Subscribers WoW (-)' datatype='string' name='[Calculation_3000171461623676939]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;[Calculation_3000171461623533578] &lt;= 0&#10;then &apos;▼ &apos; &#10;+ STR(ROUND([Calculation_3000171461623533578],1))+&apos;%&apos;&#10;ELSE null&#10;end' />
            </column>
            <column caption='is_yesterday ' datatype='boolean' name='[Calculation_743938370266841088]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] = [last_run_date] - 1' />
            </column>
            <column caption='Subscribers WoW (+)' datatype='string' name='[Subscribers WoW (-) (copy)_3000171461623767052]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;[Calculation_3000171461623533578] &gt; 0&#10;then &apos;▲ &apos; &#10;+ STR(ROUND([Calculation_3000171461623533578],1))+&apos;%&apos;&#10;ELSE null&#10;end' />
