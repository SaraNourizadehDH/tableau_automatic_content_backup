      <column caption='T7D Total Orders' datatype='integer' name='[Calculation_4464052437736493063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([date] &gt;= now() - 8, [subscription_orders], 0))' />
