            <column datatype='integer' name='[subscription_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_4464052437760811041]' derivation='User' name='[usr:Calculation_4464052437760811041:ok]' pivot='key' type='ordinal' />
