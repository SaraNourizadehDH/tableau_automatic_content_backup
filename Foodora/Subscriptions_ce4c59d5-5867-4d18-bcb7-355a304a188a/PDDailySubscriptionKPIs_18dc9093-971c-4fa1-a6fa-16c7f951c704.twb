      <column caption='PF yesterday' datatype='real' name='[Calculation_1190850263249641472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_743938370266841088] THEN ([payment_failure_subscribers]) ELSE 0 END)&#10;    /&#10;    SUM(if [Calculation_743938370266841088] THEN [Calculation_743938370275590154]+[renewal_subscribers] ELSE 0 END )' />
      </column>
      <column caption='Ranking Churned Subscribers' datatype='integer' name='[Calculation_1299781119978463235]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([date] &gt;= NOW() - 8, [Calculation_743938370275590154], 0)' />
      </column>
      <column caption='% Churn from PF vs LW' datatype='real' default-format='*▲ 0.0;▼ 0.0' name='[Calculation_1865616214283468807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((&#10;    SUM(IF [Calculation_743938370266841088] THEN ([payment_failure_subscribers]) ELSE 0 END)&#10;    /&#10;    SUM(if [Calculation_743938370266841088] THEN [Calculation_743938370275590154]+[renewal_subscribers] ELSE 0 END )&#10;)&#10;&#10;/&#10;&#10;(&#10;    SUM(if [Calculation_743938370268401668] THEN [payment_failure_subscribers] ELSE 0 END)&#10;    /&#10;    SUM(if [Calculation_743938370268401668] THEN [Calculation_743938370275590154]+[renewal_subscribers] ELSE 0 END )&#10;)&#10;&#10;-1 ) *100' />
      </column>
      <column caption='T7D Growth Churn from PF' datatype='real' default-format='*▲ 0.0; ▼ 0.0' name='[Calculation_1865616214289985546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([T7D Churned Subscribers (copy)_1865616214286315528]/[T7D Churned from PF (copy)_1865616214289788937] -1) * 100' />
      </column>
      <column caption='Country Name' datatype='string' name='[Calculation_2906018043226947584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [global_entity_id (regional_apac_subscriptions_daily_subscription_revenue)]&#10;WHEN &quot;FP_HK&quot; THEN &quot;Hong Kong&quot;&#10;WHEN &quot;FP_TW&quot; THEN &quot;Taiwan&quot;&#10;WHEN &quot;FP_PH&quot; THEN &quot;Philippines&quot;&#10;WHEN &quot;FP_MY&quot; THEN &quot;Malaysia&quot;&#10;WHEN &quot;FP_SG&quot; THEN &quot;Singapore&quot;&#10;WHEN &quot;FP_KH&quot; THEN &quot;Cambodia&quot;&#10;WHEN &quot;FP_BD&quot; THEN &quot;Bangladesh&quot;&#10;WHEN &quot;FP_PK&quot; THEN &quot;Pakistan&quot;&#10;WHEN &quot;FP_MM&quot; THEN &quot;Myanmar&quot;&#10;WHEN &quot;FP_TH&quot; THEN &quot;Thailand&quot;&#10;WHEN &quot;DJ_CZ&quot; THEN &quot;Czech Republic&quot;&#10;WHEN &quot;NP_HU&quot; THEN &quot;Hungary&quot;&#10;WHEN &quot;MJM_AT&quot; THEN &quot;Austria&quot;&#10;WHEN &quot;OP_SE&quot; THEN &quot;Sweden&quot;&#10;WHEN &quot;FO_NO&quot; THEN &quot;Norway&quot;&#10;WHEN &quot;PO_FI&quot; THEN &quot;Finland&quot;&#10;WHEN &quot;YS_TR&quot; THEN &quot;Turkey&quot;&#10;ELSE [global_entity_id (regional_apac_subscriptions_daily_subscription_revenue)]&#10;END' />
      </column>
      <column caption='% Amortized Rev from Partnerships' datatype='real' default-format='p0.0%' name='[Calculation_2906018043227660289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([daily_amortized_partnership_revenue_eur])/SUM([daily_amortized_payment_incl_partnership_revenue_eur])' />
      </column>
      <column caption='1 % Revenue from Partnerships' datatype='string' name='[Calculation_2906018043228114946]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot; &quot;' />
        <aliases>
          <alias key='&quot; &quot;' value='L7D % from Partnerships' />
        </aliases>
      </column>
      <column caption='Yesterday Subscribers' datatype='integer' name='[Calculation_3000171461621948423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_743938370266841088] THEN [active_subscribers] ELSE 0 END' />
      </column>
      <column caption='placeholder' datatype='integer' name='[Calculation_3000171461622910984]' role='measure' type='quantitative'>
