        <calculation class='tableau' formula='SUM(IIF([Calculation_743938370266841088] AND [plan_duration] = &quot;3M&quot;, [active_subscribers], 0))&#10;/&#10;SUM(IIF([Calculation_743938370266841088] , [active_subscribers], 0))' />
