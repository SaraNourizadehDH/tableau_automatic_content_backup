      <column caption='% Pro Deals MTD' datatype='real' name='[Calculation_2037315925636894742]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([is_yesterday],[pro_vendor_count],0))&#10;/&#10;SUM(iif([is_yesterday], [total_vendors],0))' />
      </column>
      <column caption='MTD' datatype='boolean' name='[Calculation_2037315925637091351]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 0&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
      </column>
      <column caption='PMTD' datatype='boolean' name='[Calculation_2037315925637169176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date], today() - 1) = 1&#10;AND&#10;DAY([date]) &lt;= DAY(TODAY()-1)' />
      </column>
