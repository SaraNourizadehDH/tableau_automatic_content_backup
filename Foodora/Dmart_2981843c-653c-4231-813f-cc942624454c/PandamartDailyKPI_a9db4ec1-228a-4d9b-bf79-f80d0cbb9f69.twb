    <worksheet name='PandaMart - GMV per store (MTD)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141502953201774]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='MTD GMV Per Store Per Day Growth % (Indicator)' datatype='string' name='[MTD Order Per Store Per Day Growth % (Indicator) (copy)_3371999890451800064]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([Order Per Store Per Day By Country (MTD) (copy)_3371999890451800066]) - avg([Order Per Store Per Day By Country (PMTD) (copy)_3371999890451800067]))&#10;/&#10;avg([Order Per Store Per Day By Country (PMTD) (copy)_3371999890451800067]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='MTD GMV Per Store Per Day Growth %' datatype='string' name='[MTD Order Per Store Per Day Growth % (copy)_3371999890451800065]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([Order Per Store Per Day By Country (MTD) (copy)_3371999890451800066]) - avg([Order Per Store Per Day By Country (PMTD) (copy)_3371999890451800067]))&#10;/&#10;avg([Order Per Store Per Day By Country (PMTD) (copy)_3371999890451800067]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;(avg([Order Per Store Per Day By Country (MTD) (copy)_3371999890451800066]) - avg([Order Per Store Per Day By Country (PMTD) (copy)_3371999890451800067]))&#10;/&#10;avg([Order Per Store Per Day By Country (PMTD) (copy)_3371999890451800067])&#10;*100,2&#10;)&#10;)' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='GMV Per Store Per Day By Country (MTD)' datatype='real' name='[Order Per Store Per Day By Country (MTD) (copy)_3371999890451800066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([PMTD (copy)_128141502928715882],&#10;{FIXED [country_name],[vendor_type],[report_date_local]: sum([gfv_eur])}&#10;/ {FIXED [country_name],[vendor_type],[report_date_local]: sum([num_of_active_vendors])&#10;}&#10;,0&#10;)' />
            </column>
            <column caption='GMV Per Store Per Day By Country (PMTD)' datatype='real' name='[Order Per Store Per Day By Country (PMTD) (copy)_3371999890451800067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([Previous L30D (copy)_128141502928400489],&#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([gmv_eur])&#10;}&#10;&#10;/ &#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([num_of_active_vendors])&#10;}&#10;,0&#10;)' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date_local], today() - 1) = 0&#10;AND&#10;DAY([report_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Previous L30D (copy)_128141502928400489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date_local], today() - 1) = 1&#10;AND&#10;DAY([report_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='T7D GMV Per Store' datatype='real' name='[T7D Order Per Store (copy)_3371999890451800070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [gmv_eur], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_active_vendors], 0))' />
