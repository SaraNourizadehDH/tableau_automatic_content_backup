              <calculation class='tableau' formula='IF [WoW Orders per store (W1)  (copy)_4585157035307577362] = &apos;▲&apos; THEN &apos;Increase&apos; ELSE &apos;Decrease&apos; END' />
            </column>
            <column caption='WoW Orders per store (W1) Symbol Only' datatype='string' datatype-customized='true' name='[WoW Orders per store (W1)  (copy)_4585157035307577362]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_active_vendors] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_active_vendors] ELSE 0 END))&#10;- 100) &gt;= 0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='WoW Orders per store (W1) Value Only' datatype='real' datatype-customized='true' name='[WoW Orders per store (W1)  (copy)_4585157035307687955]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='round((SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_active_vendors] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_active_vendors] ELSE 0 END))&#10;- 100,1)' />
            </column>
            <column caption='WoW Orders per store (W1) Negative' datatype='string' datatype-customized='true' name='[WoW Orders per store (W1) Symbol Only (copy)_4585157035308023828]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [WoW Orders per store (W1)  (copy)_4585157035307577362] = &apos;▼&apos; THEN [WoW Orders (W1) (copy)_277675072081944584]+&apos;%&apos; ELSE NULL END' />
            </column>
