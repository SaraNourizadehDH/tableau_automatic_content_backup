            <column caption='WoW Orders per store (W1)' datatype='string' datatype-customized='true' name='[WoW Orders (W1) (copy)_277675072081944584]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[WoW Orders per store (W1)  (copy)_4585157035307577362]&#10;+ &apos; &apos; &#10;+ str([WoW Orders per store (W1)  (copy)_4585157035307687955])' />
            </column>
