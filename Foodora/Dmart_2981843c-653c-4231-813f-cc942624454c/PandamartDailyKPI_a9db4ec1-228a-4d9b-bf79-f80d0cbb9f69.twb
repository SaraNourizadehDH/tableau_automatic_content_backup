      </column>
      <column caption='Orders MTD vs PMTD' datatype='string' name='[Calculation_128141502929027179]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([PMTD (copy)_128141502928715882], [num_of_valid_orders], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Previous L30D (copy)_128141502928400489], [num_of_valid_orders], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Previous L30D (copy)_128141502928400489], [num_of_valid_orders], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([PMTD (copy)_128141502928715882], [num_of_valid_orders], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Previous L30D (copy)_128141502928400489], [num_of_valid_orders], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Previous L30D (copy)_128141502928400489], [num_of_valid_orders], 0)&#10;) * 100&#10;,2)&#10;)' />
      </column>
      <column caption='is_d-1' datatype='string' hidden='true' name='[Calculation_133982140139909123]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_58898640418394127] != 1 THEN &quot;False&quot; else &quot;True&quot; END' />
      </column>
      <column aggregation='Sum' caption='d-2' datatype='integer' name='[Calculation_133982140145025029]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [report_date_local]&#13;&#10;     WHEN today()-2 THEN 1 else 0 end' />
      </column>
      <column aggregation='Sum' caption='d-9' datatype='integer' name='[Calculation_133982140146204678]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [report_date_local]&#13;&#10;     WHEN today()-9 THEN 1 else 0 end' />
      </column>
      <column caption='Weighted Availability' datatype='real' name='[Calculation_139048683022270464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([wa_numerator])/SUM([wa_denominator])' />
