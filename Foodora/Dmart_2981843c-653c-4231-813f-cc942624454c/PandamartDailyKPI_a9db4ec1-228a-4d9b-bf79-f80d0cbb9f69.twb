            <column caption='T7D % &gt;45 Delivery Time' datatype='real' name='[T7D % Magical Orders (copy)_3081025137546936330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_lg_orders_above_45], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_successful_nonpreorder_orders], 0))' />
