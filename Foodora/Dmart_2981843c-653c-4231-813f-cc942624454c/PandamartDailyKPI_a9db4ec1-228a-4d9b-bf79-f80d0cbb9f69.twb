              <calculation class='tableau' formula='if&#10;([T7D Order Per Store (copy)_2913336400860614664] - [T7D % Total Orders (Prev L7D) (copy)_6630354184322428932])/ [T7D % Total Orders (Prev L7D) (copy)_6630354184322428932] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(&#10;round(([T7D Order Per Store (copy)_2913336400860614664] - [T7D % Total Orders (Prev L7D) (copy)_6630354184322428932]) / [T7D % Total Orders (Prev L7D) (copy)_6630354184322428932]*100,2)&#10;)' />
            </column>
            <column caption='T7D % Total GMV' datatype='real' name='[T7D Order Per Store (copy)_2913336400860614664]' role='measure' type='quantitative'>
