            <column caption='% of GMV color code' datatype='integer' name='[% of Orders color code (copy)_6630354184317607937]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='if ([% of total orders (copy)_6630354184317353984] - [L7 % of Total Orders AVG (copy)_6630354184317829122]) / [L7 % of Total Orders AVG (copy)_6630354184317829122] &gt;= 0.2 then 2&#10;elseif ([% of total orders (copy)_6630354184317353984] - [L7 % of Total Orders AVG (copy)_6630354184317829122]) / [L7 % of Total Orders AVG (copy)_6630354184317829122] &lt;= -0.2 then -2&#10;elseif ([% of total orders (copy)_6630354184317353984] - [L7 % of Total Orders AVG (copy)_6630354184317829122]) / [L7 % of Total Orders AVG (copy)_6630354184317829122] &lt;= -0.1 then -1&#10;elseif ([% of total orders (copy)_6630354184317353984] - [L7 % of Total Orders AVG (copy)_6630354184317829122]) / [L7 % of Total Orders AVG (copy)_6630354184317829122] &gt;= 0.1 then 1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% of total GMV' datatype='real' name='[% of total orders (copy)_6630354184317353984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur]) / SUM({fixed[country_name],[report_date_local] : sum([gmv_eur])})' />
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
