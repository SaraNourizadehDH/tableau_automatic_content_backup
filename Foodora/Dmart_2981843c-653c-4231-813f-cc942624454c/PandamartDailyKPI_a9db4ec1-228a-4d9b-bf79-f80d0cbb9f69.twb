            <column caption='Seamless Fulfilled Orders color code' datatype='integer' name='[Partially Fulfilled Orders color code (copy)_92746032746446868]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='if ([Partially Fulfilled Orders (copy)_92746032662851584] - [L7 Partially Fulfilled Orders AVG (copy)_92746032745811970]) / [L7 Partially Fulfilled Orders AVG (copy)_92746032745811970] &gt;= 0.2 then 2&#10;elseif ([Partially Fulfilled Orders (copy)_92746032662851584] - [L7 Partially Fulfilled Orders AVG (copy)_92746032745811970]) / [L7 Partially Fulfilled Orders AVG (copy)_92746032745811970]  &lt;= -0.2 then -2&#10;elseif ([Partially Fulfilled Orders (copy)_92746032662851584] - [L7 Partially Fulfilled Orders AVG (copy)_92746032745811970]) / [L7 Partially Fulfilled Orders AVG (copy)_92746032745811970] &lt;= -0.1 then -1&#10;elseif ([Partially Fulfilled Orders (copy)_92746032662851584] - [L7 Partially Fulfilled Orders AVG (copy)_92746032745811970]) / [L7 Partially Fulfilled Orders AVG (copy)_92746032745811970]  &gt;= 0.1 then 1&#10;else 0&#10;end'>
