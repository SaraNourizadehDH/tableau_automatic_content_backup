    <worksheet name='PandaMart - GMV per store Growth (W1)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column aggregation='Sum' caption='w-1' datatype='integer' name='[Calculation_58898640406446086]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [report_date_local]&#10;     WHEN today()-8 THEN 1 else 0 end' />
            </column>
            <column aggregation='Sum' caption='d-1' datatype='integer' name='[Calculation_58898640418394127]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [report_date_local]&#10;     WHEN today()-1 THEN 1 else 0 end' />
            </column>
            <column aggregation='Sum' caption='1' datatype='integer' name='[Calculation_58898640425685014]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='WoW Growth %' />
              </aliases>
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='T7D GMV Per Store' datatype='real' name='[T7D Order Per Store (copy)_3371999890451800070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [gmv_eur], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_active_vendors], 0))' />
            </column>
            <column caption='WoW GMV per store (W1) Symbol Only' datatype='string' datatype-customized='true' name='[WoW GMV per store (W1) (copy)_4585157035311304729]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [gmv_eur] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_active_vendors] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [gmv_eur] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_active_vendors] ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='WoW GMV per store (W1) Value Only' datatype='real' datatype-customized='true' name='[WoW GMV per store (W1) (copy)_4585157035311620122]' role='measure' type='ordinal'>
