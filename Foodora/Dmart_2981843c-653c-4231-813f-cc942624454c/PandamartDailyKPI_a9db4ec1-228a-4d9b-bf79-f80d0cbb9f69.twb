            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='T7D % Total GMV' datatype='real' name='[T7D Order Per Store (copy)_2913336400860614664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [gmv_eur], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, {fixed[country_name],[report_date_local] : sum([gmv_eur])}, 0))' />
            </column>
            <column caption='WoW % of total orders (W1) Symbol Only' datatype='string' datatype-customized='true' name='[WoW % of total orders (W1) (copy)_4585157035334119463]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN {fixed[country_name],[report_date_local] : sum([num_of_valid_orders])} ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN {fixed[country_name],[report_date_local] : sum([num_of_valid_orders])} ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='WoW % of total orders (W1) Value Only' datatype='real' datatype-customized='true' name='[WoW % of total orders (W1) (copy)_4585157035334287400]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='round((SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN {fixed[country_name],[report_date_local] : sum([num_of_valid_orders])} ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN {fixed[country_name],[report_date_local] : sum([num_of_valid_orders])} ELSE 0 END))&#10;- 100,1)' />
            </column>
            <column caption='WoW % of total orders (W1)' datatype='string' datatype-customized='true' name='[WoW % of total orders (W2) (copy)_277675072041586693]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[WoW % of total orders (W1) (copy)_4585157035334119463]&#10;+ &apos; &apos; &#10;+ str([WoW % of total orders (W1) (copy)_4585157035334287400])' />
            </column>
            <column caption='WoW % of total orders (W1) Indicator' datatype='string' datatype-customized='true' name='[WoW % of total orders (W2) Indicator (copy)_277675072041586694]' role='measure' type='nominal'>
