            <column caption='WoW DF (chargeback) (W1)' datatype='string' datatype-customized='true' name='[WoW DF (W1) (copy)_450641504340320258]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_58898640418394127] = 1 THEN [delivery_fee_incl_chargeback_eur] ELSE 0 END) / &#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#10;*100.0 / &#10;((SUM(IF [Calculation_58898640406446086] = 1 THEN [delivery_fee_incl_chargeback_eur] ELSE 0 END) /&#10;(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)))&#10;)-100)&#10;&#10;&gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos; &#10;&#10;+ str(round(&#10;(SUM(IF [Calculation_58898640418394127] = 1 THEN [delivery_fee_incl_chargeback_eur] ELSE 0 END) / &#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#10;*100.0 / &#10;((SUM(IF [Calculation_58898640406446086] = 1 THEN [delivery_fee_incl_chargeback_eur] ELSE 0 END) /&#10;(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)))&#10;)-100&#10;,1))' />
            </column>
            <column caption='WoW DF (chargeback) (W1) Growth' datatype='real' datatype-customized='true' name='[WoW DF (W1) Growth (copy)_450641504340402179]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='round(&#10;(SUM(IF [Calculation_58898640418394127] = 1 THEN [delivery_fee_incl_chargeback_eur] ELSE 0 END) / &#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#10;*100.0 / &#10;((SUM(IF [Calculation_58898640406446086] = 1 THEN [delivery_fee_incl_chargeback_eur] ELSE 0 END) /&#10;(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)))&#10;)-100&#10;,1)' />
            </column>
            <column caption='WoW DF (chargeback) (W1) Indicator' datatype='string' datatype-customized='true' name='[WoW DF (W1) Indicator (copy)_450641504340414468]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_58898640418394127] = 1 THEN [delivery_fee_incl_chargeback_eur] ELSE 0 END) / &#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#10;*100.0 / &#10;((SUM(IF [Calculation_58898640406446086] = 1 THEN [delivery_fee_incl_chargeback_eur] ELSE 0 END) /&#10;(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)))&#10;)-100)&#10;&#10;&gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
