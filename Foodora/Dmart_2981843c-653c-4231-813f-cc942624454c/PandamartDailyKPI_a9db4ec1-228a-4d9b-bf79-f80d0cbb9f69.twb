    <worksheet name='PM - Partially Fulfilled Orders % (MTD)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141502953201774]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='MTD Partially Fulfilled Orders Growth % (Indicator)' datatype='string' name='[MTD Magical Order Growth % (Indicator) (copy)_2004875903011713032]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([Magical Order % Per Day By Country (MTD) (copy)_2004875903011090439]) - avg([Magical Order % Per Day By Country (PMTD) (copy)_2004875903011090438]))&#10;/&#10;avg([Magical Order % Per Day By Country (PMTD) (copy)_2004875903011090438]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='MTD Partially Fulfilled Orders Growth %' datatype='string' name='[MTD Magical Order Growth % (copy)_2004875903011012613]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([Magical Order % Per Day By Country (MTD) (copy)_2004875903011090439]) - avg([Magical Order % Per Day By Country (PMTD) (copy)_2004875903011090438]))&#10;/&#10;avg([Magical Order % Per Day By Country (PMTD) (copy)_2004875903011090438]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;(avg([Magical Order % Per Day By Country (MTD) (copy)_2004875903011090439]) - avg([Magical Order % Per Day By Country (PMTD) (copy)_2004875903011090438]))&#10;/&#10;avg([Magical Order % Per Day By Country (PMTD) (copy)_2004875903011090438]) &#10;*100,2&#10;)&#10;)' />
            </column>
            <column caption='Partially Fulfilled Orders % Per Day By Country (MTD)' datatype='real' name='[Magical Order % Per Day By Country (MTD) (copy)_2004875903011090439]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([PMTD (copy)_128141502928715882],&#10;1&#10;-&#10;&#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([num_of_partially_fulfilled_orders])&#10;}&#10;&#10;/ &#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([num_of_valid_orders])&#10;}&#10;,0&#10;)' />
            </column>
            <column caption='Partially Fulfilled Orders % Per Day By Country (PMTD)' datatype='real' name='[Magical Order % Per Day By Country (PMTD) (copy)_2004875903011090438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([Previous L30D (copy)_128141502928400489],&#10;1&#10;-&#10;&#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([num_of_partially_fulfilled_orders])&#10;}&#10;&#10;/ &#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([num_of_valid_orders])&#10;}&#10;,0&#10;)' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
