            <column caption='Yesterday&apos;s Seamless Fulfilled Orders Main' datatype='real' name='[Yesterday&apos;s GMV Main (copy)_45739685137494026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([Calculation_58898640418394127]=1, [num_of_seamless_fulfilled_orders], null)) / sum(iif([Calculation_58898640418394127]=1, [num_of_valid_orders],null))' />
