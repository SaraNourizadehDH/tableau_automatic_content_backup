              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_valid_orders], 0))' />
            </column>
            <column caption='Orders MTD vs PMTD' datatype='string' name='[Calculation_128141502929027179]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([PMTD (copy)_128141502928715882], [num_of_valid_orders], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Previous L30D (copy)_128141502928400489], [num_of_valid_orders], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Previous L30D (copy)_128141502928400489], [num_of_valid_orders], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([PMTD (copy)_128141502928715882], [num_of_valid_orders], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Previous L30D (copy)_128141502928400489], [num_of_valid_orders], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Previous L30D (copy)_128141502928400489], [num_of_valid_orders], 0)&#10;) * 100&#10;,2)&#10;)' />
            </column>
