            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0k7p4ya0h1m5vb10pew4e1jfm7ji].[Action (2,Country)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action2]' user:ui-enumeration='all' user:ui-marker='enumerate'>
