            </column>
            <column caption='T7D mCVR4' datatype='real' name='[T7D mCVR2 (copy)_468937369424977962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= {FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)} - 6, [checkout_and_transact_sessions], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= {FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)} - 6, [checkout_sessions], 0))' />
            </column>
