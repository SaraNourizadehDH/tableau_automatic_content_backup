            <column-instance column='[report_date_local]' derivation='Day-Trunc' name='[tdy:report_date_local:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Exec: AFV (Average line) (copy)_861313449361018891]' derivation='User' name='[usr:Exec: AFV (Average line) (copy)_861313449361018891:nk]' pivot='key' type='nominal' />
            <column-instance column='[valid_orders_per_store (copy)_3371999890454192142]' derivation='User' name='[usr:valid_orders_per_store (copy)_3371999890454192142:qk]' pivot='key' type='quantitative' />
