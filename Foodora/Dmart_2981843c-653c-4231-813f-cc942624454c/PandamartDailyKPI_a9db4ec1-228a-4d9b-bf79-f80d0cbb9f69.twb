            <column caption='MTD Seamless Fulfilled Orders Growth % (Indicator)' datatype='string' name='[MTD Partially Fulfilled Orders Growth % (Indicator) (copy)_92746032745914372]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([Partially Fulfilled Orders % Per Day By Country (MTD) (copy)_92746032745943045]) - avg([Partially Fulfilled Orders % Per Day By Country (PMTD) (copy)_92746032745955334]))&#10;/&#10;avg([Partially Fulfilled Orders % Per Day By Country (PMTD) (copy)_92746032745955334]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='MTD Seamless Fulfilled Orders Growth %' datatype='string' name='[MTD Partially Fulfilled Orders Growth % (copy)_92746032745902083]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([Partially Fulfilled Orders % Per Day By Country (MTD) (copy)_92746032745943045]) - avg([Partially Fulfilled Orders % Per Day By Country (PMTD) (copy)_92746032745955334]))&#10;/&#10;avg([Partially Fulfilled Orders % Per Day By Country (PMTD) (copy)_92746032745955334]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;(avg([Partially Fulfilled Orders % Per Day By Country (MTD) (copy)_92746032745943045]) - avg([Partially Fulfilled Orders % Per Day By Country (PMTD) (copy)_92746032745955334]))&#10;/&#10;avg([Partially Fulfilled Orders % Per Day By Country (PMTD) (copy)_92746032745955334]) &#10;*100,2&#10;)&#10;)' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date_local], today() - 1) = 0&#10;AND&#10;DAY([report_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='Seamless Fulfilled Orders % Per Day By Country (MTD)' datatype='real' name='[Partially Fulfilled Orders % Per Day By Country (MTD) (copy)_92746032745943045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([PMTD (copy)_128141502928715882],&#10;1&#10;-&#10;&#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([num_of_seamless_fulfilled_orders])&#10;}&#10;&#10;/ &#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([num_of_valid_orders])&#10;}&#10;,0&#10;)' />
            </column>
            <column caption='Seamless Fulfilled Orders % Per Day By Country (PMTD)' datatype='real' name='[Partially Fulfilled Orders % Per Day By Country (PMTD) (copy)_92746032745955334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([Previous L30D (copy)_128141502928400489],&#10;1&#10;-&#10;&#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([num_of_seamless_fulfilled_orders])&#10;}&#10;&#10;/ &#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([num_of_valid_orders])&#10;}&#10;,0&#10;)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Previous L30D (copy)_128141502928400489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date_local], today() - 1) = 1&#10;AND&#10;DAY([report_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='T7D % Seamless Fulfilled Orders' datatype='real' name='[T7D % Partially Fulfilled Orders (copy)_92746032745979912]' role='measure' type='quantitative'>
