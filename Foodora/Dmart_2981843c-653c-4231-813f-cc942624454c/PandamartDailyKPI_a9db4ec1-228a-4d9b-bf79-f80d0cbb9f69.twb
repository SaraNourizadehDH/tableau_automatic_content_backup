              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='Average Delivery Time (PMTD)' datatype='real' name='[Average Delivery Time (MTD) (copy)_2913336401047507029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([Previous L30D (copy)_128141502928400489],&#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([delivery_time_non_preorder])&#10;}&#10;&#10;/ &#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([num_of_non_preorders])&#10;}&#10;/ 60.0&#10;,0&#10;)' />
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='MTD Avg Delivery Time Growth %' datatype='string' name='[MTD % Order Contribution Growth % (copy)_2913336401047572566]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([Magical Order % Per Day By Country (MTD) (copy)_2913336401047306324]) - avg([Average Delivery Time (MTD) (copy)_2913336401047507029]))&#10;/&#10;avg([Average Delivery Time (MTD) (copy)_2913336401047507029]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;(avg([Magical Order % Per Day By Country (MTD) (copy)_2913336401047306324]) - avg([Average Delivery Time (MTD) (copy)_2913336401047507029]))&#10;/&#10;avg([Average Delivery Time (MTD) (copy)_2913336401047507029]) &#10;*100,2&#10;)&#10;)' />
            </column>
