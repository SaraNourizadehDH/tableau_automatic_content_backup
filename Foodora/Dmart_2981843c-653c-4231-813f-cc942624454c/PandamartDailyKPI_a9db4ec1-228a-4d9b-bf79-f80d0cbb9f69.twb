          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Avg Basket Size - GFV (€)' datatype='real' name='[Calculation_967218450116943873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gfv_eur])/sum([num_of_valid_orders])' />
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='L7 Avg Basket Size AVG' datatype='real' name='[L7 Orders Per Store AVG (copy)_1650991491446259723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(([Calculation_967218450116943873]), first(), first()+7)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Average Basket Size color code' datatype='integer' name='[Orders Per Store color code (copy)_1650991491446099978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([Calculation_967218450116943873] - [L7 Orders Per Store AVG (copy)_1650991491446259723]) / [L7 Orders Per Store AVG (copy)_1650991491446259723] &gt;= 0.1 then 2&#10;elseif ([Calculation_967218450116943873] - [L7 Orders Per Store AVG (copy)_1650991491446259723]) / [L7 Orders Per Store AVG (copy)_1650991491446259723] &lt;= -0.1 then -2&#10;elseif ([Calculation_967218450116943873] - [L7 Orders Per Store AVG (copy)_1650991491446259723]) / [L7 Orders Per Store AVG (copy)_1650991491446259723] &lt;= -0.05 then -1&#10;elseif ([Calculation_967218450116943873] - [L7 Orders Per Store AVG (copy)_1650991491446259723]) / [L7 Orders Per Store AVG (copy)_1650991491446259723] &gt;= 0.05 then 1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='T7D Avg Basket Size' datatype='real' name='[T7D % Total Orders (copy)_2913336400862162957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [gfv_eur], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_valid_orders], 0))' />
            </column>
