            <column-instance column='[T7D Avg DFPO (copy)_182677324001636362]' derivation='User' name='[usr:T7D Avg DFPO (copy)_182677324001636362:qk]' pivot='key' type='quantitative' />
            <column-instance column='[WoW DF (W1) (copy)_182677324001148935]' derivation='User' name='[usr:WoW DF (W1) (copy)_182677324001148935:nk]' pivot='key' type='nominal' />
            <column-instance column='[WoW DF (W1) Indicator (copy)_182677324001402889]' derivation='User' name='[usr:WoW DF (W1) Indicator (copy)_182677324001402889:nk]' pivot='key' type='nominal' />
