            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column caption='is_past_7_days (mkt incentive cost)' datatype='boolean' name='[is_past_7_days (d-3) (copy)_172121948630102020]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local]&gt;= {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} - 6' />
            </column>
            <column-instance column='[Global Entity Id (copy)_5424515436352962560]' derivation='None' name='[none:Global Entity Id (copy)_5424515436352962560:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_past_7_days (d-3) (copy)_172121948630102020]' derivation='None' name='[none:is_past_7_days (d-3) (copy)_172121948630102020:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column caption='Report Date Local' datatype='date' name='[report_date_local]' role='dimension' type='ordinal' />
            <column-instance column='[Subsidy per Voucher (copy)_5158591907037593600]' derivation='User' name='[usr:Subsidy per Voucher (copy)_5158591907037593600:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0k7p4ya0h1m5vb10pew4e1jfm7ji].[Action (2,Country)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action5]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Calculation_58898640433270810]' />
              <groupfilter function='level-members' level='[none:country_name:nk]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0k7p4ya0h1m5vb10pew4e1jfm7ji].[none:is_past_7_days (d-3) (copy)_172121948630102020:nk]'>
