              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_valid_orders_w_vouchers], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_valid_orders], 0))' />
