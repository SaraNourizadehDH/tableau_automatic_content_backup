              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 15 AND [report_date_local] &lt; now() - 8, [num_of_seamless_fulfilled_orders], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 15 AND [report_date_local] &lt; now() - 8, [num_of_valid_orders], 0))' />
            </column>
            <column caption='T7D % Seamless Fulfilled Orders' datatype='real' name='[T7D % Partially Fulfilled Orders (copy)_92746032745979912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_seamless_fulfilled_orders], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_valid_orders], 0))' />
            </column>
            <column caption='T7D % Seamless Fulfilled Orders Growth % (Indicator)' datatype='string' name='[T7D % Partially Fulfilled Orders Growth % (Indicator) (copy)_92746032745979913]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([T7D % Partially Fulfilled Orders (copy)_92746032745979912] - [T7D % Partially Fulfilled Orders (Prev L7D) (copy)_92746032745979911]) / [T7D % Partially Fulfilled Orders (Prev L7D) (copy)_92746032745979911] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='T7D % Seamless Fulfilled Orders Growth %' datatype='string' name='[T7D % Partially Fulfilled Orders Growth % (copy)_92746032745979914]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([T7D % Partially Fulfilled Orders (copy)_92746032745979912] - [T7D % Partially Fulfilled Orders (Prev L7D) (copy)_92746032745979911]) / [T7D % Partially Fulfilled Orders (Prev L7D) (copy)_92746032745979911] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(&#10;round(([T7D % Partially Fulfilled Orders (copy)_92746032745979912] - [T7D % Partially Fulfilled Orders (Prev L7D) (copy)_92746032745979911]) / [T7D % Partially Fulfilled Orders (Prev L7D) (copy)_92746032745979911] *100,2)&#10;)' />
