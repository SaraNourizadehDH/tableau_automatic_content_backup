              <calculation class='tableau' formula='if ([Calculation_277675072037953537] - [L7 Orders Per Store AVG (copy)_1650991491438178311]) / [L7 Orders Per Store AVG (copy)_1650991491438178311] &gt;= 0.2 then 2&#10;elseif ([Calculation_277675072037953537] - [L7 Orders Per Store AVG (copy)_1650991491438178311]) / [L7 Orders Per Store AVG (copy)_1650991491438178311] &lt;= -0.2 then -2&#10;elseif ([Calculation_277675072037953537] - [L7 Orders Per Store AVG (copy)_1650991491438178311]) / [L7 Orders Per Store AVG (copy)_1650991491438178311] &lt;= -0.1 then -1&#10;elseif ([Calculation_277675072037953537] - [L7 Orders Per Store AVG (copy)_1650991491438178311]) / [L7 Orders Per Store AVG (copy)_1650991491438178311] &gt;= 0.1 then 1&#10;else 0&#10;end'>
