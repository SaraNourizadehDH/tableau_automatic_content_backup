    <worksheet name='PandaMart - Service Fee Growth (W1)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column aggregation='Sum' caption='w-1' datatype='integer' name='[Calculation_58898640406446086]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [report_date_local]&#10;     WHEN today()-8 THEN 1 else 0 end' />
            </column>
            <column aggregation='Sum' caption='d-1' datatype='integer' name='[Calculation_58898640418394127]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [report_date_local]&#10;     WHEN today()-1 THEN 1 else 0 end' />
            </column>
            <column aggregation='Sum' caption='1' datatype='integer' name='[Calculation_58898640425685014]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='WoW Growth %' />
              </aliases>
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='T7D Avg Service Fee Per Order' datatype='real' name='[T7D Avg DFPO (copy)_182677324001636362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [service_fee_eur], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_valid_orders], 0))' />
            </column>
            <column caption='WoW Service Fee Per Order (W1)' datatype='string' datatype-customized='true' name='[WoW DF (W1) (copy)_182677324001148935]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (ZN(&#10;(SUM(IF [Calculation_58898640418394127] = 1 THEN [service_fee_eur] ELSE 0 END) / &#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#10;*100.0 / &#10;((SUM(IF [Calculation_58898640406446086] = 1 THEN [service_fee_eur] ELSE 0 END) /&#10;(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)))&#10;)-100))&#10;&#10;&gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos; &#10;&#10;+ str(round(ZN(&#10;(SUM(IF [Calculation_58898640418394127] = 1 THEN [service_fee_eur] ELSE 0 END) / &#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#10;*100.0 / &#10;((SUM(IF [Calculation_58898640406446086] = 1 THEN [service_fee_eur] ELSE 0 END) /&#10;(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)))&#10;)-100&#10;),1))' />
            </column>
            <column caption='WoW Service Fee Per Order (W1) Indicator' datatype='string' datatype-customized='true' name='[WoW DF (W1) Indicator (copy)_182677324001402889]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (ZN(&#10;(SUM(IF [Calculation_58898640418394127] = 1 THEN [service_fee_eur] ELSE 0 END) / &#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#10;*100.0 / &#10;((SUM(IF [Calculation_58898640406446086] = 1 THEN [service_fee_eur] ELSE 0 END) /&#10;(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)))&#10;)-100))&#10;&#10;&gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_58898640425685014]' derivation='None' name='[none:Calculation_58898640425685014:ok]' pivot='key' type='ordinal' />
