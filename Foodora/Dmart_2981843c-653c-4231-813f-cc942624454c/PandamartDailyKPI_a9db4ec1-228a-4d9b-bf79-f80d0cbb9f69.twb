              <calculation class='tableau' formula='IF AVG([Exec: GMV Per Day Per Store (Average line) (copy)_4585157035342475317]) &gt; [% of total orders (copy)_6630354184317353984] THEN &quot;Below&quot;&#10;ELSE &quot;Above&quot;&#10;END' />
