    <worksheet name='PandaMart - Daily Chart mCVR4'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column caption='DayOfWeek' datatype='string' name='[Calculation_1893693317791571972]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [report_date_local])' />
            </column>
            <column caption='mCVR4' datatype='real' name='[Calculation_468937369333915650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkout_and_transact_sessions])/SUM([checkout_sessions])' />
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Day (Similar Scale) (d-3)' datatype='datetime' name='[Day (Similar Scale) (copy)_649362823320608768]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [report_date_local] &lt;= {FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)} - 7&#13;&#10;THEN DATEADD(&apos;day&apos;, 7, [report_date_local])&#13;&#10;ELSE [report_date_local]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='L7D &amp; Previous L7D (d-3)' datatype='string' name='[L7D &amp; Previous L7D (copy)_133982140155396106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date_local] &gt;= {FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)} - 6 AND [report_date_local] &lt;= {FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)}&#10;THEN &apos;L7D&apos;&#10;ELSEIF [report_date_local] &gt;= {FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)} - 13 AND [report_date_local] &lt;= {FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)} - 7&#10;THEN &apos;Previous L7D&apos;&#10;END' />
            </column>
            <column-instance column='[Calculation_1893693317791571972]' derivation='Attribute' name='[attr:Calculation_1893693317791571972:nk]' pivot='key' type='nominal' />
            <column caption='Checkout And Transact Sessions' datatype='integer' name='[checkout_and_transact_sessions]' role='measure' type='quantitative' />
