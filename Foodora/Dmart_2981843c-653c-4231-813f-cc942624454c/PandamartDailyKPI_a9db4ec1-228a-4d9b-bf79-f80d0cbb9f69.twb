    <worksheet name='PandaMart - Delivery Time Growth (W1)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column aggregation='Sum' caption='w-1' datatype='integer' name='[Calculation_58898640406446086]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [report_date_local]&#10;     WHEN today()-8 THEN 1 else 0 end' />
            </column>
            <column aggregation='Sum' caption='d-1' datatype='integer' name='[Calculation_58898640418394127]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [report_date_local]&#10;     WHEN today()-1 THEN 1 else 0 end' />
            </column>
            <column aggregation='Sum' caption='1' datatype='integer' name='[Calculation_58898640425685014]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='WoW Growth %' />
              </aliases>
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='T7D Avg Delivery Time' datatype='real' name='[T7D Avg Basket Size (copy)_2913336400866361372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [delivery_time_non_preorder], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_non_preorders], 0))&#10;/ 60.0' />
            </column>
            <column caption='WoW Delivery Time (W1) Indicator ' datatype='string' datatype-customized='true' name='[WoW Delivery Time (copy)_58898640423903253]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [delivery_time_non_preorder] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_non_preorders] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [delivery_time_non_preorder] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_non_preorders] ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;Increase&apos; ELSE &apos;Decrease&apos; END' />
            </column>
            <column caption='WoW Delivery Time (W1)' datatype='string' datatype-customized='true' name='[WoW Orders (copy 2)_58898640422678548]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [delivery_time_non_preorder] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_non_preorders] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [delivery_time_non_preorder] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_non_preorders] ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos; &#10;+ str(round((SUM(IF [Calculation_58898640418394127] = 1 THEN [delivery_time_non_preorder] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_non_preorders] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [delivery_time_non_preorder] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_non_preorders] ELSE 0 END))&#10;- 100,1))' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Time Non Preorder' datatype='integer' name='[delivery_time_non_preorder]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
