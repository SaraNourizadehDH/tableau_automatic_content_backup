    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Metric Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APPandamartDailyKPI/MetricDefinitions?rev=' id='MetricDefinitions' path='/t/Foodora/workbooks/APPandamartDailyKPI' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_8' value='top' />
        </style-rule>
      </style>
      <size maxheight='500' maxwidth='1200' minheight='500' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='96800' id='3' param='vert' type-v2='layout-flow' w='98666' x='667' y='1600'>
            <zone h='8000' id='5' param='vert' type-v2='layout-flow' w='98666' x='667' y='1600'>
              <zone fixed-size='32' forceUpdate='true' h='8000' id='6' is-fixed='true' type-v2='text' w='98666' x='667' y='1600'>
                <formatted-text>
                  <run bold='true' fontcolor='#ffffff' fontsize='18'>Definitions</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#d70f64' />
                </zone-style>
              </zone>
            </zone>
            <zone forceUpdate='true' h='78400' id='8' type-v2='text' w='98666' x='667' y='9600'>
              <formatted-text>
                <run bold='true' fontcolor='#333333' fontsize='8'>GMV: </run>
                <run fontcolor='#333333' fontsize='8'>Gross Merchandise Value, or the amount paid by customers for their orders. This is GFV + Delivery Fee + Service Fee + Difference to MOV + Packaging Fee - Voucher - Discount. In Euro currency.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>GMV Per Day Per Store:</run>
                <run fontcolor='#333333' fontsize='8'> GMV / Days / Number of Active Vendors (determined through pandora vendor portal)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Orders:</run>
                <run fontcolor='#333333' fontsize='8'> Number of Valid Orders</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Orders Per Day Per Store:</run>
                <run fontcolor='#333333' fontsize='8'> Valid Orders / Days / Number of Active Vendors (determined through pandora vendor portal)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>New Customers: </run>
                <run fontcolor='#333333' fontsize='8'>Customers who made their first pandamart order</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Existing Customers:</run>
                <run fontcolor='#333333' fontsize='8'> Customers who had previous orders with pandamart</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Order Contribution: </run>
                <run fontcolor='#333333' fontsize='8'>Pandamart Valid Orders / Platform Valid Orders</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>GMV Contribution:</run>
                <run fontcolor='#333333' fontsize='8'> Pandamart GMV / Platform GMV</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Average Basket Size:</run>
                <run fontcolor='#333333' fontsize='8'> GFV / Valid Orders</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Delivery Fees (Incl Chargeback) Per Order:</run>
                <run fontcolor='#333333' fontsize='8'> Total Delivery Fees + Pandapro Chargeback / Valid Orders</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Service Fee Per Order: </run>
                <run fontcolor='#333333' fontsize='8'>Total Service Fees / Valid Orders</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Partially Fulfilled Orders %: </run>
                <run fontcolor='#333333' fontsize='8'><![CDATA[Percentage of valid orders with delivered quantity < ordered quantity]]></run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Seamless Fulfilled Orders %: </run>
                <run fontcolor='#333333' fontsize='8'>Percentage of valid orders which are partially fulfilled or had refund/compensation</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Weighted Availability: </run>
                <run fontcolor='#333333' fontsize='8'>Availability of SKUs weighted by forecasted sales and warehouse sessions (calculated by central)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Fail Rate %: </run>
                <run fontcolor='#333333' fontsize='8'>Failed Orders / Gross Orders</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Vendor Fail Rate %: </run>
                <run fontcolor='#333333' fontsize='8'>Failed Orders due to Vendor / Gross Orders</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>% &gt;45 DT: </run>
                <run fontcolor='#333333' fontsize='8'>Percentage of delivered orders with delivery time &gt; 45 minutes</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Average Delivery Time: </run>
                <run fontcolor='#333333' fontsize='8'>Average delivery time of delivered orders</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Voucher Orders %:</run>
                <run fontcolor='#333333' fontsize='8'> Percentga of valid orders with vouchers applied</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>iCPGMV %:</run>
                <run fontcolor='#333333' fontsize='8'> Total voucher value subsidised by marketing / GMV</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>Reorder Rate 30D: </run>
                <run fontcolor='#333333' fontsize='8'>Customers who ordered 30 days ago and reordered within 1-30 days of their order / Customers who ordered 30 days ago</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>mCVR2:</run>
                <run fontcolor='#333333' fontsize='8'> Sessions which visited pandamart menu page / Sessions which visited shops listing page</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>mCVR3: </run>
                <run fontcolor='#333333' fontsize='8'>Sessions which visited checkout page / Sessions which visited pandamart menu page</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='8'>mCVR4:</run>
                <run fontcolor='#333333' fontsize='8'> Sessions which made a transaction / Sessions which visited checkout page</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='50' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='49' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone fixed-size='32' forceUpdate='true' h='8000' id='6' type-v2='text' w='98666' x='667' y='1600'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontsize='18'>Definitions</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#d70f64' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='78400' id='8' type-v2='text' w='98666' x='667' y='9600'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333' fontsize='8'>GMV: </run>
                    <run fontcolor='#333333' fontsize='8'>Gross Merchandise Value, or the amount paid by customers for their orders. This is GFV + Delivery Fee + Service Fee + Difference to MOV + Packaging Fee - Voucher - Discount. In Euro currency.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>GMV Per Day Per Store:</run>
                    <run fontcolor='#333333' fontsize='8'> GMV / Days / Number of Active Vendors (determined through pandora vendor portal)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Orders:</run>
                    <run fontcolor='#333333' fontsize='8'> Number of Valid Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Orders Per Day Per Store:</run>
                    <run fontcolor='#333333' fontsize='8'> Valid Orders / Days / Number of Active Vendors (determined through pandora vendor portal)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>New Customers: </run>
                    <run fontcolor='#333333' fontsize='8'>Customers who made their first pandamart order</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Existing Customers:</run>
                    <run fontcolor='#333333' fontsize='8'> Customers who had previous orders with pandamart</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Order Contribution: </run>
                    <run fontcolor='#333333' fontsize='8'>Pandamart Valid Orders / Platform Valid Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>GMV Contribution:</run>
                    <run fontcolor='#333333' fontsize='8'> Pandamart GMV / Platform GMV</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Average Basket Size:</run>
                    <run fontcolor='#333333' fontsize='8'> GFV / Valid Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Delivery Fees (Incl Chargeback) Per Order:</run>
                    <run fontcolor='#333333' fontsize='8'> Total Delivery Fees + Pandapro Chargeback / Valid Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Service Fee Per Order: </run>
                    <run fontcolor='#333333' fontsize='8'>Total Service Fees / Valid Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Partially Fulfilled Orders %: </run>
                    <run fontcolor='#333333' fontsize='8'><![CDATA[Percentage of valid orders with delivered quantity < ordered quantity]]></run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Seamless Fulfilled Orders %: </run>
                    <run fontcolor='#333333' fontsize='8'>Percentage of valid orders which are partially fulfilled or had refund/compensation</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Weighted Availability: </run>
                    <run fontcolor='#333333' fontsize='8'>Availability of SKUs weighted by forecasted sales and warehouse sessions (calculated by central)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Fail Rate %: </run>
                    <run fontcolor='#333333' fontsize='8'>Failed Orders / Gross Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Vendor Fail Rate %: </run>
                    <run fontcolor='#333333' fontsize='8'>Failed Orders due to Vendor / Gross Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>% &gt;45 DT: </run>
                    <run fontcolor='#333333' fontsize='8'>Percentage of delivered orders with delivery time &gt; 45 minutes</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Average Delivery Time: </run>
                    <run fontcolor='#333333' fontsize='8'>Average delivery time of delivered orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Voucher Orders %:</run>
                    <run fontcolor='#333333' fontsize='8'> Percentga of valid orders with vouchers applied</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>iCPGMV %:</run>
                    <run fontcolor='#333333' fontsize='8'> Total voucher value subsidised by marketing / GMV</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Reorder Rate 30D: </run>
                    <run fontcolor='#333333' fontsize='8'>Customers who ordered 30 days ago and reordered within 1-30 days of their order / Customers who ordered 30 days ago</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>mCVR2:</run>
                    <run fontcolor='#333333' fontsize='8'> Sessions which visited pandamart menu page / Sessions which visited shops listing page</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>mCVR3: </run>
                    <run fontcolor='#333333' fontsize='8'>Sessions which visited checkout page / Sessions which visited pandamart menu page</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>mCVR4:</run>
                    <run fontcolor='#333333' fontsize='8'> Sessions which made a transaction / Sessions which visited checkout page</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
