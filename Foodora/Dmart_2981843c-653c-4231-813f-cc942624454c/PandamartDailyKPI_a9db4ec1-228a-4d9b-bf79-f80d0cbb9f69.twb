    <worksheet name='PandaMart - Existing Customers Growth (MTD)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141502953201774]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Existing Customers (PMTD)' datatype='integer' name='[Existing Customers (MTD) (copy)_2913336401066934368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([Previous L30D (copy)_128141502928400489],&#10;{FIXED [country_name],[vendor_type], [report_date_local]: SUM([num_of_existing_customers])}&#10;,0&#10;)' />
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='MTD Existing Customers Growth %(Indicator)' datatype='string' name='[MTD Existing Customers Growth % (copy)_2913336401067749476]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([New Customers (MTD) (copy)_2913336401066811487]) - avg([Existing Customers (MTD) (copy)_2913336401066934368]))&#10;/&#10;avg([Existing Customers (MTD) (copy)_2913336401066934368])  &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='MTD Existing Customers Growth %' datatype='string' name='[MTD New Customers Growth % (copy)_2913336401067561059]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([New Customers (MTD) (copy)_2913336401066811487]) - avg([Existing Customers (MTD) (copy)_2913336401066934368]))&#10;/&#10;avg([Existing Customers (MTD) (copy)_2913336401066934368])  &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;(avg([New Customers (MTD) (copy)_2913336401066811487]) - avg([Existing Customers (MTD) (copy)_2913336401066934368]))&#10;/&#10;avg([Existing Customers (MTD) (copy)_2913336401066934368])&#10;*100,2&#10;)&#10;)' />
            </column>
            <column caption='Existing Customers (MTD)' datatype='integer' name='[New Customers (MTD) (copy)_2913336401066811487]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([PMTD (copy)_128141502928715882],&#10;{FIXED [country_name],[vendor_type], [report_date_local]: SUM([num_of_existing_customers])}&#10;,0&#10;)' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date_local], today() - 1) = 0&#10;AND&#10;DAY([report_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Previous L30D (copy)_128141502928400489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date_local], today() - 1) = 1&#10;AND&#10;DAY([report_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='T7D Existing Customers' datatype='integer' name='[T7D New Customers (copy)_2913336400874586160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_existing_customers], 0))' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Number of Records]' derivation='Min' name='[min:Number of Records:qk]' pivot='key' type='quantitative' />
