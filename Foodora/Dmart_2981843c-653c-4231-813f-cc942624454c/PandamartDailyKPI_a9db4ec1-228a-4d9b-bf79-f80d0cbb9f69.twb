            <column caption='L7 Partially Fulfilled Orders AVG' datatype='real' name='[L7 Magicals Order AVG (copy)_2004875903012093962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(([Magical Orders (copy)_2004875903008292864]), first(), first()+7)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Partially Fulfilled Orders' datatype='real' default-format='p0.00%' name='[Magical Orders (copy)_2004875903008292864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_partially_fulfilled_orders]) / SUM([num_of_valid_orders])' />
            </column>
            <column caption='Partially Fulfilled Orders color code' datatype='integer' name='[Magical Orders color code (copy)_2004875903012032521]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='if [Magical Orders (copy)_2004875903008292864] &gt;= 0.95 then 2 &#10;elseif ([Magical Orders (copy)_2004875903008292864] - [L7 Magicals Order AVG (copy)_2004875903012093962]) / [L7 Magicals Order AVG (copy)_2004875903012093962] &gt;= 0.2 then 2&#10;elseif ([Magical Orders (copy)_2004875903008292864] - [L7 Magicals Order AVG (copy)_2004875903012093962]) / [L7 Magicals Order AVG (copy)_2004875903012093962]  &lt;= -0.1 then -2&#10;elseif ([Magical Orders (copy)_2004875903008292864] - [L7 Magicals Order AVG (copy)_2004875903012093962]) / [L7 Magicals Order AVG (copy)_2004875903012093962] &lt;= -0.05 then -1&#10;elseif ([Magical Orders (copy)_2004875903008292864] - [L7 Magicals Order AVG (copy)_2004875903012093962]) / [L7 Magicals Order AVG (copy)_2004875903012093962]  &gt;= 0.1 then 1&#10;ELSEIF  [Magical Orders (copy)_2004875903008292864] &gt;= 0.80 then 1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='T7D % Partially Fulfilled Orders' datatype='real' name='[T7D % Magical Orders (copy)_2004875903009390595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_partially_fulfilled_orders], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_valid_orders], 0))' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
