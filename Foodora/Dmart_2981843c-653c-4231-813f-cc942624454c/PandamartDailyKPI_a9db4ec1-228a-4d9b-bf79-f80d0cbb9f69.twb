    <worksheet name='PandaMart - DF Growth (MTD)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141502953201774]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_557250104596926464]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([report_date_local])} -1' />
            </column>
            <column caption='Latest Month' datatype='date' name='[Calculation_557250104597061633]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [Calculation_557250104596926464]))' />
            </column>
            <column caption='Previous Month' datatype='date' name='[Calculation_557250104597192706]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, -1, [Calculation_557250104597061633]))' />
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='MTD Delivery Fees Growth % (Indicator)' datatype='string' name='[MTD Existing Customers Growth %(Indicator) (copy)_252834936420429827]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Valid Orders (MTD) (copy)_252834936419409922]-[Valid Orders (Previous MTD) (copy)_252834936419409920])&#10;/ [Valid Orders (Previous MTD) (copy)_252834936419409920] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='T7D Avg DFPO' datatype='real' name='[T7D % Total GMV (copy)_252834936420720645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [delivery_fee_eur], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_valid_orders], 0))' />
            </column>
            <column caption='Delivery Fees Per Order (MTD)' datatype='real' name='[Valid Orders (MTD) (copy)_252834936419409922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF &#10;DATETRUNC(&apos;month&apos;, [report_date_local]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date_local]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;([delivery_fee_eur]) END)&#10;&#10;/ SUM(IF &#10;DATETRUNC(&apos;month&apos;, [report_date_local]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date_local]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;([num_of_valid_orders]) END)' />
            </column>
            <column caption='Delivery Fees Per Order (Previous MTD)' datatype='real' name='[Valid Orders (Previous MTD) (copy)_252834936419409920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF &#10;DATETRUNC(&apos;month&apos;, [report_date_local]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date_local]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;[delivery_fee_eur]&#10;END)&#10;/&#10;sum(IF &#10;DATETRUNC(&apos;month&apos;, [report_date_local]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date_local]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;[num_of_valid_orders]&#10;END)' />
            </column>
            <column caption='MTD Delivery Fees Growth %' datatype='string' name='[Valid Orders MoM% (copy)_252834936419409921]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;[Valid Orders (MTD) (copy)_252834936419409922] - [Valid Orders (Previous MTD) (copy)_252834936419409920] )&#10;/ [Valid Orders (Previous MTD) (copy)_252834936419409920]&#10; &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;([Valid Orders (MTD) (copy)_252834936419409922] - [Valid Orders (Previous MTD) (copy)_252834936419409920])&#10;/ [Valid Orders (Previous MTD) (copy)_252834936419409920]&#10;*100, 2))' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Fee Eur' datatype='real' name='[delivery_fee_eur]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Number of Records]' derivation='Min' name='[min:Number of Records:qk]' pivot='key' type='quantitative' />
            <column-instance column='[1 T7D Growth (copy)_128141502953201774]' derivation='None' name='[none:1 T7D Growth (copy)_128141502953201774:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Global Entity Id (copy)_5424515436352962560]' derivation='None' name='[none:Global Entity Id (copy)_5424515436352962560:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column caption='Num Of Valid Orders' datatype='integer' name='[num_of_valid_orders]' role='measure' type='quantitative' />
            <column caption='Report Date Local' datatype='date' name='[report_date_local]' role='dimension' type='ordinal' />
            <column-instance column='[MTD Existing Customers Growth %(Indicator) (copy)_252834936420429827]' derivation='User' name='[usr:MTD Existing Customers Growth %(Indicator) (copy)_252834936420429827:nk]' pivot='key' type='nominal' />
            <column-instance column='[T7D % Total GMV (copy)_252834936420720645]' derivation='User' name='[usr:T7D % Total GMV (copy)_252834936420720645:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Valid Orders MoM% (copy)_252834936419409921]' derivation='User' name='[usr:Valid Orders MoM% (copy)_252834936419409921:nk]' pivot='key' type='nominal' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
