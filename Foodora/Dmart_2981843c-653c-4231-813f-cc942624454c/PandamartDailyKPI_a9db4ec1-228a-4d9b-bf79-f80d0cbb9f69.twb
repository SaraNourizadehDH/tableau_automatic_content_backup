              <calculation class='tableau' formula='IF [WoW Orders per store (W1)  (copy)_4585157035307577362] = &apos;▲&apos; THEN [WoW Orders (W1) (copy)_277675072081944584]+&apos;%&apos; ELSE NULL END' />
