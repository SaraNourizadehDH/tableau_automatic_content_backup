    <worksheet name='PandaMart - Service Fee Growth (MTD)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141502953201774]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_557250104596926464]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([report_date_local])} -1' />
            </column>
            <column caption='Latest Month' datatype='date' name='[Calculation_557250104597061633]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [Calculation_557250104596926464]))' />
            </column>
            <column caption='Previous Month' datatype='date' name='[Calculation_557250104597192706]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, -1, [Calculation_557250104597061633]))' />
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Service Fee Per Order (MTD)' datatype='real' name='[Delivery Fees Per Order (MTD) (copy)_182677323999408129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF &#10;DATETRUNC(&apos;month&apos;, [report_date_local]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date_local]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;([service_fee_eur]) END)&#10;&#10;/ SUM(IF &#10;DATETRUNC(&apos;month&apos;, [report_date_local]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597061633])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date_local]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;([num_of_valid_orders]) END)' />
            </column>
            <column caption='Service Fee Per Order (Previous MTD)' datatype='real' name='[Delivery Fees Per Order (Previous MTD) (copy)_182677323999567874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF &#10;DATETRUNC(&apos;month&apos;, [report_date_local]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date_local]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;[service_fee_eur]&#10;END)&#10;/&#10;sum(IF &#10;DATETRUNC(&apos;month&apos;, [report_date_local]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date_local]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;[num_of_valid_orders]&#10;END)' />
            </column>
            <column caption='Service Fee Per Order MoM%' datatype='string' name='[Delivery Fees Per Order MoM% (copy)_182677323999703043]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ZN((&#10;[Delivery Fees Per Order (MTD) (copy)_182677323999408129] - [Delivery Fees Per Order (Previous MTD) (copy)_182677323999567874] )&#10;/ [Delivery Fees Per Order (Previous MTD) (copy)_182677323999567874])&#10; &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(ZN(&#10;([Delivery Fees Per Order (MTD) (copy)_182677323999408129] - [Delivery Fees Per Order (Previous MTD) (copy)_182677323999567874])&#10;/ [Delivery Fees Per Order (Previous MTD) (copy)_182677323999567874]&#10;*100), 2))' />
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
