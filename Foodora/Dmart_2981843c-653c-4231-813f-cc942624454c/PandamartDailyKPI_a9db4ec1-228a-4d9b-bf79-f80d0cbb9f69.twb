    <worksheet name='PandaMart - Daily Delivery Fees'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column caption='Average DF color code' datatype='integer' name='[Average Basket Size color code (copy)_252834936424034315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([Calculation_408701670334345219] - [L7 Order AVG (copy)_252834936424095756]) / [L7 Order AVG (copy)_252834936424095756] &gt;= 0.1 then 2&#10;elseif ([Calculation_408701670334345219] - [L7 Order AVG (copy)_252834936424095756]) / [L7 Order AVG (copy)_252834936424095756] &lt;= -0.1 then -2&#10;elseif ([Calculation_408701670334345219] - [L7 Order AVG (copy)_252834936424095756]) / [L7 Order AVG (copy)_252834936424095756] &lt;= -0.05 then -1&#10;elseif ([Calculation_408701670334345219] - [L7 Order AVG (copy)_252834936424095756]) / [L7 Order AVG (copy)_252834936424095756] &gt;= 0.05 then 1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='DFPO' datatype='real' name='[Calculation_408701670334345219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_fee_eur]) / sum([num_of_valid_orders])' />
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='L7 DFPO AVG' datatype='real' name='[L7 Order AVG (copy)_252834936424095756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG([Calculation_408701670334345219], first(), first()+7)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='T7D Avg DFPO' datatype='real' name='[T7D % Total GMV (copy)_252834936420720645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [delivery_fee_eur], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_valid_orders], 0))' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Fee Eur' datatype='real' name='[delivery_fee_eur]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
