            <column-instance column='[Calculation_935059924758257668]' derivation='User' name='[usr:Calculation_935059924758257668:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_935059924758618117]' derivation='User' name='[usr:Calculation_935059924758618117:nk]' pivot='key' type='nominal' />
            <column-instance column='[T7D % Magical Orders (copy)_2913336400870944806]' derivation='User' name='[usr:T7D % Magical Orders (copy)_2913336400870944806:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='w-1 (mkt incentive cost)' datatype='integer' name='[w-1 (d-3) (copy)_172121948635004937]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [report_date_local] = {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} -7&#10;THEN 1 else 0 end' />
