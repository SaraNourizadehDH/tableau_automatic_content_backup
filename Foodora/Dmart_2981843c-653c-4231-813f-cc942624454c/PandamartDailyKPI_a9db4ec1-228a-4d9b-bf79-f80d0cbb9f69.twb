            <column caption='Num Of Orders' datatype='integer' name='[num_of_orders]' role='measure' type='quantitative' />
            <column caption='Report Date Local' datatype='date' name='[report_date_local]' role='dimension' type='ordinal' />
            <column-instance column='[T7D Fail Rate (copy)_325314760588853251]' derivation='User' name='[usr:T7D Fail Rate (copy)_325314760588853251:qk]' pivot='key' type='quantitative' />
            <column-instance column='[WoW Fail Rate (W1)  (copy)_325314760593072138]' derivation='User' name='[usr:WoW Fail Rate (W1)  (copy)_325314760593072138:nk]' pivot='key' type='nominal' />
