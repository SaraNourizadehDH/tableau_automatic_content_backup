              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [nc_30d_ago_reorder] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [nc_30d_ago] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [nc_30d_ago_reorder] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [nc_30d_ago] ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos; &#10;+ str(round((SUM(IF [Calculation_58898640418394127] = 1 THEN [nc_30d_ago_reorder] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [nc_30d_ago] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [nc_30d_ago_reorder] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [nc_30d_ago] ELSE 0 END))&#10;- 100,1))' />
            </column>
