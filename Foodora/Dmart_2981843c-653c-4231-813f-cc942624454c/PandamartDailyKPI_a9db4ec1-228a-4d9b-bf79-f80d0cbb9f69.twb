            <column-instance column='[MTD Delivery Fees Growth % (Indicator) (copy)_450641504341696518]' derivation='User' name='[usr:MTD Delivery Fees Growth % (Indicator) (copy)_450641504341696518:nk]' pivot='key' type='nominal' />
