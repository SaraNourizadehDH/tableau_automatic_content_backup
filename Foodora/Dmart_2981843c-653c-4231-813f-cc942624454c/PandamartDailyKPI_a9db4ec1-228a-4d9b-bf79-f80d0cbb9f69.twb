              <calculation class='tableau' formula='if&#10;([T7D mCVR2 (copy)_468937369424977962] - [T7D mCVR2 (Prev L7D) (copy)_468937369424994347]) / [T7D mCVR2 (Prev L7D) (copy)_468937369424994347] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
