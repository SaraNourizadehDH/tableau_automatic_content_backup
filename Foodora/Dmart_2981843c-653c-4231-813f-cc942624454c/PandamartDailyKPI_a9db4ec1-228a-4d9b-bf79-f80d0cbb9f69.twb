            <column aggregation='Sum' caption='1 T7D Growth %' datatype='integer' name='[1 T7D (copy)_2913336400861532172]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='T7D Growth %' />
              </aliases>
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
