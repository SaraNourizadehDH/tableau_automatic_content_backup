    <worksheet name='PandaMart - Daily % of total orders'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column caption='% of total orders' datatype='real' name='[Calculation_277675072037953537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_valid_orders]) / SUM({fixed[country_name],[report_date_local] : sum([num_of_valid_orders])})' />
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='L7 % of Total Orders AVG' datatype='real' name='[L7 Orders Per Store AVG (copy)_1650991491438178311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(([Calculation_277675072037953537]), first(), first()+7)'>
                <table-calc ordering-type='Rows' />
