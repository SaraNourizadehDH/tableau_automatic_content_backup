              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='T7D Weighted Availability' datatype='real' default-format='p0.0%' name='[T7D SWA  (copy)_139048683029815303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [wa_numerator], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, [wa_denominator], 0))' />
            </column>
            <column caption='WoW Weighted Availability (W1)' datatype='string' datatype-customized='true' name='[WoW SWA (W1) (copy)_139048683030462476]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [wa_numerator] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [wa_denominator] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [wa_numerator] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [wa_denominator] ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos; &#10;+ str(round(((SUM(IF [Calculation_58898640418394127] = 1 THEN [wa_numerator] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [wa_denominator] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [wa_numerator] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [wa_denominator] ELSE 0 END)))&#10;- 100,1))' />
            </column>
            <column caption='WoW Weighted Availability (W1) Indicator' datatype='string' datatype-customized='true' name='[WoW SWA (W1) Indicator (copy)_139048683030683661]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [wa_numerator] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [wa_denominator] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [wa_numerator] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [wa_denominator] ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;Increase&apos; ELSE &apos;Decrease&apos; END' />
            </column>
