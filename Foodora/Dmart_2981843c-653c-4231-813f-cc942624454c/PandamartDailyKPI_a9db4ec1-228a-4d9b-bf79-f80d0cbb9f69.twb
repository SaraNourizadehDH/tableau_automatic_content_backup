            <column caption='Num Of Valid Orders' datatype='integer' name='[num_of_valid_orders]' role='measure' type='quantitative' />
            <column caption='Report Date Local' datatype='date' name='[report_date_local]' role='dimension' type='ordinal' />
            <column caption='Total Orders With Issues' datatype='integer' name='[total_orders_with_issues]' role='measure' type='quantitative' />
            <column-instance column='[T7D % Total Orders (copy)_2913336400863445010]' derivation='User' name='[usr:T7D % Total Orders (copy)_2913336400863445010:qk]' pivot='key' type='quantitative' />
            <column-instance column='[WoW Fail Rate (W1)  (copy)_6016457324310409218]' derivation='User' name='[usr:WoW Fail Rate (W1)  (copy)_6016457324310409218:nk]' pivot='key' type='nominal' />
            <column-instance column='[WoW Fail Rate (W1) Indicator (copy)_6016457324310724611]' derivation='User' name='[usr:WoW Fail Rate (W1) Indicator (copy)_6016457324310724611:nk]' pivot='key' type='nominal' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0k7p4ya0h1m5vb10pew4e1jfm7ji].[Action (2,Country)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action2]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Calculation_58898640433270810]' />
              <groupfilter function='level-members' level='[none:country_name:nk]' />
            </groupfilter>
          </filter>
