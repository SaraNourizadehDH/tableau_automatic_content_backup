    <worksheet name='PandaMart - Daily Delivery Fees (chargeback)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column caption='Average DF (chargeback) color code' datatype='integer' name='[Average DF color code (copy)_450641504343179277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([DFPO (copy)_450641504337813504] - [L7 DFPO AVG (copy)_450641504343388174]) / [L7 DFPO AVG (copy)_450641504343388174] &gt;= 0.1 then 2&#10;elseif ([DFPO (copy)_450641504337813504] - [L7 DFPO AVG (copy)_450641504343388174]) / [L7 DFPO AVG (copy)_450641504343388174] &lt;= -0.1 then -2&#10;elseif ([DFPO (copy)_450641504337813504] - [L7 DFPO AVG (copy)_450641504343388174]) / [L7 DFPO AVG (copy)_450641504343388174] &lt;= -0.05 then -1&#10;elseif ([DFPO (copy)_450641504337813504] - [L7 DFPO AVG (copy)_450641504343388174]) / [L7 DFPO AVG (copy)_450641504343388174] &gt;= 0.05 then 1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='DFPO (chargeback)' datatype='real' name='[DFPO (copy)_450641504337813504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_fee_incl_chargeback_eur]) / sum([num_of_valid_orders])' />
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
