        <calculation class='tableau' formula='if&#10;(&#10;    [Calculation_3081025137537183748] - [Calculation_3081025137537327109]&#10;)&#10;&#10;/&#10;&#10;[Calculation_3081025137537327109] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='Delivery Time &gt;=45mins MTD vs PMTD ' datatype='string' name='[Calculation_3081025137537052675]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    [Calculation_3081025137537183748] - [Calculation_3081025137537327109]&#10;)&#10;&#10;/&#10;&#10;[Calculation_3081025137537327109] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    [Calculation_3081025137537183748] - [Calculation_3081025137537327109]&#10;)&#10;&#10;/&#10;&#10;[Calculation_3081025137537327109] * 100&#10;,2)&#10;)' />
      </column>
      <column caption='Delivery Time &gt;=45mins Per Day By Country (MTD)' datatype='real' name='[Calculation_3081025137537183748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([PMTD (copy)_128141502928715882],[num_of_lg_orders_above_45],0))&#10;/&#10;SUM(iif([PMTD (copy)_128141502928715882],[num_of_successful_nonpreorder_orders],0))' />
      </column>
