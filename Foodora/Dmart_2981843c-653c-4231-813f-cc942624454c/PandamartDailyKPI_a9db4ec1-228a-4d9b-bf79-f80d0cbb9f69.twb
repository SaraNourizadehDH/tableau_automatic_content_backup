    <worksheet name='Pandamart - Daily Chart Voucher Spend as % GMV'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column caption='DayOfWeek' datatype='string' name='[Calculation_1893693317791571972]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [report_date_local])' />
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Day (Similar Scale) (mkt incentive cost)' datatype='datetime' name='[Day (Similar Scale) (d-3) (copy)_172121948630806534]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [report_date_local] &lt;= {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} - 7&#13;&#10;THEN DATEADD(&apos;day&apos;, 7, [report_date_local])&#13;&#10;ELSE [report_date_local]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='L7D &amp; Previous L7D (mkt incentive cost)' datatype='string' name='[L7D &amp; Previous L7D (d-3) (copy)_172121948630425605]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date_local] &gt;= {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} - 6 AND [report_date_local] &lt;= {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)}&#10;THEN &apos;L7D&apos;&#10;ELSEIF [report_date_local] &gt;= {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} - 13 AND [report_date_local] &lt;= {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} - 7&#10;THEN &apos;Previous L7D&apos;&#10;END' />
            </column>
            <column caption='Voucher Spend % of GMV' datatype='real' name='[Subsidy per Voucher (copy)_5158591907037593600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fp_voucher_value_eur])/sum([gmv_eur])' />
            </column>
            <column-instance column='[Calculation_1893693317791571972]' derivation='Attribute' name='[attr:Calculation_1893693317791571972:nk]' pivot='key' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Fp Voucher Value Eur' datatype='real' name='[fp_voucher_value_eur]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[Global Entity Id (copy)_5424515436352962560]' derivation='None' name='[none:Global Entity Id (copy)_5424515436352962560:nk]' pivot='key' type='nominal' />
            <column-instance column='[L7D &amp; Previous L7D (d-3) (copy)_172121948630425605]' derivation='None' name='[none:L7D &amp; Previous L7D (d-3) (copy)_172121948630425605:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_date_local]' derivation='None' name='[none:report_date_local:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column caption='Report Date Local' datatype='date' name='[report_date_local]' role='dimension' type='ordinal' />
            <column-instance column='[Day (Similar Scale) (d-3) (copy)_172121948630806534]' derivation='Day-Trunc' name='[tdy:Day (Similar Scale) (d-3) (copy)_172121948630806534:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Subsidy per Voucher (copy)_5158591907037593600]' derivation='User' name='[usr:Subsidy per Voucher (copy)_5158591907037593600:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0k7p4ya0h1m5vb10pew4e1jfm7ji].[Action (2,Country)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action2]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Calculation_58898640433270810]' />
