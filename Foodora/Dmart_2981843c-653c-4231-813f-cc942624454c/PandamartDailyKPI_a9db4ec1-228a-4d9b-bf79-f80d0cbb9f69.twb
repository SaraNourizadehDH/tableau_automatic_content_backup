    <worksheet name='PandaMart - Subsidy Per Voucher Growth (MTD)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column caption='Subsidy Per Voucher (MTD)' datatype='real' name='[% Subsidy Per Voucher (MTD) (copy)_4723150133242925061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([MTD (d-3) (copy)_172121948636008458],&#10;1&#10;-&#10;&#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([fp_voucher_value_eur])&#10;}&#10;&#10;/ &#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([num_of_valid_orders])&#10;}&#10;,0&#10;)' />
            </column>
            <column caption='Subsidy Per Voucher (PMTD)' datatype='real' name='[% Subsidy Per Voucher (PMTD) (copy)_4723150133243006982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([PMTD (d-3) (copy)_172121948636114955],&#10;1&#10;-&#10;&#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([fp_voucher_value_eur])&#10;}&#10;&#10;/ &#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([num_of_valid_orders])&#10;}&#10;,0&#10;)' />
            </column>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141502953201774]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='MTD Subsidy Per Voucher Growth %' datatype='string' name='[MTD % Subsidy Per Voucher Growth % (copy)_4723150133243076615]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([% Subsidy Per Voucher (MTD) (copy)_4723150133242925061]) - avg([% Subsidy Per Voucher (PMTD) (copy)_4723150133243006982]))&#10;/&#10;avg([% Subsidy Per Voucher (PMTD) (copy)_4723150133243006982]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;(avg([% Subsidy Per Voucher (MTD) (copy)_4723150133242925061]) - avg([% Subsidy Per Voucher (PMTD) (copy)_4723150133243006982]))&#10;/&#10;avg([% Subsidy Per Voucher (PMTD) (copy)_4723150133243006982])&#10;*100,2&#10;)&#10;)' />
            </column>
            <column caption='MTD (mkt incentive cost)' datatype='boolean' name='[MTD (d-3) (copy)_172121948636008458]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date_local], {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)}) = 0&#10;AND&#10;DAY([report_date_local]) &lt;= DAY({FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)})' />
            </column>
            <column caption='MTD Subsidy Per Voucher Growth % (Indicator)' datatype='string' name='[MTD Subsidy Per Voucher Growth % (copy)_4723150133243224072]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([% Subsidy Per Voucher (MTD) (copy)_4723150133242925061]) - avg([% Subsidy Per Voucher (PMTD) (copy)_4723150133243006982]))&#10;/&#10;avg([% Subsidy Per Voucher (PMTD) (copy)_4723150133243006982]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='PMTD (mkt incentive cost)' datatype='boolean' name='[PMTD (d-3) (copy)_172121948636114955]' role='dimension' type='nominal'>
