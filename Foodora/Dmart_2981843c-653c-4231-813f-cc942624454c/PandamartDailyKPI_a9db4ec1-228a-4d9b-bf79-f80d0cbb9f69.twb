              <calculation class='tableau' formula='SUM(IIF([Calculation_58898640418394127]=1, [gmv_eur], NULL)) / SUM(IIF([Calculation_58898640418394127]=1, {fixed[country_name],[report_date_local] : sum([gmv_eur])}, NULL))' />
            </column>
