            <column caption='MTD (d-3)' datatype='boolean' name='[MTD (copy)_128141504139079806]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date_local], {FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)}) = 0&#10;AND&#10;DAY([report_date_local]) &lt;= DAY({FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)})' />
            </column>
            <column caption='MTD mCVR3 Growth % (Indicator)' datatype='string' name='[MTD mCVR2 Growth % (Indicator) (copy)_468937369424048163]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([mCVR2 (MTD) (copy)_468937369422880796]) - avg([mCVR2 (PMTD) (copy)_468937369423003677]))&#10;/&#10;avg([mCVR2 (PMTD) (copy)_468937369423003677]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
