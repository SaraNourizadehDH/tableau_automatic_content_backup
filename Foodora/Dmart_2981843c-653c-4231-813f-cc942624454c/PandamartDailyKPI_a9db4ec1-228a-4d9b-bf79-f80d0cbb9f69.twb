          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column caption='Avg Basket Size - GFV (€)' datatype='real' name='[Calculation_967218450116943873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gfv_eur])/sum([num_of_valid_orders])' />
            </column>
            <column caption='Exec: Avg Basket Size (Average line)' datatype='real' name='[Exec: AFV (Average line) (copy)_4585157035305021456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [vendor_type] = &apos;pandamart&apos; : [T7D % Total Orders (copy)_2913336400862162957]}' />
            </column>
            <column caption='Exec: Avg Basket Size (Colors Line)' datatype='string' name='[Exec: AFV (Colors Line) (copy)_4585157035305021455]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF AVG([Exec: AFV (Average line) (copy)_4585157035305021456]) &gt; [Calculation_967218450116943873] THEN &quot;Below&quot;&#10;ELSE &quot;Above&quot;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='T7D Avg Basket Size' datatype='real' name='[T7D % Total Orders (copy)_2913336400862162957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [gfv_eur], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_valid_orders], 0))' />
