              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt; {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} - 14 AND [report_date_local] &lt;= {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} - 7, [fp_voucher_value_eur], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt; {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} - 14 AND [report_date_local] &lt;= {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} - 7, [num_of_valid_orders], 0))' />
