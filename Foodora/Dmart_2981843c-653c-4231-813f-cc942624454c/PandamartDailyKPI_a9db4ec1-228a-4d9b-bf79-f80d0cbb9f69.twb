            <column caption='T7D % &gt;45 Delivery Time' datatype='real' name='[T7D % Magical Orders (copy)_3081025137546936330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_lg_orders_above_45], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_successful_nonpreorder_orders], 0))' />
            </column>
            <column caption='WoW &gt; 45 Delivery Time (W1) ' datatype='string' datatype-customized='true' name='[WoW Magical Orders (W1)  (copy)_3081025137570361360]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_lg_orders_above_45] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_successful_nonpreorder_orders] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_lg_orders_above_45] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_successful_nonpreorder_orders] ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos; &#10;+ str(round((SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_lg_orders_above_45] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_successful_nonpreorder_orders] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_lg_orders_above_45] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_successful_nonpreorder_orders] ELSE 0 END))&#10;- 100,1))' />
            </column>
            <column caption='WoW &gt; 45 Delivery Time (W1) Indicator' datatype='string' datatype-customized='true' name='[WoW Magical Orders (W1) Indicator (copy)_3081025137570783249]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_lg_orders_above_45] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_successful_nonpreorder_orders] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_lg_orders_above_45] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_successful_nonpreorder_orders] ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;Increase&apos; ELSE &apos;Decrease&apos; END' />
