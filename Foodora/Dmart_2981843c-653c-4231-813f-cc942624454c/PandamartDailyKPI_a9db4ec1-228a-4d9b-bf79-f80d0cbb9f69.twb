    <worksheet name='PandaMart - mCVR2 Growth (MTD)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141502953201774]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='mCVR2 (MTD)' datatype='real' name='[Average Basket Size (MTD) (copy)_468937369340215303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([MTD (copy)_128141504139079806],&#10;&#10;&#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([list_and_menu_sessions])&#10;}&#10;&#10;/ &#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([list_sessions])&#10;}&#10;,0&#10;)' />
            </column>
            <column caption='mCVR2 (PMTD)' datatype='real' name='[Average Basket Size (PMTD) (copy)_468937369340375048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([PMTD (copy)_128141504139505791],&#10;&#10;&#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([list_and_menu_sessions])&#10;}&#10;&#10;/ &#10;{FIXED [country_name],[vendor_type],[report_date_local]:&#10;sum([list_sessions])&#10;}&#10;,0&#10;)' />
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='MTD (d-3)' datatype='boolean' name='[MTD (copy)_128141504139079806]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date_local], {FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)}) = 0&#10;AND&#10;DAY([report_date_local]) &lt;= DAY({FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)})' />
            </column>
            <column caption='MTD mCVR2 Growth % (Indicator)' datatype='string' name='[MTD Avg Basket Size Growth % (Indicator) (copy)_468937369341116425]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([Average Basket Size (MTD) (copy)_468937369340215303]) - avg([Average Basket Size (PMTD) (copy)_468937369340375048]))&#10;/&#10;avg([Average Basket Size (PMTD) (copy)_468937369340375048]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='MTD mCVR2 Growth %' datatype='string' name='[MTD Avg Basket Size Growth % (copy)_468937369340006406]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([Average Basket Size (MTD) (copy)_468937369340215303]) - avg([Average Basket Size (PMTD) (copy)_468937369340375048]))&#10;/&#10;avg([Average Basket Size (PMTD) (copy)_468937369340375048]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;(avg([Average Basket Size (MTD) (copy)_468937369340215303]) - avg([Average Basket Size (PMTD) (copy)_468937369340375048]))&#10;/&#10;avg([Average Basket Size (PMTD) (copy)_468937369340375048])&#10;*100,2&#10;)&#10;)' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='PMTD (d-3)' datatype='boolean' name='[PMTD (copy)_128141504139505791]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date_local], {FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)}) = 1&#10;AND&#10;DAY([report_date_local]) &lt;= DAY({FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)})' />
            </column>
            <column caption='T7D mCVR2' datatype='real' name='[T7D Avg Basket Size (copy)_468937369339686917]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt; {FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)} - 7, [list_and_menu_sessions], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt; {FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)} - 7, [list_sessions], 0))' />
            </column>
