            <column caption='WoW Delivery Time (W1) Indicator ' datatype='string' datatype-customized='true' name='[WoW Delivery Time (copy)_58898640423903253]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [delivery_time_non_preorder] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_non_preorders] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [delivery_time_non_preorder] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_non_preorders] ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;Increase&apos; ELSE &apos;Decrease&apos; END' />
            </column>
            <column caption='WoW DF (W1)' datatype='string' datatype-customized='true' name='[WoW New Customers (W1) (copy)_252834936421941257]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;(SUM(IF [Calculation_58898640418394127] = 1 THEN [delivery_fee_eur] ELSE 0 END) / &#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#10;*100.0 / &#10;((SUM(IF [Calculation_58898640406446086] = 1 THEN [delivery_fee_eur] ELSE 0 END) /&#10;(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)))&#10;)-100)&#10;&#10;&gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos; &#10;&#10;+ str(round(&#10;(SUM(IF [Calculation_58898640418394127] = 1 THEN [delivery_fee_eur] ELSE 0 END) / &#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#10;*100.0 / &#10;((SUM(IF [Calculation_58898640406446086] = 1 THEN [delivery_fee_eur] ELSE 0 END) /&#10;(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)))&#10;)-100&#10;,1))' />
            </column>
            <column caption='WoW DF (W1) Growth' datatype='real' datatype-customized='true' name='[WoW New Customers (W1) Growth (copy)_252834936421941256]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='round(&#10;(SUM(IF [Calculation_58898640418394127] = 1 THEN [delivery_fee_eur] ELSE 0 END) / &#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#10;*100.0 / &#10;((SUM(IF [Calculation_58898640406446086] = 1 THEN [delivery_fee_eur] ELSE 0 END) /&#10;(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)))&#10;)-100&#10;,1)' />
