    <worksheet name='PandaMart - Subsidy per Voucher Growth (W1)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column aggregation='Sum' caption='1' datatype='integer' name='[Calculation_58898640425685014]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='WoW Growth %' />
              </aliases>
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Wow Subsidy per Voucher Rate (W1)' datatype='string' name='[Calculation_935059924758257668]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#13;&#10;SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [num_of_valid_orders] ELSE 0 END))*100.0&#13;&#10;/(SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#13;&#10;SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#13;&#10;- 100) &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;+ &apos; &apos; &#13;&#10;+ str(round((SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#13;&#10;SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [num_of_valid_orders] ELSE 0 END))*100.0&#13;&#10;/(SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#13;&#10;SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#13;&#10;- 100,1))' />
            </column>
            <column caption='Wow Subsidy per Voucher Rate (W1) Indicator' datatype='string' name='[Calculation_935059924758618117]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#13;&#10;SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [num_of_valid_orders] ELSE 0 END))*100.0&#13;&#10;/(SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#13;&#10;SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#13;&#10;- 100) &gt;= 0 THEN  &apos;Increase&apos; ELSE &apos;Decrease&apos; END' />
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='T7D Subsidy Per Voucher' datatype='real' name='[T7D % Magical Orders (copy)_2913336400870944806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} - 6, [fp_voucher_value_eur], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} - 6, [num_of_valid_orders], 0))' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column aggregation='Sum' caption='d-1 (mkt incentive cost)' datatype='integer' name='[d-3 (copy)_172121948629422083]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [report_date_local] = {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)}&#10;THEN 1 else 0 end' />
            </column>
            <column caption='Fp Voucher Value Eur' datatype='real' name='[fp_voucher_value_eur]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_58898640425685014]' derivation='None' name='[none:Calculation_58898640425685014:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Global Entity Id (copy)_5424515436352962560]' derivation='None' name='[none:Global Entity Id (copy)_5424515436352962560:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
