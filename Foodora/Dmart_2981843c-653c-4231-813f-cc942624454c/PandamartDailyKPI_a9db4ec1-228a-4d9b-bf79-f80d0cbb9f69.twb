            <column caption='T7D Existing Customers' datatype='integer' name='[T7D New Customers (copy)_2913336400874586160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_existing_customers], 0))' />
            </column>
            <column caption='WoW Existing Customers (W1)' datatype='string' datatype-customized='true' name='[WoW New Customers (W1) (copy)_6337972098101915648]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_existing_customers] ELSE 0 END)*100.0 / &#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_existing_customers] ELSE 0 END)&#10;- 100) &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos; &#10;+ str(round((SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_existing_customers] ELSE 0 END)*100.0 / &#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_existing_customers] ELSE 0 END)&#10;- 100),1))' />
            </column>
            <column caption='WoW Existing Customers (W1) Indicator' datatype='string' datatype-customized='true' name='[WoW New Customers (W1) Indicator (copy)_6337972098101915649]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_existing_customers] ELSE 0 END)*100.0 / &#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_existing_customers] ELSE 0 END)&#10;- 100) &gt;= 0 THEN  &apos;Increase&apos; ELSE &apos;Decrease&apos; END' />
            </column>
