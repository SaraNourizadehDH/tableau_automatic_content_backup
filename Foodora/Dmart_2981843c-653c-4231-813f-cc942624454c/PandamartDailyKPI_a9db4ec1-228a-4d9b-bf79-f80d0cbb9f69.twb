    <worksheet name='PandaMart - % of Total Orders (MTD)'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column caption='% Order Contribution (PMTD)' datatype='real' name='[% Order Contribution (MTD) (copy)_2913336401038356552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([Previous L30D (copy)_128141502928400489],&#10;({fixed[country_name],[vendor_type],[report_date_local] :sum([num_of_valid_orders])}) &#10;/ ({fixed[country_name],[report_date_local] : sum([num_of_valid_orders])})&#10;&#10;,0&#10;)' />
            </column>
            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141502953201774]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column caption='MTD % Order Contribution Growth % (Indicator)' datatype='string' name='[MTD % Order Contribution Growth % (copy)_2913336401038626890]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([Order Per Store Per Day By Country (MTD) (copy)_2913336401037566023]) - avg([% Order Contribution (MTD) (copy)_2913336401038356552]))&#10;/&#10;avg([% Order Contribution (MTD) (copy)_2913336401038356552]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='MTD % Order Contribution Growth %' datatype='string' name='[MTD Order Per Store Per Day Growth % (copy)_2913336401038430281]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(avg([Order Per Store Per Day By Country (MTD) (copy)_2913336401037566023]) - avg([% Order Contribution (MTD) (copy)_2913336401038356552]))&#10;/&#10;avg([% Order Contribution (MTD) (copy)_2913336401038356552]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;(avg([Order Per Store Per Day By Country (MTD) (copy)_2913336401037566023]) - avg([% Order Contribution (MTD) (copy)_2913336401038356552]))&#10;/&#10;avg([% Order Contribution (MTD) (copy)_2913336401038356552])&#10;*100,2&#10;)&#10;)' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='% Order Contribution (MTD)' datatype='real' name='[Order Per Store Per Day By Country (MTD) (copy)_2913336401037566023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([PMTD (copy)_128141502928715882],&#10;({fixed[country_name],[vendor_type],[report_date_local] :sum([num_of_valid_orders])}) &#10;/ ({fixed[country_name],[report_date_local] : sum([num_of_valid_orders])})&#10;&#10;,0&#10;)' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date_local], today() - 1) = 0&#10;AND&#10;DAY([report_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Previous L30D (copy)_128141502928400489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date_local], today() - 1) = 1&#10;AND&#10;DAY([report_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='T7D % Total GMV' datatype='real' name='[T7D Order Per Store (copy)_2913336400860614664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [gmv_eur], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, {fixed[country_name],[report_date_local] : sum([gmv_eur])}, 0))' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[Number of Records]' derivation='Min' name='[min:Number of Records:qk]' pivot='key' type='quantitative' />
            <column-instance column='[1 T7D Growth (copy)_128141502953201774]' derivation='None' name='[none:1 T7D Growth (copy)_128141502953201774:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Global Entity Id (copy)_5424515436352962560]' derivation='None' name='[none:Global Entity Id (copy)_5424515436352962560:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column caption='Num Of Valid Orders' datatype='integer' name='[num_of_valid_orders]' role='measure' type='quantitative' />
            <column caption='Report Date Local' datatype='date' name='[report_date_local]' role='dimension' type='ordinal' />
            <column-instance column='[MTD % Order Contribution Growth % (copy)_2913336401038626890]' derivation='User' name='[usr:MTD % Order Contribution Growth % (copy)_2913336401038626890:nk]' pivot='key' type='nominal' />
            <column-instance column='[MTD Order Per Store Per Day Growth % (copy)_2913336401038430281]' derivation='User' name='[usr:MTD Order Per Store Per Day Growth % (copy)_2913336401038430281:nk]' pivot='key' type='nominal' />
            <column-instance column='[T7D Order Per Store (copy)_2913336400860614664]' derivation='User' name='[usr:T7D Order Per Store (copy)_2913336400860614664:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0k7p4ya0h1m5vb10pew4e1jfm7ji].[Action (2,Country)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action2]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Calculation_58898640433270810]' />
              <groupfilter function='level-members' level='[none:country_name:nk]' />
            </groupfilter>
          </filter>
          <computed-sort column='[federated.0k7p4ya0h1m5vb10pew4e1jfm7ji].[none:country_name:nk]' direction='DESC' using='[federated.0k7p4ya0h1m5vb10pew4e1jfm7ji].[usr:T7D Order Per Store (copy)_2913336400860614664:qk]' />
          <filter class='categorical' column='[federated.0k7p4ya0h1m5vb10pew4e1jfm7ji].[none:vendor_type:nk]' filter-group='6'>
            <groupfilter function='member' level='[none:vendor_type:nk]' member='&quot;pandamart&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
