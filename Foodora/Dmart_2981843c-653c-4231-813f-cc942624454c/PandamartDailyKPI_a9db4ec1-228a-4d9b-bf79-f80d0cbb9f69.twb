              <calculation class='tableau' formula='IF ((SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#10;SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [gmv_eur] ELSE 0 END))*100.0&#10;/(SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#10;SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [gmv_eur] ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos; &#10;+ str(round((SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#10;SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [gmv_eur] ELSE 0 END))*100.0&#10;/(SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#10;SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [gmv_eur] ELSE 0 END))&#10;- 100,1))&#10;+ &apos;%&apos;' />
            </column>
            <column caption='Wow Voucher Spend % GMV (W1) Indicator' datatype='string' name='[Wow Subsidy per Voucher Rate (W1) Indicator (copy)_5158591907313115148]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#13;&#10;SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [gmv_eur] ELSE 0 END))*100.0&#13;&#10;/(SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#13;&#10;SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [gmv_eur] ELSE 0 END))&#13;&#10;- 100) &gt;= 0 THEN  &apos;Increase&apos; ELSE &apos;Decrease&apos; END' />
