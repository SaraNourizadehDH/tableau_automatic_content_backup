              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 15 AND [report_date_local] &lt; now() - 8, [gmv_eur], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 15 AND [report_date_local] &lt; now() - 8, {fixed[country_name],[report_date_local] : sum([gmv_eur])}, 0))' />
