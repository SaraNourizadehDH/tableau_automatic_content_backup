              <calculation class='tableau' formula='if&#10;(avg([mCVR2 (MTD) (copy)_468937369422880796]) - avg([mCVR2 (PMTD) (copy)_468937369423003677]))&#10;/&#10;avg([mCVR2 (PMTD) (copy)_468937369423003677]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;(avg([mCVR2 (MTD) (copy)_468937369422880796]) - avg([mCVR2 (PMTD) (copy)_468937369423003677]))&#10;/&#10;avg([mCVR2 (PMTD) (copy)_468937369423003677])&#10;*100,2&#10;)&#10;)' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='PMTD (d-3)' datatype='boolean' name='[PMTD (copy)_128141504139505791]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date_local], {FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)}) = 1&#10;AND&#10;DAY([report_date_local]) &lt;= DAY({FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)})' />
