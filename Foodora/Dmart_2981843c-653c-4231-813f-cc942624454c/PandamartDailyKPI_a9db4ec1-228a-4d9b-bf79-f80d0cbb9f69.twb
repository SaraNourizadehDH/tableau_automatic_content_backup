            <column caption='WoW GMV (W1) Symbol Only' datatype='string' datatype-customized='true' name='[WoW GMV (W1) (copy)_4585157035299409925]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [Calculation_58898640418394127] = 1 THEN [gmv_eur] ELSE 0 END)*100.0 / &#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [gmv_eur] ELSE 0 END)&#10;- 100) &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='WoW GMV (W1) Value Only' datatype='real' datatype-customized='true' name='[WoW GMV (W1) (copy)_4585157035299520518]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='round((SUM(IF [Calculation_58898640418394127] = 1 THEN [gmv_eur] ELSE 0 END)*100.0 / &#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [gmv_eur] ELSE 0 END)&#10;- 100),1)' />
