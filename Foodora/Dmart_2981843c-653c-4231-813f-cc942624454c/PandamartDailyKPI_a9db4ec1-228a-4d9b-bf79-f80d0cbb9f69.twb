              <calculation class='tableau' formula='IF [WoW Partially Fulfilled Orders (W1) Symbol Only (copy)_92746032745979917] = &apos;▲&apos; THEN &apos;Increase&apos; ELSE &apos;Decrease&apos; END' />
            </column>
            <column caption='WoW Seamless Fulfilled Orders (W1) Negative' datatype='string' datatype-customized='true' name='[WoW Partially Fulfilled Orders (W1) Negative (copy)_92746032745979919]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [WoW Partially Fulfilled Orders (W1) Symbol Only (copy)_92746032745979917] = &apos;▼&apos; THEN [WoW Partially Fulfilled Orders (W1) (copy)_92746032745979915]+&apos;%&apos; ELSE NULL END' />
            </column>
            <column caption='WoW Seamless Fulfilled Orders (W1) Positive' datatype='string' datatype-customized='true' name='[WoW Partially Fulfilled Orders (W1) Positive (copy)_92746032745979920]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [WoW Partially Fulfilled Orders (W1) Symbol Only (copy)_92746032745979917] = &apos;▲&apos; THEN [WoW Partially Fulfilled Orders (W1) (copy)_92746032745979915]+&apos;%&apos; ELSE NULL END' />
