      </column>
      <column caption='&gt; 45 Delivery Time colour code' datatype='integer' name='[Calculation_3081025137539993608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ([Calculation_3081025137536110592] - [Calculation_3081025137537531910]) / [Calculation_3081025137537531910] &gt;= 0.2 then 2&#10;elseif ([Calculation_3081025137536110592] - [Calculation_3081025137537531910]) / [Calculation_3081025137537531910] &lt;= -0.2 then -2&#10;elseif ([Calculation_3081025137536110592] - [Calculation_3081025137537531910]) / [Calculation_3081025137537531910] &lt;= -0.1 then -1&#10;elseif ([Calculation_3081025137536110592] - [Calculation_3081025137537531910]) / [Calculation_3081025137537531910] &gt;= 0.1 then 1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg % &gt; 45 Delivery Time' datatype='real' name='[Calculation_3081025137577181205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([num_of_lg_orders_above_45])/sum([num_of_successful_nonpreorder_orders])' />
      </column>
      <column caption='DFPO' datatype='real' name='[Calculation_408701670334345219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivery_fee_eur]) / sum([num_of_valid_orders])' />
      </column>
      <column caption='is_past_7_days' datatype='boolean' name='[Calculation_4585157035298091012]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date_local]&gt;=TODAY()-7' />
      </column>
      <column caption='Yesterday&apos;s Avg Basket Size Main' datatype='real' name='[Calculation_4585157035302584329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([Calculation_58898640418394127]=1, [gfv_eur], null)) / sum(iif([Calculation_58898640418394127]=1, [num_of_valid_orders],null))' />
      </column>
      <column caption='Yesterday&apos;s Orders Per Day Per Store Main' datatype='real' name='[Calculation_4585157035306872849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([Calculation_58898640418394127]=1, [num_of_valid_orders], null)) / sum(iif([Calculation_58898640418394127]=1, [num_of_active_vendors],null))' />
      </column>
      <column caption='Yesterday&apos;s Fail Rate Main' datatype='real' name='[Calculation_4585157035328020514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([Calculation_58898640418394127]=1, [num_of_failed_orders], null)) / sum(iif([Calculation_58898640418394127]=1, [num_of_orders],null))' />
      </column>
      <column caption='mCVR2' datatype='real' name='[Calculation_468937369333514240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([list_and_menu_sessions])/SUM([list_sessions])' />
      </column>
      <column caption='mCVR3' datatype='real' name='[Calculation_468937369333850113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([menu_and_checkout_sessions])/SUM([menu_sessions])' />
      </column>
      <column caption='mCVR4' datatype='real' name='[Calculation_468937369333915650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([checkout_and_transact_sessions])/SUM([checkout_sessions])' />
      </column>
      <column caption='is d_3 dates' datatype='boolean' name='[Calculation_468937369403260953]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date_local] &gt;= {FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)} - 7 &#10;AND [report_date_local] &lt;= {FIXED:MAX(IF [menu_sessions] &gt; 0 THEN [report_date_local] END)}' />
      </column>
      <column caption='Is Today' datatype='boolean' name='[Calculation_5284200113965608960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([report_date_local] = date(NOW()), TRUE, FALSE)' />
      </column>
      <column caption='Latest Date' datatype='date' name='[Calculation_557250104596926464]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED : MAX([report_date_local])} -1' />
      </column>
      <column caption='Latest Month' datatype='date' name='[Calculation_557250104597061633]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [Calculation_557250104596926464]))' />
      </column>
      <column caption='Previous Month' datatype='date' name='[Calculation_557250104597192706]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, -1, [Calculation_557250104597061633]))' />
      </column>
      <column caption='Valid Orders (Previous MTD)' datatype='integer' name='[Calculation_557250104597385219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;DATETRUNC(&apos;month&apos;, [report_date_local]) = DATETRUNC(&apos;month&apos;, [Calculation_557250104597192706])&#10;AND&#10;DATEPART(&apos;day&apos;, [report_date_local]) &lt;= DATEPART (&apos;day&apos;, [Calculation_557250104596926464])&#10;THEN&#10;[num_of_valid_orders]&#10;END' />
      </column>
      <column caption='Valid Orders MoM%' datatype='string' name='[Calculation_557250104597897221]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (&#10;(sum([Valid Orders (Previous MTD) (copy)_557250104597786628]) - sum([Calculation_557250104597385219]) )&#10;/ sum([Calculation_557250104597385219])&#10;) &gt;=0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;+ STR(&#10;ROUND(&#10;(&#10;(sum([Valid Orders (Previous MTD) (copy)_557250104597786628]) - sum([Calculation_557250104597385219]) )&#10;/ sum([Calculation_557250104597385219])&#10;)*100, 2)&#10;)' />
      </column>
      <column aggregation='Sum' caption='w-1' datatype='integer' name='[Calculation_58898640406446086]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [report_date_local]&#10;     WHEN today()-8 THEN 1 else 0 end' />
      </column>
      <column caption='WoW Orders (W1)' datatype='string' datatype-customized='true' name='[Calculation_58898640408981512]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[WoW Orders (W1) (copy)_4585157035295125504]&#10;+ &apos; &apos; &#10;+ str([WoW Orders (W1) (copy)_4585157035295318017])' />
      </column>
      <column aggregation='Sum' caption='d-1' datatype='integer' name='[Calculation_58898640418394127]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [report_date_local]&#10;     WHEN today()-1 THEN 1 else 0 end' />
      </column>
      <column aggregation='Sum' caption='w-2' datatype='integer' name='[Calculation_58898640418430992]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [report_date_local]&#10;     WHEN today()-15 THEN 1 else 0 end' />
      </column>
      <column aggregation='Sum' caption='1' datatype='integer' name='[Calculation_58898640425685014]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='1' />
        <aliases>
          <alias key='1' value='WoW Growth %' />
        </aliases>
      </column>
      <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='2' />
        <aliases>
          <alias key='2' value='% 2W Growth' />
        </aliases>
      </column>
      <column caption='total_orders_without_issues' datatype='integer' name='[Calculation_6016457324308930560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[num_of_valid_orders] - [total_orders_with_issues]' />
      </column>
      <column caption='Magical Orders' datatype='real' name='[Calculation_6016457324309209089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (sum([total_orders_with_issues]) / sum([num_of_orders]))' />
      </column>
      <column caption='Avg Delivery Time' datatype='real' name='[Calculation_6320239186696593411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivery_time_non_preorder])/sum([num_of_non_preorders])/60.0' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_6320239186720763911]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([num_of_failed_orders])/sum([num_of_orders])' />
      </column>
      <column caption='Avg Existing Customers' datatype='real' name='[Calculation_6337972098103476229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([num_of_existing_customers])/countd([report_date_local])' />
      </column>
      <column caption='Yesterday&apos;s Orders Main' datatype='integer' name='[Calculation_6649142689517953024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Calculation_58898640418394127] = 1, [num_of_valid_orders], NULL))' />
      </column>
      <column caption='Subsidy per Voucher' datatype='real' name='[Calculation_935059924755525635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([fp_voucher_value_eur])/sum([num_of_valid_orders])' />
      </column>
      <column caption='Wow Subsidy per Voucher Rate (W1)' datatype='string' name='[Calculation_935059924758257668]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ((SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#13;&#10;SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [num_of_valid_orders] ELSE 0 END))*100.0&#13;&#10;/(SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#13;&#10;SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#13;&#10;- 100) &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;+ &apos; &apos; &#13;&#10;+ str(round((SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#13;&#10;SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [num_of_valid_orders] ELSE 0 END))*100.0&#13;&#10;/(SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#13;&#10;SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#13;&#10;- 100,1))' />
      </column>
      <column caption='Wow Subsidy per Voucher Rate (W1) Indicator' datatype='string' name='[Calculation_935059924758618117]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ((SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#13;&#10;SUM(IF [d-3 (copy)_172121948629422083] = 1 THEN [num_of_valid_orders] ELSE 0 END))*100.0&#13;&#10;/(SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [fp_voucher_value_eur] ELSE 0 END)/&#13;&#10;SUM(IF [w-1 (d-3) (copy)_172121948635004937] = 1 THEN [num_of_valid_orders] ELSE 0 END))&#13;&#10;- 100) &gt;= 0 THEN  &apos;Increase&apos; ELSE &apos;Decrease&apos; END' />
      </column>
      <column caption='Subsidy per Discounted Order' datatype='real' name='[Calculation_935059924774735882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([fp_voucher_value_eur])/sum([num_of_valid_orders_w_vouchers])' />
      </column>
