              <calculation class='tableau' formula='if&#10;([T7D % Magical Orders (copy)_2913336400870944806] - [T7D % Magical Orders (Prev L7D) (copy)_2913336400871055399]) / [T7D % Magical Orders (Prev L7D) (copy)_2913336400871055399] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;+&#10;str(&#10;round(([T7D % Magical Orders (copy)_2913336400870944806] - [T7D % Magical Orders (Prev L7D) (copy)_2913336400871055399]) / [T7D % Magical Orders (Prev L7D) (copy)_2913336400871055399] *100,2)&#10;)' />
            </column>
