              <calculation class='tableau' formula='IF ((SUM(IF [d-1 (copy)_468937369334456324] = 1 THEN [list_and_menu_sessions] ELSE 0 END)/&#10;SUM(IF [d-1 (copy)_468937369334456324] = 1 THEN [list_sessions] ELSE 0 END))*100.0&#10;/(SUM(IF [w-1 (copy)_468937369344937999] = 1 THEN [list_and_menu_sessions] ELSE 0 END)/&#10;SUM(IF [w-1 (copy)_468937369344937999] = 1 THEN [list_sessions] ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END' />
