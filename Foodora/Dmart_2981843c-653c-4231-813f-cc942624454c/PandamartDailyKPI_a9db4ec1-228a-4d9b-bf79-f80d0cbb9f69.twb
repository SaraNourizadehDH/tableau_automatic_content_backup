            <column aggregation='Sum' caption='1 MTD Growth' datatype='integer' name='[1 T7D Growth (copy)_128141502953201774]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='Delivery Time &gt;= 45mins MTD vs PMTD (Indicator)' datatype='string' name='[Calculation_3081025137536913410]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    [Calculation_3081025137537183748] - [Calculation_3081025137537327109]&#10;)&#10;&#10;/&#10;&#10;[Calculation_3081025137537327109] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
            </column>
            <column caption='Delivery Time &gt;=45mins MTD vs PMTD ' datatype='string' name='[Calculation_3081025137537052675]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    [Calculation_3081025137537183748] - [Calculation_3081025137537327109]&#10;)&#10;&#10;/&#10;&#10;[Calculation_3081025137537327109] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    [Calculation_3081025137537183748] - [Calculation_3081025137537327109]&#10;)&#10;&#10;/&#10;&#10;[Calculation_3081025137537327109] * 100&#10;,2)&#10;)' />
            </column>
            <column caption='Delivery Time &gt;=45mins Per Day By Country (MTD)' datatype='real' name='[Calculation_3081025137537183748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([PMTD (copy)_128141502928715882],[num_of_lg_orders_above_45],0))&#10;/&#10;SUM(iif([PMTD (copy)_128141502928715882],[num_of_successful_nonpreorder_orders],0))' />
            </column>
            <column caption='Delivery Time &gt;=45mins Per Day By Country (PMTD)' datatype='real' name='[Calculation_3081025137537327109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(iif([Previous L30D (copy)_128141502928400489],[num_of_lg_orders_above_45],0))&#10;/&#10;SUM(iif([Previous L30D (copy)_128141502928400489],[num_of_successful_nonpreorder_orders],0))' />
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='MTD' datatype='boolean' name='[PMTD (copy)_128141502928715882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date_local], today() - 1) = 0&#10;AND&#10;DAY([report_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Previous L30D (copy)_128141502928400489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_date_local], today() - 1) = 1&#10;AND&#10;DAY([report_date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='T7D % &gt;45 Delivery Time' datatype='real' name='[T7D % Magical Orders (copy)_3081025137546936330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_lg_orders_above_45], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= now() - 8, [num_of_successful_nonpreorder_orders], 0))' />
            </column>
