            <column caption='Orders MTD vs PMTD (Indicator)' datatype='string' name='[Orders MTD vs PMTD (copy)_4682406627565907968]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([PMTD (copy)_128141502928715882], [num_of_valid_orders], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Previous L30D (copy)_128141502928400489], [num_of_valid_orders], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Previous L30D (copy)_128141502928400489], [num_of_valid_orders], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
