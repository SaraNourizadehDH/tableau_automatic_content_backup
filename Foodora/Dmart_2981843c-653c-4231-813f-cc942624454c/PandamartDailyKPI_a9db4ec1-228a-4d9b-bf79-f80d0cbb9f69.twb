              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [gmv_eur] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN {fixed[country_name],[report_date_local] : sum([gmv_eur])} ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [gmv_eur] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN {fixed[country_name],[report_date_local] : sum([gmv_eur])} ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos; &#10;+ str(round((SUM(IF [Calculation_58898640418394127] = 1 THEN [gmv_eur] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN {fixed[country_name],[report_date_local] : sum([gmv_eur])} ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [gmv_eur] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN {fixed[country_name],[report_date_local] : sum([gmv_eur])} ELSE 0 END))&#10;- 100,1))' />
            </column>
            <column caption='WoW % of total GMV (W1) Indicator' datatype='string' datatype-customized='true' name='[WoW % of total orders (W1) Indicator (copy)_6630354184358785038]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [gmv_eur] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN {fixed[country_name],[report_date_local] : sum([gmv_eur])} ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [gmv_eur] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN {fixed[country_name],[report_date_local] : sum([gmv_eur])} ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;Increase&apos; ELSE &apos;Decrease&apos; END' />
            </column>
            <column caption='WoW % of total GMV (W1) Negative' datatype='string' datatype-customized='true' name='[WoW % of total orders (W1) Negative (copy)_195484431556186112]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [WoW % of total orders (W1) Symbol Only (copy)_195484431556390914] = &apos;▼&apos; THEN [WoW % of total orders (W1) (copy)_6630354184358629389]+&apos;%&apos; ELSE NULL END' />
