    <worksheet name='PandaMart - Daily Chart Fail Rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_dmart__daily_kpi_dashboard' name='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji' />
          </datasources>
          <datasource-dependencies datasource='federated.0k7p4ya0h1m5vb10pew4e1jfm7ji'>
            <column caption='L7D &amp; Previous L7D' datatype='string' name='[Calculation_1893693317790859265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date_local] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [report_date_local] &lt;= NOW() - 1&#10;THEN &apos;L7D&apos;&#10;ELSEIF [report_date_local] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [report_date_local] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END' />
            </column>
            <column caption='Day (Similar Scale)' datatype='datetime' name='[Calculation_1893693317791297538]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [report_date_local] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [report_date_local])&#10;ELSE [report_date_local]&#10;END' />
            </column>
            <column caption='DayOfWeek' datatype='string' name='[Calculation_1893693317791571972]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [report_date_local])' />
            </column>
            <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_58898640433270810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='2' value='% 2W Growth' />
              </aliases>
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_6320239186720763911]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([num_of_failed_orders])/sum([num_of_orders])' />
            </column>
            <column caption='Country' datatype='string' name='[Global Entity Id (copy)_5424515436352962560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]' />
            </column>
            <column-instance column='[Calculation_1893693317791571972]' derivation='Attribute' name='[attr:Calculation_1893693317791571972:nk]' pivot='key' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
