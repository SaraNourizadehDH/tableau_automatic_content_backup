              <calculation class='tableau' formula='if&#10;([T7D Orders (copy)_2913336400859291650] - [T7D Orders (Prev L7D) (copy)_2913336400859447299]) / [T7D Orders (Prev L7D) (copy)_2913336400859447299] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
