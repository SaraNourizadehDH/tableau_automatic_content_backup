            <column caption='WoW GMV per store (W1) Symbol Only' datatype='string' datatype-customized='true' name='[WoW GMV per store (W1) (copy)_4585157035311304729]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [gmv_eur] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_active_vendors] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [gmv_eur] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_active_vendors] ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='WoW GMV per store (W1) Value Only' datatype='real' datatype-customized='true' name='[WoW GMV per store (W1) (copy)_4585157035311620122]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='round((SUM(IF [Calculation_58898640418394127] = 1 THEN [gmv_eur] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_active_vendors] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [gmv_eur] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_active_vendors] ELSE 0 END))&#10;- 100,1)' />
            </column>
            <column caption='WoW Orders per store (W1)' datatype='string' datatype-customized='true' name='[WoW Orders (W1) (copy)_277675072081944584]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[WoW Orders per store (W1)  (copy)_4585157035307577362]&#10;+ &apos; &apos; &#10;+ str([WoW Orders per store (W1)  (copy)_4585157035307687955])' />
            </column>
            <column caption='WoW GMV (W1) Growth' datatype='real' datatype-customized='true' name='[WoW Orders (W1) Growth (copy)_6101673844051922951]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(SUM(IF [Calculation_58898640418394127] = 1 THEN [gmv_eur] ELSE 0 END)*100.0 / &#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [gmv_eur] ELSE 0 END)&#10;- 100)' />
            </column>
            <column caption='WoW GMV per store (W1)' datatype='string' datatype-customized='true' name='[WoW Orders per store (W1)  (copy)_3371999890452987915]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[WoW GMV per store (W1) (copy)_4585157035311304729] &#10;+ &apos; &apos; &#10;+ str([WoW GMV per store (W1) (copy)_4585157035311620122])' />
            </column>
            <column caption='WoW Orders per store (W1) Symbol Only' datatype='string' datatype-customized='true' name='[WoW Orders per store (W1)  (copy)_4585157035307577362]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_active_vendors] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_active_vendors] ELSE 0 END))&#10;- 100) &gt;= 0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='WoW Orders per store (W1) Value Only' datatype='real' datatype-customized='true' name='[WoW Orders per store (W1)  (copy)_4585157035307687955]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='round((SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_valid_orders] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_active_vendors] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_valid_orders] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_active_vendors] ELSE 0 END))&#10;- 100,1)' />
