              <calculation class='tableau' formula='SUM(IIF([report_date_local] &gt;= {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} - 13 AND [report_date_local] &lt;= {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} - 6, [fp_voucher_value_eur], 0))&#10;/&#10;SUM(IIF([report_date_local] &gt;= {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} - 13 AND [report_date_local] &lt;= {FIXED:MAX(IF [fp_voucher_value_eur] &gt; 0 THEN [report_date_local] END)} - 6, [gmv_eur], 0))' />
