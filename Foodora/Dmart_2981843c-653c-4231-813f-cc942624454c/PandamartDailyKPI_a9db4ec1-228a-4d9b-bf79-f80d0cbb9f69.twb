              <calculation class='tableau' formula='IF ((SUM(IF [Calculation_58898640418394127] = 1 THEN [gmv_eur] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640418394127] = 1 THEN [num_of_active_vendors] ELSE 0 END))*100.0&#10;/(SUM(IF [Calculation_58898640406446086] = 1 THEN [gmv_eur] ELSE 0 END)/&#10;SUM(IF [Calculation_58898640406446086] = 1 THEN [num_of_active_vendors] ELSE 0 END))&#10;- 100) &gt;= 0 THEN  &apos;▲&apos; ELSE &apos;▼&apos; END' />
