      </column>
      <column caption='Orders color code' datatype='integer' name='[Calculation_2261440339122642945]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='if (sum([num_of_valid_orders]) - [Calculation_2261440339122278400]) / [Calculation_2261440339122278400] &gt;= 0.2 then 2&#10;elseif (sum([num_of_valid_orders]) - [Calculation_2261440339122278400]) / [Calculation_2261440339122278400] &lt;= -0.2 then -2&#10;elseif (sum([num_of_valid_orders]) - [Calculation_2261440339122278400]) / [Calculation_2261440339122278400] &lt;= -0.1 then -1&#10;elseif (sum([num_of_valid_orders]) - [Calculation_2261440339122278400]) / [Calculation_2261440339122278400] &gt;= 0.1 then 1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='INDEX' datatype='integer' name='[Calculation_2537426552784424960]' role='measure' type='quantitative'>
