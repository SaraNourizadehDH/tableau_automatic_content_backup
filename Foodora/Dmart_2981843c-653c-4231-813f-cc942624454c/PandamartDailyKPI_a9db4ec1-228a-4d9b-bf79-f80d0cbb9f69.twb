            <column caption='Report Date Local' datatype='date' name='[report_date_local]' role='dimension' type='ordinal' />
            <column-instance column='[MTD % Order Contribution Growth % (copy)_2913336401042075726]' derivation='User' name='[usr:MTD % Order Contribution Growth % (copy)_2913336401042075726:nk]' pivot='key' type='nominal' />
            <column-instance column='[MTD Avg Basket Size Growth % (copy)_2913336401042268239]' derivation='User' name='[usr:MTD Avg Basket Size Growth % (copy)_2913336401042268239:nk]' pivot='key' type='nominal' />
            <column-instance column='[T7D % Total Orders (copy)_2913336400862162957]' derivation='User' name='[usr:T7D % Total Orders (copy)_2913336400862162957:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0k7p4ya0h1m5vb10pew4e1jfm7ji].[Action (2,Country)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action2]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Calculation_58898640433270810]' />
