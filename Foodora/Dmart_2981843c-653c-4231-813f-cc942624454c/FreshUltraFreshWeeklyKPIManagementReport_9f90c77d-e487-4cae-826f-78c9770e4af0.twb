            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column caption='Period' datatype='string' name='[period]' role='dimension' type='nominal' />
            <column caption='Tot Fresh Frequency' datatype='real' name='[tot_fresh_frequency]' role='measure' type='quantitative' />
            <column-instance column='[WoW Change in Orders (copy)_969399856038281281]' derivation='User' name='[usr:WoW Change in Orders (copy)_969399856038281281:nk]' pivot='key' type='nominal' />
