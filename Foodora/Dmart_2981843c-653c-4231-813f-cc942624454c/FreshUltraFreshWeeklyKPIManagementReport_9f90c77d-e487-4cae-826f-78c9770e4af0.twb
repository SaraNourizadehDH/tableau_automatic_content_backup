      <group caption='User Filter 1' name='[APAC User Filter]' name-style='unqualified' user:ui-builder='identity-set'>
        <groupfilter function='intersection'>
          <groupfilter function='level-members' level='[country_name]' />
          <groupfilter function='union'>
            <groupfilter expression='false' function='filter'>
              <groupfilter function='level-members' level='[country_name]' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_qcommerce_FP_BD&apos;)' function='filter'>
              <groupfilter function='member' level='[country_name]' member='&quot;Bangladesh&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_qcommerce_FP_HK&apos;)' function='filter'>
              <groupfilter function='member' level='[country_name]' member='&quot;Hong Kong&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_qcommerce_FP_MY&apos;)' function='filter'>
              <groupfilter function='member' level='[country_name]' member='&quot;Malaysia&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_qcommerce_FP_PH&apos;)' function='filter'>
              <groupfilter function='member' level='[country_name]' member='&quot;Philippines&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_qcommerce_FP_PK&apos;)' function='filter'>
              <groupfilter function='member' level='[country_name]' member='&quot;Pakistan&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_qcommerce_FP_SG&apos;)' function='filter'>
              <groupfilter function='member' level='[country_name]' member='&quot;Singapore&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_qcommerce_FP_TH&apos;)' function='filter'>
