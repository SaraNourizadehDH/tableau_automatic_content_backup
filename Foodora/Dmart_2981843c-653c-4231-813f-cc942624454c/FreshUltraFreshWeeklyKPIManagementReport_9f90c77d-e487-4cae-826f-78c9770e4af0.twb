            <column caption='APAC User Filter' datatype='boolean' name='[Calculation_619737560434130944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISMEMBEROF(&quot;pd_qcommerce_FP_BD&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_HK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_KH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_LA&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MM&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_MY&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_PK&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_SG&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TH&quot;)&#10;    AND ISMEMBEROF(&quot;pd_qcommerce_FP_TW&quot;)&#10;    THEN&#10;        TRUE&#10;ELSE&#10;    [APAC User Filter]&#10;END' />
            </column>
            <column caption='Week Date Value' datatype='string' name='[Calculation_969399855703879680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [period] IN (&quot;W-0&quot;, &quot;W-1&quot;, &quot;W-2&quot;, &quot;W-3&quot;, &quot;W-4&quot;) THEN [date_value] END' />
            </column>
            <column caption='Tot Fresh Order Frequency Colour Code' datatype='integer' name='[GFV Colour Code (copy)_969399856033747001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (SUM([tot_fresh_frequency]) - [L4W Avg AOV (copy)_969399856033865786]) / [L4W Avg AOV (copy)_969399856033865786] &gt;= 0.2 THEN 2&#10;ELSEIF (SUM([tot_fresh_frequency]) - [L4W Avg AOV (copy)_969399856033865786]) / [L4W Avg AOV (copy)_969399856033865786] &gt;= 0.1 THEN 1&#10;ELSEIF (SUM([tot_fresh_frequency]) - [L4W Avg AOV (copy)_969399856033865786]) / [L4W Avg AOV (copy)_969399856033865786] &lt;= -0.1 THEN -1&#10;ELSEIF (SUM([tot_fresh_frequency]) - [L4W Avg AOV (copy)_969399856033865786]) / [L4W Avg AOV (copy)_969399856033865786] &lt;= -0.2 THEN -2&#10;ELSE 0&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Tot Fresh L4W Avg Order Frequency' datatype='real' name='[L4W Avg AOV (copy)_969399856033865786]' role='measure' type='quantitative'>
