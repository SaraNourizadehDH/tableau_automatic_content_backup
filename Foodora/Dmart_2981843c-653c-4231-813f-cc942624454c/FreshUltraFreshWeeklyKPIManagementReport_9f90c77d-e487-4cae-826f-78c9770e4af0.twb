    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Metric Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APWIPFreshWeeklyKPIManagementReport/MetricDefinitions?rev=' id='MetricDefinitions' path='/t/Foodora/workbooks/APWIPFreshWeeklyKPIManagementReport' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_12' value='center' />
          <format attr='text-align' id='dash-text_1249' value='center' />
        </style-rule>
      </style>
      <size maxheight='700' maxwidth='1220' minheight='700' minwidth='1220' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone friendly-name='Dashboard Header' h='8338' id='1101' param='horz' type-v2='layout-flow' w='98688' x='656' y='1143'>
            <zone fixed-size='242' forceUpdate='true' h='8338' id='170' is-fixed='true' type-v2='text' w='20492' x='656' y='1143'>
              <formatted-text>
                <run bold='true' fontcolor='#f5f5f5' fontname='Tableau Semibold' fontsize='24'>    foodpanda</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#b00f53' />
              </zone-style>
            </zone>
            <zone fixed-size='942' forceUpdate='true' h='8338' id='313' is-fixed='true' type-v2='text' w='77869' x='21148' y='1143'>
              <formatted-text>
                <run bold='true' fontcolor='#333333' fontname='Tableau Semibold' fontsize='22'>  Overview &amp; Definitions</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#e6e6e6' />
              </zone-style>
            </zone>
          </zone>
          <zone h='89376' id='1200' param='vert' type-v2='layout-flow' w='98688' x='656' y='9481'>
            <zone fixed-size='188' forceUpdate='true' h='28000' id='1201' is-fixed='true' type-v2='text' w='98688' x='656' y='9481'>
              <formatted-text>
                <run bold='true' fontcolor='#555555' fontname='Tableau Semibold' fontsize='14'>Overview</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#555555' fontsize='10'>This dashboard provides an overview of Fresh KPIs on a weekly basis for the last 4 weeks. </run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#555555' fontsize='10'>1. LW % Δ: Compares change between last week and 2 weeks ago. </run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>2. MTD % Δ: Compares change between current Month-To-Date and previous Month-To-Date. </run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#555555' fontsize='10'>For metrics based on percentages, changes reflected will be based on a percentage point difference.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='padding' value='2' />
              </zone-style>
            </zone>
            <zone fixed-size='585' forceUpdate='true' h='61376' id='1202' is-fixed='true' type-v2='text' w='98688' x='656' y='37481'>
              <formatted-text>
                <run bold='true' fontcolor='#555555' fontname='Tableau Semibold' fontsize='14'>KPI Summary:</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#555555' fontsize='10'>1. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>GFV</run>
                <run fontcolor='#555555' fontsize='10'>: Total value (gross of tax) paid by customer</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>2. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>GFV Share</run>
                <run fontcolor='#555555' fontsize='10'>: Percentage of GFV / Dmart GFV</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>3. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Orders</run>
                <run fontcolor='#555555' fontsize='10'>: Orders containing at least 1 Fresh / Ultra Fresh SKU</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>4. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Order / Basket Penetration</run>
                <run fontcolor='#555555' fontsize='10'>: Percentage of Dmart Orders containing at least 1 Fresh / Ultra Fresh SKU</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>5. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Order Frequency</run>
                <run fontcolor='#555555' fontsize='10'>: Average number of unique Fresh / Ultra Fresh orders made by each Fresh + Ultra Fresh customer.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>6. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Users</run>
                <run fontcolor='#555555' fontsize='10'>: Customers who made at least 1 order containing Fresh / Ultra Fresh SKUs</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>7. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>User Penetration</run>
                <run fontcolor='#555555' fontsize='10'>: Percentage of Dmart customers who made at least 1 order containing Fresh / Ultra Fresh SKUs</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>8. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Gross Margins</run>
                <run fontcolor='#555555' fontsize='10'>: Front margins + Back margins + Promotional Scan Rebates for Fresh + Ultra Fresh (Retail SKUs Only)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>9. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Margin Share</run>
                <run fontcolor='#555555' fontsize='10'>: Percentage of Dmart gross margins from Fresh + Ultra Fresh</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>10. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Gross Margin %</run>
                <run fontcolor='#555555' fontsize='10'>: Fresh + Ultra Fresh gross margins / Fresh + Ultra Fresh Retail Revenue.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>11. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Shrinkage %</run>
                <run fontcolor='#555555' fontsize='10'>: Percentage of Shrinkage amount out of Retail Revenue for Fresh + Ultra Fresh.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>12. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Net Margins</run>
                <run fontcolor='#555555' fontsize='10'>: Front margins + Back margins + Promotional Scan Rebates - Shrinkage for Fresh + Ultra Fresh.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>13. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Net Margin %</run>
                <run fontcolor='#555555' fontsize='10'>: Fresh + Ultra Fresh Net Margins divided by Fresh + Ultra Fresh Retail Revenue.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>14. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Weighted Availability</run>
                <run fontcolor='#555555' fontsize='10'>: Availability of SKUs weighted by forecasted sales and warehouse sessions (calculated by central)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>15. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Partially Filled Orders, PFO</run>
                <run fontcolor='#555555' fontsize='10'>: Percentage of Fresh + Ultra Fresh orders that had unavailable items in their deliveries.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>16. </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Consignment Revenue</run>
                <run fontcolor='#555555' fontsize='10'>: Consignment Commission Rate * GFV (net of tax)</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#555555' fontsize='10' italic='true'>Note: </run>
                <run fontcolor='#555555' fontsize='10'>Orders and Customers are defined based on </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>valid</run>
                <run fontcolor='#555555' fontsize='10'> orders and all currency amounts are in </run>
                <run bold='true' fontcolor='#555555' fontsize='10'>EUR</run>
                <run fontcolor='#555555' fontsize='10'>.</run>
                <run>Æ&#10;&#10;&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='padding' value='2' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
