              <calculation class='tableau' formula='IF &#10;(SUM(IF [period] = &quot;W-0&quot; THEN [non_tot_fresh_consignment_revenue_eur] END) - &#10; SUM(IF [period] = &quot;W-1&quot; THEN [non_tot_fresh_consignment_revenue_eur] END)) &#10;/ SUM(IF [period] = &quot;W-1&quot; THEN [non_tot_fresh_consignment_revenue_eur] END) &gt;= 0&#10;THEN &apos;▲&apos; &#10;ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND((&#10;(SUM(IF [period] = &quot;W-0&quot; THEN [non_tot_fresh_consignment_revenue_eur] END) - &#10; SUM(IF [period] = &quot;W-1&quot; THEN [non_tot_fresh_consignment_revenue_eur] END)) &#10;/ SUM(IF [period] = &quot;W-1&quot; THEN [non_tot_fresh_consignment_revenue_eur] END))&#10;* 100, 2)&#10;)' />
            </column>
