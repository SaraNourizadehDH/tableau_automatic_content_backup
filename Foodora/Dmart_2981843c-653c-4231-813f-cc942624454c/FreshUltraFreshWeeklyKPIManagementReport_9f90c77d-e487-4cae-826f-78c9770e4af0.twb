      <column caption='Tot Fresh Shrinkage % Colour Code' datatype='integer' name='[AOV Colour Code (copy)_3441735314351779873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (AVG([tot_fresh_shrinkage_perc]) - [L4W Avg AOV (copy)_3441735314351968290]) / ABS([L4W Avg AOV (copy)_3441735314351968290]) &gt;= 0.2 THEN 2&#10;ELSEIF (AVG([tot_fresh_shrinkage_perc]) - [L4W Avg AOV (copy)_3441735314351968290]) / ABS([L4W Avg AOV (copy)_3441735314351968290]) &gt;= 0.1 THEN 1&#10;ELSEIF (AVG([tot_fresh_shrinkage_perc]) - [L4W Avg AOV (copy)_3441735314351968290]) / ABS([L4W Avg AOV (copy)_3441735314351968290]) &lt;= -0.1 THEN -1&#10;ELSEIF (AVG([tot_fresh_shrinkage_perc]) - [L4W Avg AOV (copy)_3441735314351968290]) / ABS([L4W Avg AOV (copy)_3441735314351968290]) &lt;= -0.2 THEN -2&#10;ELSE 0&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
