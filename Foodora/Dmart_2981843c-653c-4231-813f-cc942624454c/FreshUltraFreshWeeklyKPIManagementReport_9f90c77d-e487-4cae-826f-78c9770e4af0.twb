              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Tot Fresh WoW Change in Order Frequency' datatype='string' name='[WoW Change in Orders (copy)_969399856038281281]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(AVG(IF [period] = &quot;W-0&quot; THEN ROUND([tot_fresh_frequency], 2) END) - &#10; AVG(IF [period] = &quot;W-1&quot; THEN ROUND([tot_fresh_frequency], 2) END)) &#10;/ AVG(IF [period] = &quot;W-1&quot; THEN ROUND([tot_fresh_frequency], 2) END) &gt;= 0&#10;THEN &apos;▲&apos; &#10;ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;(&#10;(AVG(IF [period] = &quot;W-0&quot; THEN ROUND([tot_fresh_frequency], 2) END) - &#10; AVG(IF [period] = &quot;W-1&quot; THEN ROUND([tot_fresh_frequency], 2) END)) &#10;/ AVG(IF [period] = &quot;W-1&quot; THEN ROUND([tot_fresh_frequency], 2) END)&#10;) * 100, 2)&#10;)' />
            </column>
            <column caption='Tot Fresh WoW Change in Order Frequency Indicator' datatype='string' name='[WoW Change in Orders Indicator (copy)_969399856038522948]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(AVG(IF [period] = &quot;W-0&quot; THEN ROUND([tot_fresh_frequency], 2) END) - &#10; AVG(IF [period] = &quot;W-1&quot; THEN ROUND([tot_fresh_frequency], 2) END)) &#10;/ AVG(IF [period] = &quot;W-1&quot; THEN ROUND([tot_fresh_frequency], 2) END) &gt;= 0&#10;THEN &apos;▲&apos; &#10;ELSE &apos;▼&apos; END' />
            </column>
