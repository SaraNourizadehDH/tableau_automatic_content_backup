            <column caption='Ultra Fresh MoM Change in GFV Share' datatype='string' name='[Tot Fresh MoM Change in GFV Share (copy)_2233363255119699989]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(AVG(IF [period] = &quot;MTD&quot; THEN ROUND([ultra_fresh_gfv_share]*100, 2) END) - &#10; AVG(IF [period] = &quot;M-1 MTD&quot; THEN ROUND([ultra_fresh_gfv_share]*100, 2) END)) &#10;/ AVG(IF [period] = &quot;M-1 MTD&quot; THEN ROUND([ultra_fresh_gfv_share]*100, 2) END) &gt;= 0&#10;THEN &apos;▲&apos; &#10;ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;(AVG(IF [period] = &quot;MTD&quot; THEN [ultra_fresh_gfv_share] END) - &#10; AVG(IF [period] = &quot;M-1 MTD&quot; THEN [ultra_fresh_gfv_share] END)&#10;) * 100, 2)&#10;)' />
            </column>
            <column caption='Ultra Fresh MoM Change in GFV Share Indicator' datatype='string' name='[Tot Fresh MoM Change in GFV Share Indicator (copy)_2233363255119699990]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(AVG(IF [period] = &quot;MTD&quot; THEN ROUND([ultra_fresh_gfv_share]*100, 2) END) - &#10; AVG(IF [period] = &quot;M-1 MTD&quot; THEN ROUND([ultra_fresh_gfv_share]*100, 2) END)) &#10;/ AVG(IF [period] = &quot;M-1 MTD&quot; THEN ROUND([ultra_fresh_gfv_share]*100, 2) END) &gt;= 0&#10;THEN &apos;▲&apos; &#10;ELSE &apos;▼&apos; END' />
