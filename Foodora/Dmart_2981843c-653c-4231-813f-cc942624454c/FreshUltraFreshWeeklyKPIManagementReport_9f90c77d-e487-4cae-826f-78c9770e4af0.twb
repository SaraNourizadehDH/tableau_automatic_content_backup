            </column>
            <column caption='Non Tot Fresh Consignment Revenue Colour Code' datatype='integer' name='[Tot Fresh Consignment Revenue Colour Code (copy)_123849007765835782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (SUM([non_tot_fresh_consignment_revenue_eur]) - [Tot Fresh L4W Avg Consignment Revenue (copy)_123849007765954567]) / [Tot Fresh L4W Avg Consignment Revenue (copy)_123849007765954567] &gt;= 0.2 THEN 2&#10;ELSEIF (SUM([non_tot_fresh_consignment_revenue_eur]) - [Tot Fresh L4W Avg Consignment Revenue (copy)_123849007765954567]) / [Tot Fresh L4W Avg Consignment Revenue (copy)_123849007765954567] &gt;= 0.1 THEN 1&#10;ELSEIF (SUM([non_tot_fresh_consignment_revenue_eur]) - [Tot Fresh L4W Avg Consignment Revenue (copy)_123849007765954567]) / [Tot Fresh L4W Avg Consignment Revenue (copy)_123849007765954567] &lt;= -0.1 THEN -1&#10;ELSEIF (SUM([non_tot_fresh_consignment_revenue_eur]) - [Tot Fresh L4W Avg Consignment Revenue (copy)_123849007765954567]) / [Tot Fresh L4W Avg Consignment Revenue (copy)_123849007765954567] &lt;= -0.2 THEN -2&#10;ELSE 0&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Non Tot Fresh L4W Avg Consignment Revenue' datatype='real' name='[Tot Fresh L4W Avg Consignment Revenue (copy)_123849007765954567]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(SUM([non_tot_fresh_consignment_revenue_eur]), FIRST(), FIRST()+4)'>
