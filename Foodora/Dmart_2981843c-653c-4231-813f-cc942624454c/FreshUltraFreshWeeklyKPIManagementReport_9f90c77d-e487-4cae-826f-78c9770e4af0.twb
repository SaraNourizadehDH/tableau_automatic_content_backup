            <column caption='Dmart L4W Avg Order Frequency' datatype='real' name='[Tot Fresh L4W Avg Order Frequency (copy)_2233363255365488703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(AVG([dmart_frequency]), FIRST(), FIRST()+4)'>
