              <calculation class='tableau' formula='IF &#10;(AVG(IF [period] = &quot;MTD&quot; THEN ROUND([tot_fresh_wa] * 100, 2) END) - &#10; AVG(IF [period] = &quot;M-1 MTD&quot; THEN ROUND([tot_fresh_wa] * 100, 2) END)) &#10;/ AVG(IF [period] = &quot;M-1 MTD&quot; THEN ROUND([tot_fresh_wa] * 100, 2) END) &gt;= 0&#10;THEN &apos;▲&apos; &#10;ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;(AVG(IF [period] = &quot;MTD&quot; THEN [tot_fresh_wa] END) - &#10; AVG(IF [period] = &quot;M-1 MTD&quot; THEN [tot_fresh_wa] END)&#10;) * 100, 2)&#10;)' />
            </column>
            <column caption='Tot Fresh MoM Change in WA Indicator' datatype='string' name='[Tot Fresh MoM Change in SWA Indicator (copy)_344736522334679041]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(AVG(IF [period] = &quot;MTD&quot; THEN ROUND([tot_fresh_wa] * 100, 2) END) - &#10; AVG(IF [period] = &quot;M-1 MTD&quot; THEN ROUND([tot_fresh_wa] * 100, 2) END)) &#10;/ AVG(IF [period] = &quot;M-1 MTD&quot; THEN ROUND([tot_fresh_wa] * 100, 2) END) &gt;= 0&#10;THEN &apos;▲&apos; &#10;ELSE &apos;▼&apos; END' />
