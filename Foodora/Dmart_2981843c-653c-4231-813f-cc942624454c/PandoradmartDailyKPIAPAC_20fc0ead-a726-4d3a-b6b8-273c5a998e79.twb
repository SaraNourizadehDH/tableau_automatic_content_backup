            <column-instance column='[vfr- same day last week growth (symbol)  (copy)_4621115451932373005]' derivation='User' name='[usr:vfr- same day last week growth (symbol)  (copy)_4621115451932373005:nk]' pivot='key' type='nominal' />
            <column caption='wa - same day last week growth (display)' datatype='string' name='[vfr - same day last week growth (display) (copy)_4621115451932373004]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[vfr- same day last week growth (symbol)  (copy)_4621115451932373005]&#10;+ &#10;&#10;&apos; &apos;&#10;&#10;+ &#10;&#10;str([vfr - same day last week growth (value) (copy)_4621115451932373006])' />
