            <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
            <column caption='platform order contribution' datatype='real' default-format='p0.00%' name='[platform GMV contribution (copy)_4621115451921932289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([valid_orders]) / SUM([platform_valid_orders])' />
            </column>
            <column datatype='integer' name='[platform_valid_orders]' role='measure' type='quantitative' />
            <column datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[platform GMV contribution (copy)_4621115451921932289]' derivation='User' name='[usr:platform GMV contribution (copy)_4621115451921932289:qk]' pivot='key' type='quantitative' />
