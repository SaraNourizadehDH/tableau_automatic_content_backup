      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (pandata_report)' name='federated.056an7j0fl7nfz194mkw11wrkh5e' />
          </datasources>
          <datasource-dependencies datasource='federated.056an7j0fl7nfz194mkw11wrkh5e'>
            <column caption='dates - d-1' datatype='integer' name='[Calculation_6888396387513438211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [report_date]&#10;WHEN today()-1 THEN 1&#10;else 0 end' />
            </column>
            <column caption='dates - 1' datatype='integer' name='[Calculation_6888396387522543622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Yest vs Same Day Last Week' />
              </aliases>
            </column>
            <column caption='dates - w-1' datatype='integer' name='[dates - d-1 (copy)_6888396387513667588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [report_date]&#10;WHEN today()-8 THEN 1 &#10;else 0 end' />
            </column>
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_6888396387522543622]' derivation='None' name='[none:Calculation_6888396387522543622:ok]' pivot='key' type='ordinal' />
