              <calculation class='tableau' formula='round((&#10;    (SUM(IF [Calculation_6888396387513438211] = 1 THEN [backend_delivered_quantity] ELSE 0 END) /&#10;    SUM(IF [Calculation_6888396387513438211] = 1 THEN [valid_orders] ELSE 0 END))&#10;    /&#10;    (SUM(IF [dates - d-1 (copy)_6888396387513667588] = 1 THEN [backend_delivered_quantity] ELSE 0 END) /&#10;    SUM(IF [dates - d-1 (copy)_6888396387513667588] = 1 THEN [valid_orders] ELSE 0 END))&#10;) - 1,2)' />
