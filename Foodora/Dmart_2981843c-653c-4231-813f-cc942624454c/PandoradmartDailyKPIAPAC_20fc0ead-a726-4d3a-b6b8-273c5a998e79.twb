            <column caption='dates - w-1' datatype='integer' name='[dates - d-1 (copy)_6888396387513667588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [report_date]&#10;WHEN today()-8 THEN 1 &#10;else 0 end' />
            </column>
            <column caption='abs - same day last week growth (display)' datatype='string' name='[delivery time - same day last week growth (display) (copy)_2235896507036479503]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[delivery time - same day last week growth (symbol) (copy)_2235896507036479504]&#10;+ &#10;&#10;&apos; &apos;&#10;&#10;+ &#10;&#10;str([delivery time - same day last week growth (value) (copy)_2235896507036479505])' />
