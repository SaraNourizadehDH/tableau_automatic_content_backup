              <calculation class='tableau' formula='if ([vfr (copy)_6888396387594723355] - [vfr - l7d avg (copy)_6888396387594723356]) / [vfr - l7d avg (copy)_6888396387594723356] &gt;= 0.2 then 2&#10;elseif ([vfr (copy)_6888396387594723355] - [vfr - l7d avg (copy)_6888396387594723356]) / [vfr - l7d avg (copy)_6888396387594723356] &lt;= -0.2 then -2&#10;elseif ([vfr (copy)_6888396387594723355] - [vfr - l7d avg (copy)_6888396387594723356]) / [vfr - l7d avg (copy)_6888396387594723356] &lt;= -0.1 then -1&#10;elseif ([vfr (copy)_6888396387594723355] - [vfr - l7d avg (copy)_6888396387594723356]) / [vfr - l7d avg (copy)_6888396387594723356] &gt;= 0.1 then 1&#10;else 0&#10;end'>
