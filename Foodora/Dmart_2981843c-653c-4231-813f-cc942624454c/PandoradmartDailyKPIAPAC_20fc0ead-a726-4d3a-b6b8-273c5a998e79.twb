            <column datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_212372892027543572]' derivation='User' name='[usr:Calculation_212372892027543572:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.056an7j0fl7nfz194mkw11wrkh5e].[vfr - l7d avg (copy)_6888396387594723356]' ordering-type='Rows' />
