            <column caption='abs' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[delivery time (copy)_2235896507036479500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([backend_delivered_quantity]) / SUM([valid_orders])' />
            </column>
            <column caption='abs - colour grade' datatype='integer' name='[delivery time - colour grade (copy)_2235896507036479501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ([delivery time (copy)_2235896507036479500] - [delivery time - l7d avg (copy)_2235896507036479502]) / [delivery time - l7d avg (copy)_2235896507036479502] &gt;= 0.2 then 2&#10;elseif ([delivery time (copy)_2235896507036479500] - [delivery time - l7d avg (copy)_2235896507036479502]) / [delivery time - l7d avg (copy)_2235896507036479502] &lt;= -0.2 then -2&#10;elseif ([delivery time (copy)_2235896507036479500] - [delivery time - l7d avg (copy)_2235896507036479502]) / [delivery time - l7d avg (copy)_2235896507036479502] &lt;= -0.1 then -1&#10;elseif ([delivery time (copy)_2235896507036479500] - [delivery time - l7d avg (copy)_2235896507036479502]) / [delivery time - l7d avg (copy)_2235896507036479502] &gt;= 0.1 then 1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='abs - l7d avg' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[delivery time - l7d avg (copy)_2235896507036479502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(SUM([backend_delivered_quantity]) / SUM([valid_orders]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
