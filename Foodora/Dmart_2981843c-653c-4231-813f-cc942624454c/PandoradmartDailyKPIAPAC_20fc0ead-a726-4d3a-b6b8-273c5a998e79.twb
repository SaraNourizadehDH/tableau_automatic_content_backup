              <calculation class='tableau' formula='if ([ontime (copy)_2235896507069845544] - [ontime - l7d avg (copy)_2235896507069845545]) / [ontime - l7d avg (copy)_2235896507069845545] &gt;= 0.2 then 2&#10;elseif ([ontime (copy)_2235896507069845544] - [ontime - l7d avg (copy)_2235896507069845545]) / [ontime - l7d avg (copy)_2235896507069845545] &lt;= -0.2 then -2&#10;elseif ([ontime (copy)_2235896507069845544] - [ontime - l7d avg (copy)_2235896507069845545]) / [ontime - l7d avg (copy)_2235896507069845545] &lt;= -0.1 then -1&#10;elseif ([ontime (copy)_2235896507069845544] - [ontime - l7d avg (copy)_2235896507069845545]) / [ontime - l7d avg (copy)_2235896507069845545] &gt;= 0.1 then 1&#10;else 0&#10;end'>
