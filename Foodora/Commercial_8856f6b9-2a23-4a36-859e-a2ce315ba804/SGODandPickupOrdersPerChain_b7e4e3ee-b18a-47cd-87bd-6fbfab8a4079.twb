      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Singapore&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Total Orders' caption='Sort By Specific Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;total_orders&quot;'>
          <calculation class='tableau' formula='&quot;total_orders&quot;' />
          <aliases>
            <alias key='&quot;AFV&quot;' value='Overall AFV' />
            <alias key='&quot;Commission&quot;' value='Average Commission' />
            <alias key='&quot;GPO&quot;' value='Overall GP' />
            <alias key='&quot;GPO_OD&quot;' value='GP of OD' />
            <alias key='&quot;GPO_PU&quot;' value='GP of PU' />
            <alias key='&quot;OD_orders&quot;' value='Total OD orders' />
            <alias key='&quot;PU_orders&quot;' value='Total PU orders' />
            <alias key='&quot;total_orders&quot;' value='Total Orders' />
          </aliases>
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='country_SG_orders_by_expedition_dashboard' id='country_SG_orders_by_expedition_dashboard_AC7C65F8844447748FF21CFDEE668BF5'>
            <properties context=''>
              <relation connection='bigquery.1ce5a8b1a95v6p1c0nwpk1v5yvk8' name='Custom SQL Query' type='text'>WITH tier_contract AS (

  SELECT

    v.vendor_code,
    v.title AS vendor_name,

    CASE
      WHEN chains.chain_code IS NOT NULL THEN chains.chain_code
      ELSE v.vendor_code
    END AS chain_code,

    CASE
      WHEN chains.title IS NOT NULL THEN chains.title
      ELSE v.title
    END AS chain_name,

    perf.gmvclass__c AS gmv_class,
    c.name__c AS name,
    c.commission_type__c AS commission_type,
    c.status,
    CAST(t.min__c AS NUMERIC) AS min_amount_needed,
    CAST(t.max__c AS NUMERIC)  AS max_amount,
    t.commission_in_percentage__c  AS commission_percentage,
    startdate AS start_date_local,

    CASE
      WHEN end_date__c IS NULL THEN CURRENT_DATE() - 1
      ELSE end_date__c
    END AS end_date_local

  FROM `fulfillment-dwh-production.curated_data_shared_salesforce.account` a

  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.platform_performance__c` perf
    ON LOWER(a.grid__c) = LOWER(perf.grid__c)
    AND LOWER(perf.country_code) = &apos;sg&apos;

  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
    ON a.id = c.accountid
    AND LOWER(a.country_code) = LOWER(c.country_code)
    AND LOWER(c.country_code) = &apos;sg&apos;

  LEFT JOIN `fulfillment-dwh-production.pandata_curated.vdr_svc_vendors` v
    ON SPLIT(a.backend_id__c, &quot;-&quot;)[SAFE_OFFSET(1)] = v.vendor_code
    AND a.global_entity_id = v.global_entity_id
    AND v.global_entity_id = &apos;FP_SG&apos;

  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.tier__c` t
    ON c.id = t.id_contract__c

  WHERE a.global_entity_id = &apos;FP_SG&apos;
    AND LOWER(c.name__c) LIKE &apos;%tier%&apos;
    AND c.status NOT IN (&apos;Terminated&apos;)
    AND v.is_active = TRUE

),

pu_orders AS (

  SELECT

    FORMAT_DATE(&quot;%b - %Y&quot;, date_local) AS month,
    vendor_business_type,

    CASE
      WHEN pu.chain_code IS NULL THEN pu.vendor_code
      ELSE pu.chain_code
    END AS chain_code,

    CASE
      WHEN pu.chain_name IS NULL THEN pu.vendor_name
      ELSE pu.chain_name
    END AS chain_name,

    CASE
      WHEN ((t.vendor_code IS NOT NULL) AND (pu.date_local BETWEEN t.start_date_local AND t.end_date_local) AND (pu.billing_source = &apos;SAP&apos;)) THEN 1
      WHEN ((t.vendor_code IS NOT NULL) AND (pu.date_local NOT BETWEEN t.start_date_local AND t.end_date_local) AND (pu.billing_source = &apos;SAP&apos;)) THEN 1
      WHEN (t.vendor_code IS NULL) THEN 1
      ELSE 0
    END AS applicable,

    commission_local,
    commission_base_local,
    pu.gfv_local,
    flgp.gpo,
    order_code,
    flgp.flgpo

  FROM `fulfillment-dwh-production.pandata_report.country_SG_pu_commission_gp` pu

  LEFT JOIN tier_contract t
    ON pu.vendor_code = t.vendor_code
  
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_flgpo_order_level` flgp 
    ON pu.order_code = flgp.code
    AND flgp.order_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)

  WHERE date_local &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)

  QUALIFY ROW_NUMBER() OVER(PARTITION BY order_code) = 1

),

pu_details AS (

  SELECT

    month,
    vendor_business_type,
    chain_code,
    chain_name,
    ROUND(SAFE_DIVIDE(SUM(CASE WHEN applicable = 1 THEN commission_local END), COUNT(DISTINCT CASE WHEN applicable = 1 THEN order_code END)),2) AS avg_commission_pu,
    ROUND(SAFE_DIVIDE(SUM(CASE WHEN applicable = 1 THEN commission_local END), SUM(CASE WHEN applicable = 1 THEN commission_base_local END)),4)*100 AS avg_commission_rate_pu,
    ROUND(SAFE_DIVIDE(SUM(gfv_local), COUNT(DISTINCT order_code)),2) AS afv_pu,
    ROUND(SAFE_DIVIDE(SUM(CASE WHEN applicable = 1 THEN gpo END), COUNT(DISTINCT CASE WHEN applicable = 1 THEN order_code END)),2) AS avg_gpo_pu,
    ROUND(SAFE_DIVIDE(SUM(CASE WHEN applicable = 1 THEN flgpo END), COUNT(DISTINCT CASE WHEN applicable = 1 THEN order_code END)),2) AS avg_full_load_gpo_pu,
    COUNT(DISTINCT order_code) AS no_of_pu_orders

  FROM pu_orders

  GROUP BY 1,2,3,4

),

od_orders AS (

  SELECT

    FORMAT_DATE(&quot;%b - %Y&quot;, date_local) AS month,
    vendor_business_type,

    CASE
      WHEN gp.chain_code IS NULL THEN gp.vendor_code
      ELSE gp.chain_code
    END AS chain_code,

    CASE
      WHEN gp.chain_name IS NULL THEN gp.vendor_name
      ELSE gp.chain_name
    END AS chain_name,

    CASE
      WHEN ((t.vendor_code IS NOT NULL) AND (gp.date_local BETWEEN t.start_date_local AND t.end_date_local) AND (gp.billing_source = &apos;SAP&apos;)) THEN 1
      WHEN ((t.vendor_code IS NOT NULL) AND (gp.date_local NOT BETWEEN t.start_date_local AND t.end_date_local) AND (gp.billing_source = &apos;SAP&apos;)) THEN 1
      WHEN (t.vendor_code IS NULL) THEN 1
      ELSE 0 END AS applicable,

    commission_local,
    commission_base_local,
    gp.gfv_local,
    flgp.gpo,
    order_code,
    flgp.flgpo

  FROM `fulfillment-dwh-production.pandata_report.country_SG_resto_gross_profit_per_order` gp

  LEFT JOIN tier_contract t
    ON gp.vendor_code = t.vendor_code
  
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_flgpo_order_level` flgp 
    ON gp.order_code = flgp.code
    AND flgp.order_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)

  WHERE date_local &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH)

  QUALIFY ROW_NUMBER() OVER(PARTITION BY order_code) = 1

),

od_details AS (

  SELECT

    month,
    vendor_business_type,
    chain_code,
    chain_name,
    ROUND(SAFE_DIVIDE(SUM(CASE WHEN applicable = 1 THEN commission_local END), COUNT(DISTINCT CASE WHEN applicable = 1 THEN order_code END)),2) AS avg_commission_od,
    ROUND(SAFE_DIVIDE(SUM(CASE WHEN applicable = 1 THEN commission_local END), sum(CASE WHEN applicable = 1 THEN commission_base_local END)),4)*100 AS avg_commission_rate_od,
    ROUND(SAFE_DIVIDE(SUM(gfv_local), COUNT(DISTINCT order_code)),2) AS afv_od,
    ROUND(SAFE_DIVIDE(SUM(CASE WHEN applicable = 1 THEN gpo END),COUNT(DISTINCT CASE WHEN applicable = 1 THEN order_code END)),2) AS avg_gpo_od,
    ROUND(SAFE_DIVIDE(SUM(CASE WHEN applicable = 1 THEN flgpo END),COUNT(DISTINCT CASE WHEN applicable = 1 THEN order_code END)),2) AS avg_full_load_gpo_od,
    COUNT(DISTINCT order_code) AS no_of_od_orders

  FROM od_orders
  GROUP BY 1,2,3,4

)

SELECT

  CASE
    WHEN od.month IS NULL THEN pu.month
    ELSE od.month
  END AS month,

  CASE
    WHEN od.chain_code IS NULL THEN pu.chain_code
    ELSE od.chain_code
  END AS chain_code,

  CASE
    WHEN od.chain_name IS NULL THEN pu.chain_name
    ELSE od.chain_name
  END AS chain_name,

  CASE
    WHEN od.vendor_business_type IS NULL THEN pu.vendor_business_type
    ELSE od.vendor_business_type
  END AS vertical_type,

  od.no_of_od_orders AS OD_orders,
  od.avg_commission_od AS avg_commission_OD,
  od.avg_commission_rate_od AS avg_commission_rate_OD,
  od.afv_od AS AFV_OD,
  od.avg_gpo_od AS GPO_OD,
  od.avg_full_load_gpo_od AS full_GPO_OD,
  pu.no_of_pu_orders AS PU_orders,
  pu.avg_commission_pu AS avg_commission_PU,
  pu.avg_commission_rate_pu AS avg_commission_rate_PU,
  pu.afv_pu AS AFV_PU,
  pu.avg_gpo_pu AS GPO_PU,
  pu.avg_full_load_gpo_pu AS full_GPO_PU

FROM od_details od

FULL OUTER JOIN pu_details pu
  ON od.month = pu.month
  AND od.chain_code = pu.chain_code</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Overall Orders'>
      <table>
        <view>
          <datasources>
            <datasource caption='OD and Pickup Orders' name='federated.1xq6zsq0xr4f6g1cjovby1lni02r' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Total Orders' caption='Sort By Specific Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;total_orders&quot;'>
              <calculation class='tableau' formula='&quot;total_orders&quot;' />
              <aliases>
                <alias key='&quot;AFV&quot;' value='Overall AFV' />
                <alias key='&quot;Commission&quot;' value='Average Commission' />
                <alias key='&quot;GPO&quot;' value='Overall GP' />
                <alias key='&quot;GPO_OD&quot;' value='GP of OD' />
                <alias key='&quot;GPO_PU&quot;' value='GP of PU' />
                <alias key='&quot;OD_orders&quot;' value='Total OD orders' />
                <alias key='&quot;PU_orders&quot;' value='Total PU orders' />
                <alias key='&quot;total_orders&quot;' value='Total Orders' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xq6zsq0xr4f6g1cjovby1lni02r'>
            <column caption='Afv Od' datatype='real' name='[AFV_OD]' role='measure' type='quantitative' />
            <column caption='Afv Pu' datatype='real' name='[AFV_PU]' role='measure' type='quantitative' />
            <column caption='Total Orders' datatype='integer' name='[Calculation_190769666652733440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([OD_orders],0) + IFNULL([PU_orders],0)' />
            </column>
            <column caption='GPO' datatype='real' name='[Calculation_190769666653237249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((IFNULL([GPO_OD],0)*IFNULL([OD_orders],0))+(IFNULL([GPO_PU],0)*IFNULL([PU_orders],0)))/(IFNULL([OD_orders],0)+IFNULL([PU_orders],0))' />
            </column>
            <column caption='Sort By Field' datatype='real' name='[Calculation_190769666659495938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;total_orders&apos; then SUM([Calculation_190769666652733440])&#10;WHEN &apos;AFV&apos; then AVG([Calculation_190769666659655683])&#10;WHEN &apos;Commission&apos; then AVG([Calculation_190769666659721220])&#10;WHEN &apos;GPO&apos; then AVG([Calculation_190769666653237249])&#10;WHEN &apos;OD_orders&apos; then SUM([OD_orders])&#10;WHEN &apos;PU_orders&apos; then SUM([PU_orders])&#10;WHEN &apos;GPO_OD&apos; then AVG([GPO_OD])&#10;WHEN &apos;GPO_PU&apos; then AVG([GPO_PU])&#10;END' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_190769666659655683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(([AFV_OD]*[OD_orders])+([AFV_PU]+[PU_orders]))/([OD_orders]+[PU_orders])' />
            </column>
            <column caption='Commission' datatype='real' name='[Calculation_190769666659721220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(([avg_commission_OD]*[OD_orders])+([avg_commission_PU]*[PU_orders]))/([OD_orders]+[PU_orders])' />
            </column>
            <column caption='FLGPO' datatype='real' name='[GPO (copy)_3535325718632632321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((IFNULL([full_GPO_OD],0)*IFNULL([OD_orders],0))+(IFNULL([full_GPO_PU],0)*IFNULL([PU_orders],0)))/(IFNULL([OD_orders],0)+IFNULL([PU_orders],0))' />
            </column>
