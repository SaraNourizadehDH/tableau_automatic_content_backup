      <table>
        <view>
          <datasources>
            <datasource caption='Vendor Level Session Metrics' name='federated.01t8cig1ylo72z1fyza3f0pte7hj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Vertical Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Delivery&quot;'>
              <calculation class='tableau' formula='&quot;Delivery&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.01t8cig1ylo72z1fyza3f0pte7hj].[date_local]' caption='Start Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2025-02-18#'>
              <calculation class='tableau' formula='#2025-02-18#' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.01t8cig1ylo72z1fyza3f0pte7hj].[date_local]' caption='End Date' datatype='date' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='#2025-02-18#'>
              <calculation class='tableau' formula='#2025-02-18#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.01t8cig1ylo72z1fyza3f0pte7hj'>
            <column caption='CVR3 Pickup' datatype='real' name='[Calculation_1570419284482203649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([transaction_no_pu]) / sum([shop_menu_no_pu])' />
            </column>
            <column caption='mCVR3 PU' datatype='real' name='[Calculation_1570419284482338819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([transaction_no_pu]) / sum([shop_menu_no_pu])' />
            </column>
            <column caption='mCVR4 PU' datatype='real' name='[Calculation_1570419284482433028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([transaction_no_pu]) / sum([checkout_loaded_no_pu])' />
            </column>
            <column caption='CP_TimeLine' datatype='boolean' name='[Calculation_1570419284483932169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;, DATE([date_local]))&gt;=[Parameters].[Parameter 2] AND DATETRUNC(&apos;day&apos;, DATE([date_local]))&lt;=[Parameters].[Parameter 3]' />
            </column>
            <column caption='Shop Menu - Vertical' datatype='integer' name='[Calculation_1570419284490596362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Delivery&apos; THEN [shop_menu_no]&#10;WHEN &apos;Pickup&apos; THEN [shop_menu_no_pu]&#10;END' />
            </column>
            <column caption='CVR3 - Vertical' datatype='real' name='[Calculation_1570419284490805259]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Delivery&apos; THEN [Calculation_6691926901270831106]&#10;WHEN &apos;Pickup&apos; THEN [Calculation_1570419284482203649]&#10;END' />
            </column>
            <column caption='mCVR3 - Vertical' datatype='real' name='[Calculation_1570419284490952716]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Delivery&apos; THEN [Calculation_6691926901270966275]&#10;WHEN &apos;Pickup&apos; THEN [Calculation_1570419284482338819]&#10;END' />
            </column>
            <column caption='mCVR4 - Vertical' datatype='real' name='[Calculation_1570419284491067405]' role='measure' type='quantitative'>
