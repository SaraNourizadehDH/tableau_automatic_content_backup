      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.01t8cig1ylo72z1fyza3f0pte7hj].[sum:Calculation_1570419284490596362:qk]&quot;' value='Menu Opens' />
          <alias key='&quot;[federated.01t8cig1ylo72z1fyza3f0pte7hj].[sum:shop_menu_no:qk]&quot;' value='Menu Open' />
          <alias key='&quot;[federated.01t8cig1ylo72z1fyza3f0pte7hj].[usr:Calculation_1570419284490805259:qk]&quot;' value='CVR3' />
          <alias key='&quot;[federated.01t8cig1ylo72z1fyza3f0pte7hj].[usr:Calculation_1570419284490952716:qk]&quot;' value='mCVR3' />
          <alias key='&quot;[federated.01t8cig1ylo72z1fyza3f0pte7hj].[usr:Calculation_1570419284491067405:qk]&quot;' value='mCVR4' />
        </aliases>
      </column>
      <column caption='Team' datatype='string' name='[Calculation_1570419284477988864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF team in (&apos;Inside Sales&apos;, &apos;Sales&apos;, &apos;Sales Ops&apos;) THEN &apos;Sales&apos;&#10;ELSEIF team in (&apos;Shops&apos;, &apos;Shops - KAM&apos;) THEN &apos;Shops&apos;&#10;ELSEIF team in (&apos;Incubation&apos;, &apos;Vendor Incubation&apos;) THEN &apos;Incubation&apos;&#10;ELSE team END' />
      </column>
      <column caption='CVR3 Pickup' datatype='real' name='[Calculation_1570419284482203649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([transaction_no_pu]) / sum([shop_menu_no_pu])' />
      </column>
      <column caption='mCVR3 PU' datatype='real' name='[Calculation_1570419284482338819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([transaction_no_pu]) / sum([shop_menu_no_pu])' />
      </column>
      <column caption='mCVR4 PU' datatype='real' name='[Calculation_1570419284482433028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([transaction_no_pu]) / sum([checkout_loaded_no_pu])' />
      </column>
      <column caption='Median CVR3 PU' datatype='real' name='[Calculation_1570419284482703365]' role='measure' type='quantitative'>
