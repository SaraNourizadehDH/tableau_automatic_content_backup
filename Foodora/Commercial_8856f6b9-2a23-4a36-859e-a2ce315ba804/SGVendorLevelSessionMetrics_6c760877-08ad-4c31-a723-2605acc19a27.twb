    <worksheet name='Median CVR3'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Medium' fontsize='20'>Median CVR3</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Vendor Level Session Metrics' name='federated.01t8cig1ylo72z1fyza3f0pte7hj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Vertical Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Delivery&quot;'>
              <calculation class='tableau' formula='&quot;Delivery&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.01t8cig1ylo72z1fyza3f0pte7hj].[date_local]' caption='Start Date' datatype='date' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='#2025-02-18#'>
              <calculation class='tableau' formula='#2025-02-18#' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.01t8cig1ylo72z1fyza3f0pte7hj].[date_local]' caption='End Date' datatype='date' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='#2025-02-18#'>
              <calculation class='tableau' formula='#2025-02-18#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.01t8cig1ylo72z1fyza3f0pte7hj'>
            <column caption='Team' datatype='string' name='[Calculation_1570419284477988864]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF team in (&apos;Inside Sales&apos;, &apos;Sales&apos;, &apos;Sales Ops&apos;) THEN &apos;Sales&apos;&#10;ELSEIF team in (&apos;Shops&apos;, &apos;Shops - KAM&apos;) THEN &apos;Shops&apos;&#10;ELSEIF team in (&apos;Incubation&apos;, &apos;Vendor Incubation&apos;) THEN &apos;Incubation&apos;&#10;ELSE team END' />
            </column>
            <column caption='CP_TimeLine' datatype='boolean' name='[Calculation_1570419284483932169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;, DATE([date_local]))&gt;=[Parameters].[Parameter 2] AND DATETRUNC(&apos;day&apos;, DATE([date_local]))&lt;=[Parameters].[Parameter 3]' />
            </column>
            <column caption='LOD - Median CVR Vertical' datatype='real' name='[Calculation_6317424409426739214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Delivery&apos; THEN [LOD Average CVR (copy)_6317424409423810567]&#10;WHEN &apos;Pickup&apos; THEN [LOD Median CVR (copy)_6317424409426563084]&#10;END' />
            </column>
            <column caption='LOD - CVR (PU)' datatype='real' name='[LOD - CVR (copy)_6317424409426313225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE [chain_code] : SUM([transaction_no_pu]) / SUM([shop_menu_no_pu])}' />
            </column>
            <column caption='LOD - CVR' datatype='real' name='[LOD - Total Number of Shop Menu (copy)_6317424409423392773]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE [chain_code] : SUM([transaction_no]) / SUM([shop_menu_no])}' />
            </column>
            <column caption='LOD Median CVR' datatype='real' name='[LOD Average CVR (copy)_6317424409423810567]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN([LOD - Total Number of Shop Menu (copy)_6317424409423392773])' />
            </column>
            <column caption='LOD Median CVR (PU)' datatype='real' name='[LOD Median CVR (copy)_6317424409426563084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN([LOD - CVR (copy)_6317424409426313225])' />
            </column>
            <column caption='Chain Code' datatype='string' name='[chain_code]' role='dimension' type='nominal' />
            <column caption='Date Local' datatype='date' name='[date_local]' role='dimension' type='ordinal' />
