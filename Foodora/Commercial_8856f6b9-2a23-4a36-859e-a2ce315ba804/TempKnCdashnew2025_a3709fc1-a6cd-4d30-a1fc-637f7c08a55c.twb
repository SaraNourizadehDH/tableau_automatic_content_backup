    <worksheet name='KPI Deep Dive Level'>
      <repository-location id='KPIDeepDiveLevel' path='/t/Foodora/workbooks/TempKnCdashnew2025' revision='' site='Foodora' />
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#d70f64'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='country_BD_vendor_level_basic_kpi (pandata_report)' name='federated.0g43esi1k3q1qc19y4tg708nyy1v' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Dynamic Date Selector (copy)_4152529998772572172]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendor Level&quot;'>
              <calculation class='tableau' formula='&quot;Vendor Level&quot;' />
            </column>
            <column caption='Dynamic Date Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0g43esi1k3q1qc19y4tg708nyy1v'>
            <column caption='AFV' datatype='real' name='[Calculation_4152529996996321285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv])/SUM([orders])' />
            </column>
            <column caption='Date Granularity' datatype='datetime' name='[Calculation_4152529998734688267]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN [order_date]&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[order_date])&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[order_date])&#10;END' />
            </column>
            <column caption='KPI Granularity' datatype='string' name='[Date Granularity (copy)_4152529998772936717]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dynamic Date Selector (copy)_4152529998772572172]&#10;WHEN &apos;Vendor Level&apos; THEN [vendor_name]&#10;WHEN &apos;Chain Level&apos; THEN [chain_name]&#10;WHEN &apos;Zone Level&apos; THEN [primary_zone_name]&#10;WHEN &apos;Kitchen Level&apos; THEN [kitchen_name]&#10;END' />
            </column>
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='GFV' datatype='real' name='[gfv]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Kitchen Name' datatype='string' name='[kitchen_name]' role='dimension' type='nominal' />
            <column-instance column='[Date Granularity (copy)_4152529998772936717]' derivation='None' name='[none:Date Granularity (copy)_4152529998772936717:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column caption='Order Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column caption='Orders' datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column caption='Primary Zone Name' datatype='string' name='[primary_zone_name]' role='dimension' type='nominal' />
            <column-instance column='[orders]' derivation='Sum' name='[sum:orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4152529998734688267]' derivation='Day-Trunc' name='[tdy:Calculation_4152529998734688267:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_4152529996996321285]' derivation='User' name='[usr:Calculation_4152529996996321285:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Name' datatype='string' name='[vendor_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0g43esi1k3q1qc19y4tg708nyy1v].[:Measure Names]'>
