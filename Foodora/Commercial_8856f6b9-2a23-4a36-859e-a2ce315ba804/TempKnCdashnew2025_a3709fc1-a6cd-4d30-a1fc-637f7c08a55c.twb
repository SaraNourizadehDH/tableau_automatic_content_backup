            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0g43esi1k3q1qc19y4tg708nyy1v'>
            <column caption='OGV' datatype='integer' name='[Calculation_4152529996987547649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [orders] &gt; 0&#10;    THEN [Vendor_code]&#10;END )' />
            </column>
            <column caption='Ten Minute Delayed %' datatype='real' name='[Calculation_4152529996989116419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ten_minute_delayed_orders])/SUM([orders])' />
            </column>
            <column caption='VFS over GMV Net' datatype='real' name='[Calculation_4152529996989661188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_fundend_deals_with_bogo])/SUM([gmv_net_local])' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_4152529996996321285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv])/SUM([orders])' />
            </column>
            <column caption='iCRev%' datatype='real' name='[Calculation_4152529997000499206]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL((&#10;SUM(IFNULL(fp_fundend_deals,0)) &#10;)&#10;/&#10;(&#10;SUM(IFNULL([commission],0))&#10;+SUM(IFNULL([df],0))&#10;),0)' />
            </column>
            <column caption='OPD Per Outlet' datatype='real' name='[Calculation_4152529997001814024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/[Calculation_4152529996987547649]' />
            </column>
            <column caption='Offline %' datatype='real' name='[Calculation_4152529997009276938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(closed_hour)/SUM(scheduled_hours)' />
            </column>
            <column caption='Date Granularity' datatype='datetime' name='[Calculation_4152529998734688267]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN [order_date]&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[order_date])&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[order_date])&#10;END' />
            </column>
            <column caption='OPD Per Chain (Brand)' datatype='real' name='[OPD Per Outlet (copy)_4152529997003104265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/&#10;COUNTD(&#10;IF [orders] &gt;0&#10;THEN [chain_code] END&#10;)' />
            </column>
