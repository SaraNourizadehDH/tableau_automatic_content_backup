      <column caption='Ads GFV delta%' datatype='real' name='[GFV delta% （複製）_1123155553736429575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[參數 4] = &quot;MoM&quot; THEN &#10;(SUM([ads_gfv]) - LOOKUP(SUM([ads_gfv]), 1)) &#10;/ ABS(LOOKUP(SUM([ads_gfv]), 1))&#10;&#10;ELSEIF [Parameters].[參數 4] = &quot;YoY&quot; THEN &#10;(SUM([ads_gfv]) - LOOKUP(SUM([ads_gfv]), 12)) &#10;/ ABS(LOOKUP(SUM([ads_gfv]), 12))&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Config Metric diff all %' datatype='real' name='[Metric diff % （複製）_173951536914030607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Non Config Metrics （複製）_148407748596113409]) - SUM([Pre Metrics （複製）_148407748594470912])) / SUM([Pre Metrics （複製）_148407748594470912])' />
      </column>
      <column caption='Ads New Customer +delta%' datatype='string' name='[New Customer +delta% （複製）_1123155553739419666]' role='measure' type='nominal'>
