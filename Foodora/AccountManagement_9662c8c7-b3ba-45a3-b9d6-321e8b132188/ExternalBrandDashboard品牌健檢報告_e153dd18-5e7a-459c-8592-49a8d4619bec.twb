              <calculation class='tableau' formula='IF [mCVR4 delta% （複製）_292593294149165071] &lt;= 0 THEN&#10;&quot;▼ &quot; + STR(ROUND([mCVR4 delta% （複製）_292593294149165071]*100, 1)) + &quot;%&quot;&#10;END'>
