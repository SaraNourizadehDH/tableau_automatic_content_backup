              <calculation class='tableau' formula='IF [Vendor Fail Rate delta% （複製）_138133904529551375] &gt; 0 THEN&#10;&quot;▲ &quot; + STR(ROUND([Vendor Fail Rate delta% （複製）_138133904529551375]*100, 1)) + &quot;%&quot;&#10;END'>
