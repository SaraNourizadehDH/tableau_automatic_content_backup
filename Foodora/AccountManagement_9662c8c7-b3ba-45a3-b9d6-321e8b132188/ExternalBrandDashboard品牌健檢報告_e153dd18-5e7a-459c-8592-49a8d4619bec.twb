      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='markets__country_TW_commercial_vendor_performance_monthly' name='sqlproxy.0t36og20ttpwuv1475ahw0otgxt5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Target Brand Name' datatype='string' name='[Target Brand Group （複製）_145311521471471621]' param-domain-type='any' role='measure' type='nominal' value='&quot;請輸入Brand Name或全店家&quot;'>
              <calculation class='tableau' formula='&quot;請輸入Brand Name或全店家&quot;' />
            </column>
            <column caption='Password' datatype='string' name='[參數 3]' param-domain-type='any' role='measure' type='nominal' value='&quot;00000000&quot;'>
              <calculation class='tableau' formula='&quot;00000000&quot;' />
            </column>
            <column alias='顯示 Display' caption='顯示/隱藏市場趨勢' datatype='string' datatype-customized='true' name='[參數 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;顯示市場趨勢&quot;'>
              <calculation class='tableau' formula='&quot;顯示市場趨勢&quot;' />
              <aliases>
                <alias key='&quot;隱藏市場趨勢&quot;' value='隱藏 Hide' />
                <alias key='&quot;顯示市場趨勢&quot;' value='顯示 Display' />
              </aliases>
            </column>
            <column caption='Target Brand Group' datatype='string' name='[連鎖品牌 （複製）]' param-domain-type='any' role='measure' type='nominal' value='&quot;請輸入Brand Group&quot;'>
              <calculation class='tableau' formula='&quot;請輸入Brand Group&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0t36og20ttpwuv1475ahw0otgxt5'>
            <column caption='is_market_trend_display' datatype='boolean' name='[Calculation_3152379032774799372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[參數 5] = &quot;顯示市場趨勢&quot;' />
            </column>
            <column caption='is_target_brand_group' datatype='boolean' name='[Calculation_487233240156688384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([manual_brand_group] = [Parameters].[連鎖品牌 （複製）])&#10;AND (([is_password_match_admin （複製）_145311521384022016]) OR ([is_password_match_agent （複製）_145311521384177665] AND [is_vendor_available_brand]))' />
            </column>
            <column caption='is_target_market' datatype='boolean' name='[Calculation_6497005460862361608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_3152379032774799372]&#10;AND [is_same_cuisine_only （複製）_145311521456697348]&#10;// AND [is_market_competitors_enough]&#10;// AND [is_same_chain_only] AND [is_same_cuisine_only] AND [is_same_city_only]' />
            </column>
            <column caption='Offline Rate_target_brand' datatype='real' default-format='p0.0%' name='[Offline Rate_target_vendor （複製）_138133904595120154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [Calculation_487233240156688384] AND [is_target_brand_group （複製）_145311521471709190] THEN [offline_rate] ELSE NULL END)' />
            </column>
            <column caption='Offline Rate_market_trend' datatype='real' default-format='p0.0%' name='[Offline Rate_target_vendor （複製）_3152379032773423112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6497005460862361608] THEN [offline_rate] ELSE NULL END' />
            </column>
            <column-instance column='[Offline Rate_target_vendor （複製）_3152379032773423112]' derivation='Avg' name='[avg:Offline Rate_target_vendor （複製）_3152379032773423112:qk]' pivot='key' type='quantitative' />
            <column caption='is_password_match_admin_brand' datatype='boolean' name='[is_password_match_admin （複製）_145311521384022016]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[參數 3] = &quot;W7Bw6esA&quot;' />
            </column>
            <column caption='is_password_match_agent_brand' datatype='boolean' name='[is_password_match_agent （複製）_145311521384177665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[參數 3] = [manual_brand_password] &#10;AND [Parameters].[參數 3] != &quot;&quot; &#10;AND NOT(ISNULL([Parameters].[參數 3]))' />
            </column>
            <column caption='is_same_cuisine_only_brand' datatype='boolean' name='[is_same_cuisine_only （複製）_145311521456697348]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_487233240156688384] THEN TRUE&#10;ELSEIF [Primary Cuisine 集合 （複製）] THEN TRUE&#10;ELSE FALSE END' />
            </column>
            <column caption='is_target_brand_name' datatype='boolean' name='[is_target_brand_group （複製）_145311521471709190]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='((CONTAINS([Parameters].[Target Brand Group （複製）_145311521471471621], [manual_brand_name])) OR ([Parameters].[Target Brand Group （複製）_145311521471471621] = &quot;全店家&quot;))&#10;AND (([is_password_match_admin （複製）_145311521384022016]) OR ([is_password_match_agent （複製）_145311521384177665] AND [is_vendor_available_brand]))&#10;&#10;//([Manual Brand Name] = [Target Brand Name]' />
            </column>
            <column aggregation='Count' caption='Is Vendor Available Brand' datatype='boolean' default-type='nominal' layered='true' name='[is_vendor_available_brand]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default' />
            <column aggregation='Count' caption='Manual Brand Group' datatype='string' default-type='nominal' layered='true' name='[manual_brand_group]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' caption='Manual Brand Name' datatype='string' default-type='nominal' layered='true' name='[manual_brand_name]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' caption='Manual Brand Password' datatype='string' default-type='nominal' layered='true' name='[manual_brand_password]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column-instance column='[report_month]' derivation='MY' name='[my:report_month:ok]' pivot='key' type='ordinal' />
