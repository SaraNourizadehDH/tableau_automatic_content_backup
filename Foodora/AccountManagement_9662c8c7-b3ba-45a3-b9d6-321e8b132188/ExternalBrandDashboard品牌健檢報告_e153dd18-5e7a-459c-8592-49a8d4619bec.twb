            <column alias='倒數10間店家 Bottom 10 vendors' caption='營運落後店家顯示基準' datatype='string' name='[Target Vendor （複製）]' param-domain-type='list' role='measure' type='nominal' value='&quot;倒數10間店家&quot;'>
              <calculation class='tableau' formula='&quot;倒數10間店家&quot;' />
              <aliases>
                <alias key='&quot;PR值&lt;=10店家&quot;' value='PR值&lt;=10店家 PR value &lt;= 10%' />
                <alias key='&quot;倒數10間店家&quot;' value='倒數10間店家 Bottom 10 vendors' />
                <alias key='&quot;大於某數值店家&quot;' value='大於某數值店家 Bigger than benchmark' />
              </aliases>
            </column>
            <column alias='離線率 Offline Rate' caption='營業健康指標' datatype='string' name='[post_start_date （複製）]' param-domain-type='list' role='measure' type='nominal' value='&quot;離線率&quot;'>
              <calculation class='tableau' formula='&quot;離線率&quot;' />
              <aliases>
                <alias key='&quot;拖餐率&quot;' value='拖餐率 Delay Rate' />
                <alias key='&quot;製餐時間&quot;' value='製餐時間 APT' />
                <alias key='&quot;訂單失敗率&quot;' value='訂單失敗率 Fail Rate' />
                <alias key='&quot;離線率&quot;' value='離線率 Offline Rate' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[sqlproxy.0t36og20ttpwuv1475ahw0otgxt5].[report_month]' caption='Target Month' datatype='date' default-format='*yyyy/mm' name='[參數 2]' param-domain-type='list' role='measure' type='quantitative' value='#2025-06-01#'>
              <calculation class='tableau' formula='#2025-06-01#' />
            </column>
            <column caption='Password' datatype='string' name='[參數 3]' param-domain-type='any' role='measure' type='nominal' value='&quot;00000000&quot;'>
              <calculation class='tableau' formula='&quot;00000000&quot;' />
            </column>
            <column caption='營運健康指標數值基準' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[營業健康指標 （複製）]' param-domain-type='any' role='measure' type='quantitative' value='0.08'>
              <calculation class='tableau' formula='0.08' />
            </column>
            <column caption='Target Brand Group' datatype='string' name='[連鎖品牌 （複製）]' param-domain-type='any' role='measure' type='nominal' value='&quot;請輸入Brand Group&quot;'>
              <calculation class='tableau' formula='&quot;請輸入Brand Group&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0t36og20ttpwuv1475ahw0otgxt5'>
            <column caption='APT_target_brand' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[APT_target_vendor （複製）_138133904602890270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [Calculation_487233240156688384] AND [is_target_brand_group （複製）_145311521471709190] THEN [avg_actual_prep_time] ELSE NULL END)' />
            </column>
            <column caption='is_target_month' datatype='boolean' name='[Calculation_1248130435943194633]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_month] = [Parameters].[參數 2]' />
            </column>
            <column caption='is_target_brand_group' datatype='boolean' name='[Calculation_487233240156688384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([manual_brand_group] = [Parameters].[連鎖品牌 （複製）])&#10;AND (([is_password_match_admin （複製）_145311521384022016]) OR ([is_password_match_agent （複製）_145311521384177665] AND [is_vendor_available_brand]))' />
            </column>
            <column caption='main_operation_kpi' datatype='real' name='[Calculation_988258650616369152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[post_start_date （複製）]&#10;    WHEN &quot;離線率&quot; THEN AVG(IFNULL([offline_rate], 0))&#10;    WHEN &quot;訂單失敗率&quot; THEN AVG(IFNULL([vendor_fail_rate], 0))&#10;    WHEN &quot;拖餐率&quot; THEN AVG(IFNULL([delay_rate], 0))&#10;    WHEN &quot;製餐時間&quot; THEN [APT_target_vendor （複製）_138133904602890270]&#10;    ELSE NULL&#10;END' />
            </column>
            <column caption='index' datatype='integer' name='[Calculation_988258650657259524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='display_operation_vendor_filter' datatype='boolean' name='[Calculation_988258650660323334]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Target Vendor （複製）]&#10;    WHEN &quot;大於某數值店家&quot; THEN [Calculation_988258650616369152] &gt;= [Parameters].[營業健康指標 （複製）]&#10;    WHEN &quot;PR值&lt;=10店家&quot; THEN [main_operation_kpi （複製）_988258650662002695] &lt;= 10&#10;    WHEN &quot;倒數10間店家&quot; THEN [Calculation_988258650657259524] &lt;= 10&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='Sum' caption='Avg Actual Prep Time' datatype='real' default-format='n#,##0.0;-#,##0.0' default-type='quantitative' layered='true' name='[avg_actual_prep_time]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' caption='Delay Rate' datatype='real' default-type='quantitative' layered='true' name='[delay_rate]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column caption='is_password_match_admin_brand' datatype='boolean' name='[is_password_match_admin （複製）_145311521384022016]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[參數 3] = &quot;W7Bw6esA&quot;' />
            </column>
            <column caption='is_password_match_agent_brand' datatype='boolean' name='[is_password_match_agent （複製）_145311521384177665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[參數 3] = [manual_brand_password] &#10;AND [Parameters].[參數 3] != &quot;&quot; &#10;AND NOT(ISNULL([Parameters].[參數 3]))' />
            </column>
            <column caption='is_target_brand_name' datatype='boolean' name='[is_target_brand_group （複製）_145311521471709190]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='((CONTAINS([Parameters].[Target Brand Group （複製）_145311521471471621], [manual_brand_name])) OR ([Parameters].[Target Brand Group （複製）_145311521471471621] = &quot;全店家&quot;))&#10;AND (([is_password_match_admin （複製）_145311521384022016]) OR ([is_password_match_agent （複製）_145311521384177665] AND [is_vendor_available_brand]))&#10;&#10;//([Manual Brand Name] = [Target Brand Name]' />
            </column>
            <column aggregation='Count' caption='Is Vendor Available Brand' datatype='boolean' default-type='nominal' layered='true' name='[is_vendor_available_brand]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default' />
            <column caption='display_main_operation_kpi' datatype='string' name='[main_operation_kpi （複製）_988258650618503170]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[post_start_date （複製）]&#10;    WHEN &quot;製餐時間&quot; THEN STR(ROUND([Calculation_988258650616369152], 2))&#10;    ELSE STR(ROUND([Calculation_988258650616369152]*100, 2)) + &quot;%&quot;&#10;END' />
            </column>
            <column caption='main_operation_kpi_pr_value' datatype='real' name='[main_operation_kpi （複製）_988258650662002695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[post_start_date （複製）]&#10;    WHEN &quot;離線率&quot; THEN ROUND(RANK_PERCENTILE(AVG(IFNULL([offline_rate], 0)), &quot;DESC&quot;) * 100, 2)&#10;    WHEN &quot;訂單失敗率&quot; THEN ROUND(RANK_PERCENTILE(AVG(IFNULL([vendor_fail_rate], 0)), &quot;DESC&quot;) * 100, 2)&#10;    WHEN &quot;拖餐率&quot; THEN ROUND(RANK_PERCENTILE(AVG(IFNULL([delay_rate], 0)), &quot;DESC&quot;) * 100, 2)&#10;    WHEN &quot;製餐時間&quot; THEN ROUND(RANK_PERCENTILE([APT_target_vendor （複製）_138133904602890270], &quot;DESC&quot;) * 100, 2)&#10;    ELSE NULL&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
