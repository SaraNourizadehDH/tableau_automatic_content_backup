            </column>
            <column caption='is_target_ads' datatype='boolean' name='[Calculation_128141548912906244]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LOWER([Parameters].[KPI （複製）]) = REPLACE(LOWER([ads_product]), &quot;_&quot;, &quot; &quot;)' />
            </column>
            <column caption='Datetrunc Report Date' datatype='date' name='[Calculation_143270771536908288]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Password （複製）], &quot;(month)|(mtd)&quot;) THEN DATE(DATETRUNC(&quot;month&quot;, [report_date]))&#10;ELSEIF REGEXP_MATCH([Parameters].[Password （複製）], &quot;(week)|(wtd)&quot;) THEN DATE(DATETRUNC(&quot;iso-week&quot;, [report_date]))&#10;ELSE DATE(DATETRUNC(&quot;day&quot;, [report_date]))&#10;END' />
            </column>
            <column caption='Display Date 1' datatype='string' name='[Calculation_143270771538690049]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Password （複製）] = &quot;day&quot; THEN LEFT(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3) // 顯示 Mon, Tue, Wed...&#10;ELSE STR(YEAR([Calculation_143270771536908288])) // 顯示年份&#10;END' />
            </column>
            <column caption='Display Date 2' datatype='string' name='[Calculation_143270771538956290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Password （複製）], &quot;Monthly&quot;) THEN LEFT(DATENAME(&quot;month&quot;, [report_date]), 3)&#10;ELSEIF REGEXP_MATCH([Parameters].[Password （複製）], &quot;Weekly&quot;) THEN &quot;Week &quot; + DATENAME(&quot;iso-week&quot;, [report_date])&#10;ELSEIF [Parameters].[Password （複製）] = &quot;Daily&quot; THEN STR([Calculation_143270771536908288])&#10;END' />
            </column>
            <column caption='GFV per Vendor' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_148407748655226882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[brand_gfv] / [vendors]' />
            </column>
            <column caption='Orders per Vendor' datatype='real' name='[Calculation_148407748657623044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[brand_orders] / [vendors]' />
            </column>
            <column caption='is_password_match_admin_brand' datatype='boolean' name='[Calculation_206602637694193664]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[參數 3] = &quot;W7Bw6esA&quot;' />
            </column>
            <column caption='is_password_match_agent_brand' datatype='boolean' name='[Calculation_206602637694349313]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[參數 3] = [manual_brand_password] &#10;AND [Parameters].[參數 3] != &quot;&quot; &#10;AND NOT(ISNULL([Parameters].[參數 3]))' />
            </column>
            <column caption='Config Vendor non ads perform' datatype='real' default-format='n#,##0;-#,##0' name='[Config Metrics （複製）_592364097579507714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//IF [KPI] = &quot;GFV&quot; AND [Is Config] THEN [Non Ads GFV per Vendor]&#10;//ELSEIF [KPI] = &quot;Orders&quot; AND [Is Config] THEN [Non Ads Orders per Vendor]&#10;//ELSEIF [KPI] = &quot;AFV&quot; AND [Is Config] THEN IFNULL([Non Ads Gfv] / [Non Ads Orders], 0)&#10;//ELSE NULL&#10;//END&#10;&#10;IF [Parameters].[參數 7] = &quot;GFV&quot; AND [is_config] THEN ([brand_gfv] - IFNULL([ads_gfv], 0)) / [vendors]&#10;ELSEIF [Parameters].[參數 7] = &quot;Orders&quot; AND [is_config] THEN ([brand_orders] - IFNULL([ads_orders], 0)) / [vendors]&#10;ELSEIF [Parameters].[參數 7] = &quot;AFV&quot; AND [is_config] THEN ([brand_gfv] - IFNULL([ads_gfv], 0)) / ([brand_orders] - IFNULL([ads_orders], 0))&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Config Metrics' datatype='real' default-format='n#,##0;-#,##0' name='[Non Config Metrics （複製）_148407748596113409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[參數 7] = &quot;GFV&quot; AND [is_config] THEN [Calculation_148407748655226882]&#10;ELSEIF [Parameters].[參數 7] = &quot;Orders&quot; AND [is_config] THEN [Calculation_148407748657623044]&#10;ELSEIF [Parameters].[參數 7] = &quot;AFV&quot; AND [is_config] THEN ZN([brand_gfv] / [brand_orders])&#10;ELSE NULL&#10;END' />
            </column>
            <column aggregation='Sum' caption='Ads Gfv' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' default-type='quantitative' layered='true' name='[ads_gfv]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' caption='Ads Orders' datatype='integer' default-type='quantitative' layered='true' name='[ads_orders]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='Count' caption='Ads Product' datatype='string' default-type='nominal' layered='true' name='[ads_product]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Sum' caption='Brand Gfv' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' default-type='quantitative' layered='true' name='[brand_gfv]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' caption='Brand Orders' datatype='integer' default-type='quantitative' layered='true' name='[brand_orders]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
