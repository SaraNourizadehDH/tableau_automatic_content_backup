              <calculation class='tableau' formula='IF [customer_type] = &quot;nc&quot; THEN &quot;新客&quot; &#10;ELSEIF CONTAINS([customer_type], &quot;churn&quot;) THEN &quot;流失客&quot;&#10;ELSE &quot;舊客&quot; END' />
