              <calculation class='tableau' formula='IF [CVR delta% （複製）_292593294096883713] &gt; 0 THEN&#10;&quot;▲ &quot; + STR(ROUND([CVR delta% （複製）_292593294096883713]*100, 1)) + &quot;%&quot;&#10;END'>
