              <calculation class='tableau' formula='IF [Calculation_6497005460862361608] THEN [shop_menu_loaded] ELSE NULL END' />
            </column>
            <column caption='Shop Menu Loaded_target_brand' datatype='integer' default-format='n#,##0;-#,##0' name='[Shop Menu Loaded_target_vendor （複製）_292593294151811090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_487233240156688384] AND [is_target_brand_group （複製）_145311521471709190] THEN [shop_menu_loaded] ELSE NULL END' />
