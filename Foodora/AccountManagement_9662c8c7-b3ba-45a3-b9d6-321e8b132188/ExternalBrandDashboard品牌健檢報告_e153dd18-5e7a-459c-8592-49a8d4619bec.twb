          <datasource-dependencies datasource='sqlproxy.0t36og20ttpwuv1475ahw0otgxt5'>
            <column caption='is_market_trend_display' datatype='boolean' name='[Calculation_3152379032774799372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[參數 5] = &quot;顯示市場趨勢&quot;' />
            </column>
            <column caption='is_target_brand_group' datatype='boolean' name='[Calculation_487233240156688384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([manual_brand_group] = [Parameters].[連鎖品牌 （複製）])&#10;AND (([is_password_match_admin （複製）_145311521384022016]) OR ([is_password_match_agent （複製）_145311521384177665] AND [is_vendor_available_brand]))' />
            </column>
            <column caption='is_target_market' datatype='boolean' name='[Calculation_6497005460862361608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_3152379032774799372]&#10;AND [is_same_cuisine_only （複製）_145311521456697348]&#10;// AND [is_market_competitors_enough]&#10;// AND [is_same_chain_only] AND [is_same_cuisine_only] AND [is_same_city_only]' />
            </column>
            <column aggregation='Sum' caption='Add Cart Clicked' datatype='integer' default-type='quantitative' layered='true' name='[add_cart_clicked]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column-instance column='[mCVR3_target_vendor （複製）_3152379032772354053]' derivation='Avg' name='[avg:mCVR3_target_vendor （複製）_3152379032772354053:qk]' pivot='key' type='quantitative' />
