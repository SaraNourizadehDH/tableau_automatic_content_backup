            <column caption='Ads GFV KPI filter (Est)' datatype='real' name='[Ads GFV(Est) （複製）_117515812621029388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// SUM(IF [Ads Product] = &quot;cpc&quot; THEN [Vendor Gfv] END)*[投入廣告成本比率]*[Ads ROI]&#10;&#10;// [Non Ads GFV]*[投入廣告成本比率]*[Ads ROI]&#10;&#10;[Calculation_181480992131862529] * [Parameters].[參數 8] * [Ads ROI （複製）_117515812600320008]' />
            </column>
            <column caption='Ads ROI KPI filter' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Ads ROI （複製）_117515812600320008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Ads GFV （複製）_117515812598595591])/SUM([Ads Cost （複製）_117515812598087686])' />
            </column>
            <column caption='Display Ads Product' datatype='string' name='[Calculation_117515812570542080]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [ads_product]&#10;    WHEN &quot;cpc&quot; THEN &quot;CPC&quot;&#10;    WHEN &quot;pandabox&quot; THEN &quot;Pandabox&quot;&#10;    WHEN &quot;deal targeting&quot; THEN &quot;Deal Targeting&quot;&#10;    WHEN &quot;vfd_discount&quot; THEN &quot;VFD Discount&quot;&#10;    WHEN &quot;vfd_voucher&quot; THEN &quot;VFD Voucher&quot;&#10;    WHEN &quot;display ads&quot; THEN &quot;Display Ads&quot;&#10;END' />
            </column>
