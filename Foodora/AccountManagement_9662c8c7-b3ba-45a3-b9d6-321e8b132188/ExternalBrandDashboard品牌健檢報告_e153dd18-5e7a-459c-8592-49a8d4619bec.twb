            </column>
            <column caption='CVR Calculated delta%' datatype='real' name='[CVR delta% （複製）_292593294096883713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[參數 4] = &quot;MoM&quot; THEN &#10;((SUM([transactions]) / SUM([shop_menu_loaded])) - LOOKUP((SUM([transactions]) / SUM([shop_menu_loaded])), 1)) &#10;/ ABS(LOOKUP((SUM([transactions]) / SUM([shop_menu_loaded])), 1))&#10;&#10;ELSEIF [Parameters].[參數 4] = &quot;YoY&quot; THEN &#10;((SUM([transactions]) / SUM([shop_menu_loaded])) - LOOKUP((SUM([transactions]) / SUM([shop_menu_loaded])), 12)) &#10;/ ABS(LOOKUP((SUM([transactions]) / SUM([shop_menu_loaded])), 12))&#10;&#10;END&#10;&#10;&#10;//IF [Comparison] = &quot;MoM&quot; THEN &#10;//(SUM([Conversion Rate]) - LOOKUP(SUM([Conversion Rate]), 1)) &#10;/// ABS(LOOKUP(SUM([Conversion Rate]), 1))&#10;&#10;//ELSEIF [Comparison] = &quot;YoY&quot; THEN &#10;//(SUM([Conversion Rate]) - LOOKUP(SUM([Conversion Rate]), 12)) &#10;/// ABS(LOOKUP(SUM([Conversion Rate]), 12))&#10;&#10;//END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='is_target_month' datatype='boolean' name='[Calculation_1248130435943194633]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_month] = [Parameters].[參數 2]' />
            </column>
            <column caption='Conversion Rate Calculated' datatype='real' name='[Calculation_292593294096125952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transactions]) / SUM([shop_menu_loaded])' />
            </column>
            <column caption='is_target_brand_group' datatype='boolean' name='[Calculation_487233240156688384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([manual_brand_group] = [Parameters].[連鎖品牌 （複製）])&#10;AND (([is_password_match_admin （複製）_145311521384022016]) OR ([is_password_match_agent （複製）_145311521384177665] AND [is_vendor_available_brand]))' />
            </column>
