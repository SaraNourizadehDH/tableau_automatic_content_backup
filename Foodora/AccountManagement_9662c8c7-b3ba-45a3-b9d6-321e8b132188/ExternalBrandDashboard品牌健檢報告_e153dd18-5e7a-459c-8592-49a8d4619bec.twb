              <calculation class='tableau' formula='&quot;MoM&quot;' />
            </column>
            <column caption='Target Brand Group' datatype='string' name='[連鎖品牌 （複製）]' param-domain-type='any' role='measure' type='nominal' value='&quot;請輸入Brand Group&quot;'>
              <calculation class='tableau' formula='&quot;請輸入Brand Group&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0t36og20ttpwuv1475ahw0otgxt5'>
            <column caption='Orders per vendor' datatype='real' name='[Calculation_105553127125565440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// [Orders] / [monthly_brand_vendors_number_calculated]&#10;&#10;SUM([orders]) / SUM([Calculation_105553127125942273])&#10;&#10;// 因為有時會有只選其中幾個品牌的情況，故需要先把品牌的店家數加好，不然會變成不同品牌的分母數字不同' />
            </column>
            <column caption='monthly_brand_vendors_number_calculated' datatype='integer' name='[Calculation_105553127125942273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [report_month], [manual_brand_group], [manual_brand_name] :MAX([monthly_brand_vendors_number])} &#10;&#10;// 用於要加filter時' />
            </column>
            <column caption='is_target_month' datatype='boolean' name='[Calculation_1248130435943194633]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_month] = [Parameters].[參數 2]' />
            </column>
            <column caption='is_target_brand_group' datatype='boolean' name='[Calculation_487233240156688384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([manual_brand_group] = [Parameters].[連鎖品牌 （複製）])&#10;AND (([is_password_match_admin （複製）_145311521384022016]) OR ([is_password_match_agent （複製）_145311521384177665] AND [is_vendor_available_brand]))' />
            </column>
            <column caption='Order per vendor +delta%' datatype='string' default-format='p0.0%' name='[Order +delta% （複製）_105553127128137733]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Order delta% （複製）_105553127126745090] &gt; 0 THEN&#10;&quot;▲ &quot; + STR(ROUND([Order delta% （複製）_105553127126745090]*100, 1)) + &quot;%&quot;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Order per vendor -delta%' datatype='string' default-format='p0.0%' name='[Order -delta% （複製）_105553127128326150]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Order delta% （複製）_105553127126745090] &lt;= 0 THEN&#10;&quot;▼ &quot; + STR(ROUND([Order delta% （複製）_105553127126745090]*100, 1)) + &quot;%&quot;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Order per vendor delta%' datatype='real' name='[Order delta% （複製）_105553127126745090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// IF [Comparison] = &quot;MoM&quot; THEN &#10;// (SUM([Orders per vendor]) - LOOKUP(SUM([Orders per vendor]), 1)) &#10;// / ABS(LOOKUP(SUM([Orders per vendor]), 1))&#10;&#10;// ELSEIF [Comparison] = &quot;YoY&quot; THEN &#10;// (SUM([Orders per vendor]) - LOOKUP(SUM([Orders per vendor]), 12)) &#10;// / ABS(LOOKUP(SUM([Orders per vendor]), 12))&#10;&#10;// END&#10;&#10;IF [Parameters].[參數 4] = &quot;MoM&quot; THEN &#10; ([Calculation_105553127125565440] - LOOKUP([Calculation_105553127125565440], 1)) &#10; / ABS(LOOKUP([Calculation_105553127125565440], 1))&#10;&#10;ELSEIF [Parameters].[參數 4] = &quot;YoY&quot; THEN &#10; ([Calculation_105553127125565440] - LOOKUP([Calculation_105553127125565440], 12)) &#10; / ABS(LOOKUP([Calculation_105553127125565440], 12))&#10;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='is_password_match_admin_brand' datatype='boolean' name='[is_password_match_admin （複製）_145311521384022016]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[參數 3] = &quot;W7Bw6esA&quot;' />
            </column>
            <column caption='is_password_match_agent_brand' datatype='boolean' name='[is_password_match_agent （複製）_145311521384177665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[參數 3] = [manual_brand_password] &#10;AND [Parameters].[參數 3] != &quot;&quot; &#10;AND NOT(ISNULL([Parameters].[參數 3]))' />
            </column>
            <column caption='is_target_brand_name' datatype='boolean' name='[is_target_brand_group （複製）_145311521471709190]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='((CONTAINS([Parameters].[Target Brand Group （複製）_145311521471471621], [manual_brand_name])) OR ([Parameters].[Target Brand Group （複製）_145311521471471621] = &quot;全店家&quot;))&#10;AND (([is_password_match_admin （複製）_145311521384022016]) OR ([is_password_match_agent （複製）_145311521384177665] AND [is_vendor_available_brand]))&#10;&#10;//([Manual Brand Name] = [Target Brand Name]' />
