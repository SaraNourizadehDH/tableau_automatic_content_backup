      <column caption='Ads ROI' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Ads ROI （複製）_1123155553738113035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ads_gfv])/SUM([ads_cost])' />
