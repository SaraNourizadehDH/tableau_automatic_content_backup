                <zone forceUpdate='true' h='3188' id='1906' type-v2='text' w='55001' x='44272' y='57937'>
                  <formatted-text>
                    <run>Æ&#10;</run>
                    <run fontname='PP Agrandir'>Orders: Total number of valid orders</run>
                    <run>Æ&#10;</run>
                    <run fontname='PP Agrandir'>GFV: Total food value of all items sold. It does not include discounts, vouchers, fees or tips.</run>
                    <run>Æ&#10;</run>
                    <run fontname='PP Agrandir'>AFV: Average food value, also known as average basket size</run>
                    <run>Æ&#10;</run>
                    <run fontname='PP Agrandir'>YTD:Year to Date</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
