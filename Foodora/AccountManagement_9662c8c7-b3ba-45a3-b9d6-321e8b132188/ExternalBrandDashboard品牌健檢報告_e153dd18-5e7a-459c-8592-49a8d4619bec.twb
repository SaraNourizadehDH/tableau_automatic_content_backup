              <calculation class='tableau' formula='WINDOW_SUM(&#10;    SUM(IF [Calculation_487233240156688384] AND [is_target_brand_group （複製）_145311521471709190] THEN [orders] END),&#10;    -11,&#10;    0&#10;)&#10;&#10;&#10;&#10;//IF [is_target_brand_group] AND [is_target_brand_name] THEN [Orders YTD] ELSE NULL END'>
