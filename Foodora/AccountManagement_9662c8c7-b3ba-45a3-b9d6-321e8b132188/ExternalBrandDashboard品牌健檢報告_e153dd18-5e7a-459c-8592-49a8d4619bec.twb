        <calculation class='tableau' formula='IF [Parameters].[參數 7] = &quot;GFV&quot; AND NOT [is_config] THEN [Calculation_148407748655226882]&#10;ELSEIF [Parameters].[參數 7] = &quot;Orders&quot; AND NOT [is_config] THEN [Calculation_148407748657623044]&#10;ELSEIF [Parameters].[參數 7] = &quot;AFV&quot; AND NOT [is_config] THEN IFNULL([brand_gfv] / [brand_orders], 0)&#10;ELSE NULL&#10;END' />
