            <column caption='Ads GFV delta KPI filter' datatype='real' name='[Ads GFV delta （複製）_117515812621422605]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Ads GFV(Est) （複製）_117515812621029388] - SUM([Ads GFV （複製）_117515812598595591])' />
