            <column caption='mCVR3_target_brand' datatype='real' default-format='p0.0%' name='[mCVR3_target_vendor （複製）_292593294155194389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_487233240156688384] AND [is_target_brand_group （複製）_145311521471709190] THEN [add_cart_clicked] ELSE NULL END) &#10;/ SUM(IF [Calculation_487233240156688384] AND [is_target_brand_group （複製）_145311521471709190] THEN [shop_menu_loaded] ELSE NULL END)' />
            </column>
            <column caption='mCVR3_market_trend' datatype='real' default-format='p0.0%' name='[mCVR3_target_vendor （複製）_3152379032772354053]' role='measure' type='quantitative'>
