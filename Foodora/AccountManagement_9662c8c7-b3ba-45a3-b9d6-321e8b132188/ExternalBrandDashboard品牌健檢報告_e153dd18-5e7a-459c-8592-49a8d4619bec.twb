      <column caption='Ads ROI delta%' datatype='real' name='[Ads ROI delta% （複製）_1123155553738395660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[參數 4] = &quot;MoM&quot; THEN &#10;(ZN([Ads ROI （複製）_1123155553738113035]) - LOOKUP(ZN([Ads ROI （複製）_1123155553738113035]), 1)) &#10;/ ABS(LOOKUP(ZN([Ads ROI （複製）_1123155553738113035]), 1))&#10;&#10;ELSEIF [Parameters].[參數 4] = &quot;YoY&quot; THEN &#10;(ZN([Ads ROI （複製）_1123155553738113035]) - LOOKUP(ZN([Ads ROI （複製）_1123155553738113035]), 12)) &#10;/ ABS(LOOKUP(ZN([Ads ROI （複製）_1123155553738113035]), 12))&#10;&#10;END'>
