      </column>
      <column caption='Ads GFV KPI filter ' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Ads GFV （複製）_117515812598595591]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_117515812597772293] THEN [ads_gfv] END' />
