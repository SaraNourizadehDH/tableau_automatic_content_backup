            <column caption='Ads Cost KPI filter' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Ads Cost （複製）_117515812598087686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_117515812597772293] THEN [ads_cost] END' />
