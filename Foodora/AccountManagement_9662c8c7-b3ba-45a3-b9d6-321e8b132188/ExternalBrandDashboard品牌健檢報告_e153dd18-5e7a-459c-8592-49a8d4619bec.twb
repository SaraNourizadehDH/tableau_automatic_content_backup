              <calculation class='tableau' formula='SUM(IF [Calculation_487233240156688384] AND [is_target_brand_group （複製）_145311521471709190] THEN [shop_menu_loaded] ELSE NULL END) &#10;/ SUM(IF [Calculation_487233240156688384] AND [is_target_brand_group （複製）_145311521471709190] THEN [shop_impressions_loaded] ELSE NULL END)' />
