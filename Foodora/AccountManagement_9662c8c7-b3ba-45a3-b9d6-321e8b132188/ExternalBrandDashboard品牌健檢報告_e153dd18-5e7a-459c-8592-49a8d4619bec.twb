                <zone fixed-size='479' forceUpdate='true' h='3844' id='556' type-v2='text' w='44272' x='727' y='67719'>
                  <formatted-text>
                    <run>指標定義 </run>
                    <run fontname='PP Agrandir'>Definition of Metrics</run>
                    <run>
[1] 品牌店家關店率(離線率)：在計劃營業時間內，您的商家被標記為離線的時間百分比
[2] 失敗率：因商家原因而失敗的訂單百分比
[3] 拖餐率：商家延遲製餐超過 10 分鐘的訂單百分比
[4] 製餐時間：平均餐點製作時長（單位：分鐘）</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='3844' id='1803' type-v2='text' w='54274' x='44999' y='67719'>
                  <formatted-text>
                    <run>Æ&#10;</run>
                    <run fontname='PP Agrandir'>Offline Rate: % of time that your store was marked offline during the store&apos;s scheduled opening hours.</run>
                    <run>Æ&#10;</run>
                    <run fontname='PP Agrandir'>Fail Rate: % of orders failed by vendor</run>
                    <run>Æ&#10;</run>
                    <run fontname='PP Agrandir'>Delay Rate: % of orders with vendor meal preparation time exceeding estimated preparation time more than 10 minutes</run>
                    <run>Æ&#10;</run>
                    <run fontname='PP Agrandir'>APT: Average meal actual preparation time (unit: minutes)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
