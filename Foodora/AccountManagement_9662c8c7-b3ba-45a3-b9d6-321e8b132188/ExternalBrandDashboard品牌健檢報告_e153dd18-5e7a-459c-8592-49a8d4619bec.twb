      <column caption='Non Ads Vendors' datatype='integer' name='[Ads Vendors （複製）_611504393549291520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_config] = False AND [ads_product] = REPLACE(LOWER([Parameters].[KPI （複製）]), &quot; &quot;, &quot;_&quot;) THEN [vendors] ELSE 0 END' />
      </column>
      <column caption='Brand Ads GFV for calculation' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Brand GFV for calculation （複製）_2689563808839888897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [report_date], [manual_brand_group], [manual_brand_name]: max([brand_ads_gfv])})' />
      </column>
      <column caption='Display Ads Product' datatype='string' name='[Calculation_117515812570542080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [ads_product]&#10;    WHEN &quot;cpc&quot; THEN &quot;CPC&quot;&#10;    WHEN &quot;pandabox&quot; THEN &quot;Pandabox&quot;&#10;    WHEN &quot;deal targeting&quot; THEN &quot;Deal Targeting&quot;&#10;    WHEN &quot;vfd_discount&quot; THEN &quot;VFD Discount&quot;&#10;    WHEN &quot;vfd_voucher&quot; THEN &quot;VFD Voucher&quot;&#10;    WHEN &quot;display ads&quot; THEN &quot;Display Ads&quot;&#10;END' />
      </column>
      <column caption='is_filter_kpi_product' datatype='boolean' name='[Calculation_117515812597772293]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([Parameters].[ADs Products （複製 2）], [Calculation_117515812570542080])' />
      </column>
      <column caption='Pre Metrics' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_128141548876025857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[參數 7] = &quot;GFV&quot; AND [report_date] &gt;= [Parameters].[ADs Products （複製）] AND [report_date] &lt;= [Parameters].[pre_start_date （複製）] THEN [brand_gfv]&#10;ELSEIF [Parameters].[參數 7] = &quot;Orders&quot; AND [report_date] &gt;= [Parameters].[ADs Products （複製）] AND [report_date] &lt;= [Parameters].[pre_start_date （複製）] THEN [brand_orders]&#10;ELSEIF [Parameters].[參數 7] = &quot;AFV&quot; AND [report_date] &gt;= [Parameters].[ADs Products （複製）] AND [report_date] &lt;= [Parameters].[pre_start_date （複製）] THEN IFNULL([brand_gfv] / [brand_orders], 0)&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='is_target_brand_group' datatype='boolean' name='[Calculation_128141548909654018]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([manual_brand_group] = [Parameters].[連鎖品牌 （複製）])&#10;AND (([Calculation_206602637694193664]) OR ([Calculation_206602637694349313] AND [is_vendor_available_brand]))' />
      </column>
      <column caption='is_target_brand_name' datatype='boolean' name='[Calculation_128141548909821955]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='((CONTAINS([Parameters].[Target Brand Group （複製）_145311521471471621], [manual_brand_name])) OR ([Parameters].[Target Brand Group （複製）_145311521471471621] = &quot;全店家&quot;))&#10;AND (([Calculation_206602637694193664]) OR ([Calculation_206602637694349313] AND [is_vendor_available_brand]))&#10;&#10;//([Manual Brand Name] = [Target Brand Name]' />
      </column>
      <column caption='is_target_ads' datatype='boolean' name='[Calculation_128141548912906244]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LOWER([Parameters].[KPI （複製）]) = REPLACE(LOWER([ads_product]), &quot;_&quot;, &quot; &quot;)' />
      </column>
      <column caption='Datetrunc Report Date' datatype='date' name='[Calculation_143270771536908288]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Password （複製）], &quot;(month)|(mtd)&quot;) THEN DATE(DATETRUNC(&quot;month&quot;, [report_date]))&#10;ELSEIF REGEXP_MATCH([Parameters].[Password （複製）], &quot;(week)|(wtd)&quot;) THEN DATE(DATETRUNC(&quot;iso-week&quot;, [report_date]))&#10;ELSE DATE(DATETRUNC(&quot;day&quot;, [report_date]))&#10;END' />
      </column>
      <column caption='Display Date 1' datatype='string' name='[Calculation_143270771538690049]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Password （複製）] = &quot;day&quot; THEN LEFT(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3) // 顯示 Mon, Tue, Wed...&#10;ELSE STR(YEAR([Calculation_143270771536908288])) // 顯示年份&#10;END' />
      </column>
      <column caption='Display Date 2' datatype='string' name='[Calculation_143270771538956290]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Password （複製）], &quot;Monthly&quot;) THEN LEFT(DATENAME(&quot;month&quot;, [report_date]), 3)&#10;ELSEIF REGEXP_MATCH([Parameters].[Password （複製）], &quot;Weekly&quot;) THEN &quot;Week &quot; + DATENAME(&quot;iso-week&quot;, [report_date])&#10;ELSEIF [Parameters].[Password （複製）] = &quot;Daily&quot; THEN STR([Calculation_143270771536908288])&#10;END' />
      </column>
      <column caption='has_ads' datatype='boolean' name='[Calculation_1478025132749070336]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAX(IF [ads_product] IN (&quot;cpc&quot;, &quot;pandabox&quot;, &quot;deal targeting&quot;) THEN [is_config] ELSE NULL END)' />
      </column>
      <column caption='GFV per Vendor' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_148407748655226882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[brand_gfv] / [vendors]' />
      </column>
      <column caption='Orders per Vendor' datatype='real' name='[Calculation_148407748657623044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[brand_orders] / [vendors]' />
      </column>
      <column caption='Number of Date' datatype='string' name='[Calculation_148407748685561864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_date] &gt;= [Parameters].[ADs Products （複製）] AND [report_date] &lt;= [Parameters].[pre_start_date （複製）]&#10;    THEN &quot;第&quot; + STR(DATEDIFF(&quot;day&quot;, [Parameters].[ADs Products （複製）], [report_date]) + 1) + &quot;天&quot;&#10;ELSEIF [report_date] &gt;= [Parameters].[pre_start_date （複製 2）] AND [report_date] &lt;= [Parameters].[pre_end_date （複製）]&#10;    THEN &quot;第&quot; + STR(DATEDIFF(&quot;day&quot;, [Parameters].[pre_start_date （複製 2）], [report_date]) + 1) + &quot;天&quot;&#10;ELSE &quot;NULL&quot;&#10;END' />
      </column>
      <column caption='Report Month' datatype='datetime' default-format='*yyyy/mm' name='[Calculation_1738882073693237253]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;, [report_date])' />
      </column>
      <column caption='Metric diff %' datatype='real' name='[Calculation_173951536899276800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND((SUM([Pre Metrics （複製）_128141548932153352]) - SUM([Calculation_128141548876025857])) / SUM([Calculation_128141548876025857]) * 100, 2)' />
      </column>
      <column caption='Ads Vendors' datatype='integer' name='[Calculation_173951536908328970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_config] = TRUE THEN [vendors] ELSE 0 END&#10;// AND [Ads Product] = REPLACE(LOWER([ADs Products]), &quot; &quot;, &quot;_&quot;)' />
      </column>
      <column caption='Ads Vendors Ratio' datatype='real' name='[Calculation_173951536911568909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Calculation_173951536908328970]) / [Calculation_611504393549410305]' />
      </column>
      <column caption='Display Ads Vendors Ratio' datatype='string' name='[Calculation_173951536913293326]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([Calculation_173951536911568909] * 100, 2)) + &quot;%&quot;' />
      </column>
      <column caption='is_comparison_month' datatype='boolean' name='[Calculation_173951536922095634]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1738882073693237253] &gt;= [Parameters].[投入廣告成本比率 （複製）]' />
      </column>
      <column caption='Non Ads GFV' datatype='real' name='[Calculation_181480992131862529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// SUM([Vendor Gfv]) - [Ads GFV]&#10;// SUM(IF [Ads Product] = &quot;cpc&quot; THEN [Vendor Gfv] END) - [Ads GFV]&#10;// SUM({FIXED [Report Date], [Manual Brand Group], [Manual Brand Name]: MAX([Brand Gfv])}) - SUM([Ads Gfv])&#10;SUM([sqlproxy.0t36og20ttpwuv1475ahw0otgxt5].[gfv]) - SUM([ads_gfv])' />
      </column>
      <column caption='is_password_match_admin_brand' datatype='boolean' name='[Calculation_206602637694193664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[參數 3] = &quot;W7Bw6esA&quot;' />
      </column>
      <column caption='is_password_match_agent_brand' datatype='boolean' name='[Calculation_206602637694349313]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[參數 3] = [manual_brand_password] &#10;AND [Parameters].[參數 3] != &quot;&quot; &#10;AND NOT(ISNULL([Parameters].[參數 3]))' />
