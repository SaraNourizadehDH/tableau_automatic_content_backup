        <calculation class='tableau' formula='IF [Ads Cost% delta% （複製）_138133904503111682] &lt;= 0 THEN&#10;&quot;▼ &quot; + STR(ROUND([Ads Cost% delta% （複製）_138133904503111682]*100, 1)) + &quot;%&quot;&#10;END'>
