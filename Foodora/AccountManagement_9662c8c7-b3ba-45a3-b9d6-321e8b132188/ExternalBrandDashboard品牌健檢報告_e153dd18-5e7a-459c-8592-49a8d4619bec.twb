        <calculation class='tableau' formula='IF [Parameters].[參數 4] = &quot;MoM&quot; THEN &#10;(ZN([Ads Cost% （複製）_138133904502992897]) - LOOKUP(ZN([Ads Cost% （複製）_138133904502992897]), 1)) &#10;/ ABS(LOOKUP(ZN([Ads Cost% （複製）_138133904502992897]), 1))&#10;&#10;ELSEIF [Parameters].[參數 4] = &quot;YoY&quot; THEN &#10;(ZN([Ads Cost% （複製）_138133904502992897]) - LOOKUP(ZN([Ads Cost% （複製）_138133904502992897]), 12)) &#10;/ ABS(LOOKUP(ZN([Ads Cost% （複製）_138133904502992897]), 12))&#10;&#10;END'>
