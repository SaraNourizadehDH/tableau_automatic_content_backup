          <datasource-dependencies datasource='sqlproxy.0t36og20ttpwuv1475ahw0otgxt5'>
            <column caption='AFV_target_brand' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[AFV_target_vendor （複製）_487233240210460681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_487233240156688384] AND [is_target_brand_group （複製）_145311521471709190] THEN [gfv] ELSE NULL END) &#10;/ SUM(IF [Calculation_487233240156688384] AND [is_target_brand_group （複製）_145311521471709190] THEN [orders] ELSE NULL END)' />
            </column>
            <column caption='AFV_market_trend' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_3152379032771764226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6497005460862361608] THEN [afv] ELSE NULL END&#10;&#10;// SUM(IF [is_target_market] THEN [Gfv] ELSE NULL END) &#10;// / SUM(IF [is_target_market] THEN [Orders] ELSE NULL END)' />
            </column>
            <column caption='is_market_trend_display' datatype='boolean' name='[Calculation_3152379032774799372]' role='dimension' type='nominal'>
