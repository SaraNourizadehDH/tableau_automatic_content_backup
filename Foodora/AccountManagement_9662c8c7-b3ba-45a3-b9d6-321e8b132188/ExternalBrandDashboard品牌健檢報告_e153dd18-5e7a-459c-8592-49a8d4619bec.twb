      <column caption='Post Metrics' datatype='real' default-format='n#,##0;-#,##0' name='[Pre Metrics （複製）_128141548932153352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[參數 7] = &quot;GFV&quot; AND [report_date] &gt;= [Parameters].[pre_start_date （複製 2）] AND [report_date] &lt;= [Parameters].[pre_end_date （複製）] THEN [brand_gfv]&#10;ELSEIF [Parameters].[參數 7] = &quot;Orders&quot; AND [report_date] &gt;= [Parameters].[pre_start_date （複製 2）] AND [report_date] &lt;= [Parameters].[pre_end_date （複製）] THEN [brand_orders]&#10;ELSEIF [Parameters].[參數 7] = &quot;AFV&quot; AND [report_date] &gt;= [Parameters].[pre_start_date （複製 2）] AND [report_date] &lt;= [Parameters].[pre_end_date （複製）] THEN IFNULL([brand_gfv] / [brand_orders], 0)&#10;ELSE NULL&#10;END' />
      </column>
