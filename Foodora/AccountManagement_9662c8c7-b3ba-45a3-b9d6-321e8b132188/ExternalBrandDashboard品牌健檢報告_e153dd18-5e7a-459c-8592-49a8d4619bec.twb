      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[sqlproxy.1wgs8fw0gkzq621diyosw1gmrqv8].[sum:customers:qk]&quot;' value='消費人數 Customers' />
          <alias key='&quot;[sqlproxy.1wgs8fw0gkzq621diyosw1gmrqv8].[sum:total_gfv:qk]&quot;' value='業績 GFV' />
          <alias key='&quot;[sqlproxy.1wgs8fw0gkzq621diyosw1gmrqv8].[sum:total_orders:qk]&quot;' value='訂單 Orders' />
          <alias key='&quot;[sqlproxy.1wgs8fw0gkzq621diyosw1gmrqv8].[usr:Calculation_1248130435998183447:qk]&quot;' value='客單價 AFV' />
          <alias key='&quot;[sqlproxy.1wgs8fw0gkzq621diyosw1gmrqv8].[usr:Calculation_143270771541381123:qk]&quot;' value='消費頻率 Order Frequency' />
        </aliases>
      </column>
      <column caption='NC/EC/Churn' datatype='string' name='[Calculation_1248130435995480086]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [customer_type] = &quot;nc&quot; THEN &quot;新客&quot; &#10;ELSEIF CONTAINS([customer_type], &quot;churn&quot;) THEN &quot;流失客&quot;&#10;ELSE &quot;舊客&quot; END' />
        <aliases>
          <alias key='&quot;新客&quot;' value='新客 NC' />
          <alias key='&quot;流失客&quot;' value='流失客 Churn' />
          <alias key='&quot;舊客&quot;' value='舊客 EC' />
        </aliases>
      </column>
      <column caption='AFV' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_1248130435998183447]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gfv])/SUM([total_orders])' />
      </column>
      <column caption='Order Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_143270771541381123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders]) / SUM([customers])' />
      </column>
      <column caption='is_password_match_admin_brand' datatype='boolean' name='[Calculation_206602637696868354]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[參數 3] = &quot;W7Bw6esA&quot;' />
      </column>
      <column caption='is_password_match_agent_brand' datatype='boolean' name='[Calculation_206602637696978947]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[參數 3] = [manual_brand_password] &#10;AND [Parameters].[參數 3] != &quot;&quot; &#10;AND NOT(ISNULL([Parameters].[參數 3]))' />
      </column>
      <column caption='Customers %' datatype='real' default-format='p0.0%' name='[Calculation_3216766434071621633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customers]) / TOTAL(SUM([customers]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Pro/Nonpro' datatype='string' name='[Calculation_3216766434074546187]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_pandapro_subscriber] THEN &quot;訂閱會員 Pro&quot; ELSE &quot;非會員 Nonpro&quot; END' />
      </column>
      <column caption='is_target_month' datatype='boolean' name='[Calculation_438889883982618632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF[report_month] = [Parameters].[參數 2] THEN True ELSE False END' />
      </column>
      <column caption='Customers delta%' datatype='real' name='[Calculation_438889883984990217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[參數 4] = &quot;MoM&quot; THEN &#10;(SUM([customers]) - LOOKUP(SUM([customers]), 1)) &#10;/ ABS(LOOKUP(SUM([customers]), 1))&#10;&#10;ELSEIF [Parameters].[參數 4] = &quot;YoY&quot; THEN &#10;(SUM([customers]) - LOOKUP(SUM([customers]), 12)) &#10;/ ABS(LOOKUP(SUM([customers]), 12))&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Customers +delta%' datatype='string' name='[Calculation_438889883985231882]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_438889883984990217] &gt; 0 THEN&#10;&quot;▲ &quot; + STR(ROUND([Calculation_438889883984990217]*100, 1)) + &quot;%&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Customers -delta%' datatype='string' name='[Calculation_438889883985432587]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_438889883984990217] &lt;= 0 THEN&#10;&quot;▼ &quot; + STR(ROUND([Calculation_438889883984990217]*100, 1)) + &quot;%&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Lost Revenue' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_5106941272819957760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS([customer_type], &quot;churn&quot;) &#10;THEN [total_gfv] ELSE 0 END' />
