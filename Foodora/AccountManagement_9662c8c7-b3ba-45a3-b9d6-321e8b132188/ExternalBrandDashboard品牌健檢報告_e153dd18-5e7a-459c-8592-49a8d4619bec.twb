        <calculation class='tableau' formula='IF [Ads ROI delta% （複製）_1123155553738395660] &lt;= 0 THEN&#10;&quot;▼ &quot; + STR(ROUND([Ads ROI delta% （複製）_1123155553738395660]*100, 1)) + &quot;%&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
