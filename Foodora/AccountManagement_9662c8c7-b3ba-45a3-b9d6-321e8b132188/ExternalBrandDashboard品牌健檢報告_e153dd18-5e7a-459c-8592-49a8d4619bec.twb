              <calculation class='tableau' formula='IF [Parameters].[參數 4] = &quot;MoM&quot; THEN &#10;((SUM([transactions])/SUM([checkout_loaded])) - LOOKUP(SUM([transactions])/SUM([checkout_loaded]), 1))&#10;/ ABS(LOOKUP(SUM([transactions])/SUM([checkout_loaded]), 1))&#10;&#10;ELSEIF [Parameters].[參數 4] = &quot;YoY&quot; THEN &#10;(SUM([transactions])/SUM([checkout_loaded]) - LOOKUP(SUM([transactions])/SUM([checkout_loaded]), 12)) &#10;/ ABS(LOOKUP(SUM([transactions])/SUM([checkout_loaded]), 12))&#10;&#10;END'>
