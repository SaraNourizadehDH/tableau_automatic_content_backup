            <column caption='is_target_brand_name' datatype='boolean' name='[is_target_brand_group （複製）_145311521471709190]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='((CONTAINS([Parameters].[Target Brand Group （複製）_145311521471471621], [manual_brand_name])) OR ([Parameters].[Target Brand Group （複製）_145311521471471621] = &quot;全店家&quot;))&#10;AND (([is_password_match_admin （複製）_145311521384022016]) OR ([is_password_match_agent （複製）_145311521384177665] AND [is_vendor_available_brand]))&#10;&#10;//([Manual Brand Name] = [Target Brand Name]' />
