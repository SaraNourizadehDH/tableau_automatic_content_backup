            <column aggregation='Count' caption='Monthly Brand Vendors Number' datatype='integer' default-type='ordinal' layered='true' name='[monthly_brand_vendors_number]' pivot='key' role='dimension' type='ordinal' user-datatype='integer' visual-totals='Default' />
