              <calculation class='tableau' formula='CONTAINS([Parameters].[ADs Products （複製 2）], [Calculation_117515812570542080])' />
            </column>
            <column caption='is_target_brand_group' datatype='boolean' name='[Calculation_128141548909654018]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([manual_brand_group] = [Parameters].[連鎖品牌 （複製）])&#10;AND (([Calculation_206602637694193664]) OR ([Calculation_206602637694349313] AND [is_vendor_available_brand]))' />
            </column>
            <column caption='is_target_brand_name' datatype='boolean' name='[Calculation_128141548909821955]' role='dimension' type='nominal'>
