      <column caption='Ads GFV -delta%' datatype='string' name='[GFV -delta% （複製）_1123155553736687624]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [GFV delta% （複製）_1123155553736429575] &lt;= 0 THEN&#10;&quot;▼ &quot; + STR(ROUND([GFV delta% （複製）_1123155553736429575]*100, 1)) + &quot;%&quot;&#10;END'>
