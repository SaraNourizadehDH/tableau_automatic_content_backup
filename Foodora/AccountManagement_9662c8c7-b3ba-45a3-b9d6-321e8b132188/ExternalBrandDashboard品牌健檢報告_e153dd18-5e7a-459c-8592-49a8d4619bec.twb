        <calculation class='tableau' formula='IF [New Customer delta% （複製）_1123155553739268113] &lt;= 0 THEN&#10;&quot;▼ &quot; + STR(ROUND([New Customer delta% （複製）_1123155553739268113]*100, 1)) + &quot;%&quot;&#10;END'>
