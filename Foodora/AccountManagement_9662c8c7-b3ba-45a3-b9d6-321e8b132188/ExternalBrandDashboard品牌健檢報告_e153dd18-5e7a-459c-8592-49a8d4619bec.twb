              <calculation class='tableau' formula='SUM(IF [Calculation_487233240156688384] AND [is_target_brand_group （複製）_145311521471709190] THEN [transactions] ELSE NULL END) &#10;/ SUM(IF [Calculation_487233240156688384] AND [is_target_brand_group （複製）_145311521471709190] THEN [shop_menu_loaded] ELSE NULL END)' />
            </column>
            <column caption='CVR_market_trend' datatype='real' default-format='p0.0%' name='[CVR_target_vendor （複製）_3152379032772497415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_6497005460862361608] THEN [conversion_rate] ELSE NULL END' />
            </column>
            <column caption='is_market_trend_display' datatype='boolean' name='[Calculation_3152379032774799372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[參數 5] = &quot;顯示市場趨勢&quot;' />
            </column>
            <column caption='is_target_brand_group' datatype='boolean' name='[Calculation_487233240156688384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([manual_brand_group] = [Parameters].[連鎖品牌 （複製）])&#10;AND (([is_password_match_admin （複製）_145311521384022016]) OR ([is_password_match_agent （複製）_145311521384177665] AND [is_vendor_available_brand]))' />
