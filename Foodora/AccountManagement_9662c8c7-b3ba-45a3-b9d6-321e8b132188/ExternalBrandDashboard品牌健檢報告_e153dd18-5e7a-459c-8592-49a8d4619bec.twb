      <column caption='Ads ROI KPI filter' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Ads ROI （複製）_117515812600320008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Ads GFV （複製）_117515812598595591])/SUM([Ads Cost （複製）_117515812598087686])' />
