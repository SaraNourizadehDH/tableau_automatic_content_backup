            <column caption='Orders_YTD_market_trend' datatype='integer' default-format='n#,##0;-#,##0' name='[Orders_market_trend （複製）_78813002911019009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM(&#10;    SUM(IF [Calculation_6497005460862361608] THEN [orders] END),&#10;    -11,&#10;    0&#10;)&#10;&#10;// IF [is_target_market] THEN [Orders YTD] ELSE NULL END'>
