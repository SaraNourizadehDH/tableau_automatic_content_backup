              <calculation class='tableau' formula='IF [Parameters].[參數 7] = &quot;GFV&quot; AND [report_date] &gt;= [Parameters].[ADs Products （複製）] AND [report_date] &lt;= [Parameters].[pre_start_date （複製）] THEN [brand_gfv]&#10;ELSEIF [Parameters].[參數 7] = &quot;Orders&quot; AND [report_date] &gt;= [Parameters].[ADs Products （複製）] AND [report_date] &lt;= [Parameters].[pre_start_date （複製）] THEN [brand_orders]&#10;ELSEIF [Parameters].[參數 7] = &quot;AFV&quot; AND [report_date] &gt;= [Parameters].[ADs Products （複製）] AND [report_date] &lt;= [Parameters].[pre_start_date （複製）] THEN IFNULL([brand_gfv] / [brand_orders], 0)&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='is_target_brand_group' datatype='boolean' name='[Calculation_128141548909654018]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([manual_brand_group] = [Parameters].[連鎖品牌 （複製）])&#10;AND (([Calculation_206602637694193664]) OR ([Calculation_206602637694349313] AND [is_vendor_available_brand]))' />
            </column>
            <column caption='is_target_brand_name' datatype='boolean' name='[Calculation_128141548909821955]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='((CONTAINS([Parameters].[Target Brand Group （複製）_145311521471471621], [manual_brand_name])) OR ([Parameters].[Target Brand Group （複製）_145311521471471621] = &quot;全店家&quot;))&#10;AND (([Calculation_206602637694193664]) OR ([Calculation_206602637694349313] AND [is_vendor_available_brand]))&#10;&#10;//([Manual Brand Name] = [Target Brand Name]' />
            </column>
            <column caption='is_target_ads' datatype='boolean' name='[Calculation_128141548912906244]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LOWER([Parameters].[KPI （複製）]) = REPLACE(LOWER([ads_product]), &quot;_&quot;, &quot; &quot;)' />
            </column>
            <column caption='Number of Date' datatype='string' name='[Calculation_148407748685561864]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt;= [Parameters].[ADs Products （複製）] AND [report_date] &lt;= [Parameters].[pre_start_date （複製）]&#10;    THEN &quot;第&quot; + STR(DATEDIFF(&quot;day&quot;, [Parameters].[ADs Products （複製）], [report_date]) + 1) + &quot;天&quot;&#10;ELSEIF [report_date] &gt;= [Parameters].[pre_start_date （複製 2）] AND [report_date] &lt;= [Parameters].[pre_end_date （複製）]&#10;    THEN &quot;第&quot; + STR(DATEDIFF(&quot;day&quot;, [Parameters].[pre_start_date （複製 2）], [report_date]) + 1) + &quot;天&quot;&#10;ELSE &quot;NULL&quot;&#10;END' />
            </column>
            <column caption='Metric diff %' datatype='real' name='[Calculation_173951536899276800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((SUM([Pre Metrics （複製）_128141548932153352]) - SUM([Calculation_128141548876025857])) / SUM([Calculation_128141548876025857]) * 100, 2)' />
            </column>
