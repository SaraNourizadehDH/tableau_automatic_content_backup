              <calculation class='tableau' formula='WINDOW_SUM(&#10;    SUM(IF [Calculation_6497005460862361608] THEN [gfv] END),&#10;    -11,&#10;    0&#10;) / &#10;&#10;WINDOW_SUM(&#10;    SUM(IF [Calculation_6497005460862361608] THEN [orders] END),&#10;    -11,&#10;    0&#10;)&#10;&#10;// IF [is_target_market] THEN [Afv] ELSE NULL END'>
