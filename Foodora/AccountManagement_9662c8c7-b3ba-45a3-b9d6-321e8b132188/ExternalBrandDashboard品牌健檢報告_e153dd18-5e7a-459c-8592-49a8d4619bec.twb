              <calculation class='tableau' formula='// SUM(IF [is_target_brand_group] AND [is_target_brand_name] THEN [Gfv] ELSE NULL END) &#10;// / SUM(IF [is_target_brand_group] AND [is_target_brand_name] THEN [Orders] ELSE NULL END)&#10;&#10;WINDOW_SUM(&#10;    SUM(IF [Calculation_487233240156688384] AND [is_target_brand_group （複製）_145311521471709190] THEN [gfv] END),&#10;    -11,&#10;    0&#10;)/&#10;WINDOW_SUM(&#10;    SUM(IF [Calculation_487233240156688384] AND [is_target_brand_group （複製）_145311521471709190] THEN [orders] END),&#10;    -11,&#10;    0&#10;)'>
