                <zone fixed-size='1081' h='60500' id='518' is-fixed='true' name='Ads&amp;Deal Table' show-title='false' w='98546' x='727' y='22443'>
                  <layout-cache type-h='fixed' type-w='cell' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone fixed-size='112' h='6222' id='2030' is-fixed='true' param='horz' type-v2='layout-flow' w='98546' x='727' y='82943'>
                  <zone fixed-size='454' forceUpdate='true' h='6222' id='524' is-fixed='true' type-v2='text' w='42000' x='727' y='82943'>
                    <formatted-text>
                      <run>指標定義</run>
                      <run fontname='PP Agrandir'> Definition of Metrics</run>
                      <run>
[1] 廣告業績：廣告帶來的訂單業績
[2] 廣告投入比例：廣告成本占總業績百分比
[3] 廣告投報率：廣告業績相對廣告成本的比例
[4] 廣告新客數：藉由廣告吸引的新客（首次下單顧客）數量
（廣告產品包含：熱門推薦 CPC、Pandabox、指定新客折扣 Deal Targeting、Deals、Display ADs）</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone forceUpdate='true' h='6222' id='2031' type-v2='text' w='56546' x='42727' y='82943'>
                    <formatted-text>
                      <run>Æ&#10;</run>
                      <run fontname='PP Agrandir'>[1] Ads GFV: Total GFV of orders from ads, including CPC, Pandabox, Deal Targeting, Deals, Display ADs)</run>
                      <run>Æ&#10;</run>
                      <run fontname='PP Agrandir'>[2] Ads Cost%: Total Ads cost / Total GFV (Ads cost includes cpc cost, pandabox fee, pandabox voucher value, deal targeting fee, deal targeting discount value, deals&apos; value, display ads budget)</run>
                      <run>Æ&#10;</run>
                      <run fontname='PP Agrandir'>[3] Ads ROI: Ads GFV / Ads Cost Ads cost includes cpc cost, pandabox fee, pandabox voucher value, deal targeting fee, deal targeting discount value, deals&apos; value, display ads budget)</run>
                      <run>Æ&#10;</run>
                      <run fontname='PP Agrandir'>[4] Ads New Customer: Number of new customers attracted through advertising</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
                <zone h='1778' id='5945' param='horz' type-v2='layout-flow' w='98546' x='727' y='89165' />
              </zone>
