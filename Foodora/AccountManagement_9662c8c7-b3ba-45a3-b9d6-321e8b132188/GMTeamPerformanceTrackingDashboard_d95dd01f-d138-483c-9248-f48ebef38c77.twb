          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.17298db0jnndjp113t9wk0fthudc'>
            <column caption='# account' datatype='integer' name='[# account (copy)_60517169437458434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([agent_name])' />
            </column>
            <column caption='# brand' datatype='integer' name='[# brand (copy)_4939885890848587776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [sub_team_lv1],[Calculation_285697110781050880 1]: &#13;&#10;   COUNTD(IF ([team] = &apos;GMB&apos; OR [team] = &apos;AAA&apos;) AND [is_active] = TRUE&#13;&#10;            THEN [brand_name]&#13;&#10;          END)}' />
            </column>
            <column caption='# outlet' datatype='integer' name='[# outlet (copy 3)_387028140070109185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [agent_name],[Calculation_285697110781050880 1],[vendor_code]:MAX(IF [vendor_code] != &apos;AAA&apos; AND [is_active] = TRUE THEN [vendors] ELSE 0 END)})&#13;&#10;+&#13;&#10;SUM({FIXED [agent_name],[Calculation_285697110781050880 1],[vendor_code]:&#13;&#10;SUM({FIXED [brand_name]:MAX(IF [vendor_code] = &apos;AAA&apos; AND [is_active] = TRUE THEN [vendors] ELSE 0 END)})})' />
            </column>
            <column caption='% V/O FD Vx over deal Vx' datatype='real' name='[% VFD Vx over deal Vx (copy)_1433552115787546628 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[deal Vx (copy)_1235675202932699163 1]/[Calculation_387028140144406535 1]' />
            </column>
            <column caption='% V/O FD utilization over deal Vx all orders' datatype='real' name='[% VFD utilization over deal Vx all orders (copy)_1433552115787472899 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1235675202930880536 1]) / SUM(IF [deal Vx list (copy)_5112078209517359109 1] = &apos;0&apos; THEN 0 ELSE [orders] END)' />
            </column>
            <column caption='% V/O FD utilization over deal orders' datatype='real' name='[% VFD utilization over deal orders (copy)_1433552115787436034 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1235675202930880536 1]) / SUM([daily deal orders (copy)_1235675202892288021 1])' />
            </column>
            <column caption='% gmv  over platform' datatype='real' name='[% gmv  over platform (copy)_1433552115787358209 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv]) / SUM({FIXED [report_date]:MAX([platform_gmv])})' />
            </column>
            <column caption='vendor deal orders (parameter)' datatype='integer' name='[Calculation_1235675202930880536 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;  WHEN &apos;deal&apos; THEN [Calculation_2262495904509874177]&#13;&#10;  WHEN &apos;discount&apos; THEN [Vendor/Own deal orders  (parameter) (copy) (copy)_2262495904510554115]&#13;&#10;  WHEN &apos;voucher&apos; THEN [Vendor/Own discount orders  (parameter) (copy) (copy)_2262495904511102981]&#13;&#10;END' />
            </column>
            <column caption='afv' datatype='real' name='[Calculation_192247455084838916 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv])/SUM([orders])' />
