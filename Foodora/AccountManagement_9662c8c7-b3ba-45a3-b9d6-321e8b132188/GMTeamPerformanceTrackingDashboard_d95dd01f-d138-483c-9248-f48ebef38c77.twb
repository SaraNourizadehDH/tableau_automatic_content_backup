      <aliases enabled='yes' />
      <column caption='# account' datatype='integer' name='[# account (copy)_60517169437458434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([agent_name])' />
      </column>
      <column caption='# brand' datatype='integer' name='[# brand (copy)_4939885890848587776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [sub_team_lv1],[Calculation_285697110781050880 1]: &#13;&#10;   COUNTD(IF ([team] = &apos;GMB&apos; OR [team] = &apos;AAA&apos;) AND [is_active] = TRUE&#13;&#10;            THEN [brand_name]&#13;&#10;          END)}' />
      </column>
      <column caption='# outlet' datatype='integer' name='[# outlet (copy 3)_387028140070109185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [agent_name],[Calculation_285697110781050880 1],[vendor_code]:MAX(IF [vendor_code] != &apos;AAA&apos; AND [is_active] = TRUE THEN [vendors] ELSE 0 END)})&#13;&#10;+&#13;&#10;SUM({FIXED [agent_name],[Calculation_285697110781050880 1],[vendor_code]:&#13;&#10;SUM({FIXED [brand_name]:MAX(IF [vendor_code] = &apos;AAA&apos; AND [is_active] = TRUE THEN [vendors] ELSE 0 END)})})' />
      </column>
      <column caption='% V/O FD Vx over deal Vx' datatype='real' name='[% VFD Vx over deal Vx (copy)_1433552115787546628 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[deal Vx (copy)_1235675202932699163 1]/[Calculation_387028140144406535 1]' />
      </column>
      <column caption='% V/O FD utilization over deal Vx all orders' datatype='real' name='[% VFD utilization over deal Vx all orders (copy)_1433552115787472899 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1235675202930880536 1]) / SUM(IF [deal Vx list (copy)_5112078209517359109 1] = &apos;0&apos; THEN 0 ELSE [orders] END)' />
      </column>
      <column caption='% V/O FD utilization over deal orders' datatype='real' name='[% VFD utilization over deal orders (copy)_1433552115787436034 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1235675202930880536 1]) / SUM([daily deal orders (copy)_1235675202892288021 1])' />
      </column>
      <column caption='% gmv  over platform' datatype='real' name='[% gmv  over platform (copy)_1433552115787358209 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv]) / SUM({FIXED [report_date]:MAX([platform_gmv])})' />
      </column>
      <column caption='start_date' datatype='date' name='[Calculation_118782488938762240 1]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MIN([report_date])' />
      </column>
      <column caption='vendor deal orders (parameter)' datatype='integer' name='[Calculation_1235675202930880536 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;  WHEN &apos;deal&apos; THEN [Calculation_2262495904509874177]&#13;&#10;  WHEN &apos;discount&apos; THEN [Vendor/Own deal orders  (parameter) (copy) (copy)_2262495904510554115]&#13;&#10;  WHEN &apos;voucher&apos; THEN [Vendor/Own discount orders  (parameter) (copy) (copy)_2262495904511102981]&#13;&#10;END' />
      </column>
      <column caption='afv' datatype='real' name='[Calculation_192247455084838916 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv])/SUM([orders])' />
      </column>
      <column caption='days' datatype='integer' name='[Calculation_192247455116853258 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([report_date])' />
      </column>
      <column caption='Vendor/Own deal orders  (parameter)' datatype='integer' name='[Calculation_2262495904509874177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;  WHEN &apos;Vendor Funded&apos;&#13;&#10;    THEN [vendor_deal_orders]&#13;&#10;  WHEN &apos;Own Funded&apos;&#13;&#10;    THEN [own_deal_orders]&#13;&#10;END' />
      </column>
      <column caption='vendor search (parameter)' datatype='boolean' name='[Calculation_2301902392301412352 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;&apos; &#13;&#10;  THEN TRUE&#13;&#10;  ELSE REGEXP_MATCH(LOWER([vendor_code]+[vendor_name]),LOWER(REGEXP_REPLACE([Parameters].[Parameter 1],&apos; |,|;&apos;,&apos;|&apos;)))&#13;&#10;END' />
      </column>
      <column caption='Partiton By (parameter)' datatype='string' name='[Calculation_285697110781050880 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;  WHEN &apos;Agent Name&apos; &#13;&#10;    THEN [agent_name]&#13;&#10;  WHEN &apos;Vendor Name&apos; &#13;&#10;    THEN [vendor_name]&#13;&#10;  WHEN &apos;Brand Name&apos; &#13;&#10;    THEN [brand_name]&#13;&#10;  WHEN &apos;City Name&apos; &#13;&#10;    THEN [restaurant_city]&#13;&#10;  WHEN &apos;Vendor Code&apos; &#13;&#10;    THEN [vendor_code]&#10;  WHEN &apos;All&apos;&#10;    THEN &apos;All&apos;&#13;&#10;END' />
      </column>
      <column caption='% outlet over platform' datatype='real' name='[Calculation_387028140135469058 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# outlet (copy 3)_387028140070109185] / MAX([platform_vendors])' />
      </column>
      <column caption='% orders over platform' datatype='real' name='[Calculation_387028140135804931 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/ SUM({FIXED [report_date]:MAX([platform_orders])})' />
      </column>
      <column caption='daily deal orders' datatype='real' name='[Calculation_387028140141858821 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([daily deal orders (copy)_1235675202892288021 1]) / [Calculation_192247455116853258 1]' />
      </column>
      <column caption='deal Vx' datatype='integer' name='[Calculation_387028140144406535 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [agent_name],[Calculation_285697110781050880 1],[vendor_code]:MAX(IF IFNULL([daily deal orders (copy)_1235675202892288021 1],0)&gt;0 AND [vendor_code] != &apos;AAA&apos; AND [is_active] = TRUE THEN [vendors] ELSE 0 END)})&#13;&#10;+&#13;&#10;SUM({FIXED [agent_name],[Calculation_285697110781050880 1],[vendor_code]:&#13;&#10;SUM({FIXED [brand_name]:MAX(IF IFNULL([daily deal orders (copy)_1235675202892288021 1],0)&gt;0 AND [vendor_code] = &apos;AAA&apos; AND [is_active] = TRUE THEN [vendors] ELSE 0 END)})&#13;&#10;})' />
      </column>
      <column caption='% V/O FD Vx over oulet' datatype='real' name='[Calculation_387028140153663497 1 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[deal Vx (copy)_1235675202932699163 1]/[# outlet (copy 3)_387028140070109185]' />
      </column>
      <column caption='daily gmv' datatype='real' name='[Daily Order (copy)_192247455116210184 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv])/[Calculation_192247455116853258 1]' />
      </column>
      <column caption='daily order' datatype='real' name='[Daily Order per vendors (copy)_192247455114932231 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/[Calculation_192247455116853258 1]' />
      </column>
      <column caption='GM_sub_team_name' datatype='string' datatype-customized='true' name='[GM_sub_team_name (copy)_6487646418901209088 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [agent_name]&#13;&#10;//----------------------------------- GMA2&#13;&#10; WHEN &apos;Dana Yuan&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Roger Yu&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Maggie_HC Cheng&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Joel Chen&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Cindy Wang&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Jerry_CL Huang&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Fion Chen&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Iron Chen&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Judy Chen&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Andy Hsieh&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Eva_YH Chen&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Sam Ding&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Lily Lin&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Tiana Peng&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Delia Chen&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Eileen_GL Zhuang&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Joy Wong&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Jenny _YL Lee&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Julia Chen&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Melissa Xu&apos; THEN &apos;GMA2&apos;&#13;&#10; WHEN &apos;Joyce Tsou&apos; THEN &apos;GMA2&apos;&#13;&#10;//----------------------------------- GMA1&#13;&#10; WHEN &apos;Leo Ke&apos; THEN &apos;GMA1&apos; &#13;&#10; WHEN &apos;Tina Huang&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Eva Liau&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Tracy Tseng&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Charlene Tu&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Kiki Chang&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Billyray Chen&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Jayden Huang&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Cindy Chung&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Dora Chen&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Selina_NF Hu&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Kevin Tseng&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Jane Liu&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Una Liao&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Ailsa Wang&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Taya Tsai&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Eva Cheng&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Mina_SM Hsu&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Sam Tu&apos; THEN &apos;GMA1&apos;&#13;&#10; WHEN &apos;Joyce Li&apos; THEN &apos;GMA1&apos;&#13;&#10;//----------------------------------- GMB1&#13;&#10; WHEN &apos;Mike Kuo&apos; THEN &apos;GMB1&apos;&#13;&#10; WHEN &apos;Stacy Guo&apos; THEN &apos;GMB1&apos;&#13;&#10; WHEN &apos;Banny Yin&apos; THEN &apos;GMB1&apos; &#13;&#10; WHEN &apos;Martin Lin&apos; THEN &apos;GMB1&apos; &#13;&#10; WHEN &apos;Shaki Lee&apos; THEN &apos;GMB1&apos;  &#13;&#10; WHEN &apos;Zenzen Lai&apos; THEN &apos;GMB1&apos;&#13;&#10; WHEN &apos;Middy Chang&apos; THEN &apos;GMB1&apos;&#13;&#10; WHEN &apos;Kelly Huang&apos; THEN &apos;GMB1&apos;  &#13;&#10; WHEN &apos;Ariel Pan&apos; THEN &apos;GMB1&apos;&#13;&#10; WHEN &apos;Elan Shi&apos; THEN &apos;GMB1&apos;  &#13;&#10;//----------------------------------- GMB2&#13;&#10; WHEN &apos;Tingting Hsu&apos; THEN &apos;GMB2&apos;&#13;&#10; WHEN &apos;Michelle Wang&apos; THEN &apos;GMB2&apos;&#13;&#10; WHEN &apos;Sandy Wu&apos; THEN &apos;GMB2&apos;&#13;&#10; WHEN &apos;Nancy Yen&apos; THEN &apos;GMB2&apos;&#13;&#10; WHEN &apos;Yuki Tsai&apos; THEN &apos;GMB2&apos;&#13;&#10; WHEN &apos;Holly Huang&apos; THEN &apos;GMB2&apos;&#13;&#10; WHEN &apos;Chris Liu&apos; THEN &apos;GMB2&apos;&#13;&#10; WHEN &apos;Louis Sung&apos; THEN &apos;GMB2&apos;&#13;&#10; WHEN &apos;VictorJT Chen&apos; THEN &apos;GMB2&apos;&#13;&#10; WHEN &apos;Calvin Chen&apos; THEN &apos;GMB2&apos;&#13;&#10; WHEN &apos;Betty Wang&apos; THEN &apos;GMB2&apos;&#13;&#10;//----------------------------------- SSC&#13;&#10; WHEN &apos;ssc&apos; THEN &apos;SSC&apos;&#13;&#10;//----------------------------------- AAA&#13;&#10; WHEN &apos;aaa&apos; THEN &apos;AAA&apos;&#13;&#10;ELSE &apos;未分類&apos;&#13;&#10;END' />
