                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Customers % delta%' datatype='real' name='[Customers delta% （複製）_3216766434071539712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[參數 4] = &quot;MoM&quot; THEN &#10;(([Calculation_3216766434071621633]) - LOOKUP(([Calculation_3216766434071621633]), 1)) &#10;/ ABS(LOOKUP(([Calculation_3216766434071621633]), 1))&#10;&#10;ELSEIF [Parameters].[參數 4] = &quot;YoY&quot; THEN &#10;(([Calculation_3216766434071621633]) - LOOKUP(([Calculation_3216766434071621633]), 12)) &#10;/ ABS(LOOKUP(([Calculation_3216766434071621633]), 12))&#10;&#10;END'>
