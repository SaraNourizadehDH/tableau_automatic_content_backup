            <column caption='NC/EC/Churn' datatype='string' name='[Calculation_1248130435995480086]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// IF [Customer Type] = &quot;nc&quot; THEN &quot;新客&quot; &#10;// ELSEIF CONTAINS([Customer Type], &quot;churn&quot;) THEN &quot;流失客&quot;&#10;// ELSE &quot;舊客&quot; END&#10;&#10;IF [Parameters].[是否為有廣告店家 （複製）] = &quot;全新客&quot; AND [new_customer_type] = &quot;nc&quot; THEN &quot;新客&quot;&#10;ELSEIF [Parameters].[是否為有廣告店家 （複製）] = &quot;30天內未下單&quot; AND (&#10;  [new_customer_type] = &quot;nc&quot; &#10;  OR [new_customer_type] = &quot;30d_nc&quot;&#10;  ) THEN &quot;新客&quot;&#10;ELSEIF [Parameters].[是否為有廣告店家 （複製）] = &quot;60天內未下單&quot; AND (&#10;  [new_customer_type] = &quot;nc&quot; &#10;  OR [new_customer_type] = &quot;30d_nc&quot;&#10;  OR [new_customer_type] = &quot;60d_nc&quot;&#10;  ) THEN &quot;新客&quot;&#10;ELSEIF [Parameters].[是否為有廣告店家 （複製）] = &quot;90天內未下單&quot; AND (&#10;  [new_customer_type] = &quot;nc&quot; &#10;  OR [new_customer_type] = &quot;30d_nc&quot;&#10;  OR [new_customer_type] = &quot;60d_nc&quot;&#10;  OR [new_customer_type] = &quot;90d_nc&quot;&#10;  ) THEN &quot;新客&quot;&#10;ELSEIF CONTAINS([new_customer_type], &quot;churn&quot;) THEN &quot;流失客&quot;&#10;ELSE &quot;舊客&quot; END' />
              <aliases>
                <alias key='&quot;新客&quot;' value='新客NC' />
                <alias key='&quot;流失客&quot;' value='流失客 Churn' />
                <alias key='&quot;舊客&quot;' value='舊客EC' />
              </aliases>
            </column>
            <column caption='AFV' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_1248130435998183447]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gfv])/SUM([total_orders])' />
