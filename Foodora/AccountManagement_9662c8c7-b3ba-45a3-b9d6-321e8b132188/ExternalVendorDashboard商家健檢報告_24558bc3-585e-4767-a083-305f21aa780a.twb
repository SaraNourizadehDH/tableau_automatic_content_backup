          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[sqlproxy.1eabi1v1sii8sh1dv1isw1w59ls5].[report_month]' caption='Target Month' datatype='date' default-format='*yyyy/mm' name='[參數 2]' param-domain-type='list' role='measure' type='quantitative' value='#2025-07-01#'>
