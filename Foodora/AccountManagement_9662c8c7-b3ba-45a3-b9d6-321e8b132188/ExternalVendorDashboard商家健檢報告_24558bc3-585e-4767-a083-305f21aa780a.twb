        <calculation class='tableau' formula='IF [CVR delta% （複製）_1526368450800238608] &lt;= 0 THEN&#10;&quot;▼ &quot; + STR(ROUND([CVR delta% （複製）_1526368450800238608]*100, 1)) + &quot;%&quot;&#10;END'>
