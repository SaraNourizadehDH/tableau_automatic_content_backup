            <column caption='AFV delta%' datatype='real' name='[GFV delta% （複製）_1526368450795474949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[參數 4] = &quot;MoM&quot; THEN &#10;(MAX([afv]) - LOOKUP(MAX([afv]), 1)) &#10;/ ABS(LOOKUP(MAX([afv]), 1))&#10;&#10;ELSEIF [Parameters].[參數 4] = &quot;YoY&quot; THEN &#10;(MAX([afv]) - LOOKUP(MAX([afv]), 12)) &#10;/ ABS(LOOKUP(MAX([afv]), 12))&#10;&#10;END'>
