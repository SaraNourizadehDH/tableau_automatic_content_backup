      <column caption='mCVR2 delta%' datatype='real' name='[CVR delta% （複製）_1526368450800238608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[參數 4] = &quot;MoM&quot; THEN &#10;(SUM([mcvr2]) - LOOKUP(SUM([mcvr2]), 1)) &#10;/ ABS(LOOKUP(SUM([mcvr2]), 1))&#10;&#10;ELSEIF [Parameters].[參數 4] = &quot;YoY&quot; THEN &#10;(SUM([mcvr2]) - LOOKUP(SUM([mcvr2]), 12)) &#10;/ ABS(LOOKUP(SUM([mcvr2]), 12))&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='mCVR2_marktet_trend_stats' datatype='real' default-format='p0.0%' name='[CVR_marktet_trend_stats （複製）_6458584119506452494]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[參數 1]&#10;WHEN &quot;平均值&quot; THEN AVG([mCVR2_target_vendor （複製）_3152379032772431878])&#10;WHEN &quot;百分位數 10&quot; THEN PERCENTILE([mCVR2_target_vendor （複製）_3152379032772431878],0.10)&#10;WHEN &quot;百分位數 25&quot; THEN PERCENTILE([mCVR2_target_vendor （複製）_3152379032772431878],0.25)&#10;WHEN &quot;百分位數 50&quot; THEN PERCENTILE([mCVR2_target_vendor （複製）_3152379032772431878],0.50)&#10;WHEN &quot;百分位數 75&quot; THEN PERCENTILE([mCVR2_target_vendor （複製）_3152379032772431878],0.75)&#10;WHEN &quot;百分位數 90&quot; THEN PERCENTILE([mCVR2_target_vendor （複製）_3152379032772431878],0.90)&#10;ELSE NULL END' />
      </column>
      <column caption='CVR_market_trend' datatype='real' default-format='p0.0%' name='[CVR_target_vendor （複製）_3152379032772497415]' role='measure' type='quantitative'>
