          <datasource-dependencies datasource='sqlproxy.1eabi1v1sii8sh1dv1isw1w59ls5'>
            <column caption='Offline Rate_target_vendor' datatype='real' default-format='p0.0%' name='[CVR_target_vendor （複製）_78742653038915588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(IF [is_target_month （複製）_1090926668880277504]&#10;THEN [offline_rate]&#10;ELSE NULL END)' />
            </column>
            <column caption='Same Chain Vendors' datatype='integer' name='[Calculation_1202109306667966464]' role='measure' type='quantitative'>
