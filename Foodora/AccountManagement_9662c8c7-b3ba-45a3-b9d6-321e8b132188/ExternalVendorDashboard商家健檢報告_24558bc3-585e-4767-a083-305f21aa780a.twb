      <column caption='mCVR2 +delta%' datatype='string' default-format='p0.0%' name='[CVR +delta% （複製）_1526368450800238606]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [CVR delta% （複製）_1526368450800238608] &gt; 0 THEN&#10;&quot;▲ &quot; + STR(ROUND([CVR delta% （複製）_1526368450800238608]*100, 1)) + &quot;%&quot;&#10;END'>
