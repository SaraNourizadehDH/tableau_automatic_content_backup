            <column caption='AFV -delta%' datatype='string' default-format='p0.0%' name='[GFV -delta% （複製）_1526368450795474951]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [GFV delta% （複製）_1526368450795474949] &lt;= 0 THEN&#10;&quot;▼ &quot; + STR(ROUND([GFV delta% （複製）_1526368450795474949]*100, 1)) + &quot;%&quot;&#10;END'>
