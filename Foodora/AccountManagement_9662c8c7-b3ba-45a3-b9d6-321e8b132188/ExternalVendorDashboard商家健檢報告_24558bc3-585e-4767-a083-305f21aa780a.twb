            <column caption='is_market_competitors_enough' datatype='boolean' name='[Calculation_2273684543699451910]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[顯示/隱藏市場趨勢 （複製）_3152379032778375181] != &quot;全部&quot; THEN&#10;    IF [Calculation_1202109306667966464] &gt;= 5&#10;    THEN TRUE ELSE FALSE END&#10;ELSE&#10;    IF [Same Outlet Competitors （複製）_2273684543677116416] &gt;= 10&#10;    THEN TRUE ELSE FALSE END&#10;END' />
            </column>
            <column caption='is_same_chain_only' datatype='boolean' name='[Calculation_3152379032758788096]' role='dimension' type='nominal'>
