            <column caption='Vendor Late Above 10 Minutes Count' datatype='integer' name='[vendor_late_above_10_minutes_count]' role='measure' type='quantitative' />
            <column caption='Vendor Late In Minutes Count' datatype='integer' name='[vendor_late_in_minutes_count]' role='measure' type='quantitative' />
            <column caption='Weekly Distinct Active Rider Count' datatype='integer' name='[weekly_distinct_active_rider_count]' role='measure' type='quantitative' />
            <column caption='Weekly Distinct Rider Active Last 28 Days Count' datatype='integer' name='[weekly_distinct_rider_active_last_28_days_count]' role='measure' type='quantitative' />
            <column caption='Avg. Dropoff Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ø At Vendor Time (copy)_1813121115900784693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_to_customer_time_in_minutes]) / sum([to_customer_time_in_minutes_count])' />
            </column>
            <column caption='Avg. Cost per Reactivation' datatype='real' default-format='c#,##0.00&quot;€&quot;;-#,##0.00&quot;€&quot;' name='[Ø Cost per Hire (copy)_5380746089329614864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_reactivation_cost_eur])&#10;/ sum([rider_reactivated_count])' />
            </column>
            <column caption='Avg. Cost per Hire' datatype='real' default-format='c#,##0.00&quot;€&quot;;-#,##0.00&quot;€&quot;' name='[Ø Cost per Lead (copy)_1813121115910537280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ifnull(sum([total_marketing_cost_eur]),0)&#10;+ifnull(sum([total_recruitment_cost_not_proportioned_eur]),0))&#10;/ sum([hire_count])' />
            </column>
            <column caption='Avg. Dispatching Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ø Delivery Time (copy)_1813121115900129329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_dispatching_time_in_minutes]) / sum([dispatching_time_in_minutes_count])' />
            </column>
            <column caption='Avg. Rider Accepting Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ø Dispatching Time (copy)_1813121115900309554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_rider_accepting_time_in_minutes]) / sum([rider_accepting_time_in_minutes_count])' />
            </column>
            <column caption='Avg. At Customer Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ø Dropoff Time (copy)_1813121115900854326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_at_customer_time_in_minutes]) / sum([at_customer_time_in_minutes_count])' />
            </column>
            <column caption='Avg. Recruitment CPO' datatype='real' default-format='c#,##0.00&quot;€&quot;;-#,##0.00&quot;€&quot;' name='[Ø Other CPO (copy)_1813121115908968507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_recruitment_cost_not_proportioned_eur]) / sum([successful_order_count])' />
            </column>
            <column caption='Avg. At Vendor Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ø Pickup Time (copy)_1813121115900633140]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_at_vendor_time_in_minutes]) / sum([at_vendor_time_in_minutes_count])' />
            </column>
            <column caption='Avg. Pickup Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ø Rider Accepting Time (copy)_1813121115900407859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_to_vendor_time_in_minutes]) / sum([to_vendor_time_in_minutes_count])' />
            </column>
            <column caption='Avg. Delivery CPO' datatype='real' default-format='c#,##0.00&quot;€&quot;;-#,##0.00&quot;€&quot;' name='[Ø Rider Earning per Hour (copy)_1813121115908530233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_delivery_rider_cost_not_proportioned_eur]) / sum([successful_order_count])' />
            </column>
            <column caption='Avg. Cost per Lead' datatype='real' default-format='c#,##0.00&quot;€&quot;;-#,##0.00&quot;€&quot;' name='[Ø Rider Earning per Hour (copy)_1813121115910316095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ifnull(sum([total_marketing_cost_eur]),0)&#10;+ifnull(sum([total_recruitment_cost_not_proportioned_eur]),0))&#10;/ sum([lead_count])' />
            </column>
            <column caption='Avg. Rider Earning per Hour ' datatype='real' default-format='n#,##0.00&quot;€&quot;;-#,##0.00&quot;€&quot;' name='[Ø Rider Earning per Hour (copy)_5106026502200827932]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IFNULL(SUM([total_delivery_rider_cost_not_proportioned_eur]),0)&#10;+IFNULL(SUM([total_recruitment_cost_not_proportioned_eur]),0)&#10;+IFNULL(SUM([total_tip_payment_eur]),0))&#10;/SUM([total_evaluation_working_time_in_hours])' />
            </column>
            <column caption='Avg. UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ø Rider Rating (copy)_1813121115898679337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([order_actual_count]) / SUM([total_evaluation_working_time_in_hours]) &gt; 6&#10;THEN NULL&#10;ELSE SUM([order_actual_count]) / SUM([total_evaluation_working_time_in_hours])&#10;END' />
            </column>
            <column caption='Avg. Rider Earning per Hour' datatype='real' default-format='n#,##0.00&quot;€&quot;;-#,##0.00&quot;€&quot;' name='[Ø Rider Rating (copy)_5106026502192631832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IFNULL(SUM([total_delivery_rider_cost_not_proportioned_eur]),0)&#10;+IFNULL(SUM([total_recruitment_cost_not_proportioned_eur]),0)&#10;+IFNULL(SUM([total_tip_payment_eur]),0))&#10;/SUM([total_evaluation_working_time_in_hours])' />
            </column>
            <column caption='Avg. Delivery Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Ø Rider Rating (copy)_5106026502195335193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_delivery_time_in_minutes]) / SUM([delivery_time_in_minutes_count])' />
            </column>
