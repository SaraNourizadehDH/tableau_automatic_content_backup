    <worksheet name='Table Daily'>
      <table>
        <view>
          <datasources>
            <datasource caption='logistics__scorecard_daily (pandata_report)' name='federated.0yej4cp0fahf9a13h8brb1adbh2e' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0yej4cp0fahf9a13h8brb1adbh2e'>
            <column caption='Avg. Rider Hours per Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# Active Days per Month (copy)_1813121115894390823]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_evaluation_working_time_in_hours]) / sum([evaluation_working_time_in_hours_count])' />
            </column>
            <column caption='Avg. Active Days' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# Actual Rider Hours (copy)_1813121115893706790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_active_count]) / &#10;&#10;CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN SUM([rider_active_count])&#10;WHEN &apos;Week&apos; THEN SUM([weekly_distinct_active_rider_count])&#10;WHEN &apos;Month&apos; THEN SUM([monthly_distinct_active_rider_count])&#10;END' />
            </column>
            <column caption='# Activated Riders' datatype='integer' name='[# Actual Rider Hours (copy)_4348506939885342723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([activated_count])' />
            </column>
            <column caption='% COD collection' datatype='real' default-format='p0.0%' name='[# Cost of Failed Orders (copy)_1813121115909177404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cod_return_share_n]) / sum([cod_return_share_d])' />
            </column>
            <column caption='Avg. Hires to Ride (CVT)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# Leads to Hire (CVT) (copy)_1813121115892191262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_days_to_activation_excluding_3pl]) / sum([days_to_activation_excluding_3pl_count])' />
            </column>
            <column caption='% dCPO / AFV (OD)' datatype='real' default-format='p0.0%' name='[% Acceptance Rate (copy)_1813121115907813432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([total_delivery_rider_cost_not_proportioned_eur]) / sum([successful_order_count])) &#10;/ &#10;(sum([total_gfv_eur]) / sum([successful_order_count]))' />
            </column>
            <column caption='% Active Riders' datatype='real' default-format='p0.0%' name='[% CVR (copy)_1813121115889606678]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN SUM(rider_active_count) / SUM(daily_distinct_rider_active_last_28_days_count)&#10;WHEN &apos;Week&apos; THEN SUM(weekly_distinct_active_rider_count) / SUM(weekly_distinct_rider_active_last_28_days_count)&#10;WHEN &apos;Month&apos; THEN SUM(monthly_distinct_active_rider_count) / SUM(monthly_distinct_rider_active_last_28_days_count)&#10;END' />
            </column>
            <column caption='% Hires to Ride (CVR)' datatype='real' default-format='p0.0%' name='[% CVR (copy)_1813121115890176026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([activated_excluding_3pl_count]) / sum([hire_excluding_3pl_count])' />
            </column>
            <column caption='% New Rider Churn' datatype='real' default-format='p0.00%' name='[% CVR (copy)_1813121115892645919]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([new_rider_churned_count]) / sum([rider_activated_count])' />
            </column>
            <column caption='% CVR (with events and mean delay &gt; 8 mins)' datatype='real' default-format='p0.0%' name='[% Closure (copy)_5106026502190391314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transaction_with_event_and_mean_delay_more_than_8_count]) / SUM([session_with_event_and_mean_delay_more_than_8_count])' />
            </column>
            <column caption='Avg. Rider Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[% Fail Rate (copy)_5106026502188335110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_rider_score]) / SUM([rider_score_count])' />
            </column>
            <column caption='% Orders Late &lt;10min' datatype='real' default-format='p0.0%' name='[% Fail Rate (copy)_5106026502189199368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_below_10_minutes_count]) / SUM([order_delay_in_minutes_count])' />
            </column>
            <column caption='% No Rider Fail' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_5106026502189584395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_order_logistics_no_rider_count]) / SUM([gross_order_count])' />
            </column>
            <column caption='% Shrink' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_5106026502190063630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrink_order_count]) / SUM([forecasted_adjusted_order_count])' />
            </column>
            <column caption='% Fill Rate' datatype='real' default-format='p0.0%' name='[% Fail Rate (copy)_5106026502190710805]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([open_slots_assigned_count]) / SUM([open_slot_count])' />
            </column>
            <column caption='% Acceptance Rate' datatype='real' default-format='p0.0%' name='[% Fill Rate (copy)_1813121115899121707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([rider_accepted_count]) / sum([rider_notified_count])' />
            </column>
            <column caption='% Idle TIme' datatype='real' default-format='p0.0%' name='[% Fill Rate (copy)_1813121115899863086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-sum([total_transition_busy_time_in_hours]) / sum([total_transition_working_time_in_hours])' />
            </column>
            <column caption='% No Show Hours' datatype='real' default-format='p0.0%' name='[% Fill Rate (copy)_5106026502190833686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IFNULL(SUM([total_no_show_duration_in_hours]),0) + IFNULL(SUM([total_excused_no_shows_duration_in_hours]),0)) / SUM([total_planned_shift_duration_in_hours])' />
            </column>
            <column caption='% Leads to Hire (CVR)' datatype='real' default-format='p0.0%' name='[% Hires to Ride (CVR) (copy)_1813121115891163163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([hire_excluding_3pl_count]) / sum([lead_excluding_3pl_count])' />
            </column>
            <column caption='Avg. Leads to Hire (CVT)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[% Leads to Hire (CVR) (copy)_1813121115891286044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_days_to_approval_excluding_3pl]) / sum([days_to_approval_excluding_3pl_count])' />
            </column>
            <column caption='% Experienced Rider Churn' datatype='real' default-format='p0.0%' name='[% New Rider Churn (copy)_1813121115892908064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_churned_count]) / (&#10;&#10;CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN SUM([daily_distinct_rider_active_last_28_days_count])&#10;WHEN &apos;Week&apos; THEN SUM([weekly_distinct_rider_active_last_28_days_count])&#10;WHEN &apos;Month&apos; THEN SUM([monthly_distinct_rider_active_last_28_days_count])&#10;END&#10; + SUM([rider_churned_count]))' />
            </column>
            <column caption='% Reactivated' datatype='real' default-format='p0.0%' name='[% No Rider Fail (copy)_1813121115893141537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_reactivated_count]) / &#10;&#10;CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN SUM([daily_distinct_rider_active_last_28_days_count])&#10;WHEN &apos;Week&apos; THEN SUM([weekly_distinct_rider_active_last_28_days_count])&#10;WHEN &apos;Month&apos; THEN SUM([monthly_distinct_rider_active_last_28_days_count])&#10;END' />
            </column>
            <column caption='% Rider Incident Fail' datatype='real' default-format='p0.00%' name='[% No Rider Fail (copy)_5106026502189797388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_order_rider_incident_count]) / SUM([gross_order_count])' />
            </column>
            <column caption='% Break Hours' datatype='real' default-format='p0.0%' name='[% No Shows (copy)_5106026502191177751]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_evaluation_break_time_in_hours]) / (IFNULL(SUM([total_evaluation_break_time_in_hours]),0) + IFNULL(SUM([total_evaluation_working_time_in_hours]),0))' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[% On Time (copy)_5106026502188204037]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_order_count]) / SUM([gross_order_count])' />
            </column>
            <column caption='% Rider Late &gt;10min' datatype='real' default-format='p0.0%' name='[% Orders Late &lt;10min (copy) (copy)_1813121115899346989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([rider_late_above_10_minutes_count]) / sum([rider_late_in_minutes_count])' />
            </column>
            <column caption='% Vendor Late &gt;10min' datatype='real' default-format='p0.0%' name='[% Orders Late &lt;10min (copy)_1813121115899334700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_late_above_10_minutes_count]) / sum([vendor_late_in_minutes_count])' />
            </column>
            <column caption='% Orders Late &gt;30min' datatype='real' default-format='p0.00%' name='[% Orders Late &lt;10min (copy)_5106026502189318153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_above_30_minutes_count]) / SUM([order_delay_in_minutes_count])' />
            </column>
            <column caption='% Orders DT &gt;45min' datatype='real' default-format='p0.00%' name='[% Orders Late &gt;30min (copy)_5106026502189383690]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_above_45_minutes_count]) / SUM([delivery_time_in_minutes_count])' />
            </column>
            <column caption='% Customer Delay Fail' datatype='real' default-format='p0.00%' name='[% Rider Incident Fail (copy)_5106026502189924365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_order_customer_delay_count]) / SUM([gross_order_count])' />
            </column>
            <column caption='% Stack Rate' datatype='real' default-format='p0.00%' name='[% Shrink (copy)_1813121115910008893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([stacked_delivery_count]) / sum([completed_delivery_count])' />
            </column>
            <column caption='% Shrink 2+' datatype='real' default-format='p0.00%' name='[% Shrink (copy)_5106026502190219279]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrink_more_than_2_order_count]) / SUM([forecasted_adjusted_order_count])' />
            </column>
            <column caption='% Surge' datatype='real' default-format='p0.00%' name='[% Shrink (copy)_8873850486911881245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([surged_order_count]) / SUM([dps_session_mapped_to_order_count])' />
            </column>
            <column caption='% Orders with Rider Tips' datatype='real' default-format='p0.00%' name='[% Shrink 2+ (copy)_1813121115910144062]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([online_tip_order_count]) / sum([online_payment_order_count])' />
            </column>
            <column caption='% Closure' datatype='real' default-format='p0.00%' name='[% Shrink 2+ (copy)_5106026502190284816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([close_order_count]) / SUM([forecasted_adjusted_order_count])' />
            </column>
            <column caption='# Hires' datatype='integer' default-format='n#,##0;-#,##0' name='[Actual Rider Hour (copy) (copy)_1813121115889852440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([hire_count])' />
            </column>
            <column caption='# Leads' datatype='integer' default-format='n#,##0;-#,##0' name='[Actual Rider Hour (copy)_1813121115889840151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([lead_count])' />
            </column>
            <column caption='Avg. Cost per Activation' datatype='real' default-format='c#,##0.00&quot;€&quot;;-#,##0.00&quot;€&quot;' name='[Avg. Cost per Hire (copy)_4348506939884793858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ifnull(sum([total_marketing_cost_eur]),0)&#10;+ifnull(sum([total_recruitment_cost_not_proportioned_eur]),0))&#10;/ sum([activated_count])' />
            </column>
            <column caption='Report Year Local' datatype='date' datatype-customized='true' name='[Calculation_1038853809050353664]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;yyyy&quot;, STR(DATEPART(&apos;year&apos;, [report_date_local])) )) ' />
            </column>
            <column caption='% Surge with Surge Fee &gt; 0' datatype='real' default-format='p0.0%' name='[Calculation_1266215219698544641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([surged_order_with_surge_fee_count])/SUM([dps_session_mapped_to_order_count])' />
            </column>
            <column caption='% Healthy Vendor Availability' datatype='real' default-format='p0.0%' name='[Calculation_1813121115864145924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([healthy_vendor_availability_session_count]) / sum([availability_session_count])' />
            </column>
            <column caption='% RHI' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1813121115864965127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([rider_happiness_index_satisfied_count]) / sum([rider_happiness_index_response_count])' />
            </column>
            <column caption='# Fleet Size' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1813121115891675165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN SUM([daily_distinct_rider_active_last_28_days_count])&#10;WHEN &apos;Week&apos; THEN SUM([weekly_distinct_rider_active_last_28_days_count])&#10;WHEN &apos;Month&apos; THEN SUM([monthly_distinct_rider_active_last_28_days_count])&#10;END' />
            </column>
            <column caption='# Successful Orders' datatype='integer' name='[Calculation_3493526727178362885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_order_count])' />
            </column>
            <column caption='# GMV' datatype='real' default-format='c#,##0&quot;€&quot;;-#,##0&quot;€&quot;' name='[Calculation_3493526727178633222]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_user_paid_gmv_eur])' />
            </column>
            <column aggregation='Sum' caption='Day of Month' datatype='integer' name='[Calculation_3956975232009183237]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DAY([report_date_local])' />
            </column>
            <column caption='Pandora' datatype='string' name='[Calculation_5106026502175227905]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Pandora&apos;' />
            </column>
            <column caption='% On Time' datatype='real' default-format='p0.0%' name='[Calculation_5106026502175358978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;      (&#10;          SUM(pdt_bucket_10_is_order_on_time_within_10_minutes_n)/&#10;          SUM(pdt_bucket_10_is_order_on_time_within_10_minutes_d)&#10;      ) * MAX(pdt_bucket_10_is_order_on_time_weight),&#10;      0&#10;    )&#10;    + &#10;    IFNULL(&#10;      (&#10;          SUM(pdt_bucket_20_is_order_on_time_within_10_minutes_n)/&#10;          SUM(pdt_bucket_20_is_order_on_time_within_10_minutes_d)&#10;      ) * MAX(pdt_bucket_20_is_order_on_time_weight),&#10;      0&#10;    )&#10;    +&#10;    IFNULL(&#10;      (&#10;          SUM(pdt_bucket_30_is_order_on_time_within_10_minutes_n)/&#10;          SUM(pdt_bucket_30_is_order_on_time_within_10_minutes_d)&#10;      ) * MAX(pdt_bucket_30_is_order_on_time_weight),&#10;      0&#10;    )&#10;    +&#10;    IFNULL(&#10;      (&#10;          SUM(pdt_bucket_40_is_order_on_time_within_10_minutes_n)/&#10;          SUM(pdt_bucket_40_is_order_on_time_within_10_minutes_d)&#10;      ) * MAX(pdt_bucket_40_is_order_on_time_weight),&#10;      0&#10;    )&#10;    +&#10;    IFNULL(&#10;      (&#10;          SUM(pdt_bucket_50_is_order_on_time_within_10_minutes_n)/&#10;          SUM(pdt_bucket_50_is_order_on_time_within_10_minutes_d)&#10;      ) * MAX(pdt_bucket_50_is_order_on_time_weight),&#10;      0&#10;    )&#10;    +&#10;    IFNULL(&#10;      (&#10;          SUM(pdt_bucket_60_is_order_on_time_within_10_minutes_n)/&#10;          SUM(pdt_bucket_60_is_order_on_time_within_10_minutes_d)&#10;      ) * MAX(pdt_bucket_60_is_order_on_time_weight),&#10;      0&#10;    )' />
            </column>
            <column caption='Time Granularity' datatype='date' name='[Calculation_5106026502179749892]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Day&apos; then [report_date_local]&#10;when &apos;Week&apos; then [report_week_local]&#10;when &apos;Month&apos; then [report_month_local]&#10;when &apos;Year&apos; then [Calculation_1038853809050353664]&#10;end' />
            </column>
            <column caption='# Actual Rider Hours' datatype='real' name='[Calculation_5106026502190526483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_evaluation_working_time_in_hours])' />
            </column>
            <column caption='Country Group' datatype='string' name='[Calculation_5380746023765225529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [region] = &quot;Asia&quot;&#10;then &quot;APAC&quot;&#10;else &quot;EU + TR&quot;&#10;end' />
            </column>
            <column caption='Timeframe' datatype='date' name='[Calculation_5380746027628564548]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='ifnull([report_date_local],[report_month_local])' />
            </column>
            <column caption='Avg. Food Value (AFV)' datatype='real' name='[Calculation_5582774751779188748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_gfv_eur]) / sum([successful_order_count])' />
            </column>
            <column caption='Avg. Logistics Failed Order CPO*1000' datatype='real' name='[Calculation_6407285280869216257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_logistics_failed_order_cost_eur]) / &#10;sum([gross_order_count])*1000' />
            </column>
            <column caption='% Logistics Failed Orders Costs over GFV' datatype='real' name='[Calculation_6407285280872693762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_logistics_failed_order_cost_eur])/&#10;sum([total_gfv_eur])' />
            </column>
            <column caption='% Stacking Monetization (global)' datatype='real' name='[Calculation_7898258268939075587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([cpo_delta_total] * [Successful Order Count]) / sum([Successful Order Count])&#10;&#10;/*&#10;IF [Parameters].[Time Granularity] = &apos;Month&apos; THEN&#10;&#10;  SUM(&#10;    { FIXED [Report Month Local], [Country Name] : MAX(cpo_delta_total)} &#10;    * &#10;    { FIXED [Report Month Local], [Country Name] : MAX([Successful Order Count])}&#10;  ) &#10;&#10;  / &#10;&#10;  SUM({ FIXED [Report Month Local], [Country Name] : MAX([Successful Order Count])})&#10;&#10;END&#10;*/&#10;&#10;&#10;//IF [Parameters].[Time Granularity] = &apos;Month&apos; THEN [global_monthly_stacking_monetization_pct]&#10;CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Month&apos; THEN avg([global_monthly_stacking_monetization_pct])&#10;    WHEN &apos;Week&apos; THEN avg([global_weekly_stacking_monetization_pct])&#10;    WHEN &apos;Day&apos; THEN avg([global_daily_stacking_monetization_pct])&#10;END' />
            </column>
            <column datatype='integer' name='[activated_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[activated_excluding_3pl_count]' role='measure' type='quantitative' />
            <column caption='At Customer Time In Minutes Count' datatype='integer' name='[at_customer_time_in_minutes_count]' role='measure' type='quantitative' />
            <column caption='At Vendor Time In Minutes Count' datatype='integer' name='[at_vendor_time_in_minutes_count]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_5106026502179749892]' derivation='Attribute' name='[attr:Calculation_5106026502179749892:ok]' pivot='key' type='ordinal' />
