        <calculation class='tableau' formula='sum([total_logistics_failed_order_cost_eur])/&#10;sum([total_gfv_eur])' />
      </column>
      <column caption='% Stacking Monetization (global)' datatype='real' name='[Calculation_7898258268939075587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum([cpo_delta_total] * [Successful Order Count]) / sum([Successful Order Count])&#10;&#10;/*&#10;IF [Parameters].[Time Granularity] = &apos;Month&apos; THEN&#10;&#10;  SUM(&#10;    { FIXED [Report Month Local], [Country Name] : MAX(cpo_delta_total)} &#10;    * &#10;    { FIXED [Report Month Local], [Country Name] : MAX([Successful Order Count])}&#10;  ) &#10;&#10;  / &#10;&#10;  SUM({ FIXED [Report Month Local], [Country Name] : MAX([Successful Order Count])})&#10;&#10;END&#10;*/&#10;&#10;&#10;//IF [Parameters].[Time Granularity] = &apos;Month&apos; THEN [global_monthly_stacking_monetization_pct]&#10;CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Month&apos; THEN avg([global_monthly_stacking_monetization_pct])&#10;    WHEN &apos;Week&apos; THEN avg([global_weekly_stacking_monetization_pct])&#10;    WHEN &apos;Day&apos; THEN avg([global_daily_stacking_monetization_pct])&#10;END' />
      </column>
