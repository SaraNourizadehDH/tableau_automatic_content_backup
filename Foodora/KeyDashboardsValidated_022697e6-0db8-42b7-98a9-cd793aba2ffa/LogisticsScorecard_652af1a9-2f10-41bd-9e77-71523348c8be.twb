      <column caption='Pandora' datatype='string' name='[Calculation_5106026502175227905]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Pandora&apos;' />
      </column>
      <column caption='% On Time' datatype='real' default-format='p0.0%' name='[Calculation_5106026502175358978]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#10;      (&#10;          SUM(pdt_bucket_10_is_order_on_time_within_10_minutes_n)/&#10;          SUM(pdt_bucket_10_is_order_on_time_within_10_minutes_d)&#10;      ) * MAX(pdt_bucket_10_is_order_on_time_weight),&#10;      0&#10;    )&#10;    + &#10;    IFNULL(&#10;      (&#10;          SUM(pdt_bucket_20_is_order_on_time_within_10_minutes_n)/&#10;          SUM(pdt_bucket_20_is_order_on_time_within_10_minutes_d)&#10;      ) * MAX(pdt_bucket_20_is_order_on_time_weight),&#10;      0&#10;    )&#10;    +&#10;    IFNULL(&#10;      (&#10;          SUM(pdt_bucket_30_is_order_on_time_within_10_minutes_n)/&#10;          SUM(pdt_bucket_30_is_order_on_time_within_10_minutes_d)&#10;      ) * MAX(pdt_bucket_30_is_order_on_time_weight),&#10;      0&#10;    )&#10;    +&#10;    IFNULL(&#10;      (&#10;          SUM(pdt_bucket_40_is_order_on_time_within_10_minutes_n)/&#10;          SUM(pdt_bucket_40_is_order_on_time_within_10_minutes_d)&#10;      ) * MAX(pdt_bucket_40_is_order_on_time_weight),&#10;      0&#10;    )&#10;    +&#10;    IFNULL(&#10;      (&#10;          SUM(pdt_bucket_50_is_order_on_time_within_10_minutes_n)/&#10;          SUM(pdt_bucket_50_is_order_on_time_within_10_minutes_d)&#10;      ) * MAX(pdt_bucket_50_is_order_on_time_weight),&#10;      0&#10;    )&#10;    +&#10;    IFNULL(&#10;      (&#10;          SUM(pdt_bucket_60_is_order_on_time_within_10_minutes_n)/&#10;          SUM(pdt_bucket_60_is_order_on_time_within_10_minutes_d)&#10;      ) * MAX(pdt_bucket_60_is_order_on_time_weight),&#10;      0&#10;    )' />
      </column>
      <column caption='Time Granularity' datatype='date' name='[Calculation_5106026502179749892]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Day&apos; then [report_date_local]&#10;when &apos;Week&apos; then [report_week_local]&#10;when &apos;Month&apos; then [report_month_local]&#10;when &apos;Year&apos; then [Calculation_1038853809050353664]&#10;end' />
      </column>
      <column caption='# Actual Rider Hours' datatype='real' name='[Calculation_5106026502190526483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_evaluation_working_time_in_hours])' />
