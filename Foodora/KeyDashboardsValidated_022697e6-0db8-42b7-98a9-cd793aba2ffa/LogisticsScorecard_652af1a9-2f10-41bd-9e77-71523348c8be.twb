      <column caption='Avg. Rider Earning per Hour ' datatype='real' default-format='n#,##0.00&quot;€&quot;;-#,##0.00&quot;€&quot;' name='[Ø Rider Earning per Hour (copy)_5106026502200827932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IFNULL(SUM([total_delivery_rider_cost_not_proportioned_eur]),0)&#10;+IFNULL(SUM([total_recruitment_cost_not_proportioned_eur]),0)&#10;+IFNULL(SUM([total_tip_payment_eur]),0))&#10;/SUM([total_evaluation_working_time_in_hours])' />
