          <datasource-dependencies datasource='sqlproxy.0ditk5912i53ub1farvmd03dszkh'>
            <column caption='Base CPO (w/o Fleet CPO)' datatype='real' name='[Base CPO (copy)_2186990237366808576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#9;SUM([total_basic_payment])+&#10;    SUM([act_bonus_payment])+&#10;    SUM([rc_bonus_payment])+&#10;    SUM([not_on_system_other_bonus_payment])+&#10;    SUM([quest_bonus_payment])-&#10;    SUM([fleet_campaign_payment])+&#10;    SUM([deduct_act_cpo])+&#10;    SUM([deduct_basic_cpo])+&#10;    SUM([deduct_distance_cpo])+&#10;    SUM([deduct_quest_cpo])+&#10;    SUM([deduct_zone_bonus_cpo])&#10;    )/SUM([deliveries])' />
            </column>
            <column caption='Act Bonus CPO' datatype='real' name='[Calculation_3775494252277743616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([act_bonus_payment])+SUM([deduct_act_cpo]))/SUM([deliveries])' />
            </column>
            <column caption='Other CPO' datatype='real' name='[Calculation_3775494252278669313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([not_on_system_other_bonus_payment])/SUM([deliveries])' />
            </column>
            <column caption='RC Bonus CPO' datatype='real' name='[Calculation_3775494252278906882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rc_bonus_payment])/SUM([deliveries])' />
            </column>
            <column caption='Area Bonus CPO' datatype='real' name='[Calculation_4206291718971564032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([basic_payment])+&#10;SUM([zone_payment])+&#10;SUM([distance_payment])+&#10;SUM([deduct_basic_cpo])+&#10;SUM([deduct_zone_bonus_cpo])+&#10;SUM([deduct_distance_cpo])&#10;)&#10;/SUM([deliveries])' />
            </column>
            <column caption='datefilter(2) report_date' datatype='boolean' name='[Calculation_5103352495440302080]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_886364738032287758] &lt;= 12 + [Parameters].[Parameter 2] + [Parameters].[Parameter 4]&#10;AND &#10;[Calculation_886364738032287758] &gt;= [Parameters].[Parameter 2]' />
            </column>
            <column caption='Quest CPO' datatype='real' name='[Calculation_6545630249731608576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([quest_bonus_payment])+SUM([deduct_quest_cpo]))/SUM([deliveries])' />
            </column>
            <column caption='is_in_peak_time' datatype='boolean' name='[Calculation_886364738026364929]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [report_hour]&#10;WHEN 11 THEN TRUE&#10;WHEN 12 THEN TRUE&#10;WHEN 18 THEN TRUE&#10;WHEN 19 THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Basic CPO' datatype='real' name='[Calculation_886364738027835394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([basic_payment])+SUM([deduct_basic_cpo]))/sum([deliveries])' />
            </column>
            <column caption='Base CPO' datatype='real' name='[Calculation_886364738027970563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#9;SUM([total_basic_payment])+&#10;    SUM([act_bonus_payment])+&#10;    SUM([rc_bonus_payment])+&#10;    SUM([not_on_system_other_bonus_payment])+&#10;    SUM([quest_bonus_payment])+&#10;    SUM([fleet_quest_payment])+&#10;    SUM([deduct_act_cpo])+&#10;    SUM([deduct_basic_cpo])+&#10;    SUM([deduct_distance_cpo])+&#10;    SUM([deduct_quest_cpo])+&#10;    SUM([deduct_zone_bonus_cpo])&#10;&#9;)/SUM([deliveries])' />
            </column>
            <column caption='Distance CPO' datatype='real' name='[Calculation_886364738028437509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([distance_payment])+SUM([deduct_distance_cpo]))/SUM([deliveries])' />
            </column>
            <column caption='Zone Bonus CPO' datatype='real' name='[Calculation_886364738028523526]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([zone_payment])+SUM([deduct_zone_bonus_cpo]))/SUM([deliveries])' />
            </column>
            <column caption='Fallback CPO' datatype='real' name='[Calculation_886364738028732423]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fallback_payment])/sum([deliveries])' />
            </column>
            <column caption='Fleet Bonus CPO' datatype='real' name='[Calculation_886364738028806152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([fleet_campaign_payment])+ sum([fleet_quest_payment]))/sum([deliveries])' />
            </column>
            <column caption='filter_report_date' datatype='boolean' name='[Calculation_886364738029547529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] &lt; TODAY()' />
            </column>
            <column caption='datetrunc report_date' datatype='date' name='[Calculation_886364738030346250]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;)&#10;THEN DATE(DATETRUNC(&apos;month&apos;, [report_date]))&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#10;THEN DATE(DATETRUNC(&apos;iso-week&apos;, [report_date]))&#10;ELSE DATE(DATETRUNC(&apos;day&apos;, [report_date]))&#10;END' />
            </column>
            <column caption='updated_date' datatype='date' name='[Calculation_886364738032025612]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([report_date])}' />
            </column>
            <column aggregation='Sum' caption='datediff report_date' datatype='integer' name='[Calculation_886364738032287758]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) &#10;then DATEDIFF(&apos;month&apos;,[report_date], [Calculation_886364738032025612])&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#10;then DATEDIFF(&apos;week&apos;,[report_date], [Calculation_886364738032025612])&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; &#10;then DATEDIFF(&apos;day&apos;,[report_date], [Calculation_886364738032025612])&#10;end' />
            </column>
            <column aggregation='Sum' caption='mtd report_date' datatype='integer' name='[Calculation_886364738036924431]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [report_date])' />
            </column>
            <column aggregation='Sum' caption='wtd updated_date' datatype='integer' name='[Calculation_886364738037231633]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[Calculation_886364738032025612]) = 1 THEN 7&#10;ELSE DATEPART(&apos;weekday&apos;,[Calculation_886364738032025612]) -1&#10;END' />
            </column>
            <column caption='datename report_date' datatype='string' name='[Calculation_886364738037665811]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) &#10;THEN LEFT(DATENAME(&apos;month&apos;, [report_date]),3)&#10;ELSEIF  REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;) &#10;THEN &apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [report_date])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;day&apos; &#10;THEN STR([Calculation_886364738030346250])&#10;END' />
            </column>
            <column caption='datename(2) report_date' datatype='string' name='[Calculation_886364738037989396]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;day&apos;&#10;THEN LEFT(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#10;ELSE STR(YEAR([Calculation_886364738030346250]))&#10;END' />
            </column>
            <column caption='datefilter report_date' datatype='boolean' name='[Calculation_886364738038325269]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(week)|(day)&apos;)&#10;THEN [Calculation_886364738032287758] &lt;= 12+[Parameters].[Parameter 2] and [Calculation_886364738032287758] &gt;= [Parameters].[Parameter 2]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;mtd&apos;&#10;THEN [Calculation_886364738036924431] &lt;= [wtd updated_date (copy)_886364738037415954] and [Calculation_886364738032287758] &lt;= 12+[Parameters].[Parameter 2] and [Calculation_886364738032287758] &gt;= [Parameters].[Parameter 2]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;wtd&apos;&#10;THEN [mtd report_date (copy)_886364738037035024] &lt;= [Calculation_886364738037231633] and [Calculation_886364738032287758] &lt;= 12+[Parameters].[Parameter 2] and [Calculation_886364738032287758] &gt;= [Parameters].[Parameter 2]&#10;END' />
            </column>
            <column caption='main_kpi' datatype='real' name='[Calculation_886364738042871830]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(&#10;case [Parameters].[Parameter 3]&#10;when &apos;Base CPO&apos; then [Calculation_886364738027970563]&#10;when &apos;Base CPO (w/o Fleet CPO)&apos; then [Base CPO (copy)_2186990237366808576]&#10;when &apos;Basic CPO&apos; then [Calculation_886364738027835394]&#10;when &apos;Distance CPO&apos; then [Calculation_886364738028437509]&#10;when &apos;Area Bonus CPO&apos; then [Calculation_4206291718971564032]&#10;when &apos;Fallback CPO&apos; then [Calculation_886364738028732423]&#10;when &apos;Fleet Bonus CPO&apos; then [Calculation_886364738028806152]&#10;when &apos;Zone Bonus CPO&apos; then [Calculation_886364738028523526]&#10;when &apos;Act Bonus CPO&apos; then [Calculation_3775494252277743616]&#10;when &apos;RC Bonus CPO&apos; then [Calculation_3775494252278906882]&#10;when &apos;Other CPO&apos; then [Calculation_3775494252278669313]&#10;when &apos;Quest CPO&apos; then [Calculation_6545630249731608576]&#10;when &apos;Orders&apos; then SUM([deliveries])&#10;when &apos;Basic Payments&apos; then SUM([total_basic_payment])&#10;end&#10;)' />
