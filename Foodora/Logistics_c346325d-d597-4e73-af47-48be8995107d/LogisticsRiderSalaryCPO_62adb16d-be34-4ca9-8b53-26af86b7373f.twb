    <dashboard name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/LogisticsRiderSalaryCPO/Definitions?rev=' id='240881' path='/t/Foodora/workbooks/LogisticsRiderSalaryCPO' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_5' value='top' />
        </style-rule>
      </style>
      <size maxheight='1000' maxwidth='1400' minheight='1000' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='5800' id='3' type-v2='text' w='98858' x='571' y='800'>
            <formatted-text>
              <run bold='true' fontcolor='#333333' fontname='Tableau Light' fontsize='20'>Definitions</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='92600' id='5' type-v2='text' w='98858' x='571' y='6600'>
            <formatted-text>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>Figures included,</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>1. ONLY </run>
              <run bold='true' fontcolor='#e15759' fontname='Tableau Light'>&apos;Valid&apos;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'> orders and report dates based on </run>
              <run bold='true' fontcolor='#e15759' fontname='Tableau Light'>[rider_accepted_at_local]</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>2. ONLY </run>
              <run bold='true' fontcolor='#e15759' fontname='Tableau Light'>Rooster payment </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>data, NOT including manual calculation (TW Rooster payment rollout on </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light' underline='true'>2021-04-16</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>)</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontsize='12'>[CPO Elements] All divided by valid orders</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Base CPO] </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>All Rooster basic payment, including fleet campaign, zone bonus, distance payment, not-on-system payment (act, rc, other bonus) , 3-day quest bonus and </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Rooster quest payment with rule name</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Æ </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>starts with &quot;Q&quot;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Base CPO (w/o Fleet CPO)] </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Base CPO - Fleet CPO, used to identify the orignial pay scheme cost</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Basic CPO] </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Rooster basic payment, including 取餐費、小隊長</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Zone Bonus CPO] </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Rooster basic payment with </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>&quot;區域&quot;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'> payment rule name</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Fleet Bonus CPO] </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Rooster basic payment with payment rule name </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>starts with [&quot;F&quot;,  &quot;L&quot;]  or includes &quot;加碼&quot; or </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Æ </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>Rooster quest payment with rule name</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Æ </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>starts with &quot;Q&quot;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>, e.g.F0418_全時段_0421_0427 and L0424_限時加碼_0427</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Distance CPO] </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Rooster basic payment with </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>&quot;Distance&quot;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'> payment rule name, e.g. Distance_PU</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Fallback CPO] </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Rooster basic payment with </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>NULL </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>payment rule name which indicate the rooster payment fallback </run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Quest CPO] </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Rooster quest payment with rule name </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>includes &quot;達標&quot; and doesn&apos;t starts with &quot;Q&quot; and doesn&apos;t includes &quot;C&quot;.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>This represents the regular basis 3-day quest payment on </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>Mon to Wed</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'> and </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>Thu to Sat</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'> and 1-day quest payment on </run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>Sunday</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Area Bonus CPO] </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Basic CPO + Zone Bonus CPO + Distance CPO</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Act Bonus CPO] </run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Light'>Payment not on Rooster and categorized as Act Bonus, e.g.</run>
              <run fontcolor='#666666' fontname='Tableau Light' fontsize='9'>20231201_1210_U1204_offline 14-27_1204_1210</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[RC Bonus CPO] </run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Light'>Payment not on Rooster and categorized as RC Bonus, e.g.</run>
              <run fontname='Tableau Light' fontsize='9'>20231127_1130_(R)LtH獎金活動(fp231004)-VF</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Other CPO] </run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Light'>Payment not on Rooster and categorized as Other Bonus, e.g.</run>
              <run fontname='Tableau Light' fontsize='9'>20231211_1210_點數獎金</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Is In Peak Time] </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>If report_hour is in [11,12,18,19] </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
