    <worksheet name='cities_trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10'><![CDATA[<[sqlproxy.0ditk5912i53ub1farvmd03dszkh].[none:Calculation_998813991266557954:nk]> - ]]></run>
            <run fontsize='10'><![CDATA[<[Parameters].[Parameter 3]> <[Parameters].[Parameter 1]> Trend]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='hourly_rider_cpo' name='sqlproxy.0ditk5912i53ub1farvmd03dszkh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Date Part' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;mtd&quot;' value='Mtd' />
                <alias key='&quot;week&quot;' value='Weekly' />
                <alias key='&quot;wtd&quot;' value='Wtd' />
              </aliases>
            </column>
            <column caption='Left Shifting N Step' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <range granularity='1' max='100' min='0' />
            </column>
            <column caption='Main KPIs' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Base CPO&quot;'>
              <calculation class='tableau' formula='&quot;Base CPO&quot;' />
              <aliases>
                <alias key='&quot;Fleet Bonus CPO&quot;' value='Fleet Bonus CPO' />
                <alias key='&quot;Zone Bonus CPO&quot;' value='Zone Bonus CPO' />
              </aliases>
            </column>
            <column caption='Stacked Line' datatype='boolean' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0ditk5912i53ub1farvmd03dszkh'>
            <column caption='Base CPO (w/o Fleet CPO)' datatype='real' name='[Base CPO (copy)_2186990237366808576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#9;SUM([total_basic_payment])+&#10;    SUM([act_bonus_payment])+&#10;    SUM([rc_bonus_payment])+&#10;    SUM([not_on_system_other_bonus_payment])+&#10;    SUM([quest_bonus_payment])-&#10;    SUM([fleet_campaign_payment])+&#10;    SUM([deduct_act_cpo])+&#10;    SUM([deduct_basic_cpo])+&#10;    SUM([deduct_distance_cpo])+&#10;    SUM([deduct_quest_cpo])+&#10;    SUM([deduct_zone_bonus_cpo])&#10;    )/SUM([deliveries])' />
            </column>
            <column caption='Act Bonus CPO' datatype='real' name='[Calculation_3775494252277743616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([act_bonus_payment])+SUM([deduct_act_cpo]))/SUM([deliveries])' />
            </column>
            <column caption='Other CPO' datatype='real' name='[Calculation_3775494252278669313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([not_on_system_other_bonus_payment])/SUM([deliveries])' />
            </column>
            <column caption='RC Bonus CPO' datatype='real' name='[Calculation_3775494252278906882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rc_bonus_payment])/SUM([deliveries])' />
            </column>
            <column caption='Area Bonus CPO' datatype='real' name='[Calculation_4206291718971564032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([basic_payment])+&#10;SUM([zone_payment])+&#10;SUM([distance_payment])+&#10;SUM([deduct_basic_cpo])+&#10;SUM([deduct_zone_bonus_cpo])+&#10;SUM([deduct_distance_cpo])&#10;)&#10;/SUM([deliveries])' />
            </column>
            <column caption='Quest CPO' datatype='real' name='[Calculation_6545630249731608576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([quest_bonus_payment])+SUM([deduct_quest_cpo]))/SUM([deliveries])' />
            </column>
            <column caption='is_in_peak_time' datatype='boolean' name='[Calculation_886364738026364929]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [report_hour]&#10;WHEN 11 THEN TRUE&#10;WHEN 12 THEN TRUE&#10;WHEN 18 THEN TRUE&#10;WHEN 19 THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Basic CPO' datatype='real' name='[Calculation_886364738027835394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([basic_payment])+SUM([deduct_basic_cpo]))/sum([deliveries])' />
            </column>
            <column caption='Base CPO' datatype='real' name='[Calculation_886364738027970563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#9;SUM([total_basic_payment])+&#10;    SUM([act_bonus_payment])+&#10;    SUM([rc_bonus_payment])+&#10;    SUM([not_on_system_other_bonus_payment])+&#10;    SUM([quest_bonus_payment])+&#10;    SUM([fleet_quest_payment])+&#10;    SUM([deduct_act_cpo])+&#10;    SUM([deduct_basic_cpo])+&#10;    SUM([deduct_distance_cpo])+&#10;    SUM([deduct_quest_cpo])+&#10;    SUM([deduct_zone_bonus_cpo])&#10;&#9;)/SUM([deliveries])' />
            </column>
            <column caption='Distance CPO' datatype='real' name='[Calculation_886364738028437509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([distance_payment])+SUM([deduct_distance_cpo]))/SUM([deliveries])' />
            </column>
            <column caption='Zone Bonus CPO' datatype='real' name='[Calculation_886364738028523526]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([zone_payment])+SUM([deduct_zone_bonus_cpo]))/SUM([deliveries])' />
