              <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[Calculation_886364738032025612]) = 1 THEN 7&#10;ELSE DATEPART(&apos;weekday&apos;,[Calculation_886364738032025612]) -1&#10;END' />
            </column>
            <column caption='datename report_date' datatype='string' name='[Calculation_886364738037665811]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) &#10;THEN LEFT(DATENAME(&apos;month&apos;, [report_date]),3)&#10;ELSEIF  REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;) &#10;THEN &apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [report_date])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;day&apos; &#10;THEN STR([Calculation_886364738030346250])&#10;END' />
