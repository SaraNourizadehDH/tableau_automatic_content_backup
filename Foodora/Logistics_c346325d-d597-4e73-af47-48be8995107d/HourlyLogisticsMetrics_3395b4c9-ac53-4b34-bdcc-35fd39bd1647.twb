        <_.fcp.ObjectModelEncapsulateLegacy.false...relation name='sqlproxy' table='[sqlproxy]' type='table' />
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation name='sqlproxy' table='[sqlproxy]' type='table' />
        <calculations>
          <calculation column='[Calculation_2411255423127760896]' formula='str(DATEPART(&apos;hour&apos;, [start_at_local]))+&apos;:&apos;+&#10;str(DATEPART(&apos;minute&apos;, [start_at_local]))+&apos;:&apos;+&#10;str(DATEPART(&apos;second&apos;, [start_at_local]))+&apos; ~ &apos;+&#10;str(DATEPART(&apos;hour&apos;, [end_at_local]))+&apos;:&apos;+&#10;str(DATEPART(&apos;minute&apos;, [end_at_local]))+&apos;:&apos;+&#10;str(DATEPART(&apos;second&apos;, [end_at_local]))' />
          <calculation column='[Calculation_2411255423127965697]' formula='MAKETIME(&#10;DATEPART(&apos;hour&apos;, [start_at_local]),&#10;DATEPART(&apos;minute&apos;, [start_at_local]),&#10;DATEPART(&apos;second&apos;, [start_at_local])&#10;)' />
          <calculation column='[Calculation_2411255423128301570]' formula='IF  [Parameters].[Parameter 4] THEN &quot;Total&quot;&#10;ELSE [city_name]&#10;END' />
          <calculation column='[Calculation_5493687875095764995]' formula='{ INCLUDE [city_name],[zone_name],[report_date],[hour]:&#10;MAX([operating_mins])&#10;}' />
          <calculation column='[Calculation_5493687875095891972]' formula='if [event_action] = &apos;shrink&apos; then [event_duration]&#10;END' />
          <calculation column='[Calculation_5493687875096592390]' formula='SUM(&#10;if [event_action] = &apos;close&apos; then [event_duration] end &#10;)/SUM([Calculation_5493687875095764995])' />
          <calculation column='[Calculation_5493687875099791371]' formula='SUM(if [event_action_adj] = &apos;shrink - 1st&apos; then [event_duration] &#10;end)&#10;/SUM([Calculation_5493687875095764995])' />
          <calculation column='[Calculation_5493687875100282892]' formula='SUM([Calculation_5493687875095891972])/SUM([Calculation_5493687875095764995])' />
          <calculation column='[Calculation_5493687875100741645]' formula='DATEPART(&apos;day&apos;, [report_date (copy)])' />
          <calculation column='[Calculation_5493687875101691919]' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) &#10;then DATEDIFF(&apos;month&apos;,[report_date], [updated from (copy)_1536290430262157312])&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#10;then DATEDIFF(&apos;iso-week&apos;,[report_date], [updated from (copy)_1536290430262157312])&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; &#10;then DATEDIFF(&apos;day&apos;,[report_date], [updated from (copy)_1536290430262157312])&#10;end' />
          <calculation column='[Number of Records]' formula='1' />
          <calculation column='[close_affected_orders_rate (copy)_572238636449222661]' formula='SUM(&#10;if [event_action] = &apos;close&apos; then ([event_duration]/[operating_mins]*[orders_expected]) &#13;&#10;end)' />
          <calculation column='[close_rate (copy)_572238636434128898]' formula='SUM(&#10;if [event_action] = &apos;close&apos; then ([event_duration]/[operating_mins]*[orders_expected]) &#13;&#10;end)&#13;&#10;/SUM([operating_mins_adj (copy)_1707145742522433536])' />
          <calculation column='[datediff report_date (copy 2)]' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) then &#10;left(DATENAME(&apos;month&apos;, [report_date]),3)&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;) then &#10;&apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [report_date])&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; then&#10;str([datediff report_date (copy 3)])&#10;end' />
          <calculation column='[datediff report_date (copy 3)]' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;)&#10;then date(DATETRUNC(&apos;month&apos;, [report_date]))&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#10;then date(DATETRUNC(&apos;iso-week&apos;, [report_date]))&#10;else date(DATETRUNC(&apos;day&apos;, [report_date]))&#10;end' />
          <calculation column='[datediff report_date (copy)]' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(week)|(day)&apos;)&#10;then [Calculation_5493687875101691919] &lt;= 12+ [Parameters].[Parameter 2] and [Calculation_5493687875101691919] &gt;= [Parameters].[Parameter 2]&#10;elseif [Parameters].[Parameter 1] = &apos;mtd&apos;&#10;then [mtd updated_date (copy)] &lt;= [Calculation_5493687875100741645] and [Calculation_5493687875101691919] &lt;= 12+[Parameters].[Parameter 2] and [Calculation_5493687875101691919] &gt;= [Parameters].[Parameter 2]&#10;elseif [Parameters].[Parameter 1] = &apos;wtd&apos;&#10;then [mtd report_date (copy)] &lt;= [wtd report_date (copy)] and [Calculation_5493687875101691919] &lt;= 12+[Parameters].[Parameter 2] and [Calculation_5493687875101691919] &gt;= [Parameters].[Parameter 2]&#10;end' />
          <calculation column='[datename report_date (copy)]' formula='if [Parameters].[Parameter 1] = &apos;day&apos;&#10;then left(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#10;else str(year([datediff report_date (copy 3)]))&#10;end' />
          <calculation column='[mtd report_date (copy)]' formula='if DATEPART(&apos;weekday&apos;,[report_date]) = 1 then 7&#10;else DATEPART(&apos;weekday&apos;,[report_date]) - 1&#10;end' />
          <calculation column='[mtd updated_date (copy)]' formula='DATEPART(&apos;day&apos;, [report_date])' />
          <calculation column='[operating_mins_adj (copy)_1707145742522433536]' formula='{ INCLUDE [city_name],[zone_name],[report_date],[hour]:&#10;MAX([orders_expected])&#10;}' />
