            <column _.fcp.ParameterDefaultValues.true...default-value-field='[sqlproxy.0760ry21aq0mbu1avpkxn01dj895].[Calculation_1015350666411008011]' caption='End Date' datatype='date' default-format='*yyyy-mm-dd' name='[Start Date (copy)_1015350666402955271]' param-domain-type='any' role='measure' type='quantitative' value='#2025-05-26#'>
              <calculation class='tableau' formula='#2025-05-26#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0760ry21aq0mbu1avpkxn01dj895'>
            <column caption='is_in_range' datatype='boolean' name='[Calculation_1015350666405085193]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5] &lt;= [report_date] AND [Parameters].[Start Date (copy)_1015350666402955271] &gt;= [report_date]' />
            </column>
            <column caption='yesterday' datatype='datetime' name='[Calculation_1015350666411008011]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -1, today())' />
            </column>
            <column caption='filter_report_date' datatype='boolean' name='[Calculation_1201053742624849920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] &lt; TODAY()' />
            </column>
            <column aggregation='User' caption='actual_working_rh' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1418070949242556416]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([actual_rh])-SUM(IFNULL([break_rh],0))' />
            </column>
            <column caption='Open Rh Fill Rate' datatype='real' name='[Calculation_1646910100402794496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([planned_rh])/(SUM(IFNULL([unassigned_hours],0)) + SUM(IFNULL([planned_rh],0)))' />
            </column>
            <column aggregation='User' caption='stacked_deliveries_rate' datatype='real' default-type='quantitative' layered='true' name='[Calculation_3886113912864362514]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM([stacked_deliveries])/SUM([deliveries])' />
            </column>
            <column caption='courier_delay_adj' datatype='real' name='[Calculation_4149433804818989056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([estimated_courier_delay])/sum([deliveries])' />
            </column>
            <column caption='color main_kpi' datatype='integer' name='[Calculation_4149433804821086210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE(if [right_main_kpi (copy)_4855443388652044317] &lt;&gt; 0 then [right_main_kpi (copy)_4855443388652044317] end, &apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='display main_kpi' datatype='string' name='[Calculation_4149433804822814723]' role='measure' type='nominal'>
              <calculation class='tableau' formula='str(&#10;if REGEXP_MATCH([Parameters].[Right Main KPIs (copy)_4855443388409671685], &apos;Rate&apos;) then round([right_main_kpi (copy)_4855443388652044317]*100,1)&#10;ELSEIF REGEXP_MATCH([Parameters].[Right Main KPIs (copy)_4855443388409671685], &apos;Avg\.CPO|Utr|Avg\.Dt|Logistic Index|Avg\. Stacked&apos;) then round([right_main_kpi (copy)_4855443388652044317],1)&#10;ELSEIF REGEXP_MATCH([Parameters].[Right Main KPIs (copy)_4855443388409671685], &apos;Distance&apos;) then round([right_main_kpi (copy)_4855443388652044317],2)&#10;ELSEIF REGEXP_MATCH([Parameters].[Right Main KPIs (copy)_4855443388409671685], &apos;Unassigned&apos;) then round([right_main_kpi (copy)_4855443388652044317],0)&#10;ELSEIF REGEXP_MATCH([Parameters].[Right Main KPIs (copy)_4855443388409671685], &apos;Riders&apos;) then round([right_main_kpi (copy)_4855443388652044317],0)&#10;ELSEIF REGEXP_MATCH([Parameters].[Right Main KPIs (copy)_4855443388409671685], &apos;Orders&apos;) then round([right_main_kpi (copy)_4855443388652044317]/1000,1)&#10;else round([right_main_kpi (copy)_4855443388652044317],1)&#10;end&#10;)' />
            </column>
            <column caption='display unit' datatype='string' name='[Calculation_4149433804823367684]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Right Main KPIs (copy)_4855443388409671685], &apos;Rate&apos;) then &apos;%&apos;&#10;ELSEIF REGEXP_MATCH([Parameters].[Right Main KPIs (copy)_4855443388409671685], &apos;Avg\.CPO|Utr|Avg\.Dt|Logistic Index|Avg\. Stacked&apos;) then &apos;&apos;&#10;ELSEIF REGEXP_MATCH([Parameters].[Right Main KPIs (copy)_4855443388409671685], &apos;Distance&apos;) then &apos;&apos;&#10;ELSEIF REGEXP_MATCH([Parameters].[Right Main KPIs (copy)_4855443388409671685], &apos;Unassigned&apos;) then &apos;&apos;&#10;ELSEIF REGEXP_MATCH([Parameters].[Right Main KPIs (copy)_4855443388409671685], &apos;Riders&apos;) then &apos;&apos;&#10;ELSEIF REGEXP_MATCH([Parameters].[Right Main KPIs (copy)_4855443388409671685], &apos;Orders&apos;) then &apos;k&apos;&#10;else &apos;&apos;&#10;end' />
            </column>
            <column caption='utr' datatype='real' name='[Calculation_4855443387963817985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([actual_rh])' />
            </column>
            <column caption='dt_adjusted' datatype='real' name='[Calculation_4855443387964243970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_dt])/SUM([deliveries]-[preorders])' />
            </column>
            <column caption='time_zone' datatype='string' name='[Calculation_4855443388407123971]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pick_hour] &lt;= 10 THEN &apos;Morning&apos;&#10;ELSEIF [pick_hour] &lt;= 16 THEN &apos;Afternoon&apos;&#10;ELSE &apos;Evening&apos;&#10;END' />
            </column>
            <column caption='dispatching_time_adj' datatype='real' name='[Calculation_4855443388642938893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dispatching_time])/SUM([deliveries])' />
            </column>
            <column caption='apac_on_time_rate' datatype='real' name='[Calculation_7958071688459309056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    IF SUM([on_time_order_base_bucket_10]) = 0 THEN 0 &#10;    ELSE SUM([order_on_time_within_10_minutes_bucket_10]) / SUM([on_time_order_base_bucket_10]) &#10;    END * 0.07&#10;)&#10;+&#10;(&#10;    IF SUM([on_time_order_base_bucket_20]) = 0 THEN 0 &#10;    ELSE SUM([order_on_time_within_10_minutes_bucket_20]) / SUM([on_time_order_base_bucket_20]) &#10;    END * 0.35&#10;)&#10;+&#10;(&#10;    IF SUM([on_time_order_base_bucket_30]) = 0 THEN 0 &#10;    ELSE SUM([order_on_time_within_10_minutes_bucket_30]) / SUM([on_time_order_base_bucket_30]) &#10;    END * 0.35&#10;)&#10;+&#10;(&#10;    IF SUM([on_time_order_base_bucket_40]) = 0 THEN 0 &#10;    ELSE SUM([order_on_time_within_10_minutes_bucket_40]) / SUM([on_time_order_base_bucket_40]) &#10;    END * 0.16&#10;)&#10;+&#10;(&#10;    IF SUM([on_time_order_base_bucket_50]) = 0 THEN 0 &#10;    ELSE SUM([order_on_time_within_10_minutes_bucket_50]) / SUM([on_time_order_base_bucket_50]) &#10;    END * 0.05&#10;)&#10;+&#10;(&#10;    IF SUM([on_time_order_base_bucket_60]) = 0 THEN 0 &#10;    ELSE SUM([order_on_time_within_10_minutes_bucket_60]) / SUM([on_time_order_base_bucket_60]) &#10;    END * 0.02&#10;)&#10;&#10;&#10;/*&#10;((SUM([order_on_time_within_10_minutes_bucket_10]) / SUM([on_time_order_base_bucket_10])) * 0.07) +&#10;((SUM([order_on_time_within_10_minutes_bucket_20]) / SUM([on_time_order_base_bucket_20])) * 0.35) +&#10;((SUM([order_on_time_within_10_minutes_bucket_30]) / SUM([on_time_order_base_bucket_30])) * 0.35) +&#10;((SUM([order_on_time_within_10_minutes_bucket_40]) / SUM([on_time_order_base_bucket_40])) * 0.16) +&#10;((SUM([order_on_time_within_10_minutes_bucket_50]) / SUM([on_time_order_base_bucket_50])) * 0.05) +&#10;((SUM([order_on_time_within_10_minutes_bucket_60]) / SUM([on_time_order_base_bucket_60])) * 0.02)&#10;*/&#10;&#10;/* (SUM([apac_lg_orders])-SUM([apac_early_orders])-SUM([apac_late_orders]))/SUM([apac_lg_orders]) */' />
            </column>
