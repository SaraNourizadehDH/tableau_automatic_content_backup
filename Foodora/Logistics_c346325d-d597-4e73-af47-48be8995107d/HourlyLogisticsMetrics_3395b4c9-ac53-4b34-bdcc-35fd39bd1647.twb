      </column>
      <column caption='is_weekday' datatype='string' name='[Calculation_4855443387962351616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4845310288791244801] = &apos;Sunday&apos; OR [Calculation_4845310288791244801] = &apos;Saturday&apos;&#10;THEN &apos;Weekend&apos;&#10;ELSE &apos;Weekday&apos;&#10;END' />
      </column>
