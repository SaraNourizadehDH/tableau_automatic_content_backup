    <dashboard name='Zone Hourly Logistics Metrics'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/HourlyLogisticsMetrics/ZoneHourlyLogisticsMetrics?rev=' id='240897' path='/t/Foodora/workbooks/HourlyLogisticsMetrics' revision='' site='Foodora' />
      <style>
        <style-rule element='parameter-ctrl-title'>
          <format attr='font-weight' value='bold' />
        </style-rule>
      </style>
      <size maxheight='3800' maxwidth='1200' minheight='3800' minwidth='1200' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='hourly_deliveries' name='sqlproxy.0760ry21aq0mbu1avpkxn01dj895' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Main KPIs Zone' datatype='string' name='[Main KPIs City (copy)_4855443388409921542]' param-domain-type='list' role='measure' type='nominal' value='&quot;Shrink_2+3_zone&quot;'>
          <calculation class='tableau' formula='&quot;Shrink_2+3_zone&quot;' />
          <members>
            <member value='&quot;Shrink_2+3_zone&quot;' />
            <member value='&quot;Shrink_3rd_zone&quot;' />
            <member value='&quot;Shrink_all_zone&quot;' />
            <member value='&quot;Closure_zone&quot;' />
          </members>
        </column>
        <column _.fcp.ParameterDefaultValues.true...default-value-field='[sqlproxy.0760ry21aq0mbu1avpkxn01dj895].[Calculation_1015350666411008011]' caption='Start Date' datatype='date' default-format='*yyyy-mm-dd' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='#2025-05-26#'>
          <calculation class='tableau' formula='#2025-05-26#' />
        </column>
        <column caption='Main KPIs' datatype='string' name='[Right Main KPIs (copy)_4855443388409671685]' param-domain-type='list' role='measure' type='nominal' value='&quot;Utr&quot;'>
          <calculation class='tableau' formula='&quot;Utr&quot;' />
          <members>
            <member value='&quot;Avg.Dt&quot;' />
