            <column caption='toggled main_kpi' datatype='real' name='[Calculation_4149433804829581319]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 4] then &#10;sum({EXCLUDE [city_name]: [right_main_kpi (copy)_4855443388652044317]})&#10;else [right_main_kpi (copy)_4855443388652044317] end' />
