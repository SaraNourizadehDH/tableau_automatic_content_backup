  <column aggregation='Year' caption='updated_date' datatype='date' default-type='ordinal' name='[Calculation_3886113912828583936]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
    <calculation class='tableau' formula='{MAX([report_date])}' />
  </column>
  <column aggregation='Count' caption='wtd report_date' datatype='integer' default-type='ordinal' name='[Calculation_3886113912828940289]' pivot='key' role='dimension' type='ordinal' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[report_date]) = 1 then 7&\#10;else DATEPART(&apos;weekday&apos;,[report_date]) -1&\#10;END' />
  </column>
  <column aggregation='Count' caption='mtd report_date' datatype='integer' default-type='ordinal' name='[Calculation_3886113912830406658]' pivot='key' role='dimension' type='ordinal' user-datatype='integer' visual-totals='Default'>
