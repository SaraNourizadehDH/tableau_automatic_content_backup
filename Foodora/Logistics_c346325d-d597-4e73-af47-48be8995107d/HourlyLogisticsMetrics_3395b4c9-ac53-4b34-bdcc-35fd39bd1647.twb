      <column caption='Avg. NearPickUp to PickUp' datatype='real' name='[Avg. Accept to NearPickUp (copy)_6222215489743462400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([near_pick_to_pick])/SUM([orders]-[preorders])' />
      </column>
      <column caption='is_in_range' datatype='boolean' name='[Calculation_1015350666405085193]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5] &lt;= [report_date] AND [Parameters].[Start Date (copy)_1015350666402955271] &gt;= [report_date]' />
      </column>
      <column caption='yesterday' datatype='datetime' name='[Calculation_1015350666411008011]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -1, today())' />
      </column>
      <column caption='dispatch_rate' datatype='real' name='[Calculation_1052716424658608130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([dispatch_to_notify])/sum([actual_dt])' />
      </column>
      <column caption='vendor_delay_5_orders_rate' datatype='real' name='[Calculation_1195142760316096512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_delay_5_orders])/sum([orders])' />
      </column>
      <column caption='filter_report_date' datatype='boolean' name='[Calculation_1201053742624849920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] &lt; TODAY()' />
      </column>
      <column aggregation='Count' caption='is_in_peak_time' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_128071130968264704]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
        <calculation class='tableau' formula='CASE [pick_hour]&#13;&#10;WHEN 11 THEN TRUE&#13;&#10;WHEN 12 THEN TRUE&#13;&#10;WHEN 18 THEN TRUE&#13;&#10;WHEN 19 THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
      </column>
      <column aggregation='User' caption='actual_working_rh' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1418070949242556416]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='SUM([actual_rh])-SUM(IFNULL([break_rh],0))' />
      </column>
      <column caption='Avg. Accept to NearPickUp' datatype='real' name='[Calculation_1529253559129165824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([accept_to_near_pick])/SUM([orders]-[preorders])' />
      </column>
      <column caption='Avg. Create To Dispatch' datatype='real' name='[Calculation_1529253559129300993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([create_to_dispatch])/sum([orders]-[preorders])' />
      </column>
      <column caption='Avg. Dispatch To Notify' datatype='real' name='[Calculation_1529253559129378818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([dispatch_to_notify])/sum([orders]-[preorders])' />
      </column>
      <column caption='Avg. Notify to Accept' datatype='real' name='[Calculation_1529253559129530371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([notify_to_accept])/sum([orders]-[preorders])' />
      </column>
      <column caption='Avg. PickUp To Near Customer' datatype='real' name='[Calculation_1529253559129665540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pick_to_customer])/sum([orders]-[preorders])' />
      </column>
      <column caption='Open Rh Fill Rate' datatype='real' name='[Calculation_1646910100402794496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([planned_rh])/(SUM(IFNULL([unassigned_hours],0)) + SUM(IFNULL([planned_rh],0)))' />
