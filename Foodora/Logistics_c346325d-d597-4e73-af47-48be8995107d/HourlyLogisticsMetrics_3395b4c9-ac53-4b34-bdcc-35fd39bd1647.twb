      <column aggregation='Year' caption='updated_date' datatype='date' default-type='ordinal' layered='true' name='[Calculation_3886113912828583936]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
        <calculation class='tableau' formula='{MAX([report_date])}' />
      </column>
      <column aggregation='Count' caption='wtd report_date' datatype='integer' default-type='ordinal' layered='true' name='[Calculation_3886113912828940289]' pivot='key' role='dimension' type='ordinal' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[report_date]) = 1 then 7&#10;else DATEPART(&apos;weekday&apos;,[report_date]) -1&#10;END' />
      </column>
      <column aggregation='Count' caption='mtd report_date' datatype='integer' default-type='ordinal' layered='true' name='[Calculation_3886113912830406658]' pivot='key' role='dimension' type='ordinal' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [report_date])' />
      </column>
      <column aggregation='Year' caption='datetrunc report_date' datatype='date' default-type='ordinal' layered='true' name='[Calculation_3886113912831004675]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
        <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;)&#10;then date(datetrunc(&apos;month&apos;,[report_date]))&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1],&apos;(week)|(wtd)&apos;)&#10;then date(DATETRUNC(&apos;iso-week&apos;,[report_date]))&#10;else date(DATETRUNC(&apos;day&apos;,[report_date]))&#10;end' />
      </column>
      <column aggregation='Count' caption='datename report_date' datatype='string' default-type='nominal' layered='true' name='[Calculation_3886113912834519044]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) then &#10;left(DATENAME(&apos;month&apos;, [report_date]),3)&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;) then &#10;&apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [report_date])&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; then&#10;str([Calculation_3886113912831004675])&#10;end' />
      </column>
      <column aggregation='Count' caption='datename(2) report_date' datatype='string' default-type='nominal' layered='true' name='[Calculation_3886113912835129349]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;day&apos;&#10;then left(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#10;else str(year([Calculation_3886113912831004675]))&#10;end' />
      </column>
      <column aggregation='Count' caption='datediff report_date' datatype='integer' default-type='ordinal' layered='true' name='[Calculation_3886113912835342342]' pivot='key' role='dimension' type='ordinal' user-datatype='integer' visual-totals='Default'>
        <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) &#10;then DATEDIFF(&apos;month&apos;,[report_date], [Calculation_3886113912828583936])&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#10;then DATEDIFF(&apos;week&apos;,[report_date], [Calculation_3886113912828583936])&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; &#10;then DATEDIFF(&apos;day&apos;,[report_date], [Calculation_3886113912828583936])&#10;end' />
      </column>
      <column aggregation='Count' caption='datefilter report_date' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_3886113912835493895]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
        <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(week)|(day)&apos;)&#10;then [Calculation_3886113912835342342] &lt;= 12+[Parameters].[Parameter 2] and [Calculation_3886113912835342342] &gt;= [Parameters].[Parameter 2]&#10;elseif [Parameters].[Parameter 1] = &apos;mtd&apos;&#10;then [Calculation_3886113912830406658] &lt;= [mtd report_date (copy)] and [Calculation_3886113912835342342] &lt;= 12+[Parameters].[Parameter 2] and [Calculation_3886113912835342342] &gt;= [Parameters].[Parameter 2]&#10;elseif [Parameters].[Parameter 1] = &apos;wtd&apos;&#10;then [Calculation_3886113912828940289] &lt;= [wtd report_date (copy)] and [Calculation_3886113912835342342] &lt;= 12+[Parameters].[Parameter 2] and [Calculation_3886113912835342342] &gt;= [Parameters].[Parameter 2]&#10;end' />
      </column>
      <column aggregation='User' caption='actual_rh_rate' datatype='real' default-type='quantitative' layered='true' name='[Calculation_3886113912861855754]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
