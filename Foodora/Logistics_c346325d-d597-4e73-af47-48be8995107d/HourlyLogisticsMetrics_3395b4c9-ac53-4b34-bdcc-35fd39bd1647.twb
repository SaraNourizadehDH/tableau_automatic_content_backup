            <column _.fcp.ParameterDefaultValues.true...default-value-field='[sqlproxy.0760ry21aq0mbu1avpkxn01dj895].[Calculation_1015350666411008011]' caption='Start Date' datatype='date' default-format='*yyyy-mm-dd' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='#2025-05-26#'>
              <calculation class='tableau' formula='#2025-05-26#' />
