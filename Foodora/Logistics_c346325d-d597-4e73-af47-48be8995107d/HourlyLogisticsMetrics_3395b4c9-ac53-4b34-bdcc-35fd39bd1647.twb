              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -1, today())' />
            </column>
            <column caption='dispatch_rate' datatype='real' name='[Calculation_1052716424658608130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dispatch_to_notify])/sum([actual_dt])' />
