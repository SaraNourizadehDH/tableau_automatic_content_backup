      </column>
      <column caption='At Vendor Time' datatype='real' name='[Actual Prep Time (copy)_1131459063360036864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(SUM([at_vendor_time_mins])/SUM([at_vendor_time_orders]))' />
      </column>
      <column caption='At Vendor Time Cleaned' datatype='real' name='[At Vendor Time (copy)_1131459063360315393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(SUM([at_vendor_time_cleaned_mins])/SUM([at_vendor_time_cleaned_orders]))' />
      </column>
      <column caption='PDT' datatype='real' name='[Avg. DT (copy)_6686789931035369472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_pdt])/SUM([completed_orders]-[completed_preorders])' />
      </column>
      <column caption='DT' datatype='real' name='[Avg. Dt (copy)_374924671033712640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_dt])/SUM([completed_orders]-[completed_preorders])' />
      </column>
      <column caption='Rider Delay' datatype='real' name='[Avg. Vendor Delay (copy)_2172423902074781696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(SUM([rider_delay_mins])/SUM([completed_orders]))' />
      </column>
      <column caption='Vendor Reaction Time' datatype='real' name='[Calculation_1251156310633353217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_reaction_time_mins])/SUM([vendor_reaction_time_orders])' />
      </column>
      <column caption='ind' datatype='integer' name='[Calculation_1251156310636204034]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Name' datatype='string' name='[Calculation_1251156310656364548]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 4] &#13;&#10;when &apos;Brand&apos; then TRIM(REGEXP_REPLACE(LOWER([vendor_name]),&apos;\(.*?\)&apos;,&apos;&apos;))&#13;&#10;when &apos;Outlet&apos; then [vendor_name]&#13;&#10;end' />
      </column>
      <column caption='vendor_search' datatype='boolean' name='[Calculation_1251156310656651271]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;&apos; &#13;&#10;  THEN TRUE&#13;&#10;ELSE REGEXP_MATCH(LOWER([vendor_code]+[vendor_name]),LOWER(REGEXP_REPLACE([Parameters].[Parameter 5],&apos; |,|;&apos;,&apos;|&apos;)))&#13;&#10;END' />
      </column>
      <column caption='index_filter' datatype='boolean' name='[Calculation_1251156310660567049]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1251156310636204034] &lt;= [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Est. Prep Time' datatype='real' name='[Calculation_1509268850173689856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([est_prep_time_mins])/SUM([completed_orders])' />
      </column>
      <column caption='Vendor Delay' datatype='real' name='[Calculation_1856046039664668676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(SUM([vendor_delay_mins])/SUM([completed_orders]))' />
      </column>
      <column caption='acceptance_rate' datatype='real' name='[Calculation_1856046039665311750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_accept])/SUM([total_notification])' />
      </column>
      <column caption='updated_from' datatype='date' name='[Calculation_1856046039665872903]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MIN([report_date])}' />
      </column>
      <column caption='Redispatch' datatype='integer' name='[Calculation_1856046039947907081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_near_picked_up])-SUM([total_dropped_off])' />
      </column>
      <column caption='Split' datatype='integer' name='[Calculation_1856046039948046346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if SUM([total_dropped_off])-SUM([completed_orders]) &lt; 0 &#10;then 0 &#10;else SUM([total_dropped_off])-SUM([completed_orders])&#10;end' />
      </column>
      <column caption='current_week' datatype='integer' name='[Calculation_1978558041647214593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;week&apos;, today())' />
      </column>
      <column caption='Prep Time Gap' datatype='real' name='[Calculation_6686789931042291714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Est. Prep Time (copy)_6686789931038748673] != 0 &#10;THEN [Calculation_1509268850173689856] - [Est. Prep Time (copy)_6686789931038748673]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='main_kpi' datatype='real' name='[Calculation_6757299412948545536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Valid Orders&quot; THEN SUM([valid_orders])&#10;WHEN &quot;Deliveries&quot; THEN SUM([completed_deliveries])&#10;WHEN &quot;Preorders&quot; THEN SUM([completed_preorders])&#10;WHEN &quot;DT&quot; THEN [Avg. Dt (copy)_374924671033712640]&#10;WHEN &quot;PDT&quot; THEN [Avg. DT (copy)_6686789931035369472]&#10;WHEN &quot;Vendor Delay&quot; THEN [Calculation_1856046039664668676]&#10;WHEN &quot;Rider Delay&quot; THEN [Avg. Vendor Delay (copy)_2172423902074781696]&#10;WHEN &quot;Est. Prep Time&quot; THEN [Calculation_1509268850173689856]&#10;WHEN &quot;Actual Prep Time&quot; THEN [Est. Prep Time (copy)_6686789931038748673]&#10;WHEN &quot;Prep Time Gap&quot; THEN [Calculation_6686789931042291714]&#10;WHEN &quot;Acceptance Rate&quot; THEN [Calculation_1856046039665311750]&#10;WHEN &quot;Redispatch Orders&quot; THEN [Calculation_1856046039947907081]&#10;WHEN &quot;Split&quot; THEN [Calculation_1856046039948046346]&#10;WHEN &quot;foodpanda Failed Orders&quot; THEN SUM([foodpanda_failed_orders])&#10;WHEN &quot;Vendor Failed Orders&quot; THEN SUM([vendor_failed_orders])&#10;WHEN &quot;Customer Failed Orders&quot; THEN SUM([customer_failed_orders])&#10;WHEN &quot;Vendor Closed Orders&quot; THEN SUM([vendor_closed_orders])&#10;END' />
      </column>
      <column caption='partition_by' datatype='string' name='[Calculation_6757299412950831105]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;All&quot; THEN &quot;All&quot;&#10;WHEN &quot;City&quot; THEN [lg_city_name]&#10;WHEN &quot;Zone&quot; THEN [lg_zone_name]&#10;WHEN &quot;TES model&quot; THEN [current_tes_strategy]&#10;WHEN &quot;Vertical type&quot; THEN [vertical_type]&#10;WHEN &quot;Primary Cuisine&quot; THEN [primary_cuisine]&#10;END' />
      </column>
      <column caption='Actual Prep Time' datatype='real' name='[Est. Prep Time (copy)_6686789931038748673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(SUM([actual_prep_time_mins])/SUM([actual_prep_orders]))' />
