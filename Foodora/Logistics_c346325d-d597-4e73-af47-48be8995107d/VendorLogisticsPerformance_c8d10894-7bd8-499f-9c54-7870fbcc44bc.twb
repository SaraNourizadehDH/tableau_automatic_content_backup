  <dashboards>
    <dashboard name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/VendorLogisticsPerformance/Definitions?rev=' id='240893' path='/t/Foodora/workbooks/VendorLogisticsPerformance' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_21' value='top' />
        </style-rule>
      </style>
      <size maxheight='1000' maxwidth='1400' minheight='1000' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='90619' id='3' param='vert' type-v2='layout-flow' w='49429' x='571' y='8581'>
            <zone forceUpdate='true' h='89000' id='8' type-v2='text' w='49429' x='571' y='8581'>
              <formatted-text>
                <run bold='true'>Report date based on</run>
                <run bold='true' fontcolor='#e15759'> [promised_delivery_at_local]</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Vaild Orders]</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>includes statuses in below list:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>621 - Order delvieried</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>622 - Customer confirmed delivery</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>612 - Order assembled</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>62 - Order accepted, customer informed</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>614 - Order picked up</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Deliveries]</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'># completed deliveries</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Preorders]</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'># completed preorders</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Avg.Dt] </run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>The average delivery time calculated as the difference between [delivery_created_at] and [rider_near_drop_off], exlcuding preorders.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Acceptance Rate]</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Light'>Accept times / Notified times</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light'>[Vendor Delay]</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Light'>The delayed actual pick up time compared to the original scheduled pickup time in seconds when this is attributable to the vendor. It distinguishes several cases:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Light'>1. If rider spends 5 or more minutes in the restaurant it is computed as `rider_picked_up_at` - `original_scheduled_pickup_time`</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Light'> 2. If rider spends less than 5 minutes in the restaurant it is computed as `rider_picked_up_at` - `rider_near_restaurant_at`. </run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Light'>It is computed only if rider is no later than 10 minutes.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light'>[Rider Delay]</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>The time difference between rider arrival at vendor and the original scheduled pickup time.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Vendor fail orders include statuses below]</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>63 - Vendor declined - customer informed</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Customer fail orders include statuses below]</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>54 - order cancelled, call vendor</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>64 - customer cancelled - vendor informed</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>68 - Post-Delivery Issue</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Fail orders include statuses below]</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>52 - Vendor declined, contact customer</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>59 - Traffic manager declined, call customer</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>631 - Logistics Cancellation</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1b1b1b' fontname='Tableau Light'>65 - order not delivered</run>
                <run>Æ&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone forceUpdate='true' h='90619' id='21' type-v2='text' w='49429' x='50000' y='8581'>
            <formatted-text>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light' fontsize='9'>[Assumed actual preparation time]</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>The assumed preparation time calculated by distinguishing three cases:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'><![CDATA[1. rider_late <= 0 computed as rider_picked_up_at - sent_to_vendor_at]]></run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>2. rider_late &gt; 0 and spends less than 5 minutes in the restaurant: computed as estimated_prep_time</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>3. rider_late &gt; 0 and spends more than 5 minutes in the restaurant: computed as rider_picked_up_at - sent_to_vendor_at</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>All the cases exclude preorder, in case of preorder we do not compute this KPI. We also do not compute this KPI if rider_late &gt; 15 minutes. There are also outlier pre filters based on data science model which make this KPI computable only on a sub set of orders.</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[At vendor time]</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>The time difference between rider arrival at vendor and the rider picking up the food.</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[At vendor time cleaned]</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>The at_vendor_time started to compute from the time food should have been picked up. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Not computed if rider is late &gt; 10 to allow possible re cooking of food.</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Vendor close]</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Vendor closed due to `decline_reason_code `= &quot;TRAFFIC_MANAGER_VENDOR_CLOSED&quot;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Redispatch]</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Order level summation redispatch times. Total rider near by restaurants - Total rider dropoff</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Split]</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b' fontname='Tableau Light'>Order level summation dropoff times, Total rider dropoff - Total Completed Orders</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='7781' id='7' type-v2='text' w='98858' x='571' y='800'>
            <formatted-text>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light' fontsize='20'>Definitions</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='153' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='152' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone h='7781' id='7' type-v2='text' w='98858' x='571' y='800'>
                  <formatted-text>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light' fontsize='20'>Definitions</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='89000' id='8' type-v2='text' w='49429' x='571' y='8581'>
                  <formatted-text>
                    <run bold='true'>Report date based on</run>
                    <run bold='true' fontcolor='#e15759'> [promised_delivery_at_local]</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Vaild Orders]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>includes statuses in below list:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>621 - Order delvieried</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>622 - Customer confirmed delivery</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>612 - Order assembled</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>62 - Order accepted, customer informed</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>614 - Order picked up</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Deliveries]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'># completed deliveries</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Preorders]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'># completed preorders</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Avg.Dt] </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>The average delivery time calculated as the difference between [delivery_created_at] and [rider_near_drop_off], exlcuding preorders.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Acceptance Rate]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Light'>Accept times / Notified times</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>[Vendor Delay]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Light'>The delayed actual pick up time compared to the original scheduled pickup time in seconds when this is attributable to the vendor. It distinguishes several cases:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Light'>1. If rider spends 5 or more minutes in the restaurant it is computed as `rider_picked_up_at` - `original_scheduled_pickup_time`</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Light'> 2. If rider spends less than 5 minutes in the restaurant it is computed as `rider_picked_up_at` - `rider_near_restaurant_at`. </run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Light'>It is computed only if rider is no later than 10 minutes.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>[Rider Delay]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>The time difference between rider arrival at vendor and the original scheduled pickup time.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Vendor fail orders include statuses below]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>63 - Vendor declined - customer informed</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Customer fail orders include statuses below]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>54 - order cancelled, call vendor</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>64 - customer cancelled - vendor informed</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>68 - Post-Delivery Issue</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Fail orders include statuses below]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>52 - Vendor declined, contact customer</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>59 - Traffic manager declined, call customer</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>631 - Logistics Cancellation</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>65 - order not delivered</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='90619' id='21' type-v2='text' w='49429' x='50000' y='8581'>
                  <formatted-text>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light' fontsize='9'>[Assumed actual preparation time]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>The assumed preparation time calculated by distinguishing three cases:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'><![CDATA[1. rider_late <= 0 computed as rider_picked_up_at - sent_to_vendor_at]]></run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>2. rider_late &gt; 0 and spends less than 5 minutes in the restaurant: computed as estimated_prep_time</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>3. rider_late &gt; 0 and spends more than 5 minutes in the restaurant: computed as rider_picked_up_at - sent_to_vendor_at</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>All the cases exclude preorder, in case of preorder we do not compute this KPI. We also do not compute this KPI if rider_late &gt; 15 minutes. There are also outlier pre filters based on data science model which make this KPI computable only on a sub set of orders.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[At vendor time]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>The time difference between rider arrival at vendor and the rider picking up the food.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[At vendor time cleaned]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>The at_vendor_time started to compute from the time food should have been picked up. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>Not computed if rider is late &gt; 10 to allow possible re cooking of food.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Vendor close]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>Vendor closed due to `decline_reason_code `= &quot;TRAFFIC_MANAGER_VENDOR_CLOSED&quot;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Redispatch]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>Order level summation redispatch times. Total rider near by restaurants - Total rider dropoff</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Split]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light'>Order level summation dropoff times, Total rider dropoff - Total Completed Orders</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{11E25E29-AF22-46E6-9671-081DD0A0F1F7}' />
    </dashboard>
