  <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APSupply_Chain_top25_availability?rev=3.2' id='APSupply_Chain_top25_availability' path='/t/Foodora/workbooks' revision='3.3' site='Foodora' />
