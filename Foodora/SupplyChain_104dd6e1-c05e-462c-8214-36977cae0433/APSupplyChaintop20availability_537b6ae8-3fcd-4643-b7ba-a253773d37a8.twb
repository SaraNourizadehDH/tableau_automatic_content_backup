            <column caption='Period' datatype='string' name='[Calculation_133559925789224968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6]=&quot;Year&quot; then [Quarter (copy)_216665417987543041]&#10;ELSEIF [Parameters].[Parameter 6]=&quot;Month&quot; then [Month (copy)_216665417987686402]&#10;ELSEIF [Parameters].[Parameter 6]=&quot;Date&quot; then RIGHT(STR([date]),LEN(STR(date))-5)&#10;ELSE [Calculation_1513279902616428553]&#10;END' />
            </column>
            <column caption='Week' datatype='string' datatype-customized='true' name='[Calculation_1513279902616428553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if len(STR(DATEPART(&apos;week&apos;,[date]))) =1 &#10;&#10;then STR(&quot;WK0&quot;+STR(DATEPART(&apos;week&apos;,[date])))&#10;&#10;ELSE (&quot;WK&quot;+STR(DATEPART(&apos;week&apos;,[date])))&#10;end' />
            </column>
            <column caption='shnk%' datatype='real' default-format='p0%' name='[Disc% (copy)_5970787961881767936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if sum([sales_qty])&lt;=0 and sum([shnk_qty_all])&lt;0 then 1&#10;ELSEIF sum([sales_qty])&lt;=0 and sum([shnk_qty_all])=0 then 0&#10;ELSE sum([shnk_qty_all])/sum([sales_qty])&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Month (copy)_216665417987686402]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if len(STR(DATEPART(&apos;month&apos;,[date])))=2 then&#10;&#10;&#10;&#10;datename(&apos;year&apos;,[date])+&quot;-&quot;+STR(DATEPART(&apos;month&apos;,[date]))&#10;&#10;else &#10;&#10;datename(&apos;year&apos;,[date])+&quot;-0&quot;+STR(DATEPART(&apos;month&apos;,[date]))&#10;END' />
            </column>
            <column caption='Year' datatype='string' datatype-customized='true' name='[Quarter (copy)_216665417987543041]' role='dimension' type='nominal'>
