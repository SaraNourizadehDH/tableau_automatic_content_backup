      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_BE55CF85C7234F3BB8B44D79EBAC84C6'>
            <properties context=''>
              <relation connection='bigquery.0era2jy0qak4ln1b00ioi1ld6ghu' name='Custom SQL Query' type='text'><![CDATA[with 
fx as 
        (

               select
                 date as week
                ,global_entity_id,
                avg(fx) as fx
                from 

                (
                select 
                        DATE
                        ,global_entity_id,
                        CASE 
                                WHEN global_entity_id = "FP_KH" THEN ROUND(SAFE_DIVIDE(fx_rate_usd,fx_rate_Eur),5)
                                else ROUND(SAFE_DIVIDE(1,fx_rate_Eur),6)
                        end
                        AS fx 
                from (
                                SELECT
                                DATE(fx_rate_date) AS DATE,
                                        CASE 
                                        WHEN currency_code= "SGD" THEN "FP_SG"
                                        WHEN currency_code = "BDT" THEN "FP_BD"
                                        WHEN currency_code = "KHR" THEN "FP_KH"
                                        WHEN currency_code = "HKD" THEN "FP_HK"
                                        WHEN currency_code = "LAK" THEN "FP_LA"
                                        WHEN currency_code = "PHP" THEN "FP_PH"
                                        WHEN currency_code = "THB" THEN "FP_TH"
                                        WHEN currency_code = "TWD" THEN "FP_TW"
                                        WHEN currency_code = "MMK" THEN "FP_MM"
                                        WHEN currency_code = "PKR" THEN "FP_PK"
                                        WHEN currency_code = "MYR" THEN "FP_MY"
                                        ELSE ""
                                        END
                                        AS global_entity_id,
                                        fx_rate_Eur,
                                        fx_rate_usd,
                                FROM `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates`
                                WHERE fx_rate_date >>= date_sub(date_trunc(current_date(),month), interval 2 month)
                        )
                         WHERE global_entity_id in ("FP_SG","FP_MY","FP_PK","FP_BD","FP_HK","FP_PH") 
                )
                group by 1,2
),
warehouses_master_temp AS 
(  
      SELECT   
                global_entity_id, 
                warehouse_id as dmart_imt_warehouse_uuid,
                CASE 
                          WHEN name like "Delivery Hero Stores (Bangladesh) Limited-%" THEN RIGHT(name,
                          BYTE_LENGTH(name)-42)
                          ELSE name
                          END
                  AS dmart_imt_warehouse_name,
                CASE 
                WHEN 
                warehouse_id="3e4c0cb7-bde7-4e9c-8e33-207bcec0b074" THEN "38618"
                ELSE CAST( distribution_center_supplier_id AS STRING )
                END 
                 AS dmart_dc_supplier_id,-- DC act as supplier, supplier id 
                if(is_distribution_center,"DC","Store") AS dmart_type,
        FROM `fulfillment-dwh-production.curated_data_shared_dmart.warehouses_v2` 
        WHERE (is_dmart or is_distribution_center)  
                AND warehouse_id IS NOT NULL 
                AND global_entity_id in ("FP_SG","FP_MY","FP_PK","FP_BD","FP_HK","FP_PH") 
        GROUP BY 1,2,3,4,5 -- dont add vendor code as sto doesnt have it 
),
warehouses_master AS 
(  
       SELECT   
                global_entity_id, 
                dmart_imt_warehouse_uuid,
                max(dmart_imt_warehouse_name) as dmart_imt_warehouse_name,
                max(dmart_dc_supplier_id) as dmart_dc_supplier_id ,
                min(dmart_type) as dmart_type         
        FROM warehouses_master_temp    
        GROUP BY 1,2
  ),
  private_label as 
  (
        SELECT 
        global_entity_id,
        SKU,	
        "private_label" as private_label
        FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__performance_materialised_private_label_skus_gsheet`
  ),
  vendor_revenue as 
  (
          select 
                *,
                row_number() over (partition by global_entity_id,dmart_imt_warehouse_uuid order by GFV_Eur desc) as multi_vendor_rank,
                sum(GFV_Eur) over (partition by global_entity_id,dmart_imt_warehouse_uuid ) as dmart_revenue,
                from 
                (   
                SELECT
                        a.global_entity_id,
                        a.dmart_imt_warehouse_uuid,
                        a.vendor_code,
                        round(sum(paid_total_price_Eur),2) as GFV_Eur,     
                FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__customer_order_line_report_v2` a
                WHERE  a.global_entity_id in ("FP_SG","FP_MY","FP_PK","FP_MM","FP_LA","FP_KH","FP_BD","FP_HK","FP_PH")  
                AND is_billable and received_quantity >>0 AND paid_total_price_Eur<<1000000
                AND order_date_local  >>= date_sub(current_date(), interval 4 day)
                GROUP BY 1,2,3
                )
  ),
  pd as (
      select * except(date_range) 
      from 
      ( 
                select *, 
                GENERATE_DATE_ARRAY( current_date()-1, current_date()-21,INTERVAL -1 day) 
                AS date_range  
                from(
                        select 
                        global_entity_id,
                        dmart_imt_warehouse_uuid, 
                        sku,
                        max(dmart_imt_warehouse_name) as dmart_imt_warehouse_name,
                        max(category_zero) as category_zero,
                        max(category_one) as category_one,
                        max(product_title_english) as product_title_english,
                        max(fresh_tag) as fresh_tag,
                        max(category_english) as category_english,
                        max(sku_status) as sku_status, 
                        MAX(dmart_supplier_name ) AS  dmart_supplier_name,
                        MAX(is_dc_original) AS  is_dc_original,
                        max(private_label) as private_label,  
                        max(sales_buffer) as sales_buffer, 
                        min(dmart_status) as dmart_status
                        from
                                (
                        
                                        SELECT 
                                        a.global_entity_id,
                                        a.dmart_imt_warehouse_uuid,--- key 
                                        CASE 
                                                WHEN a.dmart_imt_warehouse_name like "Delivery Hero Stores (Bangladesh) Limited-%" 
                                                THEN RIGHT(a.dmart_imt_warehouse_name,BYTE_LENGTH(a.dmart_imt_warehouse_name)-42)
                                                ELSE a.dmart_imt_warehouse_name
                                                END
                                        AS dmart_imt_warehouse_name,
                                        a.vendor_name,
                                        CASE 
                                                WHEN master_category_names.level_one = "Frozen" THEN "Frozen"
                                                WHEN master_category_names.level_one IN ("Bread / Bakery","Dairy / Chilled / Eggs" )  THEN "Fresh"
                                                WHEN master_category_names.level_one IN ("Meat / Seafood","Ready To Consume","Produce") THEN "Ultra Fresh"
                                                ELSE "Ambient"
                                        END AS fresh_tag,
                                        CASE
                                                WHEN master_category_names.level_one IN ("Meat / Seafood","Ready To Consume","Produce","Bread / Bakery","Dairy / Chilled / Eggs" ) 
                                                THEN "Fresh & Ultra Fresh"
                                                ELSE "Ambient&Frozen"
                                        END AS category_zero,
                                        a.sku,
                                        product_title_english,
                                        master_category_names.level_one AS category_one,
                                        category_english, 
                                        dmart_supplier_name,
                                        is_dc_original_supplier  AS  is_dc_original,
                                        status as sku_status,  
                                        private_label,    
                                        sales_buffer, 
                                        case 
                                        when dmart_revenue >>0 then "Dmart_Active"
                                        else "Dmart_Closed"
                                        end as dmart_status,
                                        multi_vendor_rank                                                
                                FROM`fulfillment-dwh-production.pandata_report.dmart__product_report` a
                                left join private_label b on a.global_entity_id = b.global_entity_id and  a.sku=b.sku
                                left join vendor_revenue c on a.global_entity_id = c.global_entity_id and a.dmart_imt_warehouse_uuid=c.dmart_imt_warehouse_uuid and a.vendor_code=c.vendor_code
                                 left join warehouses_master  f 
                                on a.global_entity_id=f.global_entity_id and a.dmart_imt_warehouse_uuid=f.dmart_imt_warehouse_uuid
                                WHERE  a.dmart_imt_warehouse_uuid <<>> ""AND is_dmart 
                                and ((ifnull(multi_vendor_rank,0) =1 and ifnull(dmart_revenue,0)>>0) or dmart_type="DC") 
                                        AND a.global_entity_id in ("FP_SG")
                                        
                                )
                                group by 1,2,3
                )
                                
                )a left join 
            unnest (date_range) as week  
),
shnk as 
(
        select
      a.global_entity_id,
               a.dmart_imt_warehouse_uuid,
               sku,
               date(created_date_local) as week,
               avg(wac_eur) as wac_eur,
               avg(wac_local) as wac_lc,
         sum(if((inventory_adjustment_reason="Quality Issue" or inventory_adjustment_reason="Store Expired" ),ifnull(on_hand_qty_delta,0)*ifnull(wac_eur,0),0)) as shnk_Eur_SC,
              sum(if((inventory_adjustment_reason="Store Damaged" 
                        or inventory_adjustment_reason="Store Expired" or
                        event_type="StoreTransferShrinkage" 
                        or contains_substr(lower(inventory_adjustment_reason), "putaway")
                        or event_type="CycleCountAdjustment"
                        or inventory_adjustment_reason="Stock Addition" 
                        or inventory_adjustment_reason="Stock Subtraction" 
                        or inventory_adjustment_reason="Quality Issue" 
                        or inventory_adjustment_reason="Theft" 
                        or inventory_adjustment_reason="Customer Replacement" 
                        or (dmart_type<<>>"DC" AND (inventory_adjustment_reason="Store Transfer Addition" or inventory_adjustment_reason="Store Transfer Subtraction"))),
               ifnull(on_hand_qty_delta,0)*ifnull(wac_eur,0),0)) as shnk_eur_all,
             sum(if(contains_substr(lower(inventory_adjustment_reason), "putaway"), ifnull(on_hand_qty_delta,0)*ifnull(wac_eur,0),0)) as shnk_eur_putaway,
             sum(if(inventory_adjustment_reason="Other",  ifnull(on_hand_qty_delta,0)*ifnull(wac_eur,0),0)) as Other_Eur,
             sum(if(inventory_adjustment_reason="Supplier Return",  ifnull(on_hand_qty_delta,0)*ifnull(wac_eur,0),0)) as shnk_Eur_SupplierReturn,
             sum(if(inventory_adjustment_reason="Store Damaged",  ifnull(on_hand_qty_delta,0)*ifnull(wac_eur,0),0)) as shnk_Eur_damaged,
             sum(if(inventory_adjustment_reason="Store Expired",  ifnull(on_hand_qty_delta,0)*ifnull(wac_eur,0),0)) as shnk_Eur_expired,
             sum(if(event_type="StoreTransferShrinkage",  ifnull(on_hand_qty_delta,0)*ifnull(wac_eur,0),0)) as shnk_Eur_ist,
             sum(if(event_type="CycleCountAdjustment",  ifnull(on_hand_qty_delta,0)*ifnull(wac_eur,0),0)) as shnk_Eur_cyclecount,
             sum(if(inventory_adjustment_reason="Quality Issue" ,  ifnull(on_hand_qty_delta,0)*ifnull(wac_eur,0),0)) as shnk_Eur_quality_issue,
             sum(if(inventory_adjustment_reason="Theft"  ,  ifnull(on_hand_qty_delta,0)*ifnull(wac_eur,0),0)) as shnk_Eur_theft,
             sum(if((inventory_adjustment_reason="Store Transfer Addition" 
             or inventory_adjustment_reason="Store Transfer Subtraction") ,
               ifnull(on_hand_qty_delta,0)*ifnull(wac_eur,0),0)) as shnk_Eur_store_transfer,
             sum(if(inventory_adjustment_reason="Stock Addition" 
             or inventory_adjustment_reason="Stock Subtraction" ,  ifnull(on_hand_qty_delta,0)*ifnull(wac_eur,0),0)) as shnk_Eur_stock_sub_add,
              sum(if(inventory_adjustment_reason="Customer Replacement",ifnull(on_hand_qty_delta,0)*ifnull(wac_eur,0),0)) as shnk_Eur_customerReplacment,
              sum(if((inventory_adjustment_reason="Store Damaged" 
                        or inventory_adjustment_reason="Store Expired" or
                        event_type="StoreTransferShrinkage" 
                        or contains_substr(lower(inventory_adjustment_reason), "putaway")
                        or event_type="CycleCountAdjustment"
                        or inventory_adjustment_reason="Stock Addition" 
                        or inventory_adjustment_reason="Stock Subtraction" 
                        or inventory_adjustment_reason="Quality Issue" 
                        or inventory_adjustment_reason="Theft" 
                        or inventory_adjustment_reason="Customer Replacement" 
                        or
                                (dmart_type<<>>"DC" AND (inventory_adjustment_reason="Store Transfer Addition" or inventory_adjustment_reason="Store Transfer Subtraction"))),
           ifnull(on_hand_qty_delta,0),0)) as shnk_qty,           
               FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__inventory_movements_report` a
               left join warehouses_master c
               on a.global_entity_id=c.global_entity_id and a.dmart_imt_warehouse_uuid=c.dmart_imt_warehouse_uuid
               where  a.global_entity_id in ("FP_SG","FP_MY","FP_TH","FP_PK","FP_BD","FP_TW","FP_HK","FP_PH")
               and date(created_date_local) >>= date_sub(date_trunc(current_date(),isoweek), interval 5 week)
               group by 1,2,3,4
),
co as 
(
SELECT
        global_entity_id,
        dmart_imt_warehouse_uuid,
        sku,
        order_date_local as week,
        round(avg(original_price_local_before_discount),2) as original_price,
        round(avg(listed_unit_price_local_after_discount),2) as discount_price,
        round(1-safe_divide(avg(listed_unit_price_local_after_discount),avg(original_price_local_before_discount)),2) as disc_per,
        SUM(ifnull(djini_quantity,0)) AS djini_qty,
        sum(received_quantity) as sales_qty,
        round(sum(paid_total_price_Eur),2) as GFV_Eur,
        round(sum(COGS_Eur),2)  as COGS_Eur,
        max(order_date_local) as sales_day
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__customer_order_line_report_v2`
    WHERE  global_entity_id in ("FP_SG")  
    AND is_billable and received_quantity >>0 AND paid_total_price_Eur<<1000000
    AND order_date_local  >>= date_sub(date_trunc(current_date(),isoweek), interval 10 week)
    GROUP BY 1,2,3,4
),

stock as 
  (
    SELECT 
            a.global_entity_id,
            a.dmart_imt_warehouse_uuid,
            a.sku,
            date_local as week,
            ROUND(avg((ifnull(a.beginning_stock,0)+ifnull(a.end_stock,0))/2),0) as stock_qty,
            ROUND(avg((ifnull(a.starting_inventory_value,0)+ifnull(a.ending_inventory_value,0))/2),2) as stock_local,
        FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__inventory_value_report` a 
        WHERE date_local >>= date_sub(date_trunc(current_date(),isoweek), interval 3 week)
        AND a.global_entity_id in ("FP_SG")   
        and end_stock<<8000001 and beginning_stock <<8000001
        group by 1,2,3,4
  ),
stock_date as 
  (
    SELECT  global_entity_id,      
            dmart_imt_warehouse_uuid,
            sku,
            end_stock as current_stock,
            ending_inventory_value as current_stock_value,
        FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__inventory_value_report` a 
        where a.global_entity_id in ("FP_SG")   
        and date_local >>= current_date()-1 and end_stock>>0
        and end_stock<<8000001 and beginning_stock <<8000001
  ),
avl as 
(
 SELECT
        avl.global_entity_id,
        dmart_imt_warehouse_uuid,
        sku,
        date_local as week,
        max(vendor_type) as vendor_type,
        max(sku_status)as wkly_sku_status,
        max(sales_buffer) as wkly_sales_buffer,  
        sum(if(sku_status="ACTIVE" and vendor_type <<>> "b2b",quantity_past28days,0)) as quantity_past28days,
        sum(if(sku_status="ACTIVE" and vendor_type <<>> "b2b",available_hours,0)) as avl_hours,
        sum(if(sku_status="ACTIVE" and vendor_type <<>> "b2b",available_hours,0)) as available_hours,
        sum(if(sku_status="ACTIVE" and vendor_type <<>> "b2b",total_hours,0)) as total_hours,
        ROUND(safe_divide(sum(available_hours), sum(total_hours)),2) as AVL, 
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__availability_sku_report` avl
      WHERE  global_entity_id in ("FP_SG")  
      AND DATE(date_local) >>= date_sub(date_trunc(current_date(),isoweek), interval 3 week)
      GROUP BY 1,2,3,4
),
inflow_sto AS 
(
            SELECT 
                cd.global_entity_id,
                cd.destination_warehouse_uuid AS dmart_imt_warehouse_uuid,           
                cd.store_transfer_reference AS refer_code,
                cd.sku,
                IFNULL(cd.requested_quantity,0)AS ordered_qty,
                if(cd.received_quantity<<0,0,cd.received_quantity) AS delivered_qty,
                0 as returned_quantity,
                ROUND(SAFE_DIVIDE(cd.received_quantity,cd.requested_quantity),2) AS fr,
                DATE(cd.created_at_local) AS po_created_at_local,
                DATE(cd.status_modified_at_local) AS po_fulfilled_at_local,
                if(date_diff(cd.status_modified_at_local,cd.created_at_local,day)=0,1,
                date_diff(cd.status_modified_at_local,cd.created_at_local,day))as lt_po,  
                date_diff(cd.status_modified_at_local,cd.expected_delivery_at_local,day)as delay_days,            
                cd.origin_warehouse_name AS source_name,
                case 
                when origin_warehouse_name like "%Toll Distribution%" or origin_warehouse_name like "%Distribution%"
                or origin_warehouse_name like "%DC%"or origin_warehouse_name like "%Platform%" THEN "DC"
                WHEN bc.dmart_type IS NULL THEN "supplier"
                ELSE bc.dmart_type END AS source_type,
                latest_status as status,  
                "sto" as order_type   
        FROM `fulfillment-dwh-production.pandata_report.dmart__store_transfer_report` cd
            LEFT JOIN warehouses_master bc
                    ON cd.global_entity_id = bc.global_entity_id AND cd.origin_warehouse_uuid = bc.dmart_imt_warehouse_uuid      
                        WHERE cd.global_entity_id in ("FP_SG")  
                        and byte_length(store_transfer_reference) <<10
                    AND  latest_status in ("done","COMPLETED","Partially Inbounded","Done","partially_inbounded","PARTIALLY_INBOUNDED","confirmed","in_progress","CONFIRMING","CREATED","TRANSFERRING","INBOUNDING","OUTBOUNDING")
                ),
inflow_po AS 
(
        SELECT
                ab.global_entity_id,
                ab.dmart_imt_warehouse_uuid,
                ab.reference_number AS refer_code,
                ab.sku,
                ab.ordered_quantity as ordered_qty, --- This can be 0!
                ab.delivered_quantity as delivered_qty,--this is the key 
                returned_quantity,
                ROUND(SAFE_DIVIDE(ifnull(ab.delivered_quantity,0),ab.ordered_quantity),2) AS fr,
                DATE(ab.po_created_at_local) AS po_created_at_local,
                case when status_code in ("CANCELED","CANCELLATION","cancellation_requested","canceled") then DATE(expected_delivery_at_local)
                else DATE(ab.po_fulfilled_at_local) 
                end AS po_fulfilled_at_local, -- format to yyyy-mm-dd format 
                if(date_diff(ab.po_fulfilled_at_local,ab.po_created_at_local,day)=0,1,
                date_diff(ab.expected_delivery_at_local,ab.po_created_at_local,day))as lt_po,
                date_diff(po_fulfilled_at_local,ab.expected_delivery_at_local,day) as delay_days,  
                 ab.dmart_supplier_portal_supplier_name AS source_name,
                CASE 
                    WHEN bc.dmart_type ="DC" OR ab.dmart_supplier_portal_supplier_name like "%E&Z DC%"
                    OR ab.dmart_supplier_portal_supplier_name like "%Toll Distribution%"
                    THEN "DC"
                    WHEN ab.dmart_supplier_portal_supplier_name like "To Be used%" or ab.dmart_supplier_portal_supplier_name 
                    like "to be used%" or ab.dmart_supplier_portal_supplier_name like "Pandamart%" or ab.dmart_supplier_portal_supplier_name 
                     like "pandamart%"or ab.dmart_supplier_portal_supplier_name  like "virtual%" or ab.dmart_supplier_portal_supplier_name
                       like "%virtual%" or ab.dmart_supplier_portal_supplier_name like "%Virtual%" OR ab.dmart_supplier_portal_supplier_name 
                        like "%Pandamart%" OR ab.dmart_supplier_portal_supplier_name like "%pandamart%" or ab.dmart_supplier_portal_supplier_name 
                        like"%Delivery Hero Philippines%" THEN "Store"
                    ELSE ifnull(bc.dmart_type,"supplier") 
                    END
                AS source_type, 
                status_code as status,
                "po" as order_type           
        FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__purchase_order_line_report` ab -- take note, po lt can be improved along the way
            LEFT JOIN warehouses_master bc
                ON ab.global_entity_id = bc.global_entity_id AND ab.dmart_supplier_portal_supplier_id= bc.dmart_dc_supplier_id
                 WHERE   ab.global_entity_id in ("FP_SG")  
                 and byte_length(reference_number) <<10
                AND (status_code in ("done","COMPLETED","Partially Inbounded","Done","partially_inbounded","PARTIALLY_INBOUNDED","confirmed","in_progress","CONFIRMING","CREATED","TRANSFERRING","INBOUNDING","OUTBOUNDING")
                         or cancel_reason in ("PO rejected on site (Quality issue)","","Supplier non fulfillment","AUTO CANCELLED"))
),
open_posto AS 
(
        select 
        global_entity_id,
        dmart_imt_warehouse_uuid,
        sku,
        po_created_at_local as week,
        sum(ifnull(ordered_qty,0) - ifnull(delivered_qty,0)) as open_posto,
        sum( if (order_type ="po",ifnull(ordered_qty,0) - ifnull(delivered_qty,0),0)) as open_po
        from(

                SELECT *
                FROM(

                            SELECT * FROM inflow_sto
                            UNION ALL 
                            SELECT * FROM inflow_po
                    )
                where status not in ("done","COMPLETED","Partially Inbounded","Done","partially_inbounded","PARTIALLY_INBOUNDED","CANCELED"
                                        ,"CANCELLATION","PENDING","cancellation_requested","rejected","REJECTED","canceled","pending")
        )
        where po_created_at_local >>= date_sub(date_trunc(current_date(),isoweek), interval 3 week)
        group by 1,2,3,4
),
inflow_all AS 
(
                SELECT *
                FROM(

                            SELECT * FROM inflow_sto
                            UNION ALL 
                            SELECT * FROM inflow_po
                    )
),
first_inbound_date as 
(       select
        global_entity_id,
        dmart_imt_warehouse_uuid,
        sku,
        min(po_fulfilled_at_local ) as first_inbound_date,
        min(ordered_qty ) as MOQ
        from inflow_all
        where status in ("done","COMPLETED","Partially Inbounded","Done","partially_inbounded","PARTIALLY_INBOUNDED")
        group by 1,2,3
),
product_status as
(
        select 
        a.global_entity_id,
        a.dmart_imt_warehouse_uuid,
        a.sku,
        a.week,
        sum(if((date_diff(a.week,b.week,day) between 0 and 28 ),ifnull(b.sales_qty,0),0)) as sale_last28d,
        from pd a 
        LEFT JOIN co b
        ON a.global_entity_id=b.global_entity_id and a.sku=b.sku and a.dmart_imt_warehouse_uuid=b.dmart_imt_warehouse_uuid 
        group by 1,2,3,4
),
SALES_BRACKET_dmart AS 
    (
     SELECT 
                global_entity_id,
                dmart_imt_warehouse_uuid,
                week,  
                sku,          
        PERCENT_RANK() over (PARTITION BY  global_entity_id,dmart_imt_warehouse_uuid,week ORDER BY sale_last28d DESC  ) AS sales_qty_brackets,
        from product_status where sale_last28d>>0-- must have, otherwise no D bracket 
    ),
SALES_BRACKET_ENTITY AS 
    (
     SELECT 
                global_entity_id,
                week,  
                sku,          
        PERCENT_RANK() over (PARTITION BY  global_entity_id,week ORDER BY sale_last28d DESC  ) AS sales_qty_brackets_ENTITY,
        from product_status where sale_last28d>>0-- must have, otherwise no D bracket 
    ),
SALES_BRACKET AS 
    (
     SELECT 
        a.global_entity_id,
        a.dmart_imt_warehouse_uuid,
        a.sku,
        a.week,
        a.sale_last28d,
        max(sales_qty_brackets_entity) AS sales_qty_brackets_entity,
        max(sales_qty_brackets) AS sales_qty_brackets,
        from product_status a
        left join SALES_BRACKET_dmart j
        on a.global_entity_id=j.global_entity_id and  a.dmart_imt_warehouse_uuid=j.dmart_imt_warehouse_uuid and  a.sku=J.sku  
        AND a.week=j.week
        left join SALES_BRACKET_entity l
        on a.global_entity_id=l.global_entity_id  and  a.sku=l.sku AND a.week=L.week
        group by 1,2,3,4,5
    ),
rp_frq as 
(
        select 
        global_entity_id,
        dmart_imt_warehouse_uuid,
        sku,
        po_fulfilled_at_local as week,
        sum(ifnull(delivered_qty,0)-ifnull(returned_quantity,0)) as inbound_qty,--order_type ="po"
        sum(if(order_type ="po",ifnull(delivered_qty,0)-ifnull(returned_quantity,0),0)) as po_received_qty,
        count(distinct if (status in ("done","COMPLETED","Partially Inbounded","Done","partially_inbounded","PARTIALLY_INBOUNDED"), po_fulfilled_at_local,null)) as rp_frq, 
        avg(if (status in ("done","COMPLETED","Partially Inbounded","Done","partially_inbounded","PARTIALLY_INBOUNDED"),lt_po,null)) as lead_time,
        avg(if (status in ("done","COMPLETED","Partially Inbounded","Done","partially_inbounded","PARTIALLY_INBOUNDED"),delay_days,null)) as delay_days,
        avg(fr) as fill_rate
        from inflow_all
        where po_fulfilled_at_local >>= date_sub(date_trunc(current_date(),isoweek), interval 3 week)
        group by 1,2,3,4
),
supplier_okr as 
(
        select 
        global_entity_id,
        dmart_imt_warehouse_uuid,
        sku,
        po_fulfilled_at_local as week,
        count(distinct if (status in ("done","COMPLETED","Partially Inbounded","Done","partially_inbounded","PARTIALLY_INBOUNDED"), po_fulfilled_at_local,null)) as rp_frq, 
        avg(if (status in ("done","COMPLETED","Partially Inbounded","Done","partially_inbounded","PARTIALLY_INBOUNDED"),lt_po,null)) as lead_time,
        avg(if (status in ("done","COMPLETED","Partially Inbounded","Done","partially_inbounded","PARTIALLY_INBOUNDED"),delay_days,null)) as delay_days,
        avg(fr) as fill_rate
        from inflow_all
        where po_fulfilled_at_local >>= date_sub(date_trunc(current_date(),month), interval 1 month)
        and source_type="supplier" 
        group by 1,2,3,4
),
sku_supplier_okr as 
(
        select 
        global_entity_id,
        sku,
        po_fulfilled_at_local as week,
        count(distinct if (status in ("done","COMPLETED","Partially Inbounded","Done","partially_inbounded","PARTIALLY_INBOUNDED"), po_fulfilled_at_local,null)) as rp_frq, 
        avg(if (status in ("done","COMPLETED","Partially Inbounded","Done","partially_inbounded","PARTIALLY_INBOUNDED"),lt_po,null)) as lead_time,
        avg(if (status in ("done","COMPLETED","Partially Inbounded","Done","partially_inbounded","PARTIALLY_INBOUNDED"),delay_days,null)) as delay_days,
        avg(fr) as fill_rate
        from inflow_all
        where po_fulfilled_at_local >>= date_sub(date_trunc(current_date(),month), interval 1 month)
        and source_type="supplier" 
        group by 1,2,3
),

external_supplier as --z
     (
        select * from 
       (
        select *except(po_fulfilled_at_local), 
        row_number() over (partition by global_entity_id,dmart_imt_warehouse_uuid,sku order by po_fulfilled_at_local desc ) as rp_rank
                from (
                        select 
                        global_entity_id,
                        dmart_imt_warehouse_uuid,
                        sku,
                        source_name,
                        po_fulfilled_at_local
                        from inflow_all 
                        where source_type="supplier" 
                        and po_fulfilled_at_local >>= date_sub(date_trunc(current_date(),month), interval 2 month)
                )
        )
       where rp_rank=1   
     ),
external_Source as --bb
     (
        select * from 
       (
          select *except(po_fulfilled_at_local), 
        row_number() over (partition by global_entity_id,sku order by po_fulfilled_at_local desc ) as rp_rank
                from (
                        select 
                        global_entity_id,
                        sku,
                        source_name,
                        po_fulfilled_at_local
                        from inflow_all 
                        where source_type="supplier" 
                )
        )
       where rp_rank=1   
     ),
DC_source as --aa 
     (
       select * from 
       (
            select 
            global_entity_id,
            dmart_imt_warehouse_uuid,
            sku,
            source_name,
            source_type,
            row_number() over (partition by global_entity_id,dmart_imt_warehouse_uuid,sku order by po_fulfilled_at_local desc ) as rp_rank
            from inflow_all 
            where source_type="DC" 
       )
       where rp_rank=1 
     ),
report as
(
        select 
        a.* except(dmart_imt_warehouse_uuid,dmart_supplier_name,is_dc_original,private_label,dmart_status),-- pd
        b.* except(global_entity_id,sku,dmart_imt_warehouse_uuid,week,sales_day),--co
        c.* except(global_entity_id,sku,dmart_imt_warehouse_uuid,week),--shnk
        d.* except(global_entity_id,sku,dmart_imt_warehouse_uuid,week,stock_local),--stock
        e.* except(global_entity_id,sku,dmart_imt_warehouse_uuid,current_stock_value),--stock_date-current-stock
        f.* except(global_entity_id,sku,dmart_imt_warehouse_uuid,week,quantity_past28days),--avl
        k.* except(global_entity_id,sku,dmart_imt_warehouse_uuid,week),--rp_frq --received po/sto
        dmart_type,
        case
                             WHEN dmart_type = "Store" and sales_qty_brackets <<=0.05  THEN "S"
                             WHEN dmart_type = "Store" and sales_qty_brackets <<=0.25 THEN "A"
                             WHEN dmart_type = "Store" and sales_qty_brackets  <<=0.5 THEN "B"
                             WHEN dmart_type = "Store" and sales_qty_brackets <<=0.75 THEN "C"
                             WHEN dmart_type = "Store" and sales_qty_brackets <<=1 THEN "D"
                             WHEN dmart_type = "DC" and sales_qty_brackets_entity <<=0.05  THEN "S"
                            WHEN dmart_type = "DC" and sales_qty_brackets_entity <<=0.25 THEN "A"
                            WHEN dmart_type = "DC" and sales_qty_brackets_entity  <<=0.5 THEN "B"
                            WHEN dmart_type = "DC" and sales_qty_brackets_entity <<=0.75 THEN "C"
                            WHEN dmart_type = "DC" and sales_qty_brackets_entity <<=1 THEN "D"                      
                             else "D"
                              END
                AS sales_bracket,
        case 
                when is_dc_original is not null then is_dc_original            
                when AA.source_type ="DC" then TRUE
                else false
        end 
        as is_dc_original,
        case 
                WHEN dmart_supplier_name NOT like "To Be used%" and  dmart_supplier_name
                   not like "to be used%" and dmart_supplier_name not like "Pandamart%" and  dmart_supplier_name
                    not like "pandamart%"and  dmart_supplier_name not like "virtual%" and  dmart_supplier_name
                      not like "%virtual%" and dmart_supplier_name not like "%Virtual%" and  dmart_supplier_name
                       not like "%Pandamart%" and dmart_supplier_name not like "%pandamart%" and  dmart_supplier_name
                       not like"%Delivery Hero Philippines%"  and dmart_supplier_name not like "%DC%" 
                        and dmart_supplier_name not like "%Distribution%"
                        and dmart_supplier_name is not null
                       THEN dmart_supplier_name
                when z.source_name is not null then z.source_name
                when bb.source_name is not null  then bb.source_name
                else bb.source_name
        end 
        as dmart_supplier_name, 
        stock_local*fx as stock_Eur,
        current_stock_value*fx as current_stock_Eur,
        sale_last28d,
       case 
         when private_label is not null then "private_label"
              else "not_private_label"
      end 
         as  private_label,
        first_inbound_date,
        MOQ,
        case 
            when h.lead_time is not null then h.lead_time
            else i.lead_time
        end 
        as  sup_LT,
         case 
            when h.fill_rate is not null then h.fill_rate
            else i.fill_rate
        end 
        as  sup_FR,   
         case 
            when h.rp_frq is not null then h.rp_frq
            else i.rp_frq
        end 
        as sup_frq, 
        case 
            when h.delay_days is not null then h.delay_days
            else i.delay_days
        end 
        as sup_delay_days,
        open_posto,
        open_po,
        1 as sales_day,
        case 
            when dmart_type ="DC"  or  a.dmart_imt_warehouse_name  like "%Corporate%" or 
             a.dmart_imt_warehouse_name  like "%Business%" or a.dmart_imt_warehouse_name  like "%office%"
             or a.dmart_imt_warehouse_name  like "%Employee%" or  vendor_type = "b2b"
              then "Dmart_Active"
            else dmart_status
        end 
        as dmart_status,
            CASE 
            WHEN A.global_entity_id in ("FP_MM","FP_LA","FP_KH") THEN 0
            ELSE quantity_past28days
            END AS 
            quantity_past28days
from pd a 
left join co b 
on a.global_entity_id = b.global_entity_id and a.dmart_imt_warehouse_uuid=b.dmart_imt_warehouse_uuid and  a.sku=b.sku  and  a.week=b.week
left join shnk c 
on a.global_entity_id = c.global_entity_id and a.dmart_imt_warehouse_uuid=c.dmart_imt_warehouse_uuid and  a.sku=c.sku  and  a.week=c.week
left join stock d
on a.global_entity_id = d.global_entity_id and a.dmart_imt_warehouse_uuid=d.dmart_imt_warehouse_uuid and  a.sku=d.sku  and  a.week=d.week
left join stock_date e
on a.global_entity_id = e.global_entity_id and a.dmart_imt_warehouse_uuid=e.dmart_imt_warehouse_uuid and  a.sku=e.sku  
left join avl f
on a.global_entity_id = f.global_entity_id and a.dmart_imt_warehouse_uuid=f.dmart_imt_warehouse_uuid and  a.sku=f.sku  and  a.week=f.week
LEFT JOIN external_supplier  z
on a.global_entity_id = z.global_entity_id and a.sku=z.sku and a.dmart_imt_warehouse_uuid=z.dmart_imt_warehouse_uuid
LEFT JOIN DC_source  AA
on a.global_entity_id = AA.global_entity_id and a.dmart_imt_warehouse_uuid=AA.dmart_imt_warehouse_uuid and  a.sku=AA.sku 
LEFT JOIN external_Source  BB
on a.global_entity_id = BB.global_entity_id and a.sku=BB.sku 
LEFT JOIN supplier_okr h 
on a.global_entity_id = h.global_entity_id and a.dmart_imt_warehouse_uuid=h.dmart_imt_warehouse_uuid and  a.sku=h.sku AND a.week=h.week
LEFT JOIN sku_supplier_okr i
on a.global_entity_id = i.global_entity_id and  a.sku=i.sku AND a.week=i.week
LEFT JOIN rp_frq k 
on a.global_entity_id = k.global_entity_id and a.dmart_imt_warehouse_uuid=k.dmart_imt_warehouse_uuid and  a.sku=k.sku 
AND a.week=k.week
LEFT JOIN fx l
on a.global_entity_id = l.global_entity_id AND a.week=l.week
left join SALES_BRACKET j
on a.global_entity_id=j.global_entity_id and  a.dmart_imt_warehouse_uuid=j.dmart_imt_warehouse_uuid and  a.sku=j.sku  AND a.week=j.week
LEFT JOIN warehouses_master m
on a.global_entity_id = m.global_entity_id and a.dmart_imt_warehouse_uuid=m.dmart_imt_warehouse_uuid
LEFT JOIN first_inbound_date n
on a.global_entity_id = n.global_entity_id and a.dmart_imt_warehouse_uuid=n.dmart_imt_warehouse_uuid and  a.sku=n.sku 
LEFT JOIN open_posto o
on a.global_entity_id = o.global_entity_id and a.dmart_imt_warehouse_uuid=o.dmart_imt_warehouse_uuid and  a.sku=o.sku 
AND a.week=o.week
) 
select * 
from REPORT 
where  date_DIFF(current_date(),WEEK, day) BETWEEN 1 AND 14
and (ifnull(shnk_qty,0)<<>>0 OR (ifnull(quantity_past28days,0)+ifnull(stock_qty,0))>>0)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <shared-views>
    <shared-view name='federated.0z136u01h6on6y14z16lw06aoi3c'>
      <datasources>
        <datasource caption='agg MTH' name='federated.0z136u01h6on6y14z16lw06aoi3c' />
      </datasources>
      <datasource-dependencies datasource='federated.0z136u01h6on6y14z16lw06aoi3c'>
        <column caption='DATE' datatype='string' name='[Calculation_133559925789224968]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='STR([week])' />
        </column>
        <column caption='sales_buffer_range' datatype='string' name='[Calculation_1369094320170504203]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [sales_buffer]&gt;10 then &quot;Current sales buffer &gt;10&quot; &#10;ELSEIF [sales_buffer]&gt;0 then &quot;Current sales buffer &gt;0&quot; &#10;ELSEIF [wkly_sales_buffer]&gt;0 then &quot;wkly sales buffer &gt;0&quot; &#10;else &quot;No sales buffer&quot;&#10;END' />
        </column>
        <column caption='Wrong_status' datatype='string' name='[Calculation_207447111442825228]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if  IFNULL([current_stock],0)&gt;0 and [sku_status]=&quot;RETIRED&quot; then &quot;Retired_with_stock&quot;&#10;ELSE &quot;no&quot;&#10;end' />
        </column>
        <column caption='Sku_age' datatype='string' name='[Calculation_236931623743795202]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [Calculation_236931623742623744]&gt;90 then &quot;sku_age&gt;90&quot;&#10;ELSEif [Calculation_236931623742623744]&gt;30 then &quot;90&gt;=sku_age&gt;30&quot;&#10;ELSE &quot;30&gt;=sku_age&gt;0&quot;&#10;end' />
        </column>
        <column caption='Source' datatype='string' name='[Calculation_4328662981200150546]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='STR(if [dmart_type] =&quot;DC&quot; THEN &quot;DC&quot;&#10;ELSE &quot;Supplier&quot;&#10;END)' />
        </column>
        <column caption='SHNK_Review' datatype='string' name='[Calculation_482166691207942144]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [shnk_eur_all]&lt;0 and ifnull([review_sale_qty (copy)_481111160282615809],0)&lt;=0 AND [sku_status]=&quot;RETIRED&quot; THEN &quot;NoSale_28d_retired&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([review_sale_qty (copy)_481111160282615809],0)&lt;=0  THEN &quot;NoSale_28d_not_retired&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([Calculation_481111160282329088],0)&lt;=0 AND [sku_status]=&quot;RETIRED&quot; then &quot;NoSale_7d_retired&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([Calculation_481111160282329088],0)&lt;=0  then &quot;NoSale_7d_not_retired&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([review_sale_qty (copy)_481111160282615809],0)&lt;30 and [category_zero]=&quot;Fresh &amp; Ultra Fresh&quot; then &quot;Slow Moving&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([review_sale_qty (copy)_481111160282615809],0)&lt;5 and [category_zero]=&quot;Ambient&amp;Frozen&quot; then &quot;Slow Moving&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([MOQ],0)&gt;0.25*ifnull([review_sale_qty (copy)_481111160282615809],0) and [MOQ]&gt;3 then &quot;High_MOQ&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([inbound_qty],0)&gt;1.2*ifnull([Calculation_481111160282329088],0) then &quot;High_inbound&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([stock_qty],0)&gt;1.2*ifnull([Calculation_481111160282329088],0) then &quot;High_SOH&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([sup_LT],0)&gt;4 then &quot;LeadTime&gt;4d&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([sup_frq],0)*7/[sales_day]&lt;2 then &quot;DeliveryFrq&lt;2&quot;&#10;ELSEIF [shnk_Eur_expired]&lt;0 and [wkly_sales_buffer]&gt;1 and [sales_buffer]&gt;1 then &quot;Sales_buffer&gt;1&quot;&#10;ELSEIF [shnk_Eur_expired]&lt;0 and [wkly_sales_buffer]&gt;1 and [sales_buffer]&lt;1 then &quot;Sales_buffer_current=0&quot;&#10;ELSEIF [shnk_eur_all]/[COGS_Eur]&lt;0.35 and [Calculation_236931623742623744]&lt;90 then &quot;High_shnk_new_sku&quot;&#10;ELSEIF [shnk_eur_all]/[COGS_Eur]&lt;0.35 then &quot;High_shnk_mature_sku&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([delay_days],0)&gt;1 then &quot;Delay&gt;1d&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([sup_FR],0)&lt;0.75 then &quot;SupplierFR&lt;0.75&quot;&#10;&#10;end' />
        </column>
        <column caption='Yesterday Stock' datatype='string' name='[Calculation_482166691213197313]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [current_stock]&gt;0 then &quot;&gt;0&quot;&#10;ELSE &quot;OOS&quot;&#10;END' />
        </column>
        <column caption='Discount_Percent' datatype='string' name='[Calculation_542824554313408513]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [disc_per]&gt;=0.5 then &quot;Disc&gt;=50%&quot;&#10;ELSEIF [disc_per]&gt;0 then &quot;Disc&gt;0 and &lt;50%&quot;&#10;else &quot;no disc&quot;&#10;end' />
        </column>
        <column caption='Selling_last_28d' datatype='boolean' name='[Calculation_598556600797831170]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [sale_last28d]&gt;0 then TRUE&#10;ELSE FALSE&#10;END' />
        </column>
