    <worksheet name='SK_K'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Suppliers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='agg MTH' name='federated.0z136u01h6on6y14z16lw06aoi3c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Shrinkage_Reason' datatype='string' name='[SWA/AVL Option (copy)_2243074127738036224]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;(not shnk)Other&quot;' value='(not shnk)Other' />
                <alias key='&quot;(not shnk)Supplier Return&quot;' value='(not shnk)Supplier Return' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0z136u01h6on6y14z16lw06aoi3c'>
            <column caption='% to Entity GFV' datatype='real' default-format='p0.00%' name='[% to APAC GFV (copy)_133559925803384845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GFV_Eur]/{ FIXED week,[global_entity_id]:sum([GFV_Eur])}' />
            </column>
            <column caption='% to Entity SHNK' datatype='real' default-format='p0.00%' name='[% to APAC SHNK (copy)_133559925803532302]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2243074127740084225]/{ FIXED [Calculation_133559925789224968],[global_entity_id]:sum([Calculation_2243074127740084225])}' />
            </column>
            <column caption='Djini%' datatype='real' default-format='p0.00%' name='[% to APAC SHNK (copy)_207447111442124811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([djini_qty])/sum([sales_qty])' />
            </column>
            <column caption='ENTITY GFV' datatype='real' name='[APAC GFV (copy)_1513279902447767553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [week],[global_entity_id]:SUM([GFV_Eur])}' />
            </column>
            <column datatype='real' default-format='p0.0%' name='[AVL]' role='measure' type='quantitative' />
            <column datatype='real' default-format='c&quot; €&quot;#,##0;-&quot; €&quot;#,##0' name='[COGS_Eur]' role='measure' type='quantitative' />
            <column caption='DATE' datatype='string' name='[Calculation_133559925789224968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([week])' />
            </column>
            <column caption='sales_buffer_range' datatype='string' name='[Calculation_1369094320170504203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [sales_buffer]&gt;10 then &quot;Current sales buffer &gt;10&quot; &#10;ELSEIF [sales_buffer]&gt;0 then &quot;Current sales buffer &gt;0&quot; &#10;ELSEIF [wkly_sales_buffer]&gt;0 then &quot;wkly sales buffer &gt;0&quot; &#10;else &quot;No sales buffer&quot;&#10;END' />
            </column>
            <column caption='from DC ' datatype='string' name='[Calculation_1392104924607217666]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_dc_original] then &quot;Source-DC&quot;&#10;ELSE &quot;Source-NOT_DC&quot;&#10;END' />
            </column>
            <column caption='SHNK%ALL' datatype='real' default-format='p0.00%' name='[Calculation_172614577454415872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if avg([Calculation_412853472245948422]) &gt;=1 and min({ FIXED [week],[sku],[global_entity_id]:sum([GFV_Eur])}) &gt;0 THEN SUM([Calculation_2243074127740084225]/{ FIXED [week],[sku],[global_entity_id]:sum([GFV_Eur])})&#10;ELSEIF sum([GFV_Eur])&gt;0 THEN SUM([Calculation_2243074127740084225])/SUM([GFV_Eur])&#10;ELSEIF  sum([sales_qty])&gt;0 then  sum([shnk_qty])/sum([sales_qty])&#10;ELSEIF SUM([Calculation_2243074127740084225])&lt;0 THEN -1&#10;end' />
            </column>
            <column caption='Wrong_status' datatype='string' name='[Calculation_207447111442825228]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  IFNULL([current_stock],0)&gt;0 and [sku_status]=&quot;RETIRED&quot; then &quot;Retired_with_stock&quot;&#10;ELSE &quot;no&quot;&#10;end' />
            </column>
            <column caption='SHNK_Eur_ALL' datatype='real' default-format='c&quot; €&quot;#,##0;-&quot; €&quot;#,##0' name='[Calculation_2243074127740084225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;All&quot; then [shnk_eur_all]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;Damaged&amp;Expired&quot; then [shnk_Eur_damaged]+[shnk_Eur_expired]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;all except putaway&quot; then [shnk_eur_all]-[shnk_eur_putaway]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;Damaged&quot; then [shnk_Eur_damaged]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;Expired&quot; then [shnk_Eur_expired]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;putaway&quot; then [shnk_eur_putaway]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;IST&quot; then [shnk_Eur_ist]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;Stock Add/Subtract&quot; then [shnk_Eur_stock_sub_add]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;Store Transfer Add/Subtract&quot; then [shnk_Eur_store_transfer]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;Customer Replacement&quot; then [shnk_Eur_customerReplacment]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;Cycle Count&quot; then [shnk_Eur_cyclecount]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;(not shnk)Other&quot; then [Other_Eur]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;(not shnk)Supplier Return&quot; then [shnk_Eur_SupplierReturn]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;quality&quot; then [shnk_Eur_quality_issue]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;theft&quot; then [shnk_Eur_theft]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224] = &quot;Damage&amp;Expired&amp;Quality&quot; then [shnk_Eur_damaged]+[shnk_Eur_expired]+[shnk_Eur_quality_issue]&#10;ELSEIF [Parameters].[SWA/AVL Option (copy)_2243074127738036224]=&quot;quality&amp;expired&quot; then [shnk_Eur_expired]+[shnk_Eur_quality_issue]&#10;end' />
            </column>
            <column caption='SKU_AGE' datatype='integer' name='[Calculation_236931623742623744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&quot;day&quot;,[first_inbound_date],TODAY())' />
            </column>
            <column caption='Sku_age' datatype='string' name='[Calculation_236931623743795202]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_236931623742623744]&gt;90 then &quot;sku_age&gt;90&quot;&#10;ELSEif [Calculation_236931623742623744]&gt;30 then &quot;90&gt;=sku_age&gt;30&quot;&#10;ELSE &quot;30&gt;=sku_age&gt;0&quot;&#10;end' />
            </column>
            <column caption='LT_Supplier' datatype='real' name='[Calculation_4062106188791595008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN([sup_LT])' />
            </column>
            <column caption='Del_frq_supplier' datatype='integer' name='[Calculation_4062106188792000513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='max([sup_frq])' />
            </column>
            <column caption='FR_supplier' datatype='real' default-format='p0%' name='[Calculation_4062106188792160258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([sup_FR])' />
            </column>
            <column caption='DC check' datatype='integer' name='[Calculation_412853472245948422]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [dmart_type] =&quot;DC&quot; THEN 1&#10;ELSE 0 &#10;END' />
            </column>
            <column caption='Source' datatype='string' name='[Calculation_4328662981200150546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(if [dmart_type] =&quot;DC&quot; THEN &quot;DC&quot;&#10;ELSE &quot;Supplier&quot;&#10;END)' />
            </column>
            <column caption='sale_qty' datatype='integer' name='[Calculation_481111160282329088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [dmart_type]=&quot;DC&quot; THEN [Calculation_753719679880159239]&#10;ELSE [sales_qty]&#10;end' />
            </column>
            <column caption='SHNK_Review' datatype='string' name='[Calculation_482166691207942144]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [shnk_eur_all]&lt;0 and ifnull([review_sale_qty (copy)_481111160282615809],0)&lt;=0 AND [sku_status]=&quot;RETIRED&quot; THEN &quot;NoSale_28d_retired&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([review_sale_qty (copy)_481111160282615809],0)&lt;=0  THEN &quot;NoSale_28d_not_retired&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([Calculation_481111160282329088],0)&lt;=0 AND [sku_status]=&quot;RETIRED&quot; then &quot;NoSale_7d_retired&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([Calculation_481111160282329088],0)&lt;=0  then &quot;NoSale_7d_not_retired&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([review_sale_qty (copy)_481111160282615809],0)&lt;30 and [category_zero]=&quot;Fresh &amp; Ultra Fresh&quot; then &quot;Slow Moving&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([review_sale_qty (copy)_481111160282615809],0)&lt;5 and [category_zero]=&quot;Ambient&amp;Frozen&quot; then &quot;Slow Moving&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([MOQ],0)&gt;0.25*ifnull([review_sale_qty (copy)_481111160282615809],0) and [MOQ]&gt;3 then &quot;High_MOQ&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([inbound_qty],0)&gt;1.2*ifnull([Calculation_481111160282329088],0) then &quot;High_inbound&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([stock_qty],0)&gt;1.2*ifnull([Calculation_481111160282329088],0) then &quot;High_SOH&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([sup_LT],0)&gt;4 then &quot;LeadTime&gt;4d&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([sup_frq],0)*7/[sales_day]&lt;2 then &quot;DeliveryFrq&lt;2&quot;&#10;ELSEIF [shnk_Eur_expired]&lt;0 and [wkly_sales_buffer]&gt;1 and [sales_buffer]&gt;1 then &quot;Sales_buffer&gt;1&quot;&#10;ELSEIF [shnk_Eur_expired]&lt;0 and [wkly_sales_buffer]&gt;1 and [sales_buffer]&lt;1 then &quot;Sales_buffer_current=0&quot;&#10;ELSEIF [shnk_eur_all]/[COGS_Eur]&lt;0.35 and [Calculation_236931623742623744]&lt;90 then &quot;High_shnk_new_sku&quot;&#10;ELSEIF [shnk_eur_all]/[COGS_Eur]&lt;0.35 then &quot;High_shnk_mature_sku&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([delay_days],0)&gt;1 then &quot;Delay&gt;1d&quot;&#10;ELSEIF [shnk_eur_all]&lt;0 and ifnull([sup_FR],0)&lt;0.75 then &quot;SupplierFR&lt;0.75&quot;&#10;&#10;end' />
            </column>
            <column caption='Yesterday Stock' datatype='string' name='[Calculation_482166691213197313]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [current_stock]&gt;0 then &quot;&gt;0&quot;&#10;ELSE &quot;OOS&quot;&#10;END' />
            </column>
            <column caption='SHNK_Value_Range' datatype='string' name='[Calculation_542824554308501504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_2243074127740084225]&lt;=-500 then &quot;&gt;=€500&quot;&#10;ELSEIF [Calculation_2243074127740084225]&lt;=-100 then &quot;&gt;=€100&quot;&#10;elseif [Calculation_2243074127740084225]&lt;=-50 then &quot;&gt;=€50&quot;&#10;elseif [Calculation_2243074127740084225]&lt;0 then &quot;&lt;€50&quot;&#10;elseif [Calculation_2243074127740084225]=0 then &quot;no shnk&quot;&#10;elseif [Calculation_2243074127740084225]&gt;50 then &quot;Positvie&gt;50&quot;&#10;elseif [Calculation_2243074127740084225]&gt;0 then &quot;Positvie&gt;0&quot;&#10;ELSE &quot;no shnk&quot;&#10;end' />
            </column>
            <column caption='Discount_Percent' datatype='string' name='[Calculation_542824554313408513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [disc_per]&gt;=0.5 then &quot;Disc&gt;=50%&quot;&#10;ELSEIF [disc_per]&gt;0 then &quot;Disc&gt;0 and &lt;50%&quot;&#10;else &quot;no disc&quot;&#10;end' />
            </column>
            <column caption='Selling_last_28d' datatype='boolean' name='[Calculation_598556600797831170]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [sale_last28d]&gt;0 then TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='DOH' datatype='integer' datatype-customized='true' default-format='N' name='[Calculation_683984255920533504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&#10;if sum([COGS_Eur])&gt;0 and avg([Calculation_412853472245948422]) &lt;1 then sum([stock_Eur])/sum([COGS_Eur])*MAX([sales_day])&#10;elseif sum([GFV_Eur])&gt;0 and avg([Calculation_412853472245948422]) &lt;1 then sum([stock_Eur])/sum([GFV_Eur])*MAX([sales_day])&#10;elseif avg([Calculation_412853472245948422]) =1 and AVG([ENTITY COGS (copy)_2243074127829393422]) &gt;0 then sum([stock_Eur])*MAX([sales_day])/SUM([ENTITY COGS (copy)_2243074127829393422])&#10;elseif avg([Calculation_412853472245948422]) =1 and AVG([APAC GFV (copy)_1513279902447767553]) &gt;0 then sum([stock_Eur])*MAX([sales_day])/SUM([APAC GFV (copy)_1513279902447767553])&#10;elseif avg([Calculation_412853472245948422]) =1 and AVG([Calculation_753719679880159239]) &gt;0 then sum([stock_Eur])*MAX([sales_day])/AVG([Calculation_753719679880159239])&#10;elseif  avg([Calculation_412853472245948422]) &lt;1 and sum([COGS_Eur])&lt;0 and sum([sales_qty])&gt;0 then sum([stock_qty])*MAX([sales_day])/MAX(sales_qty)&#10;elseif sum([stock_Eur])&gt;0 and sum([COGS_Eur])&lt;=0 then 99999&#10;elseif sum([stock_Eur])&lt;=0  then null&#10;end&#10;&#10;&#10;)' />
            </column>
            <column caption='Entity_Sales_Qty' datatype='integer' name='[Calculation_753719679880159239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id],[week],[sku]:sum([sales_qty])}' />
