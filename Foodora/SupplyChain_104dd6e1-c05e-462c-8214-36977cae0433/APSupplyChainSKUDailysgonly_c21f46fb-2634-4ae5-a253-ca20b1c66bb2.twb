            <column caption='Selling_last_28d' datatype='boolean' name='[Calculation_598556600797831170]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [sale_last28d]&gt;0 then TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='DOH' datatype='integer' datatype-customized='true' default-format='N' name='[Calculation_683984255920533504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&#10;if sum([COGS_Eur])&gt;0 and avg([Calculation_412853472245948422]) &lt;1 then sum([stock_Eur])/sum([COGS_Eur])*MAX([sales_day])&#10;elseif sum([GFV_Eur])&gt;0 and avg([Calculation_412853472245948422]) &lt;1 then sum([stock_Eur])/sum([GFV_Eur])*MAX([sales_day])&#10;elseif avg([Calculation_412853472245948422]) =1 and AVG([ENTITY COGS (copy)_2243074127829393422]) &gt;0 then sum([stock_Eur])*MAX([sales_day])/SUM([ENTITY COGS (copy)_2243074127829393422])&#10;elseif avg([Calculation_412853472245948422]) =1 and AVG([APAC GFV (copy)_1513279902447767553]) &gt;0 then sum([stock_Eur])*MAX([sales_day])/SUM([APAC GFV (copy)_1513279902447767553])&#10;elseif avg([Calculation_412853472245948422]) =1 and AVG([Calculation_753719679880159239]) &gt;0 then sum([stock_Eur])*MAX([sales_day])/AVG([Calculation_753719679880159239])&#10;elseif  avg([Calculation_412853472245948422]) &lt;1 and sum([COGS_Eur])&lt;0 and sum([sales_qty])&gt;0 then sum([stock_qty])*MAX([sales_day])/MAX(sales_qty)&#10;elseif sum([stock_Eur])&gt;0 and sum([COGS_Eur])&lt;=0 then 99999&#10;elseif sum([stock_Eur])&lt;=0  then null&#10;end&#10;&#10;&#10;)' />
            </column>
            <column caption='Entity_Sales_Qty' datatype='integer' name='[Calculation_753719679880159239]' role='measure' type='quantitative'>
