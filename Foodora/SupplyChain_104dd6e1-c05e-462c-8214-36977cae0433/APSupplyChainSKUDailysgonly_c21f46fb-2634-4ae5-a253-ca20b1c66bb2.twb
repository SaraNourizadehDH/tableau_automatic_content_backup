    <action caption='Filter10' name='[Action11_0DEF36848B294137ACEAE0C4585C2868]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Shrinkage' type='sheet' worksheet='s_e' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='s_e' />
        <param name='special-fields' value='all' />
