              <calculation class='tableau' formula='if avg([Calculation_412853472245948422]) &gt;=1 THEN SUM([shnk_Eur_SC]/{ FIXED [week]:sum([GFV_Eur])})&#10;ELSEIF sum([GFV_Eur])&gt;0 THEN SUM([shnk_Eur_SC])/SUM([GFV_Eur])&#10;ELSEIF  sum([sales_qty])&gt;0 then  sum([shnk_qty])/sum([sales_qty])&#10;ELSEIF SUM([shnk_Eur_SC])&lt;0 THEN -1&#10;end' />
            </column>
            <column caption='SHNK% All' datatype='real' default-format='p0.00%' name='[SHNK% SC (copy)_4457719247021322245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if avg([Calculation_412853472245948422]) &gt;=1 THEN SUM([Calculation_2243074127740084225]/{ FIXED [week]:sum([GFV_Eur])})&#10;ELSEIF sum([GFV_Eur])&gt;0 THEN SUM([Calculation_2243074127740084225])/SUM([GFV_Eur])&#10;ELSEIF  sum([sales_qty])&gt;0 then  sum([shnk_qty])/sum([sales_qty])&#10;ELSEIF SUM([Calculation_2243074127740084225])&lt;0 THEN -1&#10;end' />
