            </column>
            <column caption='Select Parameter 2' datatype='string' name='[Select Parameter One (copy)_3200933482837991432]' param-domain-type='list' role='measure' type='nominal' value='&quot;Entity&quot;'>
              <calculation class='tableau' formula='&quot;Entity&quot;' />
            </column>
