            <column caption='DOH_current' datatype='integer' datatype-customized='true' default-format='N' name='[DOH (copy)_683984255924305921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&#10;if sum([COGS_Eur])&gt;0 and avg([Calculation_412853472245948422]) &lt;1 then sum([current_stock_Eur])/sum([COGS_Eur])*MAX([sales_day])&#10;&#10;elseif avg([Calculation_412853472245948422]) =1 then sum([current_stock_Eur])*MAX([sales_day])/AVG([ENTITY GFV (copy)_1369094320165883913])&#10;elseif sum([COGS_Eur])&lt;0 and sum([sales_qty])&gt;0 then sum([current_stock])*MAX([sales_day])/sum(sales_qty)&#10;&#10;ELSE 99999&#10;end&#10;&#10;&#10;)' />
