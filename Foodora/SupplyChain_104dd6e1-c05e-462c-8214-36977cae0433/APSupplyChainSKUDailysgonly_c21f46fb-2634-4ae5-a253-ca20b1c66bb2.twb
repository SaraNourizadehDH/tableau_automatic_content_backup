            <column caption='SWA Fresh' datatype='real' default-format='p0.0%' name='[SWA Zero (copy)_2243074127774695430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [SWA fresh AP (copy)_2243074127774580741]&gt;1 then [SWA Zero AP (copy)_2243074127774007299]&#10;&#10;ELSEif  [SWA fresh En (copy)_5379127581220265988]&gt;1 then [SWA fresh AP (copy)_2243074127774580741]&#10;else [SWA fresh En (copy)_5379127581220265988]&#10;&#10;end' />
            </column>
            <column caption='SWA fresh AP' datatype='real' default-format='p0.0%' name='[SWA Zero AP (copy)_2243074127774007299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1369094320068395012]/[Calculation_1369094320069718021]/ [sales_last28d_active_zero (copy)_542824554468339733]*[Calculation_753719679889555464])' />
            </column>
            <column caption='SWA fresh En' datatype='real' default-format='p0.0%' name='[SWA fresh AP (copy)_2243074127774580741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1369094320068395012]/[Calculation_1369094320069718021]/ [sales_last28d_active_fresh (copy)_2243074127774285828]*[Calculation_753719679889555464])' />
            </column>
            <column caption='SWA fresh dm' datatype='real' default-format='p0.0%' name='[SWA fresh En (copy)_5379127581220265988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1369094320068395012]/[Calculation_1369094320069718021]/ [sales_last28d_active_su_dmart (copy)_5379127581219811330]*[Calculation_753719679889555464])' />
