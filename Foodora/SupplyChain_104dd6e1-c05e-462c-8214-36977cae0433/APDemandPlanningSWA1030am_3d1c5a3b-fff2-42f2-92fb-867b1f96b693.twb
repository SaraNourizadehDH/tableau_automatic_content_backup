        <style>
          <style-rule element='cell'>
            <format attr='text-align' value='center' />
            <format attr='text-format' field='[federated.0cr44tk14etasv14va11j0z3jetw].[usr:Entity SWA (copy)_1254534036935667719:qk]' value='p0.0%' />
          </style-rule>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.0cr44tk14etasv14va11j0z3jetw].[usr:Entity SWA (copy)_1254534036935667719:qk]' palette='orange_blue_diverging_10_0' type='interpolated' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
