            <metadata-record class='column'>
              <remote-name>SWA</remote-name>
              <remote-type>5</remote-type>
              <local-name>[SWA]</local-name>
              <parent-name>[Extract]</parent-name>
              <remote-alias>SWA</remote-alias>
              <ordinal>7</ordinal>
              <family>Custom_SQL_Query</family>
              <local-type>real</local-type>
              <aggregation>Sum</aggregation>
              <approx-count>179294</approx-count>
              <contains-null>true</contains-null>
              <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_A1DE3536CEC741DCBF40524F89277063]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
            </metadata-record>
          </metadata-records>
        </connection>
      </extract>
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Singapore&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom_SQL_Query' id='_A1DE3536CEC741DCBF40524F89277063'>
            <properties context=''>
              <relation connection='bigquery.1mbyrn61dcty7919k5x2r1f1j45g' name='Custom_SQL_Query' type='text'><![CDATA[with
zero_mover_exclusion as 
(
        select * from `fulfillment-dwh-production.pandata_report.regional_apac_dmart__materialised_zero_mover_exclusion_gsheet` where sku is not null 
),
warehouses_master_temp AS 
(  
     SELECT   
                global_entity_id, 
                warehouse_id as dmart_imt_warehouse_uuid,
                CASE 
                          WHEN name like "Delivery Hero Stores (Bangladesh) Limited-%" THEN RIGHT(name,
                          BYTE_LENGTH(name)-42)
                          ELSE name
                          END
                  AS dmart_imt_warehouse_name,
                CASE 
                WHEN 
                warehouse_id="3e4c0cb7-bde7-4e9c-8e33-207bcec0b074" THEN "38618"
                ELSE CAST( distribution_center_supplier_id AS STRING )
                END 
                 AS dmart_dc_supplier_id,-- DC act as supplier, supplier id 
                if(is_distribution_center,"DC","Store") AS dmart_type,
        FROM `fulfillment-dwh-production.curated_data_shared_dmart.warehouses_v2` 
        WHERE (is_dmart or is_distribution_center)  
                AND warehouse_id IS NOT NULL 
                AND global_entity_id in ("FP_SG","FP_MY","FP_PK","FP_BD","FP_HK","FP_PH") 
        GROUP BY 1,2,3,4,5 -- dont add vendor code as sto doesnt have it 
),
warehouses_master AS 
(  
       SELECT   
                global_entity_id, 
                dmart_imt_warehouse_uuid,
                max(dmart_imt_warehouse_name) as dmart_imt_warehouse_name,
                max(dmart_dc_supplier_id) as dmart_dc_supplier_id ,
                min(dmart_type) as dmart_type         
        FROM warehouses_master_temp    
        GROUP BY 1,2
  ),
  inflow_sto AS 
(
            SELECT 
                cd.global_entity_id,
                cd.destination_warehouse_uuid AS dmart_imt_warehouse_uuid,
                aa.dmart_type AS dmart_type,
                cd.store_transfer_reference AS refer_code,
                cd.sku,
                origin_warehouse_wac_local as purchase_price,
                IFNULL(cd.requested_quantity,0)AS ordered_qty,
                if(cd.received_quantity<<0,0,cd.received_quantity) AS delivered_qty,
                0 as returned_quantity,
                ROUND(SAFE_DIVIDE(cd.received_quantity,cd.requested_quantity),2) AS fr,
                DATE(cd.created_at_local) AS po_created_at_local,
                DATE(cd.status_modified_at_local) AS po_fulfilled_at_local,
                if(date_diff(cd.status_modified_at_local,cd.created_at_local,day)=0,1,date_diff(cd.status_modified_at_local,cd.created_at_local,day))as lt_po,
                cd.origin_warehouse_name AS source_name,
                  case 
                when origin_warehouse_name like "%Toll Distribution%" or origin_warehouse_name like "%Distribution%"
                or origin_warehouse_name like "%DC%"or origin_warehouse_name like "%Platform%" THEN "DC"
                WHEN bc.dmart_type IS NULL THEN "supplier"
                ELSE bc.dmart_type END AS source_type,
                "sto" as order_type,
                latest_status as status   
        FROM `fulfillment-dwh-production.pandata_report.dmart__store_transfer_report` cd
            LEFT JOIN warehouses_master bc
                    ON cd.global_entity_id = bc.global_entity_id AND cd.origin_warehouse_uuid = bc.dmart_imt_warehouse_uuid
             LEFT JOIN warehouses_master aa
                        ON cd.global_entity_id = aa.global_entity_id AND cd.destination_warehouse_uuid = aa.dmart_imt_warehouse_uuid
        WHERE cd.global_entity_id in ("FP_SG","FP_MY","FP_TH","FP_PK","FP_BD","FP_TW","FP_HK","FP_PH")
                  and byte_length(store_transfer_reference) <<11
                    AND  latest_status not in ("CANCELED","CANCELLATION","PENDING","cancellation_requested","rejected","REJECTED","canceled","pending")  
                ),
inflow_po AS 
(
        SELECT
                ab.global_entity_id,
                ab.dmart_imt_warehouse_uuid,
                aa.dmart_type AS dmart_type,
                ab.reference_number AS refer_code,
                ab.sku,
                unit_cost_after_discount_without_vat_local as purchase_price,
                ab.ordered_quantity as ordered_qty, --- This can be 0!
                ab.delivered_quantity as delivered_qty,--this is the key 
                returned_quantity,
                ROUND(SAFE_DIVIDE(ab.delivered_quantity,ab.ordered_quantity),2) AS fr,
                DATE(ab.po_created_at_local) AS po_created_at_local,
                DATE(ab.po_fulfilled_at_local) AS po_fulfilled_at_local, -- format to yyyy-mm-dd format 
                if(date_diff(ab.po_fulfilled_at_local,ab.po_created_at_local,day)=0,1,date_diff(ab.expected_delivery_at_local,ab.po_created_at_local,day))as lt_po,
                ab.dmart_supplier_portal_supplier_name AS source_name,
               CASE
                   WHEN bc.dmart_type ="DC" OR ab.dmart_supplier_portal_supplier_name like "%E&Z DC%"
                   OR ab.dmart_supplier_portal_supplier_name like "%Toll Distribution%"
                   THEN "DC"
                   WHEN ab.dmart_supplier_portal_supplier_name like "To Be used%" or ab.dmart_supplier_portal_supplier_name 
                   like "to be used%" or ab.dmart_supplier_portal_supplier_name like "Pandamart%" or ab.dmart_supplier_portal_supplier_name 
                    like "pandamart%"or ab.dmart_supplier_portal_supplier_name  like "virtual%" or ab.dmart_supplier_portal_supplier_name 
                      like "%virtual%" or ab.dmart_supplier_portal_supplier_name like "%Virtual%" OR ab.dmart_supplier_portal_supplier_name 
                       like "%Pandamart%" OR ab.dmart_supplier_portal_supplier_name like "%pandamart%" or ab.dmart_supplier_portal_supplier_name 
                       like"%Delivery Hero Philippines%" THEN "Store"
                   ELSE ifnull(bc.dmart_type,"supplier")
                   END
               AS source_type,
                "po" as order_type,
                status_code as status                
        FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__purchase_order_line_report` ab -- take note, po lt can be improved along the way
            LEFT JOIN warehouses_master bc
                ON ab.global_entity_id = bc.global_entity_id AND ab.dmart_supplier_portal_supplier_id= bc.dmart_dc_supplier_id
            LEFT JOIN warehouses_master aa
                ON ab.global_entity_id = aa.global_entity_id AND ab.dmart_imt_warehouse_uuid= aa.dmart_imt_warehouse_uuid
        WHERE   ab.global_entity_id in ("FP_SG","FP_MY","FP_TH","FP_PK","FP_BD","FP_TW","FP_HK","FP_PH")
                 and byte_length(reference_number) <<11
                AND status_code not in ("CANCELED","CANCELLATION","PENDING","cancellation_requested","rejected","REJECTED","canceled","pending") 
),
inflow_all AS 
(
                SELECT *
                FROM(

                            SELECT * FROM inflow_sto
                            UNION ALL 
                            SELECT * FROM inflow_po
                    )
               where status in ("done","COMPLETED","Partially Inbounded","Done","partially_inbounded","PARTIALLY_INBOUNDED")
),
external_supplier as --c
     (
        select * from 
       (
        select *except(po_fulfilled_at_local), 
        row_number() over (partition by global_entity_id,dmart_imt_warehouse_uuid,sku order by po_fulfilled_at_local desc ) as rp_rank
                from (
                        select 
                        global_entity_id,
                        dmart_imt_warehouse_uuid,
                        sku,
                        source_name,
                        po_fulfilled_at_local
                        from inflow_all 
                        where source_type="supplier" 
                        and   date_DIFF(date(current_date()),date(po_fulfilled_at_local), DAY) BETWEEN 0 AND 30
                )
        )
       where rp_rank=1   
     ),
external_Source as --d
     (
        select * from 
       (
          select *except(po_fulfilled_at_local), 
        row_number() over (partition by global_entity_id,sku order by po_fulfilled_at_local desc ) as rp_rank
                from (
                        select 
                        global_entity_id,
                        sku,
                        source_name,
                        po_fulfilled_at_local
                        from inflow_all 
                        where source_type="supplier" 
                        and   date_DIFF(date(current_date()),date(po_fulfilled_at_local), DAY) BETWEEN 0 AND 30
                )
        )
       where rp_rank=1   
     ),

 product_report AS (
  select 
        global_entity_id,
        dmart_imt_warehouse_uuid, 
        sku,
        max(dmart_classification) as dmart_classification,
        max(dmart_imt_warehouse_name) as dmart_imt_warehouse_name,
        max(product_title_english) as product_title_english,
        max(category_english) as category_english,
        max(dmart_supplier_name ) as dmart_supplier_name,
        from( 
              SELECT
                prd.global_entity_id,
                prd.dmart_imt_warehouse_uuid,
                dmart_imt_warehouse_name,
                prd.category_english,
                prd.sku,
                prd.vendor_code,
                prd.vendor_name,
                prd.product_title_english,
                case 
                  WHEN dmart_supplier_name like "%E&Z DC%" 
                  or dmart_supplier_name like "%Toll Distribution%"or dmart_supplier_name like "To Be used%" or dmart_supplier_name 
                  like "to be used%" or dmart_supplier_name like "Pandamart%" or dmart_supplier_name 
                   like "pandamart%"or dmart_supplier_name like "virtual%" or dmart_supplier_name 
                     like "%virtual%" or dmart_supplier_name like "%Virtual%" OR dmart_supplier_name 
                      like "%Pandamart%" OR dmart_supplier_name like "%pandamart%" or dmart_supplier_name 
                      like"%Delivery Hero Philippines%"  THEN ifnull(c.source_name,d.source_name)
                else prd.dmart_supplier_name 
                end  
                as dmart_supplier_name,
                ifnull(cc.notes,"normal") as dmart_classification,  
              FROM `fulfillment-dwh-production.pandata_report.dmart__product_report` prd
               left join zero_mover_exclusion  cc on prd.global_entity_id=cc.global_entity_id and prd.dmart_imt_warehouse_name=cc.sku
                LEFT JOIN external_supplier c
                    ON prd.global_entity_id = c.global_entity_id  AND prd.sku=c.sku AND prd.dmart_imt_warehouse_uuid = c.dmart_imt_warehouse_uuid
                LEFT JOIN external_Source   d
                    ON prd.global_entity_id = d.global_entity_id  AND prd.sku=d.sku 
                WHERE prd.global_entity_id in ("FP_SG","FP_MY","FP_TH","FP_PK","FP_BD","FP_TW","FP_HK","FP_PH") 
                and vendor_name not in  ("pandamart (Serangoon Gardens)", "pandamart (Outram2)","pandamart (East Coast)",
                                "Pandamart (Danao)","pandamart (AMK - Serangoon Gardens)","pandamart (AMK - Night)",
                                "Nestle Ice Cream (Wattana)","BT TEST ACCOUNT - vg7v","pandaMV","pandamart (Tsing Yi)","Pandamart (Sai Ying Pun - Pick Up)","Pandamart (Fanling & Sheung Shui)",
                                "[not in use] pandamart (Sai Ying Pun - Pick Up)","[Do Not Use] Pandamart (Fanling & Sheung Shui)",
                                "panda multivert","PandaNow (Outram)") and vendor_name not like "%abite%" and 
                                vendor_name not like "%eckitt Health & Home Official Store%" 
                                --and a.vendor_name not like "%Testing%" and a.vendor_name not like "%Test%"   testing vendor might have inventory or sales
                                and vendor_name not like "%Extended Delivery%" and vendor_name not like "%ot in use%" 
                                and vendor_name not like "%o Not Use%" and vendor_name not like "%Multivert%" 
                                and  vendor_name not like "%multivert%" and vendor_name not like "%KJC%" 
                                and dmart_imt_warehouse_name not in 
("Pandamart - Shahdara (LHR)","Pandamart - Kharadhar (KHI)","Pandamart - Chaklala Scheme 3 (RWP)","Pandamart - Orangi Town (KHI)","Pandamart - DHA (KHI)","Pandamart - Nishtar Colony (LHR)","Pandamart - Landhi (KHI)","Pandamart Ramadan Mubarak (KHI)","Pandamart Ramadan Bazar Township (LHR)")
    )
    group by 1,2,3
), 
daily_sales as 
(
  select 
  global_entity_id, 
  sku,
  dmart_imt_warehouse_uuid,
  order_date_local,
  sum(received_quantity) as received_quantity,
  from `fulfillment-dwh-production.pandata_report.regional_apac_dmart__customer_order_line_report_v2`
  where global_entity_id in ("FP_SG","FP_MY","FP_PK","FP_BD","FP_HK","FP_PH") 
     and order_date_local>>  "2022-09-30"
  group by 1,2,3,4
),
availability as (
  SELECT
    date_local,
    sku,
    global_entity_id,
     dmart_imt_warehouse_uuid,
    SUM(ifnull(available_hours,0)) as avail_hours,
    SUM(ifnull(total_hours,0)) as total_hours,
    SUM(ifnull(quantity_past28days,0)) AS qty_28d,
    sum(ifnull(available_hours,0)) as hours_with_stock,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__availability_sku_report` a 
  WHERE date_diff(CURRENT_DATE(), date_local, DAY) BETWEEN 0 AND 56
    and date_local >> "2022-09-30"
    AND sku_status="ACTIVE"
    and vendor_type <<>> "b2b" 
  GROUP BY 1,2,3,4
), 
avl as (
  SELECT
    date_local,
    a.sku,
    a.global_entity_id,
    b.dmart_imt_warehouse_name,
    b.category_english,
    b.dmart_supplier_name as real_supplier,
    ifnull(avail_hours,0) as avail_hours,
    ifnull(total_hours,0) as total_hours,
    ifnull(qty_28d,0) AS qty_28d,
    ifnull(hours_with_stock,0) as hours_with_stock,
    ifnull(received_quantity,0) as daily_sales_qty,
  FROM availability a 
  left join  product_report b
  on a.global_entity_id=b.global_entity_id and a.dmart_imt_warehouse_uuid=b.dmart_imt_warehouse_uuid and a.sku=b.sku
  left join daily_sales c
  on a.global_entity_id=c.global_entity_id and a.dmart_imt_warehouse_uuid=c.dmart_imt_warehouse_uuid and a.sku=c.sku and a.date_local=c.order_date_local
  where dmart_classification="normal"
 
), 
combined_table as 
(

    SELECT
    date_local,
    sku,
    global_entity_id,
    dmart_imt_warehouse_name,
    category_english,
    real_supplier,
    hours_with_stock,
    daily_sales_qty,
    qty_28d,
    total_hours,
    safe_divide(hours_with_stock, total_hours) as sku_avail,
    SUM(qty_28d)
        OVER (PARTITION BY 
                date_local, 
                global_entity_id,
                dmart_imt_warehouse_name,
              category_english,
               real_supplier) AS sales_weight_warehouse_category_supplier,
  from avl
)
select* from (

  select
  date_local as date,
  global_entity_id,
  dmart_imt_warehouse_name as vendor_name,
  category_english as category,
  real_supplier,
  SUM(daily_sales_qty) as l28d_sales,
  SUM(qty_28d) as sales_weight_p28d,
  SUM(IFNULL(SAFE_DIVIDE(sku_avail*qty_28d, sales_weight_warehouse_category_supplier), 0)) as SWA
FROM combined_table
GROUP BY 1,2,3,4,5
) 
where sales_weight_p28d>>0]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <actions>
    <action caption='Filter 1 (generated)' name='[Action1]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='APAC SWA' type='sheet' worksheet='Entity - SWA - 2' />
      <command command='tsc:tsl-filter'>
        <param name='special-fields' value='all' />
        <param name='target' value='APAC SWA' />
      </command>
    </action>
  </actions>
  <worksheets>
    <worksheet name='Category - SWA - 2'>
      <table>
        <view>
          <datasources>
            <datasource caption='Combined Table - SWA' name='federated.0cr44tk14etasv14va11j0z3jetw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top X Categories' datatype='integer' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0cr44tk14etasv14va11j0z3jetw'>
            <column caption='Entity Category SWA' datatype='real' name='[Entity SWA (copy)_1254534036935667719]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([SWA] * [sales_weight_p28d])/AVG([Entity Total Sales Weight (copy)_1254534036924645378])' />
            </column>
            <column caption='Entity Category Total Sales Weight' datatype='integer' name='[Entity Total Sales Weight (copy)_1254534036924645378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [date], [global_entity_id], [category]: sum([sales_weight_p28d])}' />
            </column>
            <column datatype='real' name='[SWA]' role='measure' type='quantitative' />
            <column datatype='string' name='[category]' role='dimension' type='nominal' />
            <column caption='date range' datatype='date' name='[date (copy)_1254534036926484485]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[date]' />
            </column>
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Sales Unit' datatype='integer' name='[l28d_sales]' role='measure' type='quantitative' />
            <column-instance column='[category]' derivation='None' name='[none:category:nk]' pivot='key' type='nominal' />
            <column-instance column='[date (copy)_1254534036926484485]' derivation='None' name='[none:date (copy)_1254534036926484485:qk]' pivot='key' type='quantitative' />
            <column-instance column='[date]' derivation='None' name='[none:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_name]' derivation='None' name='[none:vendor_name:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[sales_weight_p28d]' role='measure' type='quantitative' />
            <column-instance column='[l28d_sales]' derivation='Sum' name='[sum:l28d_sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Entity SWA (copy)_1254534036935667719]' derivation='User' name='[usr:Entity SWA (copy)_1254534036935667719:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[vendor_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0cr44tk14etasv14va11j0z3jetw].[Action (date)]'>
            <groupfilter function='level-members' level='[date]' user:ui-action-filter='[Action1]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0cr44tk14etasv14va11j0z3jetw].[none:category:nk]'>
            <groupfilter count='[Parameters].[Parameter 2]' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([l28d_sales])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:category:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <computed-sort column='[federated.0cr44tk14etasv14va11j0z3jetw].[none:category:nk]' direction='DESC' using='[federated.0cr44tk14etasv14va11j0z3jetw].[sum:l28d_sales:qk]' />
          <filter class='quantitative' column='[federated.0cr44tk14etasv14va11j0z3jetw].[none:date (copy)_1254534036926484485:qk]' filter-group='3' included-values='all' />
          <filter class='quantitative' column='[federated.0cr44tk14etasv14va11j0z3jetw].[none:date:qk]' filter-group='4' included-values='all' />
          <filter class='categorical' column='[federated.0cr44tk14etasv14va11j0z3jetw].[none:global_entity_id:nk]' context='true' filter-group='9'>
            <groupfilter function='member' level='[none:global_entity_id:nk]' member='&quot;FP_PK&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0cr44tk14etasv14va11j0z3jetw].[none:vendor_name:nk]' context='true' filter-group='6'>
            <groupfilter function='level-members' level='[none:vendor_name:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.0cr44tk14etasv14va11j0z3jetw].[none:global_entity_id:nk]</column>
            <column>[federated.0cr44tk14etasv14va11j0z3jetw].[none:vendor_name:nk]</column>
            <column>[federated.0cr44tk14etasv14va11j0z3jetw].[none:category:nk]</column>
            <column>[federated.0cr44tk14etasv14va11j0z3jetw].[none:date (copy)_1254534036926484485:qk]</column>
