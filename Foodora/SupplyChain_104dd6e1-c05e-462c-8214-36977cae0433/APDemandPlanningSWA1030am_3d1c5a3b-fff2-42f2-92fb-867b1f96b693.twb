      <column caption='Entity Total Sales Weight' datatype='integer' name='[Calculation_1254534036924538881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date], [global_entity_id]: sum([sales_weight_p28d])}' />
      </column>
