    <worksheet name='Hourly- Overview'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' underline='true'>Hourly - Overview</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='lg_orders_ept' name='federated.0pjuqjb176e0sy1bdz9tj04e6f6l' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='On-Time Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EPT&quot;'>
              <calculation class='tableau' formula='&quot;EPT&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0pjuqjb176e0sy1bdz9tj04e6f6l'>
            <column caption='% On Time (Grace Time 5mins )' datatype='real' name='[% On Time (copy)_5284481643172098048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;EPT&quot; THEN SUM([total_is_on_time_ept_5min]) / SUM([total_order])&#10;WHEN &quot;Estimated Food is Ready&quot; THEN SUM([total_is_on_time_based_timestamp_5min]) / SUM([total_order])&#10;END' />
            </column>
            <column caption='% Stack' datatype='real' name='[% Split (copy)_4664181162996011013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_stack_order]) / SUM([total_order])' />
            </column>
            <column caption='% On Time' datatype='real' name='[Calculation_4664181162993512448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;EPT&quot; THEN SUM([total_is_on_time_ept]) / SUM([total_order])&#10;WHEN &quot;Estimated Food is Ready&quot; THEN SUM([total_is_on_time_based_timestamp]) / SUM([total_order])&#10;END' />
            </column>
            <column caption='Dmarts' datatype='integer' name='[Calculation_4664181162994130945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([warehouse_id])' />
            </column>
            <column caption='Date Granularity' datatype='datetime' name='[Calculation_4664181162995068931]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN [ordered_date_local]&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[ordered_date_local],&apos;monday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[ordered_date_local])&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;,[ordered_date_local])&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&apos;year&apos;,[ordered_date_local])&#10;END' />
            </column>
            <column caption='% Split' datatype='real' name='[Calculation_4664181162995859460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_split_order]) / SUM([total_order])' />
            </column>
            <column-instance column='[avg_ept_min]' derivation='Avg' name='[avg:avg_ept_min:qk]' pivot='key' type='quantitative' />
            <column-instance column='[avg_vendor_prep_time_min]' derivation='Avg' name='[avg:avg_vendor_prep_time_min:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[avg_ept_min]' role='measure' type='quantitative' />
            <column datatype='real' name='[avg_vendor_prep_time_min]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_preorder]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_split]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_stacked]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4664181162995068931]' derivation='None' name='[none:Calculation_4664181162995068931:qk]' pivot='key' type='quantitative' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_preorder]' derivation='None' name='[none:is_preorder:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_split]' derivation='None' name='[none:is_split:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_stacked]' derivation='None' name='[none:is_stacked:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_hour]' derivation='None' name='[none:order_hour:ok]' pivot='key' type='ordinal' />
            <column-instance column='[strategy]' derivation='None' name='[none:strategy:nk]' pivot='key' type='nominal' />
            <column-instance column='[warehouse_name]' derivation='None' name='[none:warehouse_name:nk]' pivot='key' type='nominal' />
            <column aggregation='Sum' datatype='integer' name='[order_hour]' role='dimension' type='ordinal' />
            <column datatype='date' name='[ordered_date_local]' role='dimension' type='ordinal' />
            <column-instance column='[total_order (copy)_767019379484700672]' derivation='Sum' name='[pcto:sum:total_order (copy)_767019379484700672:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.0pjuqjb176e0sy1bdz9tj04e6f6l].[order_hour]' ordering-type='Field' type='PctTotal' />
            </column-instance>
            <column datatype='string' name='[strategy]' role='dimension' type='nominal' />
            <column-instance column='[total_order]' derivation='Sum' name='[sum:total_order:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4664181162995068931]' derivation='ISO-Weekday-Trunc' name='[tiwd:Calculation_4664181162995068931:ok]' pivot='key' type='ordinal' />
            <column datatype='integer' name='[total_is_on_time_based_timestamp]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_is_on_time_based_timestamp_5min]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_is_on_time_ept]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_is_on_time_ept_5min]' role='measure' type='quantitative' />
            <column caption='total_order (copy)' datatype='integer' name='[total_order (copy)_767019379484700672]' role='measure' type='quantitative'>
