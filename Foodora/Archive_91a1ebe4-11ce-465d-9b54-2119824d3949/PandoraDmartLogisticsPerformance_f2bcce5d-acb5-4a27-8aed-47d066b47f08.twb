    <datasource caption='dmart_shrink_logistics' inline='true' name='federated.0fy8mst08i888r11nf6rk1oppi6c' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1p3lw650xlqlyj11v2yn91rgcmqp'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_curated' server-oauth='' username='usama.ahmed@foodpanda.pk' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1p3lw650xlqlyj11v2yn91rgcmqp' name='Custom SQL Query' type='text'><![CDATA[WITH lg_entities AS (
  -- to get rid of dp-* country_code duplicates
  -- and ensures that each entity id has one country iso
  SELECT DISTINCT
    platforms.entity_id AS id,
    lg_countries.country_iso
  FROM `fulfillment-dwh-production.curated_data_shared.countries` AS lg_countries,
  UNNEST(lg_countries.platforms) AS platforms
),

countries_timezone AS (
  SELECT
    country_code,
    country_iso,
    (SELECT timezone FROM UNNEST(cities) LIMIT 1) AS timezone  -- replicating global's logic to get timezone, from lg old tables
  FROM `fulfillment-dwh-production.curated_data_shared.countries`
),

warehouses_vendors AS (
  SELECT DISTINCT
    warehouses.global_entity_id,
    warehouses.warehouse_id,
    warehouses.name AS warehouse_name,
    vendors.platform_vendor_id,
    warehouses.is_dmart
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.warehouses_v2` AS warehouses
  LEFT JOIN UNNEST(vendors) AS vendors
),

dmart_wh AS ( -- Dmart WH zone and city ID
  SELECT
    shared_countries.global_entity_id,
    lg_entities.country_iso,
    warehouses_vendors.warehouse_id,
    warehouses_vendors.warehouse_name,
    vendor_zone.id AS lg_zone_id,
    delivery_area_locations.city_id AS lg_city_id,
    COUNT(DISTINCT vendor.vendor_code) AS total_vendors
  FROM `fulfillment-dwh-production.curated_data_shared.vendors_delivery_areas` AS vendor,
  UNNEST(vendor.zones) AS vendor_zone,
  UNNEST(vendor.delivery_areas_location) AS delivery_area_locations
  LEFT JOIN lg_entities
         ON lg_entities.id = vendor.entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON lg_entities.country_iso = shared_countries.country_code_iso
  LEFT JOIN warehouses_vendors
         ON warehouses_vendors.global_entity_id = shared_countries.global_entity_id
        AND warehouses_vendors.platform_vendor_id = vendor.vendor_code
  WHERE vendor.vertical_type = "darkstores"
    AND warehouses_vendors.warehouse_id IS NOT NULL
    AND vendor_zone.id IS NOT NULL
    AND delivery_area_locations.city_id IS NOT NULL
    AND warehouses_vendors.is_dmart
  GROUP BY
    shared_countries.global_entity_id,
    lg_entities.country_iso,
    warehouses_vendors.warehouse_id,
    warehouses_vendors.warehouse_name,
    vendor_zone.id,
    delivery_area_locations.city_id
),

chains AS ( -- Dmart chain information
  SELECT DISTINCT
    shared_countries.global_entity_id,
    vendor.chain.id AS chain_code,
    vendor.chain.name AS chain_name,
    TRUE AS is_dmart
  FROM `fulfillment-dwh-production.curated_data_shared.vendors_delivery_areas` AS vendor
  LEFT JOIN lg_entities
         ON lg_entities.id = vendor.entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON lg_entities.country_iso = shared_countries.country_code_iso
  WHERE vendor.vertical_type = "darkstores"
    AND vendor.chain.id IS NOT NULL
),

zones AS (
  SELECT
    country.country_code,
    city_zone.id || "_" || country.country_code AS lg_zone_uuid,
    city_zone.id AS zone_id,
    city_zone.name AS zone_name,
    city.id AS city_id,
    city.name AS city_name
  FROM `fulfillment-dwh-production.curated_data_shared.countries` AS country,
  UNNEST(country.cities) AS city,
  UNNEST(city.zones) AS city_zone
  WHERE city_zone.is_active
),

shrink_event AS (
  SELECT
  (
    delivery_areas_events.transaction_id || "_"
    || COALESCE(CAST(delivery_areas_events.end_transaction_id AS STRING), "") || "_"
    || delivery_areas_events.event_id || "_"
    || delivery_areas_events.country_code
  ) AS uuid,
    shared_countries.global_entity_id,
    shared_countries.name AS country_name,
    delivery_areas_events.country_code AS lg_country_code,
    DATE(delivery_areas_events.active_from, delivery_areas_events.timezone) AS date_local,
    EXTRACT(HOUR FROM DATETIME(delivery_areas_events.active_from, delivery_areas_events.timezone)) AS local_hour,
    delivery_areas_events.city.city_id AS lg_city_id,
    zones.city_name,
    delivery_areas_events.zone_id AS lg_zone_id,
    zones.zone_name,
    zones.lg_zone_uuid,
    delivery_areas_events.action AS action_type,
    delivery_areas_events.title,
    CASE
      WHEN delivery_areas_events.title LIKE "%1%" THEN 1
      WHEN delivery_areas_events.title LIKE "%2%" THEN 2
      WHEN delivery_areas_events.title LIKE "%3%" THEN 3
      WHEN delivery_areas_events.title LIKE "%4%" THEN 4
      WHEN delivery_areas_events.title LIKE "%5%" THEN 5
      WHEN delivery_areas_events.title LIKE "%0%" THEN 0
    END AS shrink_tier,
    delivery_areas_events.value AS final_drive_time_mins,
    DATETIME(delivery_areas_events.active_from, delivery_areas_events.timezone) AS active_from_local,
    DATETIME(delivery_areas_events.active_to, delivery_areas_events.timezone) AS active_to_local,
    SAFE_DIVIDE(DATETIME_DIFF(delivery_areas_events.active_to, delivery_areas_events.active_from, SECOND), 60) AS durations_mins,
    fil.key,
    fil.operator,
    fil_values,
    chains.chain_name,
    -- chain based inclusion logic
    IF(fil.key = "chains" AND fil.operator IN ("$in", "$is", "$all") AND chains.is_dmart, 1, NULL) AS is_dmart_chain_include,
    IF(fil.key = "chains" AND fil.operator IN ("$nin", "$not", "$nall") AND chains.is_dmart, 1, NULL) AS is_dmart_chain_exclude,
    -- vertical based inclusion logic
    IF(fil.key = "vertical_type" AND fil_values = "darkstores" AND fil.operator IN ("$in", "$is", "$all"), 1, NULL) AS is_dmart_vertical_include,
    IF(fil.key = "vertical_type" AND fil_values = "darkstores" AND fil.operator IN ("$nin", "$not", "$nall"), 1, NULL) AS is_dmart_vertical_exclude,
    -- rider based inclusion logic
    IF(fil.key = "delivery_types" AND fil_values = "OWN_DELIVERY" AND fil.operator IN ("$in", "$is", "$all"), 1, NULL) AS is_rider_delivery_include
  FROM `fulfillment-dwh-production.curated_data_shared.delivery_areas_events` AS delivery_areas_events,
  UNNEST(delivery_areas_events.filters) AS fil,
  UNNEST(fil.values) AS fil_values
  LEFT JOIN countries_timezone
         ON delivery_areas_events.country_code = countries_timezone.country_code
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON countries_timezone.country_iso = shared_countries.country_code_iso
  LEFT JOIN chains
         ON chains.global_entity_id = shared_countries.global_entity_id
        AND chains.chain_code = fil_values
  LEFT JOIN zones
         ON zones.zone_id = delivery_areas_events.zone_id
        AND zones.country_code = delivery_areas_events.country_code
  WHERE delivery_areas_events.created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH), MONTH)
    AND delivery_areas_events.is_active
    AND LOWER(delivery_areas_events.action) IN ("shrink", "close")
    AND fil.values IS NOT NULL
)

SELECT
  shrink_event.uuid,
  shrink_event.global_entity_id,
  shrink_event.country_name,
  shrink_event.lg_country_code,
  shrink_event.date_local,
  shrink_event.local_hour,
  shrink_event.lg_city_id,
  shrink_event.city_name,
  shrink_event.lg_zone_id,
  shrink_event.zone_name,
  shrink_event.action_type,
  shrink_event.title,
  shrink_event.shrink_tier,
  shrink_event.final_drive_time_mins,
  dmart_wh.warehouse_id,
  dmart_wh.warehouse_name,
  shrink_event.active_from_local,
  shrink_event.active_to_local,
  shrink_event.durations_mins,
  SUM(shrink_event.is_rider_delivery_include) AS rider_delivery_include,
  SUM(shrink_event.is_dmart_chain_include) AS dmart_chain_include,
  SUM(shrink_event.is_dmart_vertical_include) AS dmart_vertical_include,
  SUM(shrink_event.is_dmart_chain_exclude) AS dmart_chain_exclude,
  SUM(shrink_event.is_dmart_vertical_exclude) AS dmart_vertical_exclude,
  IFNULL(LOGICAL_OR(
    shrink_event.is_dmart_vertical_exclude >>= 1
    OR shrink_event.is_dmart_chain_exclude >>= 1
    OR shrink_event.is_dmart_chain_include << 1
    OR shrink_event.is_dmart_vertical_include << 1
    ), FALSE) AS final_exclude_dmart,
  IF(LOGICAL_OR(
    shrink_event.is_dmart_vertical_exclude >>= 1
    OR shrink_event.is_dmart_chain_exclude >>= 1
    OR shrink_event.is_dmart_chain_include << 1
    OR shrink_event.is_dmart_vertical_include << 1
    ), 0, ANY_VALUE(ROUND(shrink_event.durations_mins, 4))) AS dmart_duration_mins
FROM shrink_event
LEFT JOIN dmart_wh
       ON dmart_wh.global_entity_id = shrink_event.global_entity_id
      AND dmart_wh.lg_city_id = shrink_event.lg_city_id
      AND dmart_wh.lg_zone_id = shrink_event.lg_zone_id
WHERE dmart_wh.warehouse_id IS NOT NULL
GROUP BY
  shrink_event.uuid,
  shrink_event.global_entity_id,
  shrink_event.country_name,
  shrink_event.lg_country_code,
  shrink_event.date_local,
  shrink_event.local_hour,
  shrink_event.lg_city_id,
  shrink_event.city_name,
  shrink_event.lg_zone_id,
  shrink_event.zone_name,
  shrink_event.action_type,
  shrink_event.title,
  shrink_event.shrink_tier,
  shrink_event.final_drive_time_mins,
  dmart_wh.warehouse_id,
  dmart_wh.warehouse_name,
  shrink_event.active_from_local,
  shrink_event.active_to_local,
  shrink_event.durations_mins]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1p3lw650xlqlyj11v2yn91rgcmqp' name='Custom SQL Query' type='text'><![CDATA[WITH lg_entities AS (
  -- to get rid of dp-* country_code duplicates
  -- and ensures that each entity id has one country iso
  SELECT DISTINCT
    platforms.entity_id AS id,
    lg_countries.country_iso
  FROM `fulfillment-dwh-production.curated_data_shared.countries` AS lg_countries,
  UNNEST(lg_countries.platforms) AS platforms
),

countries_timezone AS (
  SELECT
    country_code,
    country_iso,
    (SELECT timezone FROM UNNEST(cities) LIMIT 1) AS timezone  -- replicating global's logic to get timezone, from lg old tables
  FROM `fulfillment-dwh-production.curated_data_shared.countries`
),

warehouses_vendors AS (
  SELECT DISTINCT
    warehouses.global_entity_id,
    warehouses.warehouse_id,
    warehouses.name AS warehouse_name,
    vendors.platform_vendor_id,
    warehouses.is_dmart
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.warehouses_v2` AS warehouses
  LEFT JOIN UNNEST(vendors) AS vendors
),

dmart_wh AS ( -- Dmart WH zone and city ID
  SELECT
    shared_countries.global_entity_id,
    lg_entities.country_iso,
    warehouses_vendors.warehouse_id,
    warehouses_vendors.warehouse_name,
    vendor_zone.id AS lg_zone_id,
    delivery_area_locations.city_id AS lg_city_id,
    COUNT(DISTINCT vendor.vendor_code) AS total_vendors
  FROM `fulfillment-dwh-production.curated_data_shared.vendors_delivery_areas` AS vendor,
  UNNEST(vendor.zones) AS vendor_zone,
  UNNEST(vendor.delivery_areas_location) AS delivery_area_locations
  LEFT JOIN lg_entities
         ON lg_entities.id = vendor.entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON lg_entities.country_iso = shared_countries.country_code_iso
  LEFT JOIN warehouses_vendors
         ON warehouses_vendors.global_entity_id = shared_countries.global_entity_id
        AND warehouses_vendors.platform_vendor_id = vendor.vendor_code
  WHERE vendor.vertical_type = "darkstores"
    AND warehouses_vendors.warehouse_id IS NOT NULL
    AND vendor_zone.id IS NOT NULL
    AND delivery_area_locations.city_id IS NOT NULL
    AND warehouses_vendors.is_dmart
  GROUP BY
    shared_countries.global_entity_id,
    lg_entities.country_iso,
    warehouses_vendors.warehouse_id,
    warehouses_vendors.warehouse_name,
    vendor_zone.id,
    delivery_area_locations.city_id
),

chains AS ( -- Dmart chain information
  SELECT DISTINCT
    shared_countries.global_entity_id,
    vendor.chain.id AS chain_code,
    vendor.chain.name AS chain_name,
    TRUE AS is_dmart
  FROM `fulfillment-dwh-production.curated_data_shared.vendors_delivery_areas` AS vendor
  LEFT JOIN lg_entities
         ON lg_entities.id = vendor.entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON lg_entities.country_iso = shared_countries.country_code_iso
  WHERE vendor.vertical_type = "darkstores"
    AND vendor.chain.id IS NOT NULL
),

zones AS (
  SELECT
    country.country_code,
    city_zone.id || "_" || country.country_code AS lg_zone_uuid,
    city_zone.id AS zone_id,
    city_zone.name AS zone_name,
    city.id AS city_id,
    city.name AS city_name
  FROM `fulfillment-dwh-production.curated_data_shared.countries` AS country,
  UNNEST(country.cities) AS city,
  UNNEST(city.zones) AS city_zone
  WHERE city_zone.is_active
),

shrink_event AS (
  SELECT
  (
    delivery_areas_events.transaction_id || "_"
    || COALESCE(CAST(delivery_areas_events.end_transaction_id AS STRING), "") || "_"
    || delivery_areas_events.event_id || "_"
    || delivery_areas_events.country_code
  ) AS uuid,
    shared_countries.global_entity_id,
    shared_countries.name AS country_name,
    delivery_areas_events.country_code AS lg_country_code,
    DATE(delivery_areas_events.active_from, delivery_areas_events.timezone) AS date_local,
    EXTRACT(HOUR FROM DATETIME(delivery_areas_events.active_from, delivery_areas_events.timezone)) AS local_hour,
    delivery_areas_events.city.city_id AS lg_city_id,
    zones.city_name,
    delivery_areas_events.zone_id AS lg_zone_id,
    zones.zone_name,
    zones.lg_zone_uuid,
    delivery_areas_events.action AS action_type,
    delivery_areas_events.title,
    CASE
      WHEN delivery_areas_events.title LIKE "%1%" THEN 1
      WHEN delivery_areas_events.title LIKE "%2%" THEN 2
      WHEN delivery_areas_events.title LIKE "%3%" THEN 3
      WHEN delivery_areas_events.title LIKE "%4%" THEN 4
      WHEN delivery_areas_events.title LIKE "%5%" THEN 5
      WHEN delivery_areas_events.title LIKE "%0%" THEN 0
    END AS shrink_tier,
    delivery_areas_events.value AS final_drive_time_mins,
    DATETIME(delivery_areas_events.active_from, delivery_areas_events.timezone) AS active_from_local,
    DATETIME(delivery_areas_events.active_to, delivery_areas_events.timezone) AS active_to_local,
    SAFE_DIVIDE(DATETIME_DIFF(delivery_areas_events.active_to, delivery_areas_events.active_from, SECOND), 60) AS durations_mins,
    fil.key,
    fil.operator,
    fil_values,
    chains.chain_name,
    -- chain based inclusion logic
    IF(fil.key = "chains" AND fil.operator IN ("$in", "$is", "$all") AND chains.is_dmart, 1, NULL) AS is_dmart_chain_include,
    IF(fil.key = "chains" AND fil.operator IN ("$nin", "$not", "$nall") AND chains.is_dmart, 1, NULL) AS is_dmart_chain_exclude,
    -- vertical based inclusion logic
    IF(fil.key = "vertical_type" AND fil_values = "darkstores" AND fil.operator IN ("$in", "$is", "$all"), 1, NULL) AS is_dmart_vertical_include,
    IF(fil.key = "vertical_type" AND fil_values = "darkstores" AND fil.operator IN ("$nin", "$not", "$nall"), 1, NULL) AS is_dmart_vertical_exclude,
    -- rider based inclusion logic
    IF(fil.key = "delivery_types" AND fil_values = "OWN_DELIVERY" AND fil.operator IN ("$in", "$is", "$all"), 1, NULL) AS is_rider_delivery_include
  FROM `fulfillment-dwh-production.curated_data_shared.delivery_areas_events` AS delivery_areas_events,
  UNNEST(delivery_areas_events.filters) AS fil,
  UNNEST(fil.values) AS fil_values
  LEFT JOIN countries_timezone
         ON delivery_areas_events.country_code = countries_timezone.country_code
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON countries_timezone.country_iso = shared_countries.country_code_iso
  LEFT JOIN chains
         ON chains.global_entity_id = shared_countries.global_entity_id
        AND chains.chain_code = fil_values
  LEFT JOIN zones
         ON zones.zone_id = delivery_areas_events.zone_id
        AND zones.country_code = delivery_areas_events.country_code
  WHERE delivery_areas_events.created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH), MONTH)
    AND delivery_areas_events.is_active
    AND LOWER(delivery_areas_events.action) IN ("shrink", "close")
    AND fil.values IS NOT NULL
)

SELECT
  shrink_event.uuid,
  shrink_event.global_entity_id,
  shrink_event.country_name,
  shrink_event.lg_country_code,
  shrink_event.date_local,
  shrink_event.local_hour,
  shrink_event.lg_city_id,
  shrink_event.city_name,
  shrink_event.lg_zone_id,
  shrink_event.zone_name,
  shrink_event.action_type,
  shrink_event.title,
  shrink_event.shrink_tier,
  shrink_event.final_drive_time_mins,
  dmart_wh.warehouse_id,
  dmart_wh.warehouse_name,
  shrink_event.active_from_local,
  shrink_event.active_to_local,
  shrink_event.durations_mins,
  SUM(shrink_event.is_rider_delivery_include) AS rider_delivery_include,
  SUM(shrink_event.is_dmart_chain_include) AS dmart_chain_include,
  SUM(shrink_event.is_dmart_vertical_include) AS dmart_vertical_include,
  SUM(shrink_event.is_dmart_chain_exclude) AS dmart_chain_exclude,
  SUM(shrink_event.is_dmart_vertical_exclude) AS dmart_vertical_exclude,
  IFNULL(LOGICAL_OR(
    shrink_event.is_dmart_vertical_exclude >>= 1
    OR shrink_event.is_dmart_chain_exclude >>= 1
    OR shrink_event.is_dmart_chain_include << 1
    OR shrink_event.is_dmart_vertical_include << 1
    ), FALSE) AS final_exclude_dmart,
  IF(LOGICAL_OR(
    shrink_event.is_dmart_vertical_exclude >>= 1
    OR shrink_event.is_dmart_chain_exclude >>= 1
    OR shrink_event.is_dmart_chain_include << 1
    OR shrink_event.is_dmart_vertical_include << 1
    ), 0, ANY_VALUE(ROUND(shrink_event.durations_mins, 4))) AS dmart_duration_mins
FROM shrink_event
LEFT JOIN dmart_wh
       ON dmart_wh.global_entity_id = shrink_event.global_entity_id
      AND dmart_wh.lg_city_id = shrink_event.lg_city_id
      AND dmart_wh.lg_zone_id = shrink_event.lg_zone_id
WHERE dmart_wh.warehouse_id IS NOT NULL
GROUP BY
  shrink_event.uuid,
  shrink_event.global_entity_id,
  shrink_event.country_name,
  shrink_event.lg_country_code,
  shrink_event.date_local,
  shrink_event.local_hour,
  shrink_event.lg_city_id,
  shrink_event.city_name,
  shrink_event.lg_zone_id,
  shrink_event.zone_name,
