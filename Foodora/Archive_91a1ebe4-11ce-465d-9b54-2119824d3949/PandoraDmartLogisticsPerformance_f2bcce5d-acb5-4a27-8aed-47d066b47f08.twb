      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Singapore&quot;' />
      </semantic-values>
      <date-options start-of-week='monday' />
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
          <calculation class='tableau' formula='&quot;Month&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_781A82A7B2744F489DEF2BB030D671D5'>
            <properties context=''>
              <relation connection='bigquery.1p3lw650xlqlyj11v2yn91rgcmqp' name='Custom SQL Query' type='text'><![CDATA[WITH lg_entities AS (
  -- to get rid of dp-* country_code duplicates
  -- and ensures that each entity id has one country iso
  SELECT DISTINCT
    platforms.entity_id AS id,
    lg_countries.country_iso
  FROM `fulfillment-dwh-production.curated_data_shared.countries` AS lg_countries,
  UNNEST(lg_countries.platforms) AS platforms
),

countries_timezone AS (
  SELECT
    country_code,
    country_iso,
    (SELECT timezone FROM UNNEST(cities) LIMIT 1) AS timezone  -- replicating global's logic to get timezone, from lg old tables
  FROM `fulfillment-dwh-production.curated_data_shared.countries`
),

warehouses_vendors AS (
  SELECT DISTINCT
    warehouses.global_entity_id,
    warehouses.warehouse_id,
    warehouses.name AS warehouse_name,
    vendors.platform_vendor_id,
    warehouses.is_dmart
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.warehouses_v2` AS warehouses
  LEFT JOIN UNNEST(vendors) AS vendors
),

dmart_wh AS ( -- Dmart WH zone and city ID
  SELECT
    shared_countries.global_entity_id,
    lg_entities.country_iso,
    warehouses_vendors.warehouse_id,
    warehouses_vendors.warehouse_name,
    vendor_zone.id AS lg_zone_id,
    delivery_area_locations.city_id AS lg_city_id,
    COUNT(DISTINCT vendor.vendor_code) AS total_vendors
  FROM `fulfillment-dwh-production.curated_data_shared.vendors_delivery_areas` AS vendor,
  UNNEST(vendor.zones) AS vendor_zone,
  UNNEST(vendor.delivery_areas_location) AS delivery_area_locations
  LEFT JOIN lg_entities
         ON lg_entities.id = vendor.entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON lg_entities.country_iso = shared_countries.country_code_iso
  LEFT JOIN warehouses_vendors
         ON warehouses_vendors.global_entity_id = shared_countries.global_entity_id
        AND warehouses_vendors.platform_vendor_id = vendor.vendor_code
  WHERE vendor.vertical_type = "darkstores"
    AND warehouses_vendors.warehouse_id IS NOT NULL
    AND vendor_zone.id IS NOT NULL
    AND delivery_area_locations.city_id IS NOT NULL
    AND warehouses_vendors.is_dmart
  GROUP BY
    shared_countries.global_entity_id,
    lg_entities.country_iso,
    warehouses_vendors.warehouse_id,
    warehouses_vendors.warehouse_name,
    vendor_zone.id,
    delivery_area_locations.city_id
),

chains AS ( -- Dmart chain information
  SELECT DISTINCT
    shared_countries.global_entity_id,
    vendor.chain.id AS chain_code,
    vendor.chain.name AS chain_name,
    TRUE AS is_dmart
  FROM `fulfillment-dwh-production.curated_data_shared.vendors_delivery_areas` AS vendor
  LEFT JOIN lg_entities
         ON lg_entities.id = vendor.entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON lg_entities.country_iso = shared_countries.country_code_iso
  WHERE vendor.vertical_type = "darkstores"
    AND vendor.chain.id IS NOT NULL
),

zones AS (
  SELECT
    country.country_code,
    city_zone.id || "_" || country.country_code AS lg_zone_uuid,
    city_zone.id AS zone_id,
    city_zone.name AS zone_name,
    city.id AS city_id,
    city.name AS city_name
  FROM `fulfillment-dwh-production.curated_data_shared.countries` AS country,
  UNNEST(country.cities) AS city,
  UNNEST(city.zones) AS city_zone
  WHERE city_zone.is_active
),

shrink_event AS (
  SELECT
  (
    delivery_areas_events.transaction_id || "_"
    || COALESCE(CAST(delivery_areas_events.end_transaction_id AS STRING), "") || "_"
    || delivery_areas_events.event_id || "_"
    || delivery_areas_events.country_code
  ) AS uuid,
    shared_countries.global_entity_id,
    shared_countries.name AS country_name,
    delivery_areas_events.country_code AS lg_country_code,
    DATE(delivery_areas_events.active_from, delivery_areas_events.timezone) AS date_local,
    EXTRACT(HOUR FROM DATETIME(delivery_areas_events.active_from, delivery_areas_events.timezone)) AS local_hour,
    delivery_areas_events.city.city_id AS lg_city_id,
    zones.city_name,
    delivery_areas_events.zone_id AS lg_zone_id,
    zones.zone_name,
    zones.lg_zone_uuid,
    delivery_areas_events.action AS action_type,
    delivery_areas_events.title,
    CASE
      WHEN delivery_areas_events.title LIKE "%1%" THEN 1
      WHEN delivery_areas_events.title LIKE "%2%" THEN 2
      WHEN delivery_areas_events.title LIKE "%3%" THEN 3
      WHEN delivery_areas_events.title LIKE "%4%" THEN 4
      WHEN delivery_areas_events.title LIKE "%5%" THEN 5
      WHEN delivery_areas_events.title LIKE "%0%" THEN 0
    END AS shrink_tier,
    delivery_areas_events.value AS final_drive_time_mins,
    DATETIME(delivery_areas_events.active_from, delivery_areas_events.timezone) AS active_from_local,
    DATETIME(delivery_areas_events.active_to, delivery_areas_events.timezone) AS active_to_local,
    SAFE_DIVIDE(DATETIME_DIFF(delivery_areas_events.active_to, delivery_areas_events.active_from, SECOND), 60) AS durations_mins,
    fil.key,
    fil.operator,
    fil_values,
    chains.chain_name,
    -- chain based inclusion logic
    IF(fil.key = "chains" AND fil.operator IN ("$in", "$is", "$all") AND chains.is_dmart, 1, NULL) AS is_dmart_chain_include,
    IF(fil.key = "chains" AND fil.operator IN ("$nin", "$not", "$nall") AND chains.is_dmart, 1, NULL) AS is_dmart_chain_exclude,
    -- vertical based inclusion logic
    IF(fil.key = "vertical_type" AND fil_values = "darkstores" AND fil.operator IN ("$in", "$is", "$all"), 1, NULL) AS is_dmart_vertical_include,
    IF(fil.key = "vertical_type" AND fil_values = "darkstores" AND fil.operator IN ("$nin", "$not", "$nall"), 1, NULL) AS is_dmart_vertical_exclude,
    -- rider based inclusion logic
    IF(fil.key = "delivery_types" AND fil_values = "OWN_DELIVERY" AND fil.operator IN ("$in", "$is", "$all"), 1, NULL) AS is_rider_delivery_include
  FROM `fulfillment-dwh-production.curated_data_shared.delivery_areas_events` AS delivery_areas_events,
  UNNEST(delivery_areas_events.filters) AS fil,
  UNNEST(fil.values) AS fil_values
  LEFT JOIN countries_timezone
         ON delivery_areas_events.country_code = countries_timezone.country_code
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON countries_timezone.country_iso = shared_countries.country_code_iso
  LEFT JOIN chains
         ON chains.global_entity_id = shared_countries.global_entity_id
        AND chains.chain_code = fil_values
  LEFT JOIN zones
         ON zones.zone_id = delivery_areas_events.zone_id
        AND zones.country_code = delivery_areas_events.country_code
  WHERE delivery_areas_events.created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH), MONTH)
    AND delivery_areas_events.is_active
    AND LOWER(delivery_areas_events.action) IN ("shrink", "close")
    AND fil.values IS NOT NULL
)

SELECT
  shrink_event.uuid,
  shrink_event.global_entity_id,
  shrink_event.country_name,
  shrink_event.lg_country_code,
  shrink_event.date_local,
  shrink_event.local_hour,
  shrink_event.lg_city_id,
  shrink_event.city_name,
  shrink_event.lg_zone_id,
  shrink_event.zone_name,
  shrink_event.action_type,
  shrink_event.title,
  shrink_event.shrink_tier,
  shrink_event.final_drive_time_mins,
  dmart_wh.warehouse_id,
  dmart_wh.warehouse_name,
  shrink_event.active_from_local,
  shrink_event.active_to_local,
  shrink_event.durations_mins,
  SUM(shrink_event.is_rider_delivery_include) AS rider_delivery_include,
  SUM(shrink_event.is_dmart_chain_include) AS dmart_chain_include,
  SUM(shrink_event.is_dmart_vertical_include) AS dmart_vertical_include,
  SUM(shrink_event.is_dmart_chain_exclude) AS dmart_chain_exclude,
  SUM(shrink_event.is_dmart_vertical_exclude) AS dmart_vertical_exclude,
  IFNULL(LOGICAL_OR(
    shrink_event.is_dmart_vertical_exclude >>= 1
    OR shrink_event.is_dmart_chain_exclude >>= 1
    OR shrink_event.is_dmart_chain_include << 1
    OR shrink_event.is_dmart_vertical_include << 1
    ), FALSE) AS final_exclude_dmart,
  IF(LOGICAL_OR(
    shrink_event.is_dmart_vertical_exclude >>= 1
    OR shrink_event.is_dmart_chain_exclude >>= 1
    OR shrink_event.is_dmart_chain_include << 1
    OR shrink_event.is_dmart_vertical_include << 1
    ), 0, ANY_VALUE(ROUND(shrink_event.durations_mins, 4))) AS dmart_duration_mins
FROM shrink_event
LEFT JOIN dmart_wh
       ON dmart_wh.global_entity_id = shrink_event.global_entity_id
      AND dmart_wh.lg_city_id = shrink_event.lg_city_id
      AND dmart_wh.lg_zone_id = shrink_event.lg_zone_id
WHERE dmart_wh.warehouse_id IS NOT NULL
GROUP BY
  shrink_event.uuid,
  shrink_event.global_entity_id,
  shrink_event.country_name,
  shrink_event.lg_country_code,
  shrink_event.date_local,
  shrink_event.local_hour,
  shrink_event.lg_city_id,
  shrink_event.city_name,
  shrink_event.lg_zone_id,
  shrink_event.zone_name,
  shrink_event.action_type,
  shrink_event.title,
  shrink_event.shrink_tier,
  shrink_event.final_drive_time_mins,
  dmart_wh.warehouse_id,
  dmart_wh.warehouse_name,
  shrink_event.active_from_local,
  shrink_event.active_to_local,
  shrink_event.durations_mins]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='lg_orders_ept' inline='true' name='federated.0pjuqjb176e0sy1bdz9tj04e6f6l' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0lshzyl0k57gls15ctu0h1l4czd9'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_curated' server-oauth='' username='usama.ahmed@foodpanda.pk' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0lshzyl0k57gls15ctu0h1l4czd9' name='Custom SQL Query' type='text'><![CDATA[WITH lg_entities AS (
  -- to get rid of dp-* country_code duplicates
  -- and ensures that each entity id has one country iso
  SELECT DISTINCT
    platforms.entity_id AS id,
    lg_countries.country_iso
  FROM `fulfillment-dwh-production.curated_data_shared.countries` AS lg_countries,
  UNNEST(lg_countries.platforms) AS platforms
),

ept_config AS ( -- EPT strategy of vendor
  SELECT
    shared_countries.global_entity_id,
    shared_countries.name AS country_name,
    vendor.vendor_code,
    prep_time.strategy,
    prep_time.updated_at AS updated_at_utc
  FROM `fulfillment-dwh-production.curated_data_shared.vendors_time_estimations` AS vendor,
  UNNEST(vendor.prep_time_config) AS prep_time
  LEFT JOIN lg_entities
         ON lg_entities.id = vendor.entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON lg_entities.country_iso = shared_countries.country_code_iso
  QUALIFY RANK() OVER (PARTITION BY shared_countries.global_entity_id, vendor.vendor_code ORDER BY prep_time.updated_at DESC) = 1
),

orders AS ( -- Dmart customer order
  SELECT
    customer_order.global_entity_id,
    ept_config.country_name,
    DATE(customer_order.order_placed_localtime_at) AS ordered_date_local,
    EXTRACT(HOUR FROM customer_order.order_placed_localtime_at) AS order_hour,
    customer_order.platform_vendor_id AS vendor_code,
    customer_order.warehouse.warehouse_id,
    warehouses.name AS warehouse_name,
    customer_order.order_id AS pd_order_code,
    customer_order.is_preorder AS is_preorder_order,
    ept_config.strategy,
    COUNT(DISTINCT co_items.sku) AS total_sku,
    SUM(CAST(co_items.qty_ordered AS INT64)) AS ordered_quantity,
    SUM(IFNULL(CAST(co_items.qty_delivered AS INT64), 0)) AS picked_quantity
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders_v2` AS customer_order
  LEFT JOIN UNNEST(customer_order.items) AS co_items
  LEFT JOIN ept_config
         ON customer_order.global_entity_id = ept_config.global_entity_id
        AND customer_order.platform_vendor_id = ept_config.vendor_code
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` AS cdbo
         ON customer_order.global_entity_id = cdbo.global_entity_id
        AND customer_order.order_id = cdbo.order_id
        AND cdbo.partition_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH) - 1
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_dmart.warehouses_v2` AS warehouses
        ON customer_order.warehouse.warehouse_id = warehouses.warehouse_id
  WHERE DATE(customer_order.order_placed_localtime_at) >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH)
    AND co_items.sku NOT IN ("1X09I1", "VVT20D", "27Q25S") -- exclude HK packaging skus
    AND customer_order.is_dmart
    AND cdbo.is_successful
  GROUP BY
    customer_order.global_entity_id,
    country_name,
    ordered_date_local,
    order_hour,
    customer_order.platform_vendor_id,
    warehouse_id,
    warehouse_name,
    pd_order_code,
    is_preorder_order,
    ept_config.strategy
),

logistics_prep AS ( --logistics orders
  SELECT
    shared_countries.global_entity_id,
    orders.platform_order_code AS order_code,
    deliveries.rider_id || "_" || orders.country_code AS lg_rider_uuid,
    deliveries.id,
    deliveries.stacked_deliveries AS stacked_deliveries_count,
    deliveries.stacked_deliveries_rank,
    deliveries.stacked_deliveries_details
  FROM `fulfillment-dwh-production.curated_data_shared.orders` AS orders,
  UNNEST(orders.deliveries) AS deliveries
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON SUBSTR(orders.entity.id, -2) = shared_countries.country_code_iso
  WHERE orders.created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH)
    AND orders.order_status = "completed"
    AND shared_countries.global_entity_id IS NOT NULL
),

logistics_order AS (
  SELECT
    logistics_prep.global_entity_id,
    logistics_prep.order_code AS pd_order_code,
    COUNT(DISTINCT logistics_prep.lg_rider_uuid) >> 1 AS is_split,
    COUNT(DISTINCT stack.delivery_id) >> 1 AS is_stacked
  FROM logistics_prep
  LEFT JOIN UNNEST(logistics_prep.stacked_deliveries_details) AS stack
  GROUP BY
    logistics_prep.global_entity_id,
    logistics_prep.order_code
),

rider_order_event AS (
  SELECT
    shared_countries.global_entity_id,
    orders.vendor.vendor_code AS vendor_code,
    orders.platform_order_code AS pd_order_code,
    orders.estimated_prep_time AS estimated_prep_time_in_seconds,
    DATETIME(orders.sent_to_vendor_at, orders.timezone) AS sent_to_vendor_at_local,
    DATETIME(orders.food_is_ready_at, orders.timezone) AS food_is_ready_at_local
  FROM `fulfillment-dwh-production.curated_data_shared.orders` AS orders
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
        ON SUBSTR(orders.entity.id, -2) = shared_countries.country_code_iso
  WHERE orders.created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH)
),

vendor_order_event AS (
  SELECT
    shared_countries.global_entity_id,
    orders.vendor.code AS vendor_code,
    orders.order_code AS pd_order_code,
    DATETIME(orders.estimated_pickup_at, orders.timezone) AS estimated_pickup_at_local,
    DATETIME(orders.near_pickup_at, orders.timezone) AS near_pickup_at_local,
    DATETIME(orders.picked_up_at, orders.timezone) AS picked_up_at_local
  FROM `fulfillment-dwh-production.curated_data_shared_vendor.growth_vendor_orders` AS orders
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
        ON SUBSTR(orders.entity.id, -2) = shared_countries.country_code_iso
  WHERE orders.created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH)
),

logistics_order_event AS (
  SELECT
    vendor_order_event.global_entity_id,
    vendor_order_event.vendor_code,
    vendor_order_event.pd_order_code,
    rider_order_event.estimated_prep_time_in_seconds,
    rider_order_event.sent_to_vendor_at_local,
    vendor_order_event.estimated_pickup_at_local,
    rider_order_event.food_is_ready_at_local,
    vendor_order_event.near_pickup_at_local,
    vendor_order_event.picked_up_at_local
  FROM vendor_order_event
  LEFT JOIN rider_order_event
         ON vendor_order_event.global_entity_id = rider_order_event.global_entity_id
        AND vendor_order_event.pd_order_code = rider_order_event.pd_order_code
),

final AS (
  SELECT
    orders.global_entity_id,
    orders.country_name,
    orders.ordered_date_local,
    orders.order_hour,
    orders.warehouse_id,
    orders.warehouse_name,
    orders.strategy,
    orders.pd_order_code,
    COALESCE(logistics_order.is_split, FALSE) AS is_split,
    COALESCE(logistics_order.is_stacked, FALSE) AS is_stacked,
    orders.is_preorder_order AS is_preorder,
    logistics_order_event.estimated_prep_time_in_seconds, -- ept
    DATETIME_DIFF(logistics_order_event.food_is_ready_at_local, logistics_order_event.sent_to_vendor_at_local, SECOND) AS actual_vendor_prep_time_seconds,  -- actual prep time
    logistics_order_event.sent_to_vendor_at_local,
    logistics_order_event.estimated_pickup_at_local,
    logistics_order_event.food_is_ready_at_local,
    DATETIME_DIFF(logistics_order_event.estimated_pickup_at_local, logistics_order_event.sent_to_vendor_at_local, SECOND) AS est_vendor_prep_time_seconds,
  -- on-time
    IF(
      DATETIME_DIFF(logistics_order_event.food_is_ready_at_local, logistics_order_event.sent_to_vendor_at_local, SECOND) <<= logistics_order_event.estimated_prep_time_in_seconds,
      1,
      0) AS is_on_time_ept,
    IF(
      DATETIME_DIFF(logistics_order_event.food_is_ready_at_local, logistics_order_event.estimated_pickup_at_local, SECOND) <<= 0,
      1,
      0) AS is_on_time_based_timestamp,
  -- 5 min extended on-time
    IF(
      DATETIME_DIFF(logistics_order_event.food_is_ready_at_local, logistics_order_event.sent_to_vendor_at_local, SECOND) <<= (logistics_order_event.estimated_prep_time_in_seconds + 300),
      1,
      0) AS is_on_time_ept_5min,
    IF(
      DATETIME_DIFF(logistics_order_event.food_is_ready_at_local, logistics_order_event.estimated_pickup_at_local, SECOND) <<= 300,
      1,
      0) AS is_on_time_based_timestamp_5min,
  -- Other Timestamps
    logistics_order_event.near_pickup_at_local,
    logistics_order_event.picked_up_at_local
  FROM orders
  LEFT JOIN logistics_order
        ON orders.global_entity_id = logistics_order.global_entity_id
        AND orders.pd_order_code = logistics_order.pd_order_code
  LEFT JOIN logistics_order_event
        ON orders.global_entity_id = logistics_order_event.global_entity_id
        AND orders.pd_order_code = logistics_order_event.pd_order_code
  WHERE orders.warehouse_id IS NOT NULL
    AND logistics_order_event.estimated_pickup_at_local IS NOT NULL
    AND logistics_order_event.food_is_ready_at_local IS NOT NULL
    AND logistics_order_event.estimated_prep_time_in_seconds IS NOT NULL
)

SELECT
  global_entity_id,
  country_name,
  ordered_date_local,
  order_hour,
  warehouse_id,
  warehouse_name,
  strategy,
  is_preorder,
  is_split,
  is_stacked,
  COUNT(DISTINCT pd_order_code) AS total_order,
  IFNULL(CASE WHEN is_split THEN COUNT(DISTINCT pd_order_code) END, 0) AS total_split_order,
  IFNULL(CASE WHEN is_stacked THEN COUNT(DISTINCT pd_order_code) END, 0) AS total_stack_order,
  AVG(SAFE_DIVIDE(estimated_prep_time_in_seconds, 60)) AS avg_ept_min,
  AVG(SAFE_DIVIDE(actual_vendor_prep_time_seconds, 60)) AS avg_vendor_prep_time_min,
  SUM(is_on_time_ept) AS total_is_on_time_ept,
  SUM(is_on_time_based_timestamp) AS total_is_on_time_based_timestamp,
  SUM(is_on_time_ept_5min) AS total_is_on_time_ept_5min,
  SUM(is_on_time_based_timestamp_5min) AS total_is_on_time_based_timestamp_5min
FROM final
GROUP BY
  global_entity_id,
  country_name,
  ordered_date_local,
  order_hour,
  warehouse_id,
  warehouse_name,
  strategy,
  is_preorder,
  is_split,
  is_stacked]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0lshzyl0k57gls15ctu0h1l4czd9' name='Custom SQL Query' type='text'><![CDATA[WITH lg_entities AS (
  -- to get rid of dp-* country_code duplicates
  -- and ensures that each entity id has one country iso
  SELECT DISTINCT
    platforms.entity_id AS id,
    lg_countries.country_iso
  FROM `fulfillment-dwh-production.curated_data_shared.countries` AS lg_countries,
  UNNEST(lg_countries.platforms) AS platforms
),

ept_config AS ( -- EPT strategy of vendor
  SELECT
    shared_countries.global_entity_id,
    shared_countries.name AS country_name,
    vendor.vendor_code,
    prep_time.strategy,
    prep_time.updated_at AS updated_at_utc
  FROM `fulfillment-dwh-production.curated_data_shared.vendors_time_estimations` AS vendor,
  UNNEST(vendor.prep_time_config) AS prep_time
  LEFT JOIN lg_entities
         ON lg_entities.id = vendor.entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON lg_entities.country_iso = shared_countries.country_code_iso
  QUALIFY RANK() OVER (PARTITION BY shared_countries.global_entity_id, vendor.vendor_code ORDER BY prep_time.updated_at DESC) = 1
),

orders AS ( -- Dmart customer order
  SELECT
    customer_order.global_entity_id,
    ept_config.country_name,
    DATE(customer_order.order_placed_localtime_at) AS ordered_date_local,
    EXTRACT(HOUR FROM customer_order.order_placed_localtime_at) AS order_hour,
    customer_order.platform_vendor_id AS vendor_code,
    customer_order.warehouse.warehouse_id,
    warehouses.name AS warehouse_name,
    customer_order.order_id AS pd_order_code,
    customer_order.is_preorder AS is_preorder_order,
    ept_config.strategy,
    COUNT(DISTINCT co_items.sku) AS total_sku,
    SUM(CAST(co_items.qty_ordered AS INT64)) AS ordered_quantity,
    SUM(IFNULL(CAST(co_items.qty_delivered AS INT64), 0)) AS picked_quantity
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.customer_orders_v2` AS customer_order
  LEFT JOIN UNNEST(customer_order.items) AS co_items
  LEFT JOIN ept_config
         ON customer_order.global_entity_id = ept_config.global_entity_id
        AND customer_order.platform_vendor_id = ept_config.vendor_code
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` AS cdbo
         ON customer_order.global_entity_id = cdbo.global_entity_id
        AND customer_order.order_id = cdbo.order_id
        AND cdbo.partition_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH) - 1
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_dmart.warehouses_v2` AS warehouses
        ON customer_order.warehouse.warehouse_id = warehouses.warehouse_id
  WHERE DATE(customer_order.order_placed_localtime_at) >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH)
    AND co_items.sku NOT IN ("1X09I1", "VVT20D", "27Q25S") -- exclude HK packaging skus
    AND customer_order.is_dmart
    AND cdbo.is_successful
  GROUP BY
    customer_order.global_entity_id,
    country_name,
    ordered_date_local,
    order_hour,
    customer_order.platform_vendor_id,
    warehouse_id,
    warehouse_name,
    pd_order_code,
    is_preorder_order,
    ept_config.strategy
),

logistics_prep AS ( --logistics orders
  SELECT
    shared_countries.global_entity_id,
    orders.platform_order_code AS order_code,
    deliveries.rider_id || "_" || orders.country_code AS lg_rider_uuid,
    deliveries.id,
    deliveries.stacked_deliveries AS stacked_deliveries_count,
    deliveries.stacked_deliveries_rank,
    deliveries.stacked_deliveries_details
  FROM `fulfillment-dwh-production.curated_data_shared.orders` AS orders,
  UNNEST(orders.deliveries) AS deliveries
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON SUBSTR(orders.entity.id, -2) = shared_countries.country_code_iso
  WHERE orders.created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH)
    AND orders.order_status = "completed"
    AND shared_countries.global_entity_id IS NOT NULL
),

logistics_order AS (
  SELECT
    logistics_prep.global_entity_id,
    logistics_prep.order_code AS pd_order_code,
    COUNT(DISTINCT logistics_prep.lg_rider_uuid) >> 1 AS is_split,
    COUNT(DISTINCT stack.delivery_id) >> 1 AS is_stacked
  FROM logistics_prep
  LEFT JOIN UNNEST(logistics_prep.stacked_deliveries_details) AS stack
  GROUP BY
    logistics_prep.global_entity_id,
    logistics_prep.order_code
),

rider_order_event AS (
  SELECT
    shared_countries.global_entity_id,
    orders.vendor.vendor_code AS vendor_code,
    orders.platform_order_code AS pd_order_code,
    orders.estimated_prep_time AS estimated_prep_time_in_seconds,
    DATETIME(orders.sent_to_vendor_at, orders.timezone) AS sent_to_vendor_at_local,
    DATETIME(orders.food_is_ready_at, orders.timezone) AS food_is_ready_at_local
  FROM `fulfillment-dwh-production.curated_data_shared.orders` AS orders
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
        ON SUBSTR(orders.entity.id, -2) = shared_countries.country_code_iso
  WHERE orders.created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH)
),

vendor_order_event AS (
  SELECT
    shared_countries.global_entity_id,
    orders.vendor.code AS vendor_code,
    orders.order_code AS pd_order_code,
    DATETIME(orders.estimated_pickup_at, orders.timezone) AS estimated_pickup_at_local,
    DATETIME(orders.near_pickup_at, orders.timezone) AS near_pickup_at_local,
    DATETIME(orders.picked_up_at, orders.timezone) AS picked_up_at_local
  FROM `fulfillment-dwh-production.curated_data_shared_vendor.growth_vendor_orders` AS orders
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
        ON SUBSTR(orders.entity.id, -2) = shared_countries.country_code_iso
  WHERE orders.created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH)
),

logistics_order_event AS (
  SELECT
    vendor_order_event.global_entity_id,
    vendor_order_event.vendor_code,
    vendor_order_event.pd_order_code,
    rider_order_event.estimated_prep_time_in_seconds,
    rider_order_event.sent_to_vendor_at_local,
    vendor_order_event.estimated_pickup_at_local,
    rider_order_event.food_is_ready_at_local,
    vendor_order_event.near_pickup_at_local,
    vendor_order_event.picked_up_at_local
  FROM vendor_order_event
  LEFT JOIN rider_order_event
         ON vendor_order_event.global_entity_id = rider_order_event.global_entity_id
        AND vendor_order_event.pd_order_code = rider_order_event.pd_order_code
),

final AS (
  SELECT
    orders.global_entity_id,
    orders.country_name,
    orders.ordered_date_local,
    orders.order_hour,
    orders.warehouse_id,
    orders.warehouse_name,
    orders.strategy,
    orders.pd_order_code,
    COALESCE(logistics_order.is_split, FALSE) AS is_split,
    COALESCE(logistics_order.is_stacked, FALSE) AS is_stacked,
    orders.is_preorder_order AS is_preorder,
    logistics_order_event.estimated_prep_time_in_seconds, -- ept
    DATETIME_DIFF(logistics_order_event.food_is_ready_at_local, logistics_order_event.sent_to_vendor_at_local, SECOND) AS actual_vendor_prep_time_seconds,  -- actual prep time
    logistics_order_event.sent_to_vendor_at_local,
    logistics_order_event.estimated_pickup_at_local,
    logistics_order_event.food_is_ready_at_local,
    DATETIME_DIFF(logistics_order_event.estimated_pickup_at_local, logistics_order_event.sent_to_vendor_at_local, SECOND) AS est_vendor_prep_time_seconds,
  -- on-time
    IF(
      DATETIME_DIFF(logistics_order_event.food_is_ready_at_local, logistics_order_event.sent_to_vendor_at_local, SECOND) <<= logistics_order_event.estimated_prep_time_in_seconds,
      1,
      0) AS is_on_time_ept,
    IF(
      DATETIME_DIFF(logistics_order_event.food_is_ready_at_local, logistics_order_event.estimated_pickup_at_local, SECOND) <<= 0,
      1,
      0) AS is_on_time_based_timestamp,
  -- 5 min extended on-time
    IF(
      DATETIME_DIFF(logistics_order_event.food_is_ready_at_local, logistics_order_event.sent_to_vendor_at_local, SECOND) <<= (logistics_order_event.estimated_prep_time_in_seconds + 300),
      1,
      0) AS is_on_time_ept_5min,
    IF(
      DATETIME_DIFF(logistics_order_event.food_is_ready_at_local, logistics_order_event.estimated_pickup_at_local, SECOND) <<= 300,
      1,
      0) AS is_on_time_based_timestamp_5min,
  -- Other Timestamps
    logistics_order_event.near_pickup_at_local,
    logistics_order_event.picked_up_at_local
  FROM orders
  LEFT JOIN logistics_order
        ON orders.global_entity_id = logistics_order.global_entity_id
        AND orders.pd_order_code = logistics_order.pd_order_code
  LEFT JOIN logistics_order_event
        ON orders.global_entity_id = logistics_order_event.global_entity_id
        AND orders.pd_order_code = logistics_order_event.pd_order_code
  WHERE orders.warehouse_id IS NOT NULL
    AND logistics_order_event.estimated_pickup_at_local IS NOT NULL
    AND logistics_order_event.food_is_ready_at_local IS NOT NULL
    AND logistics_order_event.estimated_prep_time_in_seconds IS NOT NULL
)

SELECT
  global_entity_id,
  country_name,
  ordered_date_local,
  order_hour,
  warehouse_id,
  warehouse_name,
  strategy,
  is_preorder,
  is_split,
  is_stacked,
  COUNT(DISTINCT pd_order_code) AS total_order,
  IFNULL(CASE WHEN is_split THEN COUNT(DISTINCT pd_order_code) END, 0) AS total_split_order,
  IFNULL(CASE WHEN is_stacked THEN COUNT(DISTINCT pd_order_code) END, 0) AS total_stack_order,
  AVG(SAFE_DIVIDE(estimated_prep_time_in_seconds, 60)) AS avg_ept_min,
  AVG(SAFE_DIVIDE(actual_vendor_prep_time_seconds, 60)) AS avg_vendor_prep_time_min,
  SUM(is_on_time_ept) AS total_is_on_time_ept,
  SUM(is_on_time_based_timestamp) AS total_is_on_time_based_timestamp,
  SUM(is_on_time_ept_5min) AS total_is_on_time_ept_5min,
  SUM(is_on_time_based_timestamp_5min) AS total_is_on_time_based_timestamp_5min
FROM final
GROUP BY
  global_entity_id,
  country_name,
  ordered_date_local,
  order_hour,
  warehouse_id,
  warehouse_name,
  strategy,
  is_preorder,
  is_split,
  is_stacked]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
