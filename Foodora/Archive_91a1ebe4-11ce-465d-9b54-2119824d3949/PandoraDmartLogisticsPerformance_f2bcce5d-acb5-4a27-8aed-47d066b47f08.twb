      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/PandoraDmartLogisticsPerformance/DmartLogisticsEvents-DataDump?rev=' id='DmartLogisticsEvents-DataDump' path='/t/Foodora/workbooks/PandoraDmartLogisticsPerformance' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='dmart_shrink_logistics' name='federated.0fy8mst08i888r11nf6rk1oppi6c' />
          </datasources>
          <datasource-dependencies datasource='federated.0fy8mst08i888r11nf6rk1oppi6c'>
            <column caption='Close Hours' datatype='real' name='[Calculation_1983131990219292672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [action_type] = &quot;close&quot; THEN [dmart_duration_mins]/60 ELSE 0 END' />
            </column>
            <column caption='Total Events' datatype='integer' name='[Calculation_2239555652284592129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [dmart_duration_mins] &gt; 0 THEN [uuid] END)' />
            </column>
            <column caption='Shrink Hours' datatype='real' name='[Close Hours (copy)_1983131990219792385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [action_type] = &quot;shrink&quot; THEN [dmart_duration_mins]/60 ELSE 0 END' />
            </column>
            <column datatype='string' name='[action_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[date_local]' role='dimension' type='ordinal' />
            <column datatype='real' name='[dmart_duration_mins]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[action_type]' derivation='None' name='[none:action_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[date_local]' derivation='None' name='[none:date_local:ok]' pivot='key' type='ordinal' />
