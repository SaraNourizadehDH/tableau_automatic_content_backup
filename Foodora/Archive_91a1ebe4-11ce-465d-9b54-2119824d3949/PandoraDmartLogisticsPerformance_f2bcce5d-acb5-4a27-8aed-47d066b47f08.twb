      <column caption='Close Hours' datatype='real' name='[Calculation_1983131990219292672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [action_type] = &quot;close&quot; THEN [dmart_duration_mins]/60 ELSE 0 END' />
      </column>
      <column caption='Date Granularity' datatype='datetime' name='[Calculation_2239555652284203008]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN [date_local]&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[date_local],&apos;monday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[date_local])&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;,[date_local])&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&apos;year&apos;,[date_local])&#10;END' />
      </column>
      <column caption='Total Events' datatype='integer' name='[Calculation_2239555652284592129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [dmart_duration_mins] &gt; 0 THEN [uuid] END)' />
      </column>
      <column caption='Shrinkage Hours' datatype='real' name='[Calculation_2239555652286291970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_duration_mins]/60)' />
      </column>
      <column caption='Shrink Events' datatype='integer' name='[Close Events (copy)_1983131990220759043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [action_type] = &quot;shrink&quot; AND [dmart_duration_mins] &gt; 0 THEN [uuid] END)' />
      </column>
      <column caption='Shrink Hours' datatype='real' name='[Close Hours (copy)_1983131990219792385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [action_type] = &quot;shrink&quot; THEN [dmart_duration_mins]/60 ELSE 0 END' />
