    <worksheet name='IR Performance Breakdown'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_shops__item_replacement_dashboard (pandata_report)' name='federated.19hw0qb03to1ol15ljvw81mac43x' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Perspective' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;APAC&quot;'>
              <calculation class='tableau' formula='&quot;APAC&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19hw0qb03to1ol15ljvw81mac43x'>
            <column caption='# Chains Using IR' datatype='integer' name='[# Enabled Chains (copy)_353884422609932301]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD(IF [num_of_replaced_orders] &gt; 0 THEN [chain_code] + &quot;_&quot; + [global_entity_id] ELSE NULL END)' />
            </column>
            <column caption='# Enabled Chains' datatype='integer' name='[# Enabled Vendors (copy)_353884422609825804]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([item_replacement_phase_two_live_date_local]) THEN [chain_code] + &quot;_&quot; + [global_entity_id] ELSE NULL END)' />
            </column>
            <column caption='# Vendors Using IR' datatype='integer' name='[# Enabled Vendors (copy)_353884422609932302]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD(IF [num_of_replaced_orders] &gt; 0 THEN [vendor_code] + &quot;_&quot; + [global_entity_id] ELSE NULL END)' />
            </column>
            <column caption='% Enabled Vendors Using IR' datatype='real' default-format='p0.0%' name='[% Enabled Chains Using Ir (copy)_353884422964416541]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Enabled Vendors (copy)_353884422609932302] / [Calculation_353884422609211403]' />
            </column>
            <column caption='% IR Enabled Found Rate' datatype='real' default-format='p0.0%' name='[% Found Rate (copy)_353884422259335169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ir_enabled_delivered_quantity]) / SUM([ir_enabled_post_replacement_ordered_quantity])' />
            </column>
