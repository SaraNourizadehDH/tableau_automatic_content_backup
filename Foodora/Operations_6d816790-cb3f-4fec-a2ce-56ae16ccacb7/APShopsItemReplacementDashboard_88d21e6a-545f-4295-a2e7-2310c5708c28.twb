        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#10;    WHEN IN (&#10;        &quot;APAC&quot;, &quot;Country&quot;, &quot;Vertical Type&quot;, &quot;Chain&quot;, &quot;Vendor&quot;, &quot;Strategic Account&quot;,&#10;        &quot;Country ▸ Vertical Type&quot;, &quot;Country ▸ Chain&quot;, &quot;Country ▸ IR Phase&quot;, &quot;Vertical Type ▸ Country&quot;&#10;    ) THEN &quot;&quot;&#10;    WHEN IN (&#10;        &quot;Country ▸ Vertical Type ▸ Chain&quot;,&#10;        &quot;Vertical Type ▸ Country ▸ Chain&quot;&#10;    ) THEN [Vendor (copy)_353884422919020562]&#10;    WHEN IN (&#10;        &quot;Country ▸ Chain ▸ Vendor&quot;,&#10;        &quot;Strategic Account ▸ Chain ▸ Vendor&quot;&#10;    ) THEN [Calculation_353884422918926353]&#10;    WHEN IN (&#10;        &quot;Country ▸ Vertical Type ▸ IR Phase&quot;&#10;    ) THEN [max_item_replacement_phase]&#10;END' />
      </column>
