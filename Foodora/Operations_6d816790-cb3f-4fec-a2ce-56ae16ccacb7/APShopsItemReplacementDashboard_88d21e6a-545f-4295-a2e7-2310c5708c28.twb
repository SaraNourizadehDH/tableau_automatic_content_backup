          <datasource-dependencies datasource='federated.19hw0qb03to1ol15ljvw81mac43x'>
            <column caption='% Orders PLC: Suggestion Sent' datatype='real' default-format='p0.0%' name='[% Orders PLC: Suggestion Added (copy)_6008083406187413506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_orders_plc_suggestions_sent]) / SUM([num_of_ir_phase_2_eligible_orders])' />
