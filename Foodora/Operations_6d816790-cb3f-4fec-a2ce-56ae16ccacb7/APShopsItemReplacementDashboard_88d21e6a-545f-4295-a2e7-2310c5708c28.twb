          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Perspective 1A (Cat)' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Original Master Categories: L1&quot;'>
              <calculation class='tableau' formula='&quot;Original Master Categories: L1&quot;' />
            </column>
            <column caption='Perspective 1B (Cat)' datatype='string' name='[Perspective 1 (copy)_353884422935093267]' param-domain-type='list' role='measure' type='nominal' value='&quot;Original Master Categories: L2&quot;'>
              <calculation class='tableau' formula='&quot;Original Master Categories: L2&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ynptcb1cj26fd15i69ji0864a9e'>
            <column caption='[DNU] # Suggestion Opportunities: No Suggestions (duplicate: for % of total)' datatype='integer' name='[# Suggestion Opportunities: No Suggestions (copy)_1413989613060116484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[num_of_no_suggestions]' />
            </column>
            <column caption='[DNU] # Suggestion Opportunities: REFUND (duplicate: for % of total)' datatype='integer' name='[# Suggestion Opportunities: REFUND (copy)_1413989613060116485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[num_of_refund_replacements]' />
            </column>
            <column caption='% Suggestion Opportunities: Successful' datatype='real' default-format='p0.0%' name='[# Suggestion Opportunities: Successful (copy)_1413989613059506176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_successful_replacements])/ SUM([num_of_suggestion_opportunities])' />
            </column>
            <column caption='[DNU] # Suggestion Opportunities: Successful (duplicate: for % of total)' datatype='integer' name='[# Suggestion Opportunities: Successful (copy)_1413989613060116486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[num_of_successful_replacements]' />
            </column>
            <column caption='% Suggestion Opportunities: No Suggestions' datatype='real' default-format='p0.0%' name='[% Suggestion Opportunities: REFUND (copy)_1413989613059854339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_no_suggestions])/ SUM([num_of_suggestion_opportunities])' />
            </column>
            <column caption='% Suggestion Opportunities: REFUND' datatype='real' default-format='p0.0%' name='[% Suggestion Opportunities: Successful (copy)_1413989613059653633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_refund_replacements])/ SUM([num_of_suggestion_opportunities])' />
            </column>
            <column caption='Chain' datatype='string' name='[Calculation_3267994857934307350]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[chain_name] + &quot; | &quot; + [chain_code]' />
            </column>
            <column caption='Perspective 1A' datatype='string' name='[Calculation_353884422935150612]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &quot;Original Master Categories: L1&quot; THEN [master_category_level_one] &#10;    WHEN &quot;Original Master Categories: L2&quot; THEN [master_category_level_two] &#10;    WHEN &quot;Replacement Master Categories: L1&quot; THEN [replacement_master_category_level_one]&#10;ELSE [replacement_master_category_level_two] END' />
            </column>
            <column caption='Replacement Not Null' datatype='boolean' name='[Calculation_353884422936166422]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([replacement_master_category_level_one])' />
            </column>
            <column caption='Same Replacement L1' datatype='boolean' name='[Calculation_353884422936793111]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[master_category_level_one] = [replacement_master_category_level_one]' />
            </column>
            <column caption='% Item Replacement GFV Saved' datatype='real' name='[Calculation_6079296591813259274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([final_replacement_gfv_saved_eur])/&#10;SUM([ir_eligible_gfv_eur])' />
            </column>
            <column caption='Exclude Outliers: Suggestion Not Tracked' datatype='boolean' name='[Calculation_6925621500393226240]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[suggestion_master_category_level_one] = &quot;No Suggestion Selected&quot; AND [replacement_master_category_level_one] &lt;&gt; &quot;No Suggestion Selected&quot;' />
            </column>
            <column caption='Exclude: No Suggestion Selected' datatype='boolean' name='[Calculation_6925621500425203713]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[suggestion_master_category_level_two] &lt;&gt; &quot;No Suggestion Selected&quot;' />
            </column>
            <column caption='Vendor' datatype='string' name='[Chain (copy)_3267994857934381079]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_name] + &quot; | &quot; + [vendor_code]' />
            </column>
            <column caption='Perspective 1B' datatype='string' name='[Perspective 1 (copy)_353884422935224341]' role='dimension' type='nominal'>
