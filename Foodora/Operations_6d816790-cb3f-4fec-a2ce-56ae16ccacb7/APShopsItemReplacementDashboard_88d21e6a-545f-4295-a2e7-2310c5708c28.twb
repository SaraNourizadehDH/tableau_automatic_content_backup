      <datasource-dependencies datasource='federated.19hw0qb03to1ol15ljvw81mac43x'>
        <column caption='Strategic Account' datatype='string' name='[Calculation_142989353526398981]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [is_strategic_account]=TRUE THEN &quot;True&quot; ELSE &quot;False&quot; END' />
        </column>
        <column caption='Perspective 1' datatype='string' name='[Calculation_3267994857857658893]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#10;    WHEN &quot;APAC&quot; THEN [Calculation_353884422962622490]&#10;    WHEN IN (&#10;        &quot;Country&quot;,&#10;        &quot;Country ▸ Vertical Type&quot;,&#10;        &quot;Country ▸ Vertical Type ▸ Chain&quot;,&#10;        &quot;Country ▸ Vertical Type ▸ IR Phase&quot;,&#10;        &quot;Country ▸ Chain&quot;,&#10;        &quot;Country ▸ Chain ▸ Vendor&quot;,&#10;        &quot;Country ▸ IR Phase&quot;&#10;    ) THEN [global_entity_id]&#10;    WHEN IN (&quot;IR Phase&quot;) THEN STR([max_item_replacement_phase])&#10;    WHEN IN (&#10;        &quot;Vertical Type&quot;,&#10;        &quot;Vertical Type ▸ Country&quot;,&#10;        &quot;Vertical Type ▸ Country ▸ Chain&quot;&#10;    ) THEN [vertical_type]&#10;    WHEN &quot;Chain&quot; THEN [Vendor (copy)_353884422919020562]&#10;    WHEN &quot;Vendor&quot; THEN [Calculation_353884422918926353]&#10;    WHEN IN (&#10;        &quot;Strategic Account&quot;,&#10;        &quot;Strategic Account ▸ Chain ▸ Vendor&quot;&#10;    ) THEN [Calculation_142989353526398981]&#10;END' />
        </column>
        <column caption='Vendor' datatype='string' name='[Calculation_353884422918926353]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [chain_name] = &quot;others&quot; THEN &quot;Others&quot; ELSE [vendor_name] + &quot; | &quot; + [vendor_code] END' />
        </column>
        <column caption='Perspective 2' datatype='string' name='[Perspective 1 (copy)_3267994857858314254]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#10;    WHEN IN (&quot;APAC&quot;, &quot;Country&quot;, &quot;Vertical Type&quot;, &quot;Chain&quot;, &quot;Vendor&quot;, &quot;IR Phase&quot;, &quot;Strategic Account&quot;) THEN &quot;&quot;&#10;    WHEN IN (&#10;        &quot;Country ▸ Vertical Type&quot;,&#10;        &quot;Country ▸ Vertical Type ▸ Chain&quot;,&#10;        &quot;Country ▸ Vertical Type ▸ IR Phase&quot;&#10;    ) THEN [vertical_type]&#10;    WHEN IN (&#10;        &quot;Country ▸ Chain&quot;,&#10;        &quot;Country ▸ Chain ▸ Vendor&quot;,&#10;        &quot;Strategic Account ▸ Chain ▸ Vendor&quot;&#10;    ) THEN [Vendor (copy)_353884422919020562]&#10;    WHEN IN (&quot;Vertical Type ▸ Country&quot;, &quot;Vertical Type ▸ Country ▸ Chain&quot;) THEN [global_entity_id]&#10;    WHEN IN (&quot;Country ▸ IR Phase&quot;) THEN [max_item_replacement_phase]&#10;END' />
