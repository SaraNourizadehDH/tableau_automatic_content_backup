          <alias key='&quot;[federated.16iqxpx1rgqgwo1c4plhq19z6kw5].[sum:valid_gmv_eur:qk]&quot;' value='GMV (€)  ' />
        </aliases>
      </column>
      <column caption='Picking Time' datatype='real' name='[Assignment Time (copy)_1121466701240086537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([picking_time_mins])&#10;/&#10;SUM(&#10;IF  [is_pelican_order] THEN [num_of_accurate_picked_orders] ELSE 0&#10;END&#10;)' />
      </column>
      <column caption='Avg Items Not Delivered per IND Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Items Not Delivered  per IND Order (incl. Post Delivery) (copy)_2159405719831916546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;(ZN(SUM([num_of_valid_ordered_quantity])) + ZN(SUM([num_of_failed_vendor_product_unavailable_ordered_quantity])))&#10;-&#10;(ZN(SUM([num_of_valid_sent_quantity])))&#10;)&#10;/&#10;[Items Not Delivered Orders (incl. Post Delivery) (copy)_2159405719831916551]' />
      </column>
      <column caption='Avg Items Not Delivered per Partial Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Items Not Delivered per Partial Order (incl. Post Delivery) (copy)_2159405719831916552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;ZN(SUM([num_of_valid_ordered_quantity]))&#10;-&#10;ZN(SUM([num_of_valid_sent_quantity]))&#10;)&#10;/&#10;ZN(SUM([num_of_partially_fulfilled_excl_post_delivery_orders]))' />
      </column>
      <column caption='Avg Items Not Delivered per IND Order (incl. Post Delivery)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg OOS Quantity per Partial Order (copy)_4621185830078431233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;(ZN(SUM([num_of_valid_ordered_quantity])) + ZN(SUM([num_of_failed_vendor_product_unavailable_ordered_quantity])))&#10;-&#10;(ZN(SUM([num_of_valid_delivered_quantity])))&#10;)&#10;/&#10;[GFV Loss (€) from OOS Orders (copy)_6921540072751685634]' />
      </column>
      <column caption='Date Type' datatype='datetime' default-format='*mmm dd' name='[Calculation_1075445537741815808]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1],[report_date_local])' />
      </column>
      <column caption='Persp #1' datatype='string' name='[Calculation_1075445537741946881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// 1 PERSPECTIVE&#10;IF     [Parameters].[Parameter 4] = &apos;APAC&apos; THEN &apos;APAC&apos;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Country&apos; THEN [name]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vertical&apos; THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Chain&apos; THEN [Calculation_2724396325008797696]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Managed Account&apos; THEN [Calculation_4654962823809421312]&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Integration Status&apos; &#10;    AND [is_sftp_vendor] = FALSE &#10;    AND [is_api_vendor] = FALSE &#10;THEN &apos;Not Integrated&apos;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Integration Status&apos; AND [is_sftp_vendor] THEN &apos;SFTP Integrated&apos;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Integration Status&apos; AND [is_api_vendor] THEN &apos;API Integrated&apos;&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Pelican Status&apos; &#10;    AND [is_pelican_order] THEN &apos;Pelican&apos;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Pelican Status&apos; &#10;    AND NOT [is_pelican_order] THEN &apos;Godroid&apos;&#10;   &#10;ELSEIF [Parameters].[Parameter 4] = &apos;POS Status&apos; AND [is_pos_vendor] THEN &apos;POS Integrated&apos; &#10;ELSEIF [Parameters].[Parameter 4] = &apos;POS Status&apos; AND NOT [is_pos_vendor] THEN &apos;Non POS Integrated&apos; &#10;&#10;// &gt;=2 PERSPECTIVE&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Vertical&apos;,&#10;                         &apos;Country ▸ Chain&apos;,&#10;                         &apos;Country ▸ Managed Account&apos;,&#10;                         &apos;Country ▸ Integration Status&apos;,&#10;                         &apos;Country ▸ Pelican Status&apos;,&#10;                         &apos;Country ▸ Chain ▸ Integration Status&apos;,&#10;                         &apos;Country ▸ Chain ▸ Pelican Status&apos;,&#10;                         &apos;Country ▸ Vertical ▸ Chain&apos;,&#10;                         &apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                         &apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                         &apos;Country ▸ Vertical ▸ POS Status&apos;&#10;                        )&#10;THEN [name]&#10;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Vertical ▸ Country&apos;,&#10;                         &apos;Vertical ▸ Chain&apos;,&#10;                         &apos;Vertical ▸ Integration Status&apos;,&#10;                         &apos;Vertical ▸ Pelican Status&apos;,&#10;                         &apos;Vertical ▸ POS Status&apos;,&#10;                         &apos;Vertical ▸ Country ▸ Chain&apos;&#10;                        )&#10;THEN [vertical_type]&#10;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Chain ▸ Integration Status&apos;, &#10;                         &apos;Chain ▸ Pelican Status&apos;,&#10;                         &apos;Chain ▸ POS Status&apos;&#10;                        ) &#10;THEN [Calculation_2724396325008797696]&#10;END' />
      </column>
      <column caption='# Valid Orders' datatype='integer' hidden='true' name='[Calculation_1075445539115327497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2724396325245480961]&#10;    AND ([Calculation_1075445537741946881] = &apos;Not Integrated&apos; OR [Perspective #1 (copy)_1413496969084428289] = &apos;Not Integrated&apos; OR [Persp #2 (copy)_1075445539109261317] = &apos;Not Integrated&apos;) &#10;    THEN [num_of_valid_orders]&#10;&#10;ELSEIF [Calculation_2724396325245480961] THEN [num_of_valid_integrated_orders]&#10;&#10;ELSEIF [Perspective = Integration (copy)_2724396325245755394]&#10;    AND ([Calculation_1075445537741946881] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;) OR [Perspective #1 (copy)_1413496969084428289] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;) OR [Persp #2 (copy)_1075445539109261317] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;)) &#10;    THEN [num_of_valid_orders]&#10;&#10;ELSEIF [Perspective = Integration (copy)_2724396325245755394] THEN [num_of_valid_pelican_orders]&#10;&#10;ELSEIF [Perspective = Integration (copy)_6239244721856913410] THEN [num_of_valid_orders]&#10;&#10;&#10;ELSE [num_of_valid_orders] END' />
      </column>
      <column caption='Delivery Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1108518878132781056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_time_non_preorder_mins]) / SUM([num_of_valid_completed_non_preorders])' />
      </column>
      <column caption='% Valid Orders' datatype='real' name='[Calculation_1121466698916216833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_valid_orders]) / &#10;&#10;ZN(&#10;IF     [Parameters].[Parameter 4] IN (&apos;APAC&apos;) THEN SUM([num_of_valid_orders])&#10;&#10;ELSEIF  [Parameters].[Parameter 4] IN (&apos;Integration Status&apos;, &apos;Pelican Status&apos;, &apos;POS Status&apos;, &apos;Country&apos;, &apos;Vertical&apos;, &apos;Chain&apos;, &apos;Managed Account&apos;) //THEN SUM([Num Of Valid Orders])&#10;THEN SUM({EXCLUDE [Calculation_1075445537741946881]: SUM([num_of_valid_orders])})&#10;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Integration Status&apos;, &#10;                         &apos;Country ▸ Vertical&apos;,&#10;                         &apos;Country ▸ Chain&apos;,&#10;                         &apos;Country ▸ Pelican Status&apos;, &#10;                         &apos;Country ▸ POS Status&apos;, &#10;                         &apos;Country ▸ Managed Account&apos;, &#10;                         &apos;Vertical ▸ Integration Status&apos;,&#10;                         &apos;Vertical ▸ Pelican Status&apos;,&#10;                         &apos;Vertical ▸ POS Status&apos;,&#10;                         &apos;Vertical ▸ Country&apos;,&#10;                         &apos;Vertical ▸ Chain&apos;,&#10;                         &apos;Chain ▸ Integration Status&apos;,&#10;                         &apos;Chain ▸ Pelican Status&apos;,&#10;                         &apos;Chain ▸ POS Status&apos;) &#10;THEN SUM({EXCLUDE [Perspective #1 (copy)_1413496969084428289]: SUM([num_of_valid_orders])})&#10;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Chain ▸ Integration Status&apos;, &#10;                          &apos;Country ▸ Vertical ▸ Integration Status&apos;, &#10;                          &apos;Country ▸ Chain ▸ Pelican Status&apos;,&#10;                          &apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                          &apos;Country ▸ Chain ▸ POS Status&apos;,&#10;                          &apos;Country ▸ Vertical ▸ POS Status&apos;) &#10;THEN SUM({EXCLUDE [Persp #2 (copy)_1075445539109261317]: SUM([num_of_valid_orders])})&#10;&#10;END&#10;)' />
      </column>
      <column caption='% Partial Order (incl. Post Delivery)' datatype='real' name='[Calculation_1121466698919759875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_partially_fulfilled_orders]) / SUM([num_of_valid_orders])' />
      </column>
      <column caption='Prep Time' datatype='real' name='[Calculation_1121466701214699526]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([prep_time_mins])&#10;/&#10;SUM([num_of_valid_prepped_orders])' />
      </column>
      <column caption='% Incident Rate' datatype='real' default-format='p0.0%' name='[Calculation_1121466701312081931]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_issues]) / SUM([num_of_orders])' />
      </column>
      <column caption='% Valid Orders with &gt;1 Rider' datatype='real' default-format='p0.0%' name='[Calculation_1121466701316468754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_valid_orders_multiple_riders]) / SUM([num_of_valid_orders])' />
      </column>
      <column caption='Avg Basket Size (Units)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1121466701316890644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_valid_delivered_quantity]) / SUM([num_of_valid_orders])' />
      </column>
      <column caption='Max Data Date' datatype='date' name='[Calculation_139189382966403072]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{MAX([report_date_local])}' />
      </column>
      <column caption='IR Impact on % Found Rate (incl. Post Delivery)' datatype='real' default-format='p0.0%' name='[Calculation_2163275953713221632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% Partial Order Rate (copy)_6777073038982397958] - &#10;(SUM([num_of_valid_pre_ir_delivered_quantity]) / SUM([num_of_valid_pre_ir_ordered_quantity]))' />
      </column>
      <column caption='Persp #1 Filter' datatype='string' name='[Calculation_2652268341934047236]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP(ATTR([Calculation_1075445537741946881]), 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Chain' datatype='string' name='[Calculation_2724396325008797696]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[chain_name]+&quot; (&quot; +[chain_code]+&quot;)&quot;' />
      </column>
      <column caption='Perspective = Integration' datatype='boolean' hidden='true' name='[Calculation_2724396325245480961]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4] IN (&apos;Integration Status&apos;,&#10;                     &apos;Country ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                     &apos;Vertical ▸ Integration Status&apos;,&#10;                     &apos;Chain ▸ Integration Status&apos;)' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_450008138454843392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='% GMV' datatype='real' name='[Calculation_450008138454876161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([valid_gmv_eur]) / &#10;&#10;ZN(&#10;IF     [Parameters].[Parameter 4] IN (&apos;APAC&apos;) THEN SUM([valid_gmv_eur])&#10;&#10;ELSEIF  [Parameters].[Parameter 4] IN (&apos;Integration Status&apos;, &apos;Pelican Status&apos;, &apos;POS Status&apos;, &apos;Country&apos;, &apos;Vertical&apos;, &apos;Chain&apos;, &apos;Managed Account&apos;) //THEN SUM([Valid Gmv Eur])&#10;THEN SUM({EXCLUDE [Calculation_1075445537741946881]: SUM([valid_gmv_eur])})&#10;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Integration Status&apos;, &#10;                         &apos;Country ▸ Vertical&apos;,&#10;                         &apos;Country ▸ Chain&apos;,&#10;                         &apos;Country ▸ Pelican Status&apos;, &#10;                         &apos;Country ▸ POS Status&apos;, &#10;                         &apos;Country ▸ Managed Account&apos;, &#10;                         &apos;Vertical ▸ Integration Status&apos;,&#10;                         &apos;Vertical ▸ Pelican Status&apos;,&#10;                         &apos;Vertical ▸ POS Status&apos;,&#10;                         &apos;Vertical ▸ Country&apos;,&#10;                         &apos;Vertical ▸ Chain&apos;,&#10;                         &apos;Chain ▸ Integration Status&apos;,&#10;                         &apos;Chain ▸ Pelican Status&apos;,&#10;                         &apos;Chain ▸ POS Status&apos;) &#10;THEN SUM({EXCLUDE [Perspective #1 (copy)_1413496969084428289]: SUM([valid_gmv_eur])})&#10;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Chain ▸ Integration Status&apos;, &#10;                          &apos;Country ▸ Vertical ▸ Integration Status&apos;, &#10;                          &apos;Country ▸ Chain ▸ Pelican Status&apos;,&#10;                          &apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                          &apos;Country ▸ Chain ▸ POS Status&apos;,&#10;                          &apos;Country ▸ Vertical ▸ POS Status&apos;) &#10;THEN SUM({EXCLUDE [Persp #2 (copy)_1075445539109261317]: SUM([valid_gmv_eur])})&#10;&#10;END&#10;)' />
      </column>
      <column caption='Managed Account' datatype='string' name='[Calculation_4654962823809421312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_strategic_account]THEN &quot;True&quot; ELSE &quot;False&quot; END' />
      </column>
      <column caption='Items Not Delivered Orders: Ordered Quantity' datatype='integer' name='[Calculation_4899705331398172672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN(num_of_valid_ordered_quantity)) + SUM(ZN(num_of_failed_vendor_product_unavailable_ordered_quantity))' />
      </column>
      <column caption='% Final IR Eligible GFV Saved' datatype='real' default-format='p0.0%' name='[Calculation_5176043371550642176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([final_replacement_gfv_saved_eur]) / SUM([ir_eligible_gfv_eur])' />
      </column>
      <column caption='Valid Delivered Quantity' datatype='integer' name='[Calculation_5730267637456793600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([num_of_valid_delivered_quantity]))' />
      </column>
      <column caption='Valid Ordered Quantity' datatype='integer' name='[Calculation_5730267637456855041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([num_of_valid_ordered_quantity]))' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_6239244721855254529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] IN (&apos;day&apos;, &apos;month&apos;)&#10;    THEN [report_date_local] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;iso-week&apos; &#10;    THEN [report_date_local] &gt;= DATEADD(&apos;iso-week&apos;, -12, DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;END' />
      </column>
      <column caption='SFTP Uploads per Vendor' datatype='real' name='[Calculation_6777073039270752278]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([Num Of Sftp Uploads])&#10;/// &#10;//SUM([Num of Vendors With SFTP Uploads])&#10;&#10;IF [Parameters].[Parameter 1] = &apos;day&apos; &#10;THEN SUM([num_of_sftp_uploads]) / SUM([num_of_vendors_with_sftp_uploads])&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;iso-week&apos; &#10;THEN SUM([num_of_sftp_uploads]) / SUM([num_of_vendors_with_sftp_uploads_weekly])&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;month&apos; &#10;THEN SUM([num_of_sftp_uploads]) / SUM([num_of_vendors_with_sftp_uploads_monthly])&#10;&#10;END' />
      </column>
      <column caption='Active SKU per Vendor' datatype='real' name='[Calculation_6777073039329665053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;day&apos; &#10;THEN SUM([num_of_active_products_daily]) / SUM([num_of_active_vendors_daily])&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;iso-week&apos; &#10;THEN SUM([num_of_active_skus_weekly]) / SUM([num_of_active_vendors_weekly])&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;month&apos; &#10;THEN SUM([num_of_active_skus_monthly]) / SUM([num_of_active_vendors_monthly])&#10;&#10;END' />
      </column>
      <column caption='GFV Loss (€) from Items Not Delivered Orders (incl. Post Delivery)' datatype='real' name='[Calculation_6921540072750837760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([failed_vendor_product_unavailable_gfv_loss_eur]))&#10;+&#10;ZN(SUM([valid_gfv_loss_eur]))' />
      </column>
      <column caption='% GMV Loss from Items Not Delivered Orders' datatype='real' name='[Calculation_6921540072751230977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GFV Loss (€) from Items Not Delivered Orders (incl. Post Delivery) (copy)_2159405719831916547]&#10;/ &#10;SUM([valid_gmv_eur])' />
      </column>
      <column caption='VD Funded Amount (€)' datatype='real' hidden='true' name='[Calculation_81557426754256896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([vd_discount_value_eur]) + ZN([vd_voucher_value_eur])' />
      </column>
      <column caption='FP Funded Amount (€)' datatype='real' hidden='true' name='[Calculation_81557426754387969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([fp_discount_value_eur]) + ZN([fp_voucher_value_eur])' />
      </column>
      <column caption='% Offline Hours' datatype='real' name='[Calculation_941674549888630784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_closed_mins]) / SUM([total_scheduled_open_mins])' />
      </column>
      <column caption='% Offline Hours (excl. Special Days)' datatype='real' name='[Calculation_941674549888950273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_unavailable_mins])/SUM([total_scheduled_open_mins])' />
      </column>
      <column caption='% Fail Rate: F30D' datatype='real' name='[Calculation_981784733035110400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_f30d_failed_orders])/SUM([num_of_f30d_orders])' />
      </column>
      <column caption='% Fail Rate: F30D Vendor' datatype='real' name='[Calculation_981784733035667457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_f30d_failed_vendor_orders])/SUM([num_of_f30d_orders])' />
      </column>
      <column caption='% Fail Rate: F90D' datatype='real' name='[Calculation_981784733036109826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_f90d_failed_orders])/SUM([num_of_f90d_orders])' />
      </column>
      <column caption='% Fail Rate: F90D Vendor' datatype='real' name='[Calculation_981784733036249091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_f90d_failed_vendor_orders])/SUM([num_of_f90d_orders])' />
      </column>
      <column caption='% Items Not Delivered Orders (incl. Post Delivery)' datatype='real' name='[Calculation_981784733037637638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([num_of_partially_fulfilled_orders])) + ZN(SUM([num_of_failed_vendor_product_unavailable])))&#10;/&#10;(ZN(SUM([num_of_valid_orders])) + ZN(SUM([num_of_failed_vendor_product_unavailable])))' />
      </column>
      <column caption='% Items Not Delivered (incl. Post Delivery)' datatype='real' default-format='p0.0%' name='[Calculation_981784733037948935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;(SUM([num_of_valid_ordered_quantity]) + SUM([num_of_failed_vendor_product_unavailable_ordered_quantity]))&#10;-&#10;(SUM([num_of_valid_delivered_quantity]))&#10;)&#10;/&#10;ZN(SUM([num_of_valid_ordered_quantity]) + SUM([num_of_failed_vendor_product_unavailable_ordered_quantity]))' />
      </column>
      <column caption='Core SKU % Items Not Delivered' datatype='real' default-format='p0.0%' name='[Core SKU % Items Not Delivered (copy)_1137651530959904771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(SUM(ZN(num_of_core_sku_valid_ordered_quantity)) + SUM(ZN(num_of_core_sku_failed_vendor_product_unavailable_ordered_quantity)))&#10;-&#10;(SUM(ZN(num_of_core_sku_valid_sent_quantity)))&#10;)&#10;/&#10;(SUM(ZN(num_of_core_sku_valid_ordered_quantity)) + SUM(ZN(num_of_core_sku_failed_vendor_product_unavailable_ordered_quantity)))' />
      </column>
      <column caption='New Item % Items Not Delivered' datatype='real' default-format='p0.0%' name='[Core SKU % Items Not Delivered (copy)_1137651530960433156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(SUM(ZN(num_of_f30d_product_valid_ordered_quantity)) + SUM(ZN(num_of_f30d_product_failed_vendor_product_unavailable_ordered_quantity)))&#10;-&#10;(SUM(ZN(num_of_f30d_product_valid_sent_quantity)))&#10;)&#10;/&#10;(SUM(ZN(num_of_f30d_product_valid_ordered_quantity)) + SUM(ZN(num_of_f30d_product_failed_vendor_product_unavailable_ordered_quantity)))' />
      </column>
      <column caption='Zombie Items % Items Not Delivered' datatype='real' default-format='p0.0%' name='[Core SKU % Items Not Delivered (incl. Post Delivery) (copy)_2159405719831916545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(SUM(ZN(num_of_l30d_zombie_product_valid_ordered_quantity)) + SUM(ZN(num_of_l30d_zombie_product_failed_vendor_product_unavailable_ordered_quantity)))&#10;-&#10;(SUM(ZN(num_of_l30d_zombie_product_valid_sent_quantity)))&#10;)&#10;/&#10;(SUM(ZN(num_of_l30d_zombie_product_valid_ordered_quantity)) + SUM(ZN(num_of_l30d_zombie_product_failed_vendor_product_unavailable_ordered_quantity)))' />
      </column>
      <column caption='GFV Loss (€) from Items Not Delivered Orders' datatype='real' name='[GFV Loss (€) from Items Not Delivered Orders (incl. Post Delivery) (copy)_2159405719831916547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([failed_vendor_product_unavailable_gfv_loss_eur]))&#10;+&#10;ZN(SUM([gfv_loss_excl_post_delivery_eur]))' />
      </column>
      <column caption='Items Not Delivered Orders (incl. Post Delivery)' datatype='integer' name='[GFV Loss (€) from OOS Orders (copy)_6921540072751685634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([num_of_partially_fulfilled_orders]))&#10;+&#10;ZN(SUM([num_of_failed_vendor_product_unavailable]))' />
      </column>
      <column caption='Wastages: Picked Up Orders ' datatype='integer' hidden='true' name='[GMV (€) (copy)_6777073039314182169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] IN (&apos;Integration Status&apos;,&#10;                     &apos;Country ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                     &apos;Vertical ▸ Integration Status&apos;) &#10;    AND ([Calculation_1075445537741946881] = &apos;Not Integrated&apos; OR [Perspective #1 (copy)_1413496969084428289] = &apos;Not Integrated&apos; OR [Persp #2 (copy)_1075445539109261317] = &apos;Not Integrated&apos;) &#10;    THEN [delivery_picked_up_wastage_orders]&#10;&#10;ELSEIF  [Parameters].[Parameter 4] IN (&apos;Integration Status&apos;,&#10;                     &apos;Country ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                     &apos;Vertical ▸ Integration Status&apos;) &#10;    THEN [delivery_picked_up_wastage_integrated_orders]&#10;&#10;ELSEIF &#10;    [Parameters].[Parameter 4] IN (&apos;Pelican Status&apos;,&#10;                     &apos;Country ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                     &apos;Vertical ▸ Pelican Status&apos;) &#10;    AND ([Calculation_1075445537741946881] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;) OR [Perspective #1 (copy)_1413496969084428289] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;) OR [Persp #2 (copy)_1075445539109261317] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;)) &#10;    THEN [delivery_picked_up_wastage_orders]&#10;&#10;ELSEIF &#10;    [Parameters].[Parameter 4] IN (&apos;Pelican Status&apos;,&#10;                     &apos;Country ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                     &apos;Vertical ▸ Pelican Status&apos;)&#10;    THEN [delivery_picked_up_wastage_pelican_orders]&#10;&#10;ELSE [delivery_picked_up_wastage_orders] END' />
      </column>
      <column caption='Items Not Delivered Orders: Sent Quantity' datatype='integer' name='[IND: Ordered Quantity (copy)_4899705331398459393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN(num_of_valid_sent_quantity))' />
      </column>
      <column caption='Items Not Delivered Orders: IND Quantity' datatype='integer' name='[IND: Sent Quantity (copy)_4899705331398639618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(ZN(num_of_valid_ordered_quantity)) + SUM(ZN(num_of_failed_vendor_product_unavailable_ordered_quantity)))&#10;-&#10;(SUM(ZN(num_of_valid_sent_quantity)))' />
      </column>
      <column caption='IR Impact on % Items Not Delivered' datatype='real' default-format='p0.0%' name='[IR Impact on % Found Rate (copy)_1137651530961489927]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% Items Not Delivered (incl. Post Delivery) (copy)_2159405719831916550] - &#10;(&#10;SUM([num_of_valid_pre_ir_ordered_quantity]) + SUM([num_of_failed_vendor_product_unavailable_ordered_quantity])&#10;- SUM([num_of_valid_pre_ir_sent_quantity])&#10;)&#10;&#10;/ SUM([num_of_valid_pre_ir_ordered_quantity])' />
      </column>
      <column caption='IR Impact on % Partial Order' datatype='real' default-format='p0.0%' name='[IR Impact on % Found Rate (copy)_2163275953713643521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_valid_fulfilled_replacement_order])&#10;/ SUM([num_of_valid_orders])' />
      </column>
      <column caption='IR Impact on % Found Rate' datatype='real' default-format='p0.0%' name='[IR Impact on % Found Rate (incl. Post Delivery) (copy)_2159405719835901963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% Found Rate (incl. Post Delivery) (copy)_2159405719835725834] - &#10;(SUM([num_of_valid_pre_ir_delivered_quantity]) / SUM([num_of_valid_pre_ir_ordered_quantity]))' />
      </column>
      <column caption='Items Not Delivered Orders' datatype='integer' name='[Items Not Delivered Orders (incl. Post Delivery) (copy)_2159405719831916551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([num_of_partially_fulfilled_excl_post_delivery_orders]))&#10;+&#10;ZN(SUM([num_of_failed_vendor_product_unavailable]))' />
      </column>
      <column caption='Avg Items Not Delivered per Partial Order (incl. Post Delivery)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[OOS Orders (copy)_4621185830077804544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;ZN(SUM([num_of_valid_ordered_quantity]))&#10;-&#10;ZN(SUM([num_of_valid_delivered_quantity]))&#10;)&#10;/&#10;ZN(SUM([num_of_partially_fulfilled_orders]))' />
      </column>
      <column caption='Persp #2 Filter' datatype='string' name='[Persp #1 Filter (copy)_2652268341934919685]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP(ATTR([Perspective #1 (copy)_1413496969084428289]), 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Persp #3' datatype='string' name='[Persp #2 (copy)_1075445539109261317]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// 1-2 PERSPECTIVE&#10;IF     [Parameters].[Parameter 4] IN (&apos;APAC&apos;,&#10;                         &apos;Country&apos;,&#10;                         &apos;Chain&apos;,&#10;                         &apos;Vertical&apos;,&#10;                         &apos;Integration Status&apos;,&#10;                         &apos;Pelican Status&apos;,&#10;                         &apos;POS Status&apos;,&#10;                         &apos;Managed Account&apos;,&#10;                         &apos;Country ▸ Chain&apos;,&#10;                         &apos;Country ▸ Managed Account&apos;,&#10;                         &apos;Country ▸ Vertical&apos;, &#10;                         &apos;Country ▸ Integration Status&apos;,&#10;                         &apos;Country ▸ Pelican Status&apos;,&#10;                         &apos;Country ▸ POS Status&apos;,&#10;                         &apos;Vertical ▸ Chain&apos;,&#10;                         &apos;Vertical ▸ Country&apos;,&#10;                         &apos;Vertical ▸ Integration Status&apos;,&#10;                         &apos;Vertical ▸ Pelican Status&apos;,&#10;                         &apos;Vertical ▸ POS Status&apos;,&#10;                         &apos;Chain ▸ Integration Status&apos;,&#10;                         &apos;Chain ▸ Pelican Status&apos;,&#10;                         &apos;Chain ▸ POS Status&apos;&#10;                        )&#10;THEN &apos;All&apos;&#10;&#10;// 3 PERSPECTIVE: Integration&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                         &apos;Country ▸ Chain ▸ Integration Status&apos;) &#10;    AND [is_sftp_vendor] = FALSE &#10;    AND [is_api_vendor] = FALSE &#10;THEN &apos;Not Integrated&apos;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                         &apos;Country ▸ Chain ▸ Integration Status&apos;) AND [is_sftp_vendor] THEN &apos;SFTP Integrated&apos;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                         &apos;Country ▸ Chain ▸ Integration Status&apos;) AND [is_api_vendor] THEN &apos;API Integrated&apos;&#10;&#10;&#10;// 3 PERSPECTIVE: Pelican&#10;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                         &apos;Country ▸ Chain ▸ Pelican Status&apos;) &#10;    AND [is_pelican_order] THEN &apos;Pelican&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                         &apos;Country ▸ Chain ▸ Pelican Status&apos;) &#10;    AND NOT [is_pelican_order] THEN &apos;Godroid&apos;&#10;&#10;// 3 PERSPECTIVE: POS&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Vertical ▸ POS Status&apos;,&#10;                         &apos;Country ▸ Chain ▸ POS Status&apos;) &#10;    AND [is_pos_vendor] = FALSE THEN &apos;Non POS Integrated&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Vertical ▸ POS Status&apos;,&#10;                         &apos;Country ▸ Chain ▸ POS Status&apos;) &#10;    AND [is_pos_vendor] = TRUE THEN &apos;POS Integrated&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Vertical ▸ Chain&apos;,&#10;                         &apos;Vertical ▸ Country ▸ Chain&apos;)&#10;THEN [Calculation_2724396325008797696]&#10;END' />
      </column>
      <column caption='Persp #3 Filter' datatype='string' name='[Persp #2 Filter (copy)_1075445539111919622]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP(ATTR([Persp #2 (copy)_1075445539109261317]), 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Persp #2' datatype='string' name='[Perspective #1 (copy)_1413496969084428289]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// 1 PERSPECTIVE&#10;IF     [Parameters].[Parameter 4] IN (&apos;APAC&apos;,&#10;                         &apos;Country&apos;,&#10;                         &apos;Vertical&apos;,&#10;                         &apos;Chain&apos;,&#10;                         &apos;Managed Account&apos;,&#10;                         &apos;Integration Status&apos;,&#10;                         &apos;Pelican Status&apos;,&#10;                         &apos;POS Status&apos;&#10;                        )&#10;THEN &apos;All&apos;&#10;&#10;// &gt;=2 PERSPECTIVE&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Vertical ▸ Country&apos;,&#10;                         &apos;Vertical ▸ Country ▸ Chain&apos;)&#10;THEN [name]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Country ▸ Managed Account&apos; THEN [Calculation_4654962823809421312]&#10;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Vertical&apos;, &#10;                         &apos;Country ▸ Vertical ▸ Chain&apos;,&#10;                         &apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                         &apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                         &apos;Country ▸ Vertical ▸ POS Status&apos;)&#10;THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Chain&apos;,&#10;                         &apos;Country ▸ Chain ▸ Integration Status&apos;,&#10;                         &apos;Country ▸ Chain ▸ Pelican Status&apos;,&#10;                         &apos;Country ▸ Chain ▸ POS Status&apos;,&#10;                         &apos;Vertical ▸ Chain&apos;)&#10;THEN [Calculation_2724396325008797696]&#10;&#10;//  &gt;=2 PERSPECTIVE: Integration&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Integration Status&apos;,&#10;                         &apos;Vertical ▸ Integration Status&apos;,&#10;                         &apos;Chain ▸ Integration Status&apos;) &#10;    AND [is_sftp_vendor] = FALSE &#10;    AND [is_api_vendor] = FALSE &#10;THEN &apos;Not Integrated&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Integration Status&apos;,&#10;                         &apos;Vertical ▸ Integration Status&apos;,&#10;                         &apos;Chain ▸ Integration Status&apos;)  AND [is_sftp_vendor] &#10;THEN &apos;SFTP Integrated&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Integration Status&apos;,&#10;                         &apos;Vertical ▸ Integration Status&apos;,&#10;                         &apos;Chain ▸ Integration Status&apos;)  AND [is_api_vendor] &#10;THEN &apos;API Integrated&apos;&#10;&#10;&#10;//  &gt;=2 PERSPECTIVE: Pelican&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Pelican Status&apos;,&#10;                         &apos;Vertical ▸ Pelican Status&apos;,&#10;                         &apos;Chain ▸ Pelican Status&apos;) &#10;    AND [is_pelican_order] THEN &apos;Pelican&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ Pelican Status&apos;,&#10;                         &apos;Vertical ▸ Pelican Status&apos;,&#10;                         &apos;Chain ▸ Pelican Status&apos;) &#10;    AND NOT [is_pelican_order] THEN &apos;Godroid&apos;&#10;&#10;//  &gt;=2 PERSPECTIVE: POS&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ POS Status&apos;,&#10;                         &apos;Vertical ▸ POS Status&apos;,&#10;                         &apos;Chain ▸ POS Status&apos;)  AND [is_pos_vendor] THEN &apos;POS Integrated&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 4] IN (&apos;Country ▸ POS Status&apos;,&#10;                         &apos;Vertical ▸ POS Status&apos;,&#10;                         &apos;Chain ▸ POS Status&apos;)  AND NOT [is_pos_vendor] THEN &apos;Non POS Integrated&apos;&#10;&#10;END' />
      </column>
      <column caption='Perspective = Pelican' datatype='boolean' hidden='true' name='[Perspective = Integration (copy)_2724396325245755394]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4] IN (&apos;Pelican Status&apos;,&#10;                     &apos;Country ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                     &apos;Vertical ▸ Pelican Status&apos;,&#10;                     &apos;Chain ▸ Pelican Status&apos;)' />
      </column>
      <column caption='Perspective = POS' datatype='boolean' hidden='true' name='[Perspective = Integration (copy)_6239244721856913410]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4] IN (&apos;POS Status&apos;,&#10;                     &apos;Country ▸ POS Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ POS Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ POS Status&apos;,&#10;                     &apos;Vertical ▸ POS Status&apos;,&#10;                     &apos;Chain ▸ POS Status&apos;)' />
      </column>
      <column caption='Assignment Time' datatype='real' name='[Prep Time (copy)_1121466701239726087]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_accepting_time_mins])&#10;/&#10;SUM(&#10;IF NOT [is_pelican_order] THEN [num_of_valid_completed_non_preorders]&#10;ELSE [num_of_accurate_non_preorder_picked_orders]&#10;END&#10;)' />
      </column>
      <column caption='API Uploads per Vendor' datatype='real' name='[SFTP Uploads per Vendor (copy)_3338082168680751104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([Num Of Sftp Uploads])&#10;/// &#10;//SUM([Num of Vendors With SFTP Uploads])&#10;&#10;IF [Parameters].[Parameter 1] = &apos;day&apos; &#10;THEN SUM([num_of_api_uploads]) / SUM([num_of_vendors_with_api_uploads])&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;iso-week&apos; &#10;THEN SUM([num_of_api_uploads]) / SUM([num_of_vendors_with_api_uploads_weekly])&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;month&apos; &#10;THEN SUM([num_of_api_uploads]) / SUM([num_of_vendors_with_api_uploads_monthly])&#10;&#10;END' />
      </column>
      <column caption='Wastages: Not Picked Up (€) ' datatype='real' hidden='true' name='[Wastages: Not Picked Up Orders (copy)_6777073039320711196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] IN (&apos;Integration Status&apos;,&#10;                     &apos;Country ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                     &apos;Vertical ▸ Integration Status&apos;) &#10;    AND ([Calculation_1075445537741946881] = &apos;Not Integrated&apos; OR [Perspective #1 (copy)_1413496969084428289] = &apos;Not Integrated&apos; OR [Persp #2 (copy)_1075445539109261317] = &apos;Not Integrated&apos;) &#10;    THEN [delivery_not_picked_up_wastage_eur]&#10;&#10;ELSEIF  [Parameters].[Parameter 4] IN (&apos;Integration Status&apos;,&#10;                     &apos;Country ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                     &apos;Vertical ▸ Integration Status&apos;) &#10;    THEN [delivery_not_picked_up_wastage_integrated_eur]&#10;&#10;ELSEIF &#10;    [Parameters].[Parameter 4] IN (&apos;Pelican Status&apos;,&#10;                     &apos;Country ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                     &apos;Vertical ▸ Pelican Status&apos;) &#10;    AND ([Calculation_1075445537741946881] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;) OR [Perspective #1 (copy)_1413496969084428289] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;) OR [Persp #2 (copy)_1075445539109261317] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;)) &#10;    THEN [delivery_not_picked_up_wastage_eur]&#10;&#10;ELSEIF &#10;    [Parameters].[Parameter 4] IN (&apos;Pelican Status&apos;,&#10;                     &apos;Country ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                     &apos;Vertical ▸ Pelican Status&apos;)&#10;    THEN [delivery_not_picked_up_wastage_pelican_eur]&#10;&#10;ELSE [delivery_not_picked_up_wastage_eur] END' />
      </column>
      <column caption='Wastages: Not Picked Up Orders' datatype='integer' hidden='true' name='[Wastages: Picked Up Orders  (copy)_6777073039319662618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] IN (&apos;Integration Status&apos;,&#10;                     &apos;Country ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                     &apos;Vertical ▸ Integration Status&apos;) &#10;    AND ([Calculation_1075445537741946881] = &apos;Not Integrated&apos; OR [Perspective #1 (copy)_1413496969084428289] = &apos;Not Integrated&apos; OR [Persp #2 (copy)_1075445539109261317] = &apos;Not Integrated&apos;) &#10;    THEN [delivery_not_picked_up_wastage_orders]&#10;&#10;ELSEIF  [Parameters].[Parameter 4] IN (&apos;Integration Status&apos;,&#10;                     &apos;Country ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                     &apos;Vertical ▸ Integration Status&apos;) &#10;    THEN [delivery_not_picked_up_wastage_integrated_orders]&#10;&#10;ELSEIF &#10;    [Parameters].[Parameter 4] IN (&apos;Pelican Status&apos;,&#10;                     &apos;Country ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                     &apos;Vertical ▸ Pelican Status&apos;) &#10;    AND ([Calculation_1075445537741946881] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;) OR [Perspective #1 (copy)_1413496969084428289] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;) OR [Persp #2 (copy)_1075445539109261317] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;)) &#10;    THEN [delivery_not_picked_up_wastage_orders]&#10;&#10;ELSEIF &#10;    [Parameters].[Parameter 4] IN (&apos;Pelican Status&apos;,&#10;                     &apos;Country ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                     &apos;Vertical ▸ Pelican Status&apos;)&#10;    THEN [delivery_not_picked_up_wastage_pelican_orders]&#10;&#10;ELSE [delivery_not_picked_up_wastage_orders] END' />
      </column>
      <column caption='Wastages: Picked Up Orders (€)' datatype='real' hidden='true' name='[Wastages: Picked Up Orders  (copy)_6777073039320711195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] IN (&apos;Integration Status&apos;,&#10;                     &apos;Country ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                     &apos;Vertical ▸ Integration Status&apos;) &#10;    AND ([Calculation_1075445537741946881] = &apos;Not Integrated&apos; OR [Perspective #1 (copy)_1413496969084428289] = &apos;Not Integrated&apos; OR [Persp #2 (copy)_1075445539109261317] = &apos;Not Integrated&apos;) &#10;    THEN [delivery_picked_up_wastage_eur]&#10;&#10;ELSEIF  [Parameters].[Parameter 4] IN (&apos;Integration Status&apos;,&#10;                     &apos;Country ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Integration Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Integration Status&apos;,&#10;                     &apos;Vertical ▸ Integration Status&apos;) &#10;    THEN [delivery_picked_up_wastage_integrated_eur]&#10;&#10;ELSEIF &#10;    [Parameters].[Parameter 4] IN (&apos;Pelican Status&apos;,&#10;                     &apos;Country ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Chain ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ Vertical ▸ Pelican Status&apos;,&#10;                     &apos;Vertical ▸ Pelican Status&apos;) &#10;    AND ([Calculation_1075445537741946881] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;) OR [Perspective #1 (copy)_1413496969084428289] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;) OR [Persp #2 (copy)_1075445539109261317] IN (&apos;Non Pelican&apos;, &apos;Partial Pelican&apos;)) &#10;    THEN [delivery_picked_up_wastage_eur]&#10;&#10;ELSEIF &#10;    [Parameters].[Parameter 4] IN (&apos;Pelican Status&apos;,&#10;                     &apos;Country ▸ Pelican Status&apos;,&#10;                     &apos;Country ▸ C