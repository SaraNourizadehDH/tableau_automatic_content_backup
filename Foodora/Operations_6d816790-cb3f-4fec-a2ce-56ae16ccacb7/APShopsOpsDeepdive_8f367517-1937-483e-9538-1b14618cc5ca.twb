        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1hahxdg0s650l01b9xnj2115nqrs' name='Custom SQL Query' type='text'>SELECT
  report_month_local,
  global_entity_id,
  country_name,
  &apos;Fully Fulfilled&apos; AS metric_type,
  num_of_valid_orders,
  num_of_subsidized_orders,
  delivered_commission_per_order_eur,
  delivery_fee_per_order_eur,
  delivery_fee_without_vat_per_order_eur,
  subsidy_per_order_eur,
  delivered_gfv_per_order_eur,
  avg_num_of_delivered_quantity,
  avg_num_of_delivered_unique_products,
  avg_effective_commission_rate
FROM `fulfillment-dwh-production.pandata_report.regional_apac_shops__partial_order_impact_dashboard`
WHERE NOT is_partial

UNION ALL

SELECT
  report_month_local,
  global_entity_id,
  country_name,
  &apos;Delivered Partial&apos; AS metric_type,
  num_of_valid_orders,
  num_of_subsidized_orders,
  delivered_commission_per_order_eur,
  delivery_fee_per_order_eur,
  delivery_fee_without_vat_per_order_eur,
  subsidy_per_order_eur,
  delivered_gfv_per_order_eur,
  avg_num_of_delivered_quantity,
  avg_num_of_delivered_unique_products,
  avg_effective_commission_rate
FROM `fulfillment-dwh-production.pandata_report.regional_apac_shops__partial_order_impact_dashboard`
WHERE is_partial

UNION ALL

SELECT
  report_month_local,
  global_entity_id,
  country_name,
  &apos;Ordered Partial&apos; AS metric_type,
  num_of_valid_orders,
  num_of_subsidized_orders,
  ordered_commission_per_order_eur,
  delivery_fee_per_order_eur,
  delivery_fee_without_vat_per_order_eur,
  subsidy_per_order_eur,
  ordered_gfv_per_order_eur,
  avg_num_of_ordered_quantity,
  avg_num_of_ordered_unique_products,
  avg_effective_commission_rate
FROM `fulfillment-dwh-production.pandata_report.regional_apac_shops__partial_order_impact_dashboard`
WHERE is_partial

UNION ALL

SELECT
  report_month_local,
  global_entity_id,
  country_name,
  &apos;Diff Partial&apos; AS metric_type,
  0 AS num_of_valid_orders,
  0 AS num_of_subsidized_orders,
  ordered_commission_per_order_eur - delivered_commission_per_order_eur,
  0 AS delivery_fee_per_order_eur,
