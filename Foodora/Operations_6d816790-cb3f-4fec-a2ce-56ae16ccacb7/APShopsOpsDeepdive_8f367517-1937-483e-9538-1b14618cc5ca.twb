              <calculation class='tableau' formula='(ZN(SUM([num_of_partially_fulfilled_excl_post_delivery_orders])) + ZN(SUM([num_of_failed_vendor_product_unavailable])))&#10;/&#10;(ZN(SUM([num_of_valid_orders])) + ZN(SUM([num_of_failed_vendor_product_unavailable])))' />
            </column>
            <column caption='% Items Not Delivered from Zombie Items' datatype='real' default-format='p0.0%' name='[% Items Not Delivered from Core SKU (copy)_1137651530959540225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(ZN([num_of_l30d_zombie_product_valid_ordered_quantity])) + SUM(ZN(num_of_l30d_zombie_product_failed_vendor_product_unavailable_ordered_quantity)))&#10;-&#10;(SUM(ZN(num_of_l30d_zombie_product_valid_sent_quantity)))&#10;)&#10;/&#10;(&#10;(SUM(ZN([num_of_valid_ordered_quantity])) + SUM(ZN([num_of_failed_vendor_product_unavailable_ordered_quantity])))&#10;-&#10;(SUM(ZN([num_of_valid_sent_quantity])))&#10;)' />
