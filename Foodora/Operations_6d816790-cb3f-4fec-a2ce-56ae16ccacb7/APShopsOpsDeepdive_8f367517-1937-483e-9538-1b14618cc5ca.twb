  0 AS subsidy_per_order_eur,
  ordered_gfv_per_order_eur - delivered_gfv_per_order_eur,
  avg_num_of_ordered_quantity - avg_num_of_delivered_quantity,
  avg_num_of_ordered_unique_products - avg_num_of_delivered_unique_products,
  0 AS avg_effective_commission_rate
FROM `fulfillment-dwh-production.pandata_report.regional_apac_shops__partial_order_impact_dashboard`
WHERE is_partial</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
