            <column caption='% Found Rate' datatype='real' default-format='p0.0%' name='[% Found Rate (incl. Post Delivery) (copy)_2159405719835725834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([num_of_valid_sent_quantity]))&#10;&#10;/&#10;&#10;SUM(ZN([num_of_valid_ordered_quantity]))' />
