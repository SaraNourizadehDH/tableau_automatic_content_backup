        <calculation class='tableau' formula='IF [Parameters].[Parameter 12] IN (&apos;Country ▸ Chain ▸ Decline Reason&apos;) THEN [Calculation_834854787921477644]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Vendor ▸ Decline Reason&apos;) THEN [Calculation_834854787921477644]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Chain ▸ Vendor&apos;,&apos;Country ▸ Chain ▸ Vendor ▸ Decline Reason&apos;) THEN [vendor_name]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Vendor ▸ Pelican Status ▸ Decline Reason&apos;) THEN [Calculation_3455597921250607110]&#10;ELSE &apos;All&apos;&#10;END' />
