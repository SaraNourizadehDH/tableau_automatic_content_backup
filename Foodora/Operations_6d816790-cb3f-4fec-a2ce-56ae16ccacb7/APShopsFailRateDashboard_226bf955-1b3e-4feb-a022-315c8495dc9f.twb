              <calculation class='tableau' formula='IF&#10;(IF [Parameters].[Parameter 12] IN (&apos;Cancellation Type&apos;,&apos;Decline Reason&apos;)&#10;THEN SUM(ZN([num_of_failed_orders]))/ATTR({EXCLUDE([Calculation_3455597921250873351]): SUM([num_of_orders])})&#10;&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Cancellation Type&apos;,&apos;Country ▸ Decline Reason&apos;)&#10;THEN SUM(ZN([num_of_failed_orders]))/ATTR({EXCLUDE([Calculation_3455597921251700745]): SUM([num_of_orders])})&#10;&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Chain ▸ Decline Reason&apos;,&apos;Country ▸ Vendor ▸ Decline Reason&apos;)&#10;THEN SUM(ZN([num_of_failed_orders]))/ATTR({EXCLUDE([Persp #2 (copy)_4374332247627890689]): SUM([num_of_orders])})&#10;&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Chain ▸ Vendor ▸ Decline Reason&apos;)&#10;THEN SUM(ZN([num_of_failed_orders]))/ATTR({EXCLUDE([Persp #3 (copy)_4374332247629766658]): SUM([num_of_orders])})&#10;&#10;ELSE SUM(ZN([num_of_failed_orders]))/SUM(ZN([num_of_orders]))&#10;END) = 0&#10;THEN NULL &#10;ELSE &#10;(IF [Parameters].[Parameter 12] IN (&apos;Cancellation Type&apos;,&apos;Decline Reason&apos;)&#10;THEN SUM(ZN([num_of_failed_orders]))/ATTR({EXCLUDE([Calculation_3455597921250873351]): SUM([num_of_orders])})&#10;&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Cancellation Type&apos;,&apos;Country ▸ Decline Reason&apos;)&#10;THEN SUM(ZN([num_of_failed_orders]))/ATTR({EXCLUDE([Calculation_3455597921251700745]): SUM([num_of_orders])})&#10;&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Chain ▸ Decline Reason&apos;,&apos;Country ▸ Vendor ▸ Decline Reason&apos;)&#10;THEN SUM(ZN([num_of_failed_orders]))/ATTR({EXCLUDE([Persp #2 (copy)_4374332247627890689]): SUM([num_of_orders])})&#10;&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Chain ▸ Vendor ▸ Decline Reason&apos;)&#10;THEN SUM(ZN([num_of_failed_orders]))/ATTR({EXCLUDE([Persp #3 (copy)_4374332247629766658]): SUM([num_of_orders])})&#10;&#10;ELSE SUM(ZN([num_of_failed_orders]))/SUM(ZN([num_of_orders]))&#10;END)&#10;END' />
            </column>
            <column caption='Integration Status' datatype='string' hidden='true' name='[Calculation_3455597921250426885]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [is_sftp_vendor] THEN &quot;SFTP Integrated&quot;&#10;ELSEIF [is_pos_vendor] THEN &quot;POS Integrated&quot;&#10;ELSE &quot;Not Integrated&quot; &#10;END' />
            </column>
            <column caption='Pelican Status' datatype='string' hidden='true' name='[Calculation_3455597921250607110]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_511510439060750336]' />
            </column>
            <column caption='Persp #1' datatype='string' name='[Calculation_3455597921250873351]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// 1 PERSPECTIVE&#10;IF     [Parameters].[Parameter 12] = &apos;APAC&apos; THEN &apos;APAC&apos;&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Vertical&apos; THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Chain&apos; THEN [chain_name]&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Integration Status&apos; THEN [Calculation_3455597921250426885]&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Pelican Status&apos; THEN [Calculation_3455597921250607110]&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Delivery Type&apos; THEN [delivery_type]&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Cancellation Type&apos; THEN [cancellation_type]&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Decline Reason&apos; THEN [Calculation_834854787921477644]&#10;&#10;// &gt;= 2 PERSPECTIVE&#10;&#10;ELSE [country_name]&#10;END' />
            </column>
            <column caption='Persp #2' datatype='string' name='[Calculation_3455597921251700745]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// 1 PERSPECTIVE&#10;IF     [Parameters].[Parameter 12] IN (&apos;APAC&apos;,&#10;                         &apos;Country&apos;,&#10;                         &apos;Vertical&apos;,&#10;                         &apos;Chain&apos;,&#10;                         &apos;Integration Status&apos;,&#10;                         &apos;Pelican Status&apos;,&#10;                         &apos;Delivery Type&apos;,&#10;                         &apos;Cancellation Type&apos;,&#10;                         &apos;Decline Reason&apos;)&#10;THEN &apos;All&apos;&#10;&#10;// &gt;= 2 PERSPECTIVE&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Vertical&apos;) THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Chain&apos;,&apos;Country ▸ Chain ▸ Vendor&apos;,&apos;Country ▸ Chain ▸ Decline Reason&apos;,&apos;Country ▸ Chain ▸ Vendor ▸ Decline Reason&apos;) THEN [chain_name]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Integration Status&apos;) THEN [Calculation_3455597921250426885]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Pelican Status&apos;) THEN [Calculation_3455597921250607110]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Delivery Type&apos;) THEN [delivery_type]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Cancellation Type&apos;) THEN [cancellation_type]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Decline Reason&apos;) THEN [Calculation_834854787921477644]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Decline Reason Type ▸ Decline Reason&apos;) THEN [Calculation_834854787921477644]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Vendor ▸ Decline Reason&apos;, &apos;Country ▸ Vendor ▸ Pelican Status ▸ Decline Reason&apos;) THEN [vendor_name]&#10;&#10;END' />
            </column>
            <column caption='Persp #1 Filter' datatype='string' name='[Calculation_3455597921260396557]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LOOKUP(ATTR([Calculation_3455597921250873351]), 0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Is Pelican Vendor' datatype='string' hidden='true' name='[Calculation_511510439060750336]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_shops_pelican_order] THEN &quot;Pelican&quot; Else &quot;Godroid&quot; END' />
            </column>
            <column caption='Decline Reason' datatype='string' name='[Calculation_834854787921477644]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [decline_reason_type] = &apos;VENDOR&apos; THEN REGEXP_REPLACE(REGEXP_EXTRACT([decline_reason_code],&apos;^VENDOR_(\S+)&apos;),&apos;_&apos;,&apos; &apos;)&#10;ELSEIF [decline_reason_type] = &apos;TRAFFIC_MANAGER&apos; THEN REGEXP_REPLACE(REGEXP_EXTRACT([decline_reason_code],&apos;^TRAFFIC_MANAGER_(\S+)&apos;),&apos;_&apos;,&apos; &apos;)&#10;ELSEIF [decline_reason_type] = &apos;CUSTOMER&apos; THEN REGEXP_REPLACE(REGEXP_EXTRACT([decline_reason_code],&apos;^CUSTOMER_(\S+)&apos;),&apos;_&apos;,&apos; &apos;)&#10;ELSEIF [decline_reason_type] = &apos;POST_DELIVERY&apos; THEN REGEXP_REPLACE(REGEXP_EXTRACT([decline_reason_code],&apos;^POST_DELIVERY_(\S+)&apos;),&apos;_&apos;,&apos; &apos;)&#10;END' />
            </column>
            <column caption='Persp #2 Filter' datatype='string' name='[Persp #1 Filter (copy)_3455597921260453902]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LOOKUP(ATTR([Calculation_3455597921251700745]), 0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Persp #3' datatype='string' name='[Persp #2 (copy)_4374332247627890689]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 12] IN (&apos;Country ▸ Chain ▸ Decline Reason&apos;) THEN [Calculation_834854787921477644]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Vendor ▸ Decline Reason&apos;) THEN [Calculation_834854787921477644]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Chain ▸ Vendor&apos;,&apos;Country ▸ Chain ▸ Vendor ▸ Decline Reason&apos;) THEN [vendor_name]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Vendor ▸ Pelican Status ▸ Decline Reason&apos;) THEN [Calculation_3455597921250607110]&#10;ELSE &apos;All&apos;&#10;END' />
            </column>
            <column caption='Persp #3 Filter' datatype='string' name='[Persp #2 Filter (copy)_4374332247638962179]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LOOKUP(ATTR([Persp #2 (copy)_4374332247627890689]), 0)'>
