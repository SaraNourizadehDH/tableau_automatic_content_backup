              <calculation class='tableau' formula='[chain_name] + &quot; | &quot; + [chain_code]// + &quot; | &quot; + [Country Name]' />
            </column>
            <column caption='Vendor' datatype='string' name='[Calculation_2320479758965829633]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_name] + &quot; | &quot; + [vendor_code]' />
            </column>
            <column caption='Latest Date Type Fail Rate' datatype='real' name='[Calculation_834854787652644868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF DATETRUNC([Parameters].[Parameter 1],[order_date_local],&apos;monday&apos;) = DATETRUNC([Parameters].[Parameter 1],{MAX([order_date_local])},&apos;monday&apos;) &#10;THEN [num_of_failed_orders] END)&#10;/&#10;SUM(IF DATETRUNC([Parameters].[Parameter 1],[order_date_local],&apos;monday&apos;) = DATETRUNC([Parameters].[Parameter 1],{MAX([order_date_local])},&apos;monday&apos;) &#10;THEN [num_of_orders] END)' />
            </column>
            <column caption='Latest Date Type Fail Rate Growth: Calc' datatype='real' name='[Calculation_834854787653951494]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_834854787652644868] - [Latest Date Fail Rate (copy)_834854787653857285]' />
            </column>
            <column caption='Date Type' datatype='datetime' name='[Calculation_834854787654877191]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1], [order_date_local], &apos;monday&apos;)' />
            </column>
            <column caption='Country Name (copy)' datatype='string' name='[Country Name (copy)_834854787928698893]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country_name]' />
            </column>
            <column caption='Latest Date Type (-1) Fail Rate ' datatype='real' name='[Latest Date Fail Rate (copy)_834854787653857285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF DATEDIFF([Parameters].[Parameter 1], [Calculation_834854787654877191], {MAX([Calculation_834854787654877191])}) = 1&#10;THEN [num_of_failed_orders] END)&#10;/&#10;SUM(IF DATEDIFF([Parameters].[Parameter 1], [Calculation_834854787654877191], {MAX([Calculation_834854787654877191])}) = 1&#10;THEN [num_of_orders] END)' />
            </column>
            <column caption='Latest Date Type Fail Rate Growth: Display' datatype='string' name='[Latest Date Type Fail Rate Growth (copy)_834854787945873422]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(IF [Calculation_834854787652644868] - [Latest Date Fail Rate (copy)_834854787653857285] &gt;= 0 &#10;THEN  &apos;▲&apos; ELSE &apos;▼&apos; END)&#10;+&#10;&apos;  &apos;&#10;+&#10;STR(ROUND(([Calculation_834854787652644868] - [Latest Date Fail Rate (copy)_834854787653857285])*100,1))&#10;+ &apos;%&apos;' />
            </column>
