      <column caption='Integration Status' datatype='string' hidden='true' name='[Calculation_3455597921250426885]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [is_sftp_vendor] THEN &quot;SFTP Integrated&quot;&#10;ELSEIF [is_pos_vendor] THEN &quot;POS Integrated&quot;&#10;ELSE &quot;Not Integrated&quot; &#10;END' />
      </column>
      <column caption='Pelican Status' datatype='string' hidden='true' name='[Calculation_3455597921250607110]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_511510439060750336]' />
      </column>
      <column caption='Persp #1' datatype='string' name='[Calculation_3455597921250873351]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// 1 PERSPECTIVE&#10;IF     [Parameters].[Parameter 12] = &apos;APAC&apos; THEN &apos;APAC&apos;&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Vertical&apos; THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Chain&apos; THEN [chain_name]&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Integration Status&apos; THEN [Calculation_3455597921250426885]&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Pelican Status&apos; THEN [Calculation_3455597921250607110]&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Delivery Type&apos; THEN [delivery_type]&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Cancellation Type&apos; THEN [cancellation_type]&#10;ELSEIF [Parameters].[Parameter 12] = &apos;Decline Reason&apos; THEN [Calculation_834854787921477644]&#10;&#10;// &gt;= 2 PERSPECTIVE&#10;&#10;ELSE [country_name]&#10;END' />
      </column>
      <column caption='Persp #2' datatype='string' name='[Calculation_3455597921251700745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// 1 PERSPECTIVE&#10;IF     [Parameters].[Parameter 12] IN (&apos;APAC&apos;,&#10;                         &apos;Country&apos;,&#10;                         &apos;Vertical&apos;,&#10;                         &apos;Chain&apos;,&#10;                         &apos;Integration Status&apos;,&#10;                         &apos;Pelican Status&apos;,&#10;                         &apos;Delivery Type&apos;,&#10;                         &apos;Cancellation Type&apos;,&#10;                         &apos;Decline Reason&apos;)&#10;THEN &apos;All&apos;&#10;&#10;// &gt;= 2 PERSPECTIVE&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Vertical&apos;) THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Chain&apos;,&apos;Country ▸ Chain ▸ Vendor&apos;,&apos;Country ▸ Chain ▸ Decline Reason&apos;,&apos;Country ▸ Chain ▸ Vendor ▸ Decline Reason&apos;) THEN [chain_name]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Integration Status&apos;) THEN [Calculation_3455597921250426885]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Pelican Status&apos;) THEN [Calculation_3455597921250607110]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Delivery Type&apos;) THEN [delivery_type]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Cancellation Type&apos;) THEN [cancellation_type]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Decline Reason&apos;) THEN [Calculation_834854787921477644]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Decline Reason Type ▸ Decline Reason&apos;) THEN [Calculation_834854787921477644]&#10;ELSEIF [Parameters].[Parameter 12] IN (&apos;Country ▸ Vendor ▸ Decline Reason&apos;, &apos;Country ▸ Vendor ▸ Pelican Status ▸ Decline Reason&apos;) THEN [vendor_name]&#10;&#10;END' />
      </column>
      <column caption='Persp #1 Filter' datatype='string' name='[Calculation_3455597921260396557]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP(ATTR([Calculation_3455597921250873351]), 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric Comparison' datatype='real' default-format='p0.0%' name='[Calculation_4794222556049485824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 10]&#10;    WHEN &quot;Customer Fail Rate&quot; THEN SUM(IF [decline_reason_type] = &apos;CUSTOMER&apos; THEN [num_of_failed_orders] END) / SUM([num_of_orders])&#10;    WHEN &quot;Vendor Fail Rate&quot; THEN SUM(IF [decline_reason_type] = &apos;VENDOR&apos; THEN [num_of_failed_orders] END) / SUM([num_of_orders])&#10;    WHEN &quot;Traffic Manager Fail Rate&quot; THEN SUM(IF [decline_reason_type] = &apos;TRAFFIC_MANAGER&apos; THEN [num_of_failed_orders] END) / SUM([num_of_orders])&#10;    WHEN &quot;Post Delivery Fail Rate&quot; THEN SUM(IF [decline_reason_type] = &apos;POST_DELIVERY&apos; THEN [num_of_failed_orders] END) / SUM([num_of_orders])&#10;END' />
      </column>
      <column caption='Is Pelican Vendor' datatype='string' hidden='true' name='[Calculation_511510439060750336]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_shops_pelican_order] THEN &quot;Pelican&quot; Else &quot;Godroid&quot; END' />
      </column>
      <column caption='Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_834854787651776512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_failed_orders])/ SUM([num_of_orders])' />
      </column>
      <column caption='Latest Date Type Fail Rate' datatype='real' name='[Calculation_834854787652644868]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF DATETRUNC([Parameters].[Parameter 1],[order_date_local],&apos;monday&apos;) = DATETRUNC([Parameters].[Parameter 1],{MAX([order_date_local])},&apos;monday&apos;) &#10;THEN [num_of_failed_orders] END)&#10;/&#10;SUM(IF DATETRUNC([Parameters].[Parameter 1],[order_date_local],&apos;monday&apos;) = DATETRUNC([Parameters].[Parameter 1],{MAX([order_date_local])},&apos;monday&apos;) &#10;THEN [num_of_orders] END)' />
      </column>
      <column caption='Latest Date Type Fail Rate Growth: Calc' datatype='real' name='[Calculation_834854787653951494]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_834854787652644868] - [Latest Date Fail Rate (copy)_834854787653857285]' />
      </column>
      <column caption='Date Type' datatype='datetime' name='[Calculation_834854787654877191]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1], [order_date_local], &apos;monday&apos;)' />
      </column>
      <column caption='Decline Reason' datatype='string' name='[Calculation_834854787921477644]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [decline_reason_type] = &apos;VENDOR&apos; THEN REGEXP_REPLACE(REGEXP_EXTRACT([decline_reason_code],&apos;^VENDOR_(\S+)&apos;),&apos;_&apos;,&apos; &apos;)&#10;ELSEIF [decline_reason_type] = &apos;TRAFFIC_MANAGER&apos; THEN REGEXP_REPLACE(REGEXP_EXTRACT([decline_reason_code],&apos;^TRAFFIC_MANAGER_(\S+)&apos;),&apos;_&apos;,&apos; &apos;)&#10;ELSEIF [decline_reason_type] = &apos;CUSTOMER&apos; THEN REGEXP_REPLACE(REGEXP_EXTRACT([decline_reason_code],&apos;^CUSTOMER_(\S+)&apos;),&apos;_&apos;,&apos; &apos;)&#10;ELSEIF [decline_reason_type] = &apos;POST_DELIVERY&apos; THEN REGEXP_REPLACE(REGEXP_EXTRACT([decline_reason_code],&apos;^POST_DELIVERY_(\S+)&apos;),&apos;_&apos;,&apos; &apos;)&#10;END' />
      </column>
      <column caption='Latest Date Type' datatype='boolean' name='[Calculation_834854787952058384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{MAX([Calculation_834854787654877191])} = [Calculation_834854787654877191]' />
      </column>
      <column caption='Chain Name (copy)' datatype='string' name='[Chain Name (copy)_834854787954532370]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[chain_name]' />
      </column>
      <column caption='Country Name (copy)' datatype='string' name='[Country Name (copy)_834854787928698893]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='[country_name]' />
      </column>
      <column caption='Decline Reason Type (copy)' datatype='string' name='[Decline Reason Type (copy)_2884062987866112000]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[decline_reason_type]' />
        <aliases>
          <alias key='&quot;POST_DELIVERY&quot;' value='POST DELIVERY' />
          <alias key='&quot;TRAFFIC_MANAGER&quot;' value='TRAFFIC MANAGER' />
        </aliases>
      </column>
      <column caption='Exclude Latest Week' datatype='boolean' name='[Exclude Today (copy)_2884062989319544855]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[order_date_local],&apos;monday&apos;) &lt; DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)' />
      </column>
      <column caption='Latest Date Type (-1) Fail Rate ' datatype='real' name='[Latest Date Fail Rate (copy)_834854787653857285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF DATEDIFF([Parameters].[Parameter 1], [Calculation_834854787654877191], {MAX([Calculation_834854787654877191])}) = 1&#10;THEN [num_of_failed_orders] END)&#10;/&#10;SUM(IF DATEDIFF([Parameters].[Parameter 1], [Calculation_834854787654877191], {MAX([Calculation_834854787654877191])}) = 1&#10;THEN [num_of_orders] END)' />
      </column>
      <column caption='Latest Date Type Fail Rate Growth: Display' datatype='string' name='[Latest Date Type Fail Rate Growth (copy)_834854787945873422]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(IF [Calculation_834854787652644868] - [Latest Date Fail Rate (copy)_834854787653857285] &gt;= 0 &#10;THEN  &apos;▲&apos; ELSE &apos;▼&apos; END)&#10;+&#10;&apos;  &apos;&#10;+&#10;STR(ROUND(([Calculation_834854787652644868] - [Latest Date Fail Rate (copy)_834854787653857285])*100,1))&#10;+ &apos;%&apos;' />
      </column>
      <column caption='Num Of Failed Orders (copy)' datatype='integer' name='[Num Of Failed Orders (copy)_834854787917623305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[num_of_failed_orders]' />
