    <worksheet name='Prank Orders Pie Graph'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#f4077f' fontname='Tableau Medium' fontsize='12'>Prank Order </run>
            <run bold='true' fontalignment='1' fontcolor='#f4077f' fontname='Tableau Medium' fontsize='12'>Decline Reasons</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#898989' fontname='Tableau Regular' fontsize='8' italic='true'>Top 5 Decline Reasons within selected Countries &amp; Dates.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_shops__fail_rate_dashboard (pandata_report)' name='federated.0ygte0x1olrm7o1gufw9c1v5va5z' />
          </datasources>
          <datasource-dependencies datasource='federated.0ygte0x1olrm7o1gufw9c1v5va5z'>
            <column caption='Chain' datatype='string' name='[Calculation_2320479758965661696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[chain_name] + &quot; | &quot; + [chain_code]// + &quot; | &quot; + [Country Name]' />
            </column>
            <column caption='Vendor' datatype='string' name='[Calculation_2320479758965829633]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_name] + &quot; | &quot; + [vendor_code]' />
            </column>
            <column caption='Decline Reason' datatype='string' name='[Calculation_834854787921477644]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [decline_reason_type] = &apos;VENDOR&apos; THEN REGEXP_REPLACE(REGEXP_EXTRACT([decline_reason_code],&apos;^VENDOR_(\S+)&apos;),&apos;_&apos;,&apos; &apos;)&#10;ELSEIF [decline_reason_type] = &apos;TRAFFIC_MANAGER&apos; THEN REGEXP_REPLACE(REGEXP_EXTRACT([decline_reason_code],&apos;^TRAFFIC_MANAGER_(\S+)&apos;),&apos;_&apos;,&apos; &apos;)&#10;ELSEIF [decline_reason_type] = &apos;CUSTOMER&apos; THEN REGEXP_REPLACE(REGEXP_EXTRACT([decline_reason_code],&apos;^CUSTOMER_(\S+)&apos;),&apos;_&apos;,&apos; &apos;)&#10;ELSEIF [decline_reason_type] = &apos;POST_DELIVERY&apos; THEN REGEXP_REPLACE(REGEXP_EXTRACT([decline_reason_code],&apos;^POST_DELIVERY_(\S+)&apos;),&apos;_&apos;,&apos; &apos;)&#10;END' />
            </column>
            <column caption='Exclude Latest Week' datatype='boolean' name='[Exclude Today (copy)_2884062989319544855]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[order_date_local],&apos;monday&apos;) &lt; DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)' />
            </column>
