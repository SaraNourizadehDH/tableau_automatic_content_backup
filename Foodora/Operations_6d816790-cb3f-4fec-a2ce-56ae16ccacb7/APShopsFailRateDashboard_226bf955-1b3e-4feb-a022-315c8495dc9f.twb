            </column>
            <column caption='Latest Date Type (-1) Fail Rate ' datatype='real' name='[Latest Date Fail Rate (copy)_834854787653857285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF DATEDIFF([Parameters].[Parameter 1], [Calculation_834854787654877191], {MAX([Calculation_834854787654877191])}) = 1&#10;THEN [num_of_failed_orders] END)&#10;/&#10;SUM(IF DATEDIFF([Parameters].[Parameter 1], [Calculation_834854787654877191], {MAX([Calculation_834854787654877191])}) = 1&#10;THEN [num_of_orders] END)' />
