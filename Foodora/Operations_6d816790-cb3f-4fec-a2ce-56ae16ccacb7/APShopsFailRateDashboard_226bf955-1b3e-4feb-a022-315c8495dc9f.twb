    <worksheet name='Vendor FR Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#f4077f' fontname='Tableau Medium' fontsize='12'>Vendors:</run>
            <run fontalignment='1' fontcolor='#f4077f' fontname='Tableau Medium' fontsize='12'> Top 3 Failed Orders</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#898989' fontname='Tableau Regular' fontsize='8' italic='true'>Vendors with the most </run>
            <run fontalignment='1' fontcolor='#f4077f' fontname='Tableau Regular' fontsize='8' italic='true'>Failed Orders</run>
            <run fontalignment='1' fontcolor='#898989' fontname='Tableau Regular' fontsize='8' italic='true'><![CDATA[ during selected Date Range & their FR by <[Parameters].[Parameter 1]>.]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#898989' fontname='Tableau Regular' fontsize='8' italic='true'>Click on </run>
            <run fontalignment='1' fontcolor='#f4077f' fontname='Tableau Regular' fontsize='8' italic='true'>Vendor Names</run>
            <run fontalignment='1' fontcolor='#898989' fontname='Tableau Regular' fontsize='8' italic='true'> to filter Decline Reason Breakdown below.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_shops__fail_rate_dashboard (pandata_report)' name='federated.0ygte0x1olrm7o1gufw9c1v5va5z' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Day' caption='Date Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;week&quot;' value='Week' />
              </aliases>
            </column>
            <column caption='Top N Vendors' datatype='integer' name='[Parameter 8]' param-domain-type='range' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <range max='5' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ygte0x1olrm7o1gufw9c1v5va5z'>
            <column caption='Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_834854787651776512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_failed_orders])/ SUM([num_of_orders])' />
            </column>
            <column caption='Date Type' datatype='datetime' name='[Calculation_834854787654877191]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1], [order_date_local], &apos;monday&apos;)' />
            </column>
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_834854787654877191]' derivation='None' name='[none:Calculation_834854787654877191:qk]' pivot='key' type='quantitative' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date_local]' derivation='None' name='[none:order_date_local:ok]' pivot='key' type='ordinal' />
            <column-instance column='[vendor_name]' derivation='None' name='[none:vendor_name:nk]' pivot='key' type='nominal' />
            <column caption='# Failed Orders' datatype='integer' name='[num_of_failed_orders]' role='measure' type='quantitative' />
            <column caption='Num Of Orders' datatype='integer' name='[num_of_orders]' role='measure' type='quantitative' />
            <column caption='Order Date Local' datatype='date' name='[order_date_local]' role='dimension' type='ordinal' />
            <column-instance column='[num_of_failed_orders]' derivation='Sum' name='[sum:num_of_failed_orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_834854787651776512]' derivation='User' name='[usr:Calculation_834854787651776512:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Name' datatype='string' name='[vendor_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0ygte0x1olrm7o1gufw9c1v5va5z].[Action (Chain Name)]' context='true'>
            <groupfilter function='level-members' level='[chain_name]' user:ui-action-filter='[Action7]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.0ygte0x1olrm7o1gufw9c1v5va5z].[none:Calculation_834854787654877191:qk]' context='true' filter-group='6' included-values='non-null' />
          <filter class='categorical' column='[federated.0ygte0x1olrm7o1gufw9c1v5va5z].[none:country_name:nk]' context='true' filter-group='8'>
            <groupfilter function='level-members' level='[none:country_name:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
