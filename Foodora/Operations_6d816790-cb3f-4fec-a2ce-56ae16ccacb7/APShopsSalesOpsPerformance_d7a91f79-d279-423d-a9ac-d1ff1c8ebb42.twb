              <calculation class='tableau' formula='COUNTD([Calculation_2155887227802406921])/COUNTD([non-ka above cr min (copy)_2155887227802804235])' />
            </column>
            <column caption='Non-KA %Above CR Min.' datatype='real' name='[%Above SKU Target (copy)_2155887227801948166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([non-ka above cr target (copy)_2155887227802566666])/COUNTD([non-ka above cr min (copy)_2155887227802804235])' />
            </column>
            <column caption='% Above SKU Target' datatype='real' name='[%above sku min (copy)_2155887227801743365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hit_sku_target])/sum([Calculation_2869496662760534016])' />
            </column>
            <column caption='no of signups' datatype='integer' name='[Calculation_2155887227800289282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([sf_account_id])' />
            </column>
            <column caption='% Above SKU Min.' datatype='real' name='[Calculation_2155887227801292803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hit_sku_min])/sum([Calculation_2869496662760534016])' />
            </column>
            <column caption='non-ka above cr target' datatype='string' name='[Calculation_2155887227802406921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_key_vip_account] = FALSE AND [hit_cr_target] = 1 THEN [sf_account_id] end' />
            </column>
            <column caption='%KA signing' datatype='real' name='[Calculation_2155887227803283468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(COUNTD([non-ka above cr min (copy)_2155887227802804235])/[Calculation_2155887227800289282])' />
            </column>
            <column caption='Is_activated' datatype='integer' name='[Calculation_2869496662760534016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ISNULL([activated_date]) then 0 else 1 end' />
            </column>
            <column caption='No of Onboarded Vendors' datatype='integer' name='[Calculation_6050867640151576576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF ISNULL([activated_date]) = FALSE THEN [sf_account_id] END)' />
