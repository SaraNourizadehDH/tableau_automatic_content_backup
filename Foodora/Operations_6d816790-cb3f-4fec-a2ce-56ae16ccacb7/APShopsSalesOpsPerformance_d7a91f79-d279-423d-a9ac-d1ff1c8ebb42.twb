    <datasource caption='[AP] Shops Sales Lead Conversion (Custom SQL)' inline='true' name='federated.0nwzyko00px4o01b81o8h0vg6y8o' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1u324341gsu0bd11jsewf00x4y1t'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='ruiyi.yap@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1u324341gsu0bd11jsewf00x4y1t' name='Custom SQL Query' type='text'><![CDATA[WITH leads_raw AS (
  SELECT  
    country,
    city,
    vendor_type,
    sf_lead_id,
    lead_status,
    is_lead_converted,
    is_won,
    is_closed,
    lead_created_date_utc,
    lead_disqualified_date,
    account_created_date_utc,
    opp_close_date_utc
  FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated`
  WHERE (
    opportunity_business_type != 'Upgrade/Upsell' 
    OR opportunity_business_type IS NULL
    )
    AND lead_created_date_utc << CURRENT_DATE()
    AND vendor_type = 'Shops'
),

dates AS (
  SELECT
    date
  FROM `fulfillment-dwh-production.pandata_curated.shared_dates`
  WHERE date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 6 MONTH)
),

leads_created AS (
  SELECT
    country,
    city,
    DATE_TRUNC(date, MONTH) AS report_month,
    COUNT(DISTINCT sf_lead_id) AS total_leads
  FROM leads_raw
  CROSS JOIN dates
  WHERE date >>= lead_created_date_utc 
    AND date <<= IFNULL(IF(is_lead_converted AND is_won AND is_closed, opp_close_date_utc, NULL), CURRENT_DATE())
    AND date <<= IF(lead_status = 'Lost' AND lead_disqualified_date IS NULL, lead_created_date_utc, CURRENT_DATE())
  GROUP BY
    country,
    city,
    report_month
),

pre_leads_converted AS (
  SELECT 
    country,
    city,
    DATE_TRUNC(opp_close_date_utc, month) AS report_month,
    COUNT(DISTINCT sf_lead_id) AS num_converted_leads /* total leads created in the month */
  FROM leads_raw
  WHERE is_lead_converted
    AND is_closed
    AND is_won
    AND opp_close_date_utc BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 6 MONTH) AND CURRENT_DATE() 
  GROUP BY
    country,
    city,
    report_month
  
  UNION ALL 
  
  SELECT 
    country,
    city,
    DATE_TRUNC(lead_created_date_utc, MONTH) AS month,
    COUNT(DISTINCT sf_lead_id) AS num_converted_leads /* total leads converted in the month */
  FROM leads_raw
  WHERE lead_status = 'Lost'
    AND lead_disqualified_date IS NULL
  GROUP BY 1,2,3
  ORDER BY 2,1
),

leads_converted AS (
  SELECT
    country,
    city,
    report_month,
    SUM(num_converted_leads) AS num_converted_leads
  FROM pre_leads_converted
  WHERE report_month BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE,month),INTERVAL 6 MONTH) AND CURRENT_DATE 
  GROUP BY 1,2,3
)

SELECT
  COALESCE(a.country, b.country) AS country,
  COALESCE(a.city, b.city) AS city,
  COALESCE(a.report_month, b.report_month) AS month,
  total_leads,
  num_converted_leads,
  ROUND(SAFE_DIVIDE(num_converted_leads,total_leads), 4) AS perc_conversion
FROM leads_created AS a 
FULL OUTER JOIN leads_converted AS b
  ON a.country = b.country 
 AND a.report_month = b.report_month
 AND COALESCE(a.city, 'null') = COALESCE(b.city, 'null')
ORDER BY 2,1]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1u324341gsu0bd11jsewf00x4y1t' name='Custom SQL Query' type='text'><![CDATA[WITH leads_raw AS (
  SELECT  
