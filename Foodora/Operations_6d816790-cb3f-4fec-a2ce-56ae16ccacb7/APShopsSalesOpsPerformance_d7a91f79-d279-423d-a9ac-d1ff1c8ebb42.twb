            <column caption='Signup Date' datatype='date' name='[signup_date]' role='dimension' type='ordinal' />
            <column caption='avg sku MTD vs PMTD' datatype='string' name='[signups MTD vs PMTD (copy)_4932356439091298304]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    (SUM(iif([Calculation_128141504433950898], (IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END), NULL))/COUNTD(iif([Calculation_128141504433950898], (IF ISNULL([activated_date]) = FALSE THEN [sf_account_id] END), NULL)))&#10;    -&#10;    (SUM(iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END), NULL))/COUNTD(iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [sf_account_id] END), NULL)))&#10;    &#10;)&#10;&#10;/&#10;iif(&#10;isnull((SUM(iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END), NULL))/COUNTD(iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [sf_account_id] END), NULL)))) &#10;or ((SUM(iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END), NULL))/COUNTD(iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [sf_account_id] END), NULL)))) = 0,&#10;1,&#10;(SUM(iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END), NULL))/COUNTD(iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [sf_account_id] END), NULL)))&#10;)&#10;&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;(SUM(iif([Calculation_128141504433950898], (IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END), NULL))/COUNTD(iif([Calculation_128141504433950898], (IF ISNULL([activated_date]) = FALSE THEN [sf_account_id] END), NULL)))&#10;    -&#10;(SUM(iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END), NULL))/COUNTD(iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [sf_account_id] END), NULL)))&#10;)&#10;&#10;/&#10;&#10;iif(&#10;isnull((SUM(iif([Calculation_128141504434032819], 