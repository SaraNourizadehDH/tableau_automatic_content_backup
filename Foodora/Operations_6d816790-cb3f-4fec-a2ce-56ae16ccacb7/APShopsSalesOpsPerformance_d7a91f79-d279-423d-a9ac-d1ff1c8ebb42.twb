  <worksheets>
    <worksheet name='Account Conversion to Active Account (Country)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='12'>&lt;Sheet Name&gt;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold'>Æ </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'>(Agg. accounts converted by month. Only Country filter applies.)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[AP] Shops Sales Lead Conversion (Custom SQL)' name='federated.0nwzyko00px4o01b81o8h0vg6y8o' />
            <datasource caption='regional_apac_shops__sales_performance_dashboard' name='federated.1agh3n91uw9mvr1cviijb06zs10m' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Leads Converted&quot;'>
              <calculation class='tableau' formula='&quot;% Leads Converted&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nwzyko00px4o01b81o8h0vg6y8o'>
            <column caption='Leads Metric' datatype='real' name='[Calculation_5243597361184133122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;% Leads Converted&apos; THEN [Calculation_5243597361184436227]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;# Leads Converted&apos; THEN SUM([num_converted_leads])&#10;END' />
            </column>
            <column caption='% Lead Conversion' datatype='real' default-format='p0.0%' name='[Calculation_5243597361184436227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_converted_leads]) / SUM([total_leads])' />
            </column>
            <column caption='Leads Metric Avg' datatype='real' name='[Calculation_5243597361185300485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG([Calculation_5243597361184133122])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Leads Metric Color Indicator' datatype='integer' name='[Calculation_5243597361185484806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if isnull([Calculation_5243597361184133122]) then 0&#10;elseif ([Calculation_5243597361184133122] - [Calculation_5243597361185300485])/abs([Calculation_5243597361185300485]) &gt;=0.1&#10;then 2&#10;elseif ([Calculation_5243597361184133122] - [Calculation_5243597361185300485])/abs([Calculation_5243597361185300485]) &lt;=-0.1 &#10;then -2&#10;elseif (([Calculation_5243597361184133122] - [Calculation_5243597361185300485])/abs([Calculation_5243597361185300485]) &gt;= 0.05)&#10;then 1&#10;elseif ([Calculation_5243597361184133122] - [Calculation_5243597361185300485])/abs([Calculation_5243597361185300485]) &lt;=-0.05&#10;then -1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Column Name' datatype='string' name='[Calculation_5243597361187434504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Month&apos;' />
            </column>
            <column caption='Leads Metric (Str)' datatype='string' name='[Leads Metric (copy)_5243597361186463751]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;% Leads Converted&apos; THEN STR(ROUND([Calculation_5243597361184436227]*100,1)) + &apos;%&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;# Leads Converted&apos; THEN STR(SUM([num_converted_leads]))&#10;END' />
            </column>
            <column caption='Country Name' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Month' datatype='date' default-format='*mmm yy' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5243597361187434504]' derivation='None' name='[none:Calculation_5243597361187434504:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[month]' derivation='None' name='[none:month:qk]' pivot='key' type='quantitative' />
            <column caption='Num Converted Leads' datatype='integer' name='[num_converted_leads]' role='measure' type='quantitative' />
            <column-instance column='[month]' derivation='Month-Trunc' name='[tmn:month:ok]' pivot='key' type='ordinal' />
            <column caption='Total Leads' datatype='integer' name='[total_leads]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_5243597361185484806]' derivation='User' name='[usr:Calculation_5243597361185484806:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.0nwzyko00px4o01b81o8h0vg6y8o].[Calculation_5243597361185300485]' ordering-type='Rows' />
            </column-instance>
            <column-instance column='[Leads Metric (copy)_5243597361186463751]' derivation='User' name='[usr:Leads Metric (copy)_5243597361186463751:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1agh3n91uw9mvr1cviijb06zs10m'>
            <column caption='Country Name' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0nwzyko00px4o01b81o8h0vg6y8o].[none:month:qk]' included-values='non-null' />
          <slices>
            <column>[federated.0nwzyko00px4o01b81o8h0vg6y8o].[[User Filter]] Country]</column>
            <column>[federated.0nwzyko00px4o01b81o8h0vg6y8o].[none:month:qk]</column>
            <column>[federated.1agh3n91uw9mvr1cviijb06zs10m].[none:country:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-align' value='right' />
          </style-rule>
          <style-rule element='header'>
            <format attr='background-color' field='[federated.0nwzyko00px4o01b81o8h0vg6y8o].[none:Calculation_5243597361187434504:nk]' value='#e6e6e6' />
            <format attr='background-color' field='[federated.0nwzyko00px4o01b81o8h0vg6y8o].[tmn:month:ok]' value='#e6e6e6' />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-weight' field='[federated.0nwzyko00px4o01b81o8h0vg6y8o].[tmn:month:ok]' value='bold' />
            <format attr='color' field='[federated.0nwzyko00px4o01b81o8h0vg6y8o].[tmn:month:ok]' value='#333333' />
          </style-rule>
          <style-rule element='mark'>
