      </column>
      <column caption='% Below SKU Threshold' datatype='real' default-format='p0.0%' name='[% Below SKU Target  (copy)_3839037248899538948]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [hit_sku_min] = 0 THEN 1 ELSE 0 END &#10;)&#10;/&#10;SUM([Calculation_2869496662760534016])' />
      </column>
      <column caption='% Below CR Target' datatype='real' default-format='p0.0%' name='[% Below SKU Target (copy)_3839037248923582469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [hit_cr_target] = 0 THEN 1 ELSE 0 END &#10;)&#10;/&#10;SUM([Calculation_2869496662760534016])' />
      </column>
      <column caption='% Activations with Deal' datatype='real' default-format='p0.0%' name='[% Preferred Partner (copy)_3419428436571693056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [has_deal] THEN [sf_account_id] END)/COUNTD([sf_account_id])' />
      </column>
      <column caption='% Accounts with Sales NCR' datatype='real' default-format='p0.0%' name='[% Preferred Partner (copy)_3419428436574007298]' role='measure' type='quantitative'>
