            </column>
            <column caption='Dynamic Date Range (Signup)' datatype='string' name='[Calculation_6333046271247306753]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1 2] = &apos;week&apos; or [Parameters].[Parameter 1 2] = &apos;week w wtd&apos;) then str(DATEPART(&apos;iso-year&apos;,[signup_date]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[signup_date]))&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;day&apos; then str(DATEPART(&apos;day&apos;,[signup_date]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[signup_date])),3)&#10;ELSEIF ([Parameters].[Parameter 1 2] = &apos;month&apos; or [Parameters].[Parameter 1 2] = &apos;month w mtd&apos;) then LEFT(str(DATENAME(&apos;month&apos;,[signup_date])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[signup_date])),2) end' />
            </column>
            <column caption='Dynamic Date Filter: Signup' datatype='boolean' name='[Calculation_6333046271249321986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1 2] = &apos;month&apos; THEN [signup_date] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [signup_date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;week&apos; THEN [signup_date] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [signup_date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;day&apos; THEN [signup_date] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [signup_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;month w mtd&apos; THEN [signup_date] &gt;= DATEADD(&apos;month&apos;,-5,DATETRUNC(&apos;month&apos;,TODAY())) AND [signup_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;week w wtd&apos; THEN [signup_date] &gt;= DATEADD(&apos;iso-week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [signup_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;END' />
            </column>
            <column caption='Dynamic column name' datatype='string' name='[Calculation_6333046271255556099]' role='dimension' type='nominal'>
