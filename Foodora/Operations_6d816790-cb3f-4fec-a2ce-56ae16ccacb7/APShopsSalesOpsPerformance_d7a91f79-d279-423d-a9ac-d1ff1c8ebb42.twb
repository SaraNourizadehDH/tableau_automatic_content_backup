              <calculation class='tableau' formula='if&#10;(&#10;    SUM(iif([Calculation_128141504433950898], (IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END), NULL))&#10;    -&#10;    SUM(iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END), NULL))&#10;    &#10;)&#10;&#10;/&#10;iif(&#10;isnull(SUM(iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END), NULL))) &#10;or (SUM(iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END), NULL))) = 0,&#10;1,&#10;SUM(iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END), NULL))&#10;)&#10;&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
