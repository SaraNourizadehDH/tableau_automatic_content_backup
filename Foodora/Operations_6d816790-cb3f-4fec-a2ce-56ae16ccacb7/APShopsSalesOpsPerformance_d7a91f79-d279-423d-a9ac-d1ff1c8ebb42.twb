    <worksheet name='Shops Incubation Performance View'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#555555' fontsize='8' italic='true'>Columns are collapsible, click [+] or [-] on Region/ Country/ Chain/ Vendor for desired level of granularity.</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#555555' fontname='Tableau Regular' fontsize='8'>- Activation Dates </run>
            <run fontcolor='#555555' fontname='Tableau Regular' fontsize='8'>takes into account if a vendor has been re-signed. </run>
            <run fontcolor='#e15759' fontname='Tableau Regular' fontsize='8'>For such cases, the later activated date is considered in this view. All other views in this dashboard account for all Activations per Vendor.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#555555' fontname='Tableau Regular' fontsize='8'>- F30D ...* </run>
            <run fontcolor='#555555' fontname='Tableau Regular' fontsize='8'>is based on order performance in first 30D from activated date</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#555555' fontname='Tableau Regular' fontsize='8'>- Active Product % </run>
            <run fontcolor='#555555' fontname='Tableau Regular' fontsize='8'>is based latest on latest data of active product vs total product</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#555555' fontname='Tableau Regular' fontsize='8'>- Zombie Vendors: </run>
            <run fontcolor='#555555' fontname='Tableau Regular' fontsize='8'>Vendors activated for at least 30D with no valid orders in first 30D from activated date. </run>
            <run>Æ&#10;</run>
            <run fontcolor='#555555' fontname='Tableau Regular' fontsize='8'>As vendors will have 30D to perform, </run>
            <run bold='true' fontcolor='#555555' fontname='Tableau Regular' fontsize='8'>Zombie Vendors</run>
            <run fontcolor='#555555' fontname='Tableau Regular' fontsize='8'> data for [current month -1] will only be accurate when [current month] is over.</run>
            <run>Æ&#10;</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_shops__vendor_incubation_dashboard' name='federated.0cgk72e1iypoxa1epdyyv1pqfink' />
            <datasource caption='regional_apac_shops__sales_performance_dashboard' name='federated.1agh3n91uw9mvr1cviijb06zs10m' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0cgk72e1iypoxa1epdyyv1pqfink'>
            <column caption='F60D Offline Rate %' datatype='real' default-format='p0.0%' name='[Calculation_1177902455891107840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([f60d_closed_minutes]) / SUM([f60d_open_minutes])' />
            </column>
            <column caption='F60D Fail Rate %' datatype='real' default-format='p0.0%' name='[Calculation_2782732015849418752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_f60d_failed_orders]) / SUM([num_of_f60d_orders])' />
            </column>
            <column caption='F30D Vendor Fail Rate % ' datatype='real' default-format='p0.0%' name='[Calculation_3042181601517445120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_f30d_vendor_fail_orders]) / SUM([num_of_f30d_orders])' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_3042181601518014465]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;APAC&apos;' />
            </column>
            <column caption='F30D Total Orders' datatype='integer' name='[Calculation_3042181601519112200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_f30d_orders])' />
            </column>
            <column caption='F30D Zombie Vendors' datatype='integer' name='[Calculation_3586554160063479809]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD(IF [is_zombie] THEN [global_entity_id] + &apos;_&apos; + [vendor_code] END)' />
            </column>
            <column caption='F30D Zombie Vendors %' datatype='real' default-format='p0.0%' name='[Calculation_3586554160063729666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3586554160063479809] / COUNTD([global_entity_id] + &apos;_&apos; + [vendor_code])' />
            </column>
            <column caption='Activated Date' datatype='date' default-format='*dd mmm yy' name='[Calculation_730849825353887745]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;isoweek&apos; THEN [activated_isoweek] ELSE [activated_month] END' />
            </column>
            <column caption='F30D Fail Rate %' datatype='real' default-format='p0.0%' name='[Calculation_730849825355747330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_f30d_failed_orders]) / SUM([num_of_f30d_orders])' />
            </column>
            <column caption='Active Product % (Latest Run)' datatype='real' default-format='p0.0%' name='[Calculation_730849825356271621]' role='measure' type='quantitative'>
