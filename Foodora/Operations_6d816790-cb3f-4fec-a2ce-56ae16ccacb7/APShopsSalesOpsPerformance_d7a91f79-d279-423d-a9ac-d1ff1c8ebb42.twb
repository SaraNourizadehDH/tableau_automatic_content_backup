            <column caption='no of sku per vendor l7period avg ' datatype='real' name='[no of signups l7period avg (copy)_4304245028273885186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG([Calculation_496381171776454659],first(),first()+7)'>
