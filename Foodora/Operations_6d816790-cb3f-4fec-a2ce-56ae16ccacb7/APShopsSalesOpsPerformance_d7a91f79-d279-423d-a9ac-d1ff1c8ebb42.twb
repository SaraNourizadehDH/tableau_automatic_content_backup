      </column>
      <column caption='F30D Zombie Vendors' datatype='integer' name='[Calculation_3586554160063479809]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD(IF [is_zombie] THEN [global_entity_id] + &apos;_&apos; + [vendor_code] END)' />
      </column>
