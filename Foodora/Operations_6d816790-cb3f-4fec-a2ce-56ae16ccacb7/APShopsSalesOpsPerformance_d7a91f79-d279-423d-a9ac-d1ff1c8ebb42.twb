    <worksheet name='Shops Summary - Category Signups'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#c9005d' fontname='Tableau Regular' fontsize='8' italic='true'>  Based on Signup Dates</run>
            <run fontcolor='#c9005d' fontname='Tableau Regular' italic='true'>Æ </run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_shops__sales_performance_dashboard' name='federated.1agh3n91uw9mvr1cviijb06zs10m' />
          </datasources>
          <datasource-dependencies datasource='federated.1agh3n91uw9mvr1cviijb06zs10m'>
            <column caption='Non-KA %Above CR Target' datatype='real' name='[%Above CR Min. (copy)_2155887227802030087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_2155887227802406921])/COUNTD([non-ka above cr min (copy)_2155887227802804235])' />
            </column>
            <column caption='Non-KA %Above CR Min.' datatype='real' name='[%Above SKU Target (copy)_2155887227801948166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([non-ka above cr target (copy)_2155887227802566666])/COUNTD([non-ka above cr min (copy)_2155887227802804235])' />
            </column>
            <column caption='% Above SKU Target' datatype='real' name='[%above sku min (copy)_2155887227801743365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hit_sku_target])/sum([Calculation_2869496662760534016])' />
            </column>
            <column caption='no of signups' datatype='integer' name='[Calculation_2155887227800289282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([sf_account_id])' />
            </column>
            <column caption='% Above SKU Min.' datatype='real' name='[Calculation_2155887227801292803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hit_sku_min])/sum([Calculation_2869496662760534016])' />
            </column>
            <column caption='non-ka above cr target' datatype='string' name='[Calculation_2155887227802406921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_key_vip_account] = FALSE AND [hit_cr_target] = 1 THEN [sf_account_id] end' />
            </column>
            <column caption='%KA signing' datatype='real' name='[Calculation_2155887227803283468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(COUNTD([non-ka above cr min (copy)_2155887227802804235])/[Calculation_2155887227800289282])' />
            </column>
            <column caption='Is_activated' datatype='integer' name='[Calculation_2869496662760534016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if ISNULL([activated_date]) then 0 else 1 end' />
            </column>
            <column caption='No of Onboarded Vendors' datatype='integer' name='[Calculation_6050867640151576576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF ISNULL([activated_date]) = FALSE THEN [sf_account_id] END)' />
            </column>
            <column caption='Total Onboarded Vendors SKUs' datatype='integer' name='[Calculation_6050867640157220865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END)' />
            </column>
            <column caption='% Preferred Partner' datatype='real' name='[Calculation_982066193952395265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_preferred_partner] THEN [sf_account_id] END)/COUNTD([sf_account_id])' />
            </column>
            <column caption='Account Source' datatype='string' name='[account_source]' role='dimension' type='nominal' />
            <column caption='Activated Date' datatype='date' name='[activated_date]' role='dimension' type='ordinal' />
            <column-instance column='[commission_w_trial]' derivation='Avg' name='[avg:commission_w_trial:qk]' pivot='key' type='quantitative' />
            <column aggregation='Sum' caption='Commission W Trial' datatype='real' name='[commission_w_trial]' role='dimension' type='ordinal' />
            <column caption='Country Name' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Service Types' datatype='string' name='[delivery_service_types]' role='dimension' type='nominal' />
            <column datatype='integer' name='[hit_cr_min]' role='measure' type='quantitative' />
            <column datatype='integer' name='[hit_cr_target]' role='measure' type='quantitative' />
