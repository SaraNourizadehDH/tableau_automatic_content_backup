            <column caption='sku per vendor color indicator' datatype='integer' name='[signups color indicator (copy)_4304245028274065411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if isnull([Calculation_496381171776454659]) then 0&#10;elseif ([Calculation_496381171776454659] - [no of signups l7period avg (copy)_4304245028273885186])/abs([no of signups l7period avg (copy)_4304245028273885186]) &gt;=0.3&#10;then 2&#10;elseif ([Calculation_496381171776454659] - [no of signups l7period avg (copy)_4304245028273885186])/abs([no of signups l7period avg (copy)_4304245028273885186]) &lt;=-0.3 &#10;then -2&#10;elseif (([Calculation_496381171776454659] - [no of signups l7period avg (copy)_4304245028273885186])/abs([no of signups l7period avg (copy)_4304245028273885186]) &gt;= 0.2)&#10;then 1&#10;elseif ([Calculation_496381171776454659] - [no of signups l7period avg (copy)_4304245028273885186])/abs([no of signups l7period avg (copy)_4304245028273885186]) &lt;=-0.2&#10;then -1&#10;else 0&#10;end'>
