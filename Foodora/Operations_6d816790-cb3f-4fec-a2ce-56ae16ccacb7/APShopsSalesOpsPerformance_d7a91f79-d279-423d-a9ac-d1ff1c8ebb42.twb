    <worksheet name='Comm % w Trial (Country)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='12'>Average Signing Commission % (with Trial) </run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold'>Æ </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'>(Avg. comm rate w trial in the period)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_shops__sales_performance_dashboard' name='federated.1agh3n91uw9mvr1cviijb06zs10m' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Month (incl. curr)' caption='Dynamic Date' datatype='string' name='[Parameter 1 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;month w mtd&quot;'>
              <calculation class='tableau' formula='&quot;month w mtd&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;month w mtd&quot;' value='Month (incl. curr)' />
                <alias key='&quot;week&quot;' value='Week' />
                <alias key='&quot;week w wtd&quot;' value='Week (incl. curr)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1agh3n91uw9mvr1cviijb06zs10m'>
            <column aggregation='Sum' caption='Is KA' datatype='integer' name='[Calculation_1474225247392129024]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [is_key_vip_account] THEN 1 ELSE 0 END' />
            </column>
            <column caption='no of signups' datatype='integer' name='[Calculation_2155887227800289282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([sf_account_id])' />
            </column>
            <column caption='Comm % w trial' datatype='real' name='[Calculation_496381171775442945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_w_trial])/([Calculation_2155887227800289282])' />
            </column>
            <column caption='Dynamic Date Range (Signup)' datatype='string' name='[Calculation_6333046271247306753]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1 2] = &apos;week&apos; or [Parameters].[Parameter 1 2] = &apos;week w wtd&apos;) then str(DATEPART(&apos;iso-year&apos;,[signup_date]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[signup_date]))&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;day&apos; then str(DATEPART(&apos;day&apos;,[signup_date]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[signup_date])),3)&#10;ELSEIF ([Parameters].[Parameter 1 2] = &apos;month&apos; or [Parameters].[Parameter 1 2] = &apos;month w mtd&apos;) then LEFT(str(DATENAME(&apos;month&apos;,[signup_date])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[signup_date])),2) end' />
            </column>
            <column caption='Dynamic Date Filter: Signup' datatype='boolean' name='[Calculation_6333046271249321986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1 2] = &apos;month&apos; THEN [signup_date] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [signup_date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;week&apos; THEN [signup_date] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [signup_date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;day&apos; THEN [signup_date] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [signup_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;month w mtd&apos; THEN [signup_date] &gt;= DATEADD(&apos;month&apos;,-5,DATETRUNC(&apos;month&apos;,TODAY())) AND [signup_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;week w wtd&apos; THEN [signup_date] &gt;= DATEADD(&apos;iso-week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [signup_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;END' />
            </column>
            <column caption='Dynamic column name' datatype='string' name='[Calculation_6333046271255556099]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1 2] = &apos;day&apos; then &apos;Daily&apos;&#10;ELSEIF ([Parameters].[Parameter 1 2] = &apos;week&apos; or [Parameters].[Parameter 1 2] = &apos;week w wtd&apos;) then &apos;Week&apos;&#10;ELSEIF ([Parameters].[Parameter 1 2] = &apos;month&apos; or [Parameters].[Parameter 1 2] = &apos;month w mtd&apos;) then &apos;Month&apos;&#10;END' />
            </column>
            <column caption='Account Source' datatype='string' name='[account_source]' role='dimension' type='nominal' />
