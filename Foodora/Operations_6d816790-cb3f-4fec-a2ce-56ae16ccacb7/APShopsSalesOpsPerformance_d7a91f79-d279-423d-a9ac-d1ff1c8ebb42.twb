            <column caption='comm% after trial color indicator' datatype='integer' name='[comm% w trial color indicator (copy)_4304245028275724295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if isnull([Comm % w trial (copy)_496381171775561730]) then 0&#10;elseif ([Comm % w trial (copy)_496381171775561730] - [comm% w trial l7period avg  (copy)_4304245028275638278])/abs([comm% w trial l7period avg  (copy)_4304245028275638278]) &gt;=0.1&#10;then 2&#10;elseif ([Comm % w trial (copy)_496381171775561730] - [comm% w trial l7period avg  (copy)_4304245028275638278])/abs([comm% w trial l7period avg  (copy)_4304245028275638278]) &lt;=-0.1 &#10;then -2&#10;elseif (([Comm % w trial (copy)_496381171775561730] - [comm% w trial l7period avg  (copy)_4304245028275638278])/abs([comm% w trial l7period avg  (copy)_4304245028275638278]) &gt;= 0.05)&#10;then 1&#10;elseif ([Comm % w trial (copy)_496381171775561730] - [comm% w trial l7period avg  (copy)_4304245028275638278])/abs([comm% w trial l7period avg  (copy)_4304245028275638278]) &lt;=-0.05&#10;then -1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='comm% after trial l7period avg' datatype='real' name='[comm% w trial l7period avg  (copy)_4304245028275638278]' role='measure' type='quantitative'>
