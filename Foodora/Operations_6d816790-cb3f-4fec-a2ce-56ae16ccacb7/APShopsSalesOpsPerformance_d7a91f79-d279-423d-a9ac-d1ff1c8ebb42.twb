            <column-instance column='[activated_date]' derivation='Max' name='[max:activated_date:qk]' pivot='key' type='quantitative' />
            <column caption='Total Onboarded Vendor SKUs l7period avg' datatype='real' name='[no of sku per vendor l7period avg  (copy)_982066193984401412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(AVG(IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END),first(),first()+7)'>
