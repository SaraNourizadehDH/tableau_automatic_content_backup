            <column caption='Num of Products' datatype='integer' name='[num_of_product]' role='measure' type='quantitative' />
            <column caption='Opp Owner Name' datatype='string' name='[opp_owner_full_name]' role='dimension' type='nominal' />
            <column caption='Opp Owner Type' datatype='string' name='[opp_owner_grouped]' role='dimension' type='nominal' />
            <column caption='Opp Owner Title' datatype='string' name='[opp_owner_title]' role='dimension' type='nominal' />
            <column caption='Sf Account Id' datatype='string' name='[sf_account_id]' role='dimension' type='nominal' />
            <column caption='Signup Date' datatype='date' name='[signup_date]' role='dimension' type='ordinal' />
            <column caption='sku per vendor color indicator' datatype='integer' name='[signups color indicator (copy)_4304245028274065411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if isnull([Calculation_496381171776454659]) then 0&#10;elseif ([Calculation_496381171776454659] - [no of signups l7period avg (copy)_4304245028273885186])/abs([no of signups l7period avg (copy)_4304245028273885186]) &gt;=0.3&#10;then 2&#10;elseif ([Calculation_496381171776454659] - [no of signups l7period avg (copy)_4304245028273885186])/abs([no of signups l7period avg (copy)_4304245028273885186]) &lt;=-0.3 &#10;then -2&#10;elseif (([Calculation_496381171776454659] - [no of signups l7period avg (copy)_4304245028273885186])/abs([no of signups l7period avg (copy)_4304245028273885186]) &gt;= 0.2)&#10;then 1&#10;elseif ([Calculation_496381171776454659] - [no of signups l7period avg (copy)_4304245028273885186])/abs([no of signups l7period avg (copy)_4304245028273885186]) &lt;=-0.2&#10;then -1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[Calculation_6050867640151576576]' derivation='User' name='[usr:Calculation_6050867640151576576:qk]' pivot='key' type='quantitative' />
            <column-instance column='[signups color indicator (copy)_4304245028274065411]' derivation='User' name='[usr:signups color indicator (copy)_4304245028274065411:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.1agh3n91uw9mvr1cviijb06zs10m].[no of signups l7period avg (copy)_4304245028273885186]' ordering-type='Rows' />
            </column-instance>
