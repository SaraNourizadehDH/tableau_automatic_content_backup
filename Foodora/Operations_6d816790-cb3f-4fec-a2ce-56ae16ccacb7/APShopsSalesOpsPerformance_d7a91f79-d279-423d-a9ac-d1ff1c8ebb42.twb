            <column caption='Dynamic column name' datatype='string' name='[Calculation_6333046271255556099]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1 2] = &apos;day&apos; then &apos;Daily&apos;&#10;ELSEIF ([Parameters].[Parameter 1 2] = &apos;week&apos; or [Parameters].[Parameter 1 2] = &apos;week w wtd&apos;) then &apos;Week&apos;&#10;ELSEIF ([Parameters].[Parameter 1 2] = &apos;month&apos; or [Parameters].[Parameter 1 2] = &apos;month w mtd&apos;) then &apos;Month&apos;&#10;END' />
            </column>
            <column caption='Dynamic Date Filter: Activations' datatype='boolean' name='[Dynamic Date Filter: Signup (copy)_3839037248881795072]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1 2] = &apos;month&apos; THEN [activated_date] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [activated_date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;week&apos; THEN [activated_date] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [activated_date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;day&apos; THEN [activated_date] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [activated_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;month w mtd&apos; THEN [activated_date] &gt;= DATEADD(&apos;month&apos;,-5,DATETRUNC(&apos;month&apos;,TODAY())) AND [activated_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;week w wtd&apos; THEN [activated_date] &gt;= DATEADD(&apos;iso-week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [activated_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;END' />
            </column>
            <column caption='Dynamic Date Range (Activated)' datatype='string' name='[Dynamic Date Range (Signup) (copy)_6558507761620418560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1 2] = &apos;week&apos; or [Parameters].[Parameter 1 2] = &apos;week w wtd&apos;) then str(DATEPART(&apos;iso-year&apos;,[activated_date]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[activated_date]))&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;day&apos; then str(DATEPART(&apos;day&apos;,[activated_date]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[activated_date])),3)&#10;ELSEIF ([Parameters].[Parameter 1 2] = &apos;month&apos; or [Parameters].[Parameter 1 2] = &apos;month w mtd&apos;) then LEFT(str(DATENAME(&apos;month&apos;,[activated_date])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[activated_date])),2) end' />
