      <aliases enabled='yes' />
      <column caption='F60D Offline Rate %' datatype='real' default-format='p0.0%' name='[Calculation_1177902455891107840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([f60d_closed_minutes]) / SUM([f60d_open_minutes])' />
      </column>
      <column caption='F60D Fail Rate %' datatype='real' default-format='p0.0%' name='[Calculation_2782732015849418752]' role='measure' type='quantitative'>
