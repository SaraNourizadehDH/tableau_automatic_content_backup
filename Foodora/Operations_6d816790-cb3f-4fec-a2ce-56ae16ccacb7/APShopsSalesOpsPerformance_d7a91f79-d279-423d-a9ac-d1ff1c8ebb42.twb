    <worksheet name='Avg Total SKU per vendor (Vertical)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='12'> SKU per Activated Vendor (Vertical)</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold'>Æ </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'>(No. of SKU per activated vendors in the period)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_shops__sales_performance_dashboard' name='federated.1agh3n91uw9mvr1cviijb06zs10m' />
