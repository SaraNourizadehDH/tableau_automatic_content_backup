            <column caption='onboarded vendors mtd indicator' datatype='string' name='[onboarded vendors mtd (copy)_2133510013856124934]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    COUNTD(&#10;        iif([Calculation_128141504433950898], (IF ISNULL([activated_date]) = FALSE THEN [sf_account_id] END), NULL)&#10;    )&#10;    -&#10;    COUNTD(&#10;        iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [sf_account_id] END), NULL)&#10;    )&#10;)&#10;&#10;/&#10;iif(&#10;isnull(COUNTD(&#10;    iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [sf_account_id] END), NULL)&#10;)) or (COUNTD(&#10;    iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [sf_account_id] END), NULL)&#10;)) = 0,&#10;1,&#10;COUNTD(&#10;    iif([Calculation_128141504434032819], (IF ISNULL([activated_date]) = FALSE THEN [sf_account_id] END), NULL)&#10;)&#10;)&#10;&#10;&lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
