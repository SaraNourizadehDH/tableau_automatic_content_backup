              <calculation class='tableau' formula='&quot;month w mtd&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;month w mtd&quot;' value='Month (incl. curr)' />
                <alias key='&quot;week&quot;' value='Week' />
                <alias key='&quot;week w wtd&quot;' value='Week (incl. curr)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1agh3n91uw9mvr1cviijb06zs10m'>
            <column aggregation='Sum' caption='Is KA' datatype='integer' name='[Calculation_1474225247392129024]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [is_key_vip_account] THEN 1 ELSE 0 END' />
            </column>
            <column caption='Avg sku per vendor' datatype='real' name='[Calculation_496381171776454659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6050867640157220865])/([Calculation_6050867640151576576])' />
            </column>
            <column caption='No of Onboarded Vendors' datatype='integer' name='[Calculation_6050867640151576576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF ISNULL([activated_date]) = FALSE THEN [sf_account_id] END)' />
            </column>
            <column caption='Total Onboarded Vendors SKUs' datatype='integer' name='[Calculation_6050867640157220865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END)' />
            </column>
            <column caption='Dynamic Date Filter: Signup' datatype='boolean' name='[Calculation_6333046271249321986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1 2] = &apos;month&apos; THEN [signup_date] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [signup_date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;week&apos; THEN [signup_date] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [signup_date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;day&apos; THEN [signup_date] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [signup_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;month w mtd&apos; THEN [signup_date] &gt;= DATEADD(&apos;month&apos;,-5,DATETRUNC(&apos;month&apos;,TODAY())) AND [signup_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;week w wtd&apos; THEN [signup_date] &gt;= DATEADD(&apos;iso-week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [signup_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;END' />
            </column>
            <column caption='Dynamic column name' datatype='string' name='[Calculation_6333046271255556099]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1 2] = &apos;day&apos; then &apos;Daily&apos;&#10;ELSEIF ([Parameters].[Parameter 1 2] = &apos;week&apos; or [Parameters].[Parameter 1 2] = &apos;week w wtd&apos;) then &apos;Week&apos;&#10;ELSEIF ([Parameters].[Parameter 1 2] = &apos;month&apos; or [Parameters].[Parameter 1 2] = &apos;month w mtd&apos;) then &apos;Month&apos;&#10;END' />
            </column>
            <column caption='Dynamic Date Range (Activated)' datatype='string' name='[Dynamic Date Range (Signup) (copy)_6558507761620418560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1 2] = &apos;week&apos; or [Parameters].[Parameter 1 2] = &apos;week w wtd&apos;) then str(DATEPART(&apos;iso-year&apos;,[activated_date]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[activated_date]))&#10;ELSEIF [Parameters].[Parameter 1 2] = &apos;day&apos; then str(DATEPART(&apos;day&apos;,[activated_date]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[activated_date])),3)&#10;ELSEIF ([Parameters].[Parameter 1 2] = &apos;month&apos; or [Parameters].[Parameter 1 2] = &apos;month w mtd&apos;) then LEFT(str(DATENAME(&apos;month&apos;,[activated_date])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[activated_date])),2) end' />
            </column>
            <column caption='Account Source' datatype='string' name='[account_source]' role='dimension' type='nominal' />
            <column caption='Activated Date' datatype='date' name='[activated_date]' role='dimension' type='ordinal' />
            <column caption='Country Name' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Service Types' datatype='string' name='[delivery_service_types]' role='dimension' type='nominal' />
            <column caption='Is Key Vip Account' datatype='boolean' name='[is_key_vip_account]' role='dimension' type='nominal' />
            <column caption='Is Strategic Brand' datatype='boolean' name='[is_strategic_account]' role='dimension' type='nominal' />
            <column caption='Key Account Subcategory' datatype='string' name='[key_account_sub_category]' role='dimension' type='nominal' />
            <column caption='no of sku per vendor l7period avg ' datatype='real' name='[no of signups l7period avg (copy)_4304245028273885186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG([Calculation_496381171776454659],first(),first()+7)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[Calculation_1474225247392129024]' derivation='None' name='[none:Calculation_1474225247392129024:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_6333046271249321986]' derivation='None' name='[none:Calculation_6333046271249321986:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6333046271255556099]' derivation='None' name='[none:Calculation_6333046271255556099:nk]' pivot='key' type='nominal' />
            <column-instance column='[Dynamic Date Range (Signup) (copy)_6558507761620418560]' derivation='None' name='[none:Dynamic Date Range (Signup) (copy)_6558507761620418560:nk]' pivot='key' type='nominal' />
            <column-instance column='[account_source]' derivation='None' name='[none:account_source:nk]' pivot='key' type='nominal' />
