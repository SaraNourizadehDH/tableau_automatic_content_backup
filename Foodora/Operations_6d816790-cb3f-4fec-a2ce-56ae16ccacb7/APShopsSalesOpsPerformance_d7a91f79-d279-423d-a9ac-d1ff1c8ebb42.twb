            <column caption='Num of Products' datatype='integer' name='[num_of_product]' role='measure' type='quantitative' />
            <column caption='Opp Owner Name' datatype='string' name='[opp_owner_full_name]' role='dimension' type='nominal' />
            <column caption='Opp Owner Type' datatype='string' name='[opp_owner_grouped]' role='dimension' type='nominal' />
            <column caption='Opp Owner Title' datatype='string' name='[opp_owner_title]' role='dimension' type='nominal' />
