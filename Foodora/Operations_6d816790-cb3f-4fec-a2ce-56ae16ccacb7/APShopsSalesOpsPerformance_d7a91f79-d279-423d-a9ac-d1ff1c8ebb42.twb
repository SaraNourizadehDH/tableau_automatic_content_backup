      <aliases enabled='yes' />
      <column caption='# Accounts Created Activated' datatype='integer' default-format='n#,##0;-#,##0' name='[% Accounts Created Activations  (copy)_6519804887390453760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([activated_date]) THEN  [sf_account_id] END)' />
      </column>
      <column caption='% Accounts with Onboarding Fee' datatype='real' default-format='p0.0%' name='[% Accounts with Listing Fee (copy)_3419428436577423364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [has_onboarding_fee] THEN [sf_account_id] END)/COUNTD([sf_account_id])' />
      </column>
      <column caption='% Accounts with Listing Fee at Signup' datatype='real' default-format='p0.0%' name='[% Accounts with Listing Fee (copy)_5816680444828155904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [has_listing_fee_signup] THEN [sf_account_id] END)/COUNTD([sf_account_id])' />
      </column>
      <column caption='% Accounts with Listing Fee' datatype='real' default-format='p0.0%' name='[% Accounts with Sales NCR (copy)_3419428436576817155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [has_listing_fee] THEN [sf_account_id] END)/COUNTD([sf_account_id])' />
      </column>
      <column caption='% Activations: 30D Zombie' datatype='real' default-format='p0.0%' name='[% Activations with Deal (copy)_3419428436584398856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_30d_zombie] THEN [sf_account_id] END)/COUNTD([sf_account_id])' />
      </column>
      <column caption='% Accounts Created Activations ' datatype='real' default-format='p0.0%' name='[% Activations with Deal (copy)_5816680444830420994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([activated_date]) THEN  [sf_account_id] END)/COUNTD([sf_account_id])' />
      </column>
      <column caption='% Activations: 60D Zombie' datatype='real' default-format='p0.0%' name='[% Activations: 30D Zombie (copy)_3419428436584898569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_60d_zombie] THEN [sf_account_id] END)/COUNTD([sf_account_id])' />
      </column>
      <column caption='% Activations: 90D Zombie' datatype='real' default-format='p0.0%' name='[% Activations: 60D Zombie (copy)_3419428436585123850]' role='measure' type='quantitative'>
