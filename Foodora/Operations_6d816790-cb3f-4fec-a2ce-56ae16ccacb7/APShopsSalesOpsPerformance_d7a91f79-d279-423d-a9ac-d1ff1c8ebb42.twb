      <column caption='Opp Created Month' datatype='datetime' default-format='*mmm yy' name='[Account Created Month (copy)_5816680444831309827]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [sf_opportunity_created_date])' />
      </column>
      <column caption='Activated Date + 30 &lt; Current Month (copy)' datatype='boolean' name='[Activated Date + 30 &lt; Current Month (copy)_4316489163515092997]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[activated_date] + 30 &lt; DATETRUNC(&quot;month&quot;, TODAY())' />
      </column>
      <column caption='Avg Total Onboarded Vendor SKUs' datatype='real' name='[Avg sku per vendor (copy)_982066193984061443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF ISNULL([activated_date]) = FALSE THEN [num_of_product] END)' />
      </column>
      <column caption='MTD' datatype='boolean' name='[Calculation_128141504433950898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [signup_date], today() - 1) = 0&#10;AND&#10;DAY([signup_date]) &lt;= DAY(TODAY()-1)' />
      </column>
      <column caption='PMTD' datatype='boolean' name='[Calculation_128141504434032819]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [signup_date], today() - 1) = 1&#10;AND&#10;DAY([signup_date]) &lt;= DAY(TODAY()-1)' />
      </column>
      <column aggregation='Sum' caption='Is KA' datatype='integer' name='[Calculation_1474225247392129024]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [is_key_vip_account] THEN 1 ELSE 0 END' />
      </column>
      <column caption='no of ka signing' datatype='integer' name='[Calculation_2155887227772108800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_1474225247392129024] = 1 then [Calculation_2155887227800289282] end' />
      </column>
      <column caption='%ka signing' datatype='real' name='[Calculation_2155887227773661185]' role='measure' type='quantitative'>
