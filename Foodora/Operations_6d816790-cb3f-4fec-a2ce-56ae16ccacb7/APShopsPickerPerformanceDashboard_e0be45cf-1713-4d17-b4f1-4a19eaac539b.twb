      <aliases enabled='yes' />
      <column caption='% Incident Rate: Missing Items' datatype='real' default-format='p0.0%' name='[% Incident Rate (copy)_132856220131659782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM([num_of_issues_missing_items]) &#10;) &#10;/ &#10;SUM([num_of_orders])' />
      </column>
      <column caption='% Incident Rate: Wrong Items' datatype='real' default-format='p0.0%' name='[% Incident Rate: Missing Items (copy)_132856220131778567]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM([num_of_issues_wrong_items])&#10;) &#10;/ &#10;SUM([num_of_orders])' />
      </column>
      <column caption='% Orders PLC: Suggestion Answered' datatype='real' default-format='p0.0%' name='[% Orders PLC: Suggestion Sent (copy)_132856220436742156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_orders_plc_suggestions_answered]) / SUM([num_of_ir_phase_2_eligible_orders])' />
      </column>
      <column caption='% Total Vendor IND' datatype='real' default-format='p0.0%' name='[% Total Chain IND (copy)_132856220436205577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ind_unfilfilled_quantity]) /&#10;MAX({FIXED [global_entity_id], [Calculation_182606908425760769], [vendor_code]: SUM([ind_unfilfilled_quantity])})' />
      </column>
      <column caption='Perspective 1' datatype='string' name='[Calculation_132856220128837633]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;Picker → Vendor&quot; THEN STR([Calculation_749778982308659223]) &#10;WHEN &quot;Picker → Chain&quot; THEN STR([Calculation_749778982308659223]) &#10;WHEN &quot;Vendor → Picker&quot; THEN [vendor_code]&#10;WHEN &quot;Chain → Picker&quot; THEN [chain_code]&#10;END' />
      </column>
      <column caption='Perspective 2' datatype='string' name='[Calculation_132856220130160643]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;Picker → Vendor&quot; THEN [vendor_code]&#10;WHEN &quot;Picker → Chain&quot; THEN [chain_code]&#10;WHEN &quot;Vendor → Picker&quot; THEN STR([Calculation_749778982308659223])&#10;WHEN &quot;Chain → Picker&quot; THEN STR([Calculation_749778982308659223])&#10;END' />
      </column>
      <column caption='Perspective Text' datatype='string' name='[Calculation_132856220130529284]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;Picker → Vendor&quot; THEN [vendor_name]&#10;WHEN &quot;Picker → Chain&quot; THEN [chain_name]&#10;WHEN &quot;Vendor → Picker&quot; THEN [vendor_name]&#10;WHEN &quot;Chain → Picker&quot; THEN [chain_name]&#10;END' />
      </column>
      <column caption='% Items Not Delivered' datatype='real' default-format='p0.0%' name='[Calculation_132856220131414021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ind_unfilfilled_quantity]) / SUM([ind_ordered_quantity])' />
      </column>
      <column caption='% Total Chain IND' datatype='real' default-format='p0.0%' name='[Calculation_132856220435619848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ind_unfilfilled_quantity]) /&#10;MAX({FIXED [global_entity_id], [Calculation_182606908425760769], [chain_code]: SUM([ind_unfilfilled_quantity])})' />
      </column>
      <column caption='% Orders PLC: Suggestion Sent' datatype='real' default-format='p0.0%' name='[Calculation_132856220436570123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_orders_plc_suggestions_sent]) / SUM([num_of_ir_phase_2_eligible_orders])' />
      </column>
      <column caption='Isoweek' datatype='datetime' default-format='*mmm dd' name='[Calculation_1442629655820156928]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;iso-week&apos;, [report_date_local])' />
      </column>
      <column caption='Week Split' datatype='string' name='[Calculation_1442629655820996609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_date_dayofweek] IN (2,3,4) THEN &quot;Mon to Wed&quot; ELSE &quot;Thurs to Sun&quot; END' />
      </column>
      <column caption='Worst Category' datatype='string' name='[Calculation_1442629655821434882]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1442629655820996609] = &quot;Mon to Wed&quot; THEN [top_mon_wed_ind_category] ELSE [top_thurs_sun_ind_category] END' />
      </column>
      <column caption='Avg Weighted Item per Weighted Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1442629655861874697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sold_by_weight_ordered_quantity]) / SUM([num_of_orders_sold_by_weight])' />
      </column>
      <column caption='Date' datatype='date' datatype-customized='true' default-format='*Mmm Dd' name='[Calculation_182606908425760769]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;Week&quot; THEN DATETRUNC(&apos;iso-week&apos;, [report_date_local])&#10;    WHEN &quot;Month&quot; THEN DATETRUNC(&apos;month&apos;, [report_date_local])&#10;    ELSE [report_date_local]&#10;END)' />
      </column>
      <column caption='Weighted Average Picking Time' datatype='real' name='[Calculation_749778981294034944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_picking_time]) / 60 / SUM([num_of_valid_accurately_picked_orders])' />
      </column>
      <column caption='% Partial Order Rate' datatype='real' name='[Calculation_749778981294170113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_valid_partially_fulfilled_orders]) / SUM([num_of_valid_orders])' />
      </column>
      <column caption='% Found Rate' datatype='real' name='[Calculation_749778981300473858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivered_quantity]) / SUM([ordered_quantity])' />
      </column>
      <column caption='% Incident Rate: Wrong or Missing' datatype='real' name='[Calculation_749778981301608451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM([num_of_issues_missing_items]) + SUM([num_of_issues_wrong_items])&#10;) &#10;/ &#10;SUM([num_of_orders])' />
      </column>
      <column caption='Average Basket Size (Units)' datatype='real' name='[Calculation_749778981590224900]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivered_quantity]) / SUM([num_of_orders])' />
      </column>
      <column caption='% Vendor Fail Rate' datatype='real' name='[Calculation_749778981596368901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_vendor_failed_orders]) / SUM([num_of_orders])' />
      </column>
      <column caption='Orders Per Picker' datatype='real' name='[Calculation_749778981646925830]' role='measure' type='quantitative'>
