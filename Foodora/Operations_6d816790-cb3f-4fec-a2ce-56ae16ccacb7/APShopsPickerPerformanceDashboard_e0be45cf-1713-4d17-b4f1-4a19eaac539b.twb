    <worksheet name='(Picker Performance) Weighted Average Picking Time'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#e80078' fontname='Tableau Bold' fontsize='10'>WEIGHTED AVG PICK TIME (MINS)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_shops__picker_performance_dashboard (pandata_report)' name='federated.0z0jn1n1naqymj14wsrw209g18yw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Picker Perspective' datatype='string' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Shopper&quot;'>
              <calculation class='tableau' formula='&quot;Shopper&quot;' />
            </column>
            <column alias='Month' caption='Date Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
              <aliases>
                <alias key='&quot;Day&quot;' value='Day' />
                <alias key='&quot;Month&quot;' value='Month' />
                <alias key='&quot;Week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0z0jn1n1naqymj14wsrw209g18yw'>
            <column caption='Date' datatype='date' datatype-customized='true' default-format='*Mmm Dd' name='[Calculation_182606908425760769]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;Week&quot; THEN DATETRUNC(&apos;iso-week&apos;, [report_date_local])&#10;    WHEN &quot;Month&quot; THEN DATETRUNC(&apos;month&apos;, [report_date_local])&#10;    ELSE [report_date_local]&#10;END)' />
            </column>
            <column caption='Weighted Average Picking Time' datatype='real' name='[Calculation_749778981294034944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_picking_time]) / 60 / SUM([num_of_valid_accurately_picked_orders])' />
            </column>
            <column caption='Picker Id' datatype='integer' name='[Calculation_749778982308659223]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Rooster&quot; THEN [rooster_id] &#10;    ELSE [shopper_id]&#10;END' />
            </column>
            <column caption='Picker Name' datatype='string' name='[Calculation_749778982309441560]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Shopper&quot; THEN [shopper_name]&#10;    ELSE &quot;&quot;&#10;END' />
            </column>
            <column caption='is_valid_picker' datatype='boolean' name='[Calculation_749778982322434073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([Calculation_749778982308659223]) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_182606908425760769]' derivation='None' name='[none:Calculation_182606908425760769:ok]' pivot='key' type='ordinal' />
