              <calculation class='tableau' formula='&quot;Month&quot;' />
              <aliases>
                <alias key='&quot;Day&quot;' value='Day' />
                <alias key='&quot;Month&quot;' value='Month' />
                <alias key='&quot;Week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1w49iy016eopel1b6q6341porvar'>
            <column caption='Open Shift' datatype='integer' name='[Calculation_171136802835668993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [shift_state] = &quot;OPEN&quot; THEN [shift_id] ELSE NULL  END)' />
            </column>
            <column caption='Not Taken Shift' datatype='integer' name='[Calculation_749778982035144719]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [shift_state] = &quot;NO_SHOW&quot; THEN [shift_id] ELSE NULL  END)' />
            </column>
            <column caption='Report Date Local' datatype='date' datatype-customized='true' default-format='*Mmm Dd' name='[Calculation_749778982035656720]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;Month&quot; THEN DATETRUNC(&apos;month&apos;, [shift_start_date_local])&#10;    WHEN &quot;Week&quot; THEN DATETRUNC(&apos;iso-week&apos;, [shift_start_date_local])&#10;    ELSE [shift_start_date_local]&#10;END)' />
            </column>
            <column caption='Published Shift' datatype='integer' name='[Calculation_749778982039642129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([shift_id])' />
            </column>
            <column caption='Taken Shift' datatype='integer' name='[Calculation_749778982039949330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [shift_state] = &quot;EVALUATED&quot; OR [shift_state] = &quot;IN_DISCUSSION&quot; THEN [shift_id] ELSE NULL END)' />
            </column>
            <column caption='% Not Taken' datatype='real' name='[Calculation_749778982043824149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_749778982035144719] / [Calculation_749778982039642129]' />
            </column>
            <column caption='Pending Shift' datatype='integer' name='[Calculation_749778982612357146]' role='measure' type='quantitative'>
