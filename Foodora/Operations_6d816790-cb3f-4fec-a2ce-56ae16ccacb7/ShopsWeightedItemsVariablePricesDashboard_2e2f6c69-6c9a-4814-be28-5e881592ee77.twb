      <aliases enabled='yes' />
      <column caption='% Partial Order Rate: Weighted Item Adjusted Orders' datatype='real' default-format='p0.0%' name='[% Partial Order Rate: Weighted Item Orders (copy)_235453881730252801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_partially_fulfilled_weighted_item_adjusted_orders])/ SUM([num_of_valid_weighted_item_adjusted_orders])' />
      </column>
      <column caption='% Weighted Item Gross Orders with Refund Request Issue' datatype='real' default-format='p0.0%' name='[% of Weighted Item Gross Orders with Missing Item Issue (copy) (copy) (copy)_3107624510485925897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_weighted_item_orders_w_missing_item_issue])&#10;/&#10;SUM([num_of_weighted_item_orders])' />
      </column>
      <column caption='% Weighted Item Gross Orders with Refund Query Issue' datatype='real' default-format='p0.0%' name='[% of Weighted Item Gross Orders with Missing Item Issue (copy) (copy)_3107624510485917704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_weighted_item_orders_w_refund_query_issue])&#10;/&#10;SUM([num_of_weighted_item_orders])' />
      </column>
      <column caption='% Weighted Item Gross Orders with Wrong Item Issue' datatype='real' default-format='p0.0%' name='[% of Weighted Item Gross Orders with Missing Item Issue (copy)_3107624510485909511]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_weighted_item_orders_w_wrong_item_issue])&#10;/&#10;SUM([num_of_weighted_item_orders])' />
      </column>
