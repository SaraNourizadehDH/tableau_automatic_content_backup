      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_shops__weighted_items_dashboard (pandata_report)' name='federated.0ftlcxb1woor2c16poj6i0uk4e66' />
          </datasources>
          <datasource-dependencies datasource='federated.0ftlcxb1woor2c16poj6i0uk4e66'>
            <column caption='% Weighted Item Gross Orders with Refund Request Issue' datatype='real' default-format='p0.0%' name='[% of Weighted Item Gross Orders with Missing Item Issue (copy) (copy) (copy)_3107624510485925897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_weighted_item_orders_w_missing_item_issue])&#10;/&#10;SUM([num_of_weighted_item_orders])' />
            </column>
            <column caption='% Weighted Item Gross Orders with Refund Query Issue' datatype='real' default-format='p0.0%' name='[% of Weighted Item Gross Orders with Missing Item Issue (copy) (copy)_3107624510485917704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_weighted_item_orders_w_refund_query_issue])&#10;/&#10;SUM([num_of_weighted_item_orders])' />
            </column>
            <column caption='% Weighted Item Gross Orders with Wrong Item Issue' datatype='real' default-format='p0.0%' name='[% of Weighted Item Gross Orders with Missing Item Issue (copy)_3107624510485909511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_weighted_item_orders_w_wrong_item_issue])&#10;/&#10;SUM([num_of_weighted_item_orders])' />
            </column>
            <column caption='ABV (€): Weighted Item Vendors' datatype='real' default-format='c&quot;€&quot;#,##0.00;(&quot;€&quot;#,##0.00)' name='[ABV (€): Weighted Item Orders (copy)_467037390233681920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_orders_gfv_eur])&#10;/&#10;SUM([num_of_valid_orders])' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_141652313711763458]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date_local] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY()-1))' />
            </column>
            <column caption='% Partial Order Rate: Weighted Item Orders' datatype='real' default-format='p0.0%' name='[Calculation_235453881730080768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_partially_fulfilled_weighted_item_orders])/ SUM([num_of_valid_weighted_item_orders])' />
            </column>
