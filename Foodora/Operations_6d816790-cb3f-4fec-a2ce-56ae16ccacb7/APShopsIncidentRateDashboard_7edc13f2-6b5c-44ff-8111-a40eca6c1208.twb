            <column-instance column='[is_shops_pelican_order]' derivation='None' name='[none:is_shops_pelican_order:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_subscriber_order]' derivation='None' name='[none:is_subscriber_order:nk]' pivot='key' type='nominal' />
            <column caption='Num Of Issues' datatype='integer' name='[num_of_issues]' role='measure' type='quantitative' />
            <column datatype='integer' name='[num_of_non_nego_issues]' role='measure' type='quantitative' />
            <column caption='Num Of Orders' datatype='integer' name='[num_of_orders]' role='measure' type='quantitative' />
            <column caption='Num Of Orders With Issue' datatype='integer' name='[num_of_orders_with_issue]' role='measure' type='quantitative' />
            <column caption='Order Date' datatype='date' name='[order_date_local]' role='dimension' type='ordinal' />
            <column caption='Sorrypanda Count' datatype='integer' name='[sorrypanda_count]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1714956686204350464]' derivation='User' name='[usr:Calculation_1714956686204350464:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1714956686205984769]' derivation='User' name='[usr:Calculation_1714956686205984769:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
