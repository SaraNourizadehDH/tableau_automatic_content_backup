            <run bold='true' fontalignment='1' fontcolor='#f4077f' fontname='Tableau Regular' fontsize='8' italic='true'>Metric</run>
            <run fontalignment='1' fontcolor='#898989' fontname='Tableau Regular' fontsize='8' italic='true'> to compare against and </run>
            <run bold='true' fontalignment='1' fontcolor='#f4077f' fontname='Tableau Regular' fontsize='8' italic='true'>Top N Country</run>
            <run fontalignment='1' fontcolor='#898989' fontname='Tableau Regular' fontsize='8' italic='true'> to view more.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_shops__incident_rate_dashboard (pandata_report)' name='federated.1pg4ijg0bt2reg17m51xz0rmcnl4' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Fraud Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Restaurant Incident Rate&quot;'>
              <calculation class='tableau' formula='&quot;Restaurant Incident Rate&quot;' />
              <aliases>
                <alias key='&quot;Sorrypanda&quot;' value='# Sorrypanda Orders' />
              </aliases>
            </column>
            <column alias='Week' caption='Date Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;iso-week&quot;'>
              <calculation class='tableau' formula='&quot;iso-week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;iso-week&quot;' value='Week' />
                <alias key='&quot;month&quot;' value='Month' />
              </aliases>
            </column>
            <column caption='Top N Country' datatype='integer' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='4'>
              <calculation class='tableau' formula='4' />
              <range max='12' min='1' />
            </column>
            <column caption='Incident Type' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Incident Rate&quot;'>
              <calculation class='tableau' formula='&quot;Incident Rate&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1pg4ijg0bt2reg17m51xz0rmcnl4'>
            <column caption='Date Type' datatype='datetime' default-format='*mmm d' name='[Calculation_113082595608236035]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 2], [order_date_local])' />
            </column>
            <column caption='Incident Rate' datatype='real' default-format='p0.0%' name='[Calculation_1714956686204350464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &quot;Non Nego Incident Rate&quot;&#10;THEN &#10;&#10;SUM(IF [Calculation_3640245536539054082] THEN &#10;[num_of_non_nego_issues] END)&#10;/ &#10;SUM(IF [Calculation_3640245536539054082] THEN &#10;[num_of_orders] END)&#10;&#10;ELSE&#10;&#10;SUM(IF [Calculation_3640245536539054082] THEN &#10;[num_of_issues] END)&#10;/ &#10;SUM(IF [Calculation_3640245536539054082] THEN &#10;[num_of_orders] END)&#10;END' />
            </column>
            <column caption='Comparison Metric' datatype='real' name='[Calculation_1714956686205984769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Sorrypanda&apos; THEN &#10;SUM(IF [Calculation_3640245536539054082] THEN [sorrypanda_count] END)&#10;//ELSEIF [Parameters].[Fraud Type] = &apos;Partial Refund&apos; THEN&#10;//SUM(IF [Is Shops Vendor] THEN [partial_refund_orders] END)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;# Issues&apos; THEN&#10;SUM(IF [Calculation_3640245536539054082] THEN [num_of_issues] END)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;# Orders with Issues&apos; THEN&#10;SUM(IF [Calculation_3640245536539054082] THEN [num_of_orders_with_issue] END) &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Restaurant Incident Rate&apos; THEN&#10;([Calculation_3640245536533585920]) &#10;END' />
            </column>
            <column caption='Exclude Max Date: T/F' datatype='boolean' name='[Calculation_1714956686206619650]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date_local] &lt;= DATEADD(&apos;day&apos;,-1,{MAX([order_date_local])})' />
            </column>
            <column caption='Restaurant Incident Rate' datatype='real' default-format='p0.0%' name='[Calculation_3640245536533585920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vendor_type] = &apos;restaurants&apos; THEN &#10;[num_of_issues] END)&#10;/&#10;SUM(IF [vendor_type] = &apos;restaurants&apos; THEN &#10;[num_of_orders] END)' />
            </column>
            <column caption='Is Shops Vendor' datatype='boolean' name='[Calculation_3640245536539054082]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_type] &lt;&gt; &apos;restaurants&apos; AND [vendor_type] &lt;&gt; &apos;pandago&apos; AND [vendor_type] &lt;&gt; &apos;pandamart&apos;' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Is Corporate Order' datatype='boolean' name='[is_corporate_order]' role='dimension' type='nominal' />
            <column caption='Is Pelican Order' datatype='boolean' name='[is_shops_pelican_order]' role='dimension' type='nominal' />
            <column caption='Is Subscriber' datatype='boolean' name='[is_subscriber_order]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_113082595608236035]' derivation='None' name='[none:Calculation_113082595608236035:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1714956686206619650]' derivation='None' name='[none:Calculation_1714956686206619650:nk]' pivot='key' type='nominal' />
