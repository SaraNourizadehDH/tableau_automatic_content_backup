    <worksheet name='CCR: Crosstab'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#f4077f' fontname='Tableau Medium' fontsize='12'>&lt;[Parameters].[Parameter 6]&gt;:</run>
            <run fontalignment='1' fontcolor='#f4077f' fontname='Tableau Medium' fontsize='12'> CCR/ LCR %</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#898989' fontname='Tableau Regular' fontsize='8' italic='true'>Drilldown of CCR% (Total Issues / Total Orders in Perspective) during selected Date Range and Perspective. Filters above apply. </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#898989' fontname='Tableau Regular' fontsize='8' italic='true'>e.g. if Singapore is selected in Country filter above, &apos;All&apos; Perspective only consists of Singapore data.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_shops__incident_rate_ccr_dashboard (pandata_report)' name='federated.1xbkrkw15ykkch13j7xv510xhejs' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Date Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;iso-week&quot;'>
              <calculation class='tableau' formula='&quot;iso-week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;iso-week&quot;' value='Week' />
                <alias key='&quot;month&quot;' value='Month' />
              </aliases>
            </column>
            <column alias='All' caption='Perspective' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;APAC&quot;'>
              <calculation class='tableau' formula='&quot;APAC&quot;' />
              <aliases>
                <alias key='&quot;APAC&quot;' value='All' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xbkrkw15ykkch13j7xv510xhejs'>
            <column caption='Date Type' datatype='datetime' default-format='*mmm d' name='[Calculation_130322944298967041]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 2], [order_date_local])' />
            </column>
            <column caption='CCR is NULL: T/F' datatype='boolean' name='[Calculation_130322944299139074]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([ccr1])' />
            </column>
            <column caption='CCR % Incident Rate' datatype='real' name='[Calculation_3097913631470485504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_issues]) &#10;/&#10;SUM(&#10;{FIXED [Calculation_130322944298967041], [Calculation_3097913631472709633]: SUM([num_of_orders])}&#10;&#10;//IF [Parameters].[Perspective] = &apos;Is Pelican Order&apos; THEN ({FIXED [Date Type], [Is Pelican Order]: SUM([Num Of Orders])})&#10;//ELSEIF [Parameters].[Perspective] = &apos;Chain&apos; THEN ({FIXED [Date Type], [Country Name], [Chain Code]: SUM([Num Of Orders])})&#10;//ELSEIF [Parameters].[Perspective] = &apos;Vendor&apos; THEN ({FIXED [Date Type], [Country Name], [Vendor Code]: SUM([Num Of Orders])})&#10;//END&#10;)' />
            </column>
            <column caption='Perspective' datatype='string' name='[Calculation_3097913631472709633]' role='dimension' type='nominal'>
