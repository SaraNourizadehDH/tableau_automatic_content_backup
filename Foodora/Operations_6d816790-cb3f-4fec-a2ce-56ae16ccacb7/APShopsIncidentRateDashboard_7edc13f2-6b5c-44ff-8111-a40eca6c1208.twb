            <column caption='Is Subscriber' datatype='boolean' name='[is_subscriber_order]' role='dimension' type='nominal' />
            <column-instance column='[order_date_local]' derivation='Max' name='[max:order_date_local:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_113082595608236035]' derivation='None' name='[none:Calculation_113082595608236035:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1714956686206619650]' derivation='None' name='[none:Calculation_1714956686206619650:nk]' pivot='key' type='nominal' />
