      <aliases enabled='yes' />
      <column caption='Latest Date Type Incident Rate' datatype='real' name='[Calculation_113082595565490177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF DATETRUNC([Parameters].[Parameter 2],[order_date_local]) = DATETRUNC([Parameters].[Parameter 2],{MAX([order_date_local])}) AND [Calculation_3640245536539054082]&#10;THEN [num_of_issues] END)&#10;/&#10;SUM(IF DATETRUNC([Parameters].[Parameter 2],[order_date_local]) = DATETRUNC([Parameters].[Parameter 2],{MAX([order_date_local])}) AND [Calculation_3640245536539054082]&#10;THEN [num_of_orders] END)' />
      </column>
      <column caption='Latest Date Type (-1) Incident Rate' datatype='real' name='[Calculation_113082595565613058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF DATEDIFF([Parameters].[Parameter 2], [Calculation_113082595608236035], {MAX([Calculation_113082595608236035])}) = 1 AND [Calculation_3640245536539054082]&#10;THEN [num_of_issues] END)&#10;/&#10;SUM(IF DATEDIFF([Parameters].[Parameter 2], [Calculation_113082595608236035], {MAX([Calculation_113082595608236035])}) = 1 AND [Calculation_3640245536539054082]&#10;THEN [num_of_orders] END)' />
      </column>
      <column caption='Date Type' datatype='datetime' default-format='*mmm d' name='[Calculation_113082595608236035]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 2], [order_date_local])' />
      </column>
      <column caption='Latest Date Type Incident Rate Growth: Display' datatype='string' name='[Calculation_113082595608498180]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(IF [Calculation_113082595565490177] - [Calculation_113082595565613058] &gt;= 0 &#10;THEN  &apos;▲&apos; ELSE &apos;▼&apos; END)&#10;+&#10;&apos;  &apos;&#10;+&#10;STR(ROUND(([Calculation_113082595565490177] - [Calculation_113082595565613058])*100,1))&#10;+ &apos;%&apos;' />
      </column>
      <column caption='Latest Date Type: T/F' datatype='boolean' name='[Calculation_113082596219236358]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{MAX([Calculation_113082595608236035])} = [Calculation_113082595608236035]' />
      </column>
      <column caption='Incident Rate' datatype='real' default-format='p0.0%' name='[Calculation_1714956686204350464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &quot;Non Nego Incident Rate&quot;&#10;THEN &#10;&#10;SUM(IF [Calculation_3640245536539054082] THEN &#10;[num_of_non_nego_issues] END)&#10;/ &#10;SUM(IF [Calculation_3640245536539054082] THEN &#10;[num_of_orders] END)&#10;&#10;ELSE&#10;&#10;SUM(IF [Calculation_3640245536539054082] THEN &#10;[num_of_issues] END)&#10;/ &#10;SUM(IF [Calculation_3640245536539054082] THEN &#10;[num_of_orders] END)&#10;END' />
      </column>
      <column caption='Comparison Metric' datatype='real' name='[Calculation_1714956686205984769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Sorrypanda&apos; THEN &#10;SUM(IF [Calculation_3640245536539054082] THEN [sorrypanda_count] END)&#10;//ELSEIF [Parameters].[Fraud Type] = &apos;Partial Refund&apos; THEN&#10;//SUM(IF [Is Shops Vendor] THEN [partial_refund_orders] END)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;# Issues&apos; THEN&#10;SUM(IF [Calculation_3640245536539054082] THEN [num_of_issues] END)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;# Orders with Issues&apos; THEN&#10;SUM(IF [Calculation_3640245536539054082] THEN [num_of_orders_with_issue] END) &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Restaurant Incident Rate&apos; THEN&#10;([Calculation_3640245536533585920]) &#10;END' />
      </column>
      <column caption='Exclude Max Date: T/F' datatype='boolean' name='[Calculation_1714956686206619650]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_date_local] &lt;= DATEADD(&apos;day&apos;,-1,{MAX([order_date_local])})' />
      </column>
      <column caption='% of Total IR' datatype='real' name='[Calculation_181973611580747780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_3640245536539054082] THEN &#10;[num_of_issues] END)&#10;/ &#10;TOTAL(SUM(IF [Calculation_3640245536539054082] THEN &#10;[num_of_orders] END))'>
          <table-calc ordering-type='Rows' />
