      <column caption='Month' datatype='string' name='[Calculation_1402308354904743937]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM( SPLIT( [Region Month], &quot;_&quot;, 3 ) )' />
      </column>
      <column caption='Dashboard link Text' datatype='string' name='[Calculation_2001850049606598657]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Dashboard Link&apos;' />
      </column>
      <column caption='Current Week' datatype='boolean' name='[Calculation_2804194503302496259]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[Region Month - Split 2]) &lt;&gt; DATETRUNC(&apos;week&apos;,TODAY())' />
      </column>
      <column caption='Year' datatype='string' name='[Calculation_460493079994880000]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM( SPLIT( [Region Month], &quot;_&quot;, 4 ) )' />
      </column>
      <column caption='Month Year' datatype='date' datatype-customized='true' name='[Calculation_460493079995011073]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE(&apos;MMMYYYY&apos;,([Calculation_1402308354904743937]+[Calculation_460493079994880000])))' />
      </column>
      <column caption='Split by country dimension' datatype='string' name='[Calculation_832321521317216256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Yes&apos; then [Region Month - Split 1] Else &apos;&apos; END' />
      </column>
      <column caption='Value ' datatype='string' name='[Calculation_832321521338052611]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ABS(AVG([Value])) &gt;= 1000000000 THEN&#13;&#10;//round for billions&#13;&#10;STR(ROUND(AVG([Value] / 1000000000), 1)) + &quot;B&quot;&#13;&#10;ELSEIF ABS(AVG([Value])) &gt;= 1000000 THEN&#13;&#10;//round for millions&#13;&#10;STR(ROUND(AVG([Value] / 1000000), 1)) + &quot;M&quot;&#13;&#10;ELSEIF ABS(AVG([Value])) &gt;= 1000 THEN&#13;&#10;//round for thousands&#13;&#10;STR(ROUND(AVG([Value] / 1000), 1)) + &quot;K&quot;&#13;&#10;ELSE&#13;&#10;STR(ROUND(AVG([Value]),2))&#13;&#10;END' />
      </column>
      <column caption='Market' datatype='string' name='[Country (copy)_832321521317748737]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.14uwjmc1gb728r1cfbzj20zfsw8r].[Region Month]'>
        <calculation class='tableau' formula='TRIM( SPLIT( [Region Month], &quot;_&quot;, 1 ) )' />
      </column>
