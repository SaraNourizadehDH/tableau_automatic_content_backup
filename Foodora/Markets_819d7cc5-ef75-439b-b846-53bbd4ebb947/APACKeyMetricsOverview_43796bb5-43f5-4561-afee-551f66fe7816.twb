      </column>
      <column caption='Metric1' datatype='string' name='[Metric]' role='dimension' type='nominal' />
      <column caption='Country' datatype='string' name='[Region Month - Split 1]' role='dimension' type='nominal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.14uwjmc1gb728r1cfbzj20zfsw8r].[Region Month]'>
        <calculation class='tableau' formula='TRIM( SPLIT( [Region Month], &quot;_&quot;, 1 ) )' />
      </column>
      <column caption='Week of' datatype='date' datatype-customized='true' name='[Region Month - Split 2]' role='dimension' type='ordinal' user:SplitFieldIndex='2' user:SplitFieldOrigin='[federated.14uwjmc1gb728r1cfbzj20zfsw8r].[Region Month]'>
        <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;dd-MMM-yyyy&quot;, TRIM( SPLIT( [Region Month], &quot;_&quot;, 2 ) )+&apos;-&apos;+TRIM( SPLIT( [Region Month], &quot;_&quot;, 3 ) )+&apos;-&apos;+TRIM( SPLIT( [Region Month], &quot;_&quot;, 4 ) ) )) ' />
