    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Description'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/Metrics360/Description?rev=' id='Description' path='/t/Foodora/workbooks/Metrics360' revision='' site='Foodora' />
      <style />
      <size maxheight='1300' maxwidth='1500' minheight='1300' minwidth='1500' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98770' id='5' param='vert' type-v2='layout-flow' w='98934' x='533' y='615'>
            <zone fixed-size='99' forceUpdate='true' h='8230' id='3' is-fixed='true' type-v2='text' w='98934' x='533' y='615'>
              <formatted-text>
                <run fontcolor='#fc0107' fontname='Tableau Bold' fontsize='15'>Introduction</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#333333' fontsize='10'>This dashboard serves as a tool for C-Suite to view the top metrics in a single repository, rather than navigate through multiple dashboards or gsheets. The list of ~100 metrics have been carefully selected and aligned across teams on the definitions and logic. Moving forward, this would be the starting point for key metrics in APAC, and other dashboards / reporting are expected to follow the definitions and logic here.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='dotted' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='4' />
                <format attr='padding' value='4' />
              </zone-style>
            </zone>
            <zone fixed-size='158' forceUpdate='true' h='12769' id='6' is-fixed='true' type-v2='text' w='98934' x='533' y='8845'>
              <formatted-text>
                <run fontcolor='#fc0107' fontname='Tableau Bold' fontsize='15'>How to use the dashboard</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='10'>Metric Definitions:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#333333' fontsize='10'>This tab provies an overview of the metrics available on the different granularities and countries.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#333333' fontsize='10'>Metric View:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#333333' fontsize='10'>This tab provides a deep-dive of the metrics, where users are able to view the trend over time and see the numbers in tabular form, with more filters such as pro/non-pro and YoY/MoM comparisons.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='dotted' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='4' />
                <format attr='padding' value='4' />
              </zone-style>
            </zone>
            <zone fixed-size='90' forceUpdate='true' h='7538' id='10' is-fixed='true' type-v2='text' w='98934' x='533' y='21614'>
              <formatted-text>
                <run fontcolor='#fc0107' fontname='Tableau Bold' fontsize='15'>POCs</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#333333' fontsize='10'>Please reach out in our slack channel #apac-cxo-data-support if there are issues.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='dotted' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='4' />
                <format attr='padding' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
