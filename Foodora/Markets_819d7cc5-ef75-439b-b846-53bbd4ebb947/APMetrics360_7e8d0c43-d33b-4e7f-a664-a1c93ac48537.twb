            <column caption='source' datatype='string' name='[date granularity (high level) (copy)_1371205383752896519]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([date_granularity], &quot;Lucanet&quot;) THEN &quot;Lucanet&quot;&#10;ELSEIF CONTAINS([date_granularity], &quot;Pandata&quot;) THEN &quot;Pandata&quot;&#10;ELSEIF CONTAINS([date_granularity], &quot;Manual&quot;) THEN &quot;Manual&quot;&#10;ELSE [date_granularity]&#10;END' />
