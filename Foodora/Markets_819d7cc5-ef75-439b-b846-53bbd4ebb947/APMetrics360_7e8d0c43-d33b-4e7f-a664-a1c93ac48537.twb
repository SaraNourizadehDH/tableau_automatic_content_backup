    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Metric View'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/Metrics360/MetricView?rev=' id='MetricView' path='/t/Foodora/workbooks/Metrics360' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_448' value='top' />
        </style-rule>
      </style>
      <size maxheight='1300' maxwidth='1500' minheight='1300' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='All Metrics Connector' name='federated.11ro4we0d9hao010fimv40fqfyjz' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='DoD (only available for Date Granularity = Daily)' caption='delta comparison' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;DoD&quot;'>
          <calculation class='tableau' formula='&quot;DoD&quot;' />
          <aliases>
            <alias key='&quot;DoD&quot;' value='DoD (only available for Date Granularity = Daily)' />
            <alias key='&quot;MoM&quot;' value='MoM (only available for Date Granularity = Monthly)' />
            <alias key='&quot;WoW&quot;' value='WoW (only available for Date Granularity = Weekly)' />
            <alias key='&quot;YoY&quot;' value='YoY (only available for Date Granularity = Monthly)' />
          </aliases>
          <members>
            <member alias='YoY (only available for Date Granularity = Monthly)' value='&quot;YoY&quot;' />
            <member alias='MoM (only available for Date Granularity = Monthly)' value='&quot;MoM&quot;' />
            <member alias='WoW (only available for Date Granularity = Weekly)' value='&quot;WoW&quot;' />
            <member alias='DoD (only available for Date Granularity = Daily)' value='&quot;DoD&quot;' />
          </members>
        </column>
        <column alias='Yes' caption='show 2 years ago data' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
          <calculation class='tableau' formula='true' />
          <aliases>
            <alias key='false' value='No' />
            <alias key='true' value='Yes' />
          </aliases>
          <members>
            <member alias='Yes' value='true' />
            <member alias='No' value='false' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.11ro4we0d9hao010fimv40fqfyjz'>
        <column caption='metric with unique ranking' datatype='string' name='[Calculation_1157073285327806474]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='STR([distinct_metric_ranking]) + &apos;. &apos; + [metric_name]' />
        </column>
        <column caption='month/week/day with format' datatype='string' datatype-customized='true' name='[Calculation_1157073285659787280]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF CONTAINS([date_granularity], &quot;Monthly&quot;) THEN&#10;DATENAME(&quot;month&quot;,[report_date_local])&#10;//LEFT(DATENAME(&quot;month&quot;,[report_date_local]),3) + &quot; &quot; + STR(YEAR([report_date_local]))&#10;&#10;ELSEIF CONTAINS([date_granularity], &quot;Weekly&quot;) THEN&#10;//STR(YEAR([report_date_local])) +&#10;&quot;W&quot; + STR(ISOWEEK([report_date_local])) +&#10;&quot; (&quot; + STR(DAY([report_date_local])) + &quot; &quot; + LEFT(DATENAME(&quot;month&quot;,[report_date_local]),3) + &quot;)&quot;&#10;&#10;ELSE STR([report_date_local])&#10;END' />
        </column>
        <column caption='date granularity (high level)' datatype='string' name='[Calculation_1371205383752462342]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF CONTAINS([date_granularity], &quot;Monthly&quot;) THEN &quot;Monthly&quot;&#10;ELSEIF CONTAINS([date_granularity], &quot;Weekly&quot;) THEN &quot;Weekly&quot;&#10;ELSEIF CONTAINS([date_granularity], &quot;Daily&quot;) THEN &quot;Daily&quot;&#10;ELSE [date_granularity]&#10;END' />
        </column>
        <column caption='is_subscriber_order aliases' datatype='string' name='[Calculation_463307842058133505]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [is_subscriber_order]&#10;WHEN &quot;ALL&quot; THEN &quot;All users&quot;&#10;WHEN &quot;TRUE&quot; THEN &quot;Pro users&quot;&#10;WHEN &quot;FALSE&quot; THEN &quot;Non-pro users&quot;&#10;ELSE [is_subscriber_order]&#10;END' />
        </column>
        <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_1157073285327806474]' derivation='None' name='[none:Calculation_1157073285327806474:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_1157073285659787280]' derivation='None' name='[none:Calculation_1157073285659787280:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_1371205383752462342]' derivation='None' name='[none:Calculation_1371205383752462342:nk]' pivot='key' type='nominal' />
