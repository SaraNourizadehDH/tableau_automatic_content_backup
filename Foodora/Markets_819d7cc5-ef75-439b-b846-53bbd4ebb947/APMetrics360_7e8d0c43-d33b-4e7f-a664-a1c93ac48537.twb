    <worksheet name='Table Values'>
      <table>
        <view>
          <datasources>
            <datasource caption='All Metrics Connector' name='federated.11ro4we0d9hao010fimv40fqfyjz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='DoD (only available for Date Granularity = Daily)' caption='delta comparison' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;DoD&quot;'>
              <calculation class='tableau' formula='&quot;DoD&quot;' />
              <aliases>
                <alias key='&quot;DoD&quot;' value='DoD (only available for Date Granularity = Daily)' />
                <alias key='&quot;MoM&quot;' value='MoM (only available for Date Granularity = Monthly)' />
                <alias key='&quot;WoW&quot;' value='WoW (only available for Date Granularity = Weekly)' />
                <alias key='&quot;YoY&quot;' value='YoY (only available for Date Granularity = Monthly)' />
              </aliases>
            </column>
            <column alias='Yes' caption='show 2 years ago data' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='No' />
                <alias key='true' value='Yes' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11ro4we0d9hao010fimv40fqfyjz'>
            <column caption='is current month/week' datatype='boolean' name='[Calculation_1157073285256343554]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([date_granularity], &quot;Monthly&quot;) THEN&#10;DATEDIFF(&apos;month&apos;, [report_date_local], TODAY()) = 0&#10;AND DATEDIFF(&apos;year&apos;, [report_date_local], TODAY()) = 0&#10;&#10;ELSEIF CONTAINS([date_granularity], &quot;Weekly&quot;) THEN&#10;DATEDIFF(&apos;week&apos;, [report_date_local], TODAY()) = 0&#10;&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='previous column delta' datatype='real' name='[Calculation_1157073285261066244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([Pivot Field Values])) - LOOKUP(ZN(SUM([Pivot Field Values])), -1)) / ABS(LOOKUP(ZN(SUM([Pivot Field Values])), -1))'>
                <table-calc level-address='[federated.11ro4we0d9hao010fimv40fqfyjz].[Calculation_1157073285659787280]' ordering-type='Field'>
                  <order field='[federated.11ro4we0d9hao010fimv40fqfyjz].[Calculation_3640597383816437760]' />
                  <order field='[federated.11ro4we0d9hao010fimv40fqfyjz].[Calculation_1157073285659787280]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='delta with indicator' datatype='string' name='[Calculation_1157073285261283333]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3640597383824601092] &gt; 0 THEN ATTR([Calculation_3640597383832113157]) + &apos;: ▲ &apos; + STR(ROUND([Calculation_3640597383824601092]*100,1)) + &apos;%&apos;&#10;ELSEIF [Calculation_3640597383824601092] &lt; 0 THEN ATTR([Calculation_3640597383832113157]) + &apos;: ▼ &apos; + STR(ROUND([Calculation_3640597383824601092]*100,1)) + &apos;%&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='metric with unique ranking' datatype='string' name='[Calculation_1157073285327806474]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([distinct_metric_ranking]) + &apos;. &apos; + [metric_name]' />
            </column>
            <column caption='display date granularity' datatype='string' name='[Calculation_1157073285334945804]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Calculation_1371205383752462342]&#10;WHEN &quot;Monthly&quot; THEN [time_monthly]&#10;WHEN &quot;Weekly&quot; THEN [time_weekly]&#10;WHEN &quot;Daily&quot; THEN [time_daily]&#10;END' />
