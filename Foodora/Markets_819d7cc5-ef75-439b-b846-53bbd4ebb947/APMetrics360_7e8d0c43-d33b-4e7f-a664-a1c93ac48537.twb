          <datasource-dependencies datasource='federated.11ro4we0d9hao010fimv40fqfyjz'>
            <column caption='is current month/week' datatype='boolean' name='[Calculation_1157073285256343554]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([date_granularity], &quot;Monthly&quot;) THEN&#10;DATEDIFF(&apos;month&apos;, [report_date_local], TODAY()) = 0&#10;AND DATEDIFF(&apos;year&apos;, [report_date_local], TODAY()) = 0&#10;&#10;ELSEIF CONTAINS([date_granularity], &quot;Weekly&quot;) THEN&#10;DATEDIFF(&apos;week&apos;, [report_date_local], TODAY()) = 0&#10;&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='metric with unique ranking' datatype='string' name='[Calculation_1157073285327806474]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([distinct_metric_ranking]) + &apos;. &apos; + [metric_name]' />
            </column>
            <column caption='display date granularity' datatype='string' name='[Calculation_1157073285334945804]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Calculation_1371205383752462342]&#10;WHEN &quot;Monthly&quot; THEN [time_monthly]&#10;WHEN &quot;Weekly&quot; THEN [time_weekly]&#10;WHEN &quot;Daily&quot; THEN [time_daily]&#10;END' />
            </column>
            <column caption='month/week/day with format' datatype='string' datatype-customized='true' name='[Calculation_1157073285659787280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([date_granularity], &quot;Monthly&quot;) THEN&#10;DATENAME(&quot;month&quot;,[report_date_local])&#10;//LEFT(DATENAME(&quot;month&quot;,[report_date_local]),3) + &quot; &quot; + STR(YEAR([report_date_local]))&#10;&#10;ELSEIF CONTAINS([date_granularity], &quot;Weekly&quot;) THEN&#10;//STR(YEAR([report_date_local])) +&#10;&quot;W&quot; + STR(ISOWEEK([report_date_local])) +&#10;&quot; (&quot; + STR(DAY([report_date_local])) + &quot; &quot; + LEFT(DATENAME(&quot;month&quot;,[report_date_local]),3) + &quot;)&quot;&#10;&#10;ELSE STR([report_date_local])&#10;END' />
            </column>
            <column caption='Pivot Field Values with format' datatype='real' name='[Calculation_1157073288112635926]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [unit]&#10;WHEN &quot;€&apos;000&quot; THEN ROUND([Pivot Field Values]/1000,0)&#10;WHEN &quot;€&quot; THEN ROUND([Pivot Field Values],2)&#10;WHEN &quot;#&quot; THEN ROUND([Pivot Field Values],1)&#10;WHEN &quot;%&quot; THEN ROUND([Pivot Field Values]*100,2)&#10;WHEN &quot;min&quot; THEN ROUND([Pivot Field Values],1)&#10;WHEN &quot;ppt&quot; THEN ROUND([Pivot Field Values],1)&#10;ELSE [Pivot Field Values]&#10;END' />
            </column>
            <column caption='date granularity (high level)' datatype='string' name='[Calculation_1371205383752462342]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([date_granularity], &quot;Monthly&quot;) THEN &quot;Monthly&quot;&#10;ELSEIF CONTAINS([date_granularity], &quot;Weekly&quot;) THEN &quot;Weekly&quot;&#10;ELSEIF CONTAINS([date_granularity], &quot;Daily&quot;) THEN &quot;Daily&quot;&#10;ELSE [date_granularity]&#10;END' />
            </column>
            <column caption='source priority' datatype='string' name='[Calculation_1594203942319120387]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [Calculation_1371205383752462342], [department], [Calculation_1157073285327806474], [vertical], [Calculation_463307842058133505], [region_name]:&#10;IF MIN([date granularity (high level) (copy)_1371205383752896519]) = &quot;Lucanet&quot; THEN &quot;Lucanet&quot;&#10;ELSEIF MIN([date granularity (high level) (copy)_1371205383752896519]) = &quot;Pandata&quot; THEN &quot;Pandata&quot;&#10;ELSE &quot;Manual&quot;&#10;END&#10;}' />
