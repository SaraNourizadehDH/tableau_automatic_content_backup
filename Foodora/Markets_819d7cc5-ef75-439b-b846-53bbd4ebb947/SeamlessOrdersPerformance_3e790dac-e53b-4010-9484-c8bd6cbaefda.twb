              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_MTD] THEN [orders_early_10mins_mtd (copy)_296252474774536198] END)&#10;- AVG(IF [is_2MTD] THEN [orders_early_10mins_mtd (copy)_296252474774536198] END))&#10;/ &#10;AVG(IF [is_2MTD] THEN [orders_early_10mins_mtd (copy)_296252474774536198] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND((AVG(IF [is_MTD] THEN [orders_early_10mins_mtd (copy)_296252474774536198] END)&#10;- AVG(IF [is_2MTD] THEN [orders_early_10mins_mtd (copy)_296252474774536198] END))&#10;/ &#10;AVG(IF [is_2MTD] THEN [orders_early_10mins_mtd (copy)_296252474774536198] END) * 100, 1)&#10;)' />
