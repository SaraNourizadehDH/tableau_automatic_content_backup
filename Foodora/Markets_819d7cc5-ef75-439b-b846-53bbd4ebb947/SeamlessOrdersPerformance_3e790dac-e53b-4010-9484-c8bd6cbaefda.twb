              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_last_week] THEN [average_delivery_time_weekly (copy)_1802002868801630233] END)&#10;- AVG(IF [is_2last_week] THEN [average_delivery_time_weekly (copy)_1802002868801630233] END))&#10;/ &#10;AVG(IF [is_2last_week] THEN [average_delivery_time_weekly (copy)_1802002868801630233] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
