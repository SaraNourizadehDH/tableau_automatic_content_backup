          <datasource-dependencies datasource='federated.0d6yz8z0tpe1t11a1czxh175rj6l'>
            <column caption='Title - MTD  % Δ' datatype='string' name='[Calculation_1943021772700332045]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='mtd_year_month' datatype='string' name='[Calculation_84512874281316363]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_MTD] or [is_2MTD] THEN [report_month] END' />
            </column>
            <column caption='MTD restaurant_seamless_orders_percentage change' datatype='string' default-format='p0.0%' name='[MTD mp_seamless_orders_percentage change (copy)_4482066819991445515]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_MTD] THEN [dmart_seamless_orders_percentage_mtd (copy)_4482066819991719949] END)&#10;- AVG(IF [is_2MTD] THEN [dmart_seamless_orders_percentage_mtd (copy)_4482066819991719949] END))&#10;/ &#10;AVG(IF [is_2MTD] THEN [dmart_seamless_orders_percentage_mtd (copy)_4482066819991719949] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND((AVG(IF [is_MTD] THEN [dmart_seamless_orders_percentage_mtd (copy)_4482066819991719949] END)&#10;- AVG(IF [is_2MTD] THEN [dmart_seamless_orders_percentage_mtd (copy)_4482066819991719949] END))&#10;/ &#10;AVG(IF [is_2MTD] THEN [dmart_seamless_orders_percentage_mtd (copy)_4482066819991719949] END) * 100, 1)&#10;)' />
            </column>
            <column caption='MTD restaurant_seamless_orders_percentage change (indicator)' datatype='string' default-format='p0.0%' name='[MTD seamless_orders_percentage change (indicator) (copy)_4482066819992023055]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_MTD] THEN [dmart_seamless_orders_percentage_mtd (copy)_4482066819991719949] END)&#10;- AVG(IF [is_2MTD] THEN [dmart_seamless_orders_percentage_mtd (copy)_4482066819991719949] END))&#10;/ &#10;AVG(IF [is_2MTD] THEN [dmart_seamless_orders_percentage_mtd (copy)_4482066819991719949] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='restaurant_seamless_orders_percentage_mtd' datatype='real' name='[dmart_seamless_orders_percentage_mtd (copy)_4482066819991719949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//order_issues = orders with ticket_issues/shrink/closure/delivery time over 30mins&#10;&#10;(&#10;  {fixed [country_name],[Calculation_84512874281316363]:&#10;  //SUM([pandora_od_orders_with_issues])&#10;  SUM([restaurant_seamless_orders])&#10;  }&#10;  /&#10;  {fixed [country_name],[Calculation_84512874281316363]:&#10;  //SUM([pandora_od_gross_orders])&#10;  SUM([restaurant_seamless_table_orders])&#10;  }&#10;)' />
