  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glossary'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/SeamlessOrdersPerformance_17092979743450/Glossary?rev=' id='Glossary' path='/t/Foodora/workbooks/SeamlessOrdersPerformance_17092979743450' revision='' site='Foodora' />
      <style />
      <size maxheight='800' maxwidth='1400' minheight='800' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='87875' id='3' type-v2='text' w='98858' x='571' y='11125'>
            <formatted-text>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'># </run>
              <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11' underline='true'>Seamless Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>- Seamless Orders %: </run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>(i) Delivered on time (within +/- 10mins of promised delivery time)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>(ii) No customer contacts</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>(iii) Fulfilled in full (no partial delivery / cancellations)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>- Late Orders %: </run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>Orders that are &gt;10mins late from promised delivery time</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>- Early Orders %: </run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>Orders that are &gt;10mins early from promised delivery </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>- Fail Rate: </run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>Cancellation Rate</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>- Customer Contact Rate: </run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>Orders with customer contact excl. &apos;</run>
              <run fontcolor='#333333' fontname='Roboto,RobotoDraft,Helvetica,Arial,sans-serif' fontsize='11'>Automations - Missed Contact&apos;, &apos;Automations - Backend Ticket&apos;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>- Partially Fulfilled Orders: </run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>Orders with basket updated</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>- Fail Rate: </run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>Cancellation Rate</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>Note: </run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10' italic='true'>Seamless Orders does not take into account odr orders (due to different customer flow), only Pandora OD Gross orders are considered. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10' italic='true'>We consider all Orders with Dropoff Distinace &gt; 3km as long distance orders</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'># </run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11' underline='true'>Dispatching Performance</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>- Manually Touched %: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'># orders that need manual support / Total Gross Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>- Acceptance Rate: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'># order notification accepted by riders / Total order notifications</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>- Redispatch after acceptance %: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'># orders redispatched after rider accepted / Total orders notification</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>- Net Acceptance Rate: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>Acceptance Rate - Redispatch after acceptance %</run>
              <run>Æ&#10;</run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>- </run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>Accepting Time: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>First dispatched time - last rider accepted time</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>- First notified to first accepted: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>First order accepted time - First order notified time</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># </run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12' underline='true'>PU-DO performance</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- PU distance: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Manhattan Distance from rider accepted location to pickup location, or from pickup location 1 to pickup location 2 if stacked (in km). Cleaned to remove outliers (Excludes distance &gt;= 98th percentile)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- DO distance: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Manhattan Distance from pickup location to dropoff location, or from dropoff location 1 to dropoff location 2 if stacked (in km). Cleaned to remove outliers (Excludes distance &gt;= 98th percentile)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Time to Vendor: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># minutes taken for rider to go from current location to PU</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Time to Customer: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># minutes taken for rider to go from PU to DO</run>
              <run>Æ&#10;</run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- </run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>P-D distance:</run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'> Delivery distance from pickup location to dropoff location, even for stacked orders (in km). Cleaned to remove outliers (Excludes distance &gt;= 98th percentile)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># </run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12' underline='true'>Staffing performance</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Fill Rate: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>% of open shift hours booked by riders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Adjusted Forecast Error: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Actual Orders / Adjusted Forecast Orders - 1. (If positive= underforecast, negative = overforecast)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Idle Time %: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>The % of time riders have been working without touching any order.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Actual vs Planned Hours:</run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'> Actual Working Hours / Total Taken Shift Duration</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- No Show: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>% of No Show shifts hours (including No Show Excused)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Breaks %: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Time spent by the rider on break as a percentage of the total shift duration</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Late Login %: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Late Login Hours / (Planned Hours - No Show Hours)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># </run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12' underline='true'>Rider Growth</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Æ </run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12' italic='true'>(Only weekly level)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Active Riders l4w: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># Riders worked at least 1 time in the last 28 days</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Active Riders: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># Riders worked at least 1 time in the reporting week</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- New Riders: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># New riders completed 1st shift in the week</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Reactivated Riders: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># riders who completed a shift in the week after they have previously churned (inactive for at least 28 days)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Reactivation Rate: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># Reactivated Riders/ (Total Active Riders l4w + Reactivated Riders)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Total Working Hours: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Total evaluated working shift duration (in hours)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Average Hours: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Total Working Hours / Total Active Riders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Churned Rider: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Rider who did not book any shifts in the last 4 weeks</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Æ </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Churn Rate: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># Churned Riders / (Total Active Riders l4w + Churned Riders)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Rider Applicants: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># new Applicants we have for rider hiring this week</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Rider Application CR (conversion rate): </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># Hired riders/ Rider Applicants</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># </run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12' underline='true'>Rider Support/ Compliance</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Dispatcher Incident Rate: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Rider Service Incidents (Inbound &amp; Outbound) / Total Gross Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- % Diff At customer time (Last vs Non-Last Order): </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Delta of &apos;at customer time&apos; between each rider&apos;s last order vs the rest of their orders each day</run>
              <run>Æ&#10;</run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- </run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Rider Late %: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Time difference between rider arrival at vendor and the original scheduled pickup time</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># </run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12' underline='true'>Vendor Performance</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Vendor Late &gt; 10 mins: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># orders having vendor late over 10 mins / Total Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Waiting At Vendor (Cleaned): </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Average of time the rider stays at the vendor but computed from the time food should have been picked up (</run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12' italic='true'>expected time food should have been ready</run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>). </run>
              <run>Æ&#10;</run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Not computed if rider is late &gt; 10 mins to allow possible re cooking of food.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Vendor Reaction Time: </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Time from vendor order notification to vendor order acceptance</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Vendor Total Close Hours % : </run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># Vendor Close Offline Hours / # Vendor Open Hours</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='10125' id='5' type-v2='text' w='98858' x='571' y='1000'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='14'>Definitions</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#df1067' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='53' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='52' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone h='10125' id='5' type-v2='text' w='98858' x='571' y='1000'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='14'>Definitions</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#df1067' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='87875' id='3' type-v2='text' w='98858' x='571' y='11125'>
                  <formatted-text>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'># </run>
                    <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11' underline='true'>Seamless Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>- Seamless Orders %: </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>(i) Delivered on time (within +/- 10mins of promised delivery time)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>(ii) No customer contacts</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>(iii) Fulfilled in full (no partial delivery / cancellations)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>- Late Orders %: </run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>Orders that are &gt;10mins late from promised delivery time</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>- Early Orders %: </run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>Orders that are &gt;10mins early from promised delivery </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>- Fail Rate: </run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>Cancellation Rate</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>- Customer Contact Rate: </run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>Orders with customer contact excl. &apos;</run>
                    <run fontcolor='#333333' fontname='Roboto,RobotoDraft,Helvetica,Arial,sans-serif' fontsize='11'>Automations - Missed Contact&apos;, &apos;Automations - Backend Ticket&apos;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>- Partially Fulfilled Orders: </run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>Orders with basket updated</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>- Fail Rate: </run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='11'>Cancellation Rate</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10'>Note: </run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10' italic='true'>Seamless Orders does not take into account odr orders (due to different customer flow), only Pandora OD Gross orders are considered. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontname='Helvetica Neue' fontsize='10' italic='true'>We consider all Orders with Dropoff Distinace &gt; 3km as long distance orders</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'># </run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11' underline='true'>Dispatching Performance</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>- Manually Touched %: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'># orders that need manual support / Total Gross Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>- Acceptance Rate: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'># order notification accepted by riders / Total order notifications</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>- Redispatch after acceptance %: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'># orders redispatched after rider accepted / Total orders notification</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>- Net Acceptance Rate: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>Acceptance Rate - Redispatch after acceptance %</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>- </run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>Accepting Time: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>First dispatched time - last rider accepted time</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>- First notified to first accepted: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='11'>First order accepted time - First order notified time</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># </run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12' underline='true'>PU-DO performance</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- PU distance: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Manhattan Distance from rider accepted location to pickup location, or from pickup location 1 to pickup location 2 if stacked (in km). Cleaned to remove outliers (Excludes distance &gt;= 98th percentile)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- DO distance: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Manhattan Distance from pickup location to dropoff location, or from dropoff location 1 to dropoff location 2 if stacked (in km). Cleaned to remove outliers (Excludes distance &gt;= 98th percentile)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Time to Vendor: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># minutes taken for rider to go from current location to PU</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Time to Customer: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># minutes taken for rider to go from PU to DO</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- </run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>P-D distance:</run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'> Delivery distance from pickup location to dropoff location, even for stacked orders (in km). Cleaned to remove outliers (Excludes distance &gt;= 98th percentile)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># </run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12' underline='true'>Staffing performance</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Fill Rate: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>% of open shift hours booked by riders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Adjusted Forecast Error: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Actual Orders / Adjusted Forecast Orders - 1. (If positive= underforecast, negative = overforecast)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Idle Time %: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>The % of time riders have been working without touching any order.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Actual vs Planned Hours:</run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'> Actual Working Hours / Total Taken Shift Duration</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- No Show: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>% of No Show shifts hours (including No Show Excused)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Breaks %: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Time spent by the rider on break as a percentage of the total shift duration</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Late Login %: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Late Login Hours / (Planned Hours - No Show Hours)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># </run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12' underline='true'>Rider Growth</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Æ </run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12' italic='true'>(Only weekly level)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Active Riders l4w: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># Riders worked at least 1 time in the last 28 days</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Active Riders: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># Riders worked at least 1 time in the reporting week</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- New Riders: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># New riders completed 1st shift in the week</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Reactivated Riders: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># riders who completed a shift in the week after they have previously churned (inactive for at least 28 days)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Reactivation Rate: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># Reactivated Riders/ (Total Active Riders l4w + Reactivated Riders)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Total Working Hours: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Total evaluated working shift duration (in hours)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Average Hours: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Total Working Hours / Total Active Riders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Churned Rider: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Rider who did not book any shifts in the last 4 weeks</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Æ </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Churn Rate: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># Churned Riders / (Total Active Riders l4w + Churned Riders)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Rider Applicants: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># new Applicants we have for rider hiring this week</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Rider Application CR (conversion rate): </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># Hired riders/ Rider Applicants</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># </run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12' underline='true'>Rider Support/ Compliance</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Dispatcher Incident Rate: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Rider Service Incidents (Inbound &amp; Outbound) / Total Gross Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- % Diff At customer time (Last vs Non-Last Order): </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Delta of &apos;at customer time&apos; between each rider&apos;s last order vs the rest of their orders each day</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- </run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Rider Late %: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Time difference between rider arrival at vendor and the original scheduled pickup time</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># </run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12' underline='true'>Vendor Performance</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Vendor Late &gt; 10 mins: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># orders having vendor late over 10 mins / Total Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Waiting At Vendor (Cleaned): </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Average of time the rider stays at the vendor but computed from the time food should have been picked up (</run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12' italic='true'>expected time food should have been ready</run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>). </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Not computed if rider is late &gt; 10 mins to allow possible re cooking of food.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Vendor Reaction Time: </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>Time from vendor order notification to vendor order acceptance</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'>- Vendor Total Close Hours % : </run>
                    <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='12'># Vendor Close Offline Hours / # Vendor Open Hours</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{7C8CF592-6A8F-4866-B0C3-4B8DE27FD249}' />
    </dashboard>
