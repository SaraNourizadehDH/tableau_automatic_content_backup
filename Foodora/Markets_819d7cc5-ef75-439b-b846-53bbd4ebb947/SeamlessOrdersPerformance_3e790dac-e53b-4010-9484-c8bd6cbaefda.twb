          <datasource-dependencies datasource='federated.0d6yz8z0tpe1t11a1czxh175rj6l'>
            <column caption='ytd_main_year' datatype='integer' name='[Calculation_84512874283065357]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_YTD] or [is_2YTD] THEN YEAR([report_date]) END' />
            </column>
            <column caption='Title - YTD  % Δ' datatype='string' name='[Title - MTD  % Δ (copy)_1943021772703002640]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;YTD % Δ&apos;' />
            </column>
            <column caption='YTD sdd_dt_over_30mins_change' datatype='string' default-format='p0.0%' name='[YTD average_delivery_time_change (copy)_1802002868802351134]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_YTD] THEN [average_delivery_time_ytd (copy)_1802002868801712154] END)&#10;- AVG(IF [is_2YTD] THEN [average_delivery_time_ytd (copy)_1802002868801712154] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [average_delivery_time_ytd (copy)_1802002868801712154] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND((AVG(IF [is_YTD] THEN [average_delivery_time_ytd (copy)_1802002868801712154] END)&#10;- AVG(IF [is_2YTD] THEN [average_delivery_time_ytd (copy)_1802002868801712154] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [average_delivery_time_ytd (copy)_1802002868801712154] END) * 100, 1)&#10;)' />
            </column>
            <column caption='YTD sdd_dt_over_30mins_change (indicator)' datatype='string' default-format='p0.0%' name='[YTD non_ldd_delivery_time_change (copy)_1802002868814532645]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_YTD] THEN [average_delivery_time_ytd (copy)_1802002868801712154] END)&#10;- AVG(IF [is_2YTD] THEN [average_delivery_time_ytd (copy)_1802002868801712154] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [average_delivery_time_ytd (copy)_1802002868801712154] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='YTD sdd_dt_over_30mins_current' datatype='real' default-format='p0.0%' name='[YTD non_ldd_delivery_time_change (indicator) (copy)_1802002868814610470]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND((AVG(IF [is_YTD] THEN [average_delivery_time_ytd (copy)_1802002868801712154] END)), 4)' />
            </column>
            <column caption='YTD sdd_dt_over_30mins_previous' datatype='real' default-format='p0.0%' name='[YTD non_ldd_delivery_time_current (copy)_1802002868814766119]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND((AVG(IF [is_2YTD] THEN [average_delivery_time_ytd (copy)_1802002868801712154] END)), 4)' />
