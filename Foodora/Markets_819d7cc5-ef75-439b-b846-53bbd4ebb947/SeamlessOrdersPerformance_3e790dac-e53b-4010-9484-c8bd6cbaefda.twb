              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_YTD] THEN [cancelled_mp_seamless_orders_percentage_ytd (copy)_4641170557308272658] END)&#10;- AVG(IF [is_2YTD] THEN [cancelled_mp_seamless_orders_percentage_ytd (copy)_4641170557308272658] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [cancelled_mp_seamless_orders_percentage_ytd (copy)_4641170557308272658] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND((AVG(IF [is_YTD] THEN [cancelled_mp_seamless_orders_percentage_ytd (copy)_4641170557308272658] END)&#10;- AVG(IF [is_2YTD] THEN [cancelled_mp_seamless_orders_percentage_ytd (copy)_4641170557308272658] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [cancelled_mp_seamless_orders_percentage_ytd (copy)_4641170557308272658] END) * 100, 1)&#10;)' />
            </column>
            <column caption='YTD hc_session_mp_seamless_orders_percentage change (indicator)' datatype='string' default-format='p0.0%' name='[YTD cancelled_mp_seamless_orders_percentage change (indicator) (copy)_4641170557313708081]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_YTD] THEN [cancelled_mp_seamless_orders_percentage_ytd (copy)_4641170557308272658] END)&#10;- AVG(IF [is_2YTD] THEN [cancelled_mp_seamless_orders_percentage_ytd (copy)_4641170557308272658] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [cancelled_mp_seamless_orders_percentage_ytd (copy)_4641170557308272658] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='hc_session_mp_seamless_orders_percentage_ytd' datatype='real' name='[cancelled_mp_seamless_orders_percentage_ytd (copy)_4641170557308272658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//order_issues = orders with ticket_issues/shrink/closure/delivery time over 30mins&#10;&#10;(&#10;  {fixed [country_name],[Calculation_84512874283065357]:&#10;  //SUM([pandora_od_orders_with_issues])&#10;  SUM([hc_session_mp_orders])&#10;  }&#10;  /&#10;  {fixed [country_name],[Calculation_84512874283065357]:&#10;  //SUM([pandora_od_gross_orders])&#10;  SUM([mp_all_orders])&#10;  }&#10;)' />
