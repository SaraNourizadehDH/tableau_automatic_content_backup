              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_YTD] THEN [seamless_orders_percentage_ytd (copy)_5555682749557760002] END)&#10;- AVG(IF [is_2YTD] THEN [seamless_orders_percentage_ytd (copy)_5555682749557760002] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [seamless_orders_percentage_ytd (copy)_5555682749557760002] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND((AVG(IF [is_YTD] THEN [seamless_orders_percentage_ytd (copy)_5555682749557760002] END)&#10;- AVG(IF [is_2YTD] THEN [seamless_orders_percentage_ytd (copy)_5555682749557760002] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [seamless_orders_percentage_ytd (copy)_5555682749557760002] END) * 100, 1)&#10;)' />
