              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_last_week] THEN [delivery_time_percent_over_45_mins_daily (copy)_3605061141737930758] END)&#10;- AVG(IF [is_2last_week] THEN [delivery_time_percent_over_45_mins_daily (copy)_3605061141737930758] END))&#10;/ &#10;AVG(IF [is_2last_week] THEN [delivery_time_percent_over_45_mins_daily (copy)_3605061141737930758] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
