      <aliases enabled='yes' />
      <column datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE([Calculation_5486580623761874980])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='current_year_week' datatype='string' name='[Calculation_1943021772555628545]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(ISOYEAR(now())) &#10;+ &#10;&apos;-&apos; &#10;+ &#10;(IF ISOWEEK(now()) &lt; 10 THEN STR(0) + STR(ISOWEEK(now()))&#10;ELSE STR(ISOWEEK(now()))&#10;END)' />
      </column>
      <column caption='Title - MTD  % Δ' datatype='string' name='[Calculation_1943021772700332045]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
      </column>
      <column caption='ytd_new_seamless_orders' datatype='integer' name='[Calculation_2806516657977057281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [country_name],[Calculation_84512874283065357]: SUM([new_seamless_orders])  }' />
      </column>
      <column caption='  Date Filter' datatype='date' name='[Calculation_3323656550981718035]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='[report_date]' />
      </column>
      <column caption='ldd_delivery_time_percent_over_45_mins' datatype='real' name='[Calculation_3605061141718515716]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pandora_ldd_od_orders_above_45_mins])/SUM([pandora_od_gross_orders])' />
      </column>
      <column caption='help_session_rate' datatype='real' name='[Calculation_4504162639018774528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[helpcenter_session_orders]/[all_seamles_orders]' />
      </column>
      <column caption='partial_orders_rate' datatype='real' name='[Calculation_4504162639050481687]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[partial_orders]/[all_seamles_orders]' />
      </column>
      <column caption='weighted_closure_time' datatype='real' name='[Calculation_5346265366542053376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([events_orders_affected_by_close])/SUM([events_orders_forecast])' />
      </column>
      <column caption='weighted_shrinking_time' datatype='real' name='[Calculation_5346265366545469441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([events_orders_affected_by_shrink])/SUM([events_orders_forecast])' />
      </column>
      <column caption='YTD shrink_time_percent_change' datatype='string' name='[Calculation_5346265366547517443]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_YTD] THEN [Calculation_5346265366547845124] END)&#10;- AVG(IF [is_2YTD] THEN [Calculation_5346265366547845124] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [Calculation_5346265366547845124] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND((AVG(IF [is_YTD] THEN [Calculation_5346265366547845124] END)&#10;- AVG(IF [is_2YTD] THEN [Calculation_5346265366547845124] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [Calculation_5346265366547845124] END) * 100, 1)&#10;)' />
      </column>
