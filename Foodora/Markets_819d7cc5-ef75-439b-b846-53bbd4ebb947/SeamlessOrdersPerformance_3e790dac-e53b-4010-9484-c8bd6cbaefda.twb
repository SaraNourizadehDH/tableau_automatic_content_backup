              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_last_week] THEN [orders_early_10mins_weekly (copy)_296252474774548487] END)&#10;- AVG(IF [is_2last_week] THEN [orders_early_10mins_weekly (copy)_296252474774548487] END))&#10;/ &#10;AVG(IF [is_2last_week] THEN [orders_early_10mins_weekly (copy)_296252474774548487] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
