        <calculation class='tableau' formula='//excludes pending &amp; in-progress orders&#10;//(SUM([pd_vendor_fail])+SUM([pd_customer_fail])+SUM([pd_rider_fail]))/SUM([pd_gross_orders])&#10;SUM([pd_total_fail])&#10;/&#10;SUM([pd_gross_orders])' />
      </column>
      <column caption='Title - LW  % Δ' datatype='string' name='[Calculation_654992317754626050]' role='dimension' type='nominal'>
