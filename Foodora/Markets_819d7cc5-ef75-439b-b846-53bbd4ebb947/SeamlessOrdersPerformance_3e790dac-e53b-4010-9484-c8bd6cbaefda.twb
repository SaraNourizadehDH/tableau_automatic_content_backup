      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff'>Æ </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main_seamless_kpis (shared_eu)' name='federated.0d6yz8z0tpe1t11a1czxh175rj6l' />
          </datasources>
          <datasource-dependencies datasource='federated.0d6yz8z0tpe1t11a1czxh175rj6l'>
            <column caption='Title - MTD  % Δ' datatype='string' name='[Calculation_1943021772700332045]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='mtd_year_month' datatype='string' name='[Calculation_84512874281316363]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_MTD] or [is_2MTD] THEN [report_month] END' />
            </column>
            <column caption='MTD ldd_delivery_time_percent_over_45_mins_change (indicator)' datatype='string' default-format='p0.0%' name='[MTD delivery_time_percent_over_45_mins_change (copy)_3605061141767381004]' role='measure' type='nominal'>
