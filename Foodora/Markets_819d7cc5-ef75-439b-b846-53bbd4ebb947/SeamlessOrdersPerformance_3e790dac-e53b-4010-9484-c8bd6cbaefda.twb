      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main_seamless_kpis (shared_eu)' name='federated.0d6yz8z0tpe1t11a1czxh175rj6l' />
          </datasources>
          <datasource-dependencies datasource='federated.0d6yz8z0tpe1t11a1czxh175rj6l'>
            <column caption='ytd_main_year' datatype='integer' name='[Calculation_84512874283065357]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_YTD] or [is_2YTD] THEN YEAR([report_date]) END' />
            </column>
            <column caption='YTD seamless_orders_percentage change' datatype='string' default-format='p0.0%' name='[MTD seamless_orders_percentage change (copy)_5486580623777099822]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_YTD] THEN [seamless_orders_percentage_weekly (copy)_84512874297737255] END)&#10;- AVG(IF [is_2YTD] THEN [seamless_orders_percentage_weekly (copy)_84512874297737255] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [seamless_orders_percentage_weekly (copy)_84512874297737255] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND((AVG(IF [is_YTD] THEN [seamless_orders_percentage_weekly (copy)_84512874297737255] END)&#10;- AVG(IF [is_2YTD] THEN [seamless_orders_percentage_weekly (copy)_84512874297737255] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [seamless_orders_percentage_weekly (copy)_84512874297737255] END) * 100, 1)&#10;)' />
            </column>
            <column caption='Title - YTD  % Δ' datatype='string' name='[Title - MTD  % Δ (copy)_1943021772703002640]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;YTD % Δ&apos;' />
            </column>
            <column caption='YTD seamless_orders_percentage change (indicator)' datatype='string' default-format='p0.0%' name='[YTD seamless_orders_percentage change (copy)_5486580623777304623]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_YTD] THEN [seamless_orders_percentage_weekly (copy)_84512874297737255] END)&#10;- AVG(IF [is_2YTD] THEN [seamless_orders_percentage_weekly (copy)_84512874297737255] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [seamless_orders_percentage_weekly (copy)_84512874297737255] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='YTD seamless_orders_percentage current' datatype='real' default-format='p0.0%' name='[YTD seamless_orders_percentage change (indicator) (copy)_5486580623777370160]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND(AVG(IF [is_YTD] THEN [seamless_orders_percentage_weekly (copy)_84512874297737255] END),4)' />
            </column>
            <column caption='YTD seamless_orders_percentage previous' datatype='real' default-format='p0.0%' name='[YTD seamless_orders_percentage current (copy)_5486580623777488945]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND(AVG(IF [is_2YTD] THEN [seamless_orders_percentage_weekly (copy)_84512874297737255] END),4)' />
            </column>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='boolean' name='[is_2YTD]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_YTD]' role='dimension' type='nominal' />
            <column datatype='integer' name='[new_seamless_all_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[new_seamless_orders]' role='measure' type='quantitative' />
            <column-instance column='[Title - MTD  % Δ (copy)_1943021772703002640]' derivation='None' name='[none:Title - MTD  % Δ (copy)_1943021772703002640:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column caption='seamless_orders_percentage_ytd' datatype='real' name='[seamless_orders_percentage_weekly (copy)_84512874297737255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//order_issues = orders with ticket_issues/shrink/closure/delivery time over 30mins&#10;//1 &#10;//- &#10;(&#10;  {fixed [country_name],[Calculation_84512874283065357]:&#10;  //SUM(pandora_od_orders_with_issues_n)&#10;SUM([new_seamless_orders])&#10;  }&#10;  /&#10;  {fixed [country_name],[Calculation_84512874283065357]:&#10;  //SUM(pandora_od_orders_with_issues_d)&#10;  SUM([new_seamless_all_orders])&#10;  }&#10;)' />
            </column>
            <column-instance column='[MTD seamless_orders_percentage change (copy)_5486580623777099822]' derivation='User' name='[usr:MTD seamless_orders_percentage change (copy)_5486580623777099822:nk]' pivot='key' type='nominal' />
