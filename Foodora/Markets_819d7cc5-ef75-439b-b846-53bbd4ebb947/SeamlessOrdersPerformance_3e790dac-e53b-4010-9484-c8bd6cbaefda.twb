              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_last_week] THEN [help_center_session_rate_weekly (copy)_4504162639046725649] END)&#10;- AVG(IF [is_2last_week] THEN [help_center_session_rate_weekly (copy)_4504162639046725649] END))&#10;/ &#10;AVG(IF [is_2last_week] THEN [help_center_session_rate_weekly (copy)_4504162639046725649] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND((AVG(IF [is_last_week] THEN [help_center_session_rate_weekly (copy)_4504162639046725649] END)&#10;- AVG(IF [is_2last_week] THEN [help_center_session_rate_weekly (copy)_4504162639046725649] END))&#10;/ &#10;AVG(IF [is_2last_week] THEN [help_center_session_rate_weekly (copy)_4504162639046725649] END) * 100, 1)&#10;)' />
            </column>
            <column caption='WoW partial_orders_rate change (indicator)' datatype='string' default-format='p0.0%' name='[WoW contact_rate change (indicator) (copy)_4504162639047348245]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_last_week] THEN [help_center_session_rate_weekly (copy)_4504162639046725649] END)&#10;- AVG(IF [is_2last_week] THEN [help_center_session_rate_weekly (copy)_4504162639046725649] END))&#10;/ &#10;AVG(IF [is_2last_week] THEN [help_center_session_rate_weekly (copy)_4504162639046725649] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column datatype='integer' name='[all_seamles_orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='partial_orders_rate_weekly' datatype='real' name='[help_center_session_rate_weekly (copy)_4504162639046725649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//order_issues = orders with ticket_issues/shrink/closure/delivery time over 30mins&#10;&#10;  {fixed [country_name],[report_week]:&#10;  SUM([partial_orders])&#10;  }&#10;  /&#10;  {fixed [country_name],[report_week]:&#10;  SUM([all_seamles_orders])&#10;  }' />
