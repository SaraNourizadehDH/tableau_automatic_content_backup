            <column-instance column='[Calculation_654992317754626050]' derivation='None' name='[none:Calculation_654992317754626050:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[report_week]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5346265366558568466]' derivation='User' name='[usr:Calculation_5346265366558568466:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5346265366558924820]' derivation='User' name='[usr:Calculation_5346265366558924820:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
