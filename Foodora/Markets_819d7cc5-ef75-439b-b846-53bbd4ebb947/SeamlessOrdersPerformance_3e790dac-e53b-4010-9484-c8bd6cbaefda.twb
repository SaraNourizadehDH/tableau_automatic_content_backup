      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main_seamless_kpis (shared_eu)' name='federated.0d6yz8z0tpe1t11a1czxh175rj6l' />
          </datasources>
          <datasource-dependencies datasource='federated.0d6yz8z0tpe1t11a1czxh175rj6l'>
            <column caption='WoW weighted_close_time_percent change' datatype='string' name='[Calculation_5346265366558568466]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_last_week] THEN [Calculation_5346265366558699539] END)&#10;- AVG(IF [is_2last_week] THEN [Calculation_5346265366558699539] END))&#10;/ &#10;AVG(IF [is_2last_week] THEN [Calculation_5346265366558699539] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND((AVG(IF [is_last_week] THEN [Calculation_5346265366558699539] END)&#10;- AVG(IF [is_2last_week] THEN [Calculation_5346265366558699539] END))&#10;/ &#10;AVG(IF [is_2last_week] THEN [Calculation_5346265366558699539] END) * 100, 1)&#10;)' />
            </column>
            <column caption='weighted_close_time_percent_weekly' datatype='real' name='[Calculation_5346265366558699539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [country_name],[report_week]:&#10;SUM([events_orders_affected_by_close])&#10;}&#10;/&#10;{fixed [country_name],[report_week]:&#10;SUM([events_orders_forecast])&#10;&#10;}' />
            </column>
            <column caption='WoW weighted_close_time_percent change (indicator)' datatype='string' name='[Calculation_5346265366558924820]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_last_week] THEN [Calculation_5346265366558699539] END)&#10;- AVG(IF [is_2last_week] THEN [Calculation_5346265366558699539] END))&#10;/ &#10;AVG(IF [is_2last_week] THEN [Calculation_5346265366558699539] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='Title - LW  % Δ' datatype='string' name='[Calculation_654992317754626050]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;LW % Δ&apos;' />
              <aliases>
                <alias key='&quot;WoW Trend&quot;' value='LW % ∆' />
              </aliases>
            </column>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[events_orders_affected_by_close]' role='measure' type='quantitative' />
            <column datatype='integer' name='[events_orders_forecast]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_2last_week]' role='dimension' type='nominal' />
