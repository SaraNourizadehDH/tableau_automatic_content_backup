    <worksheet name='orders_on_time_ytd'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff'>Æ </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main_seamless_kpis (shared_eu)' name='federated.0d6yz8z0tpe1t11a1czxh175rj6l' />
          </datasources>
          <datasource-dependencies datasource='federated.0d6yz8z0tpe1t11a1czxh175rj6l'>
            <column caption='ytd_main_year' datatype='integer' name='[Calculation_84512874283065357]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_YTD] or [is_2YTD] THEN YEAR([report_date]) END' />
            </column>
            <column caption='Title - YTD  % Δ' datatype='string' name='[Title - MTD  % Δ (copy)_1943021772703002640]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;YTD % Δ&apos;' />
            </column>
            <column caption='YTD orders_early_10mins_change' datatype='string' default-format='p0.0%' name='[YTD delivery_time_percent_over_45_mins_change (copy)_1802002868793462793]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_YTD] THEN [delivery_time_percent_over_45_mins_ytd (copy)_1802002868792688644] END)&#10;- AVG(IF [is_2YTD] THEN [delivery_time_percent_over_45_mins_ytd (copy)_1802002868792688644] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [delivery_time_percent_over_45_mins_ytd (copy)_1802002868792688644] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND((AVG(IF [is_YTD] THEN [delivery_time_percent_over_45_mins_ytd (copy)_1802002868792688644] END)&#10;- AVG(IF [is_2YTD] THEN [delivery_time_percent_over_45_mins_ytd (copy)_1802002868792688644] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [delivery_time_percent_over_45_mins_ytd (copy)_1802002868792688644] END) * 100, 1)&#10;)' />
            </column>
            <column caption='YTD orders_early_10mins_change (indicator)' datatype='string' default-format='p0.0%' name='[YTD orders_on_time_change (copy)_1802002868799148049]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_YTD] THEN [delivery_time_percent_over_45_mins_ytd (copy)_1802002868792688644] END)&#10;- AVG(IF [is_2YTD] THEN [delivery_time_percent_over_45_mins_ytd (copy)_1802002868792688644] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [delivery_time_percent_over_45_mins_ytd (copy)_1802002868792688644] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='YTD orders_early_10mins_current' datatype='real' default-format='p0.0%' name='[YTD orders_on_time_change (indicator) (copy)_1802002868799262738]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND((AVG(IF [is_YTD] THEN [delivery_time_percent_over_45_mins_ytd (copy)_1802002868792688644] END)),4)' />
            </column>
            <column caption='YTD orders_early_10mins_previous' datatype='real' default-format='p0.0%' name='[YTD orders_on_time_current (copy)_1802002868799361043]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND((AVG(IF [is_2YTD] THEN [delivery_time_percent_over_45_mins_ytd (copy)_1802002868792688644] END)),4)' />
            </column>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='orders_early_10mins_ytd' datatype='real' name='[delivery_time_percent_over_45_mins_ytd (copy)_1802002868792688644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [country_name],[Calculation_84512874283065357]:&#10;SUM(pandora_od_orders_not_on_time_early)&#10;}&#10;/&#10;{fixed [country_name],[Calculation_84512874283065357]:&#10;SUM([new_table_all_orders])&#10;}' />
            </column>
            <column datatype='boolean' name='[is_2YTD]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_YTD]' role='dimension' type='nominal' />
            <column datatype='integer' name='[new_table_all_orders]' role='measure' type='quantitative' />
            <column-instance column='[Title - MTD  % Δ (copy)_1943021772703002640]' derivation='None' name='[none:Title - MTD  % Δ (copy)_1943021772703002640:nk]' pivot='key' type='nominal' />
