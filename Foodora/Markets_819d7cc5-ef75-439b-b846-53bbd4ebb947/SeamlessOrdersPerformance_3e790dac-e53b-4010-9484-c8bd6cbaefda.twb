            <column caption='YTD orders_late_10mins_change' datatype='string' default-format='p0.0%' name='[YTD orders_early_10mins_change (copy)_296252474774646798]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ROUND((AVG(IF [is_YTD] THEN [orders_early_10mins_ytd (copy)_296252474774564872] END)&#10;- AVG(IF [is_2YTD] THEN [orders_early_10mins_ytd (copy)_296252474774564872] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [orders_early_10mins_ytd (copy)_296252474774564872] END), 4) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND((AVG(IF [is_YTD] THEN [orders_early_10mins_ytd (copy)_296252474774564872] END)&#10;- AVG(IF [is_2YTD] THEN [orders_early_10mins_ytd (copy)_296252474774564872] END))&#10;/ &#10;AVG(IF [is_2YTD] THEN [orders_early_10mins_ytd (copy)_296252474774564872] END) * 100, 1)&#10;)' />
