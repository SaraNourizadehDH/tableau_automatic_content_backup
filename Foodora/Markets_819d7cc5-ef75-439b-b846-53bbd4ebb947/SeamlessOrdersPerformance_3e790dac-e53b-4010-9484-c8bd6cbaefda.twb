    <worksheet name='partial_orders_rate daily'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='16'>Partial Orders Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_report_main_seamless_kpis (shared_eu)' name='federated.0d6yz8z0tpe1t11a1czxh175rj6l' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='  Time Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0d6yz8z0tpe1t11a1czxh175rj6l'>
            <column caption='current_year_week' datatype='string' name='[Calculation_1943021772555628545]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(ISOYEAR(now())) &#10;+ &#10;&apos;-&apos; &#10;+ &#10;(IF ISOWEEK(now()) &lt; 10 THEN STR(0) + STR(ISOWEEK(now()))&#10;ELSE STR(ISOWEEK(now()))&#10;END)' />
            </column>
            <column caption='partial_orders_rate' datatype='real' name='[Calculation_4504162639050481687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[partial_orders]/[all_seamles_orders]' />
            </column>
            <column caption='week_dimension' datatype='string' name='[Calculation_654992317758599171]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//exclude current week&#10;IF [report_week]!= [Calculation_1943021772555628545] &#10;AND [is_last_6_weeks]&#10;THEN [report_week] &#10;END' />
            </column>
            <column caption='time_dimension' datatype='string' name='[Calculation_97671849648975875]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Day&apos; THEN [week_dimension (copy)_459930141429800962]&#10;    WHEN &apos;Week&apos; THEN [Calculation_654992317758599171]&#10;    WHEN &apos;Month&apos; THEN [week_dimension (copy)_97671849649909764]&#10;END' />
            </column>
            <column datatype='integer' name='[all_seamles_orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='is_last_6_months' datatype='boolean' name='[is_last_6_days (copy)_97671849651605509]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] &gt;= DATEADD(&apos;month&apos;, -6, DATETRUNC(&apos;month&apos;,today()))' />
            </column>
            <column caption='is_last_6_days' datatype='boolean' name='[is_last_6_weeks (copy)_97671849326993409]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] &gt;= today() - 6' />
            </column>
            <column datatype='boolean' name='[is_last_6_weeks]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_97671849648975875]' derivation='None' name='[none:Calculation_97671849648975875:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[pandora_od_orders_with_customer_contact_d]' role='measure' type='quantitative' />
            <column datatype='integer' name='[pandora_od_orders_with_customer_contact_n]' role='measure' type='quantitative' />
            <column datatype='integer' name='[partial_orders]' role='measure' type='quantitative' />
            <column-instance column='[seamless_orders_percentage (copy)_296252475552714771]' derivation='User' name='[pcrk:usr:seamless_orders_percentage (copy)_296252475552714771:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' rank-options='Competition,Ascending' type='PctRank' />
            </column-instance>
            <column datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[report_month]' role='dimension' type='nominal' />
            <column datatype='string' name='[report_week]' role='dimension' type='nominal' />
            <column caption='contact_rate' datatype='real' name='[seamless_orders_percentage (copy)_296252475552714771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//order_issues = orders with ticket_issues/shrink/closure/delivery time over 30mins&#10;//SUM([pandora_od_orders_with_customer_contact])/SUM([pandora_od_gross_orders])&#10;&#10;SUM(pandora_od_orders_with_customer_contact_n)/SUM(pandora_od_orders_with_customer_contact_d)' />
            </column>
            <column-instance column='[Calculation_4504162639050481687]' derivation='Sum' name='[sum:Calculation_4504162639050481687:qk]' pivot='key' type='quantitative' />
            <column caption='date_dimension' datatype='string' name='[week_dimension (copy)_459930141429800962]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//exclude current week&#10;IF [report_date]!= TODAY() &#10;AND [is_last_6_weeks (copy)_97671849326993409]&#10;THEN &#10;&#10;RIGHT(LEFT([report_month],4),2)+&apos;-&apos;+&#10;IF DATEPART(&apos;month&apos;,[report_date])&lt;10 THEN &apos;0&apos; ELSE &apos;&apos; END +&#10;STR(DATEPART(&apos;month&apos;,[report_date]))+&#10;&apos;-&apos;+&#10;IF DATEPART(&apos;day&apos;,[report_date])&lt;10 THEN &apos;0&apos; ELSE &apos;&apos; END +&#10;STR(DATEPART(&apos;day&apos;,[report_date]))&#10;END' />
            </column>
            <column caption='month_dimension' datatype='string' name='[week_dimension (copy)_97671849649909764]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//exclude current week&#10;IF DATETRUNC(&apos;month&apos;,[report_date]) != DATETRUNC(&apos;month&apos;,today()) &#10;AND [is_last_6_days (copy)_97671849651605509]&#10;THEN [report_month] &#10;END' />
            </column>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0d6yz8z0tpe1t11a1czxh175rj6l].[none:Calculation_97671849648975875:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
