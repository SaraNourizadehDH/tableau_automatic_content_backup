      <column caption='% Extreme Early' datatype='real' name='[Calculation_1899252420315303938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_1899252420315119616] THEN [orders_count] ELSE 0 END)&#10;&#10;/[Calculation_2071726197410054146]' />
