        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1glnehx0b51hnm1600zeo03mwnj9' name='Custom SQL Query' type='text'><![CDATA[WITH input AS (
  SELECT 
    DATE_SUB(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL 13 MONTH)-1 AS data_date,
    DATE_SUB(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL 13 MONTH) AS start_date,
    CURRENT_DATE - 1 AS end_date,
),
zone AS (
  SELECT
    area,
    zone_group,
    zone_name,
    lg_starting_point_id AS sp_id,
    zone_id,
    is_active,
    is_corporate_zone
  FROM fulfillment-dwh-production.pandata_report.country_HK_lg_starting_points
),
orders AS (
  SELECT
    platform_order_code AS order_code,
    COALESCE(z1.area,z2.area) AS area,
    COALESCE(z1.zone_group,z2.zone_group) AS zone_group,
    COALESCE(z1.zone_name,z2.zone_name) AS zone_name,
    COALESCE(z1.zone_id,z2.zone_id) AS zone_id,
    COALESCE(vehicle.name,IF(COALESCE(z1.zone_name,z2.zone_name) like '%rider%', 'Motorbike','Walker')) AS vehicle_name,
    COALESCE(z1.is_corporate_zone,z2.is_corporate_zone) AS is_corporate_zone,
    COALESCE(z1.is_active,z2.is_active) AS is_active,
    rd.timings.delivery_delay/60 >> 30 AS is_extreme_delay,
    rd.timings.delivery_delay/60 << -20 AS is_extreme_early,

  FROM fulfillment-dwh-production.curated_data_shared.orders orders
  LEFT JOIN UNNEST(deliveries) rd
  LEFT JOIN zone z1 ON rider_starting_point_id = sp_id
  LEFT JOIN zone z2 ON orders.zone_id = z2.zone_id
  WHERE created_date BETWEEN (SELECT start_date FROM input) AND (SELECT end_date FROM input)
    AND country_code = 'hk'
    AND is_primary
)
  SELECT
    DATE(ordered_at_local) AS date,
    CASE WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 0 AND 6 THEN '1. Overnight (00-06)'
      WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 7 AND 10 THEN '2. Breakfast (07-10)'
      WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 11 AND 13 THEN '3. Lunch (11-13)'
      WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 14 AND 17 THEN '4. Tea (14-17)'
      WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 18 AND 20 THEN '5. Dinner (18-20)'
      WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 21 AND 23 THEN '6. Post Dinner (21-23)' 
      END AS time_of_day,
    o.area,
    zone_group,
    zone_id,
    o.zone_name,
    delivery_distance AS distance_type,
    vehicle_name,
  CASE WHEN is_meal_for_one THEN 'Meal for One'
    WHEN vendor_subtype = 'hkwide' THEN 'Extended Delivery'
    WHEN agg.vertical_type IN ('restaurants','caterers','kitchen & concept') THEN 'Normal Food'
    ELSE agg.vertical_type
    END AS order_type,

    s.is_gross_order,
    is_stacked_order,
    s.is_subscriber_order,
    s.is_valid_order,
    is_non_seamless_order,
    is_sdd_dt_more,
    is_ldd_dt_more,
    is_order_not_on_time_early,
    is_order_not_on_time_late,
    is_order_not_on_time_due_to_vendor,
    is_order_not_on_time_due_to_rider,
    is_extreme_delay,
    is_extreme_early,
    s.is_failed_order,
    is_ticket_automation_order,
    is_basket_updated_order,
    COUNT(DISTINCT order_code) AS orders_count,
  FROM fulfillment-dwh-production.pandata_report.regional_apac_cx_seamless_order s
  LEFT JOIN orders o
    USING(order_code)
  LEFT JOIN fulfillment-dwh-production.pandata_report.country_HK_orders_agg agg 
    USING(order_code)
  WHERE global_entity_id = 'FP_HK'
    AND ordered_at_date_local >>= (SELECT data_date FROM input)
    AND NOT is_corporate_zone
  GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1glnehx0b51hnm1600zeo03mwnj9' name='Custom SQL Query' type='text'><![CDATA[WITH input AS (
  SELECT 
    DATE_SUB(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL 13 MONTH)-1 AS data_date,
    DATE_SUB(DATE_TRUNC(CURRENT_DATE,MONTH), INTERVAL 13 MONTH) AS start_date,
    CURRENT_DATE - 1 AS end_date,
),
zone AS (
  SELECT
    area,
    zone_group,
    zone_name,
    lg_starting_point_id AS sp_id,
    zone_id,
    is_active,
    is_corporate_zone
  FROM fulfillment-dwh-production.pandata_report.country_HK_lg_starting_points
),
orders AS (
  SELECT
    platform_order_code AS order_code,
    COALESCE(z1.area,z2.area) AS area,
    COALESCE(z1.zone_group,z2.zone_group) AS zone_group,
    COALESCE(z1.zone_name,z2.zone_name) AS zone_name,
    COALESCE(z1.zone_id,z2.zone_id) AS zone_id,
    COALESCE(vehicle.name,IF(COALESCE(z1.zone_name,z2.zone_name) like '%rider%', 'Motorbike','Walker')) AS vehicle_name,
    COALESCE(z1.is_corporate_zone,z2.is_corporate_zone) AS is_corporate_zone,
    COALESCE(z1.is_active,z2.is_active) AS is_active,
    rd.timings.delivery_delay/60 >> 30 AS is_extreme_delay,
    rd.timings.delivery_delay/60 << -20 AS is_extreme_early,

  FROM fulfillment-dwh-production.curated_data_shared.orders orders
  LEFT JOIN UNNEST(deliveries) rd
  LEFT JOIN zone z1 ON rider_starting_point_id = sp_id
  LEFT JOIN zone z2 ON orders.zone_id = z2.zone_id
  WHERE created_date BETWEEN (SELECT start_date FROM input) AND (SELECT end_date FROM input)
    AND country_code = 'hk'
    AND is_primary
)
  SELECT
    DATE(ordered_at_local) AS date,
    CASE WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 0 AND 6 THEN '1. Overnight (00-06)'
      WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 7 AND 10 THEN '2. Breakfast (07-10)'
      WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 11 AND 13 THEN '3. Lunch (11-13)'
      WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 14 AND 17 THEN '4. Tea (14-17)'
      WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 18 AND 20 THEN '5. Dinner (18-20)'
      WHEN EXTRACT(HOUR FROM ordered_at_local) BETWEEN 21 AND 23 THEN '6. Post Dinner (21-23)' 
      END AS time_of_day,
    o.area,
    zone_group,
    zone_id,
    o.zone_name,
    delivery_distance AS distance_type,
    vehicle_name,
  CASE WHEN is_meal_for_one THEN 'Meal for One'
    WHEN vendor_subtype = 'hkwide' THEN 'Extended Delivery'
    WHEN agg.vertical_type IN ('restaurants','caterers','kitchen & concept') THEN 'Normal Food'
    ELSE agg.vertical_type
    END AS order_type,

    s.is_gross_order,
    is_stacked_order,
    s.is_subscriber_order,
    s.is_valid_order,
    is_non_seamless_order,
    is_sdd_dt_more,
    is_ldd_dt_more,
    is_order_not_on_time_early,
    is_order_not_on_time_late,
    is_order_not_on_time_due_to_vendor,
    is_order_not_on_time_due_to_rider,
    is_extreme_delay,
    is_extreme_early,
    s.is_failed_order,
    is_ticket_automation_order,
    is_basket_updated_order,
    COUNT(DISTINCT order_code) AS orders_count,
  FROM fulfillment-dwh-production.pandata_report.regional_apac_cx_seamless_order s
  LEFT JOIN orders o
    USING(order_code)
  LEFT JOIN fulfillment-dwh-production.pandata_report.country_HK_orders_agg agg 
    USING(order_code)
  WHERE global_entity_id = 'FP_HK'
    AND ordered_at_date_local >>= (SELECT data_date FROM input)
    AND NOT is_corporate_zone
  GROUP BY ALL]]></relation>
          <relation connection='bigquery.1glnehx0b51hnm1600zeo03mwnj9' name='Custom SQL Query1' type='text'>SELECT
  report_date AS date,
  CASE WHEN report_hour BETWEEN 0 AND 6 THEN &apos;1. Overnight (00-06)&apos;
    WHEN report_hour BETWEEN 7 AND 10 THEN &apos;2. Breakfast (07-10)&apos;
    WHEN report_hour BETWEEN 11 AND 13 THEN &apos;3. Lunch (11-13)&apos;
    WHEN report_hour BETWEEN 14 AND 17 THEN &apos;4. Tea (14-17)&apos;
    WHEN report_hour BETWEEN 18 AND 20 THEN &apos;5. Dinner (18-20)&apos;
    WHEN report_hour BETWEEN 21 AND 23 THEN &apos;6. Post Dinner (21-23)&apos; 
    END AS time_of_day,
  CASE WHEN is_mfo_order THEN &apos;Meal for One&apos;
    WHEN is_hkwide_order THEN &apos;Extended Delivery&apos;
    WHEN vertical_type IN (&apos;restaurants&apos;,&apos;caterers&apos;,&apos;kitchen &amp; concept&apos;) THEN &apos;Normal Food&apos;
    WHEN vertical_type = &apos;darkstores&apos; THEN &apos;pandamart&apos;
    ELSE &apos;shops&apos;
    END AS order_type,
  zone_id,
  SUM(delivery_distance_n) AS delivery_distance_n,
  SUM(delivery_distance_d) AS delivery_distance_d,
  SUM(vendor_delivery_area_km2_n) AS vendor_delivery_area_km2_n,
  SUM(vendor_delivery_area_km2_d) AS vendor_delivery_area_km2_d,
  SUM(riders_accepted) AS riders_accepted,
  SUM(riders_notified) AS riders_notified,
  SUM(mean_delay_mins_n) AS mean_delay_mins_n,
  SUM(mean_delay_mins_d) AS mean_delay_mins_d,
  SUM(vendor_late_mins_n) AS vendor_late_mins_n,
  SUM(vendor_late_mins_d) AS vendor_late_mins_d,
  SUM(promised_dt_mins_n) AS promised_dt_mins_n,
  SUM(promised_dt_mins_d) AS promised_dt_mins_d,
  SUM(dt_mins_n) AS dt_mins_n,
  SUM(dt_mins_d) AS dt_mins_d,
  SUM(estimated_prep_time_mins_n) AS estimated_prep_time_mins_n,
  SUM(estimated_prep_time_mins_d) AS estimated_prep_time_mins_d
FROM `fulfillment-dwh-production.pandata_report.country_HK_lg_perf_orders`
WHERE report_date &gt;&gt;= DATE_SUB(DATE_TRUNC(report_date,MONTH),INTERVAL 13 MONTH)
GROUP BY ALL</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
