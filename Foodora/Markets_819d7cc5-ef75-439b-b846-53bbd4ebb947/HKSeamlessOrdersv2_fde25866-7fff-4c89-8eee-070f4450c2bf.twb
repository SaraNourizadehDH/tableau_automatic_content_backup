            <column caption='Reason Owner' datatype='string' name='[Calculation_2071726197493710873]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    [Long DT - SDD (copy) (copy) (copy) (copy)_6436347563829002250]&#10;    OR &#10;        (([Long DT - SDD (copy) (copy)_6436347563828981768] OR [Long DT - SDD (copy) (copy) (copy)_6436347563828989961]) AND [is_order_not_on_time_due_to_vendor])&#10;THEN &apos;Vendor&apos;&#10;&#10;ELSEIF&#10;    (([Long DT - SDD (copy) (copy)_6436347563828981768] OR [Long DT - SDD (copy) (copy) (copy)_6436347563828989961]) AND [is_order_not_on_time_due_to_rider])&#10;    OR [Cancelled (copy)_6436347563830415373] &#10;    OR [Long DT - SDD (copy) (copy)_6436347563828981768]&#10;    OR [Long DT - SDD (copy) (copy) (copy)_6436347563828989961]&#10;THEN &apos;Logistics&apos;&#10;&#10;ELSEIF &#10;    [Long DT - SDD (copy) (copy) (copy) (copy) (copy)_6436347563829010443]&#10;    OR [Long DT - SDD (copy)_6436347563828973575] &#10;    OR [Calculation_6436347563828670470]&#10;&#10;THEN &apos;Both&apos;&#10;ELSE &apos;Seamless Orders&apos;&#10;&#10;END' />
