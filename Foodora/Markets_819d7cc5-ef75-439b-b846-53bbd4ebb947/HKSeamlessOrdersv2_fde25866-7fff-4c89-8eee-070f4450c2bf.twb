        <calculation class='tableau' formula='IF [Long DT - SDD (copy) (copy) (copy) (copy)_6436347563829002250] AND [Calculation_2071726197496176667]&lt;&gt; &apos;OOS&apos; THEN &apos;OOS&apos;&#10;ELSEIF ([Long DT - SDD (copy) (copy)_6436347563828981768] OR [Calculation_1899252420315119616]) AND [Calculation_2071726197496176667]&lt;&gt; &apos;Early&apos; THEN &apos;Early&apos;&#10;ELSEIF ([Long DT - SDD (copy) (copy) (copy)_6436347563828989961] OR [Is Extreme Delay (copy)_1899252420315193345]) AND [Calculation_2071726197496176667]&lt;&gt; &apos;Late&apos; THEN &apos;Late&apos;&#10;ELSEIF [Calculation_6436347563828670470] AND [Calculation_2071726197496176667]&lt;&gt; &apos;Long DT - SDD&apos; THEN &apos;Long DT - SDD&apos;&#10;ELSEIF [Long DT - SDD (copy)_6436347563828973575] AND [Calculation_2071726197496176667]&lt;&gt; &apos;Long DT - LDD&apos; THEN &apos;Long DT - LDD&apos;&#10;ELSEIF [Cancelled (copy)_6436347563830415373] AND [Calculation_2071726197496176667]&lt;&gt; &apos;Contacted&apos; THEN &apos;Contacted&apos;&#10;ELSEIF [Long DT - SDD (copy) (copy) (copy) (copy) (copy)_6436347563829010443] AND [Calculation_2071726197496176667]&lt;&gt; &apos;Cancelled&apos; THEN &apos;Cancelled&apos;&#10;ELSE &apos;Seamless Orders&apos;&#10;&#10;END' />
