            <column caption='% Seamless Order' datatype='real' default-format='p0.0%' name='[Calculation_2071726197410246659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_6436347563831029774] THEN [orders_count] ELSE 0 END)&#10;&#10;/[Calculation_2071726197410054146]' />
