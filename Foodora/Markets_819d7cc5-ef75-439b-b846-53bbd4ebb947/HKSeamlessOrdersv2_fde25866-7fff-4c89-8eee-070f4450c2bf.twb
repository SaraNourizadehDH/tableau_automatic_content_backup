          <datasource-dependencies datasource='federated.0n1hlbu166c33c1h7919i1kt21po'>
            <column caption='Day of Week' datatype='string' name='[Calculation_1117033446927540224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[date])' />
            </column>
            <column caption='Is Extreme Early' datatype='boolean' name='[Calculation_1899252420315119616]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_extreme_early]' />
            </column>
            <column caption='Gross Order Count' datatype='integer' name='[Calculation_2071726197410054146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;&#10;IF [is_gross_order] THEN [orders_count] ELSE 0 END&#10;&#10;)' />
            </column>
            <column caption='% Seamless Order' datatype='real' default-format='p0.0%' name='[Calculation_2071726197410246659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_6436347563831029774] THEN [orders_count] ELSE 0 END)&#10;&#10;/[Calculation_2071726197410054146]' />
            </column>
            <column caption='Timeframe' datatype='string' datatype-customized='true' name='[Calculation_2071726197411663876]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Day&apos; THEN STR(YEAR([date]))+ &apos;-&apos; + RIGHT(&apos;0&apos;+STR(MONTH([date])),2)+ &apos;-&apos; + RIGHT(&apos;0&apos;+STR(DAY([date])),2)&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN STR(YEAR(DATETRUNC(&apos;iso-week&apos;,[date]))) + &apos;-&apos; + RIGHT(&apos;0&apos;+DATENAME(&apos;iso-week&apos;,[date]),2)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos; THEN STR(YEAR([date])) + &apos;-&apos; + RIGHT(&apos;0&apos;+STR(MONTH([date])),2)&#10;&#10;END' />
            </column>
            <column caption='Comparison' datatype='string' name='[Calculation_2071726197446561808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Stacked Orders&apos; THEN (IF[is_stacked_order] THEN&apos;Stacked&apos; ELSE &apos;Non-Stacks&apos; END)&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Distance Type&apos; THEN [distance_type]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Vertical Type&apos; THEN [order_type]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Vehicle Name&apos; THEN [vehicle_name]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Time of Day&apos; THEN [time_of_day]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Zone Type&apos; THEN [Calculation_2071726197486649365]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Zone Group&apos; THEN [zone_group]&#10;END' />
            </column>
            <column caption='Reason Count' datatype='integer' name='[Calculation_2071726197461155858]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='LEN(&#10;       REPLACE(&#10;        STR([Long DT - SDD (copy) (copy) (copy) (copy) (copy)_6436347563829010443])&#10;        + STR([Cancelled (copy)_6436347563830415373])&#10;        + STR([Long DT - SDD (copy) (copy)_6436347563828981768])&#10;        + STR([Long DT - SDD (copy) (copy) (copy)_6436347563828989961])&#10;        + STR([Long DT - SDD (copy)_6436347563828973575])&#10;        + STR([Calculation_6436347563828670470])&#10;        + STR([Long DT - SDD (copy) (copy) (copy) (copy)_6436347563829002250])&#10;    ,&quot;f&quot;,&quot;&quot;)&#10;)' />
            </column>
            <column caption='Reason Type' datatype='string' name='[Calculation_2071726197462355987]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2071726197461155858]&gt;1 THEN &apos;Multiple Reasons&apos;&#10;ELSEIF [Calculation_2071726197461155858]= 1 THEN &apos;Single Reason&apos;&#10;ELSE &apos;Seamless Orders&apos;&#10;END' />
            </column>
            <column caption='Zone Type' datatype='string' name='[Calculation_2071726197486649365]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER([zone_name]), &apos;rider&apos;) THEN &apos;Rider&apos; ELSE &apos;Walker&apos; END' />
            </column>
            <column caption='Reason Owner' datatype='string' name='[Calculation_2071726197493710873]' role='dimension' type='nominal'>
