      </column>
      <column caption='Ops Metrics' datatype='real' name='[Calculation_1398156587801849864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 7] = &apos;Acceptance Rate&apos; THEN [Calculation_1398156587801223175]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Delivery Distance&apos; THEN [Calculation_1398156587799592961]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Mean Delay&apos; THEN [Calculation_1398156587800559619]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Promised DT&apos; THEN [Calculation_1398156587800645636]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Vendor Delivery Area&apos; THEN [Calculation_1398156587800850437]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Vendor Late&apos; THEN [Calculation_1398156587801026566]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Delivery Time&apos; THEN [Calculation_1398156587799359488]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Est. Prep Time&apos; THEN [Calculation_1398156587800416258]&#10;END' />
      </column>
      <column caption='Dot Sizes' datatype='string' name='[Calculation_1398156587822596105]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;By Date&apos; THEN STR([date])&#10;ELSEIF [Parameters].[Parameter 8] = &apos;By Date and TOD&apos; THEN STR([date])+&apos; - &apos;+[time_of_day]&#10;ELSEIF [Parameters].[Parameter 8] = &apos;By Date and Zone&apos; THEN STR([date])+&apos; - &apos;+[zone_name]&#10;END' />
      </column>
      <column caption='Is Extreme Early' datatype='boolean' name='[Calculation_1899252420315119616]' role='dimension' type='nominal'>
