  </column>
  <column caption='L7d vs previous l7d od' datatype='real' default-format='p0.0%' name='[Calculation_517280701040685059]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='([T7D Orders (copy)_174021959076356109]-[Previous T7D Orders (copy)_174021959078952977])/[Previous T7D Orders (copy)_174021959078952977]' />
  </column>
  <column caption='Date Range for Start Date' datatype='date' name='[Calculation_5264496889549340679]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='IF &#10;    DATEDIFF(&quot;day&quot;,     [reference_date_local], { FIXED : MAX([reference_date_local])}) &gt;= 7&#10;THEN [reference_date_local]&#10;END' />
  </column>
  <column caption='lmd' datatype='boolean' name='[Calculation_527061944040620032]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='datepart(&apos;day&apos;,DATEADD(&apos;day&apos;,1,[reference_date_local]))=1' />
