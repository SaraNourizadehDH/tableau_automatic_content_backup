  <column caption='Total AFV Eur Per Day' datatype='real' name='[AFV Eur (copy 2)_1127236962444795904]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ FIXED [reference_date_local], [country_name]:&#10;round(sum([total_gfv_eur]) / sum([total_number_of_successful_orders]),2)&#10;}' />
  </column>
  <column caption='AFV Eur (copy)' datatype='real' name='[AFV Eur (copy)_109493778668576784]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='round(sum([total_gfv_eur]) / sum([total_number_of_successful_orders]),2)' />
  </column>
  <column caption='T7D AFV Eur' datatype='real' name='[AFV Eur (copy)_128141500939751435]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='//sum(iif([date]&gt;= now() - 8, [total_gfv_eur],0)) / sum(iif([date]&gt;=now() - 8, [total_number_of_successful_orders], 0))&#10;{FIXED [reference_date_local], [country_name]:&#10;[Calculation_5401364105257897994]&#10;}' />
  </column>
  <column caption='existing customers L7D Average' datatype='real' name='[AFV L7D Average (copy)_552253907126247424]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='WINDOW_AVG(SUM([main_total_existing_customer_count (Custom SQL Query)]),first(),first()+7)'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='AFV WTD vs PWTD' datatype='string' name='[AFV MTD vs LYMTD (copy)_3688870375764226076]' role='measure' type='nominal'>
    <calculation class='tableau' formula='if&#10;(&#10;    (SUM(iif([MTD (copy 2)_382172716287561733], [total_gfv_eur], 0)) / SUM(iif([MTD (copy 2)_382172716287561733], [total_number_of_successful_orders], 0)))&#10;    -&#10;    (SUM(iif([PMTD (copy)_382172716287787014], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_382172716287787014], [total_number_of_successful_orders], 0)))&#10;)&#10;&#10;/&#10;&#10;(SUM(iif([PMTD (copy)_382172716287787014], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_382172716287787014], [total_number_of_successful_orders], 0))) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    (SUM(iif([MTD (copy 2)_382172716287561733], [total_gfv_eur], 0)) / SUM(iif([MTD (copy 2)_382172716287561733], [total_number_of_successful_orders], 0)))&#10;    -&#10;    (SUM(iif([PMTD (copy)_382172716287787014], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_382172716287787014], [total_number_of_successful_orders], 0)))&#10;)&#10;&#10;/&#10;&#10;(SUM(iif([PMTD (copy)_382172716287787014], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_382172716287787014], [total_number_of_successful_orders], 0)))&#10;* 100&#10;,1)&#10;)' />
  </column>
  <column caption='AFV MTD vs LYMTD (Indicator)' datatype='string' name='[AFV MTD vs PMTD (Indicator) (copy)_3688870375761883163]' role='measure' type='nominal'>
    <calculation class='tableau' formula='if&#10;(&#10;    (SUM(iif([PMTD (copy)_128141502928715882], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_128141502928715882], [total_number_of_successful_orders], 0)))&#10;    -&#10;    (SUM(iif([PMTD (copy)_383861552113147904], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_383861552113147904], [total_number_of_successful_orders], 0)))&#10;)&#10;&#10;/&#10;&#10;(SUM(iif([PMTD (copy)_383861552113147904], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_383861552113147904], [total_number_of_successful_orders], 0))) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
  </column>
  <column caption='AFV WTD vs PWTD (Indicator)' datatype='string' name='[AFV MTD vs PMTD (Indicator) (copy)_3688870375765762077]' role='measure' type='nominal'>
    <calculation class='tableau' formula='if&#10;(&#10;    (SUM(iif([MTD (copy 2)_382172716287561733], [total_gfv_eur], 0)) / SUM(iif([MTD (copy 2)_382172716287561733], [total_number_of_successful_orders], 0)))&#10;    -&#10;    (SUM(iif([PMTD (copy)_382172716287787014], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_382172716287787014], [total_number_of_successful_orders], 0)))&#10;)&#10;&#10;/&#10;&#10;(SUM(iif([PMTD (copy)_382172716287787014], [total_gfv_eur], 0)) / SUM(iif([PMTD (copy)_382172716287787014], [total_number_of_successful_orders], 0))) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
  </column>
  <column caption='AFV MTD vs PMTD (Indicator)' datatype='string' name='[AFV MTD vs PMTD (copy)_128141503797129334]' role='measure' type='nominal'>
