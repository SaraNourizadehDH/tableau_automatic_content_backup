  </column>
  <column caption='test_' datatype='integer' name='[Calculation_527061944041971714]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM({ fixed [country_name] : MAX([au_yoy_month_cumulative_cum_distinct_cnt]) })' />
  </column>
  <column caption='Is Today' datatype='boolean' name='[Calculation_5284200113965608960]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='IIF([reference_date_local] = date(NOW()), TRUE, FALSE)' />
  </column>
  <column caption='AFV Eur' datatype='real' name='[Calculation_5401364105257897994]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='round(sum([total_gfv_eur]) / sum([total_number_of_successful_orders]),2)' />
  </column>
  <column caption='2 days before' datatype='boolean' name='[Calculation_5401364115944001580]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='[reference_date_local] &lt;= now() - 2' />
  </column>
  <column caption='NPS Score' datatype='real' name='[Calculation_5401364116094865456]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(SUM([nps_positive_ratings]) &#10;- SUM([nps_negative_ratings])) * 100&#10;/ SUM([total_ratings])' />
  </column>
  <column caption='NCR' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_567664670600089663]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ fixed [global_entity_id], [reference_date_local]:MAX([ncr_revenue])}' />
  </column>
  <column caption='NULL' datatype='string' name='[Calculation_6109836637894942736]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='&quot; &quot;' />
  </column>
  <column caption='% of total Orders' datatype='real' name='[Calculation_6109836638281674769]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='[Calculation_6109836638287081491]&#10;/&#10;( &#10;sum(&#10;{fixed [country_name]: sum(iif([Calculation_378794978108076033], [total_number_of_successful_orders], 0))}&#10;)&#10;)' />
  </column>
  <column caption='Yesterday&apos;s Orders Main' datatype='integer' name='[Calculation_6109836638287081491]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IIF([Calculation_378794978108076033], [total_number_of_successful_orders], null))' />
  </column>
  <column caption='Orders WoW Main (Positive)' datatype='string' name='[Calculation_6109836638295011353]' role='measure' type='nominal'>
    <calculation class='tableau' formula='if&#10;([Calculation_6109836638287081491] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / iif([Yesterday&apos;s Orders Main (copy)_6109836638288412692] = 0, 1, [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Calculation_6109836638287081491] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / iif([Yesterday&apos;s Orders Main (copy)_6109836638288412692] = 0, 1, [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Calculation_6109836638287081491] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / iif([Yesterday&apos;s Orders Main (copy)_6109836638288412692] = 0, 1, [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
  </column>
  <column caption='% of Total Orders Str' datatype='string' name='[Calculation_6109836638400880667]' role='measure' type='nominal'>
    <calculation class='tableau' formula='iif(isnull([Calculation_6109836638281674769]), null, &#10;str(round([Calculation_6109836638281674769]*100,2)) + &quot;% of Total&quot;&#10;)' />
  </column>
  <column caption='Day (Similar Scale)' datatype='datetime' name='[Calculation_6149806036921335808]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='IF [reference_date_local] &lt; DATEADD(&apos;day&apos;, -6, {fixed:MIN([Calculation_378794978106404864])})&#10;THEN DATEADD(&apos;day&apos;, 7, [reference_date_local])&#10;ELSE [reference_date_local]&#10;END' />
  </column>
  <column caption='hour now' datatype='integer' name='[Calculation_6149806037898752003]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, now())' />
  </column>
  <column aggregation='Sum' caption='1' datatype='integer' name='[Calculation_6180416436319469570]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='1' />
    <aliases>
      <alias key='1' value='LastD WoW' />
    </aliases>
  </column>
  <column caption='L1W' datatype='boolean' name='[Calculation_6180416436320313347]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='[is_same_day_last_week]' />
  </column>
  <column caption='W1 GFV %' datatype='string' name='[Calculation_6180416436345286660]' role='measure' type='nominal'>
    <calculation class='tableau' formula='IF (SUM(IF [L1W (copy 2)] THEN [total_gfv_eur] ELSE 0 END) - SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END))&#10;/ SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(ABS(&#10;//IF SUM(IF [Yesterday] THEN [total_gfv_eur] ELSE 0 END) - SUM(IF [L1W] THEN [total_gfv_eur] ELSE 0 END) &gt;= 0&#10;//THEN &#10;   (SUM(IF [L1W (copy 2)] THEN [total_gfv_eur] ELSE 0 END) - SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END))&#10;   / SUM(IF [Calculation_6180416436320313347] THEN [total_gfv_eur] ELSE 0 END)&#10;//ELSE&#10;//    SUM(IF [L1W] THEN [total_gfv_eur] ELSE 0 END) / SUM(IF [Yesterday] THEN [total_gfv_eur] ELSE 0 END)&#10;//END &#10;* 100), 2))' />
  </column>
  <column caption='f. Exclude Today' datatype='boolean' name='[Calculation_6180416436359450629]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;IIF(DATEPART(&apos;hour&apos;, NOW()) &lt;= 2, [reference_date_local] &lt;= NOW() - 2, [reference_date_local] != TODAY())' />
  </column>
  <column caption='Total GFV Eur Per Day' datatype='real' name='[Calculation_6180416436372983814]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ FIXED [reference_date_local]:&#10;SUM([total_gfv_eur])&#10;}' />
  </column>
  <column caption='Max GFV In L7D' datatype='real' name='[Calculation_6180416436375367687]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='MAX([Calculation_6180416436372983814])' />
  </column>
  <column caption='Avg Delivery Time' datatype='real' name='[Calculation_6180416437197033481]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([total_delivery_time_in_minutes]) / SUM([total_number_of_successful_nonpreorder_orders])' />
  </column>
  <column caption='Fail Rate' datatype='real' name='[Calculation_6180416437370576907]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM([total_number_of_failed_orders]) / SUM([total_number_of_orders])' />
  </column>
  <column caption='AFV Target' datatype='real' name='[Calculation_679410292710674438]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='([amt_gfv_mp_eur] + [amt_gfv_od_eur])/[successful_orders]' />
  </column>
  <column caption='Total New Customer Count By Date, Country' datatype='integer' name='[Calculation_841399086563610626]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='{ FIXED [placed_date], [global_entity_id (Custom SQL Query)]:&#10;MAX([main_total_new_customer_count (Custom SQL Query)])&#10;}' />
  </column>
  <column caption='TT Orders Yesterday' datatype='integer' name='[Calculation_841399086758039563]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF [L1W (copy 2)] THEN [total_number_of_successful_orders] ELSE 0 END)' />
  </column>
  <column caption='Kitchens GMV' datatype='real' name='[Calculation_94012665307082756]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='IF [is_yesterday] and ([vertical_type] = &apos;kitchen&apos; or [vertical_type] = &apos;kitchen&amp;concepts&apos;)&#10;then [total_gmv_eur]&#10;else 0 end' />
  </column>
  <column caption='Calculation2' datatype='boolean' name='[Calculation_94012673484685376]' role='measure' type='nominal'>
    <calculation class='tableau' formula='TOTAL( COUNTD( [country_code] ) ) = SUM( { FIXED : COUNTD( [country_code] ) } )'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='BE test' datatype='real' name='[Calculation_992691939185336320]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(iif(MONTH([target_month]) = MONTH(today()-1) AND YEAR([target_month]) = YEAR(today()-1),[successful_orders],0))' />
  </column>
  <column caption='Delivery time L7D Average ' datatype='real' name='[Closure Time L7D Average (copy)_392235447403339819]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='WINDOW_AVG([Calculation_6180416437197033481],first(),first()+7)'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='Revenue (Indicator)' datatype='integer' name='[Comm Rev (Indicator - New) (copy)_128141504825254085]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='if isnull(sum([Calculation_128141504822948034])) then 0&#10;elseif ((sum([Calculation_128141504822948034]) - [Comm Rev L7D Average (copy)_128141504825458886])/abs([Comm Rev L7D Average (copy)_128141504825458886]) &gt;= 0.1)&#10;then 2&#10;elseif (sum([Calculation_128141504822948034]) - [Comm Rev L7D Average (copy)_128141504825458886])/abs([Comm Rev L7D Average (copy)_128141504825458886]) &lt;= -0.1 &#10;then -2&#10;elseif ((sum([Calculation_128141504822948034]) - [Comm Rev L7D Average (copy)_128141504825458886])/abs([Comm Rev L7D Average (copy)_128141504825458886]) &gt;= 0.05)&#10;then 1&#10;elseif (sum([Calculation_128141504822948034]) - [Comm Rev L7D Average (copy)_128141504825458886])/abs([Comm Rev L7D Average (copy)_128141504825458886]) &lt;= -0.05&#10;then -1&#10;else 0&#10;end'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='Revenue L7D Average' datatype='real' name='[Comm Rev L7D Average (copy)_128141504825458886]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='WINDOW_AVG(sum([Calculation_128141504822948034]),first(),first()+7)'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='Revenue MTD vs PMTD' datatype='string' name='[Comm Rev MTD vs PMTD (copy)_128141504829669583]' role='measure' type='nominal'>
    <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([MTD (copy)_128141504139079806], [Calculation_128141504822948034], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (copy)_128141504139505791], [Calculation_128141504822948034], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (copy)_128141504139505791], [Calculation_128141504822948034], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([MTD (copy)_128141504139079806], [Calculation_128141504822948034], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([PMTD (copy)_128141504139505791], [Calculation_128141504822948034], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([PMTD (copy)_128141504139505791], [Calculation_128141504822948034], 0)&#10;) * 100&#10;,1)&#10;)' />
  </column>
  <column caption='Revenue WoW Main (Negative)' datatype='string' name='[Comm Rev WoW Main (Negative) (copy)_128141504857403604]' role='measure' type='nominal'>
    <calculation class='tableau' formula='if&#10;([Yesterday&apos;s Comms Rev Main (copy)_128141504856039634] - [L7D Comm Rev Main (copy)_128141504856514771]) / [L7D Comm Rev Main (copy)_128141504856514771] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s Comms Rev Main (copy)_128141504856039634] - [L7D Comm Rev Main (copy)_128141504856514771]) / [L7D Comm Rev Main (copy)_128141504856514771] &lt;= 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s Comms Rev Main (copy)_128141504856039634] - [L7D Comm Rev Main (copy)_128141504856514771]) / [L7D Comm Rev Main (copy)_128141504856514771] * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
