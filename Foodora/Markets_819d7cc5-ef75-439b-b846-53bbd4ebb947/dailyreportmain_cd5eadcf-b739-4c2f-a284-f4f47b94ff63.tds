      <object caption='Targets' id='Targets_F2FC9954213D42A2886C170BE6534BE6'>
        <properties context=''>
          <relation connection='bigquery.126pg641p64tew1fh2il71ccq8f9' name='Custom SQL Query2' type='text'><![CDATA[/*WITH prep AS (SELECT global_entity_id, 
target_month,
be_version,
successful_orders, 
amt_total_revenue_eur,
acquisitions, 
amt_gmv_eur, 
active_users, 
od_restaurant_delivery_fees, 
od_restaurant_orders, 
quarter_orders_target,
quarter_revenue_eur_target,
quarter_gmv_target,
quarter_acquisitions_target
FROM fulfillment-dwh-production.curated_data_shared_intl_markets.lucanet_be
LEFT JOIN (SELECT
  date_trunc(current_date -1, month) AS target_month,
  global_entity_id,
  SUM(successful_orders) quarter_orders_target,
  SUM(amt_total_revenue_eur) quarter_revenue_eur_target,
  SUM(amt_gmv_eur) quarter_gmv_target,
  SUM(acquisitions) quarter_acquisitions_target
  FROM fulfillment-dwh-production.curated_data_shared_intl_markets.lucanet_be
  WHERE DATE_TRUNC(target_month, quarter) = date_trunc(current_date -1, quarter)
  GROUP BY 1, 2
) USING (target_month, global_entity_id)
WHERE global_entity_id IN (
"DJ_CZ",
"FO_NO",
"FP_DE",
"MJM_AT",
"OP_SE",
"PO_FI",
"NP_HU",
"YS_TR")),

total_with_TR AS (SELECT
  'DH_Europe+YS_TR' AS global_entity_id,
  target_month,
  MAX(be_version),
SUM(successful_orders), 
SUM(amt_total_revenue_eur),
SUM(acquisitions), 
SUM(amt_gmv_eur), 
SUM(active_users), 
SUM(od_restaurant_delivery_fees), 
SUM(od_restaurant_orders), 
SUM(quarter_orders_target),
SUM(quarter_revenue_eur_target),
SUM(quarter_gmv_target),
SUM(quarter_acquisitions_target)
FROM prep
WHERE global_entity_id IN (
"DJ_CZ",
"FO_NO",
"MJM_AT",
"OP_SE",
"PO_FI",
"NP_HU",
"YS_TR")
GROUP BY 1, 2
),

total_without_TR AS (SELECT
  'DH_Europe' AS global_entity_id,
  target_month,
  MAX(be_version),
SUM(successful_orders), 
SUM(amt_total_revenue_eur),
SUM(acquisitions), 
SUM(amt_gmv_eur), 
SUM(active_users), 
SUM(od_restaurant_delivery_fees), 
SUM(od_restaurant_orders), 
SUM(quarter_orders_target),
SUM(quarter_revenue_eur_target),
SUM(quarter_gmv_target),
SUM(quarter_acquisitions_target)
FROM prep
WHERE global_entity_id IN (
"DJ_CZ",
"FO_NO",
"MJM_AT",
"OP_SE",
"PO_FI",
"NP_HU")
GROUP BY 1, 2)

SELECT *
FROM prep
UNION ALL
SELECT *
FROM total_with_TR
UNION ALL
SELECT *
FROM total_without_TR*/

with
prep as
(SELECT 
CASE 
   WHEN country = 'Austria' THEN 'MJM_AT'
   WHEN country = 'Czech Republic' THEN 'DJ_CZ'
   WHEN country = 'Finland' THEN 'PO_FI'
   WHEN country = 'Sweden' THEN 'OP_SE'
   WHEN country = 'Norway' THEN 'FO_NO'
   WHEN country = 'Hungary' THEN 'NP_HU' 
      WHEN country = 'Turkey' THEN "YS_TR"
END as global_entity_id,
month as target_month, 
record_type as be_version,
total_orders as successful_orders, 
total_net_gmv  as amt_gmv_eur
FROM `dhh---analytics-eu.pandata_eu_finance.regional_eu_finance_ln_os_key_kpis` 
where
currency = 'EUR' 
and record_type <<>> 'Actual'
and record_type LIKE '%Best Estimate%'
and country in ('Austria', 'Czech Republic', 'Finland', 'Sweden', 'Norway', 'Hungary', 'Turkey')
),

total_with_TR AS (SELECT
  'DH_Europe+YS_TR' AS global_entity_id,
  target_month,
  MAX(be_version),
SUM(successful_orders), 
SUM(amt_gmv_eur), 
FROM prep
WHERE global_entity_id IN (
"DJ_CZ",
"FO_NO",
"MJM_AT",
"OP_SE",
"PO_FI",
"NP_HU",
"YS_TR")
GROUP BY 1, 2
),

total_without_TR AS (SELECT
  'DH_Europe' AS global_entity_id,
  target_month,
  MAX(be_version),
SUM(successful_orders), 
SUM(amt_gmv_eur), 
FROM prep
WHERE global_entity_id IN (
"DJ_CZ",
"FO_NO",
"MJM_AT",
"OP_SE",
"PO_FI",
"NP_HU")
GROUP BY 1, 2)

SELECT *
FROM prep
UNION ALL
SELECT *
FROM total_with_TR
UNION ALL
SELECT *
FROM total_without_TR]]></relation>
        </properties>
