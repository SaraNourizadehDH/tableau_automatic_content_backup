    <calculation class='tableau' formula='if isnull(sum([Calculation_841399086563610626])) then 0&#10;elseif (sum([Calculation_841399086563610626]) - [DH Subsidies L7D Average (copy)_392235447732990005])/abs([DH Subsidies L7D Average (copy)_392235447732990005]) &gt;=0.2&#10;then 2&#10;elseif (sum([Calculation_841399086563610626]) - [DH Subsidies L7D Average (copy)_392235447732990005])/abs([DH Subsidies L7D Average (copy)_392235447732990005]) &lt;=-0.2 &#10;then -2&#10;elseif ((sum([Calculation_841399086563610626]) - [DH Subsidies L7D Average (copy)_392235447732990005])/abs([DH Subsidies L7D Average (copy)_392235447732990005]) &gt;= 0.1)&#10;then 1&#10;elseif (sum([Calculation_841399086563610626]) - [DH Subsidies L7D Average (copy)_392235447732990005])/abs([DH Subsidies L7D Average (copy)_392235447732990005]) &lt;=-0.1&#10;then -1&#10;else 0&#10;end'>
