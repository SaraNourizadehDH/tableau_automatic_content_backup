  <column caption='Within Last 21 days' datatype='boolean' name='[Calculation_2662964453460332558]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='//IF DAY(TODAY()) = 1 AND MONTH([placed_date]) = MONTH(TODAY()-1) THEN null&#10;//ELSE&#10;[reference_date_local] &lt;= TODAY()-1&#10;AND&#10;[reference_date_local] &gt;= TODAY()-21&#10;//END' />
  </column>
  <column caption='Hours worked yesterday' datatype='real' name='[Calculation_2718626066435383301]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(IF [L1W (copy 2)]&#10;THEN ([worked_hours])&#10;ELSE 0&#10;END)' />
  </column>
  <column caption='od_customer_delivery_fee' datatype='real' name='[Calculation_2882655655196323840]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='sum(od_df_user_paid_incl_vat_eur) +&#10;sum(od_service_fee_plus_vat_eur) +&#10;sum(od_minimum_delivery_value_eur) +&#10;sum(od_delivery_priority_fee_eur)' />
  </column>
  <column caption='target_month_current' datatype='datetime' name='[Calculation_2979623767953010689]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='//([Target Month]) =&#10;   DATETRUNC(&apos;month&apos;, TODAY()-1)' />
  </column>
  <column caption='L7D Orders' datatype='real' name='[Calculation_301952284732268545]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='SUM(IF [reference_date_local] &gt; [Parameters].[Parameter 1] AND [reference_date_local] &lt;= [Calculation_378794978106404864] THEN [total_number_of_successful_orders] END)&#10;/&#10;7' />
  </column>
  <column caption='L7D Orders Growth %' datatype='real' default-format='p0.0%' name='[Calculation_301952284733530116]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(([Calculation_301952284732268545])-SUM(IF [Calculation_378794978108076033] = TRUE THEN [total_number_of_successful_orders] ELSE null END))&#10;/&#10;[Calculation_301952284732268545]' />
  </column>
  <column caption='l7d vs previous day shops' datatype='real' name='[Calculation_310115084253265985]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='([L7D Orders (copy) (copy)_310115084210036770]- SUM(IF [reference_date_local] = [Parameters].[Start Date (copy) (copy)_310115084204445709] THEN [total_number_of_successful_orders] END))&#10;/&#10;SUM(IF [reference_date_local] = [Parameters].[Start Date (copy) (copy)_310115084204445709] THEN [total_number_of_successful_orders] END)' />
  </column>
  <column caption='Exec: GMV (Average line)' datatype='real' name='[Calculation_3498874746735554562]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='AVG({ FIXED [Calculation_418201474534387717], [country_name] : AVG([Total GFV Eur Per Day (copy 2)]) })' />
  </column>
  <column caption='customer_delivery_fee_eur_new' datatype='real' name='[Calculation_3657204422667014144]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='(sum([od_df_user_paid_incl_vat_eur]) / SUM(od_successful_orders))&#10;+&#10;(sum([od_delivery_priority_fee_eur]) / SUM(od_successful_orders))&#10;+&#10;(sum([od_service_fee_plus_vat_eur]) / SUM(od_successful_orders))&#10;+&#10;(sum([od_minimum_delivery_value_eur]) / SUM(od_successful_orders))' />
  </column>
  <column caption='start date + 7' datatype='date' name='[Calculation_378794978106404864]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='[Parameters].[Parameter 1] + 7' />
  </column>
  <column caption='Start date + 7 Boolean' datatype='boolean' name='[Calculation_378794978108076033]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='[reference_date_local] = [Calculation_378794978106404864]' />
  </column>
  <column caption='yesterday/x day' datatype='string' name='[Calculation_378794978173800456]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [reference_date_local] WHEN DATE(TODAY()-1) THEN &apos;yesterday&apos;&#10;ELSE &apos;on the&apos; END' />
  </column>
  <column caption='NPS Score L7D Average' datatype='real' name='[Calculation_392235446685270034]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='WINDOW_AVG([Calculation_5401364116094865456],first(),first()+7)'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column caption='NPS Score (Indicator - L7D)' datatype='integer' name='[Calculation_392235446685605907]' role='measure' type='quantitative'>
    <calculation class='tableau' formula='iif([Calculation_5401364116094865456] - [Calculation_392235446685270034] &gt; 0, 1, -1)'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column aggregation='Sum' caption='2' datatype='integer' name='[Calculation_4056406276413648901]' role='dimension' type='ordinal'>
    <calculation class='tableau' formula='2' />
    <aliases>
      <alias key='2' value=' ' />
    </aliases>
  </column>
