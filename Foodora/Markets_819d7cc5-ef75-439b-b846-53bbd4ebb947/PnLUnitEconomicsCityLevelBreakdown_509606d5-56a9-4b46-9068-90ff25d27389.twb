        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1svaied08v7zli19dra0o1hc84lg'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata APAC Production' schema='pandata_ap_commercial' server-oauth='' username='rikin.khanna@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1svaied08v7zli19dra0o1hc84lg' name='Custom SQL Query' type='text'>SELECT &#13;
order_month,&#13;
country_name,&#13;
city,&#13;
count(distinct(order_uuid)) as orders,&#13;
sum(commission_net_local/fx_rate_eur) as commission_net,&#13;
suM(delivery_fee_net_local/fx_rate_eur) as df,&#13;
sum(ads_rev_per_valid_order_local/fx_rate_eur) as NCR,&#13;
sum(other_ncr_per_valid_order/fx_rate_eur) as Other_NCR,&#13;
sum(difference_to_minimum_order_value_local/fx_rate_eur) as Small_order_rev,&#13;
sum(service_fee_local/fx_rate_eur) as svc_fee,&#13;
sum(gmv_user_paid_amount_local/fx_rate_eur) as GMV,&#13;
sum(-rider_cpo_logistics_local/fx_rate_eur) as rider_Cpo,&#13;
sum(failed_order_cost_local/fx_rate_eur) as failed_costs,&#13;
sum(other_delivery_cpo/fx_rate_eur) as other_del_cpo,&#13;
sum(transmission_method_cpo/fx_rate_eur) as transmission_cpo,&#13;
sum(contact_center_cpo/fx_rate_eur) as contact_center_cpo,&#13;
sum(-online_payment_cost/fx_rate_eur) as online_payment_cpo,&#13;
sum(other_cos_cpo/fx_rate_eur) as other_cos_cpo,&#13;
sum(-incentive_cost_local/fx_rate_eur) as incentive_local,&#13;
sum(gross_profit_local/fx_rate_eur) as gp,&#13;
sum(fully_loaded_gross_profit_local/fx_rate_eur) as flgp&#13;
&#13;
&#13;
 FROM `fulfillment-dwh-production.pandata_report.regional_apac_finance_order_level_flgp_platform` WHERE &#13;
 order_date &gt;&gt;= &quot;2022-01-01&quot;  AND is_valid_order=TRUE&#13;
 GROUP BY 1,2,3</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1svaied08v7zli19dra0o1hc84lg' name='Custom SQL Query' type='text'>SELECT &#13;
order_month,&#13;
country_name,&#13;
