  <worksheets>
    <worksheet name='Select Cities View'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (pandata_ap_commercial)' name='federated.11j0ugb1okziws17jd8mq0rndxax' />
          </datasources>
          <datasource-dependencies datasource='federated.11j0ugb1okziws17jd8mq0rndxax'>
            <column caption='Comm per order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1185291134124019713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_net])/SUM([orders])' />
            </column>
            <column caption='Total Del CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1185291134124412930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(([rider_Cpo]+[other_del_cpo])+[failed_costs])/sum([orders])' />
            </column>
            <column caption='Total NCR/order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1185291134124687363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([NCR]+[Other_NCR])/sum(orders)' />
            </column>
            <column caption='Other Rev/Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1185291134125060100]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([svc_fee]+[Small_order_rev])/sum([orders])' />
            </column>
            <column caption='COS CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1185291134125309957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([transmission_cpo]+[other_cos_cpo]+[contact_center_cpo])/sum([orders])' />
            </column>
            <column caption='Del Fee/Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1185291134126731270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(df)/sum([orders])' />
            </column>
            <column caption='iCPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1185291134126989319]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([incentive_local])/sum([orders])' />
            </column>
            <column caption='GPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1185291134127157256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gp])/sum([orders])' />
            </column>
            <column caption='FLGPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1185291134127742985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([flgp])/sum([orders])' />
            </column>
            <column caption='City v2' datatype='string' name='[Calculation_1185291134135779340]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [city]=&apos;Hong Kong&apos; then &apos;Hong Kong&apos; &#13;&#10;ELSEIF [city]=&apos;Hong kong&apos; then &apos;Hong Kong&apos; &#13;&#10;Else [city] END' />
            </column>
            <column caption='GMV per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1185291134141206541]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV])/sum([orders])' />
            </column>
            <column datatype='real' name='[GMV]' role='measure' type='quantitative' />
            <column datatype='real' name='[NCR]' role='measure' type='quantitative' />
            <column datatype='real' name='[Other_NCR]' role='measure' type='quantitative' />
            <column datatype='real' name='[Small_order_rev]' role='measure' type='quantitative' />
            <column datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
