        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0id58e707sihd2164hcmp0leej7a' name='Custom_SQL_Query' type='text'><![CDATA[SELECT 
  vendor_penalties.*,
  IF(sf_users.about_me IN ("KAM","PCM","Shops","Incubation"), sf_users.about_me, "Other") AS ampr_subgroup,

FROM `fulfillment-dwh-production.pandata_report.country_PH_finance_ncr_vendor_penalties_tableau` AS vendor_penalties

/**PHDA-3089 added AMPR subgroups**/
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PH_sf_users` AS sf_users
       ON sf_users.full_name = vendor_penalties.account_owner_name

WHERE vendor_penalties.reported_date >>= '2020-07-01'
  AND vendor_penalties.reported_date <<= LAST_DAY(CURRENT_DATE('Asia/Manila'))]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0id58e707sihd2164hcmp0leej7a' name='Custom_SQL_Query' type='text'><![CDATA[SELECT 
  vendor_penalties.*,
  IF(sf_users.about_me IN ("KAM","PCM","Shops","Incubation"), sf_users.about_me, "Other") AS ampr_subgroup,

FROM `fulfillment-dwh-production.pandata_report.country_PH_finance_ncr_vendor_penalties_tableau` AS vendor_penalties

/**PHDA-3089 added AMPR subgroups**/
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PH_sf_users` AS sf_users
       ON sf_users.full_name = vendor_penalties.account_owner_name

WHERE vendor_penalties.reported_date >>= '2020-07-01'
  AND vendor_penalties.reported_date <<= LAST_DAY(CURRENT_DATE('Asia/Manila'))]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
