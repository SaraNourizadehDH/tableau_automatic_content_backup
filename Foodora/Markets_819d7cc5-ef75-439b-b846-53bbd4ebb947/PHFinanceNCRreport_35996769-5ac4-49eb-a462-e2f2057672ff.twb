      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0dciccy1w2n5ky136xdk30tezjex'>
            <connection CATALOG='foodpanda-ph-bigquery' EXECCATALOG='foodpanda-ph-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='foodpanda-ph-bigquery' schema='finance_ncr' server-oauth='' username='marquee.enriquez@foodpanda.ph' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0dciccy1w2n5ky136xdk30tezjex' name='Custom_SQL_Query' type='text'><![CDATA[SELECT
  rental_fees.*,
  
  IF(sf_users.about_me IN ("KAM","PCM","Shops","Incubation"), sf_users.about_me, "Other") AS ampr_subgroup,

FROM `fulfillment-dwh-production.pandata_report.country_PH_finance_ncr_rental_fees` AS rental_fees

/**PHDA-3089 added AMPR subgroups**/
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PH_sf_users` AS sf_users
       ON sf_users.full_name = rental_fees.account_owner_name       

WHERE rental_fees.reported_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE('Asia/Manila'), MONTH), INTERVAL 6 MONTH)
  AND rental_fees.reported_date <<= LAST_DAY(CURRENT_DATE('Asia/Manila'))]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0dciccy1w2n5ky136xdk30tezjex' name='Custom_SQL_Query' type='text'><![CDATA[SELECT
  rental_fees.*,
  
  IF(sf_users.about_me IN ("KAM","PCM","Shops","Incubation"), sf_users.about_me, "Other") AS ampr_subgroup,

FROM `fulfillment-dwh-production.pandata_report.country_PH_finance_ncr_rental_fees` AS rental_fees

/**PHDA-3089 added AMPR subgroups**/
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PH_sf_users` AS sf_users
       ON sf_users.full_name = rental_fees.account_owner_name       

WHERE rental_fees.reported_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE('Asia/Manila'), MONTH), INTERVAL 6 MONTH)
  AND rental_fees.reported_date <<= LAST_DAY(CURRENT_DATE('Asia/Manila'))]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
