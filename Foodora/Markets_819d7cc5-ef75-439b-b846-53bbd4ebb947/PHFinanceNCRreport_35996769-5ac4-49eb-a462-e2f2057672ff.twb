      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='ncr_vendor_penalties' id='_2F27C30519A84AA7A3EF81AE48A8E97B'>
            <properties context=''>
              <relation connection='bigquery.0id58e707sihd2164hcmp0leej7a' name='Custom_SQL_Query' type='text'><![CDATA[SELECT 
  vendor_penalties.*,
  IF(sf_users.about_me IN ("KAM","PCM","Shops","Incubation"), sf_users.about_me, "Other") AS ampr_subgroup,

FROM `fulfillment-dwh-production.pandata_report.country_PH_finance_ncr_vendor_penalties_tableau` AS vendor_penalties

/**PHDA-3089 added AMPR subgroups**/
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PH_sf_users` AS sf_users
       ON sf_users.full_name = vendor_penalties.account_owner_name

WHERE vendor_penalties.reported_date >>= '2020-07-01'
  AND vendor_penalties.reported_date <<= LAST_DAY(CURRENT_DATE('Asia/Manila'))]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
