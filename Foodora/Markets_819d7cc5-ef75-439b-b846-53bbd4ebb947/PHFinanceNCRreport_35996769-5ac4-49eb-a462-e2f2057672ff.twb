      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='ncr_rental_fees' id='_FF791CA17435498F91978514F881ADDB'>
            <properties context=''>
              <relation connection='bigquery.0dciccy1w2n5ky136xdk30tezjex' name='Custom_SQL_Query' type='text'><![CDATA[SELECT
  rental_fees.*,
  
  IF(sf_users.about_me IN ("KAM","PCM","Shops","Incubation"), sf_users.about_me, "Other") AS ampr_subgroup,

FROM `fulfillment-dwh-production.pandata_report.country_PH_finance_ncr_rental_fees` AS rental_fees

/**PHDA-3089 added AMPR subgroups**/
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PH_sf_users` AS sf_users
       ON sf_users.full_name = rental_fees.account_owner_name       

WHERE rental_fees.reported_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE('Asia/Manila'), MONTH), INTERVAL 6 MONTH)
  AND rental_fees.reported_date <<= LAST_DAY(CURRENT_DATE('Asia/Manila'))]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
