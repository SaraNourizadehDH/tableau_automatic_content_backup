      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='ncr_digital_billboards' id='_7ED9C72B6D1A42E195B1349ACB274E63'>
            <properties context=''>
              <relation connection='bigquery.030uxea0zwqayt1d257rl0oipkho' name='Custom_SQL_Query' type='text'><![CDATA[SELECT
  ncr_db.* EXCEPT (total_db_amount, created_at_local),
  COALESCE(vendors.vendor_code, 'HQ') AS vendor_code_billing,
  ncr_db.total_db_amount,
  ncr_db.created_at_local
FROM `fulfillment-dwh-production.pandata_report.country_PH_finance_ncr_digital_billboards` AS ncr_db

LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PH_vendors` AS vendors
       ON vendors.global_entity_id = 'FP_PH'
      AND vendors.global_vendor_id = ncr_db.grid_id_billing

WHERE reported_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE('Asia/Manila'), MONTH), INTERVAL 6 MONTH)
  AND reported_date <<= LAST_DAY(CURRENT_DATE('Asia/Manila'))]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
