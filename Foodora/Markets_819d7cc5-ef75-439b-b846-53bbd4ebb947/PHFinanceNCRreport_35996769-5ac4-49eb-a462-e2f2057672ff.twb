          <named-connection caption='BigQuery' name='bigquery.0id58e707sihd2164hcmp0leej7a'>
            <connection CATALOG='foodpanda-ph-bigquery' EXECCATALOG='foodpanda-ph-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='foodpanda-ph-bigquery' schema='finance_ncr' server-oauth='' username='marquee.enriquez@foodpanda.ph' workgroup-auth-mode='prompt' />
