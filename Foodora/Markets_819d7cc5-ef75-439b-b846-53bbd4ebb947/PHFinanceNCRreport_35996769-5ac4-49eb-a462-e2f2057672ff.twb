                  <formatted-text>
                    <run>Æ&#10;</run>
                    <run bold='true'>Period covered</run>
                    <run>: mid-year 2020 to current date

</run>
                    <run bold='true' fontcolor='#d80b63' fontsize='10'>NCR Sources Included:</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#222222'>• Onboarding Fees</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#222222'>Æ </run>
                    <run fontcolor='#222222'>  ○ PHP 300 one time payment for vendors activated after January 11, 2023</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#222222'>• Platform Fees &amp; Device Rentals</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ Platform Fees - 1,000 PHP</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#222222'>  ○ </run>
                    <run fontcolor='#222222'>Device Rentals &gt; Tablet charges - 560 PHP</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>Æ  </run>
                    <run bold='true' fontcolor='#222222'>○ </run>
                    <run fontcolor='#222222'>Device Rentals &gt; Sim card &amp; data charges - 392 PHP</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ Charges are prorated based on start data &amp; end date</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ If total GFV is less than 4,000 for the billing period, vendor will not be charged its respective platform fee (for vendors activated after January 11, 2023 there is no more PHP 4k GFV threshold; this is determined by whether or not they have an onboarding fee)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ Vendors cannot be double-charged i.e, if there already exists a Platform Fee, no Device Rentals must be charged anymore</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ Vendors from 7-Eleven &amp; Crunch Time are exempted of these charges</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ Vendors from chain groups JFC &amp; MGI are excluded from any device or sim card charges but may be charged with platform fees, if applicable</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ Only active accounts will be charged</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#222222'>• Vendor Penalties</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ January - August 2020 penalties were only backtracked based on available query and might not reflect actual numbers reported due to the behavior of pandata_reports.vendor_penalties table that does not store historical data</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ On or before September 30, 2020:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>     - CRCs covered are lateness, missing items, and cancellations charged at 5% threshold</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>     - If a vendor&apos;s total CRC exceeds 3% of its GFV for the period, it will only be charged 3% of its GFV </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ Starting October 1, 2020:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>     - Only cancellation CRCs will be charged at 2% threshold</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>     - Charge will 56 PHP inclusive of VAT (50 PHP exclusive of VAT)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ Penalty exeptions</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>     - JFC - until otherwise stated</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>     - MGI - until otherwise stated</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>     - McDonald&apos;s - June - September 2020</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#222222'>• Featured Listings</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ </run>
                    <run fontcolor='#172b4d'>Swimlane: CPP (Cost Per Period) - Premium Listing (a.k.a. PandaPicks)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ </run>
                    <run fontcolor='#172b4d'>Organic List: CPC (Cost Per Click) - Organic Listing (a.k.a. PandaClicks)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#222222'>• Pandabox</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ Joker fees per order</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#222222'>• Carousell</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ Digital Billboards</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#222222'>• DMart NMR </run>
                    <run bold='true'>(Period covered</run>
                    <run>: September 2021 to date)&#10;</run>
                    <run fontcolor='#222222'>  ○ Asset/Banner</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#222222'>  ○ Discount Subsidy</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{63B09879-BDF8-4382-860A-204BDB478CB5}' />
    </dashboard>
