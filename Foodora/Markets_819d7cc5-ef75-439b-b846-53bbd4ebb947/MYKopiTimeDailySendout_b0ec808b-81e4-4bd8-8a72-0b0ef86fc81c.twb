            <column caption='Latest -7 Fail Rate' datatype='real' default-format='p0.00%' name='[Latest -7 Orders (copy)_2558466854994214981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_2558466854712492051] = TRUE, [failed_orders], 0))/SUM(IIF([Calculation_2558466854712492051] = TRUE, [gross_orders], 0))' />
