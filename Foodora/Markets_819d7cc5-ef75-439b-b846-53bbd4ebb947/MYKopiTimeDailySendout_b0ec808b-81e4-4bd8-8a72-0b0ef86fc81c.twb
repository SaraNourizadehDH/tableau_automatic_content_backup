            <column caption='% Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_2558466854998011997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((SUM([failed_orders])/SUM([gross_orders])),3)' />
