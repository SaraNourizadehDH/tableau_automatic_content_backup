            <column caption='ADT' datatype='real' name='[Calculation_4668966232209788963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((SUM([actual_delivery_time_in_minutes])/SUM([actual_delivery_time_orders])),2)' />
