    <worksheet name='Yesterday AFV'>
      <table>
        <view>
          <datasources>
            <datasource caption='management_factsheet_daily' name='federated.19dbh6e05n6ik313c1n0y0b2n233' />
          </datasources>
          <datasource-dependencies datasource='federated.19dbh6e05n6ik313c1n0y0b2n233'>
            <column caption='latest' datatype='boolean' name='[Calculation_2558466854685552646]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] = {FIXED : MAX([order_date])}' />
            </column>
            <column caption='latest - 7' datatype='boolean' name='[Calculation_2558466854712492051]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] = {FIXED : MAX([order_date])} - 7' />
            </column>
            <column caption='One' datatype='integer' default-format='p0.00%' name='[Calculation_2558466854726570014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Latest -7 AFV' datatype='real' name='[Latest -7 Orders (copy)_2558466854976225312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_2558466854712492051] = TRUE, [valid_gfv], 0))/SUM(IIF([Calculation_2558466854712492051] = TRUE, [valid_orders], 0))' />
            </column>
            <column caption='Latest AFV' datatype='real' default-format='c&quot;RM&quot;#,##0.00;(&quot;RM&quot;#,##0.00)' name='[Latest Orders (copy)_2558466854976454689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_2558466854685552646] = TRUE, [valid_gfv], 0))/&#10;SUM(IIF([Calculation_2558466854685552646] = TRUE, [valid_orders], 0))' />
            </column>
            <column caption='AFV WoW (Indicator)' datatype='string' name='[Orders WoW (Indicator) (copy)_2558466854976823331]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;  (&#10;    ([Latest Orders (copy)_2558466854976454689] - [Latest -7 Orders (copy)_2558466854976225312])&#10;    /&#10;    IIF([Latest -7 Orders (copy)_2558466854976225312] = 0, 1, [Latest -7 Orders (copy)_2558466854976225312])&#10;  ) &gt; 0 &#10;THEN &apos;▲ &apos;&#10;ELSE &apos;▼ &apos;&#10;END' />
            </column>
            <column caption='AFV WoW (Negative)' datatype='string' name='[Orders WoW (Negative) (copy)_2558466854976983076]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;  (&#10;    ([Latest Orders (copy)_2558466854976454689] - [Latest -7 Orders (copy)_2558466854976225312])&#10;    /&#10;    IIF([Latest -7 Orders (copy)_2558466854976225312] = 0, 1, [Latest -7 Orders (copy)_2558466854976225312])&#10;  ) &lt; 0&#10;THEN &apos;▼ &apos;&#10;ELSE NULL&#10;END &#10;&#10;+ &#10;&#10;IF &#10;  (&#10;    ([Latest Orders (copy)_2558466854976454689] - [Latest -7 Orders (copy)_2558466854976225312])&#10;    /&#10;    IIF([Latest -7 Orders (copy)_2558466854976225312] = 0, 1, [Latest -7 Orders (copy)_2558466854976225312])&#10;  ) &lt;= 0 &#10;THEN&#10;    STR(&#10;      ROUND(&#10;          ( &#10;            ([Latest Orders (copy)_2558466854976454689] - [Latest -7 Orders (copy)_2558466854976225312])&#10;            / &#10;            IIF([Latest -7 Orders (copy)_2558466854976225312] = 0, 1, [Latest -7 Orders (copy)_2558466854976225312])&#10;          ) * 100&#10;          ,2&#10;      )&#10;    )&#10;&#10;    +&#10;&#10;    &quot;%&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='AFV WoW (Positive)' datatype='string' name='[Orders WoW (Positive) (copy)_2558466854977261605]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;  (&#10;    ([Latest Orders (copy)_2558466854976454689] - [Latest -7 Orders (copy)_2558466854976225312])&#10;    /&#10;    IIF([Latest -7 Orders (copy)_2558466854976225312] = 0, 1, [Latest -7 Orders (copy)_2558466854976225312])&#10;  ) &gt; 0&#10;THEN &apos;▲ &apos; &#10;ELSE NULL&#10;END &#10;&#10;+ &#10;&#10;IF &#10;  (&#10;    ([Latest Orders (copy)_2558466854976454689] - [Latest -7 Orders (copy)_2558466854976225312])&#10;    /&#10;    IIF([Latest -7 Orders (copy)_2558466854976225312] = 0, 1, [Latest -7 Orders (copy)_2558466854976225312])&#10;  ) &gt; 0&#10;THEN&#10;    STR(&#10;      ROUND(&#10;          ( &#10;            ([Latest Orders (copy)_2558466854976454689] - [Latest -7 Orders (copy)_2558466854976225312])&#10;            / &#10;            IIF([Latest -7 Orders (copy)_2558466854976225312] = 0, 1, [Latest -7 Orders (copy)_2558466854976225312])&#10;          ) * 100&#10;          ,2&#10;      )&#10;    )&#10;&#10;    +&#10;&#10;    &quot;%&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column-instance column='[Calculation_2558466854726570014]' derivation='Avg' name='[avg:Calculation_2558466854726570014:qk]' pivot='key' type='quantitative' />
