              <calculation class='tableau' formula='IF [Orders Base (copy)_2558466854996074582] &lt; 0&#10;THEN &apos;▼ &apos;&#10;ELSE NULL&#10;END &#10;+ &#10;IF [Orders Base (copy)_2558466854996074582] &lt;= 0 &#10;THEN STR(ROUND([Orders Base (copy)_2558466854996074582] * 100 ,2))&#10;+&#10;&quot;pp&quot;&#10;ELSE NULL&#10;END' />
            </column>
