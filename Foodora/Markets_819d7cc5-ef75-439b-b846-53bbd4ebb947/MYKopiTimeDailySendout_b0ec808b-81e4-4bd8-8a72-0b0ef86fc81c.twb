          </metadata-record>
          <metadata-record class='column'>
            <remote-name>checkout_to_transaction_sessions</remote-name>
            <remote-type>20</remote-type>
            <local-name>[checkout_to_transaction_sessions]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>checkout_to_transaction_sessions</remote-alias>
            <local-type>integer</local-type>
