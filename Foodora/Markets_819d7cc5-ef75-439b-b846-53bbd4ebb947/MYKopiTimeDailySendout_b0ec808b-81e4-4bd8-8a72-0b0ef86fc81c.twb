    <worksheet name='L7D Genuine CSAT'>
      <table>
        <view>
          <datasources>
            <datasource caption='management_factsheet_daily' name='federated.19dbh6e05n6ik313c1n0y0b2n233' />
          </datasources>
          <datasource-dependencies datasource='federated.19dbh6e05n6ik313c1n0y0b2n233'>
            <column caption='7days Before Tag' datatype='boolean' name='[Calculation_107523507324534789]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_date] , {MAX([order_date])}) &gt;= 7 AND&#10;DATEDIFF(&apos;day&apos;, [order_date] , {MAX([order_date])}) &lt;= 13' />
            </column>
            <column caption='One' datatype='integer' default-format='p0.00%' name='[Calculation_2558466854726570014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='L7D Tag' datatype='boolean' name='[Calculation_4668966232215633960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_date] , {MAX([order_date])}) &lt;= 6' />
            </column>
            <column caption='CSAT Base' datatype='real' name='[Incident Rate Base (copy)_1683924112079024145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Latest Incident Rate (copy)_1683924112079024144]-[Latest -7 Incident Rate (copy)_1683924112079024143]' />
            </column>
            <column caption='CSAT WoW (Indicator)' datatype='string' name='[Incident Rate WoW (Indicator) (copy)_1683924112079024146]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Incident Rate Base (copy)_1683924112079024145] &gt; 0 &#10;THEN &apos;▲ &apos;&#10;ELSE &apos;▼ &apos;&#10;END' />
            </column>
            <column caption='CSAT WoW (Negative)' datatype='string' name='[Incident Rate WoW (Negative) (copy)_1683924112079024147]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Incident Rate Base (copy)_1683924112079024145] &lt; 0&#10;THEN &apos;▼ &apos;&#10;ELSE NULL&#10;END &#10;+ &#10;IF [Incident Rate Base (copy)_1683924112079024145] &lt;= 0 &#10;THEN STR(ROUND([Incident Rate Base (copy)_1683924112079024145]*100,2))&#10;+&#10;&quot;pp&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='CSAT WoW (Positive)' datatype='string' name='[Incident Rate WoW (Positive) (copy)_1683924112079024148]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Incident Rate Base (copy)_1683924112079024145] &gt; 0&#10;THEN &apos;▲ &apos; &#10;ELSE NULL&#10;END &#10;+ &#10;IF [Incident Rate Base (copy)_1683924112079024145] &gt; 0&#10;THEN STR(ROUND([Incident Rate Base (copy)_1683924112079024145]*100, 2))&#10;+&#10;&quot;pp&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='7D Before CSAT' datatype='real' default-format='p0.00%' name='[Latest -7 Incident Rate (copy)_1683924112079024143]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_107523507324534789] = TRUE, [promoter_responses], 0))/SUM(IIF([Calculation_107523507324534789] = TRUE, [total_responses], 0))' />
            </column>
            <column caption='L7D CSAT' datatype='real' default-format='p0.00%' name='[Latest Incident Rate (copy)_1683924112079024144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_4668966232215633960] = TRUE, [promoter_responses], 0))/SUM(IIF([Calculation_4668966232215633960] = TRUE, [total_responses], 0))' />
            </column>
            <column-instance column='[Calculation_2558466854726570014]' derivation='Avg' name='[avg:Calculation_2558466854726570014:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
