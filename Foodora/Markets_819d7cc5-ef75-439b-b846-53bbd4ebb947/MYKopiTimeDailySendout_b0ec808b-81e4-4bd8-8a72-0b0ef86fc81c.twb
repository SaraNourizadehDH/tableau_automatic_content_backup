    <action caption='Highlight 1 (generated) 1 1 2 2 1 1 1' name='[Action31_83E627D8E2E841F9B6F89F6C7B15A08D]'>
      <activation auto-clear='true' type='on-select' />
      <source type='sheet' worksheet='LW mCVR4' />
