            </column>
            <column caption='LW Seamless % Base' datatype='real' name='[Seamless % Base (copy)_3241958443647348749]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Latest Seamless % (copy)_3241958443647348748] - [Latest -7 Seamless % (copy)_3241958443647348747]' />
