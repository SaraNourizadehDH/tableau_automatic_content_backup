      <column caption='latest' datatype='boolean' name='[Calculation_3966193582709055489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_date] = {FIXED : MAX([order_date])}' />
      </column>
      <column caption='Latest Orders' datatype='integer' name='[Calculation_3966193582709104642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_3966193582709055489] = TRUE THEN [valid_orders] END)' />
      </column>
      <column caption='latest - 7' datatype='boolean' name='[Calculation_3966193582709559299]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_date] = {FIXED : MAX([order_date])} - 7' />
      </column>
      <column caption='vs W-1 Order Growth' datatype='real' default-format='p0.00%' name='[Calculation_3966193582709784581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3966193582709104642]-[Latest Orders (copy)_3966193582709616644])/&#10;[Latest Orders (copy)_3966193582709616644]' />
      </column>
      <column caption='vs D-1 Order Growth' datatype='real' default-format='p0.00%' name='[Calculation_3966193582717575176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3966193582709104642]-[Latest Orders (copy)_3966193582712385543])/&#10;[Latest Orders (copy)_3966193582712385543]' />
      </column>
      <column caption='last 7 days' datatype='date' name='[Calculation_4668966231840616460]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[order_date]-7' />
      </column>
      <column caption='L7D Order Avg' datatype='real' name='[Calculation_4668966231841660941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([valid_orders]),-7,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
