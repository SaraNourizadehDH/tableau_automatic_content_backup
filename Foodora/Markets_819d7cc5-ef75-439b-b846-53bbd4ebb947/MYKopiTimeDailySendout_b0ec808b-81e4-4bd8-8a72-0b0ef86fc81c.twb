              <calculation class='tableau' formula='IF [Seamless % Base (copy)_3241958443647348749] &lt; 0&#10;THEN &apos;▼ &apos;&#10;ELSE NULL&#10;END &#10;+ &#10;IF [Seamless % Base (copy)_3241958443647348749] &lt;= 0 &#10;THEN STR(ROUND([Seamless % Base (copy)_3241958443647348749] * 100 ,2))&#10;+&#10;&quot;pp&quot;&#10;ELSE NULL&#10;END' />
