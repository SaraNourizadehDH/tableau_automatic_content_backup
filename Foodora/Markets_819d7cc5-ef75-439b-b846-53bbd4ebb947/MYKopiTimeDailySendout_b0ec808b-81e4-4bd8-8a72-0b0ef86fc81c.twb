              <calculation class='tableau' formula='SUM(IIF([Calculation_2558466854712492051] = TRUE, [incentivized_orders], 0))/&#10;SUM(IIF([Calculation_2558466854712492051] = TRUE, [valid_orders], 0))' />
            </column>
