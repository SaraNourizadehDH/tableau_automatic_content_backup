          <datasource-dependencies datasource='federated.19dbh6e05n6ik313c1n0y0b2n233'>
            <column caption='Offline Rate Base' datatype='real' name='[CVR Base (copy)_1207738815261536272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Latest CVR (copy)_1207738815261536269] - [Latest - 8 CVR (copy)_1207738815261536268])' />
            </column>
            <column caption='Offline Rate WoW (Indicator)' datatype='string' name='[CVR WoW (Indicator) (copy)_1207738815261536273]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [CVR Base (copy)_1207738815261536272] &gt; 0 &#10;THEN &apos;▲ &apos;&#10;ELSE &apos;▼ &apos;&#10;END' />
            </column>
            <column caption='Offline rate WoW (Negative)' datatype='string' name='[CVR WoW (Negative) (copy)_1207738815261536274]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [CVR Base (copy)_1207738815261536272]  &lt; 0&#10;THEN &apos;▼ &apos;&#10;ELSE NULL&#10;END &#10;+ &#10;IF [CVR Base (copy)_1207738815261536272]  &lt;= 0 &#10;THEN STR(ROUND([CVR Base (copy)_1207738815261536272]  * 100 ,2))&#10;+&#10;&quot;pp&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Offline Rate WoW (Positive)' datatype='string' name='[CVR WoW (Positive) (copy)_1207738815261536275]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [CVR Base (copy)_1207738815261536272] &gt; 0&#10;THEN &apos;▲ &apos; &#10;ELSE NULL&#10;END &#10;+ &#10;IF [CVR Base (copy)_1207738815261536272] &gt; 0&#10;THEN STR(ROUND([CVR Base (copy)_1207738815261536272] * 100, 2))&#10;+&#10;&quot;pp&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='latest' datatype='boolean' name='[Calculation_2558466854685552646]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] = {FIXED : MAX([order_date])}' />
            </column>
            <column caption='latest - 7' datatype='boolean' name='[Calculation_2558466854712492051]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] = {FIXED : MAX([order_date])} - 7' />
