    <worksheet name='MTD % Incentivized'>
      <table>
        <view>
          <datasources>
            <datasource caption='management_factsheet_daily' name='federated.19dbh6e05n6ik313c1n0y0b2n233' />
          </datasources>
          <datasource-dependencies datasource='federated.19dbh6e05n6ik313c1n0y0b2n233'>
            <column caption='latest' datatype='boolean' name='[Calculation_2558466854685552646]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] = {FIXED : MAX([order_date])}' />
            </column>
            <column caption='L7D Tag' datatype='boolean' name='[Calculation_4668966232215633960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_date] , {MAX([order_date])}) &lt;= 6' />
            </column>
            <column caption='L30D Incen Comparison' datatype='string' name='[L30D Order Comparison (copy)_4668966232225910834]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Latest ADF (copy)_2558466854989451316] &gt; [MTD Min ADF (copy)_4668966231229992965] THEN &quot;Higher than&quot;&#10;ELSEIF [Latest ADF (copy)_2558466854989451316] = [MTD Min ADF (copy)_4668966231229992965] THEN &quot;Equivalent to&quot;&#10;ELSE &quot;Lower than&quot;&#10;END' />
            </column>
            <column caption='L7D Order Comparison ' datatype='string' name='[L7D Order Comparison (copy)_4668966232225910833]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Latest ADF (copy)_2558466854989451316] &gt; [MTD Max ADF (copy)_4668966231229992964] THEN &quot;Higher than&quot;&#10;ELSEIF [Latest ADF (copy)_2558466854989451316] = [MTD Max ADF (copy)_4668966231229992964] THEN &quot;Equivalent to&quot;&#10;ELSE &quot;Lower than&quot;&#10;END' />
            </column>
            <column caption='L30D Tag' datatype='boolean' name='[L7D Tag (copy)_4668966232216911913]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_date] , {MAX([order_date])}) &lt;= 30' />
            </column>
            <column caption='Latest % Incentivized' datatype='real' default-format='p0.00%' name='[Latest ADF (copy)_2558466854989451316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_2558466854685552646] = TRUE, [incentivized_orders], 0))/&#10;SUM(IIF([Calculation_2558466854685552646] = TRUE, [valid_orders], 0))' />
            </column>
            <column caption='L7D Avg % Incentivized' datatype='real' default-format='p0.00%' name='[MTD Max ADF (copy)_4668966231229992964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_4668966232215633960] = TRUE THEN [incentivized_orders] END)/&#10;SUM(IF [Calculation_4668966232215633960] = TRUE THEN [valid_orders] END)' />
            </column>
            <column caption='L30D Avg % Incentivized' datatype='real' default-format='p0.00%' name='[MTD Min ADF (copy)_4668966231229992965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [L7D Tag (copy)_4668966232216911913] = TRUE THEN [incentivized_orders] END)/&#10;SUM(IF [L7D Tag (copy)_4668966232216911913] = TRUE THEN [valid_orders] END)' />
            </column>
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='integer' name='[incentivized_orders]' role='measure' type='quantitative' />
            <column caption='Order Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column-instance column='[L30D Order Comparison (copy)_4668966232225910834]' derivation='User' name='[usr:L30D Order Comparison (copy)_4668966232225910834:nk]' pivot='key' type='nominal' />
            <column-instance column='[L7D Order Comparison (copy)_4668966232225910833]' derivation='User' name='[usr:L7D Order Comparison (copy)_4668966232225910833:nk]' pivot='key' type='nominal' />
            <column-instance column='[MTD Max ADF (copy)_4668966231229992964]' derivation='User' name='[usr:MTD Max ADF (copy)_4668966231229992964:qk]' pivot='key' type='quantitative' />
            <column-instance column='[MTD Min ADF (copy)_4668966231229992965]' derivation='User' name='[usr:MTD Min ADF (copy)_4668966231229992965:qk]' pivot='key' type='quantitative' />
