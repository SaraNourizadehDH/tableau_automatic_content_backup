          <datasource-dependencies datasource='federated.19dbh6e05n6ik313c1n0y0b2n233'>
            <column caption='latest' datatype='boolean' name='[Calculation_2558466854685552646]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] = {FIXED : MAX([order_date])}' />
            </column>
            <column caption='latest - 7' datatype='boolean' name='[Calculation_2558466854712492051]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] = {FIXED : MAX([order_date])} - 7' />
            </column>
            <column caption='Latest - 7 GMV' datatype='real' name='[Calculation_2558466854723977241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_2558466854712492051] = TRUE, [valid_gmv], 0))' />
            </column>
            <column caption='Latest GMV' datatype='real' default-format='c&quot;RM&quot;#,##0,,.00M;(&quot;RM&quot;#,##0,,.00M)' name='[Calculation_2558466854724296730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_2558466854685552646] = TRUE, [valid_gmv], 0))' />
            </column>
            <column caption='GMV WoW (Indicator)' datatype='string' name='[Calculation_2558466854724460571]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;  (&#10;    ([Calculation_2558466854724296730] - [Calculation_2558466854723977241])&#10;    /&#10;    IIF([Calculation_2558466854723977241]= 0, 1, [Calculation_2558466854723977241])&#10;  ) &gt; 0 &#10;THEN &apos;▲ &apos;&#10;ELSE &apos;▼ &apos;&#10;END' />
            </column>
