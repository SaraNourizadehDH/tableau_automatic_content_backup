    <worksheet name='LW CPO'>
      <table>
        <view>
          <datasources>
            <datasource caption='management_factsheet_daily' name='federated.19dbh6e05n6ik313c1n0y0b2n233' />
          </datasources>
          <datasource-dependencies datasource='federated.19dbh6e05n6ik313c1n0y0b2n233'>
            <column caption='One' datatype='integer' default-format='p0.00%' name='[Calculation_2558466854726570014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Last Week' datatype='boolean' name='[Calculation_6285265888773971968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[order_date])=DATETRUNC(&quot;week&quot;,dateadd(&quot;week&quot;,-1,TODAY()-1))' />
            </column>
            <column caption='L2W CPO' datatype='real' name='[L2W Rider CPO (copy)_6285265891043778669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Last Week (copy)_6285265888774799363] = TRUE, [cost_metrics], 0))/&#10;SUM(IIF([Last Week (copy)_6285265888774799363] = TRUE, [total_orders_for_cost], 0))' />
            </column>
            <column caption='LW CPO (Negative)' datatype='string' name='[LW Rider CPO (Negative) (copy)_6285265891043778671]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [LW Rider CPO Base (copy)_6285265891043778672]  &lt; 0&#10;THEN &apos;▼ &apos;&#10;ELSE NULL&#10;END &#10;+ &#10;IF [LW Rider CPO Base (copy)_6285265891043778672]  &lt;= 0 &#10;THEN STR(ROUND(([LW Rider CPO Base (copy)_6285265891043778672] ) * 100 ,2))&#10;+&#10;&quot;%&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='LW CPO' datatype='real' default-format='C1086%' name='[LW Rider CPO (copy)_6285265891043778670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_6285265888773971968] = TRUE, [cost_metrics], 0))/&#10;SUM(IIF([Calculation_6285265888773971968] = TRUE, [total_orders_for_cost], 0))' />
            </column>
            <column caption='LW CPO Base' datatype='real' default-format='p0.0%' name='[LW Rider CPO Base (copy)_6285265891043778672]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='([LW Rider CPO (copy)_6285265891043778670] - [L2W Rider CPO (copy)_6285265891043778669])/IIF([L2W Rider CPO (copy)_6285265891043778669] = 0, 1, [L2W Rider CPO (copy)_6285265891043778669])' />
            </column>
            <column caption='LW CPO WoW (Indicator)' datatype='string' name='[LW Rider CPO WoW (Indicator) (copy)_6285265891043778673]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [LW Rider CPO Base (copy)_6285265891043778672]  &gt; 0 &#10;THEN &apos;▲ &apos;&#10;ELSE &apos;▼ &apos;&#10;END' />
            </column>
            <column caption='LW CPO WoW (Positive)' datatype='string' name='[LW Rider CPO WoW (Positive) (copy)_6285265891043778674]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [LW Rider CPO Base (copy)_6285265891043778672] &gt; 0&#10;THEN &apos;▲ &apos; &#10;ELSE NULL&#10;END &#10;+ &#10;IF [LW Rider CPO Base (copy)_6285265891043778672]  &gt; 0&#10;THEN STR(ROUND([LW Rider CPO Base (copy)_6285265891043778672]  * 100, 2))&#10;+&#10;&quot;%&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Last 2 Week' datatype='boolean' name='[Last Week (copy)_6285265888774799363]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[order_date])=DATETRUNC(&quot;week&quot;,dateadd(&quot;week&quot;,-2,TODAY()-1))' />
            </column>
            <column-instance column='[Calculation_2558466854726570014]' derivation='Avg' name='[avg:Calculation_2558466854726570014:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[cost_metrics]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column caption='Order Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
