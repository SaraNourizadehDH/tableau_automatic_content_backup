    <worksheet name='Yesterday % Incentivized'>
      <table>
        <view>
          <datasources>
            <datasource caption='management_factsheet_daily' name='federated.19dbh6e05n6ik313c1n0y0b2n233' />
          </datasources>
          <datasource-dependencies datasource='federated.19dbh6e05n6ik313c1n0y0b2n233'>
            <column caption='% FP Incentivized Base' datatype='real' name='[ADF Base (copy)_2558466854989451314]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='([Latest ADF (copy)_2558466854989451316] - [Latest -7 ADF (copy)_2558466854989451315])' />
            </column>
            <column caption='% Incentivized WoW (Indicator)' datatype='string' name='[ADF WoW (Indicator)  (copy)_2558466854990422070]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [ADF Base (copy)_2558466854989451314]  &gt; 0 &#10;THEN &apos;▲ &apos;&#10;ELSE &apos;▼ &apos;&#10;END' />
            </column>
            <column caption='% Incentivized WoW (Negative)' datatype='string' name='[ADF WoW (Negative) (copy)_2558466854990680119]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [ADF Base (copy)_2558466854989451314]  &lt; 0&#10;THEN &apos;▼ &apos;&#10;ELSE NULL&#10;END &#10;+ &#10;IF [ADF Base (copy)_2558466854989451314]  &lt;= 0 &#10;THEN STR(ROUND(([ADF Base (copy)_2558466854989451314] ) * 100 ,2))&#10;+&#10;&quot;pp&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='% Incentivized WoW (Positive)' datatype='string' name='[ADF WoW (Positive) (copy)_2558466854989451317]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [ADF Base (copy)_2558466854989451314] &gt; 0&#10;THEN &apos;▲ &apos; &#10;ELSE NULL&#10;END &#10;+ &#10;IF [ADF Base (copy)_2558466854989451314]  &gt; 0&#10;THEN STR(ROUND([ADF Base (copy)_2558466854989451314]  * 100, 2))&#10;+&#10;&quot;pp&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='latest' datatype='boolean' name='[Calculation_2558466854685552646]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] = {FIXED : MAX([order_date])}' />
            </column>
            <column caption='latest - 7' datatype='boolean' name='[Calculation_2558466854712492051]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] = {FIXED : MAX([order_date])} - 7' />
            </column>
            <column caption='One' datatype='integer' default-format='p0.00%' name='[Calculation_2558466854726570014]' role='measure' type='quantitative'>
