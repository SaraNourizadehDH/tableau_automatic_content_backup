              <calculation class='tableau' formula='IF &#10;  (&#10;    ([Calculation_2558466854724296730] - [Calculation_2558466854723977241])&#10;    /&#10;    IIF([Calculation_2558466854723977241] = 0, 1, [Calculation_2558466854723977241])&#10;  ) &lt; 0&#10;THEN &apos;▼ &apos;&#10;ELSE NULL&#10;END &#10;&#10;+ &#10;&#10;IF &#10;  (&#10;    ([Calculation_2558466854724296730] - [Calculation_2558466854723977241])&#10;    /&#10;    IIF([Calculation_2558466854723977241] = 0, 1, [Calculation_2558466854723977241])&#10;  ) &lt;= 0 &#10;THEN&#10;    STR(&#10;      ROUND(&#10;          ( &#10;            ([Calculation_2558466854724296730] - [Calculation_2558466854723977241])&#10;            / &#10;            IIF([Calculation_2558466854723977241] = 0, 1, [Calculation_2558466854723977241])&#10;          ) * 100&#10;          ,2&#10;      )&#10;    )&#10;&#10;    +&#10;&#10;    &quot;%&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='GMV WoW (Positive)' datatype='string' name='[Calculation_2558466854725050397]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;  (&#10;    ([Calculation_2558466854724296730] - [Calculation_2558466854723977241])&#10;    /&#10;    IIF([Calculation_2558466854723977241] = 0, 1, [Calculation_2558466854723977241])&#10;  ) &gt; 0&#10;THEN &apos;▲ &apos; &#10;ELSE NULL&#10;END &#10;&#10;+ &#10;&#10;IF &#10;  (&#10;    ([Calculation_2558466854724296730]  - [Calculation_2558466854723977241])&#10;    /&#10;    IIF([Calculation_2558466854723977241] = 0, 1, [Calculation_2558466854723977241])&#10;  ) &gt; 0&#10;THEN&#10;    STR(&#10;      ROUND(&#10;          ( &#10;            ([Calculation_2558466854724296730] - [Calculation_2558466854723977241])&#10;            / &#10;            IIF([Calculation_2558466854723977241] = 0, 1, [Calculation_2558466854723977241])&#10;          ) * 100&#10;          ,2&#10;      )&#10;    )&#10;&#10;    +&#10;&#10;    &quot;%&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='One' datatype='integer' default-format='p0.00%' name='[Calculation_2558466854726570014]' role='measure' type='quantitative'>
