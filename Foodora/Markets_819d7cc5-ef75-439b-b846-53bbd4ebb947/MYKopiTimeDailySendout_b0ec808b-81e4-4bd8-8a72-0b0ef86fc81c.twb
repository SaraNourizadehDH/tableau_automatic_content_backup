          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='10'>Weekly Orders City Distribution</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='management_factsheet_daily' name='federated.19dbh6e05n6ik313c1n0y0b2n233' />
          </datasources>
          <datasource-dependencies datasource='federated.19dbh6e05n6ik313c1n0y0b2n233'>
            <column caption='Last Week' datatype='boolean' name='[Calculation_6285265888773971968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[order_date])=DATETRUNC(&quot;week&quot;,dateadd(&quot;week&quot;,-1,TODAY()-1))' />
            </column>
            <column caption='Last Week 1' datatype='boolean' name='[Last 2 Week (copy)_6244100193160208384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[order_date])=DATETRUNC(&quot;week&quot;,dateadd(&quot;week&quot;,0,TODAY()-1))' />
            </column>
            <column aggregation='Sum' caption='1' datatype='integer' default-format='p0.00%' name='[Order WoW % (copy)_1395130755969257475]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value=' % WoW' />
              </aliases>
            </column>
            <column caption='Fail Rate WoW %' datatype='real' default-format='p0.00%' name='[Shrink WoW % (copy)_6244100193216663560]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [Last 2 Week (copy)_6244100193160208384] THEN [failed_orders] END)/&#10;SUM(IF [Last 2 Week (copy)_6244100193160208384] THEN [gross_orders] END))&#10;-&#10;(SUM(IF [Calculation_6285265888773971968] THEN [failed_orders] END)/&#10;SUM(IF [Calculation_6285265888773971968] THEN [gross_orders] END))&#10;)' />
            </column>
            <column caption='Fail Rate WoW % str' datatype='string' default-format='p0.00%' name='[Shrink WoW % str (copy)_6244100193216663561]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(ROUND(&#10;(&#10;(SUM(IF [Last 2 Week (copy)_6244100193160208384] THEN [failed_orders] END)/&#10;SUM(IF [Last 2 Week (copy)_6244100193160208384] THEN [gross_orders] END))&#10;-&#10;(SUM(IF [Calculation_6285265888773971968] THEN [failed_orders] END)/&#10;SUM(IF [Calculation_6285265888773971968] THEN [gross_orders] END))&#10;)&#10;*100,1)) + &quot;pp&quot;' />
            </column>
            <column caption='Failed Orders' datatype='integer' name='[failed_orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Gross Orders' datatype='integer' name='[gross_orders]' role='measure' type='quantitative' />
            <column caption='City Name' datatype='string' name='[lg_city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
