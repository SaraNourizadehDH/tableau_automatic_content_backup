      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='10'>City ADF</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='management_factsheet_daily' name='federated.19dbh6e05n6ik313c1n0y0b2n233' />
          </datasources>
          <datasource-dependencies datasource='federated.19dbh6e05n6ik313c1n0y0b2n233'>
            <column caption='ISOWEEK Date' datatype='string' name='[Calculation_2558466854618738688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Wk &quot; + STR(ISOWEEK([order_date]))' />
            </column>
            <column caption='ADF' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4668966232206495775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_local2])/SUM([df_orders])' />
            </column>
            <column caption='Latest Sunday' datatype='boolean' name='[Not Latest Week (copy)_1395130755962540032]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] &lt;= (DATETRUNC(&apos;week&apos;, TODAY(), &apos;Sunday&apos;))' />
            </column>
            <column-instance column='[order_date]' derivation='Attribute' name='[attr:order_date:ok]' pivot='key' type='ordinal' />
            <column datatype='real' name='[delivery_fee_local2]' role='measure' type='quantitative' />
            <column datatype='integer' name='[df_orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[order_date]' derivation='ISO-Year' name='[iyr:order_date:ok]' pivot='key' type='ordinal' />
            <column caption='City Name' datatype='string' name='[lg_city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column-instance column='[Calculation_2558466854618738688]' derivation='None' name='[none:Calculation_2558466854618738688:nk]' pivot='key' type='nominal' />
            <column-instance column='[Not Latest Week (copy)_1395130755962540032]' derivation='None' name='[none:Not Latest Week (copy)_1395130755962540032:nk]' pivot='key' type='nominal' />
            <column-instance column='[lg_city_name]' derivation='None' name='[none:lg_city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
