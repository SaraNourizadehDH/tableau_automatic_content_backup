            <column caption='Latest -7 Seamless %' datatype='real' name='[Latest -7 Orders (copy)_2558466854996074578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_2558466854712492051] = TRUE, [total_seamless_orders], 0))/SUM(IIF([Calculation_2558466854712492051] = TRUE, [total_rider_od_orders], 0))' />
