    <worksheet name='LW AFV'>
      <table>
        <view>
          <datasources>
            <datasource caption='management_factsheet_daily' name='federated.19dbh6e05n6ik313c1n0y0b2n233' />
          </datasources>
          <datasource-dependencies datasource='federated.19dbh6e05n6ik313c1n0y0b2n233'>
            <column caption='LW AFV WoW (Indicator)' datatype='string' name='[AFV WoW (Indicator) (copy)_6285265888784592913]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;  (&#10;    ([Latest AFV (copy)_6285265888784408591] - [Latest -7 AFV (copy)_6285265888784486416])&#10;    /&#10;    IIF([Latest -7 AFV (copy)_6285265888784486416] = 0, 1, [Latest -7 AFV (copy)_6285265888784486416])&#10;  ) &gt; 0 &#10;THEN &apos;▲ &apos;&#10;ELSE &apos;▼ &apos;&#10;END' />
            </column>
            <column caption='LW AFV WoW (Negative)' datatype='string' name='[AFV WoW (Negative) (copy)_6285265888784592914]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;  (&#10;    ([Latest AFV (copy)_6285265888784408591] - [Latest -7 AFV (copy)_6285265888784486416])&#10;    /&#10;    IIF([Latest -7 AFV (copy)_6285265888784486416] = 0, 1, [Latest -7 AFV (copy)_6285265888784486416])&#10;  ) &lt; 0&#10;THEN &apos;▼ &apos;&#10;ELSE NULL&#10;END &#10;&#10;+ &#10;&#10;IF &#10;  (&#10;    ([Latest AFV (copy)_6285265888784408591] - [Latest -7 AFV (copy)_6285265888784486416])&#10;    /&#10;    IIF([Latest -7 AFV (copy)_6285265888784486416] = 0, 1, [Latest -7 AFV (copy)_6285265888784486416])&#10;  ) &lt;= 0 &#10;THEN&#10;    STR(&#10;      ROUND(&#10;          ( &#10;            ([Latest AFV (copy)_6285265888784408591] - [Latest -7 AFV (copy)_6285265888784486416])&#10;            / &#10;            IIF([Latest -7 AFV (copy)_6285265888784486416] = 0, 1, [Latest -7 AFV (copy)_6285265888784486416])&#10;          ) * 100&#10;          ,2&#10;      )&#10;    )&#10;&#10;    +&#10;&#10;    &quot;%&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='LW AFV WoW (Positive)' datatype='string' name='[AFV WoW (Positive) (copy)_6285265888784592915]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;  (&#10;    ([Latest AFV (copy)_6285265888784408591] - [Latest -7 AFV (copy)_6285265888784486416])&#10;    /&#10;    IIF([Latest -7 AFV (copy)_6285265888784486416] = 0, 1, [Latest -7 AFV (copy)_6285265888784486416])&#10;  ) &gt; 0&#10;THEN &apos;▲ &apos; &#10;ELSE NULL&#10;END &#10;&#10;+ &#10;&#10;IF &#10;  (&#10;    ([Latest AFV (copy)_6285265888784408591] - [Latest -7 AFV (copy)_6285265888784486416])&#10;    /&#10;    IIF([Latest -7 AFV (copy)_6285265888784486416] = 0, 1, [Latest -7 AFV (copy)_6285265888784486416])&#10;  ) &gt; 0&#10;THEN&#10;    STR(&#10;      ROUND(&#10;          ( &#10;            ([Latest AFV (copy)_6285265888784408591] - [Latest -7 AFV (copy)_6285265888784486416])&#10;            / &#10;            IIF([Latest -7 AFV (copy)_6285265888784486416] = 0, 1, [Latest -7 AFV (copy)_6285265888784486416])&#10;          ) * 100&#10;          ,2&#10;      )&#10;    )&#10;&#10;    +&#10;&#10;    &quot;%&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='One' datatype='integer' default-format='p0.00%' name='[Calculation_2558466854726570014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Last Week' datatype='boolean' name='[Calculation_6285265888773971968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[order_date])=DATETRUNC(&quot;week&quot;,dateadd(&quot;week&quot;,-1,TODAY()-1))' />
            </column>
            <column caption='Last 2 Week' datatype='boolean' name='[Last Week (copy)_6285265888774799363]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[order_date])=DATETRUNC(&quot;week&quot;,dateadd(&quot;week&quot;,-2,TODAY()-1))' />
            </column>
            <column caption='L2W AFV' datatype='real' name='[Latest -7 AFV (copy)_6285265888784486416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Last Week (copy)_6285265888774799363] = TRUE, [valid_gfv], 0))/SUM(IIF([Last Week (copy)_6285265888774799363] = TRUE, [valid_orders], 0))' />
            </column>
            <column caption='LW AFV' datatype='real' default-format='c&quot;RM&quot;#,##0.00;(&quot;RM&quot;#,##0.00)' name='[Latest AFV (copy)_6285265888784408591]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_6285265888773971968] = TRUE, [valid_gfv], 0))/&#10;SUM(IIF([Calculation_6285265888773971968] = TRUE, [valid_orders], 0))' />
            </column>
            <column-instance column='[Calculation_2558466854726570014]' derivation='Avg' name='[avg:Calculation_2558466854726570014:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
