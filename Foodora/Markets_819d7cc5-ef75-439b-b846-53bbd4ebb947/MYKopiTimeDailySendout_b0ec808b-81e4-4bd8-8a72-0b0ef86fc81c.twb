            <column-instance column='[Orders WoW (Negative) (copy)_2558466854976983076]' derivation='User' name='[usr:Orders WoW (Negative) (copy)_2558466854976983076:nk]' pivot='key' type='nominal' />
            <column-instance column='[Orders WoW (Positive) (copy)_2558466854977261605]' derivation='User' name='[usr:Orders WoW (Positive) (copy)_2558466854977261605:nk]' pivot='key' type='nominal' />
