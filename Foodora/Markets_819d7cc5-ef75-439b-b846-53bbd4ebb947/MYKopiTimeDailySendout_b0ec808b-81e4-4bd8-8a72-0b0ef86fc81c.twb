      <datasource-dependencies datasource='federated.19dbh6e05n6ik313c1n0y0b2n233' />
      <filter class='categorical' column='[federated.19dbh6e05n6ik313c1n0y0b2n233].[User Filter 1]' context='true' />
    </shared-view>
  </shared-views>
