    <worksheet name='Yesterday Incident Rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='management_factsheet_daily' name='federated.19dbh6e05n6ik313c1n0y0b2n233' />
          </datasources>
          <datasource-dependencies datasource='federated.19dbh6e05n6ik313c1n0y0b2n233'>
            <column caption='latest' datatype='boolean' name='[Calculation_2558466854685552646]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] = {FIXED : MAX([order_date])}' />
            </column>
            <column caption='latest - 7' datatype='boolean' name='[Calculation_2558466854712492051]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[order_date] = {FIXED : MAX([order_date])} - 7' />
            </column>
            <column caption='One' datatype='integer' default-format='p0.00%' name='[Calculation_2558466854726570014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Latest -7 Incident Rate' datatype='real' default-format='p0.00%' name='[Latest -7 UTR (copy)_1683924112066879496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_2558466854712492051] = TRUE, [total_tickets], 0))/SUM(IIF([Calculation_2558466854712492051] = TRUE, [gross_orders], 0))' />
            </column>
            <column caption='Latest Incident Rate' datatype='real' default-format='p0.00%' name='[Latest UTR (copy)_1683924112066879497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_2558466854685552646] = TRUE, [total_tickets], 0))/SUM(IIF([Calculation_2558466854685552646] = TRUE, [gross_orders], 0))' />
            </column>
            <column caption='Incident Rate Base' datatype='real' name='[UTR Base (copy)_1683924112066879488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Latest UTR (copy)_1683924112066879497]-[Latest -7 UTR (copy)_1683924112066879496])' />
            </column>
            <column caption='Incident Rate WoW (Indicator)' datatype='string' name='[UTR WoW (Indicator)  (copy)_1683924112066879489]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [UTR Base (copy)_1683924112066879488] &gt; 0 &#10;THEN &apos;▲ &apos;&#10;ELSE &apos;▼ &apos;&#10;END' />
            </column>
            <column caption='Incident Rate WoW (Negative)' datatype='string' name='[UTR WoW (Negative) (copy)_1683924112066879490]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [UTR Base (copy)_1683924112066879488] &lt; 0&#10;THEN &apos;▼ &apos;&#10;ELSE NULL&#10;END &#10;+ &#10;IF [UTR Base (copy)_1683924112066879488] &lt;= 0 &#10;THEN STR(ROUND([UTR Base (copy)_1683924112066879488]*100,2))&#10;+&#10;&quot;pp&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Incident Rate WoW (Positive)' datatype='string' name='[UTR WoW (Positive) (copy)_1683924112066879491]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [UTR Base (copy)_1683924112066879488] &gt; 0&#10;THEN &apos;▲ &apos; &#10;ELSE NULL&#10;END &#10;+ &#10;IF [UTR Base (copy)_1683924112066879488] &gt; 0&#10;THEN STR(ROUND([UTR Base (copy)_1683924112066879488]*100, 2))&#10;+&#10;&quot;pp&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column-instance column='[Calculation_2558466854726570014]' derivation='Avg' name='[avg:Calculation_2558466854726570014:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
