            </column>
            <column caption='Seamless % Base' datatype='real' name='[Orders Base (copy)_2558466854996074582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Latest Orders (copy)_2558466854996074577] - [Latest -7 Orders (copy)_2558466854996074578])' />
