      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Malaysia&quot;' />
      </semantic-values>
      <date-options start-of-week='monday' />
      <datasource-dependencies datasource='Parameters'>
        <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
          <calculation class='tableau' formula='&quot;Daily&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_8F5AD0FA29B0464A8528446C428272D4'>
            <properties context=''>
              <relation connection='bigquery.10sm2ny1nifpnq12iiq67008aihv' name='Custom SQL Query' type='text'><![CDATA[WITH

dates AS (
  SELECT
    shared_dates.date AS order_date,
    zones.lg_city_id,
    zones.lg_zone_id,
    zones.lg_city_name,
    zones.lg_zone_name

  FROM `fulfillment-dwh-production.pandata_curated.shared_dates` AS shared_dates
  CROSS JOIN `fulfillment-dwh-production.pandata_report.country_MY_lg_zones` AS zones
  WHERE shared_dates.date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH), MONTH) AND CURRENT_DATE() - 1
    AND NOT LOWER(zones.lg_city_name) LIKE "%test%"
    AND NOT LOWER(zones.lg_zone_name) LIKE "%test%"
    AND zones.is_active_city
    AND zones.is_active_zone
),

zone_performance AS (
  SELECT
    report_date AS order_date,
    lg_city_name,
    lg_zone_name,

    -- sessions
    SUM(sessions) AS sessions,
    SUM(users) AS users,
    SUM(transactions) AS transactions,
    SUM(mcvr1_start) AS home_page_sessions,
    SUM(mcvr1_end) AS home_to_listing_sessions,
    SUM(mcvr2_start) AS listing_page_sessions,
    SUM(mcvr2_end) AS listing_to_menu_sessions,
    SUM(mcvr3_start) AS menu_page_sessions,
    SUM(mcvr3_end) AS menu_to_checkout_sessions,
    SUM(mcvr4_start) AS checkout_page_sessions,
    SUM(mcvr4_end) AS checkout_to_transaction_sessions,

    -- staffing
    SUM(total_working_hours) AS working_time_in_hours,
    SUM(total_actual_working_hours) AS actual_working_time_in_hours,
    SUM(total_break_hours) AS actual_break_time_in_hours,
    SUM(shift_riders_count) AS shift_riders_count,

    -- deliveries
    SUM(total_completed_deliveries) AS deliveries_count,
    SUM(total_delivery_time_in_minutes) AS actual_delivery_time_in_minutes,
    SUM(total_delivery_time_orders) AS actual_delivery_time_orders,
    SUM(total_seamless_orders) AS total_seamless_orders,
    SUM(total_seamless_orders_d) AS total_rider_od_orders,
    SUM(total_orders_on_time) AS total_order_on_time,
    SUM(total_15_dt_early_orders) AS total_15_dt_early_orders,
    SUM(total_5_dt_late_orders) AS total_5_dt_late_orders,
    SUM(total_order_delays) AS total_order_delays,
    SUM(surged_orders) AS surged_orders,
    SUM(actual_orders) AS actual_orders,
    SUM(shrink_orders) AS shrink_orders,
    SUM(forecasted_orders) AS forecasted_orders,

    -- orders
    SUM(total_gross_orders) AS gross_orders,
    SUM(total_valid_orders) AS valid_orders,
    SUM(total_failed_orders) AS failed_orders,
    SUM(total_logistics_failed_orders) AS logistics_failed_orders,
    SUM(total_customer_failed_orders) AS customers_failed_orders,
    SUM(total_vendor_failed_orders) AS vendor_failed_orders,
    SUM(total_gmv_local) AS valid_gmv,
    SUM(total_gfv_local) AS valid_gfv,
    SUM(total_delivery_fee_local) AS delivery_fee_local,

    -- vendor_offline
    SUM(total_closed_hours) AS total_closed_hours,
    SUM(total_open_hours) AS total_open_hours,
    SUM(total_available_hours) AS total_available_hours

  FROM `fulfillment-dwh-production.pandata_report.country_MY_lg_zone_performance`
  WHERE report_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH)
  GROUP BY 1,2,3
),

orders AS (
  SELECT
    pd_orders.order_date,
    lg_city_name,
    lg_zone_name,
    COUNT(DISTINCT(IF(valid_order = 1, pd_customer_uuid, NULL))) AS order_generating_customers,

    SUM(IF(pd_orders.valid_order = 1, pd_orders.foodpanda_subsidized_voucher_value_local, 0)) + SUM(IF(pd_orders.valid_order = 1, pd_orders.foodpanda_subsidized_discount_value_local, 0)) AS fp_incentivized_value_local,
    COUNT(DISTINCT(IF(pd_orders.valid_order = 1 AND pd_orders.is_voucher_used AND pd_orders.foodpanda_subsidized_voucher_value_local >> 0, pd_orders.uuid, NULL))) + COUNT(DISTINCT(IF(pd_orders.valid_order = 1 AND pd_orders.is_discount_used AND pd_orders.foodpanda_subsidized_discount_value_local >> 0, pd_orders.uuid, NULL))) AS fp_incentivized_orders,

    SUM(IF(pd_orders.valid_order = 1, pd_orders.voucher_value_local, 0)) + SUM(IF(pd_orders.valid_order = 1, pd_orders.discount_value_local, 0)) AS incentivized_value_local,
    COUNT(DISTINCT(IF(pd_orders.valid_order = 1 AND pd_orders.is_voucher_used, pd_orders.uuid, NULL))) + COUNT(DISTINCT(IF(pd_orders.valid_order = 1 AND pd_orders.is_discount_used, pd_orders.uuid, NULL))) AS incentivized_orders,
    COUNT(DISTINCT(IF(new_customer_for_platform = 1, pd_customer_uuid, NULL))) AS new_customer_to_platform_2

  FROM `fulfillment-dwh-production.pandata_report.country_MY_pd_orders` AS pd_orders
  WHERE pd_orders.global_entity_id = "FP_MY"
    AND pd_orders.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH)
  GROUP BY 1,2,3
),

yest_vendors AS (
  SELECT
    order_date,
    lg_city_name,
    lg_zone_name,
    COUNT(DISTINCT(vendor_code)) AS yest_order_generating_vendors
  FROM `fulfillment-dwh-production.pandata_report.country_MY_pd_orders` AS pd_orders
  WHERE global_entity_id = "FP_MY"
    AND pd_orders.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH)
    AND valid_order = 1
    AND gross_order = 1
  GROUP BY 1,2,3
),

vendor_orders AS (
  SELECT
    order_date,
    lg_city_name,
    lg_zone_name,
    vendor_code,
    pd_customer_uuid,
    COUNT(DISTINCT(IF(valid_order = 1, uuid, NULL))) AS orders
  FROM `fulfillment-dwh-production.pandata_report.country_MY_pd_orders` AS pd_orders
  WHERE global_entity_id = "FP_MY"
    AND pd_orders.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY), DAY)
  GROUP BY 1,2,3,4,5
),

active_vendor AS (
  SELECT
    report_date,
    lg_city_name,
    lg_zone_name,
    COUNT(DISTINCT(inventory.pd_vendor_uuid)) AS active_vendors,
    COUNT(DISTINCT(IF(orders >>=1, inventory.pd_vendor_uuid, NULL))) AS order_generating_vendors,
  FROM `fulfillment-dwh-production.pandata_report.pandora_vendor_status` AS inventory
  LEFT JOIN vendor_orders 
         ON vendor_orders.vendor_code = inventory.vendor_code
  WHERE inventory.global_entity_id = "FP_MY"
    AND inventory.is_active
    AND NOT inventory.is_private
    AND NOT inventory.is_test
    AND inventory.report_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH)
  GROUP BY 1,2,3
),

incident AS (
  SELECT
    DATE(DATETIME(sf.creation_timestamp, "Asia/Kuala_Lumpur")) AS date,
    vendors.lg_city_name,
    vendors.lg_zone_name,
    COUNT(sf.contact_id) AS total_tickets,
  
  FROM `fulfillment-dwh-production.curated_data_shared.all_contacts` sf
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_MY_pd_vendors` AS vendors
         ON vendors.vendor_code = sf.vendor_id
  WHERE sf.global_entity_id = "FP_MY"
    AND sf.created_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH) AND CURRENT_DATE()
    AND LOWER(sf.stakeholder) LIKE '%customer%'
  GROUP BY 1,2,3
),

genuine_csat AS ( 
  SELECT
    DATE(DATETIME(sf.creation_timestamp, "Asia/Kuala_Lumpur")) AS date,
    vendors.lg_city_name,
    vendors.lg_zone_name,
    COUNT(DISTINCT(IF(sf.csat_score IN (4,5), sf.contact_id, NULL))) AS promoter_responses,
    COUNT(DISTINCT(IF(sf.csat_score IS NOT NULL, sf.contact_id, NULL))) AS total_responses

  FROM `fulfillment-dwh-production.curated_data_shared.all_contacts` sf
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_cx_contact_fraud_flag` AS flag
         ON flag.gcc_contact_id = sf.contact_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_MY_pd_vendors` AS vendors
         ON vendors.vendor_code = sf.vendor_id
  WHERE sf.global_entity_id = "FP_MY"
    AND sf.created_date BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH) AND CURRENT_DATE()
    AND LOWER(sf.stakeholder) LIKE '%customer%'
    AND (flag.is_fraud IS NULL OR flag.is_fraud = "green")
  GROUP BY 1,2,3
),

rider_cost AS (
    SELECT
      created_date_local AS report_date,
      city_name AS lg_city_name,
      zone_name AS lg_zone_name,
      SUM(
        -- basic_payment_local
        basic_minimum_guaranteed_local
        + basic_order_component_local
        + basic_hour_component_local
        + basic_distance_component_local
        + basic_fallback_local

        + scoring_payment_local
        + quest_payment_local
        + boost_payment_local
      ) AS total_cost,
      
      COUNT(DISTINCT CASE WHEN lg_order_status = "completed" THEN order_code END) AS total_orders_cost,
      --SUM(basic_payment_local) + SUM(scoring_payment_local) + SUM(quest_payment_local) + SUM(boost_payment_local) AS total_cost

    FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_delivery_level_rider_costs`
    WHERE LOWER(lg_country_code) = "my"
      AND created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH)
    GROUP BY 1,2,3
),

registered_customers AS (
WITH
  customer_based AS (
    SELECT
      customers.uuid AS customer_uuid,
      customers.code AS customer_code,
      orders.lg_city_name,
      orders.lg_zone_name,
      DATE(TIMESTAMP(customers.created_at_utc), "Asia/Kuala_Lumpur") AS registered_date

    FROM `fulfillment-dwh-production.pandata_report.country_MY_pd_orders` AS orders
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.cus_customers` AS customers
           ON orders.pd_customer_uuid = customers.uuid
    WHERE customers.global_entity_id = "FP_MY"
      AND NOT customers.is_deleted
      AND NOT customers.is_guest
      AND orders.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH)
  )

  SELECT
    registered_date,
    lg_city_name,
    lg_zone_name,
    COUNT(DISTINCT customer_uuid) AS registered_customers
  FROM customer_based
  GROUP BY 1,2,3
),

preferential_df AS (
  SELECT
    my_orders.global_entity_id,
    my_orders.order_code,
    3 AS amount_charge_to_campaign_participating_vendor
  FROM `fulfillment-dwh-production.pandata_report.country_MY_pd_orders` AS my_orders
  INNER JOIN `fulfillment-dwh-production.pandata_report.country_MY_dps_orders` AS my_dps
          ON my_orders.order_code = my_dps.platform_order_code
  WHERE my_orders.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH) - 1
    AND my_orders.order_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH)
    AND my_orders.billable_order = 1
    AND my_dps.created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH)
    AND my_dps.is_bvd_cofund_order = 1
),

backup AS (
  SELECT
    pd_orders.ordered_at_date_local AS order_date,
    orders.lg_city_name,
    orders.lg_zone_name,
    SUM(acc.gfv_local) AS valid_gfv2,
    SUM(acc.gmv_local) AS valid_gmv2,
    COUNT(DISTINCT pd_orders.code) AS df_orders,
    SUM(COALESCE(pd_orders.delivery_fee_local,0) + COALESCE(preferential_df.amount_charge_to_campaign_participating_vendor,0)) AS delivery_fee_local2

  FROM `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` AS acc
        ON acc.order_uid = CONCAT(pd_orders.global_entity_id, "_", pd_orders.code)
        AND acc.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH)
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_MY_pd_orders` AS orders
        ON CONCAT(pd_orders.global_entity_id, "_", pd_orders.code) = CONCAT(orders.global_entity_id, "_", orders.order_code)
      AND orders.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH)
  LEFT JOIN preferential_df
         ON pd_orders.global_entity_id = preferential_df.global_entity_id
        AND pd_orders.code = preferential_df.order_code
  WHERE pd_orders.global_entity_id = "FP_MY"
    AND pd_orders.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH)
    AND pd_orders.is_gross_order
    AND pd_orders.is_valid_order
  GROUP BY 1,2,3
),

reactivated_customers AS (
    WITH

    base AS (
      SELECT
        pd_orders.global_entity_id,
        pd_orders.order_date,
        pd_orders.pd_customer_uuid,
        pd_orders.new_customer_for_platform,
        pd_orders.new_customer_for_chain,
        pd_orders.new_customer_for_vendor,
        pd_orders.lg_city_name,
        pd_orders.lg_zone_name,
        pd_orders.order_code,
        pd_orders.chain_code,
        pd_orders.chain_name,
        pd_orders.vendor_code,
        pd_orders.vendor_name,
        pd_orders.ordered_at_local,
        LAG(pd_orders.ordered_at_local) OVER (PARTITION BY pd_orders.global_entity_id, pd_orders.pd_customer_uuid
          ORDER BY pd_orders.ordered_at_local ASC) AS prev_order_datetime,
          LAG(pd_orders.created_date_local) OVER (PARTITION BY pd_orders.global_entity_id, pd_orders.pd_customer_uuid
          ORDER BY pd_orders.ordered_at_local ASC) AS prev_order_date,
          LAG(pd_orders.order_code) OVER (PARTITION BY pd_orders.global_entity_id, pd_orders.pd_customer_uuid
          ORDER BY pd_orders.ordered_at_local ASC) AS prev_order_code
      FROM `fulfillment-dwh-production.pandata_report.country_MY_pd_orders` AS pd_orders
      WHERE pd_orders.global_entity_id = "FP_MY"
        AND pd_orders.created_date_utc << CURRENT_DATE()-->>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 12 MONTH)
        AND pd_orders.valid_order = 1
    ),

    final AS (
      SELECT
        base.order_date,
        base.pd_customer_uuid,
        base.order_code,
        base.chain_code,
        base.chain_name,
        base.vendor_code,
        base.vendor_name,
        base.lg_city_name,
        base.lg_zone_name,
        base.new_customer_for_chain,
        base.new_customer_for_vendor,
        base.ordered_at_local,
        CASE
          WHEN base.new_customer_for_platform = 1 THEN "New Customer"
          WHEN base.new_customer_for_vendor = 1 THEN "New Customer for Vendor"
          WHEN DATE_DIFF(order_date, prev_order_date, DAY) BETWEEN 31 AND 65 THEN "Reactivated Churn (31-65)"
          WHEN DATE_DIFF(order_date, prev_order_date, DAY) BETWEEN 66 AND 147 THEN "Reactivated Churn (66-147)"
          WHEN DATE_DIFF(order_date, prev_order_date, DAY) BETWEEN 148 AND 364 THEN "Reactivated Inactive (148-364)"
          WHEN DATE_DIFF(order_date, prev_order_date, DAY) >>= 365 THEN "Reactivated Reacquisition (>>=365)"
          ELSE "Retained Existing Customer"
        END AS cus_segment
      FROM base
    )

    SELECT
      final.order_date,
      lg_city_name,
      lg_zone_name,
      COUNT(DISTINCT(IF(cus_segment = "New Customer", pd_customer_uuid, NULL))) AS new_customers2,
      COUNT(DISTINCT(IF(cus_segment = "Reactivated Churn (31-65)", pd_customer_uuid, NULL))) AS reactivated_customers,
      COUNT(DISTINCT(IF(cus_segment = "Reactivated Churn (66-147)", pd_customer_uuid, NULL))) AS reactivated_customers_66147,
      COUNT(DISTINCT(IF(cus_segment = "Retained Existing Customer", pd_customer_uuid, NULL))) AS reatained_customers

    FROM final
    GROUP BY 1,2,3
),

flgp AS (
  SELECT  
    flgp.order_date,
    lg_city_name,
    lg_zone_name,
    SUM(flgp.gmv_net_local) AS flgp_gmv_net_local,
    SUM(flgp_fp_funded_incentives_local) AS flgp_fp_incentives,

  FROM `fulfillment-dwh-production.pandata_report.country_MY_flgp_vendor_daily` AS flgp
  GROUP BY 1,2,3
)

SELECT
  "FP_MY" AS global_entity_id,
  dates.order_date,
  dates.lg_city_name,
  dates.lg_zone_name,
  zone_performance.* EXCEPT(order_date, lg_city_name, lg_zone_name),
  orders.* EXCEPT(order_date, lg_city_name, lg_zone_name),
  active_vendor.* EXCEPT(report_date, lg_city_name, lg_zone_name),
  yest_vendors.yest_order_generating_vendors,
  incident.* EXCEPT(date, lg_city_name, lg_zone_name),
  genuine_csat.* EXCEPT(date, lg_city_name, lg_zone_name),
  rider_cost.* EXCEPT(report_date, lg_city_name, lg_zone_name),
  registered_customers.* EXCEPT(registered_date, lg_city_name, lg_zone_name),
  backup.* EXCEPT(order_date, lg_city_name, lg_zone_name),
  reactivated_customers.* EXCEPT(order_date, lg_city_name, lg_zone_name),
  flgp.* EXCEPT(order_date, lg_city_name, lg_zone_name)

FROM dates
LEFT JOIN zone_performance
       ON dates.order_date = zone_performance.order_date
      AND dates.lg_city_name = zone_performance.lg_city_name
      AND dates.lg_zone_name = zone_performance.lg_zone_name
LEFT JOIN orders
       ON orders.order_date = dates.order_date
      AND orders.lg_city_name = dates.lg_city_name
      AND orders.lg_zone_name = dates.lg_zone_name
LEFT JOIN active_vendor
       ON active_vendor.report_date = dates.order_date
      AND active_vendor.lg_city_name = dates.lg_city_name
      AND active_vendor.lg_zone_name = dates.lg_zone_name
LEFT JOIN yest_vendors
       ON yest_vendors.order_date = dates.order_date
      AND yest_vendors.lg_city_name = dates.lg_city_name
      AND yest_vendors.lg_zone_name = dates.lg_zone_name
LEFT JOIN incident
       ON incident.date = dates.order_date
      AND incident.lg_city_name = dates.lg_city_name
      AND incident.lg_zone_name = dates.lg_zone_name
LEFT JOIN genuine_csat
       ON genuine_csat.date = dates.order_date
      AND genuine_csat.lg_city_name = dates.lg_city_name
      AND genuine_csat.lg_zone_name = dates.lg_zone_name
LEFT JOIN rider_cost
       ON rider_cost.report_date = dates.order_date
      AND rider_cost.lg_city_name = dates.lg_city_name
      AND rider_cost.lg_zone_name = dates.lg_zone_name
LEFT JOIN registered_customers
       ON registered_customers.registered_date = dates.order_date
      AND registered_customers.lg_city_name = dates.lg_city_name
      AND registered_customers.lg_zone_name = dates.lg_zone_name
LEFT JOIN backup
       ON backup.order_date = dates.order_date
      AND backup.lg_city_name = dates.lg_city_name
      AND backup.lg_zone_name = dates.lg_zone_name
LEFT JOIN reactivated_customers
       ON reactivated_customers.order_date = dates.order_date
      AND reactivated_customers.lg_city_name = dates.lg_city_name
      AND reactivated_customers.lg_zone_name = dates.lg_zone_name
LEFT JOIN flgp
       ON flgp.order_date = dates.order_date
      AND flgp.lg_city_name = dates.lg_city_name
      AND flgp.lg_zone_name = dates.lg_zone_name]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <shared-views>
    <shared-view name='federated.0bl9gz31e7rup515x601e1gm5tsf'>
      <datasources>
        <datasource caption='management_factsheet_vendors' name='federated.0bl9gz31e7rup515x601e1gm5tsf' />
      </datasources>
      <datasource-dependencies datasource='federated.0bl9gz31e7rup515x601e1gm5tsf' />
      <filter class='categorical' column='[federated.0bl9gz31e7rup515x601e1gm5tsf].[User Filter 1]' context='true' />
    </shared-view>
    <shared-view name='federated.19dbh6e05n6ik313c1n0y0b2n233'>
      <datasources>
        <datasource caption='management_factsheet_daily' name='federated.19dbh6e05n6ik313c1n0y0b2n233' />
