            </column>
            <column caption='L2W Seamless %' datatype='real' name='[Latest -7 Seamless % (copy)_3241958443647348747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Last Week (copy)_6285265888774799363]  = TRUE, [total_seamless_orders], 0))/SUM(IIF([Last Week (copy)_6285265888774799363] = TRUE, [total_rider_od_orders], 0))' />
