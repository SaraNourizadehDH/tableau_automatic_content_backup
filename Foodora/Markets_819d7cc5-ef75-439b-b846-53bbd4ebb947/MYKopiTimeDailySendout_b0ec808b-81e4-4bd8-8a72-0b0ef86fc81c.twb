          <datasource-dependencies datasource='federated.19dbh6e05n6ik313c1n0y0b2n233'>
            <column caption='% Seamless (copy)' datatype='real' default-format='p0.0%' name='[% Seamless (copy)_1395130756000460817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_seamless_orders])/SUM([total_rider_od_orders])' />
            </column>
            <column caption='ISOWEEK Date' datatype='string' name='[Calculation_2558466854618738688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Wk &quot; + STR(ISOWEEK([order_date]))' />
            </column>
            <column caption='% Seamless' datatype='real' default-format='p0.0%' name='[Calculation_4668966232209375266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((SUM([total_seamless_orders])/SUM([total_rider_od_orders])),3)' />
            </column>
            <column caption='Latest Sunday' datatype='boolean' name='[Not Latest Week (copy)_1395130755962540032]' role='dimension' type='nominal'>
