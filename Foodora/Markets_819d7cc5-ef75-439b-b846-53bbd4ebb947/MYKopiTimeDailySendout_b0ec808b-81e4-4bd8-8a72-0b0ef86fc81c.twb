            <connection CATALOG='foodpanda-my-bigquery' EXECCATALOG='foodpanda-my-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='APAC Country - MY' schema='sandbox' server-oauth='' username='marquee.enriquez@foodpanda.ph' workgroup-auth-mode='prompt' />
