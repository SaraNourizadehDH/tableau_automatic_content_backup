            </column>
            <column caption='Sessions WoW (Positive)' datatype='string' name='[Orders WoW (Positive) (copy)_2558466854978392106]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;  (&#10;    ([Latest Orders (copy)_2558466854977978407] - [Latest -7 Orders (copy)_2558466854977896486])&#10;    /&#10;    IIF([Latest -7 Orders (copy)_2558466854977896486] = 0, 1, [Latest -7 Orders (copy)_2558466854977896486])&#10;  ) &gt; 0&#10;THEN &apos;▲ &apos; &#10;ELSE NULL&#10;END &#10;&#10;+ &#10;&#10;IF &#10;  (&#10;    ([Latest Orders (copy)_2558466854977978407] - [Latest -7 Orders (copy)_2558466854977896486])&#10;    /&#10;    IIF([Latest -7 Orders (copy)_2558466854977896486] = 0, 1, [Latest -7 Orders (copy)_2558466854977896486])&#10;  ) &gt; 0&#10;THEN&#10;    STR(&#10;      ROUND(&#10;          ( &#10;            ([Latest Orders (copy)_2558466854977978407] - [Latest -7 Orders (copy)_2558466854977896486])&#10;            / &#10;            IIF([Latest -7 Orders (copy)_2558466854977896486] = 0, 1, [Latest -7 Orders (copy)_2558466854977896486])&#10;          ) * 100&#10;          ,2&#10;      )&#10;    )&#10;&#10;    +&#10;&#10;    &quot;%&quot;&#10;ELSE NULL&#10;END' />
