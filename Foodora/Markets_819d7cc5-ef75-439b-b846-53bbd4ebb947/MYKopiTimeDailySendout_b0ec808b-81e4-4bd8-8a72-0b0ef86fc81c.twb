    <worksheet name='LW Orders'>
      <table>
        <view>
          <datasources>
            <datasource caption='management_factsheet_daily' name='federated.19dbh6e05n6ik313c1n0y0b2n233' />
          </datasources>
          <datasource-dependencies datasource='federated.19dbh6e05n6ik313c1n0y0b2n233'>
            <column caption='One' datatype='integer' default-format='p0.00%' name='[Calculation_2558466854726570014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Last Week' datatype='boolean' name='[Calculation_6285265888773971968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[order_date])=DATETRUNC(&quot;week&quot;,dateadd(&quot;week&quot;,-1,TODAY()-1))' />
            </column>
            <column caption='L2W Orders' datatype='integer' name='[LW Orders (copy)_6285265888774721538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Last Week (copy)_6285265888774799363] = TRUE, [valid_orders], 0))' />
            </column>
            <column caption='Last 2 Week' datatype='boolean' name='[Last Week (copy)_6285265888774799363]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[order_date])=DATETRUNC(&quot;week&quot;,dateadd(&quot;week&quot;,-2,TODAY()-1))' />
            </column>
            <column caption='LW Orders' datatype='integer' name='[Latest Orders (copy)_6285265888774254593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_6285265888773971968] = TRUE, [valid_orders], 0))' />
            </column>
            <column caption='LW Orders Base' datatype='real' name='[Orders Base (copy)_6285265888775180292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Latest Orders (copy)_6285265888774254593] - [LW Orders (copy)_6285265888774721538])&#10;/&#10;IIF([LW Orders (copy)_6285265888774721538] = 0, 1, [LW Orders (copy)_6285265888774721538])' />
            </column>
            <column caption='LW Orders WoW (Indicator)' datatype='string' name='[Orders WoW (Indicator) (copy)_6285265888775811077]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Orders Base (copy)_6285265888775180292] &gt; 0 &#10;THEN &apos;▲ &apos;&#10;ELSE &apos;▼ &apos;&#10;END' />
            </column>
            <column caption='LW Orders WoW (Negative)' datatype='string' name='[Orders WoW (Negative) (copy)_6285265888775811078]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Orders Base (copy)_6285265888775180292] &lt; 0&#10;THEN &apos;▼ &apos;&#10;ELSE NULL&#10;END &#10;+ &#10;IF [Orders Base (copy)_6285265888775180292] &lt;= 0 &#10;THEN STR(ROUND([Orders Base (copy)_6285265888775180292] * 100 ,2))&#10;+&#10;&quot;%&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='LW Orders WoW (Positive)' datatype='string' name='[Orders WoW (Positive) (copy)_6285265888775811079]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Orders Base (copy)_6285265888775180292] &gt; 0&#10;THEN &apos;▲ &apos; &#10;ELSE NULL&#10;END &#10;+ &#10;IF [Orders Base (copy)_6285265888775180292] &gt; 0&#10;THEN STR(ROUND([Orders Base (copy)_6285265888775180292] * 100, 2))&#10;+&#10;&quot;%&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column-instance column='[Calculation_2558466854726570014]' derivation='Avg' name='[avg:Calculation_2558466854726570014:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
