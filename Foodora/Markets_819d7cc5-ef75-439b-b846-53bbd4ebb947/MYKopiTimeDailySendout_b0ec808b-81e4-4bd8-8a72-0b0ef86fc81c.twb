    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Description/Metric Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/MYTehTimeDailySendout/DescriptionMetricDefinitions?rev=' id='DescriptionMetricDefinitions' path='/t/Foodora/workbooks/MYTehTimeDailySendout' revision='' site='Foodora' />
      <style />
      <size maxheight='800' maxwidth='1350' minheight='800' minwidth='1350' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='1318' param='horz' type-v2='layout-flow' w='98814' x='593' y='1000'>
            <zone h='98000' id='1094' type-v2='layout-basic' w='98814' x='593' y='1000'>
              <zone forceUpdate='true' h='4000' id='183' type-v2='text' w='98814' x='593' y='13500'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#c2004f' />
                </zone-style>
              </zone>
              <zone h='12500' id='187' name='Date Title' w='96113' x='593' y='1000'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='12500' id='654' type-v2='empty' w='2701' x='96706' y='1000'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='23875' id='1331' type-v2='text' w='98814' x='593' y='17500'>
                <formatted-text>
                  <run fontcolor='#000000' fontname='Tableau Light'>This dashboard is owned by MY Data team. Kindly reach out to us @mydata_members in our respective Slack Channels, or email us at pandata_my@foodpanda.my for any questions or concerns. Thanks!</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light'>For access:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontname='Tableau Light'>Please request for Performance viewership role access in Tableau (tableau-pandora Performance Foodpanda Malaysia). Documentation here for access: </run>
                  <run auto-url='true' fontcolor='#4996b2' fontname='Tableau Light' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/display/MYD/Other+Accesses&amp;quot;' underline='true'>https://confluence.deliveryhero.com/display/MYD/Other+Accesses</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontname='Tableau Light'>Data refresh: Daily at 9-10am. For any refresh issues, please refer to #pandata or #pandata-my-support for updates on refresh.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='53625' id='1332' type-v2='text' w='98814' x='593' y='45375'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12' underline='true'>Definitions</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true'>Orders:</run>
                  <run> total valid orders (OD, VD &amp; PU). Does not include pandago orders
</run>
                  <run bold='true'>GMV:</run>
                  <run> total gross GMV&#10;</run>
                  <run bold='true'>AFV:</run>
                  <run> average food value. total valid gfv / total valid orders
</run>
                  <run bold='true'>Customers with Order:</run>
                  <run> total order generating customers in that period
</run>
                  <run bold='true'>New Customers (First Order)</run>
                  <run>: total customers who newly ordered in our platform
</run>
                  <run bold='true'>New Registered Customers</run>
                  <run>: total customers who newly registered into our platform

</run>
                  <run bold='true'>Sessions:</run>
                  <run> total sessions. Does not include ghost sessions and valid users only
</run>
                  <run bold='true'>CVR:</run>
                  <run> Session conversion to transaction. transactions / sessions

</run>
                  <run bold='true'>ADF:</run>
                  <run> average delivery fee. total delivery fee / total valid orders
</run>
                  <run bold='true'>% Incentivized: </run>
                  <run>share of all (fp and vd) incentivized discounted and voucher orders. all incentivized orders / total valid orders
</run>
                  <run bold='true'>iCPGMV:</run>
                  <run> foodpanda incentivized value per GMV. total foodpanda incentivized value / total valid gmv
</run>
                  <run bold='true'>Rider CPO: </run>
                  <run>rider cost per order. total rider cost / total valid order

</run>
                  <run bold='true'>Fail Rate:</run>
                  <run> share of failed orders. total failed orders / total gross orders
</run>
                  <run bold='true'>Seamless: </run>
                  <run>share of seamless orders. total seamless orders / total gross OD orders
</run>
                  <run bold='true'>ADT:</run>
                  <run> average delivery time. total actual delivery time / total OD orders
</run>
                  <run bold='true'>UTR:</run>
                  <run> utilization rate of rider working hours. total deliveries / total actual working hours
</run>
                  <run bold='true'>Surge: </run>
                  <run>total surge orders / total actual orders
</run>
                  <run bold='true'>Shrink:</run>
                  <run> total shrink orders / total forecasted orders</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='4000' id='1333' type-v2='empty' w='98814' x='593' y='41375'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#c2004f' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
