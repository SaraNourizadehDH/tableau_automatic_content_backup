    <worksheet name='LW GMV'>
      <table>
        <view>
          <datasources>
            <datasource caption='management_factsheet_daily' name='federated.19dbh6e05n6ik313c1n0y0b2n233' />
          </datasources>
          <datasource-dependencies datasource='federated.19dbh6e05n6ik313c1n0y0b2n233'>
            <column caption='One' datatype='integer' default-format='p0.00%' name='[Calculation_2558466854726570014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Last Week' datatype='boolean' name='[Calculation_6285265888773971968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[order_date])=DATETRUNC(&quot;week&quot;,dateadd(&quot;week&quot;,-1,TODAY()-1))' />
            </column>
            <column caption='LW GMV WoW (Indicator)' datatype='string' name='[GMV WoW (Indicator) (copy)_6285265888782852108]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;  (&#10;    ([Latest GMV (copy)_6285265888782606346] - [Latest - 7 GMV (copy)_6285265888782671883])&#10;    /&#10;    IIF([Latest - 7 GMV (copy)_6285265888782671883]= 0, 1, [Latest - 7 GMV (copy)_6285265888782671883])&#10;  ) &gt; 0 &#10;THEN &apos;▲ &apos;&#10;ELSE &apos;▼ &apos;&#10;END' />
            </column>
            <column caption='LW GMV WoW (Negative)' datatype='string' name='[GMV WoW (Negative) (copy)_6285265888782852109]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;  (&#10;    ([Latest GMV (copy)_6285265888782606346] - [Latest - 7 GMV (copy)_6285265888782671883])&#10;    /&#10;    IIF([Latest - 7 GMV (copy)_6285265888782671883] = 0, 1, [Latest - 7 GMV (copy)_6285265888782671883])&#10;  ) &lt; 0&#10;THEN &apos;▼ &apos;&#10;ELSE NULL&#10;END &#10;&#10;+ &#10;&#10;IF &#10;  (&#10;    ([Latest GMV (copy)_6285265888782606346] - [Latest - 7 GMV (copy)_6285265888782671883])&#10;    /&#10;    IIF([Latest - 7 GMV (copy)_6285265888782671883] = 0, 1, [Latest - 7 GMV (copy)_6285265888782671883])&#10;  ) &lt;= 0 &#10;THEN&#10;    STR(&#10;      ROUND(&#10;          ( &#10;            ([Latest GMV (copy)_6285265888782606346] - [Latest - 7 GMV (copy)_6285265888782671883])&#10;            / &#10;            IIF([Latest - 7 GMV (copy)_6285265888782671883] = 0, 1, [Latest - 7 GMV (copy)_6285265888782671883])&#10;          ) * 100&#10;          ,2&#10;      )&#10;    )&#10;&#10;    +&#10;&#10;    &quot;%&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='LW GMV WoW (Positive)' datatype='string' name='[GMV WoW (Positive) (copy)_6285265888782852110]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;  (&#10;    ([Latest GMV (copy)_6285265888782606346] - [Latest - 7 GMV (copy)_6285265888782671883])&#10;    /&#10;    IIF([Latest - 7 GMV (copy)_6285265888782671883] = 0, 1, [Latest - 7 GMV (copy)_6285265888782671883])&#10;  ) &gt; 0&#10;THEN &apos;▲ &apos; &#10;ELSE NULL&#10;END &#10;&#10;+ &#10;&#10;IF &#10;  (&#10;    ([Latest GMV (copy)_6285265888782606346]  - [Latest - 7 GMV (copy)_6285265888782671883])&#10;    /&#10;    IIF([Latest - 7 GMV (copy)_6285265888782671883] = 0, 1, [Latest - 7 GMV (copy)_6285265888782671883])&#10;  ) &gt; 0&#10;THEN&#10;    STR(&#10;      ROUND(&#10;          ( &#10;            ([Latest GMV (copy)_6285265888782606346] - [Latest - 7 GMV (copy)_6285265888782671883])&#10;            / &#10;            IIF([Latest - 7 GMV (copy)_6285265888782671883] = 0, 1, [Latest - 7 GMV (copy)_6285265888782671883])&#10;          ) * 100&#10;          ,2&#10;      )&#10;    )&#10;&#10;    +&#10;&#10;    &quot;%&quot;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Last 2 Week' datatype='boolean' name='[Last Week (copy)_6285265888774799363]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&quot;week&quot;,[order_date])=DATETRUNC(&quot;week&quot;,dateadd(&quot;week&quot;,-2,TODAY()-1))' />
            </column>
            <column caption='L2W GMV' datatype='real' name='[Latest - 7 GMV (copy)_6285265888782671883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Last Week (copy)_6285265888774799363] = TRUE, [valid_gmv], 0))' />
            </column>
            <column caption='LW GMV' datatype='real' default-format='c&quot;RM&quot;#,##0,,.00M;(&quot;RM&quot;#,##0,,.00M)' name='[Latest GMV (copy)_6285265888782606346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_6285265888773971968] = TRUE, [valid_gmv], 0))' />
            </column>
            <column-instance column='[Calculation_2558466854726570014]' derivation='Avg' name='[avg:Calculation_2558466854726570014:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column caption='Order Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column-instance column='[GMV WoW (Indicator) (copy)_6285265888782852108]' derivation='User' name='[usr:GMV WoW (Indicator) (copy)_6285265888782852108:nk]' pivot='key' type='nominal' />
            <column-instance column='[GMV WoW (Negative) (copy)_6285265888782852109]' derivation='User' name='[usr:GMV WoW (Negative) (copy)_6285265888782852109:nk]' pivot='key' type='nominal' />
            <column-instance column='[GMV WoW (Positive) (copy)_6285265888782852110]' derivation='User' name='[usr:GMV WoW (Positive) (copy)_6285265888782852110:nk]' pivot='key' type='nominal' />
            <column-instance column='[Latest GMV (copy)_6285265888782606346]' derivation='User' name='[usr:Latest GMV (copy)_6285265888782606346:qk]' pivot='key' type='quantitative' />
            <column datatype='real' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[valid_gmv]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='relative-date' column='[federated.19dbh6e05n6ik313c1n0y0b2n233].[none:order_date:qk]' first-period='-7' include-future='true' include-null='false' last-period='0' period-type-v2='week' />
