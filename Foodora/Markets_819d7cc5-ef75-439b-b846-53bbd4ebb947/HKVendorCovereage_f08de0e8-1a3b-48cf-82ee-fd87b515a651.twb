      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Vendor Coverage Overview' id='_5E960B2A00A84633ACFEA7F3685E0D1B'>
            <properties context=''>
              <relation connection='bigquery.17jtfb50gwusxk1b5l1770abggcp' name='Custom SQL Query' type='text'>WITH geo_groups AS (
   SELECT
    geo_hash_group,
    ST_Y(geo_point_group) AS geo_lat,
    ST_X(geo_point_group) AS geo_long,
    MIN(geo_hash) AS geo_hash,
    MIN(area) AS area,
    STRING_AGG(zone_group,&apos;; &apos;) AS zone_groups
  FROM `fulfillment-dwh-production.pandata_report.country_HK_lg_geo_points_fp_zones`
  WHERE is_rider_zone AND is_geo_group
  GROUP BY 1,2,3
),
all_shrink_layers AS (
  SELECT &apos;Normal&apos; AS shrink_layer
  UNION ALL
  SELECT &apos;Shrink 1&apos; AS shrink_layer
  UNION ALL
  SELECT &apos;Shrink 2&apos; AS shrink_layer
  UNION ALL
  SELECT &apos;Shrink 3&apos; AS shrink_layer
),
vendor_coverage AS (
  SELECT 
    * EXCEPT(cuisines)
  FROM `fulfillment-dwh-production.pandata_report.country_HK_lg_vendor_coverages`
  WHERE is_primary
    AND vertical_type = &apos;restaurants&apos;
    AND type = &apos;Full Day&apos;
)
SELECT 
  geo.area,
  zone_groups,
  geo_hash_group,
  neighborhood_code,
  neighborhood_en,
  geo_lat,
  geo_long,
  geo_hash,
  vertical_type,
  shrink_layer,
  COALESCE(cuisine_count, 0) AS cuisine_count,
  COALESCE(chain_count, 0) AS chain_count,
  COALESCE(exclusive_chain_count, 0) AS exclusive_chain_count,
  COALESCE(ed_chain_count, 0) AS ed_chain_count,
  COALESCE(vendor_count, 0) AS vendor_count,
FROM geo_groups geo
CROSS JOIN all_shrink_layers 
LEFT JOIN vendor_coverage USING(geo_hash, shrink_layer)</relation>
            </properties>
            <properties context='extract'>
              <relation name='_5E960B2A00A84633ACFEA7F3685E0D1B' table='[Extract].[_5E960B2A00A84633ACFEA7F3685E0D1B]' type='table' />
            </properties>
          </object>
          <object caption='Cuisine Deep Dive' id='_8D60CCE8EBCA40DDB7F7C2DACDA9BCD3'>
            <properties context=''>
              <relation connection='bigquery.17jtfb50gwusxk1b5l1770abggcp' name='Custom SQL Query1' type='text'>WITH geo_groups AS (
   SELECT
    geo_hash_group,
    MIN(geo_hash) AS geo_hash
  FROM `fulfillment-dwh-production.pandata_report.country_HK_lg_geo_points_fp_zones`
  WHERE is_rider_zone AND is_geo_group
  GROUP BY 1
),
all_shrink_layers AS (
  SELECT &apos;Normal&apos; AS shrink_layer
  UNION ALL
  SELECT &apos;Shrink 1&apos; AS shrink_layer
  UNION ALL
  SELECT &apos;Shrink 2&apos; AS shrink_layer
  UNION ALL
  SELECT &apos;Shrink 3&apos; AS shrink_layer
),
vendor_coverage AS (
  SELECT 
    coverage.* EXCEPT(cuisines),
    cuisine.* EXCEPT(vendors)
  FROM `fulfillment-dwh-production.pandata_report.country_HK_lg_vendor_coverages` coverage
  LEFT JOIN UNNEST(cuisines) cuisine
  WHERE is_primary
    AND vertical_type = &apos;restaurants&apos;
    AND type = &apos;Full Day&apos;
)
SELECT 
  geo_hash_group,
  geo_hash,
  shrink_layer,
  primary_cuisine,
  COALESCE(cuisine_chain_count, 0) AS cuisine_chain_count,
  COALESCE(cuisine_exclusive_chain_count, 0) AS cuisine_exclusive_chain_count,
  COALESCE(cuisine_ed_chain_count, 0) AS cuisine_ed_chain_count,
  COALESCE(cuisine_vendor_count, 0) AS cuisine_vendor_count,
FROM geo_groups geo
CROSS JOIN all_shrink_layers 
LEFT JOIN vendor_coverage USING(geo_hash, shrink_layer)</relation>
            </properties>
            <properties context='extract'>
              <relation name='_8D60CCE8EBCA40DDB7F7C2DACDA9BCD3' table='[Extract].[_8D60CCE8EBCA40DDB7F7C2DACDA9BCD3]' type='table' />
            </properties>
          </object>
        </objects>
