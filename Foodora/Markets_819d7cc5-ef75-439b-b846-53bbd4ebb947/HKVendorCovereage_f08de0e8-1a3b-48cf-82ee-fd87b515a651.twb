        <column caption='Map Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Normal Restaurants&quot;'>
          <calculation class='tableau' formula='&quot;Normal Restaurants&quot;' />
          <members>
            <member value='&quot;Cuisines&quot;' />
            <member value='&quot;All Restaurants&quot;' />
            <member value='&quot;Normal Restaurants&quot;' />
            <member value='&quot;ED Restaurants&quot;' />
            <member value='&quot;Exclusive Restaurants&quot;' />
          </members>
        </column>
      </datasource-dependencies>
