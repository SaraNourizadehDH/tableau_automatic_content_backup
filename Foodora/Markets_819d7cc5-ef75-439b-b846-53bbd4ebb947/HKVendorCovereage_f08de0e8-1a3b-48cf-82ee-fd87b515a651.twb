          <relation connection='bigquery.17jtfb50gwusxk1b5l1770abggcp' name='Custom SQL Query1' type='text'>WITH geo_groups AS (
   SELECT
    geo_hash_group,
    MIN(geo_hash) AS geo_hash
  FROM `fulfillment-dwh-production.pandata_report.country_HK_lg_geo_points_fp_zones`
  WHERE is_rider_zone AND is_geo_group
  GROUP BY 1
),
all_shrink_layers AS (
  SELECT &apos;Normal&apos; AS shrink_layer
  UNION ALL
  SELECT &apos;Shrink 1&apos; AS shrink_layer
  UNION ALL
  SELECT &apos;Shrink 2&apos; AS shrink_layer
  UNION ALL
  SELECT &apos;Shrink 3&apos; AS shrink_layer
),
vendor_coverage AS (
  SELECT 
    coverage.* EXCEPT(cuisines),
    cuisine.* EXCEPT(vendors)
  FROM `fulfillment-dwh-production.pandata_report.country_HK_lg_vendor_coverages` coverage
  LEFT JOIN UNNEST(cuisines) cuisine
  WHERE is_primary
    AND vertical_type = &apos;restaurants&apos;
    AND type = &apos;Full Day&apos;
)
SELECT 
  geo_hash_group,
  geo_hash,
  shrink_layer,
  primary_cuisine,
  COALESCE(cuisine_chain_count, 0) AS cuisine_chain_count,
  COALESCE(cuisine_exclusive_chain_count, 0) AS cuisine_exclusive_chain_count,
  COALESCE(cuisine_ed_chain_count, 0) AS cuisine_ed_chain_count,
  COALESCE(cuisine_vendor_count, 0) AS cuisine_vendor_count,
FROM geo_groups geo
CROSS JOIN all_shrink_layers 
LEFT JOIN vendor_coverage USING(geo_hash, shrink_layer)</relation>
