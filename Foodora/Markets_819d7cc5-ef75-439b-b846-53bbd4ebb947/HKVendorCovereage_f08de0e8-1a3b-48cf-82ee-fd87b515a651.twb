            <connection CATALOG='foodpanda-hk-bigquery' EXECCATALOG='foodpanda-hk-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='APAC Country - HK' schema='sandbox_thomas_lam' server-oauth='' username='thomas.lam@foodpanda.hk' workgroup-auth-mode='prompt' />
          </named-connection>
