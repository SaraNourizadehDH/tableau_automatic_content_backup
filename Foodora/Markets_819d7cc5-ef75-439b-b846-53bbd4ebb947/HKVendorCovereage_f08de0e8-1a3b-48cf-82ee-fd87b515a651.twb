        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.17jtfb50gwusxk1b5l1770abggcp' name='Custom SQL Query' type='text'>WITH geo_groups AS (
   SELECT
    geo_hash_group,
    ST_Y(geo_point_group) AS geo_lat,
    ST_X(geo_point_group) AS geo_long,
    MIN(geo_hash) AS geo_hash,
    MIN(area) AS area,
    STRING_AGG(zone_group,&apos;; &apos;) AS zone_groups
  FROM `fulfillment-dwh-production.pandata_report.country_HK_lg_geo_points_fp_zones`
  WHERE is_rider_zone AND is_geo_group
  GROUP BY 1,2,3
),
all_shrink_layers AS (
  SELECT &apos;Normal&apos; AS shrink_layer
  UNION ALL
  SELECT &apos;Shrink 1&apos; AS shrink_layer
  UNION ALL
  SELECT &apos;Shrink 2&apos; AS shrink_layer
  UNION ALL
  SELECT &apos;Shrink 3&apos; AS shrink_layer
),
vendor_coverage AS (
  SELECT 
    * EXCEPT(cuisines)
  FROM `fulfillment-dwh-production.pandata_report.country_HK_lg_vendor_coverages`
  WHERE is_primary
    AND vertical_type = &apos;restaurants&apos;
    AND type = &apos;Full Day&apos;
)
SELECT 
  geo.area,
  zone_groups,
  geo_hash_group,
  neighborhood_code,
  neighborhood_en,
  geo_lat,
  geo_long,
  geo_hash,
  vertical_type,
  shrink_layer,
  COALESCE(cuisine_count, 0) AS cuisine_count,
  COALESCE(chain_count, 0) AS chain_count,
  COALESCE(exclusive_chain_count, 0) AS exclusive_chain_count,
  COALESCE(ed_chain_count, 0) AS ed_chain_count,
  COALESCE(vendor_count, 0) AS vendor_count,
FROM geo_groups geo
CROSS JOIN all_shrink_layers 
LEFT JOIN vendor_coverage USING(geo_hash, shrink_layer)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
