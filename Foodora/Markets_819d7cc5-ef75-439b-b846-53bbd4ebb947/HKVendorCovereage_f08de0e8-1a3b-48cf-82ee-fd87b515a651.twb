      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/HKVendorCovereage/CoverageMap?rev=' id='CoverageMap' path='/t/Foodora/workbooks/HKVendorCovereage' revision='' site='Foodora' />
      <style />
      <size maxheight='3000' maxwidth='1800' minheight='3000' minwidth='1800' preset-index='17' sizing-mode='fixed' />
      <datasources>
