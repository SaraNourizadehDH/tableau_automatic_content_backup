          <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Cuisines&apos; THEN [cuisine_count]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;All Restaurants&apos; THEN [chain_count]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Normal Restaurants&apos; THEN [Calculation_36310321536397315]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;ED Restaurants&apos; THEN [ed_chain_count]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Exclusive Restaurants&apos; THEN [exclusive_chain_count]&#10;END' />
