    <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.17y7ndz1b25imw10gqs8w13pe276' name='Custom SQL Query' type='text'>select 
payment_instrument_id,
customer_id,
instrument_bin,
instrument_display_value,
card_scheme,
valid_to_year,
valid_to_month,
tokenization,
instrument_source,
psp_identifier,
payment_instrument_type,
payment_instrument_status,
creation_date,
deleted_hidden_date,
preselected_instrument,
wallet_id,
card_brand,
issuing_organization,
card_type,
card_category,
issuing_country,
bin_type,
email,
email_domain,
mobile_number
from `fulfillment-dwh-production.curated_data_shared_fintech.alfred_customer_instruments` t
left join `fulfillment-dwh-production.curated_data_shared_fintech.binbase_all` bba on t.instrument_bin=CAST(bba.bin AS STRING)
left join `fulfillment-dwh-production.pandata_curated.cus_customers` c on t.customer_id=c.code and c.global_entity_id=&apos;YS_TR&apos;
where creation_date&gt;&gt;&apos;2000-01-01&apos; and not c.is_deleted and t.global_entity_id=&apos;YS_TR&apos;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
