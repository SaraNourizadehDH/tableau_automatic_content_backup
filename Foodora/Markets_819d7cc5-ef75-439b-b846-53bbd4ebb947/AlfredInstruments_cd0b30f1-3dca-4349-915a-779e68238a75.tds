  <column caption='TimeFrame Selector' datatype='string' name='[Calculation_3289316603179847683]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;    WHEN &apos;Daily&apos; THEN STR(DATE([creation_date]))&#10;    WHEN &apos;Weekly&apos; THEN STR(YEAR([creation_date])) +&quot; &quot;+STR(WEEK([creation_date]))&#10;    WHEN &apos;Monthly&apos; THEN STR(YEAR([creation_date])) +&quot; &quot;+STR(MONTH([creation_date]))&#10;    WHEN &apos;Yearly&apos; THEN STR(YEAR([creation_date]))&#10;END' />
  </column>
  <column caption='Cucstomer Count' datatype='integer' name='[Calculation_3859162722399260674]' role='measure' type='quantitative'>
