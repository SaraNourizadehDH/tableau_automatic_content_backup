      <column caption='% Rated' datatype='real' default-format='p0.00%' hidden='true' name='[Calculation_112308517223288832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1157143688518467609]/[Calculation_1157143688514347027]' />
      </column>
