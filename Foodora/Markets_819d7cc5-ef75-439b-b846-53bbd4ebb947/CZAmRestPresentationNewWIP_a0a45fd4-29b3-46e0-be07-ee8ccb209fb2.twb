      <aliases enabled='yes' />
      <column caption='# Display Ads Vendors' datatype='integer' hidden='true' name='[# CPC vendors (copy)_1091841437179502597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [display_ads_revenue_local] &gt; 0 THEN [vendor_code] END)' />
      </column>
      <column caption='# Eshop Vendors' datatype='integer' default-format='N' hidden='true' name='[# Joker Vendors (copy)_1091841437178585090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [eshop_revenue_local] &gt; 0 THEN [vendor_code] END)' />
      </column>
      <column caption='# Orders RR' datatype='real' hidden='true' name='[# Orders (copy)_1592022536286007299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_orders])* [Calculation_1315332633877635078]' />
      </column>
      <column caption='# Users Vendor RR' datatype='real' hidden='true' name='[# Users Vendor (copy)_1592022536289841161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_users]) * [Calculation_1315332633877635078]' />
      </column>
      <column caption='# NCR vendors' datatype='integer' hidden='true' name='[# Vendors with Order (copy)_1091841437183086599]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [ncr_revenue_local] &gt; 0 THEN [vendor_code (vendors)] END)' />
      </column>
      <column caption='% Display Ads Penetration' datatype='real' default-format='p0.0%' hidden='true' name='[% CPC Penetration (copy)_1091841437179514886]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [display_ads_revenue_local] &gt; 0 THEN [vendor_code] END)/COUNTD(IF [successful_orders] &gt; 0 THEN [vendor_code] END)' />
      </column>
      <column caption='% CVR Target' datatype='real' default-format='p0.0%' hidden='true' name='[% CVR (copy)_1157143688779743262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[report_month Parameter]),7)&#13;&#10;    WHEN &apos;2024-01&apos; THEN 0.230&#13;&#10;    WHEN &apos;2024-02&apos; THEN 0.230&#13;&#10;    WHEN &apos;2024-03&apos; THEN 0.231&#13;&#10;    WHEN &apos;2024-04&apos; THEN 0.232&#13;&#10;    WHEN &apos;2024-05&apos; THEN 0.233&#13;&#10;    WHEN &apos;2024-06&apos; THEN 0.235&#13;&#10;END)' />
      </column>
      <column caption='% Compensation Rate ' datatype='real' default-format='p0.00%' hidden='true' name='[% Contact Rate (copy)_1382323619166388228]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([compensations_resto_cnt])&#13;&#10;/&#13;&#10;SUM(IFNULL([successful_orders],0) + IFNULL([failed_orders],0))' />
      </column>
      <column caption='% PRO Cofund Subsidy Spend / GMV ' datatype='real' default-format='p0.00%' hidden='true' name='[% DH Subsidy Spend / GMV (copy)_933089613371752449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_dh_deal_value])/[Calculation_1157143688514240530]' />
      </column>
      <column caption='# Deal Orders' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' hidden='true' name='[% Deal Orders (copy)_808114725067771908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_orders])' />
      </column>
      <column caption='% Delayed &gt; 30' datatype='real' default-format='p0.0%' hidden='true' name='[% Delay &gt; 10 (copy)_2791950299355770881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_late_over_30_count]) / SUM([completed_orders])' />
      </column>
      <column caption='% Delayed Orders' datatype='real' default-format='p0.0%' hidden='true' name='[% Delay &gt; 10 (copy)_2791950299360616455]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_late_count]) / SUM([completed_orders])' />
      </column>
      <column caption='% Eshop Penetration' datatype='real' default-format='p0.0%' hidden='true' name='[% Joker Penetration (copy)_1091841437178978307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [eshop_revenue_local] &gt; 0 THEN [vendor_code] END)/COUNTD(IF [successful_orders] &gt; 0 THEN [vendor_code] END)' />
      </column>
