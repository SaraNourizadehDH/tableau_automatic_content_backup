      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='orders_delivery_data' id='_4323AB45F75F45ABAC65597C9D643B36'>
            <properties context=''>
              <relation connection='bigquery.0u9trrw1nbkfuw18uuhq81ongrf5' name='orders_delivery_data' type='text'><![CDATA[SELECT
    created_date_local,
    v.vendor_code,
    v.vendor_name,
    chain_name,

    COUNT(DISTINCT co.order_uuid) AS successful_orders,

     COUNT(CASE
        WHEN CASE
            WHEN o.promised_delivery_time_in_minutes <<= 40 THEN
                CASE
                    WHEN df_option = 'PRIORITY' THEN
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes
                        AND actual_delivery_time_in_minutes >> o.promised_delivery_time_in_minutes - 15
                    ELSE
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes + 5
                        AND actual_delivery_time_in_minutes >> o.promised_delivery_time_in_minutes - 10
                END
            ELSE
                CASE
                    WHEN df_option = 'PRIORITY' THEN
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes + 5
                        AND actual_delivery_time_in_minutes >> o.promised_delivery_time_in_minutes - 10
                    ELSE
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes + 15
                        AND actual_delivery_time_in_minutes >> o.promised_delivery_time_in_minutes
                END
        END THEN o.order_uid
    END) AS successful_orders_in_pdt,

COUNT(CASE
        WHEN CASE
            WHEN o.promised_delivery_time_in_minutes <<= 40 THEN
                CASE
                    WHEN df_option = 'PRIORITY' THEN
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes - 15
                    ELSE
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes - 10
                END
            ELSE
                CASE
                    WHEN df_option = 'PRIORITY' THEN
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes - 10
                    ELSE
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes
                END
        END THEN o.order_uid
    END) AS successful_orders_before_pdt,

FROM `damejidlo-cz-bigquery.master.orders` co
JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` o ON co.order_code = o.order_code AND co.global_entity_id = o.global_entity_id
JOIN `damejidlo-cz-bigquery.master.vendors` v ON o.vendor_code = v.vendor_code
WHERE o.country_code_iso = 'cz'
  AND co.is_valid_order
  AND co.created_at_local >>= DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)
  AND o.created_date_local >>=  DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)
  AND v.chain_name IN (
    'Burger King',
    'Burger King - Plant Based',
    'Pizza Hut',
    'KFC Rozvoz',
    'Starbucks',
    'Těstoviny z pece by Pizza Hut'
  )
  AND v.group_name IN (
    'AmRest Coffee s.r.o.',
    'AmRest s.r.o.'
  )
  AND o.delivery_type = 'Own Delivery'
GROUP BY ALL]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_4323AB45F75F45ABAC65597C9D643B36' table='[Extract].[_4323AB45F75F45ABAC65597C9D643B36]' type='table' />
            </properties>
          </object>
          <object caption='vendor_performance' id='vendor_performance_7325D9FD988246A694B22C6E43485FDB'>
            <properties context=''>
              <relation connection='bigquery.0u9trrw1nbkfuw18uuhq81ongrf5' name='vendor_performance' table='[damejidlo-cz-bigquery.tableau_outputs].[vendor_performance]' type='table' />
            </properties>
            <properties context='extract'>
              <relation name='vendor_performance_7325D9FD988246A694B22C6E43485FDB' table='[Extract].[vendor_performance_7325D9FD988246A694B22C6E43485FDB]' type='table' />
            </properties>
          </object>
          <object caption='vendors' id='vendors_F245FCBF0BDF456B8FD7BECE8BA900D6'>
            <properties context=''>
              <relation connection='bigquery.0u9trrw1nbkfuw18uuhq81ongrf5' name='vendors' table='[damejidlo-cz-bigquery.master].[vendors]' type='table' />
            </properties>
            <properties context='extract'>
              <relation name='vendors_F245FCBF0BDF456B8FD7BECE8BA900D6' table='[Extract].[vendors_F245FCBF0BDF456B8FD7BECE8BA900D6]' type='table' />
            </properties>
          </object>
        </objects>
        <relationships>
          <relationship>
            <expression op='AND'>
