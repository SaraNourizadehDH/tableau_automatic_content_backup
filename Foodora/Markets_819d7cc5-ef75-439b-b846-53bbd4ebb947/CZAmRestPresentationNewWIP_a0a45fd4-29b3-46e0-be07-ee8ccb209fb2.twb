              <calculation class='tableau' formula='SUM([promised_delivery_time_in_minutes])/SUM([promised_delivery_time_cnt])' />
            </column>
            <column caption='# Sessions' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1157143688506400768]' role='measure' type='quantitative'>
