            <connection CATALOG='damejidlo-cz-bigquery' EXECCATALOG='damejidlo-cz-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='damejidlo-cz-bigquery' schema='markets_analytics' server-oauth='' username='matyas.kapusta@foodora.cz' workgroup-auth-mode='prompt' />
