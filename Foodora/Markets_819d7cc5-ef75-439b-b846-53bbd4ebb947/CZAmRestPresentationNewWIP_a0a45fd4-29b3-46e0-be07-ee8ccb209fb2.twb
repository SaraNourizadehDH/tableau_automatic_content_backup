      <column caption='% VFD / GMV Target' datatype='real' default-format='p0.00%' hidden='true' name='[% VFD / GMV (copy)_1157143688780718112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(CASE LEFT(STR([Parameters].[report_month Parameter]),7)&#13;&#10;    WHEN &apos;2024-01&apos; THEN 0.044&#13;&#10;    WHEN &apos;2024-02&apos; THEN 0.044&#13;&#10;    WHEN &apos;2024-03&apos; THEN 0.055&#13;&#10;    WHEN &apos;2024-04&apos; THEN 0.055&#13;&#10;    WHEN &apos;2024-05&apos; THEN 0.064&#13;&#10;    WHEN &apos;2024-06&apos; THEN 0.070&#13;&#10;END)' />
