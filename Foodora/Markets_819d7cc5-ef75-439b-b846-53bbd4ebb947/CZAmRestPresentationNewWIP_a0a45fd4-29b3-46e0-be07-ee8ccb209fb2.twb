    <worksheet name='Uptime'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_performance+ (markets_analytics)' name='federated.08zb8420quuiux1gn8vt30ygp84i' />
          </datasources>
          <datasource-dependencies datasource='federated.08zb8420quuiux1gn8vt30ygp84i'>
            <column caption='% Uptime' datatype='real' default-format='p0.0%' name='[Calculation_1157143688511807500]' role='measure' type='quantitative'>
