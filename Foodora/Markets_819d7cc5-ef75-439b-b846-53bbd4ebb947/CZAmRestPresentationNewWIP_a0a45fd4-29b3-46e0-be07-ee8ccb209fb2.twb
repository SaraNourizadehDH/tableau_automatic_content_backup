      </column>
      <column caption='Metric' datatype='real' hidden='true' name='[Calculation_1024850449803714561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;Contact Rate&quot; THEN [Calculation_1382323619161903104]&#13;&#10;WHEN &quot;Compensation Rate&quot; THEN [% Contact Rate (copy)_1382323619166388228]&#13;&#10;WHEN &quot;Deals: Cofund Share&quot; THEN [% VFD / GMV (copy)_933089613371588608]&#13;&#10;WHEN &quot;Deals: Deal Utilization&quot; THEN [Calculation_1157143688518098967]&#13;&#10;WHEN &quot;Deals: Subsidy Spend&quot; THEN [Calculation_808114725068214277]&#13;&#10;WHEN &quot;Deals: VFD / GMV&quot; THEN [Calculation_1157143688516964373]&#13;&#10;WHEN &quot;Deals: VFD Total Value&quot; THEN [Calculation_1157143688518881306]&#13;&#10;WHEN &quot;GMV&quot; THEN [Calculation_1157143688514240530]&#13;&#10;WHEN &quot;NCR / GMV&quot; THEN [Calculation_431501199555026944]/[Calculation_1157143688514240530]&#13;&#10;WHEN &quot;NCR: CPP Revenue / GMV&quot; Then sum([cpp_revenue_local])/[Calculation_1157143688514240530]&#13;&#10;WHEN &quot;NCR: CPC Revenue / GMV&quot; Then sum([cpc_revenue_local])/[Calculation_1157143688514240530]&#13;&#10;WHEN &quot;NCR: Display Ads Revenue / GMV&quot; Then sum([display_ads_revenue_local])/[Calculation_1157143688514240530]&#13;&#10;WHEN &quot;NCR: Eshop Profit / GMV&quot; THEN SUM([eshop_revenue_local])/[Calculation_1157143688514240530]&#13;&#10;WHEN &quot;NCR: Eshop Turnover / GMV&quot; THEN [Turnover (copy)_958422309936173056]/ [Calculation_1157143688514240530]&#13;&#10;WHEN &quot;NCR: Joker Revenue / GMV&quot; THEN SUM([joker_fee_revenue_local])/[Calculation_1157143688514240530]&#13;&#10;WHEN &quot;OPS: Compensation Rate&quot; THEN [% Contact Rate (copy)_1382323619166388228]&#13;&#10;WHEN &quot;OPS: Contact Rate&quot; THEN [Calculation_1382323619161903104]&#13;&#10;WHEN &quot;OPS: Fail Rate&quot; THEN [% Vendor Fail Rate (copy)_808114725069668358]&#13;&#10;WHEN &quot;OPS: Order Late &gt; 10&quot; THEN [% Vendor Late &gt; 10 (copy)_1382323619162849281]&#13;&#10;WHEN &quot;OPS: Rider Late &gt; 10&quot; THEN [% Vendor Late &gt; 10 (copy)_894808954563899393]&#13;&#10;WHEN &quot;OPS: Vendor Late &gt; 10&quot; THEN [Calculation_1157143688511565835]&#13;&#10;WHEN &quot;OPS: Uptime&quot; THEN [Calculation_1157143688511807500]&#13;&#10;WHEN &quot;OPS: Vendor Fail Rate&quot; THEN [Calculation_1157143688512045069]&#13;&#10;WHEN &quot;Orders: Total Orders&quot; THEN [Calculation_1157143688514347027]&#13;&#10;WHEN &quot;Orders: ODS (Orders Daily per Store)&quot; THEN [Calculation_808114725066575875]&#13;&#10;WHEN &quot;Orders: Average Basket Value (ABV)&quot; THEN [Calculation_1157143688510693385]&#13;&#10;WHEN &quot;Take Rate&quot; THEN [Calculation_1315332633925283852]&#13;&#10;WHEN &quot;Take Rate / GMV&quot; THEN [% VFD / GMV (copy)_1315332633925586957]&#13;&#10;WHEN &quot;Traffic: CVR - Conversion&quot; THEN [Calculation_1157143688506572801] &#13;&#10;WHEN &quot;Traffic: Sessions&quot; THEN [Calculation_1157143688506400768]&#13;&#10;WHEN &quot;Turnover&quot; THEN [Calculation_1315332633910190089]&#13;&#10;WHEN &quot;Users - Active Users&quot; THEN [Calculation_1157143688513679376]&#13;&#10;WHEN &quot;Users - New Users Platform&quot; THEN [Calculation_1157143688513216526]&#13;&#10;WHEN &quot;Users - New Users Vendor&quot; THEN [Calculation_1157143688513413135]&#13;&#10;WHEN &quot;Users - Reorder Rate 1m&quot; THEN [Calculation_1157143688509468680]&#13;&#10;END' />
      </column>
      <column caption='# Online Vendors' datatype='integer' hidden='true' name='[Calculation_103301319054991360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF IFNULL([total_scheduled_open_seconds],0) -  IFNULL([total_closed_seconds],0) &gt; 0 THEN [vendor_code] END)' />
      </column>
      <column caption='# CPC vendors' datatype='integer' hidden='true' name='[Calculation_1091841437178056704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [cpc_revenue_local] &gt; 0 THEN [vendor_code] END)' />
