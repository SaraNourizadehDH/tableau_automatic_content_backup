      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='orders_delivery_data' id='_3AADBEF8AF0047F5B3AC8DBD0AD2AFE9'>
            <properties context=''>
              <relation connection='bigquery.0cjqo6d0sfkxmw14ksn1918kon3h' name='Custom SQL Query' type='text'><![CDATA[SELECT
    o.global_entity_id,
    o.created_date_local,
    v.vendor_code,
    v.vendor_name,
    chain_name,

    COUNT(DISTINCT o.order_code) AS successful_orders,

     COUNT(CASE
        WHEN CASE
            WHEN o.promised_delivery_time_in_minutes <<= 40 THEN
                CASE
                    WHEN df_option = 'PRIORITY' THEN
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes
                        AND actual_delivery_time_in_minutes >> o.promised_delivery_time_in_minutes - 15
                    ELSE
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes + 5
                        AND actual_delivery_time_in_minutes >> o.promised_delivery_time_in_minutes - 10
                END
            ELSE
                CASE
                    WHEN df_option = 'PRIORITY' THEN
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes + 5
                        AND actual_delivery_time_in_minutes >> o.promised_delivery_time_in_minutes - 10
                    ELSE
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes + 15
                        AND actual_delivery_time_in_minutes >> o.promised_delivery_time_in_minutes
                END
        END THEN o.order_uid
    END) AS successful_orders_in_pdt,

COUNT(CASE
        WHEN CASE
            WHEN o.promised_delivery_time_in_minutes <<= 40 THEN
                CASE
                    WHEN df_option = 'PRIORITY' THEN
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes - 15
                    ELSE
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes - 10
                END
            ELSE
                CASE
                    WHEN df_option = 'PRIORITY' THEN
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes - 10
                    ELSE
                        actual_delivery_time_in_minutes << o.promised_delivery_time_in_minutes
                END
        END THEN o.order_uid
    END) AS successful_orders_before_pdt,

FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` o 
JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` v USING (global_entity_id, vendor_code)
WHERE o.global_entity_id = 'DJ_CZ'
  AND o.is_successful
  AND o.created_date_local >>=  DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)
  AND v.global_entity_id = "DJ_CZ"
  AND v.chain_name IN (
    'Burger King',
    'Burger King - Plant Based',
    'Pizza Hut',
    'KFC Rozvoz',
    'Starbucks',
    'Těstoviny z pece by Pizza Hut'
  )
  AND v.legal_name IN (
    'AmRest Coffee s.r.o.',
    'AmRest s.r.o.'
  )
  AND o.delivery_type = 'Own Delivery'
GROUP BY ALL]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_3AADBEF8AF0047F5B3AC8DBD0AD2AFE9' table='[Extract].[_3AADBEF8AF0047F5B3AC8DBD0AD2AFE9]' type='table' />
            </properties>
          </object>
          <object caption='vendor_performance' id='vendor_performance_546FC016697641DF8041EF46919E31CD'>
            <properties context=''>
              <relation connection='bigquery.0cjqo6d0sfkxmw14ksn1918kon3h' name='Custom SQL Query1' type='text'>SELECT &#13;
date,&#13;
global_entity_id,&#13;
vendor_code,&#13;
actual_delivery_time_cnt,&#13;
actual_delivery_time_in_minutes,&#13;
active_users_chain,&#13;
active_users_vendor,&#13;
--compensations_resto_amount,&#13;
--compensations_resto_cnt,&#13;
sessions_vendor_shop_detail_loaded,&#13;
rating_food_cnt,&#13;
rating_food_sum,&#13;
failed_orders,&#13;
failed_orders_vendor,&#13;
gmv_local,&#13;
gmv_eur,&#13;
new_customer_vendor,&#13;
successful_orders,&#13;
successful_orders_od,&#13;
promised_delivery_time_cnt,&#13;
promised_delivery_time_in_minutes,&#13;
total_offline_hours,&#13;
total_scheduled_hours&#13;
FROM `damejidlo-cz-bigquery.markets_analytics`.`vendor_performance` `vendor_performance`&#13;
WHERE global_entity_id = &quot;DJ_CZ&quot;&#13;
AND date_dimension = &quot;month&quot;</relation>
            </properties>
            <properties context='extract'>
              <relation name='vendor_performance_546FC016697641DF8041EF46919E31CD' table='[Extract].[vendor_performance_546FC016697641DF8041EF46919E31CD]' type='table' />
            </properties>
          </object>
          <object caption='vendors' id='vendors_ADBD57F8023D4A4F9E0327556E8A0083'>
            <properties context=''>
              <relation connection='bigquery.0cjqo6d0sfkxmw14ksn1918kon3h' name='Custom SQL Query2' type='text'>SELECT&#13;
global_entity_id,&#13;
vendor_code,&#13;
vendor_name,&#13;
chain_code,&#13;
chain_name,&#13;
commission_base,&#13;
vendor_city,&#13;
rating,&#13;
vendor_flags.is_private,&#13;
vendor_flags.is_active,&#13;
sf_vendor_grade,&#13;
legal_name&#13;
FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors`&#13;
WHERE global_entity_id = &quot;DJ_CZ&quot;&#13;
AND NOT vendor_flags.is_private&#13;
AND legal_name IN (&#13;
    &apos;AmRest Coffee s.r.o.&apos;,&#13;
    &apos;AmRest s.r.o.&apos;&#13;
  )&#13;
AND chain_name IN (&#13;
    &apos;Burger King&apos;,&#13;
    &apos;Burger King - Plant Based&apos;,&#13;
    &apos;Pizza Hut&apos;,&#13;
    &apos;KFC Rozvoz&apos;,&#13;
    &apos;Starbucks&apos;,&#13;
    &apos;Těstoviny z pece by Pizza Hut&apos;&#13;
  )</relation>
            </properties>
