      <column caption='Active Vendors WoW' datatype='real' name='[Calculation_1982569050356744196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_active_vendors])/SUM([actual_active_vendors_l7d]) - 1' />
      </column>
      <column caption='Active Vendor WoW+-' datatype='string' name='[Calculation_1982569050357096453]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1982569050356744196] &lt;= 0&#10;THEN &quot;▼ &quot; + STR(ROUND([Calculation_1982569050356744196]*100, 1)) + &quot;%&quot;&#10;ELSEIF [Calculation_1982569050356744196] &gt; 0&#10;THEN &quot;▲ &quot; + STR(ROUND([Calculation_1982569050356744196]*100, 1)) + &quot;%&quot;&#10;END' />
      </column>
      <column caption='index' datatype='integer' name='[Calculation_1982569050357800966]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='is_yesterday' datatype='boolean' name='[Calculation_4631318950196781056]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] = TODAY() - 1' />
      </column>
      <column caption='Main Metric' datatype='integer' name='[Calculation_4631318950199123970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_active_vendors])' />
      </column>
      <column caption='Date Index for L7D' datatype='datetime' name='[Calculation_4631318950200238083]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [report_date] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [report_date])&#10;ELSE [report_date]&#10;END' />
      </column>
      <column caption='Date Display' datatype='string' name='[Calculation_4631318950202413060]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(STR(DATENAME(&apos;month&apos;,[report_date])), 3) + &quot; &quot; + STR(DATEPART(&apos;day&apos;, [report_date]))' />
      </column>
      <column caption='MTD AFV' datatype='real' default-format='c&quot;€&quot;#,##0.0;-&quot;€&quot;#,##0.0' name='[Calculation_5835609637413322752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mtd_gfv_eur]) / SUM([mtd_orders])' />
      </column>
      <column caption='MTD AFV MoM+' datatype='string' name='[Calculation_5835609637414092802]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [MTD AFV (copy)_5835609637413826561] &gt; 0&#10;THEN &quot;▲&quot; + STR(ROUND([MTD AFV (copy)_5835609637413826561]*100,0)) + &quot;%&quot;&#10;END' />
      </column>
      <column caption='MTD New Vendors MoM' datatype='real' name='[Calculation_5835609637416316932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mtd_new_vendors]) / SUM([mtd_new_vendors_lm]) - 1' />
      </column>
      <column caption='MTD CVR MoM' datatype='real' name='[Calculation_5835609637419544590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([mtd_transactions]) / SUM([mtd_sessions])) / (SUM([mtd_transactions_lm])/SUM([mtd_sessions_lm])) - 1' />
      </column>
      <column caption='MTD CVR' datatype='real' default-format='p0.0%' name='[Calculation_5835609637420060689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mtd_transactions]) / SUM([mtd_sessions])' />
      </column>
