        <field-sort-custom-order field='mtd_gfv_eur' />
        <field-sort-custom-order field='mtd_gfv_eur_lm' />
        <field-sort-custom-order field='mtd_gfv_eur_ly' />
        <field-sort-custom-order field='actual_gmv_eur' />
        <field-sort-custom-order field='actual_gmv_eur_l7d' />
        <field-sort-custom-order field='Calculation_5835609637427535895' />
        <field-sort-custom-order field='mtd_gmv_eur' />
        <field-sort-custom-order field='Calculation_5835609637427818520' />
        <field-sort-custom-order field='mtd_gmv_eur_lm' />
        <field-sort-custom-order field='mtd_gmv_eur_ly' />
        <field-sort-custom-order field='actual_sessions' />
        <field-sort-custom-order field='actual_sessions_l7d' />
        <field-sort-custom-order field='mtd_sessions' />
        <field-sort-custom-order field='Calculation_5835609637420060689' />
        <field-sort-custom-order field='Calculation_5835609637419544590' />
        <field-sort-custom-order field='mtd_sessions_lm' />
        <field-sort-custom-order field='mtd_sessions_ly' />
        <field-sort-custom-order field='actual_transactions' />
        <field-sort-custom-order field='actual_transactions_l7d' />
        <field-sort-custom-order field='mtd_transactions' />
        <field-sort-custom-order field='mtd_transactions_lm' />
        <field-sort-custom-order field='mtd_transactions_ly' />
        <field-sort-custom-order field='Geometry (generated)' />
        <field-sort-custom-order field='Latitude (generated)' />
        <field-sort-custom-order field='Longitude (generated)' />
        <field-sort-custom-order field=':Measure Names' />
        <field-sort-custom-order field='Multiple Values' />
      </field-sort-info>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_07F848CB92BA43E7B8E3D79DF02201DB'>
            <properties context=''>
              <relation connection='bigquery.1ucp7d313erc9913z25w21oo05d9' name='Custom SQL Query' type='text'>WITH days_x_country_name AS (
  SELECT DISTINCT
    countries.global_entity_id,
    countries.name AS country_name,
    countries.region,
    report_date,
    business_type,
  FROM UNNEST(
      GENERATE_DATE_ARRAY(
          DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 13 MONTH),
          CURRENT_DATE - 1,
          INTERVAL 1 DAY
      )
  ) AS report_date
  CROSS JOIN `fulfillment-dwh-production.pandata_datamart.pandora__core_countries` AS countries
  CROSS JOIN UNNEST([&quot;pandago&quot;,&quot;restaurants&quot;,&quot;dmart&quot;,&quot;shops&quot;,&quot;concepts&quot;,&quot;others&quot;]) AS business_type
  WHERE countries.region = &quot;Asia&quot;
    AND countries.company_name = &quot;Foodpanda&quot;
    AND NOT global_entity_id LIKE &quot;%ODR%&quot;
),

salesforce_contracts AS (
  SELECT
    contract.global_entity_id,
    agg_vendors.region,
    contract.accountid AS sf_account_id,
    agg_vendors.vendor_code,
    agg_vendors.business_type,
    agg_vendors.sf_account_status AS account_status,
    agg_vendors.vendor_flags.is_test_vendor,
    contract.termination_reason__c AS termination_reason,
    DATE(
      IFNULL(
        contract.end_date__c,
        DATE(TIMESTAMP(DATE(contract.lastmodifieddate)), countries.timezone)
      )
    ) AS report_date
  FROM `fulfillment-dwh-production.curated_data_shared_salesforce.contract` AS contract
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS agg_vendors
         ON agg_vendors.sf_account_id = contract.accountid
        AND contract.global_entity_id = agg_vendors.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__core_countries` AS countries
         ON countries.global_entity_id = contract.global_entity_id
        AND countries.region = &quot;Asia&quot;
        AND countries.company_name = &quot;Foodpanda&quot;
  WHERE agg_vendors.sf_account_status = &quot;Terminated&quot;
    AND NOT contract.termination_reason__c IN (&quot;Onboarding Failed&quot;, &quot;Duplicate&quot;)
    AND NOT agg_vendors.vendor_flags.is_test_vendor
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY
      global_entity_id,
      sf_account_id,
      vendor_code,
      account_status,
      is_test_vendor,
      termination_reason,
      report_date
  ) = 1
),

terminated_vendors AS (
  SELECT DISTINCT
    salesforce_contracts.global_entity_id,
    salesforce_contracts.report_date,
    CASE
      WHEN business_type IN (&quot;restaurants&quot;, &quot;home_based_kitchens&quot;, &quot;caterers&quot;) THEN &quot;restaurants&quot;
      WHEN business_type IN (&quot;concepts&quot;) THEN &quot;concepts&quot;
      WHEN business_type IN (&quot;dmart&quot;) THEN &quot;dmart&quot;
      WHEN business_type IN (&quot;shops&quot;) THEN &quot;shops&quot;
      WHEN business_type IN (&quot;laas_c2c&quot;, &quot;laas_b2c&quot;) THEN &quot;pandago&quot;
      ELSE &quot;others&quot; END
      AS business_type,
    &quot;food delivery&quot; AS vertical_type,
    COUNT(DISTINCT salesforce_contracts.sf_account_id) AS total_terminated_vendors
  FROM salesforce_contracts
  WHERE salesforce_contracts.report_date &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 13 MONTH)
  GROUP BY ALL
),

active_vendors AS (
  SELECT
    status.global_entity_id,
    status.report_date,
    CASE
      WHEN agg_vendors.business_type IN (&quot;restaurants&quot;, &quot;home_based_kitchens&quot;, &quot;caterers&quot;) THEN &quot;restaurants&quot;
      WHEN agg_vendors.business_type IN (&quot;concepts&quot;) THEN &quot;concepts&quot;
      WHEN agg_vendors.business_type IN (&quot;dmart&quot;) THEN &quot;dmart&quot;
      WHEN agg_vendors.business_type IN (&quot;shops&quot;) THEN &quot;shops&quot;
      WHEN agg_vendors.business_type IN (&quot;laas_c2c&quot;, &quot;laas_b2c&quot;) THEN &quot;pandago&quot;
      ELSE &quot;others&quot; END
      AS business_type,
    &quot;food delivery&quot; AS vertical_type,
    COUNT(DISTINCT IF(status.is_active, status.vendor_code, NULL)) AS total_active_vendors,
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__vendor_status_historical` AS status
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS agg_vendors
         ON status.global_entity_id = agg_vendors.global_entity_id
        AND status.vendor_code = agg_vendors.vendor_code
  WHERE NOT status.is_test
    AND status.is_active
    AND (status.is_private IS NULL OR NOT status.is_private)
    AND status.report_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 13 MONTH), MONTH)
    AND agg_vendors.vendor_name NOT LIKE (&quot;%pandago%&quot;)
    AND agg_vendors.business_type NOT IN (&quot;vouchers&quot;, &quot;pandamerchant&quot;)
  GROUP BY ALL
),

new_vendors AS (
  SELECT
    sf_opportunities.global_entity_id,
    sf_opportunities.close_date_local AS report_date,
    CASE
      WHEN agg_vendors.business_type IN (&quot;restaurants&quot;, &quot;home_based_kitchens&quot;, &quot;caterers&quot;) THEN &quot;restaurants&quot;
      WHEN agg_vendors.business_type IN (&quot;concepts&quot;) THEN &quot;concepts&quot;
      WHEN agg_vendors.business_type IN (&quot;dmart&quot;) THEN &quot;dmart&quot;
      WHEN agg_vendors.business_type IN (&quot;shops&quot;) THEN &quot;shops&quot;
      WHEN agg_vendors.business_type IN (&quot;laas_c2c&quot;, &quot;laas_b2c&quot;) THEN &quot;pandago&quot;
      ELSE &quot;others&quot; END
      AS business_type,
    &quot;food delivery&quot; AS vertical_type,
    COUNT(DISTINCT sf_opportunities.opportunity_id) AS total_new_vendors,
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_sf_opportunities` AS sf_opportunities
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS agg_vendors
         ON agg_vendors.sf_account_id = sf_opportunities.sf_account_id
        AND agg_vendors.global_entity_id = sf_opportunities.global_entity_id
  WHERE sf_opportunities.stage_name = &quot;Closed Won&quot;
    AND sf_opportunities.business_type IN (&quot;New Business&quot;, &quot;Owner Change&quot;, &quot;Win Back&quot;)
    AND agg_vendors.region = &quot;Asia&quot;
  GROUP BY ALL
),

agg_orders AS(
  SELECT
    created_date_local AS report_date,
    &quot;FP_&quot; || RIGHT(global_entity_id,2) AS global_entity_id,
    CASE
      WHEN business_type IN (&quot;restaurants&quot;, &quot;home_based_kitchens&quot;, &quot;caterers&quot;) THEN &quot;restaurants&quot;
      WHEN business_type IN (&quot;concepts&quot;) THEN &quot;concepts&quot;
      WHEN business_type IN (&quot;dmart&quot;) THEN &quot;dmart&quot;
      WHEN business_type IN (&quot;shops&quot;) THEN &quot;shops&quot;
      WHEN business_type IN (&quot;laas_c2c&quot;, &quot;laas_b2c&quot;) THEN &quot;pandago&quot;
      ELSE &quot;others&quot; END
      AS business_type,
    CASE
      WHEN business_type IN (&quot;restaurants&quot;, &quot;home_based_kitchens&quot;, &quot;caterers&quot;) AND delivery_type = &quot;pickup&quot; THEN &quot;food pickup&quot;
      WHEN business_type IN (&quot;restaurants&quot;, &quot;home_based_kitchens&quot;, &quot;caterers&quot;) AND delivery_type != &quot;pickup&quot; THEN &quot;food delivery&quot;
      WHEN business_type IN (&quot;dmart&quot;) THEN &quot;dmart&quot;
      WHEN business_type IN (&quot;shops&quot;) THEN &quot;shops&quot;
      WHEN business_type IN (&quot;concepts&quot;) THEN &quot;concepts&quot;
      WHEN business_type IN (&quot;laas_c2c&quot;, &quot;laas_b2c&quot;) THEN &quot;pandago&quot;
      ELSE &quot;others&quot; END
      AS vertical_type,
    COUNT(DISTINCT order_code) AS actual_orders,
    SUM(gfv_eur) AS actual_gfv_eur,
    SUM(user_paid_gmv_eur) AS actual_gmv_eur,
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders`
  WHERE TRUE
    AND region = &quot;Asia&quot;
    AND is_successful
    AND created_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 13 MONTH) AND CURRENT_DATE() - 1
  GROUP BY ALL
),

core_sessions AS(
  SELECT
    DATE(core_sessions.partition_date) AS report_date,
    core_sessions.global_entity_id,
    &quot;restaurants&quot; AS business_type,
    &quot;food delivery&quot; AS vertical_type,
    COUNT(DISTINCT core_sessions.session_key) AS sessions,
    SUM(core_sessions.is_transaction) AS transactions,
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__core_sessions` AS core_sessions
  -- LEFT JOIN UNNEST(core_sessions.vendors) AS core_sessions_vendors
  -- LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS agg_vendors
  --        ON agg_vendors.vendor_code = core_sessions_vendors.vendor_id
  --       AND agg_vendors.global_entity_id = core_sessions.global_entity_id
  WHERE core_sessions.partition_date &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 13 MONTH)
    AND core_sessions.global_entity_id IS NOT NULL
    AND (LOWER(core_sessions.selected_delivery_method) IN (&quot;pickup&quot;, &quot;delivery&quot;) OR core_sessions.selected_delivery_method IS NULL)
  GROUP BY ALL
),

daily_data AS(
  SELECT
    days_x_country_name.report_date,
    DATE_TRUNC(days_x_country_name.report_date, MONTH) AS report_month,
    EXTRACT(DAY FROM days_x_country_name.report_date) AS report_day,
    days_x_country_name.region,
    days_x_country_name.country_name,
    days_x_country_name.business_type,
    IFNULL(agg_orders.vertical_type, days_x_country_name.business_type) AS vertical_type,
    IFNULL(active_vendors.total_active_vendors, 0) AS actual_active_vendors,
    IFNULL(terminated_vendors.total_terminated_vendors, 0) AS actual_terminated_vendors,
    IFNULL(new_vendors.total_new_vendors, 0) AS actual_new_vendors,
    IFNULL(agg_orders.actual_orders, 0) AS actual_orders,
    IFNULL(agg_orders.actual_gfv_eur, 0) AS actual_gfv_eur,
    IFNULL(agg_orders.actual_gmv_eur, 0) AS actual_gmv_eur,
    IFNULL(sessions, 0) AS actual_sessions,
    IFNULL(transactions, 0) AS actual_transactions,

  FROM days_x_country_name
  LEFT JOIN agg_orders
         ON agg_orders.global_entity_id = days_x_country_name.global_entity_id
        AND agg_orders.report_date = days_x_country_name.report_date
        AND agg_orders.business_type = days_x_country_name.business_type
  LEFT JOIN active_vendors
         ON active_vendors.global_entity_id = days_x_country_name.global_entity_id
        AND active_vendors.report_date = days_x_country_name.report_date
        AND active_vendors.business_type = days_x_country_name.business_type
        AND active_vendors.vertical_type = agg_orders.vertical_type
  LEFT JOIN terminated_vendors
         ON terminated_vendors.global_entity_id = days_x_country_name.global_entity_id
        AND terminated_vendors.report_date = days_x_country_name.report_date
        AND terminated_vendors.business_type = days_x_country_name.business_type
        AND terminated_vendors.vertical_type = agg_orders.vertical_type
  LEFT JOIN new_vendors
         ON new_vendors.global_entity_id = days_x_country_name.global_entity_id
        AND new_vendors.report_date = days_x_country_name.report_date
        AND new_vendors.business_type = days_x_country_name.business_type
        AND new_vendors.vertical_type = agg_orders.vertical_type
  LEFT JOIN core_sessions
         ON core_sessions.global_entity_id = days_x_country_name.global_entity_id
        AND core_sessions.report_date = days_x_country_name.report_date
        AND core_sessions.business_type = days_x_country_name.business_type
        AND core_sessions.vertical_type = agg_orders.vertical_type
),

mtd_data AS(
  SELECT
    report_month,
    report_date,
    report_day,
    region,
    country_name,
    business_type,
    vertical_type,
    actual_active_vendors,
    actual_terminated_vendors,
    actual_new_vendors,
    actual_orders,
    actual_gfv_eur,
    actual_gmv_eur,
    actual_sessions,
    actual_transactions,
    SUM(actual_terminated_vendors) OVER(PARTITION BY report_month, country_name, business_type, vertical_type ORDER BY report_date ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS mtd_terminated_vendors,
    SUM(actual_new_vendors) OVER(PARTITION BY report_month, country_name, business_type, vertical_type ORDER BY report_date ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS mtd_new_vendors,
    SUM(actual_orders) OVER(PARTITION BY report_month, country_name, business_type, vertical_type ORDER BY report_date ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS mtd_orders,
    SUM(actual_gfv_eur) OVER(PARTITION BY report_month, country_name, business_type, vertical_type ORDER BY report_date ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS mtd_gfv_eur,
    SUM(actual_gmv_eur) OVER(PARTITION BY report_month, country_name, business_type, vertical_type ORDER BY report_date ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS mtd_gmv_eur,
    SUM(actual_sessions) OVER(PARTITION BY report_month, country_name, business_type, vertical_type ORDER BY report_date ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS mtd_sessions,
    SUM(actual_transactions) OVER(PARTITION BY report_month, country_name, business_type, vertical_type ORDER BY report_date ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS mtd_transactions,

  FROM daily_data
)

SELECT
  mtd_data.report_month,
  mtd_data.report_date,
  mtd_data.report_day,
  mtd_data.region,
  mtd_data.country_name,
  mtd_data.business_type,
  mtd_data.vertical_type,

  mtd_data.actual_active_vendors,
  last_7d.actual_active_vendors AS actual_active_vendors_l7d,

  mtd_data.actual_terminated_vendors,
  last_7d.actual_terminated_vendors AS actual_terminated_vendors_l7d,
  mtd_data.mtd_terminated_vendors,
  COALESCE(last_month.mtd_terminated_vendors, ROUND(SAFE_DIVIDE(last_month_wo_31.mtd_terminated_vendors, last_month_wo_31.report_day) * mtd_data.report_day, 0)) AS mtd_terminated_vendors_lm,
  last_year.mtd_terminated_vendors AS mtd_terminated_vendors_ly,

  mtd_data.actual_new_vendors,
  last_7d.actual_new_vendors AS actual_new_vendors_l7d,
  mtd_data.mtd_new_vendors,
  COALESCE(last_month.mtd_new_vendors, ROUND(SAFE_DIVIDE(last_month_wo_31.mtd_new_vendors, last_month_wo_31.report_day) * mtd_data.report_day, 0)) AS mtd_new_vendors_lm,
  last_year.mtd_new_vendors AS mtd_new_vendors_ly,

  mtd_data.actual_orders,
  last_7d.actual_orders AS actual_orders_l7d,
  mtd_data.mtd_orders,
  COALESCE(last_month.mtd_orders, ROUND(SAFE_DIVIDE(last_month_wo_31.mtd_orders, last_month_wo_31.report_day) * mtd_data.report_day, 0)) AS mtd_orders_lm,
  last_year.mtd_orders AS mtd_orders_ly,

  mtd_data.actual_gfv_eur,
  last_7d.actual_gfv_eur AS actual_gfv_eur_l7d,
  mtd_data.mtd_gfv_eur,
  COALESCE(last_month.mtd_gfv_eur, ROUND(SAFE_DIVIDE(last_month_wo_31.mtd_gfv_eur, last_month_wo_31.report_day) * mtd_data.report_day, 0)) AS mtd_gfv_eur_lm,
  last_year.mtd_gfv_eur AS mtd_gfv_eur_ly,

  mtd_data.actual_gmv_eur,
  last_7d.actual_gmv_eur AS actual_gmv_eur_l7d,
  mtd_data.mtd_gmv_eur,
  COALESCE(last_month.mtd_gmv_eur, ROUND(SAFE_DIVIDE(last_month_wo_31.mtd_gmv_eur, last_month_wo_31.report_day) * mtd_data.report_day, 0)) AS mtd_gmv_eur_lm,
  last_year.mtd_gmv_eur AS mtd_gmv_eur_ly,
  
  mtd_data.actual_sessions,
  last_7d.actual_sessions AS actual_sessions_l7d,
  mtd_data.mtd_sessions,
  COALESCE(last_month.mtd_sessions, ROUND(SAFE_DIVIDE(last_month_wo_31.mtd_sessions, last_month_wo_31.report_day) * mtd_data.report_day, 0)) AS mtd_sessions_lm,
  last_year.mtd_sessions AS mtd_sessions_ly,
  
  mtd_data.actual_transactions,
  last_7d.actual_transactions AS actual_transactions_l7d,
  mtd_data.mtd_transactions,
  COALESCE(last_month.mtd_transactions, ROUND(SAFE_DIVIDE(last_month_wo_31.mtd_transactions, last_month_wo_31.report_day) * mtd_data.report_day, 0)) AS mtd_transactions_lm,
  last_year.mtd_transactions AS mtd_transactions_ly,

FROM mtd_data
LEFT JOIN mtd_data AS last_month
        ON mtd_data.report_month = DATE_ADD(last_month.report_month, INTERVAL 1 MONTH)
      AND mtd_data.report_day = last_month.report_day
      AND mtd_data.country_name = last_month.country_name
      AND mtd_data.business_type = last_month.business_type
      AND mtd_data.vertical_type = last_month.vertical_type
LEFT JOIN mtd_data AS last_month_wo_31
        ON mtd_data.report_month = DATE_ADD(last_month_wo_31.report_month, INTERVAL 1 MONTH)
      AND last_month_wo_31.report_day = EXTRACT(DAY FROM LAST_DAY(last_month_wo_31.report_month))
      AND mtd_data.country_name = last_month_wo_31.country_name
      AND mtd_data.business_type = last_month_wo_31.business_type
      AND mtd_data.vertical_type = last_month_wo_31.vertical_type
LEFT JOIN mtd_data AS last_year
        ON mtd_data.report_month = DATE_ADD(last_year.report_month, INTERVAL 12 MONTH)
      AND mtd_data.report_day = last_year.report_day
      AND mtd_data.country_name = last_year.country_name
      AND mtd_data.business_type = last_year.business_type
      AND mtd_data.vertical_type = last_year.vertical_type
LEFT JOIN mtd_data AS last_7d
        ON mtd_data.report_date = DATE_ADD(last_7d.report_date, INTERVAL 7 DAY)
      AND mtd_data.country_name = last_7d.country_name
      AND mtd_data.business_type = last_7d.business_type
      AND mtd_data.vertical_type = last_7d.vertical_type
WHERE mtd_data.report_date = DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
-- ORDER BY country_name DESC, business_type, vertical_type, report_date DESC</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Country Daily GMV Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='markets__country_kpi_runrates_daily' name='federated.101sw9m1y8n0gd1bve4iy16oz8yd' />
          </datasources>
          <datasource-dependencies datasource='federated.101sw9m1y8n0gd1bve4iy16oz8yd'>
            <column caption='Date Display' datatype='string' name='[Calculation_2427721722797838343]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR(DATENAME(&apos;month&apos;,[reference_date_local])), 3) + &quot; &quot; + STR(DATEPART(&apos;day&apos;, [reference_date_local]))' />
            </column>
            <column caption='Date Weekday' datatype='string' name='[Date Display (copy)_4631318950246416389]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE DATEPART(&apos;weekday&apos;, [reference_date_local])&#10;    WHEN 1 THEN &quot;Sun&quot;&#10;    WHEN 2 THEN &quot;Mon&quot;&#10;    WHEN 3 THEN &quot;Tue&quot;&#10;    WHEN 4 THEN &quot;Wed&quot;&#10;    WHEN 5 THEN &quot;Thu&quot;&#10;    WHEN 6 THEN &quot;Fri&quot;&#10;    WHEN 7 THEN &quot;Sat&quot;&#10;ELSE &quot;&quot; END' />
            </column>
            <column caption='GMV YoY+' datatype='string' name='[GMV WoW+ (copy)_503629151477567494]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Order YoY (copy)_503629151454347266] &gt; 0&#10;THEN &quot;▲&quot; + STR(ROUND([Order YoY (copy)_503629151454347266]*100,1)) + &quot;%&quot;&#10;END' />
            </column>
            <column caption='GMV YoY-' datatype='string' name='[GMV WoW- (copy)_503629151477481477]' role='measure' type='nominal'>
