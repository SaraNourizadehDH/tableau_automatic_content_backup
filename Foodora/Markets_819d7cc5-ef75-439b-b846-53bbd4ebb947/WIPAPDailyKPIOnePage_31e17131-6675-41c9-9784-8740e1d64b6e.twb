      <column caption='Is_Latest 8 Days' datatype='boolean' name='[Calculation_1982569050261925888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reference_date_local] &gt; TODAY()-9' />
      </column>
      <column caption='Orders Actual vs RR Diff%' datatype='real' default-format='p0.0%' name='[Calculation_2427721722793902081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_orders])/SUM([order_rr_for_the_day]) - 1' />
      </column>
      <column caption='Order WoW' datatype='real' default-format='p0.0%' name='[Calculation_2427721722794254338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_orders])/SUM([actual_orders_l7d]) - 1' />
      </column>
      <column caption='Date Display' datatype='string' name='[Calculation_2427721722797838343]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(STR(DATENAME(&apos;month&apos;,[reference_date_local])), 3) + &quot; &quot; + STR(DATEPART(&apos;day&apos;, [reference_date_local]))' />
      </column>
      <column caption='Order WoW+' datatype='string' name='[Calculation_2427721722799050760]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2427721722794254338] &gt; 0&#10;THEN &quot;▲&quot; + STR(ROUND([Calculation_2427721722794254338]*100,1)) + &quot;%&quot;&#10;END' />
      </column>
      <column caption='index' datatype='integer' name='[Calculation_5835609637429633050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='is_this_month' datatype='boolean' name='[Calculation_5835609637473132571]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='MONTH(TODAY()-1) = MONTH([reference_date_local])' />
      </column>
      <column caption='Date Weekday' datatype='string' name='[Date Display (copy)_4631318950246416389]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE DATEPART(&apos;weekday&apos;, [reference_date_local])&#10;    WHEN 1 THEN &quot;Sun&quot;&#10;    WHEN 2 THEN &quot;Mon&quot;&#10;    WHEN 3 THEN &quot;Tue&quot;&#10;    WHEN 4 THEN &quot;Wed&quot;&#10;    WHEN 5 THEN &quot;Thu&quot;&#10;    WHEN 6 THEN &quot;Fri&quot;&#10;    WHEN 7 THEN &quot;Sat&quot;&#10;ELSE &quot;&quot; END' />
      </column>
      <column caption='GMV YoY+' datatype='string' name='[GMV WoW+ (copy)_503629151477567494]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Order YoY (copy)_503629151454347266] &gt; 0&#10;THEN &quot;▲&quot; + STR(ROUND([Order YoY (copy)_503629151454347266]*100,1)) + &quot;%&quot;&#10;END' />
      </column>
      <column caption='GMV YoY-' datatype='string' name='[GMV WoW- (copy)_503629151477481477]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Order YoY (copy)_503629151454347266] &lt;= 0&#10;THEN &quot;▼&quot; + STR(ROUND([Order YoY (copy)_503629151454347266]*100,1)) + &quot;%&quot;&#10;END' />
      </column>
      <column caption='Order YoY' datatype='real' default-format='p0.0%' name='[Order WoW (copy)_2427721722794369027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_orders])/SUM([actual_commission_ly]) - 1' />
      </column>
      <column caption='GMV WoW' datatype='real' default-format='p0.0%' name='[Order WoW (copy)_503629151454216193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_gmv_eur])/SUM([actual_gmv_l7d]) - 1' />
      </column>
      <column caption='Order WoW-' datatype='string' name='[Order WoW+ (copy)_2427721722799271945]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2427721722794254338] &lt;= 0&#10;THEN &quot;▼&quot; + STR(ROUND([Calculation_2427721722794254338]*100,1)) + &quot;%&quot;&#10;END' />
