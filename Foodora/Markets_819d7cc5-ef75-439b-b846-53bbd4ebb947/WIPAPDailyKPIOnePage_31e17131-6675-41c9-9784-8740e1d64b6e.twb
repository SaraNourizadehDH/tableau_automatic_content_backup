    <worksheet name='Overall Daily GMV Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='markets__country_kpi_runrates_daily' name='federated.101sw9m1y8n0gd1bve4iy16oz8yd' />
          </datasources>
          <datasource-dependencies datasource='federated.101sw9m1y8n0gd1bve4iy16oz8yd'>
            <column caption='Date Display' datatype='string' name='[Calculation_2427721722797838343]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR(DATENAME(&apos;month&apos;,[reference_date_local])), 3) + &quot; &quot; + STR(DATEPART(&apos;day&apos;, [reference_date_local]))' />
            </column>
            <column caption='Date Weekday' datatype='string' name='[Date Display (copy)_4631318950246416389]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE DATEPART(&apos;weekday&apos;, [reference_date_local])&#10;    WHEN 1 THEN &quot;Sun&quot;&#10;    WHEN 2 THEN &quot;Mon&quot;&#10;    WHEN 3 THEN &quot;Tue&quot;&#10;    WHEN 4 THEN &quot;Wed&quot;&#10;    WHEN 5 THEN &quot;Thu&quot;&#10;    WHEN 6 THEN &quot;Fri&quot;&#10;    WHEN 7 THEN &quot;Sat&quot;&#10;ELSE &quot;&quot; END' />
            </column>
            <column caption='GMV WoW' datatype='real' default-format='p0.0%' name='[Order WoW (copy)_503629151454216193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_gmv_eur])/SUM([actual_gmv_l7d]) - 1' />
            </column>
            <column caption='GMV YoY' datatype='real' default-format='p0.0%' name='[Order YoY (copy)_503629151454347266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_gmv_eur])/SUM([actual_gmv_ly]) - 1' />
            </column>
            <column caption='GMV Actual vs RR Diff%' datatype='real' default-format='p0.0%' name='[Orders Actual vs RR Diff% (copy)_503629151454003200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_gmv_eur])/SUM([gmv_rr_for_the_day]) - 1' />
            </column>
            <column datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[actual_gmv_eur]' role='measure' type='quantitative' />
            <column datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[actual_gmv_l7d]' role='measure' type='quantitative' />
            <column datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[actual_gmv_ly]' role='measure' type='quantitative' />
            <column-instance column='[Date Display (copy)_4631318950246416389]' derivation='Attribute' name='[attr:Date Display (copy)_4631318950246416389:nk]' pivot='key' type='nominal' />
