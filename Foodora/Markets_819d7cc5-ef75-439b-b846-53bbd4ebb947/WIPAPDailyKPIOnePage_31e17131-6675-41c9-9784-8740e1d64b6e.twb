      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_F4C29B2FB1714C28B0E977630FF9D9FD'>
            <properties context=''>
              <relation connection='bigquery.06pxr8s11ak1y21a6ulfs104xve8' name='Custom SQL Query' type='text'><![CDATA[WITH daily_orders_raw AS(
  SELECT
    dates AS reference_date_local,
    region,
    country_name,
    "FP_" || RIGHT(global_entity_id,2) AS global_entity_id,
    COUNT(DISTINCT order_code) AS actual_orders,
    SUM(COALESCE(user_paid_gmv_eur,0)) AS actual_gmv_eur,
    SUM(COALESCE(estimated_commission_revenue_eur, 0)) AS actual_commission_eur,
  FROM UNNEST(GENERATE_DATE_ARRAY(DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 14 MONTH), CURRENT_DATE() - 1, INTERVAL 1 DAY)) AS dates
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS orders
         ON dates = orders.created_date_local
  WHERE TRUE
    AND region = "Asia"
    AND is_successful
    AND created_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 14 MONTH) AND CURRENT_DATE() - 1
  GROUP BY ALL
),

daily_orders AS(
  SELECT 
    reference_date_local,
    region,
    country_name,
    global_entity_id,
    actual_orders,
    LAG(actual_orders, 7) OVER(PARTITION BY global_entity_id ORDER BY reference_date_local) AS actual_orders_l7d,
    LAG(actual_orders, 364) OVER(PARTITION BY global_entity_id ORDER BY reference_date_local) AS actual_orders_ly,
    SUM(actual_orders) OVER(PARTITION BY DATE_TRUNC(reference_date_local, MONTH), global_entity_id ORDER BY reference_date_local ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS total_actual_mtd_orders,
    actual_gmv_eur,
    LAG(actual_gmv_eur, 7) OVER(PARTITION BY global_entity_id ORDER BY reference_date_local) AS actual_gmv_l7d,
    LAG(actual_gmv_eur, 364) OVER(PARTITION BY global_entity_id ORDER BY reference_date_local) AS actual_gmv_ly,
    SUM(actual_gmv_eur) OVER(PARTITION BY DATE_TRUNC(reference_date_local, MONTH), global_entity_id ORDER BY reference_date_local ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS total_actual_mtd_gmv,
    actual_commission_eur,
    LAG(actual_commission_eur, 7) OVER(PARTITION BY global_entity_id ORDER BY reference_date_local) AS actual_commission_l7d,
    LAG(actual_commission_eur, 364) OVER(PARTITION BY global_entity_id ORDER BY reference_date_local) AS actual_commission_ly,
    SUM(actual_commission_eur) OVER(PARTITION BY DATE_TRUNC(reference_date_local, MONTH), global_entity_id ORDER BY reference_date_local ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS total_actual_mtd_commission,
  FROM daily_orders_raw
),

daily_runrates AS (
  SELECT 
    insert_date AS order_date,
    DATE_TRUNC(order_date, MONTH) AS month,
    global_entity_id,
    SUM(COALESCE(orders,0))+SUM(COALESCE(orders_c2c,0))+SUM(COALESCE(orders_odr,0)) AS orders_rr_eom,
    SUM(COALESCE(gmv_eur,0))+SUM(COALESCE(gmv_c2c_eur,0))+SUM(COALESCE(gmv_odr_eur,0)) AS gmv_rr_eom,
    SUM(COALESCE(commission_eur,0)) AS commission_rr_eom
  FROM `fulfillment-dwh-production.curated_data_shared_intl_markets.historical_runrates` 
  WHERE management_entity_group = 'Foodpanda APAC'
    AND insert_date BETWEEN DATE_TRUNC(IF(EXTRACT(DAY FROM CURRENT_DATE)<<15,CURRENT_DATE-15,CURRENT_DATE), MONTH) AND LAST_DAY(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE))
    AND order_date BETWEEN DATE_TRUNC(IF(EXTRACT(DAY FROM CURRENT_DATE)<<15,CURRENT_DATE-15,CURRENT_DATE), MONTH) AND LAST_DAY(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE))
    AND DATE_TRUNC(insert_date, MONTH) = DATE_TRUNC(order_date, MONTH)
  GROUP BY ALL
),

daily_runrates_breakdowns AS(
  SELECT
    order_date,
    global_entity_id,
    SUM(COALESCE(orders,0))+SUM(COALESCE(orders_c2c,0)) AS order_rr_for_the_day,
    SUM(COALESCE(gmv_eur,0))+SUM(COALESCE(gmv_c2c_eur,0)) AS gmv_rr_for_the_day,
    SUM(COALESCE(commission_eur,0)) AS commission_rr_for_the_day,
    -- SUM(runrates.orders_cum) AS order_rr_td, -- cumulative totals of RR for the day
    -- SUM(runrates.gmv_eur_cum) AS gmv_rr_td,
  FROM `fulfillment-dwh-production.curated_data_shared_intl_markets.runrates` AS runrates
  GROUP BY ALL
),

latest_runrates AS (
  SELECT
    DATE_TRUNC(order_date, MONTH) AS order_month,
    global_entity_id,
    SUM(COALESCE(orders,0))+SUM(COALESCE(orders_c2c,0))+SUM(COALESCE(orders_odr,0)) AS orders_rr_eom_latest,
    SUM(COALESCE(gmv_eur,0))+SUM(COALESCE(gmv_c2c_eur,0))+SUM(COALESCE(gmv_odr_eur,0)) AS gmv_rr_eom_latest,
    SUM(COALESCE(commission_eur,0)) AS commission_rr_eom_latest,
  FROM `fulfillment-dwh-production.curated_data_shared_intl_markets.historical_runrates`
  WHERE management_entity_group = "Foodpanda APAC"
    AND insert_date = CURRENT_DATE("Asia/Manila") - 1
    AND order_date BETWEEN DATE_TRUNC(IF(EXTRACT(DAY FROM CURRENT_DATE)<<15,CURRENT_DATE-15,CURRENT_DATE), MONTH) AND LAST_DAY(IF(EXTRACT(DAY FROM CURRENT_DATE)=1,CURRENT_DATE-1,CURRENT_DATE))
  GROUP BY ALL
)

SELECT
  daily_orders.reference_date_local,
  daily_orders.region,
  daily_orders.country_name,
  daily_orders.global_entity_id,

  daily_orders.actual_orders,
  daily_orders.actual_orders_l7d,
  daily_orders.actual_orders_ly,
  daily_orders.total_actual_mtd_orders,
  daily_runrates.orders_rr_eom,
  latest_runrates.orders_rr_eom_latest,
  daily_runrates_breakdowns.order_rr_for_the_day,
  
  daily_orders.actual_gmv_eur,
  daily_orders.actual_gmv_l7d,
  daily_orders.actual_gmv_ly,
  daily_orders.total_actual_mtd_gmv,
  daily_runrates.gmv_rr_eom,
  latest_runrates.gmv_rr_eom_latest,
  daily_runrates_breakdowns.gmv_rr_for_the_day,

  daily_orders.actual_commission_eur,
  daily_orders.actual_commission_l7d,
  daily_orders.actual_commission_ly,
  daily_orders.total_actual_mtd_commission,
  daily_runrates.commission_rr_eom,
  latest_runrates.commission_rr_eom_latest,
  daily_runrates_breakdowns.commission_rr_for_the_day,

FROM daily_orders
LEFT JOIN daily_runrates
       ON daily_runrates.order_date = daily_orders.reference_date_local
      AND daily_runrates.global_entity_id = daily_orders.global_entity_id
LEFT JOIN latest_runrates
       ON latest_runrates.order_month = DATE_TRUNC(daily_orders.reference_date_local, MONTH)
      AND latest_runrates.global_entity_id = daily_orders.global_entity_id
LEFT JOIN daily_runrates_breakdowns
       ON daily_runrates_breakdowns.order_date = daily_orders.reference_date_local
      AND daily_runrates_breakdowns.global_entity_id = daily_orders.global_entity_id
WHERE daily_orders.reference_date_local BETWEEN 
    DATE_TRUNC(IF(EXTRACT(DAY FROM CURRENT_DATE)<<15,CURRENT_DATE-15,CURRENT_DATE), MONTH)
    AND LAST_DAY(IF(EXTRACT(DAY FROM CURRENT_DATE)=1,CURRENT_DATE-1,CURRENT_DATE))
-- ORDER BY global_entity_id, reference_date_local]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='markets__overall_kpi_runrates_mtd' inline='true' name='federated.0bvzoaj1nvcmqc12ti9u71jdxs9m' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1bc2eei0t18jfk1cmbwzw1c3in8w'>
            <connection CATALOG='pd-data--adhoc' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandora Data Adhoc' schema='sandbox__pd_markets_apac' server-oauth='' username='tina.hsieh@foodpanda.tw' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1bc2eei0t18jfk1cmbwzw1c3in8w' name='Custom SQL Query' type='text'><![CDATA[WITH raw_orders AS(
  SELECT
    DATE_TRUNC(dates, MONTH) AS report_month,
    dates AS report_date,
    EXTRACT(DAY FROM dates) AS report_day,
    region,
    country_name,
    "FP_" || RIGHT(global_entity_id,2) AS global_entity_id,
    COUNT(DISTINCT order_code) AS actual_orders,
    SUM(IFNULL(user_paid_gmv_eur,0)) AS actual_gmv_eur,
    SUM(IFNULL(estimated_commission_revenue_eur, 0) + IFNULL(dps_delivery_fee_eur, 0)) AS actual_revenue_eur,
  FROM UNNEST(GENERATE_DATE_ARRAY(DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 14 MONTH), CURRENT_DATE() - 1, INTERVAL 1 DAY)) AS dates
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS orders
         ON dates = orders.created_date_local
  WHERE TRUE
    AND region = "Asia"
    AND is_successful
    AND created_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 14 MONTH) AND CURRENT_DATE() - 1
  GROUP BY ALL
),

daily_orders AS(
  SELECT
    report_month,
    report_date,
    report_day,
    SUM(actual_orders) AS actual_orders,
    SUM(actual_gmv_eur) AS actual_gmv_eur,
    SUM(actual_revenue_eur) AS actual_revenue_eur,
  FROM raw_orders
  GROUP BY ALL
),

mtd_orders AS(
  SELECT
    report_month,
    report_date,
    report_day,
    actual_orders,
    actual_gmv_eur,
    actual_revenue_eur,
    SUM(actual_orders) OVER(PARTITION BY report_month ORDER BY report_date ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS mtd_orders,
    SUM(actual_gmv_eur) OVER(PARTITION BY report_month ORDER BY report_date ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS mtd_gmv,
    SUM(actual_revenue_eur) OVER(PARTITION BY report_month ORDER BY report_date ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS mtd_revenue,
  FROM daily_orders
),

mtd_orders_result AS(
  SELECT
    mtd_orders.report_month,
    mtd_orders.report_date,
    mtd_orders.report_day,

    mtd_orders.mtd_orders,
    COALESCE(last_month.mtd_orders, SAFE_DIVIDE(last_month_wo_31.mtd_orders, last_month_wo_31.report_day) * mtd_orders.report_day) AS mtd_orders_lm,
    last_year.mtd_orders AS mtd_orders_ly,

    mtd_orders.mtd_gmv,
    COALESCE(last_month.mtd_gmv, SAFE_DIVIDE(last_month_wo_31.mtd_gmv, last_month_wo_31.report_day) * mtd_orders.report_day) AS mtd_gmv_lm,
    last_year.mtd_gmv AS mtd_gmv_ly,

    mtd_orders.mtd_revenue,
    COALESCE(last_month.mtd_revenue, SAFE_DIVIDE(last_month_wo_31.mtd_revenue, last_month_wo_31.report_day) * mtd_orders.report_day) AS mtd_revenue_lm,
    last_year.mtd_revenue AS mtd_revenue_ly,

  FROM mtd_orders
  LEFT JOIN mtd_orders AS last_month
         ON mtd_orders.report_month = DATE_ADD(last_month.report_month, INTERVAL 1 MONTH)
        AND mtd_orders.report_day = last_month.report_day
  LEFT JOIN mtd_orders AS last_month_wo_31
         ON mtd_orders.report_month = DATE_ADD(last_month_wo_31.report_month, INTERVAL 1 MONTH)
        AND last_month_wo_31.report_day = EXTRACT(DAY FROM LAST_DAY(last_month_wo_31.report_month))
  LEFT JOIN mtd_orders AS last_year
         ON mtd_orders.report_month = DATE_ADD(last_year.report_month, INTERVAL 12 MONTH)
        AND mtd_orders.report_day = last_year.report_day
  WHERE mtd_orders.report_day = EXTRACT(DAY FROM CURRENT_DATE()-1)
),

runrates AS(
  SELECT
    DATE_TRUNC(order_date, MONTH) AS report_month,
    CASE
      WHEN EXTRACT(DAY FROM CURRENT_DATE)=1 AND EXTRACT (MONTH FROM DATE_TRUNC(order_date, MONTH)) = EXTRACT (MONTH FROM CURRENT_DATE()-1) THEN "MTD"
      WHEN EXTRACT(DAY FROM CURRENT_DATE)<<>>1 AND EXTRACT (MONTH FROM DATE_TRUNC(order_date, MONTH)) = EXTRACT (MONTH FROM CURRENT_DATE()) THEN "MTD"
      ELSE "PMTD"
      END AS period,
    SUM(COALESCE(orders,0))+SUM(COALESCE(orders_c2c,0))+SUM(COALESCE(orders_odr,0)) AS orders_runrate_eom,
    SUM(COALESCE(gmv_eur,0))+SUM(COALESCE(gmv_c2c_eur,0))+SUM(COALESCE(gmv_odr_eur,0)) AS gmv_runrate_eom,
    SUM(COALESCE(commission_eur,0)) AS revenue_runrate_eom,

  FROM `fulfillment-dwh-production.curated_data_shared_intl_markets.historical_runrates`
  WHERE management_entity_group = "Foodpanda APAC"
    AND insert_date = CURRENT_DATE("Asia/Manila") - 1 -- extract the latest version
    AND order_date BETWEEN DATE_SUB(DATE_TRUNC(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE), MONTH), INTERVAL 1 MONTH)
                      AND LAST_DAY(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE))
  GROUP BY ALL
),

summary AS (
  SELECT 
    mtd_orders_result.report_month,
    runrates.period,

    mtd_orders_result.mtd_orders,
    mtd_orders_result.mtd_orders_lm,
    mtd_orders_result.mtd_orders_ly,
    runrates.orders_runrate_eom,
    LAG(runrates.orders_runrate_eom, 1) OVER(ORDER BY runrates.report_month ASC) AS orders_runrate_eom_lm,

    mtd_orders_result.mtd_gmv,
    mtd_orders_result.mtd_gmv_lm,
    mtd_orders_result.mtd_gmv_ly,
    runrates.gmv_runrate_eom,
    LAG(runrates.gmv_runrate_eom, 1) OVER(ORDER BY runrates.report_month ASC) AS gmv_runrate_eom_lm,

    mtd_orders_result.mtd_revenue,
    mtd_orders_result.mtd_revenue_lm,
    mtd_orders_result.mtd_revenue_ly,
    runrates.revenue_runrate_eom,
    LAG(runrates.revenue_runrate_eom, 1) OVER(ORDER BY runrates.report_month ASC) AS revenue_runrate_eom_lm,
    
  FROM mtd_orders_result
  LEFT JOIN runrates
         ON mtd_orders_result.report_month = runrates.report_month
)

SELECT *
FROM summary
WHERE report_month >>= DATE_TRUNC(CURRENT_DATE()-1, MONTH)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1bc2eei0t18jfk1cmbwzw1c3in8w' name='Custom SQL Query' type='text'><![CDATA[WITH raw_orders AS(
  SELECT
    DATE_TRUNC(dates, MONTH) AS report_month,
    dates AS report_date,
    EXTRACT(DAY FROM dates) AS report_day,
    region,
    country_name,
    "FP_" || RIGHT(global_entity_id,2) AS global_entity_id,
    COUNT(DISTINCT order_code) AS actual_orders,
    SUM(IFNULL(user_paid_gmv_eur,0)) AS actual_gmv_eur,
    SUM(IFNULL(estimated_commission_revenue_eur, 0) + IFNULL(dps_delivery_fee_eur, 0)) AS actual_revenue_eur,
  FROM UNNEST(GENERATE_DATE_ARRAY(DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 14 MONTH), CURRENT_DATE() - 1, INTERVAL 1 DAY)) AS dates
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS orders
         ON dates = orders.created_date_local
  WHERE TRUE
    AND region = "Asia"
    AND is_successful
    AND created_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 14 MONTH) AND CURRENT_DATE() - 1
  GROUP BY ALL
),

daily_orders AS(
  SELECT
    report_month,
    report_date,
    report_day,
    SUM(actual_orders) AS actual_orders,
    SUM(actual_gmv_eur) AS actual_gmv_eur,
    SUM(actual_revenue_eur) AS actual_revenue_eur,
  FROM raw_orders
  GROUP BY ALL
),

mtd_orders AS(
  SELECT
    report_month,
    report_date,
    report_day,
    actual_orders,
    actual_gmv_eur,
    actual_revenue_eur,
    SUM(actual_orders) OVER(PARTITION BY report_month ORDER BY report_date ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS mtd_orders,
    SUM(actual_gmv_eur) OVER(PARTITION BY report_month ORDER BY report_date ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS mtd_gmv,
    SUM(actual_revenue_eur) OVER(PARTITION BY report_month ORDER BY report_date ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS mtd_revenue,
  FROM daily_orders
),

mtd_orders_result AS(
  SELECT
    mtd_orders.report_month,
    mtd_orders.report_date,
    mtd_orders.report_day,

    mtd_orders.mtd_orders,
    COALESCE(last_month.mtd_orders, SAFE_DIVIDE(last_month_wo_31.mtd_orders, last_month_wo_31.report_day) * mtd_orders.report_day) AS mtd_orders_lm,
    last_year.mtd_orders AS mtd_orders_ly,

    mtd_orders.mtd_gmv,
    COALESCE(last_month.mtd_gmv, SAFE_DIVIDE(last_month_wo_31.mtd_gmv, last_month_wo_31.report_day) * mtd_orders.report_day) AS mtd_gmv_lm,
    last_year.mtd_gmv AS mtd_gmv_ly,

    mtd_orders.mtd_revenue,
    COALESCE(last_month.mtd_revenue, SAFE_DIVIDE(last_month_wo_31.mtd_revenue, last_month_wo_31.report_day) * mtd_orders.report_day) AS mtd_revenue_lm,
    last_year.mtd_revenue AS mtd_revenue_ly,

  FROM mtd_orders
  LEFT JOIN mtd_orders AS last_month
         ON mtd_orders.report_month = DATE_ADD(last_month.report_month, INTERVAL 1 MONTH)
        AND mtd_orders.report_day = last_month.report_day
  LEFT JOIN mtd_orders AS last_month_wo_31
         ON mtd_orders.report_month = DATE_ADD(last_month_wo_31.report_month, INTERVAL 1 MONTH)
        AND last_month_wo_31.report_day = EXTRACT(DAY FROM LAST_DAY(last_month_wo_31.report_month))
  LEFT JOIN mtd_orders AS last_year
         ON mtd_orders.report_month = DATE_ADD(last_year.report_month, INTERVAL 12 MONTH)
        AND mtd_orders.report_day = last_year.report_day
  WHERE mtd_orders.report_day = EXTRACT(DAY FROM CURRENT_DATE()-1)
),

runrates AS(
  SELECT
    DATE_TRUNC(order_date, MONTH) AS report_month,
    CASE
      WHEN EXTRACT(DAY FROM CURRENT_DATE)=1 AND EXTRACT (MONTH FROM DATE_TRUNC(order_date, MONTH)) = EXTRACT (MONTH FROM CURRENT_DATE()-1) THEN "MTD"
      WHEN EXTRACT(DAY FROM CURRENT_DATE)<<>>1 AND EXTRACT (MONTH FROM DATE_TRUNC(order_date, MONTH)) = EXTRACT (MONTH FROM CURRENT_DATE()) THEN "MTD"
      ELSE "PMTD"
      END AS period,
    SUM(COALESCE(orders,0))+SUM(COALESCE(orders_c2c,0))+SUM(COALESCE(orders_odr,0)) AS orders_runrate_eom,
    SUM(COALESCE(gmv_eur,0))+SUM(COALESCE(gmv_c2c_eur,0))+SUM(COALESCE(gmv_odr_eur,0)) AS gmv_runrate_eom,
    SUM(COALESCE(commission_eur,0)) AS revenue_runrate_eom,

  FROM `fulfillment-dwh-production.curated_data_shared_intl_markets.historical_runrates`
  WHERE management_entity_group = "Foodpanda APAC"
    AND insert_date = CURRENT_DATE("Asia/Manila") - 1 -- extract the latest version
    AND order_date BETWEEN DATE_SUB(DATE_TRUNC(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE), MONTH), INTERVAL 1 MONTH)
                      AND LAST_DAY(IF(EXTRACT(DAY FROM CURRENT_DATE())=1,CURRENT_DATE-1,CURRENT_DATE))
  GROUP BY ALL
),

summary AS (
  SELECT 
    mtd_orders_result.report_month,
    runrates.period,

    mtd_orders_result.mtd_orders,
    mtd_orders_result.mtd_orders_lm,
    mtd_orders_result.mtd_orders_ly,
    runrates.orders_runrate_eom,
    LAG(runrates.orders_runrate_eom, 1) OVER(ORDER BY runrates.report_month ASC) AS orders_runrate_eom_lm,

    mtd_orders_result.mtd_gmv,
    mtd_orders_result.mtd_gmv_lm,
    mtd_orders_result.mtd_gmv_ly,
    runrates.gmv_runrate_eom,
    LAG(runrates.gmv_runrate_eom, 1) OVER(ORDER BY runrates.report_month ASC) AS gmv_runrate_eom_lm,

    mtd_orders_result.mtd_revenue,
    mtd_orders_result.mtd_revenue_lm,
    mtd_orders_result.mtd_revenue_ly,
    runrates.revenue_runrate_eom,
    LAG(runrates.revenue_runrate_eom, 1) OVER(ORDER BY runrates.report_month ASC) AS revenue_runrate_eom_lm,
    
  FROM mtd_orders_result
  LEFT JOIN runrates
         ON mtd_orders_result.report_month = runrates.report_month
)

SELECT *
FROM summary
WHERE report_month >>= DATE_TRUNC(CURRENT_DATE()-1, MONTH)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
