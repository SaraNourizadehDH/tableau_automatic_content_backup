      <column caption='MTD Orders MoM' datatype='real' default-format='p0.0%' name='[Calculation_2427721722834161677]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND([mtd_orders]/[mtd_orders_lm] - 1, 4)' />
      </column>
      <column caption='Orders RR MoM' datatype='real' default-format='p0.0%' name='[Calculation_2427721722834448399]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND([orders_runrate_eom]/[orders_runrate_eom_lm] - 1, 4)' />
      </column>
      <column caption='Orders RR MoM+' datatype='string' name='[Calculation_2867315267719004160]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2427721722834448399] &gt; 0&#10;THEN &quot;▲&quot; + STR(ROUND([Calculation_2427721722834448399]*100, 0)) + &quot;%&quot;&#10;END' />
      </column>
      <column caption='MTD Rev/GMV' datatype='real' default-format='c&quot;€&quot;#,##0.0;-&quot;€&quot;#,##0.0' name='[Calculation_4646237120884887565]' role='measure' type='quantitative'>
