      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_ADB5C9B1B0554CF884D65AAB8B67E2DB'>
            <properties context=''>
              <relation connection='bigquery.0c1qscf1eyjgz615s2svg1afxr5v' name='Custom SQL Query' type='text'><![CDATA[WITH raw_segment AS(
  SELECT
    agg_orders.global_entity_id,
    agg_orders.region,
    core_countries.name AS country_name,
    EXTRACT(YEAR FROM agg_orders.created_date_local) AS report_year,
    DATE_TRUNC(agg_orders.created_date_local, MONTH) AS report_month,
    COUNT(DISTINCT agg_orders.created_date_local) AS days_of_month,
    COUNT(DISTINCT CASE WHEN agg_orders.is_successful THEN agg_orders.analytical_customer_id ELSE NULL END) AS active_customers,
    COUNT(DISTINCT CASE WHEN agg_orders.is_acquisition THEN agg_orders.analytical_customer_id ELSE NULL END) AS acquisitions,
    COUNT(DISTINCT CASE WHEN DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY) >>= 365 THEN agg_orders.analytical_customer_id ELSE NULL END) AS reacquisitions,
    COUNT(DISTINCT CASE WHEN agg_orders.is_successful THEN agg_orders.analytical_customer_id ELSE NULL END) - COUNT(DISTINCT CASE WHEN agg_orders.is_acquisition THEN agg_orders.analytical_customer_id ELSE NULL END) AS returning,
    COUNT(DISTINCT CASE WHEN ((CASE
          WHEN agg_orders.global_entity_id = "DJ_CZ" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 82 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 177 THEN TRUE
          WHEN agg_orders.global_entity_id = "FO_NO" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 95 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 201 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_SK" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 105 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 201 THEN TRUE
          WHEN agg_orders.global_entity_id = "HN_DK" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 99 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 204 THEN TRUE
          WHEN agg_orders.global_entity_id = "MJM_AT" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 63 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 139 THEN TRUE
          WHEN agg_orders.global_entity_id = "NP_HU" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 67 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 150 THEN TRUE
          WHEN agg_orders.global_entity_id = "OP_SE" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 72 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 160 THEN TRUE
          WHEN agg_orders.global_entity_id = "PO_FI" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 87 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 172 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_BD" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 81 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 183 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_HK" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 62 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 148 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_KH" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 70 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 163 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_LA" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 80 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 182 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_MM" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 66 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 159 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_MY" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 66 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 148 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_PH" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 65 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 152 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_PK" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 72 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 168 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_SG" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 66 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 150 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_TH" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 73 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 162 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_TW" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 61 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 139 THEN TRUE
          WHEN agg_orders.global_entity_id = "YS_TR" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 70 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 167 THEN TRUE
          ELSE FALSE END)
      OR (CASE
          WHEN agg_orders.global_entity_id = "DJ_CZ" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 177 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "FO_NO" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 201 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_SK" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 201 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "HN_DK" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 204 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "MJM_AT" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 139 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "NP_HU" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 150 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "OP_SE" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 160 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "PO_FI" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 172 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_BD" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 183 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_HK" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 148 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_KH" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 163 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_LA" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 182 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_MM" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 159 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_MY" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 148 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_PH" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 152 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_PK" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 168 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_SG" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 150 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_TH" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 162 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "FP_TW" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 139 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          WHEN agg_orders.global_entity_id = "YS_TR" AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) >>= 167 AND (DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY)) << 365 THEN TRUE
          ELSE FALSE END)
      OR (CASE WHEN DATE_DIFF(agg_orders.created_date_local ,agg_orders.previous_order_date, DAY) >>= 365 THEN TRUE
         ELSE FALSE END)) THEN agg_orders.analytical_customer_id ELSE NULL END) AS reactivations,
    
FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS agg_orders
INNER JOIN `fulfillment-dwh-production.pandata_datamart.pandora__core_countries` AS core_countries 
        ON agg_orders.global_entity_id = core_countries.global_entity_id
WHERE TRUE
  AND agg_orders.created_date_local >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 18 MONTH)
  AND (CASE WHEN agg_orders.global_entity_id LIKE 'ODR%' THEN 'ODR' ELSE 'Exclude ODR' END ) = 'Exclude ODR'
  AND agg_orders.is_successful
GROUP BY ALL
)

, segment AS(
  SELECT
    global_entity_id,
    region,
    country_name,
    report_year,
    report_month,
    days_of_month,
    active_customers,
    acquisitions,
    reacquisitions,
    returning,
    reactivations AS reactivations_with_reacq,
    reactivations - reacquisitions AS reactivation,
    returning - reactivations AS retained,
  FROM raw_segment
)

, segment_past AS(
  SELECT
    global_entity_id,
    region,
    country_name,
    report_year,
    report_month,
    days_of_month,
    LAG(days_of_month, 1)  OVER(PARTITION BY global_entity_id, country_name ORDER BY report_month ASC) AS days_of_month_l1m,

    active_customers,
    LAG(active_customers, 1)  OVER(PARTITION BY global_entity_id, country_name ORDER BY report_month ASC) AS active_customers_l1m,
    LAG(active_customers, 12) OVER(PARTITION BY global_entity_id, country_name ORDER BY report_month ASC) AS active_customers_l1y,
    acquisitions,
    LAG(acquisitions, 1)  OVER(PARTITION BY global_entity_id, country_name ORDER BY report_month ASC) AS acquisitions_l1m,
    LAG(acquisitions, 12) OVER(PARTITION BY global_entity_id, country_name ORDER BY report_month ASC) AS acquisitions_l1y,
    reacquisitions,
    LAG(reacquisitions, 1)  OVER(PARTITION BY global_entity_id, country_name ORDER BY report_month ASC) AS reacquisitions_l1m,
    LAG(reacquisitions, 12) OVER(PARTITION BY global_entity_id, country_name ORDER BY report_month ASC) AS reacquisitions_l1y,
    reactivation,
    LAG(reactivation, 1)  OVER(PARTITION BY global_entity_id, country_name ORDER BY report_month ASC) AS reactivation_l1m,
    LAG(reactivation, 12) OVER(PARTITION BY global_entity_id, country_name ORDER BY report_month ASC) AS reactivation_l1y,
    retained,
    LAG(retained, 1)  OVER(PARTITION BY global_entity_id, country_name ORDER BY report_month ASC) AS retained_l1m,
    LAG(retained, 12) OVER(PARTITION BY global_entity_id, country_name ORDER BY report_month ASC) AS retained_l1y,

  FROM segment
)

SELECT
  "active_customers" AS metric,
  global_entity_id,
  region,
  country_name,
  report_year,
  report_month,
  days_of_month,
  active_customers AS actual,
  ROUND(SAFE_DIVIDE(active_customers, active_customers), 4) AS pct_of_mau,
  active_customers - active_customers_l1m AS mom_abs,
  ROUND(SAFE_DIVIDE(SAFE_DIVIDE(active_customers, days_of_month), SAFE_DIVIDE(active_customers_l1m, days_of_month_l1m)) - 1, 4) AS mom_pct_daily_avg,
  active_customers - active_customers_l1y AS yoy_abs,
  ROUND(SAFE_DIVIDE(active_customers, active_customers_l1y) - 1, 4) AS yoy_pct,

FROM segment_past

UNION ALL

SELECT
  "acquisitions" AS metric,
  global_entity_id,
  region,
  country_name,
  report_year,
  report_month,
  days_of_month,
  acquisitions AS actual,
  ROUND(SAFE_DIVIDE(acquisitions, active_customers), 4) AS pct_of_mau,
  acquisitions - acquisitions_l1m AS mom_abs,
  ROUND(SAFE_DIVIDE(SAFE_DIVIDE(acquisitions, days_of_month), SAFE_DIVIDE(acquisitions_l1m, days_of_month_l1m)) - 1, 4) AS mom_pct_daily_avg,
  acquisitions - acquisitions_l1y AS yoy_abs,
  ROUND(SAFE_DIVIDE(acquisitions, acquisitions_l1y) - 1, 4) AS yoy_pct,

FROM segment_past

UNION ALL

SELECT
  "reacquisitions" AS metric,
  global_entity_id,
  region,
  country_name,
  report_year,
  report_month,
  days_of_month,
  reacquisitions AS actual,
  ROUND(SAFE_DIVIDE(reacquisitions, active_customers), 4) AS pct_of_mau,
  reacquisitions - reacquisitions_l1m AS mom_abs,
  ROUND(SAFE_DIVIDE(SAFE_DIVIDE(reacquisitions, days_of_month), SAFE_DIVIDE(reacquisitions_l1m, days_of_month_l1m)) - 1, 4) AS mom_pct_daily_avg,
  reacquisitions - reacquisitions_l1y AS yoy_abs,
  ROUND(SAFE_DIVIDE(reacquisitions, reacquisitions_l1y) - 1, 4) AS yoy_pct,

FROM segment_past

UNION ALL

SELECT
  "reactivation" AS metric,
  global_entity_id,
  region,
  country_name,
  report_year,
  report_month,
  days_of_month,
  reactivation AS actual,
  ROUND(SAFE_DIVIDE(reactivation, active_customers), 4) AS pct_of_mau,
  reactivation - reactivation_l1m AS mom_abs,
  ROUND(SAFE_DIVIDE(SAFE_DIVIDE(reactivation, days_of_month), SAFE_DIVIDE(reactivation_l1m, days_of_month_l1m)) - 1, 4) AS mom_pct_daily_avg,
  reactivation - reactivation_l1y AS yoy_abs,
  ROUND(SAFE_DIVIDE(reactivation, reactivation_l1y) - 1, 4) AS yoy_pct,

FROM segment_past

UNION ALL

SELECT
  "retained" AS metric,
  global_entity_id,
  region,
  country_name,
  report_year,
  report_month,
  days_of_month,
  retained AS actual,
  ROUND(SAFE_DIVIDE(retained, active_customers), 4) AS pct_of_mau,
  retained - retained_l1m AS mom_abs,
  ROUND(SAFE_DIVIDE(SAFE_DIVIDE(retained, days_of_month), SAFE_DIVIDE(retained_l1m, days_of_month_l1m)) - 1, 4) AS mom_pct_daily_avg,
  retained - retained_l1y AS yoy_abs,
  ROUND(SAFE_DIVIDE(retained, retained_l1y) - 1, 4) AS yoy_pct,

FROM segment_past
ORDER BY country_name, report_month DESC, metric]]></relation>
