      <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0s1c1w01jfapk91ekr49a0y4rjcu].[report_month]' caption='Year Month' datatype='date' default-format='*yyyy-mm' name='[report_month Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-01#'>
