      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_9CB6BBB28B0548659B576629C791AA17'>
            <properties context=''>
              <relation connection='bigquery.1cbjw5x08ud1ka14zt3ut076u0j7' name='Custom SQL Query' type='text'>WITH daily_surge_experience AS (&#13;
  SELECT&#13;
    global_entity_id,&#13;
    lg_country_code,city_name, zone_name,&#13;
    created_date_local,&#13;
    COUNT(CASE WHEN is_surged THEN order_code END) AS surged_order_experience,&#13;
    COUNT(CASE WHEN is_surged_1 THEN order_code END) AS surged_1st_order_experience,&#13;
    COUNT(CASE WHEN is_surged_2 THEN order_code END) AS surged_2nd_order_experience,&#13;
    COUNT(CASE WHEN is_surged_3 THEN order_code END) AS surged_3rd_order_experience,&#13;
    COUNT(CASE WHEN is_surged_4 THEN order_code END) AS surged_4th_order_experience,&#13;
    COUNT(CASE WHEN is_surged_above_4 THEN order_code END) AS surged_above_4_order_experience,&#13;
    COUNT(order_code) AS actual_orders&#13;
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_surged_orders_experienced`  &#13;
  WHERE created_date_local &gt;&gt;=  DATE_SUB(CURRENT_DATE, INTERVAL 12 WEEK)&#13;
    AND lg_zone_id IS NOT NULL&#13;
  GROUP BY 1,2,3,4,5&#13;
),&#13;
&#13;
daily_shrink_close_events AS (&#13;
  SELECT &#13;
    global_entity_id,lg_country_code, city_name, zone_name,&#13;
    date_local,&#13;
        SUM(forecasted_orders) AS forecasted_orders,&#13;
    SUM(shrink_orders) AS shrink_orders,&#13;
    SUM(shrink_0_orders) AS shrink_0_orders,&#13;
    SUM(shrink_1st_orders) AS shrink_1st_orders,&#13;
    SUM(shrink_2nd_orders) AS shrink_2nd_orders,&#13;
    SUM(shrink_3rd_orders) AS shrink_3rd_orders,&#13;
    SUM(shrink_4th_orders) AS shrink_4th_orders,&#13;
    SUM(shrink_5th_orders) AS shrink_5th_orders,&#13;
    SUM(shrink_6th_orders) AS shrink_6th_orders,&#13;
    SUM(close_orders) AS close_orders&#13;
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_weighted_das_events_hourly` &#13;
  WHERE date_local &gt;&gt;=  DATE_SUB(CURRENT_DATE, INTERVAL 12 WEEK)&#13;
  GROUP BY 1,2,3,4,5&#13;
)&#13;
&#13;
SELECT &#13;
  surge.global_entity_id,&#13;
  surge.lg_country_code AS country_code,&#13;
  surge.city_name,&#13;
  surge.zone_name,&#13;
  surge.created_date_local as date,&#13;
 SUM(surge.actual_orders) AS actual_orders,&#13;
  SUM(shrink_close.forecasted_orders) AS forecasted_orders,&#13;
  SUM(shrink_close.shrink_0_orders)as shrink0,&#13;
  SUM(shrink_close.shrink_1st_orders) as shrink1,&#13;
  SUM(shrink_close.shrink_2nd_orders)as shrink2,&#13;
  SUM(shrink_close.shrink_3rd_orders) as shrink3,&#13;
  SUM(shrink_close.shrink_4th_orders)as shrink4,&#13;
  SUM(shrink_close.shrink_5th_orders)as shrink5,&#13;
  SUM(shrink_close.shrink_6th_orders)as shrink6,&#13;
  &#13;
  &#13;
  SAFE_DIVIDE(SUM(surge.surged_order_experience), SUM(surge.actual_orders)) AS percent_surge_time,&#13;
  SAFE_DIVIDE(SUM(surge.surged_1st_order_experience), SUM(surge.actual_orders)) AS percent_surge_1st_time,&#13;
  SAFE_DIVIDE(SUM(surge.surged_2nd_order_experience), SUM(surge.actual_orders)) AS percent_surge_2nd_time,&#13;
  SAFE_DIVIDE(SUM(surge.surged_3rd_order_experience), SUM(surge.actual_orders)) AS percent_surge_3rd_time,&#13;
  SAFE_DIVIDE(SUM(surge.surged_4th_order_experience), SUM(surge.actual_orders)) AS percent_surge_4th_time,&#13;
  SAFE_DIVIDE(SUM(surge.surged_above_4_order_experience), SUM(surge.actual_orders)) AS percent_surge_above_4th_time,  &#13;
  SAFE_DIVIDE(SUM(shrink_close.shrink_orders), SUM(shrink_close.forecasted_orders)) AS percent_shrink_event_time,&#13;
  SAFE_DIVIDE(SUM(shrink_close.shrink_0_orders), SUM(shrink_close.forecasted_orders)) AS percent_shrink_0_time,&#13;
  SAFE_DIVIDE(SUM(shrink_close.shrink_1st_orders), SUM(shrink_close.forecasted_orders)) AS percent_shrink_1st_time,&#13;
  SAFE_DIVIDE(SUM(shrink_close.shrink_2nd_orders), SUM(shrink_close.forecasted_orders)) AS percent_shrink_2nd_time,&#13;
  SAFE_DIVIDE(SUM(shrink_close.shrink_3rd_orders), SUM(shrink_close.forecasted_orders)) AS percent_shrink_3rd_time,&#13;
  SAFE_DIVIDE(SUM(shrink_close.shrink_4th_orders), SUM(shrink_close.forecasted_orders)) AS percent_shrink_4th_time,&#13;
  SAFE_DIVIDE(SUM(shrink_close.shrink_5th_orders), SUM(shrink_close.forecasted_orders)) AS percent_shrink_5th_time,&#13;
  SAFE_DIVIDE(SUM(shrink_close.shrink_6th_orders), SUM(shrink_close.forecasted_orders)) AS percent_shrink_6th_time,&#13;
  SAFE_DIVIDE(SUM(shrink_close.close_orders), SUM(shrink_close.forecasted_orders)) AS percent_close_event_time,&#13;
&#13;
  CURRENT_DATE(&apos;Singapore&apos;) AS refresh_date&#13;
&#13;
FROM daily_surge_experience AS surge&#13;
LEFT JOIN daily_shrink_close_events AS shrink_close&#13;
       ON surge.global_entity_id = shrink_close.global_entity_id&#13;
       and surge.lg_country_code = shrink_close.lg_country_code&#13;
       and surge.city_name = shrink_close.city_name&#13;
       and surge.zone_name = shrink_close.zone_name&#13;
      AND surge.created_date_local = shrink_close.date_local&#13;
GROUP BY 1,2,3,4,5&#13;
ORDER BY surge.lg_country_code, date</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
