    <worksheet name='Current Week GMV Run Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily Orders' name='federated.0fitn7x0vzemch0zylmfd1e17afa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Start of week' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monday&quot;'>
              <calculation class='tableau' formula='&quot;Monday&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0fitn7x0vzemch0zylmfd1e17afa'>
            <column caption='Total GMV (local)' datatype='real' default-format='c#,##0,,.00M;-#,##0,,.00M' name='[Calculation_1038924174645780490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull([total_value_local],0)' />
            </column>
            <column caption='Market' datatype='string' name='[Calculation_941533823114350593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([global_entity_id],&apos;_&apos;,2)' />
            </column>
            <column caption='SOW' datatype='datetime' name='[Calculation_979532947777327104]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Sunday&apos; then DATETRUNC(&apos;week&apos;, [dt])&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Monday&apos; then DATETRUNC(&apos;week&apos;, [dt]-1)+1&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Today' datatype='date' name='[Calculation_979532947807358983]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Sunday&apos; Then date(DATETRUNC(&apos;week&apos;, (TODAY())-1))&#10;ELSEIF  [Parameters].[Parameter 2]=&apos;Monday&apos; THen date(DATETRUNC(&apos;week&apos;, (TODAY())-1)+1) END' />
            </column>
            <column caption='Current Week GMV Estimate' datatype='real' default-format='c#,##0,,.00M;-#,##0,,.00M' name='[Current Week Estimate (copy) (copy)_1038924174650994699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Previous Week Total Orders (copy) (copy)_1038924174651101196]*(1+[WoW% vs previous week (copy)_1038924174652805136])' />
            </column>
            <column caption='Current Week GMV' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Current Week Orders (copy) (copy)_1038924174651498511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Calculation_979532947807358983]=date([Calculation_979532947777327104]) then [Calculation_1038924174645780490] END)' />
            </column>
            <column caption='Previous Week Total GMV' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Previous Week Total Orders (copy) (copy)_1038924174651101196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Today (copy)_979532947808358408] =date([Calculation_979532947777327104]) then [Calculation_1038924174645780490] END)' />
            </column>
            <column caption='Previous Week Total GMV same days' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Previous Week Total Orders same days (copy) (copy)_1038924174651183117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Sunday&apos; then&#13;&#10;&#13;&#10;&#13;&#10;sum(if [Today (copy)_979532947808358408] =DATE([Calculation_979532947777327104])&#13;&#10;&#13;&#10;AND DATEpart(&apos;weekday&apos;,dt)&lt;DATEpart(&apos;weekday&apos;,today())&#13;&#10;&#13;&#10;then [Calculation_1038924174645780490] END)&#13;&#10;&#13;&#10;ELSEIF  [Parameters].[Parameter 2]=&apos;Monday&apos; then &#13;&#10;&#13;&#10;sum(if [Today (copy)_979532947808358408] =DATE([Calculation_979532947777327104])&#13;&#10;&#13;&#10;AND (if DATEpart(&apos;weekday&apos;,dt)&gt;1 then DATEpart(&apos;weekday&apos;,dt) &lt;DATEpart(&apos;weekday&apos;,today()) Else &#13;&#10;DATEpart(&apos;weekday&apos;,dt) &lt;DATEpart(&apos;weekday&apos;,today()) AND DATEpart(&apos;weekday&apos;,dt)&lt;&gt;1 END)&#13;&#10;then [Calculation_1038924174645780490] END)&#13;&#10;END' />
            </column>
            <column caption='Last Week' datatype='date' name='[Today (copy)_979532947808358408]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Sunday&apos; Then date(DATETRUNC(&apos;week&apos;, (TODAY())-1)-7)&#13;&#10;ELSEIF  [Parameters].[Parameter 2]=&apos;Monday&apos; THen date(DATETRUNC(&apos;week&apos;, (TODAY())-1)+1-7) END' />
            </column>
            <column caption='WoW% vs previous week GMV' datatype='real' default-format='p0.00%' name='[WoW% vs previous week (copy)_1038924174652805136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Current Week Orders (copy) (copy)_1038924174651498511]-[Previous Week Total Orders same days (copy) (copy)_1038924174651183117])/[Previous Week Total Orders same days (copy) (copy)_1038924174651183117]' />
            </column>
            <column datatype='date' name='[dt]' role='dimension' type='ordinal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_941533823114350593]' derivation='None' name='[none:Calculation_941533823114350593:nk]' pivot='key' type='nominal' />
            <column-instance column='[dt]' derivation='None' name='[none:dt:qk]' pivot='key' type='quantitative' />
