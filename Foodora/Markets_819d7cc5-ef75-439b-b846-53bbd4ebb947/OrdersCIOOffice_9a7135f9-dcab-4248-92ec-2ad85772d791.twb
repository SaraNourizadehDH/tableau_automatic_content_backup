      <column caption='Weekday Sort' datatype='integer' name='[Calculation_979532947814502410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Sunday&apos; AND &#13;&#10;&#13;&#10;(if [Parameters].[Parameter 2]=&apos;Monday&apos; then ISOWEEKDAY([ordered_at_date_local])&#13;&#10;ELSEIF  [Parameters].[Parameter 2]=&apos;Sunday&apos; then ISOWEEKDAY([ordered_at_date_local])-1 END) =6 then -1 ELSE &#13;&#10;(if [Parameters].[Parameter 2]=&apos;Monday&apos; then ISOWEEKDAY([ordered_at_date_local])&#13;&#10;ELSEIF  [Parameters].[Parameter 2]=&apos;Sunday&apos; then ISOWEEKDAY([ordered_at_date_local])-1 END) END' />
