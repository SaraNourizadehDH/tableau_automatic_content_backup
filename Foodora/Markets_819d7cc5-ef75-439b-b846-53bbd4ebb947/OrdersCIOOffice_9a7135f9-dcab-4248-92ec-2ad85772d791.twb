    <datasource caption='MAUs' inline='true' name='federated.03j7dqn1uj4af110ju2xq1dpkadr' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0aqx9e31e4f1sp13dtcwh0pzns6u'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='foodora-bi-se' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata APAC Production' schema='pandata_ap_commercial' server-oauth='server-custom' username='lovisa.lannesand@foodora.se' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0aqx9e31e4f1sp13dtcwh0pzns6u' name='Custom SQL Query' type='text'><![CDATA[WITH date_window AS (
  SELECT 
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH),MONTH) AS date_floor,
    DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL 6 MONTH),MONTH) AS date_ceiling,

),

month_dates AS (
SELECT
  DATE_TRUNC(date,MONTH) AS month_floor,
  MAX(date) AS month_ceiling
FROM  `fulfillment-dwh-production.pandata_curated.shared_dates`
WHERE date >>= (SELECT date_floor FROM date_window)
  AND date <<= DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
GROUP BY 1
),

all_subscriptions AS (
  SELECT 
       sb_subscriptions.global_entity_id,
       sb_subscriptions.customer_code,
       sb_subscriptions.id AS subscription_id,
       --sb_subscriptions.plan_duration_months,
       DATE(MIN(payment.subscription_start_at_local)) AS start_at_local,
       DATE(MAX(payment.subscription_end_at_local)) as end_at_local,       
  FROM `fulfillment-dwh-production`.pandata_curated.sb_subscriptions, UNNEST(payments) as payment
  WHERE 1=1
    AND (sb_subscriptions.plan_code LIKE ('%-single-plan-v%') OR sb_subscriptions.plan_code LIKE ('%-corporate-plan-v%'))
    AND payment.is_status_success = true
    --AND payment.is_duplicate_payment = FALSE
    AND sb_subscriptions.created_date_utc <<= CURRENT_DATE
  GROUP BY 1,2,3
),

monthly_mau AS (
  SELECT
    DATE_TRUNC(ordered_at_date_local,MONTH) AS order_month,
    global_entity_id,
    COUNT(DISTINCT pd_customer_uuid) AS MAU
  FROM `fulfillment-dwh-production`.pandata_curated.pd_orders
  WHERE created_date_utc >>= DATE_SUB((SELECT date_floor FROM date_window),INTERVAL 35 DAY)
    AND ordered_at_date_local >>= (SELECT date_floor FROM date_window)
    AND global_entity_id IN(SELECT DISTINCT global_entity_id FROM all_subscriptions)
  GROUP BY 1,2
),

L1M_mau AS (
  SELECT
    global_entity_id,
    COUNT(DISTINCT pd_customer_uuid) AS L1M
  FROM `fulfillment-dwh-production`.pandata_curated.pd_orders
  WHERE created_date_utc >>= DATE_SUB(CURRENT_DATE,INTERVAL 35 DAY)
    AND ordered_at_date_local >> DATE_SUB(CURRENT_DATE, INTERVAL 1 MONTH)
    AND global_entity_id IN(SELECT DISTINCT global_entity_id FROM all_subscriptions)
  GROUP BY 1
),

final AS (
SELECT
  month_dates.month_floor,
  DATE_TRUNC(CURRENT_DATE-1,MONTH) = month_floor AS is_TM,
  all_subscriptions.global_entity_id,
  shared_countries.name AS country_name,
  IFNULL(L1M_mau.L1M,monthly_mau.MAU) AS MAU,
  COUNT(DISTINCT all_subscriptions.customer_code) AS subscribers,
FROM month_dates
LEFT JOIN all_subscriptions
       ON all_subscriptions.start_at_local <<= month_ceiling
       AND all_subscriptions.end_at_local >> month_ceiling
LEFT JOIN monthly_mau
       ON monthly_mau.global_entity_id = all_subscriptions.global_entity_id
      AND monthly_mau.order_month = month_dates.month_floor
LEFT JOIN L1M_mau
       ON L1M_mau.global_entity_id = all_subscriptions.global_entity_id
      AND month_dates.month_floor = DATE_TRUNC(CURRENT_DATE-1,MONTH)
LEFT JOIN `fulfillment-dwh-production`.pandata_curated.shared_countries
       ON shared_countries.global_entity_id = all_subscriptions.global_entity_id      
GROUP BY 1,2,3,4,5
)

SELECT
    *
FROM final

UNION ALL

SELECT
    month_floor,
    is_TM,
    "FP_APAC" AS global_entity_id,
    "APAC" AS country_name,
    SUM(MAU) AS MAU,
    SUM(subscribers) AS subscribers
FROM final
GROUP BY 1,2,3,4]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0aqx9e31e4f1sp13dtcwh0pzns6u' name='Custom SQL Query' type='text'><![CDATA[WITH date_window AS (
