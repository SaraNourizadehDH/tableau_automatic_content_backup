    <datasource caption='Daily Orders' inline='true' name='federated.0fitn7x0vzemch0zylmfd1e17afa' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.03r2meu15nc0og1bo5rxq05aklfs'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='foodora-bi-se' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata APAC Production' schema='pandata_ap_commercial_external' server-oauth='server-custom' username='lovisa.lannesand@foodora.se' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.03r2meu15nc0og1bo5rxq05aklfs' name='Custom SQL Query' type='text'><![CDATA[With a as (SELECT 
created_date_local as dt,
global_entity_id,
substr(global_entity_id,4,2) as country,
count(distinct(uuid)) as orders,
countif(is_pickup) as pickup_orders,
countif(is_delivery) as delivery_orders,
countif(is_preorder) as pre_orders,
countif(delivery_fee_local=0 AND delivery_fee_original_local>>0) as free_delivery_orders,
countif(round(round(total_value_local,2)-round(subtotal_local,2)-round(delivery_fee_local,2)- round(service_fee_total_local,2)- round(difference_to_minimum_plus_vat_local,2)-round(rider_tip_local,2),2)<<0) as orders_with_discount,
sum(delivery_time_in_minutes) as sum_del_time,
sum(subtotal_local) as sub_total_local,
sum(total_value_local) as total_value_local,
round(sum(service_fee_total_local),2) as service_fee_total_local,
round(sum(delivery_fee_original_local),2) as delivery_fee_original_local,
sum(delivery_fee_local) as total_delivery_fee_charged,
sum(rider_tip_local) as rider_tip,
sum(CASE WHEN round(round(total_value_local,2)-round(subtotal_local,2)-round(delivery_fee_local,2)- round(service_fee_total_local,2)- round(difference_to_minimum_plus_vat_local,2)-round(rider_tip_local,2),2)<<0 then 
round(round(total_value_local,2)-round(subtotal_local,2)-round(delivery_fee_local,2)- round(service_fee_total_local,2)- round(difference_to_minimum_plus_vat_local,2)-round(rider_tip_local,2),2)
ELSE 0 END) as discount,
sum(CASE WHEN round(round(total_value_local,2)-round(subtotal_local,2)-round(delivery_fee_local,2)- round(service_fee_total_local,2)- round(difference_to_minimum_plus_vat_local,2)-round(rider_tip_local,2),2)>>0 then 
round(round(total_value_local,2)-round(subtotal_local,2)-round(delivery_fee_local,2)- round(service_fee_total_local,2)- round(difference_to_minimum_plus_vat_local,2)-round(rider_tip_local,2),2)
ELSE 0 END) as added_VAT,



FROM `fulfillment-dwh-production.pandata_curated.pd_orders` o
WHERE 
o.created_date_utc >>= "2021-12-31"  AND  
  o.created_date_local >>= "2022-02-01"  AND  
 o.global_entity_id in ("FP_SG", "FP_HK", "FP_TW", "FP_PK", "FP_BD", "FP_PH", "FP_MY", "FP_TH", "FP_MM", "FP_LA", "FP_KH")
 AND is_valid_order=TRUE

GROUP By 1,2,3),
 b as
(
SELECT global_entity_id, date_accepted_local as dt, (unique_order_count) as pandago_orders,  round(total_pandago_gmv_eur,2) as pandago_gmv_eur
FROM `fulfillment-dwh-production.pandata_report.pandago_orders_daily_country` 
WHERE date_accepted_local >>= "2022-02-01"  AND  
 global_entity_id in ("FP_SG", "FP_HK", "FP_TW", "FP_PK", "FP_BD", "FP_PH", "FP_MY", "FP_TH", "FP_MM", "FP_LA", "FP_KH")
)



SELECT a.*,
 b.pandago_orders, b.pandago_gmv_eur, a.orders+b.pandago_orders as total_orders
FROM a LEFT JOIN b on a.dt=b.dt AND a.global_entity_id=b.global_entity_id]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.03r2meu15nc0og1bo5rxq05aklfs' name='Custom SQL Query' type='text'><![CDATA[With a as (SELECT 
created_date_local as dt,
global_entity_id,
substr(global_entity_id,4,2) as country,
count(distinct(uuid)) as orders,
countif(is_pickup) as pickup_orders,
countif(is_delivery) as delivery_orders,
countif(is_preorder) as pre_orders,
countif(delivery_fee_local=0 AND delivery_fee_original_local>>0) as free_delivery_orders,
countif(round(round(total_value_local,2)-round(subtotal_local,2)-round(delivery_fee_local,2)- round(service_fee_total_local,2)- round(difference_to_minimum_plus_vat_local,2)-round(rider_tip_local,2),2)<<0) as orders_with_discount,
sum(delivery_time_in_minutes) as sum_del_time,
sum(subtotal_local) as sub_total_local,
sum(total_value_local) as total_value_local,
round(sum(service_fee_total_local),2) as service_fee_total_local,
round(sum(delivery_fee_original_local),2) as delivery_fee_original_local,
sum(delivery_fee_local) as total_delivery_fee_charged,
sum(rider_tip_local) as rider_tip,
sum(CASE WHEN round(round(total_value_local,2)-round(subtotal_local,2)-round(delivery_fee_local,2)- round(service_fee_total_local,2)- round(difference_to_minimum_plus_vat_local,2)-round(rider_tip_local,2),2)<<0 then 
round(round(total_value_local,2)-round(subtotal_local,2)-round(delivery_fee_local,2)- round(service_fee_total_local,2)- round(difference_to_minimum_plus_vat_local,2)-round(rider_tip_local,2),2)
ELSE 0 END) as discount,
sum(CASE WHEN round(round(total_value_local,2)-round(subtotal_local,2)-round(delivery_fee_local,2)- round(service_fee_total_local,2)- round(difference_to_minimum_plus_vat_local,2)-round(rider_tip_local,2),2)>>0 then 
round(round(total_value_local,2)-round(subtotal_local,2)-round(delivery_fee_local,2)- round(service_fee_total_local,2)- round(difference_to_minimum_plus_vat_local,2)-round(rider_tip_local,2),2)
ELSE 0 END) as added_VAT,



