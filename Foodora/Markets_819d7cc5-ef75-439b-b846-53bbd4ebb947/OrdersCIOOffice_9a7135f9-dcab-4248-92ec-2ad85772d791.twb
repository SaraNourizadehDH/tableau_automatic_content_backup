      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_49C14D5BBD2F43B38F89BBCBD8132EEA'>
            <properties context=''>
              <relation connection='bigquery.03r2meu15nc0og1bo5rxq05aklfs' name='Custom SQL Query' type='text'><![CDATA[With a as (SELECT 
created_date_local as dt,
global_entity_id,
substr(global_entity_id,4,2) as country,
count(distinct(uuid)) as orders,
countif(is_pickup) as pickup_orders,
countif(is_delivery) as delivery_orders,
countif(is_preorder) as pre_orders,
countif(delivery_fee_local=0 AND delivery_fee_original_local>>0) as free_delivery_orders,
countif(round(round(total_value_local,2)-round(subtotal_local,2)-round(delivery_fee_local,2)- round(service_fee_total_local,2)- round(difference_to_minimum_plus_vat_local,2)-round(rider_tip_local,2),2)<<0) as orders_with_discount,
sum(delivery_time_in_minutes) as sum_del_time,
sum(subtotal_local) as sub_total_local,
sum(total_value_local) as total_value_local,
round(sum(service_fee_total_local),2) as service_fee_total_local,
round(sum(delivery_fee_original_local),2) as delivery_fee_original_local,
sum(delivery_fee_local) as total_delivery_fee_charged,
sum(rider_tip_local) as rider_tip,
sum(CASE WHEN round(round(total_value_local,2)-round(subtotal_local,2)-round(delivery_fee_local,2)- round(service_fee_total_local,2)- round(difference_to_minimum_plus_vat_local,2)-round(rider_tip_local,2),2)<<0 then 
round(round(total_value_local,2)-round(subtotal_local,2)-round(delivery_fee_local,2)- round(service_fee_total_local,2)- round(difference_to_minimum_plus_vat_local,2)-round(rider_tip_local,2),2)
ELSE 0 END) as discount,
sum(CASE WHEN round(round(total_value_local,2)-round(subtotal_local,2)-round(delivery_fee_local,2)- round(service_fee_total_local,2)- round(difference_to_minimum_plus_vat_local,2)-round(rider_tip_local,2),2)>>0 then 
round(round(total_value_local,2)-round(subtotal_local,2)-round(delivery_fee_local,2)- round(service_fee_total_local,2)- round(difference_to_minimum_plus_vat_local,2)-round(rider_tip_local,2),2)
ELSE 0 END) as added_VAT,



FROM `fulfillment-dwh-production.pandata_curated.pd_orders` o
WHERE 
o.created_date_utc >>= "2021-12-31"  AND  
  o.created_date_local >>= "2022-02-01"  AND  
 o.global_entity_id in ("FP_SG", "FP_HK", "FP_TW", "FP_PK", "FP_BD", "FP_PH", "FP_MY", "FP_TH", "FP_MM", "FP_LA", "FP_KH")
 AND is_valid_order=TRUE

GROUP By 1,2,3),
 b as
(
SELECT global_entity_id, date_accepted_local as dt, (unique_order_count) as pandago_orders,  round(total_pandago_gmv_eur,2) as pandago_gmv_eur
FROM `fulfillment-dwh-production.pandata_report.pandago_orders_daily_country` 
WHERE date_accepted_local >>= "2022-02-01"  AND  
 global_entity_id in ("FP_SG", "FP_HK", "FP_TW", "FP_PK", "FP_BD", "FP_PH", "FP_MY", "FP_TH", "FP_MM", "FP_LA", "FP_KH")
)



SELECT a.*,
 b.pandago_orders, b.pandago_gmv_eur, a.orders+b.pandago_orders as total_orders
FROM a LEFT JOIN b on a.dt=b.dt AND a.global_entity_id=b.global_entity_id]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Fail Rate' inline='true' name='federated.0vp7juq18emwrt1gxgjgv12tmfej' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1r0dc571tc74ix14a536607ptmnk'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='foodora-nordics' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata APAC Production' schema='pandata_ap_commercial_external' server-oauth='server-custom' username='lovisa.lannesand@foodora.se' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1r0dc571tc74ix14a536607ptmnk' name='Custom SQL Query' type='text'><![CDATA[SELECT 
--EXTRACT(MONTH FROM o.created_date_utc) as Month, EXTRACT(YEAR FROM o.created_date_utc) as Year,
global_entity_id,
ordered_at_date_local,
count(distinct(o.uuid)) as orders,
Sum(CASE WHEN is_valid_order=True then 1 ELSE 0 END) as valid_orders,
Sum(CASE WHEN is_failed_order=True then 1 ELSE 0 END) as failed_orders,
Sum(CASE WHEN is_failed_order_vendor=True then 1 ELSE 0 END) as failed_orders_vendor,
Sum(CASE WHEN is_failed_order_customer=True then 1 ELSE 0 END) as failed_orders_customers,
Sum(CASE WHEN is_failed_order_foodpanda=True then 1 ELSE 0 END) as failed_orders_foodpanda,





FROM 
`fulfillment-dwh-production.pandata_curated.pd_orders` o
WHERE

 o.created_date_utc >>= "2022-01-31"  AND  
  --o.created_date_utc <<= "2022-03-01" AND
  o.created_date_local >>= "2022-02-01"  AND  
 -- o.created_date_local <<= "2022-02-28" AND
 o.global_entity_id in ("FP_PK", "FP_SG", "FP_HK", "FP_BD", "FP_TW","FP_PH", "FP_MY", "FP_TH", "FP_MM", "FP_LA", "FP_KH")

 GROUP BY 1,2
 ORDER BY 1,2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1r0dc571tc74ix14a536607ptmnk' name='Custom SQL Query' type='text'><![CDATA[SELECT 
--EXTRACT(MONTH FROM o.created_date_utc) as Month, EXTRACT(YEAR FROM o.created_date_utc) as Year,
global_entity_id,
ordered_at_date_local,
count(distinct(o.uuid)) as orders,
Sum(CASE WHEN is_valid_order=True then 1 ELSE 0 END) as valid_orders,
Sum(CASE WHEN is_failed_order=True then 1 ELSE 0 END) as failed_orders,
Sum(CASE WHEN is_failed_order_vendor=True then 1 ELSE 0 END) as failed_orders_vendor,
Sum(CASE WHEN is_failed_order_customer=True then 1 ELSE 0 END) as failed_orders_customers,
Sum(CASE WHEN is_failed_order_foodpanda=True then 1 ELSE 0 END) as failed_orders_foodpanda,





FROM 
`fulfillment-dwh-production.pandata_curated.pd_orders` o
WHERE

 o.created_date_utc >>= "2022-01-31"  AND  
  --o.created_date_utc <<= "2022-03-01" AND
  o.created_date_local >>= "2022-02-01"  AND  
 -- o.created_date_local <<= "2022-02-28" AND
 o.global_entity_id in ("FP_PK", "FP_SG", "FP_HK", "FP_BD", "FP_TW","FP_PH", "FP_MY", "FP_TH", "FP_MM", "FP_LA", "FP_KH")

 GROUP BY 1,2
 ORDER BY 1,2]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
