          <alias key='&quot;[federated.0fitn7x0vzemch0zylmfd1e17afa].[usr:WoW\% vs previous week (copy)_979532947805650948:qk]&quot;' value='WoW% vs previous week' />
        </aliases>
      </column>
      <column caption='Total GMV (local)' datatype='real' default-format='c#,##0,,.00M;-#,##0,,.00M' name='[Calculation_1038924174645780490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull([total_value_local],0)' />
      </column>
      <column caption='AFV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1038924174660829201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sub_total_local])/sum(ifnull([orders],0))' />
      </column>
      <column caption='Date level' datatype='datetime' name='[Calculation_1077767697937911808]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&apos;Week&apos; then DATETRUNC(&apos;day&apos;,[Calculation_979532947777327104]) &#13;&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Month&apos; then DATETRUNC(&apos;month&apos;,dt) END' />
      </column>
      <column caption='Graph Dimension' datatype='string' datatype-customized='true' name='[Calculation_1103381935021424641]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='(if [Parameters].[Parameter 1]=&apos;Week&apos; then str(date(DATETRUNC(&apos;week&apos;,[dt])))&#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Month&apos; then DATENAME(&apos;month&apos;,dt)&#13;&#10;END)' />
      </column>
      <column caption='WoW/MoM' datatype='string' name='[Calculation_1103381935025123330]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&apos;Week&apos; then &apos;WoW%&apos; &#13;&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Month&apos; then &apos;MoM%&apos; END' />
      </column>
      <column caption='Orders per day' datatype='real' name='[Calculation_1193172436181176320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Total Orders (copy)_1305199492752207878]/[Calculation_1305199492749926402])' />
      </column>
      <column caption='GMV per day' datatype='real' default-format='c#,##0,,.00M;-#,##0,,.00M' name='[Calculation_1193172436181393409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Orders (copy)_1038924174638510087]/[Calculation_1305199492749926402])' />
      </column>
      <column aggregation='Sum' caption='Current Week' datatype='integer' name='[Calculation_1252845151902208000]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='week(today())' />
      </column>
      <column caption='Pickup %' datatype='real' default-format='p0.00%' name='[Calculation_1264667127904190468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pickup_orders])/sum([Calculation_1305199492748541952])' />
      </column>
      <column caption='Total Orders' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_1305199492748541952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull([orders],0)+IFNULL([pandago_orders],0)' />
      </column>
      <column caption='Current Month' datatype='boolean' name='[Calculation_1305199492749729793]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='month(today())=month(dt)' />
      </column>
      <column caption='No. of days in current month' datatype='integer' name='[Calculation_1305199492749926402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if month(dt)=month(today()-1) then dt END)' />
      </column>
      <column caption='Current Month RR' datatype='real' name='[Calculation_1305199492750082051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Total Orders (copy)_1305199492752207878]/[Calculation_1305199492749926402])*[Calculation_1305199492750352389]' />
      </column>
      <column caption='No. of days per month' datatype='integer' name='[Calculation_1305199492750352389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If month(today())=1 then 31&#13;&#10;ELSEIF  (month(today())=2 AND year(today())%4=0 )then 29&#13;&#10;ELSEIF  (month(today())=2 AND year(today())%4&lt;&gt;0) then 28&#13;&#10;ELSEIF month(today())=3 then 31&#13;&#10;ELSEIF month(today())=4 then 30&#13;&#10;ELSEIF month(today())=5 then 31&#13;&#10;ELSEIF month(today())=6 then 30&#13;&#10;ELSEIF month(today())=7 then 31&#13;&#10;ELSEIF month(today())=8 then 31&#13;&#10;ELSEIF month(today())=9 then 30&#13;&#10;ELSEIF month(today())=10 then 31&#13;&#10;ELSEIF month(today())=11 then 30&#13;&#10;ELSEIF month(today())=12 then 31&#13;&#10;END' />
