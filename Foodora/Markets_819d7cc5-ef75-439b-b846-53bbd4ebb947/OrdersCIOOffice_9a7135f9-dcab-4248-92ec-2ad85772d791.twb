    DATE_TRUNC(ordered_at_date_local,MONTH) AS order_month,
    global_entity_id,
    COUNT(DISTINCT pd_customer_uuid) AS MAU
  FROM `fulfillment-dwh-production`.pandata_curated.pd_orders
  WHERE created_date_utc >>= DATE_SUB((SELECT date_floor FROM date_window),INTERVAL 35 DAY)
    AND ordered_at_date_local >>= (SELECT date_floor FROM date_window)
    AND global_entity_id IN(SELECT DISTINCT global_entity_id FROM all_subscriptions)
  GROUP BY 1,2
),

L1M_mau AS (
  SELECT
    global_entity_id,
    COUNT(DISTINCT pd_customer_uuid) AS L1M
  FROM `fulfillment-dwh-production`.pandata_curated.pd_orders
  WHERE created_date_utc >>= DATE_SUB(CURRENT_DATE,INTERVAL 35 DAY)
    AND ordered_at_date_local >> DATE_SUB(CURRENT_DATE, INTERVAL 1 MONTH)
    AND global_entity_id IN(SELECT DISTINCT global_entity_id FROM all_subscriptions)
  GROUP BY 1
),

final AS (
SELECT
  month_dates.month_floor,
  DATE_TRUNC(CURRENT_DATE-1,MONTH) = month_floor AS is_TM,
  all_subscriptions.global_entity_id,
  shared_countries.name AS country_name,
  IFNULL(L1M_mau.L1M,monthly_mau.MAU) AS MAU,
  COUNT(DISTINCT all_subscriptions.customer_code) AS subscribers,
FROM month_dates
LEFT JOIN all_subscriptions
       ON all_subscriptions.start_at_local <<= month_ceiling
       AND all_subscriptions.end_at_local >> month_ceiling
LEFT JOIN monthly_mau
       ON monthly_mau.global_entity_id = all_subscriptions.global_entity_id
      AND monthly_mau.order_month = month_dates.month_floor
LEFT JOIN L1M_mau
       ON L1M_mau.global_entity_id = all_subscriptions.global_entity_id
      AND month_dates.month_floor = DATE_TRUNC(CURRENT_DATE-1,MONTH)
LEFT JOIN `fulfillment-dwh-production`.pandata_curated.shared_countries
       ON shared_countries.global_entity_id = all_subscriptions.global_entity_id      
GROUP BY 1,2,3,4,5
)

SELECT
    *
FROM final

UNION ALL

SELECT
    month_floor,
    is_TM,
    "FP_APAC" AS global_entity_id,
    "APAC" AS country_name,
    SUM(MAU) AS MAU,
    SUM(subscribers) AS subscribers
FROM final
GROUP BY 1,2,3,4]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
