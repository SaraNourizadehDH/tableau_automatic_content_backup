      <column caption='Shrink %' datatype='real' default-format='p0.0%' name='[Calculation_1418352468008034306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([shrink0]+[shrink1]+[shrink2]+[shrink3]+[shrink4]+[shrink5]+[shrink6])/sum([forecasted_orders])' />
