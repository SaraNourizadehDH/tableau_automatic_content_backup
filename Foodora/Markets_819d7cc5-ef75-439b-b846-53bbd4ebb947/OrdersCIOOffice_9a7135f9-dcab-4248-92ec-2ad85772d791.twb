    <worksheet name='Weekly Shrink Time %'>
      <table>
        <view>
          <datasources>
            <datasource caption='Shrinkage' name='federated.1s7iw8t1cisejf1blwoiy1nqtzon' />
            <datasource caption='Daily Orders' name='federated.0fitn7x0vzemch0zylmfd1e17afa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose date level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column caption='Start of week' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monday&quot;'>
              <calculation class='tableau' formula='&quot;Monday&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0fitn7x0vzemch0zylmfd1e17afa'>
            <column caption='Market' datatype='string' name='[Calculation_941533823114350593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([global_entity_id],&apos;_&apos;,2)' />
            </column>
            <column datatype='date' name='[dt]' role='dimension' type='ordinal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_941533823114350593]' derivation='None' name='[none:Calculation_941533823114350593:nk]' pivot='key' type='nominal' />
            <column-instance column='[dt]' derivation='None' name='[none:dt:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1s7iw8t1cisejf1blwoiy1nqtzon'>
            <column caption='Shrinkage Time %' datatype='real' default-format='p0.00%' name='[AVG DT Per Day (copy 3)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_shrink_time]) / sum([total_shrink_orders])' />
            </column>
            <column caption='Date level' datatype='datetime' name='[Calculation_1077767697937911808]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1]=&apos;Week&apos; then DATETRUNC(&apos;day&apos;,[Calculation_585467984313696256]) &#13;&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Month&apos; then DATETRUNC(&apos;month&apos;,[date]) END' />
            </column>
            <column caption='Market' datatype='string' name='[Calculation_1535164560982077441]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
              <calculation class='tableau' formula='IF [country_name]=&apos;Bangladesh&apos; then &apos;BD&apos;&#13;&#10;ELSEIF [country_name]=&apos;Hong Kong&apos; then &apos;HK&apos;&#13;&#10;ELSEIF [country_name]=&apos;Pakistan&apos; then &apos;PK&apos;&#13;&#10;ELSEIF [country_name]=&apos;Singapore&apos; then &apos;SG&apos;&#13;&#10;ELSEIF [country_name]=&apos;Taiwan&apos; then &apos;TW&apos;&#13;&#10;ELSEIF [country_name]=&apos;Philippines&apos; then &apos;PH&apos;&#13;&#10;ELSEIF [country_name]=&apos;Malaysia&apos; then &apos;MY&apos;&#13;&#10;ELSEIF [country_name]=&apos;Thailand&apos; then &apos;TH&apos;&#13;&#10;ELSEIF [country_name]=&apos;Myanmar&apos; then &apos;MM&apos;&#13;&#10;ELSEIF [country_name]=&apos;Cambodia&apos; then &apos;KH&apos;&#13;&#10;ELSEIF [country_name]=&apos;Laos&apos; then &apos;LA&apos;&#13;&#10;&#13;&#10; END' />
            </column>
            <column caption='dow' datatype='datetime' name='[Calculation_585467984313696256]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Sunday&apos; then DATETRUNC(&apos;week&apos;, [date])&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Monday&apos; then DATETRUNC(&apos;week&apos;, [date]-1)+1&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Index 1' datatype='boolean' name='[Calculation_7593913429435088896]' role='measure' type='nominal'>
              <calculation class='tableau' formula='index()=1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='dt' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1535164560982077441]' derivation='None' name='[none:Calculation_1535164560982077441:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[sum_shrink_time]' role='measure' type='quantitative' />
