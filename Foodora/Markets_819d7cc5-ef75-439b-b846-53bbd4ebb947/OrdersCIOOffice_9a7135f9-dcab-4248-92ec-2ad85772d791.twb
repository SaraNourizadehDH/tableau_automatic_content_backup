      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_9B61C35897FE4E4986655BA4BDBED675'>
            <properties context=''>
              <relation connection='bigquery.1r0dc571tc74ix14a536607ptmnk' name='Custom SQL Query' type='text'><![CDATA[SELECT 
--EXTRACT(MONTH FROM o.created_date_utc) as Month, EXTRACT(YEAR FROM o.created_date_utc) as Year,
global_entity_id,
ordered_at_date_local,
count(distinct(o.uuid)) as orders,
Sum(CASE WHEN is_valid_order=True then 1 ELSE 0 END) as valid_orders,
Sum(CASE WHEN is_failed_order=True then 1 ELSE 0 END) as failed_orders,
Sum(CASE WHEN is_failed_order_vendor=True then 1 ELSE 0 END) as failed_orders_vendor,
Sum(CASE WHEN is_failed_order_customer=True then 1 ELSE 0 END) as failed_orders_customers,
Sum(CASE WHEN is_failed_order_foodpanda=True then 1 ELSE 0 END) as failed_orders_foodpanda,





FROM 
`fulfillment-dwh-production.pandata_curated.pd_orders` o
WHERE

 o.created_date_utc >>= "2022-01-31"  AND  
  --o.created_date_utc <<= "2022-03-01" AND
  o.created_date_local >>= "2022-02-01"  AND  
 -- o.created_date_local <<= "2022-02-28" AND
 o.global_entity_id in ("FP_PK", "FP_SG", "FP_HK", "FP_BD", "FP_TW","FP_PH", "FP_MY", "FP_TH", "FP_MM", "FP_LA", "FP_KH")

 GROUP BY 1,2
 ORDER BY 1,2]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
