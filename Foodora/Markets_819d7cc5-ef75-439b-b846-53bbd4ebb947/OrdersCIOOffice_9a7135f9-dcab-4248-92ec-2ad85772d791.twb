              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Sunday&apos; then DATETRUNC(&apos;week&apos;, [ordered_at_date_local])&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Monday&apos; then DATETRUNC(&apos;week&apos;, [ordered_at_date_local]-1)+1&#13;&#10;&#13;&#10;END' />
