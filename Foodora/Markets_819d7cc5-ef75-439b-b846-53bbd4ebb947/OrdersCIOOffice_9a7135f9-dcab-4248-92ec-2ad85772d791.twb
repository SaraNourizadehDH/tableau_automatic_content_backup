      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Shrinkage' id='_DD476B221DEC423F8A7F9B485548D4A4'>
            <properties context=''>
              <relation connection='bigquery.0t1i8wa0r97ia611vc2a11qczead' name='Custom SQL Query' type='text'><![CDATA[SELECT
  country_name,
  reference_date_local AS  date,
  region,  
  --no_of_zones,
  close_no_of_zones,
  surge_no_of_zones,
  total_shrink_time,
  shrink_time_percentage AS shrink_time_pct,
  sum_shrink_time,
  total_shrink_orders,
  total_close_time,
  close_time_percentage AS close_time_pct,
  sum_close_time,
  total_close_orders,
  
  IF(reference_date_local <<= DATE_SUB(current_date, interval 3 day), surge_time_percentage, null) AS surge_time_percentage,
  IF(reference_date_local <<= DATE_SUB(current_date, interval 3 day), sum_surge_time, null) AS sum_surge_time,
  IF(reference_date_local <<= DATE_SUB(current_date, interval 3 day), total_surge_orders, null) AS total_surge_orders
FROM `fulfillment-dwh-production.pandata_report.zone_events_daily_country_categories_exp`
where reference_date_local << current_date]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
