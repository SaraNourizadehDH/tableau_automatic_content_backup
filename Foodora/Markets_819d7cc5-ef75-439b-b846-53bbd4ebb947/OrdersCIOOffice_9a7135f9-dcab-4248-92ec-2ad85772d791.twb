            <column-instance column='[Current Week Estimate (copy)_979532947805843462]' derivation='User' name='[usr:Current Week Estimate (copy)_979532947805843462:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Current Week Orders (copy)_979532947805704197]' derivation='User' name='[usr:Current Week Orders (copy)_979532947805704197:qk]' pivot='key' type='quantitative' />
            <column-instance column='[WoW% vs previous week (copy)_979532947805650948]' derivation='User' name='[usr:WoW% vs previous week (copy)_979532947805650948:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
