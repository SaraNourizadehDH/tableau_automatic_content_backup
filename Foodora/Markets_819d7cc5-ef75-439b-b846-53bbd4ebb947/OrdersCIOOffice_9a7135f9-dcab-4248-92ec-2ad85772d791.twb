            </column>
            <column caption='No. of days in current month' datatype='integer' name='[Calculation_1305199492749926402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if month(dt)=month(today()-1) then dt END)' />
            </column>
            <column caption='Current Month RR' datatype='real' name='[Calculation_1305199492750082051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Total Orders (copy)_1305199492752207878]/[Calculation_1305199492749926402])*[Calculation_1305199492750352389]' />
            </column>
            <column caption='No. of days per month' datatype='integer' name='[Calculation_1305199492750352389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If month(today())=1 then 31&#13;&#10;ELSEIF  (month(today())=2 AND year(today())%4=0 )then 29&#13;&#10;ELSEIF  (month(today())=2 AND year(today())%4&lt;&gt;0) then 28&#13;&#10;ELSEIF month(today())=3 then 31&#13;&#10;ELSEIF month(today())=4 then 30&#13;&#10;ELSEIF month(today())=5 then 31&#13;&#10;ELSEIF month(today())=6 then 30&#13;&#10;ELSEIF month(today())=7 then 31&#13;&#10;ELSEIF month(today())=8 then 31&#13;&#10;ELSEIF month(today())=9 then 30&#13;&#10;ELSEIF month(today())=10 then 31&#13;&#10;ELSEIF month(today())=11 then 30&#13;&#10;ELSEIF month(today())=12 then 31&#13;&#10;END' />
            </column>
            <column caption='Market' datatype='string' name='[Calculation_941533823114350593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([global_entity_id],&apos;_&apos;,2)' />
            </column>
            <column caption='MTD Orders' datatype='integer' name='[Total Orders (copy)_1305199492752207878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if month(dt)=month(today()-1) then [Calculation_1305199492748541952] END)' />
