      <group caption='Action (DAY(dow),WEEKDAY(dt))' hidden='true' name='[Action (DAY(dow),WEEKDAY(dt))]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
