            <column caption='closed_ratio' datatype='real' name='[Calculation_73535394778116122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([closed_minutes]) +SUM([unreachable_minutes])) /SUM([open_minutes])' />
            </column>
