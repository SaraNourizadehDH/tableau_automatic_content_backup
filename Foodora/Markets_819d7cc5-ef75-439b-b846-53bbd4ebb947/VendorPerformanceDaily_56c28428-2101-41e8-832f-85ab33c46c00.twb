    <worksheet name='Orders 10 mins - Charts Value'>
      <table>
        <view>
          <datasources>
            <datasource caption='late_orders' name='federated.1eh6by31cdk6do1dg9abb07yt561' />
          </datasources>
          <datasource-dependencies datasource='federated.1eh6by31cdk6do1dg9abb07yt561'>
            <column caption='10mins_color_decider' datatype='string' name='[5mins_color_decider (copy)_53761777948381185]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [wtd_wow_5mins_delta (copy)_92816428942979100] &gt; 0 THEN &apos;above&apos; ELSE &apos;below&apos; END' />
            </column>
            <column aggregation='Sum' caption='1' datatype='integer' name='[Calculation_6180416436319469570]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='LastD WoW' />
              </aliases>
            </column>
            <column caption='positive_lastd_wow_10mins' datatype='real' name='[Calculation_73535394700251142]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [lastd_wow_5_mins (copy)_92816428944433184] &gt; 0 THEN [lastd_wow_5_mins (copy)_92816428944433184] END' />
            </column>
            <column caption='positive_wow_10mins' datatype='real' name='[Calculation_73535394700476424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [wtd_wow_5mins_delta (copy)_92816428942979100]&gt;0 THEN [wtd_wow_5mins_delta (copy)_92816428942979100] END' />
            </column>
            <column caption='positive_10mins_monthly' datatype='real' name='[Calculation_73535394700873738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [delta_5mins_mom (copy)_237142723507855360] &gt; 0 THEN [delta_5mins_mom (copy)_237142723507855360] END' />
            </column>
            <column-instance column='[Calculation_6180416436319469570]' derivation='Avg' name='[avg:Calculation_6180416436319469570:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
            <column caption='current_month_10mins_rate' datatype='real' name='[current_month_5mins_rate (copy)_237142723507904513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([running_total_10mins_orders_month])/SUM([running_total_orders_month])' />
            </column>
            <column caption='current_week_10_mins_rate' datatype='real' name='[current_week_5_mins_rate (copy)_92816428943028253]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([running_total_10mins_orders_week])/SUM([running_total_orders_week])' />
            </column>
            <column caption='delta_10mins_mom' datatype='real' name='[delta_5mins_mom (copy)_237142723507855360]' role='measure' type='quantitative'>
