            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ow7y211ndmwd516m355e1cw1qtl'>
            <column caption='+%diff left_main_kpi' datatype='real' default-format='p0.00%' name='[-%diff left_main_kpi (copy)_5109967138790187050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_306104068224516097] &gt; 0 then&#10;[Calculation_306104068224516097]&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='&apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [Report Date Local])' datatype='string' name='[Calculation_171840528175726600]' role='dimension' type='nominal' user:unnamed='Left'>
              <calculation class='tableau' formula='&apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [report_date_local])' />
            </column>
            <column caption='%diff left_main_kpi' datatype='real' name='[Calculation_306104068224516097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_5109967138782617601]) - LOOKUP(ZN([Calculation_5109967138782617601]), -1)) &#10;/ ABS(LOOKUP(ZN([Calculation_5109967138782617601]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='left_main_kpi' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5109967138782617601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Valid Orders&apos; then SUM([valid_order_count])&#10;when &apos;Platform NC&apos; then SUM([acquisition_order_count])&#10;when &apos;New Vertical NC&apos; then SUM([new_to_new_verticals_order_count])&#10;when &apos;Restaurants NC&apos; then SUM([new_to_vertical_restaurants_order_count])&#10;when &apos;Shops NC&apos; then SUM([new_to_vertical_shops_order_count])&#10;when &apos;Dmart NC&apos; then SUM([new_to_vertical_dmart_order_count])&#10;when &apos;Pickup NC&apos; then SUM([new_to_vertical_pickup_order_count])&#10;when &apos;GOV&apos; then SUM([Original Takein (copy)_5109967138785480723])&#10;when &apos;GMV&apos; then SUM([Mov (copy)_5109967138785812502])&#10;when &apos;GFV&apos; then SUM([Gfv net (copy)_5109967138786127898])&#10;when &apos;Pickup Order Share&apos; then SUM([pickup_order_count])/SUM([valid_order_count])&#10;when &apos;Subscription Order Share&apos; then SUM([subscriber_order_count])/SUM([valid_order_count])&#10;when &apos;Online Payment Order Share&apos; then SUM([order_paid_online_count])/SUM([valid_order_count])&#10;when &apos;Comm Rate&apos; then SUM([commission_gross (copy)_6682356728871391233])/SUM([Gfv net (copy)_5109967138786127898])&#10;when &apos;Comm&apos; then sum([commission_gross (copy)_6682356728871391233])&#10;when &apos;Net Df&apos; then SUM([Delivery Fee Original (copy)_5109967138786549790])&#10;when &apos;Container Charges&apos; then SUM([Delivery Fee (copy)_5109967138786840609])&#10;when &apos;Diff to MOV&apos; then SUM([Net Takein (copy)_5109967138785742869])&#10;when &apos;Original Takein&apos; then SUM([Revenue (copy)_5109967138785357842])&#10;when &apos;Eff Takein&apos; then SUM([Gfv (copy)_5109967138786218011])&#10;when &apos;Net Takein&apos; then SUM([Order Value (copy)_5109967138785574932])&#10;when &apos;Revenue&apos; then SUM([Calculation_5109967138784845838])&#10;when &apos;Marketing ICPGMV&apos; then -AVG([icpgmv_eur])&#10;when &apos;Marketing ICPO&apos; then -AVG([icpo_eur])&#10;when &apos;Daily Active User Count&apos; then SUM([daily_active_user_count_by_acid])&#10;when &apos;Daily MAU Count&apos; then SUM([daily_mau_count_by_acid])&#10;when &apos;Daily Session Count&apos; then SUM([daily_session_count])&#10;when &apos;AOV&apos; then SUM([Original Takein (copy)_5109967138785480723])/SUM([valid_order_count])&#10;when &apos;AMV&apos; then SUM([Mov (copy)_5109967138785812502])/SUM([valid_order_count])&#10;when &apos;AFV&apos; then SUM([Gfv net (copy)_5109967138786127898])/SUM([valid_order_count])&#10;when &apos;Avg Comm&apos; then SUM([commission_gross (copy)_6682356728871391233])/SUM([valid_order_count])&#10;when &apos;Avg Net Df&apos; then AVG([DF Excl Pandago Per Order (copy)_914160363790438400])&#10;when &apos;Avg Net Df Excl Pgo Dmart&apos; then AVG([Delivery Fee Net (copy)_171840528172560384])&#10;when &apos;Avg Container&apos; then SUM([Delivery Fee (copy)_5109967138786840609])/SUM([valid_order_count])&#10;when &apos;Avg Original Takein&apos; then SUM([Revenue (copy)_5109967138785357842])/SUM([valid_order_count])&#10;when &apos;Avg Eff Takein&apos; then SUM([Gfv (copy)_5109967138786218011])/SUM([valid_order_count])&#10;when &apos;Avg Net Takein&apos; then SUM([Order Value (copy)_5109967138785574932])/SUM([valid_order_count])&#10;when &apos;Avg Revenue&apos; then SUM([Calculation_5109967138784845838])/SUM([valid_order_count])&#10;when &apos;Valid Rate&apos; then SUM([valid_order_count])/SUM([order_count])&#10;when &apos;Fail Rate&apos; then SUM([failed_order_count])/SUM([order_count])&#10;when &apos;Vendor Fail Rate&apos; then SUM([failed_order_vendor_count])/SUM([order_count])&#10;when &apos;Customer Fail Rate&apos; then SUM([failed_order_customer_count])/SUM([order_count])&#10;when &apos;Foodpanda Fail Rate&apos; then SUM([failed_order_foodpanda_count])/SUM([order_count])&#10;END' />
            </column>
            <column caption='Revenue' datatype='real' name='[Calculation_5109967138784845838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Local&quot; THEN [revenue_local] ELSE [revenue_eur] END' />
            </column>
            <column caption='-%diff left_main_kpi' datatype='real' default-format='p0.00%' name='[Calculation_5109967138790080553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_306104068224516097] &lt;= 0 then&#10;[Calculation_306104068224516097]&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='display left main kpi' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5109967138790350891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;Rate|Share|ICPGMV&apos;) then [Calculation_5109967138782617601]*100&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;AOV|AMV|AFV|Avg|ICPO&apos;) then ROUND([Calculation_5109967138782617601], 2)&#10;else ROUND([Calculation_5109967138782617601]/1000, 2)&#10;end' />
            </column>
            <column caption='display left_unit' datatype='string' name='[Calculation_5109967138790699053]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;Rate|Share|ICPGMV&apos;) then &apos;%&apos;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;AOV|AMV|AFV|Avg|ICPO&apos;) then &apos;&apos;&#10;else &apos;k&apos;&#10;end' />
            </column>
            <column caption='color left_main_kpi' datatype='integer' name='[Calculation_5109967138790879278]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='rank([Calculation_306104068224516097], &apos;asc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
