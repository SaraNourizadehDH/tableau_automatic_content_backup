        <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Left Main KPIs (copy)_5109967138827857975], &apos;Rate|Share|ICPGMV&apos;) then [left_main_kpi (copy)_5109967138828107833]*100&#10;elseif REGEXP_MATCH([Parameters].[Left Main KPIs (copy)_5109967138827857975], &apos;AOV|AMV|AFV|Avg|ICPO&apos;) then ROUND([left_main_kpi (copy)_5109967138828107833], 2)&#10;else ROUND([left_main_kpi (copy)_5109967138828107833]/1000, 2)&#10;end' />
