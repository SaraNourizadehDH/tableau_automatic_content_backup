    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Changelog'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/CombinedMetricsAPAC/Changelog?rev=' id='Changelog' path='/t/Foodora/workbooks/CombinedMetricsAPAC' revision='' site='Foodora' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='49000' id='3' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='20' underline='true'>Changelog</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' underline='true'>2024-09-06</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>- </run>
              <run fontcolor='#000000'>With the migration of data sources from pd_orders to coredata_business.orders. Some differences in data is expected due to changes in definitions</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- Data affected: </run>
              <run bold='true' fontcolor='#000000'>Vendor Fail Rate</run>
              <run fontcolor='#000000'>,</run>
              <run bold='true' fontcolor='#000000'> Customer Fail Rate</run>
              <run fontcolor='#000000'>, </run>
              <run bold='true' fontcolor='#000000'>Foodpanda Fail Rate</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' underline='true'>2024-07-02</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>- </run>
              <run fontcolor='#000000'>To adhere to Tableau Gold Standards. the following changes were made</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>  - Renamed </run>
              <run bold='true' fontcolor='#000000'>Definitions</run>
              <run fontcolor='#000000'> tab to </run>
              <run bold='true' fontcolor='#000000'>Metric Definitions</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>  - Added </run>
              <run bold='true' fontcolor='#000000'>Description/Data Quality Checks</run>
              <run fontcolor='#000000'> tab</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- Added changelog tab</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>- info on gold standards </run>
              <run auto-url='true' fontcolor='#000000' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/display/AD/Gold+Standards&amp;quot;'>https://confluence.deliveryhero.com/display/AD/Gold+Standards</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
