              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Month&apos; &#10;THEN DATENAME(&apos;year&apos;,[report_date]) + &apos;-M&apos; + STR(DATEPART(&apos;month&apos;,[report_date]))&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; &#10;THEN STR(ISOYEAR([report_date])) + &apos;-W&apos; + STR(ISOWEEK([report_date]))&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;THEN DATENAME(&apos;year&apos;,[report_date]) + &apos;-&apos; + STR(DATEPART(&apos;month&apos;,[report_date])) + &apos;-&apos; + DATENAME(&apos;day&apos;,[report_date])&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day of Week&apos; &#10;THEN [Calculation_962574085135601702]&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Time of Day&apos; &#10;THEN [time_of_day]&#10;&#10;END' />
