    <worksheet name='Events'>
      <table>
        <view>
          <datasources>
            <datasource caption='Details Performance (L12M)' name='federated.11g3bdm0jlyym51erc78m0gvzxof' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Dimension 1' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11g3bdm0jlyym51erc78m0gvzxof'>
            <column caption='Future Days' datatype='boolean' name='[Calculation_2828049480575479809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] &gt;= TODAY()' />
            </column>
            <column caption='Is Valid Performance Data' datatype='boolean' name='[Calculation_693132175430881280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date]&lt;= [Calculation_693132175690670083]' />
            </column>
            <column caption='Last Update Date' datatype='date' name='[Calculation_693132175690670083]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED: MAX(IF [orders_completed]&gt; 0 AND [time_of_day] &gt;= &apos;3. Lunch&apos; THEN [report_date] END) }' />
            </column>
            <column caption='% Shrink (Layer 0)' datatype='real' name='[Calculation_962574085112221709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([weighted_shrink_0_orders])/SUM([order_forecast])' />
            </column>
            <column caption='% Shrink (Layer 1)' datatype='real' name='[Calculation_962574085112426510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([weighted_shrink_1_orders])/SUM([order_forecast])' />
            </column>
            <column caption='% Shrink (Layer 2)' datatype='real' name='[Calculation_962574085112471567]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([weighted_shrink_2_orders])/SUM([order_forecast])' />
            </column>
            <column caption='% Shrink (Layer 3)' datatype='real' name='[Calculation_962574085112520720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([weighted_shrink_3_orders])/SUM([order_forecast])' />
            </column>
            <column caption='% Shrink (All Layers)' datatype='real' name='[Calculation_962574085112565777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([weighted_shrink_orders])/SUM([order_forecast])' />
            </column>
            <column caption='% Full Closure' datatype='real' name='[Calculation_962574085115605017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([weighted_full_close_orders])/SUM([order_forecast])' />
            </column>
            <column caption='% ROA Closure' datatype='real' name='[Calculation_962574085116022810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([weighted_roa_close_orders])/SUM([order_forecast])' />
            </column>
            <column caption='% Closure (All)' datatype='real' name='[Calculation_962574085116137499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_962574085115605017],0)+IFNULL([Calculation_962574085116022810],0)' />
            </column>
            <column caption='Report Timeframe 1' datatype='string' name='[Calculation_962574085131067425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Month&apos; &#10;THEN DATENAME(&apos;year&apos;,[report_date]) + &apos;-M&apos; + STR(DATEPART(&apos;month&apos;,[report_date]))&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; &#10;THEN STR(ISOYEAR([report_date])) + &apos;-W&apos; + STR(ISOWEEK([report_date]))&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;THEN DATENAME(&apos;year&apos;,[report_date]) + &apos;-&apos; + STR(DATEPART(&apos;month&apos;,[report_date])) + &apos;-&apos; + DATENAME(&apos;day&apos;,[report_date])&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day of Week&apos; &#10;THEN [Calculation_962574085135601702]&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Time of Day&apos; &#10;THEN [time_of_day]&#10;&#10;END' />
            </column>
            <column caption='Day of Week' datatype='string' name='[Calculation_962574085135601702]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(ISOWEEKDAY([report_date])) + &quot;. &quot; + LEFT(DATENAME(&apos;weekday&apos;,[report_date]),3)' />
            </column>
            <column caption='% Weighted Event' datatype='real' name='[Calculation_962574085149388843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_962574085112565777],0)+IFNULL([Calculation_962574085116137499],0)' />
            </column>
            <column caption='Area' datatype='string' name='[area]' role='dimension' type='nominal' />
            <column caption='Strategic Zone' datatype='boolean' name='[is_2024_strategic_zones]' role='dimension' type='nominal' />
