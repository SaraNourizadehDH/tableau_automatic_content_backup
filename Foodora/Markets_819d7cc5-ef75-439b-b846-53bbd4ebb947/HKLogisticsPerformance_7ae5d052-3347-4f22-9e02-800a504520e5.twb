      </column>
      <column caption='% Stacked Deliveries' datatype='real' name='[Calculation_962574085116583964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stacked_deliveries])/SUM([deliveries_completed])' />
      </column>
      <column caption='% Intra Stacks' datatype='real' name='[Calculation_962574085116854301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stacked_intravendor])/SUM([deliveries_completed])' />
      </column>
      <column caption='Report Timeframe 1' datatype='string' name='[Calculation_962574085131067425]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Month&apos; &#10;THEN DATENAME(&apos;year&apos;,[report_date]) + &apos;-M&apos; + STR(DATEPART(&apos;month&apos;,[report_date]))&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; &#10;THEN STR(ISOYEAR([report_date])) + &apos;-W&apos; + STR(ISOWEEK([report_date]))&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;THEN DATENAME(&apos;year&apos;,[report_date]) + &apos;-&apos; + STR(DATEPART(&apos;month&apos;,[report_date])) + &apos;-&apos; + DATENAME(&apos;day&apos;,[report_date])&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day of Week&apos; &#10;THEN [Calculation_962574085135601702]&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Time of Day&apos; &#10;THEN [time_of_day]&#10;&#10;END' />
      </column>
      <column caption='Day of Week' datatype='string' name='[Calculation_962574085135601702]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(ISOWEEKDAY([report_date])) + &quot;. &quot; + LEFT(DATENAME(&apos;weekday&apos;,[report_date]),3)' />
      </column>
      <column caption='% UTR &gt; 2' datatype='real' name='[Calculation_962574085140029481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [orders_completed]/[evaluated_working_hours]&gt;2 THEN 1 ELSE 0 END)/&#10;SUM(IF [orders_completed]/[evaluated_working_hours]&gt;=0 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Shrinkage &gt; 10%' datatype='real' name='[Calculation_962574085144404010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF[weighted_shrink_orders]/[order_forecast]&gt;0.1 THEN 1 ELSE 0 END)/&#10;SUM(IF[weighted_shrink_orders]/[order_forecast]&gt;=0 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='% Weighted Event' datatype='real' name='[Calculation_962574085149388843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_962574085112565777],0)+IFNULL([Calculation_962574085116137499],0)' />
      </column>
      <column caption='Report Timeframe - Chart' datatype='datetime' name='[Report Timeframe 1 (copy)_693132175431917569]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Month&apos; &#10;THEN DATETRUNC(&apos;month&apos;,[report_date])&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; &#10;THEN DATETRUNC(&apos;week&apos;,[report_date],&apos;monday&apos;)&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;THEN DATETRUNC(&apos;day&apos;,[report_date])&#10;&#10;END' />
      </column>
      <column caption='Report Timeframe 2' datatype='string' name='[Report Timeframe 1 (copy)_962574085137375271]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Time Dimension 1 (copy)_962574085134663716] = &apos;Month&apos; &#10;THEN DATENAME(&apos;year&apos;,[report_date]) + &apos;-M&apos; + STR(DATEPART(&apos;month&apos;,[report_date]))&#10;&#10;ELSEIF [Parameters].[Time Dimension 1 (copy)_962574085134663716] = &apos;Week&apos; &#10;THEN STR(ISOYEAR([report_date])) + &apos;-W&apos; + STR(ISOWEEK([report_date]))&#10;&#10;ELSEIF [Parameters].[Time Dimension 1 (copy)_962574085134663716] = &apos;Day&apos;&#10;THEN DATENAME(&apos;year&apos;,[report_date]) + &apos;-&apos; + STR(DATEPART(&apos;month&apos;,[report_date])) + &apos;-&apos; + DATENAME(&apos;day&apos;,[report_date])&#10;&#10;ELSEIF [Parameters].[Time Dimension 1 (copy)_962574085134663716] = &apos;Day of Week&apos; &#10;THEN [Calculation_962574085135601702]&#10;&#10;ELSEIF [Parameters].[Time Dimension 1 (copy)_962574085134663716] = &apos;Time of Day&apos; &#10;THEN [time_of_day]&#10;&#10;ELSEIF [Parameters].[Time Dimension 1 (copy)_962574085134663716] = &apos;None&apos; &#10;THEN &apos;&apos;&#10;&#10;END' />
      </column>
