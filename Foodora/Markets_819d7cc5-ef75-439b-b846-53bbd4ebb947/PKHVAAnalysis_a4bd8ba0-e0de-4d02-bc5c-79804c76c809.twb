              <calculation class='tableau' formula='&quot;30 Days&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14rheiw11vo0nm1cxt9k51byldvj'>
            <column caption='orders / customers' datatype='real' name='[Calculation_887209171196395520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([acid])' />
            </column>
            <column caption='cost (incentive)' datatype='real' name='[Calculation_887209171196596226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([marketing_cost_eur]+[total_fd_cost_eur]+[total_fdnc_cost_eur])' />
            </column>
            <column caption='ROI (Net GMV Growth / Cost)*' datatype='real' name='[Calculation_887209171196801027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;30 Days&apos; THEN SUM([gmv_net_eur_30d]-zn([gmv_net_eur_30d_before]))/SUM([marketing_cost_eur]+[total_fd_cost_eur]+[total_fdnc_cost_eur]+zn([Calculation_887209171197743117]))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;60 Days&apos; THEN SUM([gmv_net_eur_60d]-zn([gmv_net_eur_60d_before]))/SUM([marketing_cost_eur]+[total_fd_cost_eur]+[total_fdnc_cost_eur]+zn([Calculation_887209171197743117]))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;90 Days&apos; THEN SUM([gmv_net_eur_90d]-zn([gmv_net_eur_90d_before]))/SUM([marketing_cost_eur]+[total_fd_cost_eur]+[total_fdnc_cost_eur]+zn([Calculation_887209171197743117]))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;120 Days&apos; THEN SUM([gmv_net_eur_120d]-zn([gmv_net_eur_120d_before]))/SUM([marketing_cost_eur]+[total_fd_cost_eur]+[total_fdnc_cost_eur]+zn([Calculation_887209171197743117]))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;150 Days&apos; THEN SUM([gmv_net_eur_150d]-zn([gmv_net_eur_150d_before]))/SUM([marketing_cost_eur]+[total_fd_cost_eur]+[total_fdnc_cost_eur]+zn([Calculation_887209171197743117]))&#10;ELSEIF [Parameters].[Parameter 1]=&apos;180 Days&apos; THEN SUM([gmv_net_eur_180d]-zn([gmv_net_eur_180d_before]))/SUM([marketing_cost_eur]+[total_fd_cost_eur]+[total_fdnc_cost_eur]+zn([Calculation_887209171197743117]))&#10;END' />
            </column>
            <column caption='Retained %' datatype='real' name='[Calculation_887209171197087748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;30 Days&apos; THEN SUM([retained_30d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;60 Days&apos; THEN SUM([retained_60d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;90 Days&apos; THEN SUM([retained_90d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;120 Days&apos; THEN SUM([retained_120d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;150 Days&apos; THEN SUM([retained_150d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;180 Days&apos; THEN SUM([retained_180d])/SUM([acid_first_order])&#10;END' />
            </column>
            <column caption='Net GMV / Customers *' datatype='real' name='[Calculation_887209171197132805]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;30 Days&apos; THEN SUM([gmv_net_eur_30d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;60 Days&apos; THEN SUM([gmv_net_eur_60d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;90 Days&apos; THEN SUM([gmv_net_eur_90d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;120 Days&apos; THEN SUM([gmv_net_eur_120d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;150 Days&apos; THEN SUM([gmv_net_eur_150d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;180 Days&apos; THEN SUM([gmv_net_eur_180d])/SUM([acid_first_order])&#10;END' />
            </column>
            <column caption='Net GMV / Customers Before*' datatype='real' name='[Calculation_887209171197272070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;30 Days&apos; THEN SUM([gmv_net_eur_30d_before])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;60 Days&apos; THEN SUM([gmv_net_eur_60d_before])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;90 Days&apos; THEN SUM([gmv_net_eur_90d_before])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;120 Days&apos; THEN SUM([gmv_net_eur_120d_before])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;150 Days&apos; THEN SUM([gmv_net_eur_150d_before])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;180 Days&apos; THEN SUM([gmv_net_eur_180d_before])/SUM([acid_first_order])&#10;END' />
            </column>
            <column caption='Net GMV / Customers Growth*' datatype='real' name='[Calculation_887209171197308935]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_887209171197132805]-zn([Calculation_887209171197272070]))' />
            </column>
            <column caption='FLGPU' datatype='real' name='[Calculation_887209171197415432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;30 Days&apos; THEN SUM([flgp_eur_30d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;60 Days&apos; THEN SUM([flgp_eur_60d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;90 Days&apos; THEN SUM([flgp_eur_90d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;120 Days&apos; THEN SUM([flgp_eur_120d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;150 Days&apos; THEN SUM([flgp_eur_150d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;180 Days&apos; THEN SUM([flgp_eur_180d])/SUM([acid_first_order])&#10;END' />
