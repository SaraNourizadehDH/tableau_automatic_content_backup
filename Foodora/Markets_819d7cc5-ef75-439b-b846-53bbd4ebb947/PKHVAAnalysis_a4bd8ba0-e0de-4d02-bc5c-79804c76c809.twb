      <column caption='Customers' datatype='integer' name='[Calculation_887209171209166862]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[acid]' />
      </column>
      <column caption='COST' datatype='real' name='[Calculation_887209171209207823]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([marketing_cost_eur]+[total_fd_cost_eur]+[total_fdnc_cost_eur]+zn([pm_costs_per_order]))' />
      </column>
      <column caption='COST (Incentive)' datatype='real' name='[Calculation_887209171209273360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([marketing_cost_eur]+[total_fd_cost_eur]+[total_fdnc_cost_eur])' />
      </column>
      <column caption='orders / Retained Customers' datatype='real' name='[Calculation_887209171209351185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;30 Days&apos; THEN SUM([retained_orders_30d])/SUM([retained_30d])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;60 Days&apos; THEN SUM([retained_orders_60d])/SUM([retained_60d])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;90 Days&apos; THEN SUM([retained_orders_90d])/SUM([retained_90d])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;120 Days&apos; THEN SUM([retained_orders_120d])/SUM([retained_120d])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;150 Days&apos; THEN SUM([retained_orders_150d])/SUM([retained_150d])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;180 Days&apos; THEN SUM([retained_orders_180d])/SUM([retained_180d])&#10;END' />
      </column>
      <column caption='Net Gmv Customer *' datatype='real' name='[Calculation_887209171209408530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;30 Days&apos; THEN SUM([gmv_net_eur_30d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;60 Days&apos; THEN SUM([gmv_net_eur_60d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;90 Days&apos; THEN SUM([gmv_net_eur_90d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;120 Days&apos; THEN SUM([gmv_net_eur_120d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;150 Days&apos; THEN SUM([gmv_net_eur_150d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;180 Days&apos; THEN SUM([gmv_net_eur_180d])/SUM([acid_first_order])&#10;END' />
      </column>
      <column caption='FLGPU' datatype='real' name='[Calculation_887209171209486355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;30 Days&apos; THEN SUM([flgp_eur_30d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;60 Days&apos; THEN SUM([flgp_eur_60d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;90 Days&apos; THEN SUM([flgp_eur_90d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;120 Days&apos; THEN SUM([flgp_eur_120d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;150 Days&apos; THEN SUM([flgp_eur_150d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;180 Days&apos; THEN SUM([flgp_eur_180d])/SUM([acid_first_order])&#10;END' />
      </column>
      <column caption='FLGPO' datatype='real' name='[Calculation_887209171209543700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;30 Days&apos; THEN SUM([flgp_eur_30d])/SUM([retained_orders_30d])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;60 Days&apos; THEN SUM([flgp_eur_60d])/SUM([retained_orders_60d])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;90 Days&apos; THEN SUM([flgp_eur_90d])/SUM([retained_orders_90d])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;120 Days&apos; THEN SUM([flgp_eur_120d])/SUM([retained_orders_120d])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;150 Days&apos; THEN SUM([flgp_eur_150d])/SUM([retained_orders_150d])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;180 Days&apos; THEN SUM([flgp_eur_180d])/SUM([retained_orders_180d])&#10;END' />
      </column>
      <column caption='retention %' datatype='real' name='[Calculation_887209171209637909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;30 Days&apos; THEN SUM([retained_30d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;60 Days&apos; THEN SUM([retained_60d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;90 Days&apos; THEN SUM([retained_90d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;120 Days&apos; THEN SUM([retained_120d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;150 Days&apos; THEN SUM([retained_150d])/SUM([acid_first_order])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;180 Days&apos; THEN SUM([retained_180d])/SUM([acid_first_order])&#10;END' />
      </column>
