        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_country_evaluation' name='federated.1qbrtpj0t7ty5q19dup500c8yi6m' />
          </datasources>
          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Calls SLA 30s %_cm' datatype='real' name='[Chat SLA 30s %_cm (copy)_414894147664404483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [calls_sla_30] * 100 / [total_inbound_calls]&#13;&#10;END' />
            </column>
            <column caption='Calls SLA 30s %_lm' datatype='real' name='[Chat SLA 30s %_lm (copy)_414894147664551940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [calls_sla_30] * 100 / [total_inbound_calls]&#13;&#10;END' />
            </column>
            <column caption='Calls SLA 30s MTD' datatype='string' name='[Chat SLA 30s MTD (copy)_414894147664650245]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Chat SLA 30s %_cm (copy)_414894147664404483]) / SUM([Chat SLA 30s %_lm (copy)_414894147664551940])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Chat SLA 30s %_cm (copy)_414894147664404483]) / SUM([Chat SLA 30s %_lm (copy)_414894147664551940])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Calls SLA 30s MTD Color' datatype='string' name='[Chat SLA 30s MTD Color (copy)_414894147664777222]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Chat SLA 30s %_cm (copy)_414894147664404483]) / SUM([Chat SLA 30s %_lm (copy)_414894147664551940])) - 1) &gt;= 0&#13;&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column datatype='integer' name='[calls_sla_30]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
