    <worksheet name='rider incident MTD'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_country_evaluation' name='federated.1qbrtpj0t7ty5q19dup500c8yi6m' />
          </datasources>
          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Rider Chat % MTD' datatype='string' name='[Customer Incident % MTD (copy)_730990567798001689]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Customer Incident %_cm (copy)_730990567797825559]) / SUM([Customer Incident %_lm (copy)_730990567797915672])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Customer Incident %_cm (copy)_730990567797825559]) / SUM([Customer Incident %_lm (copy)_730990567797915672])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Rider Chat % MTD Color' datatype='string' name='[Customer Incident % MTD Color (copy)_730990567798157338]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Customer Incident %_cm (copy)_730990567797825559]) / SUM([Customer Incident %_lm (copy)_730990567797915672])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Rider Chat %_cm' datatype='real' name='[Customer Incident %_cm (copy)_730990567797825559]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [rider_session_count] / [total_chat_count]&#13;&#10;END' />
            </column>
            <column caption='Rider Chat %_lm' datatype='real' name='[Customer Incident %_lm (copy)_730990567797915672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [rider_session_count] / [total_chat_count]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH_EU&quot;' value='DH EU' />
                <alias key='&quot;DH_EU + TR&quot;' value='DH EU + TR' />
              </aliases>
            </column>
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='Is Fraud' datatype='string' name='[is_fraud]' role='dimension' type='nominal' />
