    <worksheet name='comp % of GMV MTD'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_compensation' name='federated.08qj7o11ejfuo61fhb8ru15c7qi6' />
            <datasource caption='regional_eu_cx_sop_country_evaluation_non_live' name='federated.1jslqxp0aasw7011l42k81hmghcj' />
          </datasources>
          <datasource-dependencies datasource='federated.08qj7o11ejfuo61fhb8ru15c7qi6'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Total GMV eur' datatype='real' name='[Calculation_952229870366662656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [report_date], [country], [vertical_type], [delivery_type]: AVG([total_gmv_eur])}' />
            </column>
            <column caption='% of GMV MTD' datatype='string' name='[Reactive Compensation % MTD (copy)_952229870369685511]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Reactive Compensation %_cm (copy)_952229870369394693]) / SUM([Reactive Compensation %_lm (copy)_952229870369533958])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Reactive Compensation %_cm (copy)_952229870369394693]) / SUM([Reactive Compensation %_lm (copy)_952229870369533958])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='% of GMV_cm' datatype='real' name='[Reactive Compensation %_cm (copy)_952229870369394693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [sum_value_eur_used_voucher] / [Calculation_952229870366662656]&#13;&#10;END' />
            </column>
            <column caption='% of GMV_lm' datatype='real' name='[Reactive Compensation %_lm (copy)_952229870369533958]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [sum_value_eur_used_voucher] / [Calculation_952229870366662656]&#13;&#10;END' />
            </column>
            <column caption='% of GMV MTD Color' datatype='string' name='[Redemption % MTD Color (copy)_952229870369923080]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Reactive Compensation %_cm (copy)_952229870369394693]) / SUM([Reactive Compensation %_lm (copy)_952229870369533958])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH_EU&quot;' value='DH EU' />
