          <datasource-dependencies datasource='federated.003n5dq1v862mm1h53rcg044y4e9'>
            <column caption='Restaurant Rating MTD' datatype='string' name='[AO NPS % MTD (copy)_794322396940169222]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([AO NPS %_cm (copy)_794322396939894788]) / SUM([AO NPS %_lm (copy)_794322396940046341])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([AO NPS %_cm (copy)_794322396939894788]) / SUM([AO NPS %_lm (copy)_794322396940046341])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Restaurant Rating MTD Color' datatype='string' name='[AO NPS % MTD Color (copy)_794322396940304391]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([AO NPS %_cm (copy)_794322396939894788]) / SUM([AO NPS %_lm (copy)_794322396940046341])) - 1) &gt;= 0&#13;&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column caption='Restaurant Rating_cm' datatype='real' name='[AO NPS %_cm (copy)_794322396939894788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [restaurant_food_score] / [restaurant_food_score_response_count]&#13;&#10;END' />
            </column>
            <column caption='Restaurant Rating_lm' datatype='real' name='[AO NPS %_lm (copy)_794322396940046341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [restaurant_food_score] / [restaurant_food_score_response_count]&#13;&#10;END' />
            </column>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
