            <column caption='Cases SLA 48h %_cm' datatype='real' name='[Cases SLA 8h %_cm (copy)_2477894625282928644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [cases_sla_48h_count] * 100 / [total_incoming_cases_count]&#13;&#10;END' />
            </column>
            <column caption='Cases SLA 48h %_lm' datatype='real' name='[Cases SLA 8h %_lm (copy)_2477894625282998277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [cases_sla_48h_count] * 100 / [total_incoming_cases_count]&#13;&#10;END' />
            </column>
            <column caption='Cases SLA 48h MTD' datatype='string' name='[Cases SLA 8h MTD (copy)_2477894625283092486]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Cases SLA 8h %_cm (copy)_2477894625282928644]) / SUM([Cases SLA 8h %_lm (copy)_2477894625282998277])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Cases SLA 8h %_cm (copy)_2477894625282928644])) / SUM([Cases SLA 8h %_lm (copy)_2477894625282998277]) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
