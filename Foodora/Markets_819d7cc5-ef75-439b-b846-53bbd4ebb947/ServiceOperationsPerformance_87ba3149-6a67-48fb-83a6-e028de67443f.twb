          <relation connection='bigquery.1r54q6b0gb8m3i14a7si10q83a61' name='Custom SQL Query' type='text'><![CDATA[WITH all_calls_data AS (

SELECT
    created_date AS report_date,
    shared_countries.name AS country,
    CASE
      WHEN LOWER(stakeholder) LIKE "%customer%" THEN "Customer Service"
      WHEN LOWER(stakeholder) LIKE "%vendor%" THEN "Partner Service"
      WHEN LOWER(stakeholder) LIKE "%rider%" THEN "Dispatching"
    END AS department,
    IF(direction = 'Inbound' AND served_call_ind = 1 AND queue_time_secs <<= 30, call_id, NULL) AS calls_sla_30_count,
    IFNULL(inbound_call_ind, 0) - IFNULL(abandoned_call_ind, 0) + IFNULL(missed_call_ind, 0) AS inbound_calls_count,
    IFNULL(missed_call_ind, 0) AS missed_calls_count,
    IF(direction = 'Inbound' AND served_call_ind = 1, call_id, NULL) AS valid_inbound_calls_count,
    IF(direction = 'Inbound', handling_time_secs, NULL) AS handling_time_inbound_calls_sec,
    IF(direction = 'Outbound', call_id, NULL) AS total_calls_outbound,
    IF(direction = 'Inbound' AND served_call_ind = 1, call_id, NULL) AS answered_calls_inbound_total
  FROM `fulfillment-dwh-production.curated_data_shared.all_calls` AS gcc_toku_calls
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_eu__countries` AS shared_countries
         ON gcc_toku_calls.global_entity_id = shared_countries.global_entity_id
  WHERE created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
    AND shared_countries.name IS NOT NULL
    AND LOWER(shared_countries.name) NOT IN ("cyprus", "greece","romania")
),

prep AS (SELECT
    report_date,
    country,
    department,
    -- "NULL" AS vertical_type,
    -- "NULL" AS is_corporate_order,
    -- "NULL" AS is_subscription_order,
    -- "NULL" AS is_fraud,
    COUNT(DISTINCT calls_sla_30_count) AS calls_sla_30,
    COUNT(DISTINCT valid_inbound_calls_count) AS valid_inbound_calls,
    -- COUNT(DISTINCT inbound_calls_count) AS total_inbound_calls_count,
    SUM(inbound_calls_count) total_inbound_calls,
    SUM(missed_calls_count) missed_inbound_calls,
    -- SAFE_DIVIDE(COUNT(DISTINCT calls_sla_30_count), SUM(inbound_calls_count)) AS ratio
    SUM(handling_time_inbound_calls_sec) AS handling_time_inbound_calls_sec,
    -- COUNT(DISTINCT total_calls_outbound) AS total_calls_outbound,
    -- COUNT(DISTINCT answered_calls_inbound_total) AS answered_calls_inbound_total
  FROM all_calls_data
  GROUP BY
    report_date,
    country,
    department),

total_without_TR AS (SELECT
    report_date,
    'DH_EU' AS country,
    department,
    -- "NULL" AS vertical_type,
    -- "NULL" AS is_corporate_order,
    -- "NULL" AS is_subscription_order,
    -- "NULL" AS is_fraud,
    SUM(calls_sla_30) AS calls_sla_30,
    SUM(valid_inbound_calls) AS valid_inbound_calls,
    -- COUNT(DISTINCT inbound_calls_count) AS total_inbound_calls_count,
    SUM(total_inbound_calls) total_inbound_calls,
    SUM(missed_inbound_calls) missed_inbound_calls,
    SUM(handling_time_inbound_calls_sec) AS handling_time_inbound_calls_sec,
    FROM prep
    WHERE country <<>> "Turkey"
    GROUP BY
    1, 2, 3
),

total_with_TR AS (SELECT
    report_date,
    'DH_EU + TR' AS country,
    department,
    -- "NULL" AS vertical_type,
    -- "NULL" AS is_corporate_order,
    -- "NULL" AS is_subscription_order,
    -- "NULL" AS is_fraud,
    SUM(calls_sla_30) AS calls_sla_30,
    SUM(valid_inbound_calls) AS valid_inbound_calls,
    -- COUNT(DISTINCT inbound_calls_count) AS total_inbound_calls_count,
    SUM(total_inbound_calls) total_inbound_calls,
    SUM(missed_inbound_calls) missed_inbound_calls,
    SUM(handling_time_inbound_calls_sec) AS handling_time_inbound_calls_sec
    FROM prep
    GROUP BY
    1, 2, 3)

  SELECT *
  FROM prep
  UNION ALL
  SELECT *
  FROM total_with_TR
  UNION ALL
  SELECT *
  FROM total_without_TR]]></relation>
