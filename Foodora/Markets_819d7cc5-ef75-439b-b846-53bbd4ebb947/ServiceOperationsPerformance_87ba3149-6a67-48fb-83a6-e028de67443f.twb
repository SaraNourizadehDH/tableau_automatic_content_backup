    <worksheet name='customer chat'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_country_evaluation' name='federated.1qbrtpj0t7ty5q19dup500c8yi6m' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='Relevant time period' datatype='boolean' name='[Calculation_456271002415939588]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then IIF(DATEADD(&apos;day&apos;, -6, TODAY()) &lt; [report_date] AND [report_date] != TODAY() AND [report_date] &lt;= DATEADD(&apos;day&apos;, -1, TODAY()), true, false)&#13;&#10; when &apos;week&apos; then IIF(DATEADD(&apos;iso-week&apos;, -6, DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) &lt; DATETRUNC(&apos;week&apos;,[report_date],&apos;monday&apos;) AND ISOWEEK(TODAY()) != ISOWEEK([report_date]), true, false)&#13;&#10; when &apos;month&apos; then IIF(DATEADD(&apos;month&apos;, -5, TODAY()) &lt; [report_date] AND Month([report_date]) != month(DATEADD(&apos;month&apos;, -5, TODAY())), true, false)&#13;&#10;end' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_456271002456092691]&#13;&#10; when &apos;week&apos; then [Calculation_456271002456002578]&#13;&#10; when &apos;month&apos; then [Calculation_456271002455613457]&#13;&#10;end' />
            </column>
            <column caption='RANK_PERCENTILE(ROUND([Customer Chat %],3))' datatype='real' name='[Calculation_730990567796183059]' role='measure' type='quantitative' user:unnamed='Sheet 201'>
              <calculation class='tableau' formula='RANK_PERCENTILE(ROUND([Overall Incident % (copy)_730990567794642953],3))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Customer Chat %' datatype='real' default-format='p0.00%' name='[Overall Incident % (copy)_730990567794642953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_session_count]) / SUM([total_chat_count])' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH_EU&quot;' value='DH EU' />
                <alias key='&quot;DH_EU + TR&quot;' value='DH EU + TR' />
              </aliases>
            </column>
