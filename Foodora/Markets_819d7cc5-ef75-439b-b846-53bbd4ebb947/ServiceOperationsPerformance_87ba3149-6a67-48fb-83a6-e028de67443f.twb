    <worksheet name='Partially Fulfilled Orders MTD'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_country_evaluation_cx' name='federated.003n5dq1v862mm1h53rcg044y4e9' />
            <datasource caption='regional_eu_cx_sop_cancellation' name='federated.1rntd771dk8uz21g9y0uv0f7jh6d' />
            <datasource caption='regional_eu_cx_sop_country_evaluation_non_live' name='federated.1jslqxp0aasw7011l42k81hmghcj' />
            <datasource caption='regional_eu_cx_sop_compensation' name='federated.08qj7o11ejfuo61fhb8ru15c7qi6' />
          </datasources>
          <datasource-dependencies datasource='federated.003n5dq1v862mm1h53rcg044y4e9'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Partially Fulfilled Orders % MTD' datatype='string' name='[Incident Rate MTD (copy)_739997739914989574]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Incident Rate_cm (copy)_739997739914297348]) / SUM([Incident Rate_lm (copy)_739997739914387461])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Incident Rate_cm (copy)_739997739914297348]) / SUM([Incident Rate_lm (copy)_739997739914387461])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Partially Fulfilled Orders % MTD Color' datatype='string' name='[Incident Rate MTD Color (copy)_739997739915132935]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Incident Rate_cm (copy)_739997739914297348]) / SUM([Incident Rate_lm (copy)_739997739914387461])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Partially Fulfilled Orders %_cm' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Incident Rate_cm (copy)_739997739914297348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [num_of_partially_fulfilled_orders] / [num_of_valid_gross_orders]&#13;&#10;END' />
            </column>
            <column caption='Partially Fulfilled Orders %_lm' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Incident Rate_lm (copy)_739997739914387461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [num_of_partially_fulfilled_orders] / [num_of_valid_gross_orders]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH_EU&quot;' value='DH EU' />
                <alias key='&quot;DH_EU + TR&quot;' value='DH EU + TR' />
              </aliases>
            </column>
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_588001238739361801]' derivation='None' name='[none:Calculation_588001238739361801:nk]' pivot='key' type='nominal' />
