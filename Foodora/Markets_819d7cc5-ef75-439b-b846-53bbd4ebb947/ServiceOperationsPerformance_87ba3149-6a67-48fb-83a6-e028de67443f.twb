            <column caption='Rider Avg. Message Count MTD' datatype='string' name='[Customer Avg. Message Count MTD (copy)_1204994428639993869]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Customer Avg. Message count_cm (copy)_1204994428639838219]) / SUM([Customer Avg. Message count_lm (copy)_1204994428639916044])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Customer Avg. Message count_cm (copy)_1204994428639838219]) / SUM([Customer Avg. Message count_lm (copy)_1204994428639916044])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Rider Avg. Message count MTD Color' datatype='string' name='[Customer Avg. Message count MTD Color (copy)_1204994428640165902]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Customer Avg. Message count_cm (copy)_1204994428639838219]) / SUM([Customer Avg. Message count_lm (copy)_1204994428639916044])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Rider Avg. Message count_cm' datatype='real' name='[Customer Avg. Message count_cm (copy)_1204994428639838219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [rider_message_count] / ([total_message_count])&#13;&#10;END' />
            </column>
            <column caption='Rider Avg. Message count_lm' datatype='real' name='[Customer Avg. Message count_lm (copy)_1204994428639916044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [rider_message_count] /([total_message_count])&#13;&#10;END' />
