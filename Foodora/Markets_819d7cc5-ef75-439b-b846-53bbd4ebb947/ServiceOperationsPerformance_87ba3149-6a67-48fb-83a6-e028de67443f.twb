            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[email_cases]' derivation='Sum' name='[sum:email_cases:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1133218269713661952]' derivation='User' name='[usr:Calculation_1133218269713661952:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1990028100605956096]' derivation='User' name='[usr:Calculation_1990028100605956096:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_422775441856421938]' derivation='User' name='[usr:Calculation_422775441856421938:qk]' pivot='key' type='quantitative'>
