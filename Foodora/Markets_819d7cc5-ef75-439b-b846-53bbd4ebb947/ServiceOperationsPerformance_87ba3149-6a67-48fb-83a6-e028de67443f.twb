    <worksheet name='overall incident MTD'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_country_evaluation' name='federated.1qbrtpj0t7ty5q19dup500c8yi6m' />
          </datasources>
          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Overall Incident % MTD' datatype='string' name='[Esclated Cases % MTD (copy)_730990567789600774]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Esclated Cases %_cm (copy)_730990567789375492]) / SUM([Esclated Cases %_lm (copy)_730990567789486085])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Esclated Cases %_cm (copy)_730990567789375492]) / SUM([Esclated Cases %_lm (copy)_730990567789486085])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Overall Incident % MTD Color' datatype='string' name='[Esclated Cases % MTD Color (copy)_730990567789768711]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Esclated Cases %_cm (copy)_730990567789375492]) / SUM([Esclated Cases %_lm (copy)_730990567789486085])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Overall Incident %_cm' datatype='real' name='[Esclated Cases %_cm (copy)_730990567789375492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [total_chat_count] / [Gross Orders (copy)_846676784315985920]&#13;&#10;END' />
            </column>
            <column caption='Overall Incident %_lm' datatype='real' name='[Esclated Cases %_lm (copy)_730990567789486085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [total_chat_count] / [Gross Orders (copy)_846676784315985920]&#13;&#10;END' />
            </column>
            <column caption='Gross Orders.' datatype='real' name='[Gross Orders (copy)_846676784315985920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [report_date], [country]:AVG([gross_orders_non_vertical_count])}' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH_EU&quot;' value='DH EU' />
                <alias key='&quot;DH_EU + TR&quot;' value='DH EU + TR' />
