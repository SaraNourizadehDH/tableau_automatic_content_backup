            <column caption='Incident Rate CS MTD' datatype='string' name='[Incident Rate MTD (copy)_197032543096819717]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Incident Rate_cm (copy)_197032543096631299]) / SUM([Incident Rate_lm (copy)_197032543096729604])) - 1) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(((SUM([Incident Rate_cm (copy)_197032543096631299]) / SUM([Incident Rate_lm (copy)_197032543096729604])) - 1)*100,0)&#10;)&#10;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Incident Rate CS MTD Color' datatype='string' name='[Incident Rate MTD Color (copy)_197032543096983558]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Incident Rate_cm (copy)_197032543096631299]) / SUM([Incident Rate_lm (copy)_197032543096729604])) - 1) &gt;= 0&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Incident Rate CS_cm' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Incident Rate_cm (copy)_197032543096631299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [total_incidents_cs] / [Calculation_588001238920994897]&#13;&#10;END' />
            </column>
            <column caption='Incident Rate CS_lm' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Incident Rate_lm (copy)_197032543096729604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [total_incidents_cs] / [Calculation_588001238920994897]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
