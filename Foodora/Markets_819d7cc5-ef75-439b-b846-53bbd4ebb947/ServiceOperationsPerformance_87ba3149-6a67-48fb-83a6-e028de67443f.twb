            <column caption='RANK_PERCENTILE(ROUND([HT Cases],3))' datatype='real' name='[Calculation_2477894625285906443]' role='measure' type='quantitative' user:unnamed='HT Cases'>
              <calculation class='tableau' formula='RANK_PERCENTILE(ROUND([cases avg resolution time (copy)_2477894625285558281],3))'>
