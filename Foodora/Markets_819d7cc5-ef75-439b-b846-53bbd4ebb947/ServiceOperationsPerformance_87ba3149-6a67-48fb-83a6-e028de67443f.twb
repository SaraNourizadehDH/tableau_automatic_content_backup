              <calculation class='tableau' formula='IF((SUM([Calculation_1373034966919094279 1]) / SUM([Calculation_1373034966919315464 1])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Calculation_1373034966919094279 1]) / SUM([Calculation_1373034966919315464 1])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='QA % MTD Color' datatype='string' name='[Calculation_588001238738366472 1]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Calculation_1373034966919094279 1]) / SUM([Calculation_1373034966919315464 1])) - 1) &gt;= 0&#13;&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
