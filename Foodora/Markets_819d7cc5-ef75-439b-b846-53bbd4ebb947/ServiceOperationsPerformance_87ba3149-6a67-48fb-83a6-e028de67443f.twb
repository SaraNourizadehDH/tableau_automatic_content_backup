            </column>
            <column caption='Date (i - 2)' datatype='integer' name='[Date (i-1) (copy)_456271002486362137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;    when &apos;day&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-3, TODAY())) * 100 + DAY(DATEADD([Parameters].[Parameter 1],-3, TODAY()))&#13;&#10;    when &apos;week&apos; then ISOWEEK(DATEADD([Parameters].[Parameter 1],-2, TODAY()))&#13;&#10;    when &apos;month&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-2, TODAY()))&#13;&#10;end' />
            </column>
            <column caption='Email Resolution Time hrs (ToT)' datatype='string' default-format='p0%' name='[Incident Rate (ToT) (copy)_1133218269743165463]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [email_resolution_time_min] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [email_resolved_case_count] end) / 60) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [email_resolution_time_min] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [email_resolved_case_count] end) / 60)&#13;&#10;-1) &gt;= 0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END &#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [email_resolution_time_min] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [email_resolved_case_count] end) / 60) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [email_resolution_time_min] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [email_resolved_case_count] end) / 60)&#13;&#10;-1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Email Resolution Time hrs (ToT) Color' datatype='string' name='[Incident Rate (ToT) Color (copy)_1133218269743906840]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [email_resolution_time_min] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [email_resolved_case_count] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [email_resolution_time_min] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [email_resolved_case_count] end))&#13;&#10;-1) &gt;= 0 THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
