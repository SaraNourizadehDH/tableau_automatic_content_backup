          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='Customer Avg. Message Count MTD' datatype='string' name='[Avg. Message Count MTD (copy)_1204994428639215622]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Avg. Message count_cm (copy)_1204994428638969860]) / SUM([Avg. Message count_lm (copy)_1204994428639100933])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Avg. Message count_cm (copy)_1204994428638969860]) / SUM([Avg. Message count_lm (copy)_1204994428639100933])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Customer Avg. Message count MTD Color' datatype='string' name='[Avg. Message count MTD Color (copy)_1204994428639358983]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Avg. Message count_cm (copy)_1204994428638969860]) / SUM([Avg. Message count_lm (copy)_1204994428639100933])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Customer Avg. Message count_cm' datatype='real' name='[Avg. Message count_cm (copy)_1204994428638969860]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [customer_message_count] / ([total_message_count])&#13;&#10;END' />
            </column>
            <column caption='Customer Avg. Message count_lm' datatype='real' name='[Avg. Message count_lm (copy)_1204994428639100933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [customer_message_count] /([total_message_count])&#13;&#10;END' />
            </column>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
