            <column caption='Total Contacts' datatype='integer' name='[total_contacts]' role='measure' type='quantitative' />
            <column-instance column='[Incident Rate (ToT) (copy)_739997739914043394]' derivation='User' name='[usr:Incident Rate (ToT) (copy)_739997739914043394:nk]' pivot='key' type='nominal' />
            <column-instance column='[Incident Rate (ToT) Color (copy)_739997739914166275]' derivation='User' name='[usr:Incident Rate (ToT) Color (copy)_739997739914166275:nk]' pivot='key' type='nominal' />
            <column caption='Vertical Type' datatype='string' name='[vertical_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
