            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Seamless Orders % MTD' datatype='string' name='[Partially Fulfilled Order % MTD (copy)_76561220204863495]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Partially Fulfilled Order %_cm (copy)_76561220204576773]) / SUM([Partially Fulfilled Order %_lm (copy)_76561220204736518])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Partially Fulfilled Order %_cm (copy)_76561220204576773]) / SUM([Partially Fulfilled Order %_lm (copy)_76561220204736518])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Seamless Orders %_cm' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Partially Fulfilled Order %_cm (copy)_76561220204576773]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [seamless_orders_seamless] / [seamless_orders_all]&#13;&#10;END' />
            </column>
            <column caption='Seamless Orders %_lm' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Partially Fulfilled Order %_lm (copy)_76561220204736518]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [seamless_orders_seamless] / [seamless_orders_all]&#13;&#10;END' />
            </column>
            <column caption='Seamless Orders % MTD Color' datatype='string' name='[Partially Fulfilled Orders % MTD Color (copy)_76561220205199368]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Partially Fulfilled Order %_cm (copy)_76561220204576773]) / SUM([Partially Fulfilled Order %_lm (copy)_76561220204736518])) - 1) &gt;= 0&#13;&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
