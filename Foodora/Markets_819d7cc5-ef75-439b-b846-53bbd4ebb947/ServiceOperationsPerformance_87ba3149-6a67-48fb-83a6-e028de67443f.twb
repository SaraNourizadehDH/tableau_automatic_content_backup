          </datasources>
          <datasource-dependencies datasource='federated.08qj7o11ejfuo61fhb8ru15c7qi6'>
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column-instance column='[delivery_type]' derivation='None' name='[none:delivery_type:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1jslqxp0aasw7011l42k81hmghcj'>
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column-instance column='[delivery_type]' derivation='None' name='[none:delivery_type:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rntd771dk8uz21g9y0uv0f7jh6d'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Gross Order' datatype='real' name='[Calculation_794322396990222358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [is_self_cancellation], [is_cancelled_via_help_center], [is_inflected], [is_reordered]: &#10;SUM({ FIXED [report_date], [country], [vertical_type], [is_subscription_order], [is_corporate_order], [delivery_type]: AVG([gross_order_count])})}' />
            </column>
            <column caption='Customer Net Cancellation Rate % MTD' datatype='string' name='[Cancellation Rate % MTD (copy)_1812698864144568337]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Cancellation Rate %_cm (copy)_1812698864144420879]) / SUM([Cancellation Rate %_lm (copy)_1812698864144490512])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Cancellation Rate %_cm (copy)_1812698864144420879]) / SUM([Cancellation Rate %_lm (copy)_1812698864144490512])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Customer Net Cancellation Rate % MTD Color' datatype='string' name='[Cancellation Rate % MTD Color (copy)_1812698864144711698]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Cancellation Rate %_cm (copy)_1812698864144420879]) / SUM([Cancellation Rate %_lm (copy)_1812698864144490512])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Customer Net Cancellation Rate %_cm' datatype='real' name='[Cancellation Rate %_cm (copy)_1812698864144420879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN ([customer_net_cancellations]) * 100 / [Calculation_794322396990222358]&#13;&#10;END' />
            </column>
            <column caption='Customer Net Cancellation Rate %_lm' datatype='real' name='[Cancellation Rate %_lm (copy)_1812698864144490512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN ([customer_net_cancellations]) * 100 / [Calculation_794322396990222358]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH_EU&quot;' value='DH EU' />
                <alias key='&quot;DH_EU + TR&quot;' value='DH EU + TR' />
              </aliases>
            </column>
            <column caption='Customer Net Cancellations' datatype='integer' name='[customer_net_cancellations]' role='measure' type='quantitative' />
