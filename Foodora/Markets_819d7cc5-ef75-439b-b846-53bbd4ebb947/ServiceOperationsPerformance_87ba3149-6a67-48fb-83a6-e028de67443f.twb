    <worksheet name='SM Resolution MTD'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_country_evaluation_non_live' name='federated.1jslqxp0aasw7011l42k81hmghcj' />
          </datasources>
          <datasource-dependencies datasource='federated.1jslqxp0aasw7011l42k81hmghcj'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='SM Resolution Time hrs MTD' datatype='string' name='[Email Resolution Time hrs MTD (copy)_1133218269748797474]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Email Resolution Time hrs_cm (copy)_1133218269748441120]) / SUM([Email Resolution Time hrs_lm (copy)_1133218269748641825])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Email Resolution Time hrs_cm (copy)_1133218269748441120]) / SUM([Email Resolution Time hrs_lm (copy)_1133218269748641825])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='SM Resolution Time hrs MTD Color' datatype='string' name='[Email Resolution Time hrs MTD Color (copy)_1133218269749018659]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Email Resolution Time hrs_cm (copy)_1133218269748441120]) / SUM([Email Resolution Time hrs_lm (copy)_1133218269748641825])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='SM Resolution Time hrs_cm' datatype='real' name='[Email Resolution Time hrs_cm (copy)_1133218269748441120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN ([sm_resolution_time_min] / [sm_resolved_case_count]) / 60&#13;&#10;END' />
            </column>
            <column caption='SM Resolution Time hrs_lm' datatype='real' name='[Email Resolution Time hrs_lm (copy)_1133218269748641825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN ([sm_resolution_time_min] / [sm_resolved_case_count]) / 60&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='Is Corporate Order' datatype='string' name='[is_corporate_order]' role='dimension' type='nominal' />
            <column caption='Is Subscription Order' datatype='string' name='[is_subscription_order]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_588001238739361801]' derivation='None' name='[none:Calculation_588001238739361801:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
