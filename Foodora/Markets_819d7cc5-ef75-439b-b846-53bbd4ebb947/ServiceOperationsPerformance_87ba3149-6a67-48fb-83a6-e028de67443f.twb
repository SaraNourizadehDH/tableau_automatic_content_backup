    <worksheet name='Comp Reactive % MTD'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_compensation' name='federated.08qj7o11ejfuo61fhb8ru15c7qi6' />
            <datasource caption='regional_eu_cx_sop_country_evaluation_non_live' name='federated.1jslqxp0aasw7011l42k81hmghcj' />
          </datasources>
          <datasource-dependencies datasource='federated.08qj7o11ejfuo61fhb8ru15c7qi6'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Reactive Compensation % MTD' datatype='string' name='[Voucher Created EUR MTD (copy)_1133218269811507261]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Voucher Created EUR_cm (copy)_1133218269811126331]) / SUM([Voucher Created EUR_lm (copy)_1133218269811343420])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Voucher Created EUR_cm (copy)_1133218269811126331]) / SUM([Voucher Created EUR_lm (copy)_1133218269811343420])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Reactive Compensation % MTD Color' datatype='string' name='[Voucher Created EUR MTD Color (copy)_1133218269811769406]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Voucher Created EUR_cm (copy)_1133218269811126331]) / SUM([Voucher Created EUR_lm (copy)_1133218269811343420])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Reactive Compensation %_cm' datatype='real' name='[Voucher Created EUR_cm (copy)_1133218269811126331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [created_voucher_count] / [total_incidents]&#13;&#10;END' />
            </column>
            <column caption='Reactive Compensation %_lm' datatype='real' name='[Voucher Created EUR_lm (copy)_1133218269811343420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [created_voucher_count] / [total_incidents]&#13;&#10;END' />
