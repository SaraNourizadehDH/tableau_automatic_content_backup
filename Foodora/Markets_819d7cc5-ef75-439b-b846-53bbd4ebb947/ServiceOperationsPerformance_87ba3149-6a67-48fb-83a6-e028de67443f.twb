            <column-instance column='[Esclated Cases % MTD Color (copy)_730990567789768711]' derivation='User' name='[usr:Esclated Cases % MTD Color (copy)_730990567789768711:nk]' pivot='key' type='nominal' />
            <column caption='Vertical Type' datatype='string' name='[vertical_type]' role='dimension' type='nominal' />
