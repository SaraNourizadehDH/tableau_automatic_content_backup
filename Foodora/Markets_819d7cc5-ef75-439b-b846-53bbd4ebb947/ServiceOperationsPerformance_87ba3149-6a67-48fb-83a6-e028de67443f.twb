            <column-instance column='[vertical_type]' derivation='None' name='[none:vertical_type:nk]' pivot='key' type='nominal' />
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[automated_session]' derivation='Sum' name='[sum:automated_session:qk]' pivot='key' type='quantitative' />
            <column-instance column='[contacted_session]' derivation='Sum' name='[sum:contacted_session:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_sessions_resolution_page_reached]' derivation='Sum' name='[sum:total_sessions_resolution_page_reached:qk]' pivot='key' type='quantitative' />
            <column caption='Total Sessions Resolution Page Reached' datatype='integer' name='[total_sessions_resolution_page_reached]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3119868707176804352]' derivation='User' name='[usr:Calculation_3119868707176804352:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
