          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='Chat SLA 30s %_cm' datatype='real' name='[CSAT %_cm (copy)_588001238753415183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [chat_sla_30_count] * 100 / [total_chats_count]&#13;&#10;END' />
            </column>
            <column caption='Chat SLA 30s %_lm' datatype='real' name='[CSAT %_lm (copy)_588001238753558544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [chat_sla_30_count] * 100 / [total_chats_count]&#13;&#10;END' />
            </column>
            <column caption='Chat SLA 30s MTD' datatype='string' name='[CSAT MTD (copy)_588001238753693713]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([CSAT %_cm (copy)_588001238753415183]) / SUM([CSAT %_lm (copy)_588001238753558544])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([CSAT %_cm (copy)_588001238753415183]) / SUM([CSAT %_lm (copy)_588001238753558544])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Chat SLA 30s MTD Color' datatype='string' name='[CSAT MTD Color (copy)_588001238753972242]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([CSAT %_cm (copy)_588001238753415183]) / SUM([CSAT %_lm (copy)_588001238753558544])) - 1) &gt;= 0&#13;&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Chat Sla 30 Count' datatype='integer' name='[chat_sla_30_count]' role='measure' type='quantitative' />
