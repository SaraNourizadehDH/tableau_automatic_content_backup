    <worksheet name='Avg. Response time min MTD'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_country_evaluation' name='federated.1qbrtpj0t7ty5q19dup500c8yi6m' />
          </datasources>
          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Avg. Response Time min MTD' datatype='string' name='[Customer Abandoned % MTD (copy)_730990567817801786]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Customer Abandoned %_cm (copy)_730990567817371704]) / SUM([Customer Abandoned %_lm (copy)_730990567817564217])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Customer Abandoned %_cm (copy)_730990567817371704]) / SUM([Customer Abandoned %_lm (copy)_730990567817564217])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Avg. Response Time min MTD Color' datatype='string' name='[Customer Abandoned % MTD Color (copy)_730990567817990203]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Customer Abandoned %_cm (copy)_730990567817371704]) / SUM([Customer Abandoned %_lm (copy)_730990567817564217])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Avg. Response Time min_cm' datatype='real' name='[Customer Abandoned %_cm (copy)_730990567817371704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN ([response_time_sec]/60) / [served_chat_count]&#13;&#10;END' />
            </column>
            <column caption='Avg. Response Time min_lm' datatype='real' name='[Customer Abandoned %_lm (copy)_730990567817564217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN ([response_time_sec]/60) / [served_chat_count]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH_EU&quot;' value='DH EU' />
                <alias key='&quot;DH_EU + TR&quot;' value='DH EU + TR' />
              </aliases>
            </column>
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='Is Fraud' datatype='string' name='[is_fraud]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_588001238739361801]' derivation='None' name='[none:Calculation_588001238739361801:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_type]' derivation='None' name='[none:delivery_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_fraud]' derivation='None' name='[none:is_fraud:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical_type]' derivation='None' name='[none:vertical_type:nk]' pivot='key' type='nominal' />
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column caption='Response Time Sec' datatype='integer' name='[response_time_sec]' role='measure' type='quantitative' />
            <column caption='Served Chat Count' datatype='integer' name='[served_chat_count]' role='measure' type='quantitative' />
            <column-instance column='[Customer Abandoned % MTD (copy)_730990567817801786]' derivation='User' name='[usr:Customer Abandoned % MTD (copy)_730990567817801786:nk]' pivot='key' type='nominal' />
            <column-instance column='[Customer Abandoned % MTD Color (copy)_730990567817990203]' derivation='User' name='[usr:Customer Abandoned % MTD Color (copy)_730990567817990203:nk]' pivot='key' type='nominal' />
