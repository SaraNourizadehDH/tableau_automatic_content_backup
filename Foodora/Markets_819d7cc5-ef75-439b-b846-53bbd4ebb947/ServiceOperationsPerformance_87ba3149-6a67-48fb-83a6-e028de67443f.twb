          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='Abandoned Call MTD' datatype='string' name='[Abondened Chat MTD (copy)_1769703579708067854]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Abondened Chat_cm (copy)_1769703579707060234]) / SUM([Abondened Chat_lm (copy)_1769703579707916301])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Abondened Chat_cm (copy)_1769703579707060234]) / SUM([Abondened Chat_lm (copy)_1769703579707916301])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Abandoned Call MTD Color' datatype='string' name='[Abondened Chat MTD Color (copy)_1769703579708289039]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Abondened Chat_cm (copy)_1769703579707060234]) / SUM([Abondened Chat_lm (copy)_1769703579707916301])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Abandoned Call_cm' datatype='real' name='[Abondened Chat_cm (copy)_1769703579707060234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN ([missed_inbound_calls]) / [total_inbound_calls]&#13;&#10;END' />
            </column>
            <column caption='Abandoned Call_lm' datatype='real' name='[Abondened Chat_lm (copy)_1769703579707916301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN ([missed_inbound_calls]) / [total_inbound_calls]&#13;&#10;END' />
            </column>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
