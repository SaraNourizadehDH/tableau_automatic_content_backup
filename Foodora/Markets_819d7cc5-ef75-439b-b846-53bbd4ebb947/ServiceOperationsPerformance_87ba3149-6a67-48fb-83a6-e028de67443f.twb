    <worksheet name='Deflection Rate MTD'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_country_evaluation_cx' name='federated.003n5dq1v862mm1h53rcg044y4e9' />
            <datasource caption='regional_eu_cx_sop_cancellation' name='federated.1rntd771dk8uz21g9y0uv0f7jh6d' />
            <datasource caption='regional_eu_cx_sop_country_evaluation_non_live' name='federated.1jslqxp0aasw7011l42k81hmghcj' />
            <datasource caption='regional_eu_cx_sop_compensation' name='federated.08qj7o11ejfuo61fhb8ru15c7qi6' />
          </datasources>
          <datasource-dependencies datasource='federated.003n5dq1v862mm1h53rcg044y4e9'>
            <column caption='Deflection Rate % MTD' datatype='string' name='[AO NPS % MTD (copy)_794322396946300941]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([AO NPS %_cm (copy)_794322396945817611]) / SUM([AO NPS %_lm (copy)_794322396946178060])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([AO NPS %_cm (copy)_794322396945817611]) / SUM([AO NPS %_lm (copy)_794322396946178060])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Deflection Rate % MTD Color' datatype='string' name='[AO NPS % MTD Color (copy)_794322396946460686]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([AO NPS %_cm (copy)_794322396945817611]) / SUM([AO NPS %_lm (copy)_794322396946178060])) - 1) &gt;= 0&#13;&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column caption='Deflection Rate %_cm' datatype='real' name='[AO NPS %_cm (copy)_794322396945817611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN 1-((ZN([automated_session]) + ZN([contacted_session])) / [total_sessions_resolution_page_reached])&#13;&#10;END' />
            </column>
            <column caption='Deflection Rate %_lm' datatype='real' name='[AO NPS %_lm (copy)_794322396946178060]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN 1 - ((ZN([automated_session]) + ZN([contacted_session])) / [total_sessions_resolution_page_reached])&#13;&#10;END' />
            </column>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Automated Session' datatype='integer' name='[automated_session]' role='measure' type='quantitative' />
            <column caption='Contacted Session' datatype='integer' name='[contacted_session]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH_EU&quot;' value='DH EU' />
                <alias key='&quot;DH_EU + TR&quot;' value='DH EU + TR' />
              </aliases>
            </column>
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='Is Corporate Order' datatype='string' name='[is_corporate_order]' role='dimension' type='nominal' />
            <column caption='Is Fraud' datatype='string' name='[is_fraud]' role='dimension' type='nominal' />
            <column caption='Is Subscription Order' datatype='string' name='[is_subscription_order]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_588001238739361801]' derivation='None' name='[none:Calculation_588001238739361801:nk]' pivot='key' type='nominal' />
