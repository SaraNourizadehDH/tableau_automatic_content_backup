    <datasource caption='regional_eu_cx_sop_country_evaluation' inline='true' name='federated.1qbrtpj0t7ty5q19dup500c8yi6m' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1r54q6b0gb8m3i14a7si10q83a61'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-eu' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='server-custom' username='ozan.kir@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1r54q6b0gb8m3i14a7si10q83a61' name='Custom SQL Query1' type='text'><![CDATA[WITH all_cases_data AS (

SELECT
    created_date AS report_date,
    shared_countries.name AS country,
    CASE
      WHEN LOWER(stakeholder) LIKE "%customer%" THEN "Customer Service"
      WHEN LOWER(stakeholder) LIKE "%vendor%" THEN "Partner Service"
      WHEN LOWER(stakeholder) LIKE "%rider%" THEN "Dispatching"
    END AS department,
    CASE
      WHEN delivery_type = "Pick-up" THEN "pickup"
      WHEN delivery_type = 'Own Delivery' THEN "Own Delivery"
      WHEN delivery_type = 'Vendor Delivery' THEN "Vendor Delivery"
      ELSE "NULL"
    END AS delivery_type,
    IF(channel IN ('Email', 'Form', 'Social Media') AND incoming_case_ind = 1 AND case_within_sla_8h = 1, case_id, NULL) AS cases_sla_8h_count,
    IF(channel IN ('Email', 'Form', 'Social Media') AND incoming_case_ind = 1 AND case_within_sla_48h = 1, case_id, NULL) AS cases_sla_48h_count,
    IF(channel IN ('Email', 'Form', 'Social Media') AND incoming_case_ind = 1, case_id, NULL) AS total_incoming_cases_count,
    IF(channel IN ('Email', 'Form', 'Social Media') AND resolved_case_ind = 1, case_id, NULL) AS total_resolved_cases_count,
    SUM(CASE
      WHEN channel IN ('Email', 'Form', 'Social Media')
        THEN (IFNULL(sum_handling_time_l1_escalated, 0) + IFNULL(sum_handling_time_l1_close, 0) + IFNULL(sum_handling_time_l2, 0))
      END) AS case_handling_time,
      SUM(CASE
      WHEN channel IN ('Email', 'Form', 'Social Media')
        THEN full_resolution_time END) AS full_resolution_time,
      SUM(CASE
      WHEN channel IN ('Email', 'Form', 'Social Media')
        THEN csat*incoming_case_ind END) AS cases_csat_sum,
      COUNT(DISTINCT CASE
      WHEN channel IN ('Email', 'Form', 'Social Media') AND csat IS NOT NULL
        THEN case_id END) AS cases_csat_count,
    -- IF(incoming_case_ind = 1, case_id, NULL) AS total_incoming_cases_count,
  FROM `fulfillment-dwh-production.curated_data_shared.all_cases` AS cases
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_eu__countries` AS shared_countries
         ON cases.global_entity_id = shared_countries.global_entity_id
  WHERE created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
    AND shared_countries.name IS NOT NULL
    AND LOWER(shared_countries.name) NOT IN ("cyprus", "greece","romania")
  GROUP BY
  1, 2, 3, 4, 5, 6, 7, 8
),

prep AS (SELECT
    report_date,
    country,
    department,
    delivery_type,
    COUNT(DISTINCT cases_sla_8h_count) AS cases_sla_8h_count,
    COUNT(DISTINCT cases_sla_48h_count) AS cases_sla_48h_count,
    COUNT(DISTINCT total_incoming_cases_count) AS total_incoming_cases_count,
    COUNT(DISTINCT total_resolved_cases_count) AS total_resolved_cases_count,
    SUM(case_handling_time) case_handling_time,
    SUM(full_resolution_time) full_resolution_time,
    SUM(cases_csat_count) cases_csat_count,
    SUM(cases_csat_sum) cases_csat_sum
    -- COUNT(DISTINCT inbound_calls_count) AS total_inbound_calls_count,
    -- SAFE_DIVIDE(COUNT(DISTINCT calls_sla_30_count), SUM(inbound_calls_count)) AS ratio
    -- SUM(handling_time_inbound_calls_sec) AS handling_time_inbound_calls_sec,
    -- COUNT(DISTINCT total_calls_outbound) AS total_calls_outbound,
    -- COUNT(DISTINCT answered_calls_inbound_total) AS answered_calls_inbound_total
  FROM all_cases_data
  GROUP BY
    report_date,
    country,
    department,
    delivery_type),

total_without_TR AS (SELECT
    report_date,
    'DH_EU' AS country,
    department,
    delivery_type,
    SUM(cases_sla_8h_count) AS cases_sla_8h_count,
    SUM(cases_sla_48h_count) AS cases_sla_48h_count,
    SUM(total_incoming_cases_count) AS total_incoming_cases_count,
    SUM(total_resolved_cases_count) AS total_resolved_cases_count,
    SUM(case_handling_time) case_handling_time,
    SUM(full_resolution_time) full_resolution_time,
    SUM(cases_csat_count) cases_csat_count,
    SUM(cases_csat_sum) cases_csat_sum
    FROM prep
    WHERE country <<>> "Turkey"
    GROUP BY
    1, 2, 3, 4
),

total_with_TR AS (SELECT
    report_date,
    'DH_EU + TR' AS country,
    department,
    delivery_type,
    SUM(cases_sla_8h_count) AS cases_sla_8h_count,
    SUM(cases_sla_48h_count) AS cases_sla_48h_count,
    SUM(total_incoming_cases_count) AS total_incoming_cases_count,
    SUM(total_resolved_cases_count) AS total_resolved_cases_count,
    SUM(case_handling_time) case_handling_time,
    SUM(full_resolution_time) full_resolution_time,
    SUM(cases_csat_count) cases_csat_count,
    SUM(cases_csat_sum) cases_csat_sum
    FROM prep
    GROUP BY
    1, 2, 3, 4)

  SELECT *
  FROM prep
  UNION ALL
  SELECT *
  FROM total_with_TR
  UNION ALL
  SELECT *
  FROM total_without_TR]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
