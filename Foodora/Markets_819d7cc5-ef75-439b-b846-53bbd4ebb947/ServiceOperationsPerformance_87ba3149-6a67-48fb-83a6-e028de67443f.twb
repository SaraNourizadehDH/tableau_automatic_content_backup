          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Audits % MTD' datatype='string' name='[Perfect Interaction % MTD (copy)_588001238901928015]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Perfect Interaction %_cm (copy)_588001238901669965]) / SUM([Perfect Interaction %_lm (copy)_588001238901796942])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Perfect Interaction %_cm (copy)_588001238901669965]) / SUM([Perfect Interaction %_lm (copy)_588001238901796942])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Audits % MTD Color' datatype='string' name='[Perfect Interaction % MTD Color (copy)_588001238902067280]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Perfect Interaction %_cm (copy)_588001238901669965]) / SUM([Perfect Interaction %_lm (copy)_588001238901796942])) - 1) &gt;= 0&#13;&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column caption='Audits %_cm' datatype='real' name='[Perfect Interaction %_cm (copy)_588001238901669965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-3)) AND DAY([report_date]) &lt;= DAY(TODAY()-3)&#13;&#10;THEN [evaluation_count] / [total_incidents]&#13;&#10;END' />
            </column>
            <column caption='Audits %_lm' datatype='real' name='[Perfect Interaction %_lm (copy)_588001238901796942]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-3))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-3))&#13;&#10;THEN [evaluation_count] / [total_incidents]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH_EU&quot;' value='DH EU' />
                <alias key='&quot;DH_EU + TR&quot;' value='DH EU + TR' />
