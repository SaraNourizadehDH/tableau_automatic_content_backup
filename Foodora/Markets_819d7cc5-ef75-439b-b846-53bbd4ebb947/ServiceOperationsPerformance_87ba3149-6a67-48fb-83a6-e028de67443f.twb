          <datasource-dependencies datasource='federated.1jslqxp0aasw7011l42k81hmghcj'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Email Resolution Time hrs MTD' datatype='string' name='[Incident Rate MTD (copy)_1133218269744807963]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Incident Rate_cm (copy)_1133218269744164889]) / SUM([Incident Rate_lm (copy)_1133218269744455706])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Incident Rate_cm (copy)_1133218269744164889]) / SUM([Incident Rate_lm (copy)_1133218269744455706])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Email Resolution Time hrs MTD Color' datatype='string' name='[Incident Rate MTD Color (copy)_1133218269744988188]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Incident Rate_cm (copy)_1133218269744164889]) / SUM([Incident Rate_lm (copy)_1133218269744455706])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Email Resolution Time hrs_cm' datatype='real' name='[Incident Rate_cm (copy)_1133218269744164889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN ([email_resolution_time_min]/60) / [email_resolved_case_count]&#13;&#10;END' />
            </column>
            <column caption='Email Resolution Time hrs_lm' datatype='real' name='[Incident Rate_lm (copy)_1133218269744455706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN ([email_resolution_time_min]/60) / [email_resolved_case_count]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
