    <worksheet name='CS Email FRT MTD'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_country_evaluation_non_live' name='federated.1jslqxp0aasw7011l42k81hmghcj' />
          </datasources>
          <datasource-dependencies datasource='federated.1jslqxp0aasw7011l42k81hmghcj'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Email AVG FRT hrs MTD' datatype='string' name='[Deflection Rate % MTD (copy)_794322396958216212]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Deflection Rate %_cm (copy)_794322396957925394]) / SUM([Deflection Rate %_lm (copy)_794322396958068755])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Deflection Rate %_cm (copy)_794322396957925394]) / SUM([Deflection Rate %_lm (copy)_794322396958068755])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Email AVG FRT hrs MTD Color' datatype='string' name='[Deflection Rate % MTD Color (copy)_794322396958359573]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Deflection Rate %_cm (copy)_794322396957925394]) / SUM([Deflection Rate %_lm (copy)_794322396958068755])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Email AVG FRT hrs_cm' datatype='real' name='[Deflection Rate %_cm (copy)_794322396957925394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN ([email_first_repsonse_ht_min] / [email_cases]) / 60&#13;&#10;END' />
            </column>
            <column caption='Email AVG FRT hrs_lm' datatype='real' name='[Deflection Rate %_lm (copy)_794322396958068755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN ([email_first_repsonse_ht_min] / [email_cases]) / 60&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
