            <column caption='Overall Abandoned % MTD' datatype='string' name='[Overall Incident % MTD (copy)_730990567807922210]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Overall Incident %_cm (copy)_730990567807647776]) / SUM([Overall Incident %_lm (copy)_730990567807782945])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Overall Incident %_cm (copy)_730990567807647776]) / SUM([Overall Incident %_lm (copy)_730990567807782945])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Overall Abandoned % MTD Color' datatype='string' name='[Overall Incident % MTD Color (copy)_730990567808180259]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Overall Incident %_cm (copy)_730990567807647776]) / SUM([Overall Incident %_lm (copy)_730990567807782945])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Overall Abandoned %_cm' datatype='real' name='[Overall Incident %_cm (copy)_730990567807647776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [missed_chat_count] / [total_chat_count]&#13;&#10;END' />
            </column>
            <column caption='Overall Abandoned %_lm' datatype='real' name='[Overall Incident %_lm (copy)_730990567807782945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [missed_chat_count] / [total_chat_count]&#13;&#10;END' />
            </column>
