            <column caption='Proactive % (ToT) Color' datatype='string' name='[Chat SLA 30s (ToT) Color (copy)_588001238755557400 1]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then (IF([compensation_type] = &apos;Proactive&apos;) THEN [created_voucher_count] END) end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [created_voucher_count] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then (IF([compensation_type] = &apos;Proactive&apos;) THEN [created_voucher_count] END) end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [created_voucher_count] end))&#13;&#10;-1) &gt;= 0 THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
