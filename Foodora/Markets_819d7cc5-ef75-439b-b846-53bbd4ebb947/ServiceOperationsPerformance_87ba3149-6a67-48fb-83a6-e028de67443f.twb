          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Cases SLA 8h %_cm' datatype='real' name='[Calls SLA 30s %_cm (copy)_5976769320890662913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [cases_sla_8h_count] * 100 / [total_incoming_cases_count]&#13;&#10;END' />
            </column>
            <column caption='Cases SLA 8h %_lm' datatype='real' name='[Calls SLA 30s %_lm (copy)_5976769320890793986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [cases_sla_8h_count] * 100 / [total_incoming_cases_count]&#13;&#10;END' />
            </column>
            <column caption='Cases SLA 8h MTD' datatype='string' name='[Calls SLA 30s MTD (copy)_5976769320890953731]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Calls SLA 30s %_cm (copy)_5976769320890662913]) / SUM([Calls SLA 30s %_lm (copy)_5976769320890793986])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Calls SLA 30s %_cm (copy)_5976769320890662913])) / SUM([Calls SLA 30s %_lm (copy)_5976769320890793986]) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Cases SLA 8h MTD Color' datatype='string' name='[Calls SLA 30s MTD Color (copy)_5976769320891314180]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Calls SLA 30s %_cm (copy)_5976769320890662913]) / SUM([Calls SLA 30s %_lm (copy)_5976769320890793986])) - 1) &gt;= 0&#13;&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column datatype='integer' name='[cases_sla_8h_count]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
