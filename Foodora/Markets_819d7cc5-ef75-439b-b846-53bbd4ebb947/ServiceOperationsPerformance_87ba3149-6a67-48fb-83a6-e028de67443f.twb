            <column-instance column='[Incident Rate (ToT) (copy)_1949777177914339330]' derivation='User' name='[usr:Incident Rate (ToT) (copy)_1949777177914339330:nk]' pivot='key' type='nominal' />
            <column-instance column='[Incident Rate (ToT) Color (copy)_1949777177914634243]' derivation='User' name='[usr:Incident Rate (ToT) Color (copy)_1949777177914634243:nk]' pivot='key' type='nominal' />
