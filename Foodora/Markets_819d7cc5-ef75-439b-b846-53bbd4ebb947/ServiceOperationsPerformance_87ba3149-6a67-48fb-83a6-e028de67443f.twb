      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Malaysia&quot;' />
      </semantic-values>
      <date-options start-of-week='monday' />
      <default-date-format>*yyyy\ \Www</default-date-format>
      <default-sorts>
        <manual-sort column='[none:country:nk]' direction='ASC'>
          <dictionary>
            <bucket>&quot;DH_EU + TR&quot;</bucket>
            <bucket>&quot;DH_EU&quot;</bucket>
            <bucket>&quot;Austria&quot;</bucket>
            <bucket>&quot;Czech Republic&quot;</bucket>
            <bucket>&quot;Denmark&quot;</bucket>
            <bucket>&quot;Finland&quot;</bucket>
            <bucket>&quot;Germany&quot;</bucket>
            <bucket>&quot;Hungary&quot;</bucket>
            <bucket>&quot;Norway&quot;</bucket>
            <bucket>&quot;Slovakia&quot;</bucket>
            <bucket>&quot;Sweden&quot;</bucket>
            <bucket>&quot;Turkey&quot;</bucket>
          </dictionary>
        </manual-sort>
      </default-sorts>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Daily' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
          <calculation class='tableau' formula='&quot;day&quot;' />
          <aliases>
            <alias key='&quot;day&quot;' value='Daily' />
            <alias key='&quot;month&quot;' value='Monthly' />
            <alias key='&quot;week&quot;' value='Weekly' />
          </aliases>
        </column>
      </datasource-dependencies>
      <filter class='categorical' column='[User Group Filter]' filter-group='2' />
      <filter class='categorical' column='[country]' filter-group='2'>
        <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
          <groupfilter function='level-members' level='[country]' />
          <groupfilter function='union'>
            <groupfilter function='member' level='[country]' member='&quot;Denmark&quot;' />
            <groupfilter function='member' level='[country]' member='%null%' />
          </groupfilter>
        </groupfilter>
      </filter>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='PS_cases' id='_545D79DBC8CF4352A615220EB4B9E2F9'>
            <properties context=''>
              <relation connection='bigquery.1r54q6b0gb8m3i14a7si10q83a61' name='Custom SQL Query1' type='text'><![CDATA[WITH all_cases_data AS (

SELECT
    created_date AS report_date,
    shared_countries.name AS country,
    CASE
      WHEN LOWER(stakeholder) LIKE "%customer%" THEN "Customer Service"
      WHEN LOWER(stakeholder) LIKE "%vendor%" THEN "Partner Service"
      WHEN LOWER(stakeholder) LIKE "%rider%" THEN "Dispatching"
    END AS department,
    CASE
      WHEN delivery_type = "Pick-up" THEN "pickup"
      WHEN delivery_type = 'Own Delivery' THEN "Own Delivery"
      WHEN delivery_type = 'Vendor Delivery' THEN "Vendor Delivery"
      ELSE "NULL"
    END AS delivery_type,
    IF(channel IN ('Email', 'Form', 'Social Media') AND incoming_case_ind = 1 AND case_within_sla_8h = 1, case_id, NULL) AS cases_sla_8h_count,
    IF(channel IN ('Email', 'Form', 'Social Media') AND incoming_case_ind = 1 AND case_within_sla_48h = 1, case_id, NULL) AS cases_sla_48h_count,
    IF(channel IN ('Email', 'Form', 'Social Media') AND incoming_case_ind = 1, case_id, NULL) AS total_incoming_cases_count,
    IF(channel IN ('Email', 'Form', 'Social Media') AND resolved_case_ind = 1, case_id, NULL) AS total_resolved_cases_count,
    SUM(CASE
      WHEN channel IN ('Email', 'Form', 'Social Media')
        THEN (IFNULL(sum_handling_time_l1_escalated, 0) + IFNULL(sum_handling_time_l1_close, 0) + IFNULL(sum_handling_time_l2, 0))
      END) AS case_handling_time,
      SUM(CASE
      WHEN channel IN ('Email', 'Form', 'Social Media')
        THEN full_resolution_time END) AS full_resolution_time,
      SUM(CASE
      WHEN channel IN ('Email', 'Form', 'Social Media')
        THEN csat*incoming_case_ind END) AS cases_csat_sum,
      COUNT(DISTINCT CASE
      WHEN channel IN ('Email', 'Form', 'Social Media') AND csat IS NOT NULL
        THEN case_id END) AS cases_csat_count,
    -- IF(incoming_case_ind = 1, case_id, NULL) AS total_incoming_cases_count,
  FROM `fulfillment-dwh-production.curated_data_shared.all_cases` AS cases
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_eu__countries` AS shared_countries
         ON cases.global_entity_id = shared_countries.global_entity_id
  WHERE created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
    AND shared_countries.name IS NOT NULL
    AND LOWER(shared_countries.name) NOT IN ("cyprus", "greece","romania")
  GROUP BY
  1, 2, 3, 4, 5, 6, 7, 8
),

prep AS (SELECT
    report_date,
    country,
    department,
    delivery_type,
    COUNT(DISTINCT cases_sla_8h_count) AS cases_sla_8h_count,
    COUNT(DISTINCT cases_sla_48h_count) AS cases_sla_48h_count,
    COUNT(DISTINCT total_incoming_cases_count) AS total_incoming_cases_count,
    COUNT(DISTINCT total_resolved_cases_count) AS total_resolved_cases_count,
    SUM(case_handling_time) case_handling_time,
    SUM(full_resolution_time) full_resolution_time,
    SUM(cases_csat_count) cases_csat_count,
    SUM(cases_csat_sum) cases_csat_sum
    -- COUNT(DISTINCT inbound_calls_count) AS total_inbound_calls_count,
    -- SAFE_DIVIDE(COUNT(DISTINCT calls_sla_30_count), SUM(inbound_calls_count)) AS ratio
    -- SUM(handling_time_inbound_calls_sec) AS handling_time_inbound_calls_sec,
    -- COUNT(DISTINCT total_calls_outbound) AS total_calls_outbound,
    -- COUNT(DISTINCT answered_calls_inbound_total) AS answered_calls_inbound_total
  FROM all_cases_data
  GROUP BY
    report_date,
    country,
    department,
    delivery_type),

total_without_TR AS (SELECT
    report_date,
    'DH_EU' AS country,
    department,
    delivery_type,
    SUM(cases_sla_8h_count) AS cases_sla_8h_count,
    SUM(cases_sla_48h_count) AS cases_sla_48h_count,
    SUM(total_incoming_cases_count) AS total_incoming_cases_count,
    SUM(total_resolved_cases_count) AS total_resolved_cases_count,
    SUM(case_handling_time) case_handling_time,
    SUM(full_resolution_time) full_resolution_time,
    SUM(cases_csat_count) cases_csat_count,
    SUM(cases_csat_sum) cases_csat_sum
    FROM prep
    WHERE country <<>> "Turkey"
    GROUP BY
    1, 2, 3, 4
),

total_with_TR AS (SELECT
    report_date,
    'DH_EU + TR' AS country,
    department,
    delivery_type,
    SUM(cases_sla_8h_count) AS cases_sla_8h_count,
    SUM(cases_sla_48h_count) AS cases_sla_48h_count,
    SUM(total_incoming_cases_count) AS total_incoming_cases_count,
    SUM(total_resolved_cases_count) AS total_resolved_cases_count,
    SUM(case_handling_time) case_handling_time,
    SUM(full_resolution_time) full_resolution_time,
    SUM(cases_csat_count) cases_csat_count,
    SUM(cases_csat_sum) cases_csat_sum
    FROM prep
    GROUP BY
    1, 2, 3, 4)

  SELECT *
  FROM prep
  UNION ALL
  SELECT *
  FROM total_with_TR
  UNION ALL
  SELECT *
  FROM total_without_TR]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_545D79DBC8CF4352A615220EB4B9E2F9' table='[Extract].[_545D79DBC8CF4352A615220EB4B9E2F9]' type='table' />
            </properties>
          </object>
          <object caption='PS_calls' id='_CCFA9B312EF34C72BAED747BF2AF70DB'>
            <properties context=''>
              <relation connection='bigquery.1r54q6b0gb8m3i14a7si10q83a61' name='Custom SQL Query' type='text'><![CDATA[WITH all_calls_data AS (

SELECT
    created_date AS report_date,
    shared_countries.name AS country,
    CASE
      WHEN LOWER(stakeholder) LIKE "%customer%" THEN "Customer Service"
      WHEN LOWER(stakeholder) LIKE "%vendor%" THEN "Partner Service"
      WHEN LOWER(stakeholder) LIKE "%rider%" THEN "Dispatching"
    END AS department,
    IF(direction = 'Inbound' AND served_call_ind = 1 AND queue_time_secs <<= 30, call_id, NULL) AS calls_sla_30_count,
    IFNULL(inbound_call_ind, 0) - IFNULL(abandoned_call_ind, 0) + IFNULL(missed_call_ind, 0) AS inbound_calls_count,
    IFNULL(missed_call_ind, 0) AS missed_calls_count,
    IF(direction = 'Inbound' AND served_call_ind = 1, call_id, NULL) AS valid_inbound_calls_count,
    IF(direction = 'Inbound', handling_time_secs, NULL) AS handling_time_inbound_calls_sec,
    IF(direction = 'Outbound', call_id, NULL) AS total_calls_outbound,
    IF(direction = 'Inbound' AND served_call_ind = 1, call_id, NULL) AS answered_calls_inbound_total
  FROM `fulfillment-dwh-production.curated_data_shared.all_calls` AS gcc_toku_calls
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_eu__countries` AS shared_countries
         ON gcc_toku_calls.global_entity_id = shared_countries.global_entity_id
  WHERE created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
    AND shared_countries.name IS NOT NULL
    AND LOWER(shared_countries.name) NOT IN ("cyprus", "greece","romania")
),

prep AS (SELECT
    report_date,
    country,
    department,
    -- "NULL" AS vertical_type,
    -- "NULL" AS is_corporate_order,
    -- "NULL" AS is_subscription_order,
    -- "NULL" AS is_fraud,
    COUNT(DISTINCT calls_sla_30_count) AS calls_sla_30,
    COUNT(DISTINCT valid_inbound_calls_count) AS valid_inbound_calls,
    -- COUNT(DISTINCT inbound_calls_count) AS total_inbound_calls_count,
    SUM(inbound_calls_count) total_inbound_calls,
    SUM(missed_calls_count) missed_inbound_calls,
    -- SAFE_DIVIDE(COUNT(DISTINCT calls_sla_30_count), SUM(inbound_calls_count)) AS ratio
    SUM(handling_time_inbound_calls_sec) AS handling_time_inbound_calls_sec,
    -- COUNT(DISTINCT total_calls_outbound) AS total_calls_outbound,
    -- COUNT(DISTINCT answered_calls_inbound_total) AS answered_calls_inbound_total
  FROM all_calls_data
  GROUP BY
    report_date,
    country,
    department),

total_without_TR AS (SELECT
    report_date,
    'DH_EU' AS country,
    department,
    -- "NULL" AS vertical_type,
    -- "NULL" AS is_corporate_order,
    -- "NULL" AS is_subscription_order,
    -- "NULL" AS is_fraud,
    SUM(calls_sla_30) AS calls_sla_30,
    SUM(valid_inbound_calls) AS valid_inbound_calls,
    -- COUNT(DISTINCT inbound_calls_count) AS total_inbound_calls_count,
    SUM(total_inbound_calls) total_inbound_calls,
    SUM(missed_inbound_calls) missed_inbound_calls,
    SUM(handling_time_inbound_calls_sec) AS handling_time_inbound_calls_sec,
    FROM prep
    WHERE country <<>> "Turkey"
    GROUP BY
    1, 2, 3
),

total_with_TR AS (SELECT
    report_date,
    'DH_EU + TR' AS country,
    department,
    -- "NULL" AS vertical_type,
    -- "NULL" AS is_corporate_order,
    -- "NULL" AS is_subscription_order,
    -- "NULL" AS is_fraud,
    SUM(calls_sla_30) AS calls_sla_30,
    SUM(valid_inbound_calls) AS valid_inbound_calls,
    -- COUNT(DISTINCT inbound_calls_count) AS total_inbound_calls_count,
    SUM(total_inbound_calls) total_inbound_calls,
    SUM(missed_inbound_calls) missed_inbound_calls,
    SUM(handling_time_inbound_calls_sec) AS handling_time_inbound_calls_sec
    FROM prep
    GROUP BY
    1, 2, 3)

  SELECT *
  FROM prep
  UNION ALL
  SELECT *
  FROM total_with_TR
  UNION ALL
  SELECT *
  FROM total_without_TR]]></relation>
