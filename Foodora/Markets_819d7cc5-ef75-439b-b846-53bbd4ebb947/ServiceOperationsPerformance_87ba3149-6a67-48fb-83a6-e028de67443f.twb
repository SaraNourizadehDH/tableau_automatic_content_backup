          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Rider Abandoned % MTD' datatype='string' name='[Customer Abandoned % MTD (copy)_730990567809962032]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Customer Abandoned %_cm (copy)_730990567809789998]) / SUM([Customer Abandoned %_lm (copy)_730990567809880111])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Customer Abandoned %_cm (copy)_730990567809789998]) / SUM([Customer Abandoned %_lm (copy)_730990567809880111])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Rider Abandoned % MTD Color' datatype='string' name='[Customer Abandoned % MTD Color (copy)_730990567810117681]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Customer Abandoned %_cm (copy)_730990567809789998]) / SUM([Customer Abandoned %_lm (copy)_730990567809880111])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Rider Abandoned %_cm' datatype='real' name='[Customer Abandoned %_cm (copy)_730990567809789998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [rider_missed_chat_count] / [missed_chat_count]&#13;&#10;END' />
            </column>
            <column caption='Rider Abandoned %_lm' datatype='real' name='[Customer Abandoned %_lm (copy)_730990567809880111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [rider_missed_chat_count] / [missed_chat_count]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
