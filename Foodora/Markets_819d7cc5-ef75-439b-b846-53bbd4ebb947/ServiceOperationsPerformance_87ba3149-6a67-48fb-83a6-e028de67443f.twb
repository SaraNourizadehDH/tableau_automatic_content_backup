            <column-instance column='[Chat SLA 30s (ToT) (copy)_588001238754938900]' derivation='User' name='[usr:Chat SLA 30s (ToT) (copy)_588001238754938900:nk]' pivot='key' type='nominal' />
            <column-instance column='[Chat SLA 30s (ToT) Color (copy)_588001238755557400]' derivation='User' name='[usr:Chat SLA 30s (ToT) Color (copy)_588001238755557400:nk]' pivot='key' type='nominal' />
            <column caption='Vertical Type' datatype='string' name='[vertical_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1qbrtpj0t7ty5q19dup500c8yi6m].[none:department:nk]'>
