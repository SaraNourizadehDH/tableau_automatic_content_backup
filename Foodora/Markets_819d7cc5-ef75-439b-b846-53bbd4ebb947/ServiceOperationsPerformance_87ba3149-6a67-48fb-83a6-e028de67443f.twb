              <calculation class='tableau' formula='IF((SUM([Created Voucher Created EUR_cm (copy)_588001238864773175]) / SUM([Voucher Created EUR_lm (copy)_588001238865301560])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
