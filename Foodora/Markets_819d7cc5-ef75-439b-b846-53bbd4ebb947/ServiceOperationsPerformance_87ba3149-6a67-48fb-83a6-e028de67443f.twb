            <column-instance column='[department]' derivation='None' name='[none:department:nk]' pivot='key' type='nominal' />
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_588001238920994897]' derivation='Sum' name='[sum:Calculation_588001238920994897:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_incidents_cs]' derivation='Sum' name='[sum:total_incidents_cs:qk]' pivot='key' type='quantitative' />
            <column caption='Total Incidents' datatype='integer' name='[total_incidents]' role='measure' type='quantitative' />
