            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='HT Calls MTD' datatype='string' name='[HT + Wrapup MTD (copy)_1769703579697684488]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([HT + Wrapup_cm (copy)_1769703579697381382]) / SUM([HT + Wrapup_lm (copy)_1769703579697528839])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([HT + Wrapup_cm (copy)_1769703579697381382]) / SUM([HT + Wrapup_lm (copy)_1769703579697528839])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='HT Calls MTD Color' datatype='string' name='[HT + Wrapup MTD Color (copy)_1769703579697823753]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([HT + Wrapup_cm (copy)_1769703579697381382]) / SUM([HT + Wrapup_lm (copy)_1769703579697528839])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='HT Calls_cm' datatype='real' name='[HT + Wrapup_cm (copy)_1769703579697381382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [handling_time_inbound_calls_sec] * 100 / [total_inbound_calls]&#13;&#10;END' />
            </column>
            <column caption='HT Calls_lm' datatype='real' name='[HT + Wrapup_lm (copy)_1769703579697528839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [handling_time_inbound_calls_sec] * 100 / [total_inbound_calls]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
