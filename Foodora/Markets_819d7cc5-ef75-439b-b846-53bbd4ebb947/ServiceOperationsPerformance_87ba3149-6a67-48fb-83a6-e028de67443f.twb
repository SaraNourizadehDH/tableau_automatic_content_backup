            </column>
            <column caption='Rider Chat % (ToT)' datatype='string' default-format='p0%' name='[Customer Incident % (ToT) (copy)_730990567797575701]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [rider_session_count] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [total_chat_count] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [rider_session_count] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [total_chat_count] end))&#13;&#10;-1) &gt;= 0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END &#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [rider_session_count] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [total_chat_count] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [rider_session_count] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [total_chat_count] end))&#13;&#10;-1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Rider Chat % (ToT) Color' datatype='string' name='[Customer Incident % (ToT) Color (copy)_730990567797714966]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [rider_session_count] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [total_chat_count] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [rider_session_count] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [total_chat_count] end))&#13;&#10;-1) &gt;= 0 THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Date (i - 2)' datatype='integer' name='[Date (i-1) (copy)_456271002486362137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;    when &apos;day&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-3, TODAY())) * 100 + DAY(DATEADD([Parameters].[Parameter 1],-3, TODAY()))&#13;&#10;    when &apos;week&apos; then ISOWEEK(DATEADD([Parameters].[Parameter 1],-2, TODAY()))&#13;&#10;    when &apos;month&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-2, TODAY()))&#13;&#10;end' />
