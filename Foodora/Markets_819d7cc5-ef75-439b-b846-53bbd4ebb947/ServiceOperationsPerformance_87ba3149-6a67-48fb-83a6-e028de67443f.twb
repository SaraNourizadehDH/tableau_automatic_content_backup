    <worksheet name='PS Abondened Chat ToT'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Medium' fontsize='8'>ToT % Δ</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_country_evaluation' name='federated.1qbrtpj0t7ty5q19dup500c8yi6m' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='ToT' datatype='string' name='[Calculation_456271002444918798]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then &apos;DoD% Δ&apos;&#13;&#10; when &apos;week&apos; then &apos;WoW% Δ&apos;&#13;&#10; when &apos;month&apos; then &apos;MoM% Δ&apos;&#13;&#10;end' />
            </column>
            <column caption='date' datatype='integer' name='[Calculation_456271002483269655]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;    when &apos;day&apos; then month([report_date]) * 100 + DAY ([report_date]) &#13;&#10;    when &apos;week&apos; then ISOWEEK([report_date])&#13;&#10;    when &apos;month&apos; then month([report_date])&#13;&#10;end' />
            </column>
            <column caption='Date (i - 1)' datatype='integer' name='[Calculation_456271002485743640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;    when &apos;day&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-2, TODAY())) * 100 + DAY(DATEADD([Parameters].[Parameter 1],-2, TODAY()))&#13;&#10;    when &apos;week&apos; then ISOWEEK(DATEADD([Parameters].[Parameter 1],-1, TODAY()))&#13;&#10;    when &apos;month&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-1, TODAY()))&#13;&#10;end' />
            </column>
            <column caption='Abondened Chat (ToT)' datatype='string' default-format='p0%' name='[Chat SLA 30s (ToT) (copy)_588001238754938900]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [missed_chats_count] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [total_chats_count] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [missed_chats_count] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [total_chats_count] end))&#13;&#10;-1) &gt;= 0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END &#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [missed_chats_count] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [total_chats_count] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [missed_chats_count] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [total_chats_count] end))&#13;&#10;-1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Abondened Chat (ToT) Color' datatype='string' name='[Chat SLA 30s (ToT) Color (copy)_588001238755557400]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [missed_chats_count] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [total_chats_count] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [missed_chats_count] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [total_chats_count] end))&#13;&#10;-1) &gt;= 0 THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Date (i - 2)' datatype='integer' name='[Date (i-1) (copy)_456271002486362137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;    when &apos;day&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-3, TODAY())) * 100 + DAY(DATEADD([Parameters].[Parameter 1],-3, TODAY()))&#13;&#10;    when &apos;week&apos; then ISOWEEK(DATEADD([Parameters].[Parameter 1],-2, TODAY()))&#13;&#10;    when &apos;month&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-2, TODAY()))&#13;&#10;end' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH_EU&quot;' value='DH EU' />
                <alias key='&quot;DH_EU + TR&quot;' value='DH EU + TR' />
              </aliases>
            </column>
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
            <column caption='Missed Chats Count' datatype='integer' name='[missed_chats_count]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_456271002444918798]' derivation='None' name='[none:Calculation_456271002444918798:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
