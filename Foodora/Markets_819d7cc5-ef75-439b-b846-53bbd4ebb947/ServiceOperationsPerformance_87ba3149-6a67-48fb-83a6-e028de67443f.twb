      <aliases enabled='yes' />
      <column caption='Proactive Compensation % (ToT)' datatype='string' default-format='p0%' name='[% of GMV (ToT) (copy)_952229870376321035]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [autocomp_voucher_given_count] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [autocomp_triggered] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [autocomp_voucher_given_count] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [autocomp_triggered] end))&#13;&#10;-1) &gt;= 0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END &#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [autocomp_voucher_given_count] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [autocomp_triggered] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [autocomp_voucher_given_count] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [autocomp_triggered] end))&#13;&#10;-1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
      </column>
      <column caption='Proactive Compensation % (ToT) Color' datatype='string' name='[% of GMV (ToT) Color (copy)_952229870376574988]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [autocomp_voucher_given_count] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [autocomp_triggered] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [autocomp_voucher_given_count] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [autocomp_triggered] end))&#13;&#10;-1) &gt;= 0 THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
      </column>
      <column caption='Proactive Compensation % MTD' datatype='string' name='[% of GMV MTD (copy)_952229870377320463]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF((SUM([% of GMV_cm (copy)_952229870376964109]) / SUM([% of GMV_lm (copy)_952229870377160718])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([% of GMV_cm (copy)_952229870376964109]) / SUM([% of GMV_lm (copy)_952229870377160718])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
      </column>
      <column caption='Proactive Compensation % MTD Color' datatype='string' name='[% of GMV MTD Color (copy)_952229870377746450]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF((SUM([% of GMV_cm (copy)_952229870376964109]) / SUM([% of GMV_lm (copy)_952229870377160718])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
      </column>
      <column caption='Proactive Compensation %_cm' datatype='real' name='[% of GMV_cm (copy)_952229870376964109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [autocomp_voucher_given_count] / [autocomp_triggered]&#13;&#10;END' />
      </column>
      <column caption='Proactive Compensation %_lm' datatype='real' name='[% of GMV_lm (copy)_952229870377160718]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [autocomp_voucher_given_count] / [autocomp_triggered]&#13;&#10;END' />
      </column>
      <column caption='Redemption %' datatype='real' default-format='p0.0%' name='[Calculation_1133218269807468587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([redeemed_within_7_days]) / SUM([created_voucher_count_without_spv])' />
      </column>
      <column caption='Total Incidents ' datatype='real' name='[Calculation_1133218269809176628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [report_date], [country], [vertical_type]: AVG([total_incidents])}' />
      </column>
      <column caption='Reactive Compensation %' datatype='real' default-format='p0.00%' name='[Calculation_1133218269809872951]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([created_voucher_count]) / SUM([total_incidents])' />
      </column>
      <column caption='Relevant time period' datatype='boolean' name='[Calculation_456271002415939588]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then IIF(DATEADD(&apos;day&apos;, -6, TODAY()) &lt; [report_date] AND [report_date] != TODAY() AND [report_date] &lt;= DATEADD(&apos;day&apos;, -1, TODAY()), true, false)&#13;&#10; when &apos;week&apos; then IIF(DATEADD(&apos;iso-week&apos;, -6, DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) &lt; DATETRUNC(&apos;week&apos;,[report_date],&apos;monday&apos;) AND ISOWEEK(TODAY()) != ISOWEEK([report_date]), true, false)&#13;&#10; when &apos;month&apos; then IIF(DATEADD(&apos;month&apos;, -5, TODAY()) &lt; [report_date] AND Month([report_date]) != month(DATEADD(&apos;month&apos;, -5, TODAY())), true, false)&#13;&#10;end' />
      </column>
      <column caption='ToT' datatype='string' name='[Calculation_456271002444918798]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then &apos;DoD% Δ&apos;&#13;&#10; when &apos;week&apos; then &apos;WoW% Δ&apos;&#13;&#10; when &apos;month&apos; then &apos;MoM% Δ&apos;&#13;&#10;end' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_456271002456092691]&#13;&#10; when &apos;week&apos; then [Calculation_456271002456002578]&#13;&#10; when &apos;month&apos; then [Calculation_456271002455613457]&#13;&#10;end' />
      </column>
      <column caption='date' datatype='integer' name='[Calculation_456271002483269655]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;    when &apos;day&apos; then month([report_date]) * 100 + DAY ([report_date]) &#13;&#10;    when &apos;week&apos; then ISOWEEK([report_date])&#13;&#10;    when &apos;month&apos; then month([report_date])&#13;&#10;end' />
      </column>
      <column caption='Date (i - 1)' datatype='integer' name='[Calculation_456271002485743640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;    when &apos;day&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-2, TODAY())) * 100 + DAY(DATEADD([Parameters].[Parameter 1],-2, TODAY()))&#13;&#10;    when &apos;week&apos; then ISOWEEK(DATEADD([Parameters].[Parameter 1],-1, TODAY()))&#13;&#10;    when &apos;month&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-1, TODAY()))&#13;&#10;end' />
      </column>
      <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
      </column>
      <column caption='Proactive %' datatype='real' default-format='p0.00%' name='[Calculation_588001238868078651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF([compensation_type] = &apos;Proactive&apos;) THEN [created_voucher_count] END) / SUM([created_voucher_count])' />
      </column>
      <column caption='Total GMV eur' datatype='real' name='[Calculation_952229870366662656]' role='measure' type='quantitative'>
