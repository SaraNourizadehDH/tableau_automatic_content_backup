          <datasource-dependencies datasource='federated.08qj7o11ejfuo61fhb8ru15c7qi6'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Reactive % MTD' datatype='string' name='[Proactive % MTD (copy)_588001238875557955]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Proactive %_cm (copy)_588001238875357249]) / SUM([Proactive %_lm (copy)_588001238875455554])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Proactive %_cm (copy)_588001238875357249]) / SUM([Proactive %_lm (copy)_588001238875455554])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Reactive % MTD Color' datatype='string' name='[Proactive % MTD Color (copy)_588001238876520516]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Proactive %_cm (copy)_588001238875357249]) / SUM([Proactive %_lm (copy)_588001238875455554])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Reactive %_cm' datatype='real' name='[Proactive %_cm (copy)_588001238875357249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN (IF([compensation_type] = &apos;Reactive&apos;) THEN [created_voucher_count] END) / ([created_voucher_count])&#13;&#10;END' />
            </column>
            <column caption='Reactive %_lm' datatype='real' name='[Proactive %_lm (copy)_588001238875455554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-1))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-1))&#13;&#10;THEN (IF([compensation_type] = &apos;Reactive&apos;) THEN [created_voucher_count] END) / ([created_voucher_count])&#13;&#10;END' />
            </column>
            <column caption='Compensation Type' datatype='string' name='[compensation_type]' role='dimension' type='nominal' />
