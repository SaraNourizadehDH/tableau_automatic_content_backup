          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='AQT MTD' datatype='string' name='[Abondened Chat MTD (copy)_588001238794579999]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Abondened Chat_cm (copy)_588001238795595808]) / SUM([Abondened Chat_lm (copy)_588001238795714593])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Abondened Chat_cm (copy)_588001238795595808]) / SUM([Abondened Chat_lm (copy)_588001238795714593])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='AQT MTD Color' datatype='string' name='[Abondened Chat MTD Color (copy)_588001238795948066]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Abondened Chat_cm (copy)_588001238795595808]) / SUM([Abondened Chat_lm (copy)_588001238795714593])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='AQT_cm' datatype='real' name='[Abondened Chat_cm (copy)_588001238795595808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [sum_queue_time_chats] * 100 / [total_chats_count]&#13;&#10;END' />
            </column>
            <column caption='AQT_lm' datatype='real' name='[Abondened Chat_lm (copy)_588001238795714593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [sum_queue_time_chats] * 100 / [total_chats_count]&#13;&#10;END' />
            </column>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
