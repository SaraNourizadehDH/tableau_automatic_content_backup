          <datasource-dependencies datasource='federated.1jslqxp0aasw7011l42k81hmghcj'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='SM AVG FRT hrs MTD' datatype='string' name='[Email AVG FRT min MTD (copy)_1133218269735686151]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Email AVG FRT min_cm (copy)_1133218269735473157]) / SUM([Email AVG FRT min_lm (copy)_1133218269735579654])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Email AVG FRT min_cm (copy)_1133218269735473157]) / SUM([Email AVG FRT min_lm (copy)_1133218269735579654])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='SM AVG FRT hrs MTD Color' datatype='string' name='[Email AVG FRT min MTD Color (copy)_1133218269735817224]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF(((SUM([Email AVG FRT min_cm (copy)_1133218269735473157]) / SUM([Email AVG FRT min_lm (copy)_1133218269735579654]))) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='SM AVG FRT hrs_cm' datatype='real' name='[Email AVG FRT min_cm (copy)_1133218269735473157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN ([sm_first_repsonse_ht_min] / [sm_cases]) / 60&#13;&#10;END' />
            </column>
            <column caption='SM AVG FRT hrs_lm' datatype='real' name='[Email AVG FRT min_lm (copy)_1133218269735579654]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN ([sm_first_repsonse_ht_min] / [sm_cases]) / 60&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
