            </column>
            <column caption='FCR % MTD' datatype='string' name='[SM AVG FRT min MTD (copy)_1133218269738471445]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([SM AVG FRT min_cm (copy)_1133218269737996306]) / SUM([SM AVG FRT min_lm (copy)_1133218269738156051])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([SM AVG FRT min_cm (copy)_1133218269737996306]) / SUM([SM AVG FRT min_lm (copy)_1133218269738156051])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='FCR % MTD Color' datatype='string' name='[SM AVG FRT min MTD Color (copy)_1133218269738270740]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([SM AVG FRT min_cm (copy)_1133218269737996306]) / SUM([SM AVG FRT min_lm (copy)_1133218269738156051])) - 1) &gt;= 0&#13;&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column caption='FCR %_cm' datatype='real' name='[SM AVG FRT min_cm (copy)_1133218269737996306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN ([num_fcr]*100) / [ticket_count]&#13;&#10;END' />
            </column>
            <column caption='FCR %_lm' datatype='real' name='[SM AVG FRT min_lm (copy)_1133218269738156051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN ([num_fcr]*100) / [ticket_count]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH_EU&quot;' value='DH EU' />
                <alias key='&quot;DH_EU + TR&quot;' value='DH EU + TR' />
