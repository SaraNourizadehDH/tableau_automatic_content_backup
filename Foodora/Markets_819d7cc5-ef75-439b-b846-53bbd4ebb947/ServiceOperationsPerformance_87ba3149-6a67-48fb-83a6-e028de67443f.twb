            <column caption='Sum Value Eur Used Voucher' datatype='real' name='[sum_value_eur_used_voucher]' role='measure' type='quantitative' />
            <column caption='Total Gmv Eur' datatype='real' name='[total_gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[Reactive Compensation % (ToT) Color (copy)_952229870369218564]' derivation='User' name='[usr:Reactive Compensation % (ToT) Color (copy)_952229870369218564:nk]' pivot='key' type='nominal' />
            <column-instance column='[Redemption % (ToT) (copy)_952229870368940035]' derivation='User' name='[usr:Redemption % (ToT) (copy)_952229870368940035:nk]' pivot='key' type='nominal' />
            <column caption='Vertical Type' datatype='string' name='[vertical_type]' role='dimension' type='nominal' />
