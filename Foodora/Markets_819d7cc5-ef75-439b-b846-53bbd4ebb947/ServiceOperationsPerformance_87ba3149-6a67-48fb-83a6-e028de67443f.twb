              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Gross Order' datatype='real' name='[Calculation_794322396990222358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [is_self_cancellation], [is_cancelled_via_help_center], [is_inflected], [is_reordered]: &#10;SUM({ FIXED [report_date], [country], [vertical_type], [is_subscription_order], [is_corporate_order], [delivery_type]: AVG([gross_order_count])})}' />
            </column>
            <column caption='Customer CS-Cancellation Rate % MTD' datatype='string' name='[Customer Net Cancellation Rate % MTD (copy)_1601874106969169925]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Customer Net Cancellation Rate %_cm (copy)_1601874106968936451]) / SUM([Customer Net Cancellation Rate %_lm (copy)_1601874106969051140])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Customer Net Cancellation Rate %_cm (copy)_1601874106968936451]) / SUM([Customer Net Cancellation Rate %_lm (copy)_1601874106969051140])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Customer CS-Cancellation Rate % MTD Color' datatype='string' name='[Customer Net Cancellation Rate % MTD Color (copy)_1601874106969341958]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Customer Net Cancellation Rate %_cm (copy)_1601874106968936451]) / SUM([Customer Net Cancellation Rate %_lm (copy)_1601874106969051140])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Customer CS-Cancellation Rate %_cm' datatype='real' name='[Customer Net Cancellation Rate %_cm (copy)_1601874106968936451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN ([customer_cancellations] - [customer_self_cancellatios]) * 100 / [Calculation_794322396990222358]&#13;&#10;END' />
            </column>
            <column caption='Customer CS-Cancellation Rate %_lm' datatype='real' name='[Customer Net Cancellation Rate %_lm (copy)_1601874106969051140]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN ([customer_cancellations] - [customer_self_cancellatios]) * 100 / [Calculation_794322396990222358]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
