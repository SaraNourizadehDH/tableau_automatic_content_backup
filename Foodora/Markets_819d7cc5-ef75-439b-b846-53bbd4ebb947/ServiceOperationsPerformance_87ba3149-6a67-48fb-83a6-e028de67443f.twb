            <column caption='HT Cases MTD' datatype='string' name='[HT Calls MTD (copy)_2477894625290420243]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([HT Calls_cm (copy)_2477894625290096657]) / SUM([HT Calls_lm (copy)_2477894625290248210])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([HT Calls_cm (copy)_2477894625290096657]) / SUM([HT Calls_lm (copy)_2477894625290248210])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='HT Cases MTD Color' datatype='string' name='[HT Calls MTD Color (copy)_2477894625290706964]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([HT Calls_cm (copy)_2477894625290096657]) / SUM([HT Calls_lm (copy)_2477894625290248210])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='HT Cases_cm' datatype='real' name='[HT Calls_cm (copy)_2477894625290096657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [case_handling_time] * 100 / [total_incoming_cases_count]&#13;&#10;END' />
            </column>
            <column caption='HT Cases_lm' datatype='real' name='[HT Calls_lm (copy)_2477894625290248210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [case_handling_time] * 100 / [total_incoming_cases_count]&#13;&#10;END' />
            </column>
            <column datatype='real' name='[case_handling_time]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
