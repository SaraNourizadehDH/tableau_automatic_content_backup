            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Proactive %_cm' datatype='real' name='[Chat SLA 30s %_cm (copy)_588001238755143701 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN (IF([compensation_type] = &apos;Proactive&apos;) THEN [created_voucher_count] END) / ([created_voucher_count])&#13;&#10;END' />
            </column>
            <column caption='Proactive %_lm' datatype='real' name='[Chat SLA 30s %_lm (copy)_588001238755295254 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN (IF([compensation_type] = &apos;Proactive&apos;) THEN [created_voucher_count] END) / ([created_voucher_count])&#13;&#10;END' />
            </column>
            <column caption='Proactive % MTD' datatype='string' name='[Chat SLA 30s MTD (copy)_588001238755405847 1]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Chat SLA 30s %_cm (copy)_588001238755143701 1]) / SUM([Chat SLA 30s %_lm (copy)_588001238755295254 1])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Chat SLA 30s %_cm (copy)_588001238755143701 1]) / SUM([Chat SLA 30s %_lm (copy)_588001238755295254 1])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Proactive % MTD Color' datatype='string' name='[Chat SLA 30s MTD Color (copy)_588001238755733529 1]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Chat SLA 30s %_cm (copy)_588001238755143701 1]) / SUM([Chat SLA 30s %_lm (copy)_588001238755295254 1])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Compensation Type' datatype='string' name='[compensation_type]' role='dimension' type='nominal' />
