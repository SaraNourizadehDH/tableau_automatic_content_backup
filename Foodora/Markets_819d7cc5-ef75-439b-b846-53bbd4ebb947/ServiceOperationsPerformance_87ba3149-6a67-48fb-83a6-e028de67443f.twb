            <column caption='Incident Rate CS (ToT)' datatype='string' default-format='p0%' name='[Incident Rate (ToT) (copy)_197032543096307713]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [total_incidents_cs] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [Calculation_588001238920994897] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [total_incidents_cs] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [Calculation_588001238920994897] end))&#13;&#10;-1) &gt;= 0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END &#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [total_incidents_cs] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [Calculation_588001238920994897] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [total_incidents_cs] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [Calculation_588001238920994897] end))&#13;&#10;-1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Incident Rate CS (ToT) Color' datatype='string' name='[Incident Rate (ToT) Color (copy)_197032543096451074]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [total_incidents_cs] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [Calculation_588001238920994897] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [total_incidents_cs] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [Calculation_588001238920994897] end))&#13;&#10;-1) &gt;= 0 THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
