      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_D9A626D47673412785068CB0884AB204'>
            <properties context=''>
              <relation connection='bigquery.13hhjkt08yozr51ggafu90ggryxo' name='Custom SQL Query' type='text'><![CDATA[WITH prep AS 

/*(SELECT
    country_name,
    promised_delivery_date AS report_date,
    SUM(seamless_orders_all) AS seamless_orders_all,
    SUM(seamless_orders_seamless) AS seamless_orders_seamless,
  FROM `dhh---analytics-eu.bl_logistics.report_lg_logistics_dashboard_v2`
  GROUP BY 1,2),*/

(

   SELECT
    countries.name country_name,
    created_date_utc report_date,
  COUNT(CASE WHEN is_seamless_order = TRUE OR is_seamless_order = FALSE THEN order_code ELSE NULL END) seamless_orders_all,
    COUNT(CASE  WHEN is_seamless_order = TRUE THEN order_code   ELSE NULL END ) seamless_orders_seamless
    FROM
    `fulfillment-dwh-production.pandata_report.regional_eu_lg_seamless_orders` 
    JOIN `fulfillment-dwh-production.pandata_report.regional_eu__countries` countries using (global_entity_id)
    WHERE
    created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR), YEAR)
  GROUP BY
    1,
    2
),

total_without_TR AS (SELECT
    'DH_EU' AS country,
    report_date,
    SUM(seamless_orders_all) AS seamless_orders_all,
    SUM(seamless_orders_seamless) AS seamless_orders_seamless
    FROM prep
    WHERE country_name <<>> 'Turkey'
    GROUP BY 
    1, 2),

total_with_TR AS (SELECT
    'DH_EU + TR' AS country,
    report_date,
    SUM(seamless_orders_all) AS seamless_orders_all,
    SUM(seamless_orders_seamless) AS seamless_orders_seamless
    FROM prep
    GROUP BY 
    1, 2)

SELECT *
FROM prep
UNION ALL
SELECT *
FROM total_with_TR
UNION ALL
SELECT *
FROM total_without_TR]]></relation>
            </properties>
