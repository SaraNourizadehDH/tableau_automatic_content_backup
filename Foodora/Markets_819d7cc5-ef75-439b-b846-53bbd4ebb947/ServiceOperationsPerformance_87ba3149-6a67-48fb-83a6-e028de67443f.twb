            <column caption='RS Contact Rate % MTD' datatype='string' name='[Incident Rate MTD (copy)_739997739914989574]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Incident Rate_cm (copy)_739997739914297348]) / SUM([Incident Rate_lm (copy)_739997739914387461])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Incident Rate_cm (copy)_739997739914297348]) / SUM([Incident Rate_lm (copy)_739997739914387461])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='RS Contact Rate % MTD Color' datatype='string' name='[Incident Rate MTD Color (copy)_739997739915132935]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Incident Rate_cm (copy)_739997739914297348]) / SUM([Incident Rate_lm (copy)_739997739914387461])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='RS Contact Rate %_cm' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Incident Rate_cm (copy)_739997739914297348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [total_contacts] / [Gross Orders (copy)_846676784315985920]&#13;&#10;END' />
            </column>
