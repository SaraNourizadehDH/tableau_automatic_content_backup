            <column-instance column='[delivery_type]' derivation='None' name='[none:delivery_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_corporate_order]' derivation='None' name='[none:is_corporate_order:nk]' pivot='key' type='nominal' />
