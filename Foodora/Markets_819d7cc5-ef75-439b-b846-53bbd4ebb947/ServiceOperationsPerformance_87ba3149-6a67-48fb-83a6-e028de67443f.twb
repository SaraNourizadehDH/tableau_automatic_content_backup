          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='RT Cases MTD' datatype='string' name='[HT Cases MTD (copy)_2477894625301712921]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([HT Cases_cm (copy)_2477894625301270551]) / SUM([HT Cases_lm (copy)_2477894625301581848])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([HT Cases_cm (copy)_2477894625301270551]) / SUM([HT Cases_lm (copy)_2477894625301581848])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='RT Cases MTD Color' datatype='string' name='[HT Cases MTD Color (copy)_2477894625301831706]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([HT Cases_cm (copy)_2477894625301270551]) / SUM([HT Cases_lm (copy)_2477894625301581848])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='RT Cases_cm' datatype='real' name='[HT Cases_cm (copy)_2477894625301270551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [full_resolution_time] * 100 / [total_resolved_cases_count]&#13;&#10;END' />
            </column>
            <column caption='RT Cases_lm' datatype='real' name='[HT Cases_lm (copy)_2477894625301581848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [full_resolution_time] * 100 / [total_resolved_cases_count]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH_EU&quot;' value='DH EU' />
                <alias key='&quot;DH_EU + TR&quot;' value='DH EU + TR' />
