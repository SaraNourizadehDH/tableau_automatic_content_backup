    <worksheet name='VSAT MTD'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_country_evaluation' name='federated.1qbrtpj0t7ty5q19dup500c8yi6m' />
          </datasources>
          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='VSAT % MTD' datatype='string' name='[HT + Wrapup MTD (copy)_588001238922072151 1]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Incident Rate_cm (copy)_1949777177914839044]) / SUM([Incident Rate_lm (copy)_1949777177915019269])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Incident Rate_cm (copy)_1949777177914839044]) / SUM([Incident Rate_lm (copy)_1949777177915019269])) - 1),1)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='VSAT % MTD Color' datatype='string' name='[Incident Rate MTD Color (copy)_1949777177915420678]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Incident Rate_cm (copy)_1949777177914839044]) / SUM([Incident Rate_lm (copy)_1949777177915019269])) - 1) &gt;= 0&#13;&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column caption='VSAT %_cm' datatype='real' name='[Incident Rate_cm (copy)_1949777177914839044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [vsat_4_5] / [total_vsat_responses]&#13;&#10;END' />
            </column>
            <column caption='VSAT %_lm' datatype='real' name='[Incident Rate_lm (copy)_1949777177915019269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-4))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-4))&#13;&#10;THEN [vsat_4_5] / [total_vsat_responses]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH_EU&quot;' value='DH EU' />
                <alias key='&quot;DH_EU + TR&quot;' value='DH EU + TR' />
              </aliases>
            </column>
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_588001238739361801]' derivation='None' name='[none:Calculation_588001238739361801:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_type]' derivation='None' name='[none:delivery_type:nk]' pivot='key' type='nominal' />
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column caption='Total Vsat Responses' datatype='integer' name='[total_vsat_responses]' role='measure' type='quantitative' />
            <column-instance column='[HT + Wrapup MTD (copy)_588001238922072151 1]' derivation='User' name='[usr:HT + Wrapup MTD (copy)_588001238922072151 1:nk]' pivot='key' type='nominal' />
            <column-instance column='[Incident Rate MTD Color (copy)_1949777177915420678]' derivation='User' name='[usr:Incident Rate MTD Color (copy)_1949777177915420678:nk]' pivot='key' type='nominal' />
            <column caption='Vsat 4 5' datatype='integer' name='[vsat_4_5]' role='measure' type='quantitative' />
