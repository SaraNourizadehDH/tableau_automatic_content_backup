            <column datatype='integer' name='[seamless_orders_seamless]' role='measure' type='quantitative' />
            <column-instance column='[Partially Fulfilled Orders % (ToT) (copy)_76561220203679747]' derivation='User' name='[usr:Partially Fulfilled Orders % (ToT) (copy)_76561220203679747:nk]' pivot='key' type='nominal' />
            <column-instance column='[Partially Fulfilled Orders % (ToT) Color (copy)_76561220204302340]' derivation='User' name='[usr:Partially Fulfilled Orders % (ToT) Color (copy)_76561220204302340:nk]' pivot='key' type='nominal' />
