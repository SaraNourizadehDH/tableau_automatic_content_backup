      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Medium' fontsize='8'>ToT % Δ</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_country_evaluation_cx' name='federated.003n5dq1v862mm1h53rcg044y4e9' />
            <datasource caption='regional_eu_cx_sop_country_evaluation_non_live' name='federated.1jslqxp0aasw7011l42k81hmghcj' />
            <datasource caption='regional_eu_cx_sop_compensation' name='federated.08qj7o11ejfuo61fhb8ru15c7qi6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.003n5dq1v862mm1h53rcg044y4e9'>
            <column caption='ToT' datatype='string' name='[Calculation_456271002444918798]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then &apos;DoD% Δ&apos;&#13;&#10; when &apos;week&apos; then &apos;WoW% Δ&apos;&#13;&#10; when &apos;month&apos; then &apos;MoM% Δ&apos;&#13;&#10;end' />
            </column>
            <column caption='date' datatype='integer' name='[Calculation_456271002483269655]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;    when &apos;day&apos; then month([report_date]) * 100 + DAY ([report_date]) &#13;&#10;    when &apos;week&apos; then ISOWEEK([report_date])&#13;&#10;    when &apos;month&apos; then month([report_date])&#13;&#10;end' />
            </column>
            <column caption='Date (i - 1)' datatype='integer' name='[Calculation_456271002485743640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;    when &apos;day&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-2, TODAY())) * 100 + DAY(DATEADD([Parameters].[Parameter 1],-2, TODAY()))&#13;&#10;    when &apos;week&apos; then ISOWEEK(DATEADD([Parameters].[Parameter 1],-1, TODAY()))&#13;&#10;    when &apos;month&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-1, TODAY()))&#13;&#10;end' />
            </column>
            <column caption='Date (i - 2)' datatype='integer' name='[Date (i-1) (copy)_456271002486362137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;    when &apos;day&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-3, TODAY())) * 100 + DAY(DATEADD([Parameters].[Parameter 1],-3, TODAY()))&#13;&#10;    when &apos;week&apos; then ISOWEEK(DATEADD([Parameters].[Parameter 1],-2, TODAY()))&#13;&#10;    when &apos;month&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-2, TODAY()))&#13;&#10;end' />
            </column>
            <column caption='AO NPS % (ToT)' datatype='string' default-format='p0%' name='[Perfect Interaction % (ToT) (copy)_588001238901039179]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF(((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [promoters_total] - [detractors_total] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [ao_nps_response_count] end)) - &#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [promoters_total] - [detractors_total] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [ao_nps_response_count] end)))  /&#13;&#10;abs((sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [promoters_total] - [detractors_total] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [ao_nps_response_count] end)))) &gt;= 0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END &#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [promoters_total] - [detractors_total] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [ao_nps_response_count] end)) - &#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [promoters_total] - [detractors_total] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [ao_nps_response_count] end)))  /&#13;&#10;abs((sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [promoters_total] - [detractors_total] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [ao_nps_response_count] end)))*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='AO NPS % (ToT) Color' datatype='string' name='[Perfect Interaction % (ToT) Color (copy)_588001238901506124]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF(((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [promoters_total] - [detractors_total] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [ao_nps_response_count] end)) - &#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [promoters_total] - [detractors_total] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [ao_nps_response_count] end)))  /&#13;&#10;abs((sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [promoters_total] - [detractors_total] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [ao_nps_response_count] end)))) &gt;= 0 THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column caption='Ao Nps Response Count' datatype='integer' name='[ao_nps_response_count]' role='measure' type='quantitative' />
