            <column caption='HT + Wrapup MTD' datatype='string' name='[AQT MTD (copy)_588001238802763817]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([AQT_cm (copy)_588001238801666087]) / SUM([AQT_lm (copy)_588001238801870888])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([AQT_cm (copy)_588001238801666087]) / SUM([AQT_lm (copy)_588001238801870888])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='HT + Wrapup MTD Color' datatype='string' name='[AQT MTD Color (copy)_588001238803165227]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([AQT_cm (copy)_588001238801666087]) / SUM([AQT_lm (copy)_588001238801870888])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='HT + Wrapup_cm' datatype='real' name='[AQT_cm (copy)_588001238801666087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [handling_wrapup_time_min] * 100 / [valid_chats_count]&#13;&#10;END' />
            </column>
            <column caption='HT + Wrapup_lm' datatype='real' name='[AQT_lm (copy)_588001238801870888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [handling_wrapup_time_min] * 100 / [valid_chats_count]&#13;&#10;END' />
            </column>
