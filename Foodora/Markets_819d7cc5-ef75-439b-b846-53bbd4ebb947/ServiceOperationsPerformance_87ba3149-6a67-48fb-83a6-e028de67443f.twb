            <column caption='CSAT %_cm' datatype='real' name='[Calculation_1373034966919094279]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [csat_promotor] * 100 / [total_csat_reponses]&#13;&#10;END' />
            </column>
            <column caption='CSAT %_lm' datatype='real' name='[Calculation_1373034966919315464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [csat_promotor] * 100 / [total_csat_reponses]&#13;&#10;END' />
            </column>
