            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[total_vsat_responses]' derivation='Sum' name='[sum:total_vsat_responses:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vsat_4_5]' derivation='Sum' name='[sum:vsat_4_5:qk]' pivot='key' type='quantitative' />
            <column caption='Total Vsat Responses' datatype='integer' name='[total_vsat_responses]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_101682884816965632]' derivation='User' name='[usr:Calculation_101682884816965632:qk]' pivot='key' type='quantitative'>
