              <calculation class='tableau' formula='IF((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [customer_message_count] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [total_message_count] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [customer_message_count] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [total_message_count] end))&#13;&#10;-1) &gt;= 0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END &#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [customer_message_count] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [total_message_count] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [customer_message_count] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [total_message_count] end))&#13;&#10;-1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
