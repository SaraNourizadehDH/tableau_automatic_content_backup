          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='RSAT % (ToT)' datatype='string' default-format='p0%' name='[Audit % (ToT) (copy)_588001238924406874]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [good_rating_rsat_count] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [response_rsat_count] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [good_rating_rsat_count] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [response_rsat_count] end))&#13;&#10;-1) &gt;= 0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END &#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [good_rating_rsat_count] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [response_rsat_count] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [good_rating_rsat_count] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [response_rsat_count] end))&#13;&#10;-1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='RSAT % (ToT) Color' datatype='string' name='[Audit % (ToT) Color (copy)_588001238924669019]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [good_rating_rsat_count] end) / sum (IF ([Calculation_456271002485743640] = [Calculation_456271002483269655]) then [response_rsat_count] end)) /&#13;&#10;(sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [good_rating_rsat_count] end) / sum (IF ([Date (i-1) (copy)_456271002486362137] = [Calculation_456271002483269655]) then [response_rsat_count] end))&#13;&#10;-1) &gt;= 0 THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column caption='ToT' datatype='string' name='[Calculation_456271002444918798]' role='dimension' type='nominal'>
