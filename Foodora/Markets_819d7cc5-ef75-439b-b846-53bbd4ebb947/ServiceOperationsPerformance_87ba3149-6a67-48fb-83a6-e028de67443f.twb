          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Abondened Chat_cm' datatype='real' name='[Chat SLA 30s %_cm (copy)_588001238755143701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN ([missed_chats_count]) / [total_chats_count]&#13;&#10;END' />
            </column>
            <column caption='Abondened Chat_lm' datatype='real' name='[Chat SLA 30s %_lm (copy)_588001238755295254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN ([missed_chats_count]) / [total_chats_count]&#13;&#10;END' />
            </column>
            <column caption='Abondened Chat MTD' datatype='string' name='[Chat SLA 30s MTD (copy)_588001238755405847]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Chat SLA 30s %_cm (copy)_588001238755143701]) / SUM([Chat SLA 30s %_lm (copy)_588001238755295254])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Chat SLA 30s %_cm (copy)_588001238755143701]) / SUM([Chat SLA 30s %_lm (copy)_588001238755295254])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Abondened Chat MTD Color' datatype='string' name='[Chat SLA 30s MTD Color (copy)_588001238755733529]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Chat SLA 30s %_cm (copy)_588001238755143701]) / SUM([Chat SLA 30s %_lm (copy)_588001238755295254])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH_EU&quot;' value='DH EU' />
