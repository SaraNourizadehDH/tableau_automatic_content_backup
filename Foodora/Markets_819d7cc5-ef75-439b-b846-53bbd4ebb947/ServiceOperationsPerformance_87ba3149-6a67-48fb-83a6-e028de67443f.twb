      <column caption='Customer CS-Cancellation Rate %_cm' datatype='real' name='[Customer Net Cancellation Rate %_cm (copy)_1601874106968936451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN ([customer_cancellations] - [customer_self_cancellatios]) * 100 / [Calculation_794322396990222358]&#13;&#10;END' />
      </column>
      <column caption='Customer CS-Cancellation Rate %_lm' datatype='real' name='[Customer Net Cancellation Rate %_lm (copy)_1601874106969051140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN ([customer_cancellations] - [customer_self_cancellatios]) * 100 / [Calculation_794322396990222358]&#13;&#10;END' />
      </column>
      <column caption='Date (i - 3)' datatype='integer' name='[Date (i - 2) (copy)_723953668135305253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;    when &apos;day&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-4, TODAY())) * 100 + DAY(DATEADD([Parameters].[Parameter 1],-4, TODAY()))&#13;&#10;    when &apos;week&apos; then ISOWEEK(DATEADD([Parameters].[Parameter 1],-3, TODAY()))&#13;&#10;    when &apos;month&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-3, TODAY()))&#13;&#10;end' />
      </column>
      <column caption='Date (i - 2)' datatype='integer' name='[Date (i-1) (copy)_456271002486362137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;    when &apos;day&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-3, TODAY())) * 100 + DAY(DATEADD([Parameters].[Parameter 1],-3, TODAY()))&#13;&#10;    when &apos;week&apos; then ISOWEEK(DATEADD([Parameters].[Parameter 1],-2, TODAY()))&#13;&#10;    when &apos;month&apos; then MONTH(DATEADD([Parameters].[Parameter 1],-2, TODAY()))&#13;&#10;end' />
      </column>
