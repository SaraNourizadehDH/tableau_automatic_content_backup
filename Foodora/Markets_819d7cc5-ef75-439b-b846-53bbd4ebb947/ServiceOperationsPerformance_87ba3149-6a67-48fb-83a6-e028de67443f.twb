    <worksheet name='Customer Avg. Response time min MTD'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_country_evaluation' name='federated.1qbrtpj0t7ty5q19dup500c8yi6m' />
          </datasources>
          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='Customer Avg. Response Time min MTD' datatype='string' name='[Avg. Response Time min MTD (copy)_953355799433302025]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Avg. Response Time min_cm (copy)_953355799433003015]) / SUM([Avg. Response Time min_lm (copy)_953355799433138184])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Avg. Response Time min_cm (copy)_953355799433003015]) / SUM([Avg. Response Time min_lm (copy)_953355799433138184])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Customer Avg. Response Time min MTD Color' datatype='string' name='[Avg. Response Time min MTD Color (copy)_953355799433482252]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Avg. Response Time min_cm (copy)_953355799433003015]) / SUM([Avg. Response Time min_lm (copy)_953355799433138184])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Customer Avg. Response Time min_cm' datatype='real' name='[Avg. Response Time min_cm (copy)_953355799433003015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN ([customer_first_reply_time_sec]/60) / [rider_chat_customer_reply_count]&#13;&#10;END' />
            </column>
            <column caption='Customer Avg. Response Time min_lm' datatype='real' name='[Avg. Response Time min_lm (copy)_953355799433138184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN ([customer_first_reply_time_sec]/60) / [rider_chat_customer_reply_count]&#13;&#10;END' />
            </column>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
