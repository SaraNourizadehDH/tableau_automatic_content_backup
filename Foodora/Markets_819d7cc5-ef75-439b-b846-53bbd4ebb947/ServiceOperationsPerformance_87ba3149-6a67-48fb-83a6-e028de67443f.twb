    <worksheet name='customer chat MTD'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_sop_country_evaluation' name='federated.1qbrtpj0t7ty5q19dup500c8yi6m' />
          </datasources>
          <datasource-dependencies datasource='federated.1qbrtpj0t7ty5q19dup500c8yi6m'>
            <column caption='TITLE MTD % Δ' datatype='string' name='[Calculation_588001238739361801]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MTD % Δ&apos;' />
            </column>
            <column caption='Customer Chat % MTD' datatype='string' name='[Overall Incident % MTD (copy)_730990567795212302]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Overall Incident %_cm (copy)_730990567795027980]) / SUM([Overall Incident %_lm (copy)_730990567795118093])) - 1) &gt;= 0&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(&#13;&#10;ROUND(((SUM([Overall Incident %_cm (copy)_730990567795027980]) / SUM([Overall Incident %_lm (copy)_730990567795118093])) - 1)*100,0)&#13;&#10;)&#13;&#10;&#13;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Customer Chat % MTD Color' datatype='string' name='[Overall Incident % MTD Color (copy)_730990567795392527]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Overall Incident %_cm (copy)_730990567795027980]) / SUM([Overall Incident %_lm (copy)_730990567795118093])) - 1) &gt;= 0&#13;&#10;THEN &apos;RED&apos; ELSE &apos;GREEN&apos; END' />
            </column>
            <column caption='Customer Chat %_cm' datatype='real' name='[Overall Incident %_cm (copy)_730990567795027980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([report_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([report_date]) &lt;= DAY(TODAY()-2)&#13;&#10;THEN [customer_session_count] / [total_chat_count]&#13;&#10;END' />
            </column>
            <column caption='Customer Chat %_lm' datatype='real' name='[Overall Incident %_lm (copy)_730990567795118093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([report_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#13;&#10;AND DAY([report_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#13;&#10;THEN [customer_session_count] / [total_chat_count]&#13;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;DH_EU&quot;' value='DH EU' />
