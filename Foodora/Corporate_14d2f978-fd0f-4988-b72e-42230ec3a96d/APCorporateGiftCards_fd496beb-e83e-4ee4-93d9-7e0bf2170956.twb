            <datasource caption='regional_apac_cp_gc_order_summary' name='federated.0t971fo0jtywy41a9eo351q6l50l' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dynamic Date Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0t971fo0jtywy41a9eo351q6l50l'>
            <column caption='Dynamic Date Range' datatype='string' name='[Calculation_3225632874619400192]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;Weekly&apos; OR [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) THEN STR(DATEPART(&apos;iso-year&apos;,[order_date_local]))+&apos;-&apos;+STR(DATEPART(&apos;iso-week&apos;,[order_date_local]))&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Monthly&apos; OR [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) THEN LEFT(STR(DATENAME(&apos;month&apos;,[order_date_local])),3)+&apos; &apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[order_date_local])),2)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Quarterly&apos; OR [Parameters].[Parameter 1] = &apos;Quarterly + MTD&apos;) THEN &quot;Q&quot;+STR(DATENAME(&apos;quarter&apos;,[order_date_local]))+&apos;-&apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[order_date_local])),2)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; then str(DATEPART(&apos;day&apos;,[order_date_local]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[order_date_local])),3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Yearly&apos; then RIGHT(STR(DATEPART(&apos;year&apos;,[order_date_local])),4)&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column caption='date_local' datatype='date' name='[order_date_local]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1lcet3q1wayaqo15tge7608bn04l'>
            <column caption='redeem orders' datatype='integer' name='[Calculation_253679334761254912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([redemption_pd_order_code])' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_332844180510420996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Local Currency&quot; THEN [redeem_gmv_local] ELSE [redeem_gmv_eur] END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[redemption_date_local]' derivation='None' name='[none:redemption_date_local:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[redeem_gmv_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[redeem_gmv_local]' role='measure' type='quantitative' />
            <column caption='date_local' datatype='date' name='[redemption_date_local]' role='dimension' type='ordinal' />
            <column datatype='string' name='[redemption_pd_order_code]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_332844180510420996]' derivation='Sum' name='[sum:Calculation_332844180510420996:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_253679334761254912]' derivation='User' name='[usr:Calculation_253679334761254912:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0t971fo0jtywy41a9eo351q6l50l].[none:country:nk]' filter-group='8'>
            <groupfilter function='level-members' level='[none:country:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
            <target field='[federated.1lcet3q1wayaqo15tge7608bn04l].[none:country:nk]' />
