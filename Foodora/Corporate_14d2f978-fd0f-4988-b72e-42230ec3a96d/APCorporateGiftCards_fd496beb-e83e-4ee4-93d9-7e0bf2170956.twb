            </column>
            <column caption='Avg. value per gift card' datatype='real' name='[Calculation_332844180546068496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_332844180508901377])/SUM([total_number_of_gc_sold])' />
