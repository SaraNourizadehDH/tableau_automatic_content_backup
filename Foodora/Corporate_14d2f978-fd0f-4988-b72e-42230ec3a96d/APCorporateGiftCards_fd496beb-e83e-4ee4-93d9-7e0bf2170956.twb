        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Yearly&apos; THEN [order_date_local] &gt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,TODAY())) AND [order_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Quarterly&apos; THEN [order_date_local] &gt;= DATEADD(&apos;quarter&apos;,-7,DATETRUNC(&apos;quarter&apos;,TODAY())) AND [order_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN [order_date_local] &gt;= DATEADD(&apos;month&apos;,-12,DATETRUNC(&apos;month&apos;,TODAY())) AND [order_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN [order_date_local] &gt;= DATEADD(&apos;week&apos;,-11,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [order_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [order_date_local] &gt;= DATEADD(&apos;day&apos;,-12,TODAY()) AND [order_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly + MTD&apos; THEN [order_date_local] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [order_date_local] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly + WTD&apos; THEN [order_date_local] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [order_date_local] &lt; TODAY()&#10;END' />
      </column>
      <column caption='# Avg. gift card per order' datatype='real' name='[Calculation_1862238459106648068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_number_of_gc_sold])/SUM([total_number_of_successful_orders])' />
      </column>
      <column caption='Dynamic Date Range' datatype='string' name='[Calculation_3225632874619400192]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;Weekly&apos; OR [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) THEN STR(DATEPART(&apos;iso-year&apos;,[order_date_local]))+&apos;-&apos;+STR(DATEPART(&apos;iso-week&apos;,[order_date_local]))&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Monthly&apos; OR [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) THEN LEFT(STR(DATENAME(&apos;month&apos;,[order_date_local])),3)+&apos; &apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[order_date_local])),2)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Quarterly&apos; OR [Parameters].[Parameter 1] = &apos;Quarterly + MTD&apos;) THEN &quot;Q&quot;+STR(DATENAME(&apos;quarter&apos;,[order_date_local]))+&apos;-&apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[order_date_local])),2)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; then str(DATEPART(&apos;day&apos;,[order_date_local]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[order_date_local])),3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Yearly&apos; then RIGHT(STR(DATEPART(&apos;year&apos;,[order_date_local])),4)&#10;END' />
      </column>
      <column caption='GTV' datatype='real' name='[Calculation_332844180508901377]' role='measure' type='quantitative'>
