      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Singapore&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Dynamic Date Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
          <calculation class='tableau' formula='&quot;Monthly&quot;' />
        </column>
        <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
          <calculation class='tableau' formula='&quot;EUR&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4D1B0B8F73934845BA73B583CAD11D07'>
            <properties context=''>
              <relation connection='bigquery.15ss34610txocf18slivb0qr14v8' name='Custom SQL Query' type='text'># giftcard redemption #
-- change the EUR GMV in here or in transaction level, to giftcard created date? 
WITH
gc_redeem AS (
  SELECT
    gc_txn.global_entity_id,
    gc_txn.country,
    gc_giftcards.purchase_company_name,
    gc_giftcards.purchase_company_uuid,
    orders.company_type AS purchase_company_type,
    orders.sales_channel_platform,
    orders.outlet_name,
    DATE(gc_txn.redemption_pd_order_date) AS redemption_date_local, -- update this in tableau 12 Jan 2024
    gc_txn.redemption_pd_order_code,
    gc_giftcards.redemption_customer_code,
    gc_giftcards.redemption_customer_source,
    gc_txn.is_corporate_redemption AS is_corp_redeem,
    gc_txn.redemption_gmv_eur AS redeem_gmv_eur,
    gc_txn.redemption_gmv_local AS redeem_gmv_local,
    COUNT(DISTINCT gc_txn.gc_giftcard_uuid) AS giftcard_quantity,
    SUM(CASE 
          WHEN gc_txn.transaction_type = &quot;GIFT CARD REDEEM&quot; THEN gc_txn.amount_eur
          WHEN gc_txn.transaction_type = &quot;GIFT CARD CANCEL REDEEM&quot; THEN - gc_txn.amount_eur
          ELSE 0 END
        ) AS redeem_amt_eur,
    SUM(CASE 
          WHEN gc_txn.transaction_type = &quot;GIFT CARD REDEEM&quot; THEN gc_txn.amount_local
          WHEN gc_txn.transaction_type = &quot;GIFT CARD CANCEL REDEEM&quot; THEN - gc_txn.amount_local
          ELSE 0 END
        ) AS redeem_amt_local,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_fintech_gc_transactions` AS gc_txn
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_fintech_gc_giftcards` AS gc_giftcards
        ON gc_txn.gc_giftcard_uuid = gc_giftcards.gc_giftcard_uuid
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_fintech_gc_orders` AS orders
        ON gc_giftcards.qc_order_uuid = orders.qc_order_uuid
  WHERE gc_txn.transaction_type IN (&quot;GIFT CARD REDEEM&quot;, &quot;GIFT CARD CANCEL REDEEM&quot;)
  GROUP BY ALL
  HAVING redeem_amt_local &gt;&gt; 0
)

SELECT
  gc_redeem.global_entity_id,
  gc_redeem.country,
  gc_redeem.purchase_company_name,
  gc_redeem.purchase_company_uuid,
  gc_redeem.purchase_company_type,
  gc_redeem.sales_channel_platform,
  gc_redeem.outlet_name,
  gc_redeem.redemption_date_local,
  gc_redeem.redemption_pd_order_code,
  gc_redeem.redemption_customer_code,
  gc_redeem.redemption_customer_source,
  gc_redeem.is_corp_redeem,
  gc_redeem.giftcard_quantity,
  -- amt eur --
  SUM(gc_redeem.redeem_amt_eur) AS redeem_amt_eur,
  SUM(IF(is_corp_redeem, gc_redeem.redeem_amt_eur, 0)) AS total_b2b_redeem_amt_eur,
  SUM(IF(is_corp_redeem IS NOT TRUE, gc_redeem.redeem_amt_eur, 0)) AS total_b2c_redeem_amt_eur,
  SUM(gc_redeem.redeem_gmv_eur) AS redeem_gmv_eur,
  SUM(IF(is_corp_redeem, gc_redeem.redeem_gmv_eur, 0)) AS total_b2b_redeem_gmv_eur,
  SUM(IF(is_corp_redeem IS NOT TRUE, gc_redeem.redeem_gmv_eur, 0)) AS total_b2c_redeem_gmv_eur,
  -- amt local --
  SUM(gc_redeem.redeem_amt_local) AS redeem_amt_local,
  SUM(IF(is_corp_redeem, gc_redeem.redeem_amt_local, 0)) AS total_b2b_redeem_amt_local,
  SUM(IF(is_corp_redeem IS NOT TRUE, gc_redeem.redeem_amt_local, 0)) AS total_b2c_redeem_amt_local,
  SUM(gc_redeem.redeem_gmv_local) AS redeem_gmv_local,
  SUM(IF(is_corp_redeem, gc_redeem.redeem_gmv_local, 0)) AS total_b2b_redeem_gmv_local,
  SUM(IF(is_corp_redeem IS NOT TRUE, gc_redeem.redeem_gmv_local, 0)) AS total_b2c_redeem_gmv_local,
FROM gc_redeem
LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
       ON gc_redeem.country = shared_countries.name
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS fx_rates
       ON fx_rates.currency_code = shared_countries.currency_code_iso
      AND fx_rates.fx_rate_date = DATE(gc_redeem.redemption_date_local)
WHERE fx_rates.fx_rate_date BETWEEN &quot;2023-09-01&quot; AND CURRENT_DATE
GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
