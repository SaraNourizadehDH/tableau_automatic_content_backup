              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;Weekly&apos; OR [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) THEN STR(DATEPART(&apos;iso-year&apos;,[order_date_local]))+&apos;-&apos;+STR(DATEPART(&apos;iso-week&apos;,[order_date_local]))&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Monthly&apos; OR [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) THEN LEFT(STR(DATENAME(&apos;month&apos;,[order_date_local])),3)+&apos; &apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[order_date_local])),2)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Quarterly&apos; OR [Parameters].[Parameter 1] = &apos;Quarterly + MTD&apos;) THEN &quot;Q&quot;+STR(DATENAME(&apos;quarter&apos;,[order_date_local]))+&apos;-&apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[order_date_local])),2)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; then str(DATEPART(&apos;day&apos;,[order_date_local]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[order_date_local])),3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Yearly&apos; then RIGHT(STR(DATEPART(&apos;year&apos;,[order_date_local])),4)&#10;END' />
            </column>
            <column caption='GTV' datatype='real' name='[Calculation_332844180508901377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Local Currency&quot; THEN [total_gtv_local] ELSE [total_gtv_eur] END' />
            </column>
