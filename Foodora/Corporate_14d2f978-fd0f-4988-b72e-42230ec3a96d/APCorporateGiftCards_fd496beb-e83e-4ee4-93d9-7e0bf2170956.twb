    <datasource caption='Data Freshness' inline='true' name='federated.0g2s9901xd6wsw117m5og1oct12q' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.16jtnln10nyqie1769j3w1vt6qw2'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='yue.tee@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.16jtnln10nyqie1769j3w1vt6qw2' name='Custom SQL Query' type='text'>WITH gc_order_summary AS (
  SELECT
    gc_orders.global_entity_id,
    gc_orders.country,
    DATE(gc_orders.created_at_local) AS date_local,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_fintech_gc_orders` AS gc_orders
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.cp_companies` AS companies
        ON gc_orders.cp_company_uuid = companies.uuid
        AND companies.is_state_deleted IS NOT TRUE
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_fintech_gc_transactions` gc_transactions
        ON gc_transactions.qc_order_uuid = gc_orders.qc_order_uuid
  WHERE gc_transactions.transaction_type = &quot;GIFT CARD ACTIVATE&quot;
),

gc_redemption_summary AS (
  SELECT
      gc_txn.global_entity_id,
      gc_txn.country,
      DATE(gc_txn.redemption_pd_order_date) AS date_local, 
      SUM(CASE 
            WHEN gc_txn.transaction_type = &quot;GIFT CARD REDEEM&quot; THEN gc_txn.amount_local
            WHEN gc_txn.transaction_type = &quot;GIFT CARD CANCEL REDEEM&quot; THEN - gc_txn.amount_local
            ELSE 0 END
          ) AS redeem_amt_local,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_fintech_gc_transactions` AS gc_txn
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
        ON gc_txn.country = shared_countries.name
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS fx_rates
        ON fx_rates.currency_code = shared_countries.currency_code_iso
        AND fx_rates.fx_rate_date = DATE(gc_txn.redemption_pd_order_date)
  WHERE fx_rates.fx_rate_date BETWEEN &quot;2023-09-01&quot; AND CURRENT_DATE
    AND gc_txn.transaction_type IN (&quot;GIFT CARD REDEEM&quot;, &quot;GIFT CARD CANCEL REDEEM&quot;)
  GROUP BY ALL
  HAVING redeem_amt_local &gt;&gt; 0
),

gc_summary AS (
SELECT
  giftcards.global_entity_id,
  giftcards.country,
  DATE(giftcards.created_at_local) AS date_local,
FROM `fulfillment-dwh-production.pandata_report.regional_apac_fintech_gc_giftcards` AS giftcards
WHERE is_cancel_activation IS NOT TRUE

)

SELECT
 &quot;regional_apac_cp_gc_order_summary&quot; AS table_name,
 MAX(date_local) AS latest_date
FROM gc_order_summary
WHERE date_local &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 5 DAY)

UNION ALL

SELECT
 &quot;regional_apac_cp_gc_redemption_summary&quot; AS table_name,
 MAX(date_local) AS latest_date
FROM gc_redemption_summary
WHERE date_local &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 3 DAY)

UNION ALL

SELECT
 &quot;regional_apac_cp_gc_summary&quot; AS table_name,
 MAX(date_local) AS latest_date
FROM gc_summary
WHERE date_local &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 3 DAY)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
