      <column caption='Redeemed value' datatype='real' name='[Calculation_332844180515692553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Local Currency&quot; THEN [total_redeemed_amt_local] ELSE [total_redeemed_amt_eur] END' />
