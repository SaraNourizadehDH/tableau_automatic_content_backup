            <zone h='41000' id='5' type-v2='layout-basic' w='98400' x='800' y='17000'>
              <zone forceUpdate='true' h='41000' id='13' type-v2='text' w='98400' x='800' y='17000'>
                <formatted-text>
                  <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>Purpose/ Description</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#555555' fontsize='10'>- Performance tracking for giftcards for different country teams to analyse</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#555555' fontsize='10'>- Refreshes Daily</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#555555' fontsize='10'>- Filters for purchase company, sales channel and oultets available across the dashboards</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>How to use the dashboard (tabs)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>GC Performance Overview: </run>
                  <run fontcolor='#555555' fontsize='10'>To track all evergreen deals performance (GMV &amp; AOV) by month and country</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>GC Monthly Breakdown: </run>
                  <run fontcolor='#555555' fontsize='10'>Detailed view of giftcards performance by months</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>GC Country Breakdown: </run>
                  <run fontcolor='#555555' fontsize='10'>Detailed view of giftcards performance by countries</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>GC Company Orders: </run>
                  <run fontcolor='#555555' fontsize='10'>Detailed view of giftcards orders performance by companies</run>
                  <run>Æ&#10;&#10;&#10;</run>
                  <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>POCs</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#555555' fontsize='10'>Please reach out in </run>
                  <run fontcolor='#555555' fontsize='10' italic='true'>#pandata-corporate </run>
                  <run fontcolor='#555555' fontsize='10'>if there are any issues.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
