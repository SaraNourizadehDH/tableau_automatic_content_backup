            <column-instance column='[Calculation_332844180508901377]' derivation='Sum' name='[sum:Calculation_332844180508901377:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_332844180509016066]' derivation='Sum' name='[sum:Calculation_332844180509016066:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_332844180509118467]' derivation='Sum' name='[sum:Calculation_332844180509118467:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_number_of_gc_sold]' derivation='Sum' name='[sum:total_number_of_gc_sold:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_number_of_successful_orders]' derivation='Sum' name='[sum:total_number_of_successful_orders:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[total_existing_gtv_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[total_existing_gtv_local]' role='measure' type='quantitative' />
