          <datasource-dependencies datasource='federated.0t971fo0jtywy41a9eo351q6l50l'>
            <column caption='# Avg. gift card per order' datatype='real' name='[Calculation_1862238459106648068]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_number_of_gc_sold])/SUM([total_number_of_successful_orders])' />
            </column>
            <column caption='GTV' datatype='real' name='[Calculation_332844180508901377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Local Currency&quot; THEN [total_gtv_local] ELSE [total_gtv_eur] END' />
            </column>
            <column caption='New GTV' datatype='real' name='[Calculation_332844180509016066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Local Currency&quot; THEN [total_new_gtv_local] ELSE [total_new_gtv_eur] END' />
            </column>
            <column caption='Existing GTV' datatype='real' name='[Calculation_332844180509118467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Local Currency&quot; THEN [total_existing_gtv_local] ELSE [total_existing_gtv_eur] END' />
