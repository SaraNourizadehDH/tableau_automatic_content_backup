      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_60BA47CE479E45A7B1D7657ABBCA292E'>
            <properties context=''>
              <relation connection='bigquery.1ruzdj0028i81j124b55z1qtmo70' name='Custom SQL Query' type='text'>-- by order created date
SELECT
  gc_orders.global_entity_id,
  gc_orders.country,
  DATE(gc_orders.created_at_local) AS order_date_local,
  -- company details --
  gc_orders.cp_company_uuid AS purchase_company_uuid,
  gc_orders.company_name AS purchase_company_name,
  gc_orders.company_type AS purchase_company_type,
  companies.is_self_serving,
  gc_orders.account_owner_name,
  gc_orders.opportunity_owner_name,
  -- order details --
  gc_orders.sales_channel_platform,
  gc_orders.outlet_name,
  gc_orders.is_new_gtv_order,
  -- metrics --
  COUNT(DISTINCT gc_orders.qc_order_uuid) AS total_number_of_orders,
  COUNT(DISTINCT IF(gc_orders.is_complete, gc_orders.qc_order_uuid, NULL)) AS total_number_of_successful_orders,
  SUM(IF(gc_orders.is_complete, gc_orders.number_of_gc_sold, 0)) AS total_number_of_gc_sold,
  SUM(IF(gc_orders.is_complete, gc_orders.post_discount_amount_eur, 0)) AS total_gtv_eur,
  SUM(IF(gc_orders.is_complete AND gc_orders.is_new_gtv_order, gc_orders.post_discount_amount_eur, 0)) AS total_new_gtv_eur,
  SUM(IF(gc_orders.is_complete AND NOT gc_orders.is_new_gtv_order, gc_orders.post_discount_amount_eur, 0)) AS total_existing_gtv_eur,
  SUM(IF(gc_orders.is_complete, gc_orders.post_discount_amount_local, 0)) AS total_gtv_local,
  SUM(IF(gc_orders.is_complete AND gc_orders.is_new_gtv_order, gc_orders.post_discount_amount_local, 0)) AS total_new_gtv_local,
  SUM(IF(gc_orders.is_complete AND NOT gc_orders.is_new_gtv_order, gc_orders.post_discount_amount_local, 0)) AS total_existing_gtv_local,
FROM `fulfillment-dwh-production.pandata_report.regional_apac_fintech_gc_orders` AS gc_orders
LEFT JOIN `fulfillment-dwh-production.pandata_curated.cp_companies` AS companies
       ON gc_orders.cp_company_uuid = companies.uuid
      AND companies.is_state_deleted IS NOT TRUE
GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='regional_apac_cp_gc_summary' inline='true' name='federated.1b30wcc0gays4a1axn88a0ay9z73' version='18.1'>
