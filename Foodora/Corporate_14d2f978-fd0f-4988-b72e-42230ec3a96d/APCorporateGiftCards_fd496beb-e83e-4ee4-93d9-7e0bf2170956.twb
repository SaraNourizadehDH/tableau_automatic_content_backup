        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1vdexky0bn83ty10kr9x41yorz19'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='APAC Data Production' schema='pandata_ap_corporate' server-oauth='' username='yue.tee@foodpanda.com' workgroup-auth-mode='prompt' />
