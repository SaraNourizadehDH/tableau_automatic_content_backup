            <properties context=''>
              <relation connection='bigquery.1vdexky0bn83ty10kr9x41yorz19' name='Custom SQL Query' type='text'>SELECT
  giftcards.global_entity_id,
  giftcards.country,
  giftcards.purchase_company_name,
  giftcards.purchase_company_uuid,
  orders.company_type AS purchase_company_type,
  orders.sales_channel_platform,
  orders.outlet_name,
  DATE(giftcards.created_at_local) AS issue_date_local,
  giftcards.redemption_customer_source,
  giftcards.amount_local AS gc_value_local,
  DATE(giftcards.start_at_local) AS start_date_local,
  DATE(giftcards.end_at_local) AS end_date_local,
  giftcards.expiry_days_category,
  giftcards.expiry_month,
  -- status --
  giftcards.is_added_to_wallet,
  giftcards.is_redeemed_net,
  giftcards.is_redeemed_fully,
  giftcards.is_expired,
  -- gc count --
  COUNT(DISTINCT giftcards.gc_giftcard_uuid) AS total_giftcards,
  COUNT(DISTINCT IF(giftcards.is_added_to_wallet, giftcards.gc_giftcard_uuid, NULL)) AS total_added_to_wallet_giftcards,
  COUNT(DISTINCT IF(giftcards.is_redeemed_net, giftcards.gc_giftcard_uuid, NULL)) AS total_redeemed_giftcards,
  COUNT(DISTINCT IF(giftcards.is_redeemed_fully, giftcards.gc_giftcard_uuid, NULL)) AS total_fully_redeemed_giftcards,
  COUNT(DISTINCT IF(giftcards.is_redeemed_net IS NOT TRUE, giftcards.gc_giftcard_uuid, NULL)) AS total_no_redemption_giftcards,
  COUNT(DISTINCT IF(giftcards.is_expired, giftcards.gc_giftcard_uuid, NULL)) AS total_expired_giftcards,
  COUNT(DISTINCT IF(giftcards.is_expired AND giftcards.balance_amount_local &gt;&gt; 0, giftcards.gc_giftcard_uuid, NULL)) AS total_expired_w_bal_giftcards,
  COUNT(DISTINCT IF(giftcards.is_expired IS NOT TRUE AND giftcards.balance_amount_local &gt;&gt; 0, giftcards.gc_giftcard_uuid, NULL)) AS total_available_giftcards,
  -- amount_eur --
  SUM(giftcards.amount_eur) AS total_gc_amt_eur,
  SUM(IF(giftcards.is_added_to_wallet, giftcards.amount_eur, 0)) AS total_added_to_wallet_amt_eur,
  SUM(giftcards.net_redeemed_amount_eur) AS total_redeemed_amt_eur,
  SUM(IF(giftcards.is_redeemed_net IS NOT TRUE, giftcards.amount_eur, 0)) AS total_no_redemption_amt_eur,
  SUM(giftcards.balance_amount_eur) AS total_balance_amt_eur,
  SUM(IF(giftcards.is_expired IS NOT TRUE, giftcards.balance_amount_eur, 0)) AS total_available_bal_amt_eur,
  SUM(IF(giftcards.is_expired, giftcards.balance_amount_eur, 0)) AS total_expired_amt_eur,
  -- amount_local --
  SUM(giftcards.amount_local) AS total_gc_amt_local,
  SUM(IF(giftcards.is_added_to_wallet, giftcards.amount_local, 0)) AS total_added_to_wallet_amt_local,
  SUM(giftcards.net_redeemed_amount_local) AS total_redeemed_amt_local,
  SUM(IF(giftcards.is_redeemed_net IS NOT TRUE, giftcards.amount_local, 0)) AS total_no_redemption_amt_local,
  SUM(giftcards.balance_amount_local) AS total_balance_amt_local,
  SUM(IF(giftcards.is_expired IS NOT TRUE, giftcards.balance_amount_local, 0)) AS total_available_bal_amt_local,
  SUM(IF(giftcards.is_expired, giftcards.balance_amount_local, 0)) AS total_expired_amt_local,
FROM `fulfillment-dwh-production.pandata_report.regional_apac_fintech_gc_giftcards` AS giftcards
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_fintech_gc_orders` AS orders
       ON giftcards.qc_order_uuid = orders.qc_order_uuid
WHERE is_cancel_activation IS NOT TRUE
GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
