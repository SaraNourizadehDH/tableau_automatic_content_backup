              <bucket>&quot;[federated.1lcet3q1wayaqo15tge7608bn04l].[sum:Calculation_332844180510601221:qk]&quot;</bucket>
            </map>
            <map to='#ffffff'>
              <bucket>&quot;[federated.1lcet3q1wayaqo15tge7608bn04l].[sum:Calculation_332844180510420996:qk]&quot;</bucket>
