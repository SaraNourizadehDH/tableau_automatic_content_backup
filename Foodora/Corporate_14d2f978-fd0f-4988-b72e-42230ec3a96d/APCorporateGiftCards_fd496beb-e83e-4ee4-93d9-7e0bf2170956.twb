      <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_2306898553568382976]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Yearly&apos; THEN [redemption_date_local] &gt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,TODAY())) AND [redemption_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Quarterly&apos; THEN [redemption_date_local] &gt;= DATEADD(&apos;quarter&apos;,-7,DATETRUNC(&apos;quarter&apos;,TODAY())) AND [redemption_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN [redemption_date_local] &gt;= DATEADD(&apos;month&apos;,-12,DATETRUNC(&apos;month&apos;,TODAY())) AND [redemption_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN [redemption_date_local] &gt;= DATEADD(&apos;week&apos;,-11,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [redemption_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [redemption_date_local] &gt;= DATEADD(&apos;day&apos;,-12,TODAY()) AND [redemption_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly + MTD&apos; THEN [redemption_date_local] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [redemption_date_local] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly + WTD&apos; THEN [redemption_date_local] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [redemption_date_local] &lt; TODAY()&#10;END' />
      </column>
      <column caption='redeem orders' datatype='integer' name='[Calculation_253679334761254912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([redemption_pd_order_code])' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_332844180510420996]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Local Currency&quot; THEN [redeem_gmv_local] ELSE [redeem_gmv_eur] END' />
      </column>
      <column caption='GMV B2B' datatype='real' name='[Calculation_332844180510601221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Local Currency&quot; THEN [total_b2b_redeem_gmv_local] ELSE [total_b2b_redeem_gmv_eur] END' />
      </column>
      <column caption='GMV B2C' datatype='real' name='[Calculation_332844180510711814]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Local Currency&quot; THEN [total_b2c_redeem_gmv_local] ELSE [total_b2c_redeem_gmv_eur] END' />
      </column>
      <column caption='Dynamic Date Range' datatype='string' name='[Calculation_3830733706553991169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;Weekly&apos; OR [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) THEN STR(DATEPART(&apos;iso-year&apos;,[redemption_date_local]))+&apos;-&apos;+STR(DATEPART(&apos;iso-week&apos;,[redemption_date_local]))&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Monthly&apos; OR [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) THEN LEFT(STR(DATENAME(&apos;month&apos;,[redemption_date_local])),3)+&apos; &apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[redemption_date_local])),2)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Quarterly&apos; OR [Parameters].[Parameter 1] = &apos;Quarterly + MTD&apos;) THEN &quot;Q&quot;+STR(DATENAME(&apos;quarter&apos;,[redemption_date_local]))+&apos;-&apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[redemption_date_local])),2)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; then str(DATEPART(&apos;day&apos;,[redemption_date_local]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[redemption_date_local])),3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Yearly&apos; then RIGHT(STR(DATEPART(&apos;year&apos;,[redemption_date_local])),4)&#10;END' />
      </column>
