      <column caption='Active Vendors' datatype='integer' name='[Calculation_1204994394751016961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF[is_active]=TRUE THEN [vendor_code] END)' />
      </column>
      <column caption='Private Vendors' datatype='integer' name='[Calculation_1204994394752024579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF[is_private]=TRUE THEN [vendor_code] END)' />
      </column>
      <column caption='Testing Vendors' datatype='integer' name='[Calculation_1204994394752094212]' role='measure' type='quantitative'>
