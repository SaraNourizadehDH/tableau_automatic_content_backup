            <column-instance column='[is_vendor_testing]' derivation='None' name='[none:is_vendor_testing:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2462343120329859072]' derivation='User' name='[usr:Calculation_2462343120329859072:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3985404217862340610]' derivation='User' name='[usr:Calculation_3985404217862340610:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3985404217862508547]' derivation='User' name='[usr:Calculation_3985404217862508547:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Code' datatype='string' name='[vendor_code]' role='dimension' type='nominal' />
