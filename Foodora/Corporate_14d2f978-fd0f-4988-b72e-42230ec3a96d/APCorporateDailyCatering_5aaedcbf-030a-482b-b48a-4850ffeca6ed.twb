        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.12p7o8y0fq38fr18nkmfs043wrha' name='Custom_SQL_Query' type='text'>WITH sf_accounts AS (
    SELECT 
    sf_accounts.global_entity_id, 
    sf_accounts.id, 
    sf_accounts.global_vendor_id
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_sf_accounts` AS sf_accounts
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
           ON sf_accounts.global_entity_id = shared_countries.global_entity_id
    WHERE sf_accounts.status IN (&quot;New&quot;,&quot;Active&quot;) 
      AND sf_accounts.global_vendor_id IS NOT NULL
      AND ((shared_countries.company_name = &quot;Foodpanda&quot; AND shared_countries.region = &quot;Asia&quot;)
      OR (shared_countries.region = &quot;Europe&quot; AND shared_countries.name NOT IN (&quot;Finland&quot;, &quot;Germany&quot;)))
    GROUP BY 1,2,3
  ),

sf_commission AS (
  SELECT 
    contract.global_entity_id, 
    contract.accountid AS sf_account_id,
    contract.commission_type__c AS commission_type, 
    CASE WHEN 
      contract.commission_type__c = &apos;Percentage&apos; 
      THEN contract.commission__c
      ELSE contract.commission_per_order__c END AS commission, 
      DATETIME(contract.lastmodifieddate),
  ROW_NUMBER() OVER (PARTITION BY contract.global_entity_id, contract.accountid ORDER BY contract.global_entity_id, contract.accountid, DATETIME(contract.lastmodifieddate) DESC) AS RANK
  FROM `fulfillment-dwh-production.curated_data_shared_salesforce.contract` AS contract
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON contract.global_entity_id = shared_countries.global_entity_id
  WHERE contract.status = &quot;Activated&quot;
    AND ((shared_countries.company_name = &quot;Foodpanda&quot; AND shared_countries.region = &quot;Asia&quot;)
      OR (shared_countries.region = &quot;Europe&quot; AND shared_countries.name NOT IN (&quot;Finland&quot;, &quot;Germany&quot;)))
    AND contract.accountid IS NOT NULL
  QUALIFY RANK = 1
),

sf_vendors AS (
  SELECT 
    sf_accounts.global_entity_id, 
    sf_accounts.global_vendor_id, 
    sf_commission.commission_type, 
    sf_commission.commission
  FROM sf_accounts AS sf_accounts
  LEFT JOIN sf_commission AS sf_commission
  ON sf_accounts.global_entity_id = sf_commission.global_entity_id
  AND sf_accounts.id = sf_commission.sf_account_id
)

SELECT
pd_vendors.uuid,
shared_countries.name AS country,
shared_countries.country_code_iso AS country_code,
pd_vendors.global_entity_id,
offers_discounts.id AS discount_id,
pd_vendors.vendor_code,
pd_vendors.vendor_name,
sf_vendors.commission,
discounts.created_at_utc AS discount_created_date,
discounts.start_date_local AS discount_start_date,
discounts.end_date_local AS discount_end_date,
discounts.title AS discount_title,
discounts.description,
discounts.discount_type,
discounts.expedition_types AS expedition_type,
discounts.amount_local AS discount_amt_local,
discounts.minimum_order_value_local AS discount_mov_local,
discounts.foodpanda_ratio AS discount_foodpanda_ratio,
platform,
ROW_NUMBER() OVER (PARTITION BY pd_vendors.uuid ORDER BY pd_vendors.uuid, discounts.created_at_utc DESC) AS discount_ranking
FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` AS pd_vendors
LEFT JOIN UNNEST(pd_vendors.discounts) AS discounts
LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discounts` AS offers_discounts
       ON discounts.pd_discount_uuid=offers_discounts.uuid
LEFT JOIN UNNEST(offers_discounts.platforms) platform
LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
       ON pd_vendors.global_entity_id = shared_countries.global_entity_id
LEFT JOIN sf_vendors
       ON pd_vendors.global_entity_id = sf_vendors.global_entity_id
      AND pd_vendors.global_vendor_id = sf_vendors.global_vendor_id
WHERE LOWER(pd_vendors.vertical_type) = &quot;caterers&quot; 
  AND (DATE(discounts.end_date_local) &gt;&gt;= CURRENT_DATE OR DATE(discounts.start_date_local) &gt;&gt;= CURRENT_DATE)
  AND discounts.pd_discount_uuid IS NOT NULL
  AND LOWER(ARRAY_TO_STRING(discounts.expedition_types, &quot;,&quot;)) NOT LIKE (&quot;%pickup%&quot;)
  AND ((shared_countries.company_name = &quot;Foodpanda&quot; AND shared_countries.region = &quot;Asia&quot;)
      OR (shared_countries.region = &quot;Europe&quot; AND shared_countries.name NOT IN (&quot;Finland&quot;, &quot;Germany&quot;)))
  AND DATE(discounts.created_at_utc) &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
  AND discounts.start_date_local IS NOT NULL
QUALIFY discount_ranking = 1
ORDER BY 
  pd_vendors.uuid, 
  discounts.pd_discount_uuid, 
  discounts.created_at_utc DESC</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
