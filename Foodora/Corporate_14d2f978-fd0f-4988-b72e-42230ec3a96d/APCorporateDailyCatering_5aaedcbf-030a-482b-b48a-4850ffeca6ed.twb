              <relation connection='bigquery.1uqxw1u1mj4f8y10aw48p17fyyw8' name='Custom_SQL_Query' type='text'><![CDATA[WITH ratings AS (
  SELECT
    UPPER(SPLIT(review.global_entity_id, "_")[SAFE_OFFSET(1)]) AS country_code, 
    content.order_id AS code, 
    MAX(content.ratings.vendor_food.score) AS restaurant_food_rating, 
    MAX(content.ratings.packaging.score) AS packaging_rating, 
    MAX(content.ratings.rider.score) AS rider_rating, 
    MAX(content.avg_score) AS average_rating, 
    STRING_AGG(DISTINCT(content.text)) AS rating_comment 
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.review_stream` AS review 
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
        ON review.global_entity_id = shared_countries.global_entity_id 
  WHERE ((shared_countries.company_name = "Foodpanda" AND shared_countries.region = "Asia")
      OR (shared_countries.region = "Europe" AND shared_countries.name NOT IN ("Finland", "Germany")))
    AND DATE(`timestamp`) >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH) 
    AND content.order_id IS NOT NULL 
  GROUP BY 1,2
),

cancelled_orders AS (
  SELECT *
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_cancelled_orders`
  WHERE created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
    AND global_entity_id IN ("FP_PK", "FP_SG", "FP_TW", "FP_KH", "FP_LA", "FP_PH", "FP_TH", "FP_BD", "FP_HK", "FP_MY")  

  UNION ALL

  SELECT *
  FROM `fulfillment-dwh-production.pandata_report.regional_eu_cx_cancelled_orders`
  WHERE created_date_utc>>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
    AND global_entity_id IN ("MJM_AT", "OP_SE", "FO_NO", "DJ_CZ", "NP_HU")  

),

fx_temporary AS (
  SELECT 
    currency_code, 
    fx_rate_eur AS fx, 
    fx_rate_date, 
    ROW_NUMBER() OVER (PARTITION BY currency_code ORDER BY currency_code, fx_rate_date DESC) AS RANK,
    CASE
      WHEN currency_code = "BDT" THEN "BD"
      WHEN currency_code = "BGN" THEN "BG"
      WHEN currency_code = "HKD" THEN "HK"
      WHEN currency_code = "JPY" THEN "JP"
      WHEN currency_code = "MYR" THEN "MY"
      WHEN currency_code = "PHP" THEN "PH"
      WHEN currency_code = "PKR" THEN "PK"
      WHEN currency_code = "THB" THEN "TH"
      WHEN currency_code = "SGD" THEN "SG"
      WHEN currency_code = "TWD" THEN "TW"

      WHEN currency_code = "CZK" THEN "CZ"
      WHEN currency_code = "EUR" THEN "AT"
      WHEN currency_code = "SEK" THEN "SE"
      WHEN currency_code = "HUF" THEN "HU"
      WHEN currency_code = "NOK" THEN "NO"
    END AS country_code
  FROM `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates`
  WHERE DATE(fx_rate_date) >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 2 MONTH), MONTH)
  QUALIFY RANK = 1
  ),

fx AS (
  SELECT 
    currency_code, 
    fx, 
    fx_rate_date, 
    country_code
  FROM fx_temporary
  WHERE country_code IS NOT NULL
  ),

-- union both EU and APAC data
agg_vouchers AS (
  SELECT
    global_entity_id,
    order_code,
    value_eur,
    value_local,
    pd_voucher_uuid,
    is_voucher_used,
    attributions_foodpanda_ratio
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers`
  WHERE global_entity_id IN ("FP_BD", "FP_HK", "FP_KH", "FP_LA", "FP_MY", "FP_PH", "FP_PK", "FP_SG", "FP_TH", "FP_TW")
    AND created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)

  UNION ALL

  SELECT
    global_entity_id,
    order_code,
    voucher.value_eur,
    voucher.value_local,
    pd_voucher_uuid,
    is_voucher_used,
    voucher.attributions_foodpanda_ratio
  FROM `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_vouchers`
  WHERE global_entity_id IN ("MJM_AT", "OP_SE", "FO_NO", "DJ_CZ", "NP_HU")
    AND created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
),

agg_discounts AS (
  SELECT
    global_entity_id,
    order_code,
    discount_type,
    discount_title,
    discount_amount_eur,
    discount_amount_local,
    pd_discount_uuid,
    is_discount_used,
    attributions_foodpanda_ratio
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_discounts`
  WHERE global_entity_id IN ("FP_BD", "FP_HK", "FP_KH", "FP_LA", "FP_MY", "FP_PH", "FP_PK", "FP_SG", "FP_TH", "FP_TW")
    AND created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)

  UNION ALL

  SELECT
    global_entity_id,
    order_code,
    discount.discount_type,
    discount.discount_title,
    discount.discount_amount_eur,
    discount.discount_amount_local,
    pd_discount_uuid,
    is_discount_used,
    discount.attributions_foodpanda_ratio 
  FROM `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_discounts`
  WHERE global_entity_id IN ("MJM_AT", "OP_SE", "FO_NO", "DJ_CZ", "NP_HU")
    AND created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
)

SELECT
    shared_countries.name AS country,
    orders.country_code,
    DATE(orders.placed_at_local) AS date_local,
    DATE_DIFF(DATE(orders.estimated_delivery_timestamp),DATE(orders.placed_at_local),DAY) AS pre_order_days,
    orders.is_corporate,
    orders.is_successful AS is_valid_order,
    orders.is_failed AS is_failed_order,
    orders.is_preorder,
    orders.delivery_provider AS expedition_type,
    CASE WHEN business_types.business_type IN ("caterers") AND DATE(orders.placed_at_local) >>= "2020-12-01" THEN TRUE ELSE FALSE END AS is_catering_order,
    orders.order_id AS order_code,
    orders.vendor_id AS vendor_code,
    vendors.title AS vendor_name,
    orders.order_status AS status_name,
    cancelled_orders.pandora_decline_reason_title AS decline_reason,
    sb.gmv_eur,
    sb.gmv_local,
    sb.gfv_eur,
    sb.gfv_local,
    agg_discounts.discount_amount_eur AS discount_value_eur,
    agg_discounts.discount_amount_local AS discount_value_local,
    agg_discounts.attributions_foodpanda_ratio AS discount_ratio,
    -- orders.minimum_delivery_value_local/fx.fx AS minimum_order_value_eur,
    -- orders.minimum_delivery_value_local AS minimum_order_value_local,
    orders.value.charges.delivery_fee_local/fx.fx AS delivery_fee_eur,
    orders.value.charges.delivery_fee_local,
    CONCAT(orders.frontend_client.frontend_client_type,orders.frontend_client.client_version) AS platform,
    orders.estimated_delivery_timestamp AS expected_delivery_at_local,
    ratings.packaging_rating,
    ratings.restaurant_food_rating,
    ratings.rider_rating,
    ratings.average_rating,
    ratings.rating_comment
FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` AS orders
LEFT JOIN `fulfillment-dwh-production.pandata_curated.vdr_svc_vendors` AS vendors
       ON orders.vendor_id = vendors.vendor_code
       AND orders.global_entity_id = vendors.global_entity_id
LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
       ON orders.global_entity_id = shared_countries.global_entity_id 
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` sb
  ON orders.order_id = sb.order_code
  AND orders.global_entity_id = sb.global_entity_id
LEFT JOIN `fulfillment-dwh-production.pandata_datamart.preprocessing__core_vendor_business_types` AS business_types
        ON orders.vendor_id = business_types.vendor_code
        AND orders.global_entity_id = business_types.global_entity_id
LEFT JOIN agg_discounts
  ON orders.order_id = agg_discounts.order_code
  AND orders.global_entity_id = agg_discounts.global_entity_id
LEFT JOIN agg_vouchers
  ON orders.order_id = agg_vouchers.order_code
  AND orders.global_entity_id = agg_vouchers.global_entity_id
LEFT JOIN cancelled_orders
  ON orders.order_uid = cancelled_orders.order_uid
LEFT JOIN fx AS fx
        ON SPLIT(orders.global_entity_id, "_")[SAFE_OFFSET(1)] = fx.country_code
LEFT JOIN ratings
        ON SPLIT(orders.global_entity_id, "_")[SAFE_OFFSET(1)] = ratings.country_code 
        AND orders.order_id = ratings.code
WHERE orders.partition_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH) 
  AND DATE(orders.placed_at_local) <<= DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
  AND sb.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
  AND orders.order_status != "PENDING_ORDER_FAILED"
  AND business_types.business_type IN ("caterers")
  AND ((shared_countries.company_name = "Foodpanda" AND shared_countries.region = "Asia")
      OR (shared_countries.region = "Europe" AND shared_countries.name NOT IN ("Finland", "Germany")))]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
