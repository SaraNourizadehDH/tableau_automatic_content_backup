  IFNULL(caterers_menu.description_count,0) AS description_count,
  IFNULL(caterers_menu.description_coverage,0) AS description_coverage,
  vendor_open_hours.weekly_open_hours,
  vendor_open_hours.weekly_close_hours,
  vendor_class.vendor_grade,
  vendor_class.gmv_class
FROM vendor_details AS vendor_details
LEFT JOIN caterers_menu AS caterers_menu
       ON vendor_details.uuid = caterers_menu.uuid
LEFT JOIN vendor_open_hours AS vendor_open_hours
       ON vendor_details.uuid = vendor_open_hours.uuid
LEFT JOIN commission_details AS commission_details
       ON vendor_details.global_entity_id = commission_details.global_entity_id
      AND vendor_details.global_vendor_id = commission_details.global_vendor_id
LEFT JOIN vendor_class AS vendor_class
       ON vendor_details.global_entity_id = vendor_class.global_entity_id
      AND vendor_details.global_vendor_id = vendor_class.global_vendor_id</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
