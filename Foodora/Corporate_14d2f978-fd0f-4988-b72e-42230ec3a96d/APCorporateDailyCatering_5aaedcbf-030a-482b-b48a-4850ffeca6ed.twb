        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.13nyltv1n7xu4w1btlu8f00cytx8' name='Custom SQL Query' type='text'><![CDATA[WITH cancelled_orders AS (
  SELECT *
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_cancelled_orders`
  WHERE created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)  
),

AP_Corp_Daily_Catering_All_Orders_V2 AS (
  SELECT
      DATE(orders.placed_at_local) AS date_local,
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` AS orders
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.vdr_svc_vendors` AS vendors
        ON orders.vendor_id = vendors.vendor_code
        AND orders.global_entity_id = vendors.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
        ON orders.global_entity_id = shared_countries.global_entity_id 
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` sb
    ON orders.order_id = sb.order_code
    AND orders.global_entity_id = sb.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` AS business_types
          ON orders.vendor_id = business_types.vendor_code
          AND orders.global_entity_id = business_types.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_discounts` agg_discounts
    ON orders.order_id = agg_discounts.order_code
    AND orders.global_entity_id = agg_discounts.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` AS agg_vouchers
    ON orders.order_id = agg_vouchers.order_code
    AND orders.global_entity_id = agg_vouchers.global_entity_id
  LEFT JOIN cancelled_orders
    ON orders.order_uid = cancelled_orders.order_uid
  WHERE orders.partition_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH) 
    AND DATE(orders.placed_at_local) <<= DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
    AND sb.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
    AND agg_discounts.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
    AND agg_vouchers.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
    AND orders.order_status != "PENDING_ORDER_FAILED"
    AND business_types.business_type_apac IN ("caterers")
    AND shared_countries.company_name = "Foodpanda"
    AND shared_countries.region = "Asia"
),

AP_Corp_Daily_Catering_Orders_Temp_V2 AS (
  SELECT
      DATE(orders.placed_at_local) AS date_local
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` AS orders
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
        ON orders.global_entity_id = shared_countries.global_entity_id 
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` sb
    ON orders.order_id = sb.order_code
    AND orders.global_entity_id = sb.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` AS business_types
          ON orders.vendor_id = business_types.vendor_code
          AND orders.global_entity_id = business_types.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_discounts` sb_discounts
    ON orders.order_id = sb_discounts.order_code
    AND orders.global_entity_id = sb_discounts.global_entity_id
  LEFT JOIN cancelled_orders
    ON orders.order_uid = cancelled_orders.order_uid
  WHERE orders.partition_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)  
    AND DATE(orders.placed_at_local) <<= DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
    AND sb.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
    AND sb_discounts.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
    AND shared_countries.company_name = "Foodpanda"
    AND shared_countries.region = "Asia"
    AND orders.order_status != "PENDING_ORDER_FAILED"
    AND business_types.business_type_apac IN ("caterers")
),

AP_Corp_Daily_Catering_Discounts_V2 AS (
  SELECT
  discounts.created_at_utc AS discount_created_date,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` AS pd_vendors
  LEFT JOIN UNNEST(pd_vendors.discounts) AS discounts
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discounts` AS offers_discounts
        ON discounts.pd_discount_uuid=offers_discounts.uuid
  LEFT JOIN UNNEST(offers_discounts.platforms) platform
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
        ON pd_vendors.global_entity_id = shared_countries.global_entity_id
  WHERE LOWER(pd_vendors.vertical_type) = "caterers" 
    AND (DATE(discounts.end_date_local) >>= CURRENT_DATE OR DATE(discounts.start_date_local) >>= CURRENT_DATE)
    AND discounts.pd_discount_uuid IS NOT NULL
    AND LOWER(ARRAY_TO_STRING(discounts.expedition_types, ",")) NOT LIKE ("%pickup%")
    AND shared_countries.company_name = "Foodpanda"
    AND shared_countries.region = "Asia"
    AND DATE(discounts.created_at_utc) >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
    AND discounts.start_date_local IS NOT NULL
),
 AP_Corp_Daily_Catering_Vendors_V2 AS (
  SELECT 
    table_id,
    DATETIME(TIMESTAMP_MILLIS(t.last_modified_time)) AS last_modified_time,
    IF((DATE(TIMESTAMP_MILLIS(t.last_modified_time)) >>= CURRENT_DATE - 1), TRUE, FALSE) AS is_data_fresh
  FROM `fulfillment-dwh-production.pandata_report.__TABLES__` AS t
  WHERE table_id = "regional_apac_commercial_vendors"
 )

SELECT
 "AP_Corp_Daily_Catering_All_Orders_V2" AS table_name,
 MAX(DATE(date_local)) AS latest_date,
 IF((MAX(DATE(date_local)) >>= CURRENT_DATE - 1), TRUE, FALSE) AS is_data_fresh
FROM AP_Corp_Daily_Catering_All_Orders_V2
WHERE  date_local >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 DAY)

UNION ALL

SELECT
 "AP_Corp_Daily_Catering_Orders_Temp_V2" AS table_name,
 MAX(DATE(date_local)) AS latest_date,
 IF((MAX(DATE(date_local)) >>= CURRENT_DATE - 1), TRUE, FALSE) AS is_data_fresh
FROM AP_Corp_Daily_Catering_Orders_Temp_V2
WHERE  date_local >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 DAY)

UNION ALL 

SELECT
 "AP_Corp_Daily_Catering_Discounts_V2" AS table_name,
 MAX(DATE(discount_created_date)) AS latest_date,
 IF((MAX(DATE(discount_created_date)) >>= CURRENT_DATE - 1), TRUE, FALSE) AS is_data_fresh
FROM AP_Corp_Daily_Catering_Discounts_V2
WHERE discount_created_date >>= DATE_SUB(CURRENT_DATE, INTERVAL 3 DAY)

UNION ALL

SELECT
 "AP_Corp_Daily_Catering_Vendors_V2" AS table_name,
 last_modified_time AS latest_date,
 is_data_fresh
FROM AP_Corp_Daily_Catering_Vendors_V2
GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
