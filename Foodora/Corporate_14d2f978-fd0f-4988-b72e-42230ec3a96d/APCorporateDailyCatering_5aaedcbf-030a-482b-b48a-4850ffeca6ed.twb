          </datasources>
          <datasource-dependencies datasource='federated.05cwqx41r796hy16yz9pd0dxa916'>
            <column caption='AAA Vendors %' datatype='real' name='[Calculation_2462343120329859072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(If [vendor_grade]=&quot;AAA&quot; then [vendor_code] END)/COUNT([vendor_code])' />
            </column>
            <column caption='Image Coverage %' datatype='real' name='[Calculation_3985404217862340610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([img_count])/SUM([menu_product_count])' />
            </column>
            <column caption='Description Coverage %' datatype='real' name='[Calculation_3985404217862508547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([description_count])/SUM([menu_product_count])' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Description Count' datatype='integer' name='[description_count]' role='measure' type='quantitative' />
            <column caption='Image Count' datatype='integer' name='[img_count]' role='measure' type='quantitative' />
            <column caption='Is Active' datatype='boolean' name='[is_active]' role='dimension' type='nominal' />
            <column caption='Is Private' datatype='boolean' name='[is_private]' role='dimension' type='nominal' />
            <column caption='Is Testing' datatype='boolean' name='[is_vendor_testing]' role='dimension' type='nominal' />
            <column caption='Menu Item Count' datatype='integer' name='[menu_product_count]' role='measure' type='quantitative' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_active]' derivation='None' name='[none:is_active:nk]' pivot='key' type='nominal' />
