    <datasource caption='AP_Corp_Daily_Catering_Orders_Temp_V2' inline='true' name='federated.1elnscv1dnww5y18ayjmc0w09r4q' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.15kmdix0gy7z0717gbqlm04j27c3'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' REDIRECT_URI='urn:ietf:wg:oauth:2.0:oob' SCOPE='email profile https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloudplatformprojects.readonly' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_curated' server='' server-oauth='server-custom' username='yue.tee@foodpanda.com' workgroup-auth-mode='prompt' />
