      <column caption='AAA Vendors %' datatype='real' name='[Calculation_2462343120329859072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(If [vendor_grade]=&quot;AAA&quot; then [vendor_code] END)/COUNT([vendor_code])' />
      </column>
      <column caption='Avg Menu Items Per Vendor' datatype='real' name='[Calculation_3985404217855868928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([menu_product_count])/SUM([Calculation_1204994394756722693])' />
      </column>
      <column caption='Image Coverage %' datatype='real' name='[Calculation_3985404217862340610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([img_count])/SUM([menu_product_count])' />
      </column>
      <column caption='Description Coverage %' datatype='real' name='[Calculation_3985404217862508547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([description_count])/SUM([menu_product_count])' />
      </column>
      <column caption='Avg Past 7 Days Opening Hours' datatype='real' name='[Calculation_607985980818903040]' role='measure' type='quantitative'>
