      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='performance_metrics' id='cp_combined_orders_618E50BF828C474890D50201D7B98198'>
            <properties context=''>
              <relation connection='bigquery.1j1iryq01mayt016l16ek0ql52sv' name='Custom SQL Query' type='text'>WITH cp_combined_orders AS (  
  SELECT 
    region,
    date_local,
    global_entity_id,
    country_name,
    opportunity_owner_name,
    company_uuid,
    company_name,
    company_type,
    total_allowance_gmv_eur,
    total_corporate_gmv_eur,
    is_first_valid_company_order,
    is_new_gmv_order
  FROM `fulfillment-dwh-production.pandata_report.cp_combined_orders`
  WHERE EXTRACT(YEAR FROM date_local) &gt;&gt;= 2024 
    AND global_entity_id IS NOT NULL
    AND (is_first_valid_company_order 
    OR is_new_gmv_order)

),

sales_target AS(
  SELECT
      CASE
          WHEN global_entity_id IN (&quot;MJM_AT&quot;, &quot;OP_SE&quot;, &quot;FO_NO&quot;, &quot;DJ_CZ&quot;, &quot;NP_HU&quot;) THEN &quot;Europe&quot;
          ELSE &quot;Asia&quot;
      END AS region,
      period AS date_local,
      global_entity_id,
      country AS country_name,
      name AS opportunity_owner_name,
      CAST(NULL AS STRING) AS company_name,
      CAST(NULL AS STRING)  AS company_type,
      0 AS new_gmv,
      0 AS allowance_gmv,
      COALESCE(SUM(new_gmv_target), 0) AS new_gmv_target,
      0 AS accounts_with_first_valid_order
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_cp_sales_target`
  WHERE EXTRACT(YEAR FROM period) &gt;&gt;= 2024 
  GROUP BY ALL

), 

metrics AS (
  SELECT 
    region,
    date_local,
    global_entity_id,
    country_name,
    opportunity_owner_name,
    company_name,
    company_type,
    SUM(IF(is_new_gmv_order IS TRUE, total_corporate_gmv_eur,0)) AS new_gmv,
    SUM(IF(is_new_gmv_order IS TRUE, total_allowance_gmv_eur,0)) AS allowance_gmv,
    0 AS new_gmv_target,
    COUNT(DISTINCT IF(is_first_valid_company_order, company_uuid, NULL)) AS accounts_with_first_valid_order
  FROM cp_combined_orders 
  GROUP BY ALL 
)
SELECT * FROM metrics
UNION ALL
SELECT * FROM sales_target</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='GMV pipeline' inline='true' name='federated.05y6x8z1iup02r15snhdn14vvwj4' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1v4104a13s0yf8169kjbd0zuy49y'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='curated_data_shared_salesforce_ccs' server-oauth='server-custom' username='yue.tee@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1v4104a13s0yf8169kjbd0zuy49y' name='Custom SQL Query' type='text'>WITH gmv_pipeline AS (
  SELECT 
    CASE
      WHEN opportunity.global_entity_id IN (&quot;FP_PK&quot;, &quot;FP_SG&quot;, &quot;FP_TW&quot;, &quot;FP_KH&quot;, &quot;FP_LA&quot;, &quot;FP_PH&quot;, &quot;FP_TH&quot;, &quot;FP_BD&quot;, &quot;FP_HK&quot;, &quot;FP_MY&quot;)
      THEN &quot;Asia&quot;
      ELSE &quot;Europe&quot;
    END AS region,
    opportunity.global_entity_id,
    RIGHT(opportunity.global_entity_id, 2) AS country_code,
    opportunity.country__c AS country,
    DATE(opportunity.createddate) AS created_date,
    opportunity.ownerid,
    user.name AS opportunity_owner_name,
    opportunity.name AS opportunity_name,
    opportunity.stagename,
    SUM(amount) AS est_gmv_potential_deals_local
  FROM `fulfillment-dwh-production.curated_data_shared_salesforce_ccs.opportunity` AS opportunity
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce_ccs.user` AS user
    ON opportunity.ownerid = user.id
  WHERE EXTRACT(YEAR FROM opportunity.createddate) &gt;&gt;= 2024 
    AND stagename NOT IN (&quot;Closed Lost&quot;, &quot;Closed Won&quot;)
    AND opportunity.name NOT LIKE &apos;%This is an internal test%&apos;
    AND opportunity.name NOT LIKE &apos;%Test%&apos;
    AND user.name NOT LIKE &apos;%Platform API User%&apos;
  GROUP BY ALL
  HAVING est_gmv_potential_deals_local IS NOT NULL
),
fx_rates AS (
  SELECT
    LEFT(central_dwh_fx_rates.currency_code, 2) AS country_code,
    central_dwh_fx_rates.currency_code,
    central_dwh_fx_rates.fx_rate_eur,
    central_dwh_fx_rates.fx_rate_date
  FROM `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS central_dwh_fx_rates
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON central_dwh_fx_rates.currency_code = shared_countries.currency_code_iso
  WHERE ((shared_countries.company_name = &quot;Foodpanda&quot; AND shared_countries.region = &quot;Asia&quot;)
      OR (shared_countries.region = &quot;Europe&quot; AND shared_countries.name NOT IN (&quot;Finland&quot;, &quot;Germany&quot;)))
    AND central_dwh_fx_rates.fx_rate_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 YEAR), YEAR)
)
SELECT gmv_pipeline.*,
  gmv_pipeline.est_gmv_potential_deals_local/fx_rates.fx_rate_eur AS est_gmv_potential_deals_eur, 
  fx_rates.fx_rate_eur
FROM gmv_pipeline 
LEFT JOIN fx_rates 
  ON gmv_pipeline.country_code = fx_rates.country_code
  AND gmv_pipeline.created_date = fx_rates.fx_rate_date</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1v4104a13s0yf8169kjbd0zuy49y' name='Custom SQL Query' type='text'>WITH gmv_pipeline AS (
  SELECT 
    CASE
      WHEN opportunity.global_entity_id IN (&quot;FP_PK&quot;, &quot;FP_SG&quot;, &quot;FP_TW&quot;, &quot;FP_KH&quot;, &quot;FP_LA&quot;, &quot;FP_PH&quot;, &quot;FP_TH&quot;, &quot;FP_BD&quot;, &quot;FP_HK&quot;, &quot;FP_MY&quot;)
      THEN &quot;Asia&quot;
      ELSE &quot;Europe&quot;
    END AS region,
    opportunity.global_entity_id,
    RIGHT(opportunity.global_entity_id, 2) AS country_code,
    opportunity.country__c AS country,
    DATE(opportunity.createddate) AS created_date,
    opportunity.ownerid,
    user.name AS opportunity_owner_name,
    opportunity.name AS opportunity_name,
    opportunity.stagename,
    SUM(amount) AS est_gmv_potential_deals_local
  FROM `fulfillment-dwh-production.curated_data_shared_salesforce_ccs.opportunity` AS opportunity
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce_ccs.user` AS user
    ON opportunity.ownerid = user.id
  WHERE EXTRACT(YEAR FROM opportunity.createddate) &gt;&gt;= 2024 
    AND stagename NOT IN (&quot;Closed Lost&quot;, &quot;Closed Won&quot;)
    AND opportunity.name NOT LIKE &apos;%This is an internal test%&apos;
    AND opportunity.name NOT LIKE &apos;%Test%&apos;
    AND user.name NOT LIKE &apos;%Platform API User%&apos;
  GROUP BY ALL
  HAVING est_gmv_potential_deals_local IS NOT NULL
),
fx_rates AS (
  SELECT
    LEFT(central_dwh_fx_rates.currency_code, 2) AS country_code,
    central_dwh_fx_rates.currency_code,
    central_dwh_fx_rates.fx_rate_eur,
    central_dwh_fx_rates.fx_rate_date
  FROM `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS central_dwh_fx_rates
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON central_dwh_fx_rates.currency_code = shared_countries.currency_code_iso
  WHERE ((shared_countries.company_name = &quot;Foodpanda&quot; AND shared_countries.region = &quot;Asia&quot;)
      OR (shared_countries.region = &quot;Europe&quot; AND shared_countries.name NOT IN (&quot;Finland&quot;, &quot;Germany&quot;)))
    AND central_dwh_fx_rates.fx_rate_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 YEAR), YEAR)
)
SELECT gmv_pipeline.*,
  gmv_pipeline.est_gmv_potential_deals_local/fx_rates.fx_rate_eur AS est_gmv_potential_deals_eur, 
  fx_rates.fx_rate_eur
FROM gmv_pipeline 
LEFT JOIN fx_rates 
  ON gmv_pipeline.country_code = fx_rates.country_code
  AND gmv_pipeline.created_date = fx_rates.fx_rate_date</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
