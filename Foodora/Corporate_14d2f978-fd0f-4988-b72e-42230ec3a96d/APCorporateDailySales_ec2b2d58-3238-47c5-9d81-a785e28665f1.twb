        <column caption='Dynamic Date Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
          <calculation class='tableau' formula='&quot;Monthly&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_F0B62B63084748FF8614E398D7689B22'>
            <properties context=''>
              <relation connection='bigquery.1ebghu81d135zt1cwmr5w0koyz1q' name='Custom SQL Query' type='text'>WITH cp_combined_orders AS (  
  SELECT 
    region,
    date_local,
    global_entity_id,
    country_name,
    opportunity_owner_name,
    company_uuid,
    company_name,
    total_allowance_gmv_eur,
    total_corporate_gmv_eur,
    is_first_valid_company_order,
    is_new_gmv_order
  FROM `fulfillment-dwh-production.pandata_report.cp_combined_orders`
  WHERE EXTRACT(YEAR FROM date_local) &gt;&gt;= 2024 
    AND global_entity_id IS NOT NULL
    AND (is_first_valid_company_order 
    OR is_new_gmv_order)

)

SELECT 
  region,
  date_local,
  global_entity_id,
  country_name,
  opportunity_owner_name,
  company_name,
  SUM(IF(is_new_gmv_order IS TRUE, total_corporate_gmv_eur,0)) AS new_gmv,
  SUM(IF(is_new_gmv_order IS TRUE, total_allowance_gmv_eur,0)) AS allowance_gmv,
  COALESCE(SUM(IF(is_new_gmv_order IS TRUE, total_allowance_gmv_eur,0))/ NULLIF(SUM(IF(is_new_gmv_order IS TRUE, total_corporate_gmv_eur,0)),0),0) AS pct_allowance_new_gmv
  FROM cp_combined_orders 
  GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='metric definitions and freshness' inline='true' name='federated.1ef49kq1vnf9uh198kzcq1wdk77a' version='18.1'>
