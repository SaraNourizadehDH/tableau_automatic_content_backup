            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='server-custom' username='yue.tee@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0jouuxb17dvoi418bzksb0hgkmpj' name='Custom SQL Query' type='text'>SELECT 
  table_name,
  column_name,
  description, 
  DATETIME(TIMESTAMP_MILLIS(t.last_modified_time)) AS last_modified_time,
  IF((DATE(TIMESTAMP_MILLIS(t.last_modified_time)) &gt;&gt;= CURRENT_DATE - 1), TRUE, FALSE) AS is_data_fresh
FROM `fulfillment-dwh-production.pandata_report.INFORMATION_SCHEMA.COLUMN_FIELD_PATHS` AS c
LEFT JOIN `fulfillment-dwh-production.pandata_report.__TABLES__` AS t
        ON c.table_name = t.table_id
WHERE table_name IN (
  &quot;regional_apac_cp_sales_target&quot;,
  &quot;cp_combined_orders&quot;)
  AND column_name IN (
    &quot;total_corporate_gmv_eur&quot;,
    &quot;total_allowance_gmv_eur&quot;,
    &quot;new_gmv_target&quot;
  )

UNION ALL

SELECT 
  table_name,
  column_name,
  &quot;Estimated total sale amount&quot; AS description, 
  DATETIME(TIMESTAMP_MILLIS(t.last_modified_time)) AS last_modified_time,
  IF((DATE(TIMESTAMP_MILLIS(t.last_modified_time)) &gt;&gt;= CURRENT_DATE - 1), TRUE, FALSE) AS is_data_fresh
FROM `fulfillment-dwh-production.curated_data_shared_salesforce_ccs.INFORMATION_SCHEMA.COLUMN_FIELD_PATHS` AS c
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce_ccs.__TABLES__` AS t
        ON c.table_name = t.table_id
WHERE table_name = &quot;opportunity&quot;
      AND column_name = &quot;amount&quot;
