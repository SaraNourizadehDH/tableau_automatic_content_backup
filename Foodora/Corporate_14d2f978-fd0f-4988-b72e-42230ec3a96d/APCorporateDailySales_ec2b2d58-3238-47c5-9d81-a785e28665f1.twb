        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1j1iryq01mayt016l16ek0ql52sv' name='Custom SQL Query' type='text'>WITH cp_combined_orders AS (  
  SELECT 
    region,
    date_local,
    global_entity_id,
    country_name,
    opportunity_owner_name,
    company_uuid,
    company_name,
    company_type,
    total_allowance_gmv_eur,
    total_corporate_gmv_eur,
    is_first_valid_company_order,
    is_new_gmv_order
  FROM `fulfillment-dwh-production.pandata_report.cp_combined_orders`
  WHERE EXTRACT(YEAR FROM date_local) &gt;&gt;= 2024 
    AND global_entity_id IS NOT NULL
    AND (is_first_valid_company_order 
    OR is_new_gmv_order)

),

sales_target AS(
  SELECT
      CASE
          WHEN global_entity_id IN (&quot;MJM_AT&quot;, &quot;OP_SE&quot;, &quot;FO_NO&quot;, &quot;DJ_CZ&quot;, &quot;NP_HU&quot;) THEN &quot;Europe&quot;
          ELSE &quot;Asia&quot;
      END AS region,
      period AS date_local,
      global_entity_id,
      country AS country_name,
      name AS opportunity_owner_name,
      CAST(NULL AS STRING) AS company_name,
      CAST(NULL AS STRING)  AS company_type,
      0 AS new_gmv,
      0 AS allowance_gmv,
      COALESCE(SUM(new_gmv_target), 0) AS new_gmv_target,
      0 AS accounts_with_first_valid_order
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_cp_sales_target`
  WHERE EXTRACT(YEAR FROM period) &gt;&gt;= 2024 
  GROUP BY ALL

), 

metrics AS (
  SELECT 
    region,
    date_local,
    global_entity_id,
    country_name,
    opportunity_owner_name,
    company_name,
    company_type,
    SUM(IF(is_new_gmv_order IS TRUE, total_corporate_gmv_eur,0)) AS new_gmv,
    SUM(IF(is_new_gmv_order IS TRUE, total_allowance_gmv_eur,0)) AS allowance_gmv,
    0 AS new_gmv_target,
    COUNT(DISTINCT IF(is_first_valid_company_order, company_uuid, NULL)) AS accounts_with_first_valid_order
  FROM cp_combined_orders 
  GROUP BY ALL 
)
SELECT * FROM metrics
UNION ALL
SELECT * FROM sales_target</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
