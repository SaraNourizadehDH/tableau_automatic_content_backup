            <column caption='Target' datatype='real' name='[new_gmv_target]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2572540605129211904]' derivation='None' name='[none:Calculation_2572540605129211904:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2572540605129502721]' derivation='None' name='[none:Calculation_2572540605129502721:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2572540605403127812]' derivation='None' name='[none:Calculation_2572540605403127812:qk]' pivot='key' type='quantitative' />
