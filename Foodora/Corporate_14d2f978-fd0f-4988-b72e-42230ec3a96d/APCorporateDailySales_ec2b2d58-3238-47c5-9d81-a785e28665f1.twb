      <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_2761902896746340352]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Yearly&apos; THEN [created_date] &gt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,TODAY())) AND [created_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Quarterly&apos; THEN [created_date] &gt;= DATEADD(&apos;quarter&apos;,-7,DATETRUNC(&apos;quarter&apos;,TODAY())) AND [created_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN [created_date] &gt;= DATEADD(&apos;month&apos;,-11,DATETRUNC(&apos;month&apos;,TODAY())) AND [created_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN [created_date] &gt;= DATEADD(&apos;week&apos;,-11,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [created_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [created_date] &gt;= DATEADD(&apos;day&apos;,-12,TODAY()) AND [created_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly + MTD&apos; THEN [created_date] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [created_date] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly + WTD&apos; THEN [created_date] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [created_date] &lt; TODAY()&#10;END&#10;&#10;//if [Dynamic Date Selector] = &apos;Month&apos; THEN [Date] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [Date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;//ELSEIF [Dynamic Date Selector] = &apos;Week&apos; THEN [Date] &gt;= DATEADD(&apos;week&apos;,-7,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [Date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;//ELSEIF [Dynamic Date Selector] = &apos;Day&apos; THEN [Date] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [Date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;//ELSEIF [Dynamic Date Selector] = &apos;Month + MTD&apos; THEN [Date] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [Date] &lt; TODAY()&#10;//ELSEIF [Dynamic Date Selector] = &apos;Week + WTD&apos; THEN [Date] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [Date] &lt; TODAY()&#10;//END' />
      </column>
      <column caption='Dynamic Date Range' datatype='string' name='[Calculation_2761902896746528769]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;Monthly&apos; OR [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) THEN LEFT(STR(DATENAME(&apos;month&apos;,[created_date])),3)+&apos; &apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[created_date])),2)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Quarterly&apos; OR [Parameters].[Parameter 1] = &apos;Quarterly + MTD&apos;) THEN &quot;Q&quot;+STR(DATENAME(&apos;quarter&apos;,[created_date]))+&apos;-&apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[created_date])),2)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Weekly&apos; OR [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) THEN STR(DATEPART(&apos;iso-year&apos;,[created_date]))+&apos;-&apos;+STR(DATEPART(&apos;iso-week&apos;,[created_date]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; then str(DATEPART(&apos;day&apos;,[created_date]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[created_date])),3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Yearly&apos; then RIGHT(STR(DATEPART(&apos;year&apos;,[created_date])),4)&#10;END' />
      </column>
      <column caption='Order Date Range' datatype='date' name='[Calculation_2761902896746655746]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[created_date]' />
      </column>
