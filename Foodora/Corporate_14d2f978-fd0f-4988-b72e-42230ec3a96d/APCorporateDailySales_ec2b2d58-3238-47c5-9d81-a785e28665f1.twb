            <zone fixed-size='286' forceUpdate='true' h='36750' id='105' is-fixed='true' type-v2='text' w='98666' x='667' y='15375'>
              <formatted-text>
                <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>Purpose/ Description</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>- Performance tracking for Corporate daily sales</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>- To track performance of opportunity owners</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>- Refreshes Daily</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>How to use the dashboard (tabs)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>New GMV with Target: </run>
                <run fontcolor='#555555' fontsize='10'>Monthly sales new GMV performance by country and opportunity owners with monthly target</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Allowance GMV: </run>
                <run fontcolor='#555555' fontsize='10'>Allowance GMV performance by country and opportunity owners</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>GMV Pipeline:</run>
                <run fontcolor='#555555' fontsize='10'> Estimated GMV from potential deals in pipeline by country and opportunity owners</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>First Company Orders:</run>
                <run fontcolor='#555555' fontsize='10'> Number of new accounts with first valid order by country and opportunity owners</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>POCs</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>Please reach out in #pandata-corporate if there are any issues.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
