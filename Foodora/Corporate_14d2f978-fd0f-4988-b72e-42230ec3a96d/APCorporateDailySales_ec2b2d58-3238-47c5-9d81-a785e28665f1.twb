      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales metrics' name='federated.04pfudi16m7rbs1fppyk20z6vaxa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dynamic Date Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04pfudi16m7rbs1fppyk20z6vaxa'>
            <column caption='Perf %' datatype='real' name='[Calculation_1670624413387689985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_gmv])/SUM([new_gmv_target])' />
            </column>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_2572540605129211904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Yearly&apos; THEN [date_local] &gt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,TODAY())) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Quarterly&apos; THEN [date_local] &gt;= DATEADD(&apos;quarter&apos;,-7,DATETRUNC(&apos;quarter&apos;,TODAY())) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN [date_local] &gt;= DATEADD(&apos;month&apos;,-11,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN [date_local] &gt;= DATEADD(&apos;week&apos;,-11,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [date_local] &gt;= DATEADD(&apos;day&apos;,-12,TODAY()) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly + MTD&apos; THEN [date_local] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_local] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly + WTD&apos; THEN [date_local] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [date_local] &lt; TODAY()&#10;END&#10;&#10;//if [Dynamic Date Selector] = &apos;Month&apos; THEN [Date] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [Date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;//ELSEIF [Dynamic Date Selector] = &apos;Week&apos; THEN [Date] &gt;= DATEADD(&apos;week&apos;,-7,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [Date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;//ELSEIF [Dynamic Date Selector] = &apos;Day&apos; THEN [Date] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [Date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;//ELSEIF [Dynamic Date Selector] = &apos;Month + MTD&apos; THEN [Date] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [Date] &lt; TODAY()&#10;//ELSEIF [Dynamic Date Selector] = &apos;Week + WTD&apos; THEN [Date] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [Date] &lt; TODAY()&#10;//END' />
            </column>
            <column caption='Dynamic Date Range' datatype='string' name='[Calculation_2572540605129502721]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;Monthly&apos; OR [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) THEN LEFT(STR(DATENAME(&apos;month&apos;,[date_local])),3)+&apos; &apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[date_local])),2)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Quarterly&apos; OR [Parameters].[Parameter 1] = &apos;Quarterly + MTD&apos;) THEN &quot;Q&quot;+STR(DATENAME(&apos;quarter&apos;,[date_local]))+&apos;-&apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[date_local])),2)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Weekly&apos; OR [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) THEN STR(DATEPART(&apos;iso-year&apos;,[date_local]))+&apos;-&apos;+STR(DATEPART(&apos;iso-week&apos;,[date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; then str(DATEPART(&apos;day&apos;,[date_local]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[date_local])),3)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Yearly&apos; then RIGHT(STR(DATEPART(&apos;year&apos;,[date_local])),4)&#10;END' />
            </column>
            <column caption='Order Date Range' datatype='date' name='[Calculation_2572540605403127812]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[date_local]' />
            </column>
            <column caption='Company Type' datatype='string' name='[company_type]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Target Period' datatype='date' name='[date_local]' role='dimension' type='ordinal' />
            <column-instance column='[date_local]' derivation='Max' name='[max:date_local:qk]' pivot='key' type='quantitative' />
