            <column datatype='date' name='[created_at_date]' role='dimension' type='ordinal' />
            <column datatype='boolean' name='[is_new_gtv_order]' role='dimension' type='nominal' />
            <column-instance column='[created_at_date]' derivation='Min' name='[min:created_at_date:qk]' pivot='key' type='quantitative' />
