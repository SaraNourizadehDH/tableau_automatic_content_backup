            <formatted-text>
              <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>Purpose/ Description</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>- Gift card GTV and pro subscribers premier league for sales team and AMs to track their sales performance</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>- Refreshes Daily</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>How to use the dashboard (tabs)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Sales PP Premier League: </run>
              <run fontcolor='#555555' fontsize='10'>Overview of pandapro subscription blocks by country and opportunity owners</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Sales PP Premier Leaague Detail: </run>
              <run fontcolor='#555555' fontsize='10'>Detailed view of pandapro subscription blocks by opportunity owners and pandapro plan duration</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>AM PP Premier League: </run>
              <run fontcolor='#555555' fontsize='10'>Overview of pandapro subscription blocks by country and account owners</run>
              <run>Æ&#10;</run>
