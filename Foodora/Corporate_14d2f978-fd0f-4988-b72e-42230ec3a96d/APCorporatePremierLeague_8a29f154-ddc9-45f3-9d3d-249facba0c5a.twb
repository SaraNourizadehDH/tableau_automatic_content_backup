    <worksheet name='Top New Blocks'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Top New Blocks</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_pro_premier_league' name='federated.0c1ge8u0tdg5sd1b8hva412quczj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dynamic Date Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0c1ge8u0tdg5sd1b8hva412quczj'>
            <column caption='Account Name ' datatype='string' name='[Account Name (copy)_5432044863674699781]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[account_name]' />
            </column>
            <column caption='Subscription Blocks' datatype='real' name='[Calculation_1695253440127021056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[subscription_count] * [subscription_months]' />
            </column>
            <column caption='New/Existing Subscription Blocks' datatype='string' name='[Calculation_5668765347868061697]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF([is_new_gmv_subscription] = TRUE) THEN &apos;New Blocks&apos; ELSE &apos;Existing Blocks&apos; END' />
            </column>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_5857212815465050113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Yearly&apos; THEN [subscription_start_date] &gt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,TODAY())) AND [subscription_start_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Quarterly&apos; THEN [subscription_start_date] &gt;= DATEADD(&apos;quarter&apos;,-7,DATETRUNC(&apos;quarter&apos;,TODAY())) AND [subscription_start_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN [subscription_start_date] &gt;= DATEADD(&apos;month&apos;,-11,DATETRUNC(&apos;month&apos;,TODAY())) AND [subscription_start_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN [subscription_start_date] &gt;= DATEADD(&apos;week&apos;,-11,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [subscription_start_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [subscription_start_date] &gt;= DATEADD(&apos;day&apos;,-12,TODAY()) AND [subscription_start_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly + MTD&apos; THEN [subscription_start_date] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [subscription_start_date] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly + WTD&apos; THEN [subscription_start_date] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [subscription_start_date] &lt; TODAY()&#10;END&#10;&#10;//if [Dynamic Date Selector] = &apos;Month&apos; THEN [Date] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [Date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;//ELSEIF [Dynamic Date Selector] = &apos;Week&apos; THEN [Date] &gt;= DATEADD(&apos;week&apos;,-7,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [Date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;//ELSEIF [Dynamic Date Selector] = &apos;Day&apos; THEN [Date] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [Date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;//ELSEIF [Dynamic Date Selector] = &apos;Month + MTD&apos; THEN [Date] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [Date] &lt; TODAY()&#10;//ELSEIF [Dynamic Date Selector] = &apos;Week + WTD&apos; THEN [Date] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [Date] &lt; TODAY()&#10;//END' />
            </column>
