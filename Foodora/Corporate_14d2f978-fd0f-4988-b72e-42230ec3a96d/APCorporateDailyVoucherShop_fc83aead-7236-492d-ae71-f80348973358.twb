    LEFT JOIN fx_rates fx
    ON t.country_code=fx.country_code AND t.date_at_local=fx.fx_rate_date
    WHERE t.is_voucher_shop=1
    AND (t.date_at_local BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH) AND DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)) AND t.date_at_local>>='2021-07-01'
  )
  GROUP BY 1,2,3,4,5,6
),

orders AS (
  SELECT 
    orders.global_entity_id AS country,
    orders.country_code,
    CASE WHEN
    -- to add EUR logic here next time
    ((orders.vendor_id IN ('h6ph') AND orders.global_entity_id='FP_SG')
    OR (orders.vendor_id IN ('h8at','vaal') AND orders.global_entity_id='FP_MY')
    OR (orders.vendor_id IN ('b2gp') AND orders.global_entity_id='FP_PH')
    OR (orders.vendor_id IN ('lnwf') AND orders.global_entity_id='FP_PK')
    OR (orders.vendor_id IN ('p3oi') AND orders.global_entity_id='FP_HK' AND DATE(orders.placed_at_local)>>='2021-04-07')
    OR (orders.vendor_id IN ('wdyj') AND orders.global_entity_id='FP_TH')
    OR (orders.vendor_id IN ('mq6q') AND orders.global_entity_id='FP_BD')
    OR (orders.vendor_id IN ('kwd6') AND orders.global_entity_id='FP_TW')
    ) THEN TRUE ELSE FALSE END AS is_vshop_order,
    /*CASE WHEN vshop_vouchers.is_vshop_voucher=1 THEN TRUE ELSE FALSE END AS is_vshop_voucher_order,*/
    orders.is_corporate,
    DATE(orders.placed_at_local) AS date_local,
    'Online' AS voucher_sale_type,

    COUNT(DISTINCT orders.vendor_id) AS vendor_count,
    COUNT(DISTINCT orders.order_uid) AS order_count,
    CAST(SUM(sb.gmv_eur) AS NUMERIC) AS gmv_eur,
    CAST(SUM(sb.gmv_local) AS NUMERIC) AS gmv_local,
    CAST(SUM(sb.gfv_eur) AS NUMERIC) AS gfv_eur,
    CAST(SUM(sb.gfv_local) AS NUMERIC) AS gfv_local
  
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` orders
  
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` sb
  ON orders.order_id = sb.order_code
  AND orders.global_entity_id = sb.global_entity_id
  
  /*LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders_agg_vouchers` v
  ON orders.uuid=v.uuid

  LEFT JOIN vshop_vendors
  ON orders.pd_vendor_uuid=vshop_vendors.uuid
  
  LEFT JOIN vshop_vouchers
  ON v.pd_voucher_uuid=vshop_vouchers.uuid*/
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON orders.global_entity_id = shared_countries.global_entity_id
  
  WHERE orders.partition_date_local>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH) AND orders.partition_date_local<<=DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
