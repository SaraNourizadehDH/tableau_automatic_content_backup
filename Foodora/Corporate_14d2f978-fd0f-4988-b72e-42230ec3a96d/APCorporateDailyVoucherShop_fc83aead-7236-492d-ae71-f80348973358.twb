                                    'NASICB1@@@@','S&PGP5@@@@','HIGHNOON1@@@@','NOVARTIS1@@@@','NOVARTIS2@@@@','FEROZE@@@@','PEPFF1@@@@','S&PISB5@@@@','HMBCOV@@@@','S&PISB6@@@@',
                                    'BEFP@@@@','REBRAND@@@@','S&PISB8@@@','KTTECH1001','WILSHIRE@@@@','IHIG9@@@@','S&PGLOBAL1@@@','COVANCE@@@@','SITAGEN@@@@','EMPAGENMXR@@@#',
                                    'MOXIGET@@@@','MOXIGET@@@@#','MOXIGET1@@@','BGPK@@@@','BGPK1@@@@','BGPK2@@@@','BGPK3@@@@','DIABETRON@@@@','LEFLOX@@@@','KTTECH1001',
                                    'KTTECH1003','KTTECH1005','XAVUR@@@@','VALIANT@@@@','SCB@@@@','S&PGBL1@@','NOVAPRESSIN@@','INTEGRITI1@@@','COBOL3@@','BU@@@@',
                                    'MERAFUTURE@','AMALACAD@@','MK1@@@@','MK2@@@@','XAV@@@','NOS@@@@','RIFAXA@@@')    
    AND global_entity_id='FP_PK')
   )
),

fx AS (
  SELECT * FROM
  (
    SELECT currency_code, fx, fx_rate_date,
    CASE
    WHEN currency_code='BDT' THEN 'BD'
    WHEN currency_code='BGN' THEN 'BG'
    WHEN currency_code='HKD' THEN 'HK'
    WHEN currency_code='JPY' THEN 'JP'
    WHEN currency_code='MYR' THEN 'MY'
    WHEN currency_code='PHP' THEN 'PH'
    WHEN currency_code='PKR' THEN 'PK'
    WHEN currency_code='THB' THEN 'TH'
    WHEN currency_code='SGD' THEN 'SG'
    WHEN currency_code='TWD' THEN 'TW'
    WHEN currency_code='HUF' THEN 'HU'
    WHEN currency_code='EUR' THEN 'AT'
    WHEN currency_code='CZK' THEN 'CZ'
    WHEN currency_code = 'SEK' THEN 'SE'
    WHEN currency_code = 'NOK' THEN 'NO'
    END AS country_code
    FROM
    (SELECT currency_code, fx_rate_eur AS fx, fx_rate_date, ROW_NUMBER() OVER (PARTITION BY currency_code ORDER BY currency_code, fx_rate_date DESC) AS RANK
    FROM `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates`
    WHERE DATE(fx_rate_date)>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 2 MONTH), MONTH)
    )
    WHERE RANK=1
  )
  WHERE country_code IS NOT NULL
),

orders AS (
  SELECT
    v.global_entity_id,
    /*orders.country_name,*/
    v.pd_voucher_uuid AS voucher_id,
    MAX(v.value_eur) AS voucher_value_eur,
    MAX(v.value_local) AS voucher_value_local,
    -- MAX(orders.minimum_delivery_value_local) AS minimum_order_value_local,
    COUNT(DISTINCT orders.order_uid) AS order_count,
    SUM(sb.gmv_eur) AS gmv_eur,
    SUM(sb.gmv_local) AS gmv_local,
    SUM(sb.gfv_eur) AS gfv_eur,
    SUM(sb.gfv_local) AS gfv_local,
    SUM(v.value_eur) AS voucher_value_redeemed_eur,
    SUM(v.value_local) AS voucher_value_redeemed_local
  
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` orders
  
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` sb
  ON orders.order_id = sb.order_code
  AND orders.global_entity_id = sb.global_entity_id
  
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` AS v
    ON orders.order_id = v.order_code
    AND orders.global_entity_id = v.global_entity_id

  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON orders.global_entity_id = shared_countries.global_entity_id
  
  WHERE orders.partition_date_local>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH) AND DATE(orders.placed_at_local)<<=DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
  AND sb.created_date_utc>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH)
  AND v.created_date_utc>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH)
  AND ((shared_countries.company_name = "Foodpanda" AND shared_countries.region = "Asia")
      OR (shared_countries.region = "Europe" AND shared_countries.name NOT IN ("Finland", "Germany")))
  AND orders.order_status != "PENDING_ORDER_FAILED"
  AND orders.is_successful
  AND v.pd_voucher_uuid IS NOT NULL
  AND v.is_voucher_used
  AND v.pd_voucher_uuid IN (SELECT voucher_id FROM vshop_vouchers)
  GROUP BY 1,2
)

SELECT
    vshop_vouchers.*,
    SPLIT(vshop_vouchers.voucher_id,'_')[SAFE_OFFSET(0)] AS final_voucher_id,
    
    CASE WHEN vshop_vouchers.voucher_value_local_temp<<orders.voucher_value_local THEN orders.voucher_value_eur
    ELSE vshop_vouchers.voucher_value_local_temp/fx.fx END AS voucher_value_eur,
    -- CASE WHEN vshop_vouchers.minimum_order_value_local_temp<<orders.minimum_order_value_local THEN orders.minimum_order_value_local/fx.fx
    -- ELSE vshop_vouchers.minimum_order_value_local_temp/fx.fx END AS minimum_order_value_eur,
    
    CASE WHEN vshop_vouchers.voucher_value_local_temp<<orders.voucher_value_local THEN orders.voucher_value_local
    ELSE vshop_vouchers.voucher_value_local_temp END AS voucher_value_local,
    -- CASE WHEN vshop_vouchers.minimum_order_value_local_temp<<orders.minimum_order_value_local THEN orders.minimum_order_value_local
    -- ELSE vshop_vouchers.minimum_order_value_local_temp END AS minimum_order_value_local,
    
    IFNULL(orders.order_count,0) AS order_count,
    IFNULL(orders.gmv_eur,0) AS gmv_eur,
    IFNULL(orders.gmv_local,0) AS gmv_local,
    IFNULL(orders.gfv_eur,0) AS gfv_eur,
    IFNULL(orders.gfv_local,0) AS gfv_local,
    IFNULL(orders.voucher_value_redeemed_eur,0) AS voucher_value_redeemed_eur,
    IFNULL(orders.voucher_value_redeemed_local,0) AS voucher_value_redeemed_local,
    fx.fx
  FROM vshop_vouchers
  LEFT JOIN orders ON vshop_vouchers.voucher_id=orders.voucher_id 
  LEFT JOIN fx ON vshop_vouchers.country_code=fx.country_code
  ORDER BY vshop_vouchers.country_code, vshop_vouchers.start_date_local]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
