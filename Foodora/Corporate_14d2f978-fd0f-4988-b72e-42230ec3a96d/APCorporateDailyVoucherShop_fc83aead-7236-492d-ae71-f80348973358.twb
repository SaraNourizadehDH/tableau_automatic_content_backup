      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_EF28925666EF4291BD0FA71F78725530'>
            <properties context=''>
              <relation connection='bigquery.16r2l901qv03fp1dqohwr1oorahn' name='Custom SQL Query' type='text'><![CDATA[-- updated 18 Apr 2023 for pd_vendors deprecation

WITH vshop_vendors AS (
  SELECT
    DISTINCT
    global_entity_id,
    vendor_code,
    vendor_name,
    created_at_local,
    1 AS is_voucher_shop_order
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` pd_vendors
  WHERE
    /*is_active AND*/
    ((vendor_code IN ('h6ph') AND global_entity_id='FP_SG')
    OR (vendor_code IN ('h8at','vaal') AND global_entity_id='FP_MY')
    OR (vendor_code IN ('b2gp') AND global_entity_id='FP_PH')
    OR (vendor_code IN ('lnwf') AND global_entity_id='FP_PK')
    OR (vendor_code IN ('p3oi') AND global_entity_id='FP_HK')
    OR (vendor_code IN ('wdyj') AND global_entity_id='FP_TH')
    OR (vendor_code IN ('mq6q') AND global_entity_id='FP_BD')
    -- to add in EU vshop vendors later on
    )
),

pd_orders_agg_discounts AS (
  SELECT
    global_entity_id,
    order_code,
    discount_type,
    discount_title,
    discount_amount_eur,
    discount_amount_local,
    pd_discount_uuid,
    is_discount_used,
    attributions_foodpanda_ratio
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_discounts`
  WHERE global_entity_id IN ("FP_BD", "FP_HK", "FP_KH", "FP_LA", "FP_MY", "FP_PH", "FP_PK", "FP_SG", "FP_TH", "FP_TW")
    AND created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 2 YEAR), YEAR)

  UNION ALL

  SELECT
    global_entity_id,
    order_code,
    discount.discount_type,
    discount.discount_title,
    discount.discount_amount_eur,
    discount.discount_amount_local,
    pd_discount_uuid,
    is_discount_used,
    discount.attributions_foodpanda_ratio 
  FROM `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_discounts`
  WHERE global_entity_id IN ("MJM_AT", "OP_SE", "FO_NO", "DJ_CZ", "NP_HU")
    AND created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 2 YEAR), YEAR)
),

cancelled_orders AS (
  SELECT *
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_cancelled_orders`
  WHERE created_date_local>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH)
)

SELECT
    orders.global_entity_id AS country,
    orders.country_code,
    CASE WHEN (vshop_vendors.is_voucher_shop_order=1 AND orders.global_entity_id='FP_HK' AND DATE(orders.placed_at_local)>>='2021-04-07')
    OR (vshop_vendors.is_voucher_shop_order=1 AND orders.global_entity_id NOT IN ('FP_HK')) THEN TRUE ELSE FALSE END AS is_vshop_order,
    orders.is_corporate,
    orders.is_successful AS is_valid_order,
    orders.is_failed AS is_failed_order,
    orders.is_preorder,
    orders.delivery_provider AS expedition_type,
    orders.order_status AS status_name,
    cancelled_orders.pandora_decline_reason_title AS decline_reasons_title,
    DATE(orders.placed_at_local) AS date_local,
    
    COUNT(DISTINCT orders.vendor_id) AS vendor_count,
    COUNT(DISTINCT orders.order_uid) AS order_count,
    COUNT(DISTINCT IF(orders.is_successful IS TRUE, orders.order_uid, NULL)) valid_order_count,
    COUNT(DISTINCT IF(orders.order_status = "CANCELLED", orders.order_uid, NULL)) cancelled_order_count,
    COUNT(DISTINCT IF(cancelled_orders.is_cancelled_by_vendor, orders.order_uid, NULL)) vendor_cancelled_order_count,
    COUNT(DISTINCT IF(cancelled_orders.is_cancelled_by_customer, orders.order_uid, NULL)) cust_cancelled_order_count,
    
    CAST(SUM(sb.gmv_eur) AS NUMERIC) AS gmv_eur,
    CAST(SUM(sb.gmv_local) AS NUMERIC) AS gmv_local,
    CAST(SUM(sb.gfv_eur) AS NUMERIC) AS gfv_eur,
    CAST(SUM(sb.gfv_local) AS NUMERIC) AS gfv_local,
    CAST(SUM(d.discount_amount_eur) AS NUMERIC) AS discount_value_eur,
    CAST(SUM(d.discount_amount_local) AS NUMERIC) AS discount_value_local
    
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` orders

  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON orders.global_entity_id = shared_countries.global_entity_id
        
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` sb
  ON orders.order_id = sb.order_code
  AND orders.global_entity_id = sb.global_entity_id
 
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_cp_orders` cp
  ON orders.order_id = cp.order_code
  AND orders.global_entity_id = cp.global_entity_id
        
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.preprocessing__core_vendor_business_types` bt
  ON orders.vendor_id = bt.vendor_code
  AND orders.global_entity_id = bt.global_entity_id
  
  LEFT JOIN pd_orders_agg_discounts AS d
  ON orders.order_id = d.order_code
  AND orders.global_entity_id = d.global_entity_id

  LEFT JOIN cancelled_orders
    ON orders.order_uid = cancelled_orders.order_uid
  
  RIGHT JOIN vshop_vendors
  ON orders.vendor_id = vshop_vendors.vendor_code
  AND orders.global_entity_id = vshop_vendors.global_entity_id

  
  WHERE orders.partition_date_local >>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH) AND orders.partition_date_local<<=DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
  AND sb.created_date_utc>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH)
  AND cp.created_date_utc>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH)
  AND ((shared_countries.company_name = "Foodpanda" AND shared_countries.region = "Asia")
      OR (shared_countries.region = "Europe" AND shared_countries.name NOT IN ("Finland", "Germany")))
  AND orders.order_status != "PENDING_ORDER_FAILED"
  AND orders.is_corporate
  GROUP BY ALL]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='AP_Corp_Daily_Vshop_Vouchers_All' inline='true' name='federated.1d19xlm1l74ps51exj96x0w5rap7' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1hxa1t0119b57n18qnzaj01n3hz0'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' REDIRECT_URI='urn:ietf:wg:oauth:2.0:oob' SCOPE='email profile https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloudplatformprojects.readonly' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_curated' server='' server-oauth='' username='joshua.yeo@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1hxa1t0119b57n18qnzaj01n3hz0' name='Custom SQL Query' type='text'><![CDATA[WITH vshop_vouchers AS (
  SELECT
    DISTINCT
    uuid AS voucher_uuid,
    id AS voucher_id,
    SPLIT(global_entity_id,'_')[SAFE_OFFSET(1)] AS country_code,
    voucher_code,
    customer_code,
    quantity,
    value AS voucher_value_local_mmt,
    minimum_order_value_local AS minimum_order_value_local_mmt,
    created_date_utc,
    start_date_local,
    stop_date_local,
    CASE WHEN stop_date_local<<CURRENT_DATE THEN TRUE ELSE FALSE END AS is_expired,
    type AS voucher_type
  
  FROM `fulfillment-dwh-production.pandata_curated.offers_vouchers`
  WHERE start_date_local>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH) /*AND is_deleted IS NOT TRUE*/
  AND global_entity_id IN ("FP_BD", "FP_HK", "FP_KH", "FP_LA", "FP_MY", "FP_PH", "FP_PK", "FP_SG", "FP_TH", "FP_TW",  "MJM_AT", "OP_SE", "FO_NO", "DJ_CZ", "NP_HU")
  AND channel='channel_corporate'
  AND created_date_utc>>="2020-01-01"
  AND is_deleted IS NOT TRUE
),

fx AS (
  SELECT * FROM
  (
    SELECT currency_code, fx, fx_rate_date,
    CASE
    WHEN currency_code='BDT' THEN 'BD'
    WHEN currency_code='BGN' THEN 'BG'
    WHEN currency_code='HKD' THEN 'HK'
    WHEN currency_code='JPY' THEN 'JP'
    WHEN currency_code='MYR' THEN 'MY'
    WHEN currency_code='PHP' THEN 'PH'
    WHEN currency_code='PKR' THEN 'PK'
    WHEN currency_code='THB' THEN 'TH'
    WHEN currency_code='SGD' THEN 'SG'
    WHEN currency_code='TWD' THEN 'TW'
    WHEN currency_code='HUF' THEN 'HU'
    WHEN currency_code='EUR' THEN 'AT'
    WHEN currency_code='CZK' THEN 'CZ'
    WHEN currency_code = 'SEK' THEN 'SE'
    WHEN currency_code = 'NOK' THEN 'NO'
    END AS country_code
    FROM
    (SELECT currency_code, fx_rate_eur AS fx, fx_rate_date, ROW_NUMBER() OVER (PARTITION BY currency_code ORDER BY currency_code, fx_rate_date DESC) AS RANK
    FROM `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates`
    WHERE DATE(fx_rate_date)>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 2 MONTH), MONTH)
    )
    WHERE RANK=1
  )
  WHERE country_code IS NOT NULL
),

orders AS (
  SELECT
    v.global_entity_id,
    v.pd_voucher_uuid AS voucher_uuid,
    /*CASE WHEN orders.is_corporate THEN TRUE ELSE FALSE END AS is_corporate,*/
    /*CASE WHEN LOWER(orders.source) like ('%corporate%') THEN TRUE ELSE FALSE END AS is_corporate,*/
    MAX(v.value_eur) AS voucher_value_eur,
    MAX(v.value_local) AS voucher_value_local,
    -- MAX(orders.minimum_delivery_value_local) AS minimum_order_value_local,
    
    COUNT(DISTINCT orders.order_uid) AS order_count,
    SUM(sb.gmv_eur) AS gmv_eur,
    SUM(sb.gmv_local) AS gmv_local,
    SUM(sb.gfv_eur) AS gfv_eur,
    SUM(sb.gfv_local) AS gfv_local,
    SUM(v.value_eur) AS voucher_value_redeemed_eur,
    SUM(v.value_local) AS voucher_value_redeemed_local,
    
    COUNT(DISTINCT IF(orders.is_corporate, orders.order_uid, NULL)) AS order_corp_count,
    SUM(IF(orders.is_corporate, sb.gmv_eur, 0)) AS gmv_corp_eur,
    SUM(IF(orders.is_corporate, sb.gmv_local, 0)) AS gmv_corp_local,
    SUM(IF(orders.is_corporate, sb.gfv_eur, 0)) AS gfv_corp_eur,
    SUM(IF(orders.is_corporate, sb.gfv_local, 0)) AS gfv_corp_local,
    SUM(IF(orders.is_corporate, v.value_eur, 0)) AS voucher_value_redeemed_corp_eur,
    SUM(IF(orders.is_corporate, v.value_local, 0)) AS voucher_value_redeemed_corp_local,
    
    COUNT(DISTINCT IF(orders.is_corporate IS FALSE, orders.order_uid, NULL)) AS order_non_corp_count,
    SUM(IF(orders.is_corporate IS FALSE, sb.gmv_eur, 0)) AS gmv_non_corp_eur,
    SUM(IF(orders.is_corporate IS FALSE, sb.gmv_local, 0)) AS gmv_non_corp_local,
    SUM(IF(orders.is_corporate IS FALSE, sb.gfv_eur, 0)) AS gfv_non_corp_eur,
    SUM(IF(orders.is_corporate IS FALSE, sb.gfv_local, 0)) AS gfv_non_corp_local,
    SUM(IF(orders.is_corporate IS FALSE, v.value_eur, 0)) AS voucher_value_redeemed_non_corp_eur,
    SUM(IF(orders.is_corporate IS FALSE, v.value_local, 0)) AS voucher_value_redeemed_non_corp_local,
     
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` orders
  
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` sb
  ON orders.order_id = sb.order_code
  AND orders.global_entity_id = sb.global_entity_id
  
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` AS v
    ON orders.order_id = v.order_code
    AND orders.global_entity_id = v.global_entity_id
  
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON orders.global_entity_id = shared_countries.global_entity_id
  
  WHERE orders.partition_date_local>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH) AND DATE(orders.placed_at_local)<<=DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
  AND sb.created_date_utc>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH)
  AND v.created_date_utc>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH)
  AND ((shared_countries.company_name = "Foodpanda" AND shared_countries.region = "Asia")
      OR (shared_countries.region = "Europe" AND shared_countries.name NOT IN ("Finland", "Germany")))
  AND orders.order_status != "PENDING_ORDER_FAILED"
  AND orders.is_successful
  AND v.pd_voucher_uuid IS NOT NULL
  AND v.is_voucher_used
  AND v.pd_voucher_uuid IN (SELECT voucher_uuid FROM vshop_vouchers)
  GROUP BY 1,2
)

SELECT
    v.voucher_uuid,
    v.voucher_id,
    v.country_code,
    v.customer_code,
    v.voucher_code,
    v.quantity,
    v.created_date_utc,
    v.start_date_local,
    v.stop_date_local,
    v.is_expired,
    v.voucher_type,
    
    CASE WHEN v.voucher_value_local_mmt<<orders.voucher_value_local THEN orders.voucher_value_eur
    ELSE v.voucher_value_local_mmt/fx.fx END AS voucher_value_eur,
    -- CASE WHEN v.minimum_order_value_local_mmt<<orders.minimum_order_value_local THEN orders.minimum_order_value_local/fx.fx
    -- ELSE v.minimum_order_value_local_mmt/fx.fx END AS minimum_order_value_eur,
    
    CASE WHEN v.voucher_value_local_mmt<<orders.voucher_value_local THEN orders.voucher_value_local
    ELSE v.voucher_value_local_mmt END AS voucher_value_local,
    -- CASE WHEN v.minimum_order_value_local_mmt<<orders.minimum_order_value_local THEN orders.minimum_order_value_local
    -- ELSE v.minimum_order_value_local_mmt END AS minimum_order_value_local,
    
    IFNULL(orders.order_count,0) AS order_count,
    IFNULL(orders.gmv_eur,0) AS gmv_eur,
    IFNULL(orders.gmv_local,0) AS gmv_local,
    IFNULL(orders.gfv_eur,0) AS gfv_eur,
    IFNULL(orders.gfv_local,0) AS gfv_local,
    IFNULL(orders.voucher_value_redeemed_eur,0) AS voucher_value_redeemed_eur,
    IFNULL(orders.voucher_value_redeemed_local,0) AS voucher_value_redeemed_local,

    IFNULL(orders.order_corp_count,0) AS order_corp_count,
    IFNULL(orders.gmv_corp_eur,0) AS gmv_corp_eur,
    IFNULL(orders.gmv_corp_local,0) AS gmv_corp_local,
    IFNULL(orders.gfv_corp_eur,0) AS gfv_corp_eur,
    IFNULL(orders.gfv_corp_local,0) AS gfv_corp_local,
    IFNULL(orders.voucher_value_redeemed_corp_eur,0) AS voucher_value_redeemed_corp_eur,
    IFNULL(orders.voucher_value_redeemed_corp_local,0) AS voucher_value_redeemed_corp_local,
    
    IFNULL(orders.order_non_corp_count,0) AS order_non_corp_count,
    IFNULL(orders.gmv_non_corp_eur,0) AS gmv_non_corp_eur,
    IFNULL(orders.gmv_non_corp_local,0) AS gmv_non_corp_local,
    IFNULL(orders.gfv_non_corp_eur,0) AS gfv_non_corp_eur,
    IFNULL(orders.gfv_non_corp_local,0) AS gfv_non_corp_local,
    IFNULL(orders.voucher_value_redeemed_non_corp_eur,0) AS voucher_value_redeemed_non_corp_eur,
    IFNULL(orders.voucher_value_redeemed_non_corp_local,0) AS voucher_value_redeemed_non_corp_local,   
    fx.fx
  
  FROM vshop_vouchers v  
  LEFT JOIN orders ON v.voucher_uuid=orders.voucher_uuid
  LEFT JOIN fx ON v.country_code=fx.country_code
  ORDER BY v.country_code ASC, v.start_date_local DESC]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1hxa1t0119b57n18qnzaj01n3hz0' name='Custom SQL Query' type='text'><![CDATA[WITH vshop_vouchers AS (
  SELECT
    DISTINCT
    uuid AS voucher_uuid,
    id AS voucher_id,
    SPLIT(global_entity_id,'_')[SAFE_OFFSET(1)] AS country_code,
    voucher_code,
    customer_code,
    quantity,
    value AS voucher_value_local_mmt,
    minimum_order_value_local AS minimum_order_value_local_mmt,
    created_date_utc,
    start_date_local,
    stop_date_local,
    CASE WHEN stop_date_local<<CURRENT_DATE THEN TRUE ELSE FALSE END AS is_expired,
    type AS voucher_type
  
  FROM `fulfillment-dwh-production.pandata_curated.offers_vouchers`
  WHERE start_date_local>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH) /*AND is_deleted IS NOT TRUE*/
  AND global_entity_id IN ("FP_BD", "FP_HK", "FP_KH", "FP_LA", "FP_MY", "FP_PH", "FP_PK", "FP_SG", "FP_TH", "FP_TW",  "MJM_AT", "OP_SE", "FO_NO", "DJ_CZ", "NP_HU")
  AND channel='channel_corporate'
  AND created_date_utc>>="2020-01-01"
  AND is_deleted IS NOT TRUE
),

fx AS (
  SELECT * FROM
  (
    SELECT currency_code, fx, fx_rate_date,
    CASE
    WHEN currency_code='BDT' THEN 'BD'
    WHEN currency_code='BGN' THEN 'BG'
    WHEN currency_code='HKD' THEN 'HK'
    WHEN currency_code='JPY' THEN 'JP'
    WHEN currency_code='MYR' THEN 'MY'
    WHEN currency_code='PHP' THEN 'PH'
    WHEN currency_code='PKR' THEN 'PK'
    WHEN currency_code='THB' THEN 'TH'
    WHEN currency_code='SGD' THEN 'SG'
    WHEN currency_code='TWD' THEN 'TW'
    WHEN currency_code='HUF' THEN 'HU'
    WHEN currency_code='EUR' THEN 'AT'
    WHEN currency_code='CZK' THEN 'CZ'
    WHEN currency_code = 'SEK' THEN 'SE'
    WHEN currency_code = 'NOK' THEN 'NO'
    END AS country_code
    FROM
    (SELECT currency_code, fx_rate_eur AS fx, fx_rate_date, ROW_NUMBER() OVER (PARTITION BY currency_code ORDER BY currency_code, fx_rate_date DESC) AS RANK
    FROM `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates`
    WHERE DATE(fx_rate_date)>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 2 MONTH), MONTH)
    )
    WHERE RANK=1
  )
  WHERE country_code IS NOT NULL
),

orders AS (
  SELECT
    v.global_entity_id,
    v.pd_voucher_uuid AS voucher_uuid,
    /*CASE WHEN orders.is_corporate THEN TRUE ELSE FALSE END AS is_corporate,*/
    /*CASE WHEN LOWER(orders.source) like ('%corporate%') THEN TRUE ELSE FALSE END AS is_corporate,*/
    MAX(v.value_eur) AS voucher_value_eur,
    MAX(v.value_local) AS voucher_value_local,
    -- MAX(orders.minimum_delivery_value_local) AS minimum_order_value_local,
    
    COUNT(DISTINCT orders.order_uid) AS order_count,
    SUM(sb.gmv_eur) AS gmv_eur,
    SUM(sb.gmv_local) AS gmv_local,
    SUM(sb.gfv_eur) AS gfv_eur,
    SUM(sb.gfv_local) AS gfv_local,
    SUM(v.value_eur) AS voucher_value_redeemed_eur,
    SUM(v.value_local) AS voucher_value_redeemed_local,
    
    COUNT(DISTINCT IF(orders.is_corporate, orders.order_uid, NULL)) AS order_corp_count,
    SUM(IF(orders.is_corporate, sb.gmv_eur, 0)) AS gmv_corp_eur,
    SUM(IF(orders.is_corporate, sb.gmv_local, 0)) AS gmv_corp_local,
    SUM(IF(orders.is_corporate, sb.gfv_eur, 0)) AS gfv_corp_eur,
    SUM(IF(orders.is_corporate, sb.gfv_local, 0)) AS gfv_corp_local,
    SUM(IF(orders.is_corporate, v.value_eur, 0)) AS voucher_value_redeemed_corp_eur,
    SUM(IF(orders.is_corporate, v.value_local, 0)) AS voucher_value_redeemed_corp_local,
    
    COUNT(DISTINCT IF(orders.is_corporate IS FALSE, orders.order_uid, NULL)) AS order_non_corp_count,
    SUM(IF(orders.is_corporate IS FALSE, sb.gmv_eur, 0)) AS gmv_non_corp_eur,
    SUM(IF(orders.is_corporate IS FALSE, sb.gmv_local, 0)) AS gmv_non_corp_local,
    SUM(IF(orders.is_corporate IS FALSE, sb.gfv_eur, 0)) AS gfv_non_corp_eur,
    SUM(IF(orders.is_corporate IS FALSE, sb.gfv_local, 0)) AS gfv_non_corp_local,
    SUM(IF(orders.is_corporate IS FALSE, v.value_eur, 0)) AS voucher_value_redeemed_non_corp_eur,
    SUM(IF(orders.is_corporate IS FALSE, v.value_local, 0)) AS voucher_value_redeemed_non_corp_local,
     
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` orders
  
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` sb
  ON orders.order_id = sb.order_code
  AND orders.global_entity_id = sb.global_entity_id
  
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` AS v
    ON orders.order_id = v.order_code
    AND orders.global_entity_id = v.global_entity_id
  
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON orders.global_entity_id = shared_countries.global_entity_id
  
  WHERE orders.partition_date_local>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH) AND DATE(orders.placed_at_local)<<=DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
  AND sb.created_date_utc>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH)
  AND v.created_date_utc>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH)
  AND ((shared_countries.company_name = "Foodpanda" AND shared_countries.region = "Asia")
      OR (shared_countries.region = "Europe" AND shared_countries.name NOT IN ("Finland", "Germany")))
  AND orders.order_status != "PENDING_ORDER_FAILED"
  AND orders.is_successful
  AND v.pd_voucher_uuid IS NOT NULL
  AND v.is_voucher_used
  AND v.pd_voucher_uuid IN (SELECT voucher_uuid FROM vshop_vouchers)
  GROUP BY 1,2
)

SELECT
    v.voucher_uuid,
    v.voucher_id,
    v.country_code,
    v.customer_code,
    v.voucher_code,
    v.quantity,
    v.created_date_utc,
    v.start_date_local,
    v.stop_date_local,
    v.is_expired,
    v.voucher_type,
    
    CASE WHEN v.voucher_value_local_mmt<<orders.voucher_value_local THEN orders.voucher_value_eur
    ELSE v.voucher_value_local_mmt/fx.fx END AS voucher_value_eur,
    -- CASE WHEN v.minimum_order_value_local_mmt<<orders.minimum_order_value_local THEN orders.minimum_order_value_local/fx.fx
    -- ELSE v.minimum_order_value_local_mmt/fx.fx END AS minimum_order_value_eur,
    
    CASE WHEN v.voucher_value_local_mmt<<orders.voucher_value_local THEN orders.voucher_value_local
    ELSE v.voucher_value_local_mmt END AS voucher_value_local,
    -- CASE WHEN v.minimum_order_value_local_mmt<<orders.minimum_order_value_local THEN orders.minimum_order_value_local
    -- ELSE v.minimum_order_value_local_mmt END AS minimum_order_value_local,
    
    IFNULL(orders.order_count,0) AS order_count,
    IFNULL(orders.gmv_eur,0) AS gmv_eur,
    IFNULL(orders.gmv_local,0) AS gmv_local,
    IFNULL(orders.gfv_eur,0) AS gfv_eur,
    IFNULL(orders.gfv_local,0) AS gfv_local,
    IFNULL(orders.voucher_value_redeemed_eur,0) AS voucher_value_redeemed_eur,
    IFNULL(orders.voucher_value_redeemed_local,0) AS voucher_value_redeemed_local,

    IFNULL(orders.order_corp_count,0) AS order_corp_count,
    IFNULL(orders.gmv_corp_eur,0) AS gmv_corp_eur,
    IFNULL(orders.gmv_corp_local,0) AS gmv_corp_local,
    IFNULL(orders.gfv_corp_eur,0) AS gfv_corp_eur,
    IFNULL(orders.gfv_corp_local,0) AS gfv_corp_local,
    IFNULL(orders.voucher_value_redeemed_corp_eur,0) AS voucher_value_redeemed_corp_eur,
    IFNULL(orders.voucher_value_redeemed_corp_local,0) AS voucher_value_redeemed_corp_local,
    
    IFNULL(orders.order_non_corp_count,0) AS order_non_corp_count,
    IFNULL(orders.gmv_non_corp_eur,0) AS gmv_non_corp_eur,
    IFNULL(orders.gmv_non_corp_local,0) AS gmv_non_corp_local,
    IFNULL(orders.gfv_non_corp_eur,0) AS gfv_non_corp_eur,
    IFNULL(orders.gfv_non_corp_local,0) AS gfv_non_corp_local,
    IFNULL(orders.voucher_value_redeemed_non_corp_eur,0) AS voucher_value_redeemed_non_corp_eur,
    IFNULL(orders.voucher_value_redeemed_non_corp_local,0) AS voucher_value_redeemed_non_corp_local,   
    fx.fx
  
  FROM vshop_vouchers v  
  LEFT JOIN orders ON v.voucher_uuid=orders.voucher_uuid
  LEFT JOIN fx ON v.country_code=fx.country_code
  ORDER BY v.country_code ASC, v.start_date_local DESC]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
