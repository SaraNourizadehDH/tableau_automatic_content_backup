    <worksheet name='VShop Redemptions Details'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Voucher Shop Details</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='AP_Corp_Daily_Vshop_Vouchers_V2' name='federated.03ym05m107m7kx1987eog0h03b24' />
            <datasource caption='AP_Corp_Daily_Vshop_Vouchers_All' name='federated.1d19xlm1l74ps51exj96x0w5rap7' />
          </datasources>
          <datasource-dependencies datasource='federated.03ym05m107m7kx1987eog0h03b24'>
            <column caption='Expired Voucher' datatype='string' name='[Calculation_1841127842197938176]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF([stop_date_local]&lt;TODAY()) THEN &apos;YES&apos; ELSE &apos;NO&apos; END' />
            </column>
            <column caption='Available Vouchers' datatype='integer' name='[Calculation_1841127842201907201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([quantity])-SUM([order_count])-[Calculation_2300776480510242816]' />
            </column>
            <column caption='Total Voucher Value Local' datatype='real' name='[Calculation_1841127842203688962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[quantity]*[voucher_value_local]' />
            </column>
            <column caption='Available Voucher Value Local' datatype='real' name='[Calculation_1841127842203992067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1841127842203688962])-SUM([voucher_value_redeemed_local])-[Calculation_2300776480529006594]' />
            </column>
            <column caption='Total Voucher Value EUR' datatype='real' name='[Calculation_1841127842225045512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[quantity]*[voucher_value_eur]' />
            </column>
            <column caption='Expired Unredeemed Vouchers' datatype='integer' name='[Calculation_2300776480510242816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_expired]=TRUE THEN [quantity] ELSE 0 END) - SUM(IF [is_expired]=TRUE THEN [order_count] ELSE 0 END)' />
            </column>
            <column caption='Expired Unredeemed Voucher Value Local' datatype='real' name='[Calculation_2300776480529006594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_expired]=TRUE THEN [Calculation_1841127842203688962] ELSE 0 END) - SUM(IF [is_expired]=TRUE THEN [voucher_value_redeemed_local] ELSE 0 END)' />
            </column>
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Voucher Code' datatype='string' name='[customer_code]' role='dimension' type='nominal' />
            <column caption='Voucher ID ' datatype='string' name='[final_voucher_id]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_expired]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1841127842197938176]' derivation='None' name='[none:Calculation_1841127842197938176:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_code]' derivation='None' name='[none:customer_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[final_voucher_id]' derivation='None' name='[none:final_voucher_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[start_date_local]' derivation='None' name='[none:start_date_local:ok]' pivot='key' type='ordinal' />
