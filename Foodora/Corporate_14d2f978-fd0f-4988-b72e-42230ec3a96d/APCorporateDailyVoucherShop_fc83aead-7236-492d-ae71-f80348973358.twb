                       'JANDYAN2@@@@','JANDYAN@@@@','ONEVIVANT@@@@','GOE0@@@@','AVGSUM21D2@@@@','AVGSUM21D1@@@@','FEBAJ21@@@','EXMGEN2020@@@@','SPGKIC@@@','SPGKRI@@@',
                       'Q6BT1@@@','3BAU@@@','SU5H@@@','JANDYAN1@@@','JANDYAN3@@@','N8A0A@@@','N8A0B@@@','N8A0C@@@','ERF9@@@','CEBA@@@@@@@@@@',
                       'LZDPARTY3@@@','Z4R7@@@@@@@@@@','SPG202@@@@@@@@@@','SPGFIN@@@@@@@@@@','FPLEE@@@@@@@@@@','FPLEE1@@@@@@@@@@','3MHR@@@@@@@@@@','3MHR1@@@@@@@@@@','DVLOVES@@@@@@@@@@','LMKCOFF@@@@@@@@@@',
                       'FN3Q@@@@@@@@@@','FN3Q#@@@@@@@@@@','H0OO@@@@@@@@@@','3WST@@@@@@@@@@','Z2II@@@@@@@@@@','8CYP@@@@@@@@@@','LVUH@@@@@@@@@@','LVUH1@@@@@@@@@@','PSBLITZ@@@@@@@@@@','PSBLITZ1@@@@@@@@@@',
                       '86U7@@@@@@@@@@','DM100@@@@@@@@@@','DM200@@@@@@@@@@','DM500@@@@@@@@@@','3R0S@@@@@@@@@@','IQIN@@@@@@@@@@','TZF6@@@@@@@@@@','TO6V@@@@@@@@@@','MPII100@@@@@@@@@@','MPII200@@@@@@@@@@',
                       'VENB1@@@@@@@@@@','VENB2@@@@@@@@@@','373B@@@@@@@@@@','VETN@@@@@@@@@@','QW8O@@@@@@@@@@','26JS@@@@@@@@@@','VUT8@@@@@@@@@@','MREG@@@@@@@@@@','PZH3@@@@@@@@@@','ADAW@@@@@@@@@@',
                       '9PYH@@@@@@@@@@','O2HC@@@@@@@@@@','O2HC2@@@@@@@@@@','YPWE@@@@@@@@@@','METV@@@@@@@@@@','METV1@@@@@@@@@@','BN9J@@@@@@@@@@','BN9J1@@@@@@@@@@','BN9J2@@@@@@@@@@','DO14@@@@@@@@@@',
                       '993Q@@@@@@@@@@','993Q1@@@@@@@@@@','SP2V@@@@@@@@@@','JDER@@@@@@@@@@','Q8WD@@@@@@@@@@','FBMM@@@@@@@@@@','YWGY@@@@@@@@@@','6XUQ@@@@@@@@@@','6XUG1@@@@@@@@@@','6XUG2@@@@@@@@@@',
                       
                       'K4U5@@@@@@@@@@','K4U5A@@@@@@@@@@','8K7P@@@@@@@@@@','A2KO@@@@@@@@@@','A2KO1@@@@@@@@@@','YIZV@@@@@@@@@@','LPKK@@@@@@@@@@','AEHN@@@@@@@@@@','AG9F@@@@@@@@@@','ZI6D@@@@@@@@@@',
                       '6ZD3@@@@@@@@@@','YSRR@@@@@@@@@@','15FB@@@@@@@@@@','15FB1@@@@@@@@@@','15FB2@@@@@@@@@@','15FB3@@@@@@@@@@','4EOD@@@@@@@@@@','F4M8@@@@@@@@@@','F4M8@@@@@@@@@@','ED9T@@@@@@@@@@',
                       'H3I7@@@@@@@@@@','7Z14@@@@@@@@@@','0S6O@@@@@@@@@@','3JHO@@@@@@@@@@','XBNB@@@@@@@@@@','ILRL@@@@@@@@@@','TH28@@@@@@@@@@','TH28A@@@@@@@@@@','VHER@@@@@@@@@@','VHER1@@@@@@@@@@',
                       'A6I8@@@@@@@@@@','YA2V@@@@@@@@@@','YA2V1@@@@@@@@@@','YA2V2@@@@@@@@@@','554Y@@@@@@@@@@','ZSPX@@@@@@@@@@','ZSPX1@@@@@@@@@@','N556@@@@@@@@@@','H4YZ@@@@@@@@@@','H4YZ1@@@@@@@@@@')               
    AND global_entity_id='FP_PH')
    
    OR   
    (UPPER(voucher_code) IN ('ABM2020@@@@','ABM2020@@@@','CFCAM@@@@','CFC@@@@','DIGITALGURU@@@@','SALESFLO@@@@','S&PISB@@@@','HPASS@@@@','TPLI@@@@','HN@@@@',
                                    'PEPFF@@@@','IHIG@@@@','GDG@@@@','PEPFF1@@@@','S&PISB3@@@@','S&PISB4@@@@','HMBCOV@@@@','NACISB@@@@','IHIG1@@@@','HMBCOV1@@@@',
                                    'HMBCOV2@@@@','COBOL@@@@','S&PISB2@@@@','S&PGMI@@@@','IAD@@@@','BEFP@@@@','S&PISB5@@@@','HMBCOV3@@@@','S&PISB6@@@@','COMPENSATION@@@@',
                                    'NASICB1@@@@','S&PGP5@@@@','HIGHNOON1@@@@','NOVARTIS1@@@@','NOVARTIS2@@@@','FEROZE@@@@','PEPFF1@@@@','S&PISB5@@@@','HMBCOV@@@@','S&PISB6@@@@',
                                    'BEFP@@@@','REBRAND@@@@','S&PISB8@@@','KTTECH1001','WILSHIRE@@@@','IHIG9@@@@','S&PGLOBAL1@@@','COVANCE@@@@','SITAGEN@@@@','EMPAGENMXR@@@#',
                                    'MOXIGET@@@@','MOXIGET@@@@#','MOXIGET1@@@','BGPK@@@@','BGPK1@@@@','BGPK2@@@@','BGPK3@@@@','DIABETRON@@@@','LEFLOX@@@@','KTTECH1001',
                                    'KTTECH1003','KTTECH1005','XAVUR@@@@','VALIANT@@@@','SCB@@@@','S&PGBL1@@','NOVAPRESSIN@@','INTEGRITI1@@@','COBOL3@@','BU@@@@',
                                    'MERAFUTURE@','AMALACAD@@','MK1@@@@','MK2@@@@','XAV@@@','NOS@@@@','RIFAXA@@@')    
    AND global_entity_id='FP_PK')
   )
),

fx AS (
  SELECT * FROM
  (
    SELECT currency_code, fx, fx_rate_date,
    CASE
    WHEN currency_code='BDT' THEN 'BD'
    WHEN currency_code='BGN' THEN 'BG'
    WHEN currency_code='HKD' THEN 'HK'
    WHEN currency_code='JPY' THEN 'JP'
    WHEN currency_code='MYR' THEN 'MY'
    WHEN currency_code='PHP' THEN 'PH'
    WHEN currency_code='PKR' THEN 'PK'
    WHEN currency_code='THB' THEN 'TH'
    WHEN currency_code='SGD' THEN 'SG'
    WHEN currency_code='TWD' THEN 'TW'
    WHEN currency_code='HUF' THEN 'HU'
    WHEN currency_code='EUR' THEN 'AT'
    WHEN currency_code='CZK' THEN 'CZ'
    WHEN currency_code = 'SEK' THEN 'SE'
    WHEN currency_code = 'NOK' THEN 'NO'
    END AS country_code
    FROM
    (SELECT currency_code, fx_rate_eur AS fx, fx_rate_date, ROW_NUMBER() OVER (PARTITION BY currency_code ORDER BY currency_code, fx_rate_date DESC) AS RANK
    FROM `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates`
    WHERE DATE(fx_rate_date)>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 2 MONTH), MONTH)
    )
    WHERE RANK=1
  )
  WHERE country_code IS NOT NULL
),

orders AS (
  SELECT
    v.global_entity_id,
    /*orders.country_name,*/
    v.pd_voucher_uuid AS voucher_id,
    MAX(v.value_eur) AS voucher_value_eur,
    MAX(v.value_local) AS voucher_value_local,
    -- MAX(orders.minimum_delivery_value_local) AS minimum_order_value_local,
    COUNT(DISTINCT orders.order_uid) AS order_count,
    SUM(sb.gmv_eur) AS gmv_eur,
    SUM(sb.gmv_local) AS gmv_local,
    SUM(sb.gfv_eur) AS gfv_eur,
    SUM(sb.gfv_local) AS gfv_local,
    SUM(v.value_eur) AS voucher_value_redeemed_eur,
    SUM(v.value_local) AS voucher_value_redeemed_local
  
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` orders
  
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` sb
  ON orders.order_id = sb.order_code
  AND orders.global_entity_id = sb.global_entity_id
  
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` AS v
    ON orders.order_id = v.order_code
    AND orders.global_entity_id = v.global_entity_id

  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON orders.global_entity_id = shared_countries.global_entity_id
  
  WHERE orders.partition_date_local>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH) AND DATE(orders.placed_at_local)<<=DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
  AND sb.created_date_utc>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH)
  AND v.created_date_utc>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH)
  AND ((shared_countries.company_name = "Foodpanda" AND shared_countries.region = "Asia")
      OR (shared_countries.region = "Europe" AND shared_countries.name NOT IN ("Finland", "Germany")))
  AND orders.order_status != "PENDING_ORDER_FAILED"
  AND orders.is_successful
  AND v.pd_voucher_uuid IS NOT NULL
  AND v.is_voucher_used
  AND v.pd_voucher_uuid IN (SELECT voucher_id FROM vshop_vouchers)
  GROUP BY 1,2
)

SELECT
    vshop_vouchers.*,
    SPLIT(vshop_vouchers.voucher_id,'_')[SAFE_OFFSET(0)] AS final_voucher_id,
    
    CASE WHEN vshop_vouchers.voucher_value_local_temp<<orders.voucher_value_local THEN orders.voucher_value_eur
    ELSE vshop_vouchers.voucher_value_local_temp/fx.fx END AS voucher_value_eur,
    -- CASE WHEN vshop_vouchers.minimum_order_value_local_temp<<orders.minimum_order_value_local THEN orders.minimum_order_value_local/fx.fx
    -- ELSE vshop_vouchers.minimum_order_value_local_temp/fx.fx END AS minimum_order_value_eur,
    
    CASE WHEN vshop_vouchers.voucher_value_local_temp<<orders.voucher_value_local THEN orders.voucher_value_local
    ELSE vshop_vouchers.voucher_value_local_temp END AS voucher_value_local,
    -- CASE WHEN vshop_vouchers.minimum_order_value_local_temp<<orders.minimum_order_value_local THEN orders.minimum_order_value_local
    -- ELSE vshop_vouchers.minimum_order_value_local_temp END AS minimum_order_value_local,
    
    IFNULL(orders.order_count,0) AS order_count,
    IFNULL(orders.gmv_eur,0) AS gmv_eur,
    IFNULL(orders.gmv_local,0) AS gmv_local,
    IFNULL(orders.gfv_eur,0) AS gfv_eur,
    IFNULL(orders.gfv_local,0) AS gfv_local,
    IFNULL(orders.voucher_value_redeemed_eur,0) AS voucher_value_redeemed_eur,
    IFNULL(orders.voucher_value_redeemed_local,0) AS voucher_value_redeemed_local,
    fx.fx
  FROM vshop_vouchers
  LEFT JOIN orders ON vshop_vouchers.voucher_id=orders.voucher_id 
  LEFT JOIN fx ON vshop_vouchers.country_code=fx.country_code
  ORDER BY vshop_vouchers.country_code, vshop_vouchers.start_date_local]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='AP_Corp_Daily_VShop_Sales_V2' inline='true' name='federated.0k3q36k00fqh1511u2wk413loswd' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0r18ugl1c8iyvx14sx0fk1krp4t8'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_curated' server-oauth='' username='joshua.yeo@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0r18ugl1c8iyvx14sx0fk1krp4t8' name='Custom_SQL_Query' type='text'><![CDATA[WITH fx_rates AS (
  SELECT
    LEFT(currency_code,2) AS country_code,
    currency_code,
    fx_rate_eur,
    fx_rate_date
  FROM `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` fx
  WHERE fx.currency_code IN ('BDT','HKD','LAK','MYR','PHP','PKR','SGD','THB','TWD', 'EUR', 'CZK', 'SE','NOK') -- to change Austria currency logic here
  AND fx.fx_rate_date>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH) AND fx.fx_rate_date>>='2021-07-01'
),

offline_voucher_sales AS (
  SELECT
    global_entity_id AS country,
    country_code,
    TRUE AS is_vshop_order,
    /*FALSE AS is_vshop_voucher_order,*/
    TRUE AS is_corporate,
    date_at_local AS date_local,
    'Offline' as voucher_sale_type,
      
    0 AS vendor_count,
    COUNT(DISTINCT uuid) AS order_count,
    CAST(SUM(gmv_eur) AS NUMERIC) AS gmv_eur,
    CAST(SUM(gmv_local) AS NUMERIC) AS gmv_local,
    CAST(SUM(gfv_eur) AS NUMERIC) AS gfv_eur,
    CAST(SUM(gfv_local) AS NUMERIC) AS gfv_local
  FROM
  (
    SELECT
      t.global_entity_id,
      t.country_code,
      t.date_at_local,
      t.uuid,
      SAFE_DIVIDE(t.gmv_local, fx.fx_rate_eur) AS gmv_eur,
      t.gmv_local,
      SAFE_DIVIDE(t.gmv_local, fx.fx_rate_eur) AS gfv_eur,
      t.gmv_local AS gfv_local      
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_b2b_voucher_sales_tracker` t
    LEFT JOIN fx_rates fx
    ON t.country_code=fx.country_code AND t.date_at_local=fx.fx_rate_date
    WHERE t.is_voucher_shop=1
    AND (t.date_at_local BETWEEN DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH) AND DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)) AND t.date_at_local>>='2021-07-01'
  )
  GROUP BY 1,2,3,4,5,6
),

orders AS (
  SELECT 
    orders.global_entity_id AS country,
    orders.country_code,
    CASE WHEN
    -- to add EUR logic here next time
    ((orders.vendor_id IN ('h6ph') AND orders.global_entity_id='FP_SG')
    OR (orders.vendor_id IN ('h8at','vaal') AND orders.global_entity_id='FP_MY')
    OR (orders.vendor_id IN ('b2gp') AND orders.global_entity_id='FP_PH')
    OR (orders.vendor_id IN ('lnwf') AND orders.global_entity_id='FP_PK')
    OR (orders.vendor_id IN ('p3oi') AND orders.global_entity_id='FP_HK' AND DATE(orders.placed_at_local)>>='2021-04-07')
    OR (orders.vendor_id IN ('wdyj') AND orders.global_entity_id='FP_TH')
    OR (orders.vendor_id IN ('mq6q') AND orders.global_entity_id='FP_BD')
    OR (orders.vendor_id IN ('kwd6') AND orders.global_entity_id='FP_TW')
    ) THEN TRUE ELSE FALSE END AS is_vshop_order,
    /*CASE WHEN vshop_vouchers.is_vshop_voucher=1 THEN TRUE ELSE FALSE END AS is_vshop_voucher_order,*/
    orders.is_corporate,
    DATE(orders.placed_at_local) AS date_local,
    'Online' AS voucher_sale_type,

    COUNT(DISTINCT orders.vendor_id) AS vendor_count,
    COUNT(DISTINCT orders.order_uid) AS order_count,
    CAST(SUM(sb.gmv_eur) AS NUMERIC) AS gmv_eur,
    CAST(SUM(sb.gmv_local) AS NUMERIC) AS gmv_local,
    CAST(SUM(sb.gfv_eur) AS NUMERIC) AS gfv_eur,
    CAST(SUM(sb.gfv_local) AS NUMERIC) AS gfv_local
  
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` orders
  
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` sb
  ON orders.order_id = sb.order_code
  AND orders.global_entity_id = sb.global_entity_id
  
  /*LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders_agg_vouchers` v
  ON orders.uuid=v.uuid

  LEFT JOIN vshop_vendors
  ON orders.pd_vendor_uuid=vshop_vendors.uuid
  
  LEFT JOIN vshop_vouchers
  ON v.pd_voucher_uuid=vshop_vouchers.uuid*/
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON orders.global_entity_id = shared_countries.global_entity_id
  
  WHERE orders.partition_date_local>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH) AND orders.partition_date_local<<=DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
  AND sb.created_date_utc>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH)
  AND ((shared_countries.company_name = "Foodpanda" AND shared_countries.region = "Asia")
      OR (shared_countries.region = "Europe" AND shared_countries.name NOT IN ("Finland", "Germany")))
  AND orders.is_successful
  GROUP BY 1,2,3,4,5,6
)

SELECT *
FROM orders
UNION ALL
SELECT *
FROM offline_voucher_sales]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0r18ugl1c8iyvx14sx0fk1krp4t8' name='Custom_SQL_Query' type='text'><![CDATA[WITH fx_rates AS (
