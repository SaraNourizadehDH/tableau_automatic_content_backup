   (UPPER(voucher_code) IN (&apos;CORPDBS@@@&apos;,&apos;CORPFP3@@@&apos;,&apos;CORPFP2@@@&apos;,&apos;CORPFP@@@&apos;,&apos;CORPFP1@@@&apos;,&apos;CORPTCG@@@&apos;,&apos;CORPFP4@@@&apos;,&apos;CORPFP5@@@&apos;,&apos;CORPFP6@@@&apos;,&apos;CORPFP7@@@&apos;,
                      &apos;CORPMOM1@@@&apos;,&apos;CORPMOM@@@&apos;,&apos;CORPAMGEN@@@&apos;,&apos;CORPHDB@@@&apos;,&apos;CORPRTB@@@&apos;,&apos;CORPWFO@@@&apos;,&apos;CORPECO@@@&apos;,&apos;CORPISCA@@@&apos;,&apos;CORPAMCA@@@&apos;,&apos;CORPAO@@@&apos;,
                      &apos;CORPDBS1@@@&apos;,&apos;CORPFP8@@@&apos;,&apos;CORPSNTC@@@&apos;,&apos;CORPSTBAED@@@@&apos;,&apos;CORPJVS@@@&apos;,&apos;CORPJVS1@@@&apos;,&apos;CORPHDB1@@@&apos;,&apos;CORPCHANEL@@@&apos;,&apos;CORPFP9@@@&apos;,&apos;CORPFP10@@@&apos;,
                      &apos;CORPFP11@@@&apos;,&apos;CORPESGTL2&apos;,&apos;CORPUBSGCRG@@@&apos;,&apos;CORPASPIAL@@@&apos;,&apos;CORPSTBAED1@@@&apos;,&apos;CORPGUMI@@@&apos;,&apos;CORPUBS@@@&apos;,&apos;CORPDBS2@@&apos;,&apos;CORPFP12@@@&apos;,&apos;CORPFP13@@&apos;,
                      &apos;CORPFS10@@@@@&apos;,&apos;CORPFS20@@@@@&apos;,&apos;CORPDBSOE@@@@&apos;,&apos;CORPRSBW@@@@@&apos;,&apos;CORPOC5@@@@@&apos;,&apos;CORPOC10@@@@@&apos;,&apos;CORPOTC5@@@&apos;,&apos;CORPOTC10@@@&apos;,&apos;CORPAO1@@@&apos;,&apos;CORPRP@@@&apos;,
                      &apos;CORPCSR@@@&apos;,&apos;CORPCNYSEIKO@@@&apos;,&apos;CORPMOHAPO@@@&apos;,&apos;CORPINFOBIP20@@@&apos;,&apos;CORPINFOBIP10@@@&apos;,&apos;CORPSMRT@@@@&apos;,&apos;CORPSMRTMEAL@@@@&apos;,&apos;CORPSMRTMEAL1@@@&apos;,&apos;CORPANDHUAT@@@&apos;,&apos;CORPHUATHUAT@@@@&apos;,
                      &apos;CORPARMINEH@@@&apos;,&apos;CORPHERBALIFE@@@&apos;,&apos;CORPDWS@@@&apos;,&apos;CORPUBSAPAC@@@&apos;,&apos;CORPUBS1@@@&apos;,&apos;CORPUBS2@@&apos;,&apos;CORPNOMURA&apos;,&apos;CORPUBS11@@@&apos;,&apos;CORPACCENTURE@@@&apos;,&apos;CORPMINDEF@@@&apos;,
                      &apos;CORPANGBAO@@@&apos;,&apos;CORPCAG@@@&apos;,&apos;CORPALIBABA10@@@&apos;,&apos;CORPSMRTVAC@@@&apos;,&apos;CORPSOS@@@&apos;,&apos;CORPNPARKS@@@&apos;,&apos;CORPSMRT10@@@&apos;,&apos;CORPSMRT20@@@&apos;,&apos;CORPSMRT30@@@&apos;,&apos;CORPRTB&apos;,
                      &apos;CORPSMRTBF@@@&apos;,&apos;CORPSMU5@@@&apos;,&apos;CORPSMU10@@@&apos;,&apos;CORPALIBABA1@@@&apos;,&apos;CORPBRAZE@@@&apos;,&apos;CORPCMG@@@&apos;,&apos;CORPSMRTBF1@@@&apos;,&apos;CORPSMAYE@@@&apos;,&apos;CORPPPDIV@@@&apos;,&apos;CORPALIBABA2@@@&apos;,
                      &apos;CORPFP14@@@&apos;,&apos;CORPFP15@@@&apos;,&apos;CORPALIBABA3@@@&apos;,&apos;CORPALIBABA5@@@&apos;,&apos;CORPTTSH@@@&apos;,&apos;CORPDWS1@@@&apos;,&apos;CORPFP16@@@&apos;,&apos;CORPACC1@@@&apos;,&apos;CORPACC2@@@&apos;,&apos;CORPACC3@@@&apos;,
                      
