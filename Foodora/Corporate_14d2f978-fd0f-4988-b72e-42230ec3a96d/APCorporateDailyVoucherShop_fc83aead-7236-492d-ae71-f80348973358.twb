      <column caption='Expired Voucher' datatype='string' name='[Calculation_1841127842197938176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF([stop_date_local]&lt;TODAY()) THEN &apos;YES&apos; ELSE &apos;NO&apos; END' />
      </column>
      <column caption='Available Vouchers' datatype='integer' name='[Calculation_1841127842201907201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity])-SUM([order_count])-[Calculation_2300776480510242816]' />
      </column>
      <column caption='Total Voucher Value Local' datatype='real' name='[Calculation_1841127842203688962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[quantity]*[voucher_value_local]' />
      </column>
      <column caption='Available Voucher Value Local' datatype='real' name='[Calculation_1841127842203992067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1841127842203688962])-SUM([voucher_value_redeemed_local])-[Calculation_2300776480529006594]' />
      </column>
      <column caption='Redemption Quantity %' datatype='real' name='[Calculation_1841127842215702533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_count])/SUM([quantity])' />
      </column>
      <column caption='Redemption Value Local %' datatype='real' name='[Calculation_1841127842216075270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([voucher_value_redeemed_local])/SUM([Calculation_1841127842203688962])' />
      </column>
      <column caption='Available Voucher Value EUR' datatype='real' name='[Calculation_1841127842223419399]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1841127842225045512])-SUM([voucher_value_redeemed_eur])-[Calculation_2300776480528777217]' />
      </column>
      <column caption='Total Voucher Value EUR' datatype='real' name='[Calculation_1841127842225045512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[quantity]*[voucher_value_eur]' />
      </column>
      <column caption='Redemption Value EUR %' datatype='real' name='[Calculation_1841127842226819081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([voucher_value_redeemed_eur])/SUM([Calculation_1841127842225045512])' />
      </column>
      <column caption='Expired Unredeemed Vouchers' datatype='integer' name='[Calculation_2300776480510242816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_expired]=TRUE THEN [quantity] ELSE 0 END) - SUM(IF [is_expired]=TRUE THEN [order_count] ELSE 0 END)' />
      </column>
      <column caption='Expired Unredeemed Voucher Value EUR' datatype='real' name='[Calculation_2300776480528777217]' role='measure' type='quantitative'>
