    <worksheet name='All Vouchers Expired EUR'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Expired Unredeemed Voucher Amount (EUR)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='AP_Corp_Daily_Vshop_Vouchers_All' name='federated.1d19xlm1l74ps51exj96x0w5rap7' />
          </datasources>
          <datasource-dependencies datasource='federated.1d19xlm1l74ps51exj96x0w5rap7'>
            <column caption='Total Voucher Value EUR' datatype='real' name='[Calculation_3918765027703291906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[quantity]*[voucher_value_eur]' />
            </column>
            <column caption='Expired Unredeemed Voucher Value EUR' datatype='real' name='[Calculation_3918765027704958981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_expired]=TRUE THEN [Calculation_3918765027703291906] ELSE 0 END) - SUM(IF [is_expired]=TRUE THEN [voucher_value_redeemed_eur] ELSE 0 END)' />
