 MAX(date_local) AS latest_date
FROM AP_Corp_Daily_Vshop_Sales_Failed 

UNION ALL

SELECT
 &quot;AP_Corp_Daily_VShop_Sales_V2&quot; AS table_name,
 MAX(date_local) AS latest_date
FROM AP_Corp_Daily_VShop_Sales_V2

UNION ALL 

