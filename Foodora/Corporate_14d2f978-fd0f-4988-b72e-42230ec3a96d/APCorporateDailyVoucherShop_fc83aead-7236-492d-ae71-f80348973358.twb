    AND global_entity_id=&apos;FP_SG&apos;)

    OR 
    (UPPER(voucher_code) IN (&apos;FPCRPT@@@@&apos;,&apos;ECART@@@@@&apos;,&apos;ECSM@@@@@&apos;,&apos;EXPEDITORS@@@@&apos;,&apos;EXPTEN@@@@&apos;,&apos;SSC@@@@@&apos;,&apos;TWENTYOFFSSC@@@&apos;,&apos;FIFTYOFFSSC@@@&apos;,&apos;SEVENTY@@@@@&apos;,&apos;THIRTY@@@@@@@&apos;,
                       &apos;25PDT@@@@@@&apos;,&apos;PRU2@@@@@@@&apos;,&apos;HUNDRED@@@@@&apos;,&apos;FIVEZERO@@@@@&apos;,&apos;THREEZERO@@@@&apos;,&apos;THREEZERO@@@@&apos;,&apos;STUDIO@@@@@@&apos;,&apos;CELFIVE@@@@@@&apos;,&apos;PETR@@@@@@&apos;,&apos;GEMA@@@@@@&apos;,
