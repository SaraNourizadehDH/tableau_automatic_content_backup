      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom_SQL_Query' id='_283E85A60CB5491CBBAEAF088029194D'>
            <properties context=''>
              <relation connection='bigquery.162dicc1uj2x03173n6zv141mvo4' name='Custom_SQL_Query' type='text'><![CDATA[WITH vshop_vendors AS (
  SELECT
    DISTINCT
    pd_vendor_uuid,
    vendor_name,
    created_at_local,
    1 AS is_voucher_shop_order
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` pd_vendors
  WHERE
    /* is_active AND */
    ((vendor_code IN ('h6ph') AND global_entity_id='FP_SG')
    OR (vendor_code IN ('h8at','vaal') AND global_entity_id='FP_MY')
    OR (vendor_code IN ('b2gp') AND global_entity_id='FP_PH')
    OR (vendor_code IN ('lnwf') AND global_entity_id='FP_PK')
    OR (vendor_code IN ('p3oi') AND global_entity_id='FP_HK')
    OR (vendor_code IN ('wdyj') AND global_entity_id='FP_TH')
    OR (vendor_code IN ('mq6q') AND global_entity_id='FP_BD')
    OR (vendor_code IN ('kwd6') AND global_entity_id='FP_TW')
    )
),

vshop_vouchers AS (
  SELECT
    DISTINCT
    uuid AS voucher_id,
    SPLIT(global_entity_id,'_')[SAFE_OFFSET(1)] AS country_code,
    customer_code AS code,
    voucher_code AS customer_code,
    quantity,
    value AS voucher_value_local_temp,
    minimum_order_value_local AS minimum_order_value_local_temp,
    start_date_local,
    stop_date_local,
    CASE WHEN stop_date_local<<CURRENT_DATE THEN TRUE ELSE FALSE END AS is_expired,
    type AS voucher_type
  
  FROM `fulfillment-dwh-production.pandata_curated.offers_vouchers`
  WHERE start_date_local>>='2020-01-01' AND created_date_utc>>='2020-01-01' AND
  is_deleted IS NOT TRUE AND
  (
   (UPPER(voucher_code) IN ('CORPDBS@@@','CORPFP3@@@','CORPFP2@@@','CORPFP@@@','CORPFP1@@@','CORPTCG@@@','CORPFP4@@@','CORPFP5@@@','CORPFP6@@@','CORPFP7@@@',
                      'CORPMOM1@@@','CORPMOM@@@','CORPAMGEN@@@','CORPHDB@@@','CORPRTB@@@','CORPWFO@@@','CORPECO@@@','CORPISCA@@@','CORPAMCA@@@','CORPAO@@@',
                      'CORPDBS1@@@','CORPFP8@@@','CORPSNTC@@@','CORPSTBAED@@@@','CORPJVS@@@','CORPJVS1@@@','CORPHDB1@@@','CORPCHANEL@@@','CORPFP9@@@','CORPFP10@@@',
