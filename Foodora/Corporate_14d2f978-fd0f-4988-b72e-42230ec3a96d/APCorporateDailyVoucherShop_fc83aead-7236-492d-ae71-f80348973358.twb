        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.16r2l901qv03fp1dqohwr1oorahn' name='Custom SQL Query' type='text'><![CDATA[-- updated 18 Apr 2023 for pd_vendors deprecation

WITH vshop_vendors AS (
  SELECT
    DISTINCT
    global_entity_id,
    vendor_code,
    vendor_name,
    created_at_local,
    1 AS is_voucher_shop_order
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` pd_vendors
  WHERE
    /*is_active AND*/
    ((vendor_code IN ('h6ph') AND global_entity_id='FP_SG')
    OR (vendor_code IN ('h8at','vaal') AND global_entity_id='FP_MY')
    OR (vendor_code IN ('b2gp') AND global_entity_id='FP_PH')
    OR (vendor_code IN ('lnwf') AND global_entity_id='FP_PK')
    OR (vendor_code IN ('p3oi') AND global_entity_id='FP_HK')
    OR (vendor_code IN ('wdyj') AND global_entity_id='FP_TH')
    OR (vendor_code IN ('mq6q') AND global_entity_id='FP_BD')
    -- to add in EU vshop vendors later on
    )
),

pd_orders_agg_discounts AS (
  SELECT
    global_entity_id,
    order_code,
    discount_type,
    discount_title,
    discount_amount_eur,
    discount_amount_local,
    pd_discount_uuid,
    is_discount_used,
    attributions_foodpanda_ratio
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_discounts`
  WHERE global_entity_id IN ("FP_BD", "FP_HK", "FP_KH", "FP_LA", "FP_MY", "FP_PH", "FP_PK", "FP_SG", "FP_TH", "FP_TW")
    AND created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 2 YEAR), YEAR)

  UNION ALL

  SELECT
    global_entity_id,
    order_code,
    discount.discount_type,
    discount.discount_title,
    discount.discount_amount_eur,
    discount.discount_amount_local,
    pd_discount_uuid,
    is_discount_used,
    discount.attributions_foodpanda_ratio 
  FROM `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_discounts`
  WHERE global_entity_id IN ("MJM_AT", "OP_SE", "FO_NO", "DJ_CZ", "NP_HU")
    AND created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 2 YEAR), YEAR)
),

cancelled_orders AS (
  SELECT *
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_cancelled_orders`
  WHERE created_date_local>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH)
)

SELECT
    orders.global_entity_id AS country,
    orders.country_code,
    CASE WHEN (vshop_vendors.is_voucher_shop_order=1 AND orders.global_entity_id='FP_HK' AND DATE(orders.placed_at_local)>>='2021-04-07')
    OR (vshop_vendors.is_voucher_shop_order=1 AND orders.global_entity_id NOT IN ('FP_HK')) THEN TRUE ELSE FALSE END AS is_vshop_order,
    orders.is_corporate,
    orders.is_successful AS is_valid_order,
    orders.is_failed AS is_failed_order,
    orders.is_preorder,
    orders.delivery_provider AS expedition_type,
    orders.order_status AS status_name,
    cancelled_orders.pandora_decline_reason_title AS decline_reasons_title,
    DATE(orders.placed_at_local) AS date_local,
    
    COUNT(DISTINCT orders.vendor_id) AS vendor_count,
    COUNT(DISTINCT orders.order_uid) AS order_count,
    COUNT(DISTINCT IF(orders.is_successful IS TRUE, orders.order_uid, NULL)) valid_order_count,
    COUNT(DISTINCT IF(orders.order_status = "CANCELLED", orders.order_uid, NULL)) cancelled_order_count,
    COUNT(DISTINCT IF(cancelled_orders.is_cancelled_by_vendor, orders.order_uid, NULL)) vendor_cancelled_order_count,
    COUNT(DISTINCT IF(cancelled_orders.is_cancelled_by_customer, orders.order_uid, NULL)) cust_cancelled_order_count,
    
    CAST(SUM(sb.gmv_eur) AS NUMERIC) AS gmv_eur,
    CAST(SUM(sb.gmv_local) AS NUMERIC) AS gmv_local,
    CAST(SUM(sb.gfv_eur) AS NUMERIC) AS gfv_eur,
    CAST(SUM(sb.gfv_local) AS NUMERIC) AS gfv_local,
    CAST(SUM(d.discount_amount_eur) AS NUMERIC) AS discount_value_eur,
    CAST(SUM(d.discount_amount_local) AS NUMERIC) AS discount_value_local
    
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` orders

  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON orders.global_entity_id = shared_countries.global_entity_id
        
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` sb
  ON orders.order_id = sb.order_code
  AND orders.global_entity_id = sb.global_entity_id
 
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_cp_orders` cp
  ON orders.order_id = cp.order_code
  AND orders.global_entity_id = cp.global_entity_id
        
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.preprocessing__core_vendor_business_types` bt
  ON orders.vendor_id = bt.vendor_code
  AND orders.global_entity_id = bt.global_entity_id
  
  LEFT JOIN pd_orders_agg_discounts AS d
  ON orders.order_id = d.order_code
  AND orders.global_entity_id = d.global_entity_id

  LEFT JOIN cancelled_orders
    ON orders.order_uid = cancelled_orders.order_uid
  
  RIGHT JOIN vshop_vendors
  ON orders.vendor_id = vshop_vendors.vendor_code
  AND orders.global_entity_id = vshop_vendors.global_entity_id

  
  WHERE orders.partition_date_local >>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH) AND orders.partition_date_local<<=DATE_SUB(CURRENT_DATE, INTERVAL 1 DAY)
  AND sb.created_date_utc>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH)
  AND cp.created_date_utc>>=DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH)
  AND ((shared_countries.company_name = "Foodpanda" AND shared_countries.region = "Asia")
      OR (shared_countries.region = "Europe" AND shared_countries.name NOT IN ("Finland", "Germany")))
  AND orders.order_status != "PENDING_ORDER_FAILED"
  AND orders.is_corporate
  GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
