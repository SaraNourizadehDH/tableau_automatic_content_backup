                       &apos;LAPANDA@@@@@&apos;,&apos;A2X@@@@@@&apos;,&apos;XPR5@@@@@&apos;,&apos;AEM@@@@@@@&apos;,&apos;PMB@@@@@@&apos;,&apos;SCJAP@@@@@@&apos;,&apos;TRANSFER@@@@@@&apos;,&apos;176ART@@@@@@&apos;,&apos;44ARTSB@@@@&apos;,&apos;2SIX@@@@@&apos;,
