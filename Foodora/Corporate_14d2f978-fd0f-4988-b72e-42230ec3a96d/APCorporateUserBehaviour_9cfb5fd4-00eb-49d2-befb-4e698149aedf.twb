      </column>
      <column caption='Aft B2B First Order %' datatype='real' name='[Aft B2B First Order Count (copy)_1624110677956337668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1624110677956055043])/SUM([user_count])*100' />
      </column>
      <column caption='Aft B2B First Order Count' datatype='integer' name='[Calculation_1624110677956055043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF([first_order_status_aft_b2b]) = &quot;has order aft b2b&quot; THEN [user_count] ELSE 0 END' />
      </column>
      <column caption='Non Active Count' datatype='integer' name='[Calculation_3625186622882668544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [last_order_status_bef_b2b] != &quot;active&quot; &#10;AND [last_order_status_bef_b2b] != &quot;new&quot; THEN [user_count] ELSE 0 END' />
      </column>
      <column caption='Non Active %' datatype='real' name='[Calculation_3625186622882779137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3625186622882668544])/SUM([Calculation_468374384673001476])*100' />
      </column>
      <column caption='New Count' datatype='integer' name='[Calculation_3625186622898782212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [last_order_status_bef_b2b] = &quot;new&quot; THEN [user_count] ELSE 0 END' />
      </column>
      <column caption='New %' datatype='real' name='[Calculation_3625186622898880517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3625186622898782212])/SUM([Calculation_468374384673001476])*100' />
      </column>
      <column caption='Title First Order Post B2B' datatype='string' name='[Calculation_3625186622925115398]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;First Order Post B2B&quot;' />
      </column>
      <column caption='New User Count' datatype='integer' name='[Calculation_468374384672141313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF([user_type]) = &quot;new user&quot; THEN [user_count] ELSE 0 END' />
      </column>
      <column caption='Total User Count' datatype='integer' name='[Calculation_468374384673001476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[New User Count (copy)_468374384672399363]+[Calculation_468374384672141313]' />
      </column>
      <column caption='New User %' datatype='real' name='[Calculation_468374384675631109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_468374384672141313])/SUM([Calculation_468374384673001476])*100' />
      </column>
      <column caption='Dormant count' datatype='integer' name='[Calculation_468374384733143050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [last_order_status_bef_b2b] = &quot;dormant&quot; &#10;OR [last_order_status_bef_b2b] = &quot;new&quot; THEN [user_count] ELSE 0 END' />
      </column>
      <column caption='Dormant activation %' datatype='real' name='[Calculation_468374384734035980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_468374384733143050])/SUM([Calculation_468374384673001476])*100' />
      </column>
      <column caption='Active Count' datatype='integer' name='[Calculation_468374384734314509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF([last_order_status_bef_b2b]) = &quot;active&quot; THEN [user_count] ELSE 0 END' />
      </column>
      <column caption='User with order count' datatype='integer' name='[Calculation_468374384746373139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF([first_order_status]) != &quot;no first order&quot; THEN [user_count] ELSE 0 END' />
      </column>
      <column caption='Dormant user with order' datatype='integer' name='[Calculation_468374384770605076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ( [last_order_status_bef_b2b] = &quot;dormant&quot; OR [last_order_status_bef_b2b] = &quot;new&quot; ) &#10;AND [first_order_status] != &quot;no first order&quot; &#10;THEN [user_count] ELSE 0 END' />
      </column>
      <column caption='Dormant order %' datatype='real' name='[Calculation_468374384771981333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_468374384770605076])/SUM([Calculation_468374384733143050])*100' />
      </column>
      <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_6346557085063192577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Yearly&apos; THEN [created_date_utc] &gt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,TODAY())) AND [created_date_utc] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Quarterly&apos; THEN [created_date_utc] &gt;= DATEADD(&apos;quarter&apos;,-7,DATETRUNC(&apos;quarter&apos;,TODAY())) AND [created_date_utc] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Monthly&apos; THEN [created_date_utc] &gt;= DATEADD(&apos;month&apos;,-11,DATETRUNC(&apos;month&apos;,TODAY())) AND [created_date_utc] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Weekly&apos; THEN [created_date_utc] &gt;= DATEADD(&apos;week&apos;,-11,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [created_date_utc] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Daily&apos; THEN [created_date_utc] &gt;= DATEADD(&apos;day&apos;,-12,TODAY()) AND [created_date_utc] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Monthly + MTD&apos; THEN [created_date_utc] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [created_date_utc] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Weekly + WTD&apos; THEN [created_date_utc] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [created_date_utc] &lt; TODAY()&#10;END' />
      </column>
      <column caption='Dynamic Date Range' datatype='string' name='[Calculation_6346557085063688194]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parameter 2] = &apos;Weekly&apos; OR [Parameters].[Parameter 2] = &apos;Week + WTD&apos;) THEN STR(DATEPART(&apos;iso-year&apos;,[created_date_utc]))+&apos;-&apos;+STR(DATEPART(&apos;iso-week&apos;,[created_date_utc]))&#10;ELSEIF([Parameters].[Parameter 2] = &apos;Monthly&apos; OR [Parameters].[Parameter 2] = &apos;Month + MTD&apos;) THEN LEFT(STR(DATENAME(&apos;month&apos;,[created_date_utc])),3)+&apos; &apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[created_date_utc])),2)&#10;ELSEIF ([Parameters].[Parameter 2] = &apos;Quarterly&apos; OR [Parameters].[Parameter 2] = &apos;Quarterly + MTD&apos;) THEN &quot;Q&quot;+STR(DATENAME(&apos;quarter&apos;,[created_date_utc]))+&apos;-&apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[created_date_utc])),2)&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Daily&apos; then str(DATEPART(&apos;day&apos;,[created_date_utc]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[created_date_utc])),3)&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Yearly&apos; then RIGHT(STR(DATEPART(&apos;year&apos;,[created_date_utc])),4)&#10;END' />
      </column>
