    <worksheet name='Order Chart'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Order Frequency</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cp_incrementality_pre_post' name='federated.0jb4xr70u6poo41e8fyjo0hwykfz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Reference Line' datatype='real' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jb4xr70u6poo41e8fyjo0hwykfz'>
            <column caption='Mthly B2B Order' datatype='real' name='[Calculation_1795247419927408640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2C&quot;&#10;THEN (SUM([Calculation_1795247420005699589]))/(SUM([user_count]))&#10;ELSE (SUM([b2b_order]))/(SUM([user_count]))&#10;END' />
            </column>
            <column caption='Mthly B2C Order' datatype='real' name='[Calculation_1795247419927715841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2B w/o B2C Linked&quot;&#10;THEN (SUM([Calculation_74168672014299139]))/(SUM([user_count]))&#10;ELSE (SUM([b2c_order]))/(SUM([user_count]))&#10;END' />
            </column>
            <column caption='Net B2B Order' datatype='integer' name='[Calculation_1795247420005699589]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [linked_b2c] = &quot;B2C&quot; THEN NULL ELSE [b2b_order] END' />
            </column>
            <column caption='Order Frequency' datatype='string' name='[Calculation_224828156825808911]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Order per user&quot;' />
            </column>
            <column caption='User Start Month' datatype='string' name='[Calculation_4637018817372807168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([profile_created_month])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(MONTH([profile_created_month])), 2)' />
            </column>
            <column caption='Months' datatype='string' name='[Calculation_74168672013697026]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [month_ref] &lt; 0 THEN &quot;M&quot; + STR([month_ref]) &#10;ELSEIF [month_ref] = 0 THEN &quot;M&quot; + STR([month_ref]) &#10;ELSE &quot;M+&quot; + STR([month_ref]) &#10;END' />
            </column>
            <column caption='Net B2C Order' datatype='integer' name='[Calculation_74168672014299139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [linked_b2c] = &quot;B2B w/o B2C Linked&quot; THEN NULL ELSE [b2c_order] END' />
            </column>
            <column caption='Total Order' datatype='real' name='[Calculation_74168672018440196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [linked_b2c] = &quot;B2C&quot;&#10;    THEN [Calculation_74168672014299139]&#10;    ELSE [b2b_order] + [b2c_order]&#10;    END)&#10;/&#10;SUM([user_count])' />
            </column>
            <column-instance column='[Calculation_74168672018440196]' derivation='Avg' name='[avg:Calculation_74168672018440196:qk]' pivot='key' type='quantitative' />
            <column caption='Raw B2B Order' datatype='integer' name='[b2b_order]' role='measure' type='quantitative' />
            <column caption='Raw B2C Order' datatype='integer' name='[b2c_order]' role='measure' type='quantitative' />
