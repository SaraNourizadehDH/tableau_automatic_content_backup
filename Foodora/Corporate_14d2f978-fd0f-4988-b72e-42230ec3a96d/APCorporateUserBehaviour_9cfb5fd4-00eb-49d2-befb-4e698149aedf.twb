          </datasources>
          <datasource-dependencies datasource='federated.0puws7x0gl3xzj13cu8cc1h4k17i'>
            <column caption='Aft B2B First Order %' datatype='real' name='[Aft B2B First Order Count (copy)_1624110677956337668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1624110677956055043])/SUM([user_count])*100' />
            </column>
            <column caption='Aft B2B First Order Count' datatype='integer' name='[Calculation_1624110677956055043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF([first_order_status_aft_b2b]) = &quot;has order aft b2b&quot; THEN [user_count] ELSE 0 END' />
            </column>
            <column caption='New User Count' datatype='integer' name='[Calculation_468374384672141313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF([user_type]) = &quot;new user&quot; THEN [user_count] ELSE 0 END' />
            </column>
            <column caption='Total User Count' datatype='integer' name='[Calculation_468374384673001476]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[New User Count (copy)_468374384672399363]+[Calculation_468374384672141313]' />
            </column>
            <column caption='New User %' datatype='real' name='[Calculation_468374384675631109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_468374384672141313])/SUM([Calculation_468374384673001476])*100' />
            </column>
            <column caption='Existing User %' datatype='real' name='[New User % (copy)_468374384675717127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([New User Count (copy)_468374384672399363])/SUM([Calculation_468374384673001476])*100' />
            </column>
            <column caption='Existing User Count' datatype='integer' name='[New User Count (copy)_468374384672399363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF([user_type]) = &quot;existing user&quot; THEN [user_count] ELSE 0 END' />
            </column>
