    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Pre Post B2B'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APCorporateIUserBehaviour/PrePostB2B?rev=' id='PrePostB2B' path='/t/Foodora/workbooks/APCorporateUserBehaviour' revision='' site='Foodora' />
      <style />
      <size maxheight='1500' maxwidth='1800' minheight='1500' minwidth='1800' sizing-mode='fixed' />
      <datasources>
        <datasource caption='cp_incrementality_pre_post' name='federated.0jb4xr70u6poo41e8fyjo0hwykfz' />
      </datasources>
      <datasource-dependencies datasource='federated.0jb4xr70u6poo41e8fyjo0hwykfz'>
        <column caption='month_bucket' datatype='string' name='[Calculation_224828156770648066]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [month_ref] &gt;= -6 AND [month_ref] &lt;= -4 THEN &quot;Pre-6M&quot;&#10;ELSEIF[month_ref] &gt;= -3 AND [month_ref] &lt;= -1 THEN &quot;Pre-3M&quot;&#10;ELSEIF [month_ref] &gt;= 0 AND [month_ref] &lt;= 2 THEN &quot;Post+3M&quot;&#10;ELSEIF [month_ref] &gt;= 3 AND [month_ref] &lt;= 5 THEN &quot;Post+6M&quot;&#10;ELSEIF [month_ref] &gt;= 6 AND [month_ref] &lt;= 8 THEN &quot;Post+9M&quot;&#10;ELSEIF [month_ref] &gt;= 9 AND [month_ref] &lt;= 11 THEN &quot;Post+12M&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
        </column>
        <column caption='User Start Month' datatype='string' name='[Calculation_4637018817372807168]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='STR(YEAR([profile_created_month])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(MONTH([profile_created_month])), 2)' />
        </column>
        <column caption='Company Type' datatype='string' name='[company_type]' role='dimension' type='nominal' />
        <column caption='Cp Company Name' datatype='string' name='[cp_company_name]' role='dimension' type='nominal' />
        <column caption='Cp Company Uuid' datatype='string' name='[cp_company_uuid]' role='dimension' type='nominal' />
        <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_224828156770648066]' derivation='None' name='[none:Calculation_224828156770648066:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_4637018817372807168]' derivation='None' name='[none:Calculation_4637018817372807168:nk]' pivot='key' type='nominal' />
        <column-instance column='[company_type]' derivation='None' name='[none:company_type:nk]' pivot='key' type='nominal' />
        <column-instance column='[cp_company_name]' derivation='None' name='[none:cp_company_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[cp_company_uuid]' derivation='None' name='[none:cp_company_uuid:nk]' pivot='key' type='nominal' />
        <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
      <zones>
