            </zone-style>
          </zone>
          <zone forceUpdate='true' h='12141' id='313' type-v2='text' w='31889' x='444' y='2792'>
            <formatted-text>
              <run bold='true' fontcolor='#005493' fontsize='8'>User Group</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>New User             :   </run>
              <run fontcolor='#555555' fontsize='8'>User added due to B2B</run>
              <run fontcolor='#555555' fontsize='5'>Æ </run>
              <run fontcolor='#595959' fontname='Arial' fontsize='5'>(no B2C profile linked / B2C profile was created after B2B) </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>Existing User     :   </run>
              <run fontcolor='#555555' fontsize='8'>User converted from B2B to B2C </run>
              <run fontcolor='#595959' fontname='Arial' fontsize='5'>(linked with existing B2C profile)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#005493' fontsize='8'>User profile</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>B2B Overall                     :   </run>
              <run fontcolor='#555555' fontsize='8'>User who has corporate profile</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>B2C                                      :   </run>
              <run fontcolor='#555555' fontsize='8'>User who has private profile only</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>With allowance only</run>
              <run fontcolor='#555555' fontsize='8'>   :   User who has at least 1 allowance as a perk from their company</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>With pp only  </run>
              <run fontcolor='#555555' fontsize='8'>                 :   User who has at least 1 pandapro as a perk from their company</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='8'>With allowance &amp; pp</run>
              <run fontcolor='#555555' fontsize='8'>  :    User how has at least 1 allowance or 1 pandapro as a perk from their company</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
