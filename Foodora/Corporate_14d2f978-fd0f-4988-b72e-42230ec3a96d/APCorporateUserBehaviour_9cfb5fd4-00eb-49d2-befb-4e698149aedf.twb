    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Description'>
      <layout-options>
        <title>
          <formatted-text>
            <run>  &lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APCorporateIUserBehaviour/Description?rev=' id='Description' path='/t/Foodora/workbooks/APCorporateUserBehaviour' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-title'>
          <format attr='background-color' value='#d90663' />
          <format attr='color' value='#ffffff' />
          <format attr='font-weight' value='bold' />
          <format attr='font-family' value='Tableau Regular' />
        </style-rule>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_3' value='top' />
        </style-rule>
      </style>
      <size maxheight='600' maxwidth='1000' minheight='600' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97334' id='229' param='horz' type-v2='layout-flow' w='98400' x='800' y='1333'>
            <zone h='97334' id='7' param='vert' type-v2='layout-flow' w='98400' x='800' y='1333'>
              <zone fixed-size='58' h='11000' id='8' is-fixed='true' type-v2='title' w='98400' x='800' y='1333'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='86334' id='5' type-v2='layout-basic' w='98400' x='800' y='12333'>
                <zone forceUpdate='true' h='86334' id='3' type-v2='text' w='98400' x='800' y='12333'>
                  <formatted-text>
                    <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='12'>Purpose/ Description</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontname='Benton Sans Book' fontsize='12'>- Performance tracking for Corporate user acquisition and reactivation</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontname='Benton Sans Book' fontsize='12'>- Refreshes Daily</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='12'>How to use the dashboard (tabs)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='12'>User Acquisition: </run>
                    <run fontcolor='#555555' fontname='Benton Sans Book' fontsize='12'>Overview of Corporate user acquisition and activation over different periods with visualisations</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='12'>Companies Overview: </run>
                    <run fontcolor='#555555' fontname='Benton Sans Book' fontsize='12'>Corporate user acquisition by companies</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='12'>Pre Post B2B: </run>
                    <run fontcolor='#555555' fontname='Benton Sans Book' fontsize='12'>Comparison of users&apos; behaviour (order frequency, AOV, FLGPO, FLGPU) pre and post B2B</run>
                    <run>Æ&#10;&#10;</run>
