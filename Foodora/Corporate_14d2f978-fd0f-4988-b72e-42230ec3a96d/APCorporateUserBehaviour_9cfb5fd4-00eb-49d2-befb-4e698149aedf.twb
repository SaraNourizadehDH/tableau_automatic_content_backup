            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_6346557085063192577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Yearly&apos; THEN [created_date_utc] &gt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,TODAY())) AND [created_date_utc] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Quarterly&apos; THEN [created_date_utc] &gt;= DATEADD(&apos;quarter&apos;,-7,DATETRUNC(&apos;quarter&apos;,TODAY())) AND [created_date_utc] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Monthly&apos; THEN [created_date_utc] &gt;= DATEADD(&apos;month&apos;,-11,DATETRUNC(&apos;month&apos;,TODAY())) AND [created_date_utc] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Weekly&apos; THEN [created_date_utc] &gt;= DATEADD(&apos;week&apos;,-11,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [created_date_utc] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Daily&apos; THEN [created_date_utc] &gt;= DATEADD(&apos;day&apos;,-12,TODAY()) AND [created_date_utc] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Monthly + MTD&apos; THEN [created_date_utc] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [created_date_utc] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Weekly + WTD&apos; THEN [created_date_utc] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [created_date_utc] &lt; TODAY()&#10;END' />
            </column>
            <column caption='Dynamic Date Range' datatype='string' name='[Calculation_6346557085063688194]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 2] = &apos;Weekly&apos; OR [Parameters].[Parameter 2] = &apos;Week + WTD&apos;) THEN STR(DATEPART(&apos;iso-year&apos;,[created_date_utc]))+&apos;-&apos;+STR(DATEPART(&apos;iso-week&apos;,[created_date_utc]))&#10;ELSEIF([Parameters].[Parameter 2] = &apos;Monthly&apos; OR [Parameters].[Parameter 2] = &apos;Month + MTD&apos;) THEN LEFT(STR(DATENAME(&apos;month&apos;,[created_date_utc])),3)+&apos; &apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[created_date_utc])),2)&#10;ELSEIF ([Parameters].[Parameter 2] = &apos;Quarterly&apos; OR [Parameters].[Parameter 2] = &apos;Quarterly + MTD&apos;) THEN &quot;Q&quot;+STR(DATENAME(&apos;quarter&apos;,[created_date_utc]))+&apos;-&apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[created_date_utc])),2)&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Daily&apos; then str(DATEPART(&apos;day&apos;,[created_date_utc]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[created_date_utc])),3)&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Yearly&apos; then RIGHT(STR(DATEPART(&apos;year&apos;,[created_date_utc])),4)&#10;END' />
            </column>
