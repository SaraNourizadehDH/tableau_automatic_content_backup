    <worksheet name='Pre Post B2C agg new user'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Pre Post B2B agg</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cp_incrementality_pre_post' name='federated.0jb4xr70u6poo41e8fyjo0hwykfz' />
            <datasource caption='cp_incrementality_user_count' name='federated.1wiqqzs033db7o176h45t1jumf5c' />
          </datasources>
          <datasource-dependencies datasource='federated.0jb4xr70u6poo41e8fyjo0hwykfz'>
            <column caption='B2C only' datatype='boolean' name='[B2B only (copy)_4606971368153890830]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[linked_b2c] = &quot;B2C&quot;' />
            </column>
            <column caption='Net B2C Gmv Eur' datatype='real' name='[Calculation_152489084636901377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [linked_b2c] = &quot;B2B w/o B2C Linked&quot; THEN NULL ELSE [b2c_gmv_eur] END' />
            </column>
            <column caption='Total AOV' datatype='real' name='[Calculation_152489084638175234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2C&quot; THEN [Calculation_1795247419934048260] / [Calculation_1795247419927715841]&#10;ELSEIF ATTR([linked_b2c]) = &quot;B2B w/o B2C Linked&quot; THEN [Calculation_1795247419933863939] / [Calculation_1795247419927408640]&#10;ELSE ([Calculation_1795247419933863939] + [Calculation_1795247419934048260]) / ([Calculation_1795247419927408640] + [Calculation_1795247419927715841])&#10;END' />
            </column>
            <column caption='Mthly B2B AOV' datatype='real' name='[Calculation_152489084638314499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1795247419933863939]/[Calculation_1795247419927408640]' />
            </column>
            <column caption='Mthly B2C AOV' datatype='real' name='[Calculation_152489084638416900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1795247419934048260]/[Calculation_1795247419927715841]' />
            </column>
            <column caption='Mthly B2B Order' datatype='real' name='[Calculation_1795247419927408640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2C&quot;&#10;THEN (SUM([Calculation_1795247420005699589]))/(SUM([user_count]))&#10;ELSE (SUM([b2b_order]))/(SUM([user_count]))&#10;END' />
            </column>
            <column caption='Mthly B2C Order' datatype='real' name='[Calculation_1795247419927715841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2B w/o B2C Linked&quot;&#10;THEN (SUM([Calculation_74168672014299139]))/(SUM([user_count]))&#10;ELSE (SUM([b2c_order]))/(SUM([user_count]))&#10;END' />
            </column>
            <column caption='Mthly B2B GMV' datatype='real' name='[Calculation_1795247419933863939]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2C&quot;&#10;THEN (SUM([Calculation_1795247420005867526]))/(SUM([user_count]))&#10;ELSE (SUM([b2b_gmv_eur]))/(SUM([user_count]))&#10;END' />
            </column>
            <column caption='Mthly B2C GMV' datatype='real' name='[Calculation_1795247419934048260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2B w/o B2C Linked&quot;&#10;THEN (SUM([Calculation_152489084636901377]))/(SUM([user_count]))&#10;ELSE (SUM([b2c_gmv_eur]))/(SUM([user_count]))&#10;END' />
            </column>
            <column caption='Net B2B Order' datatype='integer' name='[Calculation_1795247420005699589]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [linked_b2c] = &quot;B2C&quot; THEN NULL ELSE [b2b_order] END' />
            </column>
            <column caption='Net B2B Gmv Eur' datatype='real' name='[Calculation_1795247420005867526]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [linked_b2c] = &quot;B2C&quot; THEN NULL ELSE [b2b_gmv_eur] END' />
            </column>
            <column caption='month_bucket' datatype='string' name='[Calculation_224828156770648066]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [month_ref] &gt;= -6 AND [month_ref] &lt;= -4 THEN &quot;Pre-6M&quot;&#10;ELSEIF[month_ref] &gt;= -3 AND [month_ref] &lt;= -1 THEN &quot;Pre-3M&quot;&#10;ELSEIF [month_ref] &gt;= 0 AND [month_ref] &lt;= 2 THEN &quot;Post+3M&quot;&#10;ELSEIF [month_ref] &gt;= 3 AND [month_ref] &lt;= 5 THEN &quot;Post+6M&quot;&#10;ELSEIF [month_ref] &gt;= 6 AND [month_ref] &lt;= 8 THEN &quot;Post+9M&quot;&#10;ELSEIF [month_ref] &gt;= 9 AND [month_ref] &lt;= 11 THEN &quot;Post+12M&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
            </column>
            <column caption='Order Frequency' datatype='string' name='[Calculation_224828156825808911]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Order per user&quot;' />
            </column>
            <column caption='Net B2B Flgp' datatype='real' name='[Calculation_4606971366443937792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [linked_b2c] = &quot;B2C&quot; THEN NULL ELSE [b2b_flgp_eur] END' />
            </column>
            <column caption='Net B2C Flgp' datatype='real' name='[Calculation_4606971366444236801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [linked_b2c] = &quot;B2B w/o B2C Linked&quot; THEN NULL ELSE [b2c_flgp_eur] END' />
            </column>
            <column caption='Mthly B2B Flgpo' datatype='real' name='[Calculation_4606971366444523522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2C&quot;&#10;THEN (SUM([Calculation_4606971366443937792]))/(SUM([b2b_order]))&#10;ELSE (SUM([b2b_flgp_eur]))/(SUM([b2b_order]))&#10;END' />
            </column>
            <column caption='Mthly B2B Flgpu' datatype='real' name='[Calculation_4606971366445346820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2C&quot;&#10;THEN (SUM([Calculation_4606971366443937792]))/(SUM([user_count]))&#10;ELSE (SUM([b2b_flgp_eur]))/(SUM([user_count]))&#10;END' />
            </column>
            <column caption='Mthly B2C Flgpu' datatype='real' name='[Calculation_4606971366445592581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2B w/o B2C Linked&quot;&#10;THEN (SUM([Calculation_4606971366444236801]))/(SUM([user_count]))&#10;ELSE (SUM([b2c_flgp_eur]))/(SUM([user_count]))&#10;END' />
            </column>
            <column caption='Total FLGPO' datatype='real' name='[Calculation_4606971366446698503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2C&quot; THEN [Calculation_4606971366445592581]/[Calculation_1795247419927715841]&#10;ELSEIF ATTR([linked_b2c]) = &quot;B2B w/o B2C Linked&quot; THEN [Calculation_4606971366445346820]/[Calculation_1795247419927408640]&#10;ELSE ([Calculation_4606971366445346820]+[Calculation_4606971366445592581]) / ([Calculation_1795247419927408640] + [Calculation_1795247419927715841])&#10;END' />
            </column>
            <column caption='Total FLGPU' datatype='real' name='[Calculation_4606971366446915592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [linked_b2c] = &quot;B2C&quot;&#10;    THEN [Calculation_4606971366444236801]&#10;    ELSE [b2b_flgp_eur] + [b2c_flgp_eur]&#10;    END)&#10;/&#10;SUM([user_count])' />
            </column>
            <column caption='User Start Month' datatype='string' name='[Calculation_4637018817372807168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([profile_created_month])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(MONTH([profile_created_month])), 2)' />
