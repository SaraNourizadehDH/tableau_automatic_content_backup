  <worksheets>
    <worksheet name='AOV'>
      <layout-options>
        <title>
          <formatted-text>
            <run>AOV EUR</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cp_incrementality_pre_post' name='federated.0jb4xr70u6poo41e8fyjo0hwykfz' />
          </datasources>
          <datasource-dependencies datasource='federated.0jb4xr70u6poo41e8fyjo0hwykfz'>
            <column caption='Net B2C Gmv Eur' datatype='real' name='[Calculation_152489084636901377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [linked_b2c] = &quot;B2B w/o B2C Linked&quot; THEN NULL ELSE [b2c_gmv_eur] END' />
            </column>
            <column caption='Mthly B2B AOV' datatype='real' name='[Calculation_152489084638314499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1795247419933863939]/[Calculation_1795247419927408640]' />
            </column>
            <column caption='Mthly B2C AOV' datatype='real' name='[Calculation_152489084638416900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1795247419934048260]/[Calculation_1795247419927715841]' />
            </column>
            <column caption='Mthly B2B Order' datatype='real' name='[Calculation_1795247419927408640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2C&quot;&#10;THEN (SUM([Calculation_1795247420005699589]))/(SUM([user_count]))&#10;ELSE (SUM([b2b_order]))/(SUM([user_count]))&#10;END' />
            </column>
