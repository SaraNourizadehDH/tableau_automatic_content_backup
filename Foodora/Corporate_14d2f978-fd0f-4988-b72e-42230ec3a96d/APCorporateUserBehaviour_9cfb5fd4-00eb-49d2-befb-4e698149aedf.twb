            <column caption='Net B2B Flgp' datatype='real' name='[Calculation_4606971366443937792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [linked_b2c] = &quot;B2C&quot; THEN NULL ELSE [b2b_flgp_eur] END' />
            </column>
            <column caption='Net B2C Flgp' datatype='real' name='[Calculation_4606971366444236801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [linked_b2c] = &quot;B2B w/o B2C Linked&quot; THEN NULL ELSE [b2c_flgp_eur] END' />
            </column>
            <column caption='Mthly B2B Flgpo' datatype='real' name='[Calculation_4606971366444523522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2C&quot;&#10;THEN (SUM([Calculation_4606971366443937792]))/(SUM([b2b_order]))&#10;ELSE (SUM([b2b_flgp_eur]))/(SUM([b2b_order]))&#10;END' />
            </column>
            <column caption='Mthly B2B Flgpu' datatype='real' name='[Calculation_4606971366445346820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2C&quot;&#10;THEN (SUM([Calculation_4606971366443937792]))/(SUM([user_count]))&#10;ELSE (SUM([b2b_flgp_eur]))/(SUM([user_count]))&#10;END' />
            </column>
            <column caption='Mthly B2C Flgpu' datatype='real' name='[Calculation_4606971366445592581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2B w/o B2C Linked&quot;&#10;THEN (SUM([Calculation_4606971366444236801]))/(SUM([user_count]))&#10;ELSE (SUM([b2c_flgp_eur]))/(SUM([user_count]))&#10;END' />
            </column>
            <column caption='Total FLGPO' datatype='real' name='[Calculation_4606971366446698503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([linked_b2c]) = &quot;B2C&quot; THEN [Calculation_4606971366445592581]/[Calculation_1795247419927715841]&#10;ELSEIF ATTR([linked_b2c]) = &quot;B2B w/o B2C Linked&quot; THEN [Calculation_4606971366445346820]/[Calculation_1795247419927408640]&#10;ELSE ([Calculation_4606971366445346820]+[Calculation_4606971366445592581]) / ([Calculation_1795247419927408640] + [Calculation_1795247419927715841])&#10;END' />
            </column>
            <column caption='Total FLGPU' datatype='real' name='[Calculation_4606971366446915592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [linked_b2c] = &quot;B2C&quot;&#10;    THEN [Calculation_4606971366444236801]&#10;    ELSE [b2b_flgp_eur] + [b2c_flgp_eur]&#10;    END)&#10;/&#10;SUM([user_count])' />
            </column>
            <column caption='User Start Month' datatype='string' name='[Calculation_4637018817372807168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([profile_created_month])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(MONTH([profile_created_month])), 2)' />
            </column>
            <column caption='Months' datatype='string' name='[Calculation_74168672013697026]' role='dimension' type='nominal'>
