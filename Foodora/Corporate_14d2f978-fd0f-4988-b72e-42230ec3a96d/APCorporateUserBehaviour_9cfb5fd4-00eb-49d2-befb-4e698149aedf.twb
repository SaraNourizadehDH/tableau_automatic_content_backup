    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Metric Definitions / Data Quality Checks'>
      <layout-options>
        <title>
          <formatted-text>
            <run>  &lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APCorporateIUserBehaviour/MetricDefinitionsDataQualityChecks?rev=' id='MetricDefinitionsDataQualityChecks' path='/t/Foodora/workbooks/APCorporateUserBehaviour' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-title'>
          <format attr='background-color' value='#d90663' />
          <format attr='color' value='#ffffff' />
          <format attr='font-weight' value='bold' />
          <format attr='font-family' value='Tableau Regular' />
        </style-rule>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_3' value='top' />
        </style-rule>
      </style>
      <size maxheight='1000' maxwidth='1000' minheight='1000' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98400' id='229' param='horz' type-v2='layout-flow' w='98400' x='800' y='800'>
            <zone h='98400' id='7' param='vert' type-v2='layout-flow' w='98400' x='800' y='800'>
              <zone fixed-size='58' h='6600' id='8' is-fixed='true' type-v2='title' w='98400' x='800' y='800'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='91800' id='5' type-v2='layout-basic' w='98400' x='800' y='7400'>
                <zone forceUpdate='true' h='61600' id='3' type-v2='text' w='98400' x='800' y='37600'>
                  <formatted-text>
                    <run bold='true' fontcolor='#005493' underline='true'>Definitions</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555'> -  Month 0 reference the month when the user </run>
                    <run bold='true' fontcolor='#555555' underline='true'>activate corporate / private profile</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#005493'>User Group</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555'>New User             :   User added due to B2B </run>
                    <run fontcolor='#595959'>(no B2C profile linked / B2C profile was created after B2B) </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555'>Existing User     :</run>
                    <run bold='true' fontcolor='#555555'>Æ   </run>
                    <run fontcolor='#555555'>User converted from B2B to B2C </run>
                    <run fontcolor='#595959'>(linked with existing B2C profile)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#005493'>User profile</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555'>B2B Overall                        :   User who has corporate profile</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555'>B2B with B2C Linked     :   User who has corproate profile linked with private profile </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555'>B2B w/o B2C Linked       :   User who has corporate profile only</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555'>B2C                                         :   User who has private profile only</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555'>With allowance only     :   User who has at least 1 allowance only as a perk from their company</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555'>With pp only                      :   User who has at least 1 pandapro only as a perk from their company</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555'>With allowance &amp; pp     :    User how has at least 1 allowance and 1 pandapro as a perk from their company</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#005493' underline='true'>Notes</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555'>1. Existing users who either create a new B2C account for B2B linkage or have never linked their B2C account are categorized as new users. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555'>2. </run>
                    <run bold='true' fontcolor='#555555'>FLGP in the data are platform FLGP, may not be 100% accurate for dmart orders</run>
                    <run fontcolor='#555555'>.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555'>3. FLGP data only available for orders start from 2022. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555'>4. The categorization of allowance and pp is based on whether a user has at least one allowance or at least one Pandapro subscription after onboarding.</run>
                    <run>Æ&#10;&#10;&#10;&#10;</run>
                    <run bold='true' fontcolor='#005493' underline='true'>Useful Dashboards for User Behaviour</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#555555'>MKT User Stickiness</run>
                    <run fontcolor='#555555'>:</run>
                    <run>Æ&#10;</run>
                    <run auto-url='true' fontcolor='#555555' hyperlink='tabdoc:load-url url=&amp;quot;https://tableau.deliveryhero.net/#/site/Foodora/views/APUserCohorts/AcquisitionCohorts?:iid=1https://tableau.deliveryhero.net/#/site/Foodora/views/APUserCohorts/AcquisitionCohorts?:iid=1&amp;quot;'>https://tableau.deliveryhero.net/#/site/Foodora/views/APUserCohorts/AcquisitionCohorts?:iid=1https://tableau.deliveryhero.net/#/site/Foodora/views/APUserCohorts/AcquisitionCohorts?:iid=1</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#555555'>MKT User Lifecycles:</run>
                    <run>Æ&#10;</run>
                    <run auto-url='true' fontcolor='#555555' hyperlink='tabdoc:load-url url=&amp;quot;https://tableau.deliveryhero.net/#/site/Foodora/views/LifecycleInsights/EarlyLifecycle?:iid=1&amp;quot;'>https://tableau.deliveryhero.net/#/site/Foodora/views/LifecycleInsights/EarlyLifecycle?:iid=1</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#555555'>MKT User CPA Cost:</run>
                    <run>Æ&#10;</run>
                    <run auto-url='true' fontcolor='#555555' hyperlink='tabdoc:load-url url=&amp;quot;https://tableau.deliveryhero.net/#/site/Foodora/views/APUserCohorts/AcquisitionPerformanceOverall?:iid=1&amp;quot;'>https://tableau.deliveryhero.net/#/site/Foodora/views/APUserCohorts/AcquisitionPerformanceOverall?:iid=1</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='27000' id='227' name='data definition and checks' w='98400' x='800' y='7400'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='3200' id='230' param='horz' type-v2='layout-flow' w='98400' x='800' y='34400' />
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
