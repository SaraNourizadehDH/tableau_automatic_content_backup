            <column-instance column='[date_local_week]' derivation='Max' name='[max:date_local_week:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[date_local_week]' derivation='None' name='[none:date_local_week:nk]' pivot='key' type='nominal' />
