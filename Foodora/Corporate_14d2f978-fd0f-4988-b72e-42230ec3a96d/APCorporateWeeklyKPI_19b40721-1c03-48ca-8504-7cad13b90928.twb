          <datasource-dependencies datasource='federated.1dbpo1p0sa8i5w161rqya03yx9v8'>
            <column caption='WoW Δ (%) TOTAL GIFT CARD GTV EUR' datatype='string' name='[Calculation_2720314974688169990]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos; THEN (&#10;IF (&#10;(SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [total_gtv_eur] end) &#10;- SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_gtv_eur] end)) &#10;/ SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_gtv_eur] end))&#10;&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;((SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [total_gtv_eur] end) &#10;- SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_gtv_eur] end)) &#10;/ SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_gtv_eur] end))&#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Month&apos; THEN (&#10;IF ( &#10;(SUM(if LEFT([Calculation_684547188204953648],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_gtv_eur] end)&#10;- SUM(if LEFT([Calculation_684547188204953648],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_gtv_eur] end))&#10;/ SUM(if LEFT([Calculation_684547188204953648],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_gtv_eur] end))&#10;&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;((SUM(if LEFT([Calculation_684547188204953648],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_gtv_eur] end)&#10;- SUM(if LEFT([Calculation_684547188204953648],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_gtv_eur] end))&#10;/ SUM(if LEFT([Calculation_684547188204953648],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_gtv_eur] end))&#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Day&apos; THEN (&#10;IF ( &#10;(SUM(if [Calculation_684547188204953648] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-1,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-1,TODAY()))),3) THEN [total_gtv_eur] end)&#10;- SUM(if [Calculation_684547188204953648] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [total_gtv_eur] end))&#10;/ SUM(if [Calculation_684547188204953648] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [total_gtv_eur] end)) &#10;&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;((SUM(if [Calculation_684547188204953648] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-1,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-1,TODAY()))),3) THEN [total_gtv_eur] end)&#10;- SUM(if [Calculation_684547188204953648] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [total_gtv_eur] end))&#10;/ SUM(if [Calculation_684547188204953648] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [total_gtv_eur] end)) &#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;&#10;END' />
