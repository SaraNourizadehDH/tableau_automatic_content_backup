            <column-instance column='[MTD Δ (%) Corps Signed (copy)_612841440358096913]' derivation='User' name='[usr:MTD Δ (%) Corps Signed (copy)_612841440358096913:nk]' pivot='key' type='nominal' />
            <column-instance column='[MTD Δ (%) Corps Signed Colour (copy)_612841440358096914]' derivation='User' name='[usr:MTD Δ (%) Corps Signed Colour (copy)_612841440358096914:nk]' pivot='key' type='nominal' />
