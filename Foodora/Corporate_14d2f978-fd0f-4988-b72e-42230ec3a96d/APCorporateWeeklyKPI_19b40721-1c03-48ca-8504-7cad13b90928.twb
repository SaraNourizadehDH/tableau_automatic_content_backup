    <worksheet name='6a Compliant MTD'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_weekly_kpi_sales_opps' name='federated.15spowa11s8ecq1a5a7840s6o6kj' />
          </datasources>
          <datasource-dependencies datasource='federated.15spowa11s8ecq1a5a7840s6o6kj'>
            <column caption='MTD Col' datatype='integer' name='[Calculation_3781616316346118153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='MTD Δ (%) Signups' datatype='string' name='[Calculation_3781616316390301712]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    COUNT(IF [is_mtd] THEN [opportunity_id] END)&#10;    -&#10;    COUNT(IF [is_2mtd] THEN [opportunity_id] END)&#10;)&#10;&#10;/  COUNT(IF [is_2mtd] THEN [opportunity_id] END)&#10;&#10;* SIGN(COUNT(IF [is_2mtd] THEN [opportunity_id] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(ROUND(abs(&#10;(&#10;    COUNT(IF [is_mtd] THEN [opportunity_id] END)&#10;    -&#10;    COUNT(IF [is_2mtd] THEN [opportunity_id] END)&#10;&#10;)&#10;&#10;/  COUNT(IF [is_2mtd] THEN [opportunity_id] END)&#10;&#10;* 100), 1&#10;)) &#10;+ &apos;%&apos;' />
            </column>
            <column caption='MTD Δ (%) Signups Colour' datatype='string' name='[Calculation_3781616316390801425]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF LEFT([Calculation_3781616316390301712],1) = &quot;▲&quot; THEN &quot;▲&quot;&#10;ELSE &quot;▼&quot;&#10;END' />
