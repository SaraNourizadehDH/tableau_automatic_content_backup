            </column>
            <column caption='MTD Δ (%) Late Rate Colour' datatype='string' name='[MTD Δ (%) Fail Rate Colour (copy)_5738711871496810565]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;  ( (SUM(IIF ([is_MTD] ,  [dt_over_45_mins_count] ,0))&#10;        /&#10;     SUM(IIF ([is_MTD] ,  [orders_completed_less_preorder_volume] ,0))&#10;    )&#10;    -&#10;    (SUM(IIF ([is_2MTD] ,  [dt_over_45_mins_count] ,0))&#10;        /&#10;     SUM(IIF ([is_2MTD] ,  [orders_completed_less_preorder_volume] ,0))&#10;    )  )&#10;  &#10;) &gt;=0 &#10;THEN  STR(&apos;▲&apos;) ELSE STR(&apos;▼&apos;) END' />
