            </column>
            <column caption='Country' datatype='string' name='[Calculation_2288180497450983424]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_code]=&apos;BD&apos; THEN &apos;Bangladesh&apos;&#10;ELSEIF [country_code]=&apos;HK&apos; THEN &apos;Hong Kong&apos;&#10;ELSEIF [country_code]=&apos;LA&apos; THEN &apos;Laos&apos;&#10;ELSEIF [country_code]=&apos;MY&apos; THEN &apos;Malaysia&apos;&#10;ELSEIF [country_code]=&apos;PH&apos; THEN &apos;Philippines&apos;&#10;ELSEIF [country_code]=&apos;PK&apos; THEN &apos;Pakistan&apos;&#10;ELSEIF [country_code]=&apos;SG&apos; THEN &apos;Singapore&apos;&#10;ELSEIF [country_code]=&apos;TH&apos; THEN &apos;Thailand&apos;&#10;ELSEIF [country_code]=&apos;TW&apos; THEN &apos;Taiwan&apos;&#10;END' />
            </column>
            <column caption='Record Date Filter' datatype='date' name='[Calculation_2288180497454886915]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='MTD Δ (%) Companies' datatype='string' name='[MTD Δ (%) End Users (copy)_2263973671763226634]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_mtd] THEN [company_count] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [company_count] END)&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [company_count] END)&#10;&#10;* SIGN(SUM(IF [is_2mtd] THEN [company_count] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(ROUND(abs(&#10;(&#10;    SUM(IF [is_mtd] THEN [company_count] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [company_count] END)&#10;&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [company_count] END)&#10;&#10;* 100), 1&#10;)) &#10;+ &apos;%&apos;' />
            </column>
            <column caption='MTD Δ (%) Companies Colour' datatype='string' name='[MTD Δ (%) End Users Colour (copy)_2263973671763435531]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_mtd] THEN [company_count] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [company_count] END)&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [company_count] END)&#10;&#10;* SIGN(SUM(IF [is_2mtd] THEN [company_count] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
