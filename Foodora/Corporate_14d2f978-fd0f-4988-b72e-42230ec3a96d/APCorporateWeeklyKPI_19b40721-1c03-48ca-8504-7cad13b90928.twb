    <worksheet name='5a FR Op MTD'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_weekly_kpi_ops' name='federated.1g3sziq1jrgyrb10zpeul0uhoi2v' />
          </datasources>
          <datasource-dependencies datasource='federated.1g3sziq1jrgyrb10zpeul0uhoi2v'>
            <column aggregation='Sum' caption='MTD Col' datatype='integer' name='[Calculation_5738711871227994137]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='MTD Δ (%) Fail Rate Colour' datatype='string' name='[MTD Δ (%) FCR Colour (copy)_5738711871471296577]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;  ( (SUM(IIF ([is_MTD] ,  [vendor_fail_volume]+[customer_fail_volume]+[rider_fail_volume] ,0))&#10;        /&#10;     SUM(IIF ([is_MTD] ,  [gross_order_volume] ,0))&#10;    )&#10;    -&#10;    (SUM(IIF ([is_2MTD] ,  [vendor_fail_volume]+[customer_fail_volume]+[rider_fail_volume] ,0))&#10;        /&#10;     SUM(IIF ([is_2MTD] ,  [gross_order_volume] ,0))&#10;    )  )&#10;  &#10;) &gt;=0 &#10;THEN  STR(&apos;▲&apos;) ELSE STR(&apos;▼&apos;) END' />
            </column>
            <column caption='MTD Δ (%) Fail Rate' datatype='string' name='[MTD Δ (%) IR (copy)_5738711871469527102]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;  ( (SUM(IIF ([is_MTD] ,  [vendor_fail_volume]+[customer_fail_volume]+[rider_fail_volume] ,0))&#10;        /&#10;     SUM(IIF ([is_MTD] ,  [gross_order_volume] ,0))&#10;    )&#10;    -&#10;    (SUM(IIF ([is_2MTD] ,  [vendor_fail_volume]+[customer_fail_volume]+[rider_fail_volume] ,0))&#10;        /&#10;     SUM(IIF ([is_2MTD] ,  [gross_order_volume] ,0))&#10;    )  )&#10;   &#10;) &gt;=0 &#10;&#10;THEN  STR(&apos;▲&apos;) ELSE STR(&apos;▼&apos;) END&#10;&#10;+&apos; &apos;+&#10;&#10;STR( ROUND(ABS( &#10;       &#10;   ( (SUM(IIF ([is_MTD] ,  [vendor_fail_volume]+[customer_fail_volume]+[rider_fail_volume] ,0))&#10;        /&#10;     SUM(IIF ([is_MTD] ,  [gross_order_volume] ,0))&#10;    )&#10;    -&#10;    (SUM(IIF ([is_2MTD] ,  [vendor_fail_volume]+[customer_fail_volume]+[rider_fail_volume] ,0))&#10;        /&#10;     SUM(IIF ([is_2MTD] ,  [gross_order_volume] ,0))&#10;    )  )&#10;    / (SUM(IIF ([is_2MTD] ,  [vendor_fail_volume]+[customer_fail_volume]+[rider_fail_volume] ,0))&#10;        /&#10;     SUM(IIF ([is_2MTD] ,  [gross_order_volume] ,0))&#10;    )  &#10;&#10;&#10; * 100)        ,1))&#10;&#10;+ &apos;%&apos;' />
            </column>
