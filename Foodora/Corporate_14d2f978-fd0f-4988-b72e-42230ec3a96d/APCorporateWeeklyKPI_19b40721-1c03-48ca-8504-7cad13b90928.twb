          <datasource-dependencies datasource='federated.1cwb42e0gc4vrm1attwll1dfsaeu'>
            <column caption='WoW Col' datatype='integer' datatype-customized='true' name='[Calculation_-4792392890779615229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='LW % Δ' />
              </aliases>
            </column>
            <column caption='WoW Δ (%) Users With Orders Colour PP' datatype='string' name='[WoW Δ (%) Company With Orders Colour PP (copy)_3438216882156167176]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;(&#13;&#10;    AVG(IF [is_last_week] THEN [main_pp_customer_count] END)&#13;&#10;    -&#13;&#10;    AVG(IF [is_2last_week] THEN [main_pp_customer_count] END)&#13;&#10;)&#13;&#10;&#13;&#10;/  AVG(IF [is_2last_week] THEN [main_pp_customer_count] END)&#13;&#10;&#13;&#10;* SIGN(AVG(IF [is_2last_week] THEN [main_pp_customer_count] END))&#13;&#10;&#13;&#10;&gt;= 0&#13;&#10;&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='WoW Δ (%) Users With Orders PP' datatype='string' name='[WoW Δ (%) Company With Orders PP (copy)_3438216882157432842]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;(&#13;&#10;    AVG(IF [is_last_week] THEN [main_pp_customer_count] END)&#13;&#10;    -&#13;&#10;    AVG(IF [is_2last_week] THEN [main_pp_customer_count] END)&#13;&#10;)&#13;&#10;&#13;&#10;/  AVG(IF [is_2last_week] THEN [main_pp_customer_count] END)&#13;&#10;&#13;&#10;* SIGN(AVG(IF [is_2last_week] THEN [main_pp_customer_count] END))&#13;&#10;&#13;&#10;&gt;= 0&#13;&#10;&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(ROUND(abs(&#13;&#10;(&#13;&#10;    AVG(IF [is_last_week] THEN [main_pp_customer_count] END)&#13;&#10;    -&#13;&#10;    AVG(IF [is_2last_week] THEN [main_pp_customer_count] END)&#13;&#10;&#13;&#10;)&#13;&#10;&#13;&#10;/  AVG(IF [is_2last_week] THEN [main_pp_customer_count] END)&#13;&#10;&#13;&#10;* 100), 1&#13;&#10;)) &#13;&#10;+ &apos;%&apos;' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Is 2Last Week' datatype='boolean' name='[is_2last_week]' role='dimension' type='nominal' />
            <column caption='Is Last Week' datatype='boolean' name='[is_last_week]' role='dimension' type='nominal' />
            <column caption='Main Pp Customer Count' datatype='integer' name='[main_pp_customer_count]' role='measure' type='quantitative' />
