    <worksheet name='2a FCR Op MTD'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_weekly_kpi_ops' name='federated.1g3sziq1jrgyrb10zpeul0uhoi2v' />
          </datasources>
          <datasource-dependencies datasource='federated.1g3sziq1jrgyrb10zpeul0uhoi2v'>
            <column caption='FCR %_cm' datatype='real' name='[CSAT %_cm (copy)_5738711871431684141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([shared_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([shared_date]) &lt;= DAY(TODAY()-2)&#10;THEN ZN([num_fcr]) / ZN([ticket_count])&#10;END' />
            </column>
            <column caption='FCR %_lm' datatype='real' name='[CSAT %_lm (copy)_5738711871431696430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([shared_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#10;AND DAY([shared_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#10;THEN ZN([num_fcr]) / ZN([ticket_count])&#10;END' />
            </column>
            <column aggregation='Sum' caption='MTD Col' datatype='integer' name='[Calculation_5738711871227994137]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='MTD Δ (%) FCR' datatype='string' name='[MTD Δ (%) CSAT Score (copy)_5738711871432310831]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([CSAT %_cm (copy)_5738711871431684141]) / SUM([CSAT %_lm (copy)_5738711871431696430])) - 1) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(((SUM([CSAT %_cm (copy)_5738711871431684141]) / SUM([CSAT %_lm (copy)_5738711871431696430])) - 1)*100,1)&#10;)&#10;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='MTD Δ (%) FCR Colour' datatype='string' name='[MTD Δ (%) CSAT Score Colour (copy)_5738711871431634988]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([CSAT %_cm (copy)_5738711871431684141]) / SUM([CSAT %_lm (copy)_5738711871431696430])) - 1) &gt;= 0&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_5738711871227994137]' derivation='None' name='[none:Calculation_5738711871227994137:ok]' pivot='key' type='ordinal' />
