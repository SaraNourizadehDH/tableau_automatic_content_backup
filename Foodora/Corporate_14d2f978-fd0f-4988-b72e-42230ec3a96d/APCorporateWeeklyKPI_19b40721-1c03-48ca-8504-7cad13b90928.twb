            <column-instance column='[MTD Δ (%) QA (copy)_5738711871448125498]' derivation='User' name='[usr:MTD Δ (%) QA (copy)_5738711871448125498:nk]' pivot='key' type='nominal' />
            <column-instance column='[MTD Δ (%) QA Colour (copy)_5738711871448125499]' derivation='User' name='[usr:MTD Δ (%) QA Colour (copy)_5738711871448125499:nk]' pivot='key' type='nominal' />
