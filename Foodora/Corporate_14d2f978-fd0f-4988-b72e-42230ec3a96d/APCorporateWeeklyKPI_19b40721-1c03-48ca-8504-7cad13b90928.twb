    <worksheet name='9c Gross Order Cnt Weekly'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular'>Overall Corporate Orders</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular'>(Gross Orders)</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_weekly_kpi_ops' name='federated.1g3sziq1jrgyrb10zpeul0uhoi2v' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Dynamic Date Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Month&quot;' value='Month' />
                <alias key='&quot;Week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1g3sziq1jrgyrb10zpeul0uhoi2v'>
            <column caption='Dynamic Column Name' datatype='string' name='[Calculation_5738711871219757074]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Day&apos; then &apos;Daily&apos;&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then &apos;Week&apos;&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then &apos;Month&apos;&#10;END' />
              <aliases>
                <alias key='&quot;Week&quot;' value='LW % Δ' />
              </aliases>
            </column>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_5738711871220162580]' role='dimension' type='nominal'>
