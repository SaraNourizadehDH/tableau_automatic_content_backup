              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Month&apos; THEN [shared_date] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [shared_date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN [shared_date] &gt;= DATEADD(&apos;week&apos;,-7,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [shared_date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; THEN [shared_date] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [shared_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month + MTD&apos; THEN [shared_date] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [shared_date] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week + WTD&apos; THEN [shared_date] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [shared_date] &lt; TODAY()&#10;END' />
            </column>
            <column caption='Dynamic Date Range' datatype='string' name='[Calculation_5738711871220273173]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then str(DATEPART(&apos;iso-year&apos;,[shared_date]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[shared_date]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; then str(DATEPART(&apos;day&apos;,[shared_date]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[shared_date])),3)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then LEFT(str(DATENAME(&apos;month&apos;,[shared_date])),3)+&apos; &apos;+ right(str(DATEPART(&apos;year&apos;,[shared_date])),2) end' />
