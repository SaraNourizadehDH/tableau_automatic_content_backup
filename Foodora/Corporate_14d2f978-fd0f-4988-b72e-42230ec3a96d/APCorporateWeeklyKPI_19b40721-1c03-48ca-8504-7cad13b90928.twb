              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Week Max Date' datatype='boolean' name='[Month Max Date (copy)_1312799338954952705]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date]={FIXED DATETRUNC(&apos;iso-week&apos;,[report_date]): MAX([report_date])}' />
            </column>
            <column caption='WoW Δ (%) Companies' datatype='string' name='[WoW Δ (%) End Users (copy)_2263973671761694728]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_last_week] THEN [company_count] END)&#10;    -&#10;    SUM(IF [is_2last_week] THEN [company_count] END)&#10;)&#10;&#10;/  SUM(IF [is_2last_week] THEN [company_count] END)&#10;&#10;* SIGN(SUM(IF [is_2last_week] THEN [company_count] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(ROUND(abs(&#10;(&#10;    SUM(IF [is_last_week] THEN [company_count] END)&#10;    -&#10;    SUM(IF [is_2last_week] THEN [company_count] END)&#10;&#10;)&#10;&#10;/  SUM(IF [is_2last_week] THEN [company_count] END)&#10;&#10;* 100), 1&#10;)) &#10;+ &apos;%&apos;' />
