      <column caption='Pass or Fail' datatype='string' name='[Calculation_925349021258133504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [type_of_date] = &quot;day&quot; THEN&#10;    IF DATE([latest_week]) &gt;= TODAY() - 1 THEN&#10;        &quot;Pass&quot;&#10;    ELSE&#10;        &quot;Fail&quot;&#10;    END&#10;ELSEIF [type_of_date] = &quot;week&quot; THEN&#10;    IF int(RIGHT([latest_week],2)) &gt;= [Calculation_351562283407028225] THEN&#10;        &quot;Pass&quot;&#10;    ELSE&#10;        &quot;Fail&quot;&#10;    END&#10;ELSEIF [type_of_date] = &quot;month&quot; THEN&#10;    IF DATE([latest_week]) = DATETRUNC(&apos;month&apos;, TODAY() - 1) THEN&#10;        &quot;Pass&quot;&#10;    ELSE&#10;        &quot;Fail&quot;&#10;    END&#10;END' />
      </column>
