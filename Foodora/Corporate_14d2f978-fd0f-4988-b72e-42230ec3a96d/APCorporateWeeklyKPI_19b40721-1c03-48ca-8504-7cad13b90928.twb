            </column>
            <column caption='MTD Δ (%) New Signed Users' datatype='string' name='[Calculation_1211186857580605445]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_mtd] THEN [new_signed_users] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [new_signed_users] END)&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [new_signed_users] END)&#10;&#10;* SIGN(SUM(IF [is_2mtd] THEN [new_signed_users] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(ROUND(abs(&#10;(&#10;    SUM(IF [is_mtd] THEN [new_signed_users] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [new_signed_users] END)&#10;&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [new_signed_users] END)&#10;&#10;* 100), 1&#10;)) &#10;+ &apos;%&apos;' />
            </column>
            <column caption='MTD Δ (%) New Signed Users Colour' datatype='string' name='[Calculation_1211186857580843014]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_mtd] THEN [new_signed_users] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [new_signed_users] END)&#10;)&#10;&#10;/  SUM(IF [is_2mtd]  THEN [new_signed_users] END)&#10;&#10;* SIGN(SUM(IF [is_2mtd]  THEN [new_signed_users] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Is 2Mtd' datatype='boolean' name='[is_2mtd]' role='dimension' type='nominal' />
            <column caption='Is Mtd' datatype='boolean' name='[is_mtd]' role='dimension' type='nominal' />
            <column caption='New Signed Users' datatype='integer' name='[new_signed_users]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1211186857577586689]' derivation='None' name='[none:Calculation_1211186857577586689:ok]' pivot='key' type='ordinal' />
