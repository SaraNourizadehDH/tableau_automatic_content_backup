    <worksheet name='8a FR Cnt MTD'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_weekly_kpi_ops' name='federated.1g3sziq1jrgyrb10zpeul0uhoi2v' />
          </datasources>
          <datasource-dependencies datasource='federated.1g3sziq1jrgyrb10zpeul0uhoi2v'>
            <column caption='Fail Rate Count_cm' datatype='integer' name='[CSAT Count_cm (copy)_882987053222068228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([shared_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([shared_date]) &lt;= DAY(TODAY()-2)&#10;THEN [vendor_fail_volume]+[customer_fail_volume]+[rider_fail_volume]&#10;END' />
            </column>
            <column caption='Fail Rate Count_lm' datatype='integer' name='[CSAT Count_lm (copy)_882987053222068229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([shared_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#10;AND DAY([shared_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#10;THEN [vendor_fail_volume]+[customer_fail_volume]+[rider_fail_volume]&#10;END' />
            </column>
            <column aggregation='Sum' caption='MTD Col' datatype='integer' name='[Calculation_5738711871227994137]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='MTD Δ (%) Fail Rate Count' datatype='string' name='[MTD Δ (%) CSAT Count (copy)_882987053222756358]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([CSAT Count_cm (copy)_882987053222068228]) / SUM([CSAT Count_lm (copy)_882987053222068229])) - 1) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(((SUM([CSAT Count_cm (copy)_882987053222068228]) / SUM([CSAT Count_lm (copy)_882987053222068229])) - 1)*100,1)&#10;)&#10;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='MTD Δ (%) Fail Rate Count Colour' datatype='string' name='[MTD Δ (%) CSAT Count Colour (copy)_882987053221957635]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([CSAT Count_cm (copy)_882987053222068228]) / SUM([CSAT Count_lm (copy)_882987053222068229])) - 1) &gt;= 0&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Customer Fail Volume' datatype='integer' name='[customer_fail_volume]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_5738711871227994137]' derivation='None' name='[none:Calculation_5738711871227994137:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[shared_date]' derivation='None' name='[none:shared_date:qk]' pivot='key' type='quantitative' />
            <column caption='Rider Fail Volume' datatype='integer' name='[rider_fail_volume]' role='measure' type='quantitative' />
            <column caption='Shared Date' datatype='date' name='[shared_date]' role='dimension' type='ordinal' />
            <column-instance column='[MTD Δ (%) CSAT Count (copy)_882987053222756358]' derivation='User' name='[usr:MTD Δ (%) CSAT Count (copy)_882987053222756358:nk]' pivot='key' type='nominal' />
            <column-instance column='[MTD Δ (%) CSAT Count Colour (copy)_882987053221957635]' derivation='User' name='[usr:MTD Δ (%) CSAT Count Colour (copy)_882987053221957635:nk]' pivot='key' type='nominal' />
            <column caption='Vendor Fail Volume' datatype='integer' name='[vendor_fail_volume]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1g3sziq1jrgyrb10zpeul0uhoi2v].[none:country:nk]'>
            <groupfilter function='level-members' level='[none:country:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
