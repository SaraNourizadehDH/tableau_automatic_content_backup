    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Description'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APCorporateWeeklyKPI_16896683775550/Description?rev=' id='Description' path='/t/Foodora/workbooks/APCorporateWeeklyKPI' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_105' value='top' />
          <format attr='wrap' id='dash-text_105' value='off' />
          <format attr='text-orientation' id='dash-text_105' value='0' />
        </style-rule>
      </style>
      <size maxheight='1000' maxwidth='1260' minheight='1000' minwidth='1260' preset-index='17' sizing-mode='fixed' />
      <zones>
        <zone h='98666' id='626' param='vert' type-v2='layout-flow' w='98730' x='635' y='667'>
          <zone fixed-size='115' h='11500' id='627' is-fixed='true' param='horz' type-v2='layout-flow' w='98730' x='635' y='667'>
            <zone fixed-size='215' h='11500' id='164' is-fixed='true' type-v2='text' w='17698' x='635' y='667'>
              <formatted-text>
                <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='24'>    foodpanda</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#b00f53' />
              </zone-style>
            </zone>
            <zone forceUpdate='true' h='11500' id='165' type-v2='text' w='81032' x='18333' y='667'>
              <formatted-text>
                <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='22'>   Definitions</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#e6e6e6' />
              </zone-style>
            </zone>
          </zone>
          <zone forceUpdate='true' h='34800' id='105' type-v2='text' w='98730' x='635' y='12167'>
            <formatted-text>
              <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>Purpose/ Description</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='8'>- Weekly performance tracking for all important Corporate metrics  </run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='8'>- Refreshes weekly</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>How to use the dashboard (tabs)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Corporate Weekly Overview: </run>
              <run fontcolor='#555555' fontsize='8'>Weekly overview of Corporate GMV &amp; GTV, users &amp; corporations  and Operstions CSAT</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Pandapro Weekly Overview: </run>
              <run fontcolor='#555555' fontsize='8'>Weekly overview of pandapro subscribers, orders and revenue</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Commercial Weekly Overview: </run>
              <run fontcolor='#555555' fontsize='8'>Weekly overview of Commercial OKRs (opportunities per sales rep and New &amp; Existing GMV) and Commercial Metrics </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Operations Weekly Overview: </run>
              <run fontcolor='#555555' fontsize='8'>Weekly overview Operations OKRs and Metrics (fail rate, CSAT, QA score, first contact resolution, delivery time)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Allowance Weekly Overview: </run>
              <run fontcolor='#555555' fontsize='8'>Weekly overview of allowance orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Catering Weekly Overview: </run>
              <run fontcolor='#555555' fontsize='8'>Weekly overview of catering orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Evergreen discount Weekly Overview: </run>
              <run fontcolor='#555555' fontsize='8'>Weekly overview of evergreen discount orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Pandamart Weekly Overview: </run>
              <run fontcolor='#555555' fontsize='8'>Weekly overview of catering orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Shops Weekly Overview: </run>
              <run fontcolor='#555555' fontsize='8'>Weekly overview of shops orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Voucher Shop Weekly Overview: </run>
              <run fontcolor='#555555' fontsize='8'>Weekly overview of voucher shop orders</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>POCs</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='8'>Please reach out in #pandata-corporate if there are any issues.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='1669' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='1668' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone fixed-size='215' h='11500' id='164' type-v2='text' w='17698' x='635' y='667'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='24'>    foodpanda</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#b00f53' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='11500' id='165' type-v2='text' w='81032' x='18333' y='667'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='22'>   Definitions</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#e6e6e6' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='34800' id='105' type-v2='text' w='98730' x='635' y='12167'>
                  <formatted-text>
                    <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>Purpose/ Description</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='8'>- Weekly performance tracking for all important Corporate metrics  </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='8'>- Refreshes weekly</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>How to use the dashboard (tabs)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Corporate Weekly Overview: </run>
                    <run fontcolor='#555555' fontsize='8'>Weekly overview of Corporate GMV &amp; GTV, users &amp; corporations  and Operstions CSAT</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Pandapro Weekly Overview: </run>
                    <run fontcolor='#555555' fontsize='8'>Weekly overview of pandapro subscribers, orders and revenue</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Commercial Weekly Overview: </run>
                    <run fontcolor='#555555' fontsize='8'>Weekly overview of Commercial OKRs (opportunities per sales rep and New &amp; Existing GMV) and Commercial Metrics </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Operations Weekly Overview: </run>
                    <run fontcolor='#555555' fontsize='8'>Weekly overview Operations OKRs and Metrics (fail rate, CSAT, QA score, first contact resolution, delivery time)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Allowance Weekly Overview: </run>
                    <run fontcolor='#555555' fontsize='8'>Weekly overview of allowance orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Catering Weekly Overview: </run>
                    <run fontcolor='#555555' fontsize='8'>Weekly overview of catering orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Evergreen discount Weekly Overview: </run>
                    <run fontcolor='#555555' fontsize='8'>Weekly overview of evergreen discount orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Pandamart Weekly Overview: </run>
                    <run fontcolor='#555555' fontsize='8'>Weekly overview of catering orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Shops Weekly Overview: </run>
                    <run fontcolor='#555555' fontsize='8'>Weekly overview of shops orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Voucher Shop Weekly Overview: </run>
                    <run fontcolor='#555555' fontsize='8'>Weekly overview of voucher shop orders</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>POCs</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#555555' fontsize='8'>Please reach out in #pandata-corporate if there are any issues.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
