          <datasource-dependencies datasource='federated.1t4my7f1b5s3q51d1tksz00x18tl'>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_1312799338978664450]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] &gt;= DATEADD(&apos;week&apos;,-7,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [report_date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))' />
            </column>
            <column caption='WoW Δ (%) End Users' datatype='string' name='[Calculation_1312799339005018117]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_last_week] THEN [end_user_count] END)&#10;    -&#10;    SUM(IF [is_2last_week] THEN [end_user_count] END)&#10;)&#10;&#10;/  SUM(IF [is_2last_week] THEN [end_user_count] END)&#10;&#10;* SIGN(SUM(IF [is_2last_week] THEN [end_user_count] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(ROUND(abs(&#10;(&#10;    SUM(IF [is_last_week] THEN [end_user_count] END)&#10;    -&#10;    SUM(IF [is_2last_week] THEN [end_user_count] END)&#10;&#10;)&#10;&#10;/  SUM(IF [is_2last_week] THEN [end_user_count] END)&#10;&#10;* 100), 1&#10;)) &#10;+ &apos;%&apos;' />
            </column>
            <column caption='WoW Δ (%) End Users Colour' datatype='string' name='[Calculation_1312799339006693383]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_last_week] THEN [end_user_count] END)&#10;    -&#10;    SUM(IF [is_2last_week] THEN [end_user_count] END)&#10;)&#10;&#10;/  SUM(IF [is_2last_week] THEN [end_user_count] END)&#10;&#10;* SIGN(SUM(IF [is_2last_week] THEN [end_user_count] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='Country' datatype='string' name='[Calculation_2288180497450983424]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_code]=&apos;BD&apos; THEN &apos;Bangladesh&apos;&#10;ELSEIF [country_code]=&apos;HK&apos; THEN &apos;Hong Kong&apos;&#10;ELSEIF [country_code]=&apos;LA&apos; THEN &apos;Laos&apos;&#10;ELSEIF [country_code]=&apos;MY&apos; THEN &apos;Malaysia&apos;&#10;ELSEIF [country_code]=&apos;PH&apos; THEN &apos;Philippines&apos;&#10;ELSEIF [country_code]=&apos;PK&apos; THEN &apos;Pakistan&apos;&#10;ELSEIF [country_code]=&apos;SG&apos; THEN &apos;Singapore&apos;&#10;ELSEIF [country_code]=&apos;TH&apos; THEN &apos;Thailand&apos;&#10;ELSEIF [country_code]=&apos;TW&apos; THEN &apos;Taiwan&apos;&#10;END' />
            </column>
            <column caption='WoW Col' datatype='integer' name='[Calculation_2288180497454215169]' role='measure' type='quantitative'>
