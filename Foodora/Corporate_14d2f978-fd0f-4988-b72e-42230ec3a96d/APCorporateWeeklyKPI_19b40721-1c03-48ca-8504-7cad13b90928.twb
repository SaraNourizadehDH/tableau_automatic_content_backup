      <column caption='Weekly CSAT Colour' datatype='real' name='[Calculation_5738711871233875997]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE([Calculation_5738711871220563990])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CSAT %_cm' datatype='real' name='[Calculation_5738711871236223006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MONTH([shared_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([shared_date]) &lt;= DAY(TODAY()-2)&#10;THEN ZN([csat_4_5]) / ZN([total_responses])&#10;END' />
      </column>
      <column caption='CSAT %_lm' datatype='real' name='[Calculation_5738711871236452383]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if MONTH([shared_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#10;AND DAY([shared_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#10;THEN ZN([csat_4_5]) / ZN([total_responses])&#10;END' />
      </column>
      <column caption='FCR' datatype='real' name='[Calculation_5738711871249641505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_fcr]) / SUM([ticket_count])' />
      </column>
      <column caption='QA' datatype='real' name='[Calculation_5738711871250513955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([qa_score_total]) / SUM([total_interactions_evaluated])) / 100' />
      </column>
      <column caption='Incident Rate' datatype='real' name='[Calculation_5738711871251456038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([total_chats])+ZN([incoming_cases]))/SUM(ZN([gross_order_count]))' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_5738711871252422695]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//excludes pending &amp; in-progress orders&#10;(SUM(vendor_fail_volume)+SUM(customer_fail_volume)+SUM(rider_fail_volume))&#10;/&#10;SUM([gross_order_volume])' />
