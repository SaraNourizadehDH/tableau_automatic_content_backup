              <calculation class='tableau' formula='IF &#13;&#10;(&#13;&#10;    AVG(IF [is_last_week] THEN [main_total_company_count_voucher_shop] END)&#13;&#10;    -&#13;&#10;    AVG(IF [is_2last_week] THEN [main_total_company_count_voucher_shop] END)&#13;&#10;)&#13;&#10;&#13;&#10;/  AVG(IF [is_2last_week] THEN [main_total_company_count_voucher_shop] END)&#13;&#10;&#13;&#10;* SIGN(AVG(IF [is_2last_week] THEN [main_total_company_count_voucher_shop] END))&#13;&#10;&#13;&#10;&gt;= 0&#13;&#10;&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(ROUND(abs(&#13;&#10;(&#13;&#10;    AVG(IF [is_last_week] THEN [main_total_company_count_voucher_shop] END)&#13;&#10;    -&#13;&#10;    AVG(IF [is_2last_week] THEN [main_total_company_count_voucher_shop] END)&#13;&#10;&#13;&#10;)&#13;&#10;&#13;&#10;/  AVG(IF [is_2last_week] THEN [main_total_company_count_voucher_shop] END)&#13;&#10;&#13;&#10;* 100), 1&#13;&#10;)) &#13;&#10;+ &apos;%&apos;' />
