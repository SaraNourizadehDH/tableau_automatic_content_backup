      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_weekly_kpi_gmv' name='federated.1fc3orj1gfbzu115dr91c1lph96d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Dynamic Date Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Month&quot;' value='Month' />
                <alias key='&quot;Week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fc3orj1gfbzu115dr91c1lph96d'>
            <column caption='WoW Δ (%) Orders Colour' datatype='string' name='[Calculation_2022890300486570010]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF LEFT([WoW Δ (%)  GMV EUR (copy)_-4792392890702880744],1) = &quot;▲&quot; THEN &quot;▲&quot;&#10;ELSE &quot;▼&quot;&#10;END' />
            </column>
            <column caption='Dynamic Date Range' datatype='string' name='[Calculation_684547188204953648]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then str(DATEPART(&apos;iso-year&apos;,[date_local]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; then str(DATEPART(&apos;day&apos;,[date_local]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[date_local])),3)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then LEFT(str(DATENAME(&apos;month&apos;,[date_local])),3)+&apos; &apos;+ right(str(DATEPART(&apos;year&apos;,[date_local])),2) end' />
            </column>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_684547188206465073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Month&apos; THEN [date_local] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN [date_local] &gt;= DATEADD(&apos;week&apos;,-7,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; THEN [date_local] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month + MTD&apos; THEN [date_local] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_local] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week + WTD&apos; THEN [date_local] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [date_local] &lt; TODAY()&#10;END' />
            </column>
            <column caption='Dynamic column name for %change' datatype='string' name='[Calculation_684547188217540659]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Day&apos; then &apos;LD % Δ&apos;&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then &apos;LW % Δ&apos;&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then &apos;LM % Δ&apos;&#10;END' />
            </column>
            <column caption='WoW Δ (%) Orders' datatype='string' name='[WoW Δ (%)  GMV EUR (copy)_-4792392890702880744]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos; THEN (&#10;IF (&#10;(SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [total_number_of_successful_orders] end) &#10;- SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_number_of_successful_orders] end)) &#10;/ SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_number_of_successful_orders] end))&#10;&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;((SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [total_number_of_successful_orders] end) &#10;- SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_number_of_successful_orders] end)) &#10;/ SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_number_of_successful_orders] end))&#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Month&apos; THEN (&#10;IF ( &#10;(SUM(if LEFT([Calculation_684547188204953648],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_number_of_successful_orders] end)&#10;- SUM(if LEFT([Calculation_684547188204953648],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_number_of_successful_orders] end))&#10;/ SUM(if LEFT([Calculation_684547188204953648],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_number_of_successful_orders] end))&#10;&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;((SUM(if LEFT([Calculation_684547188204953648],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_number_of_successful_orders] end)&#10;- SUM(if LEFT([Calculation_684547188204953648],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_number_of_successful_orders] end))&#10;/ SUM(if LEFT([Calculation_684547188204953648],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_number_of_successful_orders] end))&#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Day&apos; THEN (&#10;IF ( &#10;(SUM(if [Calculation_684547188204953648] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-1,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-1,TODAY()))),3) THEN [total_number_of_successful_orders] end)&#10;- SUM(if [Calculation_684547188204953648] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [total_number_of_successful_orders] end))&#10;/ SUM(if [Calculation_684547188204953648] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [total_number_of_successful_orders] end)) &#10;&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;((SUM(if [Calculation_684547188204953648] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-1,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-1,TODAY()))),3) THEN [total_number_of_successful_orders] end)&#10;- SUM(if [Calculation_684547188204953648] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [total_number_of_successful_orders] end))&#10;/ SUM(if [Calculation_684547188204953648] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [total_number_of_successful_orders] end)) &#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;&#10;END' />
            </column>
