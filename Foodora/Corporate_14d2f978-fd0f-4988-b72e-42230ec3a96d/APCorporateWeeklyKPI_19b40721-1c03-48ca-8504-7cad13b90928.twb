    <worksheet name='2c GMV Weekly Corp'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular'>Overall Corporate Orders GMV</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular'>(excludes Voucher Shop GMV)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_weekly_kpi_gmv' name='federated.1fc3orj1gfbzu115dr91c1lph96d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Dynamic Date Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Month&quot;' value='Month' />
                <alias key='&quot;Week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fc3orj1gfbzu115dr91c1lph96d'>
            <column caption='WoW Col' datatype='integer' datatype-customized='true' name='[Calculation_-4792392890779615229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='LW % Δ' />
              </aliases>
            </column>
            <column caption='L7D AVG GMV EUR Corp' datatype='real' name='[Calculation_2022890300484669445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(sum([Calculation_2022890300614664220]), first(), first()+6)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Weekly GMV Corp Colour' datatype='integer' name='[Calculation_2022890300485873682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (sum([Calculation_2022890300614664220]) - [Calculation_2022890300484669445]) / [Calculation_2022890300484669445] &gt;= 0.2 then 2&#10;elseif (sum([Calculation_2022890300614664220]) - [Calculation_2022890300484669445]) / [Calculation_2022890300484669445] &lt;= -0.2 then -2&#10;elseif (sum([Calculation_2022890300614664220]) - [Calculation_2022890300484669445]) / [Calculation_2022890300484669445] &lt;= -0.1 then -1&#10;elseif (sum([Calculation_2022890300614664220])-[Calculation_2022890300484669445])/ [Calculation_2022890300484669445] &gt;= 0.1 then 1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='total_gmv_eur_corp' datatype='real' name='[Calculation_2022890300614664220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [corp_order_type] != &quot;Voucher Shop&quot; THEN [total_gmv_eur] ELSE 0 END' />
            </column>
            <column caption='Dynamic Column Name' datatype='string' name='[Calculation_684547188204240943]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Day&apos; then &apos;Daily&apos;&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then &apos;Week&apos;&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then &apos;Month&apos;&#10;END' />
              <aliases>
                <alias key='&quot;Week&quot;' value='LW % Δ' />
              </aliases>
            </column>
            <column caption='Dynamic Date Range' datatype='string' name='[Calculation_684547188204953648]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then str(DATEPART(&apos;iso-year&apos;,[date_local]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; then str(DATEPART(&apos;day&apos;,[date_local]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[date_local])),3)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then LEFT(str(DATENAME(&apos;month&apos;,[date_local])),3)+&apos; &apos;+ right(str(DATEPART(&apos;year&apos;,[date_local])),2) end' />
            </column>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_684547188206465073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Month&apos; THEN [date_local] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN [date_local] &gt;= DATEADD(&apos;week&apos;,-7,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; THEN [date_local] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month + MTD&apos; THEN [date_local] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_local] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week + WTD&apos; THEN [date_local] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [date_local] &lt; TODAY()&#10;END' />
            </column>
            <column caption='Corp Order Type' datatype='string' name='[corp_order_type]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
