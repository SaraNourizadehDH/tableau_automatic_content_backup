            <column caption='MTD Δ (%) PP Revenue' datatype='string' name='[MTD Δ (%) PP Subscribers (copy)_282741682658947078]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_mtd] THEN [daily_amortized_payment] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [daily_amortized_payment] END)&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [daily_amortized_payment] END)&#10;&#10;* SIGN(SUM(IF [is_2mtd] THEN [daily_amortized_payment] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(ROUND(abs(&#10;(&#10;    SUM(IF [is_mtd] THEN [daily_amortized_payment] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [daily_amortized_payment] END)&#10;&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [daily_amortized_payment] END)&#10;&#10;* 100), 1&#10;)) &#10;+ &apos;%&apos;' />
            </column>
            <column caption='MTD Δ (%) PP Revenue Colour' datatype='string' name='[MTD Δ (%) PP Subscribers Colour (copy)_282741682659217415]' role='measure' type='nominal'>
