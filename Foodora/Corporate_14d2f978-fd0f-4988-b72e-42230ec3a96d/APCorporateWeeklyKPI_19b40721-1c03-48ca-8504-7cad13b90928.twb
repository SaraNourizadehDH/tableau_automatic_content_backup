            <column caption='First Order %' datatype='real' name='[Calculation_612841440378875927]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([first_order_activated_acct])/SUM([accounts])' />
            </column>
            <column caption='Weekly First Order Colour' datatype='real' name='[Weekly Corps Signed Colour (copy)_612841440378994712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_PERCENTILE([Calculation_612841440378875927])'>
