              <calculation class='tableau' formula='IF &#10;(&#10;  ( (SUM(IIF ([is_mtd] ,  [first_order_activated_acct] ,0))&#10;        /&#10;     SUM(IIF ([is_mtd] ,  [accounts] ,0))&#10;    )&#10;    -&#10;    (SUM(IIF ([is_2mtd] ,  [first_order_activated_acct] ,0))&#10;        /&#10;     SUM(IIF ([is_2mtd] ,  [accounts] ,0))&#10;    )  )&#10;   &#10;) &gt;=0 &#10;&#10;THEN  STR(&apos;▲&apos;) ELSE STR(&apos;▼&apos;) END&#10;&#10;+&apos; &apos;+&#10;&#10;STR( ROUND(ABS( &#10;       &#10;   ( (SUM(IIF ([is_mtd] ,  [first_order_activated_acct] ,0))&#10;        /&#10;     SUM(IIF ([is_mtd] ,  [accounts] ,0))&#10;    )&#10;    -&#10;    (SUM(IIF ([is_2mtd] ,  [first_order_activated_acct] ,0))&#10;        /&#10;     SUM(IIF ([is_2mtd] ,  [accounts] ,0))&#10;    )  )&#10;    / (SUM(IIF ([is_2mtd] ,  [first_order_activated_acct] ,0))&#10;        /&#10;     SUM(IIF ([is_2mtd] ,  [accounts] ,0))&#10;    )  &#10;&#10;&#10; * 100)        ,1))&#10;&#10;+ &apos; %&apos;' />
