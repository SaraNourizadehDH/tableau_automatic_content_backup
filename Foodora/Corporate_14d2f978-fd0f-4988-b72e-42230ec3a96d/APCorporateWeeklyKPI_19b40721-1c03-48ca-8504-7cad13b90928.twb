      <column caption='Weekly Total Gift Card GMV Colour' datatype='integer' name='[Calculation_2720314974683140096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if (sum([total_gift_card_gmv]) - [Calculation_2720314974683709441]) / [Calculation_2720314974683709441] &gt;= 0.2 then 2&#10;elseif (sum([total_gift_card_gmv]) - [Calculation_2720314974683709441]) / [Calculation_2720314974683709441] &lt;= -0.2 then -2&#10;elseif (sum([total_gift_card_gmv]) - [Calculation_2720314974683709441]) / [Calculation_2720314974683709441] &lt;= -0.1 then -1&#10;elseif (sum([total_gift_card_gmv])-[Calculation_2720314974683709441])/ [Calculation_2720314974683709441] &gt;= 0.1 then 1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='L7D AVG TOTAL GC GMV' datatype='real' name='[Calculation_2720314974683709441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(sum([total_gift_card_gmv]), first(), first()+6)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MTD Δ (%) TOTAL GIFT CARD GMV EUR' datatype='string' name='[Calculation_2720314974685704194]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_mtd] THEN [total_gift_card_gmv] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [total_gift_card_gmv] END)&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [total_gift_card_gmv] END)&#10;&#10;* SIGN(SUM(IF [is_2mtd] THEN [total_gift_card_gmv] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(ROUND(abs(&#10;(&#10;    SUM(IF [is_mtd] THEN [total_gift_card_gmv] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [total_gift_card_gmv] END)&#10;&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [total_gift_card_gmv] END)&#10;&#10;* 100), 1&#10;)) &#10;+ &apos;%&apos;' />
      </column>
