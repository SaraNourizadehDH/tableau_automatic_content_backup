            <column caption='MTD Δ (%) AFV EUR' datatype='string' name='[WoW Δ (%) AFV EUR (copy)_-4792392890697150432]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;(&#13;&#10;  ( (SUM(IIF ([is_mtd] ,  [total_gfv_eur] ,0))&#13;&#10;        /&#13;&#10;     SUM(IIF ([is_mtd] ,  [total_number_of_successful_orders] ,0))&#13;&#10;    )&#13;&#10;    -&#13;&#10;    (SUM(IIF ([is_2mtd] ,  [total_gfv_eur] ,0))&#13;&#10;        /&#13;&#10;     SUM(IIF ([is_2mtd] ,  [total_number_of_successful_orders] ,0))&#13;&#10;    )  )&#13;&#10;   &#13;&#10;) &gt;=0 &#13;&#10;&#13;&#10;THEN  STR(&apos;▲&apos;) ELSE STR(&apos;▼&apos;) END&#13;&#10;&#13;&#10;+&apos; &apos;+&#13;&#10;&#13;&#10;STR( ROUND(ABS( &#13;&#10;       &#13;&#10;   ( (SUM(IIF ([is_mtd] ,  [total_gfv_eur] ,0))&#13;&#10;        /&#13;&#10;     SUM(IIF ([is_mtd] ,  [total_number_of_successful_orders] ,0))&#13;&#10;    )&#13;&#10;    -&#13;&#10;    (SUM(IIF ([is_2mtd] ,  [total_gfv_eur] ,0))&#13;&#10;        /&#13;&#10;     SUM(IIF ([is_2mtd] ,  [total_number_of_successful_orders] ,0))&#13;&#10;    )  )&#13;&#10;    / (SUM(IIF ([is_2mtd] ,  [total_gfv_eur] ,0))&#13;&#10;        /&#13;&#10;     SUM(IIF ([is_2mtd] ,  [total_number_of_successful_orders] ,0))&#13;&#10;    )  &#13;&#10;&#13;&#10;&#13;&#10; * 100)        ,1))&#13;&#10;&#13;&#10;+ &apos; %&apos;' />
            </column>
            <column caption='MTD Δ (%) AFV EUR Colour' datatype='string' name='[WoW Δ (%) AFV EUR Colour (copy)_-4792392890697797602]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;(&#13;&#10;  ( (SUM(IIF ([is_mtd] ,  [total_gfv_eur] ,0))&#13;&#10;        /&#13;&#10;     SUM(IIF ([is_mtd] ,  [total_number_of_successful_orders] ,0))&#13;&#10;    )&#13;&#10;    -&#13;&#10;    (SUM(IIF ([is_2mtd] ,  [total_gfv_eur] ,0))&#13;&#10;        /&#13;&#10;     SUM(IIF ([is_2mtd] ,  [total_number_of_successful_orders] ,0))&#13;&#10;    )  )&#13;&#10;  &#13;&#10;) &gt;=0 &#13;&#10;THEN  STR(&apos;▲&apos;) ELSE STR(&apos;▼&apos;) END' />
