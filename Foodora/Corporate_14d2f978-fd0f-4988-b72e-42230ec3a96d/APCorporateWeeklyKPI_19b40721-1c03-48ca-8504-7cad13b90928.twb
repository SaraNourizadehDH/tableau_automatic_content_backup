              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_mtd] THEN [pp_orders] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [pp_orders] END)&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [pp_orders] END)&#10;&#10;* SIGN(SUM(IF [is_2mtd] THEN [pp_orders] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(ROUND(abs(&#10;(&#10;    SUM(IF [is_mtd] THEN [pp_orders] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [pp_orders] END)&#10;&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [pp_orders] END)&#10;&#10;* 100), 1&#10;)) &#10;+ &apos;%&apos;' />
