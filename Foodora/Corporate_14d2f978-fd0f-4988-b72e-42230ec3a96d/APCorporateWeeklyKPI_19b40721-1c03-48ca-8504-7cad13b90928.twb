      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_weekly_kpi_sales' name='federated.1cdh99w0jowbgn12uw5ur0a9zfi4' />
          </datasources>
          <datasource-dependencies datasource='federated.1cdh99w0jowbgn12uw5ur0a9zfi4'>
            <column aggregation='Sum' caption='MTD Col' datatype='integer' name='[Calculation_612841440071634944]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='MTD Δ (%) Corps Signed All' datatype='string' name='[MTD Δ (%) Sales Reps (copy)_612841440396705829]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_mtd] THEN [opportunities_closed_won] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [opportunities_closed_won] END)&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [opportunities_closed_won] END)&#10;&#10;* SIGN(SUM(IF [is_2mtd] THEN [opportunities_closed_won] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(ROUND(abs(&#10;(&#10;    SUM(IF [is_mtd] THEN [opportunities_closed_won] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [opportunities_closed_won] END)&#10;&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [opportunities_closed_won] END)&#10;&#10;* 100), 1&#10;)) &#10;+ &apos;%&apos;' />
            </column>
            <column caption='MTD Δ (%) Corps Signed All Colour' datatype='string' name='[MTD Δ (%) Sales Reps Colour (copy)_612841440396705830]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_mtd] THEN [opportunities_closed_won] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [opportunities_closed_won] END)&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [opportunities_closed_won] END)&#10;&#10;* SIGN(SUM(IF [is_2mtd] THEN [opportunities_closed_won] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
