              <calculation class='tableau' formula='[date_local_month] = DATETRUNC(&apos;month&apos;, TODAY())' />
            </column>
            <column caption='Is 2Mtd' datatype='boolean' name='[Calculation_534239536902418434]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date_local_month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
            </column>
            <column caption='MTD Δ (%) Users With Orders' datatype='string' name='[Calculation_534239536902656003]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    AVG(IF [Calculation_534239536897998848] THEN [active_customer_count] END)&#10;    -&#10;    AVG(IF [Calculation_534239536902418434] THEN [active_customer_count] END)&#10;)&#10;&#10;/  AVG(IF [Calculation_534239536902418434] THEN [active_customer_count] END)&#10;&#10;* SIGN(AVG(IF [Calculation_534239536902418434] THEN [active_customer_count] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(ROUND(abs(&#10;(&#10;    AVG(IF [Calculation_534239536897998848] THEN [active_customer_count] END)&#10;    -&#10;    AVG(IF [Calculation_534239536902418434] THEN [active_customer_count] END)&#10;&#10;)&#10;&#10;/  AVG(IF [Calculation_534239536902418434] THEN [active_customer_count] END)&#10;&#10;* 100), 1&#10;)) &#10;+ &apos;%&apos;' />
            </column>
            <column caption='MTD Δ (%) Users With Orders Colour' datatype='string' name='[Calculation_534239536903118852]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    AVG(IF [Calculation_534239536897998848] THEN [active_customer_count] END)&#10;    -&#10;    AVG(IF [Calculation_534239536902418434] THEN [active_customer_count]  END)&#10;)&#10;&#10;/  AVG(IF [Calculation_534239536902418434] THEN [active_customer_count]  END)&#10;&#10;* SIGN(AVG(IF [Calculation_534239536902418434] THEN [active_customer_count]  END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
