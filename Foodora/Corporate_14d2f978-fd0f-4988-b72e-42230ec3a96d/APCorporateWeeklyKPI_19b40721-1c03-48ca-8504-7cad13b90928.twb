            <column caption='Total Gmv Eur' datatype='real' name='[total_gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[Weekly New GMV Colour (copy)_3358911313249792012]' derivation='User' name='[usr:Weekly New GMV Colour (copy)_3358911313249792012:qk]' pivot='key' type='quantitative'>
