    <worksheet name='7a New GMV MTD'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_weekly_kpi_gmv' name='federated.1fc3orj1gfbzu115dr91c1lph96d' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.1fc3orj1gfbzu115dr91c1lph96d'>
            <column caption='MTD Col' datatype='integer' name='[Calculation_-4792392890731851763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='MTD Δ (%) New GMV EUR' datatype='string' name='[Calculation_3781616316338921479]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;(&#13;&#10;    SUM(IF [is_mtd] THEN [new_gmv_eur] END)&#13;&#10;    -&#13;&#10;    SUM(IF [is_2mtd] THEN [new_gmv_eur] END)&#13;&#10;)&#13;&#10;&#13;&#10;/  SUM(IF [is_2mtd] THEN [new_gmv_eur] END)&#13;&#10;&#13;&#10;* SIGN(SUM(IF [is_2mtd] THEN [new_gmv_eur] END))&#13;&#10;&#13;&#10;&gt;= 0&#13;&#10;&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(ROUND(abs(&#13;&#10;(&#13;&#10;    SUM(IF [is_mtd] THEN [new_gmv_eur] END)&#13;&#10;    -&#13;&#10;    SUM(IF [is_2mtd] THEN [new_gmv_eur] END)&#13;&#10;&#13;&#10;)&#13;&#10;&#13;&#10;/  SUM(IF [is_2mtd] THEN [new_gmv_eur] END)&#13;&#10;&#13;&#10;* 100), 1&#13;&#10;)) &#13;&#10;+ &apos;%&apos;' />
            </column>
            <column caption='MTD Δ (%) New GMV EUR Colour' datatype='string' name='[Calculation_3781616316339044360]' role='measure' type='nominal'>
