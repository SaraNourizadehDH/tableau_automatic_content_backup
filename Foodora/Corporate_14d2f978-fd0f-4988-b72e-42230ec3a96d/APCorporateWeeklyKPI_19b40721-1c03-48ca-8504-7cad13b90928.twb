          <datasource-dependencies datasource='federated.1g3sziq1jrgyrb10zpeul0uhoi2v'>
            <column caption='CSAT Count_cm' datatype='integer' name='[CSAT %_cm (copy)_5738711871500509259]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([shared_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([shared_date]) &lt;= DAY(TODAY()-2)&#10;THEN [total_responses]&#10;END' />
            </column>
            <column caption='CSAT Count_lm' datatype='integer' name='[CSAT %_lm (copy)_5738711871500509260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([shared_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#10;AND DAY([shared_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#10;THEN [total_responses]&#10;END' />
            </column>
            <column aggregation='Sum' caption='MTD Col' datatype='integer' name='[Calculation_5738711871227994137]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='MTD Δ (%) CSAT Count' datatype='string' name='[MTD Δ (%) CSAT Score (copy)_5738711871500382282]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([CSAT %_cm (copy)_5738711871500509259]) / SUM([CSAT %_lm (copy)_5738711871500509260])) - 1) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(((SUM([CSAT %_cm (copy)_5738711871500509259]) / SUM([CSAT %_lm (copy)_5738711871500509260])) - 1)*100,1)&#10;)&#10;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='MTD Δ (%) CSAT Count Colour' datatype='string' name='[MTD Δ (%) CSAT Score Colour (copy)_5738711871500382281]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([CSAT %_cm (copy)_5738711871500509259]) / SUM([CSAT %_lm (copy)_5738711871500509260])) - 1) &gt;= 0&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_5738711871227994137]' derivation='None' name='[none:Calculation_5738711871227994137:ok]' pivot='key' type='ordinal' />
