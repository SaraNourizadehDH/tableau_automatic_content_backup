    <worksheet name='3a Activities MTD'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_weekly_kpi_sales' name='federated.1cdh99w0jowbgn12uw5ur0a9zfi4' />
          </datasources>
          <datasource-dependencies datasource='federated.1cdh99w0jowbgn12uw5ur0a9zfi4'>
            <column aggregation='Sum' caption='MTD Col' datatype='integer' name='[Calculation_612841440071634944]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='MTD Δ (%) Opps Activities' datatype='string' name='[MTD Δ (%) Leads Converted (copy)_612841440359784467]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;  ( (SUM(IIF ([is_mtd] ,  [opps_with_activities] ,0))&#10;        /&#10;     AVG(IIF ([is_mtd] ,  [sales_rep_count] ,0))&#10;    )&#10;    -&#10;    (SUM(IIF ([is_2mtd] ,  [opps_with_activities] ,0))&#10;        /&#10;     AVG(IIF ([is_2mtd] ,  [sales_rep_count] ,0))&#10;    )  )&#10;   &#10;) &gt;=0 &#10;&#10;THEN  STR(&apos;▲&apos;) ELSE STR(&apos;▼&apos;) END&#10;&#10;+&apos; &apos;+&#10;&#10;STR( ROUND(ABS( &#10;       &#10;   ( (SUM(IIF ([is_mtd] ,  [opps_with_activities] ,0))&#10;        /&#10;     AVG(IIF ([is_mtd] ,  [sales_rep_count] ,0))&#10;    )&#10;    -&#10;    (SUM(IIF ([is_2mtd] ,  [opps_with_activities] ,0))&#10;        /&#10;     AVG(IIF ([is_2mtd] ,  [sales_rep_count] ,0))&#10;    )  )&#10;    / (SUM(IIF ([is_2mtd] ,  [opps_with_activities] ,0))&#10;        /&#10;     AVG(IIF ([is_2mtd] ,  [sales_rep_count] ,0))&#10;    )  &#10;&#10;&#10; * 100)        ,1))&#10;&#10;+ &apos; %&apos;' />
            </column>
            <column caption='MTD Δ (%) Opps Activities Colour' datatype='string' name='[MTD Δ (%) Leads Converted Colour (copy)_612841440359784468]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;  ( (SUM(IIF ([is_mtd] ,  [opps_with_activities] ,0))&#10;        /&#10;     AVG(IIF ([is_mtd] ,  [sales_rep_count] ,0))&#10;    )&#10;    -&#10;    (SUM(IIF ([is_2mtd] ,  [opps_with_activities] ,0))&#10;        /&#10;     AVG(IIF ([is_2mtd] ,  [sales_rep_count] ,0))&#10;    )  )&#10;  &#10;) &gt;=0 &#10;THEN  STR(&apos;▲&apos;) ELSE STR(&apos;▼&apos;) END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Is 2Mtd' datatype='boolean' name='[is_2mtd]' role='dimension' type='nominal' />
            <column caption='Is Mtd' datatype='boolean' name='[is_mtd]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_612841440071634944]' derivation='None' name='[none:Calculation_612841440071634944:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column caption='Opps With Activities' datatype='integer' name='[opps_with_activities]' role='measure' type='quantitative' />
            <column caption='Sales Rep Count' datatype='integer' name='[sales_rep_count]' role='measure' type='quantitative' />
            <column-instance column='[MTD Δ (%) Leads Converted (copy)_612841440359784467]' derivation='User' name='[usr:MTD Δ (%) Leads Converted (copy)_612841440359784467:nk]' pivot='key' type='nominal' />
