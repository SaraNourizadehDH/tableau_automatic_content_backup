            <column caption='Gross Order Volume_cm' datatype='integer' name='[CSAT Count_cm (copy)_882987053247967245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([shared_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([shared_date]) &lt;= DAY(TODAY()-2)&#10;THEN [gross_order_volume]&#10;END' />
            </column>
            <column caption='Gross Order Volume_lm' datatype='integer' name='[CSAT Count_lm (copy)_882987053247967246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([shared_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#10;AND DAY([shared_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#10;THEN [gross_order_volume]&#10;END' />
            </column>
            <column aggregation='Sum' caption='MTD Col' datatype='integer' name='[Calculation_5738711871227994137]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='MTD Δ (%) Gross Order Volume' datatype='string' name='[MTD Δ (%) CSAT Count (copy)_882987053247672331]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([CSAT Count_cm (copy)_882987053247967245]) / SUM([CSAT Count_lm (copy)_882987053247967246])) - 1) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(((SUM([CSAT Count_cm (copy)_882987053247967245]) / SUM([CSAT Count_lm (copy)_882987053247967246])) - 1)*100,1)&#10;)&#10;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='MTD Δ (%) Gross Order Volume Colour' datatype='string' name='[MTD Δ (%) CSAT Count Colour (copy)_882987053247672332]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([CSAT Count_cm (copy)_882987053247967245]) / SUM([CSAT Count_lm (copy)_882987053247967246])) - 1) &gt;= 0&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
