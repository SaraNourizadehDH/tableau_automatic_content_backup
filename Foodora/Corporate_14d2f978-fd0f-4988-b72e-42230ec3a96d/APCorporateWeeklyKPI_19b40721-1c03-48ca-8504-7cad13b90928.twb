            <column-instance column='[MTD Δ (%) CSAT Score Colour (copy)_5738711871500382281]' derivation='User' name='[usr:MTD Δ (%) CSAT Score Colour (copy)_5738711871500382281:nk]' pivot='key' type='nominal' />
