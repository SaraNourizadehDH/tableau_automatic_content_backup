                <alias key='0' value='LW % Δ' />
              </aliases>
            </column>
            <column caption='Weekly Company With Orders Colour A' datatype='integer' name='[Calculation_684547186912317440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (MIN([main_total_company_count_allowance]) - [Calculation_684547186912706561]) / [Calculation_684547186912706561] &gt;= 0.2 then 2&#10;elseif (MIN([main_total_company_count_allowance]) - [Calculation_684547186912706561]) / [Calculation_684547186912706561] &lt;= -0.2 then -2&#10;elseif (MIN([main_total_company_count_allowance]) - [Calculation_684547186912706561]) / [Calculation_684547186912706561] &lt;= -0.1 then -1&#10;elseif (MIN([main_total_company_count_allowance]) - [Calculation_684547186912706561]) / [Calculation_684547186912706561] &gt;= 0.1 then 1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='L7D AVG Company With Orders A' datatype='real' name='[Calculation_684547186912706561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(MIN([main_total_company_count_allowance]), first(), first()+6)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
