            </column>
            <column caption='MTD Δ (%) GMV EUR Corp' datatype='string' name='[Calculation_2022890300485287948]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_mtd] THEN [Calculation_2022890300614664220] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [Calculation_2022890300614664220] END)&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [Calculation_2022890300614664220] END)&#10;&#10;* SIGN(SUM(IF [is_2mtd] THEN [Calculation_2022890300614664220] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(ROUND(abs(&#10;(&#10;    SUM(IF [is_mtd] THEN [Calculation_2022890300614664220] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [Calculation_2022890300614664220] END)&#10;&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [Calculation_2022890300614664220] END)&#10;&#10;* 100), 1&#10;)) &#10;+ &apos;%&apos;' />
            </column>
            <column caption='MTD Δ (%) GMV EUR Corp Colour' datatype='string' name='[Calculation_2022890300485361677]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_mtd] THEN [Calculation_2022890300614664220] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [Calculation_2022890300614664220] END)&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [Calculation_2022890300614664220] END)&#10;&#10;* SIGN(SUM(IF [is_2mtd] THEN [Calculation_2022890300614664220] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='total_gmv_eur_corp' datatype='real' name='[Calculation_2022890300614664220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [corp_order_type] != &quot;Voucher Shop&quot; THEN [total_gmv_eur] ELSE 0 END' />
            </column>
            <column caption='Corp Order Type' datatype='string' name='[corp_order_type]' role='dimension' type='nominal' />
