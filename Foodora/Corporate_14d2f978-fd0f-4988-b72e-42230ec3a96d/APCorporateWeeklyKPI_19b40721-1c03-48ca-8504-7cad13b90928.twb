                <alias key='0' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='MTD Δ (%) Corps Signed' datatype='string' name='[Calculation_612841440073175043]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;  ( (SUM(IIF ([is_mtd] ,  [opportunities_closed_won] ,0))&#10;        /&#10;     AVG(IIF ([is_mtd] ,  [sales_rep_count] ,0))&#10;    )&#10;    -&#10;    (SUM(IIF ([is_2mtd] ,  [opportunities_closed_won] ,0))&#10;        /&#10;     AVG(IIF ([is_2mtd] ,  [sales_rep_count] ,0))&#10;    )  )&#10;   &#10;) &gt;=0 &#10;&#10;THEN  STR(&apos;▲&apos;) ELSE STR(&apos;▼&apos;) END&#10;&#10;+&apos; &apos;+&#10;&#10;STR( ROUND(ABS( &#10;       &#10;   ( (SUM(IIF ([is_mtd] ,  [opportunities_closed_won] ,0))&#10;        /&#10;     AVG(IIF ([is_mtd] ,  [sales_rep_count] ,0))&#10;    )&#10;    -&#10;    (SUM(IIF ([is_2mtd] ,  [opportunities_closed_won] ,0))&#10;        /&#10;     AVG(IIF ([is_2mtd] ,  [sales_rep_count] ,0))&#10;    )  )&#10;    / (SUM(IIF ([is_2mtd] ,  [opportunities_closed_won] ,0))&#10;        /&#10;     AVG(IIF ([is_2mtd] ,  [sales_rep_count] ,0))&#10;    )  &#10;&#10;&#10; * 100)        ,1))&#10;&#10;+ &apos; %&apos;' />
            </column>
            <column caption='MTD Δ (%) Corps Signed Colour' datatype='string' name='[MTD Δ (%) AFV EUR (copy)_612841440073609220]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;  ( (SUM(IIF ([is_mtd] ,  [opportunities_closed_won] ,0))&#10;        /&#10;     AVG(IIF ([is_mtd] ,  [sales_rep_count] ,0))&#10;    )&#10;    -&#10;    (SUM(IIF ([is_2mtd] ,  [opportunities_closed_won] ,0))&#10;        /&#10;     AVG(IIF ([is_2mtd] ,  [sales_rep_count] ,0))&#10;    )  )&#10;  &#10;) &gt;=0 &#10;THEN  STR(&apos;▲&apos;) ELSE STR(&apos;▼&apos;) END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
