      <column caption='QA %_lm' datatype='real' name='[CSAT %_lm (copy)_5738711871441653811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if MONTH([shared_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#10;AND DAY([shared_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#10;THEN ZN([qa_score_total]) / ZN([total_interactions_evaluated])&#10;END' />
