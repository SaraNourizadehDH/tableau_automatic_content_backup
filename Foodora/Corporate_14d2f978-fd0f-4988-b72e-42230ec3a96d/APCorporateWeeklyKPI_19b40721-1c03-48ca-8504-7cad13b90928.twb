              <calculation class='tableau' formula='//excludes pending &amp; in-progress orders&#10;(SUM(vendor_fail_volume)+SUM(customer_fail_volume)+SUM(rider_fail_volume))&#10;/&#10;SUM([gross_order_volume])' />
            </column>
            <column caption='Weekly Fail Rate Colour' datatype='real' name='[Weekly CSAT Colour (copy)_5738711871252860968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_PERCENTILE([Calculation_5738711871252422695])'>
