              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Month&quot;' value='Month' />
                <alias key='&quot;Week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qq48ck05dcgmq13x9lt61nsrhbg'>
            <column caption='Dynamic Date Range' datatype='string' name='[Calculation_3153927137248092161]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then str(DATEPART(&apos;iso-year&apos;,[date_utc]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[date_utc]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; then str(DATEPART(&apos;day&apos;,[date_utc]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[date_utc])),3)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then LEFT(str(DATENAME(&apos;month&apos;,[date_utc])),3)+&apos; &apos;+ right(str(DATEPART(&apos;iso-year&apos;,[date_utc])),2) end' />
            </column>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_3153927137255313414]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Month&apos; THEN [date_utc] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_utc] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN [date_utc] &gt;= DATEADD(&apos;week&apos;,-7,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [date_utc] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; THEN [date_utc] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [date_utc] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month + MTD&apos; THEN [date_utc] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_utc] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week + WTD&apos; THEN [date_utc] &gt;= DATEADD(&apos;week&apos;,-7,DATETRUNC(&apos;week&apos;,TODAY())) AND [date_utc] &lt; TODAY()&#10;END' />
            </column>
            <column caption='Dynamic column name for %change' datatype='string' name='[Calculation_3153927137271398407]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Day&apos; then &apos;LD % Δ&apos;&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then &apos;LW % Δ&apos;&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then &apos;LM % Δ&apos;&#10;END' />
            </column>
            <column caption='WoW Δ (%) PP Sign Ups' datatype='string' name='[Calculation_3153927137274003466]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos; THEN (&#10;IF (&#10;(SUM(if str(REGEXP_EXTRACT([Calculation_3153927137248092161],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [pp_orders] end) &#10;- SUM(if str(REGEXP_EXTRACT([Calculation_3153927137248092161],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [pp_orders] end)) &#10;/ SUM(if str(REGEXP_EXTRACT([Calculation_3153927137248092161],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [pp_orders] end))&#10;&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;((SUM(if str(REGEXP_EXTRACT([Calculation_3153927137248092161],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [pp_orders] end) &#10;- SUM(if str(REGEXP_EXTRACT([Calculation_3153927137248092161],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [pp_orders] end)) &#10;/ SUM(if str(REGEXP_EXTRACT([Calculation_3153927137248092161],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [pp_orders] end))&#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Month&apos; THEN (&#10;IF ( &#10;(SUM(if LEFT([Calculation_3153927137248092161],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [pp_orders] end)&#10;- SUM(if LEFT([Calculation_3153927137248092161],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [pp_orders] end))&#10;/ SUM(if LEFT([Calculation_3153927137248092161],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [pp_orders] end))&#10;&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;((SUM(if LEFT([Calculation_3153927137248092161],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [pp_orders] end)&#10;- SUM(if LEFT([Calculation_3153927137248092161],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [pp_orders] end))&#10;/ SUM(if LEFT([Calculation_3153927137248092161],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [pp_orders] end))&#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Day&apos; THEN (&#10;IF ( &#10;(SUM(if [Calculation_3153927137248092161] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-1,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-1,TODAY()))),3) THEN [pp_orders] end)&#10;- SUM(if [Calculation_3153927137248092161] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [pp_orders] end))&#10;/ SUM(if [Calculation_3153927137248092161] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [pp_orders] end)) &#10;&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;((SUM(if [Calculation_3153927137248092161] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-1,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-1,TODAY()))),3) THEN [pp_orders] end)&#10;- SUM(if [Calculation_3153927137248092161] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [pp_orders] end))&#10;/ SUM(if [Calculation_3153927137248092161] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [pp_orders] end)) &#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;&#10;END' />
