              <calculation class='tableau' formula='IF &#13;&#10;(&#13;&#10;    SUM(IF [is_mtd] THEN [total_gmv_eur] END)&#13;&#10;    -&#13;&#10;    SUM(IF [is_2mtd] THEN [total_gmv_eur] END)&#13;&#10;)&#13;&#10;&#13;&#10;/  SUM(IF [is_2mtd] THEN [total_gmv_eur] END)&#13;&#10;&#13;&#10;* SIGN(SUM(IF [is_2mtd] THEN [total_gmv_eur] END))&#13;&#10;&#13;&#10;&gt;= 0&#13;&#10;&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(ROUND(abs(&#13;&#10;(&#13;&#10;    SUM(IF [is_mtd] THEN [total_gmv_eur] END)&#13;&#10;    -&#13;&#10;    SUM(IF [is_2mtd] THEN [total_gmv_eur] END)&#13;&#10;&#13;&#10;)&#13;&#10;&#13;&#10;/  SUM(IF [is_2mtd] THEN [total_gmv_eur] END)&#13;&#10;&#13;&#10;* 100), 1&#13;&#10;)) &#13;&#10;+ &apos;%&apos;' />
