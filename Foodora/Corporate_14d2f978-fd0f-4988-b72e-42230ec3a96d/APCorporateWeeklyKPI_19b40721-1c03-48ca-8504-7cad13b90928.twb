            <column-instance column='[Calculation_684547188206465073]' derivation='None' name='[none:Calculation_684547188206465073:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_corporate]' derivation='None' name='[none:is_corporate:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_dmart_order]' derivation='None' name='[none:is_dmart_order:nk]' pivot='key' type='nominal' />
            <column caption='Total Gfv Eur' datatype='real' name='[total_gfv_eur]' role='measure' type='quantitative' />
            <column caption='Total Number Of Successful Orders' datatype='integer' name='[total_number_of_successful_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_-4792392890711814124]' derivation='User' name='[usr:Calculation_-4792392890711814124:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Weekly GMV Colour (copy)_-4792392890709893098]' derivation='User' name='[usr:Weekly GMV Colour (copy)_-4792392890709893098:qk]' pivot='key' type='quantitative'>
