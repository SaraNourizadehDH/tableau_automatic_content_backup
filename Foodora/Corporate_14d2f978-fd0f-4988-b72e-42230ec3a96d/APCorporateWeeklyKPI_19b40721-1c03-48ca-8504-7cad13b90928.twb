            <column caption='MTD Δ (%) TOTAL GIFT CARD GTV EUR' datatype='string' name='[Calculation_2720314974689263624]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_mtd] THEN [total_gtv_eur] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [total_gtv_eur] END)&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [total_gtv_eur] END)&#10;&#10;* SIGN(SUM(IF [is_2mtd] THEN [total_gtv_eur] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(ROUND(abs(&#10;(&#10;    SUM(IF [is_mtd] THEN [total_gtv_eur] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [total_gtv_eur] END)&#10;&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [total_gtv_eur] END)&#10;&#10;* 100), 1&#10;)) &#10;+ &apos;%&apos;' />
            </column>
            <column caption='MTD Δ (%) TOTAL GIFT CARD GTV EUR Colour' datatype='string' name='[Calculation_2720314974689513481]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_mtd] THEN [total_gtv_eur] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [total_gtv_eur] END)&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [total_gtv_eur] END)&#10;&#10;* SIGN(SUM(IF [is_2mtd] THEN [total_gtv_eur] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
