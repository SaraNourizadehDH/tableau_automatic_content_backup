    <worksheet name='4b 1st Order WoW'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_weekly_kpi_sales' name='federated.1cdh99w0jowbgn12uw5ur0a9zfi4' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Dynamic Date Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Month&quot;' value='Month' />
                <alias key='&quot;Week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1cdh99w0jowbgn12uw5ur0a9zfi4'>
            <column caption='Dynamic column name for %change' datatype='string' name='[Calculation_5738711872202604626]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Day&apos; then &apos;LD % Δ&apos;&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then &apos;LW % Δ&apos;&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then &apos;LM % Δ&apos;&#10;END' />
            </column>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_5738711872202723411]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Month&apos; THEN [date_utc] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_utc] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN [date_utc] &gt;= DATEADD(&apos;week&apos;,-7,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [date_utc] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; THEN [date_utc] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [date_utc] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month + MTD&apos; THEN [date_utc] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_utc] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week + WTD&apos; THEN [date_utc] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [date_utc] &lt; TODAY()&#10;END' />
            </column>
            <column caption='Dynamic Date Range' datatype='string' name='[Calculation_5738711872202825812]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then str(DATEPART(&apos;iso-year&apos;,[date_utc]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[date_utc]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; then str(DATEPART(&apos;day&apos;,[date_utc]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[date_utc])),3)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then LEFT(str(DATENAME(&apos;month&apos;,[date_utc])),3)+&apos; &apos;+ right(str(DATEPART(&apos;year&apos;,[date_utc])),2) end' />
            </column>
            <column caption='WoW Δ (%) First Order' datatype='string' name='[WoW Δ (%) Corps Signed (copy)_612841440381808669]' role='measure' type='nominal'>
