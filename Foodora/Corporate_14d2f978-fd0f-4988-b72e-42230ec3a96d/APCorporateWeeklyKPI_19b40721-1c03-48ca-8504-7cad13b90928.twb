            <column-instance column='[WoW Δ (%) Company With Orders PP (copy)_3438216882157432842]' derivation='User' name='[usr:WoW Δ (%) Company With Orders PP (copy)_3438216882157432842:nk]' pivot='key' type='nominal' />
