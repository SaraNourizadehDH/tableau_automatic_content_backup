            <column caption='MTD Δ (%) Leads Converted' datatype='string' name='[MTD Δ (%) Corps Signed (copy)_612841440358096913]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;  ( (SUM(IIF ([is_mtd] ,  [leads_converted] ,0))&#10;        /&#10;     AVG(IIF ([is_mtd] ,  [sales_rep_count] ,0))&#10;    )&#10;    -&#10;    (SUM(IIF ([is_2mtd] ,  [leads_converted] ,0))&#10;        /&#10;     AVG(IIF ([is_2mtd] ,  [sales_rep_count] ,0))&#10;    )  )&#10;   &#10;) &gt;=0 &#10;&#10;THEN  STR(&apos;▲&apos;) ELSE STR(&apos;▼&apos;) END&#10;&#10;+&apos; &apos;+&#10;&#10;STR( ROUND(ABS( &#10;       &#10;   ( (SUM(IIF ([is_mtd] ,  [leads_converted] ,0))&#10;        /&#10;     AVG(IIF ([is_mtd] ,  [sales_rep_count] ,0))&#10;    )&#10;    -&#10;    (SUM(IIF ([is_2mtd] ,  [leads_converted] ,0))&#10;        /&#10;     AVG(IIF ([is_2mtd] ,  [sales_rep_count] ,0))&#10;    )  )&#10;    / (SUM(IIF ([is_2mtd] ,  [leads_converted] ,0))&#10;        /&#10;     AVG(IIF ([is_2mtd] ,  [sales_rep_count] ,0))&#10;    )  &#10;&#10;&#10; * 100)        ,1))&#10;&#10;+ &apos; %&apos;' />
            </column>
            <column caption='MTD Δ (%) Leads Converted Colour' datatype='string' name='[MTD Δ (%) Corps Signed Colour (copy)_612841440358096914]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;  ( (SUM(IIF ([is_mtd] ,  [leads_converted] ,0))&#10;        /&#10;     AVG(IIF ([is_mtd] ,  [sales_rep_count] ,0))&#10;    )&#10;    -&#10;    (SUM(IIF ([is_2mtd] ,  [leads_converted] ,0))&#10;        /&#10;     AVG(IIF ([is_2mtd] ,  [sales_rep_count] ,0))&#10;    )  )&#10;  &#10;) &gt;=0 &#10;THEN  STR(&apos;▲&apos;) ELSE STR(&apos;▼&apos;) END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
