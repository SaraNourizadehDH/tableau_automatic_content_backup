            <column caption='Opportunities Closed Won' datatype='integer' name='[opportunities_closed_won]' role='measure' type='quantitative' />
            <column-instance column='[opportunities_closed_won]' derivation='Sum' name='[sum:opportunities_closed_won:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Weekly Corps Signed Colour (copy)_612841440390713380]' derivation='User' name='[usr:Weekly Corps Signed Colour (copy)_612841440390713380:qk]' pivot='key' type='quantitative'>
