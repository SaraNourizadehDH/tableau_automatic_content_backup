            <column caption='MTD Δ (%) CSAT Score Colour' datatype='string' name='[Calculation_5738711871221248023]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([Calculation_5738711871236223006]) / SUM([Calculation_5738711871236452383])) - 1) &gt;= 0&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
