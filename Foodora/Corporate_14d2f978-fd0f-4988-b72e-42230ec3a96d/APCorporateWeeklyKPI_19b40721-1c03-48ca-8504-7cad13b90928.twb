          <datasource-dependencies datasource='federated.1cdh99w0jowbgn12uw5ur0a9zfi4'>
            <column aggregation='Sum' caption='MTD Col' datatype='integer' name='[Calculation_612841440071634944]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='MTD Δ (%) Sales Reps' datatype='string' name='[MTD Δ (%) Corps Signed (copy)_612841440384524319]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    AVG(IF [is_mtd] THEN [sales_rep_count] END)&#10;    -&#10;    AVG(IF [is_2mtd] THEN [sales_rep_count] END)&#10;)&#10;&#10;/  AVG(IF [is_2mtd] THEN [sales_rep_count] END)&#10;&#10;* SIGN(AVG(IF [is_2mtd] THEN [sales_rep_count] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(ROUND(abs(&#10;(&#10;    AVG(IF [is_mtd] THEN [sales_rep_count] END)&#10;    -&#10;    AVG(IF [is_2mtd] THEN [sales_rep_count] END)&#10;&#10;)&#10;&#10;/  AVG(IF [is_2mtd] THEN [sales_rep_count] END)&#10;&#10;* 100), 1&#10;)) &#10;+ &apos;%&apos;' />
            </column>
            <column caption='MTD Δ (%) Sales Reps Colour' datatype='string' name='[MTD Δ (%) Corps Signed Colour (copy)_612841440384524320]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_mtd] THEN [sales_rep_count] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [sales_rep_count] END)&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [sales_rep_count] END)&#10;&#10;* SIGN(SUM(IF [is_2mtd] THEN [sales_rep_count] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
