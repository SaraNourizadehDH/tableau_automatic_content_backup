          <formatted-text>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_weekly_kpi_sales_opps' name='federated.15spowa11s8ecq1a5a7840s6o6kj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Dynamic Date Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Month&quot;' value='Month' />
                <alias key='&quot;Week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15spowa11s8ecq1a5a7840s6o6kj'>
            <column caption='WoW Δ (%) Signups' datatype='string' name='[Calculation_3781616316382650382]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos; THEN (&#10;IF (&#10;(COUNT(if str(REGEXP_EXTRACT([Calculation_684547188375011380],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [opportunity_id] end) &#10;- COUNT(if str(REGEXP_EXTRACT([Calculation_684547188375011380],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [opportunity_id] end)) &#10;/ COUNT(if str(REGEXP_EXTRACT([Calculation_684547188375011380],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [opportunity_id] end))&#10;&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;((COUNT(if str(REGEXP_EXTRACT([Calculation_684547188375011380],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [opportunity_id] end) &#10;- COUNT(if str(REGEXP_EXTRACT([Calculation_684547188375011380],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [opportunity_id] end)) &#10;/ COUNT(if str(REGEXP_EXTRACT([Calculation_684547188375011380],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [opportunity_id] end))&#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Month&apos; THEN (&#10;IF ( &#10;(COUNT(if LEFT([Calculation_684547188375011380],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [opportunity_id] end)&#10;- COUNT(if LEFT([Calculation_684547188375011380],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [opportunity_id] end))&#10;/ COUNT(if LEFT([Calculation_684547188375011380],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [opportunity_id] end))&#10;&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;((COUNT(if LEFT([Calculation_684547188375011380],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [opportunity_id] end)&#10;- COUNT(if LEFT([Calculation_684547188375011380],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [opportunity_id] end))&#10;/ COUNT(if LEFT([Calculation_684547188375011380],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [opportunity_id] end))&#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Day&apos; THEN (&#10;IF ( &#10;(COUNT(if [Calculation_684547188375011380] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-1,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-1,TODAY()))),3) THEN [opportunity_id] end)&#10;- COUNT(if [Calculation_684547188375011380] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [opportunity_id] end))&#10;/ COUNT(if [Calculation_684547188375011380] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [opportunity_id] end)) &#10;&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;((COUNT(if [Calculation_684547188375011380] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-1,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-1,TODAY()))),3) THEN [opportunity_id] end)&#10;- COUNT(if [Calculation_684547188375011380] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [opportunity_id] end))&#10;/ COUNT(if [Calculation_684547188375011380] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [opportunity_id] end)) &#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;&#10;END' />
            </column>
            <column caption='WoW Δ (%) Signups Colour' datatype='string' name='[Calculation_411797928456736768]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF LEFT([Calculation_3781616316382650382],1) = &quot;▲&quot; THEN &quot;▲&quot;&#10;ELSE &quot;▼&quot;&#10;END' />
            </column>
            <column caption='Dynamic Date Range' datatype='string' name='[Calculation_684547188375011380]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then str(DATEPART(&apos;iso-year&apos;,[close_date]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[close_date]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; then str(DATEPART(&apos;day&apos;,[close_date]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[close_date])),3)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then LEFT(str(DATENAME(&apos;month&apos;,[close_date])),3)+&apos; &apos;+ right(str(DATEPART(&apos;year&apos;,[close_date])),2) end' />
            </column>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_684547188375502901]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Month&apos; THEN [close_date] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [close_date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN [close_date] &gt;= DATEADD(&apos;week&apos;,-7,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [close_date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; THEN [close_date] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [close_date] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month + MTD&apos; THEN [close_date] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [close_date] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week + WTD&apos; THEN [close_date] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [close_date] &lt; TODAY()&#10;END' />
            </column>
            <column caption='Dynamic column name for %change' datatype='string' name='[Calculation_684547188375924792]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Day&apos; then &apos;LD % Δ&apos;&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then &apos;LW % Δ&apos;&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then &apos;LM % Δ&apos;&#10;END' />
            </column>
            <column caption='Close Date' datatype='date' name='[close_date]' role='dimension' type='ordinal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='F Active Sf Backend' datatype='boolean' name='[f_active_sf_backend]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_684547188375502901]' derivation='None' name='[none:Calculation_684547188375502901:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_684547188375924792]' derivation='None' name='[none:Calculation_684547188375924792:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[f_active_sf_backend]' derivation='None' name='[none:f_active_sf_backend:nk]' pivot='key' type='nominal' />
            <column caption='Opportunity Id' datatype='string' name='[opportunity_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3781616316382650382]' derivation='User' name='[usr:Calculation_3781616316382650382:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_411797928456736768]' derivation='User' name='[usr:Calculation_411797928456736768:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.15spowa11s8ecq1a5a7840s6o6kj].[none:Calculation_684547188375502901:nk]'>
            <groupfilter function='member' level='[none:Calculation_684547188375502901:nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.15spowa11s8ecq1a5a7840s6o6kj].[none:country_name:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:country_name:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:country_name:nk]' member='&quot;Austria&quot;' />
                <groupfilter function='member' level='[none:country_name:nk]' member='&quot;Hungary&quot;' />
