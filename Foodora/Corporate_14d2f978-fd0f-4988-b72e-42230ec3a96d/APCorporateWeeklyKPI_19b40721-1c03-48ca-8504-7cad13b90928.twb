              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos; THEN (&#10;(IF &#10;((SUM(if str(REGEXP_EXTRACT([Calculation_5738711871220273173],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [csat_4_5] end) / SUM(if str(REGEXP_EXTRACT([Calculation_5738711871220273173],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [total_responses] end))&#10;- ((SUM(if str(REGEXP_EXTRACT([Calculation_5738711871220273173],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [csat_4_5] end) / SUM(if str(REGEXP_EXTRACT([Calculation_5738711871220273173],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_responses] end))))&#10;/ ((SUM(if str(REGEXP_EXTRACT([Calculation_5738711871220273173],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [csat_4_5] end) / SUM(if str(REGEXP_EXTRACT([Calculation_5738711871220273173],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_responses] end))) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;(ROUND( (SUM(if str(REGEXP_EXTRACT([Calculation_5738711871220273173],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [csat_4_5] end) / SUM(if str(REGEXP_EXTRACT([Calculation_5738711871220273173],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [total_responses] end)) , 3)&#10;- ROUND( (SUM(if str(REGEXP_EXTRACT([Calculation_5738711871220273173],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [csat_4_5] end) / SUM(if str(REGEXP_EXTRACT([Calculation_5738711871220273173],&quot;-(.*)&quot;)) = str(DATEPART(&apos