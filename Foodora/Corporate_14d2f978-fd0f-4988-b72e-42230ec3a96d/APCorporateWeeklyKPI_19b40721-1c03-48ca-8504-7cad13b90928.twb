      <column caption='Weekly Signups Colour' datatype='integer' name='[Calculation_3781616316378333196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if (COUNT([opportunity_id]) - [Calculation_3781616316377444363]) / [Calculation_3781616316377444363] &gt;= 0.2 then 2&#13;&#10;elseif (COUNT([opportunity_id]) - [Calculation_3781616316377444363]) / [Calculation_3781616316377444363] &lt;= -0.2 then -2&#13;&#10;elseif (COUNT([opportunity_id]) - [Calculation_3781616316377444363]) / [Calculation_3781616316377444363] &lt;= -0.1 then -1&#13;&#10;elseif (COUNT([opportunity_id])-[Calculation_3781616316377444363])/ [Calculation_3781616316377444363] &gt;= 0.1 then 1&#13;&#10;else 0&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
