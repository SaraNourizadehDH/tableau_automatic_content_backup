      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_weekly_kpi_gmv' name='federated.1fc3orj1gfbzu115dr91c1lph96d' />
            <datasource caption='regional_apac_cp_weekly_kpi_company_count' name='federated.1cwb42e0gc4vrm1attwll1dfsaeu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Dynamic Date Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Month&quot;' value='Month' />
                <alias key='&quot;Week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1cwb42e0gc4vrm1attwll1dfsaeu'>
            <column caption='WoW Δ (%) Users With Orders' datatype='string' name='[WoW Δ (%) Company With Orders (copy)_4405153787407265800]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;(&#13;&#10;    AVG(IF [is_last_week] THEN [main_total_customer_count] END)&#13;&#10;    -&#13;&#10;    AVG(IF [is_2last_week] THEN [main_total_customer_count] END)&#13;&#10;)&#13;&#10;&#13;&#10;/  AVG(IF [is_2last_week] THEN [main_total_customer_count] END)&#13;&#10;&#13;&#10;* SIGN(AVG(IF [is_2last_week] THEN [main_total_customer_count] END))&#13;&#10;&#13;&#10;&gt;= 0&#13;&#10;&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(ROUND(abs(&#13;&#10;(&#13;&#10;    AVG(IF [is_last_week] THEN [main_total_customer_count] END)&#13;&#10;    -&#13;&#10;    AVG(IF [is_2last_week] THEN [main_total_customer_count] END)&#13;&#10;&#13;&#10;)&#13;&#10;&#13;&#10;/  AVG(IF [is_2last_week] THEN [main_total_customer_count] END)&#13;&#10;&#13;&#10;* 100), 1&#13;&#10;)) &#13;&#10;+ &apos;%&apos;' />
            </column>
            <column caption='WoW Δ (%) Users With Orders Colour' datatype='string' name='[WoW Δ (%) Company With Orders Colour (copy)_4405153787407622153]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;(&#13;&#10;    AVG(IF [is_last_week] THEN [main_total_customer_count] END)&#13;&#10;    -&#13;&#10;    AVG(IF [is_2last_week] THEN [main_pp_customer_count] END)&#13;&#10;)&#13;&#10;&#13;&#10;/  AVG(IF [is_2last_week] THEN [main_total_customer_count] END)&#13;&#10;&#13;&#10;* SIGN(AVG(IF [is_2last_week] THEN [main_total_customer_count] END))&#13;&#10;&#13;&#10;&gt;= 0&#13;&#10;&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='Is 2Last Week' datatype='boolean' name='[is_2last_week]' role='dimension' type='nominal' />
            <column caption='Is Last Week' datatype='boolean' name='[is_last_week]' role='dimension' type='nominal' />
            <column caption='Main Pp Customer Count' datatype='integer' name='[main_pp_customer_count]' role='measure' type='quantitative' />
            <column caption='Main Total Customer Count' datatype='integer' name='[main_total_customer_count]' role='measure' type='quantitative' />
