      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_weekly_kpi_ops' name='federated.1g3sziq1jrgyrb10zpeul0uhoi2v' />
          </datasources>
          <datasource-dependencies datasource='federated.1g3sziq1jrgyrb10zpeul0uhoi2v'>
            <column aggregation='Sum' caption='MTD Col' datatype='integer' name='[Calculation_5738711871227994137]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='IR %_cm' datatype='real' name='[FCR %_cm (copy)_5738711871447793720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MONTH([shared_date]) = MONTH(DATETRUNC(&apos;month&apos;,TODAY()-2)) AND DAY([shared_date]) &lt;= DAY(TODAY()-2)&#10;THEN (ZN([total_chats])+ ZN([incoming_cases])) / ZN([gross_order_count])&#10;END' />
            </column>
            <column caption='IR %_lm' datatype='real' name='[FCR %_lm (copy)_5738711871447793721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if MONTH([shared_date]) = MONTH(DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;,TODAY()-2))) &#10;AND DAY([shared_date]) &lt;= DAY(DATEADD(&apos;month&apos;, -1, TODAY()-2))&#10;THEN (ZN([total_chats])+ ZN([incoming_cases])) / ZN([gross_order_count])&#10;END' />
            </column>
            <column caption='MTD Δ (%) IR' datatype='string' name='[MTD Δ (%) QA (copy)_5738711871448125498]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([FCR %_cm (copy)_5738711871447793720]) / SUM([FCR %_lm (copy)_5738711871447793721])) - 1) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(((SUM([FCR %_cm (copy)_5738711871447793720]) / SUM([FCR %_lm (copy)_5738711871447793721])) - 1)*100,1)&#10;)&#10;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='MTD Δ (%) IR Colour' datatype='string' name='[MTD Δ (%) QA Colour (copy)_5738711871448125499]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((SUM([FCR %_cm (copy)_5738711871447793720]) / SUM([FCR %_lm (copy)_5738711871447793721])) - 1) &gt;= 0&#10;THEN &apos;GREEN&apos; ELSE &apos;RED&apos; END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Gross Order Count' datatype='integer' name='[gross_order_count]' role='measure' type='quantitative' />
            <column caption='Incoming Cases' datatype='integer' name='[incoming_cases]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_5738711871227994137]' derivation='None' name='[none:Calculation_5738711871227994137:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
