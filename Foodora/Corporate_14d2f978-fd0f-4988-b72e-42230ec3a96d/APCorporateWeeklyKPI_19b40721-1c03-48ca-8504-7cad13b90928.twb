            </column>
            <column caption='WoW Δ (%) Orders' datatype='string' name='[WoW Δ (%)  GMV EUR (copy)_-4792392890702880744]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos; THEN (&#10;IF (&#10;(SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [total_number_of_successful_orders] end) &#10;- SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_number_of_successful_orders] end)) &#10;/ SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_number_of_successful_orders] end))&#10;&gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;((SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [total_number_of_successful_orders] end) &#10;- SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_number_of_successful_orders] end)) &#10;/ SUM(if str(REGEXP_EXTRACT([Calculation_684547188204953648],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [total_number_of_successful_orders] end))&#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Month&apos; THEN (&#10;IF ( &#10;(SUM(if LEFT([Calculation_684547188204953648],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_number_of_successful_orders] end)&#10;- SUM(if LEFT([Calculation_684547188204953648],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [total_number_of_successful_orders] end)