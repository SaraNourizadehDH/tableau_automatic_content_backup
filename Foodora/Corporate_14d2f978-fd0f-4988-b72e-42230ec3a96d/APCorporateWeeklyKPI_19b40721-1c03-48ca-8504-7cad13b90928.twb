              <calculation class='tableau' formula='IF LEFT([WoW Δ (%)  GMV EUR (copy)_-4792392890702880744],1) = &quot;▲&quot; THEN &quot;▲&quot;&#10;ELSE &quot;▼&quot;&#10;END' />
