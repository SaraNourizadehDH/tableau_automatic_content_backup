    <worksheet name='15b New Signed Customers'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_weekly_kpi_new_signed_users' name='federated.05ls2he0tv5w601h18ofi1u5fl8r' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Dynamic Date Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Month&quot;' value='Month' />
                <alias key='&quot;Week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05ls2he0tv5w601h18ofi1u5fl8r'>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_1211186857577435136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Month&apos; THEN [date_local] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN [date_local] &gt;= DATEADD(&apos;week&apos;,-7,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; THEN [date_local] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month + MTD&apos; THEN [date_local] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_local] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week + WTD&apos; THEN [date_local] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [date_local] &lt; TODAY()&#10;END' />
            </column>
            <column caption='Dynamic Column Name' datatype='string' name='[Calculation_1211186857577897986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Day&apos; then &apos;Daily&apos;&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then &apos;Week&apos;&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then &apos;Month&apos;&#10;END' />
              <aliases>
                <alias key='&quot;Week&quot;' value='LW % Δ' />
              </aliases>
            </column>
            <column caption='Dynamic Date Range' datatype='string' name='[Calculation_1211186857578045443]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;Week&apos; or [Parameters].[Parameter 1] = &apos;Week + WTD&apos;) then str(DATEPART(&apos;iso-year&apos;,[date_local]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos; then str(DATEPART(&apos;day&apos;,[date_local]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[date_local])),3)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;Month&apos; or [Parameters].[Parameter 1] = &apos;Month + MTD&apos;) then LEFT(str(DATENAME(&apos;month&apos;,[date_local])),3)+&apos; &apos;+ right(str(DATEPART(&apos;year&apos;,[date_local])),2) end' />
            </column>
            <column caption='WoW Δ (%) New Signed Users' datatype='string' name='[Calculation_1211186857582735367]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos; THEN (&#10;(IF &#10;((SUM(if str(REGEXP_EXTRACT([Calculation_1211186857578045443],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [new_signed_users] end))&#10;- ((SUM(if str(REGEXP_EXTRACT([Calculation_1211186857578045443],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [new_signed_users] end))))&#10;/ ((SUM(if str(REGEXP_EXTRACT([Calculation_1211186857578045443],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [new_signed_users] end))) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;(ROUND( (SUM(if str(REGEXP_EXTRACT([Calculation_1211186857578045443],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY()))) THEN [new_signed_users] end)) , 3)&#10;- ROUND( (SUM(if str(REGEXP_EXTRACT([Calculation_1211186857578045443],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [new_signed_users] end)), 3))&#10;/ ROUND( (SUM(if str(REGEXP_EXTRACT([Calculation_1211186857578045443],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY()))) THEN [new_signed_users] end)) , 3) &#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;) &#10;&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Month&apos; THEN (&#10;(IF &#10;((SUM(if LEFT([Calculation_1211186857578045443],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [new_signed_users] end))&#10;- ((SUM(if LEFT([Calculation_1211186857578045443],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [new_signed_users] end))))&#10;/ ((SUM(if LEFT([Calculation_1211186857578045443],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [new_signed_users] end))) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;(ROUND( (SUM(if LEFT([Calculation_1211186857578045443],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [new_signed_users] end)) , 3)&#10;- ROUND( (SUM(if LEFT([Calculation_1211186857578045443],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [new_signed_users] end)), 3))&#10;/ ROUND( (SUM(if LEFT([Calculation_1211186857578045443],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3) THEN [new_signed_users] end)) , 3) &#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;) &#10;&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Day&apos; THEN (&#10;(IF &#10;((SUM(if [Calculation_1211186857578045443] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-1,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-1,TODAY()))),3) THEN [new_signed_users] end))&#10;- ((SUM(if [Calculation_1211186857578045443] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [new_signed_users] end))))&#10;/ ((SUM(if [Calculation_1211186857578045443] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [new_signed_users] end))) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;(ROUND( (SUM(if [Calculation_1211186857578045443] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-1,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-1,TODAY()))),3) THEN [new_signed_users] end)) , 3)&#10;- ROUND( (SUM(if [Calculation_1211186857578045443] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [new_signed_users] end)), 3))&#10;/ ROUND( (SUM(if [Calculation_1211186857578045443] = str(DATEPART(&apos;day&apos;,DATEADD(&apos;day&apos;,-2,TODAY())))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;day&apos;,-2,TODAY()))),3) THEN [new_signed_users] end)) , 3) &#10;* 100&#10;, 1))&#10;+&apos;%&apos;)&#10;) &#10;&#10;END' />
            </column>
            <column caption='WoW Δ (%) New Signed Users Colour' datatype='string' name='[Calculation_1211186857582923784]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF LEFT([Calculation_1211186857582735367],1) = &quot;▲&quot; THEN &quot;▲&quot;&#10;ELSE &quot;▼&quot;&#10;END' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Local' datatype='date' name='[date_local]' role='dimension' type='ordinal' />
            <column caption='New Signed Users' datatype='integer' name='[new_signed_users]' role='measure' type='quantitative' />
