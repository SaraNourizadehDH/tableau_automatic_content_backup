            <column-instance column='[main_total_company_count_allowance]' derivation='Sum' name='[sum:main_total_company_count_allowance:vtsum:qk]' pivot='key' type='quantitative' visual-totals='Sum' />
            <column-instance column='[Calculation_684547186912317440]' derivation='User' name='[usr:Calculation_684547186912317440:qk]' pivot='key' type='quantitative'>
