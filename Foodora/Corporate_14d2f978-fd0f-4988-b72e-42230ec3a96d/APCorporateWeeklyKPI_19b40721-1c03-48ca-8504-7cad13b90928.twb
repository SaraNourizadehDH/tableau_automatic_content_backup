            <column caption='WoW Col' datatype='integer' datatype-customized='true' name='[Calculation_-4792392890779615229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='LW % Δ' />
              </aliases>
            </column>
            <column caption='L7D AVG Company With Orders' datatype='real' name='[L7D AVG Orders (copy)_-9115285580310114304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(MIN([main_total_company_count]), first(), first()+6)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Weekly Company With Orders Colour' datatype='integer' name='[Weekly Orders Colour (copy)_-9115285580309786623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if (MIN([main_total_company_count]) - [L7D AVG Orders (copy)_-9115285580310114304]) / [L7D AVG Orders (copy)_-9115285580310114304] &gt;= 0.2 then 2&#13;&#10;elseif (MIN([main_total_company_count]) - [L7D AVG Orders (copy)_-9115285580310114304]) / [L7D AVG Orders (copy)_-9115285580310114304] &lt;= -0.2 then -2&#13;&#10;elseif (MIN([main_total_company_count]) - [L7D AVG Orders (copy)_-9115285580310114304]) / [L7D AVG Orders (copy)_-9115285580310114304] &lt;= -0.1 then -1&#13;&#10;elseif (MIN([main_total_company_count]) - [L7D AVG Orders (copy)_-9115285580310114304]) / [L7D AVG Orders (copy)_-9115285580310114304] &gt;= 0.1 then 1&#13;&#10;else 0&#13;&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Local Week' datatype='string' name='[date_local_week]' role='dimension' type='nominal' />
            <column caption='Main Total Company Count' datatype='integer' name='[main_total_company_count]' role='measure' type='quantitative' />
            <column-instance column='[date_local_week]' derivation='Max' name='[max:date_local_week:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[date_local_week]' derivation='None' name='[none:date_local_week:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_-4792392890779615229]' derivation='Sum' name='[sum:Calculation_-4792392890779615229:vtmin:qk]' pivot='key' type='quantitative' visual-totals='Min' />
            <column-instance column='[main_total_company_count]' derivation='Sum' name='[sum:main_total_company_count:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Weekly Orders Colour (copy)_-9115285580309786623]' derivation='User' name='[usr:Weekly Orders Colour (copy)_-9115285580309786623:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.1cwb42e0gc4vrm1attwll1dfsaeu].[L7D AVG Orders (copy)_-9115285580310114304]' ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1cwb42e0gc4vrm1attwll1dfsaeu].[none:country_name:nk]' filter-group='7'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:country_name:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:country_name:nk]' member='&quot;Myanmar&quot;' />
                <groupfilter function='member' level='[none:country_name:nk]' member='%null%' />
              </groupfilter>
            </groupfilter>
          </filter>
          <alphabetic-sort column='[federated.1cwb42e0gc4vrm1attwll1dfsaeu].[none:country_name:nk]' direction='ASC' />
          <filter class='categorical' column='[federated.1cwb42e0gc4vrm1attwll1dfsaeu].[none:date_local_week:nk]'>
            <groupfilter count='7' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='MAX([date_local_week])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:date_local_week:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
