          </datasources>
          <datasource-dependencies datasource='federated.1cwb42e0gc4vrm1attwll1dfsaeu' />
          <datasource-dependencies datasource='federated.1fc3orj1gfbzu115dr91c1lph96d'>
            <column caption='MTD Col' datatype='integer' name='[Calculation_-4792392890731851763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='MTD Δ (%) GMV EUR' datatype='string' name='[Calculation_-4792392890739822580]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;(&#13;&#10;    SUM(IF [is_mtd] THEN [total_gmv_eur] END)&#13;&#10;    -&#13;&#10;    SUM(IF [is_2mtd] THEN [total_gmv_eur] END)&#13;&#10;)&#13;&#10;&#13;&#10;/  SUM(IF [is_2mtd] THEN [total_gmv_eur] END)&#13;&#10;&#13;&#10;* SIGN(SUM(IF [is_2mtd] THEN [total_gmv_eur] END))&#13;&#10;&#13;&#10;&gt;= 0&#13;&#10;&#13;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;&#13;&#10;+ &apos; &apos;&#13;&#10;&#13;&#10;+ STR(ROUND(abs(&#13;&#10;(&#13;&#10;    SUM(IF [is_mtd] THEN [total_gmv_eur] END)&#13;&#10;    -&#13;&#10;    SUM(IF [is_2mtd] THEN [total_gmv_eur] END)&#13;&#10;&#13;&#10;)&#13;&#10;&#13;&#10;/  SUM(IF [is_2mtd] THEN [total_gmv_eur] END)&#13;&#10;&#13;&#10;* 100), 1&#13;&#10;)) &#13;&#10;+ &apos;%&apos;' />
            </column>
            <column caption='MTD Δ (%) GMV EUR Colour' datatype='string' name='[Calculation_-4792392890740998133]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_mtd] THEN [total_gmv_eur] END)&#10;    -&#10;    SUM(IF [is_2mtd] THEN [total_gmv_eur] END)&#10;)&#10;&#10;/  SUM(IF [is_2mtd] THEN [total_gmv_eur] END)&#10;&#10;* SIGN(SUM(IF [is_2mtd] THEN [total_gmv_eur] END))&#10;&#10;&gt;= 0&#10;&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Local' datatype='date' name='[date_local]' role='dimension' type='ordinal' />
            <column caption='is_2MTD' datatype='boolean' name='[is_2mtd]' role='dimension' type='nominal' />
            <column caption='Is Allowance Order' datatype='boolean' name='[is_allowance_order]' role='dimension' type='nominal' />
            <column caption='Is Corporate' datatype='boolean' name='[is_corporate]' role='dimension' type='nominal' />
            <column caption='is_MTD' datatype='boolean' name='[is_mtd]' role='dimension' type='nominal' />
