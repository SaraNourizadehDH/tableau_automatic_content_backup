    <worksheet name='AOV EUR B2B P'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='8'>3a. Corporate Regular AOV vs.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_evergreen_orders' name='federated.18cvfop1ft1yr612wtejw1hfbu1j' />
          </datasources>
          <datasource-dependencies datasource='federated.18cvfop1ft1yr612wtejw1hfbu1j'>
            <column caption='AOV EUR' datatype='real' name='[Calculation_470344697429970954]' role='measure' type='quantitative'>
