    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Description'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APCorporateDailyEvergreenDiscount/Description?rev=' id='Description' path='/t/Foodora/workbooks/APCorporateDailyEvergreenandBPD' revision='' site='Foodora' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='42812' id='3' type-v2='text' w='98400' x='800' y='15125'>
            <formatted-text>
              <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>Purpose/ Description</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='8'>- Performance tracking for Corporate evergreen discount for different country teams to analyse</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='8'>- Refreshes Daily</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>How to use the dashboard (tabs)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Evergreen Discount Tracking: </run>
              <run fontcolor='#555555' fontsize='8'>To track all evergreen deals performance (GMV &amp; AOV) by month and country</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Evergreen discount orders: </run>
              <run fontcolor='#555555' fontsize='8'>Detailed view of individual evergreen discount orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Shops Tracking: </run>
              <run fontcolor='#555555' fontsize='8'>To track all evergreen deals performance in Shops by month and country</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Shops Orders: </run>
              <run fontcolor='#555555' fontsize='8'>Detailed view of individual evergreen discount orders in Shops</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Pantry Tracking: </run>
              <run fontcolor='#555555' fontsize='8'>To track all evergreen deals performance in Pantry by month and country</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Pantry Orders:</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Æ </run>
              <run fontcolor='#555555' fontsize='8'>Detailed view of individual evergreen discount orders in Pantry</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Vendors With/Without Deals:</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>Æ </run>
              <run fontcolor='#555555' fontsize='8'>Detailed view of vendors and their possible deals</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>POCs</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='8'>Please reach out in #pandata-corporate if there are any issues.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
