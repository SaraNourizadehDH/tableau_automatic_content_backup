    <worksheet name='5 EG Vendors Summary'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='9'>5. # of Vendors w/ Regular Evergreen Deals (As Of Current Date)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_cp_evergreen_all_vendors' name='federated.0edg9ta0s99cty1fq7o7f1yp0hn1' />
            <datasource caption='regional_apac_cp_evergreen_orders' name='federated.18cvfop1ft1yr612wtejw1hfbu1j' />
          </datasources>
          <datasource-dependencies datasource='federated.0edg9ta0s99cty1fq7o7f1yp0hn1'>
            <column caption='Restaurant Vendor Count' datatype='integer' name='[Calculation_470344697344737280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([vendor_code])' />
            </column>
            <column caption='Has No Corporate Discount (WIP)' datatype='integer' name='[Calculation_470344697388285953]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [has_corp_discount] &lt;&gt; 1 THEN 1 ELSE 0 END' />
            </column>
            <column caption='Has Other Corporate Only Delivery Deal' datatype='integer' name='[Calculation_470344698036137997]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [has_corp_discount]=1  AND [has_evergreen_discount]=0 AND [has_stack_discount]=0 THEN 1 ELSE 0 END' />
            </column>
            <column caption='Has No Delivery Deal' datatype='integer' name='[Calculation_932245144496574464]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [has_discount]=0 THEN 1 ELSE 0 END' />
            </column>
            <column caption='Has Other Delivery Deal (Not Corporate Only)' datatype='integer' name='[Calculation_932245144500011009]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [has_discount]=1  AND [has_corp_discount]=0 THEN 1 ELSE 0 END' />
            </column>
            <column aggregation='Sum' caption='Commission' datatype='real' name='[commission]' role='dimension' type='ordinal' />
            <column caption='Commission Type' datatype='string' name='[commission_type]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column aggregation='Sum' caption='Has Corporate Only Delivery Deal' datatype='integer' name='[has_corp_discount]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Has Any Delivery Deal' datatype='integer' name='[has_discount]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Has Evergreen Deal' datatype='integer' name='[has_evergreen_discount]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Has Stack Deal' datatype='integer' name='[has_stack_discount]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_470344698036137997]' derivation='None' name='[none:Calculation_470344698036137997:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_932245144496574464]' derivation='None' name='[none:Calculation_932245144496574464:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_932245144500011009]' derivation='None' name='[none:Calculation_932245144500011009:ok]' pivot='key' type='ordinal' />
            <column-instance column='[commission]' derivation='None' name='[none:commission:ok]' pivot='key' type='ordinal' />
            <column-instance column='[commission_type]' derivation='None' name='[none:commission_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[has_corp_discount]' derivation='None' name='[none:has_corp_discount:ok]' pivot='key' type='ordinal' />
            <column-instance column='[has_discount]' derivation='None' name='[none:has_discount:ok]' pivot='key' type='ordinal' />
