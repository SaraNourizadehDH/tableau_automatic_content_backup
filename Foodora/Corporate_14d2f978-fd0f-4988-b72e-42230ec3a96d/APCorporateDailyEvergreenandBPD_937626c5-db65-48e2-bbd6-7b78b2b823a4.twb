        <column caption='Has No Delivery Deal' datatype='integer' name='[Calculation_932245144496574464]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='IF [has_discount]=0 THEN 1 ELSE 0 END' />
        </column>
