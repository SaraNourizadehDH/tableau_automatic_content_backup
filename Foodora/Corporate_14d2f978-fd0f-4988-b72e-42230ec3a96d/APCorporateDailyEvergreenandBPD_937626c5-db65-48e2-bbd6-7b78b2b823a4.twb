              <calculation class='tableau' formula='SUM( IF [has_business_premium] THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Restaurant Vendor Count' datatype='integer' name='[Calculation_470344697344737280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([vendor_code])' />
            </column>
            <column caption='Has No Corporate Discount (WIP)' datatype='integer' name='[Calculation_470344697388285953]' role='dimension' type='ordinal'>
