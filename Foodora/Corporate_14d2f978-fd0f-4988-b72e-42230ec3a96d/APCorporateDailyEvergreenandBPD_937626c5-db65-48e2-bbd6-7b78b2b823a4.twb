      <group name='[APAC User Filter]' name-style='unqualified' user:ui-builder='identity-set'>
        <groupfilter function='intersection'>
          <groupfilter function='level-members' level='[country]' />
          <groupfilter function='union'>
            <groupfilter expression='false' function='filter'>
              <groupfilter function='level-members' level='[country]' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_commercial_developer&apos;)' function='filter'>
              <groupfilter function='except'>
                <groupfilter function='level-members' level='[country]' />
                <groupfilter function='member' level='[country]' member='%null%' />
              </groupfilter>
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_commercial_FP_BD&apos;)' function='filter'>
              <groupfilter function='member' level='[country]' member='&quot;Bangladesh&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_commercial_FP_HK&apos;)' function='filter'>
              <groupfilter function='member' level='[country]' member='&quot;Hong Kong&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_commercial_FP_KH&apos;)' function='filter'>
              <groupfilter function='member' level='[country]' member='&quot;Cambodia&quot;' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;pd_commercial_FP_LA&apos;)' function='filter'>
              <groupfilter function='member' level='[country]' member='&quot;Laos&quot;' />
