              <calculation class='tableau' formula='COUNT([vendor_code])' />
            </column>
            <column caption='Has Other Corporate Only Delivery Deal' datatype='integer' name='[Calculation_470344698036137997]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [has_corp_discount]=1  AND [has_evergreen_discount]=0 AND [has_stack_discount]=0 THEN 1 ELSE 0 END' />
            </column>
            <column caption='Has No Delivery Deal' datatype='integer' name='[Calculation_932245144496574464]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [has_discount]=0 THEN 1 ELSE 0 END' />
