            <column caption='MTD' datatype='boolean' name='[Calculation_4159918685522096133]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date_local], today() - 1) = 0&#10;AND&#10;DAY([date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_4159918685522141190]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date_local], today() - 1) = 1&#10;AND&#10;DAY([date_local]) &lt;= DAY(TODAY()-1)' />
