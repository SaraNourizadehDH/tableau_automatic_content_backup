    <worksheet name='New GMV Daily Region'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_coredata_business)' name='federated.1mbeg540v1vzc01aalvax18oy4q5' />
          </datasources>
          <datasource-dependencies datasource='federated.1mbeg540v1vzc01aalvax18oy4q5'>
            <column caption='exclude_today' datatype='boolean' name='[Calculation_3496974746352320512]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;IIF(DATEPART(&apos;hour&apos;, NOW()) &lt;= 2, [date_local] &lt;= NOW() - 2, [date_local] != TODAY())' />
            </column>
            <column caption='Number of Records' datatype='integer' name='[Calculation_4159918685524639754]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Region' datatype='string' name='[Country (EU)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='categorical-bin' column='[country_name]' new-bin='true'>
                <bin default-name='false' value='&quot;APAC&quot;'>
                  <value>&quot;Bangladesh&quot;</value>
                  <value>&quot;Cambodia&quot;</value>
                  <value>&quot;Hong Kong&quot;</value>
                  <value>&quot;Laos&quot;</value>
                  <value>&quot;Malaysia&quot;</value>
                  <value>&quot;Pakistan&quot;</value>
                  <value>&quot;Philippines&quot;</value>
                  <value>&quot;Singapore&quot;</value>
                  <value>&quot;Taiwan&quot;</value>
                  <value>&quot;Thailand&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;EU&quot;'>
                  <value>&quot;Austria&quot;</value>
                  <value>&quot;Czech Republic&quot;</value>
                  <value>&quot;Hungary&quot;</value>
                  <value>&quot;Norway&quot;</value>
                  <value>&quot;Sweden&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='New GMV (Indicator - New)' datatype='integer' name='[Orders (Indicator - New) (copy)_392235447111036962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if isnull(sum([new_gmv_eur])) then 0&#10;elseif ((sum([new_gmv_eur]) - [Orders L7D Average (copy)_392235447111184419])/abs([Orders L7D Average (copy)_392235447111184419]) &gt;= 0.1)&#10;then 2&#10;elseif (sum([new_gmv_eur]) - [Orders L7D Average (copy)_392235447111184419])/abs([Orders L7D Average (copy)_392235447111184419]) &lt;= -0.1 &#10;then -2&#10;elseif ((sum([new_gmv_eur]) - [Orders L7D Average (copy)_392235447111184419])/abs([Orders L7D Average (copy)_392235447111184419]) &gt;= 0.05)&#10;then 1&#10;elseif (sum([new_gmv_eur]) - [Orders L7D Average (copy)_392235447111184419])/abs([Orders L7D Average (copy)_392235447111184419]) &lt;= -0.05&#10;then -1&#10;else 0&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='New GMV L7D Average' datatype='real' name='[Orders L7D Average (copy)_392235447111184419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(sum([new_gmv_eur]),first(),first()+6)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Local' datatype='date' name='[date_local]' role='dimension' type='ordinal' />
