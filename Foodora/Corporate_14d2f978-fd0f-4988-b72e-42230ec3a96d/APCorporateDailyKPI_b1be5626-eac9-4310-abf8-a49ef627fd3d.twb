      <column caption='Orders MTD vs PMTD' datatype='string' name='[Calculation_5054023968056860686]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_4159918685522096133], [total_number_of_successful_orders], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_4159918685522141190], [total_number_of_successful_orders], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_4159918685522141190], [total_number_of_successful_orders], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([Calculation_4159918685522096133], [total_number_of_successful_orders], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_4159918685522141190], [total_number_of_successful_orders], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_4159918685522141190], [total_number_of_successful_orders], 0)&#10;) * 100&#10;,2)&#10;)' />
