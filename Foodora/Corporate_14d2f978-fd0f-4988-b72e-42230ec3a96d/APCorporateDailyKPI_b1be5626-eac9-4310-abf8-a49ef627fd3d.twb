    <worksheet name='Platform % Active Users MTD %'>
      <layout-options>
        <title>
          <formatted-text>
            <run underline='true'>Platform % Active Users</run>
            <run> MTD %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily KPI Metrics' name='federated.01h9amz18ivzmc11aksub0tqj9q9' />
          </datasources>
          <datasource-dependencies datasource='federated.01h9amz18ivzmc11aksub0tqj9q9'>
            <column caption='MTD' datatype='boolean' name='[Calculation_5011099017613279238]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date_local], today() - 1) = 0&#10;AND&#10;DAY([date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_5011099017613451271]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date_local], today() - 1) = 1&#10;AND&#10;DAY([date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='MTD Growth %' datatype='integer' name='[Calculation_5011099017614192650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='pp Active User MTD vs PMTD (Indicator) ' datatype='string' name='[Platform GMV % MTD vs PMTD (Indicator) (copy)_5011099017672405050]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IIF([Calculation_5011099017613279238], [corp_active_users], 0)) / NULLIF(SUM(IIF([Calculation_5011099017613279238], [platform_active_users], 0)), 0)&#10;    -&#10;    SUM(IIF([Calculation_5011099017613451271], [corp_active_users], 0)) / NULLIF(SUM(IIF([Calculation_5011099017613451271], [platform_active_users], 0)), 0)&#10;)&#10;/ &#10;ABS(&#10;    SUM(IIF([Calculation_5011099017613451271], [corp_active_users], 0)) / NULLIF(SUM(IIF([Calculation_5011099017613451271], [platform_active_users], 0)), 0)&#10;) &lt;= 0&#10;THEN &apos;▼ &apos;&#10;ELSE &apos;▲ &apos;&#10;END' />
