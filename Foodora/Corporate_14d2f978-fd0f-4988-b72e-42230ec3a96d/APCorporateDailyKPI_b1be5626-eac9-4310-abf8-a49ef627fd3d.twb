      <column caption='Orders WoW Main (Positive)' datatype='string' name='[Calculation_6109836638295011353]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Calculation_6109836638287081491] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / iif([Yesterday&apos;s Orders Main (copy)_6109836638288412692] = 0, 1, [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Calculation_6109836638287081491] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / iif([Yesterday&apos;s Orders Main (copy)_6109836638288412692] = 0, 1, [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Calculation_6109836638287081491] - [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) / iif([Yesterday&apos;s Orders Main (copy)_6109836638288412692] = 0, 1, [Yesterday&apos;s Orders Main (copy)_6109836638288412692]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
      </column>
