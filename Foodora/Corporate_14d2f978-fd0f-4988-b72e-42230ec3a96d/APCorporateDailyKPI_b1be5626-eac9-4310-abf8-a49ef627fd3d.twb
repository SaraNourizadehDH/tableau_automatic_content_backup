            <column caption='DayOfWeek' datatype='string' name='[Calculation_5011099017608728578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [date_local])' />
            </column>
            <column caption='L7D &amp; Previous L7D' datatype='string' name='[Calculation_5011099017608949763]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_local] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [date_local] &lt;= NOW() - 1&#10;THEN &apos;L7D&apos;&#10;ELSEIF [date_local] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [date_local] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END' />
            </column>
            <column caption='Day (Similar Scale)' datatype='datetime' name='[Calculation_5011099017609465860]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [date_local] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [date_local])&#10;ELSE [date_local]&#10;END' />
