      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='11'>Expedition Type</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_coredata_business)' name='federated.1mbeg540v1vzc01aalvax18oy4q5' />
          </datasources>
          <datasource-dependencies datasource='federated.1mbeg540v1vzc01aalvax18oy4q5'>
            <column caption='Expedition Type (Simplified)' datatype='string' name='[Calculation_1393652988175007744]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [expedition_type] = &quot;pickup&quot; THEN &quot;Pickup&quot; ELSE &quot;Delivery&quot; END' />
