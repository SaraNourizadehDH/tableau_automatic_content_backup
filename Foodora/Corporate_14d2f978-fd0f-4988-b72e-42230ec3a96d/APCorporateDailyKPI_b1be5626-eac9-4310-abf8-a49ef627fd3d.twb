              <calculation class='tableau' formula='[is_same_day_last_week]' />
            </column>
            <column caption='Index' datatype='integer' name='[Calculation_5011099017636585495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='W1 Active Users % ' datatype='string' name='[W1 AM Growth % (copy)_5011099017644040225]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [corp_active_users] ELSE 0 END) - SUM(IF [Calculation_5011099017624190994] THEN [corp_active_users] ELSE 0 END))&#10;/ ABS(SUM(IF [Calculation_5011099017624190994] THEN [corp_active_users] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;   (SUM(IF [is_yesterday] THEN [corp_active_users] ELSE 0 END) - SUM(IF [Calculation_5011099017624190994] THEN [corp_active_users] ELSE 0 END))&#10;   / ABS(SUM(IF [Calculation_5011099017624190994] THEN [corp_active_users] ELSE 0 END))&#10; * 100, 2))' />
            </column>
            <column caption='W1 Active Users % Ranking' datatype='real' name='[W1 AM Growth % Ranking (copy)_5011099017644285986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [is_yesterday] THEN [corp_active_users] ELSE 0 END) - SUM(IF [Calculation_5011099017624190994] THEN [corp_active_users] ELSE 0 END))&#10;/ ABS(SUM(IF [Calculation_5011099017624190994] THEN [corp_active_users] ELSE 0 END))' />
            </column>
            <column caption='W1 Active Users (Indicator) ' datatype='string' name='[W1 AM Growth (Indicator) (copy)_5011099017644433443]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [corp_active_users] ELSE 0 END) - SUM(IF [Calculation_5011099017624190994] THEN [corp_active_users] ELSE 0 END))&#10;/ ABS(SUM(IF [Calculation_5011099017624190994] THEN [corp_active_users] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column datatype='integer' name='[corp_active_users]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='boolean' name='[is_same_day_last_week]' role='dimension' type='nominal' />
