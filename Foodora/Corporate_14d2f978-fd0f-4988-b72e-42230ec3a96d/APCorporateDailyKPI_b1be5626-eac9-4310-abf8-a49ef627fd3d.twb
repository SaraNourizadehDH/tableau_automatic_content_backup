    <worksheet name='GMV LW Growth Top Country 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold' fontsize='11'>Top Growth</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_coredata_business)' name='federated.1mbeg540v1vzc01aalvax18oy4q5' />
          </datasources>
          <datasource-dependencies datasource='federated.1mbeg540v1vzc01aalvax18oy4q5'>
            <column caption='INDEX' datatype='integer' name='[Calculation_2537426552784424960]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Number of Records' datatype='integer' name='[Calculation_4159918685524639754]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='L1W' datatype='boolean' name='[Calculation_6180416436320313347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_same_day_last_week]' />
            </column>
            <column caption='Yesterday' datatype='boolean' name='[L1W (copy 2)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;//IIF(DATEPART(&apos;hour&apos;, now()) &lt;= 2, IF [date] = TODAY() - 2 THEN TRUE ELSE FALSE END, IF [date] = TODAY() - 1 THEN TRUE ELSE FALSE END)&#10;[is_yesterday]' />
            </column>
            <column caption='W1 GMV %' datatype='string' name='[W1 GFV % (copy 4)]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [L1W (copy 2)] THEN [gmv_eur] ELSE 0 END) - SUM(IF [Calculation_6180416436320313347] THEN [gmv_eur] ELSE 0 END))&#10;/ SUM(IF [Calculation_6180416436320313347] THEN [gmv_eur] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;IF SUM(IF [L1W (copy 2)] THEN [gmv_eur] ELSE 0 END) - SUM(IF [Calculation_6180416436320313347] THEN [gmv_eur] ELSE 0 END) &gt;= 0&#10;THEN &#10;   (SUM(IF [L1W (copy 2)] THEN [gmv_eur] ELSE 0 END) - SUM(IF [Calculation_6180416436320313347] THEN [gmv_eur] ELSE 0 END))&#10;   / SUM(IF [Calculation_6180416436320313347] THEN [gmv_eur] ELSE 0 END)&#10;ELSE&#10;   (SUM(IF [L1W (copy 2)] THEN [gmv_eur] ELSE 0 END) - SUM(IF [Calculation_6180416436320313347] THEN [gmv_eur] ELSE 0 END))&#10;   / SUM(IF [Calculation_6180416436320313347] THEN [gmv_eur] ELSE 0 END)&#10;//    SUM(IF [L1W] THEN [total_number_of_successful_orders] ELSE 0 END) / SUM(IF [Yesterday] THEN [total_number_of_successful_orders] ELSE 0 END)&#10;END * 100, 2))' />
            </column>
            <column caption='W1 GMV % Ranking' datatype='real' name='[W1 GMV % (copy 2)]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(SUM(IF [L1W (copy 2)] THEN [gmv_eur] ELSE 0 END) - SUM(IF [Calculation_6180416436320313347] THEN [gmv_eur] ELSE 0 END))&#10;/ SUM(IF [Calculation_6180416436320313347] THEN [gmv_eur] ELSE 0 END)' />
            </column>
            <column caption='W1 GMV % (indicator)' datatype='string' name='[W1 New GMV % (indicator) (copy)_1768155442560335872]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [gmv_eur] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [gmv_eur] ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_week] THEN [gmv_eur] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='GMV Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column caption='Is Same Day Last Week' datatype='boolean' name='[is_same_day_last_week]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4159918685524639754]' derivation='Min' name='[min:Calculation_4159918685524639754:qk]' pivot='key' type='quantitative' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2537426552784424960]' derivation='User' name='[usr:Calculation_2537426552784424960:ok:2]' pivot='key' type='ordinal'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column-instance column='[W1 GFV % (copy 4)]' derivation='User' name='[usr:W1 GFV % (copy 4):nk]' pivot='key' type='nominal' />
            <column-instance column='[W1 GMV % (copy 2)]' derivation='User' name='[usr:W1 GMV % (copy 2):ok]' pivot='key' type='ordinal' />
            <column-instance column='[W1 New GMV % (indicator) (copy)_1768155442560335872]' derivation='User' name='[usr:W1 New GMV % (indicator) (copy)_1768155442560335872:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <computed-sort column='[federated.1mbeg540v1vzc01aalvax18oy4q5].[none:country_name:nk]' direction='DESC' using='[federated.1mbeg540v1vzc01aalvax18oy4q5].[usr:W1 GMV % (copy 2):ok]' />
          <filter class='categorical' column='[federated.1mbeg540v1vzc01aalvax18oy4q5].[usr:Calculation_2537426552784424960:ok:2]'>
            <groupfilter function='member' level='[usr:Calculation_2537426552784424960:ok:2]' member='1' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
