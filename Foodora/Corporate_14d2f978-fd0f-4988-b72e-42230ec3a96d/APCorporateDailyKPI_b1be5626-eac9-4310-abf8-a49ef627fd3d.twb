        <calculation class='tableau' formula='{ FIXED [date_local]:&#10;[Calculation_5011099017649795110]&#10;}' />
      </column>
      <column caption='Platform % GMV (Indicator) ' datatype='integer' name='[Active Users (Indicator)  (copy)_5011099017661931572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if isnull([Calculation_5011099017649795110]) then 0&#10;elseif (([Calculation_5011099017649795110] - [Active Users L7D Average  (copy)_5011099017650815015])/[Active Users L7D Average  (copy)_5011099017650815015] &gt;= 0.1)&#10;then 2&#10;elseif ([Calculation_5011099017649795110] - [Active Users L7D Average  (copy)_5011099017650815015])/[Active Users L7D Average  (copy)_5011099017650815015] &lt;= -0.1 &#10;then -2&#10;elseif (([Calculation_5011099017649795110] - [Active Users L7D Average  (copy)_5011099017650815015])/[Active Users L7D Average  (copy)_5011099017650815015] &gt;= 0.05)&#10;then 1&#10;elseif ([Calculation_5011099017649795110] - [Active Users L7D Average  (copy)_5011099017650815015])/[Active Users L7D Average  (copy)_5011099017650815015] &lt;= -0.05&#10;then -1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Platform % GMV L7D Average' datatype='real' name='[Active Users L7D Average  (copy)_5011099017650815015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_5011099017649795110],first(),first()+6)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Platform GMV % MTD vs PMTD (Indicator)' datatype='string' name='[Active Users MTD vs PMTD (Indicator) (copy)_5011099017654140970]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IIF([Calculation_5011099017613279238], [corporate_gmv_eur], 0)) / NULLIF(SUM(IIF([Calculation_5011099017613279238], [platform_gmv_eur], 0)), 0)&#10;    -&#10;    SUM(IIF([Calculation_5011099017613451271], [corporate_gmv_eur], 0)) / NULLIF(SUM(IIF([Calculation_5011099017613451271], [platform_gmv_eur], 0)), 0)&#10;)&#10;/ &#10;ABS(&#10;    SUM(IIF([Calculation_5011099017613451271], [corporate_gmv_eur], 0)) / NULLIF(SUM(IIF([Calculation_5011099017613451271], [platform_gmv_eur], 0)), 0)&#10;) &lt;= 0&#10;THEN &apos;▼ &apos;&#10;ELSE &apos;▲ &apos;&#10;END' />
      </column>
      <column caption='Platform GMV % MTD vs PMTD' datatype='string' name='[Active Users MTD vs PMTD (copy)_5011099017653264425]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IIF([Calculation_5011099017613279238], [corporate_gmv_eur], 0)) / NULLIF(SUM(IIF([Calculation_5011099017613279238], [platform_gmv_eur], 0)), 0)&#10;    -&#10;    SUM(IIF([Calculation_5011099017613451271], [corporate_gmv_eur], 0)) / NULLIF(SUM(IIF([Calculation_5011099017613451271], [platform_gmv_eur], 0)), 0)&#10;)&#10;/&#10;ABS(&#10;    SUM(IIF([Calculation_5011099017613451271], [corporate_gmv_eur], 0)) / NULLIF(SUM(IIF([Calculation_5011099017613451271], [platform_gmv_eur], 0)), 0)&#10;) &lt;= 0&#10;THEN &apos;▼ &apos;&#10;ELSE &apos;▲ &apos;&#10;END&#10;+&#10;STR(ROUND(&#10;(&#10;    SUM(IIF([Calculation_5011099017613279238], [corporate_gmv_eur], 0)) / NULLIF(SUM(IIF([Calculation_5011099017613279238], [platform_gmv_eur], 0)), 0)&#10;    -&#10;    SUM(IIF([Calculation_5011099017613451271], [corporate_gmv_eur], 0)) / NULLIF(SUM(IIF([Calculation_5011099017613451271], [platform_gmv_eur], 0)), 0)&#10;)&#10;/ &#10;NULLIF(&#10;    SUM(IIF([Calculation_5011099017613451271], [corporate_gmv_eur], 0)) / NULLIF(SUM(IIF([Calculation_5011099017613451271], [platform_gmv_eur], 0)), 0)&#10;, 0) * 100&#10;, 2))' />
      </column>
      <column caption='exclude_today' datatype='boolean' name='[Calculation_5011099017605451776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(DATEPART(&apos;hour&apos;, NOW()) &lt;= 2, [date_local] &lt;= NOW() - 2, [date_local] != TODAY())' />
      </column>
      <column caption='AM Growth Per Day' datatype='real' name='[Calculation_5011099017607905281]' role='measure' type='quantitative'>
