              <calculation class='tableau' formula='if&#10;([Calculation_6743647866350043137] - [Calculation_6743647866350342146]) / iif([Calculation_6743647866350342146] = 0, 1, [Calculation_6743647866350342146]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Calculation_6743647866350043137] - [Calculation_6743647866350342146]) / iif([Calculation_6743647866350342146] = 0, 1, [Calculation_6743647866350342146]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Calculation_6743647866350043137] - [Calculation_6743647866350342146]) / iif([Calculation_6743647866350342146] = 0, 1, [Calculation_6743647866350342146]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='% of New GMV' datatype='real' name='[Calculation_6743647866350927876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_6743647866350043137]&#10;/ &#10;sum({fixed: sum(iif([is_yesterday], [new_gmv_eur], 0))}))' />
