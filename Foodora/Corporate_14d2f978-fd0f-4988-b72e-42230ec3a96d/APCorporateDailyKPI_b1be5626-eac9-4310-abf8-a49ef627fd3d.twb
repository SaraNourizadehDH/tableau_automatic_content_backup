            <column caption='W1 New GMV %' datatype='string' name='[Calculation_6470968982598221826]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [new_gmv_eur] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [new_gmv_eur] ELSE 0 END))&#10;/ SUM(IF [is_same_day_last_week] THEN [new_gmv_eur] ELSE 0 END) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;IF SUM(IF [is_yesterday] THEN [new_gmv_eur] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [new_gmv_eur] ELSE 0 END) &gt;= 0&#10;THEN &#10;   (SUM(IF [is_yesterday] THEN [new_gmv_eur] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [new_gmv_eur] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [new_gmv_eur] ELSE 0 END)&#10;ELSE&#10;   (SUM(IF [is_yesterday] THEN [new_gmv_eur] ELSE 0 END) - SUM(IF [is_same_day_last_week] THEN [new_gmv_eur] ELSE 0 END))&#10;   / SUM(IF [is_same_day_last_week] THEN [new_gmv_eur] ELSE 0 END)&#10;END * 100, 2))' />
