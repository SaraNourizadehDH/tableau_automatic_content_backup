            <column caption='New GMV MTD vs PMTD (Indicator) ' datatype='string' name='[Calculation_4159918685521801220]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_4159918685522096133], [new_gmv_eur], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_4159918685522141190], [new_gmv_eur], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_4159918685522141190], [new_gmv_eur], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
