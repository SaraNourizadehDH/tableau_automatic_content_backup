            </column>
            <column caption='Platform % Active Users' datatype='real' name='[Platform % GMV (copy)_5011099017669980214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([corp_active_users])/SUM([platform_active_users])' />
