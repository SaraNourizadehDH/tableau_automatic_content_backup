    <worksheet name='Platform Pct GMV Top WoW %'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>Top Growth</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily KPI Metrics' name='federated.01h9amz18ivzmc11aksub0tqj9q9' />
          </datasources>
          <datasource-dependencies datasource='federated.01h9amz18ivzmc11aksub0tqj9q9'>
            <column caption='Number of Records' datatype='integer' name='[Calculation_5011099017614028809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='L1W' datatype='boolean' name='[Calculation_5011099017624190994]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_same_day_last_week]' />
            </column>
            <column caption='Index' datatype='integer' name='[Calculation_5011099017636585495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='W1 Platform Pct GMV % ' datatype='string' name='[W1 Active Users %  (copy)_5011099017659559986]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_yesterday] THEN [corporate_gmv_eur] / NULLIF([platform_gmv_eur], 0) ELSE 0 END)&#10;    - &#10;    SUM(IF [Calculation_5011099017624190994] THEN [corporate_gmv_eur] / NULLIF([platform_gmv_eur], 0) ELSE 0 END)&#10;)&#10;/ &#10;ABS(SUM(IF [Calculation_5011099017624190994] THEN [corporate_gmv_eur] / NULLIF([platform_gmv_eur], 0) ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; &#10;ELSE &apos;▼&apos; &#10;END&#10;+ &apos; &apos;&#10;+ STR(&#10;    ROUND(&#10;        (&#10;            SUM(IF [is_yesterday] THEN [corporate_gmv_eur] / NULLIF([platform_gmv_eur], 0) ELSE 0 END)&#10;            - &#10;            SUM(IF [Calculation_5011099017624190994] THEN [corporate_gmv_eur] / NULLIF([platform_gmv_eur], 0) ELSE 0 END)&#10;        )&#10;        / &#10;        ABS(SUM(IF [Calculation_5011099017624190994] THEN [corporate_gmv_eur] / NULLIF([platform_gmv_eur], 0) ELSE 0 END))&#10;        * 100, 2)&#10;)' />
            </column>
            <column caption='W1 Platform Pct GMV % Ranking' datatype='real' name='[W1 Active Users % Ranking (copy)_5011099017659912243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM(IF [is_yesterday] THEN [corporate_gmv_eur] / NULLIF([platform_gmv_eur], 0) ELSE 0 END)&#10;    - &#10;    SUM(IF [Calculation_5011099017624190994] THEN [corporate_gmv_eur] / NULLIF([platform_gmv_eur], 0) ELSE 0 END)&#10;) &#10;/ &#10;ABS(SUM(IF [Calculation_5011099017624190994] THEN [corporate_gmv_eur] / NULLIF([platform_gmv_eur], 0) ELSE 0 END))' />
            </column>
            <column caption='W1 Platform % GMV (Indicator) ' datatype='string' name='[W1 Active Users (Indicator)  (copy)_5011099017658794033]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IF [is_yesterday] THEN [corporate_gmv_eur] / NULLIF([platform_gmv_eur], 0) ELSE 0 END)&#10;    - &#10;    SUM(IF [Calculation_5011099017624190994] THEN [corporate_gmv_eur] / NULLIF([platform_gmv_eur], 0) ELSE 0 END)&#10;)&#10;/ &#10;ABS(SUM(IF [Calculation_5011099017624190994] THEN [corporate_gmv_eur] / NULLIF([platform_gmv_eur], 0) ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; &#10;ELSE &apos;▼&apos; &#10;END' />
            </column>
            <column datatype='real' name='[corporate_gmv_eur]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='boolean' name='[is_same_day_last_week]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5011099017614028809]' derivation='Min' name='[min:Calculation_5011099017614028809:qk]' pivot='key' type='quantitative' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[platform_gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_5011099017636585495]' derivation='User' name='[usr:Calculation_5011099017636585495:qk:3]' pivot='key' type='quantitative'>
