      <column caption='Active Users Platform Pct (Indicator)' datatype='integer' name='[Platform % GMV (Indicator)  (copy)_5011099017670193207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if isnull([Platform % GMV (copy)_5011099017669980214]) then 0&#10;elseif (([Platform % GMV (copy)_5011099017669980214] - [Platform % GMV L7D Average (copy)_5011099017670496312])/[Platform % GMV L7D Average (copy)_5011099017670496312] &gt;= 0.1)&#10;then 2&#10;elseif ([Platform % GMV (copy)_5011099017669980214] - [Platform % GMV L7D Average (copy)_5011099017670496312])/[Platform % GMV L7D Average (copy)_5011099017670496312] &lt;= -0.1 &#10;then -2&#10;elseif (([Platform % GMV (copy)_5011099017669980214] - [Platform % GMV L7D Average (copy)_5011099017670496312])/[Platform % GMV L7D Average (copy)_5011099017670496312] &gt;= 0.05)&#10;then 1&#10;elseif ([Platform % GMV (copy)_5011099017669980214] - [Platform % GMV L7D Average (copy)_5011099017670496312])/[Platform % GMV L7D Average (copy)_5011099017670496312] &lt;= -0.05&#10;then -1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Platform % Active Users' datatype='real' name='[Platform % GMV (copy)_5011099017669980214]' role='measure' type='quantitative'>
