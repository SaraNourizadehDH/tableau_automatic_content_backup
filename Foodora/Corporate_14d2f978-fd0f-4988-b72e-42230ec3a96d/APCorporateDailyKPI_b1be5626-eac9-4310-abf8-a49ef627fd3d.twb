        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.06dq0hc0nsuupl1ba53x71rnasb1' name='Custom SQL Query' type='text'><![CDATA[-- works, but baseline gmv per month is slightly different from am_inherited_model
WITH dates AS (
  SELECT
    shared_dates.date AS date_local,
    DATE_TRUNC(shared_dates.date, MONTH) AS month_start_date
  FROM `fulfillment-dwh-production.pandata_curated.shared_dates` AS shared_dates
  WHERE shared_dates.date BETWEEN "2020-01-01" AND CURRENT_DATE()
),

suspended_companies AS (
  SELECT
    uuid AS cp_company_uuid,
    state,
    DATE(updated_at_utc) AS suspended_date
  FROM `fulfillment-dwh-production.pandata_curated.cp_companies`
  WHERE is_state_suspended IS TRUE
),
daily_baseline_gmv AS (
  SELECT distinct
    am_inherited_model.region,
    am_inherited_model.global_entity_id,
    am_inherited_model.company_uuid,
    am_inherited_model.months, -- start date of month
    am_inherited_model.new_gmv_ref_date,
    suspended_companies.suspended_date,
    am_inherited_model.baseline_gmv_eur,
    SAFE_DIVIDE(
      baseline_gmv_eur,
      CASE
    WHEN DATE_TRUNC(DATE_ADD(new_gmv_ref_date, INTERVAL 30 DAY), MONTH) = months THEN
      DATE_DIFF(
        LAST_DAY(months),
        DATE_ADD(new_gmv_ref_date, INTERVAL 30 DAY),
        DAY
      ) + 1

    WHEN months = DATE_TRUNC(CURRENT_DATE(), MONTH) THEN
      EXTRACT(DAY FROM CURRENT_DATE())-1

    ELSE
      DATE_DIFF(LAST_DAY(months), months, DAY) + 1
  END
    ) AS daily_baseline_gmv_eur,
    ROW_NUMBER() OVER (
      PARTITION BY global_entity_id, months, company_uuid
      ORDER BY baseline_gmv_eur DESC
    ) AS row_num
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_cp_am_inherited_model` AS am_inherited_model
  LEFT JOIN suspended_companies
    ON am_inherited_model.company_uuid = suspended_companies.cp_company_uuid
  WHERE am_inherited_model.new_gmv_ref_date IS NOT NULL
),

daily_baseline_gmv_distinct AS (
  SELECT *
  FROM daily_baseline_gmv
  WHERE row_num = 1
),

daily_baseline_final AS (
 SELECT
    dates.date_local,
    dates.month_start_date,
    daily_baseline_gmv_distinct.region,
    daily_baseline_gmv_distinct.global_entity_id,
    daily_baseline_gmv_distinct.company_uuid,
    daily_baseline_gmv_distinct.new_gmv_ref_date,
    daily_baseline_gmv_distinct.suspended_date,
    daily_baseline_gmv_distinct.baseline_gmv_eur,
    daily_baseline_gmv_distinct.daily_baseline_gmv_eur
  FROM dates
  LEFT JOIN daily_baseline_gmv_distinct
    ON dates.month_start_date = daily_baseline_gmv_distinct.months
  WHERE dates.date_local >>= DATE_ADD(daily_baseline_gmv_distinct.new_gmv_ref_date, INTERVAL 30 DAY)
  -- WHERE dates.date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH)
    AND dates.date_local << COALESCE(daily_baseline_gmv_distinct.suspended_date, CURRENT_DATE())
    AND daily_baseline_gmv_distinct.company_uuid IS NOT NULL
  order by 4,1
),

daily_gmv AS (
  SELECT
    region,
    global_entity_id,
    country_name,
    date_local,
    EXTRACT(MONTH FROM date_local) AS month_local,
    company_uuid,
    SUM(IF(is_new_gmv_order IS TRUE, total_corporate_gmv_eur, 0)) AS new_gmv_eur,
    SUM(IF(is_new_gmv_order IS NOT TRUE, total_corporate_gmv_eur, 0)) AS existing_gmv_eur
  FROM `fulfillment-dwh-production.pandata_report.cp_combined_orders`
  WHERE date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH)
  GROUP BY ALL
  
),
am_perf_company AS (
  SELECT 
    daily_baseline_final.*,
    shared_countries.name AS country_name,
    daily_gmv.existing_gmv_eur,
    COALESCE(daily_gmv.existing_gmv_eur, 0) - daily_baseline_final.daily_baseline_gmv_eur AS am_perf
  FROM daily_baseline_final
  LEFT JOIN daily_gmv
    ON daily_baseline_final.global_entity_id = daily_gmv.global_entity_id
    AND daily_baseline_final.company_uuid = daily_gmv.company_uuid
    AND daily_baseline_final.date_local = daily_gmv.date_local
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
    ON daily_baseline_final.global_entity_id = shared_countries.global_entity_id
    WHERE daily_baseline_final.date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH)
),

am_perf AS (
  SELECT 
    date_local, 
    region,
    global_entity_id, 
    country_name,
    SUM(am_perf) AS cty_am_perf
  FROM am_perf_company
  GROUP BY ALL
),

gmv_summary AS (
  SELECT 
    cp_combined_summary.global_entity_id,
    cp_combined_summary.date_local,
    SUM(cp_combined_summary.total_corporate_gmv_eur) AS corporate_gmv_eur,
    SUM(cp_combined_summary.total_gmv_eur) AS platform_gmv_eur
  FROM `fulfillment-dwh-production.pandata_report.cp_combined_summary` AS cp_combined_summary
  WHERE cp_combined_summary.date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH)
  GROUP BY 
    cp_combined_summary.global_entity_id,
    cp_combined_summary.date_local
), 

active_users AS (
  SELECT 
    orders.global_entity_id, 
    DATE(orders.placed_at_local) AS date_local, 
    COUNT(DISTINCT CASE WHEN orders.is_corporate THEN orders.customer_id END) AS corp_active_users,
    COUNT(DISTINCT orders.customer_id) AS platform_active_users
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` AS orders
  WHERE orders.partition_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH)
    AND orders.is_successful
    AND orders.order_status <<>> "PENDING_ORDER_FAILED"
    AND orders.global_entity_id IN ("FP_PK", "FP_SG", "FP_TW", "FP_KH", "FP_LA", "FP_PH", "FP_TH", "FP_BD", "FP_HK", "FP_MY","MJM_AT", "OP_SE", "FO_NO", "DJ_CZ", "NP_HU")
  GROUP BY 
    orders.global_entity_id, 
    DATE(orders.placed_at_local)
)

SELECT 
  am_perf.region,
  am_perf.global_entity_id,
  am_perf.country_name,
  am_perf.date_local,
  -- am_perf.baseline_daily_gmv_eur,
  -- am_perf.new_gmv_eur,
  -- am_perf.existing_gmv_eur,
  am_perf.cty_am_perf,
  gmv_summary.corporate_gmv_eur,
  gmv_summary.platform_gmv_eur,
  active_users.corp_active_users,
  active_users.platform_active_users,
  am_perf.date_local = DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY) AS is_yesterday,
  am_perf.date_local = DATE_SUB(CURRENT_DATE(), INTERVAL 2 DAY) AS is_2yesterday,
  am_perf.date_local = DATE_SUB(CURRENT_DATE(), INTERVAL 8 DAY) AS is_same_day_last_week,
  am_perf.date_local = DATE_SUB(CURRENT_DATE(), INTERVAL 9 DAY) AS is_2same_day_last_week
FROM am_perf
LEFT JOIN gmv_summary
  ON am_perf.global_entity_id = gmv_summary.global_entity_id
 AND am_perf.date_local = gmv_summary.date_local
LEFT JOIN active_users
  ON am_perf.global_entity_id = active_users.global_entity_id
 AND am_perf.date_local = active_users.date_local
ORDER BY 1 DESC, 2, 3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.06dq0hc0nsuupl1ba53x71rnasb1' name='Custom SQL Query' type='text'><![CDATA[-- works, but baseline gmv per month is slightly different from am_inherited_model
WITH dates AS (
