    <datasource caption='Custom SQL Query (curated_data_shared_coredata_business)' inline='true' name='federated.1mbeg540v1vzc01aalvax18oy4q5' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1gvvvbg0o0gqvz1bvcnfy1r21b2p'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='curated_data_shared_coredata_business' server-oauth='' username='yue.tee@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1gvvvbg0o0gqvz1bvcnfy1r21b2p' name='Custom SQL Query' type='text'><![CDATA[with cdbo_temp AS (
select
    orders.global_entity_id, 
    shared_countries.name AS country_name,
    DATE(orders.placed_at_local) AS date_local,
    orders.order_id,
    orders.delivery_provider AS expedition_type, 
    orders.is_corporate,
    CASE
      WHEN bt.business_type IS NULL THEN "restaurants"
      WHEN bt.business_type IN ("kitchens", "concepts") THEN "kitchens"
      WHEN bt.business_type IN ("dmart") THEN "pandamart"
      ELSE bt.business_type
    END AS vendor_type,
    CASE
      WHEN DATE(orders.placed_at_local) <<= DATE_ADD(sf_opp_data.new_gmv_ref_date, INTERVAL 30 DAY)
      THEN 1
      ELSE 0
    END AS new_gmv_order,
    CASE
      WHEN DATE(orders.placed_at_local) <<= DATE_ADD(sf_opp_data.new_gmv_ref_date, INTERVAL 30 DAY)
      THEN acc.gmv_eur
      ELSE 0
    END AS new_gmv_eur,
    acc.gmv_eur
  from `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` AS orders
  left join `fulfillment-dwh-production.pandata_datamart.preprocessing__core_vendor_business_types` AS bt
    ON orders.vendor_id = bt.vendor_code
    AND orders.global_entity_id = bt.global_entity_id
  left join `fulfillment-dwh-production.pandata_curated.cp_orders` AS cp_orders
   ON orders.global_entity_id = cp_orders.global_entity_id
   AND orders.order_id = cp_orders.pd_order_code
  left join `fulfillment-dwh-production.pandata_report.regional_apac_cp_sf_opportunities` AS sf_opp_data
    on cp_orders.cp_company_id = sf_opp_data.corp_backend_id
    and cp_orders.global_entity_id = sf_opp_data.global_entity_id
  left join `fulfillment-dwh-production.pandata_report.regional_eu__pd_orders_agg_accounting` AS acc
    on orders.order_id = acc.order_code
    and cp_orders.global_entity_id = acc.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
    ON orders.global_entity_id = shared_countries.global_entity_id
   WHERE orders.partition_date_local >>= DATE_TRUNC(DATE_SUB(current_date(), INTERVAL 2 MONTH), MONTH)
    AND DATE(orders.placed_at_local) >>= DATE_TRUNC(DATE_SUB(current_date(), INTERVAL 2 MONTH), MONTH)
    and acc.created_date_utc >>= DATE_TRUNC(DATE_SUB(current_date(), INTERVAL 2 MONTH), MONTH)
    AND(shared_countries.region = "Europe" AND shared_countries.name NOT IN ("Finland", "Germany"))
    AND orders.order_status != "PENDING_ORDER_FAILED"
    AND orders.is_successful
    AND orders.is_corporate
), 

cdbo_eu AS (
  select 
    global_entity_id,  
    country_name,  
    date_local,  
    order_id,  
    expedition_type,  
    is_corporate,  
    vendor_type,  
    new_gmv_eur,  
    IF(new_gmv_order != 1, gmv_eur - new_gmv_eur, 0) AS existing_gmv_eur,
    gmv_eur
  from cdbo_temp
),
cdbo AS (
  select
    orders.global_entity_id, 
    shared_countries.name AS country_name,
    DATE(orders.placed_at_local) AS date_local,
    orders.order_id,
    orders.delivery_provider AS expedition_type, 
    orders.is_corporate,
    CASE
      WHEN bt.business_type IS NULL THEN "restaurants"
      WHEN bt.business_type IN ("kitchens", "concepts") THEN "kitchens"
      WHEN bt.business_type IN ("dmart") THEN "pandamart"
      ELSE bt.business_type
    END AS vendor_type,
    IF(cp_order_level.is_new_gmv_order, cp_order_level.gmv_eur, 0) AS new_gmv_eur, 
    IF(NOT cp_order_level.is_new_gmv_order, cp_order_level.gmv_eur, 0) AS existing_gmv_eur,
    cp_order_level.gmv_eur
  from `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` AS orders
  left join `fulfillment-dwh-production.pandata_datamart.preprocessing__core_vendor_business_types` AS bt
    ON orders.vendor_id = bt.vendor_code
    AND orders.global_entity_id = bt.global_entity_id
  left join `fulfillment-dwh-production.pandata_report.regional_apac_cp_order_level` AS cp_order_level
    on orders.order_id = cp_order_level.order_code
    and orders.global_entity_id = cp_order_level.global_entity_id
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
    ON orders.global_entity_id = shared_countries.global_entity_id
   WHERE orders.partition_date_local >>= DATE_TRUNC(DATE_SUB(current_date(), INTERVAL 2 MONTH), MONTH)
    AND DATE(orders.placed_at_local) >>= DATE_TRUNC(DATE_SUB(current_date(), INTERVAL 2 MONTH), MONTH)
    AND cp_order_level.date_local >>= DATE_TRUNC(DATE_SUB(current_date(), INTERVAL 2 MONTH), MONTH)
    AND (shared_countries.company_name = "Foodpanda" AND shared_countries.region = "Asia")
    AND orders.order_status != "PENDING_ORDER_FAILED"
    AND orders.is_successful
    AND orders.is_corporate
  
  UNION ALL 
  
  SELECT *
  FROM cdbo_eu
)

select 
  global_entity_id,
  date_local,
  country_name,
  vendor_type,
  expedition_type,
  SUM(new_gmv_eur) AS new_gmv_eur, 
  SUM(existing_gmv_eur) AS existing_gmv_eur,
  SUM(gmv_eur) AS gmv_eur,
 -- to modify when using dbt
  date_local = DATE_SUB(current_date(), INTERVAL 1 DAY) AS is_yesterday,
  date_local = DATE_SUB(current_date(), INTERVAL 2 DAY) AS is_2yesterday,
  date_local = DATE_SUB(current_date(), INTERVAL 8 DAY) AS is_same_day_last_week,
  date_local = DATE_SUB(current_date(), INTERVAL 9 DAY) AS is_2same_day_last_week
FROM cdbo 
GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
