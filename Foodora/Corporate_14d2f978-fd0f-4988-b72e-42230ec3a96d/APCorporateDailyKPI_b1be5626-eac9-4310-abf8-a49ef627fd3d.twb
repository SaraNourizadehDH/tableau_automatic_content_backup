    <worksheet name='Yest GMV Vendor Type 2'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Semibold' fontsize='11'>Vendor Type</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_coredata_business)' name='federated.1mbeg540v1vzc01aalvax18oy4q5' />
          </datasources>
          <datasource-dependencies datasource='federated.1mbeg540v1vzc01aalvax18oy4q5'>
            <column caption='% of total GMV' datatype='real' name='[% of total Orders (copy)_45739685113950209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Yesterday&apos;s Orders Main (copy)_45739685114138626]&#10;/ &#10;sum({fixed: sum(iif([is_yesterday], [gmv_eur], 0))}))' />
            </column>
            <column caption='Ystd New GMV Main' datatype='real' name='[Calculation_6743647866350043137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IIF([is_yesterday], [new_gmv_eur], null)))' />
            </column>
            <column caption='% of New GMV' datatype='real' name='[Calculation_6743647866350927876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_6743647866350043137]&#10;/ &#10;sum({fixed: sum(iif([is_yesterday], [new_gmv_eur], 0))}))' />
            </column>
            <column caption='L7D GMV Main' datatype='real' name='[L7D Orders Main (copy)_45739685114609668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([is_same_day_last_week], [gmv_eur], null))' />
            </column>
            <column caption='GMV WoW Main (Negative)' datatype='string' name='[Orders WoW Main (Negative) (copy)_45739685114871813]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s Orders Main (copy)_45739685114138626] - [L7D Orders Main (copy)_45739685114609668]) / [L7D Orders Main (copy)_45739685114609668] &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s Orders Main (copy)_45739685114138626] - [L7D Orders Main (copy)_45739685114609668]) / [L7D Orders Main (copy)_45739685114609668] &lt;= 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s Orders Main (copy)_45739685114138626] - [L7D Orders Main (copy)_45739685114609668]) / [L7D Orders Main (copy)_45739685114609668] * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='GMV WoW Main (Positive)' datatype='string' name='[Orders WoW Main (Positive) (copy)_45739685114253315]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;([Yesterday&apos;s Orders Main (copy)_45739685114138626] - [L7D Orders Main (copy)_45739685114609668]) / iif([L7D Orders Main (copy)_45739685114609668] = 0, 1, [L7D Orders Main (copy)_45739685114609668]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s Orders Main (copy)_45739685114138626] - [L7D Orders Main (copy)_45739685114609668]) / iif([L7D Orders Main (copy)_45739685114609668] = 0, 1, [L7D Orders Main (copy)_45739685114609668]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s Orders Main (copy)_45739685114138626] - [L7D Orders Main (copy)_45739685114609668]) / iif([L7D Orders Main (copy)_45739685114609668] = 0, 1, [L7D Orders Main (copy)_45739685114609668]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
            </column>
            <column caption='Yesterday&apos;s GMV Main' datatype='real' name='[Yesterday&apos;s Orders Main (copy)_45739685114138626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IIF([is_yesterday], [gmv_eur], null)))' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='GMV Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column caption='Is Same Day Last Week' datatype='boolean' name='[is_same_day_last_week]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_yesterday]' role='dimension' type='nominal' />
            <column caption='New GMV EUR' datatype='real' name='[new_gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[% of total Orders (copy)_45739685113950209]' derivation='User' name='[usr:% of total Orders (copy)_45739685113950209:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_6743647866350927876]' derivation='User' name='[usr:Calculation_6743647866350927876:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Orders WoW Main (Negative) (copy)_45739685114871813]' derivation='User' name='[usr:Orders WoW Main (Negative) (copy)_45739685114871813:nk]' pivot='key' type='nominal' />
            <column-instance column='[Orders WoW Main (Positive) (copy)_45739685114253315]' derivation='User' name='[usr:Orders WoW Main (Positive) (copy)_45739685114253315:nk]' pivot='key' type='nominal' />
            <column-instance column='[Yesterday&apos;s Orders Main (copy)_45739685114138626]' derivation='User' name='[usr:Yesterday&apos;s Orders Main (copy)_45739685114138626:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[vendor_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;caterers&quot;' value='Caterers' />
                <alias key='&quot;kitchens&quot;' value='Kitchens' />
                <alias key='&quot;restaurants&quot;' value='Restaurants' />
                <alias key='&quot;shops&quot;' value='Shops' />
                <alias key='&quot;vouchers&quot;' value='Vouchers' />
