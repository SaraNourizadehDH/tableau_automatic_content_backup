                  <value>&quot;Hungary&quot;</value>
                  <value>&quot;Norway&quot;</value>
                  <value>&quot;Sweden&quot;</value>
                </bin>
              </calculation>
            </column>
            <column-instance column='[Calculation_5011099017608728578]' derivation='Attribute' name='[attr:Calculation_5011099017608728578:nk]' pivot='key' type='nominal' />
