        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.077pas40h4nqpg16z75sk12mssxl'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='yue.tee@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.077pas40h4nqpg16z75sk12mssxl' name='Custom SQL Query' type='text'>SELECT 
  table_name,
  column_name,
  description, 
  DATETIME(TIMESTAMP_MILLIS(t.last_modified_time)) AS last_modified_time,
  IF((DATE(TIMESTAMP_MILLIS(t.last_modified_time)) &gt;&gt;= CURRENT_DATE - 1), TRUE, FALSE) AS is_data_fresh
FROM `fulfillment-dwh-production.pandata_report.INFORMATION_SCHEMA.COLUMN_FIELD_PATHS` AS c
LEFT JOIN `fulfillment-dwh-production.pandata_report.__TABLES__` AS t
        ON c.table_name = t.table_id
WHERE table_name IN (
  &quot;regional_apac_cp_daily_kpi&quot;,
  &quot;regional_apac_cp_daily_kpi_giftcard&quot;,
  &quot;regional_apac_cp_daily_kpi_pandapro&quot;
)
  AND column_name IN (
    &quot;total_gmv_eur&quot;,
    &quot;total_gift_card_gmv&quot;,
    &quot;total_gtv_eur&quot;,
    &quot;total_number_of_failed_orders&quot;,
    &quot;total_over_ten_minutes_late_orders&quot;,
    &quot;total_new_company_with_first_order_count&quot;,
    &quot;total_new_customer_count&quot;,
    &quot;total_active_customer_count&quot;,
    &quot;total_existing_customer_count&quot;,
    &quot;new_signed_users&quot;,
    &quot;subscriber_count&quot;,
    &quot;subscriber_company_count&quot;
  )</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.077pas40h4nqpg16z75sk12mssxl' name='Custom SQL Query' type='text'>SELECT 
  table_name,
  column_name,
  description, 
  DATETIME(TIMESTAMP_MILLIS(t.last_modified_time)) AS last_modified_time,
  IF((DATE(TIMESTAMP_MILLIS(t.last_modified_time)) &gt;&gt;= CURRENT_DATE - 1), TRUE, FALSE) AS is_data_fresh
FROM `fulfillment-dwh-production.pandata_report.INFORMATION_SCHEMA.COLUMN_FIELD_PATHS` AS c
LEFT JOIN `fulfillment-dwh-production.pandata_report.__TABLES__` AS t
        ON c.table_name = t.table_id
WHERE table_name IN (
