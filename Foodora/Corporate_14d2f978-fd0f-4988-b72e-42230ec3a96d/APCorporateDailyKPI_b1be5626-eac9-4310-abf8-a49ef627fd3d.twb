      </column>
      <column caption='Fail Rate WoW Main (Positive)' datatype='string' name='[AFV WoW Main (Positive) (copy)_45739686625210400]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Yesterday&apos;s AFV Main (copy)_45739686624358429] - [L7D AFV Main (copy)_45739686624632862]) / iif([L7D AFV Main (copy)_45739686624632862] = 0, 1, [L7D AFV Main (copy)_45739686624632862]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s AFV Main (copy)_45739686624358429] - [L7D AFV Main (copy)_45739686624632862]) / iif([L7D AFV Main (copy)_45739686624632862] = 0, 1, [L7D AFV Main (copy)_45739686624632862]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s AFV Main (copy)_45739686624358429] - [L7D AFV Main (copy)_45739686624632862]) / iif([L7D AFV Main (copy)_45739686624632862] = 0, 1, [L7D AFV Main (copy)_45739686624632862]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
      </column>
      <column caption='DT WoW Main (Positive)' datatype='string' name='[AFV WoW Main (Positive) (copy)_45739686631563305]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;([Yesterday&apos;s AFV Main (copy)_45739686631297062] - [L7D AFV Main (copy)_45739686631391271]) / iif([L7D AFV Main (copy)_45739686631391271] = 0, 1, [L7D AFV Main (copy)_45739686631391271]) &gt; 0&#10;then &apos;▲ &apos; &#10;ELSE null&#10;end&#10;&#10;+&#10;&#10;if&#10;([Yesterday&apos;s AFV Main (copy)_45739686631297062] - [L7D AFV Main (copy)_45739686631391271]) / iif([L7D AFV Main (copy)_45739686631391271] = 0, 1, [L7D AFV Main (copy)_45739686631391271]) &gt; 0&#10;then&#10;str(&#10;round(&#10;    ([Yesterday&apos;s AFV Main (copy)_45739686631297062] - [L7D AFV Main (copy)_45739686631391271]) / iif([L7D AFV Main (copy)_45739686631391271] = 0, 1, [L7D AFV Main (copy)_45739686631391271]) * 100,&#10; 1)&#10;)&#10;+&quot;%&quot;&#10;else null&#10;end' />
      </column>
      <column caption='New Customer Per Day' datatype='integer' name='[AVG DT Per Day (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date_local]:&#10;SUM([Calculation_841399086563610626])&#10;}' />
      </column>
      <column caption='AVG Failed Rate Per Day' datatype='real' name='[AVG DT Per Day (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date_local]:&#10;SUM([total_number_of_failed_orders]) / SUM([total_number_of_orders])&#10;}' />
      </column>
      <column caption='T7D AFV Growth' datatype='string' name='[Calculation_128141501190492177]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(avg([AFV Per Day (copy)_128141501170745359]) - avg([AFV Per Day By Country (copy)_128141501189500944]))&#10;/&#10;avg([AFV Per Day By Country (copy)_128141501189500944]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;    (avg([AFV Per Day (copy)_128141501170745359]) - avg([AFV Per Day By Country (copy)_128141501189500944]))&#10;    /&#10;    avg([AFV Per Day By Country (copy)_128141501189500944]) &#10;    * 100&#10;    , 2&#10;))&#10;+ &apos;%&apos;' />
      </column>
      <column caption='T7D Fail Rate Growth %' datatype='string' name='[Calculation_128141501292404766]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(avg([T7D AFV Eur (copy)_128141501287256090]) - avg([T7D Failed Order Rate (copy)_128141501291302940]))&#10;/&#10;avg([T7D Failed Order Rate (copy)_128141501291302940]) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(&#10;round(&#10;&#10;(avg([T7D AFV Eur (copy)_128141501287256090]) - avg([T7D Failed Order Rate (copy)_128141501291302940]))&#10;/&#10;avg([T7D Failed Order Rate (copy)_128141501291302940])&#10;*100,&#10;2&#10;)&#10;)' />
      </column>
      <column caption='Expedition Type (Simplified)' datatype='string' name='[Calculation_1393652988175007744]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [expedition_type] = &quot;pickup&quot; THEN &quot;Pickup&quot; ELSE &quot;Delivery&quot; END' />
      </column>
      <column caption='percent_active_companies' datatype='real' name='[Calculation_1592515061529714745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([total_active_company_count]/ [active_companies])*100' />
      </column>
      <column caption='INDEX' datatype='integer' name='[Calculation_2537426552784424960]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='DayOfWeek' datatype='string' name='[Calculation_2636153901957091335]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [date_local])' />
      </column>
      <column caption='exclude_today' datatype='boolean' name='[Calculation_3496974746352320512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Berlin time 3am - 10am SGT&#10;IIF(DATEPART(&apos;hour&apos;, NOW()) &lt;= 2, [date_local] &lt;= NOW() - 2, [date_local] != TODAY())' />
      </column>
      <column caption='Total GMV EUR Per Day' datatype='real' name='[Calculation_3496974746357850113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date_local]:&#10;SUM([gmv_eur])&#10;}' />
      </column>
      <column caption='L7D &amp; Previous L7D' datatype='string' name='[Calculation_4159918685516095489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [date_local] &gt; DATEADD(&apos;day&apos;, -8, NOW()) AND [date_local] &lt;= NOW() - 1&#10;THEN &apos;L7D&apos;&#10;ELSEIF [date_local] &gt;= DATEADD(&apos;day&apos;, -15, NOW()) AND [date_local] &lt;= DATEADD(&apos;day&apos;, -8, NOW())&#10;THEN &apos;Previous L7D&apos;&#10;END' />
      </column>
      <column caption='DayofWeek' datatype='string' name='[Calculation_4159918685516247042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [date_local])' />
      </column>
      <column caption='Day (Similar Scale)' datatype='datetime' name='[Calculation_4159918685516587011]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [date_local] &lt; DATEADD(&apos;day&apos;, -8, now())&#10;THEN DATEADD(&apos;day&apos;, 7, [date_local])&#10;ELSE [date_local]&#10;END' />
      </column>
      <column caption='New GMV MTD vs PMTD (Indicator) ' datatype='string' name='[Calculation_4159918685521801220]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_4159918685522096133], [new_gmv_eur], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_4159918685522141190], [new_gmv_eur], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_4159918685522141190], [new_gmv_eur], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end' />
      </column>
      <column caption='MTD' datatype='boolean' name='[Calculation_4159918685522096133]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date_local], today() - 1) = 0&#10;AND&#10;DAY([date_local]) &lt;= DAY(TODAY()-1)' />
      </column>
      <column caption='PMTD' datatype='boolean' name='[Calculation_4159918685522141190]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date_local], today() - 1) = 1&#10;AND&#10;DAY([date_local]) &lt;= DAY(TODAY()-1)' />
      </column>
      <column caption='New GMV MTD vs PMTD' datatype='string' name='[Calculation_4159918685522604040]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_4159918685522096133], [new_gmv_eur], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_4159918685522141190], [new_gmv_eur], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_4159918685522141190], [new_gmv_eur], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([Calculation_4159918685522096133], [new_gmv_eur], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_4159918685522141190], [new_gmv_eur], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_4159918685522141190], [new_gmv_eur], 0)&#10;) * 100&#10;,2)&#10;)' />
      </column>
