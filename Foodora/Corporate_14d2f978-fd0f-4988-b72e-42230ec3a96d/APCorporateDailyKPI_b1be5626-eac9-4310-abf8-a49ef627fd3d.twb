          <formatted-text>
            <run bold='true' fontsize='14'>Lowest Growth</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily KPI Metrics' name='federated.01h9amz18ivzmc11aksub0tqj9q9' />
