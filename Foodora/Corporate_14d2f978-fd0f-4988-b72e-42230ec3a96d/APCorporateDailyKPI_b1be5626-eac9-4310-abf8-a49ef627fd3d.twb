    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Description'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APCorporateDailyKPI/Description?rev=' id='Description' path='/t/Foodora/workbooks/APCorporateDailyKPI' revision='' site='Foodora' />
      <style />
      <size maxheight='800' maxwidth='1250' minheight='800' minwidth='1250' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='60625' id='3' type-v2='text' w='98720' x='640' y='15875'>
            <formatted-text>
              <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>Purpose/ Description</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>- Daily performance tracking for all important Corporate metrics  </run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='10'>- Refreshes Daily</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>How to use the dashboard (tabs)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>GMV KPI: </run>
              <run fontcolor='#555555' fontsize='10'>GMV performance daily over the last 7 days</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>New GMV KPI: </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ </run>
              <run fontcolor='#555555' fontname='Tableau Medium' fontsize='10'>New G</run>
              <run fontcolor='#555555' fontsize='10'>MV performance daily over the last 7 days</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='10'>AM Growth KPI: </run>
              <run fontcolor='#555555' fontsize='10'>AM Growth performance daily over last 7 days </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='10'>Active Users KPI: </run>
              <run fontcolor='#555555' fontsize='10'>Corporate Active Users performance over last 7 days</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Platform GMV % KPI: </run>
              <run fontcolor='#555555' fontsize='10'>Percentage of corporate GMV compared to Platform GMV over last 7 days </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Platform Active Users % KPI: </run>
              <run fontcolor='#555555' fontname='Benton Sans Book' fontsize='10'>Percentage of active corporate users compared to total active platform users over the past 7 days.</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontcolor='#cb2866' fontname='Tableau Medium' fontsize='15'>POCs</run>
              <run>Æ&#10;</run>
              <run fontcolor='#555555' fontsize='11'>Please reach out in #pandata-corporate if there are any issues.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
