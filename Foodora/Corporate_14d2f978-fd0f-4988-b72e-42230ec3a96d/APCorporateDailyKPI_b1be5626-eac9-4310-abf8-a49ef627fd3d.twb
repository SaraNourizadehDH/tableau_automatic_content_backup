      </column>
      <column caption='Active Users (Indicator) ' datatype='integer' name='[AM Growth (Indicator) (copy)_5011099017645207589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if isnull(sum([corp_active_users])) then 0&#10;elseif ((sum([corp_active_users]) - [AM Growth L7D Average (copy)_5011099017644986404])/abs([AM Growth L7D Average (copy)_5011099017644986404]) &gt;= 0.1)&#10;then 2&#10;elseif (sum([corp_active_users]) - [AM Growth L7D Average (copy)_5011099017644986404])/abs([AM Growth L7D Average (copy)_5011099017644986404]) &lt;= -0.1 &#10;then -2&#10;elseif ((sum([corp_active_users]) - [AM Growth L7D Average (copy)_5011099017644986404])/abs([AM Growth L7D Average (copy)_5011099017644986404]) &gt;= 0.05)&#10;then 1&#10;elseif (sum([corp_active_users]) - [AM Growth L7D Average (copy)_5011099017644986404])/abs([AM Growth L7D Average (copy)_5011099017644986404]) &lt;= -0.05&#10;then -1&#10;else 0&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Active Users L7D Average ' datatype='real' name='[AM Growth L7D Average (copy)_5011099017644986404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(sum([corp_active_users]),first(),first()+6)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Active Users Per Day' datatype='integer' name='[AM Growth Per Day (copy)_5011099017675108418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date_local]:&#10;SUM([corp_active_users])&#10;}' />
      </column>
