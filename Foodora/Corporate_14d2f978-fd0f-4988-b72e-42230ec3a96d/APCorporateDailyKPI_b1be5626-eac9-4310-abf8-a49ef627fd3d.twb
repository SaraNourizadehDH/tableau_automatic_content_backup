    <worksheet name='Active Users WoW Region'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Active Users WoW %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily KPI Metrics' name='federated.01h9amz18ivzmc11aksub0tqj9q9' />
          </datasources>
          <datasource-dependencies datasource='federated.01h9amz18ivzmc11aksub0tqj9q9'>
            <column caption='L1W' datatype='boolean' name='[Calculation_5011099017624190994]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_same_day_last_week]' />
            </column>
            <column aggregation='Sum' caption='1 Wow AM ' datatype='integer' name='[Calculation_5011099017624907796]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='WoW %' />
              </aliases>
            </column>
            <column datatype='string' name='[Region]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='categorical-bin' column='[country_name]' new-bin='true'>
                <bin default-name='false' value='&quot;APAC&quot;'>
                  <value>&quot;Bangladesh&quot;</value>
                  <value>&quot;Cambodia&quot;</value>
                  <value>&quot;Hong Kong&quot;</value>
                  <value>&quot;Laos&quot;</value>
                  <value>&quot;Malaysia&quot;</value>
                  <value>&quot;Pakistan&quot;</value>
                  <value>&quot;Philippines&quot;</value>
                  <value>&quot;Singapore&quot;</value>
                  <value>&quot;Taiwan&quot;</value>
                  <value>&quot;Thailand&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;EU&quot;'>
                  <value>&quot;Austria&quot;</value>
                  <value>&quot;Czech Republic&quot;</value>
                  <value>&quot;Hungary&quot;</value>
                  <value>&quot;Norway&quot;</value>
                  <value>&quot;Sweden&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='W1 Active Users % ' datatype='string' name='[W1 AM Growth % (copy)_5011099017644040225]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [corp_active_users] ELSE 0 END) - SUM(IF [Calculation_5011099017624190994] THEN [corp_active_users] ELSE 0 END))&#10;/ ABS(SUM(IF [Calculation_5011099017624190994] THEN [corp_active_users] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;   (SUM(IF [is_yesterday] THEN [corp_active_users] ELSE 0 END) - SUM(IF [Calculation_5011099017624190994] THEN [corp_active_users] ELSE 0 END))&#10;   / ABS(SUM(IF [Calculation_5011099017624190994] THEN [corp_active_users] ELSE 0 END))&#10; * 100, 2))' />
            </column>
            <column caption='W1 Active Users (Indicator) ' datatype='string' name='[W1 AM Growth (Indicator) (copy)_5011099017644433443]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [corp_active_users] ELSE 0 END) - SUM(IF [Calculation_5011099017624190994] THEN [corp_active_users] ELSE 0 END))&#10;/ ABS(SUM(IF [Calculation_5011099017624190994] THEN [corp_active_users] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column datatype='integer' name='[corp_active_users]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
