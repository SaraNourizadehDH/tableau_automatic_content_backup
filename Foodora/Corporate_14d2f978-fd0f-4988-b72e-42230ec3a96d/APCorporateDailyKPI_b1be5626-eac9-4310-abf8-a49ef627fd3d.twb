        <calculation class='tableau' formula='if&#10;([Calculation_5054023968042426379] - [Calculation_5054023968042672140]) / [Calculation_5054023968042672140] &lt;= 0&#10;then &apos;▼&apos; &#10;ELSE &apos;▲&apos; &#10;end' />
