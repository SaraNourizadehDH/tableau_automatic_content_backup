              <calculation class='tableau' formula='1' />
            </column>
            <column caption='W1 AM Growth %' datatype='string' name='[Calculation_5011099017623363601]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (SUM(IF [is_yesterday] THEN [cty_am_perf] ELSE 0 END) - SUM(IF [Calculation_5011099017624190994] THEN [cty_am_perf] ELSE 0 END))&#10;/ ABS(SUM(IF [Calculation_5011099017624190994] THEN [cty_am_perf] ELSE 0 END)) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(&#10;   (SUM(IF [is_yesterday] THEN [cty_am_perf] ELSE 0 END) - SUM(IF [Calculation_5011099017624190994] THEN [cty_am_perf] ELSE 0 END))&#10;   / ABS(SUM(IF [Calculation_5011099017624190994] THEN [cty_am_perf] ELSE 0 END))&#10; * 100, 2))' />
            </column>
