    <worksheet name='Active Users MTD %'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Active Users MTD %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily KPI Metrics' name='federated.01h9amz18ivzmc11aksub0tqj9q9' />
          </datasources>
          <datasource-dependencies datasource='federated.01h9amz18ivzmc11aksub0tqj9q9'>
            <column caption='MTD' datatype='boolean' name='[Calculation_5011099017613279238]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date_local], today() - 1) = 0&#10;AND&#10;DAY([date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_5011099017613451271]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [date_local], today() - 1) = 1&#10;AND&#10;DAY([date_local]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='MTD Growth %' datatype='integer' name='[Calculation_5011099017614192650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD Growth %' />
              </aliases>
            </column>
            <column caption='Active Users MTD vs PMTD' datatype='string' name='[Calculation_5011099017641889818]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_5011099017613279238], [corp_active_users], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_5011099017613451271], [corp_active_users], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;ABS(SUM(&#10;    iif([Calculation_5011099017613451271], [corp_active_users], 0))&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([Calculation_5011099017613279238], [corp_active_users], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_5011099017613451271], [corp_active_users], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_5011099017613451271], [corp_active_users], 0)&#10;) * 100&#10;,2)&#10;)' />
            </column>
            <column caption='Active Users MTD vs PMTD (Indicator)' datatype='string' name='[Calculation_5011099017642061851]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;(&#10;    SUM(IIF([Calculation_5011099017613279238], [corp_active_users], 0)) &#10;    - &#10;    SUM(IIF([Calculation_5011099017613451271], [corp_active_users], 0))&#10;)&#10;/ &#10;ABS(SUM(IIF([Calculation_5011099017613451271], [corp_active_users], 0))) &lt;= 0&#10;THEN &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;END' />
