      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_6FF766E5E3F94360AE238EB31F9A2333'>
            <properties context=''>
              <relation connection='bigquery.118pfvf1k8k5qy1h6a00n15nzz5q' name='Custom SQL Query' type='text'>WITH cp_combined_orders AS (
  SELECT 
      global_entity_id,
      date_local AS contact_created_date_local,
      &quot;Do not exclude&quot; AS company_uuid,
      &quot;Do not exclude&quot; AS company_name,
      &quot;Do not exclude&quot; AS department,
      &quot;Do not exclude&quot; AS contact_reason_l1,
      &quot;Do not exclude&quot; AS contact_reason_l2,
      &quot;Do not exclude&quot; AS contact_reason_l3,
      &quot;Do not exclude&quot; AS herocare_type,
      &quot;Do not exclude&quot; AS contact_channel,
      &quot;Do not exclude&quot; AS agent_email,
      &quot;Do not exclude&quot; AS is_subscriber_order,
      &quot;Do not exclude&quot; AS is_subscription_benefit_order,
      0 AS number_of_ops_orders,
      SUM(total_corporate_orders) AS total_corporate_orders
  FROM `fulfillment-dwh-production.pandata_report.cp_combined_orders`
  GROUP BY ALL
),

ops_orders_count AS (
      SELECT 
            global_entity_id,  
            contact_created_date_utc AS contact_created_date_local,
            company_uuid,
            company_name,
            department,
            contact_reason_l1,
            contact_reason_l2,
            contact_reason_l3,
            herocare_type,
            contact_channel,
            agent_email,
            is_subscriber_order,
            is_subscription_benefit_order,
            COUNT(contact_id) AS number_of_ops_orders,
            0 AS total_corporate_orders
      FROM `fulfillment-dwh-production.pandata_report.regional_apac_cp_ops_contacts`
      GROUP BY ALL
)

SELECT *
FROM cp_combined_orders
UNION ALL
SELECT *
FROM ops_orders_count</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
