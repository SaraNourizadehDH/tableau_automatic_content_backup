            <column caption='Company Name' datatype='string' name='[company_name]' role='dimension' type='nominal' />
            <column caption='Company Uuid' datatype='string' name='[company_uuid]' role='dimension' type='nominal' />
            <column caption='Contact Channel' datatype='string' name='[contact_channel]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' name='[contact_created_date_utc]' role='dimension' type='ordinal' />
            <column caption='Contact Id' datatype='string' name='[contact_id]' role='dimension' type='nominal' />
            <column caption='Contact Reason L1' datatype='string' name='[contact_reason_l1]' role='dimension' type='nominal' />
            <column caption='Contact Reason L2' datatype='string' name='[contact_reason_l2]' role='dimension' type='nominal' />
            <column caption='Contact Reason L3' datatype='string' name='[contact_reason_l3]' role='dimension' type='nominal' />
            <column-instance column='[order_code]' derivation='CountD' name='[ctd:order_code:qk]' pivot='key' type='quantitative' />
            <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Is Closed' datatype='boolean' name='[is_closed]' role='dimension' type='nominal' />
            <column caption='Is Resolved' datatype='boolean' name='[is_resolved]' role='dimension' type='nominal' />
            <column-instance column='[company_name]' derivation='None' name='[none:company_name:nk]' pivot='key' type='nominal' />
