            <column caption='Dynamic Date Range' datatype='string' name='[Calculation_1694268321498497024]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[partial_refund_amount_local Parameter] = &apos;Weekly&apos; OR [Parameters].[partial_refund_amount_local Parameter] = &apos;Week + WTD&apos;) THEN STR(DATEPART(&apos;iso-year&apos;,[contact_created_date_utc]))+&apos;-&apos;+STR(DATEPART(&apos;iso-week&apos;,[contact_created_date_utc]))&#10;ELSEIF ([Parameters].[partial_refund_amount_local Parameter] = &apos;Monthly&apos; OR [Parameters].[partial_refund_amount_local Parameter] = &apos;Month + MTD&apos;) THEN LEFT(STR(DATENAME(&apos;month&apos;,[contact_created_date_utc])),3)+&apos; &apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[contact_created_date_utc])),2)&#10;ELSEIF ([Parameters].[partial_refund_amount_local Parameter] = &apos;Quarterly&apos; OR [Parameters].[partial_refund_amount_local Parameter] = &apos;Quarterly + MTD&apos;) THEN &quot;Q&quot;+STR(DATENAME(&apos;quarter&apos;,[contact_created_date_utc]))+&apos;-&apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[contact_created_date_utc])),2)&#10;ELSEIF [Parameters].[partial_refund_amount_local Parameter] = &apos;Daily&apos; then str(DATEPART(&apos;day&apos;,[contact_created_date_utc]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[contact_created_date_utc])),3)&#10;ELSEIF [Parameters].[partial_refund_amount_local Parameter] = &apos;Yearly&apos; then RIGHT(STR(DATEPART(&apos;year&apos;,[contact_created_date_utc])),4)&#10;END' />
            </column>
            <column caption='# Resolved Cases' datatype='integer' name='[Calculation_2976668248741220352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF is_resolved THEN [contact_id] ELSE NULL END)' />
            </column>
            <column caption='AFRT (hours)' datatype='real' name='[Calculation_2976668248752779266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_resolution_time_in_hours])/[Calculation_2976668248741220352]' />
