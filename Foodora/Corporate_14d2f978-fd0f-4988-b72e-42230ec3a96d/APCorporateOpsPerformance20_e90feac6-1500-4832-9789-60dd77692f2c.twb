      <column caption='% CSAT with 4-5 score (copy)' datatype='real' name='[% CSAT with 4-5 score (copy)_3386495815217713158]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF[csat_score]&gt;= 4 THEN [contact_id] ELSE NULL END) / COUNT([csat_score]) * 100' />
