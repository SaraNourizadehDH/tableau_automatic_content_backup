          <datasource-dependencies datasource='federated.19pkvg4178knrq16oz6740iv8wr0'>
            <column caption='# Resolved Cases' datatype='integer' name='[Calculation_2976668248741220352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF is_resolved THEN [contact_id] ELSE NULL END)' />
            </column>
            <column caption='AFRT (hours)' datatype='real' name='[Calculation_2976668248752779266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_resolution_time_in_hours])/[Calculation_2976668248741220352]' />
            </column>
            <column caption='# Closed Cases' datatype='integer' name='[Calculation_2976668248760475651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF is_closed THEN [contact_id] ELSE NULL END)' />
            </column>
            <column caption='# Open Cases' datatype='integer' name='[Calculation_2976668248760619012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [status] = &quot;open&quot; THEN [contact_id] ELSE NULL END)' />
            </column>
            <column caption='# Open Cases &gt;= 5 Days' datatype='integer' name='[Calculation_2976668248789151753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [open_cases_date_diff_today]&gt;= 5 THEN [contact_id] ELSE NULL END)' />
            </column>
            <column caption='AFHT (mins)' datatype='real' name='[Calculation_2976668248790921226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_handling_time_in_seconds]/60)/[Calculation_2976668248741220352]' />
            </column>
            <column caption='# of contacts' datatype='integer' name='[Calculation_722124120239251456]' role='measure' type='quantitative'>
