        <calculation class='tableau' formula='IF ([Parameters].[partial_refund_amount_local Parameter] = &apos;Weekly&apos; OR [Parameters].[partial_refund_amount_local Parameter] = &apos;Week + WTD&apos;) THEN STR(DATEPART(&apos;iso-year&apos;,[contact_created_date_utc]))+&apos;-&apos;+STR(DATEPART(&apos;iso-week&apos;,[contact_created_date_utc]))&#10;ELSEIF ([Parameters].[partial_refund_amount_local Parameter] = &apos;Monthly&apos; OR [Parameters].[partial_refund_amount_local Parameter] = &apos;Month + MTD&apos;) THEN LEFT(STR(DATENAME(&apos;month&apos;,[contact_created_date_utc])),3)+&apos; &apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[contact_created_date_utc])),2)&#10;ELSEIF ([Parameters].[partial_refund_amount_local Parameter] = &apos;Quarterly&apos; OR [Parameters].[partial_refund_amount_local Parameter] = &apos;Quarterly + MTD&apos;) THEN &quot;Q&quot;+STR(DATENAME(&apos;quarter&apos;,[contact_created_date_utc]))+&apos;-&apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[contact_created_date_utc])),2)&#10;ELSEIF [Parameters].[partial_refund_amount_local Parameter] = &apos;Daily&apos; then str(DATEPART(&apos;day&apos;,[contact_created_date_utc]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[contact_created_date_utc])),3)&#10;ELSEIF [Parameters].[partial_refund_amount_local Parameter] = &apos;Yearly&apos; then RIGHT(STR(DATEPART(&apos;year&apos;,[contact_created_date_utc])),4)&#10;END' />
      </column>
      <column caption='unique key for ccr' datatype='string' name='[Calculation_190840042527330307]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//to ungroup the data&#10;[contact_reason_l1] + &quot;|&quot; + [contact_reason_l2] + &quot;|&quot; + [contact_reason_l3]' />
      </column>
      <column caption='# Resolved Cases' datatype='integer' name='[Calculation_2976668248741220352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF is_resolved THEN [contact_id] ELSE NULL END)' />
      </column>
      <column caption='AFHT (hours)' datatype='real' name='[Calculation_2976668248742838273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_handling_time_in_hours])/[Calculation_2976668248741220352]' />
      </column>
      <column caption='AFRT (hours)' datatype='real' name='[Calculation_2976668248752779266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_resolution_time_in_hours])/[Calculation_2976668248741220352]' />
      </column>
      <column caption='# Closed Cases' datatype='integer' name='[Calculation_2976668248760475651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF is_closed THEN [contact_id] ELSE NULL END)' />
      </column>
      <column caption='# Open Cases' datatype='integer' name='[Calculation_2976668248760619012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [status] = &quot;open&quot; THEN [contact_id] ELSE NULL END)' />
      </column>
      <column caption='# Open Cases &gt;= 5 Days' datatype='integer' name='[Calculation_2976668248789151753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [open_cases_date_diff_today]&gt;= 5 THEN [contact_id] ELSE NULL END)' />
      </column>
      <column caption='AFHT (mins)' datatype='real' name='[Calculation_2976668248790921226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_handling_time_in_seconds]/60)/[Calculation_2976668248741220352]' />
      </column>
      <column caption='AFRT (mins)' datatype='real' name='[Calculation_2976668248791273483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_resolution_time_in_minutes])/[Calculation_2976668248741220352]' />
      </column>
      <column caption='% CSAT with 4-5 score' datatype='real' name='[Calculation_2976668248797138958]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF[csat_score]&gt;= 4 THEN [contact_id] ELSE NULL END) / COUNT([csat_score]) * 100' />
      </column>
      <column caption='AHT (mins) Title' datatype='string' name='[Calculation_2976668249041338384]' role='dimension' type='nominal'>
