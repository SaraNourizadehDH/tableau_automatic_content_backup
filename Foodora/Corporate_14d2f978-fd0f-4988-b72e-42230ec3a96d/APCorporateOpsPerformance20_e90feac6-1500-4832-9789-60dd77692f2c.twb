            </column>
            <column caption='Dynamic Date Range' datatype='string' name='[Calculation_3386495815203860484]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[partial_refund_amount_local Parameter] = &apos;Weekly&apos; OR [Parameters].[partial_refund_amount_local Parameter] = &apos;Week + WTD&apos;) THEN STR(DATEPART(&apos;iso-year&apos;,[contact_created_date_local]))+&apos;-&apos;+STR(DATEPART(&apos;iso-week&apos;,[contact_created_date_local]))&#10;ELSEIF ([Parameters].[partial_refund_amount_local Parameter] = &apos;Monthly&apos; OR [Parameters].[partial_refund_amount_local Parameter] = &apos;Month + MTD&apos;) THEN LEFT(STR(DATENAME(&apos;month&apos;,[contact_created_date_local])),3)+&apos; &apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[contact_created_date_local])),2)&#10;ELSEIF ([Parameters].[partial_refund_amount_local Parameter] = &apos;Quarterly&apos; OR [Parameters].[partial_refund_amount_local Parameter] = &apos;Quarterly + MTD&apos;) THEN &quot;Q&quot;+STR(DATENAME(&apos;quarter&apos;,[contact_created_date_local]))+&apos;-&apos;+ RIGHT(STR(DATEPART(&apos;year&apos;,[contact_created_date_local])),2)&#10;ELSEIF [Parameters].[partial_refund_amount_local Parameter] = &apos;Daily&apos; then str(DATEPART(&apos;day&apos;,[contact_created_date_local]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;,[contact_created_date_local])),3)&#10;ELSEIF [Parameters].[partial_refund_amount_local Parameter] = &apos;Yearly&apos; then RIGHT(STR(DATEPART(&apos;year&apos;,[contact_created_date_local])),4)&#10;END' />
            </column>
