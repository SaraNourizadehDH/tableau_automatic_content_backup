  COUNT(DISTINCT redemption_customer_code) AS active_users_w_gc_order,
  0 AS active_users_w_allowance
FROM gc_redemption
WHERE redemption_date_local &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 6 MONTH), MONTH)
  AND global_entity_id = &quot;FP_PK&quot;
