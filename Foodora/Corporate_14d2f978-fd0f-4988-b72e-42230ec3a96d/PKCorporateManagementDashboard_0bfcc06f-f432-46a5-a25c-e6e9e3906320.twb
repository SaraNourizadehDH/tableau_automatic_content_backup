    <worksheet name='Corporate Order Summary'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (samples)' name='federated.1hoc0mf15z9sv914iehwj0vsn0hz' />
          </datasources>
          <datasource-dependencies datasource='federated.1hoc0mf15z9sv914iehwj0vsn0hz'>
            <column caption='Corporate Orders (%)' datatype='real' name='[Calculation_1049831305366298624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_corporate_orders])/SUM([total_number_of_successful_orders])' />
            </column>
            <column caption='Corporate GMV (%)' datatype='real' name='[Calculation_1049831305366888449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_corporate_gmv_eur])/SUM([total_gmv_eur])' />
            </column>
            <column caption='Total Corporate Orders (Exc Pantry &amp; Dmart_Corp)' datatype='integer' name='[Calculation_1049831305500352522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_corporate_orders])-SUM([total_pantry_orders])-SUM([total_pandamart_corporate_orders])' />
            </column>
            <column caption='New/Existing GMV' datatype='string' name='[Calculation_1049831305687584793]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF([is_new_gmv_order]=TRUE) THEN &apos;New GMV&apos; ELSE &apos;Existing GMV&apos; END' />
            </column>
            <column caption='Total Corporate GMV Local (Exc. Pantry &amp; Dmart_Corp)' datatype='real' name='[Calculation_3028881873653620737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_corporate_gmv_local])-ZN(SUM([total_pantry_gmv_local]))-ZN(SUM([total_pandamart_corporate_gmv_local]))' />
            </column>
            <column caption='Total Corporate GMV (Exc. Pantry &amp; Dmart_Corp)' datatype='real' name='[Calculation_3439694595488104448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_corporate_gmv_eur])-ZN(SUM([total_pantry_gmv_eur]))-ZN(SUM([total_pandamart_corporate_gmv_eur]))' />
            </column>
