      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='country_PK_cp_orders' id='country_PK_cp_orders_6FBE805563A54AEA950B3BD23D447D23'>
            <properties context=''>
              <relation connection='bigquery.0tmzqm71s4kq7211w9wlm1n7x6vl' name='Custom SQL Query' type='text'>with all_orders as (
select 
sb.ordered_at_date_local as date_local,
sb.global_entity_id,
sb.order_code as gross_orders,
case when sb.is_valid_order is TRUE then sb.order_code else null end as valid_order,
case when sb.is_valid_order is TRUE then sb.gmv_eur else 0 end as total_gmv_eur,
case when sb.is_valid_order is TRUE then sb.gmv_local else 0 end as total_gmv_local,
case when sb.is_valid_order is TRUE then sb.gfv_eur else 0 end as total_gfv_eur,
case when sb.is_valid_order is TRUE then sb.gfv_local else 0 end as total_gfv_local
FROM 
--`fulfillment-dwh-production.pandata_curated.pd_orders` pd
`fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` AS sb
        -- ON pd.code = sb.order_code AND 
         --pd.global_entity_id = sb.global_entity_id
WHERE sb.created_date_utc &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
and sb.global_entity_id=&quot;FP_PK&quot;
and sb.is_gross_order is TRUE
--group by 1

),
raw as (
  SELECT 
  &quot;Day&quot; AS date_type,
  a.date_local,
  a.global_entity_id,
  po.country_name,
  company_id,
  COALESCE(po.company_name, &quot;Null&quot;) AS company_name,
  CASE
    WHEN LOWER(po.company_name) LIKE &quot;%foodora%&quot;
      OR LOWER(po.company_name) LIKE &quot;%foodpanda%&quot;
      OR LOWER(po.company_name) LIKE &quot;%delivery hero%&quot;
      OR LOWER(po.company_name) LIKE &quot;%dh financial services%&quot;
      OR LOWER(po.company_name) LIKE &quot;%woowa%&quot;
      OR LOWER(po.company_name) LIKE &quot;%stores (singapore)%&quot;
    THEN &quot;PANDORA&quot;
    ELSE &quot;CORPORATE CLIENT&quot;
  END AS company_type,
  COALESCE(order_source, &quot;web&quot;) AS source, -- noqa: L029
  po.is_valid_order,
  is_corporate,
  is_dmart_order is TRUE AND v.vendor_code IN (&quot;zc9a&quot;, &quot;c6de&quot;, &quot;rt5g&quot;) AS is_pantry_order,
  v.vendor_code IN (&quot;b03g&quot;) AS is_pandamart_corporate_order,
  is_pandapro_subscriber,
  po.plan_code,
  DATE(po.date_local) = sf_company_data.first_order_date AS is_first_valid_company_order,
  is_first_valid_order,
  is_new_gmv_order,
  is_gc_order,
  CASE
    WHEN is_pandapro_subscriber IS TRUE AND is_gc_order IS TRUE THEN &quot;pro and gift card&quot;
    WHEN is_pandapro_subscriber IS TRUE AND is_gc_order IS NOT TRUE THEN &quot;pro only&quot;
    WHEN is_pandapro_subscriber IS NOT TRUE AND is_gc_order IS TRUE THEN &quot;gift card only&quot;
    ELSE &quot;non pro or giftcard&quot;
  END AS corp_order_category,
  COALESCE(po.account_owner_name, &quot;Null&quot;) AS account_owner_name,
  COALESCE(po.opportunity_owner_name, &quot;Null&quot;) AS opportunity_owner_name,
  COALESCE(po.opportunity_owner_join_date, DATE(NULL)) AS opportunity_owner_join_date,
  COALESCE(po.close_won_date, DATE(NULL)) AS close_won_date,
  COALESCE(po.corporate_solution, &quot;Null&quot;) AS corporate_solution,
  COALESCE(po.industry, &quot;Null&quot;) AS industry,
  COALESCE(po.lead_source, &quot;Null&quot;) AS lead_source,
  CASE
    WHEN number_of_employees BETWEEN 1 AND 49 THEN &quot;a. 1-49&quot;
    WHEN number_of_employees BETWEEN 50 AND 99 THEN &quot;b. 50-99&quot;
    WHEN number_of_employees BETWEEN 100 AND 199 THEN &quot;c. 100-199&quot;
    WHEN number_of_employees BETWEEN 200 AND 499 THEN &quot;d. 200-499&quot;
    WHEN number_of_employees BETWEEN 500 AND 999 THEN &quot;e. 500-999&quot;
    WHEN number_of_employees &gt;&gt;= 1000 THEN &quot;f. &gt;&gt;=1,000&quot;
    ELSE &quot;g. Null&quot;
  END AS lead_employees_band,
  -- CASE
  --   WHEN is_pantry_order IS TRUE THEN &quot;Pantry&quot;
  --   WHEN is_pandamart_corporate_order IS TRUE THEN &quot;Pandamart_Corporate&quot;
  --   WHEN is_corporate IS TRUE AND is_pantry_order IS FALSE AND is_pandamart_corporate_order IS FALSE THEN &quot;Corporate Only&quot;
  --   ELSE NULL
  -- END AS gmv_type,
  CASE
    WHEN is_voucher_shop THEN &quot;Voucher Shop&quot;
    WHEN NOT is_voucher_shop AND is_allowance_order THEN &quot;Allowance&quot;
    WHEN NOT is_voucher_shop AND NOT is_allowance_order THEN &quot;Non-Allowance&quot;
  END AS corp_order_type,
  COUNT(DISTINCT po.customer_code) AS customers,
  COUNT(DISTINCT a.gross_orders) AS total_number_of_orders,
  COUNT(DISTINCT a.valid_order) AS total_number_of_successful_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND is_corporate, po.order_code, NULL)) AS total_corporate_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND is_corporate AND vendor_grade = &quot;AAA&quot;, po.order_code, NULL)) AS total_corporate_aaa_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND po.is_preorder AND is_corporate, po.order_code, NULL)) AS total_corporate_preorder_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND po.is_preorder AND is_corporate AND preorder_days = 0, po.order_code, NULL)) AS total_corporate_preorder_same_day_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND is_corporate AND is_pandapro_subscriber, po.order_code, NULL)) AS total_corporate_pp_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND is_corporate AND is_allowance_order, po.order_code, NULL)) AS total_allowance_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND is_corporate AND is_group_order, po.order_code, NULL)) AS total_group_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND is_corporate AND is_voucher_shop, po.order_code, NULL)) AS total_voucher_shop_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND is_corporate AND is_dmart_order, po.order_code, NULL)) AS total_dmart_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND is_corporate AND is_shops_order, po.order_code, NULL)) AS total_shop_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND is_corporate AND is_dmart_order is TRUE AND v.vendor_code IN (&quot;zc9a&quot;, &quot;c6de&quot;, &quot;rt5g&quot;), po.order_code, NULL)) AS total_pantry_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND is_corporate AND v.vendor_code = &quot;b03g&quot;, po.order_code, NULL)) AS total_pandamart_corporate_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND is_corporate AND is_catering, po.order_code, NULL)) AS total_catering_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND is_catering, po.order_code, NULL)) AS total_catering_all_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND is_corporate AND NOT is_allowance_order AND NOT is_group_order AND NOT is_voucher_shop
  AND NOT is_dmart_order AND NOT is_shops_order AND NOT is_pantry_order AND NOT is_catering, po.order_code, NULL)) AS total_other_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND is_corporate AND NOT is_voucher_shop AND NOT is_dmart_order AND NOT is_shops_order AND NOT is_catering, po.order_code, NULL)) AS total_regular_orders,
  COUNT(DISTINCT IF(po.is_valid_order AND v.vendor_code=&quot;lnwf&quot;, po.order_code, NULL)) AS total_gift_card_orders,
  SUM(a.total_gmv_eur) AS total_gmv_eur,
  SUM(a.total_gmv_local) AS total_gmv_local,
  SUM(IF(po.is_valid_order AND is_corporate, po.gmv_eur, 0)) AS total_corporate_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate, po.gmv_local, 0)) AS total_corporate_gmv_local,
  SUM(IF(po.is_valid_order AND v.vendor_code=&quot;lnwf&quot;, po.gmv_local, 0)) AS total_gift_card_gmv_local,
  SUM(IF(po.is_valid_order AND v.vendor_code=&quot;lnwf&quot;, po.gmv_eur, 0)) AS total_gift_card_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND vendor_grade = &quot;AAA&quot;, po.gmv_eur, 0)) AS total_corporate_aaa_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND vendor_grade = &quot;AAA&quot;, po.gmv_local, 0)) AS total_corporate_aaa_gmv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_incentive, po.gmv_eur, 0)) AS total_corporate_incentive_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_incentive, po.gmv_local, 0)) AS total_corporate_incentive_gmv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_pandapro_subscriber, po.gmv_eur, 0)) AS total_corporate_pp_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_pandapro_subscriber, po.gmv_local, 0)) AS total_corporate_pp_gmv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_allowance_order, po.gmv_eur, 0)) AS total_allowance_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_allowance_order, po.gmv_local, 0)) AS total_allowance_gmv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_group_order, po.gmv_eur, 0)) AS total_group_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_group_order, po.gmv_local, 0)) AS total_group_gmv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_voucher_shop, po.gmv_eur, NULL)) AS total_voucher_shop_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_voucher_shop, po.gmv_local, NULL)) AS total_voucher_shop_gmv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_dmart_order, po.gmv_eur, NULL)) AS total_dmart_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_dmart_order, po.gmv_local, NULL)) AS total_dmart_gmv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_shops_order, po.gmv_eur, NULL)) AS total_shop_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_shops_order, po.gmv_local, NULL)) AS total_shop_gmv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_dmart_order is TRUE AND v.vendor_code IN (&quot;zc9a&quot;, &quot;c6de&quot;, &quot;rt5g&quot;), po.gmv_eur, NULL)) AS total_pantry_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_dmart_order is TRUE AND v.vendor_code IN (&quot;zc9a&quot;, &quot;c6de&quot;, &quot;rt5g&quot;), po.gmv_local, NULL)) AS total_pantry_gmv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND v.vendor_code = &quot;b03g&quot;, po.gmv_eur, NULL)) AS total_pandamart_corporate_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND v.vendor_code = &quot;b03g&quot;, po.gmv_local, NULL)) AS total_pandamart_corporate_gmv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_catering, po.gmv_eur, NULL)) AS total_catering_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_catering, po.gmv_local, NULL)) AS total_catering_gmv_local,
  SUM(IF(po.is_valid_order AND is_catering, po.gmv_eur, NULL)) AS total_catering_all_gmv_eur,
  SUM(IF(po.is_valid_order AND is_catering, po.gmv_local, NULL)) AS total_catering_all_gmv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND NOT is_allowance_order AND NOT is_group_order AND NOT is_voucher_shop
      AND NOT is_dmart_order AND NOT is_shops_order AND NOT is_pantry_order AND NOT is_catering, po.gmv_eur, NULL)) AS total_other_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND NOT is_allowance_order AND NOT is_group_order AND NOT is_voucher_shop
      AND NOT is_dmart_order AND NOT is_shops_order AND NOT is_pantry_order AND NOT is_catering, po.gmv_local, NULL)) AS total_other_gmv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND NOT is_voucher_shop AND NOT is_dmart_order AND NOT is_shops_order AND NOT is_catering, po.gmv_eur, NULL)) AS total_regular_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND NOT is_voucher_shop AND NOT is_dmart_order AND NOT is_shops_order AND NOT is_catering, po.gmv_local, NULL)) AS total_regular_gmv_local,
  SUM(a.total_gfv_eur) AS total_gfv_eur,
  SUM(a.total_gfv_local) AS total_gfv_local,
  SUM(IF(po.is_valid_order AND is_corporate, po.gfv_eur, 0)) AS total_corporate_gfv_eur,
  SUM(IF(po.is_valid_order AND is_corporate, po.gfv_local, 0)) AS total_corporate_gfv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_pandapro_subscriber, po.gfv_eur, NULL)) AS total_pp_gfv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_pandapro_subscriber, po.gfv_local, NULL)) AS total_pp_gfv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_voucher_shop, po.gfv_eur, NULL)) AS total_voucher_shop_gfv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_voucher_shop, po.gfv_local, NULL)) AS total_voucher_shop_gfv_local,
    SUM(IF(po.is_valid_order AND v.vendor_code=&quot;lnwf&quot;, po.gfv_local, 0)) AS total_gift_card_gfv_local,
  SUM(IF(po.is_valid_order AND v.vendor_code=&quot;lnwf&quot;, po.gfv_eur, 0)) AS total_gift_card_gfv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_dmart_order, po.gfv_eur, NULL)) AS total_dmart_gfv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_dmart_order, po.gfv_local, NULL)) AS total_dmart_gfv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_shops_order, po.gfv_eur, NULL)) AS total_shop_gfv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_shops_order, po.gfv_local, NULL)) AS total_shop_gfv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_dmart_order is TRUE AND v.vendor_code IN (&quot;zc9a&quot;, &quot;c6de&quot;, &quot;rt5g&quot;), po.gfv_eur, NULL)) AS total_pantry_gfv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_dmart_order is TRUE AND v.vendor_code IN (&quot;zc9a&quot;, &quot;c6de&quot;, &quot;rt5g&quot;), po.gfv_local, NULL)) AS total_pantry_gfv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND v.vendor_code = &quot;b03g&quot;, po.gfv_eur, NULL)) AS total_pandamart_corporate_gfv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND v.vendor_code = &quot;b03g&quot;, po.gfv_local, NULL)) AS total_pandamart_corporate_gfv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_catering, po.gfv_eur, NULL)) AS total_catering_gfv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_catering, po.gfv_local, NULL)) AS total_catering_gfv_local,
  SUM(IF(po.is_valid_order AND is_corporate AND NOT is_voucher_shop AND NOT is_dmart_order AND NOT is_shops_order AND NOT is_catering, po.gfv_eur, NULL)) AS total_regular_gfv_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND NOT is_voucher_shop AND NOT is_dmart_order AND NOT is_shops_order AND NOT is_catering, po.gfv_local, NULL)) AS total_regular_gfv_local,
  SUM(IF(po.is_valid_order AND is_corporate, po.voucher_value_eur * fp_voucher_ratio / 100, 0)) + SUM(IF(po.is_valid_order AND is_corporate, discount_value_eur * fp_discount_ratio / 100, 0)) AS total_dh_subsidy_eur,
  SUM(IF(po.is_valid_order AND is_corporate, po.voucher_value_local * fp_voucher_ratio / 100, 0)) + SUM(IF(po.is_valid_order AND is_corporate, discount_value_local * fp_discount_ratio / 100, 0)) AS total_dh_subsidy_local,
  SUM(IF(po.is_valid_order AND is_corporate, po.voucher_value_eur * (100 - fp_voucher_ratio) / 100, 0))
  + SUM(IF(po.is_valid_order AND is_corporate, discount_value_eur * (100 - fp_discount_ratio) / 100, 0)) AS total_vendor_subsidy_eur,
    SUM(IF(po.is_valid_order AND is_corporate, po.voucher_value_local * (100 - fp_voucher_ratio) / 100, 0))
  + SUM(IF(po.is_valid_order AND is_corporate, discount_value_local * (100 - fp_discount_ratio) / 100, 0)) AS total_vendor_subsidy_local,
  SUM(IF(po.is_valid_order AND is_corporate, commission_revenue_eur, 0)) AS commission_revenue_eur,
  SUM(IF(po.is_valid_order AND is_corporate, commission_revenue_local, 0)) AS commission_revenue_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_dmart_order, commission_revenue_eur, 0)) AS commission_revenue_dmart_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_dmart_order, commission_revenue_local, 0)) AS commission_revenue_dmart_local,
  SUM(IF(po.is_valid_order AND is_corporate AND is_shops_order, commission_revenue_eur, 0)) AS commission_revenue_shops_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND is_shops_order, commission_revenue_local, 0)) AS commission_revenue_shops_local,
  SUM(IF(po.is_valid_order AND is_corporate AND vertical=&quot;restaurants&quot;, commission_revenue_eur, 0)) AS commission_revenue_resto_eur,
  SUM(IF(po.is_valid_order AND is_corporate AND vertical=&quot;restaurants&quot;, commission_revenue_local, 0)) AS commission_revenue_resto_local,
  SUM(IF(po.is_valid_order AND is_corporate, po.delivery_fee_eur, 0)) AS delivery_fee_eur,
  SUM(IF(po.is_valid_order AND is_corporate, po.delivery_fee_local, 0)) AS delivery_fee_local,
  SUM(IF(po.is_valid_order AND is_corporate, billable_gmv_eur, 0)) AS billable_gmv_eur,
  SUM(IF(po.is_valid_order AND is_corporate, billable_gmv_local, 0)) AS billable_gmv_local,
  COUNT(DISTINCT IF(is_corporate AND partial_wallet_refund, po.order_code, NULL)) AS total_corporate_partial_refund_wallet_orders,
  SUM(IF(is_corporate AND partial_wallet_refund, po.gmv_eur, 0)) AS total_corporate_partial_wallet_refunds_gmv_eur,
  SUM(IF(is_corporate AND partial_wallet_refund, po.gmv_local, 0)) AS total_corporate_partial_wallet_refunds_gmv_local
FROM 
all_orders a
LEFT JOIN
`fulfillment-dwh-production.pandata_report.regional_apac_cp_order_level` po
ON a.gross_orders=po.order_code
left join `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` v
ON LEFT(po.order_code,4)=v.vendor_code
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_cp_sf_companies` AS sf_company_data
    ON po.global_entity_id = sf_company_data.global_entity_id
    AND CAST(po.company_id AS STRING) = CAST(sf_company_data.corp_backend_id AS STRING)
LEFT JOIN `fulfillment-dwh-production.pandata_curated.cus_customers` AS cus_customers
    ON po.global_entity_id = cus_customers.global_entity_id
    AND po.customer_code = cus_customers.code
WHERE a.date_local &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 6 MONTH), MONTH)
and a.global_entity_id=&quot;FP_PK&quot;
GROUP BY
  global_entity_id,
  date_local,
  date_type,
  country_name,
  company_id,
  company_name,
  company_type,
  source,
  is_valid_order,
  is_corporate,
  is_pantry_order,
  is_pandamart_corporate_order,
  is_pandapro_subscriber,
  plan_code,
  is_first_valid_company_order,
  is_first_valid_order,
  is_gc_order,
  is_new_gmv_order,
  corp_order_category,
  account_owner_name,
  opportunity_owner_name,
  opportunity_owner_join_date,
  close_won_date,
  corporate_solution,
  industry,
  lead_source,
  lead_employees_band,
  --gmv_type,
  corp_order_type
)
select
  
  date_local,
  global_entity_id,
  country_name,
  company_id,
  company_name,
  company_type,
  source,
  is_valid_order,
  is_corporate,
  is_pantry_order,
  is_pandamart_corporate_order,
  is_pandapro_subscriber,
  plan_code,
  is_first_valid_company_order,
  is_first_valid_order,
  is_new_gmv_order,
  is_gc_order,
  corp_order_category,
  account_owner_name,
  opportunity_owner_name,
  opportunity_owner_join_date,
  close_won_date,
  corporate_solution,
  industry,
  lead_source,
  lead_employees_band,
    CASE
    WHEN is_pantry_order IS TRUE THEN &quot;Pantry&quot;
    WHEN is_pandamart_corporate_order IS TRUE THEN &quot;Pandamart_Corporate&quot;
    WHEN is_corporate IS TRUE AND is_pantry_order IS FALSE AND is_pandamart_corporate_order IS FALSE THEN &quot;Corporate Only&quot;
    ELSE NULL
  END AS gmv_type,
  corp_order_type,
  customers,
  total_number_of_orders,
  total_number_of_successful_orders,
  total_corporate_orders,
