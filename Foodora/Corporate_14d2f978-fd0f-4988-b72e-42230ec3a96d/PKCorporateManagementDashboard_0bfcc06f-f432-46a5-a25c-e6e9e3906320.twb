    <worksheet name='Corporate Order Metrics (3)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (samples)' name='federated.1hoc0mf15z9sv914iehwj0vsn0hz' />
          </datasources>
          <datasource-dependencies datasource='federated.1hoc0mf15z9sv914iehwj0vsn0hz'>
            <column caption='PP AFV' datatype='real' name='[Calculation_1049831305379614722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_pp_gfv_eur])/SUM([total_corporate_pp_orders])' />
            </column>
            <column caption='Companies With Pandapro Orders' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1049831305489854468]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF([is_valid_order]=TRUE AND [is_corporate]= TRUE AND [is_pandapro_subscriber] = TRUE) then [company_id] else null end' />
            </column>
            <column caption='Corporate Orders ∆ (%)' datatype='real' name='[Calculation_1049831305491738629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_corporate_orders]) - LOOKUP(ZN(SUM([total_corporate_orders])), -1))/LOOKUP(ZN(SUM([total_corporate_orders])), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Allowance Orders (%)' datatype='real' name='[Calculation_1049831305496399878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_allowance_orders])/SUM([total_corporate_orders])' />
            </column>
            <column caption='Group Orders (%)' datatype='real' name='[Calculation_1049831305497161735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_group_orders])/SUM([total_corporate_orders])' />
            </column>
            <column caption='Preorders (%)' datatype='real' name='[Calculation_1049831305660432396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_corporate_preorder_orders])/SUM([total_corporate_orders])' />
            </column>
            <column caption='Preorders Same Day (%)' datatype='real' name='[Calculation_1049831305660776461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_corporate_preorder_same_day_orders])/SUM([total_corporate_orders])' />
            </column>
            <column caption='Total Shops Orders (Excluding PK Pantry)' datatype='integer' name='[Calculation_1049831305662431246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_shop_orders]-ZN([total_voucher_shop_orders])-ZN([total_pantry_orders])' />
            </column>
            <column caption='Total Corporate GMV ∆ (%)' datatype='real' name='[Calculation_1049831305664921615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_corporate_gmv_eur]) - LOOKUP(ZN(SUM([total_corporate_gmv_eur])), -1))/LOOKUP(ZN(SUM([total_corporate_gmv_eur])), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% AAA GMV' datatype='real' name='[Calculation_1049831305666383888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_corporate_aaa_gmv_eur])/SUM([total_corporate_gmv_eur])' />
            </column>
            <column caption='Shops GMV (Excluding PK Pantry)' datatype='real' name='[Calculation_1049831305667518481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_shop_gmv_eur]-ZN([total_voucher_shop_gmv_eur])-ZN([total_pantry_gmv_eur])' />
            </column>
            <column caption='Active Companies' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1049831305671585810]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF([is_valid_order]=TRUE and [is_corporate]=TRUE) then [company_id] else null end' />
            </column>
            <column caption='New Companies' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1049831305672388627]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF([is_corporate]=TRUE and [is_valid_order]=TRUE and [is_first_valid_company_order]=TRUE) then[company_id] else null end' />
            </column>
            <column caption='Existing Companies' datatype='integer' name='[Calculation_1049831305672794132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_1049831305671585810])-COUNTD([Calculation_1049831305672388627])' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_1049831305674145813]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_corporate_gfv_eur])/SUM([total_corporate_orders])' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_1049831305674817558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_corporate_gmv_eur])/SUM([total_corporate_orders])' />
            </column>
            <column caption='New/Existing GMV' datatype='string' name='[Calculation_1049831305687584793]' role='dimension' type='nominal'>
