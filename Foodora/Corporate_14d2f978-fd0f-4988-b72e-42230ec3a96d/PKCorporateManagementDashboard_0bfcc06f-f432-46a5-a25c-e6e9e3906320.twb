      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1hoc0mf15z9sv914iehwj0vsn0hz].[ctd:Calculation_1049831305489854468:qk]&quot;' value='Companies With Pandapro Orders' />
          <alias key='&quot;[federated.1hoc0mf15z9sv914iehwj0vsn0hz].[ctd:Calculation_1049831305671585810:qk]&quot;' value='Active Companies' />
          <alias key='&quot;[federated.1hoc0mf15z9sv914iehwj0vsn0hz].[ctd:Calculation_1049831305672388627:qk]&quot;' value='New Companies' />
          <alias key='&quot;[federated.1hoc0mf15z9sv914iehwj0vsn0hz].[ctd:Calculation_2215137718897078272:qk]&quot;' value='Pantry Customers' />
          <alias key='&quot;[federated.1hoc0mf15z9sv914iehwj0vsn0hz].[ctd:Calculation_2215137718898438145:qk]&quot;' value='Pandamart Corporate Customers' />
          <alias key='&quot;[federated.1hoc0mf15z9sv914iehwj0vsn0hz].[ctd:Calculation_2215137718899380226:qk]&quot;' value='Total Active Customers' />
          <alias key='&quot;[federated.1hoc0mf15z9sv914iehwj0vsn0hz].[sum:Calculation_1049831305662431246:qk]&quot;' value='Total Shop Orders (Excluding PK Pantry)' />
        </aliases>
      </column>
      <column caption='Corporate Orders (%)' datatype='real' name='[Calculation_1049831305366298624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_corporate_orders])/SUM([total_number_of_successful_orders])' />
      </column>
      <column caption='Corporate GMV (%)' datatype='real' name='[Calculation_1049831305366888449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_corporate_gmv_eur])/SUM([total_gmv_eur])' />
      </column>
      <column caption='PP AFV' datatype='real' name='[Calculation_1049831305379614722]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_pp_gfv_eur])/SUM([total_corporate_pp_orders])' />
      </column>
      <column caption='PP AOV' datatype='real' name='[Calculation_1049831305380286467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_corporate_pp_gmv_eur])/SUM([total_corporate_pp_orders])' />
      </column>
      <column caption='Companies With Pandapro Orders' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1049831305489854468]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF([is_valid_order]=TRUE AND [is_corporate]= TRUE AND [is_pandapro_subscriber] = TRUE) then [company_id] else null end' />
      </column>
      <column caption='Corporate Orders ∆ (%)' datatype='real' name='[Calculation_1049831305491738629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_corporate_orders]) - LOOKUP(ZN(SUM([total_corporate_orders])), -1))/LOOKUP(ZN(SUM([total_corporate_orders])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Allowance Orders (%)' datatype='real' name='[Calculation_1049831305496399878]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_allowance_orders])/SUM([total_corporate_orders])' />
      </column>
      <column caption='Group Orders (%)' datatype='real' name='[Calculation_1049831305497161735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_group_orders])/SUM([total_corporate_orders])' />
      </column>
      <column caption='Total Corporate Orders (Exc Pantry &amp; Dmart_Corp)' datatype='integer' name='[Calculation_1049831305500352522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_corporate_orders])-SUM([total_pantry_orders])-SUM([total_pandamart_corporate_orders])' />
      </column>
      <column caption='Preorders (%)' datatype='real' name='[Calculation_1049831305660432396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_corporate_preorder_orders])/SUM([total_corporate_orders])' />
      </column>
      <column caption='Preorders Same Day (%)' datatype='real' name='[Calculation_1049831305660776461]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_corporate_preorder_same_day_orders])/SUM([total_corporate_orders])' />
      </column>
      <column caption='Total Shops Orders (Excluding PK Pantry)' datatype='integer' name='[Calculation_1049831305662431246]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_shop_orders]-ZN([total_voucher_shop_orders])-ZN([total_pantry_orders])' />
      </column>
      <column caption='Total Corporate GMV ∆ (%)' datatype='real' name='[Calculation_1049831305664921615]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_corporate_gmv_eur]) - LOOKUP(ZN(SUM([total_corporate_gmv_eur])), -1))/LOOKUP(ZN(SUM([total_corporate_gmv_eur])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% AAA GMV' datatype='real' name='[Calculation_1049831305666383888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_corporate_aaa_gmv_eur])/SUM([total_corporate_gmv_eur])' />
      </column>
      <column caption='Shops GMV (Excluding PK Pantry)' datatype='real' name='[Calculation_1049831305667518481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_shop_gmv_eur]-ZN([total_voucher_shop_gmv_eur])-ZN([total_pantry_gmv_eur])' />
      </column>
      <column caption='Active Companies' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1049831305671585810]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF([is_valid_order]=TRUE and [is_corporate]=TRUE) then [company_id] else null end' />
      </column>
      <column caption='New Companies' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1049831305672388627]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF([is_corporate]=TRUE and [is_valid_order]=TRUE and [is_first_valid_company_order]=TRUE) then[company_id] else null end' />
      </column>
      <column caption='Existing Companies' datatype='integer' name='[Calculation_1049831305672794132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1049831305671585810])-COUNTD([Calculation_1049831305672388627])' />
      </column>
      <column caption='AFV' datatype='real' name='[Calculation_1049831305674145813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_corporate_gfv_eur])/SUM([total_corporate_orders])' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_1049831305674817558]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_corporate_gmv_eur])/SUM([total_corporate_orders])' />
      </column>
      <column caption='Calculation1' datatype='boolean' name='[Calculation_1049831305683501080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Yearly&apos; THEN [date_local] &gt;= DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,TODAY())) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Quarterly&apos; THEN [date_local] &gt;= DATEADD(&apos;quarter&apos;,-7,DATETRUNC(&apos;quarter&apos;,TODAY())) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN [date_local] &gt;= DATEADD(&apos;month&apos;,-12,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN [date_local] &gt;= DATEADD(&apos;week&apos;,-11,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [date_local] &gt;= DATEADD(&apos;day&apos;,-12,TODAY()) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly + MTD&apos; THEN [date_local] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_local] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly + WTD&apos; THEN [date_local] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [date_local] &lt; TODAY()&#10;END&#10;&#10;//if [Dynamic Date Selector] = &apos;Month&apos; THEN [date_local] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;//ELSEIF [Dynamic Date Selector] = &apos;Week&apos; THEN [date_local] &gt;= DATEADD(&apos;week&apos;,-7,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;//ELSEIF [Dynamic Date Selector] = &apos;Day&apos; THEN [date_local] &gt;= DATEADD(&apos;day&apos;,-7,TODAY()) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;//ELSEIF [Dynamic Date Selector] = &apos;Month + MTD&apos; THEN [date_local] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_local] &lt; TODAY()&#10;//ELSEIF [Dynamic Date Selector] = &apos;Week + WTD&apos; THEN [date_local] &gt;= DATEADD(&apos;iso-week&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [date_local] &lt; TODAY()&#10;//END' />
      </column>
      <column caption='New/Existing GMV' datatype='string' name='[Calculation_1049831305687584793]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF([is_new_gmv_order]=TRUE) THEN &apos;New GMV&apos; ELSE &apos;Existing GMV&apos; END' />
      </column>
      <column caption='pantry_customer' datatype='integer' name='[Calculation_2215137718897078272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_pantry_order] = TRUE THEN [customers] else null end' />
      </column>
      <column caption='pandamart_corp_customer' datatype='integer' name='[Calculation_2215137718898438145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_pandamart_corporate_order] = TRUE THEN [customers] else null end' />
      </column>
      <column caption='Total Active Customers' datatype='integer' name='[Calculation_2215137718899380226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_corporate]=TRUE then [customers] else 0 end' />
      </column>
      <column caption='total_cx' datatype='integer' name='[Calculation_2215137719579348995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id])' />
      </column>
      <column caption='Corporate Only GMV' datatype='real' name='[Calculation_2215137719583907844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_corporate_gmv_eur])-ZN(SUM([total_pandamart_corporate_gmv_eur]))-ZN(SUM([total_pantry_gmv_eur]))' />
      </column>
      <column caption='Total Corporate Only GMV Local' datatype='real' name='[Calculation_2215137719584350213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_corporate_gmv_local])-ZN(SUM([total_pandamart_corporate_gmv_local]))-ZN(SUM([total_pantry_gmv_local]))' />
