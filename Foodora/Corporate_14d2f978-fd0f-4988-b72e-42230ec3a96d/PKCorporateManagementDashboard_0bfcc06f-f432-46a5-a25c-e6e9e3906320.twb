            <column caption='PP AFV' datatype='real' name='[Calculation_1049831305379614722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_pp_gfv_eur])/SUM([total_corporate_pp_orders])' />
            </column>
            <column caption='PP AOV' datatype='real' name='[Calculation_1049831305380286467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_corporate_pp_gmv_eur])/SUM([total_corporate_pp_orders])' />
