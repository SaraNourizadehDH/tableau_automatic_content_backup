      </column>
      <column caption='AB GTC acquired YOY' datatype='real' name='[GTC MoM (copy)_5829206083545804805]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [Month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [acquired_dy_dh (copy)_6537045257151102982] END) &#10;- SUM(IF [Month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [acquired_dy_dh (copy)_6537045257151102982] END)) &#10;/ &#10;SUM(IF [Month] = DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [acquired_dy_dh (copy)_6537045257151102982] END)' />
      </column>
