            <column caption='Month' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='fresh and ultra fresh penetration vs target' datatype='real' name='[dmart availability v2 vs target (copy)_3360459400050311200]' role='measure' type='quantitative'>
