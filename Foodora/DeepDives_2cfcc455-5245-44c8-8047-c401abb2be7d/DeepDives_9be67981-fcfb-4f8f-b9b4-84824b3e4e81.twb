              <zone forceUpdate='true' h='4174' id='3' type-v2='text' w='99000' x='500' y='229'>
                <formatted-text>
                  <run fontalignment='1' fontcolor='#c10b57' fontname='Tableau Bold' fontsize='18'>Javelin Deep Dives</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='15359' id='1171' type-v2='text' w='9433' x='500' y='60593'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='14'>VFD</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#b92dc2' />
