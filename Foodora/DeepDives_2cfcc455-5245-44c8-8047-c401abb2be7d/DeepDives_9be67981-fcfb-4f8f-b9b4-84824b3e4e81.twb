  , COUNT(DISTINCT IF(d0_on_deals AND NOT d0_on_ads, vendor_code, NULL)) AS d0_deals_only
  , COUNT(DISTINCT IF(NOT d0_on_deals AND d0_on_ads, vendor_code, NULL)) AS d0_ads_only
  , COUNT(DISTINCT IF(d0_on_deals AND d0_on_ads, vendor_code, NULL)) AS d0_deals_and_ads

