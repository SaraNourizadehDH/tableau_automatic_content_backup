    <worksheet name='VFD vs target'>
      <table>
        <view>
          <datasources>
            <datasource caption='pandora_targets (markets_analytics)' name='federated.0ecl3640sfw5hs15xzxod16fy5xe' />
            <datasource caption='sp_okr_automation_2025 (bl_europe) (2)' name='federated.1ci860l0i4bkxv1civen50kikdtw' />
          </datasources>
          <datasource-dependencies datasource='federated.0ecl3640sfw5hs15xzxod16fy5xe'>
            <column caption='vfd gmv vs target' datatype='real' name='[%ab &gt;75 orders vs target (copy)_3360459400008581142]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[federated.1ci860l0i4bkxv1civen50kikdtw].[Calculation_3984137611677024256]&#10;- AVG([target_vfd_gmv_food])&#10;)&#10;* 100' />
            </column>
            <column caption='previous month filter' datatype='boolean' name='[Calculation_3360459398635352065]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
