        <column caption='% Deal Utilization' datatype='real' default-format='p0.0%' name='[Calculation_6372734250328383528]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM([vf_deal_orders_numerator])&#10;/&#10;SUM([deal_orders_denominator])' />
