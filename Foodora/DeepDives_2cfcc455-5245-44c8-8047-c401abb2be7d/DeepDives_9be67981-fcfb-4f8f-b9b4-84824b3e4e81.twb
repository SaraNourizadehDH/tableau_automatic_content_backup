    <worksheet name='VFD MOM'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025 (bl_europe) (2)' name='federated.1ci860l0i4bkxv1civen50kikdtw' />
          </datasources>
          <datasource-dependencies datasource='federated.1ci860l0i4bkxv1civen50kikdtw'>
            <column caption='VFD Vendor % MoM' datatype='real' name='[AB Zombies % MoM (copy)_1654509965038370816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [vf_vendors] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [vendors] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [vf_vendors] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [vendors] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='VFD GMV AO MoM' datatype='real' name='[AB Zombies % MoM (copy)_1654509965049520135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [ao_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv_eur] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [ao_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gmv_eur] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='VFD GMV MOM' datatype='real' name='[Calculation_3984137611677843457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN total_incentive_cost_vendor_incl_manual_adjustment_eur END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv_eur] END)&#10;    )&#10;    - &#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN total_incentive_cost_vendor_incl_manual_adjustment_eur END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gmv_eur] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_5829206083550920720]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU_TR&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;EU&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pandora&quot; THEN &quot;Pandora&quot;&#10;END' />
            </column>
            <column caption='% Deal Utilization' datatype='real' default-format='p0.0%' name='[Calculation_6372734250328383528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vf_deal_orders_numerator])&#10;/&#10;SUM([deal_orders_denominator])' />
            </column>
            <column caption='% Deal Utilization MoM' datatype='real' default-format='*0.0 pp' name='[Calculation_6372734250335338540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [vf_deal_orders_numerator] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [deal_orders_denominator] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [vf_deal_orders_numerator] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN deal_orders_denominator END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='VFD self booking ratio MoM' datatype='real' default-format='*0.0 pp' name='[Calculation_6372734250337427503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_vendors_with_vfd_sb_deals_self_booking] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_vendors_sb] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [total_vendors_with_vfd_sb_deals_self_booking] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [total_vendors_sb] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='Pro VFD/Pro GMV MoM' datatype='real' name='[VFD GMV AO MoM (copy)_391039175018909699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [pro_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [pro_gmv_eur] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [pro_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [pro_gmv_eur] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='VFD GMV Disco MoM' datatype='real' name='[VFD GMV Pro MoM (copy)_391039175019520007]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [disco_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv_eur] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [disco_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gmv_eur] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='disco cofunding ratio MoM' datatype='real' name='[VFD Vendor % MoM (copy)_5216294321414668288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [disco_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [disco_eur] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [disco_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [disco_eur] END)) &#10;)&#10;&#10;&#10;) * 100' />
