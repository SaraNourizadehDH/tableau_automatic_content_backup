        <column caption='%AB w/both Ads &amp; Deals live on D0' datatype='real' default-format='p0.0%' name='[Calculation_6372734250139222043]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM([d0_ab_deals_and_ads_pcnt])' />
