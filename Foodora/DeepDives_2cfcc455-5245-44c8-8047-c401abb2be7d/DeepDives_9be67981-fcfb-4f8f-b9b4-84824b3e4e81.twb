    <worksheet name='[New] VFD YOY'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025 (bl_europe) (2)' name='federated.1ci860l0i4bkxv1civen50kikdtw' />
          </datasources>
          <datasource-dependencies datasource='federated.1ci860l0i4bkxv1civen50kikdtw'>
            <column caption='Segment' datatype='string' name='[Calculation_5829206083550920720]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU_TR&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;EU&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pandora&quot; THEN &quot;Pandora&quot;&#10;END' />
            </column>
            <column caption='% Deal Utilization YoY' datatype='real' default-format='*0.0 pp' name='[Calculation_6372734250335440941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [vf_deal_orders_numerator] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [deal_orders_denominator] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [vf_deal_orders_numerator] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [deal_orders_denominator] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='VFD self booking ratio YoY' datatype='real' default-format='*0.0 pp' name='[Calculation_6372734250337513520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_vendors_with_vfd_sb_deals_self_booking] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_vendors_sb] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [total_vendors_with_vfd_sb_deals_self_booking] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [total_vendors_sb] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='VFD GMV AO YOY' datatype='real' name='[VFD GMV AO MoM (copy)_1654509965049733128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [ao_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv_eur] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [ao_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv_eur] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='VFD GMV Disco YOY' datatype='real' name='[VFD GMV Disco MoM (copy)_391039175019642888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [disco_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv_eur] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [disco_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv_eur] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='VFD GMV YOY' datatype='real' name='[VFD GMV MOM (copy)_3984137611678072834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN total_incentive_cost_vendor_incl_manual_adjustment_eur END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv_eur] END)&#10;    )&#10;    - &#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN total_incentive_cost_vendor_incl_manual_adjustment_eur END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv_eur] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='Pro VFD/Pro GMV YOY' datatype='real' name='[VFD GMV Pro MoM (copy)_391039175019048964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [pro_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [pro_gmv_eur] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [pro_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [pro_gmv_eur] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='VFD Vendor % YOY' datatype='real' name='[VFD Vendor % MoM (copy)_391039175019331590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [vf_vendors] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [vendors] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [vf_vendors] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [vendors] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='Ao Vendor Eur' datatype='real' name='[ao_vendor_eur]' role='measure' type='quantitative' />
            <column caption='disco cofunding ratio YOY' datatype='real' name='[cofunding ratio MoM (copy)_391039175020003337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [disco_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [disco_eur] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [disco_vendor_eur] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [disco_eur] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;EU&quot;' value='EU (Excl. TR)' />
                <alias key='&quot;EU_TR&quot;' value='EU (Incl. TR)' />
              </aliases>
            </column>
            <column caption='Deal Orders' datatype='integer' name='[deal_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[deal_orders_denominator]' role='measure' type='quantitative' />
            <column caption='Disco Eur' datatype='real' name='[disco_eur]' role='measure' type='quantitative' />
            <column caption='Disco Vendor Eur' datatype='real' name='[disco_vendor_eur]' role='measure' type='quantitative' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5829206083550920720]' derivation='None' name='[none:Calculation_5829206083550920720:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column caption='order penetration YoY' datatype='real' name='[order penetration MoM (copy)_391039175020245003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [deal_orders] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [orders_op] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [deal_orders] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [orders_op] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
