      </extract>
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' _.fcp.SchemaViewerObjectModel.true...common-percentage='0.761905' _.fcp.SchemaViewerObjectModel.true...user-set-layout-v2='true' dim-ordering='alphabetic' measure-ordering='alphabetic' parameter-percentage='0.238095' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <date-options start-of-week='monday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_1D4EDE6E473C4690AAE5572B5FB6BE3F'>
            <properties context=''>
              <relation connection='bigquery.1wbmy9d1ah8lda151zhd204xbe6m' name='Custom SQL Query' type='text'><![CDATA[WITH vendor_base AS (
  SELECT
    i.activation_date AS d0,
    DATE_ADD(i.activation_date, INTERVAL 7 DAY) AS d7,
    i.incubated_date_30_days AS d30,
    i.incubated_date_60_days AS d60,
    i.country,
    c.global_entity_id,
    i.vendor_code,
    CASE
      WHEN i.vendor_grade IN ("A", "B", "AA", "AAA") THEN "AB"
      WHEN i.vendor_grade IN ("C", "D") THEN "CD"
      ELSE "Ungraded"
    END AS vendor_grade
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_lead_account_opp_incubation_cut` AS i
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS c
         ON i.country = c.name
  WHERE i.opportunity_business_type IN ("New Business", "Win Back")
    AND COALESCE(i.key_account_sub_category, "") NOT IN ("Global KA", "National KA")
    AND i.vendor_type IN ("Restaurants")
    -- AND i.has_completed_60d_incubation
    AND NOT i.is_terminated_within_60_days
    -- AND i.activation_date >>= "2024-10-01"
    AND i.activation_date >>= "2024-01-01"
),

deals AS (
  -- at deal level

  -- discounts
  SELECT  
    d.uuid,
    d.global_entity_id,
    e.vendor_code,
    d.start_date_utc AS start_date,
    d.end_date_utc AS end_date
  FROM `fulfillment-dwh-production.pandata_curated.offers_discounts` AS d
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discount_vendor_entries` AS e
         ON d.uuid = e.offers_discount_uuid
  WHERE   d.created_date_utc >>= "2024-01-01"
  -- d.created_date_utc >>= "2024-10-01"
    AND NOT d.is_deleted
    AND d.foodpanda_ratio <<>> 100

  UNION ALL 

  -- vouchers
  SELECT
    v.uuid,
    v.global_entity_id,
    e.vendor_code,
    v.start_date_local AS start_date,
    v.stop_date_local AS end_date
  FROM `fulfillment-dwh-production.pandata_curated.offers_vouchers` AS v
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_voucher_vendor_entries` AS e
         ON v.uuid = e.offers_voucher_uuid
  WHERE v.created_date_utc >>= "2024-01-01"
  -- v.created_date_utc >>= "2024-10-01"
    AND NOT v.is_deleted
    AND v.foodpanda_ratio <<>> 100
),

ads AS (
-- CPC
SELECT
 global_entity_id,
 vendor_code,
 campaign_date_local AS ad_date
FROM `fulfillment-dwh-production.pandata_datamart.pandora__cpc_campaigns_daily`
WHERE campaign_date_local >>= "2024-01-01"
-- campaign_date_local >>= "2024-10-01"
 AND status = "active"
 AND business_type = "restaurants"

UNION ALL

-- Display ads
SELECT
 da.global_entity_id,
 CASE
   WHEN advertiser_type = "chain" THEN v.vendor_code
   WHEN advertiser_type = "restaurants" THEN da.advertiser_vendor_code
   ELSE da.advertiser_vendor_code
 END AS vendor_code,
 campaign_date_local AS ad_date
FROM `fulfillment-dwh-production.pandata_datamart.pandora__display_ads_campaigns_daily` AS da
LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__agg_vendors` AS v
     ON da.global_entity_id = v.global_entity_id
    AND da.advertiser_chain_code = v.chain_code
    AND advertiser_type = "chain"
WHERE campaign_date_local >>= "2024-01-01"
-- campaign_date_local >>= "2024-10-01"
 AND status = "active"
 AND advertiser_type IN ("restaurants", "chain")

UNION ALL

-- Joker
SELECT
 global_entity_id,
 vendor_code,
 campaign_date_utc AS ad_date
FROM `fulfillment-dwh-production.pandata_datamart.pandora__joker_campaigns_daily`
WHERE campaign_date_utc >>= "2024-01-01"
-- campaign_date_utc >>= "2024-10-01"
 AND status = "active"
),

adoption AS (
  -- vendor level F0D, F30D and F60D adoption of deals and ads
  SELECT
    v.d0,
    v.d7,
    v.d30,
    v.d60,
    v.global_entity_id,
    v.vendor_grade,
    v.vendor_code,
    -- aggregation to avoid duplication from multiple deals/ads
    MAX(v.d0 BETWEEN d.start_date AND d.end_date) AS d0_on_deals,
    MAX(v.d7 BETWEEN d.start_date AND d.end_date) AS d7_on_deals,
    MAX(v.d30 BETWEEN d.start_date AND d.end_date) AS d30_on_deals,
    MAX(v.d60 BETWEEN d.start_date AND d.end_date) AS d60_on_deals,
    MAX(v.d0 = a.ad_date) AS d0_on_ads,
    MAX(v.d7 = a.ad_date) AS d7_on_ads,
    MAX(v.d30 = a.ad_date) AS d30_on_ads,
    MAX(v.d60 = a.ad_date) AS d60_on_ads
  FROM vendor_base AS v
  LEFT JOIN deals AS d
        ON d.global_entity_id = v.global_entity_id 
        AND d.vendor_code = v.vendor_code
  LEFT JOIN ads AS a 
         ON a.global_entity_id = v.global_entity_id 
        AND a.vendor_code = v.vendor_code
  GROUP BY ALL
)




SELECT
  DATE_TRUNC(d30, MONTH) AS report_month,
  -- "Day 30" AS day,
  global_entity_id,
  -- vendor_grade,
  COUNT(DISTINCT vendor_code) AS vendor_count,
  -- D30 breakdowns
  COUNT(DISTINCT IF(d30_on_deals AND NOT d30_on_ads, vendor_code, NULL)) AS d30_deals_only,

  COUNT(DISTINCT IF(NOT d30_on_deals AND d30_on_ads, vendor_code, NULL)) AS d30_ads_only,
  
  COUNT(DISTINCT IF(d30_on_deals AND d30_on_ads, vendor_code, NULL)) AS d30_deals_and_ads

  , SAFE_DIVIDE( COUNT(DISTINCT IF(d30_on_deals AND NOT d30_on_ads, vendor_code, NULL)) 
    , COUNT(DISTINCT vendor_code)) AS d30_deals_only_pcnt

  , SAFE_DIVIDE(COUNT(DISTINCT IF(NOT d30_on_deals AND d30_on_ads, vendor_code, NULL)) 
    , COUNT(DISTINCT vendor_code)) AS d30_ads_only_pcnt
  
  , SAFE_DIVIDE(COUNT(DISTINCT IF(d30_on_deals AND d30_on_ads, vendor_code, NULL))
    , COUNT(DISTINCT vendor_code)) AS d30_deals_and_ads_pcnt
  
  , COUNT(DISTINCT IF(d0_on_deals AND NOT d0_on_ads, vendor_code, NULL)) AS d0_deals_only
  , COUNT(DISTINCT IF(NOT d0_on_deals AND d0_on_ads, vendor_code, NULL)) AS d0_ads_only
  , COUNT(DISTINCT IF(d0_on_deals AND d0_on_ads, vendor_code, NULL)) AS d0_deals_and_ads

  , SAFE_DIVIDE(
    COUNT(DISTINCT IF(d0_on_deals AND NOT d0_on_ads, vendor_code, NULL))
    , COUNT(DISTINCT vendor_code)) AS d0_deals_only_pcnt

    , SAFE_DIVIDE(
   COUNT(DISTINCT IF(NOT d0_on_deals AND d0_on_ads, vendor_code, NULL))
    , COUNT(DISTINCT vendor_code)) AS d0_ads_only_pcnt

      , SAFE_DIVIDE(
   COUNT(DISTINCT IF(d0_on_deals AND d0_on_ads, vendor_code, NULL))
    , COUNT(DISTINCT vendor_code)) AS d0_deals_and_ads_pcnt


FROM adoption
-- WHERE d30 >>= "2024-11-01"
WHERE d30 <<= CURRENT_DATE

GROUP BY ALL

UNION ALL 

SELECT
  DATE_TRUNC(d30, MONTH) AS report_month,
  -- "Day 30" AS day,
  "EU" AS global_entity_id,
  -- vendor_grade,
  COUNT(DISTINCT vendor_code) AS vendor_count,
  -- D30 breakdowns
   COUNT(DISTINCT IF(d30_on_deals AND NOT d30_on_ads, vendor_code, NULL)) AS d30_deals_only,

  COUNT(DISTINCT IF(NOT d30_on_deals AND d30_on_ads, vendor_code, NULL)) AS d30_ads_only,
  
  COUNT(DISTINCT IF(d30_on_deals AND d30_on_ads, vendor_code, NULL)) AS d30_deals_and_ads

  , SAFE_DIVIDE( COUNT(DISTINCT IF(d30_on_deals AND NOT d30_on_ads, vendor_code, NULL)) 
    , COUNT(DISTINCT vendor_code)) AS d30_deals_only_pcnt

  , SAFE_DIVIDE(COUNT(DISTINCT IF(NOT d30_on_deals AND d30_on_ads, vendor_code, NULL)) 
    , COUNT(DISTINCT vendor_code)) AS d30_ads_only_pcnt
  
  , SAFE_DIVIDE(COUNT(DISTINCT IF(d30_on_deals AND d30_on_ads, vendor_code, NULL))
    , COUNT(DISTINCT vendor_code)) AS d30_deals_and_ads_pcnt
  
  , COUNT(DISTINCT IF(d0_on_deals AND NOT d0_on_ads, vendor_code, NULL)) AS d0_deals_only
  , COUNT(DISTINCT IF(NOT d0_on_deals AND d0_on_ads, vendor_code, NULL)) AS d0_ads_only
  , COUNT(DISTINCT IF(d0_on_deals AND d0_on_ads, vendor_code, NULL)) AS d0_deals_and_ads

  , SAFE_DIVIDE(
    COUNT(DISTINCT IF(d0_on_deals AND NOT d0_on_ads, vendor_code, NULL))
    , COUNT(DISTINCT vendor_code)) AS d0_deals_only_pcnt

    , SAFE_DIVIDE(
   COUNT(DISTINCT IF(NOT d0_on_deals AND d0_on_ads, vendor_code, NULL))
    , COUNT(DISTINCT vendor_code)) AS d0_ads_only_pcnt

      , SAFE_DIVIDE(
   COUNT(DISTINCT IF(d0_on_deals AND d0_on_ads, vendor_code, NULL))
    , COUNT(DISTINCT vendor_code)) AS d0_deals_and_ads_pcnt
  
  
FROM adoption
-- WHERE d30 >>= "2024-11-01"
WHERE d30 <<= CURRENT_DATE
AND global_entity_id IN ("MJM_AT","NP_HU","PO_FI","DJ_CZ", "FO_NO","OP_SE")

GROUP BY ALL

UNION ALL 

