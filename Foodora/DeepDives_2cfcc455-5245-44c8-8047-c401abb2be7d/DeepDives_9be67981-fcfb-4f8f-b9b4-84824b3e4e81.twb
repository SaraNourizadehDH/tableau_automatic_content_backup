  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Defninitions / Descriptions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/DeepDives_17440364807170/DefninitionsDescriptions?rev=' id='DefninitionsDescriptions' path='/t/Foodora/workbooks/DeepDives_17440364807170' revision='' site='Foodora' />
      <style />
      <size maxheight='1100' maxwidth='1200' minheight='1100' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='92910' id='3' type-v2='text' w='98666' x='667' y='6363'>
            <formatted-text>
              <run bold='true' fontcolor='#b92dc2' fontname='Arial' fontsize='15'>Inventory:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Active inventory </run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'>- Count of unique outlets that have at least one order during a calendar month</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>AB acquisitions (TS +FS) </run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'>- All A &amp; B graded vendors activated in a certaain period of time in the platform for that given territory based on the Lead Grading model only by Telesales or Field Sales Reps. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>AB addressable GTC</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - A + B Graded Vendors only available in the competition measured vs main competitor only in a given territory in a moment in time. They also need to be considered only if marked as &quot;Addressable&quot; and for APAC Markets (specially vs Grab) we check Review Velocity Last 30 Days positive to make sure they are active in the competitor&apos;s platform. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>AB Addressable GTC acquisitions</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Activations that belonged to AB Addressable GTC</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>FS + TS Productivity</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Activations done per HC in a monthly period by Field Sales or Tele Sales Reps in a given territory. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>%AB &gt; 75 orders in F60D</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Vendors that generated more than 75 valid orders in the first 60 days since acquired. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>% Zombies</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - The distinct count of vendors with zero valid orders in the last 30 days. </run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontcolor='#b92dc2' fontname='Arial' fontsize='14'>VFD: </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>VFD/GMV (Food) </run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Total VF deal / Total food GMV (includes manual adjustments)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>VFD/GMV - Always On (AO)</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'>  - (total vendor funded AO discounts + total vendor funded AO vouchers) / total resto gmv </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>VFD Vendor Penetration</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Total number of vendors with &gt;=1 VF deal order / Total order generating vendors</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Disco Campaign Cofunding</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - (total vendor spend / (total dh + vf spend) on disco deals only</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Order Penetration</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Total orders with (VF + DH funded deal) / Total orders</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontcolor='#b92dc2' fontname='Arial' fontsize='14'>Subscription</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='14'>Æ </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Subscriber % of GMV</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - PRO USer paid Gmv/ Platform user paid GMV </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Active Subscribers#</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Subscribers having a PRO plan </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Active Subscribers - % paying </run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'>- Subscribers having a PRO plan and paying money on it </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Active Subscribers - % on Long-term-plan</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Subscribers having a PRO Long term plan (more than 1m plan) </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Churn rate (from eligible)</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Churned subscribers / up for renewal </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>% of Pro orders with $0 DF</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - pro orders with zero delivery fee paid by user </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Pro user savings (% of Pro GFV)</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Free delivery and Pro deal savings / PRO GFV </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Pro user savings - Vendor funded (% of Pro GFV)</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Free delivery and Pro deal savings vendor funded / PRO GFV </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Vendor coverage with deals (% GMV) </run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'>- GMV of vendors offering a pro deal / platform GMV </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>A/B coverage with deals (% of GMV)</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - GMV of A/B vendors offering a pro deal / platform GMV </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>FLGPO ratio</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - (PRO FLPGO / Non PRO FLGPO) - 1 </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#b92dc2' fontname='Arial' fontsize='14'>Quick Commerce:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Dmarts SC]  Dmart weighted availability v2 </run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'>- Weighted Availability of sku based on sales forecast and session weightage. WA = SUM(Available Events Weightage * Sales Forecast qty) / SUM(Total Events Weightage * Sales Forecast qty)&quot; </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Dmart Commercial] Promotion Quality Score </run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'>- The score aims to drive promo performance within 4 levers like promo attractiveness, promo availability, effective promos and market promo GPV uplift </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Shops Commercial] # key partners per MAU (Grocery &amp; H&amp;B)</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - KPI is calculated as the average number of key partners each single MAU can shop with, capping the maximum value to reach at 3 per vertical, representing a good offer. This means the maximum overall value reachable is 6. See detailed example on following link. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Shops Commercial]  Promo GPV % (Grocery &amp; H&amp;B key partners) </run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'>- % of GPV (GFV) of promotional items over Total GPV - only applicable to AAA partners </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>QC GMV % platform</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - QC Net GMV / Platform Net GMV </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Shops Commercial] Grocery Assortment Quality Score (AAA supermarkets) </run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'>- Composite metrics of assortment size, assortment design, ultra fresh performance, buyable rate, category breath, and fresh performance. See detailed explanation here </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Shops] AAA Supermarket Assortment </run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'>- Average active SKU number per AAA supermarket </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Shops] Offline Rate (Weighted)</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Total offline minutes / Total scheduled open minutes, with higher weightage applied to Vendors with greater contribution of Orders </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Shops Ops] % items not delivered</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Qty not fulfilled by the Vendor in Valid or Vendor Product Unavailable Orders as a % ordered quantity </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Dmart Commercial] Dmart Assortment quality score v6</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Measures 7 different input metrics from 3 pillars (choice, structure, health), which is blended based on their importance to form a single score </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Dmart] Fresh and Ultra Fresh Basket Penetration </run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'>- % of orders containing at least one Fresh or Ultra Fresh product </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Dmart Commercial] Dmart Affordability score</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='11'> - To improve customer&apos;s affordability perfection, the score focuses KVI base price index, gross basket discount, average realized fee out of ABV </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='5636' id='5' type-v2='text' w='98666' x='667' y='727'>
            <formatted-text>
              <run fontalignment='1' fontcolor='#c10b57' fontname='Tableau Bold' fontsize='18'>Definitions / Descriptions</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='239' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='238' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone forceUpdate='true' h='5636' id='5' type-v2='text' w='98666' x='667' y='727'>
                  <formatted-text>
                    <run fontalignment='1' fontcolor='#c10b57' fontname='Tableau Bold' fontsize='18'>Definitions / Descriptions</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='92910' id='3' type-v2='text' w='98666' x='667' y='6363'>
                  <formatted-text>
                    <run bold='true' fontcolor='#b92dc2' fontname='Arial' fontsize='15'>Inventory:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Active inventory </run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'>- Count of unique outlets that have at least one order during a calendar month</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>AB acquisitions (TS +FS) </run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'>- All A &amp; B graded vendors activated in a certaain period of time in the platform for that given territory based on the Lead Grading model only by Telesales or Field Sales Reps. </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>AB addressable GTC</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - A + B Graded Vendors only available in the competition measured vs main competitor only in a given territory in a moment in time. They also need to be considered only if marked as &quot;Addressable&quot; and for APAC Markets (specially vs Grab) we check Review Velocity Last 30 Days positive to make sure they are active in the competitor&apos;s platform. </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>AB Addressable GTC acquisitions</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Activations that belonged to AB Addressable GTC</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>FS + TS Productivity</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Activations done per HC in a monthly period by Field Sales or Tele Sales Reps in a given territory. </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>%AB &gt; 75 orders in F60D</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Vendors that generated more than 75 valid orders in the first 60 days since acquired. </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>% Zombies</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - The distinct count of vendors with zero valid orders in the last 30 days. </run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontcolor='#b92dc2' fontname='Arial' fontsize='14'>VFD: </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>VFD/GMV (Food) </run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Total VF deal / Total food GMV (includes manual adjustments)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>VFD/GMV - Always On (AO)</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'>  - (total vendor funded AO discounts + total vendor funded AO vouchers) / total resto gmv </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>VFD Vendor Penetration</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Total number of vendors with &gt;=1 VF deal order / Total order generating vendors</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Disco Campaign Cofunding</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - (total vendor spend / (total dh + vf spend) on disco deals only</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Order Penetration</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Total orders with (VF + DH funded deal) / Total orders</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontcolor='#b92dc2' fontname='Arial' fontsize='14'>Subscription</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='14'>Æ </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Subscriber % of GMV</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - PRO USer paid Gmv/ Platform user paid GMV </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Active Subscribers#</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Subscribers having a PRO plan </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Active Subscribers - % paying </run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'>- Subscribers having a PRO plan and paying money on it </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Active Subscribers - % on Long-term-plan</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Subscribers having a PRO Long term plan (more than 1m plan) </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Churn rate (from eligible)</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Churned subscribers / up for renewal </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>% of Pro orders with $0 DF</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - pro orders with zero delivery fee paid by user </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Pro user savings (% of Pro GFV)</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Free delivery and Pro deal savings / PRO GFV </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Pro user savings - Vendor funded (% of Pro GFV)</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Free delivery and Pro deal savings vendor funded / PRO GFV </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>Vendor coverage with deals (% GMV) </run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'>- GMV of vendors offering a pro deal / platform GMV </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>A/B coverage with deals (% of GMV)</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - GMV of A/B vendors offering a pro deal / platform GMV </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>FLGPO ratio</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - (PRO FLPGO / Non PRO FLGPO) - 1 </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#b92dc2' fontname='Arial' fontsize='14'>Quick Commerce:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Dmarts SC]  Dmart weighted availability v2 </run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'>- Weighted Availability of sku based on sales forecast and session weightage. WA = SUM(Available Events Weightage * Sales Forecast qty) / SUM(Total Events Weightage * Sales Forecast qty)&quot; </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Dmart Commercial] Promotion Quality Score </run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'>- The score aims to drive promo performance within 4 levers like promo attractiveness, promo availability, effective promos and market promo GPV uplift </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Shops Commercial] # key partners per MAU (Grocery &amp; H&amp;B)</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - KPI is calculated as the average number of key partners each single MAU can shop with, capping the maximum value to reach at 3 per vertical, representing a good offer. This means the maximum overall value reachable is 6. See detailed example on following link. </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Shops Commercial]  Promo GPV % (Grocery &amp; H&amp;B key partners) </run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'>- % of GPV (GFV) of promotional items over Total GPV - only applicable to AAA partners </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>QC GMV % platform</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - QC Net GMV / Platform Net GMV </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Shops Commercial] Grocery Assortment Quality Score (AAA supermarkets) </run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'>- Composite metrics of assortment size, assortment design, ultra fresh performance, buyable rate, category breath, and fresh performance. See detailed explanation here </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Shops] AAA Supermarket Assortment </run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'>- Average active SKU number per AAA supermarket </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Shops] Offline Rate (Weighted)</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Total offline minutes / Total scheduled open minutes, with higher weightage applied to Vendors with greater contribution of Orders </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Shops Ops] % items not delivered</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Qty not fulfilled by the Vendor in Valid or Vendor Product Unavailable Orders as a % ordered quantity </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Dmart Commercial] Dmart Assortment quality score v6</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - Measures 7 different input metrics from 3 pillars (choice, structure, health), which is blended based on their importance to form a single score </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Dmart] Fresh and Ultra Fresh Basket Penetration </run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'>- % of orders containing at least one Fresh or Ultra Fresh product </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Arial' fontsize='11'>[Dmart Commercial] Dmart Affordability score</run>
                    <run fontcolor='#000000' fontname='Arial' fontsize='11'> - To improve customer&apos;s affordability perfection, the score focuses KVI base price index, gross basket discount, average realized fee out of ABV </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{AE7D9A5F-0C11-4285-8C26-65F82F8D46E2}' />
    </dashboard>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Javelins Deep Dive'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/DeepDives_17440364807170/JavelinsDeepDive?rev=' id='JavelinsDeepDive' path='/t/Foodora/workbooks/DeepDives_17440364807170' revision='' site='Foodora' />
