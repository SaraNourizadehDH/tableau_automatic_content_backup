            <column caption='shops offline YOY' datatype='real' name='[shops offline MOM (copy)_4501558987586744343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    // Previous Month&apos;s Weighted Offline Percentage&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [shops_pct_offline_order_weighted] * [shops_geid_weight_vt] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [shops_geid_weight_vt] END)&#10;    )&#10;    -&#10;    // Two Months Ago&apos;s Weighted Offline Percentage&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [shops_pct_offline_order_weighted] * [shops_geid_weight_vt] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [shops_geid_weight_vt] END)&#10;    )&#10;) * 100' />
            </column>
