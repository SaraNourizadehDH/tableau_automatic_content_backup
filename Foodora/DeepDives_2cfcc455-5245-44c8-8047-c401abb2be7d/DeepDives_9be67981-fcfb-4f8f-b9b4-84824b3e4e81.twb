            <column caption='[agg] AB zombie %' datatype='real' default-format='p0.0%' name='[Calculation_6372734250048233475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ab_zombie_vendors])&#10;/&#10;sum([sa_ka_vendors])' />
