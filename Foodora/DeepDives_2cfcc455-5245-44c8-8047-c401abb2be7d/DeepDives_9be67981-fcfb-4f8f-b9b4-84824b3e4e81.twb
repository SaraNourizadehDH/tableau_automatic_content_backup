            </column>
            <column caption='[agg] % zero df pro order' datatype='real' name='[Calculation_3205577837704036354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([zero_df_pro_order_a])&#10;/&#10;sum([pro_fd_utr_b])' />
            </column>
            <column caption='[agg] % ltp subscribers' datatype='real' name='[Calculation_3919961328965410816]' role='measure' type='quantitative'>
