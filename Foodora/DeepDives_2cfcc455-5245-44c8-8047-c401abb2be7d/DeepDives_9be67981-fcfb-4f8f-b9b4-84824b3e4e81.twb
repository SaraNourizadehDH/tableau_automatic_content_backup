          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ci860l0i4bkxv1civen50kikdtw'>
            <column caption='[agg] paying subscribers share' datatype='real' name='[Calculation_3205577837695188992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([paying_subscribers_percent_a])&#10;/&#10;sum([paying_subscribers_percent_b])' />
            </column>
            <column caption='[agg] Pro Churn rate from eligible' datatype='real' name='[Calculation_3205577837703806977]' role='measure' type='quantitative'>
