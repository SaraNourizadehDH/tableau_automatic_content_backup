    <worksheet name='QC YOY'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025 (bl_europe) (2)' name='federated.1ci860l0i4bkxv1civen50kikdtw' />
          </datasources>
          <datasource-dependencies datasource='federated.1ci860l0i4bkxv1civen50kikdtw'>
            <column caption='Segment' datatype='string' name='[Calculation_5829206083550920720]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU_TR&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;EU&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pandora&quot; THEN &quot;Pandora&quot;&#10;END' />
            </column>
            <column caption='Dmart Pct Fresh Penetration YOY' datatype='real' name='[Dmart Pct Fresh Penetration MoM (copy)_2092766498465710083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_fresh_orders] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_orders] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [dmart_fresh_orders] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [dmart_orders] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='Dmart Pct Weighted Availability V2 YOY' datatype='real' name='[Dmart Pct Weighted Availability V2 MOM (copy)_4501558987588145177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_wa_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_wa_den] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [dmart_wa_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [dmart_wa_den] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='Dmarts fresh availablity YOY' datatype='real' name='[Dmarts fresh availablity MOM (copy)_371406239050616836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_fresh_wa_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_fresh_wa_den] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [dmart_fresh_wa_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [dmart_fresh_wa_den] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='Pct Items not delivered YoY' datatype='real' name='[Pct Items not delivered MoM (copy)_1193172472309149722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [shops_items_not_delivered_excl_post_delivery_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [shops_items_not_delivered_den] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [shops_items_not_delivered_excl_post_delivery_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [shops_items_not_delivered_den] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='QC GMV Share YOY' datatype='real' name='[QC GMV Share MoM (copy)_1640225104335839235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [qc_gmv] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [qc_gmv] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='Shops AAA Supermarket active products YOY' datatype='real' name='[Shops AAA Supermarket active products MoM (copy)_1559723260989677573]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [shops_aaa_supermarket_active_products] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [shops_aaa_supermarket_active_products] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [shops_aaa_supermarket_active_products] END)' />
            </column>
            <column caption='Shops key partners per MAU YOY' datatype='real' name='[Shops key partners per MAU MOM (copy)_4501558987584880658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [key_partner_country_average] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [all_platform_mau_country_average] END)&#10;    )&#10;    /&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [key_partner_country_average] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [all_platform_mau_country_average] END)&#10;    )&#10;) - 1' />
            </column>
            <column caption='All Platform Mau Country Average' datatype='real' name='[all_platform_mau_country_average]' role='measure' type='quantitative' />
