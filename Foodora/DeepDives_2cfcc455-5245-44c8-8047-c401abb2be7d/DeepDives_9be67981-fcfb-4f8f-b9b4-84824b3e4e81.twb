                <alias key='&quot;EU&quot;' value='EU (Excl. TR)' />
                <alias key='&quot;EU_TR&quot;' value='EU (Incl. TR)' />
              </aliases>
            </column>
            <column datatype='integer' name='[field_rep_activations_num]' role='measure' type='quantitative' />
            <column datatype='integer' name='[field_rep_users]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column caption='field rep productivity MOM' datatype='real' default-format='p0.0%' name='[productivity MOM (copy)_1367616598920663041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [field_rep_activations_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [field_rep_users] END)&#10;    )&#10;    /&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [field_rep_activations_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [field_rep_users] END)&#10;    )&#10;) - 1' />
            </column>
