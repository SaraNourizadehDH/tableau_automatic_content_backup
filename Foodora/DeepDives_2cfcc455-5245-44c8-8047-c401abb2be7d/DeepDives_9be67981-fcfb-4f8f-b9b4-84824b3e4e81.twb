    <worksheet name='VFD deep dive'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025 (bl_europe) (2)' name='federated.1ci860l0i4bkxv1civen50kikdtw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Months to Show' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <range max='6' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ci860l0i4bkxv1civen50kikdtw'>
            <column caption='[agg] VFD GMV' datatype='real' name='[Calculation_3984137611677024256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(total_incentive_cost_vendor_incl_manual_adjustment_eur)&#10;/&#10;sum([gmv_eur])' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_5829206083550920720]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU_TR&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;EU&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pandora&quot; THEN &quot;Pandora&quot;&#10;END' />
            </column>
            <column caption='% Deal Utilization' datatype='real' default-format='p0.0%' name='[Calculation_6372734250328383528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vf_deal_orders_numerator])&#10;/&#10;SUM([deal_orders_denominator])' />
            </column>
            <column caption='[agg] vfd self booking ratio' datatype='real' default-format='p0.0%' name='[Calculation_6372734250336600110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_vendors_with_vfd_sb_deals_self_booking])&#10;/&#10;sum([total_vendors_sb])' />
            </column>
            <column caption='[agg] VFD GMV AO' datatype='real' name='[Calculation_6404963148143558658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ao_vendor_eur])&#10;/&#10;sum([gmv_eur])' />
            </column>
            <column caption='[agg] disco cofunding ratio' datatype='real' name='[Calculation_6404963148150796297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([disco_vendor_eur])&#10;/&#10;SUM([disco_eur])' />
            </column>
            <column caption='[agg] vfd vendor penetration' datatype='real' name='[Calculation_6404963148151947275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(vf_vendors)&#10;/&#10;sum(vendors)' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_6537045256791404548]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Check if the date is within the desired number of FULL previous months for the current year&#10;(DATEADD(&apos;month&apos;, -[Parameters].[Parameter 1], DATETRUNC(&apos;month&apos;, TODAY())) &lt;= [month] AND [month] &lt; DATETRUNC(&apos;month&apos;, TODAY()))&#10;&#10;OR&#10;&#10;// Check if the date is ONLY the PREVIOUS MONTH of the PREVIOUS YEAR&#10;(MONTH([month]) = MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))&#10;AND YEAR([month]) = YEAR(TODAY()) - 1)' />
            </column>
            <column caption='[agg] Pro VFD/Pro GMV' datatype='real' name='[[agg]] VFD GMV AO (copy)_391039175011385344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pro_vendor_eur])&#10;/&#10;sum([pro_gmv_eur])' />
            </column>
            <column caption='[agg] VFD GMV Disco' datatype='real' name='[[agg]] VFD GMV Pro (copy)_391039175012634625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([disco_vendor_eur])&#10;/&#10;sum([gmv_eur])' />
            </column>
            <column caption='[agg] order penetration' datatype='real' name='[[agg]] cofunding ratio (copy)_391039175013142530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([deal_orders])&#10;/&#10;SUM([orders_op])' />
            </column>
