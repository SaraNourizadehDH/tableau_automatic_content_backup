          </datasources>
          <datasource-dependencies datasource='federated.09l3x7r1yd7cvn1g8ba7i13namua'>
            <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_5829206083550920720]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU_TR&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;EU&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pandora&quot; THEN &quot;Pandora&quot;&#10;END' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;EU&quot;' value='EU (Excl. TR)' />
                <alias key='&quot;EU_TR&quot;' value='EU (Incl. TR)' />
              </aliases>
            </column>
            <column datatype='date' name='[Month]' role='dimension' type='ordinal' />
            <column datatype='real' name='[ab_gtc_this_month]' role='measure' type='quantitative' />
            <column datatype='real' name='[acquired_by_dh]' role='measure' type='quantitative' />
            <column caption='acquired_dy_dh (copy)' datatype='real' name='[acquired_dy_dh (copy)_6537045257151102982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-[acquired_by_dh]' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ecl3640sfw5hs15xzxod16fy5xe'>
            <column caption='zombie formed vs target' datatype='real' default-format='p0.0%' name='[Calculation_1696731201239719936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1ci860l0i4bkxv1civen50kikdtw].[zombies_formed])&#10;- SUM([target_zombies_formed])&#10;)&#10;/&#10;SUM([target_zombies_formed])' />
            </column>
            <column caption='zombie revived vs target' datatype='real' default-format='p0.0%' name='[Calculation_1696731201239986177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1ci860l0i4bkxv1civen50kikdtw].[zombies_revived])&#10;- SUM([target_zombies_revived])&#10;)&#10;/&#10;SUM([target_zombies_revived])' />
            </column>
            <column caption='previous month filter' datatype='boolean' name='[Calculation_3360459398635352065]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
            </column>
            <column caption='inventory vs target' datatype='real' name='[Calculation_3360459398654816268]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([federated.1ci860l0i4bkxv1civen50kikdtw].[ogv_vendors]) &#10;- SUM([target_total_active_inventory])&#10;)&#10;/&#10;SUM([target_total_active_inventory])' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_3360459400411570212]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU (Excl. TR)&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU (Incl. TR)&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;EU&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pandora&quot; THEN &quot;Pandora&quot;&#10;END' />
            </column>
            <column caption='%AB w/both Ads &amp; Deals live on D0 vs target' datatype='real' default-format='*0.0pp' name='[Calculation_4865646857677225984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([federated.1ci860l0i4bkxv1civen50kikdtw].[Calculation_6372734250139222043]&#10;- AVG([target_ab_ads_deals_live_d0])&#10;)&#10;* 100' />
