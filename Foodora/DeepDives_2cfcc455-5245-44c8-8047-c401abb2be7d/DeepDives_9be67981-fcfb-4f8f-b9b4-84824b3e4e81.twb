    <worksheet name='QC'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025 (bl_europe) (2)' name='federated.1ci860l0i4bkxv1civen50kikdtw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Months to Show' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <range max='6' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ci860l0i4bkxv1civen50kikdtw'>
            <column caption='[agg] dmart fresh and ultra fresh availability' datatype='real' name='[Calculation_371406239049068545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dmart_fresh_wa_num])&#10;/&#10;sum([dmart_fresh_wa_den])' />
            </column>
            <column caption='[agg] Dmart Pct Weighted Availability V2' datatype='real' name='[Calculation_4501558987557949440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dmart_wa_num])&#10;/&#10;sum([dmart_wa_den])' />
            </column>
            <column caption='[agg] shops key partners per MAU' datatype='real' name='[Calculation_4501558987558252545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([key_partner_country_average])&#10;/&#10;sum([all_platform_mau_country_average])' />
            </column>
            <column caption='[agg] shops pct promo gpv contribution' datatype='real' name='[Calculation_4501558987559272450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([shops_promo_gpv_contribution_num])&#10;/&#10;sum([shops_promo_gpv_contribution_den])' />
            </column>
            <column caption='[agg] items not delivered' datatype='real' name='[Calculation_4501558987562876933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([shops_items_not_delivered_excl_post_delivery_num])&#10;/&#10;sum([shops_items_not_delivered_den])' />
            </column>
            <column caption='shops offline' datatype='real' name='[Calculation_4501558987563614214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shops_pct_offline_order_weighted] * [shops_geid_weight_vt])&#10;/&#10;SUM([shops_geid_weight_vt])' />
            </column>
            <column caption='[agg] dmart fresh penetration' datatype='real' name='[Calculation_4501558987565342728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dmart_fresh_orders])&#10;/&#10;sum([dmart_orders])' />
            </column>
            <column caption='[agg] QC GMV share' datatype='real' name='[Calculation_5425570967403634688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_gmv])&#10;/&#10;SUM([gmv])' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_5829206083550920720]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU_TR&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;EU&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pandora&quot; THEN &quot;Pandora&quot;&#10;END' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_6537045256791404548]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Check if the date is within the desired number of FULL previous months for the current year&#10;(DATEADD(&apos;month&apos;, -[Parameters].[Parameter 1], DATETRUNC(&apos;month&apos;, TODAY())) &lt;= [month] AND [month] &lt; DATETRUNC(&apos;month&apos;, TODAY()))&#10;&#10;OR&#10;&#10;// Check if the date is ONLY the PREVIOUS MONTH of the PREVIOUS YEAR&#10;(MONTH([month]) = MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))&#10;AND YEAR([month]) = YEAR(TODAY()) - 1)' />
            </column>
            <column caption='All Platform Mau Country Average' datatype='real' name='[all_platform_mau_country_average]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;EU&quot;' value='EU (Excl. TR)' />
                <alias key='&quot;EU_TR&quot;' value='EU (Incl. TR)' />
              </aliases>
            </column>
            <column caption='Dmart Fresh Orders' datatype='integer' name='[dmart_fresh_orders]' role='measure' type='quantitative' />
            <column caption='Dmart Fresh Wa Den' datatype='real' name='[dmart_fresh_wa_den]' role='measure' type='quantitative' />
            <column caption='Dmart Fresh Wa Num' datatype='real' name='[dmart_fresh_wa_num]' role='dimension' type='ordinal' />
            <column caption='Dmart Orders' datatype='integer' name='[dmart_orders]' role='measure' type='quantitative' />
            <column caption='Dmart Wa Den' datatype='real' name='[dmart_wa_den]' role='measure' type='quantitative' />
            <column caption='Dmart Wa Num' datatype='real' name='[dmart_wa_num]' role='dimension' type='ordinal' />
            <column caption='Gmv' datatype='real' name='[gmv]' role='measure' type='quantitative' />
            <column caption='Key Partner Country Average' datatype='real' name='[key_partner_country_average]' role='dimension' type='ordinal' />
            <column-instance column='[month]' derivation='Month' name='[mn:month:ok]' pivot='key' type='ordinal' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5829206083550920720]' derivation='None' name='[none:Calculation_5829206083550920720:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6537045256791404548]' derivation='None' name='[none:Calculation_6537045256791404548:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column caption='Qc Gmv' datatype='real' name='[qc_gmv]' role='measure' type='quantitative' />
            <column caption='Shops Aaa Supermarket Active Products' datatype='real' name='[shops_aaa_supermarket_active_products]' role='measure' type='quantitative' />
            <column caption='Shops Geid Weight Vt' datatype='real' name='[shops_geid_weight_vt]' role='measure' type='quantitative' />
            <column caption='Shops Items Not Delivered Den' datatype='integer' name='[shops_items_not_delivered_den]' role='measure' type='quantitative' />
            <column caption='Shops Items Not Delivered Excl Post Delivery Num' datatype='integer' name='[shops_items_not_delivered_excl_post_delivery_num]' role='dimension' type='ordinal' />
            <column caption='Shops Pct Offline Order Weighted' datatype='real' name='[shops_pct_offline_order_weighted]' role='measure' type='quantitative' />
