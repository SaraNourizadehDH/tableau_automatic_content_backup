      <aliases enabled='yes' />
      <column caption='AB GTC acquired MoM' datatype='real' default-format='p0.0%' name='[AB Acquisitions MoM (copy)_5829206083545616388]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [Month] = DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [acquired_dy_dh (copy)_6537045257151102982] END) &#10;- SUM(IF [Month] = DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [acquired_dy_dh (copy)_6537045257151102982] END)) &#10;/ &#10;SUM(IF [Month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [acquired_dy_dh (copy)_6537045257151102982] END)' />
      </column>
      <column caption='AB GTC YoY' datatype='real' name='[AB GTC MoM (copy)_3948249500361007109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [Month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [ab_gtc_this_month] END) &#10;- SUM(IF [Month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [ab_gtc_this_month] END)) &#10;/ &#10;SUM(IF [Month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [ab_gtc_this_month] END)' />
      </column>
      <column caption='AB GTC MoM' datatype='real' default-format='p0.0%' name='[AB GTC acquired MoM (copy)_3948249500360822788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [Month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [ab_gtc_this_month] END) &#10;- SUM(IF [Month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [ab_gtc_this_month] END)) &#10;/ &#10;SUM(IF [Month] = DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [ab_gtc_this_month] END)' />
      </column>
      <column caption='previous month filter' datatype='boolean' name='[Calculation_560909311124627459]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Month]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
      </column>
      <column caption='Segment' datatype='string' name='[Calculation_5829206083550920720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Country]&#10;    when &quot;Austria&quot; then &quot;EU&quot;&#10;    WHEN &quot;Czech Republic&quot; then &quot;EU&quot;&#10;    WHEN &quot;Finland&quot; then &quot;EU&quot;&#10;    WHEN &quot;Hungary&quot; then &quot;EU&quot;&#10;    WHEN &quot;Sweden&quot; then &quot;EU&quot;&#10;    WHEN &quot;Norway&quot; then &quot;EU&quot;&#10;    WHEN &quot;EU&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;EU_TR&quot; THEN &quot;EU&quot;&#10;    WHEN &quot;Turkey&quot; then &quot;EU&quot;&#10;    WHEN &quot;Bangladesh&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Hong Kong&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Cambodia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Laos&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Myanmar&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Malaysia&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Philippines&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pakistan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Singapore&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Taiwan&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;APAC&quot; THEN &quot;APAC&quot;&#10;    WHEN &quot;Pandora&quot; THEN &quot;Pandora&quot;&#10;END' />
      </column>
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <aliases>
          <alias key='&quot;EU&quot;' value='EU (Excl. TR)' />
          <alias key='&quot;EU_TR&quot;' value='EU (Incl. TR)' />
