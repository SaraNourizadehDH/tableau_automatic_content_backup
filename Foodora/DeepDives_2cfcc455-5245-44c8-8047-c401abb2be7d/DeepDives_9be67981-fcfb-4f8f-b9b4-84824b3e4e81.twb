        <calculation class='tableau' formula='SUM([d0_ab_deals_and_ads_pcnt])' />
      </column>
      <column caption='%AB w/both Ads &amp; Deals live on D30 MoM' datatype='real' default-format='p0.0%' name='[Calculation_6372734250141569053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [d30_ab_deals_and_ads_pcnt] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [d30_ab_deals_and_ads_pcnt] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [d30_ab_deals_and_ads_pcnt] END)' />
      </column>
      <column caption='%AB w/both Ads &amp; Deals live on D0 MoM' datatype='real' default-format='p0.0%' name='[Calculation_6372734250141794334]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [d0_ab_deals_and_ads_pcnt] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [d0_ab_deals_and_ads_pcnt] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [d0_ab_deals_and_ads_pcnt] END)' />
      </column>
