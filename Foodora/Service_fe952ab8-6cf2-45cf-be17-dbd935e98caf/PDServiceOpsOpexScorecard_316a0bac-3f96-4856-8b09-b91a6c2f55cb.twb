    <worksheet name='Trendline'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Light' fontsize='8'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='service_operations__opex_scorecard_daily' name='federated.156nyab0r64hxd1g3crtv1dx2xbj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Country Name Logic' datatype='string' name='[Date Level (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Pandora&quot;'>
              <calculation class='tableau' formula='&quot;Pandora&quot;' />
            </column>
            <column caption='To Date' datatype='boolean' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
            <column alias='Month' caption='Date Level' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;iso-week&quot;' value='Week' />
                <alias key='&quot;month&quot;' value='Month' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.156nyab0r64hxd1g3crtv1dx2xbj'>
            <column caption='Score Value' datatype='real' default-format='p0.00%' name='[Calculation_1727271206438961153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([metric]) = &apos;qa_score&apos;&#10;    THEN SUM([numerator])/SUM([denominator])/100&#10;&#10;ELSEIF ATTR([metric]) = &apos;compensation&apos;&#10;    OR ATTR([metric]) = &apos;wastage_cost&apos; THEN&#10;    SUM([numerator])&#10;&#10;ELSEIF CONTAINS(ATTR([metric]), &quot;zombie&quot;) THEN&#10;    IF [Parameters].[Parameter 2] = &apos;month&apos; THEN&#10;        SUM([numerator])&#10;    ELSEIF [Parameters].[Parameter 2] = &apos;iso-week&apos; THEN&#10;        SUM([denominator])&#10;    END&#10;&#10;ELSE ROUND(SUM([numerator])/SUM([denominator]),4)&#10;END' />
            </column>
            <column caption='To Date Filter' datatype='boolean' name='[Calculation_1727271206754816031]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] &lt;=&#10;IF [Parameters].[Parameter 2]=&apos;month&apos; THEN&#10;    IF NOT [Parameters].[Parameter 1] THEN&#10;        DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))  // end of last month&#10;    ELSE&#10;        TODAY()  // current date&#10;    END&#10;ELSEIF [Parameters].[Parameter 2]=&apos;iso-week&apos; THEN&#10;    IF NOT [Parameters].[Parameter 1] THEN&#10;        DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;iso-week&apos;, TODAY()))  // end of last week&#10;    ELSE&#10;        TODAY()  // current date&#10;    END&#10;END' />
            </column>
            <column caption='Report Week' datatype='date' name='[Calculation_1727271206831374389]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;iso-week&apos;, [report_date]))' />
            </column>
            <column caption='Date Level Dynamic' datatype='datetime' name='[Calculation_1727271206834499638]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 2], [report_date])' />
            </column>
            <column caption='Date Level Dynamic Filter' datatype='boolean' name='[Calculation_1727271206837989431]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;month&apos; THEN DATEDIFF(&apos;month&apos;, [Calculation_1727271206834499638], TODAY()) &lt;= 4&#10;  WHEN &apos;iso-week&apos; THEN DATEDIFF(&apos;iso-week&apos;, [Calculation_1727271206834499638], TODAY()) &lt;= 8&#10;END' />
            </column>
            <column caption='Date Axis Labels Dynamic' datatype='string' name='[Calculation_1727271206840115256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;month&apos; THEN DATENAME(&apos;month&apos;, [report_date]) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [report_date]))&#10;WHEN &apos;iso-week&apos; THEN STR(DATE([Calculation_1727271206831374389])) + &apos; (W&apos; + STR(DATEPART(&apos;iso-week&apos;, [report_date])) + &apos;)&apos;&#10;END' />
            </column>
            <column caption='Country Name Filter' datatype='boolean' name='[Calculation_596304752452489223]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Date Level (copy)] = &quot;Pandora&quot; THEN TRUE&#10;ELSEIF [Parameters].[Date Level (copy)] = [country_name] THEN TRUE&#10;ELSEIF [Parameters].[Date Level (copy)] = &quot;Foodpanda&quot; AND STARTSWITH([country_name], &quot;Foodpanda -&quot;) THEN TRUE&#10;ELSEIF [Parameters].[Date Level (copy)] = &quot;Foodora&quot; AND STARTSWITH([country_name], &quot;Foodora -&quot;) THEN TRUE&#10;ELSEIF [Parameters].[Date Level (copy)] = &quot;Yemeksepeti&quot; AND STARTSWITH([country_name], &quot;Yemeksepeti -&quot;) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Score Value Display' datatype='string' default-format='p0.00%' name='[Score Value (copy)_1727271206463037443]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([metric]) = &quot;onboarding_days&quot; THEN&#10;&#10;    STR(ROUND([Calculation_1727271206438961153], 2))&#10;&#10;ELSEIF ATTR([metric]) = &quot;compensation&quot; OR ATTR([metric]) = &quot;wastage_cost&quot; THEN&#10;&#10;    &quot;€&quot; + &#10;    IF LEN(STR(INT(ROUND([Calculation_1727271206438961153], 0)))) &lt;= 3 THEN&#10;        STR(INT(ROUND([Calculation_1727271206438961153], 0)))&#10;&#10;    ELSEIF LEN(STR(INT(ROUND([Calculation_1727271206438961153], 0)))) &lt;= 6 THEN&#10;        LEFT(STR(INT(ROUND([Calculation_1727271206438961153], 0))), LEN(STR(INT(ROUND([Calculation_1727271206438961153], 0)))) - 3) + &quot;,&quot; +&#10;        RIGHT(STR(INT(ROUND([Calculation_1727271206438961153], 0))), 3)&#10;&#10;    ELSE&#10;        LEFT(STR(INT(ROUND([Calculation_1727271206438961153], 0))), LEN(STR(INT(ROUND([Calculation_1727271206438961153], 0)))) - 6) + &quot;,&quot; +&#10;        MID(STR(INT(ROUND([Calculation_1727271206438961153], 0))), LEN(STR(INT(ROUND([Calculation_1727271206438961153], 0)))) - 5, 3) + &quot;,&quot; +&#10;        RIGHT(STR(INT(ROUND([Calculation_1727271206438961153], 0))), 3)&#10;&#10;    END&#10;&#10;ELSEIF CONTAINS(ATTR([metric]), &quot;zombie&quot;) THEN&#10;&#10;    IF LEN(STR(INT(ROUND([Calculation_1727271206438961153], 0)))) &lt;= 3 THEN&#10;        STR(INT(ROUND([Calculation_1727271206438961153], 0)))&#10;&#10;    ELSEIF LEN(STR(INT(ROUND([Calculation_1727271206438961153], 0)))) &lt;= 6 THEN&#10;        LEFT(STR(INT(ROUND([Calculation_1727271206438961153], 0))), LEN(STR(INT(ROUND([Calculation_1727271206438961153], 0)))) - 3) + &quot;,&quot; +&#10;        RIGHT(STR(INT(ROUND([Calculation_1727271206438961153], 0))), 3)&#10;&#10;    ELSE&#10;        LEFT(STR(INT(ROUND([Calculation_1727271206438961153], 0))), LEN(STR(INT(ROUND([Calculation_1727271206438961153], 0)))) - 6) + &quot;,&quot; +&#10;        MID(STR(INT(ROUND([Calculation_1727271206438961153], 0))), LEN(STR(INT(ROUND([Calculation_1727271206438961153], 0)))) - 5, 3) + &quot;,&quot; +&#10;        RIGHT(STR(INT(ROUND([Calculation_1727271206438961153], 0))), 3)&#10;&#10;    END&#10;&#10;ELSE&#10;&#10;    STR(ROUND([Calculation_1727271206438961153] * 100, 2)) + &quot;%&quot;&#10;&#10;END' />
            </column>
