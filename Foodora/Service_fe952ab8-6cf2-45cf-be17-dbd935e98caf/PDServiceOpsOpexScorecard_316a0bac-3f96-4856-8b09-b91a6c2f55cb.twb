      <aliases enabled='yes' />
      <column caption='Last Week' datatype='string' name='[COOKING Current Month (copy) (copy) (copy)_1727271206855139394]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] THEN &quot;last week&quot; ELSE &quot;last last week&quot; END' />
      </column>
      <column caption='This Week' datatype='string' name='[COOKING Current Month (copy) (copy)_1727271206855131201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] THEN &quot;this week&quot; ELSE &quot;last week&quot; END' />
      </column>
      <column caption='Last Year' datatype='string' name='[COOKING Current Month (copy)_1727271206855123008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] THEN &quot;last year&quot; ELSE &quot;last year last month&quot; END' />
      </column>
      <column caption='Report Month' datatype='date' name='[Calculation_1727271206438055936]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [report_date]))' />
      </column>
      <column caption='Score Value' datatype='real' default-format='p0.00%' name='[Calculation_1727271206438961153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([metric]) = &apos;qa_score&apos;&#10;    THEN SUM([numerator])/SUM([denominator])/100&#10;&#10;ELSEIF ATTR([metric]) = &apos;compensation&apos;&#10;    OR ATTR([metric]) = &apos;wastage_cost&apos; THEN&#10;    SUM([numerator])&#10;&#10;ELSEIF CONTAINS(ATTR([metric]), &quot;zombie&quot;) THEN&#10;    IF [Parameters].[Parameter 2] = &apos;month&apos; THEN&#10;        SUM([numerator])&#10;    ELSEIF [Parameters].[Parameter 2] = &apos;iso-week&apos; THEN&#10;        SUM([denominator])&#10;    END&#10;&#10;ELSE ROUND(SUM([numerator])/SUM([denominator]),4)&#10;END' />
      </column>
      <column caption='Score Color' datatype='integer' name='[Calculation_1727271206440697858]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF (ATTR([metric]) = &apos;non_managed_zombies_revived&apos;&#10;    OR ATTR([metric]) = &apos;managed_zombies_revived&apos;) &#10;THEN&#10;    IF [Calculation_1727271206438961153] &gt;= [Calculation_6477583656200654853] THEN 1&#10;    ELSEIF [Calculation_1727271206438961153] &lt; [Calculation_6477583656200654853] THEN 0&#10;    ELSE 2 END&#10;&#10;ELSEIF (ATTR([metric]) = &apos;non_managed_zombies_formed&apos;&#10;    OR ATTR([metric]) = &apos;managed_zombies_formed&apos;&#10;    OR ATTR([metric]) = &apos;onboarding_days&apos;) &#10;THEN&#10;    IF [Calculation_1727271206438961153] &lt;= [Calculation_6477583656200654853] THEN 1&#10;    ELSEIF [Calculation_1727271206438961153] &gt; [Calculation_6477583656200654853] THEN 0&#10;    ELSE 2 END&#10;&#10;ELSEIF [Calculation_1727271206797504556] AND [Calculation_1727271206438961153] &gt;= [Calculation_6477583656200654853] / 100 THEN 1&#10;&#10;ELSEIF [Calculation_1727271206798200877] AND [Calculation_1727271206438961153] &lt;= [Calculation_6477583656200654853] / 100 THEN 1&#10;&#10;ELSEIF ISNULL([Calculation_6477583656200654853]) OR ISNULL([Calculation_1727271206438961153]) THEN 2&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Date Measures' datatype='string' name='[Calculation_1727271206748532764]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;month&apos; THEN &#10;    CASE [Calculation_1727271206438055936]&#10;&#10;&#10;        WHEN DATETRUNC(&apos;month&apos;, TODAY()) THEN &quot;this month&quot;&#10;        WHEN DATEADD(&quot;month&quot;, -1, DATETRUNC(&apos;month&apos;, TODAY())) THEN &quot;last month&quot;&#10;        WHEN DATEADD(&quot;month&quot;, -2, DATETRUNC(&apos;month&apos;, TODAY())) THEN &quot;last last month&quot;&#10;        WHEN DATEADD(&quot;month&quot;, -12, DATETRUNC(&apos;month&apos;, TODAY())) THEN &quot;last year&quot;&#10;        WHEN DATEADD(&quot;month&quot;, -13, DATETRUNC(&apos;month&apos;, TODAY())) THEN &quot;last year last month&quot;&#10;    &#10;    END&#10;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;iso-week&apos; THEN &#10;&#10;    IF [Calculation_1727271206831374389] = DATETRUNC(&apos;iso-week&apos;, TODAY()) THEN &quot;this week&quot;&#10;    ELSEIF [Calculation_1727271206831374389] = DATEADD(&quot;iso-week&quot;, -1, DATETRUNC(&apos;iso-week&apos;, TODAY())) THEN &quot;last week&quot;&#10;    ELSEIF [Calculation_1727271206831374389] = DATEADD(&quot;iso-week&quot;, -2, DATETRUNC(&apos;iso-week&apos;, TODAY())) THEN &quot;last last week&quot;&#10;    // IF [Report Month] = DATETRUNC(&apos;month&apos;, TODAY()) THEN &quot;this month&quot; END&#10;    // this cannot be used because overlaps with &apos;this week&apos;, &apos;last week&apos;, and &apos;last last week&apos;&#10;    ELSEIF [Calculation_1727271206438055936] = DATEADD(&quot;month&quot;, -1, DATETRUNC(&apos;month&apos;, TODAY())) THEN &quot;last month&quot;&#10;    ELSEIF [Calculation_1727271206438055936] = DATEADD(&quot;month&quot;, -2, DATETRUNC(&apos;month&apos;, TODAY())) THEN &quot;last last month&quot;&#10;    END&#10;    &#10;END' />
      </column>
      <column caption='To Date Filter' datatype='boolean' name='[Calculation_1727271206754816031]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] &lt;=&#10;IF [Parameters].[Parameter 2]=&apos;month&apos; THEN&#10;    IF NOT [Parameters].[Parameter 1] THEN&#10;        DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))  // end of last month&#10;    ELSE&#10;        TODAY()  // current date&#10;    END&#10;ELSEIF [Parameters].[Parameter 2]=&apos;iso-week&apos; THEN&#10;    IF NOT [Parameters].[Parameter 1] THEN&#10;        DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;iso-week&apos;, TODAY()))  // end of last week&#10;    ELSE&#10;        TODAY()  // current date&#10;    END&#10;END' />
      </column>
      <column caption='MoM% Change' datatype='real' name='[Calculation_1727271206770855970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// For MoM change calculations, we cannot rely on the [Date Measures] field when [Date Level Parameter] is &apos;iso-week&apos;.&#10;// Because the &apos;this month&apos; label in [Date Measures] overlaps with the labels &apos;this week&apos;, &apos;last week&apos;, and &apos;last last week&apos;.&#10;// So, when [To Date Parameter] is TRUE and [Date Level Parameter] = &apos;iso-week&apos;, MoM% Change gives incorrect results.&#10;// To fix this, when [To Date Parameter] is TRUE, we explicitly check:&#10;//   [Report Month] = DATETRUNC(&apos;month&apos;, TODAY())&#10;// instead of:&#10;//   [Date Measures] = &apos;this month&apos;&#10;&#10;IF [Parameters].[Parameter 1] THEN&#10;    IF ATTR([metric]) = &quot;qa_score&quot; THEN&#10;&#10;        (&#10;            (&#10;                SUM(IF [Calculation_1727271206438055936] = DATETRUNC(&apos;month&apos;,TODAY()) THEN [numerator] END) /&#10;                SUM(IF [Calculation_1727271206438055936] = DATETRUNC(&apos;month&apos;,TODAY())  THEN [denominator] END) / 100&#10;            ) /&#10;            (&#10;                SUM(IF [Calculation_1727271206748532764] = [Current Month COOKING (copy)_1727271206854877247] THEN [numerator] END) /&#10;                SUM(IF [Calculation_1727271206748532764] = [Current Month COOKING (copy)_1727271206854877247] THEN [denominator] END) / 100&#10;            )&#10;        ) - 1&#10;&#10;    ELSEIF ATTR([metric]) = &quot;compensation&quot; &#10;        OR ATTR([metric]) = &quot;wastage_cost&quot; &#10;        OR ATTR([metric]) = &quot;zombies_formed&quot; &#10;        OR ATTR([metric]) = &quot;zombies_revived&quot; THEN&#10;&#10;        (&#10;            SUM(IF [Calculation_1727271206438055936] = DATETRUNC(&apos;month&apos;,TODAY())  THEN [numerator] END) /&#10;            SUM(IF [Calculation_1727271206748532764] = [Current Month COOKING (copy)_1727271206854877247] THEN [numerator] END)&#10;        ) - 1&#10;&#10;    ELSE&#10;&#10;        (&#10;            (&#10;                SUM(IF [Calculation_1727271206438055936] = DATETRUNC(&apos;month&apos;,TODAY())  THEN [numerator] END) /&#10;                SUM(IF [Calculation_1727271206438055936] = DATETRUNC(&apos;month&apos;,TODAY())  THEN [denominator] END)&#10;            ) /&#10;            (&#10;                SUM(IF [Calculation_1727271206748532764] = [Current Month COOKING (copy)_1727271206854877247] THEN [numerator] END) /&#10;                SUM(IF [Calculation_1727271206748532764] = [Current Month COOKING (copy)_1727271206854877247] THEN [denominator] END)&#10;            )&#10;        ) - 1&#10;&#10;    END&#10;&#10;&#10;ELSE&#10;    IF ATTR([metric]) = &quot;qa_score&quot; THEN&#10;&#10;        (&#10;            (&#10;                SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] THEN [numerator] END) /&#10;                SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] THEN [denominator] END) / 100&#10;            ) /&#10;            (&#10;                SUM(IF [Calculation_1727271206748532764] = [Current Month COOKING (copy)_1727271206854877247] THEN [numerator] END) /&#10;                SUM(IF [Calculation_1727271206748532764] = [Current Month COOKING (copy)_1727271206854877247] THEN [denominator] END) / 100&#10;            )&#10;        ) - 1&#10;&#10;    ELSEIF ATTR([metric]) = &quot;compensation&quot; &#10;        OR ATTR([metric]) = &quot;wastage_cost&quot; &#10;        OR CONTAINS(ATTR([metric]), &quot;zombie&quot;) THEN&#10;&#10;        (&#10;            SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] THEN [numerator] END) /&#10;            SUM(IF [Calculation_1727271206748532764] = [Current Month COOKING (copy)_1727271206854877247] THEN [numerator] END)&#10;        ) - 1&#10;&#10;    ELSE&#10;&#10;        (&#10;            (&#10;                SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] THEN [numerator] END) /&#10;                SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] THEN [denominator] END)&#10;            ) /&#10;            (&#10;                SUM(IF [Calculation_1727271206748532764] = [Current Month COOKING (copy)_1727271206854877247] THEN [numerator] END) /&#10;                SUM(IF [Calculation_1727271206748532764] = [Current Month COOKING (copy)_1727271206854877247] THEN [denominator] END)&#10;            )&#10;        ) - 1&#10;&#10;    END&#10;&#10;END' />
      </column>
      <column caption='Delta Target' datatype='real' name='[Calculation_1727271206778134569]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF ATTR([metric]) = &apos;non_managed_zombies_revived&apos;&#10;    OR ATTR([metric]) = &apos;non_managed_zombies_formed&apos;&#10;    OR ATTR([metric]) = &apos;managed_zombies_revived&apos;&#10;    OR ATTR([metric]) = &apos;managed_zombies_formed&apos;&#10;    OR ATTR([metric]) = &apos;onboarding_days&apos; THEN&#10;&#10;    [Calculation_1727271206787743786] - [Calculation_6477583656200654853]&#10;&#10;ELSE&#10;&#10;    ROUND(([Calculation_1727271206787743786] * 100) - [Calculation_6477583656200654853],2)&#10;&#10;END' />
      </column>
      <column caption='Current Month/Week Score Value' datatype='real' name='[Calculation_1727271206787743786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;month&apos; THEN&#10;&#10;    IF ATTR([metric]) = &apos;qa_score&apos;&#10;        THEN SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] AND [Calculation_596304752452489223] THEN [numerator] END) /&#10;             SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] AND [Calculation_596304752452489223] THEN [denominator] END) / 100&#10;&#10;    ELSEIF ATTR([metric]) = &apos;compensation&apos;&#10;        OR ATTR([metric]) = &apos;wastage_cost&apos;&#10;      THEN SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] AND [Calculation_596304752452489223] THEN [numerator] END)&#10;&#10;    ELSEIF CONTAINS(ATTR([metric]), &apos;zombie&apos;)&#10;      THEN SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] AND [Calculation_596304752452489223] THEN [numerator] END)&#10;&#10;    ELSE SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] AND [Calculation_596304752452489223] THEN [numerator] END) /&#10;         SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] AND [Calculation_596304752452489223] THEN [denominator] END) &#10;    END&#10;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;iso-week&apos; THEN&#10;&#10;    IF ATTR([metric]) = &apos;qa_score&apos;&#10;        THEN SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] AND [Calculation_596304752452489223] THEN [numerator] END) /&#10;             SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] AND [Calculation_596304752452489223] THEN [denominator] END) / 100&#10;&#10;    ELSEIF ATTR([metric]) = &apos;compensation&apos;&#10;        OR ATTR([metric]) = &apos;wastage_cost&apos;&#10;      THEN SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] AND [Calculation_596304752452489223] THEN [numerator] END)&#10;&#10;    ELSEIF CONTAINS(ATTR([metric]), &apos;zombie&apos;)&#10;      THEN SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] AND [Calculation_596304752452489223] THEN [denominator] END)&#10;&#10;    ELSE SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] AND [Calculation_596304752452489223] THEN [numerator] END) /&#10;         SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] AND [Calculation_596304752452489223] THEN [denominator] END) &#10;    END&#10;&#10;END' />
      </column>
      <column caption='Is Higher Better' datatype='boolean' name='[Calculation_1727271206797504556]' role='measure' type='nominal'>
        <calculation class='tableau' formula='ATTR([metric]) = &quot;csat&quot; OR&#10;ATTR([metric]) = &quot;rsat&quot; OR&#10;ATTR([metric]) = &quot;vsat&quot; OR&#10;ATTR([metric]) = &quot;cs_chat_sla&quot; OR&#10;ATTR([metric]) = &quot;cs_email_sla&quot; OR&#10;ATTR([metric]) = &quot;rs_chat_sla&quot; OR&#10;ATTR([metric]) = &quot;rs_email_sla&quot; OR&#10;ATTR([metric]) = &quot;vs_chat_sla&quot; OR&#10;ATTR([metric]) = &quot;vs_email_sla&quot; OR&#10;ATTR([metric]) = &quot;vs_call_sla&quot; OR&#10;ATTR([metric]) = &quot;dlp&quot; OR&#10;ATTR([metric]) = &quot;dld&quot; OR&#10;ATTR([metric]) = &quot;qa_score&quot; OR&#10;ATTR([metric]) = &quot;automation_csat&quot; OR&#10;ATTR([metric]) = &quot;automation_rate&quot; OR&#10;ATTR([metric]) = &quot;non_managed_zombies_revived&quot; OR&#10;ATTR([metric]) = &quot;managed_zombies_revived&quot;' />
      </column>
      <column caption='Is Lower Better' datatype='boolean' name='[Calculation_1727271206798200877]' role='measure' type='nominal'>
        <calculation class='tableau' formula='ATTR([metric]) = &quot;customer_io&quot; OR&#10;ATTR([metric]) = &quot;rider_io&quot; OR&#10;ATTR([metric]) = &quot;vendor_io&quot; OR&#10;ATTR([metric]) = &quot;crv_io&quot; OR&#10;ATTR([metric]) = &quot;fail_rate&quot; OR&#10;ATTR([metric]) = &quot;onboarding_days&quot; OR&#10;ATTR([metric]) = &quot;wastage_cost&quot; OR&#10;ATTR([metric]) = &quot;compensation&quot; OR&#10;ATTR([metric]) = &quot;wastage / gmv&quot; OR&#10;ATTR([metric]) = &quot;compensation / gmv&quot; OR&#10;ATTR([metric]) = &quot;non_managed_zombies_formed&quot; OR&#10;ATTR([metric]) = &quot;managed_zombies_formed&quot;' />
      </column>
      <column caption='Report Week' datatype='date' name='[Calculation_1727271206831374389]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;iso-week&apos;, [report_date]))' />
      </column>
      <column caption='Date Level Dynamic' datatype='datetime' name='[Calculation_1727271206834499638]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 2], [report_date])' />
      </column>
      <column caption='Date Level Dynamic Filter' datatype='boolean' name='[Calculation_1727271206837989431]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;month&apos; THEN DATEDIFF(&apos;month&apos;, [Calculation_1727271206834499638], TODAY()) &lt;= 4&#10;  WHEN &apos;iso-week&apos; THEN DATEDIFF(&apos;iso-week&apos;, [Calculation_1727271206834499638], TODAY()) &lt;= 8&#10;END' />
      </column>
      <column caption='Date Axis Labels Dynamic' datatype='string' name='[Calculation_1727271206840115256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;month&apos; THEN DATENAME(&apos;month&apos;, [report_date]) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [report_date]))&#10;WHEN &apos;iso-week&apos; THEN STR(DATE([Calculation_1727271206831374389])) + &apos; (W&apos; + STR(DATEPART(&apos;iso-week&apos;, [report_date])) + &apos;)&apos;&#10;END' />
      </column>
      <column caption='This Month' datatype='string' name='[Calculation_1727271206854406206]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] THEN &quot;this month&quot; ELSE &quot;last month&quot; END' />
      </column>
      <column caption='Metric 1' datatype='real' name='[Calculation_1727271206857486405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;month&apos; THEN [Calculation_1727271206770855970]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;iso-week&apos; THEN [MoM% Change (copy)_1727271206857175108]&#10;END' />
      </column>
      <column caption='Metric 2' datatype='real' name='[Calculation_1727271206857695302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;month&apos; THEN [Mom% Change (copy)_1727271206776270887]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;iso-week&apos; THEN [Calculation_1727271206770855970]&#10;END' />
      </column>
      <column caption='1' datatype='integer' name='[Calculation_1727271207157694549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(1)' />
      </column>
      <column caption='Delta Target Color' datatype='integer' name='[Calculation_535506156048736256]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_1727271206797504556] AND [Calculation_1727271206778134569] &gt;= 0 THEN 1&#10;ELSEIF [Calculation_1727271206797504556] AND [Calculation_1727271206778134569] &lt; 0 THEN 0&#10;ELSEIF [Calculation_1727271206798200877] AND [Calculation_1727271206778134569] &lt;= 0 THEN 1&#10;ELSEIF [Calculation_1727271206798200877] AND [Calculation_1727271206778134569] &gt; 0 THEN 0&#10;ELSE 2&#10;END' />
      </column>
      <column caption='WoW% / MoM% Title' datatype='string' name='[Calculation_596304751083278337]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;month&apos; THEN &apos;MoM %&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;iso-week&apos; THEN &apos;WoW %&apos;&#10;END' />
      </column>
      <column caption='Metric Label' datatype='string' name='[Calculation_596304751087984643]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;&#10;    ATTR([metric]) = &quot;csat&quot; OR&#10;    ATTR([metric]) = &quot;rsat&quot; OR&#10;    ATTR([metric]) = &quot;vsat&quot; OR&#10;    ATTR([metric]) = &quot;cs_chat_sla&quot; OR&#10;    ATTR([metric]) = &quot;cs_email_sla&quot; OR&#10;    ATTR([metric]) = &quot;rs_chat_sla&quot; OR&#10;    ATTR([metric]) = &quot;rs_email_sla&quot; OR&#10;    ATTR([metric]) = &quot;vs_chat_sla&quot; OR&#10;    ATTR([metric]) = &quot;vs_email_sla&quot; OR&#10;    ATTR([metric]) = &quot;vs_call_sla&quot; OR&#10;    ATTR([metric]) = &quot;qa_score&quot; OR &#10;    ATTR([metric]) = &quot;automation_csat&quot;&#10;&#10;THEN &apos;Experience&apos;&#10;&#10;ELSEIF&#10;&#10;    ATTR([metric]) = &quot;customer_io&quot; OR&#10;    ATTR([metric]) = &quot;rider_io&quot; OR&#10;    ATTR([metric]) = &quot;vendor_io&quot; OR&#10;    ATTR([metric]) = &quot;crv_io&quot; OR&#10;    ATTR([metric]) = &quot;fail_rate&quot; OR&#10;    ATTR([metric]) = &quot;automation_rate&quot;&#10;&#10;THEN &apos;Efficiency&apos;&#10;&#10;ELSEIF&#10;&#10;    ATTR([metric]) = &quot;wastage_cost&quot; OR&#10;    ATTR([metric]) = &quot;compensation&quot; OR&#10;    ATTR([metric]) = &quot;wastage / gmv&quot; OR&#10;    ATTR([metric]) = &quot;compensation / gmv&quot;&#10;&#10;THEN &apos;Financial&apos;&#10;&#10;ELSEIF&#10;&#9;&#10;    ATTR([metric]) = &quot;dlp&quot; OR&#10;    ATTR([metric]) = &quot;dld&quot; OR&#10;    ATTR([metric]) = &quot;onboarding_days&quot; OR&#10;    CONTAINS(ATTR([metric]), &quot;zombie&quot;)&#10;    &#10;&#10;THEN &apos;Vendor Performance&apos;&#10;&#10;END' />
      </column>
      <column caption='Country Name Filter' datatype='boolean' name='[Calculation_596304752452489223]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Date Level (copy)] = &quot;Pandora&quot; THEN TRUE&#10;ELSEIF [Parameters].[Date Level (copy)] = [country_name] THEN TRUE&#10;ELSEIF [Parameters].[Date Level (copy)] = &quot;Foodpanda&quot; AND STARTSWITH([country_name], &quot;Foodpanda -&quot;) THEN TRUE&#10;ELSEIF [Parameters].[Date Level (copy)] = &quot;Foodora&quot; AND STARTSWITH([country_name], &quot;Foodora -&quot;) THEN TRUE&#10;ELSEIF [Parameters].[Date Level (copy)] = &quot;Yemeksepeti&quot; AND STARTSWITH([country_name], &quot;Yemeksepeti -&quot;) THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Unified Target' datatype='real' name='[Calculation_6477583656200654853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Use this instead of [Target]&#10;&#10;IF [Parameters].[Parameter 2] = &apos;iso-week&apos; AND CONTAINS(ATTR([metric]), &apos;zombie&apos;) THEN&#10;&#10;  CASE [Parameters].[Date Level (copy)]&#10;    WHEN &apos;Pandora&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Pandora&apos; THEN [target] END) })&#10;    WHEN &apos;Foodpanda&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Foodpanda&apos; THEN [target] END) })&#10;    WHEN &apos;Foodora&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Foodora&apos; THEN [target] END) })&#10;    WHEN &apos;Yemeksepeti&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Yemeksepeti&apos; THEN [target] END) })&#10;    ELSE AVG([target])&#10;  END / 4&#10;&#10;ELSE&#10;&#10;  CASE [Parameters].[Date Level (copy)]&#10;    WHEN &apos;Pandora&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Pandora&apos; THEN [target] END) })&#10;    WHEN &apos;Foodpanda&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Foodpanda&apos; THEN [target] END) })&#10;    WHEN &apos;Foodora&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Foodora&apos; THEN [target] END) })&#10;    WHEN &apos;Yemeksepeti&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Yemeksepeti&apos; THEN [target] END) })&#10;    ELSE AVG([target])&#10;  END&#10;&#10;END' />
      </column>
      <column caption='Unified Target Display' datatype='string' name='[Calculation_87538746933575681]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ATTR([metric]) = &quot;onboarding_days&quot; THEN&#10;&#10;    STR(ROUND([Calculation_6477583656200654853], 2))&#10;&#10;ELSEIF ATTR([metric]) = &quot;compensation&quot; OR ATTR([metric]) = &quot;wastage_cost&quot; THEN&#10;&#10;    &quot;€&quot; + &#10;    IF LEN(STR(INT(ROUND([Calculation_6477583656200654853], 0)))) &lt;= 3 THEN&#10;        STR(INT(ROUND([Calculation_6477583656200654853], 0)))&#10;&#10;    ELSEIF LEN(STR(INT(ROUND([Calculation_6477583656200654853], 0)))) &lt;= 6 THEN&#10;        LEFT(STR(INT(ROUND([Calculation_6477583656200654853], 0))), LEN(STR(INT(ROUND([Calculation_6477583656200654853], 0)))) - 3) + &quot;,&quot; +&#10;        RIGHT(STR(INT(ROUND([Calculation_6477583656200654853], 0))), 3)&#10;&#10;    ELSE&#10;        LEFT(STR(INT(ROUND([Calculation_6477583656200654853], 0))), LEN(STR(INT(ROUND([Calculation_6477583656200654853], 0)))) - 6) + &quot;,&quot; +&#10;        MID(STR(INT(ROUND([Calculation_6477583656200654853], 0))), LEN(STR(INT(ROUND([Calculation_6477583656200654853], 0)))) - 5, 3) + &quot;,&quot; +&#10;        RIGHT(STR(INT(ROUND([Calculation_6477583656200654853], 0))), 3)&#10;&#10;    END&#10;&#10;ELSEIF CONTAINS(ATTR([metric]), &quot;zombie&quot;) THEN&#10;&#10;    IF LEN(STR(INT(ROUND([Calculation_6477583656200654853], 0)))) &lt;= 3 THEN&#10;        STR(INT(ROUND([Calculation_6477583656200654853], 0)))&#10;&#10;    ELSEIF LEN(STR(INT(ROUND([Calculation_6477583656200654853], 0)))) &lt;= 6 THEN&#10;        LEFT(STR(INT(ROUND([Calculation_6477583656200654853], 0))), LEN(STR(INT(ROUND([Calculation_6477583656200654853], 0)))) - 3) + &quot;,&quot; +&#10;        RIGHT(STR(INT(ROUND([Calculation_6477583656200654853], 0))), 3)&#10;&#10;    ELSE&#10;        LEFT(STR(INT(ROUND([Calculation_6477583656200654853], 0))), LEN(STR(INT(ROUND([Calculation_6477583656200654853], 0)))) - 6) + &quot;,&quot; +&#10;        MID(STR(INT(ROUND([Calculation_6477583656200654853], 0))), LEN(STR(INT(ROUND([Calculation_6477583656200654853], 0)))) - 5, 3) + &quot;,&quot; +&#10;        RIGHT(STR(INT(ROUND([Calculation_6477583656200654853], 0))), 3)&#10;&#10;    END&#10;&#10;ELSE&#10;&#10;    STR(ROUND([Calculation_6477583656200654853], 2)) + &quot;%&quot;&#10;&#10;END' />
      </column>
      <column caption='Numerator Tooltip' datatype='real' name='[Calculation_87538746937675778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;iso-week&apos; AND CONTAINS([metric], &apos;zombie&apos;) THEN NULL&#10;ELSE [numerator]&#10;END' />
      </column>
      <column caption='Denominator Tooltip' datatype='real' name='[Calculation_87538746938822659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;month&apos; AND CONTAINS([metric], &apos;zombie&apos;) THEN NULL&#10;ELSE [denominator]&#10;END' />
      </column>
      <column caption='Latest Available Date' datatype='string' name='[Calculation_87538746943561732]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;Latest Available Date: &quot; + STR(MAX([report_date]))' />
      </column>
      <column caption='Numerator Metric Tooltip' datatype='string' name='[Calculation_9016769425713811456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [metric] = &apos;csat&apos; THEN &apos;Total Customer Promotors:&apos;&#10;ELSEIF [metric] = &apos;rsat&apos; THEN &apos;Total Rider Promotors:&apos;&#10;ELSEIF [metric] = &apos;vsat&apos; THEN &apos;Total Vendor Promotors:&apos;&#10;&#10;ELSEIF [metric] = &apos;cs_chat_sla&apos; THEN &apos;Total Customer 30s Chats:&apos;&#10;ELSEIF [metric] = &apos;cs_email_sla&apos; THEN &apos;Total Customer 24h Emails:&apos;&#10;&#10;ELSEIF [metric] = &apos;rs_chat_sla&apos; THEN &apos;Total Rider 30s Chats:&apos;&#10;ELSEIF [metric] = &apos;rs_email_sla&apos; THEN &apos;Total Rider 24h Emails:&apos;&#10;&#10;ELSEIF [metric] = &apos;vs_chat_sla&apos; THEN &apos;Total Vendor 30s Chats:&apos;&#10;ELSEIF [metric] = &apos;vs_email_sla&apos; THEN &apos;Total Vendor 24h Emails:&apos;&#10;ELSEIF [metric] = &apos;vs_call_sla&apos; THEN &apos;Total Vendor 30s Calls:&apos;&#10;&#10;ELSEIF [metric] = &apos;dlp&apos; THEN &apos;Total Products With Image:&apos;&#10;ELSEIF [metric] = &apos;dld&apos; THEN &apos;Total Products With Description:&apos;&#10;ELSEIF [metric] = &apos;qa_score&apos; THEN &apos;Total QA Score:&apos;&#10;ELSEIF [metric] = &apos;automation_csat&apos; THEN &apos;Total Automation Customer Promoters:&apos;&#10;&#10;ELSEIF [metric] = &apos;customer_io&apos; THEN &apos;Total Customer Incidents:&apos;&#10;ELSEIF [metric] = &apos;rider_io&apos; THEN &apos;Total Rider Incidents:&apos;&#10;ELSEIF [metric] = &apos;vendor_io&apos; THEN &apos;Total Vendor Incidents:&apos;&#10;ELSEIF [metric] = &apos;crv_io&apos; THEN &apos;Total Incidents:&apos;&#10;&#10;ELSEIF [metric] = &apos;fail_rate&apos; THEN &apos;Total Cancelled Orders:&apos;&#10;ELSEIF [metric] = &apos;onboarding_days&apos; THEN &apos;Total Onboarding Days:&apos;&#10;&#10;ELSEIF [metric] = &apos;automation_rate&apos; THEN &apos;Automation Rate Numerator:&apos;&#10;ELSEIF [metric] = &apos;wastage_cost&apos; OR [metric] = &apos;wastage / gmv&apos; THEN &apos;Wastage Cost:&apos;&#10;ELSEIF [metric] = &apos;compensation&apos; OR [metric] = &apos;compensation / gmv&apos; THEN &apos;Compensation Cost:&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;month&apos; AND [metric] = &apos;non_managed_zombies_formed&apos; THEN &apos;Non Managed Zombies Formed:&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;month&apos; AND [metric] = &apos;non_managed_zombies_revived&apos; THEN &apos;Non Managed Zombies Revived:&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;month&apos; AND [metric] = &apos;managed_zombies_formed&apos; THEN &apos;Managed Zombies Formed:&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;month&apos; AND [metric] = &apos;managed_zombies_revived&apos; THEN &apos;Managed Zombies Revived:&apos;&#10;&#10;END' />
      </column>
      <column caption='Denominator Metric Tooltip' datatype='string' name='[Calculation_9016769425714089985]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [metric] = &apos;csat&apos; THEN &apos;Total Customer Responses:&apos;&#10;ELSEIF [metric] = &apos;rsat&apos; THEN &apos;Total Rider Responses:&apos;&#10;ELSEIF [metric] = &apos;vsat&apos; THEN &apos;Total Vendor Responses:&apos;&#10;&#10;ELSEIF [metric] = &apos;cs_chat_sla&apos; THEN &apos;Total Customer Chats:&apos;&#10;ELSEIF [metric] = &apos;cs_email_sla&apos; THEN &apos;Total Customer Emails:&apos;&#10;ELSEIF [metric] = &apos;rs_chat_sla&apos; THEN &apos;Total Rider Chats:&apos;&#10;ELSEIF [metric] = &apos;rs_email_sla&apos; THEN &apos;Total Rider Emails:&apos;&#10;ELSEIF [metric] = &apos;vs_chat_sla&apos; THEN &apos;Total Vendor Chats:&apos;&#10;ELSEIF [metric] = &apos;vs_email_sla&apos; THEN &apos;Total Vendor Emails:&apos;&#10;ELSEIF [metric] = &apos;vs_call_sla&apos; THEN &apos;Total Vendor Calls:&apos;&#10;&#10;ELSEIF [metric] = &apos;dlp&apos; OR [metric] = &apos;dld&apos; THEN &apos;Total Products:&apos;&#10;ELSEIF [metric] = &apos;qa_score&apos; THEN &apos;Total Evaluations:&apos;&#10;ELSEIF [metric] = &apos;automation_csat&apos; THEN &apos;Total Automation Customer Responses:&apos;&#10;&#10;ELSEIF [metric] = &apos;customer_io&apos; &#10;    OR [metric] = &apos;rider_io&apos; &#10;    OR [metric] = &apos;vendor_io&apos; &#10;    OR [metric] = &apos;crv_io&apos; &#10;    OR [metric] = &apos;fail_rate&apos; THEN &apos;Total Orders:&apos;&#10;&#10;ELSEIF [metric] = &apos;onboarding_days&apos; THEN &apos;Total Onboarded Vendors:&apos;&#10;ELSEIF [metric] = &apos;automation_rate&apos; THEN &apos;Automation Rate Denominator:&apos;&#10;&#10;ELSEIF [metric] = &apos;wastage / gmv&apos; OR [metric] = &apos;compensation / gmv&apos; THEN &apos;Gross Merchandise Value:&apos;&#10;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;iso-week&apos; AND [metric] = &apos;non_managed_zombies_formed&apos; THEN &apos;Non Managed Zombies Formed:&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;iso-week&apos; AND [metric] = &apos;non_managed_zombies_revived&apos; THEN &apos;Non Managed Zombies Revived:&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;iso-week&apos; AND [metric] = &apos;managed_zombies_formed&apos; THEN &apos;Managed Zombies Formed:&apos;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;iso-week&apos; AND [metric] = &apos;managed_zombies_revived&apos; THEN &apos;Managed Zombies Revived:&apos;&#10;&#10;END' />
      </column>
