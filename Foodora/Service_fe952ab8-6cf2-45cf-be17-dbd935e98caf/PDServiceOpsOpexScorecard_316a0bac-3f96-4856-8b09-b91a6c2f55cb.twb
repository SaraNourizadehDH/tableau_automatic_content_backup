            </column>
            <column caption='Is Lower Better' datatype='boolean' name='[Calculation_1727271206798200877]' role='measure' type='nominal'>
              <calculation class='tableau' formula='ATTR([metric]) = &quot;customer_io&quot; OR&#10;ATTR([metric]) = &quot;rider_io&quot; OR&#10;ATTR([metric]) = &quot;vendor_io&quot; OR&#10;ATTR([metric]) = &quot;crv_io&quot; OR&#10;ATTR([metric]) = &quot;fail_rate&quot; OR&#10;ATTR([metric]) = &quot;onboarding_days&quot; OR&#10;ATTR([metric]) = &quot;wastage_cost&quot; OR&#10;ATTR([metric]) = &quot;compensation&quot; OR&#10;ATTR([metric]) = &quot;wastage / gmv&quot; OR&#10;ATTR([metric]) = &quot;compensation / gmv&quot; OR&#10;ATTR([metric]) = &quot;non_managed_zombies_formed&quot; OR&#10;ATTR([metric]) = &quot;managed_zombies_formed&quot;' />
            </column>
            <column caption='Report Week' datatype='date' name='[Calculation_1727271206831374389]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;iso-week&apos;, [report_date]))' />
            </column>
            <column caption='This Month' datatype='string' name='[Calculation_1727271206854406206]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] THEN &quot;this month&quot; ELSE &quot;last month&quot; END' />
            </column>
            <column caption='Delta Target Color' datatype='integer' name='[Calculation_535506156048736256]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_1727271206797504556] AND [Calculation_1727271206778134569] &gt;= 0 THEN 1&#10;ELSEIF [Calculation_1727271206797504556] AND [Calculation_1727271206778134569] &lt; 0 THEN 0&#10;ELSEIF [Calculation_1727271206798200877] AND [Calculation_1727271206778134569] &lt;= 0 THEN 1&#10;ELSEIF [Calculation_1727271206798200877] AND [Calculation_1727271206778134569] &gt; 0 THEN 0&#10;ELSE 2&#10;END' />
            </column>
            <column caption='Country Name Filter' datatype='boolean' name='[Calculation_596304752452489223]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Date Level (copy)] = &quot;Pandora&quot; THEN TRUE&#10;ELSEIF [Parameters].[Date Level (copy)] = [country_name] THEN TRUE&#10;ELSEIF [Parameters].[Date Level (copy)] = &quot;Foodpanda&quot; AND STARTSWITH([country_name], &quot;Foodpanda -&quot;) THEN TRUE&#10;ELSEIF [Parameters].[Date Level (copy)] = &quot;Foodora&quot; AND STARTSWITH([country_name], &quot;Foodora -&quot;) THEN TRUE&#10;ELSEIF [Parameters].[Date Level (copy)] = &quot;Yemeksepeti&quot; AND STARTSWITH([country_name], &quot;Yemeksepeti -&quot;) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Unified Target' datatype='real' name='[Calculation_6477583656200654853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Use this instead of [Target]&#10;&#10;IF [Parameters].[Parameter 2] = &apos;iso-week&apos; AND CONTAINS(ATTR([metric]), &apos;zombie&apos;) THEN&#10;&#10;  CASE [Parameters].[Date Level (copy)]&#10;    WHEN &apos;Pandora&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Pandora&apos; THEN [target] END) })&#10;    WHEN &apos;Foodpanda&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Foodpanda&apos; THEN [target] END) })&#10;    WHEN &apos;Foodora&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Foodora&apos; THEN [target] END) })&#10;    WHEN &apos;Yemeksepeti&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Yemeksepeti&apos; THEN [target] END) })&#10;    ELSE AVG([target])&#10;  END / 4&#10;&#10;ELSE&#10;&#10;  CASE [Parameters].[Date Level (copy)]&#10;    WHEN &apos;Pandora&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Pandora&apos; THEN [target] END) })&#10;    WHEN &apos;Foodpanda&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Foodpanda&apos; THEN [target] END) })&#10;    WHEN &apos;Foodora&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Foodora&apos; THEN [target] END) })&#10;    WHEN &apos;Yemeksepeti&apos; THEN AVG({ FIXED [metric] : MAX(IF [country_name] = &apos;Yemeksepeti&apos; THEN [target] END) })&#10;    ELSE AVG([target])&#10;  END&#10;&#10;END' />
