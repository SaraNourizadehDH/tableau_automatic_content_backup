      <column caption='Metric Label 2' datatype='string' name='[Label Metric (copy)_596304751116263428]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#10;&#10;[Calculation_596304751087984643] = &apos;Experience&apos;&#10;&#10;THEN &apos;Strengthen Customer Relations&apos;&#10;&#10;ELSEIF&#10;&#10;[Calculation_596304751087984643] = &apos;Efficiency&apos;&#10;&#10;THEN &apos;Increase Seamless Deliveries&apos;&#10;&#10;ELSEIF&#10;&#10;[Calculation_596304751087984643] = &apos;Financial&apos;&#10;&#10;THEN &apos;Strengthen Financial Sustainability&apos;&#10;&#10;ELSEIF&#10;&#10;[Calculation_596304751087984643] = &apos;Vendor Performance&apos;&#10;&#10;THEN &apos;Improve Vendor Engagement&apos;&#10;&#10;END' />
      </column>
      <column caption='Metric 1 Color' datatype='integer' name='[Metric 1  (copy)_1727271207155794003]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_1727271206797504556] AND [Calculation_1727271206857486405] &gt; 0 THEN 1&#10;ELSEIF [Calculation_1727271206798200877] AND [Calculation_1727271206857486405] &lt; 0 THEN 1&#10;ELSEIF [Calculation_1727271206857486405] = 0 THEN 2&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Metric 2 Color' datatype='integer' name='[Metric 2 (copy)_1727271207155802196]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_1727271206797504556] AND [Calculation_1727271206857695302] &gt; 0 THEN 1&#10;ELSEIF [Calculation_1727271206798200877] AND [Calculation_1727271206857695302] &lt; 0 THEN 1&#10;ELSEIF [Calculation_1727271206857695302] = 0 THEN 2&#10;ELSE 0&#10;END' />
      </column>
      <column caption='WoW% Change' datatype='real' name='[MoM% Change (copy)_1727271206857175108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([metric]) = &quot;qa_score&quot; THEN&#10;&#10;    (&#10;        (&#10;            SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] THEN [numerator] END) /&#10;            SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] THEN [denominator] END) / 100&#10;        ) /&#10;        (&#10;            SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy) (copy)_1727271206855139394] THEN [numerator] END) /&#10;            SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy) (copy)_1727271206855139394] THEN [denominator] END) / 100&#10;        )&#10;    ) - 1&#10;&#10;    ELSEIF ATTR([metric]) = &quot;compensation&quot; &#10;        OR ATTR([metric]) = &quot;wastage_cost&quot; THEN&#10;&#10;    (&#10;        SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] THEN [numerator] END) /&#10;        SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy) (copy)_1727271206855139394] THEN [numerator] END)&#10;    ) - 1&#10;&#10;    ELSEIF CONTAINS(ATTR([metric]), &quot;zombie&quot;) THEN&#10;&#10;    (&#10;        SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] THEN [denominator] END) /&#10;        SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy) (copy)_1727271206855139394] THEN [denominator] END)&#10;    ) - 1&#10;&#10;ELSE&#10;&#10;    (&#10;        (&#10;            SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] THEN [numerator] END) /&#10;            SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] THEN [denominator] END)&#10;        ) /&#10;        (&#10;            SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy) (copy)_1727271206855139394] THEN [numerator] END) /&#10;            SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy) (copy)_1727271206855139394] THEN [denominator] END)&#10;        )&#10;    ) - 1&#10;&#10;END' />
      </column>
      <column caption='YoY% Change' datatype='real' name='[Mom% Change (copy)_1727271206776270887]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([metric]) = &quot;qa_score&quot; THEN&#10;&#10;    (&#10;        (&#10;            SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] THEN [numerator] END) /&#10;            SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] THEN [denominator] END) /&#10;            100&#10;        ) /&#10;        (&#10;            SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy)_1727271206855123008] THEN [numerator] END) /&#10;            SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy)_1727271206855123008] THEN [denominator] END) /&#10;            100&#10;        )&#10;    ) - 1&#10;&#10;    ELSEIF ATTR([metric]) = &quot;compensation&quot; &#10;        OR ATTR([metric]) = &quot;wastage_cost&quot; &#10;        OR CONTAINS(ATTR([metric]), &quot;zombie&quot;) THEN&#10;&#10;    (&#10;        SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] THEN [numerator] END) /&#10;        SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy)_1727271206855123008] THEN [numerator] END)&#10;    ) - 1&#10;&#10;ELSE&#10;&#10;    (&#10;        (&#10;            SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] THEN [numerator] END) /&#10;            SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] THEN [denominator] END)&#10;        ) /&#10;        (&#10;            SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy)_1727271206855123008] THEN [numerator] END) /&#10;            SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy)_1727271206855123008] THEN [denominator] END)&#10;        )&#10;    ) - 1&#10;&#10;END' />
      </column>
