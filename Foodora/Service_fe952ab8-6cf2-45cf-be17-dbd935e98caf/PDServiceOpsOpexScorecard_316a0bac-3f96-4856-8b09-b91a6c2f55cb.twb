      <table>
        <view>
          <datasources>
            <datasource caption='service_operations__opex_scorecard_daily' name='federated.156nyab0r64hxd1g3crtv1dx2xbj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Country Name Logic' datatype='string' name='[Date Level (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Pandora&quot;'>
              <calculation class='tableau' formula='&quot;Pandora&quot;' />
            </column>
            <column caption='To Date' datatype='boolean' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
            <column alias='Month' caption='Date Level' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;iso-week&quot;' value='Week' />
                <alias key='&quot;month&quot;' value='Month' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.156nyab0r64hxd1g3crtv1dx2xbj'>
            <column caption='This Week' datatype='string' name='[COOKING Current Month (copy) (copy)_1727271206855131201]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] THEN &quot;this week&quot; ELSE &quot;last week&quot; END' />
            </column>
            <column caption='Report Month' datatype='date' name='[Calculation_1727271206438055936]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [report_date]))' />
            </column>
            <column caption='Date Measures' datatype='string' name='[Calculation_1727271206748532764]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;month&apos; THEN &#10;    CASE [Calculation_1727271206438055936]&#10;&#10;&#10;        WHEN DATETRUNC(&apos;month&apos;, TODAY()) THEN &quot;this month&quot;&#10;        WHEN DATEADD(&quot;month&quot;, -1, DATETRUNC(&apos;month&apos;, TODAY())) THEN &quot;last month&quot;&#10;        WHEN DATEADD(&quot;month&quot;, -2, DATETRUNC(&apos;month&apos;, TODAY())) THEN &quot;last last month&quot;&#10;        WHEN DATEADD(&quot;month&quot;, -12, DATETRUNC(&apos;month&apos;, TODAY())) THEN &quot;last year&quot;&#10;        WHEN DATEADD(&quot;month&quot;, -13, DATETRUNC(&apos;month&apos;, TODAY())) THEN &quot;last year last month&quot;&#10;    &#10;    END&#10;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;iso-week&apos; THEN &#10;&#10;    IF [Calculation_1727271206831374389] = DATETRUNC(&apos;iso-week&apos;, TODAY()) THEN &quot;this week&quot;&#10;    ELSEIF [Calculation_1727271206831374389] = DATEADD(&quot;iso-week&quot;, -1, DATETRUNC(&apos;iso-week&apos;, TODAY())) THEN &quot;last week&quot;&#10;    ELSEIF [Calculation_1727271206831374389] = DATEADD(&quot;iso-week&quot;, -2, DATETRUNC(&apos;iso-week&apos;, TODAY())) THEN &quot;last last week&quot;&#10;    // IF [Report Month] = DATETRUNC(&apos;month&apos;, TODAY()) THEN &quot;this month&quot; END&#10;    // this cannot be used because overlaps with &apos;this week&apos;, &apos;last week&apos;, and &apos;last last week&apos;&#10;    ELSEIF [Calculation_1727271206438055936] = DATEADD(&quot;month&quot;, -1, DATETRUNC(&apos;month&apos;, TODAY())) THEN &quot;last month&quot;&#10;    ELSEIF [Calculation_1727271206438055936] = DATEADD(&quot;month&quot;, -2, DATETRUNC(&apos;month&apos;, TODAY())) THEN &quot;last last month&quot;&#10;    END&#10;    &#10;END' />
            </column>
            <column caption='To Date Filter' datatype='boolean' name='[Calculation_1727271206754816031]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] &lt;=&#10;IF [Parameters].[Parameter 2]=&apos;month&apos; THEN&#10;    IF NOT [Parameters].[Parameter 1] THEN&#10;        DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))  // end of last month&#10;    ELSE&#10;        TODAY()  // current date&#10;    END&#10;ELSEIF [Parameters].[Parameter 2]=&apos;iso-week&apos; THEN&#10;    IF NOT [Parameters].[Parameter 1] THEN&#10;        DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;iso-week&apos;, TODAY()))  // end of last week&#10;    ELSE&#10;        TODAY()  // current date&#10;    END&#10;END' />
            </column>
            <column caption='Delta Target' datatype='real' name='[Calculation_1727271206778134569]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF ATTR([metric]) = &apos;non_managed_zombies_revived&apos;&#10;    OR ATTR([metric]) = &apos;non_managed_zombies_formed&apos;&#10;    OR ATTR([metric]) = &apos;managed_zombies_revived&apos;&#10;    OR ATTR([metric]) = &apos;managed_zombies_formed&apos;&#10;    OR ATTR([metric]) = &apos;onboarding_days&apos; THEN&#10;&#10;    [Calculation_1727271206787743786] - [Calculation_6477583656200654853]&#10;&#10;ELSE&#10;&#10;    ROUND(([Calculation_1727271206787743786] * 100) - [Calculation_6477583656200654853],2)&#10;&#10;END' />
            </column>
            <column caption='Current Month/Week Score Value' datatype='real' name='[Calculation_1727271206787743786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;month&apos; THEN&#10;&#10;    IF ATTR([metric]) = &apos;qa_score&apos;&#10;        THEN SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] AND [Calculation_596304752452489223] THEN [numerator] END) /&#10;             SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] AND [Calculation_596304752452489223] THEN [denominator] END) / 100&#10;&#10;    ELSEIF ATTR([metric]) = &apos;compensation&apos;&#10;        OR ATTR([metric]) = &apos;wastage_cost&apos;&#10;      THEN SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] AND [Calculation_596304752452489223] THEN [numerator] END)&#10;&#10;    ELSEIF CONTAINS(ATTR([metric]), &apos;zombie&apos;)&#10;      THEN SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] AND [Calculation_596304752452489223] THEN [numerator] END)&#10;&#10;    ELSE SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] AND [Calculation_596304752452489223] THEN [numerator] END) /&#10;         SUM(IF [Calculation_1727271206748532764] = [Calculation_1727271206854406206] AND [Calculation_596304752452489223] THEN [denominator] END) &#10;    END&#10;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;iso-week&apos; THEN&#10;&#10;    IF ATTR([metric]) = &apos;qa_score&apos;&#10;        THEN SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] AND [Calculation_596304752452489223] THEN [numerator] END) /&#10;             SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] AND [Calculation_596304752452489223] THEN [denominator] END) / 100&#10;&#10;    ELSEIF ATTR([metric]) = &apos;compensation&apos;&#10;        OR ATTR([metric]) = &apos;wastage_cost&apos;&#10;      THEN SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] AND [Calculation_596304752452489223] THEN [numerator] END)&#10;&#10;    ELSEIF CONTAINS(ATTR([metric]), &apos;zombie&apos;)&#10;      THEN SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] AND [Calculation_596304752452489223] THEN [denominator] END)&#10;&#10;    ELSE SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] AND [Calculation_596304752452489223] THEN [numerator] END) /&#10;         SUM(IF [Calculation_1727271206748532764] = [COOKING Current Month (copy) (copy)_1727271206855131201] AND [Calculation_596304752452489223] THEN [denominator] END) &#10;    END&#10;&#10;END' />
