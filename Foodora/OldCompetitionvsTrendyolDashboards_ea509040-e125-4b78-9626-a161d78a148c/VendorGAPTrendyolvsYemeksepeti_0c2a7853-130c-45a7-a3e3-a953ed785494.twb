      <aliases enabled='yes' />
      <column caption='multiplier' datatype='integer' name='[Calculation_1727834177208344576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [growth] IN (&apos;YS Churn&apos;,&apos;New in Competition&apos;, &apos;Win Back in Competition&apos;) THEN 1 &#10;ELSEIF [growth] IN (&apos;YS Signing&apos;,&apos;Lost in Competition&apos;, &apos;Manuel Adjustment&apos;) THEN -1 &#10;  END' />
      </column>
      <column caption='multipler_count_gap_vendor' datatype='integer' name='[Calculation_1727834177208508417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_only_trendyol] = &apos;Yes&apos;  THEN ID  END)* ATTR([Calculation_1727834177208344576])' />
      </column>
      <column caption='max_insert_date' datatype='date' name='[Calculation_2255107178033094656]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([InsertDate])' />
      </column>
      <column caption='vendor_count' datatype='integer' name='[Calculation_362328696772505601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([ID])' />
      </column>
      <column caption='missing_vendor_count' datatype='integer' name='[Calculation_915075181566226432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_only_trendyol] = &apos;Yes&apos;  THEN ID  END)&#10;&#10;&#10;&#10;//COUNTD(IF [Is Already In YS]=0 and [Is Matched From Big Omlet]=0 and [Is Closed In TY]=0 AND [Is Not Listed In TY]=0 AND [Is ABC Typed]=1 AND [IsInODZone]=1 THEN ID END)' />
      </column>
      <column caption='matched_vendors_count' datatype='integer' name='[Calculation_915075181572440065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [IsAlreadyInYS]=1 OR [IsMatchedFromBigOmlet]=1 THEN ID END)' />
      </column>
      <column caption='City Group' datatype='string' name='[Calculation_915075181582307330]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [VendorCity] = &apos;Ankara&apos; Then &apos;Capital&apos;&#10;ELSEIF  [VendorCity] in (&apos;İzmir&apos;, &apos;İstanbul&apos;, &apos;Bursa&apos;, &apos;Antalya&apos;) Then &apos;Top 5&apos;&#10;ElSE &apos;Rest Of Country&apos; END' />
      </column>
