      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gap_trendyol_ys (shared_yemek)' name='federated.1erg17n1kftg0b1efwivt17n0ub6' />
          </datasources>
          <datasource-dependencies datasource='federated.1erg17n1kftg0b1efwivt17n0ub6'>
            <column caption='missing_vendor_count' datatype='integer' name='[Calculation_915075181566226432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_only_trendyol] = &apos;Yes&apos;  THEN ID  END)&#10;&#10;&#10;&#10;//COUNTD(IF [Is Already In YS]=0 and [Is Matched From Big Omlet]=0 and [Is Closed In TY]=0 AND [Is Not Listed In TY]=0 AND [Is ABC Typed]=1 AND [IsInODZone]=1 THEN ID END)' />
            </column>
            <column caption='City Group' datatype='string' name='[Calculation_915075181582307330]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [VendorCity] = &apos;Ankara&apos; Then &apos;Capital&apos;&#10;ELSEIF  [VendorCity] in (&apos;İzmir&apos;, &apos;İstanbul&apos;, &apos;Bursa&apos;, &apos;Antalya&apos;) Then &apos;Top 5&apos;&#10;ElSE &apos;Rest Of Country&apos; END' />
            </column>
            <column datatype='string' name='[ID]' role='dimension' type='nominal' />
            <column caption='Insert Date' datatype='date' name='[InsertDate]' role='dimension' type='ordinal' />
            <column caption='Is ABC Typed' datatype='string' datatype-customized='true' default-role='measure' default-type='quantitative' name='[IsABCTyped]' role='dimension' type='nominal' />
            <column caption='Is In OD Zone' datatype='string' datatype-customized='true' default-role='measure' default-type='quantitative' name='[IsInODZone]' role='dimension' type='nominal' />
