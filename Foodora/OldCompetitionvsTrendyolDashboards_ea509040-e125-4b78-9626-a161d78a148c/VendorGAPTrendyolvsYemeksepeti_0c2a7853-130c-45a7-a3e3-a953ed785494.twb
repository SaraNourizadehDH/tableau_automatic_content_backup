            <column caption='Vendor City' datatype='string' name='[VendorCity]' role='dimension' type='nominal' />
            <column caption='Is Only Trendyol' datatype='string' name='[is_only_trendyol]' role='dimension' type='nominal' />
            <column-instance column='[InsertDate]' derivation='MDY' name='[md:InsertDate:ok]' pivot='key' type='ordinal' />
