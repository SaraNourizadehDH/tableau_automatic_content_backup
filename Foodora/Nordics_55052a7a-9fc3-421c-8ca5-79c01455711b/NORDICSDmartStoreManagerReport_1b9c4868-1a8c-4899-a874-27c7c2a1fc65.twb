    <worksheet name='Weekly Store Overview Prep'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial' fontsize='10'>Weekly Store Overview &lt;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial' fontsize='10'>[federated.04g8j6z0navb331cr7gfl0ibcrb0].[attr:report_week:nk]</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial' fontsize='10'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='report_dmart_store_manager (bl_bi)' name='federated.04g8j6z0navb331cr7gfl0ibcrb0' />
          </datasources>
          <datasource-dependencies datasource='federated.04g8j6z0navb331cr7gfl0ibcrb0'>
            <column caption='Complaints - Wrong/Missing Item  (%)' datatype='real' name='[% Complaints (copy)_236720459544268801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_complaints_wrong_missing_item])/SUM([gross_orders])' />
            </column>
            <column caption='Shrinkage - Visible (%)' datatype='real' name='[% Shrinkage (copy)_1926133269460910093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrinkage_visible_wac])&#13;&#10;/SUM(IFNULL([shrinkage_visible_wac],0)+IFNULL([delivered_qty_wac],0))' />
            </column>
            <column caption='Unavailable (%)' datatype='real' name='[% Shrinkage (copy)_1926133269461635088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unavailable_mins])/SUM([scheduled_mins])' />
            </column>
            <column caption='Shrinkage - Invisible (%)' datatype='real' name='[% Shrinkage - Visible (copy)_1926133269460971534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrinkage_invisible_wac])&#13;&#10;/SUM(IFNULL([shrinkage_invisible_wac],0)+IFNULL([delivered_qty_wac],0))' />
            </column>
            <column caption='Unavailable - Top 200 (%)' datatype='real' name='[% Unavailable (copy)_1926133269461696529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unavailable_mins_200])/SUM([scheduled_mins_200])' />
            </column>
            <column caption='Avg. Dmart Late (minute)' datatype='integer' name='[Avg. Dmart Late (copy)_3409717506338680832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOOR([Calculation_1926133269519323161])' />
            </column>
            <column caption='Avg. Picking Time (minute)' datatype='integer' name='[Avg. Picking Time (m) (copy)_4757067849358467072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOOR([Calculation_1926133269439025155])' />
            </column>
            <column caption='Avg. Dmart Late (min.s)' datatype='real' name='[Avg. Picking Time (min.s) (copy)_3409717506339168258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. Picking Time (seconds) (copy)_3409717506338914305] + [Avg. Dmart Late (copy)_3409717506338680832]' />
            </column>
            <column caption='Avg. Picking Time (seconds)' datatype='real' name='[Avg. Picking Time (minute) (copy)_4757067849358843906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOOR(([Calculation_1926133269439025155] - [Avg. Picking Time (m) (copy)_4757067849358467072])*60)/100' />
            </column>
            <column caption='Avg. Dmart Late (seconds)' datatype='real' name='[Avg. Picking Time (seconds) (copy)_3409717506338914305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOOR(([Calculation_1926133269519323161] - [Avg. Dmart Late (copy)_3409717506338680832])*60)/100' />
            </column>
            <column caption='Avg. Picking Time (min.s)' datatype='real' name='[Avg. Picking Time (seconds) (copy)_4757067849359118339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. Picking Time (m) (copy)_4757067849358467072] + [Avg. Picking Time (minute) (copy)_4757067849358843906]' />
            </column>
            <column caption='Orders ' datatype='integer' name='[Calculation_1926133269437591552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders]' />
            </column>
            <column caption='WoW (%)' datatype='real' name='[Calculation_1926133269437644801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([orders_pw])-1' />
            </column>
            <column caption='Avg. Picking Time (m)' datatype='real' name='[Calculation_1926133269439025155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([seconds_picking_time]/60)/SUM([orders_with_picking_times])' />
            </column>
            <column caption='Picker Order UTR' datatype='real' name='[Calculation_1926133269439307780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [worked_hours] &gt; 0 THEN [orders_delivered] END)/SUM([Calculation_1926133269457960969])' />
            </column>
            <column caption='Incomplete Orders (%)' datatype='real' name='[Calculation_1926133269439463429]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_missing_quantity])/SUM([orders_delivered])' />
            </column>
            <column caption='Worked Hours ' datatype='real' name='[Calculation_1926133269457960969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[worked_hours]' />
            </column>
            <column caption='Incomplete Orders' datatype='integer' name='[Calculation_1926133269460451338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_missing_quantity]' />
            </column>
            <column caption='Order Late &gt; 10 Mins (%)' datatype='real' name='[Calculation_1926133269460566027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delay_cnt10])/SUM([delay_obs])' />
            </column>
            <column caption='Shrinkage (%)' datatype='real' name='[Calculation_1926133269460795404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrinkage_wac])&#13;&#10;/SUM(IFNULL([shrinkage_wac],0)+IFNULL([delivered_qty_wac],0))' />
            </column>
            <column caption='SKUs Counted' datatype='integer' name='[Calculation_1926133269503262739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[skus_counted]' />
            </column>
            <column caption='SKU Defect Rate (%)' datatype='real' name='[Calculation_1926133269503332372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([skus_counted_diff])/SUM([skus_counted])' />
            </column>
            <column caption='Total Units' datatype='integer' name='[Calculation_1926133269503672341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_units]' />
            </column>
            <column caption='Item Level Defect Rate (%)' datatype='real' name='[Calculation_1926133269503770646]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_units_diff_abs])/SUM([total_units])' />
            </column>
            <column caption='Avg. Dmart Late' datatype='real' name='[Calculation_1926133269519323161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_mins])/SUM([vendor_late_obs])' />
            </column>
            <column caption='Dmart Late &gt; 10 Mins (%)' datatype='real' name='[Calculation_1926133269519585306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_count10])/SUM([vendor_late_obs])' />
            </column>
            <column caption='Week Null Exclude' datatype='string' name='[Calculation_236720459589898242]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_week_last]' />
            </column>
            <column caption='Complaints - Wrong/Missing Item of Total Complaints (%)' datatype='real' name='[Complaints - Wrong/Missing Item  (%) (copy)_830491931641397248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_complaints_wrong_missing_item])/SUM([orders_complaints])' />
            </column>
            <column-instance column='[report_week]' derivation='Attribute' name='[attr:report_week:nk]' pivot='key' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delay Cnt10' datatype='integer' name='[delay_cnt10]' role='measure' type='quantitative' />
