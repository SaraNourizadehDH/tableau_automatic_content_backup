            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1aw2yf80441os91djjnsu12lwxf0'>
            <column caption='Orders CP' datatype='integer' name='[Calculation_3096224781501345796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = [created_week]&#10;THEN [orders]&#10;END' />
            </column>
            <column caption='Max Week' datatype='date' name='[Calculation_5423248808850444288]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([created_week])}' />
            </column>
            <column caption='Max Week -7' datatype='date' name='[Calculation_5423248808850550785]' role='dimension' type='ordinal'>
