            </column>
            <column caption='avg_sf_wolt_eur_PP' datatype='real' name='[avg_sf_wolt_eur_CP (copy)_3096224781512458271]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sf_wolt_eur_CP (copy)_3096224781512032283]) / SUM([Orders CP (copy)_3096224781501865990])' />
