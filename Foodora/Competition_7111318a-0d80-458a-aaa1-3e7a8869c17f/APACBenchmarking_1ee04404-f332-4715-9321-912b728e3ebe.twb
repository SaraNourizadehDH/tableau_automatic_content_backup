            <column caption='Max Week -7' datatype='date' name='[Calculation_5423248808850550785]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([created_week])-7}' />
            </column>
            <column caption='City Top 1' datatype='string' name='[City Top 1 Filter (copy)_3862470038199402497]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
