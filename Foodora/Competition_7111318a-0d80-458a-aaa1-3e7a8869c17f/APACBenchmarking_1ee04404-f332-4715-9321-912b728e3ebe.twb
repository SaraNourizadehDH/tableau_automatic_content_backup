              <color column='[federated.1aw2yf80441os91djjnsu12lwxf0].[none:Calculation_6935824942684471297:nk]' />
              <shape column='[federated.1aw2yf80441os91djjnsu12lwxf0].[none:Calculation_6935824942684471297:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true' fontsize='12' underline='true'>How does it work?</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true'>Refresh: </run>
                <run>every Monday at 10AM</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true'>Scope:</run>
                <run bold='true' fontcolor='#000000'>Æ </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Book' fontsize='9'>BD - pathao, HK - keeta, LA - egets,  TW - ubereats, KH/MM/MY/PH/SG/TH - grab</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true'>Vendors: </run>
                <run>only vendors that operate for Foodpanda and competitors</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true'>DH Pricing: </run>
                <run>delivery fee, service fee and MOV paid by the user at the order level, then aggregated to averages at different levels like vendor, city and country</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true'>Competitior Pricing: </run>
                <run>delivery fee, service fee and MOV are scraped from the competitor&apos;s app every week. The distance falls into particular Foodpanda pricing tiers, thus giving us the delivery fee.</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true'>Orders:</run>
                <run> for every Monday refresh we take the orders from the last completed week</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-labels-show' value='false' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
