              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = [created_week]&#10;THEN [orders]&#10;END' />
            </column>
            <column caption='City Top 1 Filter' datatype='string' name='[Calculation_3862470038197702656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name]&#10;WHEN &apos;Bangladesh&apos; THEN &apos;dhaka&apos;&#13;&#10;WHEN &apos;Cambodia&apos; THEN &apos;phnom penh&apos;&#13;&#10;WHEN &apos;Laos&apos; THEN &apos;vientiane capital&apos;&#13;&#10;WHEN &apos;Malaysia&apos; THEN &apos;kuala lumpur&apos;&#13;&#10;WHEN &apos;Myanmar&apos; THEN &apos;yangon&apos;&#10;WHEN &apos;Philippines&apos; THEN &apos;manila&apos;&#10;WHEN &apos;Thailand&apos; THEN &apos;bangkok&apos;&#10;END' />
            </column>
            <column caption='Max Week' datatype='date' name='[Calculation_5423248808850444288]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([created_week])}' />
            </column>
            <column caption='Max Week -7' datatype='date' name='[Calculation_5423248808850550785]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([created_week])-7}' />
            </column>
            <column caption='City Top 1' datatype='string' name='[City Top 1 Filter (copy)_3862470038199402497]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <calculation class='tableau' formula='IF [vendor_city] = [Calculation_3862470038197702656] THEN [vendor_city] END' />
            </column>
            <column caption='Orders PP' datatype='integer' name='[Orders CP (copy)_3096224781501865990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Current Period (copy)_3096224781494988801] = [created_week]&#10;THEN [orders]&#10;END' />
            </column>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[created_week]' role='dimension' type='ordinal' />
            <column datatype='string' name='[distance_tier]' role='dimension' type='nominal' />
