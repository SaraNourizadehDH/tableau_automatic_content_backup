            </column>
            <column caption='City Top 1 Filter' datatype='string' name='[Calculation_3862470038197702656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name]&#10;WHEN &apos;Bangladesh&apos; THEN &apos;dhaka&apos;&#13;&#10;WHEN &apos;Cambodia&apos; THEN &apos;phnom penh&apos;&#13;&#10;WHEN &apos;Laos&apos; THEN &apos;vientiane capital&apos;&#13;&#10;WHEN &apos;Malaysia&apos; THEN &apos;kuala lumpur&apos;&#13;&#10;WHEN &apos;Myanmar&apos; THEN &apos;yangon&apos;&#10;WHEN &apos;Philippines&apos; THEN &apos;manila&apos;&#10;WHEN &apos;Thailand&apos; THEN &apos;bangkok&apos;&#10;END' />
            </column>
            <column caption='Max Week' datatype='date' name='[Calculation_5423248808850444288]' role='dimension' type='ordinal'>
