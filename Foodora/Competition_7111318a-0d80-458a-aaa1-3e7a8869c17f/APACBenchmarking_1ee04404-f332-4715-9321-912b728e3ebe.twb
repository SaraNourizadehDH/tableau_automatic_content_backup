            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1aw2yf80441os91djjnsu12lwxf0].[Calculation_5423248808850444288]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1aw2yf80441os91djjnsu12lwxf0].[created_week]' caption='Current Period' datatype='date' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-18#'>
