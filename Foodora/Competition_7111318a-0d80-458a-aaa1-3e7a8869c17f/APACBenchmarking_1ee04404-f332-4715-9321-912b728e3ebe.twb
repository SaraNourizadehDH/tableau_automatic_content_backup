    <worksheet name='DF Delta Country City 2'>
      <table>
        <view>
          <datasources>
            <datasource caption='comp_analysis_pricing_joined (sandbox)' name='federated.1aw2yf80441os91djjnsu12lwxf0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1aw2yf80441os91djjnsu12lwxf0].[Calculation_5423248808850550785]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1aw2yf80441os91djjnsu12lwxf0].[created_week]' caption='Previous Period' datatype='date' name='[Current Period (copy)_3096224781494988801]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-18#'>
              <calculation class='tableau' formula='#2025-08-18#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1aw2yf80441os91djjnsu12lwxf0].[Calculation_5423248808850444288]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1aw2yf80441os91djjnsu12lwxf0].[created_week]' caption='Current Period' datatype='date' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-18#'>
              <calculation class='tableau' formula='#2025-08-18#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1aw2yf80441os91djjnsu12lwxf0'>
            <column caption='Orders CP' datatype='integer' name='[Calculation_3096224781501345796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = [created_week]&#10;THEN [orders]&#10;END' />
            </column>
            <column caption='Max Week' datatype='date' name='[Calculation_5423248808850444288]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([created_week])}' />
            </column>
            <column caption='Max Week -7' datatype='date' name='[Calculation_5423248808850550785]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([created_week])-7}' />
            </column>
            <column caption='City Top 2' datatype='string' name='[City Top 1 (copy)_3862470038199988226]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <calculation class='tableau' formula='IF [vendor_city] = [City Top 1 Filter (copy)_3862470038199996419] THEN [vendor_city] END' />
            </column>
            <column caption='City Top 2 Filter' datatype='string' name='[City Top 1 Filter (copy)_3862470038199996419]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name]&#13;&#10;WHEN &apos;Bangladesh&apos; THEN &apos;chittagong&apos;&#13;&#10;WHEN &apos;Cambodia&apos; THEN &apos;ta khmau&apos;&#13;&#10;WHEN &apos;Malaysia&apos; THEN &apos;johor bahru&apos;&#13;&#10;WHEN &apos;Philippines&apos; THEN &apos;quezon city&apos;&#13;&#10;WHEN &apos;Thailand&apos; THEN &apos;chiang mai&apos;&#13;&#10;END' />
            </column>
            <column caption='DF Delta CP' datatype='real' name='[DF Delta (copy)_3862470038219128838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([avg_df_dh_eur (copy)_3096224781502808074] - [avg_df_wolt_eur (copy)_3096224781504405517]) / [avg_df_dh_eur (copy)_3096224781502808074]' />
            </column>
            <column caption='DF Delta PP' datatype='real' name='[DF Delta CP (copy)_3862470038219374599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([avg_df_dh_eur_CP (copy)_3096224781504749582] - [avg_df_wolt_eur_CP (copy)_3096224781504843791]) / [avg_df_dh_eur_CP (copy)_3096224781504749582]' />
            </column>
            <column caption='Orders PP' datatype='integer' name='[Orders CP (copy)_3096224781501865990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Current Period (copy)_3096224781494988801] = [created_week]&#10;THEN [orders]&#10;END' />
            </column>
            <column caption='df_paid_dh_eur_CP' datatype='real' name='[Orders CP (copy)_3096224781502464008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = [created_week]&#10;THEN [df_paid_dh_eur]&#10;END' />
            </column>
            <column caption='avg_df_dh_eur_CP' datatype='real' name='[avg_df_dh_eur (copy)_3096224781502808074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Orders CP (copy)_3096224781502464008]) / SUM([Calculation_3096224781501345796])' />
            </column>
            <column caption='avg_df_dh_eur_PP' datatype='real' name='[avg_df_dh_eur_CP (copy)_3096224781504749582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([df_paid_dh_eur_CP (copy)_3096224781502677001]) / SUM([Orders CP (copy)_3096224781501865990])' />
            </column>
            <column caption='avg_df_wolt_eur_CP' datatype='real' name='[avg_df_wolt_eur (copy)_3096224781504405517]' role='measure' type='quantitative'>
