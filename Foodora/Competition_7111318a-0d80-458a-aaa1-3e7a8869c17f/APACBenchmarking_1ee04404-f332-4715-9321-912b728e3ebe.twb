            </column>
            <column caption='City Top 3' datatype='string' name='[City Top 2 (copy)_3862470038200868868]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <calculation class='tableau' formula='IF [vendor_city] = [City Top 2 Filter (copy)_3862470038200877061] THEN [vendor_city] END' />
            </column>
            <column caption='City Top 3 Filter' datatype='string' name='[City Top 2 Filter (copy)_3862470038200877061]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name]&#13;&#10;WHEN &apos;Bangladesh&apos; THEN &apos;sylhet&apos;&#13;&#10;WHEN &apos;Malaysia&apos; THEN &apos;shah alam&apos;&#13;&#10;WHEN &apos;Philippines&apos; THEN &apos;makati city&apos;&#13;&#10;WHEN &apos;Thailand&apos; THEN &apos;phuket&apos;&#13;&#10;END' />
            </column>
            <column caption='Orders PP' datatype='integer' name='[Orders CP (copy)_3096224781501865990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Current Period (copy)_3096224781494988801] = [created_week]&#10;THEN [orders]&#10;END' />
            </column>
            <column caption='avg_sf_dh_eur_CP' datatype='real' name='[avg_sf_dh_eur (copy)_3096224781512134684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([df_paid_dh_eur_CP (copy)_3096224781511385112]) / SUM([Calculation_3096224781501345796])' />
            </column>
            <column caption='avg_sf_dh_eur_PP' datatype='real' name='[avg_sf_dh_eur_CP (copy)_3096224781512249373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sf_paid_dh_eur_CP (copy)_3096224781511729177]) / SUM([Orders CP (copy)_3096224781501865990])' />
            </column>
            <column caption='avg_sf_wolt_eur_CP' datatype='real' name='[avg_sf_wolt_eur (copy)_3096224781512351774]' role='measure' type='quantitative'>
