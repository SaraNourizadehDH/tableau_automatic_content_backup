            <column caption='df_paid_dh_eur_CP' datatype='real' name='[Orders CP (copy)_3096224781502464008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = [created_week]&#10;THEN [df_paid_dh_eur]&#10;END' />
            </column>
            <column caption='avg_df_dh_eur_CP' datatype='real' name='[avg_df_dh_eur (copy)_3096224781502808074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Orders CP (copy)_3096224781502464008]) / SUM([Calculation_3096224781501345796])' />
            </column>
            <column caption='avg_df_dh_eur_PP' datatype='real' name='[avg_df_dh_eur_CP (copy)_3096224781504749582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([df_paid_dh_eur_CP (copy)_3096224781502677001]) / SUM([Orders CP (copy)_3096224781501865990])' />
            </column>
            <column caption='avg_df_wolt_eur_CP' datatype='real' name='[avg_df_wolt_eur (copy)_3096224781504405517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([df_paid_dh_eur_CP (copy)_3096224781504147467]) / SUM([Calculation_3096224781501345796])' />
            </column>
            <column caption='avg_df_wolt_eur_PP' datatype='real' name='[avg_df_wolt_eur_CP (copy)_3096224781504843791]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([df_offered_wolt_eur_CP (copy)_3096224781504294924]) / SUM([Orders CP (copy)_3096224781501865990])' />
            </column>
