    <worksheet name='Best Experience'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Best Experience</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Competition_Overview_CIO_Metrics (compstrat)' name='federated.0h2w5m41xdkwbb19d56gc0bpigg5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0h2w5m41xdkwbb19d56gc0bpigg5].[Calculation_6726055713198727168]' caption='Month' datatype='date' name='[Month Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2025-05-01#'>
              <calculation class='tableau' formula='#2025-05-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0h2w5m41xdkwbb19d56gc0bpigg5'>
            <column caption='Max(1)' datatype='integer' name='[Calculation_143270775762698242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Max(1)' />
            </column>
            <column caption='Last 3 Months' datatype='string' name='[Calculation_430515988520439809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [month] &gt;= DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, [Parameters].[Month Parameter]))&#10;AND [month] &lt;= [Parameters].[Month Parameter]&#10;THEN &quot;True&quot;&#10;ELSE &quot;False&quot;&#10;END' />
            </column>
            <column caption='One Month Before' datatype='date' name='[Calculation_6726055713198727168]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [month] = {MAX([month])}&#10;THEN DATEADD(&apos;month&apos;, -1, [month])&#10;ELSE [month]&#10;END)' />
            </column>
            <column caption='MoM Subscriber Penetration (p.p)' datatype='real' name='[MoM Customer CP (p.p)  (copy)_2415688635029307401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([subscriber_penetration]) - LOOKUP(SUM([subscriber_penetration]), -1)) * 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MoM QC GMV Vertical Penetration (p.p)' datatype='real' name='[MoM Subscriber Penetration (p.p) (copy)_2415688635030306826]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Vertical Percentage (copy)_143270775855435784]) - LOOKUP(SUM([Vertical Percentage (copy)_143270775855435784]), -1)) * 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='QC vertical penetration' datatype='real' name='[Vertical Percentage (copy)_143270775855435784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [vertical] = &apos;Shops&apos; OR [vertical] = &apos;Dmart&apos; OR [vertical] = &apos;UE Dmart&apos; THEN [vertical_percentage] ELSE NULL END' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;Hong_Kong&quot;' value='Hong Kong' />
              </aliases>
            </column>
            <column-instance column='[Vertical Percentage (copy)_143270775855435784]' derivation='Sum' name='[diff:sum:Vertical Percentage (copy)_143270775855435784:qk:2]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-field='[federated.0h2w5m41xdkwbb19d56gc0bpigg5].[month]' ordering-type='Field' type='Difference'>
                <address>
                  <value>-1</value>
                </address>
              </table-calc>
            </column-instance>
