    <worksheet name='Customer Base &amp; Marketing'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Customer Base &amp; Marketing&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Competition_Overview_CIO_Metrics (compstrat)' name='federated.0h2w5m41xdkwbb19d56gc0bpigg5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0h2w5m41xdkwbb19d56gc0bpigg5].[Calculation_6726055713198727168]' caption='Month' datatype='date' name='[Month Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2025-05-01#'>
              <calculation class='tableau' formula='#2025-05-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0h2w5m41xdkwbb19d56gc0bpigg5'>
            <column caption='Max(1)' datatype='integer' name='[Calculation_143270775762698242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Max(1)' />
            </column>
            <column caption='AFV combined' datatype='real' name='[Calculation_143270775781662723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [brand_name] = &quot;Deliveroo&quot; THEN [net_gmv_per_order_local_daily_average]&#10;ELSEIF [brand_name] = &quot;UberEats&quot; THEN [net_gmv_per_order_local_daily_average]&#10;ELSE [afv_local_daily_average]&#10;END' />
            </column>
            <column caption='Incentivised Orders Percentage Clean' datatype='real' name='[Calculation_1702923624953954305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [country_name] = &quot;Hong_Kong&quot; AND [brand_name] = &quot;Deliveroo&quot; THEN NULL&#10;ELSEIF [country_name] = &quot;Hong_Kong&quot; AND [brand_name] = &quot;Keeta&quot; THEN NULL&#10;ELSEIF [country_name] = &quot;Singapore&quot; AND [brand_name] = &quot;Deliveroo&quot; THEN NULL&#10;ELSEIF [country_name] = &quot;Taiwan&quot; AND [brand_name] = &quot;UberEats&quot; THEN NULL &#10;ELSEIF [country_name] = &quot;Cambodia&quot; AND [brand_name] = &quot;Nham24&quot; THEN NULL &#10;ELSE [incentivised_orders_percentage] END' />
            </column>
            <column caption='Last 3 Months' datatype='string' name='[Calculation_430515988520439809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [month] &gt;= DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, [Parameters].[Month Parameter]))&#10;AND [month] &lt;= [Parameters].[Month Parameter]&#10;THEN &quot;True&quot;&#10;ELSE &quot;False&quot;&#10;END' />
            </column>
            <column caption='One Month Before' datatype='date' name='[Calculation_6726055713198727168]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [month] = {MAX([month])}&#10;THEN DATEADD(&apos;month&apos;, -1, [month])&#10;ELSE [month]&#10;END)' />
            </column>
            <column caption='MoM Incentivised Orders (p.p) ' datatype='real' name='[MoM Customer CP (p.p)  (copy)_2415688635027554311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1702923624953954305]) - LOOKUP(SUM([Calculation_1702923624953954305]), -1)) * 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MoM Qcomm GMV CP (p.p) ' datatype='real' name='[MoM Customer CP (p.p)  (copy)_2415688635028217864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Net GMV CP (copy)_143270775835168775]) - LOOKUP(SUM([Net GMV CP (copy)_143270775835168775]), -1)) * 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MoM Customer CP (p.p) ' datatype='real' name='[MoM Order CP (p.p)  (copy)_2415688635025870854]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Order CP  (copy)_143270775782567941]) - LOOKUP(SUM([Order CP  (copy)_143270775782567941]), -1)) * 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Net GMV CP (QC)' datatype='real' name='[Net GMV CP (copy)_143270775835168775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Numerator: Sum of &quot;Net Gmv Adj Local&quot; for specified &quot;Verticals&quot; by &quot;Brand Name&quot;, &quot;Month&quot;, and &quot;Country Name&quot;&#10;{FIXED [brand_name], [month], [country_name]: &#10;    SUM(IF [vertical] = &apos;Shops&apos; OR [vertical] = &apos;Dmart&apos; OR [vertical] = &apos;UE Dmart&apos; THEN [net_gmv_adj_local] ELSE 0 END)}&#10;&#10;/&#10;// Denominator: Sum of &quot;Net Gmv Adj Local&quot; for specified &quot;Verticals&quot; by &quot;Month&quot; and &quot;Country Name&quot;&#10;{FIXED [month], [country_name]: &#10;    SUM(IF [vertical] = &apos;Shops&apos; OR [vertical] = &apos;Dmart&apos; OR [vertical] = &apos;UE Dmart&apos; THEN [net_gmv_adj_local] ELSE 0 END)}' />
            </column>
            <column caption='Customer CP' datatype='real' name='[Order CP  (copy)_143270775782567941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{Fixed [brand_name], [month], [vertical], [country_name]:SUM([customers])}&#10;                              /&#10;       {Fixed [month], [country_name], [vertical]: SUM([customers])}' />
            </column>
            <column caption='Afv Local Daily Average' datatype='real' name='[afv_local_daily_average]' role='measure' type='quantitative' />
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;Hong_Kong&quot;' value='Hong Kong' />
              </aliases>
            </column>
            <column caption='Customers' datatype='real' name='[customers]' role='measure' type='quantitative' />
