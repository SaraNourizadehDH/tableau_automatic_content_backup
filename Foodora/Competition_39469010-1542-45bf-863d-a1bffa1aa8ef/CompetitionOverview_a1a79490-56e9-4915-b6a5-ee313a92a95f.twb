      <table>
        <view>
          <datasources>
            <datasource caption='Competition_Overview_CIO_Metrics (compstrat)' name='federated.0h2w5m41xdkwbb19d56gc0bpigg5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0h2w5m41xdkwbb19d56gc0bpigg5].[Calculation_6726055713198727168]' caption='Month' datatype='date' name='[Month Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2025-05-01#'>
              <calculation class='tableau' formula='#2025-05-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0h2w5m41xdkwbb19d56gc0bpigg5'>
            <column caption='Max(1)' datatype='integer' name='[Calculation_143270775762698242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Max(1)' />
            </column>
            <column caption='Last 3 Months' datatype='string' name='[Calculation_430515988520439809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [month] &gt;= DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, [Parameters].[Month Parameter]))&#10;AND [month] &lt;= [Parameters].[Month Parameter]&#10;THEN &quot;True&quot;&#10;ELSE &quot;False&quot;&#10;END' />
            </column>
            <column caption='Net GMV CP' datatype='real' name='[Calculation_430515989173362713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{Fixed [brand_name],[month], [vertical], [country_name]:SUM([net_gmv_adj_local])}&#10;                              /&#10;       {Fixed [month], [vertical],[country_name]: SUM([net_gmv_adj_local])}' />
            </column>
            <column caption='One Month Before' datatype='date' name='[Calculation_6726055713198727168]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [month] = {MAX([month])}&#10;THEN DATEADD(&apos;month&apos;, -1, [month])&#10;ELSE [month]&#10;END)' />
            </column>
            <column caption='MoM Order CP (p.p) ' datatype='real' name='[MoM Net GMV CP (p.p) (copy)_2415688635023675396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Net GMV CP (copy)_143270775757795328]) - LOOKUP(SUM([Net GMV CP (copy)_143270775757795328]), -1)) * 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Order CP ' datatype='real' name='[Net GMV CP (copy)_143270775757795328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{Fixed [brand_name],[month], [vertical], [country_name]:SUM([orders_daily_average])}&#10;                              /&#10;       {Fixed [month], [vertical], [country_name]: SUM([orders_daily_average])}' />
            </column>
            <column caption='MoM Net GMV CP (p.p)' datatype='real' name='[Net GMV CP (copy)_2415688635021959170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_430515989173362713]) - LOOKUP(SUM([Calculation_430515989173362713]), -1)) * 100'>
