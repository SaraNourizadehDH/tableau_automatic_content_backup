      <aliases enabled='yes' />
      <column caption='Active Vendors cleaned' datatype='integer' name='[Active Vendors (copy)_2388948521850642435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [brand_name] = &quot;Keeta&quot; THEN NULL&#10;ELSEIF [brand_name] = &quot;Deliveroo&quot; THEN NULL&#10;ELSEIF [brand_name] = &quot;UberEats&quot; THEN NULL&#10;ELSE [active_vendors]&#10;END' />
      </column>
      <column caption='Addressable GTC cleaned' datatype='integer' name='[Addressable GTC (copy)_2388948521849827330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [brand_name] = &quot;Foodpanda&quot; THEN NULL &#10;ELSEIF [country_name] = &quot;Singapore&quot; AND [brand_name] = &quot;Deliveroo&quot; THEN NULL&#10;ELSE [addressable_gtc]&#10;END' />
      </column>
      <column caption='Offline Percentage cleaned' datatype='real' name='[Offline Percentage (copy)_2388948521849421825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [country_name] = &quot;Hong_Kong&quot; THEN NULL&#10;ELSEIF [country_name] = &quot;Cambodia&quot; THEN NULL&#10;ElSEIF [country_name] = &quot;Taiwan&quot; THEN NULL&#10;ELSEIF  [brand_name] != &quot;GrabFood&quot; THEN NULL&#10;ELSE [offline_percentage]&#10;END' />
      </column>
      <column caption='Percentage Worse Deal Parity cleaned' datatype='real' name='[Percentage Worse Deal Parity (copy)_2388948521860800516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [brand_name] = &quot;Foodpanda&quot; THEN NULL&#10;ELSEIF [country_name] = &quot;Singapore&quot; AND [brand_name] = &quot;Deliveroo&quot; THEN NULL&#10;ELSEIF  [brand_name] = &quot;Keeta&quot; THEN NULL&#10;ELSE [percentage_worse_deal_parity]&#10;END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Competition_Overview_COO_Metrics' datatype='table' name='[__tableau_internal_object_id__].[Competition_Overview_COO_Metrics_B63B283E2C5C46ED82BB424936A2E4B9]' role='measure' type='quantitative' />
