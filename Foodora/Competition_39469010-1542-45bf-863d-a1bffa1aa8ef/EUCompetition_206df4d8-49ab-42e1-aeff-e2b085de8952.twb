      <column caption='MoM %' datatype='real' name='[MoM (copy)_6128062113852235777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((ZN(SUM([CP])) - LOOKUP(ZN(SUM([CP])), -1))) / LOOKUP(ZN(SUM([CP])), -1)'>
