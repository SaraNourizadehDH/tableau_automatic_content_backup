      <aliases enabled='yes' />
      <column datatype='real' name='[CP]' role='measure' type='quantitative' />
      <column caption='CP lm' datatype='real' name='[CP_lm]' role='measure' type='quantitative' />
      <column caption='CP ly' datatype='real' name='[CP_ly]' role='measure' type='quantitative' />
      <column caption='Sub Plan' datatype='string' name='[Calculation_3563402861814513664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([SubscriptionPlan],&quot;&quot;)' />
      </column>
      <column caption='Foodora CP' datatype='real' name='[Calculation_4419720103683047429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Competitor] = &quot;foodora&quot; OR [Competitor] = &quot;Yemeksepeti&quot;) THEN[CP] END' />
      </column>
      <column caption='INDX' datatype='integer' name='[Calculation_4765300996426555392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Size() - INDEX() +1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM' datatype='real' name='[Calculation_4765300996707004417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((ZN(SUM([CP])) - LOOKUP(ZN(SUM([CP])), -1)))*100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM change' datatype='real' name='[Calculation_5278781718111662080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([CP] - [CP_lm])*100' />
      </column>
      <column caption='Orders/GMV' datatype='real' name='[Calculation_5967058427160027175]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 Then sum([OrderCount])&#10;When 2 then sum([GMV])&#10;END' />
      </column>
      <column caption='CP/Orders' datatype='real' default-format='*0.00%;-#,##0' name='[Calculation_6128062113847873536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;When 1 then AVG([CP])&#10;When 2 then SUM([OrderCount]) * -1&#10;END' />
      </column>
      <column caption='MoM % / pp' datatype='string' name='[Calculation_6128062113853366274]' role='measure' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#10;When 2 then STR(ROUND([MoM (copy)_6128062113852235777]*100,1))+&quot;%&quot;&#10;When 1 then STR(ROUND([Calculation_4765300996707004417],1))+&quot;pp&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM Title' datatype='string' name='[Calculation_8033366209560371219]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;MoM&quot;' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[City_lm]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[City_ly]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='Competitor (competition subscribers)' datatype='string' name='[Competitor (competition_subscribers)]' role='dimension' type='nominal' />
