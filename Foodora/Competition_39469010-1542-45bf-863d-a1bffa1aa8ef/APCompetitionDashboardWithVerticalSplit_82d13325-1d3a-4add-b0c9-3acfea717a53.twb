      <column aggregation='Attribute' caption='Bucket Contribution GMV' datatype='real' name='[Bucket Contribution (copy)_829225335838924801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [brand_name] : SUM([scaled_gfv])}' />
      </column>
      <column aggregation='Attribute' caption='Bucket Contribution GMV_2' datatype='real' name='[Bucket Contribution GMV (copy)_142778239978467331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [brand_name] : SUM([scaled_gmv])}' />
      </column>
      <column aggregation='Attribute' caption='Bucket Contribution GMV by Brand' datatype='real' name='[Bucket Contribution GMV (copy)_829225335848947719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE : SUM([scaled_gfv])}' />
      </column>
      <column caption='Orders / GMV' datatype='real' name='[Calculation_1156088152606633984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1 1] = &quot;Orders&quot; THEN &#10;[scaled_orders]&#10;&#10;ELSEIF [Parameters].[Parameter 1 1] = &quot;GMV&quot; AND [brand_name] = &quot;Deliveroo&quot; THEN 0&#10;&#10;ELSEIF [Parameters].[Parameter 1 1] = &quot;GMV&quot; THEN[scaled_gfv]&#10;&#10;ELSEIF [Parameters].[Parameter 1 1] = &quot;GMV_2&quot; THEN&#10;[scaled_gmv]&#10;&#10;END' />
      </column>
      <column aggregation='Attribute' caption='Total Orders by Month' datatype='real' name='[Calculation_5820480357590577160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [brand_name], [gfv_buckets] : SUM([scaled_orders])}' />
      </column>
      <column caption='Running Percentage Orders ' datatype='real' name='[Calculation_5820480357595328522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1 1] = &quot;Orders&quot; THEN &#10;    IF FIRST()==0 THEN&#10;        MIN([Calculation_5820480357611036698])&#10;    ELSEIF MIN([month]) != LOOKUP(MIN([month]),-1) THEN&#10;        PREVIOUS_VALUE(0) + MIN([Calculation_5820480357611036698])&#10;    ELSEIF MIN([country_name]) != LOOKUP(MIN([country_name]),-1) THEN&#10;        PREVIOUS_VALUE(0) + MIN([Calculation_5820480357611036698])&#10;    ELSEIF MIN([gfv_buckets]) != LOOKUP(MIN([gfv_buckets]),-1) THEN&#10;        PREVIOUS_VALUE(0) + MIN([Calculation_5820480357611036698])&#10;    ELSE&#10;        PREVIOUS_VALUE(0)&#10;    END&#10;ELSEIF [Parameters].[Parameter 1 1] = &quot;GMV&quot; THEN&#10;    IF FIRST()==0 THEN&#10;        MIN([Percent Bucket (copy)_829225335839322114])&#10;    ELSEIF MIN([month]) != LOOKUP(MIN([month]),-1) THEN&#10;        PREVIOUS_VALUE(0) + MIN([Percent Bucket (copy)_829225335839322114])&#10;    ELSEIF MIN([country_name]) != LOOKUP(MIN([country_name]),-1) THEN&#10;        PREVIOUS_VALUE(0) + MIN([Percent Bucket (copy)_829225335839322114])&#10;    ELSEIF MIN([gfv_buckets]) != LOOKUP(MIN([gfv_buckets]),-1) THEN&#10;        PREVIOUS_VALUE(0) + MIN([Percent Bucket (copy)_829225335839322114])&#10;    ELSE&#10;        PREVIOUS_VALUE(0)&#10;    END&#10;&#10;ELSEIF [Parameters].[Parameter 1 1] = &quot;GMV_2&quot; THEN&#10;    IF FIRST()==0 THEN&#10;        MIN([Calculation_5820480357611036698])&#10;    ELSEIF MIN([month]) != LOOKUP(MIN([month]),-1) THEN&#10;        PREVIOUS_VALUE(0) + MIN([Calculation_5820480357611036698])&#10;    ELSEIF MIN([country_name]) != LOOKUP(MIN([country_name]),-1) THEN&#10;        PREVIOUS_VALUE(0) + MIN([Calculation_5820480357611036698])&#10;    ELSEIF MIN([gfv_buckets]) != LOOKUP(MIN([gfv_buckets]),-1) THEN&#10;        PREVIOUS_VALUE(0) + MIN([Calculation_5820480357611036698])&#10;    ELSE&#10;        PREVIOUS_VALUE(0)&#10;    END&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Attribute' caption='Bucket Contribution Orders' datatype='real' name='[Calculation_5820480357607862297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [brand_name] : SUM([scaled_orders])}' />
      </column>
      <column aggregation='Attribute' caption='Percent Bucket Orders' datatype='real' name='[Calculation_5820480357611036698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1 1] = &apos;Orders&apos; THEN&#10;    [Calculation_5820480357607862297] / [Calculation_5820480357590577160]&#10;&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;GMV&apos; THEN&#10;    [Bucket Contribution (copy)_829225335838924801] / [Calculation_829225335838453760]&#10;&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;GMV_2&apos; THEN&#10;    [Bucket Contribution GMV (copy)_142778239978467331] / [Total GMV by Month (copy)_142778239978962948]&#10;&#10;END' />
      </column>
      <column aggregation='Attribute' caption='Total GMV by Month' datatype='real' name='[Calculation_829225335838453760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [brand_name], [gfv_buckets] : SUM([scaled_gfv])}' />
      </column>
      <column caption='SUM(scaled orders / gmv)' datatype='real' name='[Calculation_994591884700504065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1 1] = &apos;Orders&apos; THEN&#10;    SUM([scaled_orders]) / TOTAL(SUM([scaled_orders]))&#10;&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;GMV&apos; THEN&#10;    SUM([Scaled Gfv (copy)_1370220244707966977]) / TOTAL(SUM([Scaled Gfv (copy)_1370220244707966977]))&#10;&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;GMV_2&apos; THEN&#10;    SUM([scaled_gmv]) / TOTAL(SUM([scaled_gmv]))&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Attribute' caption='Percent Bucket GMV' datatype='real' name='[Percent Bucket (copy)_829225335839322114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Bucket Contribution (copy)_829225335838924801] / [Calculation_829225335838453760]' />
      </column>
      <column aggregation='Attribute' caption='Percent Bucket GMV by Brand' datatype='real' name='[Percent Bucket GMV (copy)_829225335849263113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Bucket Contribution GMV (copy)_829225335848947719] / [Total GMV by Month (copy)_829225335848763398]' />
      </column>
      <column caption='Running Percentage GMV' datatype='real' name='[Running Percentage Orders  (copy)_829225335839690755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF FIRST()==0 THEN&#10;MIN([Percent Bucket (copy)_829225335839322114])&#10;ELSEIF MIN([month]) != LOOKUP(MIN([month]),-1) THEN&#10;PREVIOUS_VALUE(0) + MIN([Percent Bucket (copy)_829225335839322114])&#10;ELSEIF MIN([country_name]) != LOOKUP(MIN([country_name]),-1) THEN&#10;PREVIOUS_VALUE(0) + MIN([Percent Bucket (copy)_829225335839322114])&#10;ELSEIF MIN([gfv_buckets]) != LOOKUP(MIN([gfv_buckets]),-1) THEN&#10;PREVIOUS_VALUE(0) + MIN([Percent Bucket (copy)_829225335839322114])&#10;//ELSEIF MIN([Brand Name]) != LOOKUP(MIN([Brand Name]),-1) THEN&#10;//PREVIOUS_VALUE(0) + MIN([Total Orders by Month])&#10;ELSE&#10;PREVIOUS_VALUE(0)&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
