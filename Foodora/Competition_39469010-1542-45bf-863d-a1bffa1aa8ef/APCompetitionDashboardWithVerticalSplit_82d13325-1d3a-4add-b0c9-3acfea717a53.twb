    <worksheet name='L12P - Order'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='10'>L12P</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='8'>(vs </run>
            <run fontalignment='1' fontcolor='#ff0000' fontsize='8'><![CDATA[<[federated.18dajj21lpwep91aifks41rr409l].[none:Calculation_3105724545502990338:qk]>]]></run>
            <run fontalignment='1' fontsize='8'>)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (pandata_ap_mktg)' name='federated.18dajj21lpwep91aifks41rr409l' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 6' caption='Custom Date Range' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Last 6&quot;'>
              <calculation class='tableau' formula='&quot;Last 6&quot;' />
              <aliases>
                <alias key='&quot;Custom Date Range&quot;' value='Custom' />
                <alias key='&quot;Last 6&quot;' value='Last 6' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18dajj21lpwep91aifks41rr409l'>
            <column caption='Last6Period' datatype='string' name='[Calculation_139048643610664962]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;weekly&apos; THEN&#13;&#10;    IF DATEDIFF(&apos;week&apos;, DATETRUNC(&apos;week&apos;, {MAX([date_value])}), DATETRUNC(&apos;week&apos;, TODAY())) &gt; 1 THEN&#13;&#10;        IF [date_value] &gt;= DATEADD(&apos;week&apos;, -5, DATETRUNC(&apos;week&apos;, {MAX([date_value])})) &#13;&#10;        AND [date_value] &lt; DATEADD(&apos;week&apos;, 1, DATETRUNC(&apos;week&apos;, {MAX([date_value])})) THEN&#13;&#10;            &quot;True&quot;&#13;&#10;        END&#13;&#10;    ELSE&#13;&#10;        IF [date_value] &gt;= DATEADD(&apos;week&apos;, -6, DATETRUNC(&apos;week&apos;, TODAY())) &#13;&#10;        AND [date_value] &lt; DATETRUNC(&apos;week&apos;, TODAY()) THEN&#13;&#10;            &quot;True&quot;&#13;&#10;        END&#13;&#10;    END&#13;&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN&#13;&#10;    IF [date_value] &gt;= DATEADD(&apos;month&apos;, -5, DATETRUNC(&apos;month&apos;, {MAX([date_value])}))&#13;&#10;    AND [date_value] &lt;= DATEADD(&apos;month&apos;, 0, TODAY()) THEN&#13;&#10;        &quot;True&quot;&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_1749366987462377475]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Last 6&apos; THEN&#13;&#10;    ISNULL([Calculation_139048643610664962]) = FALSE&#13;&#10;ELSE&#13;&#10;    TRUE&#13;&#10;END' />
            </column>
            <column caption='Custom Range Filter' datatype='boolean' name='[Calculation_1749366987463086084]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Custom&apos; THEN&#13;&#10;    TRUE&#13;&#10;ELSE&#13;&#10;    FALSE&#13;&#10;END' />
            </column>
            <column caption='date_value_max' datatype='boolean' name='[Calculation_3105724545502892033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date_value] = {FIXED [granularity]:MAX([date_value])}' />
            </column>
            <column caption='L12P - Date' datatype='datetime' name='[Calculation_3105724545502990338]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [granularity]&#10;WHEN &apos;monthly&apos; THEN DATEADD(&apos;month&apos;,-12,[date_value])&#10;WHEN &apos;weekly&apos; THEN DATEADD(&apos;week&apos;,-12,[date_value])&#10;END' />
            </column>
            <column caption='l12p_order_cp_adj' datatype='real' name='[Calculation_6259862764685029379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([is_capital]) &gt;= 2 THEN SUM([l12p_order_cp_nationwide])&#10;ELSE SUM([l12p_order_cp]) END' />
            </column>
            <column caption='order_cp_adj' datatype='real' name='[Calculation_6259862764685967367]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([is_capital]) &gt;= 2 THEN SUM([order_cp_nationwide])&#10;ELSE SUM([order_cp]) END' />
            </column>
            <column caption='l12p_order_cp_delta' datatype='real' name='[Calculation_6259862764686462984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6259862764685967367] - [Calculation_6259862764685029379]) * 100' />
            </column>
            <column caption='Brand' datatype='string' name='[brand_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Foodpanda&quot;' value='foodpanda' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;Hong_Kong&quot;' value='Hong Kong' />
              </aliases>
            </column>
            <column datatype='date' name='[date_value]' role='dimension' type='ordinal' />
            <column datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column datatype='string' name='[is_capital]' role='dimension' type='nominal' />
            <column datatype='real' name='[l12p_order_cp]' role='measure' type='quantitative' />
            <column datatype='real' name='[l12p_order_cp_nationwide]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3105724545502990338]' derivation='Max' name='[max:Calculation_3105724545502990338:qk]' pivot='key' type='quantitative' />
