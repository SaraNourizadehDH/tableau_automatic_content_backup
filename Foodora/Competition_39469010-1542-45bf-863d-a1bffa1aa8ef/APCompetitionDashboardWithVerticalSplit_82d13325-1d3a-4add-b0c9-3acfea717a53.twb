              <zone forceUpdate='true' h='12388' id='133' type-v2='text' w='98934' x='533' y='5556'>
                <formatted-text>
                  <run fontcolor='#000000' fontname='Tableau Bold'>Note:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>This page shows the freshness of the data for each table used in this workbook.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000'>AP_Comp_Zone_CP:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>- Data is fresh if there is data from 2 weeks ago</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>- Data is refreshed up till last day of previous month on Week 2/3 of current month</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000'>Other tables:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>- Data is fresh if there is data from 1 week ago</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>- Data is refreshed by Thursday every week for data up till last Sunday</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
