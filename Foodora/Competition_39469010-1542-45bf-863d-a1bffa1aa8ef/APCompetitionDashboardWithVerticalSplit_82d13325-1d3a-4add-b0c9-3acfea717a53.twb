              <calculation class='tableau' formula='IF ATTR([country_name]) = &apos;Hong_Kong&apos; AND ATTR([brand_name]) = &apos;Foodpanda&apos; THEN&#13;&#10;&#13;&#10;(sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Foodpanda&quot; then [gfv_adj_eur] end) })/&#13;&#10;sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Foodpanda&quot; then [orders_adj] end) }))&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Deliveroo&quot; then [gfv_adj_eur] end) })/&#13;&#10;sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Deliveroo&quot; then [orders_adj]  end) }))&#13;&#10;-1&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ATTR([country_name]) = &apos;Taiwan&apos; AND ATTR([brand_name]) = &apos;Foodpanda&apos; THEN&#13;&#10;(sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Foodpanda&quot; then [Calculation_819092188382683146] end) })/&#13;&#10;sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Foodpanda&quot; then [orders_adj] end) }))&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;UberEats&quot; then [Calculation_819092188382683146] end)})/&#13;&#10;sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;UberEats&quot; then [orders_adj]  end) }))&#13;&#10;-1&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ATTR([country_name]) != &apos;Taiwan&apos; AND ATTR([country_name]) != &apos;Hong_Kong&apos; &#13;&#10;AND ATTR([brand_name]) = &apos;Foodpanda&apos; THEN&#13;&#10;(sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Foodpanda&quot; then [gfv_adj_eur] end) })/&#13;&#10;sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Foodpanda&quot; then [orders_adj] end) }))&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;GrabFood&quot; then [gfv_adj_eur] end) })/&#13;&#10;sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;GrabFood&quot; then [orders_adj]  end) }))&#13;&#10;-1&#13;&#10;&#13;&#10;&#13;&#10;ELSE 0&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='df_fp' datatype='real' name='[Calculation_1064256893193773071]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([country_name]) = &apos;Hong_Kong&apos; AND ATTR([brand_name]) = &apos;Foodpanda&apos; THEN&#13;&#10;(sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Foodpanda&quot; then [df_eur] end) })/&#13;&#10;sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Foodpanda&quot; then [df_orders] end) }))&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Deliveroo&quot; then [df_eur] end) })/&#13;&#10;sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Deliveroo&quot; then [df_orders]  end) }))&#13;&#10;-1&#13;&#10;&#13;&#10;ELSEIF ATTR([country_name]) = &apos;Taiwan&apos; AND ATTR([brand_name]) = &apos;Foodpanda&apos; THEN&#13;&#10;(sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Foodpanda&quot; then [Calculation_819092188382683146] end) })/&#13;&#10;sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Foodpanda&quot; then [orders_adj] end) }))&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;UberEats&quot; then [Calculation_819092188382683146] end)})/&#13;&#10;sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;UberEats&quot; then [orders_adj]  end) }))&#13;&#10;-1&#13;&#10;&#13;&#10;ELSEIF ATTR([country_name]) != &apos;Taiwan&apos; AND ATTR([country_name]) != &apos;Hong_Kong&apos; &#13;&#10;AND ATTR([brand_name]) = &apos;Foodpanda&apos; THEN&#13;&#10;(sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Foodpanda&quot; then [df_eur] end) })/&#13;&#10;sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Foodpanda&quot; then [df_orders] end) }))&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;GrabFood&quot; then [df_eur] end) })/&#13;&#10;sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;GrabFood&quot; then [df_orders]  end) }))&#13;&#10;-1&#13;&#10;&#13;&#10;ELSE 0&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='avg_df_adj' datatype='real' name='[Calculation_1170935941591531521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Eur&apos; THEN sum([df_eur_adj])/SUM([df_orders_adj])&#10;WHEN &apos;Local&apos; THEN sum([df_local_adj])/SUM([df_orders_adj])&#10;END' />
            </column>
            <column caption='net_gmv_adj_eur' datatype='real' name='[Calculation_819092188382683146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] &gt;= #2025-06-30#&#13;&#10;    AND [date_value] &lt;= #2025-07-06#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN (ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])) * (ZN([error_prcnt]) + 0.4)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] = #2025-07-07#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN (ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])) * (ZN([error_prcnt]) + 0.3)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-07#&#13;&#10;    AND [date_value] &lt;= #2025-08-03#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN (ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])) * (ZN([error_prcnt]) + 0.1)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-01#&#13;&#10;    AND [date_value] &lt;= #2025-07-31#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;monthly&quot;&#13;&#10;THEN (ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])) * .8&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;taiwan&quot;&#13;&#10;    AND [date_value] &gt;= #2025-06-30#&#13;&#10;    AND [date_value] &lt;= #2025-07-13#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN (ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])) * (ZN([error_prcnt]) + 0.4)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;taiwan&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-14#&#13;&#10;    AND [date_value] &lt;= #2025-07-28#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN (ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])) * (ZN([error_prcnt]) + 0.25)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;taiwan&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-01#&#13;&#10;    AND [date_value] &lt;= #2025-07-31#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;monthly&quot;&#13;&#10;THEN (ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])) * 0.9&#13;&#10;ELSE ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])&#13;&#10;END' />
            </column>
