        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1cn9reh0b7w3ak185ggkz1dxzajh' name='Custom SQL Query' type='text'>WITH raw_data AS (
  SELECT *, 
    IF(LOWER(country_name) IN (&quot;philippines&quot;, &quot;taiwan&quot;) AND month &gt;&gt;= &quot;2025-07-01&quot;, TRUE, FALSE) has_data_issues
  FROM `pd-data--adhoc.sandbox__pd_markets_apac.Order_CP_by_GFV_Bucket`
)

SELECT *EXCEPT(has_data_issues)
FROM raw_data
WHERE NOT has_data_issues</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
