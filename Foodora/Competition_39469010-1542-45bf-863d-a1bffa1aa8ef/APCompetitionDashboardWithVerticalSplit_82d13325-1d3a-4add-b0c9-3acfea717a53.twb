              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;Eur&apos; THEN [net_gmv_adj_eur_upper]&#13;&#10;WHEN &apos;Local&apos; THEN [net_gmv_adj_local_upper]&#13;&#10;END' />
            </column>
            <column caption='net_gmv_adj_local' datatype='real' name='[net_gmv_adj_eur (copy)_847591591449104384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] &gt;= #2025-06-30#&#13;&#10;    AND [date_value] &lt;= #2025-07-06#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN ([gross_gmv_adj_local]-[incentives_adj_local]) * (ZN([error_prcnt]) + 0.4)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] = #2025-07-07#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN ([gross_gmv_adj_local]-[incentives_adj_local]) * (ZN([error_prcnt]) + 0.3)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-07#&#13;&#10;    AND [date_value] &lt;= #2025-08-03#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN ([gross_gmv_adj_local]-[incentives_adj_local]) * (ZN([error_prcnt]) + 0.1)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-01#&#13;&#10;    AND [date_value] &lt;= #2025-07-31#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;monthly&quot;&#13;&#10;THEN ([gross_gmv_adj_local]-[incentives_adj_local]) * .8&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;taiwan&quot;&#13;&#10;    AND [date_value] &gt;= #2025-06-30#&#13;&#10;    AND [date_value] &lt;= #2025-07-13#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN ([gross_gmv_adj_local]-[incentives_adj_local]) * (ZN([error_prcnt]) + 0.4)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;taiwan&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-14#&#13;&#10;    AND [date_value] &lt;= #2025-07-28#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN ([gross_gmv_adj_local]-[incentives_adj_local]) * (ZN([error_prcnt]) + 0.25)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;taiwan&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-01#&#13;&#10;    AND [date_value] &lt;= #2025-07-31#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;monthly&quot;&#13;&#10;THEN ([gross_gmv_adj_local]-[incentives_adj_local]) * 0.9&#13;&#10;ELSE [gross_gmv_adj_local]-[incentives_adj_local]&#13;&#10;END' />
