          <datasource-dependencies datasource='federated.18dajj21lpwep91aifks41rr409l'>
            <column caption='avg_df_adj' datatype='real' name='[Calculation_1170935941591531521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Eur&apos; THEN sum([df_eur_adj])/SUM([df_orders_adj])&#10;WHEN &apos;Local&apos; THEN sum([df_local_adj])/SUM([df_orders_adj])&#10;END' />
            </column>
            <column caption='Last6Period' datatype='string' name='[Calculation_139048643610664962]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;weekly&apos; THEN&#13;&#10;    IF DATEDIFF(&apos;week&apos;, DATETRUNC(&apos;week&apos;, {MAX([date_value])}), DATETRUNC(&apos;week&apos;, TODAY())) &gt; 1 THEN&#13;&#10;        IF [date_value] &gt;= DATEADD(&apos;week&apos;, -5, DATETRUNC(&apos;week&apos;, {MAX([date_value])})) &#13;&#10;        AND [date_value] &lt; DATEADD(&apos;week&apos;, 1, DATETRUNC(&apos;week&apos;, {MAX([date_value])})) THEN&#13;&#10;            &quot;True&quot;&#13;&#10;        END&#13;&#10;    ELSE&#13;&#10;        IF [date_value] &gt;= DATEADD(&apos;week&apos;, -6, DATETRUNC(&apos;week&apos;, TODAY())) &#13;&#10;        AND [date_value] &lt; DATETRUNC(&apos;week&apos;, TODAY()) THEN&#13;&#10;            &quot;True&quot;&#13;&#10;        END&#13;&#10;    END&#13;&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN&#13;&#10;    IF [date_value] &gt;= DATEADD(&apos;month&apos;, -5, DATETRUNC(&apos;month&apos;, {MAX([date_value])}))&#13;&#10;    AND [date_value] &lt;= DATEADD(&apos;month&apos;, 0, TODAY()) THEN&#13;&#10;        &quot;True&quot;&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_1749366987462377475]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Last 6&apos; THEN&#13;&#10;    ISNULL([Calculation_139048643610664962]) = FALSE&#13;&#10;ELSE&#13;&#10;    TRUE&#13;&#10;END' />
            </column>
            <column caption='Custom Range Filter' datatype='boolean' name='[Calculation_1749366987463086084]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Custom&apos; THEN&#13;&#10;    TRUE&#13;&#10;ELSE&#13;&#10;    FALSE&#13;&#10;END' />
