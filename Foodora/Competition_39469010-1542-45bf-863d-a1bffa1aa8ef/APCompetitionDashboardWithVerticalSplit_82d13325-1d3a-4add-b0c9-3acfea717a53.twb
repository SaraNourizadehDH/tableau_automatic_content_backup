              <calculation class='tableau' formula='IF [granularity] = &apos;weekly&apos; THEN&#13;&#10;IF [date_value] &gt;= &#13;&#10;DATEADD(&apos;week&apos;,-6,datetrunc(&apos;week&apos;,{MAX([date_value] )})) &#13;&#10;AND [date_value] &lt;= DATEADD(&apos;week&apos;, 0,TODAY()) THEN&#13;&#10;&quot;True&quot;&#13;&#10;ELSE &quot;False&quot;&#13;&#10;END&#13;&#10;ELSEIF  [granularity] = &quot;monthly&quot; THEN&#13;&#10;IF [date_value]  &gt;= DATEADD(&apos;month&apos;,-6,datetrunc(&apos;month&apos;,{MAX([date_value] )}))&#13;&#10;AND [date_value] &lt;= DATEADD(&apos;month&apos;, -1,TODAY()) THEN&#13;&#10;&quot;True&quot;&#13;&#10;ELSE &quot;False&quot;&#13;&#10;END&#13;&#10;ELSE &quot;False&quot;&#13;&#10;END' />
