            <column caption='orders_adj (copy)' datatype='real' name='[orders_adj (copy)_1476336294393847808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;taiwan&quot;&#13;&#10;    AND [date_value] &gt;= #2025-06-30#&#13;&#10;    AND [date_value] &lt;= #2025-07-07#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN ZN([orders_adj]) * (ZN([error_prcnt]) + 0.45)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;taiwan&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-14#&#13;&#10;    AND [date_value] &lt;= #2025-07-28#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN ZN([orders_adj]) * (ZN([error_prcnt]) + 0.3)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;taiwan&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-01#&#13;&#10;    AND [date_value] &lt;= #2025-07-31#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;monthly&quot;&#13;&#10;THEN ZN([orders_adj])*0.9&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] = #2025-06-30#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN ZN([orders_adj]) * (ZN([error_prcnt]) + 0.4)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] = #2025-07-07#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN ZN([orders_adj]) * (ZN([error_prcnt]) + 0.25)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] = #2025-07-14#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN ZN([orders_adj]) * 0.7&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-14#&#13;&#10;    AND [date_value] &lt;= #2025-07-31#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN ZN([orders_adj])*.75&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-01#&#13;&#10;    AND [date_value] &lt;= #2025-07-31#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;monthly&quot;&#13;&#10;THEN ZN([orders_adj])*.725&#13;&#10;ELSE ZN([orders_adj])&#13;&#10;END' />
            </column>
