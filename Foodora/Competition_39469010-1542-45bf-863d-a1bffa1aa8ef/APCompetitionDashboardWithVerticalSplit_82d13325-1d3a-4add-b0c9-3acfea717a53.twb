      <repository-location id='CustomerBehaviourDetailedView' path='/t/Foodora/workbooks/APCompDashWithVerticalSplit' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (pandata_ap_mktg)' name='federated.18dajj21lpwep91aifks41rr409l' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eur&quot;'>
              <calculation class='tableau' formula='&quot;Eur&quot;' />
            </column>
            <column alias='Last 6' caption='Custom Date Range' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Last 6&quot;'>
              <calculation class='tableau' formula='&quot;Last 6&quot;' />
              <aliases>
                <alias key='&quot;Custom Date Range&quot;' value='Custom' />
                <alias key='&quot;Last 6&quot;' value='Last 6' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18dajj21lpwep91aifks41rr409l'>
            <column caption='afv_adj_eur_2' datatype='real' name='[CP (copy)_3191081833215025159]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF ([brand_name] = &quot;Deliveroo&quot; OR [brand_name] = &quot;UberEats&quot; OR [brand_name] = &quot;UE Dmart&quot;) THEN [Calculation_819092188382683146] ELSE [gfv_adj_eur] END)/SUM([orders_adj])' />
            </column>
            <column caption='orders per customer' datatype='real' name='[Calculation_1170935941591343104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_adj])/SUM([customer_adj])' />
            </column>
            <column caption='avg_df_adj' datatype='real' name='[Calculation_1170935941591531521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Eur&apos; THEN sum([df_eur_adj])/SUM([df_orders_adj])&#10;WHEN &apos;Local&apos; THEN sum([df_local_adj])/SUM([df_orders_adj])&#10;END' />
            </column>
            <column caption='Last6Period' datatype='string' name='[Calculation_139048643610664962]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;weekly&apos; THEN&#13;&#10;    IF DATEDIFF(&apos;week&apos;, DATETRUNC(&apos;week&apos;, {MAX([date_value])}), DATETRUNC(&apos;week&apos;, TODAY())) &gt; 1 THEN&#13;&#10;        IF [date_value] &gt;= DATEADD(&apos;week&apos;, -5, DATETRUNC(&apos;week&apos;, {MAX([date_value])})) &#13;&#10;        AND [date_value] &lt; DATEADD(&apos;week&apos;, 1, DATETRUNC(&apos;week&apos;, {MAX([date_value])})) THEN&#13;&#10;            &quot;True&quot;&#13;&#10;        END&#13;&#10;    ELSE&#13;&#10;        IF [date_value] &gt;= DATEADD(&apos;week&apos;, -6, DATETRUNC(&apos;week&apos;, TODAY())) &#13;&#10;        AND [date_value] &lt; DATETRUNC(&apos;week&apos;, TODAY()) THEN&#13;&#10;            &quot;True&quot;&#13;&#10;        END&#13;&#10;    END&#13;&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN&#13;&#10;    IF [date_value] &gt;= DATEADD(&apos;month&apos;, -5, DATETRUNC(&apos;month&apos;, {MAX([date_value])}))&#13;&#10;    AND [date_value] &lt;= DATEADD(&apos;month&apos;, 0, TODAY()) THEN&#13;&#10;        &quot;True&quot;&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_1749366987462377475]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Last 6&apos; THEN&#13;&#10;    ISNULL([Calculation_139048643610664962]) = FALSE&#13;&#10;ELSE&#13;&#10;    TRUE&#13;&#10;END' />
            </column>
            <column caption='Custom Range Filter' datatype='boolean' name='[Calculation_1749366987463086084]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Custom&apos; THEN&#13;&#10;    TRUE&#13;&#10;ELSE&#13;&#10;    FALSE&#13;&#10;END' />
            </column>
            <column caption='Vertical Filter Rule' datatype='boolean' name='[Calculation_2018808967997255681]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;weekly&apos; THEN ([vertical] = &apos;Food&apos; OR [vertical] = &apos;All&apos;) ELSEIF&#10;[granularity] = &apos;monthly&apos; THEN [vertical] = [vertical] ELSE NULL END' />
            </column>
            <column caption='net_gmv_adj_eur' datatype='real' name='[Calculation_819092188382683146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] &gt;= #2025-06-30#&#13;&#10;    AND [date_value] &lt;= #2025-07-06#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN (ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])) * (ZN([error_prcnt]) + 0.4)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] = #2025-07-07#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN (ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])) * (ZN([error_prcnt]) + 0.3)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-07#&#13;&#10;    AND [date_value] &lt;= #2025-08-03#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN (ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])) * (ZN([error_prcnt]) + 0.1)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;philippines&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-01#&#13;&#10;    AND [date_value] &lt;= #2025-07-31#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;monthly&quot;&#13;&#10;THEN (ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])) * .8&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;taiwan&quot;&#13;&#10;    AND [date_value] &gt;= #2025-06-30#&#13;&#10;    AND [date_value] &lt;= #2025-07-13#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN (ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])) * (ZN([error_prcnt]) + 0.4)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;taiwan&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-14#&#13;&#10;    AND [date_value] &lt;= #2025-07-28#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;weekly&quot;&#13;&#10;THEN (ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])) * (ZN([error_prcnt]) + 0.25)&#13;&#10;ELSEIF&#13;&#10;    LOWER([Country (copy)_1182124562073939969]) = &quot;taiwan&quot;&#13;&#10;    AND [date_value] &gt;= #2025-07-01#&#13;&#10;    AND [date_value] &lt;= #2025-07-31#&#13;&#10;    AND (LOWER([brand_name]) != &quot;foodpanda&quot; AND LOWER([brand_name]) != &quot;dmart&quot;)&#13;&#10;    AND LOWER([granularity]) = &quot;monthly&quot;&#13;&#10;THEN (ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])) * 0.9&#13;&#10;ELSE ZN([gross_gmv_adj_eur]) - ZN([incentives_adj_eur])&#13;&#10;END' />
            </column>
