      <column caption='net_gmv' datatype='real' name='[Calculation_2465087545384271872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Eur&quot; THEN [net_gmv_eur]&#10;WHEN &quot;Local&quot; THEN [net_gmv_local]&#10;END' />
      </column>
      <column caption='Last6Period' datatype='string' name='[Calculation_271904882836090899]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;weekly&apos; THEN&#13;&#10;IF [date_value] &gt;= &#13;&#10;DATEADD(&apos;week&apos;,-6,datetrunc(&apos;week&apos;,{MAX([date_value] )})) &#13;&#10;AND [date_value] &lt;= DATEADD(&apos;week&apos;, 0,TODAY()) THEN&#13;&#10;&quot;True&quot;&#13;&#10;ELSE &quot;False&quot;&#13;&#10;END&#13;&#10;ELSEIF  [granularity] = &quot;monthly&quot; THEN&#13;&#10;IF [date_value]  &gt;= DATEADD(&apos;month&apos;,-6,datetrunc(&apos;month&apos;,{MAX([date_value] )}))&#13;&#10;AND [date_value] &lt;= DATEADD(&apos;month&apos;, -1,TODAY()) THEN&#13;&#10;&quot;True&quot;&#13;&#10;ELSE &quot;False&quot;&#13;&#10;END&#13;&#10;ELSE &quot;False&quot;&#13;&#10;END' />
      </column>
      <column caption='Metric Estimated' datatype='real' name='[Metric (copy)_6422766395627810819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#13;&#10;WHEN &apos;GMV&apos; THEN [Calculation_2465087545384271872]&#13;&#10;WHEN &apos;Orders&apos; THEN [orders]&#13;&#10;END' />
      </column>
