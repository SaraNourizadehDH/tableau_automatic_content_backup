        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0n1ce2z0tntuvu14vo6q80882d4l' name='Custom SQL Query' type='text'>WITH max_batch_date AS (&#13;
    SELECT&#13;
    MAX(batch_date) AS latest_batch_date&#13;
  FROM `fulfillment-dwh-production.curated_data_shared_intl_markets_business.aads_seagull_mai_imports`&#13;
  WHERE LOWER(brand_name) = &quot;foodpanda&quot;&#13;
    AND UPPER(country_code) IN (&quot;PH&quot;, &quot;TW&quot;)&#13;
    AND DATE(order_time) &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 24 MONTH)&#13;
),&#13;
&#13;
seagull_orders AS (&#13;
  SELECT&#13;
    DISTINCT &quot;weekly&quot; AS granularity,&#13;
    CONCAT(&quot;FP_&quot;, UPPER(country_code)) AS global_entity_id,&#13;
    DATE(DATE_TRUNC(order_time, ISOWEEK)) AS order_date,&#13;
    order_id AS order_code&#13;
  FROM `fulfillment-dwh-production.curated_data_shared_intl_markets_business.aads_seagull_mai_imports` AS mai&#13;
  INNER JOIN max_batch_date&#13;
         ON max_batch_date.latest_batch_date = mai.batch_date&#13;
  WHERE LOWER(brand_name) = &quot;foodpanda&quot;&#13;
    AND UPPER(country_code) IN (&quot;PH&quot;, &quot;TW&quot;)&#13;
    AND DATE(order_time) &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 24 MONTH)&#13;
&#13;
  UNION ALL&#13;
&#13;
  SELECT&#13;
    DISTINCT &quot;monthly&quot; AS granularity,&#13;
    CONCAT(&quot;FP_&quot;, UPPER(country_code)) AS global_entity_id,&#13;
    DATE(DATE_TRUNC(order_time, MONTH)) AS order_date,&#13;
    order_id AS order_code&#13;
  FROM `fulfillment-dwh-production.curated_data_shared_intl_markets_business.aads_seagull_mai_imports` AS mai&#13;
  INNER JOIN max_batch_date&#13;
         ON max_batch_date.latest_batch_date = mai.batch_date&#13;
  WHERE LOWER(brand_name) = &quot;foodpanda&quot;&#13;
    AND UPPER(country_code) IN (&quot;PH&quot;, &quot;TW&quot;)&#13;
    AND DATE(order_time) &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 24 MONTH)&#13;
),&#13;
&#13;
seagull_customers AS (&#13;
  SELECT&#13;
    DISTINCT o.global_entity_id,&#13;
    o.customer_code&#13;
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS o&#13;
  INNER JOIN seagull_orders&#13;
          ON seagull_orders.global_entity_id = o.global_entity_id&#13;
         AND seagull_orders.order_code = o.order_code&#13;
  WHERE created_date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 24 MONTH)&#13;
),&#13;
&#13;
all_seagull_customer_orders_internal AS (&#13;
  SELECT&#13;
    &quot;weekly&quot; AS granularity,&#13;
    o.global_entity_id,&#13;
    DATE(DATE_TRUNC(created_date_local, ISOWEEK)) AS order_date,&#13;
    COUNT(DISTINCT IF(is_successful AND is_gross_order, order_code, NULL)) AS actual_order_count&#13;
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS o&#13;
  INNER JOIN seagull_customers&#13;
          ON seagull_customers.global_entity_id = o.global_entity_id&#13;
         AND seagull_customers.customer_code = o.customer_code&#13;
  WHERE created_date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 24 MONTH)&#13;
    AND o.global_entity_id IN (&quot;FP_PH&quot;, &quot;FP_TW&quot;)&#13;
  GROUP BY ALL&#13;
&#13;
  UNION ALL&#13;
&#13;
   SELECT&#13;
    &quot;monthly&quot; AS granularity,&#13;
    o.global_entity_id,&#13;
    DATE(DATE_TRUNC(created_date_local, MONTH)) AS order_date,&#13;
    COUNT(DISTINCT IF(is_successful AND is_gross_order, order_code, NULL)) AS actual_order_count&#13;
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS o&#13;
  INNER JOIN seagull_customers&#13;
          ON seagull_customers.global_entity_id = o.global_entity_id&#13;
         AND seagull_customers.customer_code = o.customer_code&#13;
  WHERE created_date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 24 MONTH)&#13;
    AND o.global_entity_id IN (&quot;FP_PH&quot;, &quot;FP_TW&quot;)&#13;
  GROUP BY ALL&#13;
),&#13;
&#13;
final_sg_orders AS (&#13;
  SELECT&#13;
    seagull_orders.granularity,&#13;
    seagull_orders.global_entity_id,&#13;
    cc.name AS country_name,&#13;
    seagull_orders.order_date,&#13;
    COUNT(DISTINCT seagull_orders.order_code) AS seagull_orders,&#13;
    MAX(actual_order_count) AS fp_internal_order_count&#13;
  FROM seagull_orders&#13;
  LEFT JOIN all_seagull_customer_orders_internal&#13;
         ON all_seagull_customer_orders_internal.global_entity_id = seagull_orders.global_entity_id&#13;
        AND all_seagull_customer_orders_internal.order_date = seagull_orders.order_date&#13;
        AND all_seagull_customer_orders_internal.granularity = seagull_orders.granularity&#13;
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.pandora__core_countries` AS cc&#13;
       ON cc.global_entity_id = seagull_orders.global_entity_id&#13;
  GROUP BY ALL&#13;
),&#13;
&#13;
sg_raw_data AS (&#13;
SELECT *, &#13;
IF((LOWER(country_name) IN (&quot;philippines&quot;, &quot;taiwan&quot;) AND granularity IN (&quot;weekly&quot;) AND date_value BETWEEN &quot;2025-06-30&quot; AND &quot;2025-08-03&quot;)&#13;
OR (LOWER(country_name) IN (&quot;philippines&quot;, &quot;taiwan&quot;) AND granularity IN (&quot;monthly&quot;) AND date_value BETWEEN &quot;2025-07-01&quot; AND &quot;2025-07-31&quot;), TRUE, FALSE) has_data_issues&#13;
FROM `pd-data--adhoc.sandbox__pd_markets_apac.AP_Comp_Dash`&#13;
WHERE date_value &gt;&gt;= &quot;2021-01-01&quot;&#13;
)&#13;
&#13;
SELECT &#13;
DISTINCT sg_raw_data.*EXCEPT(has_data_issues), SAFE_DIVIDE(final_sg_orders.seagull_orders, final_sg_orders.fp_internal_order_count) AS error_prcnt,&#13;
seagull_orders,&#13;
final_sg_orders.order_date,&#13;
final_sg_orders.global_entity_id&#13;
FROM sg_raw_data&#13;
LEFT JOIN final_sg_orders&#13;
       ON final_sg_orders.granularity = sg_raw_data.granularity&#13;
      AND DATE(final_sg_orders.order_date) = DATE(sg_raw_data.date_value)&#13;
      AND UPPER(final_sg_orders.country_name) = UPPER(sg_raw_data.country_name)&#13;
---WHERE NOT has_data_issues</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
