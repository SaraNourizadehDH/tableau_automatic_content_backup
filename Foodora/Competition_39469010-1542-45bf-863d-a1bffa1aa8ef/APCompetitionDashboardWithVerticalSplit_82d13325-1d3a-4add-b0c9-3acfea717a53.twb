    <datasource caption='Custom SQL Query (pandata_ap_mktg)' inline='true' name='federated.18dajj21lpwep91aifks41rr409l' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='AP Comp Dash' name='bigquery.0n1ce2z0tntuvu14vo6q80882d4l'>
            <connection CATALOG='dhh---analytics-apac' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata APAC Production' schema='pandata_ap_mktg' server-oauth='' username='sakthi.ganesh@foodpanda.com' workgroup-auth-mode='prompt' />
