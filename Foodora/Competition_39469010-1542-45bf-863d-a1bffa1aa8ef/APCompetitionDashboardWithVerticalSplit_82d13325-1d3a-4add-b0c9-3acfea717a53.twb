                <zone forceUpdate='true' h='9215' id='1339' type-v2='text' w='67359' x='642' y='17070'>
                  <formatted-text>
                    <run fontcolor='#000000'>Select &quot;</run>
                    <run bold='true' fontcolor='#000000'>Custom</run>
                    <run fontcolor='#000000'> &quot; in &quot;</run>
                    <run bold='true' fontcolor='#000000'>Date Selection Type&quot;</run>
                    <run fontcolor='#000000'> filter to use &quot;</run>
                    <run bold='true' fontcolor='#000000'>Custom Date Range&quot;</run>
                    <run fontcolor='#000000'> Filter</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>select &quot;All&quot; only: </run>
                    <run fontcolor='#000000'>display combined figures for </run>
                    <run bold='true' fontcolor='#000000'>all verticals</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>select individual vertical: </run>
                    <run fontcolor='#000000'>display figures for </run>
                    <run bold='true' fontcolor='#000000'>individual vertical</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>select &quot;Grocery&quot; and/or &quot;Pickup&quot; verticals: </run>
                    <run fontcolor='#000000'>only available for monthly view due to insufficient sample size</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>TW and PH data for week starting </run>
                    <run bold='true' fontcolor='#e15759'>30th June, 2025</run>
                    <run bold='true' fontcolor='#000000'>Æ </run>
                    <run fontcolor='#000000'>and </run>
                    <run bold='true' fontcolor='#e15759'>7th July, 2025</run>
                    <run fontcolor='#000000'> have data issues and </run>
                    <run bold='true' fontcolor='#e15759'>should not</run>
                    <run fontcolor='#000000'> be refered.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#e15759'>July, 2025</run>
                    <run fontcolor='#000000'> Monthly data is partial due to data issues in source.</run>
                    <run>Æ&#10;</run>
