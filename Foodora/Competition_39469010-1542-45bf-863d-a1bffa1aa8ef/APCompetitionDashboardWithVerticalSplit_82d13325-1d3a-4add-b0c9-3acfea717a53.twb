              <calculation class='tableau' formula='IF ATTR([country_name]) != &apos;Taiwan&apos; AND ATTR([country_name]) != &apos;Hong_Kong&apos; AND ATTR([country_name]) != &apos;Philippines&apos; &#13;&#10;AND ATTR([brand_name]) = &apos;Foodpanda&apos; THEN&#13;&#10;(SUM({FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;Foodpanda&quot; then [subscriber_penetration] end) }) -&#13;&#10;SUM({FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;GrabFood&quot; then [subscriber_penetration] end) }))/2&#13;&#10;&#13;&#10;ELSE NULL&#13;&#10;&#13;&#10;END' />
