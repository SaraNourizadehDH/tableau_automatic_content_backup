            <column caption='gfv_adj' datatype='real' name='[afv_adj (copy)_847591591454089225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;Eur&apos; THEN [gfv_adj_eur]&#13;&#10;WHEN &apos;Local&apos; THEN [gfv_adj_local]&#13;&#10;END' />
            </column>
            <column caption='afv_adj_local_2' datatype='real' name='[afv_adj_eur_2 (copy)_273382606516240384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF ([brand_name] = &quot;Deliveroo&quot; OR [brand_name] = &quot;UberEats&quot; OR [brand_name] = &quot;UE Dmart&quot;) THEN [net_gmv_adj_eur (copy)_847591591449104384] ELSE [gfv_adj_local] END)/SUM([orders_adj])' />
            </column>
