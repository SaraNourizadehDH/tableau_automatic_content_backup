      <repository-location id='ZoneLevelCP' path='/t/Foodora/workbooks/APCompDashWithVerticalSplit' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='AP_Comp_Zone_CP' name='federated.0tvr6m41y3g7ib170hxm613anb91' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eur&quot;'>
              <calculation class='tableau' formula='&quot;Eur&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0tvr6m41y3g7ib170hxm613anb91'>
            <column caption='net_gmv' datatype='real' name='[Calculation_2465087545384271872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Eur&quot; THEN [net_gmv_eur]&#10;WHEN &quot;Local&quot; THEN [net_gmv_local]&#10;END' />
            </column>
            <column caption='Metric Estimated' datatype='real' name='[Metric (copy)_6422766395627810819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#13;&#10;WHEN &apos;GMV&apos; THEN [Calculation_2465087545384271872]&#13;&#10;WHEN &apos;Orders&apos; THEN [orders]&#13;&#10;END' />
            </column>
            <column datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='datetime' name='[date_value]' role='dimension' type='ordinal' />
            <column datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column datatype='string' name='[is_capital]' role='dimension' type='nominal' />
