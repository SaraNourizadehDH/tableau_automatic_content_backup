    <worksheet name='Competitor Promotion Tracking'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <repository-location id='CompetitorPromotionTracking' path='/t/Foodora/workbooks/APCompDashWithVerticalSplit' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='Promo Tracker' name='federated.1i5kdxj01ln2un1dim09t066d9zk' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 6' caption='Custom Date Range' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Last 6&quot;'>
              <calculation class='tableau' formula='&quot;Last 6&quot;' />
              <aliases>
                <alias key='&quot;Custom Date Range&quot;' value='Custom' />
                <alias key='&quot;Last 6&quot;' value='Last 6' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1i5kdxj01ln2un1dim09t066d9zk'>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_1597370500399808512]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Last 6&apos; THEN&#13;&#10;    ISNULL([Calculation_360006500393250833]) = FALSE&#13;&#10;ELSE&#13;&#10;    TRUE&#13;&#10;END' />
            </column>
            <column caption='Previous Week' datatype='integer' name='[Calculation_360006500391559181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP(sum([seagull_orders]),1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='WoW % Change' datatype='real' name='[Calculation_360006500391747598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([seagull_orders])-[Calculation_360006500391559181])/[Calculation_360006500391559181]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% Redemption' datatype='real' name='[Calculation_360006500391862287]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[seagull_orders]/[total_order]' />
            </column>
            <column caption='Seagull icpgmv' datatype='real' name='[Calculation_360006500392009744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [date_value], [brand_name], [country_name], [Promo Code (copy)_3175811814614306816] : SUM([seagull_incentive_eur])} / &#10;({FIXED [date_value], [brand_name], [country_name], [Promo Code (copy)_3175811814614306816] : SUM([seagull_gmv_eur])} + &#10; {FIXED [date_value], [brand_name], [country_name], [Promo Code (copy)_3175811814614306816] : SUM([seagull_incentive_eur])})' />
            </column>
            <column caption='Last6Period' datatype='string' name='[Calculation_360006500393250833]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [date_value] &gt;= DATEADD(&apos;week&apos;,-7,datetrunc(&apos;week&apos;,TODAY())) then&#13;&#10;&quot;True&quot;&#13;&#10;END' />
            </column>
            <column caption='Custom Date Range Filter' datatype='boolean' name='[Calculation_97390364390252544]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Custom&apos; THEN&#13;&#10;    TRUE&#13;&#10;ELSE&#13;&#10;    FALSE&#13;&#10;END' />
