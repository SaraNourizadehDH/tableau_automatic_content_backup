        <zone forceUpdate='true' h='6750' id='18' type-v2='text' w='25611' x='37333' y='22375'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#f8d47c' fontsize='12'>GMV</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='background-color' value='#00008f' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='62375' id='20' type-v2='text' w='26889' x='64389' y='36750'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' underline='true'>Competitor for Benchmarking</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>• TW: UberEats</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>• MY, PH, TH, SG: Grab</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>• HK: Deliveroo</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' underline='true'>Definition (all metrics are on a monthly basis)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold'>Order</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>• FP Order CP: FP Order/Total Market Order</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>• % Diff in Customers: (FP Customers /Competitor Customers)-1</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>• Diff in Order Freq*: FP Order Freq - Competitor Order Freq </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='8'>   *</run>
            <run bold='true' fontcolor='#555555' fontsize='8'>Æ </run>
            <run bold='true' fontcolor='#000000' fontsize='8'>where Order Freq = Total Orders/Total Unique Customer</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold'>GMV</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>• FP GMV CP:  FP GMV/Total Market GMV</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>• % Diff in AFV: (FP AFV /Competitor AFV)-1</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>• % Diff in DF: (FP DF /Competitor DF)-1</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold'>Subscription</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>• Diff in Subscriber Penetration: </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>FP Sub. Penetration% - Competitor Sub. Penetration%</run>
            <run>Æ&#10;&#10;</run>
