quot; then [df_orders] end) }))&#13;&#10;&#13;&#10;/&#13;&#10;&#13;&#10;(sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;GrabFood&quot; then [df_eur] end) })/&#13;&#10;sum({ FIXED [country_name],[vertical],[date_value],[granularity]: sum( if [brand_name] = &quot;GrabFood&quot; then [df_orders]  end) }))&#13;&#10;-1&#13;&#10;&#13;&#10;ELSE 0&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='incentives_corrected' datatype='real' name='[Calculation_1064256893199130640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[incentives_adj_eur]*[incentive_spend_error_ratio]' />
      </column>
      <column caption='orders per customer' datatype='real' name='[Calculation_1170935941591343104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_adj])/SUM([customer_adj])' />
      </column>
      <column caption='avg_df_adj' datatype='real' name='[Calculation_1170935941591531521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Eur&apos; THEN sum([df_eur_adj])/SUM([df_orders_adj])&#10;WHEN &apos;Local&apos; THEN sum([df_local_adj])/SUM([df_orders_adj])&#10;END' />
      </column>
      <column caption='incentive_share' datatype='real' name='[Calculation_1170935941593546755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([incentivised_orders])/SUM([orders_adj])' />
      </column>
      <column caption='incentives_corrected_lower' datatype='real' name='[Calculation_1209497993217138704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[incentives_adj_eur_lower]*[incentive_spend_error_ratio]' />
      </column>
      <column caption='incentives_corrected_range' datatype='real' name='[Calculation_1209497993217445906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[incentives_adj_eur_corrected_lower (copy)_1209497993217355793]-[Calculation_1209497993217138704]' />
      </column>
      <column caption='Last6Period' datatype='string' name='[Calculation_139048643610664962]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;weekly&apos; THEN&#13;&#10;    IF DATEDIFF(&apos;week&apos;, DATETRUNC(&apos;week&apos;, {MAX([date_value])}), DATETRUNC(&apos;week&apos;, TODAY())) &gt; 1 THEN&#13;&#10;        IF [date_value] &gt;= DATEADD(&apos;week&apos;, -5, DATETRUNC(&apos;week&apos;, {MAX([date_value])})) &#13;&#10;        AND [date_value] &lt; DATEADD(&apos;week&apos;, 1, DATETRUNC(&apos;week&apos;, {MAX([date_value])})) THEN&#13;&#10;            &quot;True&quot;&#13;&#10;        END&#13;&#10;    ELSE&#13;&#10;        IF [date_value] &gt;= DATEADD(&apos;week&apos;, -6, DATETRUNC(&apos;week&apos;, TODAY())) &#13;&#10;        AND [date_value] &lt; DATETRUNC(&apos;week&apos;, TODAY()) THEN&#13;&#10;            &quot;True&quot;&#13;&#10;        END&#13;&#10;    END&#13;&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN&#13;&#10;    IF [date_value] &gt;= DATEADD(&apos;month&apos;, -5, DATETRUNC(&apos;month&apos;, {MAX([date_value])}))&#13;&#10;    AND [date_value] &lt;= DATEADD(&apos;month&apos;, 0, TODAY()) THEN&#13;&#10;        &quot;True&quot;&#13;&#10;    END&#13;&#10;END' />
      </column>
      <column caption='CP' datatype='real' name='[Calculation_139048643611381763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#13;&#10;WHEN &apos;GMV&apos; THEN [CP (copy)_847591591449579522]&#13;&#10;WHEN &apos;Orders&apos; THEN [orders_adj (copy)_1476336294393847808] &#13;&#10;END' />
      </column>
      <column caption='icpgmv' datatype='real' name='[Calculation_139048643626651657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([incentives_adj_eur])/SUM([gross_gmv_adj_eur])' />
      </column>
      <column caption='icpgmv_corrected' datatype='real' name='[Calculation_139048643626926090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([incentives_adj_eur])/sum([gross_gmv_adj_eur])*avg([icpgmv_error_ratio])' />
      </column>
      <column caption='icpigmv' datatype='real' name='[Calculation_139048643628969995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([incentives_adj_eur])/sum([incentivised_gmv_adj_eur])' />
      </column>
      <column caption='icpigmv_corrected' datatype='real' name='[Calculation_139048643629113356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([incentives_adj_eur])/sum([incentivised_gmv_adj_eur])*avg([icpigmv_error_ratio])' />
      </column>
      <column caption='range_incentive_share' datatype='real' name='[Calculation_139048643633307668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[lower_ci_incentive_share (copy)_139048643633205267]-[lower_ci_incentive_spend (copy)_139048643633041426]' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_1749366987462377475]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Last 6&apos; THEN&#13;&#10;    ISNULL([Calculation_139048643610664962]) = FALSE&#13;&#10;ELSE&#13;&#10;    TRUE&#13;&#10;END' />
      </column>
      <column caption='Custom Range Filter' datatype='boolean' name='[Calculation_1749366987463086084]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Custom&apos; THEN&#13;&#10;    TRUE&#13;&#10;ELSE&#13;&#10;    FALSE&#13;&#10;END' />
      </column>
      <column caption='Vertical Filter Rule' datatype='boolean' name='[Calculation_2018808967997255681]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;weekly&apos; THEN ([vertical] = &apos;Food&apos; OR [vertical] = &apos;All&apos;) ELSEIF&#10;[granularity] = &apos;monthly&apos; THEN [vertical] = [vertical] ELSE NULL END' />
      </column>
      <column caption='orders growth' datatype='real' name='[Calculation_3092565594298937346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders_adj (copy)_1476336294393847808]' />
      </column>
      <column caption='CP Threshold' datatype='real' name='[Calculation_3105724545500454912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Malaysia&#10;IF MAX([country_name]) = &quot;Malaysia&quot; THEN&#10;    IF COUNTD([is_capital]) &gt;= 2 THEN 0.3&#10;    ELSEIF AVG(LEN([is_capital])) = 7 THEN 0.28&#10;    ELSEIF AVG(LEN([is_capital])) = 10 THEN 0.34 ELSE 0.3&#10;    END&#10;//Cambodia&#10;ELSEIF MAX([country_name]) = &quot;Cambodia&quot; THEN&#10;    IF COUNTD([is_capital]) &gt;= 2 THEN 0.4&#10;    ELSEIF AVG(LEN([is_capital])) = 7 THEN 0.41&#10;    ELSEIF AVG(LEN([is_capital])) = 10 THEN 0.37 ELSE 0.4&#10;    END&#10;//Singapore&#10;ELSEIF MAX([country_name]) = &quot;Singapore&quot; THEN 0.25&#10;//Hong_Kong&#10;ELSEIF MAX([country_name]) = &quot;Hong_Kong&quot; THEN 0.45&#10;//Philippines&#10;ELSEIF MAX([country_name]) = &quot;Philippines&quot; THEN&#10;    IF COUNTD([is_capital]) &gt;= 2 THEN 0.38&#10;    ELSEIF AVG(LEN([is_capital])) = 7 THEN 0.3&#10;    ELSEIF AVG(LEN([is_capital])) = 10 THEN 0.55 ELSE 0.38&#10;    END&#10;//Thailand&#10;ELSEIF MAX([country_name]) = &quot;Thailand&quot; THEN&#10;    IF COUNTD([is_capital]) &gt;= 2 THEN 0.1&#10;    ELSEIF AVG(LEN([is_capital])) = 7 THEN 0.095&#10;    ELSEIF AVG(LEN([is_capital])) = 10 THEN 0.11 ELSE 0.1&#10;    END&#10;//Taiwan&#10;ELSEIF MAX([country_name]) = &quot;Taiwan&quot; THEN&#10;    IF COUNTD([is_capital]) &gt;= 2 THEN 0.585&#10;    ELSEIF AVG(LEN([is_capital])) = 7 THEN 0.48&#10;    ELSEIF AVG(LEN([is_capital])) = 10 THEN 0.65 ELSE 0.585&#10;    END&#10;END' />
      </column>
      <column caption='date_value_max' datatype='boolean' name='[Calculation_3105724545502892033]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date_value] = {FIXED [granularity]:MAX([date_value])}' />
      </column>
      <column caption='L12P - Date' datatype='datetime' name='[Calculation_3105724545502990338]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [granularity]&#10;WHEN &apos;monthly&apos; THEN DATEADD(&apos;month&apos;,-12,[date_value])&#10;WHEN &apos;weekly&apos; THEN DATEADD(&apos;week&apos;,-12,[date_value])&#10;END' />
      </column>
      <column caption='L6P - Date' datatype='datetime' name='[Calculation_3105724545507459075]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [granularity]&#10;WHEN &apos;monthly&apos; THEN DATEADD(&apos;month&apos;,-6,[date_value])&#10;WHEN &apos;weekly&apos; THEN DATEADD(&apos;week&apos;,-6,[date_value])&#10;END' />
      </column>
      <column caption='L3P - Date' datatype='datetime' name='[Calculation_3105724545507528708]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [granularity]&#10;WHEN &apos;monthly&apos; THEN DATEADD(&apos;month&apos;,-3,[date_value])&#10;WHEN &apos;weekly&apos; THEN DATEADD(&apos;week&apos;,-3,[date_value])&#10;END' />
      </column>
