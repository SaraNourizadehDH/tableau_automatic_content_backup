      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (pandata_ap_mktg)' name='federated.18dajj21lpwep91aifks41rr409l' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 6' caption='Custom Date Range' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Last 6&quot;'>
              <calculation class='tableau' formula='&quot;Last 6&quot;' />
              <aliases>
                <alias key='&quot;Custom Date Range&quot;' value='Custom' />
                <alias key='&quot;Last 6&quot;' value='Last 6' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18dajj21lpwep91aifks41rr409l'>
            <column caption='incentive_share' datatype='real' name='[Calculation_1170935941593546755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([incentivised_orders])/SUM([orders_adj])' />
            </column>
            <column caption='Last6Period' datatype='string' name='[Calculation_139048643610664962]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;weekly&apos; THEN&#13;&#10;    IF DATEDIFF(&apos;week&apos;, DATETRUNC(&apos;week&apos;, {MAX([date_value])}), DATETRUNC(&apos;week&apos;, TODAY())) &gt; 1 THEN&#13;&#10;        IF [date_value] &gt;= DATEADD(&apos;week&apos;, -5, DATETRUNC(&apos;week&apos;, {MAX([date_value])})) &#13;&#10;        AND [date_value] &lt; DATEADD(&apos;week&apos;, 1, DATETRUNC(&apos;week&apos;, {MAX([date_value])})) THEN&#13;&#10;            &quot;True&quot;&#13;&#10;        END&#13;&#10;    ELSE&#13;&#10;        IF [date_value] &gt;= DATEADD(&apos;week&apos;, -6, DATETRUNC(&apos;week&apos;, TODAY())) &#13;&#10;        AND [date_value] &lt; DATETRUNC(&apos;week&apos;, TODAY()) THEN&#13;&#10;            &quot;True&quot;&#13;&#10;        END&#13;&#10;    END&#13;&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN&#13;&#10;    IF [date_value] &gt;= DATEADD(&apos;month&apos;, -5, DATETRUNC(&apos;month&apos;, {MAX([date_value])}))&#13;&#10;    AND [date_value] &lt;= DATEADD(&apos;month&apos;, 0, TODAY()) THEN&#13;&#10;        &quot;True&quot;&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='range_incentive_share' datatype='real' name='[Calculation_139048643633307668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[lower_ci_incentive_share (copy)_139048643633205267]-[lower_ci_incentive_spend (copy)_139048643633041426]' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_1749366987462377475]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Last 6&apos; THEN&#13;&#10;    ISNULL([Calculation_139048643610664962]) = FALSE&#13;&#10;ELSE&#13;&#10;    TRUE&#13;&#10;END' />
            </column>
            <column caption='Custom Range Filter' datatype='boolean' name='[Calculation_1749366987463086084]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Custom&apos; THEN&#13;&#10;    TRUE&#13;&#10;ELSE&#13;&#10;    FALSE&#13;&#10;END' />
            </column>
            <column caption='Vertical Filter Rule' datatype='boolean' name='[Calculation_2018808967997255681]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;weekly&apos; THEN ([vertical] = &apos;Food&apos; OR [vertical] = &apos;All&apos;) ELSEIF&#10;[granularity] = &apos;monthly&apos; THEN [vertical] = [vertical] ELSE NULL END' />
            </column>
            <column caption='incentive_share_corrected' datatype='real' name='[Calculation_608830413303353350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//{FIXED [vertical],[Country],[granularity],[Brand],[date_value]:AVG([incentive_share_error_ratio])}&#13;&#10;&#13;&#10;SUM([incentivised_orders])/SUM([orders_adj])*AVG([incentive_share_error_ratio])' />
            </column>
            <column caption='Brand' datatype='string' name='[brand_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Foodpanda&quot;' value='foodpanda' />
              </aliases>
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;Hong_Kong&quot;' value='Hong Kong' />
              </aliases>
            </column>
            <column datatype='date' name='[date_value]' role='dimension' type='ordinal' />
            <column datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column datatype='real' name='[incentive_share_error_ratio]' role='measure' type='quantitative' />
            <column datatype='real' name='[incentivised_orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[is_capital]' role='dimension' type='nominal' />
            <column caption='upper_ci_incentive_share' datatype='real' name='[lower_ci_incentive_share (copy)_139048643633205267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if SUM({FIXED [vertical],[country_name],[granularity],[brand_name],[date_value]:AVG([incentive_share_error_ratio])}) &gt; 1 &#13;&#10;&#13;&#10;THEN SUM([incentivised_orders])/SUM([orders_adj])*AVG([incentive_share_error_ratio])&#13;&#10;&#13;&#10;//{FIXED [vertical],[Country],[granularity],[Brand],[date_value],[is_capital]:SUM([incentivised_orders])}&#13;&#10;//{FIXED [vertical],[Country],[granularity],[Brand],[date_value],[is_capital]:SUM([orders_adj])} *&#13;&#10;//{FIXED [vertical],[Country],[granularity],[Brand],[date_value]:AVG([incentive_share_error_ratio])} &#13;&#10;&#13;&#10;ELSE SUM([incentivised_orders])/SUM([orders_adj])&#13;&#10;//{FIXED [vertical],[Country],[granularity],[Brand],[date_value],[is_capital]:SUM([incentivised_orders])}&#13;&#10;///{FIXED [vertical],[Country],[granularity],[Brand],[date_value],[is_capital]:SUM([orders_adj])}&#13;&#10;&#13;&#10;end&#13;&#10;//then [incentivised_order_share]*[incentivised_erro_ratio]&#13;&#10;//else [incentivised_order_share] END' />
            </column>
            <column caption='lower_ci_incentive_share' datatype='real' name='[lower_ci_incentive_spend (copy)_139048643633041426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if SUM({FIXED [vertical],[country_name],[granularity],[brand_name],[date_value]:AVG([incentive_share_error_ratio])}) &lt; 1 &#13;&#10;&#13;&#10;THEN SUM([incentivised_orders])/SUM([orders_adj])*AVG([incentive_share_error_ratio])&#13;&#10;&#13;&#10;//{FIXED [vertical],[Country],[granularity],[Brand],[date_value],[is_capital]:SUM([incentivised_orders])}&#13;&#10;//{FIXED [vertical],[Country],[granularity],[Brand],[date_value],[is_capital]:SUM([orders_adj])} *&#13;&#10;//{FIXED [vertical],[Country],[granularity],[Brand],[date_value]:AVG([incentive_share_error_ratio])} &#13;&#10;&#13;&#10;ELSE SUM([incentivised_orders])/SUM([orders_adj])&#13;&#10;//{FIXED [vertical],[Country],[granularity],[Brand],[date_value],[is_capital]:SUM([incentivised_orders])}&#13;&#10;///{FIXED [vertical],[Country],[granularity],[Brand],[date_value],[is_capital]:SUM([orders_adj])}&#13;&#10;&#13;&#10;end&#13;&#10;//then [incentivised_order_share]*[incentivised_erro_ratio]&#13;&#10;//else [incentivised_order_share] END' />
