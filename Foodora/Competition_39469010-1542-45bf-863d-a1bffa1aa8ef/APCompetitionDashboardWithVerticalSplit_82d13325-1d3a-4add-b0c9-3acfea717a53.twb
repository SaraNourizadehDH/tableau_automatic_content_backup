            <column caption='Brand clean' datatype='string' name='[Brand (copy)_1182124562069942272]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_name] = &quot;Cambodia&quot; THEN&#10;    CASE [brand_name]&#10;        WHEN &quot;GrabFood&quot; THEN NULL&#10;        ELSE [brand_name]&#10;    END&#10;ELSE&#10;    [brand_name]&#10;END' />
              <aliases>
