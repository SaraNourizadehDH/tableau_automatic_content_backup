      <column caption='orders CP error bound fp only' datatype='real' name='[Calculation_5876142028550074377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS(ATTR([brand_name]), &quot;Foodpanda&quot;) THEN [gmv CP error bound (copy)_5876142028545449992]&#10;ELSE NULL&#10;END' />
