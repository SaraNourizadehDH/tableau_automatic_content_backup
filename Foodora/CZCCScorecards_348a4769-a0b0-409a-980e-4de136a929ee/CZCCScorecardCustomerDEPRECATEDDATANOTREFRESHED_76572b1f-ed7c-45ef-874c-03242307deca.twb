      <column caption='AHT Target (min)' datatype='real' default-format='n#,##0;-#,##0' name='[AHT Chat (min) (copy)_1379227434078744582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(7)' />
      </column>
      <column caption='Wrap Up (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AHT Chat (min) (copy)_778841328911056896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([sum_wrap_up_time_chat_sec])/60/SUM([chat_aht_min_denominator]))' />
      </column>
      <column caption='CSAT vs Target' datatype='real' default-format='p0%' name='[AHT vs Target (copy)_1379227434087059473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1379227434076377088] / [Calculation_1379227434076827650] - 1' />
      </column>
      <column caption='QA Score' datatype='real' default-format='p0.00%' name='[CSAT (copy)_1379227434077343747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qa_score_numerator])/SUM([qa_score_denominator])/100' />
      </column>
      <column caption='Online Time' datatype='real' default-format='p0.00%' name='[CSAT (copy)_1379227434082414599]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([status_online_seconds])/&#13;&#10;( SUM(IFNULL([status_online_seconds],0))&#13;&#10;+ SUM(IFNULL([status_short_break_seconds],0))&#13;&#10;+ SUM(IFNULL([status_busy_seconds],0))&#13;&#10;+ SUM(IFNULL([status_assigned_task_seconds],0)))' />
      </column>
      <column caption='QA Target' datatype='real' default-format='p0%' name='[CSAT Target (copy)_1379227434077990916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(0.90)' />
      </column>
      <column caption='Online Time Target' datatype='real' default-format='p0%' name='[CSAT Target (copy)_1379227434082893832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(0.90)' />
      </column>
      <column caption='QA vs Target' datatype='real' default-format='p0%' name='[CSAT vs Target (copy)_1379227434087297042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CSAT (copy)_1379227434077343747] / [CSAT Target (copy)_1379227434077990916] - 1' />
      </column>
      <column caption='CSAT' datatype='real' default-format='p0.00%' name='[Calculation_1379227434076377088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_csat_4_5])/SUM([count_csat_responses])' />
      </column>
      <column caption='CSAT Responses' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1379227434076598273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_csat_responses])' />
      </column>
      <column caption='CSAT Target' datatype='real' default-format='p0%' name='[Calculation_1379227434076827650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(0.75)' />
      </column>
      <column caption='AHT Chat (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1379227434078388229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([chat_aht_min_numerator])/SUM([chat_aht_min_denominator]))/60' />
      </column>
      <column caption='Data Date' datatype='date' name='[Calculation_1379227434083688459]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([date])}' />
      </column>
      <column caption='Start of Month' datatype='datetime' name='[Calculation_1379227434083741708]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED:MAX(DATETRUNC(&quot;month&quot;,[Calculation_1379227434083688459]))}' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_1379227434084360206]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] &gt;= [Parameters].[Date Parameter] AND [date] &lt;= [Parameters].[Date From (copy)_1379227434084216845]' />
      </column>
      <column caption='Dummy 01' datatype='integer' name='[Calculation_1379227434086408207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(NULL)' />
