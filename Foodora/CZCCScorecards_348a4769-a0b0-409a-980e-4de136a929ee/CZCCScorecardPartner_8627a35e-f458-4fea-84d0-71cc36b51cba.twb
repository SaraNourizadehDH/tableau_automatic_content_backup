          <named-connection caption='BigQuery' name='bigquery.1hrdxxj0w23iq413ec6830qd6joa'>
            <connection CATALOG='damejidlo-cz-bigquery' EXECCATALOG='damejidlo-cz-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='damejidlo-cz-bigquery' schema='tableau_outputs' server-oauth='' username='matyas.kapusta@foodora.cz' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1hrdxxj0w23iq413ec6830qd6joa' name='Custom SQL Query1' type='text'>SELECT&#13;
agent_email,&#13;
reporting_to,&#13;
created_date as date,&#13;
SUM(qa_score) as qa_score_numerator,&#13;
count(evaluation_id) as qa_score_denominator &#13;
FROM `fulfillment-dwh-production.curated_data_shared.playvox_evaluations` eval&#13;
JOIN `damejidlo-cz-bigquery.master.agents` ag USING (agent_email)&#13;
WHERE eval.created_date &gt;&gt;= &quot;2024-01-01&quot;&#13;
AND eval.contact_center = &apos;Czech Republic&apos;&#13;
AND EXISTS &#13;
  (SELECT&#13;
  0&#13;
  FROM `fulfillment-dwh-production.curated_data_shared.all_contacts` ac&#13;
  WHERE ac.global_entity_id = &quot;DJ_CZ&quot;&#13;
  AND ac.created_date &gt;&gt;= &quot;2024-01-01&quot;&#13;
  AND ac.stakeholder = &quot;Vendor&quot;&#13;
  AND eval.agent_email = ac.agent_email)&#13;
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1hrdxxj0w23iq413ec6830qd6joa' name='Custom SQL Query' type='text'>WITH nonlive AS &#13;
    (SELECT&#13;
    ac.agent_email,&#13;
    ag.reporting_to,&#13;
    ac.created_date as date,&#13;
    count(distinct ac.contact_id) as nonlive_contacts&#13;
    FROM `fulfillment-dwh-production.curated_data_shared.all_contacts` ac&#13;
    JOIN `damejidlo-cz-bigquery.master.agents` ag ON ac.agent_email = ag.agent_email&#13;
    WHERE ac.global_entity_id = &apos;DJ_CZ&apos;&#13;
    AND ac.created_date &gt;&gt;= &apos;2024-01-01&apos;&#13;
    AND ac.stakeholder = &apos;Vendor&apos;&#13;
    AND ac.channel IN (&apos;Email&apos;, &apos;Form&apos;, &apos;Other&apos;) --nonlive channels&#13;
    GROUP BY 1,2,3), &#13;
calls as &#13;
    (SELECT &#13;
    ac.agent_email,&#13;
    ag.reporting_to,&#13;
    ac.created_date as date,&#13;
    count(distinct case when direction = &apos;Inbound&apos; then ac.call_id end) as calls_inbound,&#13;
    count(distinct case when direction = &apos;Outbound&apos; then ac.call_id end) as calls_outbound,&#13;
    sum(case when direction = &apos;Inbound&apos; then handling_time_secs end) as handling_time_secs_inbound,&#13;
    sum(case when direction = &apos;Outbound&apos; then handling_time_secs end) as handling_time_secs_outbound,&#13;
    FROM `fulfillment-dwh-production.curated_data_shared.all_calls` ac&#13;
    JOIN `damejidlo-cz-bigquery.master.agents` ag ON ac.agent_email = ag.agent_email&#13;
    where ac.global_entity_id = &apos;DJ_CZ&apos;&#13;
    and ac.created_date &gt;&gt;= &apos;2024-01-01&apos;&#13;
    AND ac.stakeholder = &apos;Vendor&apos;&#13;
    group by 1,2,3)&#13;
SELECT&#13;
*&#13;
FROM nonlive FULL OUTER JOIN calls USING (agent_email, reporting_to, date)</relation>
          <relation connection='bigquery.1hrdxxj0w23iq413ec6830qd6joa' name='Custom SQL Query1' type='text'>SELECT&#13;
agent_email,&#13;
reporting_to,&#13;
created_date as date,&#13;
SUM(qa_score) as qa_score_numerator,&#13;
count(evaluation_id) as qa_score_denominator &#13;
FROM `fulfillment-dwh-production.curated_data_shared.playvox_evaluations` eval&#13;
JOIN `damejidlo-cz-bigquery.master.agents` ag USING (agent_email)&#13;
WHERE eval.created_date &gt;&gt;= &quot;2024-01-01&quot;&#13;
AND eval.contact_center = &apos;Czech Republic&apos;&#13;
AND EXISTS &#13;
  (SELECT&#13;
  0&#13;
  FROM `fulfillment-dwh-production.curated_data_shared.all_contacts` ac&#13;
  WHERE ac.global_entity_id = &quot;DJ_CZ&quot;&#13;
  AND ac.created_date &gt;&gt;= &quot;2024-01-01&quot;&#13;
  AND ac.stakeholder = &quot;Vendor&quot;&#13;
  AND eval.agent_email = ac.agent_email)&#13;
GROUP BY ALL</relation>
