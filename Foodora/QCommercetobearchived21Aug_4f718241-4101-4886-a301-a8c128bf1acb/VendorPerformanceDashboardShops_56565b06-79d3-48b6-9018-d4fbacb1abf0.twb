        <calculation class='tableau' formula='SUM([Calculation_1261852366477828130])/SUM([orders])' />
      </column>
      <column aggregation='Sum' caption='comm' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1261852366477651999]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;TWD&apos; &#13;&#10;then [comm_local] else [comm_eur] end' />
      </column>
      <column aggregation='User' caption='comm_rate' datatype='real' default-format='p0.0%' default-type='quantitative' layered='true' name='[Calculation_1261852366477713440]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='SUM([Calculation_1261852366477651999])/SUM([Calculation_1261852366477426715])' />
      </column>
      <column aggregation='Sum' caption='container' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1261852366477762593]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;TWD&apos; &#13;&#10;then [container_local] else [container_eur] end' />
