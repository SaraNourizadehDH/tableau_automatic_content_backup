          <datasource-dependencies datasource='Parameters'>
            <column caption='Vendor Search' datatype='string' name='[Brand or Outlet (copy)]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column alias='Daily' caption='Date Part' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;mtd&quot;' value='Mtd' />
                <alias key='&quot;week&quot;' value='Weekly' />
                <alias key='&quot;wtd&quot;' value='Wtd' />
              </aliases>
            </column>
            <column caption='Swap Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;TWD&quot;'>
              <calculation class='tableau' formula='&quot;TWD&quot;' />
            </column>
            <column caption='Pc1 Cost' datatype='real' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='70.0'>
              <calculation class='tableau' formula='70.0' />
            </column>
            <column caption='New Customer Type' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Restaurants&quot;'>
              <calculation class='tableau' formula='&quot;Restaurants&quot;' />
            </column>
            <column caption='Brand or Outlet' datatype='string' name='[Parameter 6 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand&quot;'>
              <calculation class='tableau' formula='&quot;Brand&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1bzpziw1rz44ez0zmj8s516k6qv0'>
            <column caption='CPO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[CPA (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([Calculation_3161738081925332999]) + ZN([valid_own_discount (copy)]))/SUM([Calculation_3161738081921597443])' />
            </column>
            <column caption='NC' datatype='integer' name='[Calculation_1083115768099082243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;WHEN &apos;Platform&apos; THEN [first_orders_platform]&#13;&#10;WHEN &apos;Restaurants&apos; THEN [first_orders_restaurants]&#13;&#10;WHEN &apos;Pickup&apos; THEN [first_orders_pickup]&#13;&#10;WHEN &apos;Chain&apos; THEN [first_orders_with_this_chain]&#13;&#10;WHEN &apos;Vendor&apos; THEN [first_orders_with_this_vendor]&#13;&#10;END' />
            </column>
            <column caption='valid_gmv' datatype='real' name='[Calculation_1083115768106848262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_valid_order] THEN [Calculation_1261852366477475868] END' />
            </column>
            <column caption='eff_vx' datatype='integer' name='[Calculation_1083115768108097546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [is_valid_order] &#13;&#10;THEN [vendor_uuid]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Order Share' datatype='real' default-format='p0.0%' name='[Calculation_1083115768144236569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3161738081921597443])/SUM({INCLUDE report_date:MAX({ FIXED [report_date]:SUM([Calculation_3161738081921597443])})})' />
            </column>
            <column aggregation='Year' caption='datetrunc report_date' datatype='date' default-type='ordinal' layered='true' name='[Calculation_1261852366473306115]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;month&apos;, [report_date]))&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;iso-week&apos;, [report_date]))&#13;&#10;else date(DATETRUNC(&apos;day&apos;, [report_date]))&#13;&#10;end' />
            </column>
            <column aggregation='Sum' caption='own_discount' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1261852366476083216]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;TWD&apos; &#13;&#10;then [own_discount_local] else [own_discount_eur] end' />
            </column>
            <column aggregation='Sum' caption='eff_takein' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1261852366476451859]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;TWD&apos; &#13;&#10;then [takein_local] else [takein_eur] end&#13;&#10;+zn([Calculation_1261852366476632084]) + zn([Calculation_1261852366476750870])' />
            </column>
            <column aggregation='Sum' caption='own_df_voucher' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1261852366476632084]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;TWD&apos; &#13;&#10;then [own_df_voucher_local] else [own_df_voucher_eur] end' />
            </column>
            <column aggregation='Sum' caption='own_voucher' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1261852366476697621]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;TWD&apos; &#13;&#10;then [own_voucher_local] else [own_voucher_eur] end' />
