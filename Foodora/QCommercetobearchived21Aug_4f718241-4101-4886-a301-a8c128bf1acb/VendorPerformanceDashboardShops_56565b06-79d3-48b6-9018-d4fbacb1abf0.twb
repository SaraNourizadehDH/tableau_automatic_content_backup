          <datasource-dependencies datasource='sqlproxy.1bzpziw1rz44ez0zmj8s516k6qv0'>
            <column caption='NC' datatype='integer' name='[Calculation_1083115768099082243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;WHEN &apos;Platform&apos; THEN [first_orders_platform]&#13;&#10;WHEN &apos;Restaurants&apos; THEN [first_orders_restaurants]&#13;&#10;WHEN &apos;Pickup&apos; THEN [first_orders_pickup]&#13;&#10;WHEN &apos;Chain&apos; THEN [first_orders_with_this_chain]&#13;&#10;WHEN &apos;Vendor&apos; THEN [first_orders_with_this_vendor]&#13;&#10;END' />
            </column>
            <column caption='valid_gmv' datatype='real' name='[Calculation_1083115768106848262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_valid_order] THEN [Calculation_1261852366477475868] END' />
            </column>
            <column caption='valid_gov' datatype='real' name='[Calculation_1083115768106901511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_valid_order] THEN [Calculation_1261852366477828130] END' />
            </column>
            <column caption='daily_gmv_per_vx' datatype='real' name='[Calculation_1083115768107606025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [vendor_uuid], [report_date]:SUM([Calculation_1083115768106848262])})' />
            </column>
            <column caption='valid_comm' datatype='real' name='[Calculation_1083115768126173198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_valid_order] THEN [Calculation_1261852366477651999] END' />
            </column>
            <column caption='valid_comm_rate' datatype='real' default-format='p0.0%' name='[Calculation_1083115768127082513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1083115768126173198])/SUM([valid_orders (copy)])' />
            </column>
            <column caption='Gfv Share' datatype='real' default-format='p0.0%' name='[Calculation_1083115768143044632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_orders (copy)])/SUM({INCLUDE report_date:MAX({ FIXED [report_date]:SUM([valid_orders (copy)])})})' />
            </column>
            <column aggregation='Year' caption='datetrunc report_date' datatype='date' default-type='ordinal' layered='true' name='[Calculation_1261852366473306115]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;month&apos;, [report_date]))&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;iso-week&apos;, [report_date]))&#13;&#10;else date(DATETRUNC(&apos;day&apos;, [report_date]))&#13;&#10;end' />
            </column>
            <column aggregation='Sum' caption='own_discount' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1261852366476083216]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;TWD&apos; &#13;&#10;then [own_discount_local] else [own_discount_eur] end' />
            </column>
            <column aggregation='Sum' caption='own_voucher' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1261852366476697621]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;TWD&apos; &#13;&#10;then [own_voucher_local] else [own_voucher_eur] end' />
            </column>
            <column aggregation='Sum' caption='net_takein' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1261852366476972056]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;TWD&apos; &#13;&#10;then [takein_local] else [takein_eur] end' />
            </column>
            <column aggregation='Sum' caption='gfv' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1261852366477426715]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;TWD&apos; &#13;&#10;then [gfv_local] else [gfv_eur] end' />
            </column>
            <column aggregation='Sum' caption='gmv' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1261852366477475868]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;TWD&apos; &#13;&#10;then [gmv_local] else [gmv_eur] end' />
            </column>
            <column aggregation='Sum' caption='comm' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1261852366477651999]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;TWD&apos; &#13;&#10;then [comm_local] else [comm_eur] end' />
            </column>
            <column aggregation='Sum' caption='order_value' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1261852366477828130]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;TWD&apos; &#13;&#10;then [order_value_local] else [order_value_eur] end' />
            </column>
            <column caption='failed_rate' datatype='real' default-format='p0.0%' name='[Calculation_2761199189366972427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_rate (copy 3)])/SUM([orders])' />
            </column>
            <column caption='valid_orders' datatype='integer' name='[Calculation_3161738081921597443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_valid_order] THEN [orders] END' />
            </column>
            <column caption='daily_orders_per_vx' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3161738081923153924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [vendor_uuid], [report_date]:SUM([Calculation_3161738081921597443])})' />
            </column>
            <column caption='valid_own_discount' datatype='real' name='[Calculation_3161738081925332999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_valid_order] THEN [Calculation_1261852366476083216] END' />
            </column>
            <column caption='CPA' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3161738081935609867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([Calculation_3161738081925332999]) + ZN([valid_own_discount (copy)]))/SUM([Calculation_1083115768099082243])' />
            </column>
            <column caption='searching_vendor' datatype='boolean' name='[Calculation_406520248093827072]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Brand or Outlet (copy)] = &apos;&apos; &#10;  THEN TRUE&#10;ELSE REGEXP_MATCH(LOWER([vendor_code]+[vendor_name]),LOWER(REGEXP_REPLACE([Parameters].[Brand or Outlet (copy)],&apos; |,|;&apos;,&apos;|&apos;)))&#10;END' />
