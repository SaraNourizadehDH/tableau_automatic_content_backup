          <calculation column='[Calculation_1261852366473842698]' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(week)|(day)&apos;)&#13;&#10;then TRUE&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;mtd&apos;&#13;&#10;then [Calculation_1261852366473547782] &lt;= [Calculation_1261852366473588743]&#13;&#10;elseif [Parameters].[Parameter 1] = &apos;wtd&apos;&#13;&#10;then [Calculation_1261852366473379844] &lt;= [Calculation_1261852366473449477]&#13;&#10;end' />
