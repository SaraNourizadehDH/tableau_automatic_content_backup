        <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;TWD&apos; &#13;&#10;then [order_value_local] else [order_value_eur] end' />
      </column>
      <column caption='Top N vendor_brand_outlet' datatype='boolean' name='[Calculation_1572671086903361536]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5 1] &gt; 0 &#10;THEN RANK_UNIQUE([Calculation_3161738081916452865]) &lt;= [Parameters].[Parameter 5 1]&#10;ELSE TRUE&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='bussiness_mode' datatype='boolean' name='[Calculation_2713559538590986240]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;when &apos;All&apos; then TRUE&#10;when &apos;Own Delivery&apos; &#10;    then [is_own_delivery] and [expedition_type] = &apos;delivery&apos;&#10;when &apos;Vendor Delivery&apos; &#10;    then NOT [is_own_delivery] and [expedition_type] = &apos;delivery&apos;&#10;when &apos;Pickup&apos;&#10;    then [expedition_type] = &apos;pickup&apos;&#10;when &apos;Corporate&apos;&#10;    then [is_corporate_order]&#10;when &apos;Subscription&apos;&#10;    then [is_subscription_order]&#10;end' />
      </column>
      <column caption='failed_rate' datatype='real' default-format='p0.0%' name='[Calculation_2761199189366972427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_rate (copy 3)])/SUM([orders])' />
      </column>
      <column caption='relative weeks' datatype='string' name='[Calculation_2995597502902431749]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;) = &#10;{MAX(DATETRUNC(&apos;iso-week&apos;, [Calculation_1261852366473232386]))}&#10;then &apos;this week&apos;&#10;elseif &#10;DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;) = &#10;{MAX(DATETRUNC(&apos;iso-week&apos;, [Calculation_1261852366473232386])-7)}&#10;then &apos;last week&apos;&#10;else &apos;other weeks&apos;&#10;end' />
      </column>
      <column caption='main_kpi' datatype='real' name='[Calculation_3161738081916452865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#13;&#10;WHEN &apos;Eff Vendors&apos; THEN [Calculation_1083115768108097546]&#10;WHEN &apos;Comm Rate&apos; THEN [Calculation_1083115768127082513]&#10;WHEN &apos;Valid Orders&apos; THEN SUM([Calculation_3161738081921597443])&#13;&#10;WHEN &apos;Order Share&apos; THEN [Calculation_1083115768144236569]&#10;WHEN &apos;Daily Orders per Vx&apos; THEN [Calculation_3161738081923153924]&#10;WHEN &apos;New Customers&apos; THEN SUM([Calculation_1083115768099082243])&#10;WHEN &apos;Daily Nc per Vx&apos; THEN [daily_order_per_vx (copy)]&#10;WHEN &apos;Gfv&apos; THEN SUM([valid_orders (copy)])&#13;&#10;WHEN &apos;Gfv Share&apos; THEN [Calculation_1083115768143044632]&#10;WHEN &apos;Daily Gfv per Vx&apos; THEN [daily_nc_per_vx (copy)]&#13;&#10;WHEN &apos;Gmv&apos; THEN SUM([Calculation_1083115768106848262])&#13;&#10;WHEN &apos;Daily Gmv per Vx&apos; THEN [Calculation_1083115768107606025]&#10;WHEN &apos;Discount Cost&apos; THEN SUM([Calculation_3161738081925332999])&#10;WHEN &apos;Voucher Cost&apos; THEN SUM([valid_own_discount (copy)])&#10;WHEN &apos;CPO&apos; THEN [CPA (copy)]&#10;WHEN &apos;CPA&apos; THEN [Calculation_3161738081935609867]&#10;WHEN &apos;Afv&apos; THEN [afv (copy)]&#10;WHEN &apos;Aov&apos; THEN [aov (copy)]&#13;&#10;WHEN &apos;Amv&apos; THEN [Calculation_1083115768107196424]&#10;WHEN &apos;Eff Pc1&apos; THEN [Calculation_3161738081929994250]&#10;WHEN &apos;Net Pc1&apos; THEN [valid_eff_pc1 (copy)]&#10;WHEN &apos;Failed Rate&apos; THEN [Calculation_2761199189366972427]&#10;WHEN &apos;Vendor Failed Rate&apos; THEN [fail_rate (copy)]&#10;WHEN &apos;Customer Failed Rate&apos; THEN [fail_rate (copy 2)]&#10;WHEN &apos;foodpanda Fail Rate&apos; THEN [fail_rate_vendor (copy)]&#10;WHEN &apos;Failed Orders&apos; THEN SUM([fail_rate (copy 3)])&#10;WHEN &apos;Vendor Failed Orders&apos; THEN SUM([failed_orders_vendor])&#10;WHEN &apos;Customer Failed Orders&apos; THEN SUM([failed_orders_customer])&#10;WHEN &apos;foodpanda Failed Orders&apos; THEN SUM([failed_orders_foodpanda])&#10;WHEN &apos;Valid Preorder Rate&apos; THEN [Calculation_3161738081921290242]&#10;WHEN &apos;Failed Preorder Rate&apos; THEN [valid_preorder_rate (copy)]&#10;WHEN &apos;Valid Preorders&apos; THEN SUM([preorder_rate_valid (copy)])&#10;WHEN &apos;Failed Preorders&apos; THEN SUM([preorder_rate_fail (copy)])&#10;END' />
      </column>
      <column caption='preorder_rate_valid' datatype='real' default-format='p0.0%' name='[Calculation_3161738081921290242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_valid_order] then [preorders] end)/SUM([orders])' />
      </column>
      <column caption='valid_orders' datatype='integer' name='[Calculation_3161738081921597443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_valid_order] THEN [orders] END' />
      </column>
      <column caption='daily_orders_per_vx' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3161738081923153924]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ INCLUDE [vendor_uuid], [report_date]:SUM([Calculation_3161738081921597443])})' />
      </column>
      <column caption='valid_own_discount' datatype='real' name='[Calculation_3161738081925332999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_valid_order] THEN [Calculation_1261852366476083216] END' />
      </column>
      <column caption='valid_eff_pc1' datatype='real' name='[Calculation_3161738081929994250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_valid_order] THEN [Calculation_1261852366476451859] END)&#10;- SUM([Calculation_3161738081921597443] * [Parameters].[Parameter 4])' />
      </column>
      <column caption='CPA' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3161738081935609867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([Calculation_3161738081925332999]) + ZN([valid_own_discount (copy)]))/SUM([Calculation_1083115768099082243])' />
      </column>
      <column caption='updated_from_date' datatype='date' name='[Calculation_3161738081940348940]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MIN([report_date])}' />
      </column>
      <column caption='display main_kpi' datatype='real' name='[Calculation_3268839310645993472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 3],&apos;Rate|Share&apos;) then&#10;[Calculation_3161738081916452865]*100&#10;else &#10;[Calculation_3161738081916452865]&#10;end' />
      </column>
      <column caption='User Filter' datatype='boolean' name='[Calculation_338051505795006464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISMEMBEROF(&apos;l3_shops_head&apos;)&#13;&#10;THEN [chain_code] = &apos;ch3hm&apos;&#13;&#10;ELSE TRUE&#13;&#10;END' />
      </column>
      <column caption='searching_vendor' datatype='boolean' name='[Calculation_406520248093827072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Brand or Outlet (copy)] = &apos;&apos; &#10;  THEN TRUE&#10;ELSE REGEXP_MATCH(LOWER([vendor_code]+[vendor_name]),LOWER(REGEXP_REPLACE([Parameters].[Brand or Outlet (copy)],&apos; |,|;&apos;,&apos;|&apos;)))&#10;END' />
      </column>
      <column caption='vendor_brand_outlet' datatype='string' name='[Calculation_6119266004414869504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 6 1] &#10;when &apos;Brand&apos; then TRIM(REGEXP_REPLACE(LOWER([vendor_name]),&apos;\(.*?\)&apos;,&apos;&apos;))&#10;when &apos;Outlet&apos; then [vendor_name]&#10;end' />
      </column>
