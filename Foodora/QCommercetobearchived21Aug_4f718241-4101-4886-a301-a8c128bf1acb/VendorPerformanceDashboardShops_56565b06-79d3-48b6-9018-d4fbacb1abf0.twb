      <repository-location derived-from='http://ip-172-31-0-77:8405/t/Foodora/workbooks/VendorPerformanceDashboardShops/Definitions?rev=' id='240983' path='/t/Foodora/workbooks/VendorPerformanceDashboardShops' revision='' site='Foodora' />
