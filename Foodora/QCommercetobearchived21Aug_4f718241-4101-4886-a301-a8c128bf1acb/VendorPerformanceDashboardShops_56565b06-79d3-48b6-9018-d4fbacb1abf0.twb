          <format attr='vertical-align' id='dash-text_5' value='top' />
        </style-rule>
      </style>
      <size maxheight='800' maxwidth='1400' minheight='800' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='4000' id='3' type-v2='text' w='98858' x='571' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#1b1b1b' fontsize='20'>Definitions</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='94000' id='5' type-v2='text' w='98858' x='571' y='5000'>
            <formatted-text>
              <run bold='true' fontcolor='#e15759'>Report Date bases on &quot;Expected Dropoff Date&quot; not &quot;Order Date&quot;.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>Valid orders include statuses below:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>621 - Order delivered</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>622 - Customer confirmed delivery</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>612 - Order assembled</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>62 - order accepted, customer informed</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>614 - Order picked up</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>Vendor fail orders include statuses below:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>63 - Vendor declined - customer informed</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>Customer fail orders include statuses below:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>54 - order cancelled, call vendor</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>64 - customer cancelled - vendor informed</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>68 - Post-Delivery Issue</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>Fail orders include statuses below:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>52 - Vendor declined, contact customer</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>59 - Traffic manager declined, call customer</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>631 - Logistics Cancellation</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>65 - order not delivered</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
