            <column caption='Actual Open Hours' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_894527541834178561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_open_seconds])/3600' />
