            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[business_type_apac]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[closed_seconds_on_special_day]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column-instance column='[report_date]' derivation='MDY' name='[md:report_date:ok]' pivot='key' type='ordinal' />
