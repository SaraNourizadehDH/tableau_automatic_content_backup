      <column caption='Brands/Outlets' datatype='string' name='[Calculation_1002895389037502464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Brand&apos; THEN TRIM(REGEXP_REPLACE(LOWER([vendor_name]),&apos;\(.*?\)&apos;,&apos;&apos;))&#13;&#10;ELSE [vendor_name]&#13;&#10;END' />
