    <worksheet name='date kpi'>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_offline_vendorcode' name='sqlproxy.15473mz1p58j9718kmhsh0bmjd5b' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Main KPIs' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Actual Open Hours Rate&quot;'>
              <calculation class='tableau' formula='&quot;Actual Open Hours Rate&quot;' />
            </column>
            <column caption='Partition By' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vertical&quot;'>
              <calculation class='tableau' formula='&quot;Vertical&quot;' />
            </column>
            <column alias='Daily' caption='Date Part' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;mtd&quot;' value='Mtd' />
                <alias key='&quot;week&quot;' value='Weekly' />
                <alias key='&quot;wtd&quot;' value='Wtd' />
              </aliases>
            </column>
            <column caption='Right Shifting N Step' datatype='integer' name='[Parameter 5]' param-domain-type='range' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <range granularity='1' min='0' />
            </column>
            <column caption='Vendor Search' datatype='string' name='[Parameter 7]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.15473mz1p58j9718kmhsh0bmjd5b'>
            <column caption='Partition' datatype='string' name='[Calculation_1002895389038489601]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Vendor City&apos; THEN [Vendor City (group)]&#13;&#10;WHEN &apos;Vertical&apos; THEN [vertical_type]&#13;&#10;WHEN &apos;Brand&apos; THEN TRIM(REGEXP_REPLACE(LOWER([vendor_name]),&apos;\(.*?\)&apos;,&apos;&apos;))&#13;&#10;WHEN &apos;Outlet&apos; THEN [vendor_name]&#13;&#10;END' />
            </column>
            <column caption='Planned Open Hours' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1261852323305025536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([planned_open_seconds])/3600' />
            </column>
            <column caption='Closed Hours on Special Day' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1261852323305545730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([closed_seconds_on_special_day])/3600' />
            </column>
            <column caption='Updated To' datatype='date' name='[Calculation_130041450306670592]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([report_date])}' />
            </column>
            <column caption='Actual Open Hours Rate' datatype='real' default-format='p0.00%' name='[Calculation_130041450307153922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_open_seconds])/SUM([planned_open_seconds])' />
            </column>
            <column caption='main_kpi' datatype='real' name='[Calculation_130041450307518467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Actual Open Hours Rate&apos; THEN [Calculation_130041450307153922]&#13;&#10;WHEN &apos;Offline Rate&apos; THEN [Calculation_894527541836029955]&#13;&#10;WHEN &apos;Scheduled Open Hours&apos; THEN [Calculation_894527541833883648]&#13;&#10;WHEN &apos;Planned Open Hours&apos; THEN [Calculation_1261852323305025536]&#13;&#10;WHEN &apos;Closed Hours on Special Day&apos; THEN [Calculation_1261852323305545730]&#13;&#10;WHEN &apos;Actual Open Hours&apos; THEN [Calculation_894527541834178561]&#13;&#10;WHEN &apos;Actual Closed Hours&apos; THEN [Calculation_894527541834645506]&#13;&#10;END' />
            </column>
            <column caption='wtd report_date' datatype='integer' name='[Calculation_497647776747888642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if DATEPART(&apos;weekday&apos;,[report_date]) = 1 then 7&#13;&#10;else DATEPART(&apos;weekday&apos;,[report_date]) - 1&#13;&#10;end' />
            </column>
            <column caption='wtd updated_date' datatype='integer' name='[Calculation_497647776751943683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if DATEPART(&apos;weekday&apos;,[Calculation_130041450306670592]) = 1 then 7&#13;&#10;else DATEPART(&apos;weekday&apos;,[Calculation_130041450306670592]) - 1&#13;&#10;end' />
            </column>
            <column caption='mtd report_date' datatype='integer' name='[Calculation_497647776752365572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [report_date])' />
            </column>
            <column caption='mtd updated_date' datatype='integer' name='[Calculation_497647776752463877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [Calculation_130041450306670592])' />
            </column>
            <column caption='datetrunc report_date' datatype='date' name='[Calculation_497647776752640006]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 4], &apos;(month)|(mtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;month&apos;, [report_date]))&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 4], &apos;(week)|(wtd)&apos;)&#13;&#10;then date(DATETRUNC(&apos;iso-week&apos;, [report_date]))&#13;&#10;else date(DATETRUNC(&apos;day&apos;, [report_date]))&#13;&#10;end' />
            </column>
            <column caption='datename report_date' datatype='string' name='[Calculation_497647776752730119]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 4], &apos;(month)|(mtd)&apos;) then &#13;&#10;left(DATENAME(&apos;month&apos;, [report_date]),3)&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 4], &apos;(week)|(wtd)&apos;) then &#13;&#10;&apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [report_date])&#13;&#10;elseif [Parameters].[Parameter 4] = &apos;day&apos; then&#13;&#10;str([Calculation_497647776752640006])&#13;&#10;end' />
            </column>
            <column caption='datename(2) report_date' datatype='string' name='[Calculation_497647776752775176]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;day&apos;&#13;&#10;then left(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#13;&#10;else str(year([Calculation_497647776752640006]))&#13;&#10;end' />
            </column>
            <column aggregation='Sum' caption='datediff report_date' datatype='integer' name='[Calculation_497647776752996362]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 4], &apos;(month)|(mtd)&apos;) &#13;&#10;then DATEDIFF(&apos;month&apos;,[report_date], [Calculation_130041450306670592])&#13;&#10;elseif REGEXP_MATCH([Parameters].[Parameter 4], &apos;(week)|(wtd)&apos;)&#13;&#10;then DATEDIFF(&apos;iso-week&apos;,[report_date], [Calculation_130041450306670592])&#13;&#10;elseif [Parameters].[Parameter 4] = &apos;day&apos; &#13;&#10;then DATEDIFF(&apos;day&apos;,[report_date], [Calculation_130041450306670592])&#13;&#10;end' />
            </column>
            <column caption='datefilter report_date' datatype='boolean' name='[Calculation_497647776753156107]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_497647776752996362] &lt;= 12+[Parameters].[Parameter 5] and [Calculation_497647776752996362] &gt;= [Parameters].[Parameter 5]' />
            </column>
            <column caption='datefilter(2) report_date' datatype='boolean' name='[Calculation_497647776753242124]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;mtd&apos;&#13;&#10;then [Calculation_497647776752365572] &lt;= [Calculation_497647776752463877]&#13;&#10;elseif [Parameters].[Parameter 4] = &apos;wtd&apos;&#13;&#10;then [Calculation_497647776747888642] &lt;= [Calculation_497647776751943683]&#13;&#10;else TRUE&#13;&#10;end' />
            </column>
            <column caption='vendor_search' datatype='boolean' name='[Calculation_497647776792207374]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 7] = &apos;&apos; &#13;&#10;THEN TRUE&#13;&#10;ELSE REGEXP_MATCH(LOWER([vendor_code]+[vendor_name]),LOWER(REGEXP_REPLACE([Parameters].[Parameter 7],&apos;,|;&apos;,&apos;|&apos;)))&#13;&#10;END' />
            </column>
