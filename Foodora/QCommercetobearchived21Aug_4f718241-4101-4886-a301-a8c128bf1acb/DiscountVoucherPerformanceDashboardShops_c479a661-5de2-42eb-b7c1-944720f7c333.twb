              <calculation class='tableau' formula='IF REGEXP_MATCH([adjust_voucher_description],&apos;([a-z]|\d){4}-([a-z]|\d){4}&apos;)&#10;THEN &apos;Specific orders&apos;&#10;ELSEIF  isnull([adjust_voucher_description])&#10;THEN &apos;No voucher orders&apos;&#10;ELSE [adjust_voucher_description]&#10;END' />
