              <calculation class='tableau' formula='if [Calculation_1287748064437972992] then [orders] end' />
            </column>
            <column aggregation='Sum' caption='gfv' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1007891555199242269]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] WHEN &apos;TWD&apos;&#10;THEN [gfv_local]&#10;ELSE [gfv_eur]&#10;END' />
