            <column caption='afv' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3320138114904772616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1007891555199242269])/SUM([orders])' />
