      <datasource-dependencies datasource='sqlproxy.1vo22171fxt96v14y9gpx04cu4k7'>
        <column caption='is_dis_vou_order' datatype='boolean' name='[Calculation_3320138114916122644]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='NOT ([dis_vou_end_date (copy)_1007891555197476886] = &apos;No voucher orders&apos; OR &#10;[dis_vou_end_date (copy)_1007891555197476886] = &apos;No discount orders&apos;)' />
          <aliases>
            <alias key='false' value='Not Used' />
            <alias key='true' value='Used' />
          </aliases>
        </column>
        <column caption='sub_report_date' datatype='date' name='[Calculation_3486912038808821760]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='DATE([report_date])' />
        </column>
        <column datatype='string' name='[city_name adj]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
          <calculation class='categorical-bin' column='[city_name]' new-bin='true'>
            <bin default-name='false' value='&quot;Chiayi City&quot;'>
              <value>&quot;Chiayi City&quot;</value>
              <value>&quot;Chiayi County&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;Hsinchu City&quot;'>
              <value>&quot;Hsinchu City&quot;</value>
              <value>&quot;Hsinchu County&quot;</value>
            </bin>
          </calculation>
        </column>
        <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[city_name]' pivot='key' role='dimension' semantic-role='[City].[Name]' type='nominal' user-datatype='string' visual-totals='Default' />
        <column aggregation='Count' caption='dis_vou_title' datatype='string' default-type='nominal' layered='true' name='[dis_vou_end_date (copy)_1007891555197476886]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Discount&apos; THEN [Calculation_1007891555165556737]&#10;WHEN &apos;Voucher&apos; THEN &#10;  CASE [Parameters].[Parameter 2 4]&#10;    WHEN &apos;Voucher Description&apos; THEN [Calculation_1007891555196657681]&#10;    WHEN &apos;Voucher Code&apos; THEN [adjust_voucher_code_adj (copy)_554365015599931392]&#10;    WHEN &apos;Adjust Voucher Code&apos; THEN [voucher_description_adj (copy)_54746931886391303]&#10;  END&#10;END' />
        </column>
        <column aggregation='Count' caption='dis_vou_type' datatype='string' default-type='nominal' layered='true' name='[dis_vou_title (copy)_1007891555197726744]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Discount&apos; THEN IFNULL([discount_type], &apos;No discount orders&apos;)&#10;WHEN &apos;Voucher&apos; THEN IFNULL([voucher_type], &apos;No voucher orders&apos;)&#10;END' />
        </column>
        <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[expedition_type]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
