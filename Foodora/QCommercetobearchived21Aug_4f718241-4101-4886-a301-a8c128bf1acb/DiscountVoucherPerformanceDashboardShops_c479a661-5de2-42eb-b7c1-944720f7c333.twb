        <calculations>
          <calculation column='[Calculation_1007891555165556737]' formula='IF ISNULL([discount_title]) THEN &apos;No discount orders&apos;&#10;ELSE [discount_title]&#10;END' />
          <calculation column='[Calculation_1007891555165822978]' formula='min(&#10;{max([report_date])},&#10;{ FIXED [Calculation_1007891555165556737]:max([discount_end_date])}&#10;)' />
          <calculation column='[Calculation_1007891555166134277]' formula='{MAX([report_date])}' />
          <calculation column='[Calculation_1007891555166437382]' formula='IF DATEPART(&apos;weekday&apos;,[report_date]) = 1 then 7&#10;ELSE DATEPART(&apos;weekday&apos;,[report_date]) - 1&#10;END' />
          <calculation column='[Calculation_1007891555181166602]' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;)&#10;then date(DATETRUNC(&apos;month&apos;, [report_date]))&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#10;then date(DATETRUNC(&apos;week&apos;, [report_date]))&#10;else date(DATETRUNC(&apos;day&apos;, [report_date]))&#10;end' />
          <calculation column='[Calculation_1007891555181355019]' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) then &#10;left(DATENAME(&apos;month&apos;, [report_date]),3)&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;) then &#10;&apos;Week &apos; + DATENAME(&apos;week&apos;, [report_date])&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; then&#10;str([Calculation_1007891555181166602])&#10;end' />
          <calculation column='[Calculation_1007891555181559820]' formula='if [Parameters].[Parameter 1] = &apos;day&apos;&#10;then left(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#10;else str(year([Calculation_1007891555181166602]))&#10;end' />
          <calculation column='[Calculation_1007891555181637645]' formula='if [Parameters].[Parameter 1] = &apos;mtd&apos;&#10;then [wtd_report_date (copy)_1007891555167100936] &lt;= [mtd_report_date (copy)_1007891555167256585]&#10;elseif [Parameters].[Parameter 1] = &apos;wtd&apos;&#10;then [Calculation_1007891555166437382] &lt;= [wtd_report_date (copy)_1007891555166568455]&#13;&#10;else TRUE&#13;&#10;end' />
          <calculation column='[Calculation_1007891555181707278]' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) &#10;then DATEDIFF(&apos;month&apos;,[report_date], [Calculation_1007891555166134277])&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#10;then DATEDIFF(&apos;week&apos;,[report_date], [Calculation_1007891555166134277])&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; &#10;then DATEDIFF(&apos;day&apos;,[report_date], [Calculation_1007891555166134277])&#10;end' />
          <calculation column='[Calculation_1007891555196657681]' formula='IF REGEXP_MATCH([adjust_voucher_description],&apos;([a-z]|\d){4}-([a-z]|\d){4}&apos;)&#10;THEN &apos;Specific orders&apos;&#10;ELSEIF  isnull([adjust_voucher_description])&#10;THEN &apos;No voucher orders&apos;&#10;ELSE [adjust_voucher_description]&#10;END' />
          <calculation column='[Calculation_1007891555196825618]' formula='min(&#10;{max([report_date])},&#10;{ FIXED [Calculation_1007891555196657681]:max([voucher_end_date])}&#10;)' />
          <calculation column='[Calculation_1007891555197177876]' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Discount&apos; THEN [Calculation_1007891555165822978]&#10;WHEN &apos;Voucher&apos; THEN [Calculation_1007891555196825618]&#10;END' />
          <calculation column='[Calculation_1007891555198414873]' formula='DATEDIFF(&apos;day&apos;,[dis_vou_end_date (copy)_1007891555197321237],[Calculation_1007891555197177876])' />
          <calculation column='[Calculation_1007891555198631962]' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Discount&apos; then [own_discount_local]&#10;WHEN &apos;Voucher&apos; then [own_voucher_local]&#10;END' />
          <calculation column='[Calculation_1007891555198873627]' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Discount&apos; THEN [vendor_discount_local]&#10;WHEN &apos;Voucher&apos; THEN [vendor_voucher_local]&#10;END' />
          <calculation column='[Calculation_1007891555199156252]' formula='if [Calculation_1287748064437972992] then [orders] end' />
          <calculation column='[Calculation_1007891555199242269]' formula='CASE [Parameters].[Parameter 4] WHEN &apos;TWD&apos;&#10;THEN [gfv_local]&#10;ELSE [gfv_eur]&#10;END' />
          <calculation column='[Calculation_1007891555199545375]' formula='CASE [Parameters].[Parameter 4] WHEN &apos;TWD&apos;&#10;THEN [own_discount_local]&#10;ELSE [own_discount_eur]&#10;END' />
          <calculation column='[Calculation_1287748064437972992]' formula='CASE [Parameters].[Parameter 5]&#13;&#10;WHEN &apos;Platform&apos; THEN [is_first_order]&#10;WHEN &apos;Restaurants&apos; THEN [is_first_order_restaurants]&#13;&#10;WHEN &apos;New Vertical&apos; THEN [is_first_order_new_vertical]&#13;&#10;WHEN &apos;Shops&apos; THEN [is_first_order_shops]&#13;&#10;WHEN &apos;Dmart&apos; THEN [is_first_order_dmart]&#10;WHEN &apos;Pickup&apos; THEN [is_first_order_pickup]&#13;&#10;END' />
          <calculation column='[Calculation_1462825464137146368]' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Voucher/Discount Type&apos; THEN [dis_vou_title (copy)_1007891555197726744]&#13;&#10;WHEN &apos;Voucher Purpose&apos; THEN [voucher_purpose]&#13;&#10;WHEN &apos;Voucher Channel&apos; THEN [voucher_channel]&#13;&#10;END' />
          <calculation column='[Number of Records]' formula='1' />
          <calculation column='[adjust_voucher_code_adj (copy)_554365015599931392]' formula='IF REGEXP_MATCH([voucher_description],&apos;([a-z]|\d){4}-([a-z]|\d){4}&apos;)&#10;THEN &apos;Specific orders&apos;&#10;ELSEIF  isnull([voucher_description])&#10;THEN &apos;No voucher orders&apos;&#10;ELSE [voucher_code]&#10;END' />
          <calculation column='[dis_vou_end_date (copy)_1007891555197321237]' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Discount&apos; THEN [discount_end_date_adj (copy)_1007891555165892611]&#10;WHEN &apos;Voucher&apos; THEN [voucher_end_date_adj (copy)_1007891555196932115]&#10;END' />
          <calculation column='[dis_vou_end_date (copy)_1007891555197476886]' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Discount&apos; THEN [Calculation_1007891555165556737]&#10;WHEN &apos;Voucher&apos; THEN &#10;  CASE [Parameters].[Parameter 2 4]&#10;    WHEN &apos;Voucher Description&apos; THEN [Calculation_1007891555196657681]&#10;    WHEN &apos;Voucher Code&apos; THEN [adjust_voucher_code_adj (copy)_554365015599931392]&#10;    WHEN &apos;Adjust Voucher Code&apos; THEN [voucher_description_adj (copy)_54746931886391303]&#10;  END&#10;END' />
          <calculation column='[dis_vou_title (copy)_1007891555197726744]' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Discount&apos; THEN IFNULL([discount_type], &apos;No discount orders&apos;)&#10;WHEN &apos;Voucher&apos; THEN IFNULL([voucher_type], &apos;No voucher orders&apos;)&#10;END' />
