            <column caption='Attribute 1' datatype='string' name='[Calculation_151715042829934597]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Attribute (copy)_151715042829492227]&#10;WHEN &apos;Report Date&apos; THEN [Calculation_1007891555181355019]&#10;WHEN &apos;Date Name&apos; THEN [Calculation_1007891555181559820]&#10;WHEN &apos;Voucher/Discount Used&apos; THEN IF [Calculation_3320138114916122644] THEN &apos;TRUE&apos; ELSE &apos;FALSE&apos; END&#10;WHEN &apos;Voucher/Discount Type&apos; THEN [dis_vou_title (copy)_1007891555197726744]&#10;WHEN &apos;Voucher Purpose&apos; THEN [Calculation_111886321266368512]&#10;WHEN &apos;Voucher Channel&apos; THEN [voucher_channel]&#10;WHEN &apos;Vendor City&apos; THEN [city_name adj]&#10;WHEN &apos;pandapro Users&apos; THEN IF [is_pandapro_user] THEN &apos;TRUE&apos; ELSE &apos;FALSE&apos; END&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Voucher Vertical Per Origin&apos; THEN [voucher_vertical_per_origin]&#10;WHEN &apos;Voucher Budget Channel&apos; THEN [voucher_budget_channel]&#10;WHEN &apos;Vertical Per Redemption&apos; THEN [vertical_per_redemption]&#10;END' />
            </column>
            <column caption='order_type' datatype='boolean' name='[Calculation_1945555059774435328]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 3]&#10;when &apos;All&apos; then TRUE&#10;when &apos;pandapro User Orders&apos;&#10;    then [is_pandapro_user]&#10;when &apos;Non-pandapro User Orders&apos;&#10;    then [is_pandapro_user] = FALSE&#10;when &apos;Subscription Orders&apos;&#10;    then [is_subscription]&#10;when &apos;First Orders&apos;&#10;    then [Calculation_1287748064437972992]&#10;end' />
            </column>
            <column caption='main_kpi' datatype='real' name='[Calculation_3320138114887876614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 3 1]&#10;when &apos;Used Rate&apos; then [Calculation_428686433568043008]&#10;when &apos;Orders&apos; then SUM([orders])&#10;when &apos;First Orders&apos; then SUM([Calculation_1007891555199156252])&#10;when &apos;Own Cost&apos; then SUM([Calculation_1007891555198631962])&#10;when &apos;Regional Own Cost&apos; then SUM([dis_vou_own_cost (copy)_2851763788511186944])&#10;when &apos;Vendor Cost&apos; then SUM([Calculation_1007891555198873627])&#13;&#10;when &apos;Total Cost&apos; then [Calculation_1039487146145521664]&#10;when &apos;Cpa&apos; then SUM([Calculation_1007891555198631962])/SUM([Calculation_1007891555199156252])&#10;when &apos;Cpo&apos; then SUM([Calculation_1007891555198631962])/SUM([orders])&#10;when &apos;Amv&apos; then [Calculation_3320138114904813577]&#10;when &apos;Afv&apos; then [Calculation_3320138114904772616]&#13;&#10;when &apos;Vendor Cost over Total Gmv&apos; then [Calculation_1039487146145665025]&#10;when &apos;Comm Rate&apos; then [Calculation_1243556455796658176]&#10;end' />
