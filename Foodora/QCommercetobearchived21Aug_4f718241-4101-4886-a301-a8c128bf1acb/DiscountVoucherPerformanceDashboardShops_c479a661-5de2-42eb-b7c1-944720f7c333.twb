              <zone h='98000' id='6' type-v2='layout-basic' w='98858' x='571' y='1000'>
                <zone h='4000' id='7' type-v2='text' w='98858' x='571' y='1000'>
                  <formatted-text>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light' fontsize='20'>Definitions</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='94000' id='13' param='horz' type-v2='layout-flow' w='98858' x='571' y='5000'>
                  <zone forceUpdate='true' h='94000' id='8' type-v2='text' w='49143' x='571' y='5000'>
                    <formatted-text>
                      <run bold='true' fontcolor='#333333'>Figures only included valid orders defined as statuses below:</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>621 - Order delivered</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>622 - Customer confirmed delivery</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>612 - Order assembled</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>62 - order accepted, customer informed</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>614 - Order picked up</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#333333'>[...]</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>Abbreviate from </run>
                      <run bold='true' fontcolor='#333333'>[Discount Voucher]</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#333333'>[... Used Rate]</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>Sum of discount/voucher used orders divided by total orders in the period.</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#333333'>[... Orders]</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>Orders that applied discount or voucher.</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#333333'>[... First Orders]</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>A customer&apos;s first order that applied discount or voucher.</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#333333'>[... Own Cost]</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>Voucher or discount values foodpanda costed.</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#333333'>[... Own Cost Share]</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>[... Own Cost] / [... Gmv], represents the percentage of [... Own Cost] accounts for [... Gmv]. Could potientally be abused if the figure is high.</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#333333'>[... Vendor Cost]</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>Voucher or discount values vendors costed.</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#333333'>[... Cpa]</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>Stands for Costs per Acquisition, equals to [... Own Cost] / [... First Orders].</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#333333'>[... Cpo]</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>Stands for Costs per Acquisition, equals to [... Own Cost] / [... Orders].</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#333333'>[... Amv]</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>Stands for Average Merchandise Value which means the amount before all subsidies. Equals to [... Gmv] / [... Orders].</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#333333'>[... Afv]</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>Stands for Average Food Value which means the food amount before all subsidies. Equals to [... Gfv] / [... Orders].</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#333333'>[... iCPGMV]</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>Stands for Costs per Gfv, Equals to [... Own Cost] / [... Gmv].</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone forceUpdate='true' h='94000' id='14' type-v2='text' w='49714' x='49714' y='5000'>
                    <formatted-text>
                      <run bold='true' fontcolor='#333333'>[... Regional Own Cost]</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>Refers to the regional [voucher/discount] cost in local currency, used for an order, that is attributed to marketing</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#333333'>[Crosstab Attributes]</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>- Voucher description</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>- Voucher Code</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>- Adjust Voucher Code</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#333333'>If the voucher is blanket, then this field would show the voucher code, if the voucher is pandapro or for specific customers with voucher code [v%], then this field would show the voucher description.</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{BFB64852-BA07-4FE2-8251-188095B5E7C6}' />
    </dashboard>
    <dashboard name='Discount Voucher Performance Dashboard'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/DiscountVoucherPerformanceDashboardShops/DiscountVoucherPerformanceDashboard?rev=' id='228435' path='/t/Foodora/workbooks/DiscountVoucherPerformanceDashboardShops' revision='' site='Foodora' />
      <style>
        <style-rule element='parameter-ctrl-title'>
          <format attr='font-family' value='Tableau Light' />
