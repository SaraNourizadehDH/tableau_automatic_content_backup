        <column-instance column='[voucher_channel]' derivation='None' name='[none:voucher_channel:nk]' pivot='key' type='nominal' />
        <column-instance column='[voucher_description_adj (copy)_54746931886391303]' derivation='None' name='[none:voucher_description_adj (copy)_54746931886391303:nk]' pivot='key' type='nominal' />
        <column-instance column='[voucher_purpose]' derivation='None' name='[none:voucher_purpose:nk]' pivot='key' type='nominal' />
        <column-instance column='[voucher_vertical_per_origin]' derivation='None' name='[none:voucher_vertical_per_origin:nk]' pivot='key' type='nominal' />
        <column aggregation='Year' datatype='date' default-type='ordinal' layered='true' name='[report_date]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
        <column caption='subscription_plan_adj' datatype='string' name='[subscription_plan (copy)_4438930767265214464]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IFNULL([subscription_plan], &apos;Non-pandapro&apos;)' />
        </column>
        <column caption='subscription_type_adj' datatype='string' name='[subscription_type (copy)_4438930767265447937]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IFNULL([subscription_type], &apos;Non-pandapro&apos;)' />
        </column>
        <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[vertical_per_redemption]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
        <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[vertical_type]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
        <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[voucher_budget_channel]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
        <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[voucher_channel]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
        <column aggregation='Count' caption='adjust_voucher_code_adj' datatype='string' default-type='nominal' layered='true' name='[voucher_description_adj (copy)_54746931886391303]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
          <calculation class='tableau' formula='IF REGEXP_MATCH([adjust_voucher_code],&apos;([a-z]|\d){4}-([a-z]|\d){4}&apos;)&#10;THEN &apos;Specific orders&apos;&#10;ELSEIF ISNULL([adjust_voucher_code])&#10;THEN &apos;No voucher orders&apos;&#10;ELSE [adjust_voucher_code]&#10;END' />
        </column>
        <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[voucher_purpose]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
        <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[voucher_vertical_per_origin]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
      </datasource-dependencies>
