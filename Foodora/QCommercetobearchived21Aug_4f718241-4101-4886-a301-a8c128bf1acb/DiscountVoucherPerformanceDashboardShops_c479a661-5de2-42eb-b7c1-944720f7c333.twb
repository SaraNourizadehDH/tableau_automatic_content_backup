            <column aggregation='Sum' caption='wtd report_date' datatype='integer' default-type='ordinal' layered='true' name='[Calculation_1007891555166437382]' pivot='key' role='dimension' type='ordinal' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[report_date]) = 1 then 7&#10;ELSE DATEPART(&apos;weekday&apos;,[report_date]) - 1&#10;END' />
            </column>
            <column aggregation='Count' caption='datefilter report_date' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_1007891555181637645]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;mtd&apos;&#10;then [wtd_report_date (copy)_1007891555167100936] &lt;= [mtd_report_date (copy)_1007891555167256585]&#10;elseif [Parameters].[Parameter 1] = &apos;wtd&apos;&#10;then [Calculation_1007891555166437382] &lt;= [wtd_report_date (copy)_1007891555166568455]&#13;&#10;else TRUE&#13;&#10;end' />
