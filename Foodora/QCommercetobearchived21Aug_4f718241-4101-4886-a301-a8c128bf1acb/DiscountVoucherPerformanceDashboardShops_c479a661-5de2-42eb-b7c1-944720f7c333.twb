            <column caption='Daily Vendor Cost/Total Gmv' datatype='real' name='[Calculation_1421167167890956301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1007891555198873627])/SUM({INCLUDE [Calculation_1007891555181166602]:MAX({ FIXED [Calculation_1007891555181166602]:SUM([gfv (copy)_1007891555199393822])})})' />
