          <calculation class='tableau' formula='IF ISMEMBEROF(&apos;l2_mkt_director&apos;) THEN [Food Set (copy 2)]&#10;ELSEIF ISMEMBEROF(&apos;l4_mkt_growth_crew&apos;) THEN [Food Set (copy 2)]&#10;ELSEIF ISMEMBEROF(&apos;l3_mkt_food_head&apos;) THEN [Food Set (copy 2)]&#10;ELSEIF ISMEMBEROF(&apos;l3_mkt_nv_head&apos;) THEN [Food Set (copy)]&#10;ELSEIF ISMEMBEROF(&apos;l4_mkt_food_crew&apos;) THEN [All Set (copy)]&#10;ELSEIF ISMEMBEROF(&apos;l4_mkt_nv_crew&apos;) THEN [Food Set (copy)]&#10;ELSE TRUE&#10;END' />
        </column>
