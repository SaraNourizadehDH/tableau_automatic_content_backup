            <column caption='Attribute 2' datatype='string' name='[Attribute 1 (copy)_151715042831544327]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Partition By (copy)_151715042827583488]&#10;WHEN &apos;Report Date&apos; THEN [Calculation_1007891555181355019]&#10;WHEN &apos;Date Name&apos; THEN [Calculation_1007891555181559820]&#10;WHEN &apos;Voucher/Discount Used&apos; THEN IF [Calculation_3320138114916122644] THEN &apos;TRUE&apos; ELSE &apos;FALSE&apos; END&#10;WHEN &apos;Voucher/Discount Type&apos; THEN [dis_vou_title (copy)_1007891555197726744]&#10;WHEN &apos;Voucher Purpose&apos; THEN [Calculation_111886321266368512]&#10;WHEN &apos;Voucher Channel&apos; THEN [voucher_channel]&#10;WHEN &apos;Vendor City&apos; THEN [city_name adj]&#10;WHEN &apos;pandapro Users&apos; THEN IF [is_pandapro_user] THEN &apos;TRUE&apos; ELSE &apos;FALSE&apos; END&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Voucher Vertical Per Origin&apos; THEN [voucher_vertical_per_origin]&#10;WHEN &apos;Voucher Budget Channel&apos; THEN [voucher_budget_channel]&#10;WHEN &apos;Vertical Per Redemption&apos; THEN [vertical_per_redemption]&#10;END' />
            </column>
            <column aggregation='Count' caption='discount_title_adj' datatype='string' default-type='nominal' layered='true' name='[Calculation_1007891555165556737]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='IF ISNULL([discount_title]) THEN &apos;No discount orders&apos;&#10;ELSE [discount_title]&#10;END' />
            </column>
            <column aggregation='Year' caption='discount_end_date_adj' datatype='date' default-type='ordinal' layered='true' name='[Calculation_1007891555165822978]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
              <calculation class='tableau' formula='min(&#10;{max([report_date])},&#10;{ FIXED [Calculation_1007891555165556737]:max([discount_end_date])}&#10;)' />
            </column>
            <column aggregation='Year' caption='updated_date' datatype='date' default-type='ordinal' layered='true' name='[Calculation_1007891555166134277]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
              <calculation class='tableau' formula='{MAX([report_date])}' />
            </column>
            <column aggregation='Sum' caption='wtd report_date' datatype='integer' default-type='ordinal' layered='true' name='[Calculation_1007891555166437382]' pivot='key' role='dimension' type='ordinal' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[report_date]) = 1 then 7&#10;ELSE DATEPART(&apos;weekday&apos;,[report_date]) - 1&#10;END' />
            </column>
            <column aggregation='Year' caption='datetrunc report_date' datatype='date' default-type='ordinal' layered='true' name='[Calculation_1007891555181166602]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;)&#10;then date(DATETRUNC(&apos;month&apos;, [report_date]))&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#10;then date(DATETRUNC(&apos;week&apos;, [report_date]))&#10;else date(DATETRUNC(&apos;day&apos;, [report_date]))&#10;end' />
            </column>
            <column aggregation='Count' caption='datename report_date' datatype='string' default-type='nominal' layered='true' name='[Calculation_1007891555181355019]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) then &#10;left(DATENAME(&apos;month&apos;, [report_date]),3)&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;) then &#10;&apos;Week &apos; + DATENAME(&apos;week&apos;, [report_date])&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; then&#10;str([Calculation_1007891555181166602])&#10;end' />
            </column>
            <column aggregation='Count' caption='datename(2) report_date' datatype='string' default-type='nominal' layered='true' name='[Calculation_1007891555181559820]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;day&apos;&#10;then left(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#10;else str(year([Calculation_1007891555181166602]))&#10;end' />
            </column>
            <column aggregation='Count' caption='datefilter report_date' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_1007891555181637645]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;mtd&apos;&#10;then [wtd_report_date (copy)_1007891555167100936] &lt;= [mtd_report_date (copy)_1007891555167256585]&#10;elseif [Parameters].[Parameter 1] = &apos;wtd&apos;&#10;then [Calculation_1007891555166437382] &lt;= [wtd_report_date (copy)_1007891555166568455]&#13;&#10;else TRUE&#13;&#10;end' />
            </column>
            <column aggregation='Count' caption='voucher_description_adj' datatype='string' default-type='nominal' layered='true' name='[Calculation_1007891555196657681]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='IF REGEXP_MATCH([adjust_voucher_description],&apos;([a-z]|\d){4}-([a-z]|\d){4}&apos;)&#10;THEN &apos;Specific orders&apos;&#10;ELSEIF  isnull([adjust_voucher_description])&#10;THEN &apos;No voucher orders&apos;&#10;ELSE [adjust_voucher_description]&#10;END' />
            </column>
            <column aggregation='Year' caption='voucher_end_date_adj' datatype='date' default-type='ordinal' layered='true' name='[Calculation_1007891555196825618]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
              <calculation class='tableau' formula='min(&#10;{max([report_date])},&#10;{ FIXED [Calculation_1007891555196657681]:max([voucher_end_date])}&#10;)' />
            </column>
            <column aggregation='Year' caption='dis_vou_end_date' datatype='date' default-type='ordinal' layered='true' name='[Calculation_1007891555197177876]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Discount&apos; THEN [Calculation_1007891555165822978]&#10;WHEN &apos;Voucher&apos; THEN [Calculation_1007891555196825618]&#10;END' />
            </column>
            <column aggregation='Sum' caption='dis_vou_datediff' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_1007891555198414873]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[dis_vou_end_date (copy)_1007891555197321237],[Calculation_1007891555197177876])' />
            </column>
            <column aggregation='Sum' caption='dis_vou_own_cost' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1007891555198631962]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Discount&apos; then [own_discount_local]&#10;WHEN &apos;Voucher&apos; then [own_voucher_local]&#10;END' />
            </column>
            <column aggregation='Sum' caption='dis_vou_vendor_cost' datatype='real' default-type='quantitative' layered='true' name='[Calculation_1007891555198873627]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Discount&apos; THEN [vendor_discount_local]&#10;WHEN &apos;Voucher&apos; THEN [vendor_voucher_local]&#10;END' />
