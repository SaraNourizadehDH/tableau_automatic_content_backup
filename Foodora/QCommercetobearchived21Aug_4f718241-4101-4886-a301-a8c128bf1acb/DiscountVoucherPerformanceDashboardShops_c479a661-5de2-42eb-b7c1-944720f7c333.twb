          <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;mtd&apos;&#10;then [wtd_report_date (copy)_1007891555167100936] &lt;= [mtd_report_date (copy)_1007891555167256585]&#10;elseif [Parameters].[Parameter 1] = &apos;wtd&apos;&#10;then [Calculation_1007891555166437382] &lt;= [wtd_report_date (copy)_1007891555166568455]&#13;&#10;else TRUE&#13;&#10;end' />
        </column>
        <column caption='order_type' datatype='boolean' name='[Calculation_1945555059774435328]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 3]&#10;when &apos;All&apos; then TRUE&#10;when &apos;pandapro User Orders&apos;&#10;    then [is_pandapro_user]&#10;when &apos;Non-pandapro User Orders&apos;&#10;    then [is_pandapro_user] = FALSE&#10;when &apos;Subscription Orders&apos;&#10;    then [is_subscription]&#10;when &apos;First Orders&apos;&#10;    then [Calculation_1287748064437972992]&#10;end' />
        </column>
        <column caption='is_dis_vou_order' datatype='boolean' name='[Calculation_3320138114916122644]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='NOT ([dis_vou_end_date (copy)_1007891555197476886] = &apos;No voucher orders&apos; OR &#10;[dis_vou_end_date (copy)_1007891555197476886] = &apos;No discount orders&apos;)' />
