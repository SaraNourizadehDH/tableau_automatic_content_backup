            <connection CATALOG='foodpanda-hk-bigquery' EXECCATALOG='foodpanda-hk-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='APAC Country - HK' schema='sandbox_kelvin_ng' server-oauth='' username='sunny.lau@foodpanda.hk' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1folyrk0dpblmu181eu271lkbd2w' name='Custom SQL Query' type='text'>SELECT distinct t.vendor_id as keeta_id,b.grid,c.vendor_code,c.sf_account_owner, c.sf_account_owner_department, c.global_vendor_id, t.name as keeta_chain, t.branch_name as keeta_name,c.vendor_name as fp_name,c.vendor_name_zh as fp_ZH_name, c.chain_name as fp_chain, t.number_of_ratings, t.rating_score,t.sales, t.address, t.cuisine, t.is_pickup_enabled, t.others, t.promotions, t.date_of_scrape, t.is_meal_for_one , c.sf_status, c.gfv_l91d, c.is_exclusive&#13;
FROM (&#13;
  SELECT vendor_id, MAX(date_of_scrape) AS most_recent_date&#13;
  FROM `production-371309.vendor.vendor` &#13;
  GROUP BY vendor_id&#13;
) AS max_dates&#13;
JOIN `production-371309.vendor.vendor`  AS t&#13;
  ON t.vendor_id = max_dates.vendor_id AND t.date_of_scrape = max_dates.most_recent_date&#13;
LEFT JOIN `foodpanda-hk-bigquery.sandbox_kelvin_ng.keeta_dashboard_v2_testing`  AS b&#13;
ON SUBSTR(t.vendor_id, 1, 6) = SUBSTR(b.keeta_uuid, 1, 6)&#13;
LEFT JOIN `dhh---analytics-apac.pandata_hk.hkg_vendors_agg` AS c&#13;
  ON b.grid = c.global_vendor_id&#13;
where t.lead_source = &quot;keeta&quot;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1folyrk0dpblmu181eu271lkbd2w' name='Custom SQL Query' type='text'>SELECT distinct t.vendor_id as keeta_id,b.grid,c.vendor_code,c.sf_account_owner, c.sf_account_owner_department, c.global_vendor_id, t.name as keeta_chain, t.branch_name as keeta_name,c.vendor_name as fp_name,c.vendor_name_zh as fp_ZH_name, c.chain_name as fp_chain, t.number_of_ratings, t.rating_score,t.sales, t.address, t.cuisine, t.is_pickup_enabled, t.others, t.promotions, t.date_of_scrape, t.is_meal_for_one , c.sf_status, c.gfv_l91d, c.is_exclusive&#13;
FROM (&#13;
  SELECT vendor_id, MAX(date_of_scrape) AS most_recent_date&#13;
  FROM `production-371309.vendor.vendor` &#13;
  GROUP BY vendor_id&#13;
) AS max_dates&#13;
JOIN `production-371309.vendor.vendor`  AS t&#13;
  ON t.vendor_id = max_dates.vendor_id AND t.date_of_scrape = max_dates.most_recent_date&#13;
LEFT JOIN `foodpanda-hk-bigquery.sandbox_kelvin_ng.keeta_dashboard_v2_testing`  AS b&#13;
ON SUBSTR(t.vendor_id, 1, 6) = SUBSTR(b.keeta_uuid, 1, 6)&#13;
LEFT JOIN `dhh---analytics-apac.pandata_hk.hkg_vendors_agg` AS c&#13;
  ON b.grid = c.global_vendor_id&#13;
where t.lead_source = &quot;keeta&quot;</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
