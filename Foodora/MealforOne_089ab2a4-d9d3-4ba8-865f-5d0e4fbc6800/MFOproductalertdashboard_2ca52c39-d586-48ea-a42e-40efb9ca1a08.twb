  <worksheets>
    <worksheet name='price distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'><![CDATA[Price distribution - <[Parameters].[Parameter 2]>]]></run>
