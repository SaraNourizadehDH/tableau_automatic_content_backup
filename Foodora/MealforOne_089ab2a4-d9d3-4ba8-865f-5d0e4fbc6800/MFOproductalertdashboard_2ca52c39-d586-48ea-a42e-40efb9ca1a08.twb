            <column caption='No Eng desc' datatype='string' name='[Calculation_5503398751018565634]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [product_description_en] = &apos;No Eng description&apos; then &apos;Y&apos; else &apos;&apos; end' />
