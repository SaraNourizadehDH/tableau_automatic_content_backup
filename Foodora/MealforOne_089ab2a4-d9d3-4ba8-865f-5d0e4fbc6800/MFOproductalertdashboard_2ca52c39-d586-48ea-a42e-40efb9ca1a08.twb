    <worksheet name='summary vendors'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>Impacted Vendors</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ffffff' fontsize='10'>Impacted: Has at least 1 alert. The table is sorted by the number of vendors (high to low)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='all products' name='federated.16ktw730es57dc165i0wb1v7fvqi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Table breakdown' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Zone&quot;'>
              <calculation class='tableau' formula='&quot;Zone&quot;' />
            </column>
            <column caption='Table breakdown 2' datatype='string' name='[Table breakdown (copy)_308285486897389568]' param-domain-type='list' role='measure' type='nominal' value='&quot;Zone&quot;'>
              <calculation class='tableau' formula='&quot;Zone&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.16ktw730es57dc165i0wb1v7fvqi'>
            <column caption='Breakdown 2' datatype='string' name='[Breakdown (copy)_308285486897602561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Table breakdown (copy)_308285486897389568] = &apos;Team category&apos; then [team_category]&#10;ELSEIF [Parameters].[Table breakdown (copy)_308285486897389568] = &apos;Team lead name&apos; then [team_lead_name]&#10;ELSEIF [Parameters].[Table breakdown (copy)_308285486897389568] = &apos;SF owner name&apos; then [sf_owner_name]&#10;ELSEIF [Parameters].[Table breakdown (copy)_308285486897389568] = &apos;GMV class&apos; then [gmv_class]&#10;ELSEIF [Parameters].[Table breakdown (copy)_308285486897389568] = &apos;Country&apos; then [global_entity_id]&#10;ELSEIF [Parameters].[Table breakdown (copy)_308285486897389568] = &apos;City&apos; then [city_name]&#10;ELSEIF [Parameters].[Table breakdown (copy)_308285486897389568] = &apos;Zone&apos; then [zone_name]&#10;ELSEIF [Parameters].[Table breakdown (copy)_308285486897389568] = &apos;Cuisine&apos; then [primary_cuisine]&#10;ELSEIF [Parameters].[Table breakdown (copy)_308285486897389568] = &apos;Chain name&apos; then [chain_name]&#10;ELSEIF [Parameters].[Table breakdown (copy)_308285486897389568] = &apos;Vendor name&apos; then [vendor_name]&#10;ELSEIF [Parameters].[Table breakdown (copy)_308285486897389568] = &apos;Geohash&apos; then [geohash]&#10;end' />
              <aliases>
                <alias key='&quot;FP_BD&quot;' value='Bangladesh' />
                <alias key='&quot;FP_HK&quot;' value='Hong Kong' />
                <alias key='&quot;FP_PH&quot;' value='Phlippines' />
                <alias key='&quot;FP_SG&quot;' value='Singapore' />
              </aliases>
            </column>
            <column caption='Last 7d order halved' datatype='string' name='[Calculation_1706723526182178816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [last_7d_orders] &lt; [prev_7d_orders] * 0.5&#10;then &apos;Y&apos;&#10;else &apos;&apos; end' />
            </column>
            <column caption='No dish image' datatype='string' name='[Calculation_1706723526204506117]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISNULL([image_url]) = true then &apos;Y&apos; else &apos;&apos; end' />
            </column>
            <column caption='High price' datatype='string' name='[Calculation_1706723526208577543]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [global_entity_id] = &apos;FP_HK&apos; and [unit_price] &gt; 70 then &apos;Y&apos; &#10;elseif [global_entity_id] = &apos;FP_BD&apos; and [unit_price] &gt; 350 then &apos;Y&apos; &#10;elseif [global_entity_id] = &apos;FP_PH&apos; and [unit_price] &gt; 400 then &apos;Y&apos; &#10;elseif [global_entity_id] = &apos;FP_SG&apos; and [unit_price] &gt; 12 then &apos;Y&apos; &#10;elseif [global_entity_id] = &apos;FP_MY&apos; and [unit_price] &gt; 18 then &apos;Y&apos; &#10;else &apos;&apos; end' />
            </column>
            <column caption='is_meal_item' datatype='boolean' name='[Calculation_4534702630357643264]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [global_entity_id] = &apos;FP_HK&apos; and [unit_price] &gt;= 30 then true&#10;elseif [global_entity_id] = &apos;FP_SG&apos; then true&#10;elseif [global_entity_id] = &apos;FP_BD&apos; then true&#10;elseif [global_entity_id] = &apos;FP_PH&apos; then true&#10;elseif [global_entity_id] = &apos;FP_MY&apos; then true&#10;elseif [global_entity_id] = &apos;FP_MM&apos; then true&#10;elseif [global_entity_id] = &apos;FP_KH&apos; then true&#10;elseif [global_entity_id] = &apos;FP_TH&apos; then true&#10;elseif [global_entity_id] = &apos;FP_LA&apos; then true&#10;else false end' />
            </column>
            <column caption='Overall alert' datatype='string' name='[Calculation_4600778871639515139]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1706723526208577543] = &apos;Y&apos;&#10;or [Calculation_5503398751018565634] = &apos;Y&apos;&#10;OR  [Calculation_1706723526204506117] = &apos;Y&apos;&#10;or [Calculation_5503398751018754051] = &apos;Y&apos;&#10;or [Calculation_5503398751018405889] = &apos;Y&apos;&#10;or [last 3d no orders alert (copy)_4600778871635693569] = &apos;Y&apos;&#10;or [Calculation_1706723526182178816] = &apos;Y&apos;&#10;or [last 7d no orders alert (copy)_4600778871635857410] = &apos;Y&apos;&#10;then &apos;Y&apos; else &apos;&apos; end' />
            </column>
            <column caption='vendor count' datatype='integer' name='[Calculation_4600778871822094353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([vendor_code])' />
            </column>
            <column caption='Breakdown' datatype='string' name='[Calculation_4600778871833546805]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Team category&apos; then [team_category]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Team lead name&apos; then [team_lead_name]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;SF owner name&apos; then [sf_owner_name]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;GMV class&apos; then [gmv_class]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Country&apos; then [global_entity_id]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;City&apos; then [city_name]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Zone&apos; then [zone_name]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Cuisine&apos; then [primary_cuisine]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Chain name&apos; then [chain_name]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Vendor name&apos; then [vendor_name]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Geohash&apos; then [geohash]&#10;end' />
              <aliases>
