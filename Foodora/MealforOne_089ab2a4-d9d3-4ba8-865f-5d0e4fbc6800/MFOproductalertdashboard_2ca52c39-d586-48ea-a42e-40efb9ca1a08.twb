                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ff2b86' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='24722' id='5' type-v2='text' w='98400' x='800' y='12660'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Alert definitions</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='11'>1. No Eng desc</run>
                    <run fontcolor='#000000' fontsize='11'>: The product does not have an English description</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='11'>2. No local desc</run>
                    <run fontcolor='#000000' fontsize='11'>: The product does not have a local language description.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='11'>3. No local name</run>
                    <run fontcolor='#000000' fontsize='11'>: The product does not have a local language name.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='11'>4. High price:</run>
                    <run fontcolor='#000000' fontsize='11'> The price of the product is higher than the maximum recommended price. (Please see the country pricing below)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='11'>5. No dish image</run>
                    <run fontcolor='#000000' fontsize='11'>: The product does not have a dish level image.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='11'>6. Last 7d no orders</run>
                    <run fontcolor='#000000' fontsize='11'>: The product did not have any orders in the last 7 days.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='11'>7. Last 14d no orders:</run>
                    <run fontcolor='#000000' fontsize='11'> The product did not have any orders in the last 14 days.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='18392' id='8' type-v2='text' w='49200' x='800' y='37382'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='11'>The maximum recommended prices:</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>- Hong Kong: 70 HKD</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>- Singapore: 12 SGD</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>- Bangladesh: 350 BDT</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>- Philippines: 400 PHP</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>- Malaysia: 18 MYR</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='18392' id='9' type-v2='text' w='49200' x='50000' y='37382'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='11'>Local language (written language) definition per country:</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>- Hong Kong: Chinese</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>- Singapore: Chinese</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>- Bangladesh: English</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>- Philippines: English</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>- Malaysia: Malay</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
