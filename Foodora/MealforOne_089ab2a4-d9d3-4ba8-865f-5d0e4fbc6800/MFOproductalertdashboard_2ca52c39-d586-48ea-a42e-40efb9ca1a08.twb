    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Product requirement alert'>
      <repository-location id='Productrequirementalert' path='/t/Foodora/workbooks/MFOproductalertdashboard' revision='' site='Foodora' />
      <style />
      <size maxheight='1169' maxwidth='1654' minheight='1169' minwidth='1654' preset-index='14' sizing-mode='fixed' />
      <datasources>
        <datasource caption='all products' name='federated.16ktw730es57dc165i0wb1v7fvqi' />
      </datasources>
      <datasource-dependencies datasource='federated.16ktw730es57dc165i0wb1v7fvqi'>
        <column caption='No dish image' datatype='string' name='[Calculation_1706723526204506117]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if ISNULL([image_url]) = true then &apos;Y&apos; else &apos;&apos; end' />
        </column>
        <column caption='High price' datatype='string' name='[Calculation_1706723526208577543]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [global_entity_id] = &apos;FP_HK&apos; and [unit_price] &gt; 70 then &apos;Y&apos; &#10;elseif [global_entity_id] = &apos;FP_BD&apos; and [unit_price] &gt; 350 then &apos;Y&apos; &#10;elseif [global_entity_id] = &apos;FP_PH&apos; and [unit_price] &gt; 400 then &apos;Y&apos; &#10;elseif [global_entity_id] = &apos;FP_SG&apos; and [unit_price] &gt; 12 then &apos;Y&apos; &#10;elseif [global_entity_id] = &apos;FP_MY&apos; and [unit_price] &gt; 18 then &apos;Y&apos; &#10;else &apos;&apos; end' />
