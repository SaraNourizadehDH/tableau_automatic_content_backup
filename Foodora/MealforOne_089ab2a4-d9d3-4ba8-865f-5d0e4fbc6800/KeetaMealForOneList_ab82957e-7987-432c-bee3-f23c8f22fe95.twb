          <named-connection caption='BigQuery' name='bigquery.08jk6qq1tbhu6n1fimzmf0o5qagn'>
            <connection CATALOG='foodpanda-hk-bigquery' EXECCATALOG='foodpanda-hk-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='APAC Country - HK' schema='sandbox_kelvin_ng' server-oauth='' username='sunny.lau@foodpanda.hk' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.08jk6qq1tbhu6n1fimzmf0o5qagn' name='Custom SQL Query' type='text'>WITH first_query AS (&#13;
  SELECT DISTINCT&#13;
    t.vendor_id AS keeta_id,&#13;
    b.grid,&#13;
    c.vendor_code,&#13;
    b.owner_name,&#13;
    o.sf_account_owner_department,&#13;
    c.global_vendor_id,&#13;
    t.name AS keeta_chain,&#13;
    t.branch_name AS keeta_name,&#13;
    c.vendor_name AS fp_name,&#13;
    c.vendor_name_zh AS fp_ZH_name,&#13;
    c.chain_name AS fp_chain,&#13;
    t.number_of_ratings,&#13;
    t.rating_score,&#13;
    t.sales,&#13;
    t.address,&#13;
    t.latitude,&#13;
    t.longitude,&#13;
    t.cuisine,&#13;
    t.is_pickup_enabled,&#13;
    t.promotions,&#13;
    t.date_of_scrape,&#13;
    t.is_meal_for_one,&#13;
    m.menu_items,&#13;
    m.original_price,&#13;
    m.discounted_price,&#13;
    m.discount,&#13;
    c.sf_status,&#13;
    c.gfv_l91d,&#13;
    c.is_exclusive&#13;
  FROM (&#13;
    SELECT vendor_id, MAX(date_of_scrape) AS most_recent_date&#13;
    FROM `production-371309.vendor.vendor`&#13;
    GROUP BY vendor_id&#13;
  ) AS max_dates&#13;
  JOIN `production-371309.vendor.vendor` AS t&#13;
    ON t.vendor_id = max_dates.vendor_id AND t.date_of_scrape = max_dates.most_recent_date&#13;
  LEFT JOIN `foodpanda-hk-bigquery.sandbox_kelvin_ng.keeta_dashboard_v2_testing` AS b&#13;
    ON SUBSTR(t.vendor_id, 1, 6) = SUBSTR(b.keeta_uuid, 1, 6)&#13;
  LEFT JOIN `dhh---analytics-apac.pandata_hk.hkg_vendors_agg` AS c&#13;
    ON b.grid = c.global_vendor_id&#13;
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_sales_sf_accounts` AS d&#13;
    ON b.grid = d.global_vendor_id&#13;
  LEFT JOIN `dhh---analytics-apac.pandata_hk.hkg_vendors_agg` AS o&#13;
    ON b.owner_name = o.sf_account_owner&#13;
  LEFT JOIN `production-371309.vendor.vendor_menu` as m&#13;
   ON CAST(t.vendor_id AS INT64) = m.vendor_id&#13;
  WHERE t.lead_source = &quot;keeta&quot; AND t.is_meal_for_one = true AND m.menu_Category =&quot;Promo items&quot;&#13;
),&#13;
second_query AS (&#13;
  SELECT DISTINCT&#13;
    pr.vendor_id AS vendor_code&#13;
  FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.products` pr&#13;
  LEFT JOIN UNNEST(tags) AS tags&#13;
  LEFT JOIN UNNEST(attributes) AS attributes&#13;
  WHERE tags = &apos;meal_for_one&apos;&#13;
    AND pr.global_entity_id IN (&quot;FP_HK&quot;)&#13;
    AND pr.created_at &gt;&gt;= &apos;2024-03-01&apos;&#13;
    AND attributes.attribute_type = &apos;menu_category&apos;&#13;
    AND (LOWER(attributes.name) NOT LIKE &apos;%choice%&apos; OR LOWER(attributes.name) NOT LIKE &apos;%topping%&apos;)&#13;
  QUALIFY ROW_NUMBER() OVER (PARTITION BY pr.global_entity_id, pr.product_id ORDER BY updated_at DESC) = 1&#13;
)&#13;
SELECT&#13;
  f.*,&#13;
  s.vendor_code AS On_our_MFO&#13;
FROM first_query f&#13;
LEFT JOIN second_query s&#13;
  ON f.vendor_code = s.vendor_code</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
