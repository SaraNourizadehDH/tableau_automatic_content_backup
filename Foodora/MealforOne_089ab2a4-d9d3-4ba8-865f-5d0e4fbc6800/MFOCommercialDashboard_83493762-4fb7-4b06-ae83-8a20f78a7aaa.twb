            <column caption='FLGP' datatype='real' name='[GFV (copy)_6280129007641788419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [flgp_eur]&#10;elseif [Parameters].[service_fee_local Parameter] = &apos;Local&apos; then [flgp_local]&#10;end' />
            </column>
            <column caption='GFV' datatype='real' name='[GMV (copy)_6280129007641710594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [gfv_eur]&#10;elseif [Parameters].[service_fee_local Parameter] = &apos;Local&apos; then [gfv_local]&#10;end' />
            </column>
            <column caption='Metric last period' datatype='real' name='[Metric (copy)_6280129009491075123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &apos;Orders&apos; then &#10;    sum(if [Parameters].[Parameter 1] = &apos;Week&apos; and [Calculation_6280129009434628123] = &apos;Last&apos; then [order_count]&#10;        elseif [Parameters].[Parameter 1] = &apos;Month&apos; and [Calculation_6280129009434628123] = &apos;Last&apos; then [order_count] &#10;        elseif [Parameters].[Parameter 1] = &apos;Day&apos; and [Calculation_6280129009434628123] = &apos;Last&apos; then [order_count]  else 0 end)&#10;elseif [Parameters].[Parameter 2] = &apos;GMV&apos; then &#10;    sum(if [Parameters].[Parameter 1] = &apos;Week&apos; and [Calculation_6280129009434628123] = &apos;Last&apos; then [Calculation_6280129007641382913]&#10;        elseif [Parameters].[Parameter 1] = &apos;Month&apos; and [Calculation_6280129009434628123] = &apos;Last&apos; then [Calculation_6280129007641382913]&#10;        elseif [Parameters].[Parameter 1] = &apos;Day&apos; and [Calculation_6280129009434628123] = &apos;Last&apos; then [Calculation_6280129007641382913] else 0 end)&#10;elseif [Parameters].[Parameter 2] = &apos;GFV&apos; then &#10;    sum(if [Parameters].[Parameter 1] = &apos;Week&apos; and [Calculation_6280129009434628123] = &apos;Last&apos; then [GMV (copy)_6280129007641710594]&#10;        elseif [Parameters].[Parameter 1] = &apos;Month&apos; and [Calculation_6280129009434628123] = &apos;Last&apos; then [GMV (copy)_6280129007641710594]&#10;        elseif [Parameters].[Parameter 1] = &apos;Day&apos; and [Calculation_6280129009434628123] = &apos;Last&apos; then [GMV (copy)_6280129007641710594] else 0 end)&#10;elseif [Parameters].[Parameter 2] = &apos;FLGP&apos; then &#10;    sum(if [Parameters].[Parameter 1] = &apos;Week&apos; and [Calculation_6280129009434628123] = &apos;Last&apos; then [GFV (copy)_6280129007641788419]&#10;        elseif [Parameters].[Parameter 1] = &apos;Month&apos; and [Calculation_6280129009434628123] = &apos;Last&apos; then [GFV (copy)_6280129007641788419]&#10;        elseif [Parameters].[Parameter 1] = &apos;Day&apos; and [Calculation_6280129009434628123] = &apos;Last&apos; then [GFV (copy)_6280129007641788419] else 0 end)&#10;end' />
            </column>
            <column caption='Metric current runrate' datatype='real' name='[Metric current period (copy)_6280129009510002746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos; and ([Parameters].[Parameter 2] = &apos;Orders&apos; or [Parameters].[Parameter 2] = &apos;GMV&apos; or [Parameters].[Parameter 2] = &apos;GFV&apos; or [Parameters].[Parameter 2] = &apos;FLGP&apos;)&#10;    then [Metric latest period (copy)_6280129009504780341]/avg([no_of_days_this_week])*7&#10;elseif [Parameters].[Parameter 1] = &apos;Week&apos; then [Metric latest period (copy)_6280129009504780341]&#10;elseif [Parameters].[Parameter 1] = &apos;Month&apos; and ([Parameters].[Parameter 2] = &apos;Orders&apos; or [Parameters].[Parameter 2] = &apos;GMV&apos; or [Parameters].[Parameter 2] = &apos;GFV&apos; or [Parameters].[Parameter 2] = &apos;FLGP&apos;) &#10;    then [Metric latest period (copy)_6280129009504780341]/avg([no_of_days_this_month])*avg([no_of_days_month])&#10;elseif [Parameters].[Parameter 1] = &apos;Month&apos; then [Metric latest period (copy)_6280129009504780341]&#10;elseif [Parameters].[Parameter 1] = &apos;Day&apos; then [Metric latest period (copy)_6280129009504780341]&#10;end' />
            </column>
            <column caption='Rank' datatype='string' datatype-customized='true' name='[Metric difference rank (copy)_6280129009528123468]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(RANK([% growth (copy)_6280129009520689219], &apos;desc&apos; ))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Metric current period' datatype='real' name='[Metric latest period (copy)_6280129009504780341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &apos;Orders&apos; then &#10;    sum(if [Parameters].[Parameter 1] = &apos;Week&apos; and [Calculation_6280129009434628123] = &apos;Current&apos; then [order_count]&#10;        elseif [Parameters].[Parameter 1] = &apos;Month&apos; and [Calculation_6280129009434628123] = &apos;Current&apos; then [order_count] &#10;        elseif [Parameters].[Parameter 1] = &apos;Day&apos; and [Calculation_6280129009434628123] = &apos;Current&apos; then [order_count]  else 0 end)&#10;elseif [Parameters].[Parameter 2] = &apos;GMV&apos; then &#10;    sum(if [Parameters].[Parameter 1] = &apos;Week&apos; and [Calculation_6280129009434628123] = &apos;Current&apos; then [Calculation_6280129007641382913]&#10;        elseif [Parameters].[Parameter 1] = &apos;Month&apos; and [Calculation_6280129009434628123] = &apos;Current&apos; then [Calculation_6280129007641382913]&#10;        elseif [Parameters].[Parameter 1] = &apos;Day&apos; and [Calculation_6280129009434628123] = &apos;Current&apos; then [Calculation_6280129007641382913] else 0 end)&#10;elseif [Parameters].[Parameter 2] = &apos;GFV&apos; then &#10;    sum(if [Parameters].[Parameter 1] = &apos;Week&apos; and [Calculation_6280129009434628123] = &apos;Current&apos; then [GMV (copy)_6280129007641710594]&#10;        elseif [Parameters].[Parameter 1] = &apos;Month&apos; and [Calculation_6280129009434628123] = &apos;Current&apos; then [GMV (copy)_6280129007641710594]&#10;        elseif [Parameters].[Parameter 1] = &apos;Day&apos; and [Calculation_6280129009434628123] = &apos;Current&apos; then [GMV (copy)_6280129007641710594] else 0 end)&#10;elseif [Parameters].[Parameter 2] = &apos;FLGP&apos; then &#10;    sum(if [Parameters].[Parameter 1] = &apos;Week&apos; and [Calculation_6280129009434628123] = &apos;Current&apos; then [GFV (copy)_6280129007641788419]&#10;        elseif [Parameters].[Parameter 1] = &apos;Month&apos; and [Calculation_6280129009434628123] = &apos;Current&apos; then [GFV (copy)_6280129007641788419]&#10;        elseif [Parameters].[Parameter 1] = &apos;Day&apos; and [Calculation_6280129009434628123] = &apos;Current&apos; then [GFV (copy)_6280129007641788419] else 0 end)&#10;end' />
