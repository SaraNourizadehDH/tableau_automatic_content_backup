      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='main data' name='federated.1dtddn11ueo48f11lgw830qa7578' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top &amp; Bottom N' datatype='integer' default-format='n#,##0;-#,##0' name='[Currency (copy)]' param-domain-type='any' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
            </column>
            <column alias='Daily' caption='Day/Week/Month' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
              <aliases>
                <alias key='&quot;Day&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[service_fee_local Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dtddn11ueo48f11lgw830qa7578'>
            <column caption='Metric Difference' datatype='real' name='[% growth (copy)_6280129009520689219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Metric current period (copy)_6280129009510002746] - [Metric (copy)_6280129009491075123]' />
            </column>
            <column caption='geohash fixed total order last4w' datatype='integer' name='[Calculation_3775283193466970114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [geohash]: sum(if [order_week] &gt;= [Calculation_3775283193470758916] then [order_count] end)}' />
            </column>
            <column caption='Geohash order share' datatype='real' name='[Calculation_3775283193467129859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [order_week] &gt;= [Calculation_3775283193470758916] then [order_count] end)/sum([Calculation_3775283193466970114])' />
            </column>
            <column caption='Last 4 week date' datatype='datetime' name='[Calculation_3775283193470758916]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='dateadd(&apos;week&apos;,-4,DATETRUNC(&apos;week&apos;,TODAY()-1))' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_6280129007641382913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [gmv_eur]&#10;elseif [Parameters].[service_fee_local Parameter] = &apos;Local&apos; then [gmv_local]&#10;end' />
            </column>
            <column caption='Avg Comm %' datatype='real' name='[Calculation_6280129007686660105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Comm Base (copy)_6280129007686012936])/sum([FLGP (copy)_6280129007685885959])' />
            </column>
            <column caption='FLGPO' datatype='real' name='[Calculation_6280129007687086091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GFV (copy)_6280129007641788419])/sum([order_count])' />
            </column>
            <column caption='Current or last period' datatype='string' name='[Calculation_6280129009434628123]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos; and [this_or_last_week_flag] = &apos;This week&apos; then &apos;Current&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Month&apos; and [this_or_last_month_flag] = &apos;This month&apos; then &apos;Current&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Week&apos; and [this_or_last_week_flag] = &apos;Last week&apos; then &apos;Last&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Month&apos; and [this_or_last_month_flag] = &apos;Last month&apos; then &apos;Last&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Day&apos; and [order_date] = [data_latest_date] then &apos;Current&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Day&apos; and [order_date] = [data_latest_date]-1 then &apos;Last&apos;&#10;else &apos;Older&apos; end' />
            </column>
            <column caption='Commission' datatype='real' name='[Comm Base (copy)_6280129007686012936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [commission_net_eur]&#10;elseif [Parameters].[service_fee_local Parameter] = &apos;Local&apos; then [commission_net_local]&#10;end' />
            </column>
            <column caption='Comm Base' datatype='real' name='[FLGP (copy)_6280129007685885959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [commission_base_eur]&#10;elseif [Parameters].[service_fee_local Parameter] = &apos;Local&apos; then [commission_base_local]&#10;end' />
            </column>
            <column caption='FLGP' datatype='real' name='[GFV (copy)_6280129007641788419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [flgp_eur]&#10;elseif [Parameters].[service_fee_local Parameter] = &apos;Local&apos; then [flgp_local]&#10;end' />
            </column>
            <column caption='AOV' datatype='real' name='[GFV (copy)_6280129007685480453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_6280129007641382913])/sum([order_count])' />
            </column>
            <column caption='GFV' datatype='real' name='[GMV (copy)_6280129007641710594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [gfv_eur]&#10;elseif [Parameters].[service_fee_local Parameter] = &apos;Local&apos; then [gfv_local]&#10;end' />
            </column>
            <column caption='Metric last period' datatype='real' name='[Metric (copy)_6280129009491075123]' role='measure' type='quantitative'>
