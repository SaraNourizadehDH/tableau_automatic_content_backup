          <alias key='&quot;[federated.1dtddn11ueo48f11lgw830qa7578].[pcto:usr:Last 7d orders (copy) (copy)_4136063682544103426:qk]&quot;' value='% of last 30d orders total' />
          <alias key='&quot;[federated.1dtddn11ueo48f11lgw830qa7578].[pcto:usr:Last 7d orders (copy)_4136063682544099329:qk]&quot;' value='% of last 14d orders total' />
          <alias key='&quot;[federated.1dtddn11ueo48f11lgw830qa7578].[sum:order_count:qk]&quot;' value='Orders' />
          <alias key='&quot;[federated.1dtddn11ueo48f11lgw830qa7578].[usr:\% growth (copy)_6280129009520689219:qk]&quot;' value='Difference' />
          <alias key='&quot;[federated.1dtddn11ueo48f11lgw830qa7578].[usr:Calculation_6280129009504985142:qk]&quot;' value='% growth' />
          <alias key='&quot;[federated.1dtddn11ueo48f11lgw830qa7578].[usr:Geohash flgp share (copy)_3775283193489858576:qk]&quot;' value='FLGP share' />
          <alias key='&quot;[federated.1dtddn11ueo48f11lgw830qa7578].[usr:Geohash gmv share (copy)_3775283193489862673:qk]&quot;' value='GMV share' />
          <alias key='&quot;[federated.1dtddn11ueo48f11lgw830qa7578].[usr:Geohash order share (copy)_3775283193489870866:qk]&quot;' value='Order share' />
          <alias key='&quot;[federated.1dtddn11ueo48f11lgw830qa7578].[usr:Metric (copy)_6280129009491075123:qk]&quot;' value='Last period' />
          <alias key='&quot;[federated.1dtddn11ueo48f11lgw830qa7578].[usr:Metric current period (copy)_6280129009510002746:qk]&quot;' value='Runrate' />
