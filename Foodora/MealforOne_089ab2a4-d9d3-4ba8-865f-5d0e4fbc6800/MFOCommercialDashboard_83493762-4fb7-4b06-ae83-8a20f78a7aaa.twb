      <column caption='# MFO geohash w orders' datatype='integer' name='[# MFO orders (copy)_6280129009519865921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([geohash])' />
      </column>
      <column caption='# MFO orders' datatype='integer' name='[# MFO vendor (copy)_6280129009518010430]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([order_count])' />
      </column>
      <column caption='Metric Difference' datatype='real' name='[% growth (copy)_6280129009520689219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Metric current period (copy)_6280129009510002746] - [Metric (copy)_6280129009491075123]' />
      </column>
      <column caption='Orders % growth' datatype='real' name='[% growth (copy)_6280129010494238804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Metric current runrate (copy)_6280129010493010002]/[Metric last period (copy)_6280129010494349397] - 1' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
