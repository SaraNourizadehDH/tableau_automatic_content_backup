            <column caption='Currency' datatype='string' name='[service_fee_local Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dtddn11ueo48f11lgw830qa7578'>
            <column caption='Last 4 week date' datatype='datetime' name='[Calculation_3775283193470758916]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='dateadd(&apos;week&apos;,-4,DATETRUNC(&apos;week&apos;,TODAY()-1))' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_6280129007641382913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [gmv_eur]&#10;elseif [Parameters].[service_fee_local Parameter] = &apos;Local&apos; then [gmv_local]&#10;end' />
            </column>
            <column caption='FLGP' datatype='real' name='[GFV (copy)_6280129007641788419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [flgp_eur]&#10;elseif [Parameters].[service_fee_local Parameter] = &apos;Local&apos; then [flgp_local]&#10;end' />
            </column>
            <column caption='zone flgp share' datatype='real' name='[Geohash flgp share (copy)_3775283193489858576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [order_week] &gt;= [Calculation_3775283193470758916] then [GFV (copy)_6280129007641788419] end)/sum([geohash fixed total flgp last4w (copy)_3775283193489440780])' />
            </column>
            <column caption='zone gmv share' datatype='real' name='[Geohash gmv share (copy)_3775283193489862673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [order_week] &gt;= [Calculation_3775283193470758916] then [Calculation_6280129007641382913] end)/sum([geohash fixed total gmv last4w (copy)_3775283193489518605])' />
            </column>
            <column caption='zone order share' datatype='real' name='[Geohash order share (copy)_3775283193489870866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [order_week] &gt;= [Calculation_3775283193470758916] then [order_count] end)/sum([geohash fixed total order last4w (copy)_3775283193489580046])' />
            </column>
            <column datatype='string' name='[chain_code]' role='dimension' type='nominal' />
            <column caption='Chain name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column datatype='real' name='[flgp_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[flgp_local]' role='measure' type='quantitative' />
            <column caption='zone fixed total flgp last4w' datatype='real' name='[geohash fixed total flgp last4w (copy)_3775283193489440780]' role='measure' type='quantitative'>
