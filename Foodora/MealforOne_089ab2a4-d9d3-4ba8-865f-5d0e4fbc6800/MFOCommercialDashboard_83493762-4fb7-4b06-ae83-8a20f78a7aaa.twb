            <column caption='Geohash flgp share' datatype='real' name='[Geohash gmv share (copy)_3775283193489711119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [order_week] &gt;= [Calculation_3775283193470758916] then [GFV (copy)_6280129007641788419] end)/sum([geohash fixed total order last4w (copy)_3775283193489371147])' />
            </column>
            <column caption='Geohash gmv share' datatype='real' name='[Geohash order share (copy)_3775283193489240073]' role='measure' type='quantitative'>
