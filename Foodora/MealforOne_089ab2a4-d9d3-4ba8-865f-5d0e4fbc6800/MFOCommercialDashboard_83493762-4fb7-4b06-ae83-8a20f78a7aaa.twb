    <datasource caption='main data' inline='true' name='federated.1dtddn11ueo48f11lgw830qa7578' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0vwujm90n9cg7z14e3zl00220x29'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='steven.song@foodpanda.co.th' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='test - mfo dashboard waterfall' name='excel-direct.16irc120ldj6061c74boc0nicio0'>
            <connection class='excel-direct' cleaning='no' compat='no' dataRefreshTime='' filename='Data/Desktop/test - mfo dashboard waterfall.xlsx' interpretationMode='0' server='' validate='no' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0vwujm90n9cg7z14e3zl00220x29' name='Custom SQL Query1' type='text'>/*************************** MFO product level data *********************************/
WITH latest_vendor_status AS (
  SELECT DISTINCT 
    content.global_entity_id,
    content.vendor_id AS vendor_code, 
    content.meal_for_one,
    -- ROW_NUMBER () OVER (PARTITION BY content.global_entity_id, content.vendor_id ORDER BY content.timestamp DESC) AS timestamp_rank 
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.vendor_stream`
  WHERE 
  global_entity_id = &apos;FP_HK&apos;
  -- global_entity_id in (&quot;FP_SG&quot;, &quot;FP_KH&quot;, &quot;FP_LA&quot;, &quot;FP_HK&quot;, &quot;FP_TW&quot;, &quot;FP_TH&quot;, &quot;FP_PH&quot;, &quot;FP_PK&quot;, &quot;FP_MM&quot;, &quot;FP_MY&quot;, &quot;FP_BD&quot;)
  QUALIFY ROW_NUMBER () OVER (PARTITION BY content.global_entity_id, content.vendor_id ORDER BY content.timestamp DESC) = 1
),

mfo_vendors as (
  SELECT
    *
  FROM latest_vendor_status
  where meal_for_one
),

hk_zones AS (
  SELECT DISTINCT
    zone_group,
    zone_id,
    zone_name
  FROM `fulfillment-dwh-production.pandata_report.country_HK_lg_zone_groups`
  WHERE is_active
  AND NOT is_corporate_zone
  AND NOT is_hk_wide_zone
  ORDER BY 1
),

all_mfo_vendors AS (
  SELECT DISTINCT 
    mfovd.global_entity_id,
    mfovd.vendor_code,
    vd.vendor_name,
    vd.chain_name, 
    vd.chain_code,
    vd.gmv_class,
    vd.team_category,
    vd.team_lead_name,
    vd.team_source,
    vd.sf_owner_name,
    vd.lg_zone_id AS zone_id,
    vd.lg_city_name AS city_name,
    vd.is_active,
    vd.is_private,
    vd.is_test,
    CASE WHEN vd.global_entity_id = &quot;FP_HK&quot; AND vd.lg_zone_id = hkz.zone_id THEN hkz.zone_group ELSE vd.lg_zone_name END AS zone_name,
    vd.primary_cuisine,
    ST_GEOHASH(ST_GEOGPOINT(vd.longitude, vd.latitude), 6) AS geohash,
  FROM mfo_vendors mfovd
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors` AS vd
    ON mfovd.global_entity_id = vd.global_entity_id
    AND mfovd.vendor_code = vd.vendor_code
  LEFT JOIN hk_zones AS hkz
    ON vd.lg_zone_id = hkz.zone_id
    and vd.global_entity_id = &quot;FP_HK&quot; -- update
  WHERE NOT vd.is_test
  AND vd.business_type_apac = &quot;restaurants&quot;
  AND lower(hkz.zone_group) NOT IN (&quot;sham tseng&quot;,&quot;discovery bay&quot;)
),

mfo_products_latest_status AS ( -- all product info in HK with latest timestamp
  SELECT DISTINCT 
    content.global_entity_id,
    tags,
    content.vendor.vendor_id,
    content.product_id,
    content.product_parent.product_parent_id,
    content.active,
    content.name AS product_name,
    content.unit_price/100 AS unit_price,
    image.url AS image_url,
    content.food_science.ontology.is_combo,
    -- names.locale,
    -- descriptions.locale
    -- ROW_NUMBER () OVER (PARTITION BY content.product_id ORDER BY timestamp DESC) AS ranking 
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.product_stream` s
  LEFT JOIN UNNEST(content.tags) tags
  -- LEFT JOIN UNNEST(content.names) names
  -- LEFT JOIN UNNEST(content.descriptions) descriptions
  LEFT JOIN UNNEST(content.image_urls) image
  WHERE content.global_entity_id = &apos;FP_HK&apos;
  AND created_date &gt;&gt;= &apos;2024-03-01&apos; -- change
  AND content.active
  -- AND tags LIKE &quot;%meal_for_one%&quot;
  QUALIFY ROW_NUMBER () OVER (PARTITION BY content.global_entity_id, content.product_id ORDER BY timestamp DESC) = 1
  order by 3
),-- 3518910

translation_en AS (
  SELECT DISTINCT
    content.global_entity_id,
    content.product_id,
    content.name AS product_name,
    names.locale AS name_locale,
    names.value AS product_name_en,
    description.locale AS description_locale,
    description.value AS product_description_en,
    -- ROW_NUMBER () OVER (PARTITION BY content.product_id ORDER BY timestamp DESC) AS ranking 
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.product_stream` AS ps
  LEFT JOIN UNNEST(content.names) names
  LEFT JOIN UNNEST(content.descriptions) description
  LEFT JOIN UNNEST(content.tags) tags
  WHERE content.global_entity_id = &apos;FP_HK&apos;  -- change
  AND ps.created_date &gt;&gt;= &apos;2024-03-01&apos; -- change
  AND names.locale like &apos;%en-%&apos;
  AND description.locale like &apos;%en-%&apos;
  -- AND tags LIKE &quot;%meal_for_one%&quot;
  QUALIFY ROW_NUMBER () OVER (PARTITION BY content.global_entity_id, content.product_id ORDER BY timestamp DESC) = 1
),

translation_local AS (
  SELECT DISTINCT
    content.global_entity_id,
    content.product_id,
    content.name AS product_name,
    names.locale AS name_locale,
    names.value AS product_name_local,
    description.locale AS description_locale,
    description.value AS product_description_local,
    -- ROW_NUMBER () OVER (PARTITION BY content.product_id ORDER BY timestamp DESC) AS ranking 
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.product_stream` AS ps
  LEFT JOIN UNNEST(content.names) names
  LEFT JOIN UNNEST(content.descriptions) description
  LEFT JOIN UNNEST(content.tags) tags
  WHERE ps.global_entity_id = &apos;FP_HK&apos;  -- change
  AND ps.created_date &gt;&gt;= &apos;2024-03-01&apos; -- change
  -- AND description.locale = &apos;zh-HK&apos;
  -- AND tags LIKE &quot;%meal_for_one%&quot;
  AND CASE WHEN content.global_entity_id = &quot;FP_HK&quot; AND names.locale = &quot;zh-HK&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_KH&quot; AND names.locale = &quot;km-KH&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_BD&quot; AND names.locale = &quot;en-BD&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_TH&quot; AND names.locale = &quot;th-TH&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_TW&quot; AND names.locale = &quot;zh-TW&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_PH&quot; AND names.locale = &quot;en-PH&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_MM&quot; AND names.locale = &quot;my-MM&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_MY&quot; AND names.locale = &quot;ms-MY&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_LA&quot; AND names.locale = &quot;lo-LA&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_PK&quot; AND names.locale = &quot;en-PK&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_SG&quot; AND names.locale = &quot;zh-SG&quot; THEN TRUE
            ELSE FALSE END
  AND CASE WHEN content.global_entity_id = &quot;FP_HK&quot; AND description.locale = &quot;zh-HK&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_KH&quot; AND description.locale = &quot;km-KH&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_BD&quot; AND description.locale = &quot;en-BD&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_TH&quot; AND description.locale = &quot;th-TH&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_TW&quot; AND description.locale = &quot;zh-TW&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_PH&quot; AND description.locale = &quot;en-PH&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_MM&quot; AND description.locale = &quot;my-MM&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_MY&quot; AND description.locale = &quot;ms-MY&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_LA&quot; AND description.locale = &quot;lo-LA&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_PK&quot; AND description.locale = &quot;en-PK&quot; THEN TRUE
            WHEN content.global_entity_id = &quot;FP_SG&quot; AND description.locale = &quot;zh-SG&quot; THEN TRUE
            ELSE FALSE END
  QUALIFY ROW_NUMBER () OVER (PARTITION BY content.global_entity_id, content.product_id ORDER BY timestamp DESC) = 1
),

menu_category AS (
  SELECT DISTINCT
    ps.global_entity_id,
    content.product_id,
    content.name AS product_name,
    attr.attribute_type, 
    attr.name AS menu_category,
    -- ROW_NUMBER () OVER (PARTITION BY content.product_id ORDER BY timestamp DESC) AS ranking 
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.product_stream` AS ps
  LEFT JOIN UNNEST(content.attributes) attr
  WHERE ps.global_entity_id = &quot;FP_HK&quot; -- upate
  AND ps.created_date &gt;&gt;= &quot;2024-03-01&quot; -- change
  AND attr.attribute_type = &quot;menu_category&quot; -- add mfo filter?
  QUALIFY ROW_NUMBER () OVER (PARTITION BY content.global_entity_id, content.product_id ORDER BY timestamp DESC) = 1
),

topping_ids AS (
  SELECT DISTINCT
    ctl.global_entity_id,
    CAST(v.id AS STRING) AS variation_id, 
    tp.position AS topping_position, 
    tp.title AS topping_title
  FROM `fulfillment-dwh-production.pandata_curated.ctl_products` ctl
  LEFT JOIN UNNEST(variations) v 
  LEFT JOIN UNNEST(v.topping_templates) tp 
  WHERE ctl.global_entity_id = &apos;FP_HK&apos;
  AND ctl.created_date_utc &gt;&gt;= &apos;2024-01-01&apos;
  AND v.id IS NOT null
  ORDER BY 1,2,3
),

toppings_agg AS (
  SELECT DISTINCT 
    global_entity_id,
    variation_id,
  STRING_AGG(topping_title, &quot; || &quot;) AS toppings
  FROM topping_ids 
  GROUP BY 1,2
),

-- ## 3. Menu Hour
