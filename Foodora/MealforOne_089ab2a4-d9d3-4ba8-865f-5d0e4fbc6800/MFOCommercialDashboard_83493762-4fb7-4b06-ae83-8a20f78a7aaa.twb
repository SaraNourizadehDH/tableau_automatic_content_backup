        </aliases>
      </column>
      <column caption='geohash fixed total order last4w' datatype='integer' name='[Calculation_3775283193466970114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [geohash]: sum(if [order_week] &gt;= [Calculation_3775283193470758916] then [order_count] end)}' />
      </column>
      <column caption='Geohash order share' datatype='real' name='[Calculation_3775283193467129859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [order_week] &gt;= [Calculation_3775283193470758916] then [order_count] end)/sum([Calculation_3775283193466970114])' />
      </column>
      <column caption='Last 4 week date' datatype='datetime' name='[Calculation_3775283193470758916]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='dateadd(&apos;week&apos;,-4,DATETRUNC(&apos;week&apos;,TODAY()-1))' />
      </column>
      <column caption='Last 7d orders' datatype='integer' name='[Calculation_4136063682543878144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [order_date (Custom SQL Query1)] &gt; TODAY()-8 then [order_count (Custom SQL Query1)] else 0 end)' />
      </column>
      <column caption='day/week/month parameter' datatype='string' name='[Calculation_5079497431127420928]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Day&apos; then &apos;Day&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Week&apos; then &apos;Week&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Month&apos; then &apos;Month&apos;&#10;end' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_6280129007641382913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [gmv_eur]&#10;elseif [Parameters].[service_fee_local Parameter] = &apos;Local&apos; then [gmv_local]&#10;end' />
      </column>
      <column caption='Avg Comm %' datatype='real' name='[Calculation_6280129007686660105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Comm Base (copy)_6280129007686012936])/sum([FLGP (copy)_6280129007685885959])' />
      </column>
      <column caption='FLGPO' datatype='real' name='[Calculation_6280129007687086091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([GFV (copy)_6280129007641788419])/sum([order_count])' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_6280129009384341521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &apos;Orders&apos; then sum([order_count])&#10;elseif [Parameters].[Parameter 2] = &apos;GMV&apos; then sum([Calculation_6280129007641382913])&#10;elseif [Parameters].[Parameter 2] = &apos;GFV&apos; then sum([GMV (copy)_6280129007641710594])&#10;elseif [Parameters].[Parameter 2] = &apos;FLGP&apos; then sum([GFV (copy)_6280129007641788419])&#10;elseif [Parameters].[Parameter 2] = &apos;FLGPO&apos; then sum([GFV (copy)_6280129007641788419])/sum([order_count])&#10;elseif [Parameters].[Parameter 2] = &apos;AFV&apos; then sum([GMV (copy)_6280129007641710594])/sum([order_count])&#10;elseif [Parameters].[Parameter 2] = &apos;Avg comm %&apos; then sum([Comm Base (copy)_6280129007686012936])/sum([FLGP (copy)_6280129007685885959])&#10;end' />
      </column>
      <column caption='Day/Week/Month view' datatype='datetime' name='[Calculation_6280129009395130387]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos; then DATETRUNC(&apos;week&apos;,[order_week],&apos;Monday&apos;) &#10;elseif [Parameters].[Parameter 1] = &apos;Month&apos; then datetrunc(&apos;month&apos;,[order_month])&#10;elseif [Parameters].[Parameter 1] = &apos;Day&apos; then [order_date]&#10;end' />
      </column>
      <column caption='week or month filter' datatype='string' name='[Calculation_6280129009408806934]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='recent day/week/month' datatype='integer' name='[Calculation_6280129009418608665]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos; then [last_6weeks]&#10;elseif [Parameters].[Parameter 1] = &apos;Month&apos; then [last_6months]&#10;elseif [Parameters].[Parameter 1] = &apos;Day&apos; then [last_7days]&#10;end' />
      </column>
      <column caption='Current or last period' datatype='string' name='[Calculation_6280129009434628123]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos; and [this_or_last_week_flag] = &apos;This week&apos; then &apos;Current&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Month&apos; and [this_or_last_month_flag] = &apos;This month&apos; then &apos;Current&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Week&apos; and [this_or_last_week_flag] = &apos;Last week&apos; then &apos;Last&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Month&apos; and [this_or_last_month_flag] = &apos;Last month&apos; then &apos;Last&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Day&apos; and [order_date] = [data_latest_date] then &apos;Current&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Day&apos; and [order_date] = [data_latest_date]-1 then &apos;Last&apos;&#10;else &apos;Older&apos; end' />
      </column>
      <column caption='FLGP component names' datatype='string' name='[Calculation_6280129009436917788]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [flgp_component_number] = 1 then &apos;Commission&apos;&#10;elseif [flgp_component_number] = 2 then &apos;Delivery fee&apos;&#10;elseif [flgp_component_number] = 3 then &apos;Subscription&apos;&#10;elseif [flgp_component_number] = 4 then &apos;Ads&apos;&#10;elseif [flgp_component_number] = 5 then &apos;Other NCR&apos;&#10;elseif [flgp_component_number] = 6 then &apos;Small order fee&apos;&#10;elseif [flgp_component_number] = 7 then &apos;Service fee&apos;&#10;elseif [flgp_component_number] = 8 then &apos;Rider CPO&apos;&#10;elseif [flgp_component_number] = 9 then &apos;Other delivery CPO&apos;&#10;elseif [flgp_component_number] = 10 then &apos;Wastage&apos;&#10;elseif [flgp_component_number] = 11 then &apos;Transmission method CPO&apos;&#10;elseif [flgp_component_number] = 12 then &apos;Conctact centre CPO&apos;&#10;elseif [flgp_component_number] = 13 then &apos;Online payment cost&apos;&#10;elseif [flgp_component_number] = 14 then &apos;Other COS CPO&apos;&#10;elseif [flgp_component_number] = 15 then &apos;Incentive&apos;&#10;elseif [flgp_component_number] = 16 then &apos;FLGPO&apos;&#10;end' />
      </column>
      <column caption='Ads revenue' datatype='real' name='[Calculation_6280129009461399584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [ads_rev_per_valid_order_eur]&#10;else [ads_rev_per_valid_order_local]&#10;end' />
      </column>
      <column caption='Contact centre CPO' datatype='real' name='[Calculation_6280129009461645345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [contact_center_cpo_eur]&#10;else [contact_center_cpo_local]&#10;end' />
      </column>
      <column caption='Delivery fee' datatype='real' name='[Calculation_6280129009461780514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [delivery_fee_net_eur]&#10;else [delivery_fee_net_local]&#10;end' />
      </column>
      <column caption='FLGP components per order' datatype='real' name='[Calculation_6280129009466187824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([FLGP component base value (copy)_6280129009465413679])/sum([order_count])' />
      </column>
      <column caption='FLGP base per order' datatype='real' name='[Calculation_6280129009466556465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([FLGP component names (copy)_6280129009460592671])/sum([order_count])' />
