    <worksheet name='3-4 FLGPO waterfall'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>Current &lt;</run>
            <run bold='true' fontcolor='#ffffff'>[federated.1dtddn11ueo48f11lgw830qa7578].[none:Calculation_5079497431127420928:nk]</run>
            <run bold='true' fontcolor='#ffffff'>&gt; FLGPO Waterfall (&lt;</run>
            <run bold='true' fontcolor='#ffffff'>[Parameters].[service_fee_local Parameter]</run>
            <run bold='true' fontcolor='#ffffff'>&gt;) - &lt;</run>
            <run bold='true' fontcolor='#ffffff'>[federated.1dtddn11ueo48f11lgw830qa7578].[none:vendor_name:nk]</run>
            <run bold='true' fontcolor='#ffffff'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='main data' name='federated.1dtddn11ueo48f11lgw830qa7578' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Day/Week/Month' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
              <aliases>
                <alias key='&quot;Day&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[service_fee_local Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dtddn11ueo48f11lgw830qa7578'>
            <column caption='day/week/month parameter' datatype='string' name='[Calculation_5079497431127420928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Day&apos; then &apos;Day&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Week&apos; then &apos;Week&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Month&apos; then &apos;Month&apos;&#10;end' />
            </column>
            <column caption='Current or last period' datatype='string' name='[Calculation_6280129009434628123]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos; and [this_or_last_week_flag] = &apos;This week&apos; then &apos;Current&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Month&apos; and [this_or_last_month_flag] = &apos;This month&apos; then &apos;Current&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Week&apos; and [this_or_last_week_flag] = &apos;Last week&apos; then &apos;Last&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Month&apos; and [this_or_last_month_flag] = &apos;Last month&apos; then &apos;Last&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Day&apos; and [order_date] = [data_latest_date] then &apos;Current&apos;&#10;elseif [Parameters].[Parameter 1] = &apos;Day&apos; and [order_date] = [data_latest_date]-1 then &apos;Last&apos;&#10;else &apos;Older&apos; end' />
            </column>
            <column caption='FLGP component names' datatype='string' name='[Calculation_6280129009436917788]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [flgp_component_number] = 1 then &apos;Commission&apos;&#10;elseif [flgp_component_number] = 2 then &apos;Delivery fee&apos;&#10;elseif [flgp_component_number] = 3 then &apos;Subscription&apos;&#10;elseif [flgp_component_number] = 4 then &apos;Ads&apos;&#10;elseif [flgp_component_number] = 5 then &apos;Other NCR&apos;&#10;elseif [flgp_component_number] = 6 then &apos;Small order fee&apos;&#10;elseif [flgp_component_number] = 7 then &apos;Service fee&apos;&#10;elseif [flgp_component_number] = 8 then &apos;Rider CPO&apos;&#10;elseif [flgp_component_number] = 9 then &apos;Other delivery CPO&apos;&#10;elseif [flgp_component_number] = 10 then &apos;Wastage&apos;&#10;elseif [flgp_component_number] = 11 then &apos;Transmission method CPO&apos;&#10;elseif [flgp_component_number] = 12 then &apos;Conctact centre CPO&apos;&#10;elseif [flgp_component_number] = 13 then &apos;Online payment cost&apos;&#10;elseif [flgp_component_number] = 14 then &apos;Other COS CPO&apos;&#10;elseif [flgp_component_number] = 15 then &apos;Incentive&apos;&#10;elseif [flgp_component_number] = 16 then &apos;FLGPO&apos;&#10;end' />
            </column>
            <column caption='Ads revenue' datatype='real' name='[Calculation_6280129009461399584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [ads_rev_per_valid_order_eur]&#10;else [ads_rev_per_valid_order_local]&#10;end' />
            </column>
            <column caption='Contact centre CPO' datatype='real' name='[Calculation_6280129009461645345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [contact_center_cpo_eur]&#10;else [contact_center_cpo_local]&#10;end' />
            </column>
            <column caption='Delivery fee' datatype='real' name='[Calculation_6280129009461780514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[service_fee_local Parameter] = &apos;EUR&apos; then [delivery_fee_net_eur]&#10;else [delivery_fee_net_local]&#10;end' />
            </column>
            <column caption='FLGP components per order' datatype='real' name='[Calculation_6280129009466187824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([FLGP component base value (copy)_6280129009465413679])/sum([order_count])' />
