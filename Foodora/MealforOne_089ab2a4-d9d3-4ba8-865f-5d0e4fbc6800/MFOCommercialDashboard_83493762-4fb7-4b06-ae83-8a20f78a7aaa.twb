            </column>
            <column caption='Comm% current period' datatype='real' name='[Orders current period (copy)_6280129010497523808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Parameters].[Parameter 1] = &apos;Day&apos; and [order_date] = TODAY()-2 then [Comm Base (copy)_6280129007686012936]&#10;    elseif [Parameters].[Parameter 1] &lt;&gt; &apos;Day&apos; and [Calculation_6280129009434628123] = &apos;Current&apos; then [Comm Base (copy)_6280129007686012936] end)&#10;/sum(if [Parameters].[Parameter 1] = &apos;Day&apos; and [order_date] = TODAY()-2 then [FLGP (copy)_6280129007685885959]&#10;    elseif [Parameters].[Parameter 1] &lt;&gt; &apos;Day&apos; and [Calculation_6280129009434628123] = &apos;Current&apos; then [FLGP (copy)_6280129007685885959] end)' />
