              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [successful_orders] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [successful_orders] END)-1' />
            </column>
            <column caption='% Complaints MoM' datatype='real' name='[% Complaints (copy)_648799847253827617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(IF [month_type]=&quot;CM&quot; THEN [orders_complaints] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [gross_orders] END)&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(IF [month_type]=&quot;PM&quot; THEN [orders_complaints] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [gross_orders] END)&#13;&#10;)&#13;&#10;-1' />
            </column>
            <column caption='% Failed Orders MoM' datatype='real' name='[% Failed Orders (copy)_648799847253389343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(IF [month_type]=&quot;CM&quot; THEN [failed_orders] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [gross_orders] END)&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(IF [month_type]=&quot;PM&quot; THEN [failed_orders] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [gross_orders] END)&#13;&#10;)&#13;&#10;-1' />
            </column>
            <column caption='% Fill Rate MoM' datatype='real' name='[% Fill Rate (copy)_648799847254376484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(IF [month_type]=&quot;CM&quot; THEN [customer_qty_delivered] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [customer_qty_ordered] END)&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(IF [month_type]=&quot;PM&quot; THEN [customer_qty_delivered] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [customer_qty_ordered] END)&#13;&#10;)&#13;&#10;-1' />
            </column>
            <column caption='% Gross Margin MoM' datatype='real' name='[% Gross Margin (copy)_648799847249481745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;(&#13;&#10;SUM(IF [month_type]=&quot;CM&quot; THEN [customer_net_total_price] END)&#13;&#10;-SUM(IF [month_type]=&quot;CM&quot; THEN [total_cogs] END)&#13;&#10;)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [customer_net_total_price] END)&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;(&#13;&#10;SUM(IF [month_type]=&quot;PM&quot; THEN [customer_net_total_price] END)&#13;&#10;-SUM(IF [month_type]=&quot;PM&quot; THEN [total_cogs] END)&#13;&#10;)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [customer_net_total_price] END)&#13;&#10;)&#13;&#10;-1' />
