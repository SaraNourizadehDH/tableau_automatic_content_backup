      <aliases enabled='yes' />
      <column caption='# Active Customers (by Warehouse) MoM' datatype='real' name='[# Active Customers (by Warehouse) (copy)_648799847257182258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [active_customers] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [active_customers] END)&#13;&#10;-1' />
      </column>
      <column caption='# Active Warehouses MoM' datatype='real' name='[# Active Warehouses (copy)_648799847249825810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [month_type]=&quot;CM&quot; THEN [warehouse_id] END)&#13;&#10;/COUNTD(IF [month_type]=&quot;PM&quot; THEN [warehouse_id] END)&#13;&#10;-1' />
      </column>
      <column caption='# Daily Orders Per Warehouse MoM' datatype='real' name='[# Daily Orders Per Warehouse (copy)_648799847250317332]' role='measure' type='quantitative'>
