    <worksheet name='Overview Prep'>
      <table>
        <view>
          <datasources>
            <datasource caption='report_monthly_dmart (bl_nordics)' name='federated.0ic7ueh0xefvtz1911epz130idau' />
          </datasources>
          <datasource-dependencies datasource='federated.0ic7ueh0xefvtz1911epz130idau'>
            <column caption='# New Customers - Warehouse' datatype='integer' name='[# New Customers - Foodora Market (copy)_1011339610637561903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month_type]=&quot;CM&quot; THEN [new_customer_warehouse] END' />
            </column>
            <column caption='# New Customers - Foodora' datatype='integer' name='[# New Customers - Warehouses (copy)_1011339610637635632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [new_customer_platform] END)' />
            </column>
            <column caption='# Daily Orders Per Warehouse' datatype='real' name='[# Orders Per Warehouse (copy)_2201978762645757954]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [orders] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [warehouse_days] END)' />
            </column>
            <column caption='% Fill Rate' datatype='real' name='[% Wrong / Missing Items (copy)_648799847232229379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [customer_qty_delivered] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [customer_qty_ordered] END)' />
            </column>
            <column caption='--Warehouse' datatype='real' name='[--Logistics (copy)_1023724510260727808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1/NULL' />
            </column>
            <column caption='Avg. Sub Categories Per Order' datatype='real' name='[Avg. Main Categories Per Order (copy)_620652343275864068]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [order_sub_categories] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [orders] END)' />
            </column>
            <column caption='Avg. Main Categories Per Order' datatype='real' name='[Avg. SKUs Per Order (copy)_620652343275671554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [order_parent_categories] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [orders] END)' />
            </column>
            <column caption='GFV (LC)' datatype='real' name='[Calculation_1011339610622701568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month_type]=&quot;CM&quot; THEN [gfv_local] END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1011339610626564100]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR([report_month]),7)' />
            </column>
            <column caption='# Active Warehouses' datatype='integer' name='[Calculation_1011339610626818053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [month_type]=&quot;CM&quot; THEN [warehouse_id] END)' />
            </column>
            <column caption='# Successful Orders' datatype='integer' name='[Calculation_1011339610627137543]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month_type]=&quot;CM&quot; THEN [successful_orders] END' />
            </column>
            <column caption='# Orders w/Vouchers' datatype='integer' name='[Calculation_1011339610627432456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month_type]=&quot;CM&quot; THEN [successful_orders_voucher] END' />
            </column>
            <column caption='GMV (LC)' datatype='real' name='[Calculation_1011339610627751945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month_type]=&quot;CM&quot; THEN [gmv_local] END' />
            </column>
            <column caption='Delivery Fee (LC) - Gross' datatype='real' name='[Calculation_1011339610627833866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month_type]=&quot;CM&quot; THEN [delivery_fee_local] END' />
            </column>
            <column caption='AFV (LC) ' datatype='real' name='[Calculation_1011339610628022283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [gfv_local] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [successful_orders] END)' />
            </column>
            <column caption='AOV (LC)' datatype='real' name='[Calculation_1011339610628243468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [gmv_local] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [successful_orders] END)' />
            </column>
            <column caption='Customer Paid (LC)' datatype='real' name='[Calculation_1011339610628608013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month_type]=&quot;CM&quot; THEN [customer_paid_local] END' />
            </column>
            <column caption='Avg. Customer Paid (LC)' datatype='real' name='[Calculation_1011339610628853774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [customer_paid_local] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [successful_orders] END)' />
            </column>
            <column caption='% Gross Margin' datatype='real' name='[Calculation_1011339610629099535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(IF [month_type]=&quot;CM&quot; THEN [customer_net_total_price] END)&#13;&#10;-SUM(IF [month_type]=&quot;CM&quot; THEN [total_cogs] END)&#13;&#10;)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [customer_net_total_price] END)' />
            </column>
            <column caption='NPS (After Order)' datatype='real' name='[Calculation_1011339610629451792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;(SUM(IF [month_type]=&quot;CM&quot; THEN promoter END)&#13;&#10;-SUM(IF [month_type]=&quot;CM&quot; THEN detractor END)&#13;&#10;)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [nps_responses] END))*100' />
            </column>
            <column caption='empty1' datatype='real' name='[Calculation_1011339610629554193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1/NULL' />
            </column>
            <column caption='# Pre Orders' datatype='integer' name='[Calculation_1011339610629672979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month_type]=&quot;CM&quot; THEN [successful_orders_preorder] END' />
            </column>
            <column caption='# NPS Responses' datatype='integer' name='[Calculation_1011339610629853204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month_type]=&quot;CM&quot; THEN [nps_responses] END' />
            </column>
            <column caption='% Failed Orders' datatype='real' name='[Calculation_1011339610630021141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [failed_orders] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [gross_orders] END)' />
            </column>
            <column caption='% Vendor Failed Orders' datatype='real' name='[Calculation_1011339610630189078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [failed_orders_vendor] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [gross_orders] END)' />
            </column>
            <column caption='% Complaints' datatype='real' name='[Calculation_1011339610630529047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [orders_complaints] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [gross_orders] END)' />
            </column>
            <column caption='% Wrong / Missing Items' datatype='real' name='[Calculation_1011339610630869016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [order_complaints_wrong_missing_item] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [gross_orders] END)' />
            </column>
            <column caption='Avg. Items Per Order' datatype='real' name='[Calculation_1011339610631589915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN  [customer_qty_ordered] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [orders] END)' />
            </column>
            <column caption='Avg. SKUs Per Order' datatype='real' name='[Calculation_1011339610631647260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [order_skus] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [orders] END)' />
            </column>
            <column caption='Avg. Delivery Distance' datatype='real' name='[Calculation_1011339610631942175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [dropoff_distance_manhattan] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [dropoff_distance_manhattan_den] END)' />
