      <table>
        <view>
          <datasources>
            <datasource caption='report_monthly_dmart (bl_nordics)' name='federated.0ic7ueh0xefvtz1911epz130idau' />
          </datasources>
          <datasource-dependencies datasource='federated.0ic7ueh0xefvtz1911epz130idau'>
            <column caption='# Active Customers (by Warehouse) MoM' datatype='real' name='[# Active Customers (by Warehouse) (copy)_648799847257182258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [active_customers] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [active_customers] END)&#13;&#10;-1' />
            </column>
            <column caption='# Active Warehouses MoM' datatype='real' name='[# Active Warehouses (copy)_648799847249825810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [month_type]=&quot;CM&quot; THEN [warehouse_id] END)&#13;&#10;/COUNTD(IF [month_type]=&quot;PM&quot; THEN [warehouse_id] END)&#13;&#10;-1' />
            </column>
            <column caption='# Daily Orders Per Warehouse MoM' datatype='real' name='[# Daily Orders Per Warehouse (copy)_648799847250317332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(IF [month_type]=&quot;CM&quot; THEN [orders] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [warehouse_days] END)&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(IF [month_type]=&quot;PM&quot; THEN [orders] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [warehouse_days] END)&#13;&#10;)&#13;&#10;-1' />
            </column>
            <column caption='# Delivered Orders - Dmart MoM' datatype='real' name='[# Delivered Orders - Dmart (copy)_648799847246036997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [orders] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [orders] END)-1' />
            </column>
            <column caption='# NPS Responses MoM' datatype='real' name='[# NPS Responses (copy)_648799847253180446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [nps_responses] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [nps_responses] END)&#13;&#10;-1' />
            </column>
            <column caption='# New Customers - Dmart MoM' datatype='real' name='[# New Customers - Dmart (copy)_648799847256453167]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [new_customer_market] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [new_customer_market] END)&#13;&#10;-1' />
            </column>
            <column caption='# New Customers - Foodora MoM' datatype='real' name='[# New Customers - Foodora (copy)_648799847256617008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [new_customer_platform] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [new_customer_platform] END)&#13;&#10;-1' />
            </column>
