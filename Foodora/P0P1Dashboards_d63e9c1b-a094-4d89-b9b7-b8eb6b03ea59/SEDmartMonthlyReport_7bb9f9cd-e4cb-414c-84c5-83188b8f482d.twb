            <column caption='# Pre Orders MoM' datatype='real' name='[# Pre Orders (copy)_648799847248003081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [successful_orders_preorder] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [successful_orders_preorder] END)-1' />
            </column>
            <column caption='# Purchase Orders MoM' datatype='real' name='[# Purchase Orders (copy)_648799847258103863]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [purchase_orders] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [purchase_orders] END)&#13;&#10;-1' />
            </column>
            <column caption='# Successful Orders - Internal - MoM' datatype='real' name='[# Successful Orders - MoM (copy)_433049296090656771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [successful_orders_internal] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [successful_orders_internal] END)-1' />
            </column>
            <column caption='# Pick-Up Orders - MoM' datatype='real' name='[# Successful Orders - MoM (copy)_433049296090820612]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [successful_orders_pickup] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [successful_orders_pickup] END)-1' />
