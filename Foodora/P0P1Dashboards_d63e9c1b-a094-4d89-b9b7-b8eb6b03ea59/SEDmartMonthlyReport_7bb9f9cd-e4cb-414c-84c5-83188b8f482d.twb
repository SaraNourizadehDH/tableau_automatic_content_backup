              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [new_customer_warehouse] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [new_customer_warehouse] END)&#13;&#10;-1' />
            </column>
            <column caption='# Orders Per Warehouse MoM' datatype='real' name='[# Orders Per Warehouse (copy)_648799847250108435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(IF [month_type]=&quot;CM&quot; THEN [orders] END)&#13;&#10;/COUNTD(IF [month_type]=&quot;CM&quot; THEN [warehouse_id] END)&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(IF [month_type]=&quot;PM&quot; THEN [orders] END)&#13;&#10;/COUNTD(IF [month_type]=&quot;PM&quot; THEN [warehouse_id] END)&#13;&#10;)&#13;&#10;-1' />
