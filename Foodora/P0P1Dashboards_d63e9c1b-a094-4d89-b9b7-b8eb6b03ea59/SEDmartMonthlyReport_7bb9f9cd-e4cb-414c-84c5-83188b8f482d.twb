              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [successful_orders_voucher] END)&#13;&#10;/SUM(IF [month_type]=&quot;PM&quot; THEN [successful_orders_voucher] END)-1' />
