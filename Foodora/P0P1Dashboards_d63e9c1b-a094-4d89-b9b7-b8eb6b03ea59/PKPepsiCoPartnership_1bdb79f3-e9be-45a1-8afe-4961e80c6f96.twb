      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Pepsico Deals' id='_3A1E3F7F43824C7AB12FEC858B07C910'>
            <properties context=''>
              <relation connection='bigquery.18dr3nw0789h3i1cgwzpk18rh1ye' name='Custom SQL Query2' type='text'>WITH pepsi_discount as (SELECT distinct&#13;
-- format_date(&apos;%B %Y&apos;,orders.created_date_utc) as month_local,&#13;
-- orders.code,&#13;
-- vendors.vendor_code,&#13;
-- vendors.vendor_name,&#13;
-- vendors.vertical,&#13;
-- vendors.lg_city,&#13;
-- vendors.lg_zone_id,&#13;
-- vendors.primary_cuisine,&#13;
discounts.uuid as discount_id,&#13;
-- offers.title as offers_title,&#13;
-- offers.id as offer_id,&#13;
-- offers.description,&#13;
-- offers.foodpanda_ratio,&#13;
-- offers.expedition_types,&#13;
-- offers.discount_type,&#13;
-- offers.is_active,&#13;
-- offers.products.*,&#13;
-- offers.is_active, &#13;
-- is_inactive, &#13;
-- is_subscription_discount,&#13;
-- offers.is_deleted,&#13;
-- is_condition_multiple_vendors, is_condition_vendor, is_condition_menu_category, is_condition_product, is_condition_product_variation, is_condition_multiple_menu_categories, is_condition_menu, is_condition_chain,&#13;
-- start_time_local, end_time_local, start_date_local, end_date_local, offers.created_date_local&#13;
FROM &#13;
`fulfillment-dwh-production.pandata_curated.pd_orders` as orders&#13;
LEFT JOIN UNNEST (orders.products) as products&#13;
LEFT JOIN &#13;
`fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_discounts` as discounts&#13;
    on orders.uuid=discounts.uuid&#13;
    and discounts.global_entity_id = orders.global_entity_id&#13;
LEFT JOIN `fulfillment-dwh-production.pandata_curated.offers_discounts` as offers&#13;
    on discounts.pd_discount_uuid=offers.uuid&#13;
    and discounts.global_entity_id=offers.global_entity_id &#13;
LEFT JOIN `fulfillment-dwh-production.pandata_curated.ctl_products` as product&#13;
    on products.pd_product_uuid=product.uuid&#13;
WHERE&#13;
    orders.global_entity_id = &quot;FP_PK&quot;&#13;
    and orders.created_date_utc &gt;&gt;= &apos;2023-08-01&apos;&#13;
    and (LOWER(products.title) like &apos;%strong pepsi deal%&apos;&#13;
    or LOWER(product.menu_category_title) like &apos;%strong pepsi deal%&apos;)&#13;
    and discounts.is_discount_used)&#13;
&#13;
SELECT &#13;
orders.created_date_local,&#13;
orders.expedition_type,&#13;
-- vendors.vertical,&#13;
-- vendors.lg_city,&#13;
-- vendors.lg_zone_name,&#13;
-- vendors.primary_cuisine,&#13;
vendors.vendor_name,&#13;
vendors.vendor_code,&#13;
--     vendors.account_type,&#13;
--     vendors.owner_name,&#13;
--     CASE&#13;
-- WHEN LOWER(vendors.lg_city) in (&apos;bahawalpur&apos;, &apos;burewala&apos;, &apos;daska&apos;, &apos;dera ghazi khan&apos;, &apos;gujranwala&apos;, &apos;hafizabad&apos;, &apos;kasur&apos;, &apos;khanpur&apos;, &apos;kot addu&apos;, &apos;lahore&apos;, &apos;multan&apos;, &apos;muridke&apos;, &apos;okara&apos;, &apos;rahim yar khan&apos;, &apos;sadiqabad&apos;, &apos;sahiwal&apos;, &apos;sheikhupura&apos;, &apos;sialkot&apos;, &apos;khanewal&apos;) THEN &quot;Central&quot;&#13;
-- WHEN LOWER(vendors.lg_city) in (&apos;abbottabad&apos;, &apos;attock&apos;, &apos;chakwal&apos;, &apos;chiniot&apos;, &apos;faisalabad&apos;, &apos;gujrat&apos;, &apos;haripur&apos;, &apos;islamabad&apos;, &apos;jaranwala&apos;, &apos;jhang&apos;, &apos;jhelum&apos;, &apos;mandi bahauddin&apos;, &apos;mardan&apos;, &apos;mirpur&apos;, &apos;murree&apos;, &apos;muzaffarabad&apos;, &apos;peshawar&apos;, &apos;sargodha&apos;, &apos;toba tek singh&apos;, &apos;wah&apos;, &apos;wah cantt&apos;, &apos;wazirabad&apos;) THEN &quot;North&quot;&#13;
-- WHEN LOWER(vendors.lg_city) in (&apos;hyderabad&apos;, &apos;karachi&apos;, &apos;larkana&apos;, &apos;mirpur khas&apos;, &apos;nawabshah&apos;, &apos;quetta&apos;, &apos;sukkur&apos;) THEN &quot;South&quot;&#13;
-- ELSE &quot;Expansion&quot;&#13;
-- END AS region,&#13;
sum(ifnull(products.quantity,0)) as deals_quantity,&#13;
count(distinct orders.code) as deals_orders&#13;
&#13;
&#13;
FROM  `fulfillment-dwh-production.pandata_curated.pd_orders` as orders&#13;
JOIN UNNEST (orders.products) as products&#13;
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` as vendors&#13;
      on orders.vendor_code=vendors.vendor_code&#13;
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_discounts` as discounts&#13;
      on orders.uuid=discounts.uuid&#13;
     and discounts.global_entity_id = orders.global_entity_id&#13;
LEFT JOIN pepsi_discount &#13;
      on discounts.uuid=pepsi_discount.discount_id&#13;
&#13;
&#13;
WHERE discounts.uuid IN (pepsi_discount.discount_id) &#13;
and orders.created_date_utc &gt;&gt;= &apos;2023-08-01&apos; -1 &#13;
and orders.created_date_local &gt;&gt;=&apos;2023-08-01&apos;&#13;
    AND orders.is_valid_order&#13;
    and orders.is_gross_order&#13;
    AND NOT orders.is_test_order&#13;
    AND orders.global_entity_id = &apos;FP_PK&apos;&#13;
    AND LOWER(vendors.vendor_name) NOT LIKE &apos;%test%&apos;&#13;
    AND vendors.vertical IN (&apos;restaurants&apos;, &apos;home chefs&apos;, &apos;shared kitchens&apos;, &apos;concepts&apos;)&#13;
GROUP BY&#13;
1,2,3,4</relation>
            </properties>
            <properties context='extract'>
              <relation name='_3A1E3F7F43824C7AB12FEC858B07C910' table='[Extract].[_3A1E3F7F43824C7AB12FEC858B07C910]' type='table' />
            </properties>
          </object>
          <object caption='Pepsico Orders' id='_6E3F599085EB47C89D34E2BAE479A1BD'>
            <properties context=''>
              <relation connection='bigquery.18dr3nw0789h3i1cgwzpk18rh1ye' name='Custom SQL Query1' type='text'>SELECT&#13;
  pd_orders.created_date_local,&#13;
  pd_orders.vendor_code,&#13;
  vendors.vendor_name,&#13;
  vendors.vertical,&#13;
  vendors.account_type,&#13;
  vendors.primary_cuisine,&#13;
  city,&#13;
  zone_name,&#13;
  pd_orders.expedition_type,&#13;
  -- final_sub_cat,&#13;
  -- final_bev_flag,&#13;
  IFNULL(COUNT(DISTINCT CASE WHEN final_bev_flag IN (&apos;ui bev&apos;, &apos;other bev&apos;, &apos;pepsi bev&apos;) THEN order_code END), 0) AS beverage_orders,&#13;
  IFNULL(SUM(CASE WHEN final_bev_flag IN (&apos;ui bev&apos;, &apos;other bev&apos;, &apos;pepsi bev&apos;) THEN amount_sold END), 0) AS beverage_quantity,&#13;
  &#13;
  IFNULL(COUNT(DISTINCT CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) THEN order_code END), 0) AS pepsico_beverage_orders,&#13;
  IFNULL(COUNT(DISTINCT CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) and final_sub_cat in (&apos;Pepsi&apos;,&apos;Diet Pepsi&apos;) THEN order_code END), 0) AS pepsi_beverage_orders,&#13;
  IFNULL(COUNT(DISTINCT CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) and final_sub_cat in (&apos;7up&apos;,&apos;7up Zero&apos;) THEN order_code END), 0) AS s7up_beverage_orders,&#13;
  IFNULL(COUNT(DISTINCT CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) and final_sub_cat in (&apos;Mirinda&apos;) THEN order_code END), 0) AS mirinda_beverage_orders,&#13;
  IFNULL(COUNT(DISTINCT CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) and final_sub_cat in (&apos;Mountain Dew&apos;) THEN order_code END), 0) AS Dew_beverage_orders,&#13;
  IFNULL(COUNT(DISTINCT CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) and final_sub_cat in (&apos;Aquafina&apos;,&apos;Sting&apos;) THEN order_code END), 0) AS other_beverage_orders,&#13;
&#13;
  IFNULL(SUM( CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) THEN amount_sold END), 0) AS pepsico_beverage_quantity,&#13;
  IFNULL(SUM( CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) and final_sub_cat in (&apos;Pepsi&apos;,&apos;Diet Pepsi&apos;) THEN amount_sold END), 0) AS pepsi_beverage_quanity,&#13;
  IFNULL(SUM( CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) and final_sub_cat in (&apos;7up&apos;,&apos;7up Zero&apos;,&apos;Diet 7up&apos;) THEN amount_sold END), 0) AS s7up_beverage_quantity,&#13;
  IFNULL(SUM( CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) and final_sub_cat in (&apos;Mirinda&apos;) THEN amount_sold END), 0) AS mirinda_beverage_quantity,&#13;
  IFNULL(SUM( CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) and final_sub_cat in (&apos;Mountain Dew&apos;) THEN amount_sold END), 0) AS dew_beverage_quantity,&#13;
  IFNULL(SUM( CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) and final_sub_cat in (&apos;Aquafina&apos;,&apos;Sting&apos;) THEN amount_sold END), 0) AS others_beverage_quantity,&#13;
&#13;
  IFNULL(SUM( CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) THEN product_ml_sold END), 0) AS pepsico_ml_sold,&#13;
  IFNULL(SUM( CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) and final_sub_cat in (&apos;Pepsi&apos;,&apos;Diet Pepsi&apos;) THEN product_ml_sold END), 0) AS pepsi_ml_sold,&#13;
  IFNULL(SUM( CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) and final_sub_cat in (&apos;7up&apos;,&apos;7up Zero&apos;,&apos;Diet 7up&apos;) THEN product_ml_sold END), 0) AS s7up_ml_sold,&#13;
  IFNULL(SUM( CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) and final_sub_cat in (&apos;Mirinda&apos;) THEN product_ml_sold END), 0) AS mirinda_ml_sold,&#13;
  IFNULL(SUM( CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) and final_sub_cat in (&apos;Mountain Dew&apos;) THEN product_ml_sold END), 0) AS dew_ml_sold,&#13;
  IFNULL(SUM( CASE WHEN final_bev_flag IN (&apos;pepsi bev&apos;) and final_sub_cat in (&apos;Aquafina&apos;,&apos;Sting&apos;) THEN product_ml_sold END), 0) AS others_ml_sold,&#13;
&#13;
&#13;
&#13;
&#13;
FROM `fulfillment-dwh-production.pandata_curated.pd_orders` as pd_orders &#13;
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` as vendors&#13;
       ON pd_orders.vendor_code=vendors.vendor_code&#13;
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_mkt_partnerships_beverages_order_level` as beverages&#13;
       ON pd_orders.code=beverages.order_code&#13;
WHERE&#13;
  pd_orders.global_entity_id = &quot;FP_PK&quot;&#13;
  AND beverages.created_date_local&gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), month), INTERVAL 3 month)&#13;
  AND pd_orders.created_date_utc&gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), month), INTERVAL 3 month) - 10&#13;
  AND pd_orders.created_date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), month), INTERVAL 3 month)&#13;
group by&#13;
1,2,3,4,5,6,7,8,9</relation>
            </properties>
            <properties context='extract'>
              <relation name='_6E3F599085EB47C89D34E2BAE479A1BD' table='[Extract].[_6E3F599085EB47C89D34E2BAE479A1BD]' type='table' />
            </properties>
          </object>
          <object caption='Orders' id='_B62C11D4AA704088AF4212A636B47A03'>
            <properties context=''>
              <relation connection='bigquery.18dr3nw0789h3i1cgwzpk18rh1ye' name='Custom SQL Query' type='text'>SELECT &#13;
    o.created_date_local,&#13;
    v.vertical,&#13;
    v.account_type,&#13;
    v.owner_name,&#13;
    v.primary_cuisine,&#13;
    v.lg_city AS city,&#13;
    v.vendor_code,&#13;
    v.lg_zone_name AS zone_name,&#13;
    o.expedition_type,&#13;
    SUM(p.quantity) AS total_quantity,&#13;
    COUNT(DISTINCT o.code) AS total_orders&#13;
  FROM `fulfillment-dwh-production.pandata_curated.pd_orders` AS o&#13;
  LEFT JOIN UNNEST(o.products) p&#13;
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS v&#13;
         ON v.vendor_code = o.vendor_code&#13;
  WHERE o.created_date_utc &gt;&gt;=DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), month), INTERVAL 3 month) -1&#13;
    AND o.created_date_local&gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), month), INTERVAL 3 month)&#13;
    AND o.is_valid_order&#13;
    AND NOT o.is_test_order &#13;
    AND o.is_gross_order&#13;
    AND o.global_entity_id = &apos;FP_PK&apos;&#13;
    AND LOWER(v.vendor_name) NOT LIKE &apos;%test%&apos;&#13;
    AND v.vertical IN (&apos;restaurants&apos;, &apos;home chefs&apos;, &apos;shared kitchens&apos;, &apos;concepts&apos;)&#13;
    GROUP BY&#13;
    1,2,3,4,5,6,7,8,9</relation>
            </properties>
