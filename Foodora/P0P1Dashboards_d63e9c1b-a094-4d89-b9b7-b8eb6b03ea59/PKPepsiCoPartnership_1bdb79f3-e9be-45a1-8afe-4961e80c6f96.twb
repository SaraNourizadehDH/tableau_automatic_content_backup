              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;iso-week&apos;,[created_date_local (Custom SQL Query)]))' />
            </column>
            <column caption='Date Range' datatype='string' name='[Calculation_1089026749728555015]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([Calculation_1089026749728468998]),2) &#13;&#10;            +&quot;-&quot;+&#13;&#10;MID(STR([Calculation_1089026749728468998]),6,2)&#13;&#10;            +&quot;-&quot;+&#13;&#10;LEFT(STR([Calculation_1089026749728468998]),4)&#13;&#10;&#13;&#10;      +&quot; to &quot;+&#13;&#10;&#13;&#10;RIGHT(STR([Calculation_1089026749728468998]+6),2) &#13;&#10;            +&quot;-&quot;+&#13;&#10;MID(STR([Calculation_1089026749728468998]+6),6,2)&#13;&#10;            +&quot;-&quot;+&#13;&#10;LEFT(STR([Calculation_1089026749728468998]+6),4)' />
