    <worksheet name='Voucher Efficacy'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffd271' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Normal/Fraud ICPO' name='federated.1raacwm0gkhgmp193jeum06rmrb9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Data Split' datatype='string' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
              <aliases>
                <alias key='&quot;C&amp;BI Segments&quot;' value='Usama&apos;s Segments' />
                <alias key='&quot;False&quot;' value='Black/Grey/Green' />
                <alias key='&quot;True&quot;' value='Fraud/Genuine' />
              </aliases>
            </column>
            <column alias='No' caption='NC/EC Split' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='false' value='No' />
                <alias key='true' value='Yes' />
              </aliases>
            </column>
            <column caption='Voucher Attribution' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1raacwm0gkhgmp193jeum06rmrb9'>
            <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([value_local]) / TOTAL(SUM([value_local]))'>
                <table-calc ordering-type='Columns' />
              </calculation>
            </column>
            <column caption='Front Margin' datatype='real' name='[Calculation_1655635856197431296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([margin_amount])/SUM([gfv_without_vat])' />
            </column>
            <column caption='Orders' datatype='integer' name='[Calculation_1655635856197902337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([order_code])' />
            </column>
            <column caption='SKUs Per Order' datatype='real' name='[Calculation_1655635856198037506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([skus_in_order])/[Calculation_1655635856197902337]' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_1655635856199282691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_without_vat])/[Calculation_1655635856197902337]' />
            </column>
            <column caption='DF Per Order' datatype='real' name='[Calculation_1655635856199770116]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_local])/[Calculation_1655635856197902337]' />
            </column>
            <column caption='Units Per Order' datatype='real' name='[Calculation_1655635856200708102]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([units_sold])/[Calculation_1655635856197902337]' />
            </column>
            <column caption='Customers' datatype='integer' name='[Calculation_1655635856206344200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([customer_code])' />
            </column>
            <column caption='Order Per Customer' datatype='real' name='[Calculation_1655635856206438409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1655635856197902337]/[Calculation_1655635856206344200]' />
            </column>
            <column caption='Existing Customers' datatype='integer' name='[Calculation_1655635856208285706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_new_customer_acid] THEN NULL ELSE [customer_code] end)' />
            </column>
            <column caption='EC/NC' datatype='string' name='[Calculation_1655635856209698829]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#13;&#10;WHEN TRUE THEN [Calculation_1655635856210067470]&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;&quot;' value=' ' />
              </aliases>
            </column>
            <column caption='Customer Type NC/EC' datatype='string' name='[Calculation_1655635856210067470]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_new_customer_acid]&#13;&#10;WHEN TRUE THEN &quot;NC&quot; ELSE &quot;EC&quot; END' />
            </column>
            <column caption='% of GFV' datatype='real' name='[Calculation_1655635856232685583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([value_local])/SUM([gfv_with_vat])' />
            </column>
            <column caption='ICPO' datatype='real' name='[Calculation_1681813002129625089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3025574573555425280])/COUNTD([order_code])' />
            </column>
            <column caption='@Fraud Segregation Field' datatype='string' name='[Calculation_1681813002131066882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;True&quot; THEN [fraud_status]&#13;&#10;    WHEN &quot;False&quot; THEN [fraud_status_detailed]&#13;&#10;    WHEN &quot;C&amp;BI Segments&quot; THEN [customer_segment]&#13;&#10;    ELSE &quot;Total&quot;&#13;&#10;END' />
            </column>
            <column caption='Voucher Amount' datatype='real' name='[Calculation_3025574573555425280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Overall&quot; THEN [value_local]&#13;&#10;ELSE [voucher_amount_foodpanda]&#13;&#10;END' />
