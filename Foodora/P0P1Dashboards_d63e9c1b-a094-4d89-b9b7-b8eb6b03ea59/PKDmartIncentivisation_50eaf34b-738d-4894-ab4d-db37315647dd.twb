        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1ledej61a82ic0177v4ln0nr1jl4' name='Custom SQL Query1' type='text'>WITH products AS (&#13;
  SELECT&#13;
    dmart__product_report.sku,&#13;
    dmart__product_report.product_title_english AS product_name,&#13;
    dmart__product_report.category_english AS category,&#13;
    dmart__product_report.subcategory_english AS subcategory,&#13;
    dmart__product_report.dmart_imt_warehouse_name,&#13;
    dmart__product_report.dmart_imt_warehouse_uuid,&#13;
    dmart__product_report.principal_name_english,&#13;
    dmart__product_report.brand_name_english&#13;
  FROM `fulfillment-dwh-production.pandata_report.dmart__product_report` AS dmart__product_report&#13;
  WHERE dmart__product_report.global_entity_id = &quot;FP_PK&quot;&#13;
)&#13;
&#13;
SELECT&#13;
  customer_order_line_report.pd_order_code,&#13;
  customer_order_line_report.sku,&#13;
  products.product_name,&#13;
  products.category,&#13;
  products.subcategory,&#13;
  COALESCE(customer_order_line_report.received_quantity, 0) AS units_sold,&#13;
  (received_quantity * unit_price_paid_local) AS gfv_with_vat,&#13;
  (received_quantity * unit_price_paid_local) / (1 + vat_rate_percent) AS gfv_without_vat,&#13;
  (received_quantity * wac_local) AS cogs,&#13;
  (received_quantity * unit_price_paid_local) / (1 + vat_rate_percent) - (received_quantity * wac_local) AS margin_amount&#13;
FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__customer_order_line_report` AS customer_order_line_report&#13;
LEFT JOIN products &#13;
       ON products.sku = customer_order_line_report.sku&#13;
      AND products.dmart_imt_warehouse_uuid = customer_order_line_report.dmart_imt_warehouse_uuid&#13;
INNER JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` pav&#13;
        ON customer_order_line_report.pd_order_code = pav.order_code&#13;
       AND pav.global_entity_id = &quot;FP_PK&quot;&#13;
       AND channel not in (&apos;channel_corporate&apos;,&apos;channel_customer_service&apos;,&apos;channel_pr&apos;)&#13;
       AND purpose not in (&apos;autocompensation_realtime&apos;,&apos;sorry_panda&apos;)&#13;
WHERE customer_order_line_report.ordered_date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 2 MONTH)&#13;
  AND customer_order_line_report.global_entity_id = &quot;FP_PK&quot;&#13;
  AND customer_order_line_report.is_valid_order</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.079t8kl0m1zvk4104s0l701mana5' name='Custom SQL Query' type='text'><![CDATA[WITH all_required_data AS (
  SELECT 
    *,
    DATE_TRUNC(ordered_date_local, MONTH) AS month,
    DATE_DIFF(
      ordered_date_local,
      LAG(ordered_date_local) OVER (PARTITION BY pd_customer_uuid, DATE_TRUNC(ordered_date_local, MONTH) ORDER BY ordered_at_local),
      DAY
    ) AS gap_between_orders
  FROM `fulfillment-dwh-production.pandata_report.country_PK_dmart_order_info` 
  WHERE ordered_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH)
),

customer_level_data AS (
  SELECT
    month,
    pd_customer_uuid,
    COUNT(DISTINCT pd_order_code) AS total_orders,
    AVG(skus) AS sku_per_order,
    SUM(units_sold)/COUNT(DISTINCT skus) AS qty_per_order,
    AVG(gap_between_orders) AS avg_days_between_orders,
    SAFE_DIVIDE(SUM(total_discount_amount_local) + SUM(COALESCE(voucher_amount, 0)), SUM(total_price_before_discount)) AS subsidy_percentage
  FROM all_required_data
  GROUP BY
    pd_customer_uuid,
    month
),

percentile_values AS (
  SELECT DISTINCT
    month,
    PERCENTILE_DISC(total_orders, 0.01) OVER(PARTITION BY month) AS lower_value_orders,
    PERCENTILE_DISC(total_orders, 0.99) OVER(PARTITION BY month) AS higher_value_orders,
    PERCENTILE_DISC(avg_days_between_orders, 0.01) OVER(PARTITION BY month) AS lower_value_avg_days_between_orders,
    PERCENTILE_DISC(avg_days_between_orders, 0.99) OVER(PARTITION BY month) AS higher_value_avg_days_between_orders,
    PERCENTILE_DISC(sku_per_order, 0.01) OVER(PARTITION BY month) AS lower_value_skus_per_order,
    PERCENTILE_DISC(sku_per_order, 0.99) OVER(PARTITION BY month) AS higher_value_skus_per_order,
    PERCENTILE_DISC(qty_per_order, 0.01) OVER(PARTITION BY month) AS lower_value_qty_per_order,
    PERCENTILE_DISC(qty_per_order, 0.99) OVER(PARTITION BY month)
     AS higher_value_qty_per_order
  FROM customer_level_data
),

combined_table AS (
  SELECT
    customer_level_data.*,
    percentile_values.* EXCEPT (month)
  FROM customer_level_data
  LEFT JOIN percentile_values
         ON customer_level_data.month = percentile_values.month
),

variable_after_outlier AS (
  SELECT
    pd_customer_uuid,
    month,
    IF(total_orders <<= lower_value_orders, lower_value_orders, IF(total_orders >>= higher_value_orders, higher_value_orders, total_orders)) AS total_order_final,
    IF(sku_per_order <<= lower_value_skus_per_order, lower_value_skus_per_order, IF(sku_per_order >>= higher_value_skus_per_order,
    higher_value_skus_per_order, sku_per_order)) AS sku_per_order_final,
    IF(qty_per_order <<= lower_value_qty_per_order, lower_value_qty_per_order, IF(qty_per_order >>= higher_value_qty_per_order,
    higher_value_qty_per_order, qty_per_order)) AS qty_per_order_final,
    IF(avg_days_between_orders >>= higher_value_avg_days_between_orders, higher_value_avg_days_between_orders, avg_days_between_orders) AS avg_days_between_orders_final,
    subsidy_percentage
  FROM combined_table
),

standardized_parameters AS (
  SELECT
    month,
    AVG(total_order_final) AS mean_total_order_final,
    STDDEV(total_order_final) AS std_dev_total_order_final,
    AVG(avg_days_between_orders_final) AS mean_avg_days_between_orders_final,
    STDDEV(avg_days_between_orders_final) AS std_dev_avg_days_between_orders_final,
    AVG(sku_per_order_final) AS mean_avg_skus,
    STDDEV(sku_per_order_final) AS std_dev_avg_skus,
    AVG(qty_per_order_final) AS mean_avg_quantity,
    STDDEV(qty_per_order_final) AS std_dev_avg_quantity
  FROM variable_after_outlier
  GROUP BY
    month
),

standardized_parameters_final AS (
  SELECT
    variable_after_outlier.*,
    standardized_parameters.* EXCEPT (month)
  FROM variable_after_outlier
  LEFT JOIN standardized_parameters
         ON variable_after_outlier.month = standardized_parameters.month
),

standardized_variables AS (
  SELECT
    month,
    pd_customer_uuid,
    SAFE_DIVIDE((total_order_final - mean_total_order_final), std_dev_total_order_final) AS standardized_total_order,
    SAFE_DIVIDE((avg_days_between_orders_final - mean_avg_days_between_orders_final), std_dev_avg_days_between_orders_final) AS standardized_avg_days_btwn_orders,
    SAFE_DIVIDE((sku_per_order_final - mean_avg_skus), std_dev_avg_skus) AS standardized_skus_per_order,
    SAFE_DIVIDE((qty_per_order_final - mean_avg_quantity), std_dev_avg_quantity) AS standardized_qpo
  FROM standardized_parameters_final
),

blacklisted_customers AS (
  SELECT
    customer_code,
    is_black,
    type,
    remarks
  FROM `dhh---analytics-apac.pandata_pk.cx_fraud_customers`
  QUALIFY ROW_NUMBER() OVER(PARTITION BY customer_code ORDER BY date DESC) = 1
),

consumer_segments AS (
  SELECT
    DATE_TRUNC(all_required_data.ordered_date_local, MONTH) AS month,
    all_required_data.pd_customer_uuid,
    CASE
      WHEN is_black THEN "Fraudster"
      WHEN customer_level_data.subsidy_percentage >>= 0.15 THEN "Opportunist"
      WHEN standardized_qpo >> 2
      AND (
        standardized_avg_days_btwn_orders << -2
        OR standardized_total_order >> 2
      )
      THEN "Bulk Buyer"
      ELSE "Organic" 
    END AS customer_segment
  FROM all_required_data
  LEFT JOIN standardized_variables
         ON all_required_data.pd_customer_uuid = standardized_variables.pd_customer_uuid
        AND DATE_TRUNC(all_required_data.ordered_date_local, MONTH) = standardized_variables.month
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.cus_customers` AS customers
         ON customers.uuid = all_required_data.pd_customer_uuid
        AND customers.global_entity_id = "FP_PK"
  LEFT JOIN blacklisted_customers
         ON blacklisted_customers.customer_code = customers.code
  LEFT JOIN customer_level_data
         ON customer_level_data.pd_customer_uuid = all_required_data.pd_customer_uuid
        AND customer_level_data.month = DATE_TRUNC(all_required_data.ordered_date_local, MONTH)
  GROUP BY
    month,
    pd_customer_uuid,
    customer_segment
), 

blacklist AS(
  SELECT
    customer_code,
    is_black
  FROM `dhh---analytics-apac.pandata_pk.cx_fraud_customers`
  QUALIFY ROW_NUMBER() OVER(PARTITION BY customer_code ORDER BY date DESC) = 1
),

products_info AS (
  SELECT
    dmart__product_report.sku,
    dmart__product_report.product_title_english AS product_name,
    dmart__product_report.category_english AS category,
    dmart__product_report.subcategory_english AS subcategory,
    dmart__product_report.dmart_imt_warehouse_name,
    dmart__product_report.dmart_imt_warehouse_uuid,
    dmart__product_report.principal_name_english,
    dmart__product_report.brand_name_english
  FROM `fulfillment-dwh-production.pandata_report.dmart__product_report` AS dmart__product_report
  WHERE dmart__product_report.global_entity_id = "FP_PK"
),

products AS (
  SELECT
    pd_order_code,
    COUNT(DISTINCT sale.sku) AS skus_in_order,
    COUNT(DISTINCT products_info.category) AS categories_in_order,
    STRING_AGG(CONCAT(delivered_quantity, 'x ', products_info.product_name), ' | ' ORDER BY products_info.product_name) AS aggregated_products,
    STRING_AGG(DISTINCT products_info.category, ' | ' ORDER BY products_info.category) AS aggregated_categories,
    SUM(unit_discount_amount_local * delivered_quantity) AS discount,
    SUM(unit_price_paid_local * received_quantity) + SUM(unit_discount_amount_local * received_quantity) AS original_amount_before_discount,
    
    SUM(received_quantity) AS units_sold,
    SUM(received_quantity * unit_discount_amount_local) AS discount_amount,
    SUM(received_quantity * unit_price_paid_local) AS gfv_with_vat,
    SUM((received_quantity * unit_price_paid_local) / (1 + vat_rate_percent)) AS gfv_without_vat,
    SUM(received_quantity * wac_local) AS cogs,
    SUM((received_quantity * unit_price_paid_local) / (1 + vat_rate_percent) - (received_quantity * wac_local)) AS margin_amount
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__customer_order_line_report` AS sale
  LEFT JOIN products_info
         ON sale.sku = products_info.sku
        AND sale.dmart_imt_warehouse_uuid = products_info.dmart_imt_warehouse_uuid
  WHERE global_entity_id = "FP_PK"
    AND ordered_date_local >>=  DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH)
  GROUP BY
    pd_order_code
),

required_data AS (
  SELECT
    pd_orders.created_date_local as ordered_date,
    DATE_TRUNC(pd_orders.created_date_local, MONTH) as month,
    FORMAT_DATE('%B', pd_orders.created_date_local) AS month_name,
    pd_orders.vendor_code,
    vendor_info.vendor_name,
    pd_orders.code AS order_code,
    c.code AS customer_code,
    COALESCE(id_mapping.analytical_customer_id, pd_orders.pd_customer_uuid) AS analytical_customer_id,
    customer_agg.first_valid_vertical_order_at_utc = ordered_at_utc AS is_new_customer,
    COALESCE(acid_order_dates.first_valid_order_all_at_utc, customer_agg.first_valid_vertical_order_at_utc) = ordered_at_utc AS is_new_customer_acid,
    (customer_agg.first_valid_vertical_order_at_utc = ordered_at_utc) = (COALESCE(acid_order_dates.first_valid_order_all_at_utc, customer_agg.first_valid_vertical_order_at_utc) = ordered_at_utc) AS check,
    products.units_sold,
    products.skus_in_order,
    products.categories_in_order,
    products.aggregated_products,
    products.aggregated_categories,
    COALESCE(products.discount, 0) AS discount_amount,
    COALESCE(products.original_amount_before_discount, 0) AS original_amount_before_discount,
    COALESCE(products.gfv_without_vat, 0) AS gfv_without_vat,
    COALESCE(products.gfv_with_vat, 0) AS gfv_with_vat,
    COALESCE(products.margin_amount, 0) AS margin_amount,
    pd_orders.subtotal_local,
    pd_orders.total_value_local,
    pd_orders.delivery_fee_local,
    agg_vouchers.channel,
    agg_vouchers.purpose,
    agg_vouchers.description,
    agg_vouchers.voucher_code,
    agg_vouchers.voucher_code_used,
    agg_vouchers.value_local,
    agg_vouchers.value_local * (agg_vouchers.attributions_foodpanda_ratio / 100) AS voucher_amount_foodpanda,
    blacklist.is_black,
    CASE 
      WHEN blacklist.is_black IS NULL THEN "Genuine"
      ELSE "Fraud"
    END AS fraud_status,
    CASE 
      WHEN blacklist.is_black IS NULL THEN "Green"
      WHEN blacklist.is_black THEN "Black"
      ELSE "Grey"
    END AS fraud_status_detailed,
    consumer_segments.customer_segment
  
  FROM `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
  INNER JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info`vendor_info
          ON pd_orders.vendor_code=vendor_info.vendor_code
         AND vendor_info.vertical = "darkstores"
         AND LOWER(vendor_info.vendor_name) NOT LIKE "%business%"
         AND LOWER(vendor_info.vendor_name) NOT LIKE "%corporate%"
         AND LOWER(vendor_info.vendor_name) NOT LIKE "%pantry%"
         AND LOWER(vendor_info.vendor_name) NOT LIKE "%odr%"
         AND LOWER(vendor_info.vendor_name) NOT LIKE "%export%"
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.cus_customers` as c 
         ON c.uuid = pd_orders.pd_customer_uuid 
        AND c.global_entity_id = pd_orders.global_entity_id
  INNER JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` AS agg_vouchers
          ON pd_orders.code = agg_vouchers.order_code
         AND agg_vouchers.global_entity_id = "FP_PK"
         AND CONCAT(channel, purpose) NOT IN (
          'channel_crmautocompensation_realtime', 'channel_crmcompensation', 'channel_customer_servicecompensation', 'channel_customer_servicerefund', 'channel_customer_servicesorry_panda', 'channel_onlineautocompensation_realtime', 'channel_onlinesorry_panda', 'channel_otherssorry_panda', 'channel_subsidiessorry_panda')
  LEFT JOIN blacklist 
         ON c.code = blacklist.customer_code
  LEFT JOIN products
         ON products.pd_order_code = pd_orders.code
  LEFT JOIN consumer_segments
         ON consumer_segments.pd_customer_uuid = pd_orders.pd_customer_uuid
        AND consumer_segments.month = DATE_TRUNC(pd_orders.created_date_local, MONTH)
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_qcommerce__customers_agg_orders_dates` AS customer_agg
         ON pd_orders.pd_vendor_uuid = customer_agg.pd_vendor_uuid
        AND pd_orders.pd_customer_uuid = customer_agg.pd_customer_uuid
        AND customer_agg.global_entity_id = "FP_PK"
        AND customer_agg.vendor_type IN ("pandamart")
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_mkt.braze_external_id_map` AS id_mapping
         ON CONCAT(REGEXP_EXTRACT(id_mapping.external_id, r"[0-9]+"), "_FP_", REGEXP_EXTRACT(id_mapping.external_id, r"^..")) = pd_orders.pd_customer_uuid
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_customers_agg_orders_dates_acid` AS acid_order_dates
         ON acid_order_dates.analytical_customer_id = COALESCE(id_mapping.analytical_customer_id, pd_orders.pd_customer_uuid)
  
  WHERE pd_orders.global_entity_id ="FP_PK"
    AND pd_orders.created_date_utc >>=  DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH) - 1
    AND pd_orders.created_at_local >>=  DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH)
    AND pd_orders.created_at_local <<  CURRENT_DATE()
    AND pd_orders.status_code NOT IN (67, 679, 66)
    AND pd_orders.is_valid_order
)

SELECT
  *
FROM required_data]]></relation>
          <relation connection='bigquery.1ledej61a82ic0177v4ln0nr1jl4' name='Custom SQL Query1' type='text'>WITH products AS (&#13;
  SELECT&#13;
    dmart__product_report.sku,&#13;
    dmart__product_report.product_title_english AS product_name,&#13;
    dmart__product_report.category_english AS category,&#13;
    dmart__product_report.subcategory_english AS subcategory,&#13;
    dmart__product_report.dmart_imt_warehouse_name,&#13;
    dmart__product_report.dmart_imt_warehouse_uuid,&#13;
    dmart__product_report.principal_name_english,&#13;
    dmart__product_report.brand_name_english&#13;
  FROM `fulfillment-dwh-production.pandata_report.dmart__product_report` AS dmart__product_report&#13;
  WHERE dmart__product_report.global_entity_id = &quot;FP_PK&quot;&#13;
)&#13;
&#13;
SELECT&#13;
  customer_order_line_report.pd_order_code,&#13;
  customer_order_line_report.sku,&#13;
  products.product_name,&#13;
  products.category,&#13;
  products.subcategory,&#13;
  COALESCE(customer_order_line_report.received_quantity, 0) AS units_sold,&#13;
  (received_quantity * unit_price_paid_local) AS gfv_with_vat,&#13;
  (received_quantity * unit_price_paid_local) / (1 + vat_rate_percent) AS gfv_without_vat,&#13;
  (received_quantity * wac_local) AS cogs,&#13;
  (received_quantity * unit_price_paid_local) / (1 + vat_rate_percent) - (received_quantity * wac_local) AS margin_amount&#13;
FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__customer_order_line_report` AS customer_order_line_report&#13;
LEFT JOIN products &#13;
       ON products.sku = customer_order_line_report.sku&#13;
      AND products.dmart_imt_warehouse_uuid = customer_order_line_report.dmart_imt_warehouse_uuid&#13;
INNER JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` pav&#13;
        ON customer_order_line_report.pd_order_code = pav.order_code&#13;
       AND pav.global_entity_id = &quot;FP_PK&quot;&#13;
       AND channel not in (&apos;channel_corporate&apos;,&apos;channel_customer_service&apos;,&apos;channel_pr&apos;)&#13;
       AND purpose not in (&apos;autocompensation_realtime&apos;,&apos;sorry_panda&apos;)&#13;
WHERE customer_order_line_report.ordered_date_local &gt;&gt;= DATE_SUB(DATE_TRUNC(CURRENT_DATE(&quot;Asia/Karachi&quot;), MONTH), INTERVAL 2 MONTH)&#13;
  AND customer_order_line_report.global_entity_id = &quot;FP_PK&quot;&#13;
  AND customer_order_line_report.is_valid_order</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
