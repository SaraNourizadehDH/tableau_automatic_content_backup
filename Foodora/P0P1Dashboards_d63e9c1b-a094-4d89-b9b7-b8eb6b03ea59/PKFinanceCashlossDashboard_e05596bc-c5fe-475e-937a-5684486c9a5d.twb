      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_6A3E48943E9E4CC39B390F1C7CCA87B8'>
            <properties context=''>
              <relation connection='bigquery.0yrj7dd0dj9v4s141ldkj0ryf1j6' name='Custom SQL Query' type='text'>WITH overall AS
(SELECT 
date_local AS date,
COUNT(DISTINCT CASE WHEN billable = &quot;Billable&quot; AND expedition_type = &quot;delivery&quot; AND is_own_delivery THEN order_code END) AS overall_OD_orders
FROM `fulfillment-dwh-production.pandata_report.country_PK_finance_cashback_order_level` 
WHERE date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 06 MONTH) AND CURRENT_DATE()
GROUP BY 1
),

shops AS (
SELECT
cb.date_local AS date, 
--cb.week_number AS finance_week,
DATE_TRUNC(cb.date_local, MONTH) AS report_month,
vi.vendor_name,
vi.vendor_code,
vi.vertical,
vi.lg_city,
vi.lg_zone_name,
--t.Billable,t.expedition_type, 
pd.decline_reason.title AS decline_reason, 
overall.overall_OD_orders,
COUNT(DISTINCT CASE WHEN billable = &quot;Billable&quot; AND cb.is_wastage  AND c.order_code IS NOT NULL AND LOWER(c.na_missing) IN (&quot;not returned&quot;) THEN cb.order_code END) AS cashloss_orders_exception, 
COUNT(DISTINCT CASE WHEN billable = &quot;NOT Billable&quot; AND cb.is_wastage AND c.order_code IS NOT NULL AND LOWER(c.na_missing) IN (&quot;not returned&quot;) THEN cb.order_code END) AS cashloss_orders_non_exception, 
SUM(CASE WHEN ((cb.status_code = 65 AND cb.billable = &quot;Billable&quot;) OR (cb.is_wastage AND cb.billable = &quot;Billable&quot;)) AND c.order_code IS NOT NULL AND LOWER(c.na_missing) IN (&quot;not returned&quot;) THEN IFNULL(cb.cashloss_cost_exception, 0) END) AS cashloss_cost_exception,
SUM(CASE WHEN ((cb.status_code = 65 AND cb.billable = &quot;NOT Billable&quot;) OR (cb.is_wastage AND cb.billable = &quot;NOT Billable&quot;)) AND c.order_code IS NOT NULL AND LOWER(c.na_missing) IN (&quot;not returned&quot;) THEN IFNULL(cb.cashloss_cost_non_exception, 0) END) AS cashloss_cost_non_exception,
COUNT(DISTINCT CASE WHEN billable = &quot;Billable&quot; THEN cb.order_code END) AS total_orders

FROM `fulfillment-dwh-production.pandata_report.country_PK_finance_cashback_order_level` AS cb
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_gsheet_combined_cashloss_shops` AS c
       ON CAST(c.order_code AS STRING) = cb.order_code
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
       ON cb.vendor_code = vi.vendor_code
LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd 
       ON pd.code = cb.order_code 
      AND pd.global_entity_id = &quot;FP_PK&quot;
      AND pd.created_date_utc BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 06 MONTH) AND CURRENT_DATE()
LEFT JOIN overall 
       ON overall.date = cb.date_local
WHERE cb.date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 06 MONTH) AND CURRENT_DATE() 
AND vi.vertical IN (&quot;shops&quot;)
AND pd.expedition_type IN (&quot;delivery&quot;)
AND pd.is_own_delivery
GROUP BY ALL
),

dmart AS (
SELECT
pd.created_date_local AS date, 
DATE_TRUNC(pd.created_date_local, MONTH) AS report_month,
vi.vendor_name,
vi.vendor_code,
vi.vertical,
vi.lg_city,
vi.lg_zone_name,
--t.Billable,t.expedition_type, 
pd.decline_reason.title AS decline_reason, 
overall.overall_OD_orders,
SUM(0) AS cashloss_orders_exception,
COUNT(DISTINCT CASE WHEN c.order_code IS NOT NULL AND LOWER(c.return_status) IN (&quot;not returned&quot;, &quot;omad&quot;) THEN pd.code END) AS cashloss_orders_non_exception, 
SUM(0) as cashloss_exception,
SUM(CASE WHEN c.order_code IS NOT NULL AND LOWER(c.return_status) IN (&quot;not returned&quot;, &quot;omad&quot;) THEN IFNULL(pd.subtotal_local, 0) END) AS cashloss_non_exception,
COUNT(DISTINCT CASE WHEN pd.is_valid_order THEN pd.code END) AS total_orders

FROM `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd 
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_gsheet_pandamart_recon` AS c
       ON CAST(c.order_code AS STRING) = pd.code
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
       ON pd.vendor_code = vi.vendor_code
LEFT JOIN overall 
       ON overall.date = pd.created_date_local
WHERE  vi.vertical IN (&quot;darkstores&quot;)
AND pd.expedition_type IN (&quot;delivery&quot;)
AND pd.is_own_delivery
AND pd.global_entity_id = &quot;FP_PK&quot;
AND pd.created_date_utc BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 06 MONTH) AND CURRENT_DATE()
GROUP BY ALL
),

rest AS (
SELECT 
cb.date_local AS date, 
--cb.week_number AS finance_week,
DATE_TRUNC(cb.date_local, MONTH) AS report_month,
vi.vendor_name,
vi.vendor_code,
vi.vertical,
vi.lg_city,
vi.lg_zone_name,
--t.Billable,t.expedition_type, 
pd.decline_reason.title AS decline_reason, 
overall.overall_OD_orders,
COUNT(DISTINCT CASE WHEN (cb.is_wastage AND billable = &quot;Billable&quot;) THEN cb.order_code END) AS cashloss_orders_exception,
COUNT(DISTINCT CASE WHEN (cb.is_wastage AND billable = &quot;NOT Billable&quot;) THEN cb.order_code END) AS cashloss_orders_non_exception,
SUM(CASE WHEN (cb.is_wastage AND billable = &quot;Billable&quot;) THEN IFNULL(cashloss_cost_exception, 0) END) AS cashloss_cost_exception,
SUM(CASE WHEN (cb.is_wastage AND billable = &quot;NOT Billable&quot;) THEN IFNULL(Cashloss_cost_non_exception, 0) END) AS Cashloss_cost_non_exception,
COUNT(DISTINCT CASE WHEN billable = &quot;Billable&quot; THEN cb.order_code END) AS total_orders

FROM `fulfillment-dwh-production.pandata_report.country_PK_finance_cashback_order_level` AS cb
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
       ON cb.vendor_code = vi.vendor_code
LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd 
       ON pd.code = cb.order_code 
      AND pd.global_entity_id = &quot;FP_PK&quot;
      AND pd.created_date_utc BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 06 MONTH) AND CURRENT_DATE()
LEFT JOIN overall
       ON overall.date = cb.date_local
WHERE cb.date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 06 MONTH) AND CURRENT_DATE() 
AND vi.vertical NOT IN (&quot;shops&quot;,&quot;darkstores&quot;)
AND pd.expedition_type IN (&quot;delivery&quot;)
AND pd.is_own_delivery
GROUP BY ALL
)

SELECT * 
FROM rest
UNION ALL
SELECT * 
FROM shops
UNION ALL 
SELECT * 
FROM dmart</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
