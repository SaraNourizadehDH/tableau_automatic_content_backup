      <aliases enabled='yes' />
      <column caption='% Order Late &gt; 10 min' datatype='real' name='[% Order Late &gt; 15 min (copy)_647111035729096705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delay_cnt10])/sum([delay_obs])' />
      </column>
      <column caption='AFV INT' datatype='real' name='[AFV (copy)_984881004203212803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gfv_int_gfv_local])/sum([gfv_int_orders])' />
      </column>
      <column caption='Avg. Est. Prep Time (mins)' datatype='real' name='[Avg. Est. Prep Time (mins) (copy)_599260227360432128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([est_prep_time_mins])/sum([est_prep_time_count])' />
      </column>
      <column caption='Avg. Item Price ' datatype='real' name='[Avg. Item Price (copy)_314126135378001922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([main_items_gfv])/SUM([main_items])' />
      </column>
      <column caption='Avg. Items ' datatype='real' name='[Avg. Items (copy)_314126135377833985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([main_items])/SUM([successful_orders])' />
      </column>
      <column caption='Report Month' datatype='string' name='[Calculation_1114077987074834433]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='left(STR([report_month]),7)' />
      </column>
      <column caption='Report Date' datatype='string' name='[Calculation_1114077987074912258]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str([report_date])' />
      </column>
      <column caption='# Successful Orders' datatype='integer' name='[Calculation_1114077987075440643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[successful_orders]' />
      </column>
      <column caption='# Gross Orders' datatype='integer' name='[Calculation_1114077987075518468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[gross_orders]' />
      </column>
      <column caption='% Failed Orders' datatype='real' name='[Calculation_1114077987078189062]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([failed_orders])/sum([gross_orders])' />
      </column>
      <column caption='% Dmart Cancelled' datatype='real' name='[Calculation_1114077987078258695]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([vendor_cancelled_orders])/sum([gross_orders])' />
      </column>
      <column caption='Date View (+/-)' datatype='string' name='[Calculation_1114077987078598664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Monthly&quot; THEN [Calculation_1114077987074834433]&#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;END' />
      </column>
      <column caption='GFV' datatype='real' name='[Calculation_1114077987079405577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[gfv]' />
      </column>
      <column caption='AFV' datatype='real' name='[Calculation_1114077987079524362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1114077987079405577])/sum([successful_orders])' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_1114077987081269259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[gmv]' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_1114077987081355276]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1114077987081269259])/sum([successful_orders])' />
