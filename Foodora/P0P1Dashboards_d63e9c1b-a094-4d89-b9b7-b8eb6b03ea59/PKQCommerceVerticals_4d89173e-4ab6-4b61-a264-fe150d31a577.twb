    </datasource>
    <datasource caption='PK QC Verticals' inline='true' name='federated.08whz7a1l9csdk18h1bbi0gfb72z' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1h91iwd028z35x1gwv6h701n2ro2'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='pd-data--adhoc' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='server-custom' username='patchara.pattiyathanee@foodpanda.co.th' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1h91iwd028z35x1gwv6h701n2ro2' name='Custom SQL Query' type='text'><![CDATA[WITH warehouse_info AS (
  SELECT
    dmart_warehouses.warehouse_id AS dmart_imt_warehouse_uuid,
    vendors.platform_vendor_id AS vendor_code,
    dmart_warehouses.name AS dmart_imt_warehouse_name,
    RIGHT(dmart_warehouses.name, 5) AS cityedit
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.warehouses_v2` AS dmart_warehouses
  LEFT JOIN UNNEST(vendors) AS vendors
  WHERE dmart_warehouses.global_entity_id = "FP_PK"
    AND dmart_warehouses.warehouse_id IS NOT NULL
),
catalog AS (
  SELECT DISTINCT
    catalog.vendor_code,
    catalog.sku,
    catalog.dmart_catalog_global_product_id as global_id,
    catalog.master_code,
    catalog.barcodes,
    catalog.master_product_name_english,
    COALESCE(pim.pim_category_one, catalog.master_category_names.level_one) AS master_category_level_one,
      COALESCE(pim.pim_category_two, catalog.master_category_names.level_two) AS master_category_level_two,
    catalog.is_active,
    catalog.is_vendor_deleted OR catalog.is_vendor_product_deleted AS is_deleted,
    catalog.is_valid_vendor_sku,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_qcommerce__dmart_products` AS catalog
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.preprocessing__qcomm_pim_products` AS pim
         ON catalog.master_code = pim.pim_product_id
  WHERE
  global_entity_id = 'FP_PK'
  AND catalog.dmart_catalog_global_product_id IS NOT NULL
),

vouchers AS (
  SELECT
    order_code,
    channel,
    purpose,
    description,
    attributions_foodpanda_ratio,
    attributions_vendor_ratio,
    attributions_thirdparty_ratio,
    value_local AS voucher_amount,
    value_local * (attributions_foodpanda_ratio / 100) AS voucher_amount_foodpanda
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` AS vouchers
  WHERE global_entity_id = "FP_PK"
),

--blacklisted_customers AS (
--  SELECT
--    customer_code,
--    is_black,
--    type,
--    remarks
--  FROM `dhh---analytics-apac.pandata_pk.cx_fraud_customers`
--  QUALIFY ROW_NUMBER() OVER(PARTITION BY customer_code ORDER BY date DESC) = 1
--),
--
incidents AS (
  SELECT 
    order_id,
    COUNT(DISTINCT contact_id) AS number_of_issues,
    COUNT(DISTINCT 
      CASE 
        WHEN contact_reason_l2 IN ("Food Issue", "Item Issue") THEN contact_id
        ELSE NULL
      END
    ) AS number_of_food_quality_issues,
    COUNT(DISTINCT 
      CASE 
        WHEN contact_reason_l2 IN ("Food Issue", "Item Issue") THEN contact_id
        ELSE NULL
      END
    ) >> 0 is_food_quality_incident_order,
    COUNT(DISTINCT 
      CASE 
        WHEN contact_reason_l2 IN ("Wrong / Missing item", "Wrong order / Never arrived") THEN contact_id
        ELSE NULL
      END
    ) AS number_of_wrong_missing_issues,
    COUNT(DISTINCT 
      CASE 
        WHEN contact_reason_l2 IN ("Wrong / Missing item", "Wrong order / Never arrived") THEN contact_id
        ELSE NULL
      END
    ) >> 0 AS is_wrong_missing_incident_order,
    COUNT(DISTINCT contact_reason_l2) AS number_of_ccr2s
  FROM `fulfillment-dwh-production.curated_data_shared.all_contacts` 
  WHERE created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH) - 1
    AND global_entity_id = "FP_PK"
    AND contact_reason_l1 IN ("Post-Delivery")
    AND contact_reason_l3 NOT IN (
      'Order not delivered to doorstep', 'Incorrect invoice', 'Delivery instructions not followed', 'Fraud', 'Money collection issue', 'Order never arrived', 'Refund query',
      'Delayed delivery', 'Wallet refund query', 'Refund request', 'Inappropriate behaviour', 'Other issues related to contactless delivery', 'Invoice missing',
      'Moderate delay', 'Missing equipment/uniform', 'Rider tips refund issue', 'Double charge', 'Issue with item replacement process', 'Cooking instructions were not followed'
    )
    GROUP BY
      order_id
),

products AS (
  SELECT
    dmart__product_report.sku,
    dmart__product_report.dmart_imt_warehouse_uuid,
    dmart__product_report.dmart_imt_warehouse_name,
    dmart__product_report.product_title_english AS product_name,
    dmart__product_report.category_english AS category,
    dmart__product_report.subcategory_english AS subcategory,
    dmart__product_report.master_category_names.level_one AS category_level_one,
    dmart__product_report.status,
    vat_rate_percent
  FROM `fulfillment-dwh-production.pandata_report.dmart__product_report` AS dmart__product_report
  WHERE dmart__product_report.global_entity_id = "FP_PK"
  QUALIFY ROW_NUMBER() OVER (PARTITION BY sku, dmart_imt_warehouse_uuid) = 1
),

dmart_partial_orders AS (
  SELECT 
    customer_orders.order_id AS pd_order_code,
    SUM(items.quantity_ordered) AS ordered_quantity,
    SUM(
      CASE 
        WHEN customer_orders.is_successful THEN items.quantity_delivered 
        ELSE 0 
      END
    ) AS delivered_quantity,
    CASE
      WHEN SUM(
        CASE 
          WHEN customer_orders.is_successful THEN items.quantity_delivered 
          ELSE 0 
        END) << SUM(items.quantity_ordered) 
      AND customer_orders.is_successful 
      THEN TRUE
      ELSE FALSE
    END AS is_partially_fulfilled_order
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.qc_orders`  AS customer_orders
  LEFT JOIN UNNEST(customer_orders.items) AS items
  WHERE global_entity_id = "FP_PK"
    AND DATE(customer_orders.order_created_date_lt) >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND customer_orders.is_dmart
  GROUP BY
    customer_orders.order_id,
    customer_orders.is_successful
),

weighted_average_cost AS (
  SELECT 
    global_entity_id, 
    country_code, 
    sku, 
    warehouse_id, 
    wac, 
    valid_from, 
    valid_to, 
    adjustment_reason, 
    cogs_adjustment 
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.wac_info`
  WHERE global_entity_id = "FP_PK"
),

dmart_orders AS (
  SELECT 
    customer_order_line_report.order_code AS pd_order_code,
    dmart_partial_orders.is_partially_fulfilled_order,
    SUM(dmart_partial_orders.ordered_quantity) AS ordered_quantity,
    SUM(dmart_partial_orders.delivered_quantity) AS delivered_quantity,
    COUNT(DISTINCT customer_order_line_report.sku) AS skus_in_order,
    SUM(received_quantity) AS units_sold,
    SUM(received_quantity * unit_discount_amount_local) AS discount_amount,
    SUM(received_quantity * unit_price_paid_local) AS gfv_with_vat,
    SUM(
      CASE
        WHEN products.category_level_one IN ("Meat / Seafood", "Produce", "Ready To Consume")
        THEN received_quantity * unit_price_paid_local
        ELSE NULL
      END
    ) AS ultra_fresh_gfv_with_vat,
    SUM(
      CASE
        WHEN products.category IN ("Meat, Fruits and Vegetables", "Fruits & Vegetables", "Meat & Seafood")
        THEN received_quantity * unit_price_paid_local
        ELSE NULL
      END
    ) AS ultra_fresh_actual_gfv_with_vat,
    Count( distinct
      CASE
        WHEN products.category_level_one IN ("Meat / Seafood", "Produce", "Ready To Consume")
        THEN order_code
        ELSE NULL
      END
    ) AS ultra_fresh_orders_dmart,
    Count( distinct
      CASE
        WHEN products.category IN ("Meat, Fruits and Vegetables", "Fruits & Vegetables", "Meat & Seafood")
        THEN order_code
        ELSE NULL
      END
    ) AS ultra_fresh_actual_orders_dmart,
    SUM((received_quantity * unit_price_paid_local) / (1 + COALESCE(customer_order_line_report.vat_rate_percent, products.vat_rate_percent))) AS gfv_without_vat,
    SUM(received_quantity * COALESCE(weighted_average_cost.wac, wac_local)) AS cogs,
    SUM((received_quantity * unit_price_paid_local) / (1 + COALESCE(customer_order_line_report.vat_rate_percent, products.vat_rate_percent)) - (received_quantity * COALESCE(weighted_average_cost.wac, wac_local))) AS margin_amount
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__customer_order_line_report_v2` AS customer_order_line_report
  LEFT JOIN products
         ON products.sku = customer_order_line_report.sku
        AND products.dmart_imt_warehouse_uuid = customer_order_line_report.dmart_imt_warehouse_uuid
  LEFT JOIN dmart_partial_orders
         ON dmart_partial_orders.pd_order_code = customer_order_line_report.order_code
  LEFT JOIN weighted_average_cost
         ON weighted_average_cost.sku = customer_order_line_report.sku
        AND weighted_average_cost.warehouse_id = customer_order_line_report.dmart_imt_warehouse_uuid
        AND TIMESTAMP(customer_order_line_report.order_at_utc) BETWEEN weighted_average_cost.valid_from AND weighted_average_cost.valid_to
  WHERE customer_order_line_report.order_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND customer_order_line_report.global_entity_id = "FP_PK"
  GROUP BY
    pd_order_code,
    is_partially_fulfilled_order
),

shops_orders AS (
  SELECT 
    order_code AS pd_order_code,
    LOGICAL_OR(customer_order_line_report.is_item_not_fully_fulfilled) AS is_partially_fulfilled_order,
    SUM(pre_replacement_ordered_quantity) AS ordered_quantity,
    SUM(delivered_quantity) AS delivered_quantity,
    COUNT(DISTINCT catalog_global_product_id) AS skus_in_order,
    SUM(delivered_quantity) AS units_sold,
    SUM(delivered_quantity * (original_unit_price_local - discounted_unit_price_local)) AS discount_amount,
     Count( distinct
      CASE
        WHEN catalog.master_category_level_one IN ("Meat / Seafood", "Produce", "Ready To Consume")
        THEN order_code
        ELSE NULL
      END
    ) AS ultra_fresh_orders_shops,
     Count( distinct
      CASE
        WHEN catalog.master_category_level_one IN  ("Meat, Fruits and Vegetables", "Fruits & Vegetables", "Meat & Seafood")
        THEN order_code
        ELSE NULL
      END
    ) AS ultra_fresh_actual_orders_shops
   
  FROM  `fulfillment-dwh-production.pandata_datamart.pandora__order_products_shops_details` AS customer_order_line_report
  
  -- LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vendor_info
  --        ON vendor_info.vendor_code = customer_order_line_report.vendor_code
  left join catalog on catalog.global_id = customer_order_line_report.catalog_global_product_id
  WHERE customer_order_line_report.order_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND customer_order_line_report.global_entity_id = "FP_PK"
  GROUP BY
    pd_order_code
),

vendors AS (
  SELECT
    vendor_info.vendor_code,
    vendor_info.vendor_name,
    pv.cities.title city_name,
    vendor_info.sf_zone_name
  FROM `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` vendor_info
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.vdr_svc_vendors` pv
         ON vendor_info.vendor_code = pv.vendor_code
        AND pv.global_entity_id = "FP_PK"
),

sf_grid AS (
  SELECT
    vendors.vendor_code,
    CASE
      WHEN 
        COALESCE(restaurant_addresses.administrative_area_name, billing_addresses.administrative_area_name) = 'Punjab' 
        THEN 0.16
      WHEN 
        COALESCE(restaurant_addresses.administrative_area_name, billing_addresses.administrative_area_name) = 'Sindh' 
        THEN 0.13
      WHEN 
        COALESCE(restaurant_addresses.administrative_area_name, billing_addresses.administrative_area_name) = 'Balochistan' 
        THEN 0.15
      WHEN 
        COALESCE(restaurant_addresses.administrative_area_name, billing_addresses.administrative_area_name) = 'Islamabad' 
        THEN 0.16
      WHEN 
        COALESCE(restaurant_addresses.administrative_area_name, billing_addresses.administrative_area_name) = 'KPK' 
        THEN 0.02
      WHEN 
        COALESCE(restaurant_addresses.administrative_area_name, billing_addresses.administrative_area_name) = 'AJK' 
        THEN 0.16
    END AS tax_df_sf,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_sf_accounts` AS sf_accounts
  LEFT JOIN UNNEST(addresses) AS restaurant_addresses
         ON restaurant_addresses.is_deleted = FALSE
        AND restaurant_addresses.address_type LIKE "%Restaurant Address%"
  LEFT JOIN UNNEST(addresses) AS billing_addresses
         ON billing_addresses.is_deleted = FALSE
        AND billing_addresses.address_type LIKE "%Billing Address%"
  LEFT JOIN vendors 
         ON vendors.vendor_code = sf_accounts.vendor_code
  WHERE global_entity_id = "FP_PK"
    AND vendors.vendor_code IS NOT NULL
),

comp_and_refunds AS (
  SELECT
    order_id,
    TRUE AS is_refund_issued
  FROM `fulfillment-dwh-production.curated_data_shared.comp_and_refund_events`
  WHERE global_entity_id = "FP_PK"
    AND created_date_localtime >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
  QUALIFY ROW_NUMBER() OVER (PARTITION BY order_id) = 1
),

baseline AS (
  SELECT
    CASE
      WHEN vendor_info.vertical = "shops" THEN "shops"
      WHEN LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) LIKE "%franchise%" THEN "franchise"
      ELSE "dmart"
    END AS vertical,
    pd_orders.vendor_code,
    sf_grid.tax_df_sf,
    COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name) AS vendor_name,
    COALESCE(vendor_info.sf_city, vendor_info.lg_city) AS city_name,
    COALESCE(vendor_info.sf_zone_name, vendor_info.lg_zone_name) AS zone_name,
    CASE
      WHEN vendor_info.vertical = "shops" THEN vendor_info.owner_name 
      ELSE NULL
    END AS account_manager_name,
    CASE
      WHEN vendor_info.vertical = "shops" THEN vendor_info.vertical_segment 
      WHEN LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) LIKE "%franchise%" THEN "franchise"
      ELSE "dmart"
    END AS vertical_segment,
    vendor_info.chain_code,
    vendor_info.chain_name,
    pd_orders.created_date_local,
    pd_orders.created_at_utc,
    customer_agg.first_valid_order_dmart_at_utc,
    customer_agg.first_valid_order_shops_at_utc,
    customer_agg.first_valid_order_all_at_utc,
    acid_order_dates.first_valid_order_dmart_at_utc AS first_valid_order_dmart_at_utc_acid,
    acid_order_dates.first_valid_order_shops_at_utc AS first_valid_order_shops_at_utc_acid,
    pd_orders.pd_customer_uuid,
    COALESCE(id_mapping.analytical_customer_id, pd_orders.pd_customer_uuid) AS analytical_customer_id,
    pd_orders.order_code,
    pd_orders.is_successful as is_valid_order,
    pd_orders.is_failed_order,
    pd_orders.is_cancelled_by_vendor,
    pd_orders.is_cancelled_by_customer,
    pd_orders.is_cancelled_by_logistics,
    COALESCE(dmart_orders.is_partially_fulfilled_order, shops_orders.is_partially_fulfilled_order) AS is_partially_fulfilled_order,
    COALESCE(dmart_orders.ordered_quantity, shops_orders.ordered_quantity) AS ordered_quantity,
    COALESCE(dmart_orders.delivered_quantity, shops_orders.delivered_quantity) AS delivered_quantity,
   -- pd_orders.preparation_time_in_minutes,
    pd_orders.actual_delivery_time_in_minutes,
    pd_orders.gfv_local AS gfv,
    dmart_orders.gfv_with_vat,
    dmart_orders.ultra_fresh_gfv_with_vat,
    dmart_orders.ultra_fresh_actual_gfv_with_vat,
    dmart_orders.ultra_fresh_orders_dmart,
    shops_orders.ultra_fresh_orders_shops,
    dmart_orders.ultra_fresh_actual_orders_dmart,
    shops_orders.ultra_fresh_actual_orders_shops,
    dmart_orders.gfv_without_vat,
    dmart_orders.cogs,
    dmart_orders.margin_amount,
    pd_orders.user_paid_gmv_local AS gmv,
    COALESCE(dmart_orders.units_sold, shops_orders.units_sold) AS units_sold,
    COALESCE(dmart_orders.skus_in_order, shops_orders.skus_in_order) AS skus_in_order,
    COALESCE(dmart_orders.discount_amount, shops_orders.discount_amount) AS discount_amount,
    incidents.order_id IS NOT NULL AS is_incident_order,
    incidents.is_food_quality_incident_order,
    incidents.is_wrong_missing_incident_order,
    incidents.number_of_food_quality_issues,
    incidents.number_of_wrong_missing_issues,
    incidents.number_of_issues,
    incidents.number_of_ccr2s,
    vouchers.channel,
    vouchers.purpose,
    COALESCE(vouchers.voucher_amount) AS voucher_amount,
    COALESCE(vouchers.voucher_amount_foodpanda) AS voucher_amount_foodpanda,
    cashback_order_level.commission_base,
    cashback_order_level.commission_revenue,
    pd_orders.pandora_decline_reason_title AS decline_reason,
    pd_orders.payment_method AS payment_method,
    pd_orders.df_user_paid_incl_vat_local,
    pd_orders.df_user_paid_incl_vat_local / (1 + sf_grid.tax_df_sf) AS delivery_fee_excl_tax,
    subsidy_metrics_order_level.service_fee_local,
    subsidy_metrics_order_level.service_fee_local / (1 + sf_grid.tax_df_sf) AS service_fee_excl_tax,
    pd_orders.container_charges_local AS packaging_fee_local,
    pd_orders.container_charges_local / (1 + sf_grid.tax_df_sf) AS packaging_fee_excl_tax,
    subsidy_metrics_order_level.is_free_delivery_subscription_order,
    
    CASE
      WHEN subsidy_metrics_order_level.is_free_delivery_subscription_order
       AND EXTRACT(HOUR FROM pd_orders.created_at_local) IN (0, 1, 2, 3, 4, 5, 6)
      THEN 169
      WHEN subsidy_metrics_order_level.is_free_delivery_subscription_order
       AND EXTRACT(HOUR FROM pd_orders.created_at_local) NOT IN (0, 1, 2, 3, 4, 5, 6)
      THEN 159
      ELSE pd_orders.df_user_paid_incl_vat_local
    END AS pro_adjusted_delivery_fee_incl_tax,
    CASE
      WHEN subsidy_metrics_order_level.is_free_delivery_subscription_order
       AND EXTRACT(HOUR FROM pd_orders.created_at_local) IN (0, 1, 2, 3, 4, 5, 6)
      THEN 169
      WHEN subsidy_metrics_order_level.is_free_delivery_subscription_order
       AND EXTRACT(HOUR FROM pd_orders.created_at_local) NOT IN (0, 1, 2, 3, 4, 5, 6)
      THEN 159
      ELSE pd_orders.df_user_paid_incl_vat_local
    END / (1 + sf_grid.tax_df_sf) AS pro_adjusted_delivery_fee_excl_tax,
    CASE
      WHEN (pd_orders.created_at_utc = customer_agg.first_valid_order_dmart_at_utc
        OR pd_orders.created_at_utc = customer_agg.first_valid_order_shops_at_utc)
       AND pd_orders.df_user_paid_incl_vat_local = 0
       AND EXTRACT(HOUR FROM pd_orders.created_at_local) IN (0, 1, 2, 3, 4, 5, 6)
      THEN 169
      WHEN (pd_orders.created_at_utc = customer_agg.first_valid_order_dmart_at_utc
        OR pd_orders.created_at_utc = customer_agg.first_valid_order_shops_at_utc)
       AND pd_orders.df_user_paid_incl_vat_local = 0
       AND EXTRACT(HOUR FROM pd_orders.created_at_local) NOT IN (0, 1, 2, 3, 4, 5, 6)
      THEN 159
      ELSE 0
    END AS nc_df_subsidy,

    operational_metrics.actual_delivery_time_in_seconds,
    DATETIME_DIFF(pelican_event.shopper_recevied_local, pd_orders.created_at_local, SECOND) AS shopper_delay_time_in_sec,
    DATETIME_DIFF(pelican_event.pelican_available_local, pelican_event.shopper_recevied_local, SECOND) AS pelican_delay_time_in_sec,
    DATETIME_DIFF(pelican_event.started_local, pelican_event.pelican_available_local, SECOND) AS assignment_time_in_sec,
    DATETIME_DIFF(pelican_event.last_cart_local, pelican_event.started_local, SECOND) AS pick_time_in_sec,
    DATETIME_DIFF(pelican_event.ready_pickup_local, pelican_event.last_cart_local, SECOND) AS pack_time_in_sec,
    DATETIME_DIFF(pelican_event.ready_pickup_local, pelican_event.started_local, SECOND) AS pick_pack_time_in_sec,
    DATETIME_DIFF(pelican_event.pickup_local, pelican_event.ready_pickup_local, SECOND) AS rider_dispatch_time_in_sec,
    DATETIME_DIFF(pelican_event.ready_pickup_local, pelican_event.shopper_recevied_local, SECOND) AS vendor_prep_time_in_sec,
    -- DATETIME_DIFF(picked_up, pelican_event.ready_pickup_local, SECOND) AS waiting_for_rider_time_in_sec, --get picked_up timestamp from lg_orders
    -- DATETIME_DIFF(pd_orders.updated_at_local, pelican_event.picked_up, SECOND) AS rider_drive_time_in_sec,

    seamless_orders.is_seamless_order,
    seamless_orders.is_gross_order AS is_seamless_gross_base,
    COALESCE(comp_and_refunds.is_refund_issued, FALSE) AS is_refund_issued,

   -- CASE 
   --   WHEN blacklisted_customers.is_black IS NULL THEN "Green"
   --   WHEN blacklisted_customers.is_black THEN "Black"
   --   ELSE "Grey"
   -- END AS customer_local_fraud_flag,

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS pd_orders
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vendor_info
         ON vendor_info.vendor_code = pd_orders.vendor_code
  LEFT JOIN warehouse_info
         ON warehouse_info.vendor_code = pd_orders.vendor_code
  LEFT JOIN vouchers
         ON vouchers.order_code = pd_orders.order_code
  LEFT JOIN incidents
         ON incidents.order_id = pd_orders.order_code
  LEFT JOIN dmart_orders
         ON dmart_orders.pd_order_code = pd_orders.order_code
  LEFT JOIN shops_orders
         ON shops_orders.pd_order_code = pd_orders.order_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_finance_cashback_order_level` AS cashback_order_level
         ON cashback_order_level.order_code = pd_orders.order_code
        AND cashback_order_level.date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH) - 1
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_customers_agg_order_dates` AS customer_agg
        --  ON pd_orders.pd_vendor_uuid = customer_agg.pd_vendor_uuid
         ON pd_orders.pd_customer_uuid = customer_agg.uuid
        AND customer_agg.global_entity_id = "FP_PK"
        -- AND customer_agg.vendor_type IN ("pandamart", "shops")
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_qcommerce__operational_metrics_order_level` AS operational_metrics
         ON operational_metrics.code = pd_orders.order_code
        AND operational_metrics.global_entity_id = "FP_PK"
        AND operational_metrics.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH) - 1
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_dmart__ops_order_pelican_event_timing` AS pelican_event
         ON pelican_event.pd_order_code = pd_orders.order_code
        AND pelican_event.global_entity_id = "FP_PK"
  LEFT JOIN sf_grid
         ON sf_grid.vendor_code = pd_orders.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_qcommerce__subsidy_metrics_order_level` AS subsidy_metrics_order_level
         ON subsidy_metrics_order_level.order_code = pd_orders.order_code
        AND subsidy_metrics_order_level.global_entity_id = "FP_PK"
        AND subsidy_metrics_order_level.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH) - 1
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_cx_seamless_order` AS seamless_orders
         ON seamless_orders.order_code = pd_orders.order_code
        AND seamless_orders.ordered_at_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
        AND seamless_orders.global_entity_id = "FP_PK"
  LEFT JOIN comp_and_refunds
         ON comp_and_refunds.order_id = pd_orders.order_code
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_mkt.braze_external_id_map` AS id_mapping
         ON CONCAT(REGEXP_EXTRACT(id_mapping.external_id, r"[0-9]+"), "_FP_", REGEXP_EXTRACT(id_mapping.external_id, r"^..")) = pd_orders.pd_customer_uuid
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_customers_agg_order_dates_acid` AS acid_order_dates
         ON acid_order_dates.analytical_customer_id = COALESCE(id_mapping.analytical_customer_id, pd_orders.pd_customer_uuid)
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.cus_customers` AS customers
         ON customers.uuid = pd_orders.pd_customer_uuid
        AND customers.global_entity_id = "FP_PK"
 -- LEFT JOIN blacklisted_customers
 --        ON blacklisted_customers.customer_code = customers.code

  WHERE pd_orders.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH) - 1
    AND pd_orders.created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND pd_orders.global_entity_id = "FP_PK"
    AND vendor_info.vertical IN ("darkstores", "shops")
    AND pd_orders.vendor_code NOT IN ("tqip")
    AND LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) NOT LIKE "%business%"
    AND LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) NOT LIKE "%corporate%"
    AND LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) NOT LIKE "%pantry%"
    AND LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) NOT LIKE "%odr%"
    AND LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) NOT LIKE "%export%"
    AND pd_orders.is_gross_order
    AND NOT vendor_info.is_sf_test
),

all_order_level_info AS (
  SELECT
    vertical,
    vendor_code,
    vendor_name,
    city_name,
    zone_name,
    account_manager_name,
    vertical_segment,
    chain_code,
    chain_name,
    created_date_local,
    CASE
      WHEN EXTRACT (DAYOFWEEK FROM created_date_local) = 1 THEN "Sunday"
      WHEN EXTRACT (DAYOFWEEK FROM created_date_local) = 2 THEN "Monday"
      WHEN EXTRACT (DAYOFWEEK FROM created_date_local) = 3 THEN "Tuesday"
      WHEN EXTRACT (DAYOFWEEK FROM created_date_local) = 4 THEN "Wednesday"
      WHEN EXTRACT (DAYOFWEEK FROM created_date_local) = 5 THEN "Thursday"
      WHEN EXTRACT (DAYOFWEEK FROM created_date_local) = 6 THEN "Friday"
      ELSE "Saturday"
    END AS day,
    CASE 
      WHEN DATE_TRUNC(created_date_local, MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH) 
      THEN "Current Month"
      WHEN DATE_TRUNC(created_date_local, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH), MONTH) 
      THEN "Last Month"
      WHEN DATE_TRUNC(created_date_local, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH) 
        OR DATE_TRUNC(created_date_local, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH), MONTH) 
      THEN "Prior 2 Months"
      WHEN DATE_TRUNC(created_date_local, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 4 MONTH), MONTH) 
        OR DATE_TRUNC(created_date_local, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH) 
      THEN "Earlier 2 Months"
      ELSE "Older"
    END AS period,
    COUNT(DISTINCT order_code) AS gross_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order THEN order_code
        ELSE NULL
      END
    ) AS valid_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND payment_method != "Cash On Delivery"
        THEN order_code
        ELSE NULL
      END
    ) AS online_paid_valid_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_failed_order THEN order_code
        ELSE NULL
      END
    ) AS failed_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_cancelled_by_vendor 
         AND decline_reason != "Fraud/prank order"
        THEN order_code
        ELSE NULL
      END
    ) AS vendor_failed_orders,
    COUNT(DISTINCT
      CASE
        WHEN NOT is_valid_order
         AND decline_reason = "Product unavailable"
        THEN order_code
        ELSE NULL
      END
    ) AS pu_cancelled_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_cancelled_by_customer THEN order_code
        ELSE NULL
      END
    ) AS customer_failed_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_cancelled_by_logistics THEN order_code
        ELSE NULL
      END
    ) AS logistics_failed_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order
         AND is_partially_fulfilled_order THEN order_code
        ELSE NULL
      END
    ) AS partially_fulfilled_orders,
    SUM(
      CASE
        WHEN is_valid_order THEN ordered_quantity
        WHEN decline_reason = "Product unavailable" THEN ordered_quantity
        ELSE NULL
      END
    ) AS items_ordered,
  SUM(
       CASE
        WHEN is_valid_order THEN ordered_quantity
        WHEN decline_reason = "Product unavailable" THEN ordered_quantity
        ELSE NULL
      END
    ) - 
    SUM(
       CASE
        WHEN is_valid_order THEN delivered_quantity
        WHEN decline_reason = "Product unavailable" THEN 0
        ELSE NULL
      END
    ) AS item_not_delivered,
    SUM(
      CASE
        WHEN is_valid_order THEN gfv
        ELSE NULL
      END
    ) AS gfv,
    SUM(
      CASE
        WHEN is_valid_order THEN COALESCE(gfv_with_vat, gfv)
        ELSE NULL
      END
    ) AS gfv_with_vat,
    SUM(
      CASE
        WHEN vertical != "shops" AND is_valid_order 
        THEN ultra_fresh_gfv_with_vat
        WHEN vertical = "shops" AND is_valid_order AND vertical_segment IN (
          "butchery", "fishery" "fruits_and_vegetables", "wet_market"
        ) 
        THEN gfv
        ELSE NULL
      END
    ) AS ultra_fresh_gfv_with_vat,
    SUM(
      CASE
        WHEN vertical != "shops" AND is_valid_order 
        THEN ultra_fresh_actual_gfv_with_vat
        WHEN vertical = "shops" AND is_valid_order AND vertical_segment IN (
          "butchery", "fishery" "fruits_and_vegetables", "wet_market"
        ) 
        THEN gfv
        ELSE NULL
      END
    ) AS ultra_fresh_actual_gfv_with_vat,
    SUM(
      CASE
        WHEN vertical != "shops" AND is_valid_order 
        THEN ultra_fresh_actual_orders_dmart
        ELSE ultra_fresh_actual_orders_shops
      END
    ) AS ultra_fresh_actual_orders,
    SUM(
      CASE
        WHEN vertical != "shops" AND is_valid_order 
        THEN ultra_fresh_orders_dmart
        ELSE ultra_fresh_orders_shops
      END
    ) AS ultra_fresh_orders,
    SUM(
      CASE
        WHEN is_valid_order THEN gfv_without_vat
        ELSE NULL
      END
    ) AS gfv_without_vat,
    SUM(
      CASE
        WHEN is_valid_order THEN cogs
        ELSE NULL
      END
    ) AS cogs,
    SUM(
      CASE
        WHEN is_valid_order THEN margin_amount
        ELSE NULL
      END
    ) AS margin_amount,
    SUM(
      CASE
        WHEN is_valid_order THEN gmv
        ELSE NULL
      END
    ) AS gmv,
    SUM(
      CASE
        WHEN is_valid_order THEN units_sold
        ELSE NULL
      END
    ) AS units_sold,
    SUM(
      CASE
        WHEN is_valid_order THEN skus_in_order
        ELSE NULL
      END
    ) AS skus_in_order,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND channel IS NOT NULL THEN order_code
        ELSE NULL
      END
    ) AS valid_voucher_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND discount_amount >> 0 THEN order_code
        ELSE NULL
      END
    ) AS valid_discount_orders,
    SUM(
      CASE
        WHEN is_valid_order THEN voucher_amount
        ELSE NULL
      END
    ) AS voucher_amount,
    SUM(
      CASE
        WHEN is_valid_order 
         AND CONCAT(channel, purpose) NOT IN (
          'channel_crmautocompensation_realtime', 'channel_crmcompensation', 'channel_customer_servicecompensation', 'channel_customer_servicerefund', 'channel_customer_servicesorry_panda', 'channel_onlineautocompensation_realtime', 'channel_onlinesorry_panda', 'channel_otherssorry_panda', 'channel_subsidiessorry_panda')
        THEN voucher_amount
        ELSE NULL
      END
    ) AS voucher_amount_excl_cx,
    SUM(
      CASE
        WHEN is_valid_order 
         AND CONCAT(channel, purpose) NOT IN (
          'channel_crmautocompensation_realtime', 'channel_crmcompensation', 'channel_customer_servicecompensation', 'channel_customer_servicerefund', 'channel_customer_servicesorry_panda', 'channel_onlineautocompensation_realtime', 'channel_onlinesorry_panda', 'channel_otherssorry_panda', 'channel_subsidiessorry_panda')
        THEN voucher_amount_foodpanda
        ELSE NULL
      END
    ) AS voucher_amount_foodpanda_excl_cx,
    COUNT(DISTINCT
      CASE
        WHEN is_incident_order
        THEN order_code
        ELSE NULL
      END
    ) AS orders_with_incidents,
    COUNT(DISTINCT
      CASE
        WHEN is_food_quality_incident_order
        THEN order_code
        ELSE NULL
      END
    ) AS orders_with_food_quality_incidents,
    COUNT(DISTINCT
      CASE
        WHEN is_wrong_missing_incident_order
        THEN order_code
        ELSE NULL
      END
    ) AS orders_with_missing_wrong_incidents,
    SUM(number_of_issues
    ) AS number_of_issues,
    SUM(number_of_ccr2s
    ) AS number_of_ccr2s,
    SUM(
      number_of_food_quality_issues
      
    ) AS number_of_food_quality_issues,
    SUM(
      
         number_of_wrong_missing_issues
        
      
    ) AS number_of_missing_wrong_issues,
    SUM(
      CASE
        WHEN is_valid_order 
         AND vertical = "shops" 
        THEN commission_base
        ELSE NULL
      END
    ) AS commission_base,
    SUM(
      CASE
        WHEN is_valid_order 
         AND vertical = "shops" 
        THEN commission_revenue
        ELSE NULL
      END
    ) AS commission_revenue,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order
        THEN pd_customer_uuid
        ELSE NULL
      END
    ) AS unique_customers,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND vertical = "shops"
         AND created_at_utc != first_valid_order_shops_at_utc
        THEN pd_customer_uuid
        WHEN is_valid_order 
         AND vertical != "shops"
         AND created_at_utc != first_valid_order_dmart_at_utc
        THEN pd_customer_uuid
        ELSE NULL
      END
    ) AS existing_customers,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND vertical = "shops"
         AND created_at_utc = first_valid_order_shops_at_utc
        THEN pd_customer_uuid
        WHEN is_valid_order 
         AND vertical != "shops"
         AND created_at_utc = first_valid_order_dmart_at_utc
        THEN pd_customer_uuid
        ELSE NULL
      END
    ) AS new_customers,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND vertical = "shops"
         AND created_at_utc = first_valid_order_shops_at_utc
         AND created_at_utc = first_valid_order_all_at_utc
        THEN pd_customer_uuid
        WHEN is_valid_order 
         AND vertical != "shops"
         AND created_at_utc = first_valid_order_dmart_at_utc
         AND created_at_utc = first_valid_order_all_at_utc
        THEN pd_customer_uuid
        ELSE NULL
      END
    ) AS ntp_customers,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND vertical = "shops"
         AND created_at_utc = first_valid_order_shops_at_utc
         AND created_at_utc != first_valid_order_all_at_utc
        THEN pd_customer_uuid
        WHEN is_valid_order 
         AND vertical != "shops"
         AND created_at_utc = first_valid_order_dmart_at_utc
         AND created_at_utc != first_valid_order_all_at_utc
        THEN pd_customer_uuid
        ELSE NULL
      END
    ) AS ntv_customers,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND vertical = "shops"
         AND created_at_utc = first_valid_order_shops_at_utc_acid
        THEN analytical_customer_id
        WHEN is_valid_order 
         AND vertical != "shops"
         AND created_at_utc = first_valid_order_dmart_at_utc_acid
        THEN analytical_customer_id
        ELSE NULL
      END
    ) AS new_customers_acid,
    SUM(
      CASE
        WHEN is_valid_order THEN discount_amount
        ELSE NULL
      END
    ) AS discount_amount,
    SUM(
      CASE
        WHEN is_valid_order THEN actual_delivery_time_in_seconds
        ELSE NULL
      END
    ) AS actual_delivery_time_in_seconds,
    SUM(
      CASE
        WHEN is_valid_order THEN shopper_delay_time_in_sec
        ELSE NULL
      END
    ) AS shopper_delay_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN pelican_delay_time_in_sec
        ELSE NULL
      END
    ) AS pelican_delay_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN assignment_time_in_sec
        ELSE NULL
      END
    ) AS assignment_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN pick_time_in_sec
        ELSE NULL
      END
    ) AS pick_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN pack_time_in_sec
        ELSE NULL
      END
    ) AS pack_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN pick_pack_time_in_sec
        ELSE NULL
      END
    ) AS pick_pack_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN rider_dispatch_time_in_sec
        ELSE NULL
      END
    ) AS rider_dispatch_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN vendor_prep_time_in_sec
        ELSE NULL
      END
    ) AS vendor_prep_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN df_user_paid_incl_vat_local
        ELSE NULL
      END
    ) AS delivery_fee_local,
    SUM(
      CASE
        WHEN is_valid_order THEN delivery_fee_excl_tax
        ELSE NULL
      END
    ) AS delivery_fee_local_excl_tax,
    SUM(
      CASE
        WHEN is_valid_order THEN service_fee_local
        ELSE NULL
      END
    ) AS servide_fee_local,
    SUM(
      CASE
        WHEN is_valid_order THEN service_fee_excl_tax
        ELSE NULL
      END
    ) AS service_fee_local_excl_tax,
    SUM(
      CASE
        WHEN is_valid_order THEN packaging_fee_local
        ELSE NULL
      END
    ) AS packaging_fee_local,
    SUM(
      CASE
        WHEN is_valid_order THEN packaging_fee_excl_tax
        ELSE NULL
      END
    ) AS packaging_fee_local_excl_tax,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND is_free_delivery_subscription_order THEN order_code
        ELSE NULL
      END
    ) AS valid_pro_orders,
    SUM(
      CASE
        WHEN is_valid_order 
         AND vertical != "shops"
        THEN pro_adjusted_delivery_fee_incl_tax
        WHEN is_valid_order 
         AND vertical = "shops"
        THEN df_user_paid_incl_vat_local
        ELSE NULL
      END
    ) AS pro_adjusted_delivery_fee_incl_tax,
    SUM(
      CASE
        WHEN is_valid_order 
         AND vertical != "shops"
        THEN pro_adjusted_delivery_fee_excl_tax
        WHEN is_valid_order 
         AND vertical = "shops"
        THEN delivery_fee_excl_tax
        ELSE NULL
      END
    ) AS pro_adjusted_delivery_fee_excl_tax,
    SUM(
      CASE
        WHEN is_valid_order 
         AND (created_at_utc = first_valid_order_dmart_at_utc
          OR created_at_utc = first_valid_order_shops_at_utc)
        THEN nc_df_subsidy + discount_amount + voucher_amount
        ELSE NULL
      END
    ) AS nc_subsidy,
    SUM(
      CASE
        WHEN is_valid_order 
         AND (created_at_utc = first_valid_order_dmart_at_utc
          OR created_at_utc = first_valid_order_shops_at_utc)
        THEN gmv
        ELSE NULL
      END
    ) AS nc_gmv,
    COUNT(DISTINCT
      CASE
        WHEN --is_valid_order 
         --AND 
         is_seamless_order
        THEN order_code
        ELSE NULL
      END
    ) AS seamless_orders,
    COUNT(DISTINCT
      CASE
        WHEN --is_valid_order 
         --AND 
         is_seamless_gross_base
        THEN order_code
        ELSE NULL
      END
    ) AS seamless_gross_orders_demominator,
    COUNT(DISTINCT
      CASE
        WHEN --is_valid_order 
         --AND is_refund_issued
          is_refund_issued
        THEN order_code
        ELSE NULL
      END
    ) AS orders_with_refunds,
    
  FROM baseline

  GROUP BY 
    vertical,
    vendor_code,
    vendor_name,
    city_name,
    zone_name,
    account_manager_name,
    vertical_segment,
    chain_code,
    chain_name,
    created_date_local
),

conventional_availability AS (
  SELECT
 date_local
, av.sku
,av.dmart_imt_warehouse_uuid
,av.dmart_imt_warehouse_name as warehouse_name
,ANY_VALUE(category_english) AS category
,ANY_VALUE(subcategory_english) as subcategory
, sum(available_hours) as available_hours
, sum(potential_hours) as total_hours
FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__weighted_availability_report` as av
left join `fulfillment-dwh-production.pandata_report.dmart__product_report` prd on prd.sku = av.sku and prd.dmart_imt_warehouse_uuid = av.dmart_imt_warehouse_uuid and prd.global_entity_id = "FP_PK"
WHERE date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
AND av.global_entity_id = 'FP_PK'  
group by all

),

last_day_wa AS (
  SELECT
    availability.period_day,
    availability.warehouse_id,
    warehouse_info.vendor_code,
    availability.sku,
    products.category,
    MAX(availability.sku_status) AS sku_status,
    -- Formula below from Central
    CASE
      WHEN COALESCE(MAX(availability.sales_forecast_quantity), 0.0000001) <<= 0 THEN 0.0000001
      ELSE COALESCE(MAX(availability.sales_forecast_quantity), 0.0000001) END
    AS sales_forecast_quantity,
    MAX(availability.global_day_forecast_qty) AS global_day_forecast_quantity,
    SUM(availability.available_hourly) AS available_hours,
    SUM(availability.potential_hours) AS potential_hours,
    SUM(IF(availability.available_hourly = 1, availability.hourly_events_weightage, 0)) AS avail_events_weightage,
    SUM(availability.hourly_events_weightage) AS total_events_weightage,
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.availability_data` AS availability
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = availability.warehouse_id
  LEFT JOIN products
         ON products.sku = availability.sku
        AND products.dmart_imt_warehouse_uuid = availability.warehouse_id
  WHERE availability.period_day = CURRENT_DATE() - 1
    AND global_entity_id = "FP_PK"
    -- Below is filter used by Central
    AND availability.store_open = 1
    AND ((availability.period_day >>= availability.status_implementation_date
          AND availability.sku_status IN ("ACTIVE","ON_HOLD")
          AND availability.is_stale IS FALSE)
        OR
        ((availability.period_day << availability.status_implementation_date
          OR availability.status_implementation_date IS NULL)
          AND availability.is_active
          AND availability.is_stale IS FALSE)
  )
  GROUP BY
    availability.period_day,
    availability.warehouse_id,
    vendor_code,
    availability.sku,
    products.category
),

weighted_availability AS ( -- IFNULL(SUM([available_events_weightage] * sales_forecast_quantity)/ SUM(total_events_weightage * sales_forecast_quantity), 0)
  SELECT 
    date_local,
    av.dmart_warehouse_id as dmart_imt_warehouse_uuid,
    warehouse_info.vendor_code,
    SUM(sales_forecast_quantity * avail_events_weightage) AS avail_w, 
    SUM(sales_forecast_quantity * total_events_weightage) AS total_w,
    SUM(
      CASE
        WHEN products.category IN ("Meat, Fruits and Vegetables", "Fruits & Vegetables", "Meat & Seafood")
        THEN sales_forecast_quantity * avail_events_weightage
        ELSE NULL
      END
    ) AS avail_w_ultra_fresh_catalog,
    SUM(
      CASE
        WHEN products.category IN ("Meat, Fruits and Vegetables", "Fruits & Vegetables", "Meat & Seafood")
        THEN sales_forecast_quantity * total_events_weightage
        ELSE NULL
      END
    ) AS total_w_ultra_fresh_catalog,
    
  FROM `fulfillment-dwh-production.pandata_datamart.preprocessing__dmart_inventory_weighted_availability_v2` as av
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = av.dmart_warehouse_id
  LEFT JOIN products
         ON products.sku = av.sku
        AND products.dmart_imt_warehouse_uuid = av.dmart_warehouse_id
  WHERE global_entity_id = 'FP_PK'
    AND date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND date_local << CURRENT_DATE() - 1
  GROUP BY
    date_local,
    dmart_imt_warehouse_uuid,
    vendor_code

  UNION ALL

  SELECT
    last_day_wa.period_day AS date_local,
    last_day_wa.warehouse_id AS dmart_imt_warehouse_uuid,
    last_day_wa.vendor_code,
    SUM(last_day_wa.sales_forecast_quantity * last_day_wa.avail_events_weightage) AS avail_w, 
    SUM(last_day_wa.sales_forecast_quantity * last_day_wa.total_events_weightage) AS total_w,
    SUM(
      CASE
        WHEN category IN ("Meat, Fruits and Vegetables", "Fruits & Vegetables", "Meat & Seafood")
        THEN sales_forecast_quantity * avail_events_weightage
        ELSE NULL
      END
    ) AS avail_w_ultra_fresh_catalog,
    SUM(
      CASE
        WHEN category IN ("Meat, Fruits and Vegetables", "Fruits & Vegetables", "Meat & Seafood")
        THEN sales_forecast_quantity * total_events_weightage
        ELSE NULL
      END
    ) AS total_w_ultra_fresh_catalog
  FROM last_day_wa
  GROUP BY
    date_local,
    dmart_imt_warehouse_uuid,
    vendor_code
),

sku_info_product_report AS (
  SELECT 
    sku, 
    product_title_english,
    dmart_imt_warehouse_name, 
    vendor_code,
    dmart_imt_warehouse_uuid,
    category_english,
    subcategory_english,
    principal_name_english,
    brand_name_english
  FROM `fulfillment-dwh-production.pandata_report.dmart__product_report` 
  WHERE global_entity_id = "FP_PK"
    AND is_active_catalog
    AND is_dmart
    AND NOT is_vendor_deleted
    AND NOT is_vendor_product_deleted
    AND status = "ACTIVE"
),

supplier_portal_active AS (
  SELECT
    sku,
    name,
    warehouses.warehouse_id AS dmart_imt_warehouse_uuid,
    supplier_id,
    supplier_name,
    sku_supplier_status,
    sku_supplier_warehouse_status,
    is_supplier_deleted,
    product_deleted_at,
    price_deleted_at
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.products_suppliers`
  LEFT JOIN UNNEST (suppliers) AS suppliers
  LEFT JOIN UNNEST (suppliers.warehouses) AS warehouses
  WHERE global_entity_id = "FP_PK"
    AND price_deleted_at IS NULL
),

all_data_for_availability AS (
  SELECT
    conventional_availability.date_local,
    sku_info_product_report.sku,
    product_title_english,
    COALESCE(category_english, conventional_availability.category) AS category,
    COALESCE(subcategory_english, conventional_availability.subcategory) AS subcategory,
    sku_info_product_report.dmart_imt_warehouse_name,
    sku_info_product_report.vendor_code,
    principal_name_english,
    brand_name_english,
    COALESCE(total_hours, 0) AS total_hours,
    COALESCE(available_hours, 0) AS available_hours
  FROM sku_info_product_report
  INNER JOIN supplier_portal_active
          ON supplier_portal_active.sku = sku_info_product_report.sku
         AND supplier_portal_active.dmart_imt_warehouse_uuid = sku_info_product_report.dmart_imt_warehouse_uuid
  LEFT JOIN conventional_availability
         ON conventional_availability.sku = sku_info_product_report.sku
        AND conventional_availability.dmart_imt_warehouse_uuid = sku_info_product_report.dmart_imt_warehouse_uuid  
  WHERE conventional_availability.date_local IS NOT NULL 
),

availability AS (
  SELECT
    all_data_for_availability.date_local,
    all_data_for_availability.vendor_code,
    SUM(total_hours) AS total_hours,
    SUM(available_hours) AS available_hours,
    SUM(weighted_availability.avail_w) AS avail_w,
    SUM(weighted_availability.total_w) AS total_w,
    SUM(weighted_availability.avail_w_ultra_fresh_catalog) AS avail_w_ultra_fresh_catalog,
    SUM(weighted_availability.total_w_ultra_fresh_catalog) AS total_w_ultra_fresh_catalog
  FROM all_data_for_availability
  LEFT JOIN weighted_availability
         ON weighted_availability.vendor_code = all_data_for_availability.vendor_code
        AND weighted_availability.date_local = all_data_for_availability.date_local 
  GROUP BY 
    date_local,
    vendor_code
),

sessions AS (
  SELECT 
    date_utc,
    vendor_code,
    SUM(menu_sessions) AS menu_sessions,
    SUM(list_sessions) AS list_sessions,
    SUM(atc_sessions) AS atc_sessions,
    SUM(checkout_sessions) AS checkout_sessions,
    SUM(menu_n_transaction_sessions) AS menu_n_transaction_sessions,
    SUM(list_n_menu_sessions) AS list_n_menu_sessions,
    SUM(menu_n_checkout_sessions) AS menu_n_checkout_sessions,
    SUM(menu_n_atc_sessions) AS menu_n_atc_sessions,
    SUM(atc_n_checkout_sessions) AS atc_n_checkout_sessions,
    SUM(checkout_n_transaction_sessions) AS checkout_n_transaction_sessions
  FROM `fulfillment-dwh-production.pandata_report.product__groceries_vendor_reporting_daily_unified` AS s
  WHERE s.date_utc <<= CURRENT_DATE()
    AND s.date_utc >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 7 MONTH) - 1
    AND global_entity_id = "FP_PK"
    AND platform != "Web"
  GROUP BY 
    date_utc,
    vendor_code
),

vendor_offline AS (
    SELECT 
    CASE
      WHEN vendor_info.vertical = "shops" THEN "shops"
      WHEN LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) LIKE "%franchise%" THEN "franchise"
      ELSE "dmart"
    END AS vertical,
    vendor_offline.vendor_code,
    COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name) AS vendor_name,
    COALESCE(vendor_info.sf_city, vendor_info.lg_city) AS city_name,
    COALESCE(vendor_info.sf_zone_name, vendor_info.lg_zone_name) AS zone_name,
    CASE
      WHEN vendor_info.vertical = "shops" THEN vendor_info.owner_name 
      ELSE NULL
    END AS account_manager_name,
    CASE
      WHEN vendor_info.vertical = "shops" THEN vendor_info.vertical_segment 
      WHEN LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) LIKE "%franchise%" THEN "franchise"
      ELSE "dmart"
    END AS vertical_segment,
    vendor_info.chain_code,
    vendor_info.chain_name,
    report_date,
    CASE
      WHEN EXTRACT (DAYOFWEEK FROM report_date) = 1 THEN "Sunday"
      WHEN EXTRACT (DAYOFWEEK FROM report_date) = 2 THEN "Monday"
      WHEN EXTRACT (DAYOFWEEK FROM report_date) = 3 THEN "Tuesday"
      WHEN EXTRACT (DAYOFWEEK FROM report_date) = 4 THEN "Wednesday"
      WHEN EXTRACT (DAYOFWEEK FROM report_date) = 5 THEN "Thursday"
      WHEN EXTRACT (DAYOFWEEK FROM report_date) = 6 THEN "Friday"
      ELSE "Saturday"
    END AS day,
    CASE 
      WHEN DATE_TRUNC(report_date, MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH) 
      THEN "Current Month"
      WHEN DATE_TRUNC(report_date, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH), MONTH) 
      THEN "Last Month"
      WHEN DATE_TRUNC(report_date, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH) 
        OR DATE_TRUNC(report_date, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH), MONTH) 
      THEN "Prior 2 Months"
      WHEN DATE_TRUNC(report_date, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 4 MONTH), MONTH) 
        OR DATE_TRUNC(report_date, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH) 
      THEN "Earlier 2 Months"
      ELSE "Older"
    END AS period,
    COALESCE(total_open_seconds, 0) AS total_open_seconds,
    COALESCE(total_unavailable_seconds, 0) AS total_unavailable_seconds
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__vendor_offline` AS vendor_offline
  LEFT JOIN UNNEST(availabilities) AS availabilities 
  INNER JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vendor_info
          ON vendor_info.vendor_code = vendor_offline.vendor_code
         AND vendor_info.vertical IN ("darkstores", "shops")
  LEFT JOIN warehouse_info
         ON warehouse_info.vendor_code = vendor_offline.vendor_code
  WHERE global_entity_id = "FP_PK"
    AND report_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 7 MONTH)
    AND vendor_offline.is_active
    AND COALESCE(total_open_seconds, 0) >> 0
    and not vendor_offline.is_private
  and not vendor_offline.is_test
  and not is_sf_test
  and sf_status = "Active"
  and vendor_info.vendor_code NOT IN ("wbna", "dj3c", "u922", "k6f2")
  AND (chain_code IS NULL OR chain_code != "cj6qr")
  QUALIFY ROW_NUMBER() OVER (PARTITION BY vendor_code, report_date) = 1
),

mau_penetration AS (
  SELECT
    report_date_utc,
    vendor_code,
    num_of_customers_in_vendor_delivery_area,
    num_of_ds_customers_in_delivery_area
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_qcommerce__dmart_warehouse_coverage_dashboard`
  WHERE global_entity_id = 'FP_PK'
    AND report_date_utc >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 7 MONTH) - 1
),

reorder AS (
  SELECT 
    LEFT(pd_vendor_uuid, 4) AS vendor_code,
    report_date_local,
    ac_30d_ago,
    ac_30d_ago_reorder,
    ec_30d_ago,
    ec_30d_ago_reorder,
    nc_30d_ago,
    nc_30d_ago_reorder
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__vendor_reorder_rate_report`
  WHERE global_entity_id = "FP_PK"
    AND date_type = "month"
),

aqs AS (
  SELECT 
    warehouse_info.vendor_code,
    date_month,
    final_score AS store_aqs_store
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.assortment_quality_scorecard_v5_mtd` AS aqs
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = aqs.warehouse_id
  WHERE global_entity_id = "FP_PK"
    AND granularity = "Warehouse"
),

picker_utr AS (
  SELECT
    warehouse_info.vendor_code,
    date_local,
    SUM(total_picked_quantity_valid_order) AS picked_units,
    SUM(total_shift_hrs) AS shopper_manhours
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__shopper_utr_dashboard` AS utr
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = utr.warehouse_id
  WHERE global_entity_id = "FP_PK"
  GROUP BY
    vendor_code,
    date_local
),

skus_on_discount AS (
  SELECT 
    order_date_local AS date_local,
    vendor_code,
    COUNT(DISTINCT sku) AS unique_skus_ordered,
    COUNT(DISTINCT 
      CASE
        WHEN unit_discount_amount_local >> 0 THEN sku
        ELSE NULL
      END
    ) AS unique_skus_on_discount   
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__customer_order_line_report_v2` AS customer_order_line_report
  WHERE customer_order_line_report.order_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND customer_order_line_report.global_entity_id = "FP_PK"
    AND is_successful
  GROUP BY 
    date_local,
    vendor_code

  UNION ALL

  SELECT
    created_date_local AS date_local,
    vendor_code,
    COUNT(DISTINCT remote_code) AS unique_skus_ordered,
    COUNT(DISTINCT 
      CASE
        WHEN unit_discount_local >> 0 THEN remote_code
        ELSE NULL
      END
    ) AS unique_skus_on_discount   
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_shops__order_product_report` AS customer_order_line_report
  WHERE customer_order_line_report.created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND customer_order_line_report.global_entity_id = "FP_PK"
    AND is_valid_order
  GROUP BY 
    date_local,
    vendor_code
),

shops_active_skus AS (
  SELECT
    products.vendor_code,
    COUNT(DISTINCT products.uuid) AS shops_active_skus_latest,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_qcommerce__dmart_products` AS products
  WHERE global_entity_id = "FP_PK"
    AND NOT is_vendor_product_deleted
    AND is_valid_vendor_sku
    AND is_active
  GROUP BY
    vendor_code
),

skus_counted AS (
  SELECT 
    cycle_count.cycle_count_completed_at_date AS date_local,
    cycle_count.warehouse_id,
    warehouse_info.vendor_code,
    cycle_count.inventory_result,
    COUNT(cycle_count.sku) AS non_zero_skus
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.cycle_count_details` AS cycle_count
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = cycle_count.warehouse_id
  WHERE global_entity_id = "FP_PK"
    AND cycle_count_completed_at_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND cycle_count_status = "COMPLETE"
    AND on_hand_qty != 0
  GROUP BY
    date_local,
    warehouse_id,
    vendor_code,
    inventory_result
),

sku_defect_rate AS (
  SELECT
    date_local,
    vendor_code,
    SUM(non_zero_skus) AS non_zero_skus_counted,
    SUM(
      CASE
        WHEN inventory_result != "match" THEN non_zero_skus
        ELSE 0
      END
    ) AS non_zero_skus_on_defect
  FROM skus_counted
  GROUP BY
    date_local,
    vendor_code
),

unique_skus_counted AS (
  SELECT 
    DATE_TRUNC(cycle_count_completed_at_date, MONTH) AS month_local,
    warehouse_id,
    vendor_code,
    COUNT(DISTINCT sku) AS distinct_skus_counted_month
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.cycle_count_details` AS cycle_count
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = cycle_count.warehouse_id
  WHERE global_entity_id = "FP_PK"
    AND cycle_count_completed_at_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND cycle_count_status = "COMPLETE"
    AND on_hand_qty != 0
  GROUP BY
    month_local,
    warehouse_id,
    vendor_code
),

month_end_inventory AS (
  SELECT
    date_local,
    DATE_TRUNC(date_local, MONTH) AS month_local,
    inventory_value_report.dmart_imt_warehouse_uuid,
    vendor_code,
    COUNT(DISTINCT inventory_value_report.sku) AS distinct_skus_on_hand_month_end
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__inventory_value_report` AS inventory_value_report
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = inventory_value_report.dmart_imt_warehouse_uuid
  WHERE inventory_value_report.date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND inventory_value_report.global_entity_id = "FP_PK"
    AND inventory_value_report.end_stock >> 0
  GROUP BY
    date_local,
    dmart_imt_warehouse_uuid,
    vendor_code
  QUALIFY ROW_NUMBER() OVER (PARTITION BY month_local, dmart_imt_warehouse_uuid ORDER BY date_local DESC) = 1 
),

seamless_fulfillment AS (
  SELECT 
    ordered_date_local AS date_local,
    vendor_code,
    COUNT(DISTINCT IF(pd_order_code <<>> "BASELINE", pd_order_code, NULL)) AS sfr_orders,
    SUM(total_valid_order) AS total_valid_orders_sfr
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__sfr_summary_dashboard` AS sfr_dashboard
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = sfr_dashboard.warehouse_id
  WHERE global_entity_id = "FP_PK"
  GROUP BY
    date_local,
    vendor_code
)

SELECT
  COALESCE(all_order_level_info.vertical, vendor_offline.vertical) AS vertical,
  COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code) AS vendor_code,
  COALESCE(all_order_level_info.vendor_name, vendor_offline.vendor_name) AS vendor_name,
  COALESCE(all_order_level_info.city_name, vendor_offline.city_name) AS city_name,
  COALESCE(all_order_level_info.zone_name, vendor_offline.zone_name) AS zone_name,
  COALESCE(all_order_level_info.account_manager_name, vendor_offline.account_manager_name) AS account_manager_name,
  COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) AS vertical_segment,
  COALESCE(all_order_level_info.chain_code, vendor_offline.chain_code) AS chain_code,
  COALESCE(all_order_level_info.chain_name, vendor_offline.chain_name) AS chain_name,
  COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date) AS created_date_local,
  COALESCE(all_order_level_info.day, vendor_offline.day) AS day,
  COALESCE(all_order_level_info.period, vendor_offline.period) AS period,
  all_order_level_info.* EXCEPT (
    vertical,
    vendor_code,
    vendor_name,
    city_name,
    zone_name,
    account_manager_name,
    vertical_segment,
    chain_code,
    chain_name,
    created_date_local,
    day,
    period
  ),
  availability.available_hours,
  availability.total_hours,
  availability.avail_w,
  availability.total_w,
  availability.avail_w_ultra_fresh_catalog,
  availability.total_w_ultra_fresh_catalog,
  sessions.menu_sessions,
  sessions.list_sessions,
  sessions.atc_sessions,
  sessions.checkout_sessions,
  sessions.menu_n_transaction_sessions,
  sessions.list_n_menu_sessions,
  sessions.menu_n_checkout_sessions,
  sessions.menu_n_atc_sessions,
  sessions.atc_n_checkout_sessions,
  sessions.checkout_n_transaction_sessions,
  vendor_offline.total_open_seconds,
  vendor_offline.total_unavailable_seconds,
  mau_penetration.num_of_ds_customers_in_delivery_area,
  mau_penetration.num_of_customers_in_vendor_delivery_area,
  reorder.ac_30d_ago,
  reorder.ac_30d_ago_reorder,
  reorder.ec_30d_ago,
  reorder.ec_30d_ago_reorder,
  reorder.nc_30d_ago,
  reorder.nc_30d_ago_reorder,
  aqs.store_aqs_store,
  picker_utr.picked_units,
  picker_utr.shopper_manhours,
  skus_on_discount.unique_skus_ordered,
  skus_on_discount.unique_skus_on_discount,
  CASE
    WHEN COALESCE(all_order_level_info.vertical, vendor_offline.vertical) = "shops"
    THEN shops_active_skus.shops_active_skus_latest
    ELSE NULL
  END AS shops_active_skus_latest,
  CASE
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "supermarket"
    THEN 7500
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "mini_market"
    THEN 3500
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "convenience"
    THEN 1800
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "health_and_wellness"
    THEN 2500
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) IN ("tobacco", "Electronics")
    THEN 250
    ELSE NULL
  END AS target_skus,
  CASE
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "supermarket"
    THEN IF(shops_active_skus.shops_active_skus_latest >>= 7500, 1, 0)
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "mini_market"
    THEN IF(shops_active_skus.shops_active_skus_latest >>= 3500, 1, 0)
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "convenience"
    THEN IF(shops_active_skus.shops_active_skus_latest >>= 1800, 1, 0)
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "health_and_wellness"
    THEN IF(shops_active_skus.shops_active_skus_latest >>= 2500, 1, 0)
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) IN ("tobacco", "Electronics")
    THEN IF(shops_active_skus.shops_active_skus_latest >>= 250, 1, 0)
    ELSE NULL
  END AS vendors_meeting_sku_criteria,
  CASE
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) IN (
      "tobacco", "Electronics", "health_and_wellness", "convenience", "mini_market", "supermarket"
    ) THEN 1
    ELSE NULL
  END AS sku_target_vendors,
  sku_defect_rate.non_zero_skus_counted,
  sku_defect_rate.non_zero_skus_on_defect,
  unique_skus_counted.distinct_skus_counted_month,
  month_end_inventory.distinct_skus_on_hand_month_end,
  seamless_fulfillment.sfr_orders,
  seamless_fulfillment.total_valid_orders_sfr
FROM all_order_level_info
FULL OUTER JOIN vendor_offline
             ON vendor_offline.vendor_code = all_order_level_info.vendor_code
            AND vendor_offline.report_date = all_order_level_info.created_date_local
LEFT JOIN availability
       ON availability.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND availability.date_local = COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date)
LEFT JOIN sessions
       ON sessions.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND sessions.date_utc = COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date)
LEFT JOIN mau_penetration
       ON mau_penetration.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND mau_penetration.report_date_utc = COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date)
LEFT JOIN reorder
       ON reorder.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND reorder.report_date_local = COALESCE(DATE_TRUNC(all_order_level_info.created_date_local, MONTH), DATE_TRUNC(vendor_offline.report_date, MONTH))
LEFT JOIN aqs
       ON aqs.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND aqs.date_month = COALESCE(DATE_TRUNC(all_order_level_info.created_date_local, MONTH), DATE_TRUNC(vendor_offline.report_date, MONTH))
LEFT JOIN picker_utr
       ON picker_utr.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND picker_utr.date_local = COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date)
LEFT JOIN skus_on_discount
       ON skus_on_discount.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND skus_on_discount.date_local = COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date)
LEFT JOIN shops_active_skus
       ON shops_active_skus.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
LEFT JOIN sku_defect_rate
       ON sku_defect_rate.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND sku_defect_rate.date_local = COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date)
LEFT JOIN unique_skus_counted
       ON unique_skus_counted.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND unique_skus_counted.month_local = COALESCE(DATE_TRUNC(all_order_level_info.created_date_local, MONTH), DATE_TRUNC(vendor_offline.report_date, MONTH))
LEFT JOIN month_end_inventory
       ON month_end_inventory.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND month_end_inventory.month_local = COALESCE(DATE_TRUNC(all_order_level_info.created_date_local, MONTH), DATE_TRUNC(vendor_offline.report_date, MONTH))
LEFT JOIN seamless_fulfillment
       ON seamless_fulfillment.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND seamless_fulfillment.date_local = COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1h91iwd028z35x1gwv6h701n2ro2' name='Custom SQL Query' type='text'><![CDATA[WITH warehouse_info AS (
  SELECT
    dmart_warehouses.warehouse_id AS dmart_imt_warehouse_uuid,
    vendors.platform_vendor_id AS vendor_code,
    dmart_warehouses.name AS dmart_imt_warehouse_name,
    RIGHT(dmart_warehouses.name, 5) AS cityedit
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.warehouses_v2` AS dmart_warehouses
  LEFT JOIN UNNEST(vendors) AS vendors
  WHERE dmart_warehouses.global_entity_id = "FP_PK"
    AND dmart_warehouses.warehouse_id IS NOT NULL
),
catalog AS (
  SELECT DISTINCT
    catalog.vendor_code,
    catalog.sku,
    catalog.dmart_catalog_global_product_id as global_id,
    catalog.master_code,
    catalog.barcodes,
    catalog.master_product_name_english,
    COALESCE(pim.pim_category_one, catalog.master_category_names.level_one) AS master_category_level_one,
      COALESCE(pim.pim_category_two, catalog.master_category_names.level_two) AS master_category_level_two,
    catalog.is_active,
    catalog.is_vendor_deleted OR catalog.is_vendor_product_deleted AS is_deleted,
    catalog.is_valid_vendor_sku,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_qcommerce__dmart_products` AS catalog
  LEFT JOIN `fulfillment-dwh-production.pandata_datamart.preprocessing__qcomm_pim_products` AS pim
         ON catalog.master_code = pim.pim_product_id
  WHERE
  global_entity_id = 'FP_PK'
  AND catalog.dmart_catalog_global_product_id IS NOT NULL
),

vouchers AS (
  SELECT
    order_code,
    channel,
    purpose,
    description,
    attributions_foodpanda_ratio,
    attributions_vendor_ratio,
    attributions_thirdparty_ratio,
    value_local AS voucher_amount,
    value_local * (attributions_foodpanda_ratio / 100) AS voucher_amount_foodpanda
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` AS vouchers
  WHERE global_entity_id = "FP_PK"
),

--blacklisted_customers AS (
--  SELECT
--    customer_code,
--    is_black,
--    type,
--    remarks
--  FROM `dhh---analytics-apac.pandata_pk.cx_fraud_customers`
--  QUALIFY ROW_NUMBER() OVER(PARTITION BY customer_code ORDER BY date DESC) = 1
--),
--
incidents AS (
  SELECT 
    order_id,
    COUNT(DISTINCT contact_id) AS number_of_issues,
    COUNT(DISTINCT 
      CASE 
        WHEN contact_reason_l2 IN ("Food Issue", "Item Issue") THEN contact_id
        ELSE NULL
      END
    ) AS number_of_food_quality_issues,
    COUNT(DISTINCT 
      CASE 
        WHEN contact_reason_l2 IN ("Food Issue", "Item Issue") THEN contact_id
        ELSE NULL
      END
    ) >> 0 is_food_quality_incident_order,
    COUNT(DISTINCT 
      CASE 
        WHEN contact_reason_l2 IN ("Wrong / Missing item", "Wrong order / Never arrived") THEN contact_id
        ELSE NULL
      END
    ) AS number_of_wrong_missing_issues,
    COUNT(DISTINCT 
      CASE 
        WHEN contact_reason_l2 IN ("Wrong / Missing item", "Wrong order / Never arrived") THEN contact_id
        ELSE NULL
      END
    ) >> 0 AS is_wrong_missing_incident_order,
    COUNT(DISTINCT contact_reason_l2) AS number_of_ccr2s
  FROM `fulfillment-dwh-production.curated_data_shared.all_contacts` 
  WHERE created_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH) - 1
    AND global_entity_id = "FP_PK"
    AND contact_reason_l1 IN ("Post-Delivery")
    AND contact_reason_l3 NOT IN (
      'Order not delivered to doorstep', 'Incorrect invoice', 'Delivery instructions not followed', 'Fraud', 'Money collection issue', 'Order never arrived', 'Refund query',
      'Delayed delivery', 'Wallet refund query', 'Refund request', 'Inappropriate behaviour', 'Other issues related to contactless delivery', 'Invoice missing',
      'Moderate delay', 'Missing equipment/uniform', 'Rider tips refund issue', 'Double charge', 'Issue with item replacement process', 'Cooking instructions were not followed'
    )
    GROUP BY
      order_id
),

products AS (
  SELECT
    dmart__product_report.sku,
    dmart__product_report.dmart_imt_warehouse_uuid,
    dmart__product_report.dmart_imt_warehouse_name,
    dmart__product_report.product_title_english AS product_name,
    dmart__product_report.category_english AS category,
    dmart__product_report.subcategory_english AS subcategory,
    dmart__product_report.master_category_names.level_one AS category_level_one,
    dmart__product_report.status,
    vat_rate_percent
  FROM `fulfillment-dwh-production.pandata_report.dmart__product_report` AS dmart__product_report
  WHERE dmart__product_report.global_entity_id = "FP_PK"
  QUALIFY ROW_NUMBER() OVER (PARTITION BY sku, dmart_imt_warehouse_uuid) = 1
),

dmart_partial_orders AS (
  SELECT 
    customer_orders.order_id AS pd_order_code,
    SUM(items.quantity_ordered) AS ordered_quantity,
    SUM(
      CASE 
        WHEN customer_orders.is_successful THEN items.quantity_delivered 
        ELSE 0 
      END
    ) AS delivered_quantity,
    CASE
      WHEN SUM(
        CASE 
          WHEN customer_orders.is_successful THEN items.quantity_delivered 
          ELSE 0 
        END) << SUM(items.quantity_ordered) 
      AND customer_orders.is_successful 
      THEN TRUE
      ELSE FALSE
    END AS is_partially_fulfilled_order
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.qc_orders`  AS customer_orders
  LEFT JOIN UNNEST(customer_orders.items) AS items
  WHERE global_entity_id = "FP_PK"
    AND DATE(customer_orders.order_created_date_lt) >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND customer_orders.is_dmart
  GROUP BY
    customer_orders.order_id,
    customer_orders.is_successful
),

weighted_average_cost AS (
  SELECT 
    global_entity_id, 
    country_code, 
    sku, 
    warehouse_id, 
    wac, 
    valid_from, 
    valid_to, 
    adjustment_reason, 
    cogs_adjustment 
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.wac_info`
  WHERE global_entity_id = "FP_PK"
),

dmart_orders AS (
  SELECT 
    customer_order_line_report.order_code AS pd_order_code,
    dmart_partial_orders.is_partially_fulfilled_order,
    SUM(dmart_partial_orders.ordered_quantity) AS ordered_quantity,
    SUM(dmart_partial_orders.delivered_quantity) AS delivered_quantity,
    COUNT(DISTINCT customer_order_line_report.sku) AS skus_in_order,
    SUM(received_quantity) AS units_sold,
    SUM(received_quantity * unit_discount_amount_local) AS discount_amount,
    SUM(received_quantity * unit_price_paid_local) AS gfv_with_vat,
    SUM(
      CASE
        WHEN products.category_level_one IN ("Meat / Seafood", "Produce", "Ready To Consume")
        THEN received_quantity * unit_price_paid_local
        ELSE NULL
      END
    ) AS ultra_fresh_gfv_with_vat,
    SUM(
      CASE
        WHEN products.category IN ("Meat, Fruits and Vegetables", "Fruits & Vegetables", "Meat & Seafood")
        THEN received_quantity * unit_price_paid_local
        ELSE NULL
      END
    ) AS ultra_fresh_actual_gfv_with_vat,
    Count( distinct
      CASE
        WHEN products.category_level_one IN ("Meat / Seafood", "Produce", "Ready To Consume")
        THEN order_code
        ELSE NULL
      END
    ) AS ultra_fresh_orders_dmart,
    Count( distinct
      CASE
        WHEN products.category IN ("Meat, Fruits and Vegetables", "Fruits & Vegetables", "Meat & Seafood")
        THEN order_code
        ELSE NULL
      END
    ) AS ultra_fresh_actual_orders_dmart,
    SUM((received_quantity * unit_price_paid_local) / (1 + COALESCE(customer_order_line_report.vat_rate_percent, products.vat_rate_percent))) AS gfv_without_vat,
    SUM(received_quantity * COALESCE(weighted_average_cost.wac, wac_local)) AS cogs,
    SUM((received_quantity * unit_price_paid_local) / (1 + COALESCE(customer_order_line_report.vat_rate_percent, products.vat_rate_percent)) - (received_quantity * COALESCE(weighted_average_cost.wac, wac_local))) AS margin_amount
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__customer_order_line_report_v2` AS customer_order_line_report
  LEFT JOIN products
         ON products.sku = customer_order_line_report.sku
        AND products.dmart_imt_warehouse_uuid = customer_order_line_report.dmart_imt_warehouse_uuid
  LEFT JOIN dmart_partial_orders
         ON dmart_partial_orders.pd_order_code = customer_order_line_report.order_code
  LEFT JOIN weighted_average_cost
         ON weighted_average_cost.sku = customer_order_line_report.sku
        AND weighted_average_cost.warehouse_id = customer_order_line_report.dmart_imt_warehouse_uuid
        AND TIMESTAMP(customer_order_line_report.order_at_utc) BETWEEN weighted_average_cost.valid_from AND weighted_average_cost.valid_to
  WHERE customer_order_line_report.order_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND customer_order_line_report.global_entity_id = "FP_PK"
  GROUP BY
    pd_order_code,
    is_partially_fulfilled_order
),

shops_orders AS (
  SELECT 
    order_code AS pd_order_code,
    LOGICAL_OR(customer_order_line_report.is_item_not_fully_fulfilled) AS is_partially_fulfilled_order,
    SUM(pre_replacement_ordered_quantity) AS ordered_quantity,
    SUM(delivered_quantity) AS delivered_quantity,
    COUNT(DISTINCT catalog_global_product_id) AS skus_in_order,
    SUM(delivered_quantity) AS units_sold,
    SUM(delivered_quantity * (original_unit_price_local - discounted_unit_price_local)) AS discount_amount,
     Count( distinct
      CASE
        WHEN catalog.master_category_level_one IN ("Meat / Seafood", "Produce", "Ready To Consume")
        THEN order_code
        ELSE NULL
      END
    ) AS ultra_fresh_orders_shops,
     Count( distinct
      CASE
        WHEN catalog.master_category_level_one IN  ("Meat, Fruits and Vegetables", "Fruits & Vegetables", "Meat & Seafood")
        THEN order_code
        ELSE NULL
      END
    ) AS ultra_fresh_actual_orders_shops
   
  FROM  `fulfillment-dwh-production.pandata_datamart.pandora__order_products_shops_details` AS customer_order_line_report
  
  -- LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vendor_info
  --        ON vendor_info.vendor_code = customer_order_line_report.vendor_code
  left join catalog on catalog.global_id = customer_order_line_report.catalog_global_product_id
  WHERE customer_order_line_report.order_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND customer_order_line_report.global_entity_id = "FP_PK"
  GROUP BY
    pd_order_code
),

vendors AS (
  SELECT
    vendor_info.vendor_code,
    vendor_info.vendor_name,
    pv.cities.title city_name,
    vendor_info.sf_zone_name
  FROM `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` vendor_info
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.vdr_svc_vendors` pv
         ON vendor_info.vendor_code = pv.vendor_code
        AND pv.global_entity_id = "FP_PK"
),

sf_grid AS (
  SELECT
    vendors.vendor_code,
    CASE
      WHEN 
        COALESCE(restaurant_addresses.administrative_area_name, billing_addresses.administrative_area_name) = 'Punjab' 
        THEN 0.16
      WHEN 
        COALESCE(restaurant_addresses.administrative_area_name, billing_addresses.administrative_area_name) = 'Sindh' 
        THEN 0.13
      WHEN 
        COALESCE(restaurant_addresses.administrative_area_name, billing_addresses.administrative_area_name) = 'Balochistan' 
        THEN 0.15
      WHEN 
        COALESCE(restaurant_addresses.administrative_area_name, billing_addresses.administrative_area_name) = 'Islamabad' 
        THEN 0.16
      WHEN 
        COALESCE(restaurant_addresses.administrative_area_name, billing_addresses.administrative_area_name) = 'KPK' 
        THEN 0.02
      WHEN 
        COALESCE(restaurant_addresses.administrative_area_name, billing_addresses.administrative_area_name) = 'AJK' 
        THEN 0.16
    END AS tax_df_sf,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_sales_sf_accounts` AS sf_accounts
  LEFT JOIN UNNEST(addresses) AS restaurant_addresses
         ON restaurant_addresses.is_deleted = FALSE
        AND restaurant_addresses.address_type LIKE "%Restaurant Address%"
  LEFT JOIN UNNEST(addresses) AS billing_addresses
         ON billing_addresses.is_deleted = FALSE
        AND billing_addresses.address_type LIKE "%Billing Address%"
  LEFT JOIN vendors 
         ON vendors.vendor_code = sf_accounts.vendor_code
  WHERE global_entity_id = "FP_PK"
    AND vendors.vendor_code IS NOT NULL
),

comp_and_refunds AS (
  SELECT
    order_id,
    TRUE AS is_refund_issued
  FROM `fulfillment-dwh-production.curated_data_shared.comp_and_refund_events`
  WHERE global_entity_id = "FP_PK"
    AND created_date_localtime >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
  QUALIFY ROW_NUMBER() OVER (PARTITION BY order_id) = 1
),

baseline AS (
  SELECT
    CASE
      WHEN vendor_info.vertical = "shops" THEN "shops"
      WHEN LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) LIKE "%franchise%" THEN "franchise"
      ELSE "dmart"
    END AS vertical,
    pd_orders.vendor_code,
    sf_grid.tax_df_sf,
    COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name) AS vendor_name,
    COALESCE(vendor_info.sf_city, vendor_info.lg_city) AS city_name,
    COALESCE(vendor_info.sf_zone_name, vendor_info.lg_zone_name) AS zone_name,
    CASE
      WHEN vendor_info.vertical = "shops" THEN vendor_info.owner_name 
      ELSE NULL
    END AS account_manager_name,
    CASE
      WHEN vendor_info.vertical = "shops" THEN vendor_info.vertical_segment 
      WHEN LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) LIKE "%franchise%" THEN "franchise"
      ELSE "dmart"
    END AS vertical_segment,
    vendor_info.chain_code,
    vendor_info.chain_name,
    pd_orders.created_date_local,
    pd_orders.created_at_utc,
    customer_agg.first_valid_order_dmart_at_utc,
    customer_agg.first_valid_order_shops_at_utc,
    customer_agg.first_valid_order_all_at_utc,
    acid_order_dates.first_valid_order_dmart_at_utc AS first_valid_order_dmart_at_utc_acid,
    acid_order_dates.first_valid_order_shops_at_utc AS first_valid_order_shops_at_utc_acid,
    pd_orders.pd_customer_uuid,
    COALESCE(id_mapping.analytical_customer_id, pd_orders.pd_customer_uuid) AS analytical_customer_id,
    pd_orders.order_code,
    pd_orders.is_successful as is_valid_order,
    pd_orders.is_failed_order,
    pd_orders.is_cancelled_by_vendor,
    pd_orders.is_cancelled_by_customer,
    pd_orders.is_cancelled_by_logistics,
    COALESCE(dmart_orders.is_partially_fulfilled_order, shops_orders.is_partially_fulfilled_order) AS is_partially_fulfilled_order,
    COALESCE(dmart_orders.ordered_quantity, shops_orders.ordered_quantity) AS ordered_quantity,
    COALESCE(dmart_orders.delivered_quantity, shops_orders.delivered_quantity) AS delivered_quantity,
   -- pd_orders.preparation_time_in_minutes,
    pd_orders.actual_delivery_time_in_minutes,
    pd_orders.gfv_local AS gfv,
    dmart_orders.gfv_with_vat,
    dmart_orders.ultra_fresh_gfv_with_vat,
    dmart_orders.ultra_fresh_actual_gfv_with_vat,
    dmart_orders.ultra_fresh_orders_dmart,
    shops_orders.ultra_fresh_orders_shops,
    dmart_orders.ultra_fresh_actual_orders_dmart,
    shops_orders.ultra_fresh_actual_orders_shops,
    dmart_orders.gfv_without_vat,
    dmart_orders.cogs,
    dmart_orders.margin_amount,
    pd_orders.user_paid_gmv_local AS gmv,
    COALESCE(dmart_orders.units_sold, shops_orders.units_sold) AS units_sold,
    COALESCE(dmart_orders.skus_in_order, shops_orders.skus_in_order) AS skus_in_order,
    COALESCE(dmart_orders.discount_amount, shops_orders.discount_amount) AS discount_amount,
    incidents.order_id IS NOT NULL AS is_incident_order,
    incidents.is_food_quality_incident_order,
    incidents.is_wrong_missing_incident_order,
    incidents.number_of_food_quality_issues,
    incidents.number_of_wrong_missing_issues,
    incidents.number_of_issues,
    incidents.number_of_ccr2s,
    vouchers.channel,
    vouchers.purpose,
    COALESCE(vouchers.voucher_amount) AS voucher_amount,
    COALESCE(vouchers.voucher_amount_foodpanda) AS voucher_amount_foodpanda,
    cashback_order_level.commission_base,
    cashback_order_level.commission_revenue,
    pd_orders.pandora_decline_reason_title AS decline_reason,
    pd_orders.payment_method AS payment_method,
    pd_orders.df_user_paid_incl_vat_local,
    pd_orders.df_user_paid_incl_vat_local / (1 + sf_grid.tax_df_sf) AS delivery_fee_excl_tax,
    subsidy_metrics_order_level.service_fee_local,
    subsidy_metrics_order_level.service_fee_local / (1 + sf_grid.tax_df_sf) AS service_fee_excl_tax,
    pd_orders.container_charges_local AS packaging_fee_local,
    pd_orders.container_charges_local / (1 + sf_grid.tax_df_sf) AS packaging_fee_excl_tax,
    subsidy_metrics_order_level.is_free_delivery_subscription_order,
    
    CASE
      WHEN subsidy_metrics_order_level.is_free_delivery_subscription_order
       AND EXTRACT(HOUR FROM pd_orders.created_at_local) IN (0, 1, 2, 3, 4, 5, 6)
      THEN 169
      WHEN subsidy_metrics_order_level.is_free_delivery_subscription_order
       AND EXTRACT(HOUR FROM pd_orders.created_at_local) NOT IN (0, 1, 2, 3, 4, 5, 6)
      THEN 159
      ELSE pd_orders.df_user_paid_incl_vat_local
    END AS pro_adjusted_delivery_fee_incl_tax,
    CASE
      WHEN subsidy_metrics_order_level.is_free_delivery_subscription_order
       AND EXTRACT(HOUR FROM pd_orders.created_at_local) IN (0, 1, 2, 3, 4, 5, 6)
      THEN 169
      WHEN subsidy_metrics_order_level.is_free_delivery_subscription_order
       AND EXTRACT(HOUR FROM pd_orders.created_at_local) NOT IN (0, 1, 2, 3, 4, 5, 6)
      THEN 159
      ELSE pd_orders.df_user_paid_incl_vat_local
    END / (1 + sf_grid.tax_df_sf) AS pro_adjusted_delivery_fee_excl_tax,
    CASE
      WHEN (pd_orders.created_at_utc = customer_agg.first_valid_order_dmart_at_utc
        OR pd_orders.created_at_utc = customer_agg.first_valid_order_shops_at_utc)
       AND pd_orders.df_user_paid_incl_vat_local = 0
       AND EXTRACT(HOUR FROM pd_orders.created_at_local) IN (0, 1, 2, 3, 4, 5, 6)
      THEN 169
      WHEN (pd_orders.created_at_utc = customer_agg.first_valid_order_dmart_at_utc
        OR pd_orders.created_at_utc = customer_agg.first_valid_order_shops_at_utc)
       AND pd_orders.df_user_paid_incl_vat_local = 0
       AND EXTRACT(HOUR FROM pd_orders.created_at_local) NOT IN (0, 1, 2, 3, 4, 5, 6)
      THEN 159
      ELSE 0
    END AS nc_df_subsidy,

    operational_metrics.actual_delivery_time_in_seconds,
    DATETIME_DIFF(pelican_event.shopper_recevied_local, pd_orders.created_at_local, SECOND) AS shopper_delay_time_in_sec,
    DATETIME_DIFF(pelican_event.pelican_available_local, pelican_event.shopper_recevied_local, SECOND) AS pelican_delay_time_in_sec,
    DATETIME_DIFF(pelican_event.started_local, pelican_event.pelican_available_local, SECOND) AS assignment_time_in_sec,
    DATETIME_DIFF(pelican_event.last_cart_local, pelican_event.started_local, SECOND) AS pick_time_in_sec,
    DATETIME_DIFF(pelican_event.ready_pickup_local, pelican_event.last_cart_local, SECOND) AS pack_time_in_sec,
    DATETIME_DIFF(pelican_event.ready_pickup_local, pelican_event.started_local, SECOND) AS pick_pack_time_in_sec,
    DATETIME_DIFF(pelican_event.pickup_local, pelican_event.ready_pickup_local, SECOND) AS rider_dispatch_time_in_sec,
    DATETIME_DIFF(pelican_event.ready_pickup_local, pelican_event.shopper_recevied_local, SECOND) AS vendor_prep_time_in_sec,
    -- DATETIME_DIFF(picked_up, pelican_event.ready_pickup_local, SECOND) AS waiting_for_rider_time_in_sec, --get picked_up timestamp from lg_orders
    -- DATETIME_DIFF(pd_orders.updated_at_local, pelican_event.picked_up, SECOND) AS rider_drive_time_in_sec,

    seamless_orders.is_seamless_order,
    seamless_orders.is_gross_order AS is_seamless_gross_base,
    COALESCE(comp_and_refunds.is_refund_issued, FALSE) AS is_refund_issued,

   -- CASE 
   --   WHEN blacklisted_customers.is_black IS NULL THEN "Green"
   --   WHEN blacklisted_customers.is_black THEN "Black"
   --   ELSE "Grey"
   -- END AS customer_local_fraud_flag,

  FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders` AS pd_orders
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vendor_info
         ON vendor_info.vendor_code = pd_orders.vendor_code
  LEFT JOIN warehouse_info
         ON warehouse_info.vendor_code = pd_orders.vendor_code
  LEFT JOIN vouchers
         ON vouchers.order_code = pd_orders.order_code
  LEFT JOIN incidents
         ON incidents.order_id = pd_orders.order_code
  LEFT JOIN dmart_orders
         ON dmart_orders.pd_order_code = pd_orders.order_code
  LEFT JOIN shops_orders
         ON shops_orders.pd_order_code = pd_orders.order_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_finance_cashback_order_level` AS cashback_order_level
         ON cashback_order_level.order_code = pd_orders.order_code
        AND cashback_order_level.date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH) - 1
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_customers_agg_order_dates` AS customer_agg
        --  ON pd_orders.pd_vendor_uuid = customer_agg.pd_vendor_uuid
         ON pd_orders.pd_customer_uuid = customer_agg.uuid
        AND customer_agg.global_entity_id = "FP_PK"
        -- AND customer_agg.vendor_type IN ("pandamart", "shops")
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_qcommerce__operational_metrics_order_level` AS operational_metrics
         ON operational_metrics.code = pd_orders.order_code
        AND operational_metrics.global_entity_id = "FP_PK"
        AND operational_metrics.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH) - 1
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_dmart__ops_order_pelican_event_timing` AS pelican_event
         ON pelican_event.pd_order_code = pd_orders.order_code
        AND pelican_event.global_entity_id = "FP_PK"
  LEFT JOIN sf_grid
         ON sf_grid.vendor_code = pd_orders.vendor_code
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_qcommerce__subsidy_metrics_order_level` AS subsidy_metrics_order_level
         ON subsidy_metrics_order_level.order_code = pd_orders.order_code
        AND subsidy_metrics_order_level.global_entity_id = "FP_PK"
        AND subsidy_metrics_order_level.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH) - 1
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_cx_seamless_order` AS seamless_orders
         ON seamless_orders.order_code = pd_orders.order_code
        AND seamless_orders.ordered_at_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
        AND seamless_orders.global_entity_id = "FP_PK"
  LEFT JOIN comp_and_refunds
         ON comp_and_refunds.order_id = pd_orders.order_code
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_mkt.braze_external_id_map` AS id_mapping
         ON CONCAT(REGEXP_EXTRACT(id_mapping.external_id, r"[0-9]+"), "_FP_", REGEXP_EXTRACT(id_mapping.external_id, r"^..")) = pd_orders.pd_customer_uuid
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_customers_agg_order_dates_acid` AS acid_order_dates
         ON acid_order_dates.analytical_customer_id = COALESCE(id_mapping.analytical_customer_id, pd_orders.pd_customer_uuid)
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.cus_customers` AS customers
         ON customers.uuid = pd_orders.pd_customer_uuid
        AND customers.global_entity_id = "FP_PK"
 -- LEFT JOIN blacklisted_customers
 --        ON blacklisted_customers.customer_code = customers.code

  WHERE pd_orders.created_date_utc >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH) - 1
    AND pd_orders.created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND pd_orders.global_entity_id = "FP_PK"
    AND vendor_info.vertical IN ("darkstores", "shops")
    AND pd_orders.vendor_code NOT IN ("tqip")
    AND LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) NOT LIKE "%business%"
    AND LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) NOT LIKE "%corporate%"
    AND LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) NOT LIKE "%pantry%"
    AND LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) NOT LIKE "%odr%"
    AND LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) NOT LIKE "%export%"
    AND pd_orders.is_gross_order
    AND NOT vendor_info.is_sf_test
),

all_order_level_info AS (
  SELECT
    vertical,
    vendor_code,
    vendor_name,
    city_name,
    zone_name,
    account_manager_name,
    vertical_segment,
    chain_code,
    chain_name,
    created_date_local,
    CASE
      WHEN EXTRACT (DAYOFWEEK FROM created_date_local) = 1 THEN "Sunday"
      WHEN EXTRACT (DAYOFWEEK FROM created_date_local) = 2 THEN "Monday"
      WHEN EXTRACT (DAYOFWEEK FROM created_date_local) = 3 THEN "Tuesday"
      WHEN EXTRACT (DAYOFWEEK FROM created_date_local) = 4 THEN "Wednesday"
      WHEN EXTRACT (DAYOFWEEK FROM created_date_local) = 5 THEN "Thursday"
      WHEN EXTRACT (DAYOFWEEK FROM created_date_local) = 6 THEN "Friday"
      ELSE "Saturday"
    END AS day,
    CASE 
      WHEN DATE_TRUNC(created_date_local, MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH) 
      THEN "Current Month"
      WHEN DATE_TRUNC(created_date_local, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH), MONTH) 
      THEN "Last Month"
      WHEN DATE_TRUNC(created_date_local, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH) 
        OR DATE_TRUNC(created_date_local, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH), MONTH) 
      THEN "Prior 2 Months"
      WHEN DATE_TRUNC(created_date_local, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 4 MONTH), MONTH) 
        OR DATE_TRUNC(created_date_local, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH) 
      THEN "Earlier 2 Months"
      ELSE "Older"
    END AS period,
    COUNT(DISTINCT order_code) AS gross_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order THEN order_code
        ELSE NULL
      END
    ) AS valid_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND payment_method != "Cash On Delivery"
        THEN order_code
        ELSE NULL
      END
    ) AS online_paid_valid_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_failed_order THEN order_code
        ELSE NULL
      END
    ) AS failed_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_cancelled_by_vendor 
         AND decline_reason != "Fraud/prank order"
        THEN order_code
        ELSE NULL
      END
    ) AS vendor_failed_orders,
    COUNT(DISTINCT
      CASE
        WHEN NOT is_valid_order
         AND decline_reason = "Product unavailable"
        THEN order_code
        ELSE NULL
      END
    ) AS pu_cancelled_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_cancelled_by_customer THEN order_code
        ELSE NULL
      END
    ) AS customer_failed_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_cancelled_by_logistics THEN order_code
        ELSE NULL
      END
    ) AS logistics_failed_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order
         AND is_partially_fulfilled_order THEN order_code
        ELSE NULL
      END
    ) AS partially_fulfilled_orders,
    SUM(
      CASE
        WHEN is_valid_order THEN ordered_quantity
        WHEN decline_reason = "Product unavailable" THEN ordered_quantity
        ELSE NULL
      END
    ) AS items_ordered,
  SUM(
       CASE
        WHEN is_valid_order THEN ordered_quantity
        WHEN decline_reason = "Product unavailable" THEN ordered_quantity
        ELSE NULL
      END
    ) - 
    SUM(
       CASE
        WHEN is_valid_order THEN delivered_quantity
        WHEN decline_reason = "Product unavailable" THEN 0
        ELSE NULL
      END
    ) AS item_not_delivered,
    SUM(
      CASE
        WHEN is_valid_order THEN gfv
        ELSE NULL
      END
    ) AS gfv,
    SUM(
      CASE
        WHEN is_valid_order THEN COALESCE(gfv_with_vat, gfv)
        ELSE NULL
      END
    ) AS gfv_with_vat,
    SUM(
      CASE
        WHEN vertical != "shops" AND is_valid_order 
        THEN ultra_fresh_gfv_with_vat
        WHEN vertical = "shops" AND is_valid_order AND vertical_segment IN (
          "butchery", "fishery" "fruits_and_vegetables", "wet_market"
        ) 
        THEN gfv
        ELSE NULL
      END
    ) AS ultra_fresh_gfv_with_vat,
    SUM(
      CASE
        WHEN vertical != "shops" AND is_valid_order 
        THEN ultra_fresh_actual_gfv_with_vat
        WHEN vertical = "shops" AND is_valid_order AND vertical_segment IN (
          "butchery", "fishery" "fruits_and_vegetables", "wet_market"
        ) 
        THEN gfv
        ELSE NULL
      END
    ) AS ultra_fresh_actual_gfv_with_vat,
    SUM(
      CASE
        WHEN vertical != "shops" AND is_valid_order 
        THEN ultra_fresh_actual_orders_dmart
        ELSE ultra_fresh_actual_orders_shops
      END
    ) AS ultra_fresh_actual_orders,
    SUM(
      CASE
        WHEN vertical != "shops" AND is_valid_order 
        THEN ultra_fresh_orders_dmart
        ELSE ultra_fresh_orders_shops
      END
    ) AS ultra_fresh_orders,
    SUM(
      CASE
        WHEN is_valid_order THEN gfv_without_vat
        ELSE NULL
      END
    ) AS gfv_without_vat,
    SUM(
      CASE
        WHEN is_valid_order THEN cogs
        ELSE NULL
      END
    ) AS cogs,
    SUM(
      CASE
        WHEN is_valid_order THEN margin_amount
        ELSE NULL
      END
    ) AS margin_amount,
    SUM(
      CASE
        WHEN is_valid_order THEN gmv
        ELSE NULL
      END
    ) AS gmv,
    SUM(
      CASE
        WHEN is_valid_order THEN units_sold
        ELSE NULL
      END
    ) AS units_sold,
    SUM(
      CASE
        WHEN is_valid_order THEN skus_in_order
        ELSE NULL
      END
    ) AS skus_in_order,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND channel IS NOT NULL THEN order_code
        ELSE NULL
      END
    ) AS valid_voucher_orders,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND discount_amount >> 0 THEN order_code
        ELSE NULL
      END
    ) AS valid_discount_orders,
    SUM(
      CASE
        WHEN is_valid_order THEN voucher_amount
        ELSE NULL
      END
    ) AS voucher_amount,
    SUM(
      CASE
        WHEN is_valid_order 
         AND CONCAT(channel, purpose) NOT IN (
          'channel_crmautocompensation_realtime', 'channel_crmcompensation', 'channel_customer_servicecompensation', 'channel_customer_servicerefund', 'channel_customer_servicesorry_panda', 'channel_onlineautocompensation_realtime', 'channel_onlinesorry_panda', 'channel_otherssorry_panda', 'channel_subsidiessorry_panda')
        THEN voucher_amount
        ELSE NULL
      END
    ) AS voucher_amount_excl_cx,
    SUM(
      CASE
        WHEN is_valid_order 
         AND CONCAT(channel, purpose) NOT IN (
          'channel_crmautocompensation_realtime', 'channel_crmcompensation', 'channel_customer_servicecompensation', 'channel_customer_servicerefund', 'channel_customer_servicesorry_panda', 'channel_onlineautocompensation_realtime', 'channel_onlinesorry_panda', 'channel_otherssorry_panda', 'channel_subsidiessorry_panda')
        THEN voucher_amount_foodpanda
        ELSE NULL
      END
    ) AS voucher_amount_foodpanda_excl_cx,
    COUNT(DISTINCT
      CASE
        WHEN is_incident_order
        THEN order_code
        ELSE NULL
      END
    ) AS orders_with_incidents,
    COUNT(DISTINCT
      CASE
        WHEN is_food_quality_incident_order
        THEN order_code
        ELSE NULL
      END
    ) AS orders_with_food_quality_incidents,
    COUNT(DISTINCT
      CASE
        WHEN is_wrong_missing_incident_order
        THEN order_code
        ELSE NULL
      END
    ) AS orders_with_missing_wrong_incidents,
    SUM(number_of_issues
    ) AS number_of_issues,
    SUM(number_of_ccr2s
    ) AS number_of_ccr2s,
    SUM(
      number_of_food_quality_issues
      
    ) AS number_of_food_quality_issues,
    SUM(
      
         number_of_wrong_missing_issues
        
      
    ) AS number_of_missing_wrong_issues,
    SUM(
      CASE
        WHEN is_valid_order 
         AND vertical = "shops" 
        THEN commission_base
        ELSE NULL
      END
    ) AS commission_base,
    SUM(
      CASE
        WHEN is_valid_order 
         AND vertical = "shops" 
        THEN commission_revenue
        ELSE NULL
      END
    ) AS commission_revenue,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order
        THEN pd_customer_uuid
        ELSE NULL
      END
    ) AS unique_customers,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND vertical = "shops"
         AND created_at_utc != first_valid_order_shops_at_utc
        THEN pd_customer_uuid
        WHEN is_valid_order 
         AND vertical != "shops"
         AND created_at_utc != first_valid_order_dmart_at_utc
        THEN pd_customer_uuid
        ELSE NULL
      END
    ) AS existing_customers,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND vertical = "shops"
         AND created_at_utc = first_valid_order_shops_at_utc
        THEN pd_customer_uuid
        WHEN is_valid_order 
         AND vertical != "shops"
         AND created_at_utc = first_valid_order_dmart_at_utc
        THEN pd_customer_uuid
        ELSE NULL
      END
    ) AS new_customers,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND vertical = "shops"
         AND created_at_utc = first_valid_order_shops_at_utc
         AND created_at_utc = first_valid_order_all_at_utc
        THEN pd_customer_uuid
        WHEN is_valid_order 
         AND vertical != "shops"
         AND created_at_utc = first_valid_order_dmart_at_utc
         AND created_at_utc = first_valid_order_all_at_utc
        THEN pd_customer_uuid
        ELSE NULL
      END
    ) AS ntp_customers,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND vertical = "shops"
         AND created_at_utc = first_valid_order_shops_at_utc
         AND created_at_utc != first_valid_order_all_at_utc
        THEN pd_customer_uuid
        WHEN is_valid_order 
         AND vertical != "shops"
         AND created_at_utc = first_valid_order_dmart_at_utc
         AND created_at_utc != first_valid_order_all_at_utc
        THEN pd_customer_uuid
        ELSE NULL
      END
    ) AS ntv_customers,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND vertical = "shops"
         AND created_at_utc = first_valid_order_shops_at_utc_acid
        THEN analytical_customer_id
        WHEN is_valid_order 
         AND vertical != "shops"
         AND created_at_utc = first_valid_order_dmart_at_utc_acid
        THEN analytical_customer_id
        ELSE NULL
      END
    ) AS new_customers_acid,
    SUM(
      CASE
        WHEN is_valid_order THEN discount_amount
        ELSE NULL
      END
    ) AS discount_amount,
    SUM(
      CASE
        WHEN is_valid_order THEN actual_delivery_time_in_seconds
        ELSE NULL
      END
    ) AS actual_delivery_time_in_seconds,
    SUM(
      CASE
        WHEN is_valid_order THEN shopper_delay_time_in_sec
        ELSE NULL
      END
    ) AS shopper_delay_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN pelican_delay_time_in_sec
        ELSE NULL
      END
    ) AS pelican_delay_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN assignment_time_in_sec
        ELSE NULL
      END
    ) AS assignment_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN pick_time_in_sec
        ELSE NULL
      END
    ) AS pick_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN pack_time_in_sec
        ELSE NULL
      END
    ) AS pack_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN pick_pack_time_in_sec
        ELSE NULL
      END
    ) AS pick_pack_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN rider_dispatch_time_in_sec
        ELSE NULL
      END
    ) AS rider_dispatch_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN vendor_prep_time_in_sec
        ELSE NULL
      END
    ) AS vendor_prep_time_in_sec,
    SUM(
      CASE
        WHEN is_valid_order THEN df_user_paid_incl_vat_local
        ELSE NULL
      END
    ) AS delivery_fee_local,
    SUM(
      CASE
        WHEN is_valid_order THEN delivery_fee_excl_tax
        ELSE NULL
      END
    ) AS delivery_fee_local_excl_tax,
    SUM(
      CASE
        WHEN is_valid_order THEN service_fee_local
        ELSE NULL
      END
    ) AS servide_fee_local,
    SUM(
      CASE
        WHEN is_valid_order THEN service_fee_excl_tax
        ELSE NULL
      END
    ) AS service_fee_local_excl_tax,
    SUM(
      CASE
        WHEN is_valid_order THEN packaging_fee_local
        ELSE NULL
      END
    ) AS packaging_fee_local,
    SUM(
      CASE
        WHEN is_valid_order THEN packaging_fee_excl_tax
        ELSE NULL
      END
    ) AS packaging_fee_local_excl_tax,
    COUNT(DISTINCT
      CASE
        WHEN is_valid_order 
         AND is_free_delivery_subscription_order THEN order_code
        ELSE NULL
      END
    ) AS valid_pro_orders,
    SUM(
      CASE
        WHEN is_valid_order 
         AND vertical != "shops"
        THEN pro_adjusted_delivery_fee_incl_tax
        WHEN is_valid_order 
         AND vertical = "shops"
        THEN df_user_paid_incl_vat_local
        ELSE NULL
      END
    ) AS pro_adjusted_delivery_fee_incl_tax,
    SUM(
      CASE
        WHEN is_valid_order 
         AND vertical != "shops"
        THEN pro_adjusted_delivery_fee_excl_tax
        WHEN is_valid_order 
         AND vertical = "shops"
        THEN delivery_fee_excl_tax
        ELSE NULL
      END
    ) AS pro_adjusted_delivery_fee_excl_tax,
    SUM(
      CASE
        WHEN is_valid_order 
         AND (created_at_utc = first_valid_order_dmart_at_utc
          OR created_at_utc = first_valid_order_shops_at_utc)
        THEN nc_df_subsidy + discount_amount + voucher_amount
        ELSE NULL
      END
    ) AS nc_subsidy,
    SUM(
      CASE
        WHEN is_valid_order 
         AND (created_at_utc = first_valid_order_dmart_at_utc
          OR created_at_utc = first_valid_order_shops_at_utc)
        THEN gmv
        ELSE NULL
      END
    ) AS nc_gmv,
    COUNT(DISTINCT
      CASE
        WHEN --is_valid_order 
         --AND 
         is_seamless_order
        THEN order_code
        ELSE NULL
      END
    ) AS seamless_orders,
    COUNT(DISTINCT
      CASE
        WHEN --is_valid_order 
         --AND 
         is_seamless_gross_base
        THEN order_code
        ELSE NULL
      END
    ) AS seamless_gross_orders_demominator,
    COUNT(DISTINCT
      CASE
        WHEN --is_valid_order 
         --AND is_refund_issued
          is_refund_issued
        THEN order_code
        ELSE NULL
      END
    ) AS orders_with_refunds,
    
  FROM baseline

  GROUP BY 
    vertical,
    vendor_code,
    vendor_name,
    city_name,
    zone_name,
    account_manager_name,
    vertical_segment,
    chain_code,
    chain_name,
    created_date_local
),

conventional_availability AS (
  SELECT
 date_local
, av.sku
,av.dmart_imt_warehouse_uuid
,av.dmart_imt_warehouse_name as warehouse_name
,ANY_VALUE(category_english) AS category
,ANY_VALUE(subcategory_english) as subcategory
, sum(available_hours) as available_hours
, sum(potential_hours) as total_hours
FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__weighted_availability_report` as av
left join `fulfillment-dwh-production.pandata_report.dmart__product_report` prd on prd.sku = av.sku and prd.dmart_imt_warehouse_uuid = av.dmart_imt_warehouse_uuid and prd.global_entity_id = "FP_PK"
WHERE date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
AND av.global_entity_id = 'FP_PK'  
group by all

),

last_day_wa AS (
  SELECT
    availability.period_day,
    availability.warehouse_id,
    warehouse_info.vendor_code,
    availability.sku,
    products.category,
    MAX(availability.sku_status) AS sku_status,
    -- Formula below from Central
    CASE
      WHEN COALESCE(MAX(availability.sales_forecast_quantity), 0.0000001) <<= 0 THEN 0.0000001
      ELSE COALESCE(MAX(availability.sales_forecast_quantity), 0.0000001) END
    AS sales_forecast_quantity,
    MAX(availability.global_day_forecast_qty) AS global_day_forecast_quantity,
    SUM(availability.available_hourly) AS available_hours,
    SUM(availability.potential_hours) AS potential_hours,
    SUM(IF(availability.available_hourly = 1, availability.hourly_events_weightage, 0)) AS avail_events_weightage,
    SUM(availability.hourly_events_weightage) AS total_events_weightage,
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.availability_data` AS availability
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = availability.warehouse_id
  LEFT JOIN products
         ON products.sku = availability.sku
        AND products.dmart_imt_warehouse_uuid = availability.warehouse_id
  WHERE availability.period_day = CURRENT_DATE() - 1
    AND global_entity_id = "FP_PK"
    -- Below is filter used by Central
    AND availability.store_open = 1
    AND ((availability.period_day >>= availability.status_implementation_date
          AND availability.sku_status IN ("ACTIVE","ON_HOLD")
          AND availability.is_stale IS FALSE)
        OR
        ((availability.period_day << availability.status_implementation_date
          OR availability.status_implementation_date IS NULL)
          AND availability.is_active
          AND availability.is_stale IS FALSE)
  )
  GROUP BY
    availability.period_day,
    availability.warehouse_id,
    vendor_code,
    availability.sku,
    products.category
),

weighted_availability AS ( -- IFNULL(SUM([available_events_weightage] * sales_forecast_quantity)/ SUM(total_events_weightage * sales_forecast_quantity), 0)
  SELECT 
    date_local,
    av.dmart_warehouse_id as dmart_imt_warehouse_uuid,
    warehouse_info.vendor_code,
    SUM(sales_forecast_quantity * avail_events_weightage) AS avail_w, 
    SUM(sales_forecast_quantity * total_events_weightage) AS total_w,
    SUM(
      CASE
        WHEN products.category IN ("Meat, Fruits and Vegetables", "Fruits & Vegetables", "Meat & Seafood")
        THEN sales_forecast_quantity * avail_events_weightage
        ELSE NULL
      END
    ) AS avail_w_ultra_fresh_catalog,
    SUM(
      CASE
        WHEN products.category IN ("Meat, Fruits and Vegetables", "Fruits & Vegetables", "Meat & Seafood")
        THEN sales_forecast_quantity * total_events_weightage
        ELSE NULL
      END
    ) AS total_w_ultra_fresh_catalog,
    
  FROM `fulfillment-dwh-production.pandata_datamart.preprocessing__dmart_inventory_weighted_availability_v2` as av
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = av.dmart_warehouse_id
  LEFT JOIN products
         ON products.sku = av.sku
        AND products.dmart_imt_warehouse_uuid = av.dmart_warehouse_id
  WHERE global_entity_id = 'FP_PK'
    AND date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND date_local << CURRENT_DATE() - 1
  GROUP BY
    date_local,
    dmart_imt_warehouse_uuid,
    vendor_code

  UNION ALL

  SELECT
    last_day_wa.period_day AS date_local,
    last_day_wa.warehouse_id AS dmart_imt_warehouse_uuid,
    last_day_wa.vendor_code,
    SUM(last_day_wa.sales_forecast_quantity * last_day_wa.avail_events_weightage) AS avail_w, 
    SUM(last_day_wa.sales_forecast_quantity * last_day_wa.total_events_weightage) AS total_w,
    SUM(
      CASE
        WHEN category IN ("Meat, Fruits and Vegetables", "Fruits & Vegetables", "Meat & Seafood")
        THEN sales_forecast_quantity * avail_events_weightage
        ELSE NULL
      END
    ) AS avail_w_ultra_fresh_catalog,
    SUM(
      CASE
        WHEN category IN ("Meat, Fruits and Vegetables", "Fruits & Vegetables", "Meat & Seafood")
        THEN sales_forecast_quantity * total_events_weightage
        ELSE NULL
      END
    ) AS total_w_ultra_fresh_catalog
  FROM last_day_wa
  GROUP BY
    date_local,
    dmart_imt_warehouse_uuid,
    vendor_code
),

sku_info_product_report AS (
  SELECT 
    sku, 
    product_title_english,
    dmart_imt_warehouse_name, 
    vendor_code,
    dmart_imt_warehouse_uuid,
    category_english,
    subcategory_english,
    principal_name_english,
    brand_name_english
  FROM `fulfillment-dwh-production.pandata_report.dmart__product_report` 
  WHERE global_entity_id = "FP_PK"
    AND is_active_catalog
    AND is_dmart
    AND NOT is_vendor_deleted
    AND NOT is_vendor_product_deleted
    AND status = "ACTIVE"
),

supplier_portal_active AS (
  SELECT
    sku,
    name,
    warehouses.warehouse_id AS dmart_imt_warehouse_uuid,
    supplier_id,
    supplier_name,
    sku_supplier_status,
    sku_supplier_warehouse_status,
    is_supplier_deleted,
    product_deleted_at,
    price_deleted_at
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.products_suppliers`
  LEFT JOIN UNNEST (suppliers) AS suppliers
  LEFT JOIN UNNEST (suppliers.warehouses) AS warehouses
  WHERE global_entity_id = "FP_PK"
    AND price_deleted_at IS NULL
),

all_data_for_availability AS (
  SELECT
    conventional_availability.date_local,
    sku_info_product_report.sku,
    product_title_english,
    COALESCE(category_english, conventional_availability.category) AS category,
    COALESCE(subcategory_english, conventional_availability.subcategory) AS subcategory,
    sku_info_product_report.dmart_imt_warehouse_name,
    sku_info_product_report.vendor_code,
    principal_name_english,
    brand_name_english,
    COALESCE(total_hours, 0) AS total_hours,
    COALESCE(available_hours, 0) AS available_hours
  FROM sku_info_product_report
  INNER JOIN supplier_portal_active
          ON supplier_portal_active.sku = sku_info_product_report.sku
         AND supplier_portal_active.dmart_imt_warehouse_uuid = sku_info_product_report.dmart_imt_warehouse_uuid
  LEFT JOIN conventional_availability
         ON conventional_availability.sku = sku_info_product_report.sku
        AND conventional_availability.dmart_imt_warehouse_uuid = sku_info_product_report.dmart_imt_warehouse_uuid  
  WHERE conventional_availability.date_local IS NOT NULL 
),

availability AS (
  SELECT
    all_data_for_availability.date_local,
    all_data_for_availability.vendor_code,
    SUM(total_hours) AS total_hours,
    SUM(available_hours) AS available_hours,
    SUM(weighted_availability.avail_w) AS avail_w,
    SUM(weighted_availability.total_w) AS total_w,
    SUM(weighted_availability.avail_w_ultra_fresh_catalog) AS avail_w_ultra_fresh_catalog,
    SUM(weighted_availability.total_w_ultra_fresh_catalog) AS total_w_ultra_fresh_catalog
  FROM all_data_for_availability
  LEFT JOIN weighted_availability
         ON weighted_availability.vendor_code = all_data_for_availability.vendor_code
        AND weighted_availability.date_local = all_data_for_availability.date_local 
  GROUP BY 
    date_local,
    vendor_code
),

sessions AS (
  SELECT 
    date_utc,
    vendor_code,
    SUM(menu_sessions) AS menu_sessions,
    SUM(list_sessions) AS list_sessions,
    SUM(atc_sessions) AS atc_sessions,
    SUM(checkout_sessions) AS checkout_sessions,
    SUM(menu_n_transaction_sessions) AS menu_n_transaction_sessions,
    SUM(list_n_menu_sessions) AS list_n_menu_sessions,
    SUM(menu_n_checkout_sessions) AS menu_n_checkout_sessions,
    SUM(menu_n_atc_sessions) AS menu_n_atc_sessions,
    SUM(atc_n_checkout_sessions) AS atc_n_checkout_sessions,
    SUM(checkout_n_transaction_sessions) AS checkout_n_transaction_sessions
  FROM `fulfillment-dwh-production.pandata_report.product__groceries_vendor_reporting_daily_unified` AS s
  WHERE s.date_utc <<= CURRENT_DATE()
    AND s.date_utc >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 7 MONTH) - 1
    AND global_entity_id = "FP_PK"
    AND platform != "Web"
  GROUP BY 
    date_utc,
    vendor_code
),

vendor_offline AS (
    SELECT 
    CASE
      WHEN vendor_info.vertical = "shops" THEN "shops"
      WHEN LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) LIKE "%franchise%" THEN "franchise"
      ELSE "dmart"
    END AS vertical,
    vendor_offline.vendor_code,
    COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name) AS vendor_name,
    COALESCE(vendor_info.sf_city, vendor_info.lg_city) AS city_name,
    COALESCE(vendor_info.sf_zone_name, vendor_info.lg_zone_name) AS zone_name,
    CASE
      WHEN vendor_info.vertical = "shops" THEN vendor_info.owner_name 
      ELSE NULL
    END AS account_manager_name,
    CASE
      WHEN vendor_info.vertical = "shops" THEN vendor_info.vertical_segment 
      WHEN LOWER(COALESCE(warehouse_info.dmart_imt_warehouse_name, vendor_info.vendor_name)) LIKE "%franchise%" THEN "franchise"
      ELSE "dmart"
    END AS vertical_segment,
    vendor_info.chain_code,
    vendor_info.chain_name,
    report_date,
    CASE
      WHEN EXTRACT (DAYOFWEEK FROM report_date) = 1 THEN "Sunday"
      WHEN EXTRACT (DAYOFWEEK FROM report_date) = 2 THEN "Monday"
      WHEN EXTRACT (DAYOFWEEK FROM report_date) = 3 THEN "Tuesday"
      WHEN EXTRACT (DAYOFWEEK FROM report_date) = 4 THEN "Wednesday"
      WHEN EXTRACT (DAYOFWEEK FROM report_date) = 5 THEN "Thursday"
      WHEN EXTRACT (DAYOFWEEK FROM report_date) = 6 THEN "Friday"
      ELSE "Saturday"
    END AS day,
    CASE 
      WHEN DATE_TRUNC(report_date, MONTH) = DATE_TRUNC(CURRENT_DATE(), MONTH) 
      THEN "Current Month"
      WHEN DATE_TRUNC(report_date, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH), MONTH) 
      THEN "Last Month"
      WHEN DATE_TRUNC(report_date, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH) 
        OR DATE_TRUNC(report_date, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH), MONTH) 
      THEN "Prior 2 Months"
      WHEN DATE_TRUNC(report_date, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 4 MONTH), MONTH) 
        OR DATE_TRUNC(report_date, MONTH) = DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 5 MONTH), MONTH) 
      THEN "Earlier 2 Months"
      ELSE "Older"
    END AS period,
    COALESCE(total_open_seconds, 0) AS total_open_seconds,
    COALESCE(total_unavailable_seconds, 0) AS total_unavailable_seconds
  FROM `fulfillment-dwh-production.pandata_datamart.pandora__vendor_offline` AS vendor_offline
  LEFT JOIN UNNEST(availabilities) AS availabilities 
  INNER JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vendor_info
          ON vendor_info.vendor_code = vendor_offline.vendor_code
         AND vendor_info.vertical IN ("darkstores", "shops")
  LEFT JOIN warehouse_info
         ON warehouse_info.vendor_code = vendor_offline.vendor_code
  WHERE global_entity_id = "FP_PK"
    AND report_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 7 MONTH)
    AND vendor_offline.is_active
    AND COALESCE(total_open_seconds, 0) >> 0
    and not vendor_offline.is_private
  and not vendor_offline.is_test
  and not is_sf_test
  and sf_status = "Active"
  and vendor_info.vendor_code NOT IN ("wbna", "dj3c", "u922", "k6f2")
  AND (chain_code IS NULL OR chain_code != "cj6qr")
  QUALIFY ROW_NUMBER() OVER (PARTITION BY vendor_code, report_date) = 1
),

mau_penetration AS (
  SELECT
    report_date_utc,
    vendor_code,
    num_of_customers_in_vendor_delivery_area,
    num_of_ds_customers_in_delivery_area
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_qcommerce__dmart_warehouse_coverage_dashboard`
  WHERE global_entity_id = 'FP_PK'
    AND report_date_utc >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 7 MONTH) - 1
),

reorder AS (
  SELECT 
    LEFT(pd_vendor_uuid, 4) AS vendor_code,
    report_date_local,
    ac_30d_ago,
    ac_30d_ago_reorder,
    ec_30d_ago,
    ec_30d_ago_reorder,
    nc_30d_ago,
    nc_30d_ago_reorder
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__vendor_reorder_rate_report`
  WHERE global_entity_id = "FP_PK"
    AND date_type = "month"
),

aqs AS (
  SELECT 
    warehouse_info.vendor_code,
    date_month,
    final_score AS store_aqs_store
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.assortment_quality_scorecard_v5_mtd` AS aqs
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = aqs.warehouse_id
  WHERE global_entity_id = "FP_PK"
    AND granularity = "Warehouse"
),

picker_utr AS (
  SELECT
    warehouse_info.vendor_code,
    date_local,
    SUM(total_picked_quantity_valid_order) AS picked_units,
    SUM(total_shift_hrs) AS shopper_manhours
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__shopper_utr_dashboard` AS utr
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = utr.warehouse_id
  WHERE global_entity_id = "FP_PK"
  GROUP BY
    vendor_code,
    date_local
),

skus_on_discount AS (
  SELECT 
    order_date_local AS date_local,
    vendor_code,
    COUNT(DISTINCT sku) AS unique_skus_ordered,
    COUNT(DISTINCT 
      CASE
        WHEN unit_discount_amount_local >> 0 THEN sku
        ELSE NULL
      END
    ) AS unique_skus_on_discount   
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__customer_order_line_report_v2` AS customer_order_line_report
  WHERE customer_order_line_report.order_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND customer_order_line_report.global_entity_id = "FP_PK"
    AND is_successful
  GROUP BY 
    date_local,
    vendor_code

  UNION ALL

  SELECT
    created_date_local AS date_local,
    vendor_code,
    COUNT(DISTINCT remote_code) AS unique_skus_ordered,
    COUNT(DISTINCT 
      CASE
        WHEN unit_discount_local >> 0 THEN remote_code
        ELSE NULL
      END
    ) AS unique_skus_on_discount   
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_shops__order_product_report` AS customer_order_line_report
  WHERE customer_order_line_report.created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND customer_order_line_report.global_entity_id = "FP_PK"
    AND is_valid_order
  GROUP BY 
    date_local,
    vendor_code
),

shops_active_skus AS (
  SELECT
    products.vendor_code,
    COUNT(DISTINCT products.uuid) AS shops_active_skus_latest,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_qcommerce__dmart_products` AS products
  WHERE global_entity_id = "FP_PK"
    AND NOT is_vendor_product_deleted
    AND is_valid_vendor_sku
    AND is_active
  GROUP BY
    vendor_code
),

skus_counted AS (
  SELECT 
    cycle_count.cycle_count_completed_at_date AS date_local,
    cycle_count.warehouse_id,
    warehouse_info.vendor_code,
    cycle_count.inventory_result,
    COUNT(cycle_count.sku) AS non_zero_skus
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.cycle_count_details` AS cycle_count
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = cycle_count.warehouse_id
  WHERE global_entity_id = "FP_PK"
    AND cycle_count_completed_at_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND cycle_count_status = "COMPLETE"
    AND on_hand_qty != 0
  GROUP BY
    date_local,
    warehouse_id,
    vendor_code,
    inventory_result
),

sku_defect_rate AS (
  SELECT
    date_local,
    vendor_code,
    SUM(non_zero_skus) AS non_zero_skus_counted,
    SUM(
      CASE
        WHEN inventory_result != "match" THEN non_zero_skus
        ELSE 0
      END
    ) AS non_zero_skus_on_defect
  FROM skus_counted
  GROUP BY
    date_local,
    vendor_code
),

unique_skus_counted AS (
  SELECT 
    DATE_TRUNC(cycle_count_completed_at_date, MONTH) AS month_local,
    warehouse_id,
    vendor_code,
    COUNT(DISTINCT sku) AS distinct_skus_counted_month
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.cycle_count_details` AS cycle_count
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = cycle_count.warehouse_id
  WHERE global_entity_id = "FP_PK"
    AND cycle_count_completed_at_date >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND cycle_count_status = "COMPLETE"
    AND on_hand_qty != 0
  GROUP BY
    month_local,
    warehouse_id,
    vendor_code
),

month_end_inventory AS (
  SELECT
    date_local,
    DATE_TRUNC(date_local, MONTH) AS month_local,
    inventory_value_report.dmart_imt_warehouse_uuid,
    vendor_code,
    COUNT(DISTINCT inventory_value_report.sku) AS distinct_skus_on_hand_month_end
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__inventory_value_report` AS inventory_value_report
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = inventory_value_report.dmart_imt_warehouse_uuid
  WHERE inventory_value_report.date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 7 MONTH), MONTH)
    AND inventory_value_report.global_entity_id = "FP_PK"
    AND inventory_value_report.end_stock >> 0
  GROUP BY
    date_local,
    dmart_imt_warehouse_uuid,
    vendor_code
  QUALIFY ROW_NUMBER() OVER (PARTITION BY month_local, dmart_imt_warehouse_uuid ORDER BY date_local DESC) = 1 
),

seamless_fulfillment AS (
  SELECT 
    ordered_date_local AS date_local,
    vendor_code,
    COUNT(DISTINCT IF(pd_order_code <<>> "BASELINE", pd_order_code, NULL)) AS sfr_orders,
    SUM(total_valid_order) AS total_valid_orders_sfr
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__sfr_summary_dashboard` AS sfr_dashboard
  LEFT JOIN warehouse_info
         ON warehouse_info.dmart_imt_warehouse_uuid = sfr_dashboard.warehouse_id
  WHERE global_entity_id = "FP_PK"
  GROUP BY
    date_local,
    vendor_code
)

SELECT
  COALESCE(all_order_level_info.vertical, vendor_offline.vertical) AS vertical,
  COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code) AS vendor_code,
  COALESCE(all_order_level_info.vendor_name, vendor_offline.vendor_name) AS vendor_name,
  COALESCE(all_order_level_info.city_name, vendor_offline.city_name) AS city_name,
  COALESCE(all_order_level_info.zone_name, vendor_offline.zone_name) AS zone_name,
  COALESCE(all_order_level_info.account_manager_name, vendor_offline.account_manager_name) AS account_manager_name,
  COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) AS vertical_segment,
  COALESCE(all_order_level_info.chain_code, vendor_offline.chain_code) AS chain_code,
  COALESCE(all_order_level_info.chain_name, vendor_offline.chain_name) AS chain_name,
  COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date) AS created_date_local,
  COALESCE(all_order_level_info.day, vendor_offline.day) AS day,
  COALESCE(all_order_level_info.period, vendor_offline.period) AS period,
  all_order_level_info.* EXCEPT (
    vertical,
    vendor_code,
    vendor_name,
    city_name,
    zone_name,
    account_manager_name,
    vertical_segment,
    chain_code,
    chain_name,
    created_date_local,
    day,
    period
  ),
  availability.available_hours,
  availability.total_hours,
  availability.avail_w,
  availability.total_w,
  availability.avail_w_ultra_fresh_catalog,
  availability.total_w_ultra_fresh_catalog,
  sessions.menu_sessions,
  sessions.list_sessions,
  sessions.atc_sessions,
  sessions.checkout_sessions,
  sessions.menu_n_transaction_sessions,
  sessions.list_n_menu_sessions,
  sessions.menu_n_checkout_sessions,
  sessions.menu_n_atc_sessions,
  sessions.atc_n_checkout_sessions,
  sessions.checkout_n_transaction_sessions,
  vendor_offline.total_open_seconds,
  vendor_offline.total_unavailable_seconds,
  mau_penetration.num_of_ds_customers_in_delivery_area,
  mau_penetration.num_of_customers_in_vendor_delivery_area,
  reorder.ac_30d_ago,
  reorder.ac_30d_ago_reorder,
  reorder.ec_30d_ago,
  reorder.ec_30d_ago_reorder,
  reorder.nc_30d_ago,
  reorder.nc_30d_ago_reorder,
  aqs.store_aqs_store,
  picker_utr.picked_units,
  picker_utr.shopper_manhours,
  skus_on_discount.unique_skus_ordered,
  skus_on_discount.unique_skus_on_discount,
  CASE
    WHEN COALESCE(all_order_level_info.vertical, vendor_offline.vertical) = "shops"
    THEN shops_active_skus.shops_active_skus_latest
    ELSE NULL
  END AS shops_active_skus_latest,
  CASE
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "supermarket"
    THEN 7500
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "mini_market"
    THEN 3500
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "convenience"
    THEN 1800
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "health_and_wellness"
    THEN 2500
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) IN ("tobacco", "Electronics")
    THEN 250
    ELSE NULL
  END AS target_skus,
  CASE
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "supermarket"
    THEN IF(shops_active_skus.shops_active_skus_latest >>= 7500, 1, 0)
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "mini_market"
    THEN IF(shops_active_skus.shops_active_skus_latest >>= 3500, 1, 0)
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "convenience"
    THEN IF(shops_active_skus.shops_active_skus_latest >>= 1800, 1, 0)
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) = "health_and_wellness"
    THEN IF(shops_active_skus.shops_active_skus_latest >>= 2500, 1, 0)
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) IN ("tobacco", "Electronics")
    THEN IF(shops_active_skus.shops_active_skus_latest >>= 250, 1, 0)
    ELSE NULL
  END AS vendors_meeting_sku_criteria,
  CASE
    WHEN COALESCE(all_order_level_info.vertical_segment, vendor_offline.vertical_segment) IN (
      "tobacco", "Electronics", "health_and_wellness", "convenience", "mini_market", "supermarket"
    ) THEN 1
    ELSE NULL
  END AS sku_target_vendors,
  sku_defect_rate.non_zero_skus_counted,
  sku_defect_rate.non_zero_skus_on_defect,
  unique_skus_counted.distinct_skus_counted_month,
  month_end_inventory.distinct_skus_on_hand_month_end,
  seamless_fulfillment.sfr_orders,
  seamless_fulfillment.total_valid_orders_sfr
FROM all_order_level_info
FULL OUTER JOIN vendor_offline
             ON vendor_offline.vendor_code = all_order_level_info.vendor_code
            AND vendor_offline.report_date = all_order_level_info.created_date_local
LEFT JOIN availability
       ON availability.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND availability.date_local = COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date)
LEFT JOIN sessions
       ON sessions.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND sessions.date_utc = COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date)
LEFT JOIN mau_penetration
       ON mau_penetration.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND mau_penetration.report_date_utc = COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date)
LEFT JOIN reorder
       ON reorder.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND reorder.report_date_local = COALESCE(DATE_TRUNC(all_order_level_info.created_date_local, MONTH), DATE_TRUNC(vendor_offline.report_date, MONTH))
LEFT JOIN aqs
       ON aqs.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND aqs.date_month = COALESCE(DATE_TRUNC(all_order_level_info.created_date_local, MONTH), DATE_TRUNC(vendor_offline.report_date, MONTH))
LEFT JOIN picker_utr
       ON picker_utr.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND picker_utr.date_local = COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date)
LEFT JOIN skus_on_discount
       ON skus_on_discount.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND skus_on_discount.date_local = COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date)
LEFT JOIN shops_active_skus
       ON shops_active_skus.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
LEFT JOIN sku_defect_rate
       ON sku_defect_rate.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND sku_defect_rate.date_local = COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date)
LEFT JOIN unique_skus_counted
       ON unique_skus_counted.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND unique_skus_counted.month_local = COALESCE(DATE_TRUNC(all_order_level_info.created_date_local, MONTH), DATE_TRUNC(vendor_offline.report_date, MONTH))
LEFT JOIN month_end_inventory
       ON month_end_inventory.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND month_end_inventory.month_local = COALESCE(DATE_TRUNC(all_order_level_info.created_date_local, MONTH), DATE_TRUNC(vendor_offline.report_date, MONTH))
LEFT JOIN seamless_fulfillment
       ON seamless_fulfillment.vendor_code = COALESCE(all_order_level_info.vendor_code, vendor_offline.vendor_code)
      AND seamless_fulfillment.date_local = COALESCE(all_order_level_info.created_date_local, vendor_offline.report_date)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
