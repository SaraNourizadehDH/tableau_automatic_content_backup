    <worksheet name='PK QC MOM Raw Data'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffd271'>QC Verticals MOM</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PK QC Verticals' name='federated.08whz7a1l9csdk18h1bbi0gfb72z' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Display' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dmart/Shops&quot;'>
              <calculation class='tableau' formula='&quot;Dmart/Shops&quot;' />
            </column>
            <column caption='Data Split' datatype='string' name='[Select Display (copy)_327918348899606528]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.08whz7a1l9csdk18h1bbi0gfb72z'>
            <column caption='Discount Per Order' datatype='real' name='[Calculation_1174595108965253121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discount_amount])/SUM([valid_orders])' />
            </column>
            <column caption='Active Vendors' datatype='integer' name='[Calculation_1404560201013452800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_code])' />
            </column>
            <column caption='ODS' datatype='real' name='[Calculation_1404560201013514241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_orders])/COUNTD([created_date_local])/[Calculation_1404560201013452800]' />
            </column>
            <column caption='OOS Order Rate' datatype='real' name='[Calculation_1707427254412607488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partially_fulfilled_orders]+[pu_cancelled_orders])/SUM([valid_orders]+[pu_cancelled_orders])' />
            </column>
            <column caption='%IND (Items Not Delivered)' datatype='real' name='[Calculation_1707427254415011842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_not_delivered])/SUM([items_ordered])' />
            </column>
            <column caption='Reorder Rate' datatype='real' name='[Calculation_1835498376885391361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ac_30d_ago_reorder])/SUM([ac_30d_ago])' />
            </column>
            <column caption='Quality NCs' datatype='real' name='[Calculation_1902770848528642049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_customers_acid])/SUM([new_customers])' />
            </column>
            <column caption='Order Per Customer' datatype='real' name='[Calculation_1902770848529334274]' role='measure' type='quantitative'>
