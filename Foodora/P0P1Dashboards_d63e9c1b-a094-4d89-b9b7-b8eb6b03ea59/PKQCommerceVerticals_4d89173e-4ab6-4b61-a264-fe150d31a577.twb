            </column>
            <column caption='Post Delivery IR (Orders)' datatype='real' name='[Calculation_1904178245392220166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_with_incidents])/SUM([gross_orders])' />
            </column>
            <column caption='Partial Order Rate' datatype='real' name='[Calculation_1904178245407055879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partially_fulfilled_orders])/SUM([valid_orders])' />
            </column>
            <column caption='SKUs Per Order' datatype='real' name='[Calculation_1904178245407592456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([skus_in_order])/SUM([valid_orders])' />
            </column>
            <column caption='Quantity Per Order' datatype='real' name='[Calculation_1904178245407817737]' role='measure' type='quantitative'>
