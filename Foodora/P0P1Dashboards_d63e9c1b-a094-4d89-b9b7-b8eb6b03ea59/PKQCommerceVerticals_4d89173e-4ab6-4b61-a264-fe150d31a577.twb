      <column caption='ICPGMV (QCommerce)' datatype='real' name='[Calculation_1904178245408722954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([voucher_amount_foodpanda_excl_cx])/SUM([gfv])' />
