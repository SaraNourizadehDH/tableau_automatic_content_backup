    <worksheet name='PK QC DOD'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffd271'>QC Verticals DOD</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PK QC Verticals' name='federated.08whz7a1l9csdk18h1bbi0gfb72z' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Display' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dmart/Shops&quot;'>
              <calculation class='tableau' formula='&quot;Dmart/Shops&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.08whz7a1l9csdk18h1bbi0gfb72z'>
            <column caption='Discount Per Order' datatype='real' name='[Calculation_1174595108965253121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discount_amount])/SUM([valid_orders])' />
            </column>
            <column caption='Active Vendors' datatype='integer' name='[Calculation_1404560201013452800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_code])' />
            </column>
            <column caption='ODS' datatype='real' name='[Calculation_1404560201013514241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_orders])/COUNTD([created_date_local])/[Calculation_1404560201013452800]' />
            </column>
            <column caption='%IND (Items Not Delivered)' datatype='real' name='[Calculation_1707427254415011842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_not_delivered])/SUM([items_ordered])' />
            </column>
            <column caption='%SKUs on Discount' datatype='real' name='[Calculation_1902770848497422336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unique_skus_on_discount])/SUM([unique_skus_ordered])' />
            </column>
            <column caption='Quality NCs' datatype='real' name='[Calculation_1902770848528642049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_customers_acid])/SUM([new_customers])' />
            </column>
            <column caption='Order Per Customer' datatype='real' name='[Calculation_1902770848529334274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_orders])/SUM([unique_customers])' />
            </column>
            <column caption='Vendor Online Hours' datatype='real' name='[Calculation_1902770848543657987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_open_seconds])/3600' />
            </column>
            <column caption='Conventional Availability' datatype='real' name='[Calculation_190277112597897216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([available_hours])/SUM([total_hours])' />
            </column>
            <column caption='Weighted Availability' datatype='real' name='[Calculation_190277112614494209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avail_w])/SUM([total_w])' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_1904178245364326401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([gross_orders])' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_1904178245372833797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv])/SUM([valid_orders])' />
            </column>
            <column caption='Partial Order Rate' datatype='real' name='[Calculation_1904178245407055879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partially_fulfilled_orders])/SUM([valid_orders])' />
            </column>
            <column caption='SKUs Per Order' datatype='real' name='[Calculation_1904178245407592456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([skus_in_order])/SUM([valid_orders])' />
            </column>
            <column caption='Quantity Per Order' datatype='real' name='[Calculation_1904178245407817737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([units_sold])/SUM([valid_orders])' />
            </column>
            <column caption='Delivery Time' datatype='real' name='[Calculation_1904178245412519948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time_in_seconds])/SUM([valid_orders])/60' />
            </column>
            <column caption='SKU Defect Rate' datatype='real' name='[Calculation_1943584730100256768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_zero_skus_on_defect])/SUM([non_zero_skus_counted])' />
            </column>
            <column caption='Front Margin' datatype='real' name='[Calculation_1993968763642523648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([margin_amount])/SUM([gfv_without_vat])' />
            </column>
            <column caption='ECR' datatype='real' name='[Calculation_1993968763653877761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_revenue])/SUM([commission_base])' />
            </column>
            <column caption='Seamless Order Percentage' datatype='real' name='[Calculation_218706109238800384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([seamless_orders])/SUM([seamless_gross_orders_demominator])' />
            </column>
            <column caption='Refund Order Percentage' datatype='real' name='[Calculation_218706109249470465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_with_refunds])/SUM([gross_orders])' />
            </column>
            <column caption='Voucher Order Percentage' datatype='real' name='[Calculation_2254896088290586626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_voucher_orders])/SUM([valid_orders])' />
            </column>
            <column caption='Vendor Offlining %' datatype='real' name='[Calculation_2254896088321216517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_unavailable_seconds])/SUM([total_open_seconds])' />
            </column>
            <column caption='UTR - Units' datatype='real' name='[Calculation_2301902414725214208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([picked_units])/SUM([shopper_manhours])' />
            </column>
            <column caption='Display (Parameter Controlled)' datatype='string' name='[Calculation_2375085885029650432]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Account Manager (Shops Only)&quot; THEN [account_manager_name]&#13;&#10;WHEN &quot;Vertical Segment (Shops Only)&quot; THEn [vertical_segment]&#13;&#10;WHEN &quot;Chain (Shops Only)&quot; THEN [chain_name]&#13;&#10;WHEN &quot;Dmart/Franchise/Shops&quot; THEN [vertical]&#13;&#10;WHEN &quot;QCommerce&quot; THEN &quot;QCommerce&quot;&#13;&#10;WHEN &quot;Dmart/Shops&quot; THEN IF [vertical] = &quot;shops&quot; THEN &quot;shops&quot; ELSE &quot;dmart&quot; END&#13;&#10;END' />
            </column>
            <column caption='% SFR' datatype='real' name='[Calculation_3243717667671371776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sfr_orders])/SUM([total_valid_orders_sfr])' />
            </column>
            <column caption='Assortment Coverage (Shops)' datatype='real' name='[Calculation_470344700545966080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF sum([sku_target_vendors]) = 0 THEN 0 ELSE SUM([vendors_meeting_sku_criteria])/sum([sku_target_vendors]) END' />
            </column>
            <column caption='Pro Adjusted DF Per Order (Excl. Tax)' datatype='real' name='[Delivery Fee Per Order (Incl. Tax) (copy)_2145402319947333634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pro_adjusted_delivery_fee_excl_tax])/SUM([valid_orders])' />
            </column>
            <column caption='Wrong/Missing Items IR' datatype='real' name='[Food Quality IR (copy)_2254896088287555585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_with_missing_wrong_incidents])/SUM([valid_orders])' />
            </column>
            <column caption='ICPO (QCommerce)' datatype='real' name='[ICPO (Excl. CX Vouchers) (copy)_2145402319875092481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voucher_amount_foodpanda_excl_cx])/SUM([valid_orders])' />
            </column>
            <column caption='Rider Dispatch Time' datatype='real' name='[Packing Time (copy)_168885023914991625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_dispatch_time_in_sec])/SUM([valid_orders])/60' />
            </column>
            <column caption='Assignment Time' datatype='real' name='[Pelican Delay (copy)_168885023914151942]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([assignment_time_in_sec])/SUM([valid_orders])/60' />
            </column>
            <column caption='Ops-Controlled Delivery Time' datatype='real' name='[Picking &amp; Packing Time (copy)_2001850072556593152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pick_pack_time_in_sec]+[assignment_time_in_sec])/SUM([valid_orders])/60' />
            </column>
            <column caption='Picking &amp; Packing Time' datatype='real' name='[Picking Time (copy)_168885023915360266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pick_pack_time_in_sec])/SUM([valid_orders])/60' />
            </column>
            <column caption='Post Delivery IR (Distinct CCRs)' datatype='real' name='[Post Delivery IR (Orders) (copy)_3134786876851638272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([number_of_ccr2s])/SUM([gross_orders])' />
            </column>
            <column caption='Food Quality IR' datatype='real' name='[Post Delivery IR (copy)_2254896088287453184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_with_food_quality_incidents])/SUM([valid_orders])' />
            </column>
            <column caption='Ultra Fresh Penetration (Catalog)' datatype='real' name='[Ultra Fresh Penetration (copy)_1152358610226647040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ultra_fresh_actual_gfv_with_vat])/SUM([gfv_with_vat])' />
            </column>
            <column caption='Pro Order Percentage (Free DF)' datatype='real' name='[Voucher Order Percentage (copy)_2254896088308916227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_pro_orders])/SUM([valid_orders])' />
