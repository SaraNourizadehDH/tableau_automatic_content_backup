        <field-sort-custom-order field='Weighted Availability (copy)_3134786876854775809' />
        <field-sort-custom-order field='mCVR2 (copy)_251357188189360130' />
        <field-sort-custom-order field='mCVR3 (copy)_251357188189810691' />
        <field-sort-custom-order field='mCVR3a (copy)_251357188190007300' />
        <field-sort-custom-order field='mCVR3b (copy)_251357188190420997' />
