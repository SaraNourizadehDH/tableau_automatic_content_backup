      <column caption='Front Margin' datatype='real' name='[Calculation_1993968763642523648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([margin_amount])/SUM([gfv_without_vat])' />
      </column>
      <column caption='ECR' datatype='real' name='[Calculation_1993968763653877761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission_revenue])/SUM([commission_base])' />
      </column>
      <column caption='NC Subsidy (% of GMV)' datatype='real' name='[Calculation_213076608721223680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nc_subsidy])/SUM([nc_gmv])' />
      </column>
      <column caption='MAU Penetration' datatype='real' name='[Calculation_213076608734597121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_of_ds_customers_in_delivery_area])/SUM([num_of_customers_in_vendor_delivery_area])' />
      </column>
      <column caption='Seamless Order Percentage' datatype='real' name='[Calculation_218706109238800384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([seamless_orders])/SUM([seamless_gross_orders_demominator])' />
      </column>
      <column caption='Refund Order Percentage' datatype='real' name='[Calculation_218706109249470465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_with_refunds])/SUM([gross_orders])' />
      </column>
      <column caption='Discount Order Percentage' datatype='real' name='[Calculation_218706109284524034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([valid_discount_orders])/SUM([valid_orders])' />
      </column>
      <column caption='Ultra Fresh Penetration (PIM)' datatype='real' name='[Calculation_2211267469788041216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ultra_fresh_gfv_with_vat])/SUM([gfv_with_vat])' />
      </column>
      <column caption='Voucher Order Percentage' datatype='real' name='[Calculation_2254896088290586626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([valid_voucher_orders])/SUM([valid_orders])' />
      </column>
      <column caption='Vendor Offlining %' datatype='real' name='[Calculation_2254896088321216517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_unavailable_seconds])/SUM([total_open_seconds])' />
      </column>
      <column caption='UTR - Units' datatype='real' name='[Calculation_2301902414725214208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([picked_units])/SUM([shopper_manhours])' />
      </column>
      <column caption='Display (Parameter Controlled)' datatype='string' name='[Calculation_2375085885029650432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Account Manager (Shops Only)&quot; THEN [account_manager_name]&#13;&#10;WHEN &quot;Vertical Segment (Shops Only)&quot; THEn [vertical_segment]&#13;&#10;WHEN &quot;Chain (Shops Only)&quot; THEN [chain_name]&#13;&#10;WHEN &quot;Dmart/Franchise/Shops&quot; THEN [vertical]&#13;&#10;WHEN &quot;QCommerce&quot; THEN &quot;QCommerce&quot;&#13;&#10;WHEN &quot;Dmart/Shops&quot; THEN IF [vertical] = &quot;shops&quot; THEN &quot;shops&quot; ELSE &quot;dmart&quot; END&#13;&#10;END' />
      </column>
      <column caption='CVR (Transactions)' datatype='real' name='[Calculation_251357188184416256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([menu_n_transaction_sessions])/SUM([menu_sessions])' />
      </column>
      <column caption='mCVR2' datatype='real' name='[Calculation_251357188188819457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([list_n_menu_sessions])/SUM([list_sessions])' />
      </column>
      <column caption='Tiers' datatype='string' name='[Calculation_3026981967752175616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [city_name] = &quot;Karachi&quot; &#13;&#10;   OR [city_name] = &quot;Lahore&quot; &#13;&#10;   OR [city_name] = &quot;Islamabad&quot; &#13;&#10;   OR [city_name] = &quot;Rawalpindi&quot; &#13;&#10;   OR [city_name] = &quot;Hyderabad&quot; THEN &quot;Tier 1&quot;&#13;&#10;ELSE &quot;Tier 2&quot;&#13;&#10;END' />
      </column>
      <column caption='% SFR' datatype='real' name='[Calculation_3243717667671371776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sfr_orders])/SUM([total_valid_orders_sfr])' />
      </column>
      <column caption='Assortment Coverage (Shops)' datatype='real' name='[Calculation_470344700545966080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF sum([sku_target_vendors]) = 0 THEN 0 ELSE SUM([vendors_meeting_sku_criteria])/sum([sku_target_vendors]) END' />
      </column>
      <column caption='GMV Subsidized by Discount (%)' datatype='real' name='[Calculation_737464455158390784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([discount_amount])/SUM([gmv])' />
      </column>
      <column caption='Vendors Meeting SKU Criteria' datatype='real' name='[Calculation_737464455161155586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendors_meeting_sku_criteria])/COUNTD([created_date_local])' />
      </column>
      <column caption='Assortment Counted (Month)' datatype='real' name='[Calculation_737464455172804611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([distinct_skus_counted_month])/SUM([distinct_skus_on_hand_month_end])' />
      </column>
      <column caption='Vertical_orders' datatype='integer' name='[Calculation_8612360259052744712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [vertical],[created_date_local] : SUM([valid_orders]) }' />
      </column>
      <column caption='Weightage_offline' datatype='real' name='[Calculation_8612360259054223369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(([valid_orders]/[Calculation_8612360259052744712])*([total_unavailable_seconds])/([total_open_seconds]))' />
      </column>
      <column caption='Pro Adjusted DF Per Order (Excl. Tax)' datatype='real' name='[Delivery Fee Per Order (Incl. Tax) (copy)_2145402319947333634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_adjusted_delivery_fee_excl_tax])/SUM([valid_orders])' />
      </column>
      <column caption='Shopper Delay' datatype='real' name='[Delivery Time (copy)_168885023913168900]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shopper_delay_time_in_sec])/SUM([valid_orders])/60' />
