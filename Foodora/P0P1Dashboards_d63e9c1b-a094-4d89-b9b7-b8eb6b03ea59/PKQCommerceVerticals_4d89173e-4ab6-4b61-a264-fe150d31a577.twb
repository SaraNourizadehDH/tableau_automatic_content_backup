            <column caption='ICPO (Excl. Compensation)' datatype='real' name='[ICPO (Overall) (copy)_2145402319874826240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voucher_amount_excl_cx])/SUM([valid_orders])' />
            </column>
            <column caption='Rider Dispatch Time' datatype='real' name='[Packing Time (copy)_168885023914991625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_dispatch_time_in_sec])/SUM([valid_orders])/60' />
