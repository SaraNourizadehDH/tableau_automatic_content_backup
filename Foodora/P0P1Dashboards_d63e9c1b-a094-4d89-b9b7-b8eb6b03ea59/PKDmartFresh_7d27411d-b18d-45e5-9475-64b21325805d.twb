    <worksheet name='DOD Peak hours'>
      <table>
        <view>
          <datasources>
            <datasource caption='Dmart Fresh' name='federated.07pys0m1uam3no1fttscs1okcr5j' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Data Split' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07pys0m1uam3no1fttscs1okcr5j'>
            <column caption='Fulfillment Rate' datatype='real' name='[Calculation_1321806528096505858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([received_quantity])/SUM([requested_quantity])' />
            </column>
            <column caption='Conventional Availability' datatype='real' name='[Calculation_1321806528097951747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([available_hours])/SUM([total_hours])' />
            </column>
            <column caption='Weighted Availability' datatype='real' name='[Calculation_2031686420076875776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([available_events_weightage] * sales_forecast_quantity) / SUM(total_events_weightage * sales_forecast_quantity)' />
            </column>
            <column caption='Split' datatype='string' name='[Calculation_2622783885996556290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#13;&#10;WHEN &quot;City&quot; THEN [city]&#13;&#10;WHEN &quot;Store&quot; THEN [dmart_imt_warehouse_name]&#13;&#10;END' />
            </column>
            <column caption='WA_peak_hours' datatype='real' name='[Calculation_678917697212698625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sales_forecast_quantity (Custom SQL Query1)]* [available_events_weightage (Custom SQL Query1)]) / sum([sales_forecast_quantity (Custom SQL Query1)]* [total_events_weightage (Custom SQL Query1)])' />
            </column>
            <column caption='CA Peak Hours' datatype='real' name='[Calculation_678917697214775298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([available_hours (Custom SQL Query1)])/sum([potential_hours])' />
            </column>
            <column caption='Valid_Orders' datatype='integer' name='[Calculation_692147026028036096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([orders])' />
            </column>
            <column datatype='real' name='[available_events_weightage (Custom SQL Query1)]' role='measure' type='quantitative' />
            <column datatype='real' name='[available_events_weightage]' role='measure' type='quantitative' />
            <column datatype='integer' name='[available_hours (Custom SQL Query1)]' role='measure' type='quantitative' />
