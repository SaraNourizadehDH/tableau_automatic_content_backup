)
   -- and dmart__product_report.vendor_code IN ('khdw', 'yq19', 'dk6y', 'py9s', 'qjk4', 'clnz', 'bzpb', 'i75l', 'a7z5', 'x7oi', 'h2pd', 'ou6m', 'k5ty', 'zj7v', 'ays9', 'ts87', 'r1vf', 'h1ei', 'i0ma', 'l4gg', 'p3ag', 'wqke', 'z1uc', 'uj14', 'ig91', 'qp5h', 'hd4q', 'ecs5', 'j19g', 'o24t', 'qx1u', 'sx92', 'rxz8', 'dcu3', 'h8wc', 'jm8m', 'd74x', 'lxyu', 'as98', 'btqk', 'fp8x', 'cntt', 'sik4', 'e02v', 'qbfo', 'atmx', 'o13e', 'ayqd', 'kmci','hpkd','n5c6')

   and dmart__product_report.vendor_code IN ('d74x','r1vf','fp8x','a7z5','qjk4','h1ei','o24t','btqk','i75l','dcu3','yq19','sx92',
'z1uc','ig91','i0ma','lxyu','wqke','h8wc','qx1u','l4gg','p3ag','k5ty','dk6y','ays9','khdw','clnz','ts87','jm8m','atmx','n5c6','kmci','hpkd','ayqd','o13e')
    
  QUALIFY ROW_NUMBER() OVER (PARTITION BY sku, dmart_imt_warehouse_uuid) = 1
),
pre_n_1_WA AS (
  SELECT
    global_entity_id,
    warehouse_id,
    sku,
    period_day,
    MAX(sku_status) AS sku_status,
    MAX(sales_forecast_quantity) AS sales_forecast_quantity,
    SUM(available_hourly) AS available_hours,
    SUM(potential_hours) AS potential_hours,
    SUM(available_hourly * hourly_events_weightage) AS available_events_weightage,
    SUM(hourly_events_weightage ) AS total_events_weightage
  FROM
    `fulfillment-dwh-production.curated_data_shared_dmart.availability_data`
  WHERE
    TRUE
    AND global_entity_id = 'FP_PK'
    AND ((period_day >>= status_implementation_date
        AND sku_status IN ('ACTIVE',
          'ON_HOLD')
        AND is_stale IS FALSE)
      OR (((period_day << status_implementation_date)
          OR (status_implementation_date IS NULL))
        AND is_active
        AND is_stale IS FALSE))
    AND store_open = 1
    AND period_day >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH)
   -- AND period_day = (CASE
   --     WHEN EXTRACT (hour FROM current_time) >>= 4 THEN current_date-1
   --     ELSE NULL
   -- END
   --   )
  GROUP BY
    ALL ),
-- Get actual n-1 WA --
  n_1_WA AS(
  SELECT
    global_entity_id,
    warehouse_id,
    sku,
    period_day,
    sku_status,
    sales_forecast_quantity,
    available_hours,
    potential_hours,
    available_events_weightage,
    total_events_weightage from
    pre_n_1_WA
  GROUP BY
    ALL
  ORDER BY
    sales_forecast_quantity desc),

fulfillment AS (
  SELECT
    DATE(status_modified_at_local) received_date_local,
    sku,
    destination_warehouse_uuid,
    SUM(requested_quantity) AS requested_quantity,
    SUM(picked_quantity) AS picked_quantity,
    SUM(received_quantity) AS received_quantity 
  FROM `fulfillment-dwh-production.pandata_report.dmart__store_transfer_report` as st
  WHERE st.global_entity_id = 'FP_PK'
    AND DATE(status_modified_at_local) >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH)
    AND origin_warehouse_name in ('Pandamart - Platform (KHI)',	'Pandamart - Platform (LHR)',	'Pandamart - I9 (Platform) (ISB)')
    AND latest_status IN ("COMPLETED", "")
  GROUP BY
    received_date_local,
    sku,
    destination_warehouse_uuid
),

shirinkage AS (
  SELECT
    dmart_imt_warehouse_uuid,
    sku,
    created_date_local,
    SUM(
      CASE
        WHEN inventory_adjustment_reason = "Store Expired" THEN on_hand_qty_delta
        ELSE NULL
      END
    ) AS expired_quantity,
    SUM(
      CASE
        WHEN inventory_adjustment_reason = "Store Expired" THEN wac_local * on_hand_qty_delta 
        ELSE NULL
      END
    ) AS expired_amount_local,
    SUM(
      CASE
        WHEN inventory_adjustment_reason = "Donation" THEN on_hand_qty_delta
        ELSE NULL
      END
    ) AS donation_quantity,
    SUM(
      CASE
        WHEN inventory_adjustment_reason = "Donation" THEN wac_local * on_hand_qty_delta 
        ELSE NULL
      END
    ) AS donation_amount_local

  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__inventory_movements_report` 
  WHERE created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH)
    AND global_entity_id = "FP_PK"
    AND inventory_adjustment_reason IN ("Donation", "Store Expired")
  GROUP BY
    dmart_imt_warehouse_uuid,
    sku,
    created_date_local
),

sales AS (
  SELECT 
   count (distinct order_code) AS orders,
    order_date_local,
    customer_order_line_report.dmart_imt_warehouse_uuid,
    customer_order_line_report.sku,
    ANY_VALUE(subcategory_english) AS category,
    ANY_VALUE(subcategory_english) AS subcategory,
     ANY_VALUE(master_category_one) AS master_cat_one,
    ANY_VALUE(master_category_two) AS master_cat_two,
    ANY_VALUE(product_title_english) AS product_name,
    ANY_VALUE(vendor_name) AS dmart_imt_warehouse_name,
    COUNT(DISTINCT customer_id) AS customers,
    SUM(received_quantity) AS units_sold,
    SUM(received_quantity * unit_price_paid_local) AS gfv,
    ANY_VALUE(whms.warehouse_manager) AS warehouse_manager,
    ANY_VALUE(whms.cluster_lead) AS cluster_lead,
    ANY_VALUE(whms.ultra_fresh_handler) AS ultra_fresh_handler,
    ANY_VALUE(whms.chess) AS chess

  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__customer_order_line_report_v2` AS customer_order_line_report
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_gsheet_dmart_ops_managers` AS whms
         ON whms.vendor_code = customer_order_line_report.vendor_code
  INNER JOIN products
          ON products.sku = customer_order_line_report.sku
         AND products.dmart_imt_warehouse_uuid = customer_order_line_report.dmart_imt_warehouse_uuid

  WHERE TRUE
    AND customer_order_line_report.order_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH)
    AND customer_order_line_report.global_entity_id = "FP_PK"
    AND is_successful
    --AND LOWER(vendor_name) NOT LIKE "%mominpura%"

  GROUP BY
    ALL

)


SELECT
   
  COALESCE(date_range.date_local, sales.order_date_local) AS date_local,
  EXTRACT(DAYOFWEEK FROM COALESCE(date_range.date_local, sales.order_date_local) - 1) AS day_number,
  FORMAT_DATE('%A', COALESCE(date_range.date_local, sales.order_date_local)) AS day_name,
  CASE
    WHEN COALESCE(date_range.date_local, sales.order_date_local) = CURRENT_DATE() - 1 THEN TRUE
    ELSE FALSE
  END AS is_yesterday,
    CASE
    WHEN COALESCE(date_range.date_local, sales.order_date_local) = CURRENT_DATE() - 8 THEN TRUE
    ELSE FALSE
  END AS is_last_week_day,
  -- CASE
  --   WHEN DATE_DIFF(COALESCE(date_range.date_local, sales.ordered_date_local), DATE_TRUNC(CURRENT_DATE("Asia/Karachi") - 1, WEEK(MONDAY)), DAY) >>= 0 THEN TRUE
  --   ELSE FALSE
  -- END AS this_week,
  CASE
    WHEN DATE_DIFF(COALESCE(date_range.date_local, sales.order_date_local), DATE_TRUNC(CURRENT_DATE("Asia/Karachi") - 1, MONTH), DAY) >>= 0 THEN TRUE
    ELSE FALSE
  END AS this_month,
  -- CASE
  --   WHEN DATE_DIFF(COALESCE(date_range.date_local, sales.ordered_date_local), DATE_TRUNC(CURRENT_DATE("Asia/Karachi") - 1, WEEK(MONDAY)), DAY) << 0 
  --    AND EXTRACT(DAYOFWEEK FROM COALESCE(date_range.date_local, sales.ordered_date_local) - 1) <<= EXTRACT(DAYOFWEEK FROM CURRENT_DATE("Asia/Karachi") - 2)
  --   THEN TRUE
  --   ELSE FALSE
  -- END AS last_week,
  CASE
    WHEN DATE_DIFF(DATE_TRUNC(COALESCE(date_range.date_local, sales.order_date_local), MONTH), DATE_TRUNC(CURRENT_DATE("Asia/Karachi") - 1, MONTH), MONTH) = -1 
     AND EXTRACT(DAY FROM COALESCE(date_range.date_local, sales.order_date_local)) <<= EXTRACT(DAY FROM CURRENT_DATE("Asia/Karachi") - 1)
    THEN TRUE
    ELSE FALSE
  END AS last_month,
  COALESCE(products.sku, sales.sku) AS sku,
  COALESCE(products.product_name, sales.product_name) AS product_name,
  COALESCE(products.category, sales.category, CONCAT("Catalog: ", "Active"), "Deleted from Supplier Portal") AS category,
  COALESCE(products.subcategory, sales.subcategory, CONCAT("Catalog: ", "Active"), "Deleted from Supplier Portal") AS subcategory,
  COALESCE(products.category, master_cat_one, CONCAT("Catalog: ", "Active"), "Deleted from Supplier Portal") AS master_category,
  COALESCE(products.subcategory, master_cat_one, CONCAT("Catalog: ", "Active"), "Deleted from Supplier Portal") AS master_subcategory,
  products.status AS catalog_status,
  COALESCE(city.dmart_imt_warehouse_name, products.dmart_imt_warehouse_name) AS dmart_imt_warehouse_name,
  COALESCE(products.warehouse_manager, sales.warehouse_manager) AS warehouse_manager,
  COALESCE(products.cluster_lead, sales.cluster_lead) AS cluster_lead,
  COALESCE(products.ultra_fresh_handler, sales.ultra_fresh_handler) AS ultra_fresh_handler,
  COALESCE(products.chess, sales.chess) AS chess,
  COALESCE(products.dmart_imt_warehouse_uuid, city.dmart_imt_warehouse_uuid) AS dmart_imt_warehouse_uuid,
  COALESCE(products.city, city.city) AS city,
  n_1_WA.sales_forecast_quantity,
  n_1_WA.available_events_weightage,
  n_1_WA.total_events_weightage,
  n_1_WA.available_hours,
  n_1_WA.potential_hours as total_hours,
  COALESCE(sales.units_sold, 0) AS units_sold,
  COALESCE(sales.gfv, 0) AS gfv,
  COALESCE(sales.orders, 0) AS orders,
  COALESCE(sales.customers, 0) AS customers,
  COALESCE(requested_quantity, 0) AS requested_quantity,
  COALESCE(picked_quantity, 0) AS picked_quantity,
  COALESCE(received_quantity, 0) AS received_quantity,
  COALESCE(expired_quantity, 0) AS expired_quantity,
  COALESCE(expired_amount_local, 0) AS expired_amount_local,
  COALESCE(donation_quantity, 0) AS donation_quantity,
  COALESCE(donation_amount_local, 0) AS donation_amount_local
FROM products
CROSS JOIN date_range
FULL OUTER JOIN sales
             ON products.sku = sales.sku 
            AND products.dmart_imt_warehouse_uuid = sales.dmart_imt_warehouse_uuid
            AND date_range.date_local = sales.order_date_local
LEFT JOIN city
       ON sales.dmart_imt_warehouse_uuid = city.dmart_imt_warehouse_uuid
LEFT JOIN n_1_WA
       ON COALESCE(products.sku, sales.sku) = n_1_WA.sku
      AND COALESCE(products.dmart_imt_warehouse_uuid, city.dmart_imt_warehouse_uuid) = n_1_WA.warehouse_id
      AND COALESCE(date_range.date_local, sales.order_date_local) = n_1_WA.period_day
--LEFT JOIN availability
--       ON COALESCE(products.sku, sales.sku) = availability.sku
--      AND COALESCE(products.dmart_imt_warehouse_uuid, city.dmart_imt_warehouse_uuid) = availability.dmart_imt_warehouse_uuid
--      AND COALESCE(date_range.date_local, sales.order_date_local) = availability.date_local
LEFT JOIN fulfillment
       ON COALESCE(products.sku, sales.sku) = fulfillment.sku
      AND COALESCE(products.dmart_imt_warehouse_uuid, city.dmart_imt_warehouse_uuid) = fulfillment.destination_warehouse_uuid
      AND COALESCE(date_range.date_local, sales.order_date_local) = fulfillment.received_date_local
LEFT JOIN shirinkage
       ON COALESCE(products.sku, sales.sku) = shirinkage.sku
      AND COALESCE(products.dmart_imt_warehouse_uuid, city.dmart_imt_warehouse_uuid) = shirinkage.dmart_imt_warehouse_uuid
      AND COALESCE(date_range.date_local, sales.order_date_local) = shirinkage.created_date_local]]></relation>
          <relation connection='bigquery.0xwlsf70obb8s71f5cj1p13lxd8c' name='Custom SQL Query1' type='text'><![CDATA[with pre_n_1_WA AS (
  SELECT
    global_entity_id,
    warehouse_id,
    sku,
    period_day,
    hour,
    MAX(sku_status) AS sku_status,
    MAX(sales_forecast_quantity) AS sales_forecast_quantity,
    SUM(available_hourly) AS available_hours,
    SUM(potential_hours) AS potential_hours,
    SUM(available_hourly * hourly_events_weightage) AS available_events_weightage,
    SUM(hourly_events_weightage ) AS total_events_weightage
  FROM
    `fulfillment-dwh-production.curated_data_shared_dmart.availability_data`
  WHERE
    TRUE
    AND global_entity_id = 'FP_PK'
    AND ((period_day >>= status_implementation_date
        AND sku_status IN ('ACTIVE',
          'ON_HOLD')
        AND is_stale IS FALSE)
      OR (((period_day << status_implementation_date)
          OR (status_implementation_date IS NULL))
        AND is_active
        AND is_stale IS FALSE))
    AND store_open = 1
    AND period_day >>= current_date()-14
    and hour >>= 12
    and hour << 17
     --Duration FOR analysis
    --AND period_day = (CASE
    --    WHEN EXTRACT (hour FROM current_time) >>= 4 THEN current_date-1
    --    ELSE NULL
    --END
    --  )
  GROUP BY
    ALL ),
-- Get actual n-1 WA --
  n_1_WA AS(
  SELECT
    global_entity_id,
    warehouse_id,
    sku,
    period_day,
    hour,
    sku_status,
    sales_forecast_quantity,
    available_hours,
    potential_hours,
    available_events_weightage,
    total_events_weightage
    --SAFE_DIVIDE(SUM(available_hours), SUM(potential_hours)) AS availability,
    --SUM(available_events_weightage * sales_forecast_quantity) AS available_weightage,
    --SUM(total_events_weightage * sales_forecast_quantity) AS weightage,
    --SAFE_DIVIDE(SUM(available_events_weightage * sales_forecast_quantity), SUM(total_events_weightage * sales_forecast_quantity)) AS WA
  FROM
    pre_n_1_WA
  GROUP BY
    ALL
  ORDER BY
    sales_forecast_quantity desc)
    select * from n_1_WA where
     sku in (
"qjk4-5",
"167733",
"2LV190",
"LZ1V7M",
"qjk4-8",
"YJV022",
"B435OL",
"B3EM91",
"WCPMMX",
"44Z79F",
"0T39JL",
"NU7B0U",
"LZ6PB6",
"U9KL02",
"D40859",
"BC9G2O",
