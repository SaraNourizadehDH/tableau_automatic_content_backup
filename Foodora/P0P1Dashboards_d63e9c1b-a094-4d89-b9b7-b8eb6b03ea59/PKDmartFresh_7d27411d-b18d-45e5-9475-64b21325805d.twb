      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Dmart Fresh' id='_ABCE8E6D215C46CDA6AE9361042400B9'>
            <properties context=''>
              <relation connection='bigquery.0xwlsf70obb8s71f5cj1p13lxd8c' name='Custom SQL Query' type='text'><![CDATA[WITH date_range AS (
  SELECT 
    date_local
  FROM
    UNNEST(
      GENERATE_DATE_ARRAY(
        DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH), MONTH),
        CURRENT_DATE("Asia/Karachi") - 1,
        INTERVAL 1 DAY
      )
    ) AS date_local
),

warehouse_info AS (
  SELECT
    dmart_warehouses.warehouse_id AS dmart_imt_warehouse_uuid,
    vendors.platform_vendor_id AS vendor_code,
    dmart_warehouses.name AS dmart_imt_warehouse_name,
    RIGHT(dmart_warehouses.name, 5) AS cityedit
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.warehouses_v2` AS dmart_warehouses
  LEFT JOIN UNNEST(vendors) AS vendors
  WHERE dmart_warehouses.global_entity_id = "FP_PK"
    AND dmart_warehouses.warehouse_id IS NOT NULL
),

city AS (
  SELECT
    dmart_imt_warehouse_uuid,
    dmart_imt_warehouse_name,
    CASE
      WHEN LOWER(dmart_imt_warehouse_name) LIKE "%business%" THEN "Business"
      WHEN LOWER(dmart_imt_warehouse_name) LIKE "%corporate%" THEN "Corporate"
      WHEN cityedit = "(KHI)" THEN "Karachi"
      WHEN cityedit = "(HYD)" THEN "Karachi"
      WHEN cityedit = "(ISB)" THEN "Islamabad"
      WHEN cityedit = "(RWP)" THEN "Islamabad"
      WHEN cityedit = "(LHR)" THEN "Lahore"
      ELSE "Other"
    END AS city
  FROM warehouse_info
),

supplier_portal_active AS (
  SELECT
    sku,
    name,
    warehouses.warehouse_id AS dmart_imt_warehouse_uuid,
    supplier_id,
    supplier_name,
    sku_supplier_status,
    sku_supplier_warehouse_status,
    is_supplier_deleted,
    product_deleted_at,
    price_deleted_at
  FROM `fulfillment-dwh-production.curated_data_shared_dmart.products_suppliers`
  LEFT JOIN UNNEST (suppliers) AS suppliers
  LEFT JOIN UNNEST (suppliers.warehouses) AS warehouses
  WHERE global_entity_id = "FP_PK"
    AND price_deleted_at IS NULL
),

products AS (
  SELECT
    dmart__product_report.sku,
    dmart__product_report.dmart_imt_warehouse_uuid,
    dmart__product_report.dmart_imt_warehouse_name,
    dmart__product_report.product_title_english AS product_name,
    dmart__product_report.category_english AS category,
    dmart__product_report.subcategory_english AS subcategory,
    dmart__product_report.status,
    whms.warehouse_manager,
    whms.cluster_lead,
    whms.ultra_fresh_handler,
    whms.chess,
    city.city
  
  FROM `fulfillment-dwh-production.pandata_report.dmart__product_report` AS dmart__product_report
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_gsheet_dmart_ops_managers` AS whms
         ON whms.vendor_code = dmart__product_report.vendor_code
  LEFT JOIN city
         ON dmart__product_report.dmart_imt_warehouse_uuid = city.dmart_imt_warehouse_uuid

  WHERE dmart__product_report.global_entity_id = "FP_PK"
    --and sku = "5XZF4Q"
    AND dmart__product_report.is_active_catalog
    AND dmart__product_report.is_dmart
    AND NOT dmart__product_report.is_vendor_deleted
    AND NOT dmart__product_report.is_vendor_product_deleted
    -- AND dmart__product_report.status = "ACTIVE"
   -- AND dmart__product_report.category_english IN ("Meat, Fruits and Vegetables", "Fruits & Vegetables", "Meat & Seafood","Fresh Chicken","Fresh Discount Corner","Fresh Fruits","Fresh Herbs & Spices","Fresh Mutton","Fresh Produce","Fresh Vegetable","Fresh Vegetables","Meat","Meat & Seafood","Seafood & Meat")
   and dmart__product_report.sku IN
   (
  "qjk4-5",
"167733",
"2LV190",
"LZ1V7M",
"qjk4-8",
"YJV022",
"B435OL",
"B3EM91",
"WCPMMX",
"44Z79F",
"0T39JL",
