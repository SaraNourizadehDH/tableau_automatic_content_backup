    <worksheet name='Fresh Summary'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffd271' fontsize='14'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Dmart Fresh' name='federated.07pys0m1uam3no1fttscs1okcr5j' />
          </datasources>
          <datasource-dependencies datasource='federated.07pys0m1uam3no1fttscs1okcr5j'>
            <column caption='Price' datatype='real' name='[Calculation_1321806527111811072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(gfv)/SUM([units_sold])' />
            </column>
            <column caption='Fulfillment Rate' datatype='real' name='[Calculation_1321806528096505858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([received_quantity])/SUM([requested_quantity])' />
            </column>
            <column caption='Conventional Availability' datatype='real' name='[Calculation_1321806528097951747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([available_hours])/SUM([total_hours])' />
            </column>
            <column caption='Weighted Availability' datatype='real' name='[Calculation_2031686420076875776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([available_events_weightage] * sales_forecast_quantity) / SUM(total_events_weightage * sales_forecast_quantity)' />
            </column>
            <column caption='Shrinkage Quantity' datatype='integer' name='[Calculation_2959709430025388032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([expired_quantity])+SUM([donation_quantity])' />
            </column>
            <column caption='Shrinkage Amount' datatype='real' name='[Calculation_2959709430026371073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([donation_amount_local])+SUM([expired_amount_local])' />
            </column>
            <column caption='ST Rejection Rate' datatype='real' name='[Calculation_3907154215018569728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([picked_quantity])-SUM([received_quantity]))/SUM([picked_quantity])' />
            </column>
            <column caption='This month sale (MTD)' datatype='integer' name='[Calculation_701435681910562816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    CASE [this_month]&#13;&#10;    WHEN true THEN [units_sold]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Sales Growth (MTD)' datatype='real' name='[Calculation_701435681911013378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_701435681910562816]-[This month sale (copy)_701435681910816769])/[This month sale (copy)_701435681910816769]' />
            </column>
            <column caption='Effective Fulfillment Rate' datatype='real' name='[Fulfillment Rate (copy)_3907154215019458561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([picked_quantity])/SUM([requested_quantity])' />
            </column>
            <column caption='Last month sale (MTD)' datatype='integer' name='[This month sale (copy)_701435681910816769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    CASE [last_month]&#13;&#10;    WHEN true THEN [units_sold]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column datatype='real' name='[available_events_weightage]' role='measure' type='quantitative' />
            <column datatype='integer' name='[available_hours]' role='measure' type='quantitative' />
