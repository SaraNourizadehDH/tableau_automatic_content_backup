    <worksheet name='WOW (2)'>
      <repository-location id='WOW2' path='/t/Foodora/workbooks/PKDmartFresh' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='Dmart Fresh' name='federated.07pys0m1uam3no1fttscs1okcr5j' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Data Split' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07pys0m1uam3no1fttscs1okcr5j'>
            <column caption='Fulfillment Rate' datatype='real' name='[Calculation_1321806528096505858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([received_quantity])/SUM([requested_quantity])' />
            </column>
            <column caption='Conventional Availability' datatype='real' name='[Calculation_1321806528097951747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([available_hours])/SUM([total_hours])' />
            </column>
            <column caption='Weighted Availability' datatype='real' name='[Calculation_2031686420076875776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([available_events_weightage] * sales_forecast_quantity) / SUM(total_events_weightage * sales_forecast_quantity)' />
            </column>
            <column caption='Split' datatype='string' name='[Calculation_2622783885996556290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#13;&#10;WHEN &quot;City&quot; THEN [city]&#13;&#10;WHEN &quot;Store&quot; THEN [dmart_imt_warehouse_name]&#13;&#10;END' />
            </column>
            <column caption='Calculation1' datatype='string' name='[Calculation_3221973704735096870]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [dmart_imt_warehouse_name] = &quot;Pandamart - Paragon Franchise (LHR)&quot; &#10;   OR [dmart_imt_warehouse_name] = &quot;Pandamart - G13 Franchise (ISB)&quot; &#10;   OR [dmart_imt_warehouse_name] = &quot;Pandamart - DHA EME Franchise (LHR)&quot; &#10;   OR [dmart_imt_warehouse_name] = &quot;Pandamart - Shah Faisal Colony Franchise (KHI)&quot; &#10;   OR [dmart_imt_warehouse_name] = &quot;Pandamart - Shalimar Franchise (LHR)&quot; &#10;   OR [dmart_imt_warehouse_name] = &quot;Pandamart - Bahria Town Franchise (KHI)&quot;&#10;   THEN &quot;Franchise&quot;&#10;ELSE &quot;Dmart&quot;&#10;END' />
            </column>
            <column datatype='real' name='[available_events_weightage]' role='measure' type='quantitative' />
            <column datatype='integer' name='[available_hours]' role='measure' type='quantitative' />
            <column caption='Catalog Status' datatype='string' name='[catalog_status]' role='dimension' type='nominal' />
            <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='date' name='[date_local]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_2031686420076875776]' derivation='User' name='[diff:usr:Calculation_2031686420076875776:qk:2]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='Difference'>
                <address>
                  <value>1</value>
                </address>
              </table-calc>
            </column-instance>
            <column caption='Store' datatype='string' name='[dmart_imt_warehouse_name]' role='dimension' type='nominal' />
            <column caption='GFV' datatype='real' name='[gfv]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2622783885996556290]' derivation='None' name='[none:Calculation_2622783885996556290:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3221973704735096870]' derivation='None' name='[none:Calculation_3221973704735096870:nk]' pivot='key' type='nominal' />
            <column-instance column='[catalog_status]' derivation='None' name='[none:catalog_status:nk]' pivot='key' type='nominal' />
