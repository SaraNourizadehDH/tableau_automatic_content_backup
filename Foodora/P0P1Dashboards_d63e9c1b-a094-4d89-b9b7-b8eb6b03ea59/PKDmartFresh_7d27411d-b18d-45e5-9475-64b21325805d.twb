      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.07pys0m1uam3no1fttscs1okcr5j].[diff:usr:Calculation_2031686420076875776:qk:2]&quot;' value='% Change WA' />
          <alias key='&quot;[federated.07pys0m1uam3no1fttscs1okcr5j].[pcdf:sum:gfv:qk:2]&quot;' value='% Change in GFV' />
          <alias key='&quot;[federated.07pys0m1uam3no1fttscs1okcr5j].[pcdf:sum:units_sold:qk:2]&quot;' value='% Change Units Sold' />
          <alias key='&quot;[federated.07pys0m1uam3no1fttscs1okcr5j].[pcdf:usr:Calculation_692147026028036096:qk:2]&quot;' value='% Change Orders' />
          <alias key='&quot;[federated.07pys0m1uam3no1fttscs1okcr5j].[usr:Calculation_678917697212698625:qk]&quot;' value='WA Peak Hours' />
          <alias key='&quot;[federated.07pys0m1uam3no1fttscs1okcr5j].[usr:Calculation_692147026028036096:qk]&quot;' value='Valid Orders' />
        </aliases>
      </column>
      <column caption='Price' datatype='real' name='[Calculation_1321806527111811072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(gfv)/SUM([units_sold])' />
      </column>
      <column caption='Fulfillment Rate' datatype='real' name='[Calculation_1321806528096505858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([received_quantity])/SUM([requested_quantity])' />
      </column>
      <column caption='Conventional Availability' datatype='real' name='[Calculation_1321806528097951747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([available_hours])/SUM([total_hours])' />
      </column>
      <column caption='Weighted Availability' datatype='real' name='[Calculation_2031686420076875776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([available_events_weightage] * sales_forecast_quantity) / SUM(total_events_weightage * sales_forecast_quantity)' />
      </column>
      <column caption='Split' datatype='string' name='[Calculation_2622783885996556290]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#13;&#10;WHEN &quot;City&quot; THEN [city]&#13;&#10;WHEN &quot;Store&quot; THEN [dmart_imt_warehouse_name]&#13;&#10;END' />
      </column>
      <column caption='Shrinkage Quantity' datatype='integer' name='[Calculation_2959709430025388032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([expired_quantity])+SUM([donation_quantity])' />
      </column>
      <column caption='Shrinkage Amount' datatype='real' name='[Calculation_2959709430026371073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([donation_amount_local])+SUM([expired_amount_local])' />
      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_3221973704735096870]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [dmart_imt_warehouse_name] = &quot;Pandamart - Paragon Franchise (LHR)&quot; &#10;   OR [dmart_imt_warehouse_name] = &quot;Pandamart - G13 Franchise (ISB)&quot; &#10;   OR [dmart_imt_warehouse_name] = &quot;Pandamart - DHA EME Franchise (LHR)&quot; &#10;   OR [dmart_imt_warehouse_name] = &quot;Pandamart - Shah Faisal Colony Franchise (KHI)&quot; &#10;   OR [dmart_imt_warehouse_name] = &quot;Pandamart - Shalimar Franchise (LHR)&quot; &#10;   OR [dmart_imt_warehouse_name] = &quot;Pandamart - Bahria Town Franchise (KHI)&quot;&#10;   THEN &quot;Franchise&quot;&#10;ELSE &quot;Dmart&quot;&#10;END' />
      </column>
      <column caption='ST Rejection Rate' datatype='real' name='[Calculation_3907154215018569728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([picked_quantity])-SUM([received_quantity]))/SUM([picked_quantity])' />
      </column>
      <column caption='WA_peak_hours' datatype='real' name='[Calculation_678917697212698625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sales_forecast_quantity (Custom SQL Query1)]* [available_events_weightage (Custom SQL Query1)]) / sum([sales_forecast_quantity (Custom SQL Query1)]* [total_events_weightage (Custom SQL Query1)])' />
      </column>
      <column caption='CA Peak Hours' datatype='real' name='[Calculation_678917697214775298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([available_hours (Custom SQL Query1)])/sum([potential_hours])' />
      </column>
      <column caption='Valid_Orders' datatype='integer' name='[Calculation_692147026028036096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([orders])' />
      </column>
      <column caption='This month sale (MTD)' datatype='integer' name='[Calculation_701435681910562816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    CASE [this_month]&#13;&#10;    WHEN true THEN [units_sold]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Sales Growth (MTD)' datatype='real' name='[Calculation_701435681911013378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_701435681910562816]-[This month sale (copy)_701435681910816769])/[This month sale (copy)_701435681910816769]' />
      </column>
      <column caption='ISO Week' datatype='integer' name='[Calculation_969962807279050754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ISOWEEK([date_local])' />
      </column>
      <column caption='Effective Fulfillment Rate' datatype='real' name='[Fulfillment Rate (copy)_3907154215019458561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([picked_quantity])/SUM([requested_quantity])' />
      </column>
      <column caption='Last month sale (MTD)' datatype='integer' name='[This month sale (copy)_701435681910816769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    CASE [last_month]&#13;&#10;    WHEN true THEN [units_sold]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
