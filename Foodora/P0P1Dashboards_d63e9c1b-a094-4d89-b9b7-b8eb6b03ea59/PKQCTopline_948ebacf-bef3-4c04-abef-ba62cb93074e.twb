              <local-type>integer</local-type>
              <aggregation>Sum</aggregation>
              <approx-count>324</approx-count>
              <contains-null>true</contains-null>
              <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_4295A31A5CA641AFA5CC3BEDFAF42E27]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
