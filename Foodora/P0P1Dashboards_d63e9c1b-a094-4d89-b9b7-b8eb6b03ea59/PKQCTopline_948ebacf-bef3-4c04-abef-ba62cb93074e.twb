        </connection>
      </extract>
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:data_level:nk]' type='palette'>
            <map to='#59a14f'>
              <bucket>&quot;Actual&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>%all%</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;Target&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Run Rate&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Pakistan&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4295A31A5CA641AFA5CC3BEDFAF42E27'>
            <properties context=''>
              <relation connection='bigquery.0oks9l30kyjrop10dqgc116p3dya' name='Custom SQL Query' type='text'><![CDATA[-- Reorder Patch shall only be used to report customer number and not any other measure
-- It will inflate other metrics like gmv, gfc etc. - Commenting the lines is recommended

WITH units_in_basket AS (
  SELECT 
    customer_order_line_report.pd_order_code,
    SUM(customer_order_line_report.received_quantity) AS units_sold
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_dmart__customer_order_line_report` AS customer_order_line_report
  WHERE customer_order_line_report.ordered_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 25 MONTH), MONTH)
    AND customer_order_line_report.global_entity_id = "FP_PK"
    AND is_valid_order
  GROUP BY 
    pd_order_code
),

subsegments AS (
  SELECT
    report_date_local AS month_local,
    global_entity_id,
    pd_customer_uuid,
    segment,
    subsegment
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_dmart_segmentation_acid`
  WHERE report_date_local <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 0 MONTH), MONTH)
    AND report_date_local >>= "2022-12-01"
    AND global_entity_id = "FP_PK"
  QUALIFY ROW_NUMBER() OVER (PARTITION BY analytical_customer_id, report_date_local) = 1
),

raw_data AS (
  SELECT
    orders.global_entity_id,
    orders.pd_customer_uuid,
    orders.order_code,
    orders.ordered_at_utc,
    orders.created_date_local,
    customer_agg.first_valid_vendor_type_order_at_utc,
    customer_agg.first_valid_order_all_at_utc,
    customers.code AS customer_code,
    DATE_TRUNC(orders.created_date_local, MONTH) AS month_local, 
    EXTRACT(MONTH FROM orders.created_date_local) AS order_month_local,
    EXTRACT(YEAR FROM orders.created_date_local) AS order_year_local,
    LOGICAL_OR(IF(orders.ordered_at_utc = customer_agg.first_valid_vendor_type_order_at_utc, TRUE, FALSE)) AS is_first_order_date_vendor_type,
    LOGICAL_OR(IF(orders.ordered_at_utc = customer_agg.first_order_all_at_utc, TRUE, FALSE)) AS is_first_order_all,
    LOGICAL_OR(vouchers.is_voucher_used) AS is_incentivised_order,
    vouchers.value_local AS voucher_spend,
    vouchers.value_local * (vouchers.attributions_foodpanda_ratio / 100) AS voucher_amount_foodpanda,
    gmv_local,
    gfv_local,
    units_in_basket.units_sold
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_qcommerce__subsidy_metrics_order_level` AS orders
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_qcommerce__customers_agg_orders_dates` AS customer_agg
        ON orders.pd_vendor_uuid = customer_agg.pd_vendor_uuid
        AND orders.pd_customer_uuid = customer_agg.pd_customer_uuid
        AND customer_agg.vendor_type = "pandamart"
  INNER JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` AS business_type
          ON orders.pd_vendor_uuid = business_type.uuid
        AND COALESCE(business_type.business_type_apac_reclassified, business_type.business_type_apac) IN ("dmart")
        AND COALESCE(business_type.date_reclassified, orders.created_date_local) <<= orders.created_date_local
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS countries
          ON orders.global_entity_id = countries.global_entity_id
        AND countries.company_name = "Foodpanda"
        AND countries.region = "Asia"
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.cus_customers` AS customers
        ON customers.uuid = orders.pd_customer_uuid
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` AS vouchers
        ON vouchers.uuid = orders.pd_order_uuid
        AND vouchers.global_entity_id = "FP_PK"
        AND CONCAT(channel, purpose) NOT IN (
          'channel_crmautocompensation_realtime', 'channel_crmcompensation', 'channel_customer_servicecompensation', 'channel_customer_servicerefund', 'channel_customer_servicesorry_panda', 'channel_onlineautocompensation_realtime', 'channel_onlinesorry_panda', 'channel_otherssorry_panda', 'channel_subsidiessorry_panda')
  LEFT JOIN units_in_basket
        ON units_in_basket.pd_order_code = orders.order_code
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
        ON pd_orders.code = orders.order_code
        AND pd_orders.global_entity_id = "FP_PK"
        AND pd_orders.created_date_utc >>= DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 25 MONTH), MONTH), INTERVAL 1 DAY)
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vendor_info
           ON vendor_info.vendor_code = pd_orders.vendor_code
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_mkt.braze_external_id_map` AS braze
        ON CONCAT(SPLIT(orders.pd_customer_uuid, "_")[SAFE_OFFSET(2)], "_", SPLIT(orders.pd_customer_uuid, "_")[SAFE_OFFSET(0)]) = braze.external_id

  WHERE orders.created_date_utc >>= DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 25 MONTH), MONTH), INTERVAL 1 DAY)
    AND orders.created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 25 MONTH), MONTH)
    AND orders.created_date_local <<= CURRENT_DATE()
    AND orders.is_valid_order
    AND orders.global_entity_id = "FP_PK"
    AND vendor_info.vertical IN ("darkstores")     
    AND LOWER(COALESCE(vendor_info.vendor_name)) NOT LIKE "%business%"
    AND LOWER(COALESCE(vendor_info.vendor_name)) NOT LIKE "%corporate%"
    AND LOWER(COALESCE(vendor_info.vendor_name)) NOT LIKE "%pantry%"
    AND LOWER(COALESCE(vendor_info.vendor_name)) NOT LIKE "%odr%"
    AND LOWER(COALESCE(vendor_info.vendor_name)) NOT LIKE "%export%"
  GROUP BY
    orders.global_entity_id,
    orders.pd_customer_uuid,
    customer_code,
    orders.order_code,
    month_local,
    order_month_local,
    order_year_local,
    voucher_spend,
    ordered_at_utc,
    first_valid_vendor_type_order_at_utc,
    first_valid_order_all_at_utc,
    gmv_local,
    gfv_local,
    created_date_local,
    units_sold,
    vouchers.attributions_foodpanda_ratio
),

raw_data_for_reorder AS (
  SELECT
    raw_data.*,
    -- IF(reorders.created_date_local IS NOT NULL, TRUE, FALSE) AS is_30d_reorder 
  FROM raw_data
  -- LEFT JOIN raw_data AS reorders
  --        ON raw_data.pd_customer_uuid = reorders.pd_customer_uuid
  --       AND reorders.created_date_local >> raw_data.created_date_local
  --       AND reorders.created_date_local <<= DATE_ADD(raw_data.created_date_local, INTERVAL 30 DAY)
),

monthly_customer_level AS (
  SELECT
    raw_data_for_reorder.pd_customer_uuid,
    customer_code,
    raw_data_for_reorder.month_local,
    order_month_local,
    order_year_local,
    COUNT(DISTINCT order_code) AS orders,
    COUNT(DISTINCT IF(voucher_spend >> 0, order_code, NULL)) AS voucher_orders,
    IF(LOGICAL_OR(is_first_order_date_vendor_type), "NC", "EC") AS customer_type,
    -- IF(LOGICAL_OR(is_first_order_date_vendor_type), IF(LOGICAL_OR(is_first_order_all), "NCP", "NCV"), "EC") AS customer_type_detailed,
    CASE 
      WHEN LOGICAL_OR(IF(ordered_at_utc = first_valid_vendor_type_order_at_utc, TRUE, FALSE)) 
      AND NOT LOGICAL_OR(IF(ordered_at_utc = first_valid_order_all_at_utc, TRUE, FALSE)) 
      THEN "NCV" -- to check with first_order_dmart
      WHEN LOGICAL_OR(IF(ordered_at_utc = first_valid_vendor_type_order_at_utc, TRUE, FALSE)) 
      AND LOGICAL_OR(IF(ordered_at_utc = first_valid_order_all_at_utc, TRUE, FALSE)) 
      THEN "NCP"
      -- condition for weekly_shoppers
      WHEN subsegments.subsegment = "Weekly Shoppers" THEN "EC - Weekly Shoppers"
      ELSE "EC - Other"
    END AS customer_type_detailed,
    -- LOGICAL_OR(is_30d_reorder) AS is_30d_reorder,
    IF(LOGICAL_OR(is_incentivised_order), "Incentivised", "Organic") AS subsidy_type,
    SUM(voucher_spend) AS voucher_spend,
    SUM(voucher_amount_foodpanda) AS voucher_amount_foodpanda,
    SUM(gmv_local) AS gmv_local,
    SUM(gfv_local) AS gfv_local,
    SUM(units_sold) AS units_sold

  FROM raw_data_for_reorder
  LEFT JOIN subsegments 
        ON subsegments.pd_customer_uuid = raw_data_for_reorder.pd_customer_uuid
        AND subsegments.month_local = DATE_TRUNC(raw_data_for_reorder.created_date_local, MONTH)

  GROUP BY
    pd_customer_uuid,
    customer_code,
    month_local,
    order_month_local,
    order_year_local,
    subsegments.subsegment
),

actuals AS (
  SELECT
    "Actual" AS data_level,
    month_local,
    order_year_local,
    order_month_local,
    subsidy_type,
    customer_type,
    customer_type_detailed,
    -- is_30d_reorder,
    COUNT(DISTINCT pd_customer_uuid) AS customers,
    SUM(orders) AS orders,
    SUM(voucher_orders) AS voucher_orders,
    COALESCE(SUM(voucher_spend), 0) AS incentive_spend,
    COALESCE(SUM(voucher_amount_foodpanda), 0) AS voucher_amount_foodpanda,
    SUM(gmv_local) AS gmv_local,
    SUM(gfv_local) AS gfv_local,
    SUM(units_sold) AS units_sold

  FROM monthly_customer_level

  GROUP BY
    month_local,
    order_month_local,
    order_year_local,
    subsidy_type,
    customer_type,
    customer_type_detailed
    -- is_30d_reorder

  ORDER BY 
    order_year_local,
    order_month_local,
    subsidy_type,
    customer_type,
    customer_type_detailed
),

run_rate AS (
  SELECT
    "Run Rate" AS data_level,
    month_local,
    order_year_local,
    order_month_local,
    subsidy_type,
    customer_type,
    customer_type_detailed,
    -- customers / (EXTRACT(DAY FROM CURRENT_DATE() - 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS customers,
    NULL AS customers,
    orders / (EXTRACT(DAY FROM CURRENT_DATE() - 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS orders,
    -- voucher_orders / (EXTRACT(DAY FROM CURRENT_DATE() - 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS voucher_orders,
    NULL AS voucher_orders,
    -- incentive_spend / (EXTRACT(DAY FROM CURRENT_DATE() - 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS incentive_spend,
    NULL AS incentive_spend,
    NULL AS voucher_amount_foodpanda,
    gmv_local / (EXTRACT(DAY FROM CURRENT_DATE() - 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS gmv_local,
    gfv_local / (EXTRACT(DAY FROM CURRENT_DATE() - 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS gfv_local,
    -- units_sold / (EXTRACT(DAY FROM CURRENT_DATE() - 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS units_sold
    NULL AS units_sold
  FROM actuals
  WHERE month_local = DATE_TRUNC(CURRENT_DATE(), MONTH)
),

dmart AS (
  SELECT
    *
  FROM actuals
  UNION ALL
  SELECT 
    * 
  FROM run_rate
  UNION ALL
  SELECT 
    data_level,
    month_local,
    order_year_local,
    order_month_local,
    subsidy_type,
    customer_type,
    customer_type_detailed,
    customers,
    orders,
    voucher_orders,
    NULL AS incentive_spend,
    incentive_spend AS voucher_amount_foodpanda,
    gmv_local,
    gfv_local,
    units_sold
    
  FROM `fulfillment-dwh-production.pandata_report.country_PK_gsheet_dmart_mom_targets`
),

shops AS (
  -- Reorder Patch shall only be used to report customer number and not any other measure
  -- It will inflate other metrics like gmv, gfc etc. - Commenting the lines is recommended
  
  WITH units_in_basket AS (
    SELECT 
      customer_order_line_report.order_code AS pd_order_code,
      SUM(customer_order_line_report.delivered_quantity) AS units_sold
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_shops__order_product_report` AS customer_order_line_report
    WHERE customer_order_line_report.created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 25 MONTH), MONTH)
      AND customer_order_line_report.global_entity_id = "FP_PK"
      AND is_valid_order
    GROUP BY 
      pd_order_code
  ),

  subsegments AS (
    SELECT
      report_date_local AS month_local,
      global_entity_id,
      pd_customer_uuid,
      segment,
      subsegment
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_shops_segmentation_acid`
    WHERE report_date_local <<= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 0 MONTH), MONTH)
      AND report_date_local >>= "2022-12-01"
      AND global_entity_id = "FP_PK"
    QUALIFY ROW_NUMBER() OVER (PARTITION BY analytical_customer_id, report_date_local) = 1
  ),

  raw_data AS (
    SELECT
      orders.global_entity_id,
      orders.pd_customer_uuid,
      orders.order_code,
      orders.ordered_at_utc,
      orders.created_date_local,
      customer_agg.first_valid_vendor_type_order_at_utc,
      customer_agg.first_valid_order_all_at_utc,
      customers.code AS customer_code,
      DATE_TRUNC(orders.created_date_local, MONTH) AS month_local, 
      EXTRACT(MONTH FROM orders.created_date_local) AS order_month_local,
      EXTRACT(YEAR FROM orders.created_date_local) AS order_year_local,
      LOGICAL_OR(IF(orders.ordered_at_utc = customer_agg.first_valid_vendor_type_order_at_utc, TRUE, FALSE)) AS is_first_order_date_vendor_type,
      LOGICAL_OR(IF(orders.ordered_at_utc = customer_agg.first_order_all_at_utc, TRUE, FALSE)) AS is_first_order_all,
      LOGICAL_OR(vouchers.is_voucher_used) AS is_incentivised_order,
      vouchers.value_local AS voucher_spend,
      vouchers.value_local * (vouchers.attributions_foodpanda_ratio / 100) AS voucher_amount_foodpanda,
      gmv_local,
      gfv_local,
      units_in_basket.units_sold
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_qcommerce__subsidy_metrics_order_level` AS orders
    LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_qcommerce__customers_agg_orders_dates` AS customer_agg
          ON orders.pd_vendor_uuid = customer_agg.pd_vendor_uuid
          AND orders.pd_customer_uuid = customer_agg.pd_customer_uuid
          AND customer_agg.vendor_type = "shops"
    INNER JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` AS business_type
            ON orders.pd_vendor_uuid = business_type.uuid
          AND COALESCE(business_type.business_type_apac_reclassified, business_type.business_type_apac) IN ("shops")
          AND COALESCE(business_type.date_reclassified, orders.created_date_local) <<= orders.created_date_local
    INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS countries
            ON orders.global_entity_id = countries.global_entity_id
          AND countries.company_name = "Foodpanda"
          AND countries.region = "Asia"
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.cus_customers` AS customers
          ON customers.uuid = orders.pd_customer_uuid
    LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers` AS vouchers
          ON vouchers.uuid = orders.pd_order_uuid
          AND vouchers.global_entity_id = "FP_PK"
          AND CONCAT(channel, purpose) NOT IN (
          'channel_crmautocompensation_realtime', 'channel_crmcompensation', 'channel_customer_servicecompensation', 'channel_customer_servicerefund', 'channel_customer_servicesorry_panda', 'channel_onlineautocompensation_realtime', 'channel_onlinesorry_panda', 'channel_otherssorry_panda', 'channel_subsidiessorry_panda')
    LEFT JOIN units_in_basket
          ON units_in_basket.pd_order_code = orders.order_code
    LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
          ON pd_orders.code = orders.order_code
          AND pd_orders.global_entity_id = "FP_PK"
          AND pd_orders.created_date_utc >>= DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 25 MONTH), MONTH), INTERVAL 1 DAY)
    LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vendor_info
           ON vendor_info.vendor_code = pd_orders.vendor_code
    LEFT JOIN `fulfillment-dwh-production.curated_data_shared_mkt.braze_external_id_map` AS braze
          ON CONCAT(SPLIT(orders.pd_customer_uuid, "_")[SAFE_OFFSET(2)], "_", SPLIT(orders.pd_customer_uuid, "_")[SAFE_OFFSET(0)]) = braze.external_id

    WHERE orders.created_date_utc >>= DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 25 MONTH), MONTH), INTERVAL 1 DAY)
      AND orders.created_date_local >>= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 25 MONTH), MONTH)
      AND orders.created_date_local <<= CURRENT_DATE()
      AND orders.is_valid_order
      AND orders.global_entity_id = "FP_PK"
      AND vendor_info.vertical IN ("shops")     
      AND LOWER(COALESCE(vendor_info.vendor_name)) NOT LIKE "%business%"
      AND LOWER(COALESCE(vendor_info.vendor_name)) NOT LIKE "%corporate%"
      AND LOWER(COALESCE(vendor_info.vendor_name)) NOT LIKE "%pantry%"
      AND LOWER(COALESCE(vendor_info.vendor_name)) NOT LIKE "%odr%"
      AND LOWER(COALESCE(vendor_info.vendor_name)) NOT LIKE "%export%"
      
    GROUP BY
      orders.global_entity_id,
      orders.pd_customer_uuid,
      customer_code,
      orders.order_code,
      month_local,
      order_month_local,
      order_year_local,
      voucher_spend,
      ordered_at_utc,
      first_valid_vendor_type_order_at_utc,
      first_valid_order_all_at_utc,
      gmv_local,
      gfv_local,
      created_date_local,
      units_sold,
      vouchers.attributions_foodpanda_ratio
  ),

  raw_data_for_reorder AS (
    SELECT
      raw_data.*,
      -- IF(reorders.created_date_local IS NOT NULL, TRUE, FALSE) AS is_30d_reorder 
    FROM raw_data
    -- LEFT JOIN raw_data AS reorders
    --        ON raw_data.pd_customer_uuid = reorders.pd_customer_uuid
    --       AND reorders.created_date_local >> raw_data.created_date_local
    --       AND reorders.created_date_local <<= DATE_ADD(raw_data.created_date_local, INTERVAL 30 DAY)
  ),

  monthly_customer_level AS (
    SELECT
      raw_data_for_reorder.pd_customer_uuid,
      customer_code,
      raw_data_for_reorder.month_local,
      order_month_local,
      order_year_local,
      COUNT(DISTINCT order_code) AS orders,
      COUNT(DISTINCT IF(voucher_spend >> 0, order_code, NULL)) AS voucher_orders,
      IF(LOGICAL_OR(is_first_order_date_vendor_type), "NC", "EC") AS customer_type,
      -- IF(LOGICAL_OR(is_first_order_date_vendor_type), IF(LOGICAL_OR(is_first_order_all), "NCP", "NCV"), "EC") AS customer_type_detailed,
      CASE 
        WHEN LOGICAL_OR(IF(ordered_at_utc = first_valid_vendor_type_order_at_utc, TRUE, FALSE)) 
        AND NOT LOGICAL_OR(IF(ordered_at_utc = first_valid_order_all_at_utc, TRUE, FALSE)) 
        THEN "NCV" -- to check with first_order_dmart
        WHEN LOGICAL_OR(IF(ordered_at_utc = first_valid_vendor_type_order_at_utc, TRUE, FALSE)) 
        AND LOGICAL_OR(IF(ordered_at_utc = first_valid_order_all_at_utc, TRUE, FALSE)) 
        THEN "NCP"
        -- condition for weekly_shoppers
        WHEN subsegments.subsegment = "Weekly Shoppers" THEN "EC - Weekly Shoppers"
        ELSE "EC - Other"
      END AS customer_type_detailed,
      -- LOGICAL_OR(is_30d_reorder) AS is_30d_reorder,
      IF(LOGICAL_OR(is_incentivised_order), "Incentivised", "Organic") AS subsidy_type,
      SUM(voucher_spend) AS voucher_spend,
      SUM(voucher_amount_foodpanda) AS voucher_amount_foodpanda,
      SUM(gmv_local) AS gmv_local,
      SUM(gfv_local) AS gfv_local,
      SUM(units_sold) AS units_sold

    FROM raw_data_for_reorder
    LEFT JOIN subsegments 
          ON subsegments.pd_customer_uuid = raw_data_for_reorder.pd_customer_uuid
          AND subsegments.month_local = DATE_TRUNC(raw_data_for_reorder.created_date_local, MONTH)

    GROUP BY
      pd_customer_uuid,
      customer_code,
      month_local,
      order_month_local,
      order_year_local,
      subsegments.subsegment
  ),

  actuals AS (
    SELECT
      "Actual" AS data_level,
      month_local,
      order_year_local,
      order_month_local,
      subsidy_type,
      customer_type,
      customer_type_detailed,
      -- is_30d_reorder,
      COUNT(DISTINCT pd_customer_uuid) AS customers,
      SUM(orders) AS orders,
      SUM(voucher_orders) AS voucher_orders,
      COALESCE(SUM(voucher_spend), 0) AS incentive_spend,
      COALESCE(SUM(voucher_amount_foodpanda), 0) AS voucher_amount_foodpanda,
      SUM(gmv_local) AS gmv_local,
      SUM(gfv_local) AS gfv_local,
      SUM(units_sold) AS units_sold

    FROM monthly_customer_level

    GROUP BY
      month_local,
      order_month_local,
      order_year_local,
      subsidy_type,
      customer_type,
      customer_type_detailed
      -- is_30d_reorder

    ORDER BY 
      order_year_local,
      order_month_local,
      subsidy_type,
      customer_type,
      customer_type_detailed
  ),

  run_rate AS (
    SELECT
      "Run Rate" AS data_level,
      month_local,
      order_year_local,
      order_month_local,
      subsidy_type,
      customer_type,
      customer_type_detailed,
      -- customers / (EXTRACT(DAY FROM CURRENT_DATE() - 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS customers,
      NULL AS customers,
      orders / (EXTRACT(DAY FROM CURRENT_DATE() - 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS orders,
      -- voucher_orders / (EXTRACT(DAY FROM CURRENT_DATE() - 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS voucher_orders,
      NULL AS voucher_orders,
      -- incentive_spend / (EXTRACT(DAY FROM CURRENT_DATE() - 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS incentive_spend,
      NULL AS incentive_spend,
      NULL AS voucher_amount_foodpanda,
      gmv_local / (EXTRACT(DAY FROM CURRENT_DATE() - 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS gmv_local,
      gfv_local / (EXTRACT(DAY FROM CURRENT_DATE() - 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS gfv_local,
      -- units_sold / (EXTRACT(DAY FROM CURRENT_DATE() - 1)) * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE())) AS units_sold
      NULL AS units_sold
    FROM actuals
    WHERE month_local = DATE_TRUNC(CURRENT_DATE(), MONTH)
  )

  SELECT
    *
  FROM actuals
  UNION ALL
  SELECT 
    * 
  FROM run_rate
)

SELECT
  "dmart" AS vertical,
  *
FROM dmart

UNION ALL

SELECT
  "shops" AS vertical,
  *
FROM shops]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
