      <aliases enabled='yes' />
      <column caption='% of GMV' datatype='real' name='[% of GFV (copy)_1655635856233058320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([value_local])/SUM([total_value_local])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1raacwm0gkhgmp193jeum06rmrb9].[pcto:sum:value_local:qk]&quot;' value='% of Total Voucher Amount' />
        </aliases>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([value_local]) / TOTAL(SUM([value_local]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([units_sold (Custom SQL Query1)]) / TOTAL(SUM([units_sold (Custom SQL Query1)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Front Margin' datatype='real' name='[Calculation_1655635856197431296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([margin_amount])/SUM([gfv_without_vat])' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_1655635856197902337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_code])' />
      </column>
      <column caption='SKUs Per Order' datatype='real' name='[Calculation_1655635856198037506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([skus_in_order])/[Calculation_1655635856197902337]' />
      </column>
      <column caption='ABV' datatype='real' name='[Calculation_1655635856199282691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv_with_vat])/[Calculation_1655635856197902337]' />
      </column>
      <column caption='DF Per Order' datatype='real' name='[Calculation_1655635856199770116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_fee_local])/[Calculation_1655635856197902337]' />
      </column>
      <column caption='Units Per Order' datatype='real' name='[Calculation_1655635856200708102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([units_sold])/[Calculation_1655635856197902337]' />
      </column>
      <column caption='Customers' datatype='integer' name='[Calculation_1655635856206344200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_code])' />
      </column>
      <column caption='Order Per Customer' datatype='real' name='[Calculation_1655635856206438409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1655635856197902337]/[Calculation_1655635856206344200]' />
      </column>
      <column caption='Existing Customers' datatype='integer' name='[Calculation_1655635856208285706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_new_customer_acid] THEN NULL ELSE [customer_code] end)' />
      </column>
      <column caption='EC/NC' datatype='string' name='[Calculation_1655635856209698829]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#13;&#10;WHEN TRUE THEN [Calculation_1655635856210067470]&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
