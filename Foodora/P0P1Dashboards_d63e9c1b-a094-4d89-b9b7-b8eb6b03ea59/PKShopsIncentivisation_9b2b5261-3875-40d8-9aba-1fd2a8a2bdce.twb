      <column caption='Voucher Amount' datatype='real' name='[Calculation_3025574573555425280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Overall&quot; THEN [value_local]&#13;&#10;ELSE [voucher_amount_foodpanda]&#13;&#10;END' />
      </column>
      <column caption='New Customers' datatype='integer' name='[Existing Customers (copy)_1655635856208838667]' role='measure' type='quantitative'>
