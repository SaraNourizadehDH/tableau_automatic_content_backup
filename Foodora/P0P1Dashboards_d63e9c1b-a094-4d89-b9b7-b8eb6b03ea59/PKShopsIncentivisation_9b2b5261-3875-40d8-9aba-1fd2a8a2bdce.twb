      <datasource-dependencies datasource='Parameters'>
        <column alias='Fraud/Genuine' caption='Data Split' datatype='string' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;True&quot;'>
