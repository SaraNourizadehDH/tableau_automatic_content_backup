    <worksheet name='Dish Image Parity Lowest WoW'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold' fontsize='11'>Lowest WoW</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[BQ] Chain item parity - Country level' name='federated.03m11661y0ybtg1h2b61a1yqucor (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='View Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Product&quot;'>
              <calculation class='tableau' formula='&quot;Product&quot;' />
            </column>
            <column caption='Product Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03m11661y0ybtg1h2b61a1yqucor (copy)'>
            <column caption='Week filter' datatype='boolean' name='[Calculation_1791377155892424704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_week] &gt;= DATEADD(&apos;week&apos;,-4,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [report_week] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))' />
            </column>
            <column caption='No image vendor/product count' datatype='integer' name='[Calculation_6053260146597244928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Vendor&apos; THEN [no_image_vendor_count]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Product&apos; AND [Parameters].[Parameter 3] = &apos;All&apos; THEN [no_image_all_product_count]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Product&apos; AND [Parameters].[Parameter 3] = &apos;Existing&apos; THEN [no_image_existing_product_count]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Product&apos; AND [Parameters].[Parameter 3] = &apos;New&apos; THEN [no_image_new_product_count]&#10;END' />
            </column>
            <column caption='This week' datatype='boolean' name='[Calculation_757871425704644609]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(REGEXP_EXTRACT([Dynamic Date Range (qc success date) (copy)_757871425821081639],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY())))' />
            </column>
            <column caption='Vendors/Products with no image WoW' datatype='string' name='[DLP70 WoW (copy)_2130061949035999235 1]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF(&#13;&#10;(SUM(IF [Calculation_757871425704644609] THEN [Calculation_6053260146597244928] ELSE 0 END)&#13;&#10;-&#13;&#10;SUM(IF [this week (copy)_757871425706078212 1] THEN [Calculation_6053260146597244928] ELSE 0 END))&#13;&#10;&gt;= 0) THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;+ &apos; &apos;&#13;&#10;+ STR(ROUND((&#10;(SUM(IF [Calculation_757871425704644609] THEN [Calculation_6053260146597244928] ELSE 0 END)&#13;&#10;-&#13;&#10;SUM(IF [this week (copy)_757871425706078212 1] THEN [Calculation_6053260146597244928] ELSE 0 END))&#10;/&#13;&#10;SUM(IF [this week (copy)_757871425706078212 1] THEN [Calculation_6053260146597244928] ELSE 0 END))&#13;&#10;*100,1))&#13;&#10;+ &apos;%&apos;' />
            </column>
            <column caption='Dish image rank WoW rank (asc)' datatype='integer' name='[Dish image rank (asc) (copy)_137289463353843739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_DENSE([Vendors/Products with no image WoW (copy)_137289463354523678], &apos;asc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Week date Range' datatype='string' name='[Dynamic Date Range (qc success date) (copy)_757871425821081639]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(DATEPART(&apos;iso-year&apos;,[report_week]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[report_week]))' />
            </column>
            <column caption='Vendors/Products with no image WoW ▲▼' datatype='string' name='[Vendors/Products with no image MoM ▲▼ (copy)_6053260146600157185]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF  LEFT([DLP70 WoW (copy)_2130061949035999235 1],1) =   &apos;▲&apos; THEN   &apos;▲&apos; &#13;&#10;ELSE   &apos;▼&apos;&#13;&#10;END' />
            </column>
            <column caption='Vendors/Products with no image WoW (value)' datatype='real' name='[Vendors/Products with no image WoW (copy)_137289463354523678]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='(SUM(IF [Calculation_757871425704644609] THEN [Calculation_6053260146597244928] ELSE 0 END)&#13;&#10;-&#13;&#10;SUM(IF [this week (copy)_757871425706078212 1] THEN [Calculation_6053260146597244928] ELSE 0 END))&#10;/&#13;&#10;SUM(IF [this week (copy)_757871425706078212 1] THEN [Calculation_6053260146597244928] ELSE 0 END)' />
            </column>
