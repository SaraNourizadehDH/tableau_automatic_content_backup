            <column caption='Last month' datatype='boolean' name='[this month (copy)_757871425717612556]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT([Week date Range (copy)_1408500840146587649],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;iso-week&apos;,TODAY())))),3)' />
            </column>
            <column caption='This month' datatype='boolean' name='[this week (copy)_757871425716707339]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT([Week date Range (copy)_1408500840146587649],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY())))),3)' />
            </column>
