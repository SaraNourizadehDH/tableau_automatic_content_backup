            <column-instance column='[Vendors/Products with no image MoM ▲▼ (copy)_6053260146600157185]' derivation='User' name='[usr:Vendors/Products with no image MoM ▲▼ (copy)_6053260146600157185:nk]' pivot='key' type='nominal' />
