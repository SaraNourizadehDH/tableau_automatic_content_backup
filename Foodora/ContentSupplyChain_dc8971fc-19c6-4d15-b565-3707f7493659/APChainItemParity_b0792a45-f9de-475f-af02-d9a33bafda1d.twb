    <worksheet name='Dish image '>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[BQ] Chain item parity - Image, Description, Translations' name='federated.03m11661y0ybtg1h2b61a1yqucor' />
          </datasources>
          <datasource-dependencies datasource='federated.03m11661y0ybtg1h2b61a1yqucor'>
            <column caption='Vendors without dish image' datatype='integer' name='[Calculation_4294323017166499845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [to_add_image]= TRUE THEN [vendor_uuid] ELSE NULL END)' />
            </column>
            <column caption='Products without dish image' datatype='integer' name='[EXISTING Products without dish image (copy)_4158229869454659585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [to_add_image]= TRUE THEN [product_uuid] ELSE NULL END)' />
            </column>
