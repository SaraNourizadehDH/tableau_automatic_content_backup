            <column caption='No desc all product count' datatype='integer' name='[no_desc_all_product_count]' role='measure' type='quantitative' />
            <column caption='No desc existing product count' datatype='integer' name='[no_desc_existing_product_count]' role='measure' type='quantitative' />
