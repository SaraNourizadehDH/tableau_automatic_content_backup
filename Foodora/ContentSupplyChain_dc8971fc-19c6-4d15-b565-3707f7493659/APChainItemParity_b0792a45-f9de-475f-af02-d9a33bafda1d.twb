            <column-instance column='[Week filter (copy)_2234911359734898690]' derivation='None' name='[none:Week filter (copy)_2234911359734898690:nk]' pivot='key' type='nominal' />
            <column-instance column='[WoW (copy)_4332533243262750724]' derivation='None' name='[none:WoW (copy)_4332533243262750724:nk]' pivot='key' type='nominal' />
