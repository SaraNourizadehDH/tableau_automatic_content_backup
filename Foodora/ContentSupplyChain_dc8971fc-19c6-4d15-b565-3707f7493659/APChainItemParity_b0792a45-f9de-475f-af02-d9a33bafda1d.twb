    <worksheet name='Translated Title Parity Lowest'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold' fontsize='11'>Lowest</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[BQ] Chain item parity - Country level' name='federated.03m11661y0ybtg1h2b61a1yqucor (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='View Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Product&quot;'>
              <calculation class='tableau' formula='&quot;Product&quot;' />
            </column>
            <column caption='Product Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03m11661y0ybtg1h2b61a1yqucor (copy)'>
            <column caption='Week filter' datatype='boolean' name='[Calculation_1791377155892424704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_week] &gt;= DATEADD(&apos;week&apos;,-4,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [report_week] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))' />
            </column>
            <column caption='Translated title rank (asc)' datatype='integer' name='[Dish image rank (asc) (copy)_137289463372738595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_DENSE(SUM([No image vendor/product count (copy)_137289463332888585]), &apos;asc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='No translated title vendor/product count' datatype='integer' name='[No image vendor/product count (copy)_137289463332888585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Vendor&apos; THEN [no_translated_title_vendor_count]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Product&apos; AND [Parameters].[Parameter 3] = &apos;All&apos; THEN [no_translated_title_all_product_count]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Product&apos; AND [Parameters].[Parameter 3] = &apos;Existing&apos; THEN [no_translated_title_existing_product_count]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Product&apos; AND [Parameters].[Parameter 3] = &apos;New&apos; THEN [no_translated_title_new_product_count]&#10;END' />
            </column>
            <column caption='Business Type' datatype='string' name='[business_type]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
