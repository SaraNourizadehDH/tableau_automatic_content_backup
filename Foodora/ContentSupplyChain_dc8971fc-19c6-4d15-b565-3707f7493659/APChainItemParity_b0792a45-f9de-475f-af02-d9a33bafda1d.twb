              <calculation class='tableau' formula='&quot;Product&quot;' />
            </column>
            <column caption='Product Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03m11661y0ybtg1h2b61a1yqucor (copy)'>
            <column caption='Week Header' datatype='string' name='[Calculation_1372753480161103872]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;CW&apos;+STR(ISOWEEK([report_week]))' />
            </column>
            <column caption='Week filter' datatype='boolean' name='[Calculation_1791377155892424704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_week] &gt;= DATEADD(&apos;week&apos;,-4,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [report_week] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))' />
            </column>
            <column caption='country sort' datatype='integer' name='[Calculation_3579446951069786112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [country]&#10;WHEN &apos;Bangladesh&apos; THEN 1&#10;WHEN &apos;Cambodia&apos; THEN 2&#10;WHEN &apos;Hong Kong&apos; THEN 3&#10;WHEN &apos;Laos&apos; THEN 4&#10;WHEN &apos;Malaysia&apos; THEN 5&#10;WHEN &apos;Myanmar&apos; THEN 6&#10;WHEN &apos;Pakistan&apos; THEN 7&#10;WHEN &apos;Philippines&apos; THEN 8&#10;WHEN &apos;Singapore&apos; THEN 9&#10;WHEN &apos;Taiwan&apos; THEN 10&#10;WHEN &apos;Thailand&apos; THEN 11&#10;WHEN &apos;Austria&apos; THEN 12&#10;WHEN &apos;Czech Republic&apos; THEN 13&#10;WHEN &apos;Denmark&apos; THEN 14&#10;WHEN &apos;Finland&apos; THEN 15&#10;WHEN &apos;Hungary&apos; THEN 16&#10;WHEN &apos;Norway&apos; THEN 17&#10;WHEN &apos;Slovakia&apos; THEN 18&#10;WHEN &apos;Sweden&apos; THEN 19&#10;WHEN &apos;Turkey&apos; THEN 20&#10;WHEN &apos;EUROPE&apos; THEN 21&#10;WHEN &apos;EUROPE - TR&apos; THEN 22&#10;WHEN &apos;APAC&apos; THEN 23&#10;WHEN &apos;PANDORA&apos; THEN 24&#10;WHEN &apos;PANDORA - TR&apos; THEN 25&#10;END' />
            </column>
            <column caption='Trend' datatype='string' name='[Calculation_4332533243124396035]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Trend&apos;' />
            </column>
            <column caption='No translated desc vendor/product count' datatype='integer' name='[No translated title vendor/product count (copy)_137289463335473166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Vendor&apos; THEN [no_translated_desc_vendor_count]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Product&apos; AND [Parameters].[Parameter 3] = &apos;All&apos; THEN [no_translated_desc_all_product_count]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Product&apos; AND [Parameters].[Parameter 3] = &apos;Existing&apos; THEN [no_translated_desc_existing_product_count]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Product&apos; AND [Parameters].[Parameter 3] = &apos;New&apos; THEN [no_translated_desc_new_product_count]&#10;END' />
