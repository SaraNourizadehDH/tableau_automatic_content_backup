            <column-instance column='[Calculation_3579446951069786112]' derivation='Max' name='[max:Calculation_3579446951069786112:qk]' pivot='key' type='quantitative' />
            <column caption='No translated desc all product count' datatype='integer' name='[no_translated_desc_all_product_count]' role='measure' type='quantitative' />
