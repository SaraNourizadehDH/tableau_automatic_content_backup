            <column-instance column='[Vendors/Products with no translated title MoM ▲▼ (copy)_137289463337209874]' derivation='User' name='[usr:Vendors/Products with no translated title MoM ▲▼ (copy)_137289463337209874:nk]' pivot='key' type='nominal' />
