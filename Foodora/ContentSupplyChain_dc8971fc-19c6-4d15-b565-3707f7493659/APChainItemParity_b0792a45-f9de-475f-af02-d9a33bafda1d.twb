FROM `fulfillment-dwh-production.pandata_report.pandora_content_csc__chain_item_parity_countries__daily` 
WHERE report_date BETWEEN DATE_SUB( DATE_TRUNC( CURRENT_DATE, MONTH), INTERVAL 8 MONTH) AND CURRENT_DATE
  AND EXTRACT(DAYOFWEEK FROM report_date) = 1 -- every Sunday of the week</relation>
