      <aliases enabled='yes' />
      <column caption='Vendors/Products with no image MoM' datatype='string' name='[% Products with DLP WoW (copy)_2861474631572459525]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF(&#10;(SUM(IF [this week (copy)_757871425716707339] THEN [Calculation_6053260146597244928] ELSE 0 END)&#10;-&#10;SUM(IF [this month (copy)_757871425717612556] THEN [Calculation_6053260146597244928] ELSE 0 END))&#10;&gt;= 0) THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND((&#10;(SUM(IF [this week (copy)_757871425716707339] THEN [Calculation_6053260146597244928] ELSE 0 END)&#10;-&#10;SUM(IF [this month (copy)_757871425717612556] THEN [Calculation_6053260146597244928] ELSE 0 END))&#10;/&#10;SUM(IF [this month (copy)_757871425717612556] THEN [Calculation_6053260146597244928] ELSE 0 END))&#10;*100,1))&#10;+ &apos;%&apos;' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.03m11661y0ybtg1h2b61a1yqucor (copy)].[usr:Calculation_4294323017171849230:qk:1]&quot;' value='Dish image rank' />
          <alias key='&quot;[federated.03m11661y0ybtg1h2b61a1yqucor (copy)].[usr:Calculation_4294323017171849230:vtnone:qk]&quot;' value='Dish image rank ' />
          <alias key='&quot;[federated.03m11661y0ybtg1h2b61a1yqucor (copy)].[usr:Title translation rank (copy)_5998231791611592709:qk:1]&quot;' value='Description Translation rank' />
          <alias key='&quot;[federated.03m11661y0ybtg1h2b61a1yqucor (copy)].[usr:Title translation rank (copy)_5998231791611592709:vtnone:qk]&quot;' value='Translated description rank ' />
        </aliases>
      </column>
      <column caption='Week Header' datatype='string' name='[Calculation_1372753480161103872]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;CW&apos;+STR(ISOWEEK([report_week]))' />
      </column>
      <column caption='Week filter' datatype='boolean' name='[Calculation_1791377155892424704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_week] &gt;= DATEADD(&apos;week&apos;,-4,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [report_week] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))' />
      </column>
      <column caption='Month Header' datatype='string' name='[Calculation_2234911359725531136]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(str(DATENAME(&apos;month&apos;,[report_month])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[report_month])),2)' />
      </column>
      <column caption='country sort' datatype='integer' name='[Calculation_3579446951069786112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [country]&#10;WHEN &apos;Bangladesh&apos; THEN 1&#10;WHEN &apos;Cambodia&apos; THEN 2&#10;WHEN &apos;Hong Kong&apos; THEN 3&#10;WHEN &apos;Laos&apos; THEN 4&#10;WHEN &apos;Malaysia&apos; THEN 5&#10;WHEN &apos;Myanmar&apos; THEN 6&#10;WHEN &apos;Pakistan&apos; THEN 7&#10;WHEN &apos;Philippines&apos; THEN 8&#10;WHEN &apos;Singapore&apos; THEN 9&#10;WHEN &apos;Taiwan&apos; THEN 10&#10;WHEN &apos;Thailand&apos; THEN 11&#10;WHEN &apos;Austria&apos; THEN 12&#10;WHEN &apos;Czech Republic&apos; THEN 13&#10;WHEN &apos;Denmark&apos; THEN 14&#10;WHEN &apos;Finland&apos; THEN 15&#10;WHEN &apos;Hungary&apos; THEN 16&#10;WHEN &apos;Norway&apos; THEN 17&#10;WHEN &apos;Slovakia&apos; THEN 18&#10;WHEN &apos;Sweden&apos; THEN 19&#10;WHEN &apos;Turkey&apos; THEN 20&#10;WHEN &apos;EUROPE&apos; THEN 21&#10;WHEN &apos;EUROPE - TR&apos; THEN 22&#10;WHEN &apos;APAC&apos; THEN 23&#10;WHEN &apos;PANDORA&apos; THEN 24&#10;WHEN &apos;PANDORA - TR&apos; THEN 25&#10;END' />
      </column>
      <column caption='Total product count' datatype='integer' name='[Calculation_4294323017116647426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(product_uuid)' />
      </column>
      <column caption='Dish image rank (asc)' datatype='integer' name='[Calculation_4294323017171849230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE(SUM([Calculation_6053260146597244928]), &apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='WoW' datatype='string' name='[Calculation_4332533243116146690]' role='dimension' type='nominal'>
