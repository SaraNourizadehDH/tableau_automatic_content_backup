            <column caption='Is Active Chain' datatype='boolean' name='[is_active_chain]' role='dimension' type='nominal' />
            <column caption='Is Pandapro' datatype='boolean' name='[is_pandapro]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3579446951069786112]' derivation='Max' name='[max:Calculation_3579446951069786112:qk]' pivot='key' type='quantitative' />
            <column caption='No desc all product count' datatype='integer' name='[no_desc_all_product_count]' role='measure' type='quantitative' />
