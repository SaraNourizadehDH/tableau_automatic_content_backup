    <worksheet name='Translated Desc Parity MoM Change'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[BQ] Chain item parity - Country level' name='federated.03m11661y0ybtg1h2b61a1yqucor (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='View Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Product&quot;'>
              <calculation class='tableau' formula='&quot;Product&quot;' />
            </column>
            <column caption='Product Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03m11661y0ybtg1h2b61a1yqucor (copy)'>
            <column caption='country sort' datatype='integer' name='[Calculation_3579446951069786112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [country]&#10;WHEN &apos;Bangladesh&apos; THEN 1&#10;WHEN &apos;Cambodia&apos; THEN 2&#10;WHEN &apos;Hong Kong&apos; THEN 3&#10;WHEN &apos;Laos&apos; THEN 4&#10;WHEN &apos;Malaysia&apos; THEN 5&#10;WHEN &apos;Myanmar&apos; THEN 6&#10;WHEN &apos;Pakistan&apos; THEN 7&#10;WHEN &apos;Philippines&apos; THEN 8&#10;WHEN &apos;Singapore&apos; THEN 9&#10;WHEN &apos;Taiwan&apos; THEN 10&#10;WHEN &apos;Thailand&apos; THEN 11&#10;WHEN &apos;Austria&apos; THEN 12&#10;WHEN &apos;Czech Republic&apos; THEN 13&#10;WHEN &apos;Denmark&apos; THEN 14&#10;WHEN &apos;Finland&apos; THEN 15&#10;WHEN &apos;Hungary&apos; THEN 16&#10;WHEN &apos;Norway&apos; THEN 17&#10;WHEN &apos;Slovakia&apos; THEN 18&#10;WHEN &apos;Sweden&apos; THEN 19&#10;WHEN &apos;Turkey&apos; THEN 20&#10;WHEN &apos;EUROPE&apos; THEN 21&#10;WHEN &apos;EUROPE - TR&apos; THEN 22&#10;WHEN &apos;APAC&apos; THEN 23&#10;WHEN &apos;PANDORA&apos; THEN 24&#10;WHEN &apos;PANDORA - TR&apos; THEN 25&#10;END' />
            </column>
            <column caption='No translated desc vendor/product count' datatype='integer' name='[No translated title vendor/product count (copy)_137289463335473166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Vendor&apos; THEN [no_translated_desc_vendor_count]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Product&apos; AND [Parameters].[Parameter 3] = &apos;All&apos; THEN [no_translated_desc_all_product_count]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Product&apos; AND [Parameters].[Parameter 3] = &apos;Existing&apos; THEN [no_translated_desc_existing_product_count]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Product&apos; AND [Parameters].[Parameter 3] = &apos;New&apos; THEN [no_translated_desc_new_product_count]&#10;END' />
            </column>
            <column caption='Vendors/Products with no translated desc MoM' datatype='string' name='[Vendors/Products with no translated title MoM (copy)_137289463337209873]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF(&#10;(SUM(IF [this week (copy)_757871425716707339] THEN [No translated title vendor/product count (copy)_137289463335473166] ELSE 0 END)&#10;-&#10;SUM(IF [this month (copy)_757871425717612556] THEN [No translated title vendor/product count (copy)_137289463335473166] ELSE 0 END))&#10;&gt;= 0) THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND((&#10;(SUM(IF [this week (copy)_757871425716707339] THEN [No translated title vendor/product count (copy)_137289463335473166] ELSE 0 END)&#10;-&#10;SUM(IF [this month (copy)_757871425717612556] THEN [No translated title vendor/product count (copy)_137289463335473166] ELSE 0 END))&#10;/&#10;SUM(IF [this month (copy)_757871425717612556] THEN [No translated title vendor/product count (copy)_137289463335473166] ELSE 0 END))&#10;*100,1))&#10;+ &apos;%&apos;' />
            </column>
            <column caption='Vendors/Products with no translated desc MoM ▲▼' datatype='string' name='[Vendors/Products with no translated title MoM ▲▼ (copy)_137289463337209874]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF  LEFT([Vendors/Products with no translated title MoM (copy)_137289463337209873],1) =   &apos;▲&apos; THEN   &apos;▲&apos; &#13;&#10;ELSE   &apos;▼&apos;&#13;&#10;END' />
            </column>
            <column caption='Month date Range' datatype='string' name='[Week date Range (copy)_1408500840146587649]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(str(DATENAME(&apos;month&apos;,[report_month])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[report_month])),2)' />
            </column>
            <column caption='Month filter' datatype='boolean' name='[Week filter (copy)_2234911359734898690]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_month] &gt;= DATEADD(&apos;month&apos;,-7,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [report_month] &lt;= DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))' />
            </column>
            <column caption='MoM' datatype='string' name='[WoW (copy)_4332533243262750724]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MoM %Δ&apos;' />
            </column>
            <column caption='Business Type' datatype='string' name='[business_type]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
