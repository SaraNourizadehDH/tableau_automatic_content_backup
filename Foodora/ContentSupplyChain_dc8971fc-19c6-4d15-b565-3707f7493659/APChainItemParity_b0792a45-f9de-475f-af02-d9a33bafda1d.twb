            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03m11661y0ybtg1h2b61a1yqucor (copy)'>
            <column caption='Week filter' datatype='boolean' name='[Calculation_1791377155892424704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_week] &gt;= DATEADD(&apos;week&apos;,-4,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [report_week] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))' />
            </column>
            <column caption='This week' datatype='boolean' name='[Calculation_757871425704644609]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(REGEXP_EXTRACT([Dynamic Date Range (qc success date) (copy)_757871425821081639],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY())))' />
            </column>
            <column caption='Week date Range' datatype='string' name='[Dynamic Date Range (qc success date) (copy)_757871425821081639]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(DATEPART(&apos;iso-year&apos;,[report_week]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[report_week]))' />
            </column>
            <column caption='No translated title vendor/product count' datatype='integer' name='[No image vendor/product count (copy)_137289463332888585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Vendor&apos; THEN [no_translated_title_vendor_count]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Product&apos; AND [Parameters].[Parameter 3] = &apos;All&apos; THEN [no_translated_title_all_product_count]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Product&apos; AND [Parameters].[Parameter 3] = &apos;Existing&apos; THEN [no_translated_title_existing_product_count]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Product&apos; AND [Parameters].[Parameter 3] = &apos;New&apos; THEN [no_translated_title_new_product_count]&#10;END' />
            </column>
            <column caption='Vendors/Products with no translated title WoW' datatype='string' name='[Vendors/Products with no image WoW (copy)_137289463333249034]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF(&#13;&#10;(SUM(IF [Calculation_757871425704644609] THEN [No image vendor/product count (copy)_137289463332888585] ELSE 0 END)&#13;&#10;-&#13;&#10;SUM(IF [this week (copy)_757871425706078212 1] THEN [No image vendor/product count (copy)_137289463332888585] ELSE 0 END))&#13;&#10;&gt;= 0) THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#13;&#10;+ &apos; &apos;&#13;&#10;+ STR(ROUND((&#10;(SUM(IF [Calculation_757871425704644609] THEN [No image vendor/product count (copy)_137289463332888585] ELSE 0 END)&#13;&#10;-&#13;&#10;SUM(IF [this week (copy)_757871425706078212 1] THEN [No image vendor/product count (copy)_137289463332888585] ELSE 0 END))&#10;/&#13;&#10;SUM(IF [this week (copy)_757871425706078212 1] THEN [No image vendor/product count (copy)_137289463332888585] ELSE 0 END))&#13;&#10;*100,1))&#13;&#10;+ &apos;%&apos;' />
            </column>
            <column caption='Vendors/Products with no translated title WoW ▲▼' datatype='string' name='[Vendors/Products with no image WoW ▲▼ (copy)_137289463333249035]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF  LEFT([Vendors/Products with no image WoW (copy)_137289463333249034],1) =   &apos;▲&apos; THEN   &apos;▲&apos; &#13;&#10;ELSE   &apos;▼&apos;&#13;&#10;END' />
