          <alias key='&quot;[federated.104ib8a12xqx851ag2pan0sw41w8].[pcva:sum:product_count:qk:14]&quot;' value='% Products' />
          <alias key='&quot;[federated.104ib8a12xqx851ag2pan0sw41w8].[pcva:sum:vendor_count:qk:4]&quot;' value='% Vendors' />
        </aliases>
      </column>
      <column caption='Month Header' datatype='string' name='[Calculation_1304847639668924418]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(str(DATENAME(&apos;month&apos;,[report_month])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[report_month])),2)' />
      </column>
      <column caption='Products Fixed' datatype='integer' name='[Calculation_6834916140861284353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [funnel_type] = &apos;fix&apos; AND [status_or_reason] = &apos;fixed&apos; THEN [product_count] END)' />
      </column>
      <column caption='Is SG SAM Account' datatype='boolean' name='[Calculation_6834916140925898761]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([is_sam_account], FALSE)' />
      </column>
      <column caption='Status or Reason Sort' datatype='integer' name='[Calculation_6834916140928909322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [status_or_reason]&#10;WHEN &apos;flagged in gapfinder data&apos; THEN 1&#10;WHEN &apos;excluded vendors&apos; THEN 2&#10;WHEN &apos;correctly mapped&apos; THEN 3&#10;WHEN &apos;with price markup&apos; THEN 4&#10;WHEN &apos;unable to validate&apos; THEN 5&#10;WHEN &apos;fixed&apos; THEN 6&#10;WHEN &apos;vendor is excluded&apos; THEN 7&#10;WHEN &apos;vendor name is not matching&apos; THEN 8&#10;WHEN &apos;vendor is closed&apos; THEN 9&#10;WHEN &apos;variation is not matching&apos; THEN 10&#10;WHEN &apos;item is not matching&apos; THEN 11&#10;WHEN &apos;description is not matching&apos; THEN 12&#10;WHEN &apos;item cannot be found in foodpanda menu&apos; THEN 13&#10;WHEN &apos;item cannot be found in competitor menu&apos; THEN 14&#10;WHEN &apos;item cannot be found in both menus&apos; THEN 15&#10;WHEN &apos;no markup&apos; THEN 16&#10;WHEN &apos;markup present&apos; THEN 17&#10;WHEN &apos;higher commission on foodpanda&apos; THEN 18&#10;WHEN &apos;error due to erroneous menu update&apos; THEN 19&#10;WHEN &apos;done&apos; THEN 20&#10;WHEN NULL THEN 21&#10;END' />
      </column>
      <column caption='Vendors Fixed' datatype='integer' name='[Products with Fix (copy)_6834916140862193666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [funnel_type] = &apos;fix&apos; AND [status_or_reason] = &apos;fixed&apos; THEN [vendor_count] END)' />
      </column>
      <column caption='Reason' datatype='string' name='[Status Or Reason (copy)_1680124158138998795]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[status_or_reason]' />
      </column>
      <column caption='Total Flagged Chains' datatype='integer' name='[Total Flagged Vendors (copy)_6834916140939583506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [funnel_type] = &apos;fix&apos; AND [status_or_reason] = &apos;flagged in gapfinder data&apos; THEN [chain_count] END)' />
      </column>
      <column caption='Total Flagged Products' datatype='integer' name='[Total flagged vendors (copy)_6834916140936118289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [funnel_type] = &apos;fix&apos; AND [status_or_reason] = &apos;flagged in gapfinder data&apos; THEN [product_count] END)' />
      </column>
      <column caption='Mapped Vendors' datatype='integer' name='[Vendors with Fix (copy)_6834916140934017037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [funnel_type] = &apos;fix&apos; AND NOT [status_or_reason] IN (&apos;correctly mapped&apos;, &apos;unable to validate&apos;) THEN [vendor_count] END)' />
      </column>
      <column caption='Total Flagged Vendors' datatype='integer' name='[Vendors with Fix (copy)_6834916140935811088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [funnel_type] = &apos;fix&apos; AND [status_or_reason] = &apos;flagged in gapfinder data&apos; THEN [vendor_count] END)' />
      </column>
      <column caption='Chains Fixed' datatype='integer' name='[Vendors with Fix (copy)_6834916140940177428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [funnel_type] = &apos;fix&apos; AND [status_or_reason] = &apos;fixed&apos; THEN [chain_count] END)' />
      </column>
      <column caption='Month filter' datatype='boolean' name='[Week filter (copy)_2234911359734898690]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_month] &gt;= DATEADD(&apos;month&apos;,-8,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [report_month] &lt;= DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))' />
      </column>
