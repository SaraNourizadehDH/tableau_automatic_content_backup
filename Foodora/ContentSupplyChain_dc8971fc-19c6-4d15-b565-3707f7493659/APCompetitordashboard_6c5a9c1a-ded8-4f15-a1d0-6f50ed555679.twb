            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.16rxfob0ekggkq1cvz2vp0bav54c (copy 5)'>
            <column caption='country sort' datatype='integer' name='[Calculation_3579446951069786112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [country]&#10;WHEN &apos;Bangladesh&apos; THEN 1&#10;WHEN &apos;Cambodia&apos; THEN 2&#10;WHEN &apos;Hong Kong&apos; THEN 3&#10;WHEN &apos;Laos&apos; THEN 4&#10;WHEN &apos;Malaysia&apos; THEN 5&#10;WHEN &apos;Myanmar&apos; THEN 6&#10;WHEN &apos;Pakistan&apos; THEN 7&#10;WHEN &apos;Philippines&apos; THEN 8&#10;WHEN &apos;Singapore&apos; THEN 9&#10;WHEN &apos;Taiwan&apos; THEN 10&#10;WHEN &apos;Thailand&apos; THEN 11&#10;WHEN &apos;APAC&apos; THEN 12&#10;WHEN &apos;Austria&apos; THEN 13&#10;WHEN &apos;Czech Republic&apos; THEN 14&#10;WHEN &apos;Denmark&apos; THEN 15&#10;WHEN &apos;Finland&apos; THEN 16&#10;WHEN &apos;Hungary&apos; THEN 17&#10;WHEN &apos;Norway&apos; THEN 18&#10;WHEN &apos;Slovakia&apos; THEN 19&#10;WHEN &apos;Sweden&apos; THEN 20&#10;WHEN &apos;Turkey&apos; THEN 20&#10;WHEN &apos;EUROPE&apos; THEN 21&#10;WHEN &apos;EUROPE + YEMEK&apos; THEN 22&#10;WHEN &apos;PANDORA&apos; THEN 23&#10;END' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_4711891126661390342]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region] = &apos;MENA&apos; THEN &apos;Europe + Yemek&apos; ELSE [region] END' />
            </column>
            <column caption='Column name - Dynamic for % Change (product)' datatype='string' name='[Column name - Dynamic for % Change (copy)_1507931843069964293]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Week/Month View (vendor) (copy)_1716575172400848898] = &apos;week&apos; then &apos;WoW %Δ&apos;&#10;ELSEIF [Parameters].[Week/Month View (vendor) (copy)_1716575172400848898] = &apos;month&apos; then &apos;MoM %Δ&apos;&#10;END' />
            </column>
            <column caption='Date last month (product)' datatype='boolean' name='[Date last month (vendor) (copy)_1849642490970136577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT([Dynamic Date Range (copy)_1507931843067191298],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3)' />
            </column>
            <column caption='Date last week (product)' datatype='boolean' name='[Date last week (vendor) (copy)_1849642490970136578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(REGEXP_EXTRACT([Dynamic Date Range (copy)_1507931843067191298],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-2, TODAY())))' />
            </column>
            <column caption='Date this month (product)' datatype='boolean' name='[Date this month (vendor) (copy)_1849642490970136579]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT([Dynamic Date Range (copy)_1507931843067191298],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3)' />
            </column>
            <column caption='Date this week (product)' datatype='boolean' name='[Date this week (vendor) (copy)_1849642490970136576]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(REGEXP_EXTRACT([Dynamic Date Range (qc success date) (copy)_757871425821081639 3],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY())))' />
            </column>
            <column caption='Dynamic Date Filter (product)' datatype='boolean' name='[Dynamic Date Filter (copy)_1507931843067994116]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Week/Month View (vendor) (copy)_1716575172400848898] = &apos;month&apos; AND [is_last_week_of_month] = true AND [report_week_num] &gt;= &apos;2022-48&apos;&#10;THEN [report_week] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [report_week] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY()))&#10;ELSEIF [Parameters].[Week/Month View (vendor) (copy)_1716575172400848898] = &apos;week&apos; AND [report_week_num] &gt;= &apos;2022-48&apos;&#10;THEN [report_week] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [report_week] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;END' />
            </column>
            <column caption='Dynamic Date Range (product)' datatype='string' name='[Dynamic Date Range (copy)_1507931843067191298]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Week/Month View (vendor) (copy)_1716575172400848898] = &apos;week&apos; then str(DATEPART(&apos;iso-year&apos;,[report_week]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[report_week]))&#10;ELSEIF [Parameters].[Week/Month View (vendor) (copy)_1716575172400848898] = &apos;month&apos; then LEFT(str(DATENAME(&apos;month&apos;,[report_month])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[report_month])),2) end' />
            </column>
            <column caption='Dynamic Date Range (vendor)' datatype='string' name='[Dynamic Date Range (qc success date) (copy)_757871425821081639 3]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1 2 3] = &apos;week&apos; then str(DATEPART(&apos;iso-year&apos;,[report_week]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[report_week]))&#10;ELSEIF [Parameters].[Parameter 1 2 3] = &apos;month&apos; then LEFT(str(DATENAME(&apos;month&apos;,[report_week])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[report_week])),2) end' />
            </column>
            <column caption='Products with Mark-up WoW/MoM' datatype='string' name='[Vendors with Mark-up % Change (copy)_1507931843070054406]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Week/Month View (vendor) (copy)_1716575172400848898] = &apos;week&apos; AND [Parameters].[View Type (copy)_1168191572237275138] = &apos;Relative&apos; AND [Parameters].[Parameter 4] = &apos;Non discounted&apos; THEN (&#10;&#10;IF(&#10;((SUM(IF [Date this week (vendor) (copy)_1849642490970136576] THEN [non_discounted_markup_fp_product_count] END)/&#10;SUM(IF [Date this week (vendor) (copy)_1849642490970136576] THEN [mapped_fp_product_count] END))&#10;- &#10;(SUM(IF [Date last week (vendor) (copy)_1849642490970136578] THEN [non_discounted_markup_fp_product_count] END)/&#10;SUM(IF [Date last week (vendor) (copy)_1849642490970136578] THEN [mapped_fp_product_count] END)))&#10; &gt;= 0)&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;((SUM(IF [Date this week (vendor) (copy)_1849642490970136576] THEN [non_discounted_markup_fp_product_count] END)/&#10;SUM(IF [Date this week (vendor) (copy)_1849642490970136576] THEN [mapped_fp_product_count] END))&#10;- &#10;(SUM(IF [Date last week (vendor) (copy)_1849642490970136578] THEN [non_discounted_markup_fp_product_count] END)/&#10;SUM(IF [Date last week (vendor) (copy)_1849642490970136578] THEN [mapped_fp_product_count] END)))&#10;* 100,1))&#10;+&apos;%&apos;)&#10;&#10;ELSEIF [Parameters].[Week/Month View (vendor) (copy)_1716575172400848898] = &apos;week&apos; AND [Parameters].[View Type (copy)_1168191572237275138] = &apos;Relative&apos; AND [Parameters].[Parameter 4] = &apos;Item discounted&apos; THEN (&#10;&#10;IF(&#10;((SUM(IF [Date this week (vendor) (copy)_1849642490970136576] THEN [item_discounted_markup_fp_product_count] END)/&#10;SUM(IF [Date this week (vendor) (copy)_1849642490970136576] THEN [mapped_fp_product_count] END))&#10;- &#10;(SUM(IF [Date last week (vendor) (copy)_1849642490970136578] THEN [item_discounted_markup_fp_product_count] END)/&#10;SUM(IF [Date last week (vendor) (copy)_1849642490970136578] THEN [ma