        <column caption='Avg Commission %' datatype='real' name='[Calculation_1394849267146932226]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Non discounted&apos; THEN [Calculation_2954079903065403401]/[Vendors with Mark-up (copy)_2954079903057100803]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Item discounted&apos; THEN [Monthly Non-discounted FP Commision (copy)_2954079903067385866]/[Vendors with non discounted Mark-up (copy)_2954079903057485828]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vendor discounted&apos; THEN [Monthly Non-discounted FP Commision (copy)_2954079903067496459]/[Vendors with Item-discounted Mark-up (copy)_2954079903057788933]&#10;ELSE 0&#10;END' />
        </column>
        <column caption='Avg Markup Value Eur' datatype='real' name='[Calculation_2533767391924903937]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Non discounted&apos; THEN [Monthly Non-discounted FP Commision (copy)_2954079903075614737]/[Vendors with Mark-up (copy)_2954079903057100803]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Item discounted&apos; THEN [Monthly Item-discounted FP Commision (copy)_2954079903075614738]/[Vendors with non discounted Mark-up (copy)_2954079903057485828]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vendor discounted&apos; THEN [Monthly Vendor-discounted FP Commision (copy)_2954079903075614739]/[Vendors with Item-discounted Mark-up (copy)_2954079903057788933]&#10;ELSE 0&#10;END' />
        </column>
        <column caption='Avg Monthly Gfv Eur' datatype='real' name='[Calculation_3982730200508575744]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Non discounted&apos; THEN [Monthly Non-discounted FP Commision (copy)_2954079903074521102]/[Vendors with Mark-up (copy)_2954079903057100803]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Item discounted&apos; THEN [Monthly Item-discounted FP Commision (copy)_2954079903074521103]/[Vendors with non discounted Mark-up (copy)_2954079903057485828]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vendor discounted&apos; THEN [Monthly Vendor-discounted FP Commision (copy)_2954079903074521104]/[Vendors with Item-discounted Mark-up (copy)_2954079903057788933]&#10;ELSE 0&#10;END' />
        </column>
