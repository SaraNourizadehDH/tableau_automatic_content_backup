      <column caption='Risky Vendor Colour' datatype='string' name='[Calculation_2400066757819244545]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (ZN(COUNT([__tableau_internal_object_id__].[content_risky_vendors_994DC606BA444A70B9D74AF5DA2F5985])) - LOOKUP(ZN(COUNT([__tableau_internal_object_id__].[content_risky_vendors_994DC606BA444A70B9D74AF5DA2F5985])), -1)) / ABS(LOOKUP(ZN(COUNT([__tableau_internal_object_id__].[content_risky_vendors_994DC606BA444A70B9D74AF5DA2F5985])), -1)) &gt; 0 THEN &quot;Green&quot;&#10;ELSEIF  (ZN(COUNT([__tableau_internal_object_id__].[content_risky_vendors_994DC606BA444A70B9D74AF5DA2F5985])) - LOOKUP(ZN(COUNT([__tableau_internal_object_id__].[content_risky_vendors_994DC606BA444A70B9D74AF5DA2F5985])), -1)) / ABS(LOOKUP(ZN(COUNT([__tableau_internal_object_id__].[content_risky_vendors_994DC606BA444A70B9D74AF5DA2F5985])), -1)) &lt; 0 THEN &quot;Red&quot;&#10;ELSE &quot;Grey&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='index' datatype='integer' name='[Calculation_3058225649166135296]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='index()'>
