    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Mark-up products vs competitors'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APCompetitordashboard/Mark-upproductsvscompetitors?rev=' id='Mark-upproductsvscompetitors' path='/t/Foodora/workbooks/APCompetitordashboard' revision='' site='Foodora' />
      <style />
      <size maxheight='900' maxwidth='2400' minheight='900' minwidth='2400' sizing-mode='fixed' />
      <datasources>
        <datasource caption='[BQ] Mark-up Products' name='federated.03m11661y0ybtg1h2b61a1yqucor (copy 2)' />
      </datasources>
      <datasource-dependencies datasource='federated.03m11661y0ybtg1h2b61a1yqucor (copy 2)'>
        <column caption='Non Discounted Price Markup %' datatype='real' name='[Calculation_2263199577238491146]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='MAX([non_discounted_price_diff_proportion])*100' />
        </column>
        <column caption='Monthly Commission %' datatype='real' name='[Calculation_2290924852547842048]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='MAX([fp_avg_commission])*100' />
        </column>
        <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column caption='Competitor Source' datatype='string' name='[competitor_source]' role='dimension' type='nominal' />
        <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Business Type' datatype='string' name='[fp_business_type]' role='dimension' type='nominal' />
        <column aggregation='Max' caption='Monthly Fp Gfv (Eur)' datatype='real' name='[fp_gfv_vendor]' role='measure' type='quantitative' />
        <column caption='Gmv Class' datatype='string' name='[fp_gmv_class]' role='dimension' type='nominal' />
        <column aggregation='Max' caption='Mapping Score' datatype='real' name='[mapping_score]' role='measure' type='quantitative' />
        <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
        <column-instance column='[competitor_source]' derivation='None' name='[none:competitor_source:nk]' pivot='key' type='nominal' />
