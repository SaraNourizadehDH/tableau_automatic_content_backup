            <column caption='Report Week Num' datatype='string' name='[report_week_num]' role='dimension' type='nominal' />
            <column-instance column='[Products with mark-up #/% (copy)_1168191572271689736]' derivation='User' name='[usr:Products with mark-up #/% (copy)_1168191572271689736:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
