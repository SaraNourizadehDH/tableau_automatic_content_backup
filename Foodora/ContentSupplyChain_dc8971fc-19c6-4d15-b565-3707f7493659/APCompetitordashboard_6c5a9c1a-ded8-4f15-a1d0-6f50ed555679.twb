            </column>
            <column caption='Vendors with &gt;=25% Menu Non-discounted Mark-up' datatype='integer' name='[Vendors with Non-discounted Mark-up (copy)_291537747763847168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [has_non_discounted_markup_fp_vendor] = true THEN [num_vendor_more_than_25_perc_of_non_discounted_menu_marked_up] ELSE 0 END)' />
