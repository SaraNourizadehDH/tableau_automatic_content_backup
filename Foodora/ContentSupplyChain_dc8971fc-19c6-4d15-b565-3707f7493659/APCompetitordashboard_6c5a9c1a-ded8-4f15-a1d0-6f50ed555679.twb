      <column caption='% Vendors Fixed' datatype='real' name='[% Chains with Fix (copy)_6834916140862517253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Products with Fix (copy)_6834916140862193666]/[Vendors with Fix (copy)_6834916140935811088]' />
      </column>
      <column caption='% Products Fixed' datatype='real' name='[% Vendors with Fix  (copy)_6834916140862812166]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6834916140861284353]/[Total flagged vendors (copy)_6834916140936118289]' />
      </column>
      <column caption='% Chains Fixed' datatype='real' name='[% Vendors with Fix (copy)_6834916140939661331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Vendors with Fix (copy)_6834916140940177428]/[Total Flagged Vendors (copy)_6834916140939583506]' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.104ib8a12xqx851ag2pan0sw41w8].[pcto:sum:chain_count:qk]&quot;' value='% Chains ' />
          <alias key='&quot;[federated.104ib8a12xqx851ag2pan0sw41w8].[pcto:sum:product_count:qk:8]&quot;' value='% Products ' />
