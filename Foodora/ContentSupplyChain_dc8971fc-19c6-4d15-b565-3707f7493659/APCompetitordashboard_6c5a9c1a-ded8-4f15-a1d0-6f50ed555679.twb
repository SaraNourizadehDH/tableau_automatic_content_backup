      <aliases enabled='yes' />
      <column caption='Difference' datatype='string' name='[% Change (copy)_5734067493612433423]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Difference&apos;' />
      </column>
      <column caption='AOV Eur After' datatype='real' name='[Average Order Value (AOV) Before (copy)_5734067493526827016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv_eur_6wks_after])/SUM([valid_orders_6wks_after])' />
      </column>
      <column caption='has correct product mapping' datatype='integer' name='[Calculation_1304847639607885824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [has_correct_product_mapping] THEN [vendor_uuid] ELSE NULL END)' />
      </column>
      <column caption='exlcude vendors' datatype='integer' name='[Calculation_1304847639608147969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [has_excluded_adjustment] THEN [vendor_uuid] ELSE NULL END)' />
      </column>
      <column caption='Month Header' datatype='string' name='[Calculation_1304847639668924418]' role='dimension' type='nominal'>
