      <column caption='index' datatype='integer' name='[Calculation_2263199577226113024]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Has Non Discounted Price Markup' datatype='boolean' name='[Calculation_2263199577236017155]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [non_discounted_price_diff] &gt; 0 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Non Discounted Price Markup %' datatype='real' name='[Calculation_2263199577238491146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([non_discounted_price_diff_proportion])*100' />
      </column>
      <column caption='Item Discounted Price Markup %' datatype='real' name='[Calculation_2263199577436311574]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([item_discounted_price_diff_proportion])*100' />
      </column>
      <column caption='Vendor Discounted Price Markup %' datatype='real' name='[Calculation_2263199577436676119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([vendor_discounted_price_diff_proportion])*100' />
      </column>
      <column caption='Monthly Commission %' datatype='real' name='[Calculation_2290924852547842048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([fp_avg_commission])*100' />
      </column>
      <column caption='fp_menu_markup_percent' datatype='real' name='[Calculation_3907083800497315841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [non_discounted_price_diff_proportion] &gt; 100&#10;THEN 100&#10;ELSE [non_discounted_price_diff_proportion]&#10;END' />
      </column>
      <column caption='Has Discounted Price Markup' datatype='boolean' name='[Has Non Discounted Price Markup (copy)_2263199577319272462]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([ci_item_discounted_price] &gt; 0 AND [item_discounted_price_diff] &gt; 0) &#10;OR ([ci_vendor_discounted_price] &gt; 0 AND [vendor_discounted_price_diff] &gt; 0)&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
