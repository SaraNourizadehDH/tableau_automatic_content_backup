      <column caption='Mark-up' datatype='real' name='[% Products with Mark-up (copy)_4434497543966007298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_markup_product_count])/sum([total_mapped_product_count])' />
      </column>
      <column caption='No Mark-up' datatype='real' name='[% Products without Mark-up (copy)_4434497543966007297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-[Calculation_2064407871020658690]' />
