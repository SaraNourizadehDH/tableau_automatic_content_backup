            <column caption='Has Item Discounted Markup Fp Vendor' datatype='boolean' name='[has_item_discounted_markup_fp_vendor]' role='dimension' type='nominal' />
            <column caption='Has Non Discounted Markup Fp Vendor' datatype='boolean' name='[has_non_discounted_markup_fp_vendor]' role='dimension' type='nominal' />
