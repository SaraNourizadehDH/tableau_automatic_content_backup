    <worksheet name='Vendors with mark up (vs Competitors)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>Vendors with Mark-Up (vs competitors)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[BQ] Mark-up on country level' name='federated.16rxfob0ekggkq1cvz2vp0bav54c (copy 5)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Markup Type' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Non discounted&quot;'>
              <calculation class='tableau' formula='&quot;Non discounted&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.16rxfob0ekggkq1cvz2vp0bav54c (copy 5)'>
            <column caption='Vendors without Menu Mark-up' datatype='integer' name='[% Vendors without Markup (copy)_1647965642770063380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2954079902724325377] - [Calculation_1647965642769166355]' />
            </column>
            <column caption='Avg Commission %' datatype='real' name='[Calculation_1394849267146932226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Non discounted&apos; THEN [Calculation_2954079903065403401]/[Vendors with Mark-up (copy)_2954079903057100803]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Item discounted&apos; THEN [Monthly Non-discounted FP Commision (copy)_2954079903067385866]/[Vendors with non discounted Mark-up (copy)_2954079903057485828]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vendor discounted&apos; THEN [Monthly Non-discounted FP Commision (copy)_2954079903067496459]/[Vendors with Item-discounted Mark-up (copy)_2954079903057788933]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Avg Mapping Accuracy %' datatype='real' name='[Calculation_163748085689851910]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Non discounted&apos; THEN [Monthly Non-discounted FP Commision (copy)_2954079903077367828]/[Vendors with Mark-up (copy)_2954079903057100803]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Item discounted&apos; THEN [Monthly Item-discounted FP Commision (copy)_2954079903077367829]/[Vendors with non discounted Mark-up (copy)_2954079903057485828]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vendor discounted&apos; THEN [Monthly Vendor-discounted FP Commision (copy)_2954079903077367830]/[Vendors with Item-discounted Mark-up (copy)_2954079903057788933]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='% Vendors without Menu Mark-up' datatype='real' name='[Calculation_1647965642609696779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% Vendors without Markup (copy)_1647965642770063380]/[Calculation_2954079902724325377]' />
            </column>
            <column caption='Vendors with Menu Mark-up' datatype='integer' name='[Calculation_1647965642769166355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Non discounted&apos; THEN [Vendors with Mark-up (copy)_2954079903057100803]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Item discounted&apos; THEN [Vendors with non discounted Mark-up (copy)_2954079903057485828]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vendor discounted&apos; THEN [Vendors with Item-discounted Mark-up (copy)_2954079903057788933]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='% Vendors with &lt;25% Menu Mark-up' datatype='real' name='[Calculation_1692438683409342464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-[Calculation_4553913317811040267]-[Calculation_1647965642609696779]' />
            </column>
            <column caption='Avg Markup Value Eur' datatype='real' name='[Calculation_2533767391924903937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Non discounted&apos; THEN [Monthly Non-discounted FP Commision (copy)_2954079903075614737]/[Vendors with Mark-up (copy)_2954079903057100803]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Item discounted&apos; THEN [Monthly Item-discounted FP Commision (copy)_2954079903075614738]/[Vendors with non discounted Mark-up (copy)_2954079903057485828]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vendor discounted&apos; THEN [Monthly Vendor-discounted FP Commision (copy)_2954079903075614739]/[Vendors with Item-discounted Mark-up (copy)_2954079903057788933]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Mapped Vendor Count (vs competitors)' datatype='integer' name='[Calculation_2954079902724325377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_mapped_fp_vendor] = true THEN [fp_vendor_count] ELSE NULL END)' />
            </column>
            <column caption='% Vendors mapped to competitors' datatype='real' name='[Calculation_2954079902740594690]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2954079902724325377]/SUM([fp_vendor_count])' />
            </column>
            <column caption='Products with Mark-up' datatype='integer' name='[Calculation_2954079903062765576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 4] = &apos;Non discounted&apos; THEN [non_discounted_markup_fp_product_count]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Item discounted&apos; THEN [item_discounted_markup_fp_product_count]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vendor discounted&apos; THEN [vendor_discounted_markup_fp_product_count]&#10;ELSE 0&#10;END)' />
            </column>
            <column caption='Monthly Non-discounted FP Commision' datatype='real' name='[Calculation_2954079903065403401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [has_non_discounted_markup_fp_vendor] THEN [total_fp_commission] ELSE 0 END)' />
            </column>
            <column caption='country sort' datatype='integer' name='[Calculation_3579446951069786112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [country]&#10;WHEN &apos;Bangladesh&apos; THEN 1&#10;WHEN &apos;Cambodia&apos; THEN 2&#10;WHEN &apos;Hong Kong&apos; THEN 3&#10;WHEN &apos;Laos&apos; THEN 4&#10;WHEN &apos;Malaysia&apos; THEN 5&#10;WHEN &apos;Myanmar&apos; THEN 6&#10;WHEN &apos;Pakistan&apos; THEN 7&#10;WHEN &apos;Philippines&apos; THEN 8&#10;WHEN &apos;Singapore&apos; THEN 9&#10;WHEN &apos;Taiwan&apos; THEN 10&#10;WHEN &apos;Thailand&apos; THEN 11&#10;WHEN &apos;APAC&apos; THEN 12&#10;WHEN &apos;Austria&apos; THEN 13&#10;WHEN &apos;Czech Republic&apos; THEN 14&#10;WHEN &apos;Denmark&apos; THEN 15&#10;WHEN &apos;Finland&apos; THEN 16&#10;WHEN &apos;Hungary&apos; THEN 17&#10;WHEN &apos;Norway&apos; THEN 18&#10;WHEN &apos;Slovakia&apos; THEN 19&#10;WHEN &apos;Sweden&apos; THEN 20&#10;WHEN &apos;Turkey&apos; THEN 20&#10;WHEN &apos;EUROPE&apos; THEN 21&#10;WHEN &apos;EUROPE + YEMEK&apos; THEN 22&#10;WHEN &apos;PANDORA&apos; THEN 23&#10;END' />
            </column>
            <column caption='Avg Monthly Gfv Eur' datatype='real' name='[Calculation_3982730200508575744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Non discounted&apos; THEN [Monthly Non-discounted FP Commision (copy)_2954079903074521102]/[Vendors with Mark-up (copy)_2954079903057100803]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Item discounted&apos; THEN [Monthly Item-discounted FP Commision (copy)_2954079903074521103]/[Vendors with non discounted Mark-up (copy)_2954079903057485828]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vendor discounted&apos; THEN [Monthly Vendor-discounted FP Commision (copy)_2954079903074521104]/[Vendors with Item-discounted Mark-up (copy)_2954079903057788933]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Avg # of Mark-up products per vendor' datatype='real' name='[Calculation_4434497543955582976 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2954079903062765576]/[Calculation_1647965642769166355]' />
