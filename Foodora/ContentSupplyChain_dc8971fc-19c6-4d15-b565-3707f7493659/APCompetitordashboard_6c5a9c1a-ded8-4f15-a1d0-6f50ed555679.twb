    <worksheet name='Vendors with Mark-up WoW/MoM'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='14'>Vendors with Mark-up by &lt;</run>
            <run fontsize='14'>[Parameters].[Parameter 1 2 3]</run>
            <run fontsize='14'>&gt; (vs competitors)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[BQ] Mark-up on country level' name='federated.16rxfob0ekggkq1cvz2vp0bav54c (copy 5)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Week/Month View (vendor)' datatype='string' name='[Parameter 1 2 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;week&quot;' value='Week' />
              </aliases>
            </column>
            <column caption='Markup Type' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Non discounted&quot;'>
              <calculation class='tableau' formula='&quot;Non discounted&quot;' />
            </column>
            <column alias='Relative %' caption='View Type (vendor)' datatype='string' name='[View Type (product) (copy)_1168191572237352963]' param-domain-type='list' role='measure' type='nominal' value='&quot;Relative&quot;'>
              <calculation class='tableau' formula='&quot;Relative&quot;' />
              <aliases>
                <alias key='&quot;Absolute&quot;' value='Absolute #' />
                <alias key='&quot;Relative&quot;' value='Relative %' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.16rxfob0ekggkq1cvz2vp0bav54c (copy 5)'>
            <column caption='Vendors with Menu Mark-up' datatype='integer' name='[Calculation_1647965642769166355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Non discounted&apos; THEN [Vendors with Mark-up (copy)_2954079903057100803]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Item discounted&apos; THEN [Vendors with non discounted Mark-up (copy)_2954079903057485828]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vendor discounted&apos; THEN [Vendors with Item-discounted Mark-up (copy)_2954079903057788933]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Mapped Vendor Count (vs competitors)' datatype='integer' name='[Calculation_2954079902724325377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_mapped_fp_vendor] = true THEN [fp_vendor_count] ELSE NULL END)' />
            </column>
            <column caption='country sort' datatype='integer' name='[Calculation_3579446951069786112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [country]&#10;WHEN &apos;Bangladesh&apos; THEN 1&#10;WHEN &apos;Cambodia&apos; THEN 2&#10;WHEN &apos;Hong Kong&apos; THEN 3&#10;WHEN &apos;Laos&apos; THEN 4&#10;WHEN &apos;Malaysia&apos; THEN 5&#10;WHEN &apos;Myanmar&apos; THEN 6&#10;WHEN &apos;Pakistan&apos; THEN 7&#10;WHEN &apos;Philippines&apos; THEN 8&#10;WHEN &apos;Singapore&apos; THEN 9&#10;WHEN &apos;Taiwan&apos; THEN 10&#10;WHEN &apos;Thailand&apos; THEN 11&#10;WHEN &apos;APAC&apos; THEN 12&#10;WHEN &apos;Austria&apos; THEN 13&#10;WHEN &apos;Czech Republic&apos; THEN 14&#10;WHEN &apos;Denmark&apos; THEN 15&#10;WHEN &apos;Finland&apos; THEN 16&#10;WHEN &apos;Hungary&apos; THEN 17&#10;WHEN &apos;Norway&apos; THEN 18&#10;WHEN &apos;Slovakia&apos; THEN 19&#10;WHEN &apos;Sweden&apos; THEN 20&#10;WHEN &apos;Turkey&apos; THEN 20&#10;WHEN &apos;EUROPE&apos; THEN 21&#10;WHEN &apos;EUROPE + YEMEK&apos; THEN 22&#10;WHEN &apos;PANDORA&apos; THEN 23&#10;END' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_4711891126661390342]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region] = &apos;MENA&apos; THEN &apos;Europe + Yemek&apos; ELSE [region] END' />
            </column>
            <column caption='% Vendors with Menu Mark-up' datatype='real' name='[Calculation_6501860868173864961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1647965642769166355]/[Calculation_2954079902724325377]' />
            </column>
            <column caption='Dynamic Date Filter (vendor)' datatype='boolean' name='[Dynamic Date Filter (qc success date) (copy)_757871425821081640 3]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1 2 3] = &apos;month&apos; AND [is_last_week_of_month] = true AND [report_week_num] &gt;= &apos;2022-48&apos;&#10;THEN [report_week] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) AND [report_week] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1 2 3] = &apos;week&apos; AND [report_week_num] &gt;= &apos;2022-48&apos;&#10;THEN [report_week] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [report_week] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;END' />
            </column>
            <column caption='Dynamic Date Range (vendor)' datatype='string' name='[Dynamic Date Range (qc success date) (copy)_757871425821081639 3]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1 2 3] = &apos;week&apos; then str(DATEPART(&apos;iso-year&apos;,[report_week]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[report_week]))&#10;ELSEIF [Parameters].[Parameter 1 2 3] = &apos;month&apos; then LEFT(str(DATENAME(&apos;month&apos;,[report_week])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[report_week])),2) end' />
            </column>
            <column caption='Vendors with mark-up #/%' datatype='string' datatype-customized='true' name='[Products with mark-up #/% (copy)_1168191572271689736]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(CASE [Parameters].[View Type (product) (copy)_1168191572237352963]&#10;WHEN &apos;Absolute&apos; THEN [Calculation_1647965642769166355]&#10;WHEN &apos;Relative&apos; THEN ROUND([Calculation_6501860868173864961]*100,2)&#10;END)&#10;+&#10;CASE [Parameters].[View Type (product) (copy)_1168191572237352963]&#10;WHEN&apos;Absolute&apos; THEN &quot;&quot;&#10;WHEN &apos;Relative&apos; THEN &quot;%&quot;&#10;END' />
            </column>
            <column caption='Vendors with Vendor-discounted Mark-up' datatype='integer' name='[Vendors with Item-discounted Mark-up (copy)_2954079903057788933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [has_vendor_discounted_markup_fp_vendor] = true THEN [fp_vendor_count] ELSE 0 END)' />
            </column>
            <column caption='Vendors with Non-discounted Mark-up' datatype='integer' name='[Vendors with Mark-up (copy)_2954079903057100803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [has_non_discounted_markup_fp_vendor] = true THEN [fp_vendor_count] ELSE 0 END)' />
            </column>
            <column caption='Vendors with Item-discounted Mark-up' datatype='integer' name='[Vendors with non discounted Mark-up (copy)_2954079903057485828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [has_item_discounted_markup_fp_vendor] = true THEN [fp_vendor_count] ELSE 0 END)' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Business Type' datatype='string' name='[fp_business_type]' role='dimension' type='nominal' />
            <column caption='Gmv Class' datatype='string' name='[fp_gmv_class]' role='dimension' type='nominal' />
            <column caption='Active Vendor Count (on foodpanda)' datatype='integer' name='[fp_vendor_count]' role='measure' type='quantitative' />
