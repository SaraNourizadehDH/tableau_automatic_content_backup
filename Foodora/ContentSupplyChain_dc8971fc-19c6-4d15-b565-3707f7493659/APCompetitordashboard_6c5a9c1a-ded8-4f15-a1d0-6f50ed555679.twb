            <column-instance column='[Dynamic Date Filter (qc success date) (copy)_757871425821081640 3]' derivation='None' name='[none:Dynamic Date Filter (qc success date) (copy)_757871425821081640 3:nk]' pivot='key' type='nominal' />
            <column-instance column='[Dynamic Date Range (qc success date) (copy)_757871425821081639 3]' derivation='None' name='[none:Dynamic Date Range (qc success date) (copy)_757871425821081639 3:nk]' pivot='key' type='nominal' />
