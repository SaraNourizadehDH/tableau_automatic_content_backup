            </column>
            <column caption='Status or Reason Sort' datatype='integer' name='[Calculation_6834916140928909322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [status_or_reason]&#10;WHEN &apos;flagged in gapfinder data&apos; THEN 1&#10;WHEN &apos;excluded vendors&apos; THEN 2&#10;WHEN &apos;correctly mapped&apos; THEN 3&#10;WHEN &apos;with price markup&apos; THEN 4&#10;WHEN &apos;unable to validate&apos; THEN 5&#10;WHEN &apos;fixed&apos; THEN 6&#10;WHEN &apos;vendor is excluded&apos; THEN 7&#10;WHEN &apos;vendor name is not matching&apos; THEN 8&#10;WHEN &apos;vendor is closed&apos; THEN 9&#10;WHEN &apos;variation is not matching&apos; THEN 10&#10;WHEN &apos;item is not matching&apos; THEN 11&#10;WHEN &apos;description is not matching&apos; THEN 12&#10;WHEN &apos;item cannot be found in foodpanda menu&apos; THEN 13&#10;WHEN &apos;item cannot be found in competitor menu&apos; THEN 14&#10;WHEN &apos;item cannot be found in both menus&apos; THEN 15&#10;WHEN &apos;no markup&apos; THEN 16&#10;WHEN &apos;markup present&apos; THEN 17&#10;WHEN &apos;higher commission on foodpanda&apos; THEN 18&#10;WHEN &apos;error due to erroneous menu update&apos; THEN 19&#10;WHEN &apos;done&apos; THEN 20&#10;WHEN NULL THEN 21&#10;END' />
            </column>
            <column caption='Reason' datatype='string' name='[Status Or Reason (copy)_1680124158138998795]' role='dimension' type='nominal'>
