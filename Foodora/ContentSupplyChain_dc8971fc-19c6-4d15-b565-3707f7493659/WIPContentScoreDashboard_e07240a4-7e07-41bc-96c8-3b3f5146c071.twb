              <calculation class='tableau' formula='LEFT([Week date Range (copy)_1408500840146587649],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,TODAY())))),3)' />
            </column>
            <column caption='This month' datatype='boolean' name='[this week (copy)_757871425716707339]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT([Week date Range (copy)_1408500840146587649],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3)' />
            </column>
            <column-instance column='[Avg content score MoM (copy)_4795911398670868495]' derivation='User' name='[usr:Avg content score MoM (copy)_4795911398670868495:nk]' pivot='key' type='nominal' />
            <column-instance column='[Avg content score MoM ▲▼ (copy)_4795911398670868496]' derivation='User' name='[usr:Avg content score MoM ▲▼ (copy)_4795911398670868496:nk]' pivot='key' type='nominal' />
