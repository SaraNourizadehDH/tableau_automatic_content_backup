            <column-instance column='[Calculation_6330864842503241728]' derivation='User' name='[usr:Calculation_6330864842503241728:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Type' datatype='string' name='[vendor_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
