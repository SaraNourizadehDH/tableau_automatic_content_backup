      <column caption='% Vendors with Outstanding Score MoM' datatype='string' name='[Avg content score MoM (copy)_4795911398670868495]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[TBC Parameter] = &apos;Include&apos; THEN (&#10;IF(&#10;((SUM(IF [this week (copy)_757871425716707339] THEN [outstanding_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425716707339] THEN [active_vendor_count] ELSE 0 END))&#10;-&#10;(SUM(IF [this month (copy)_757871425717612556] THEN [outstanding_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this month (copy)_757871425717612556] THEN [active_vendor_count] ELSE 0 END)))&#10;&gt;= 0) THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND((&#10;ROUND((SUM(IF [this week (copy)_757871425716707339] THEN [outstanding_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425716707339] THEN [active_vendor_count] ELSE 0 END)),4)&#10;-&#10;ROUND((SUM(IF [this month (copy)_757871425717612556] THEN [outstanding_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this month (copy)_757871425717612556] THEN [active_vendor_count] ELSE 0 END)),4)&#10;)&#10;*100,2))&#10;)&#10;&#10;ELSEIF [Parameters].[TBC Parameter] = &apos;Exclude&apos; THEN (&#10;IF(&#10;((SUM(IF [this week (copy)_757871425716707339] THEN [outstanding_non_stock_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425716707339] THEN [active_vendor_count] ELSE 0 END))&#10;-&#10;(SUM(IF [this month (copy)_757871425717612556] THEN [outstanding_non_stock_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this month (copy)_757871425717612556] THEN [active_vendor_count] ELSE 0 END)))&#10;&gt;= 0) THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND((&#10;ROUND((SUM(IF [this week (copy)_757871425716707339] THEN [outstanding_non_stock_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425716707339] THEN [active_vendor_count] ELSE 0 END)),4)&#10;-&#10;ROUND((SUM(IF [this month (copy)_757871425717612556] THEN [outstanding_non_stock_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this month (copy)_757871425717612556] THEN [active_vendor_count] ELSE 0 END)),4)&#10;)&#10;*100,2))&#10;)&#10;&#10;END&#10;+ &apos;%&apos;' />
      </column>
      <column caption='% Vendors with Outstanding Score MoM ▲▼' datatype='string' name='[Avg content score MoM ▲▼ (copy)_4795911398670868496]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF  LEFT([Avg content score MoM (copy)_4795911398670868495],1) =   &apos;▲&apos; THEN   &apos;▲&apos; &#13;&#10;ELSE   &apos;▼&apos;&#13;&#10;END' />
