        <calculation class='tableau' formula='IF [Parameters].[TBC Parameter] = &apos;Include&apos; THEN (&#10;IF (&#10;((SUM(IF [this week (copy)_757871425716707339] THEN [sum_menu_score] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425716707339] THEN [active_vendor_count] ELSE 0 END))&#10;-&#10;(SUM(IF [this month (copy)_757871425717612556] THEN [sum_menu_score] ELSE 0 END)/&#10;    SUM(IF [this month (copy)_757871425717612556] THEN [active_vendor_count] ELSE 0 END)))&#10;&gt;= 0) THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;(&#10;ROUND((SUM(IF [this week (copy)_757871425716707339] THEN [sum_menu_score] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425716707339] THEN [active_vendor_count] ELSE 0 END)),2)&#10;-&#10;ROUND((SUM(IF [this month (copy)_757871425717612556] THEN [sum_menu_score] ELSE 0 END)/&#10;    SUM(IF [this month (copy)_757871425717612556] THEN [active_vendor_count] ELSE 0 END)),2)&#10;)/&#10;ROUND((SUM(IF [this month (copy)_757871425717612556] THEN [sum_menu_score] ELSE 0 END)/&#10;    SUM(IF [this month (copy)_757871425717612556] THEN [active_vendor_count] ELSE 0 END)),2)&#10;*100,2))&#10;)&#10;&#10;ELSEIF [Parameters].[TBC Parameter] = &apos;Exclude&apos; THEN (&#10;IF (&#10;((SUM(IF [this week (copy)_757871425716707339] THEN [sum_non_stock_menu_score] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425716707339] THEN [active_vendor_count] ELSE 0 END))&#10;-&#10;(SUM(IF [this month (copy)_757871425717612556] THEN [sum_non_stock_menu_score] ELSE 0 END)/&#10;    SUM(IF [this month (copy)_757871425717612556] THEN [active_vendor_count] ELSE 0 END)))&#10;&gt;= 0) THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND(&#10;(&#10;ROUND((SUM(IF [this week (copy)_757871425716707339] THEN [sum_non_stock_menu_score] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425716707339] THEN [active_vendor_count] ELSE 0 END)),2)&#10;-&#10;ROUND((SUM(IF [this month (copy)_7578714257176125