  <worksheets>
    <worksheet name='% Vendors with Outstanding Score (Region)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#b00f53' fontsize='12'>% Vendors with Outstanding Score</run>
