    <worksheet name='Avg. Vendor Menu Score (Region)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#b00f53' fontsize='11'>Avg. Vendor Menu Score</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[BQ] Menu Strength - Country' name='federated.1mb7ufj1tdag311ep5vn3187l7ba (copy 2)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Stock Photo Filter' datatype='string' name='[TBC Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Include&quot;'>
              <calculation class='tableau' formula='&quot;Include&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mb7ufj1tdag311ep5vn3187l7ba (copy 2)'>
            <column caption='Week filter' datatype='boolean' name='[Calculation_1791377155892424704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_week] &gt;= DATEADD(&apos;week&apos;,-4,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [report_week] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_2269180907905355776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region] = &apos;MENA&apos; THEN &apos;Europe&apos; ELSE [region] END' />
            </column>
            <column caption='Avg Vendor Menu Score' datatype='real' name='[Calculation_6330864842503241728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[TBC Parameter] = &apos;Include&apos; THEN SUM([sum_menu_score])/SUM([active_vendor_count])&#10;ELSEIF [Parameters].[TBC Parameter] = &apos;Exclude&apos; THEN SUM([sum_non_stock_menu_score])/SUM([active_vendor_count])&#10;ELSE 0 END' />
            </column>
            <column caption='Active Vendor Count' datatype='integer' name='[active_vendor_count]' role='measure' type='quantitative' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column-instance column='[country sort (copy)_2017120055761891331]' derivation='Count' name='[cnt:country sort (copy)_2017120055761891331:qk]' pivot='key' type='quantitative' />
            <column caption='Country/region sort' datatype='string' name='[country sort (copy)_2017120055761891331]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;WHEN &apos;EUROPE&apos; THEN &apos;Region 1&apos;&#10;WHEN &apos;EUROPE - TR&apos; THEN &apos;Region 2&apos;&#10;WHEN &apos;APAC&apos; THEN &apos;Region 3&apos;&#10;WHEN &apos;PANDORA&apos; THEN &apos;Region 4&apos;&#10;WHEN &apos;PANDORA - TR&apos; THEN &apos;Region 5&apos;&#10;ELSE &apos;Country&apos;&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Gmv Class' datatype='string' name='[gmv_class]' role='dimension' type='nominal' />
            <column caption='Is Chain' datatype='boolean' name='[is_chain]' role='dimension' type='nominal' />
            <column caption='Is Pandapro' datatype='boolean' name='[is_pandapro]' role='dimension' type='nominal' />
            <column caption='Is Zombie' datatype='boolean' name='[is_zombie]' role='dimension' type='nominal' />
            <column-instance column='[report_week]' derivation='Max' name='[max:report_week:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1791377155892424704]' derivation='None' name='[none:Calculation_1791377155892424704:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2269180907905355776]' derivation='None' name='[none:Calculation_2269180907905355776:nk]' pivot='key' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[gmv_class]' derivation='None' name='[none:gmv_class:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_chain]' derivation='None' name='[none:is_chain:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_pandapro]' derivation='None' name='[none:is_pandapro:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_zombie]' derivation='None' name='[none:is_zombie:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_week_num]' derivation='None' name='[none:report_week_num:nk]' pivot='key' type='nominal' />
            <column-instance column='[sf_vendor_grade]' derivation='None' name='[none:sf_vendor_grade:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column caption='Region (raw)' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Report Week' datatype='date' name='[report_week]' role='dimension' type='ordinal' />
            <column caption='Report Week No.' datatype='string' name='[report_week_num]' role='dimension' type='nominal' />
            <column caption='Sf Vendor Grade' datatype='string' name='[sf_vendor_grade]' role='dimension' type='nominal' />
            <column caption='Sum Menu Score' datatype='real' name='[sum_menu_score]' role='measure' type='quantitative' />
