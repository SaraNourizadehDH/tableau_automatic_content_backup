    <worksheet name='Outstanding Vendors LM%'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#b00f53' fontsize='14'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[BQ] Menu Strength - Country' name='federated.1mb7ufj1tdag311ep5vn3187l7ba (copy 2)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Stock Photo Filter' datatype='string' name='[TBC Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Include&quot;'>
              <calculation class='tableau' formula='&quot;Include&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mb7ufj1tdag311ep5vn3187l7ba (copy 2)'>
            <column caption='% Vendors with Outstanding Score MoM' datatype='string' name='[Avg content score MoM (copy)_4795911398670868495]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[TBC Parameter] = &apos;Include&apos; THEN (&#10;IF(&#10;((SUM(IF [this week (copy)_757871425716707339] THEN [outstanding_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425716707339] THEN [active_vendor_count] ELSE 0 END))&#10;-&#10;(SUM(IF [this month (copy)_757871425717612556] THEN [outstanding_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this month (copy)_757871425717612556] THEN [active_vendor_count] ELSE 0 END)))&#10;&gt;= 0) THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND((&#10;ROUND((SUM(IF [this week (copy)_757871425716707339] THEN [outstanding_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425716707339] THEN [active_vendor_count] ELSE 0 END)),4)&#10;-&#10;ROUND((SUM(IF [this month (copy)_757871425717612556] THEN [outstanding_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this month (copy)_757871425717612556] THEN [active_vendor_count] ELSE 0 END)),4)&#10;)&#10;*100,2))&#10;)&#10;&#10;ELSEIF [Parameters].[TBC Parameter] = &apos;Exclude&apos; THEN (&#10;IF(&#10;((SUM(IF [this week (copy)_757871425716707339] THEN [outstanding_non_stock_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425716707339] THEN [active_vendor_count] ELSE 0 END))&#10;-&#10;(SUM(IF [this month (copy)_757871425717612556] THEN [outstanding_non_stock_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this month (copy)_757871425717612556] THEN [active_vendor_count] ELSE 0 END)))&#10;&gt;= 0) THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND((&#10;ROUND((SUM(IF [this week (copy)_757871425716707339] THEN [outstanding_non_stock_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425716707339] THEN [active_vendor_count] ELSE 0 END)),4)&#10;-&#10;ROUND((SUM(IF [this month (copy)_757871425717612556] THEN [outstanding_non_stock_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this month (copy)_757871425717612556] THEN [active_vendor_count] ELSE 0 END)),4)&#10;)&#10;*100,2))&#10;)&#10;&#10;END&#10;+ &apos;%&apos;' />
            </column>
            <column caption='% Vendors with Outstanding Score MoM ▲▼' datatype='string' name='[Avg content score MoM ▲▼ (copy)_4795911398670868496]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF  LEFT([Avg content score MoM (copy)_4795911398670868495],1) =   &apos;▲&apos; THEN   &apos;▲&apos; &#13;&#10;ELSE   &apos;▼&apos;&#13;&#10;END' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_2269180907905355776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region] = &apos;MENA&apos; THEN &apos;Europe&apos; ELSE [region] END' />
            </column>
            <column caption='country sort' datatype='integer' name='[Calculation_3579446951069786112 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [country]&#10;WHEN &apos;Bangladesh&apos; THEN 1&#10;WHEN &apos;Cambodia&apos; THEN 2&#10;WHEN &apos;Hong Kong&apos; THEN 3&#10;WHEN &apos;Laos&apos; THEN 4&#10;WHEN &apos;Malaysia&apos; THEN 5&#10;WHEN &apos;Myanmar&apos; THEN 6&#10;WHEN &apos;Pakistan&apos; THEN 7&#10;WHEN &apos;Philippines&apos; THEN 8&#10;WHEN &apos;Singapore&apos; THEN 9&#10;WHEN &apos;Taiwan&apos; THEN 10&#10;WHEN &apos;Thailand&apos; THEN 11&#10;WHEN &apos;Austria&apos; THEN 12&#10;WHEN &apos;Czech Republic&apos; THEN 13&#10;WHEN &apos;Denmark&apos; THEN 14&#10;WHEN &apos;Finland&apos; THEN 15&#10;WHEN &apos;Hungary&apos; THEN 16&#10;WHEN &apos;Norway&apos; THEN 17&#10;WHEN &apos;Slovakia&apos; THEN 18&#10;WHEN &apos;Sweden&apos; THEN 19&#10;WHEN &apos;Turkey&apos; THEN 20&#10;WHEN &apos;EUROPE&apos; THEN 21&#10;WHEN &apos;EUROPE - TR&apos; THEN 22&#10;WHEN &apos;APAC&apos; THEN 23&#10;WHEN &apos;PANDORA&apos; THEN 24&#10;WHEN &apos;PANDORA - TR&apos; THEN 25&#10;END' />
            </column>
            <column caption='Month date Range' datatype='string' name='[Week date Range (copy)_1408500840146587649]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(str(DATENAME(&apos;month&apos;,[report_month])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[report_month])),2)' />
            </column>
            <column caption='MoM' datatype='string' name='[WoW (copy)_6330864842510237699]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MoM %Δ&apos;' />
            </column>
            <column caption='Active Vendor Count' datatype='integer' name='[active_vendor_count]' role='measure' type='quantitative' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
