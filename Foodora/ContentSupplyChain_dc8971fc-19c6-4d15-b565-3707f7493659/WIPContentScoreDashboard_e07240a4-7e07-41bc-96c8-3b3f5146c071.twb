    <worksheet name='% Vendors with Outstanding Score LW%'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#b00f53' fontsize='14'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[BQ] Menu Strength - Country' name='federated.1mb7ufj1tdag311ep5vn3187l7ba (copy 2)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Stock Photo Filter' datatype='string' name='[TBC Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Include&quot;'>
              <calculation class='tableau' formula='&quot;Include&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mb7ufj1tdag311ep5vn3187l7ba (copy 2)'>
            <column caption='% Vendors with Outstanding Score WoW' datatype='string' name='[Avg content score WoW (copy)_4795911398666686477]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[TBC Parameter] = &apos;Include&apos; THEN (&#10;IF(&#10;((SUM(IF [Calculation_757871425704644609] THEN [outstanding_vendor_count] ELSE 0 END)/&#10;    SUM(IF [Calculation_757871425704644609] THEN [active_vendor_count] ELSE 0 END))&#10;-&#10;(SUM(IF [this week (copy)_757871425706078212 1] THEN [outstanding_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425706078212 1] THEN [active_vendor_count] ELSE 0 END)))&#10;&gt;= 0) THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND((&#10;ROUND((SUM(IF [Calculation_757871425704644609] THEN [outstanding_vendor_count] ELSE 0 END)/&#10;    SUM(IF [Calculation_757871425704644609] THEN [active_vendor_count] ELSE 0 END)),4)&#10;-&#10;ROUND((SUM(IF [this week (copy)_757871425706078212 1] THEN [outstanding_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425706078212 1] THEN [active_vendor_count] ELSE 0 END)),4)&#10;)&#10;*100,2))&#10;)&#10;&#10;ELSEIF [Parameters].[TBC Parameter] = &apos;Exclude&apos; THEN (&#10;IF(&#10;((SUM(IF [Calculation_757871425704644609] THEN [outstanding_non_stock_vendor_count] ELSE 0 END)/&#10;    SUM(IF [Calculation_757871425704644609] THEN [active_vendor_count] ELSE 0 END))&#10;-&#10;(SUM(IF [this week (copy)_757871425706078212 1] THEN [outstanding_non_stock_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425706078212 1] THEN [active_vendor_count] ELSE 0 END)))&#10;&gt;= 0) THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;+ &apos; &apos;&#10;+ STR(ROUND((&#10;ROUND((SUM(IF [Calculation_757871425704644609] THEN [outstanding_non_stock_vendor_count] ELSE 0 END)/&#10;    SUM(IF [Calculation_757871425704644609] THEN [active_vendor_count] ELSE 0 END)),4)&#10;-&#10;ROUND((SUM(IF [this week (copy)_757871425706078212 1] THEN [outstanding_non_stock_vendor_count] ELSE 0 END)/&#10;    SUM(IF [this week (copy)_757871425706078212 1] THEN [active_vendor_count] ELSE 0 END)),4)&#10;)&#10;*100,2))&#10;)&#10;&#10;END&#10;+ &apos;%&apos;' />
            </column>
            <column caption='% Vendors with Outstanding Score WoW ▲▼' datatype='string' name='[Avg content score WoW ▲▼ (copy)_4795911398666686478]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF  LEFT([Avg content score WoW (copy)_4795911398666686477],1) =   &apos;▲&apos; THEN   &apos;▲&apos; &#13;&#10;ELSE   &apos;▼&apos;&#13;&#10;END' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_2269180907905355776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region] = &apos;MENA&apos; THEN &apos;Europe&apos; ELSE [region] END' />
            </column>
            <column caption='country sort' datatype='integer' name='[Calculation_3579446951069786112 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [country]&#10;WHEN &apos;Bangladesh&apos; THEN 1&#10;WHEN &apos;Cambodia&apos; THEN 2&#10;WHEN &apos;Hong Kong&apos; THEN 3&#10;WHEN &apos;Laos&apos; THEN 4&#10;WHEN &apos;Malaysia&apos; THEN 5&#10;WHEN &apos;Myanmar&apos; THEN 6&#10;WHEN &apos;Pakistan&apos; THEN 7&#10;WHEN &apos;Philippines&apos; THEN 8&#10;WHEN &apos;Singapore&apos; THEN 9&#10;WHEN &apos;Taiwan&apos; THEN 10&#10;WHEN &apos;Thailand&apos; THEN 11&#10;WHEN &apos;Austria&apos; THEN 12&#10;WHEN &apos;Czech Republic&apos; THEN 13&#10;WHEN &apos;Denmark&apos; THEN 14&#10;WHEN &apos;Finland&apos; THEN 15&#10;WHEN &apos;Hungary&apos; THEN 16&#10;WHEN &apos;Norway&apos; THEN 17&#10;WHEN &apos;Slovakia&apos; THEN 18&#10;WHEN &apos;Sweden&apos; THEN 19&#10;WHEN &apos;Turkey&apos; THEN 20&#10;WHEN &apos;EUROPE&apos; THEN 21&#10;WHEN &apos;EUROPE - TR&apos; THEN 22&#10;WHEN &apos;APAC&apos; THEN 23&#10;WHEN &apos;PANDORA&apos; THEN 24&#10;WHEN &apos;PANDORA - TR&apos; THEN 25&#10;END' />
            </column>
            <column caption='This week' datatype='boolean' name='[Calculation_757871425704644609]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(REGEXP_EXTRACT([Dynamic Date Range (qc success date) (copy)_757871425821081639],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, TODAY())))' />
            </column>
            <column caption='Week date Range' datatype='string' name='[Dynamic Date Range (qc success date) (copy)_757871425821081639]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(DATEPART(&apos;iso-year&apos;,[report_week]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[report_week]))' />
            </column>
            <column caption='WoW' datatype='string' name='[Trend (copy)_6330864842509062146]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;WoW %Δ&apos;' />
