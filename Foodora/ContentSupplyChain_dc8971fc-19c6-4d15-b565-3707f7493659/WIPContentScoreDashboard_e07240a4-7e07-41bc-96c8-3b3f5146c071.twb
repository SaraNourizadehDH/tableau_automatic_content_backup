      <table>
        <view>
          <datasources>
            <datasource caption='[BQ] Menu Strength - Country' name='federated.1mb7ufj1tdag311ep5vn3187l7ba (copy 2)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Stock Photo Filter' datatype='string' name='[TBC Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Include&quot;'>
              <calculation class='tableau' formula='&quot;Include&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mb7ufj1tdag311ep5vn3187l7ba (copy 2)'>
            <column caption='% Vendors with Non-Outstanding Menu Score' datatype='real' name='[% Vendors with Outstanding Menu Score % (copy)_4795911398288814084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-[Calculation_4795911398286884867]' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_2269180907905355776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region] = &apos;MENA&apos; THEN &apos;Europe&apos; ELSE [region] END' />
            </column>
            <column caption='% Vendors with Outstanding Menu Score (9 to 10)' datatype='real' name='[Calculation_4795911398286884867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6132987912359731200]/SUM([active_vendor_count])' />
            </column>
            <column caption='Vendors with Non-Outstanding Menu Score' datatype='integer' name='[Calculation_4795911398289309701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[TBC Parameter] = &apos;Include&apos; THEN SUM([active_vendor_count])-SUM([outstanding_vendor_count])&#10;ELSEIF [Parameters].[TBC Parameter] = &apos;Exclude&apos; THEN SUM([active_vendor_count])-SUM([outstanding_non_stock_vendor_count])&#10;ELSE 0 END' />
            </column>
            <column caption='Vendors with Outstanding Menu Score (9 to 10)' datatype='integer' name='[Calculation_6132987912359731200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[TBC Parameter] = &apos;Include&apos; THEN SUM([outstanding_vendor_count])&#10;ELSEIF [Parameters].[TBC Parameter] = &apos;Exclude&apos; THEN SUM([outstanding_non_stock_vendor_count])&#10;ELSE 0 END' />
            </column>
            <column caption='Avg Vendor Menu Score' datatype='real' name='[Calculation_6330864842503241728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[TBC Parameter] = &apos;Include&apos; THEN SUM([sum_menu_score])/SUM([active_vendor_count])&#10;ELSEIF [Parameters].[TBC Parameter] = &apos;Exclude&apos; THEN SUM([sum_non_stock_menu_score])/SUM([active_vendor_count])&#10;ELSE 0 END' />
            </column>
            <column caption='Active Vendor Count' datatype='integer' name='[active_vendor_count]' role='measure' type='quantitative' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country/region sort' datatype='string' name='[country sort (copy)_2017120055761891331]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#10;WHEN &apos;EUROPE&apos; THEN &apos;Region 1&apos;&#10;WHEN &apos;EUROPE - TR&apos; THEN &apos;Region 2&apos;&#10;WHEN &apos;APAC&apos; THEN &apos;Region 3&apos;&#10;WHEN &apos;PANDORA&apos; THEN &apos;Region 4&apos;&#10;WHEN &apos;PANDORA - TR&apos; THEN &apos;Region 5&apos;&#10;ELSE &apos;Country&apos;&#10;END' />
