            <column caption='DLD_Q MoM (Abs) ' datatype='string' name='[DLD_C MoM (Abs) (copy)_6067263560300347418]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;    (&#10;        (SUM(IF [Calculation_6067263560224706574] THEN [total_dld_q] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_dld_q] END), 0)) // avg_dld_c - This Week&#10;        -&#10;        (SUM(IF [Calculation_6067263560224800783] THEN [total_dld_q] END) / IFNULL(SUM(IF [Calculation_6067263560224800783] THEN [cnt_dld_q] END), 0)) // avg_dld_c - Last Week&#10;    )&#10;    &gt;= 0&#10;)&#10;THEN &apos;▲&apos; // Up arrow&#10;ELSE &apos;▼&apos; // Down arrow&#10;END&#10;+ &apos; &apos; +&#10;STR(&#10;  ROUND(&#10;    (&#10;      (&#10;        (SUM(IF [Calculation_6067263560224706574] THEN [total_dld_q] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_dld_q] END), 0)) // avg_dld_q - This Month&#10;        -&#10;        (SUM(IF [Calculation_6067263560224800783] THEN [total_dld_q] END) / IFNULL(SUM(IF [Calculation_6067263560224800783] THEN [cnt_dld_q] END), 0)) // avg_dld_q - Last month&#10;      )&#10;    ) * 100,&#10;    2&#10;  )&#10;)&#10;+ &apos;%&apos;' />
