    <worksheet name='DLD_C MoM % Change'>
      <table>
        <view>
          <datasources>
            <datasource caption='Content Score SQL' name='federated.1ofaxku19m99zf14byduw04u8i7v' />
          </datasources>
          <datasource-dependencies datasource='federated.1ofaxku19m99zf14byduw04u8i7v'>
            <column caption='Month date Range' datatype='string' name='[Calculation_6067263560224469005]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(str(DATENAME(&apos;month&apos;,[report_month])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[report_month])),2)' />
            </column>
            <column caption='This month' datatype='boolean' name='[Calculation_6067263560224706574]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT([Calculation_6067263560224469005],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,0,DATETRUNC(&apos;month&apos;,TODAY())))),3)' />
            </column>
            <column caption='Last month' datatype='boolean' name='[Calculation_6067263560224800783]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT([Calculation_6067263560224469005],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3)' />
            </column>
            <column caption='DLD_C MoM ▲▼' datatype='string' name='[DLD_C WoW ▲▼ (copy)_6067263560309927975]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF  LEFT([DLP WoW (Abs) (copy)_6067263560280059929],1) =   &apos;▲&apos; THEN   &apos;▲&apos; &#10;ELSE   &apos;▼&apos;&#10;END' />
            </column>
            <column caption='DLD_C MoM (Abs)' datatype='string' name='[DLP WoW (Abs) (copy)_6067263560280059929]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;    (&#10;        (SUM(IF [Calculation_6067263560224706574] THEN [total_dld_c] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_dld_c] END), 0)) // avg_dld_c - This Week&#10;        -&#10;        (SUM(IF [Calculation_6067263560224800783] THEN [total_dld_c] END) / IFNULL(SUM(IF [Calculation_6067263560224800783] THEN [cnt_dld_c] END), 0)) // avg_dld_c - Last Week&#10;    )&#10;    &gt;= 0&#10;)&#10;THEN &apos;▲&apos; // Up arrow&#10;ELSE &apos;▼&apos; // Down arrow&#10;END&#10;+ &apos; &apos; +&#10;STR(&#10;  ROUND(&#10;    (&#10;      (&#10;        (SUM(IF [Calculation_6067263560224706574] THEN [total_dld_c] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_dld_c] END), 0)) // avg_dld_c - This Month&#10;        -&#10;        (SUM(IF [Calculation_6067263560224800783] THEN [total_dld_c] END) / IFNULL(SUM(IF [Calculation_6067263560224800783] THEN [cnt_dld_c] END), 0)) // avg_dld_c - Last month&#10;      )&#10;    ) * 100,&#10;    2&#10;  )&#10;)&#10;+ &apos;%&apos;' />
            </column>
            <column caption='MoM' datatype='string' name='[WoW (copy)_6067263560222842892]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;MoM %Δ&apos;' />
            </column>
            <column datatype='integer' name='[cnt_dld_c]' role='measure' type='quantitative' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[gmv_class]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_first_week_of_month]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_pandapro]' role='dimension' type='nominal' />
            <column datatype='string' name='[new_vendor_type]' role='dimension' type='nominal' />
            <column-instance column='[WoW (copy)_6067263560222842892]' derivation='None' name='[none:WoW (copy)_6067263560222842892:nk]' pivot='key' type='nominal' />
