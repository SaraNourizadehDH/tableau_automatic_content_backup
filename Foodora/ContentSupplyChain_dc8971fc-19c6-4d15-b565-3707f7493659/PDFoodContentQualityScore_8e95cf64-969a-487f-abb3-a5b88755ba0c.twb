    <worksheet name='DLD_Q WoW % Change'>
      <table>
        <view>
          <datasources>
            <datasource caption='Content Score SQL' name='federated.1ofaxku19m99zf14byduw04u8i7v' />
          </datasources>
          <datasource-dependencies datasource='federated.1ofaxku19m99zf14byduw04u8i7v'>
            <column caption='Week date Range' datatype='string' name='[Calculation_6067263559971188738]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(DATEPART(&apos;iso-year&apos;,[report_week]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[report_week]))' />
            </column>
            <column caption='This Week' datatype='boolean' name='[Calculation_6067263559971381251]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(REGEXP_EXTRACT([Calculation_6067263559971188738],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,0, DATEADD(&apos;day&apos;,-2,TODAY()))))' />
            </column>
            <column caption='Last Week' datatype='boolean' name='[Calculation_6067263559971471364]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(REGEXP_EXTRACT([Calculation_6067263559971188738],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, DATEADD(&apos;day&apos;,-2,TODAY()))))' />
            </column>
            <column caption='WoW' datatype='string' name='[Calculation_6067263559972016134]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;WoW %Δ&apos;' />
            </column>
            <column caption='DLD_Q WoW (Abs) ' datatype='string' name='[DLD_C WoW (Abs)  (copy)_6067263560300433435]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF (&#10;    (&#10;        (SUM(IF [Calculation_6067263559971381251] THEN [total_dld_q] END) / IFNULL(SUM(IF [Calculation_6067263559971381251] THEN [cnt_dld_q] END), 0)) // avg_dld_q - This Week&#10;        -&#10;        (SUM(IF [Calculation_6067263559971471364] THEN [total_dld_q] END) / IFNULL(SUM(IF [Calculation_6067263559971471364] THEN [cnt_dld_q] END), 0)) // avg_dld_q - Last Week&#10;    )&#10;    &gt;= 0&#10;)&#10;THEN &apos;▲&apos; // Up arrow&#10;ELSE &apos;▼&apos; // Down arrow&#10;END&#10;+ &apos; &apos; +&#10;STR(&#10;  ROUND(&#10;    (&#10;      (&#10;        (SUM(IF [Calculation_6067263559971381251] THEN [total_dld_q] END) / IFNULL(SUM(IF [Calculation_6067263559971381251] THEN [cnt_dld_q] END), 0)) // avg_dld_q - This Week&#10;        -&#10;        (SUM(IF [Calculation_6067263559971471364] THEN [total_dld_q] END) / IFNULL(SUM(IF [Calculation_6067263559971471364] THEN [cnt_dld_q] END), 0)) // avg_dld_q - Last Week&#10;      )&#10;    ) * 100,&#10;    2&#10;  )&#10;)&#10;+ &apos;%&apos;' />
            </column>
            <column caption='DLD_Q WoW ▲▼' datatype='string' name='[DLD_C WoW ▲▼ (copy)_6067263560309084192]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF  LEFT([DLD_C WoW (Abs)  (copy)_6067263560300433435],1) =   &apos;▲&apos; THEN   &apos;▲&apos; &#10;ELSE   &apos;▼&apos;&#10;END' />
            </column>
            <column datatype='integer' name='[cnt_dld_q]' role='measure' type='quantitative' />
