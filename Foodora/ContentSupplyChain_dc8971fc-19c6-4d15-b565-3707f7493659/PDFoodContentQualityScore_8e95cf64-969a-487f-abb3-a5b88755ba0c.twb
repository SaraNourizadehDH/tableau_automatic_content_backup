        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0jw84f30nbgbvz14p08nv1ix9fqc' name='Custom SQL Query' type='text'><![CDATA[/* extract first day of the week Monday vendor metrics */

WITH
   vendor_weekly AS (
   SELECT
     *,
     CASE
      WHEN DATE_DIFF(report_week, activation_date_local, DAY) <<= 7 THEN "New vendor 7D"
      WHEN DATE_DIFF(report_week, activation_date_local, DAY) <<= 30 THEN "New vendor 30D"
      ELSE "Existing vendor"
    END AS new_vendor_type
   FROM
     `fulfillment-dwh-production.pandata_report.pandora_content__csc_vendor_metrics__daily`
   WHERE
     report_date BETWEEN DATE_SUB(current_date(), INTERVAL 1 YEAR)
     AND current_date()
     AND EXTRACT(DAYOFWEEK
     FROM
       report_date) = 2 
     AND global_entity_id != 'FP_TH'
   )

SELECT
  score.snapshot_date_utc AS report_date,
  DATE_TRUNC(score.snapshot_date_utc, MONTH) AS report_month,
  DATE_TRUNC(score.snapshot_date_utc, ISOWEEK) AS report_week,
  FORMAT_DATE("%G-%V", (score.snapshot_date_utc)) AS report_week_num,
  EXTRACT(DAY FROM score.snapshot_date_utc) <<= 7 AS is_first_week_of_month,
  DATE_TRUNC(score.snapshot_date_utc, ISOWEEK) = DATE_TRUNC(LAST_DAY(score.snapshot_date_utc), ISOWEEK) AS is_last_week_of_month,
  vendor_weekly.region,
  score.country_name AS country,
  score.global_entity_id,
  vendor_weekly.business_type,
  vendor_weekly.vendor_type,
  vendor_weekly.new_vendor_type,
  vendor_weekly.is_pandapro,
  vendor_weekly.gmv_class,
  vendor_weekly.sf_vendor_grade,
  -- Vendor counts --
  COUNT(DISTINCT CONCAT(score.global_entity_id, vendor_id)) AS vendor_cnt,
  COUNT(IF(vendor_weekly.menu_product_count >> 0, vendor_weekly.vendor_uuid, NULL)) AS vendor_w_menu_product_count,
  -- used for aggregating back with weights
  COUNT(score.dlp_c) AS cnt_dlp_c,
  COUNT(score.dlp_q) AS cnt_dlp_q,
  COUNT(score.vlp_q) AS cnt_vlp_q,
  COUNT(score.dld_c) AS cnt_dld_c,
  COUNT(score.dld_q) AS cnt_dld_q,
  -- Dish Level Photo Coverage (DLP) --
  SUM(CAST(score.dlp_c AS BIGNUMERIC)) AS total_dlp_c,
  -- Dish Level Photo Quality -- 
  SUM(CAST(score.dlp_q AS BIGNUMERIC)) AS total_dlp_q,
  -- Vendor Listing Quality --
  SUM(CAST(score.vlp_q AS BIGNUMERIC)) AS total_vlp_q,
  -- Dish Level Description Coverage --
  SUM(CAST(score.dld_c AS BIGNUMERIC)) AS total_dld_c,
  -- Dish Level Description Quality --
  SUM(CAST(score.dld_q AS BIGNUMERIC)) AS total_dld_q,
  -- food score --
  SUM(CAST(food_score AS BIGNUMERIC)) AS total_food_score,
  -- overall score --
  (SUM(score.dlp_c) * 0.3) + (SUM(score.dlp_q) * 0.3) + (SUM(score.vlp_q) * 0.2) + (SUM(dld_c) * 0.15) + (SUM(score.dld_q) * 0.05) AS total_overall_score
  
FROM `fulfillment-dwh-production.curated_data_shared_gd_analytics.content_quality_score_food` AS score
LEFT JOIN vendor_weekly
ON vendor_weekly.global_entity_id = score.global_entity_id
AND vendor_weekly.vendor_code = score.vendor_id
AND vendor_weekly.report_date = score.snapshot_date_utc
WHERE score.snapshot_date_utc BETWEEN DATE_SUB(current_date(), INTERVAL 1 YEAR)
     AND current_date()
     AND EXTRACT(DAYOFWEEK
     FROM
       snapshot_date_utc) = 2 
    AND score.global_entity_id != 'FP_TH'
    AND score.vendor_is_available
    AND score.vertical_parent = 'Food'
    AND score.vertical_type = 'restaurants'
GROUP BY ALL

UNION ALL

