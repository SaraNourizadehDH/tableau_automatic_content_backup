      <aliases enabled='yes' />
      <column caption='Overall Content Score' datatype='real' name='[Calculation_2140758003575095296]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='([Calculation_897412605045493760]*0.3)+([Calculation_897412605045624833]*0.3)+([Calculation_897412605045739522]*0.2)+([Calculation_897412605045874691]*0.15)+([Calculation_897412605045985284]*0.05)' />
      </column>
      <column caption='Last 6 Weeks' datatype='boolean' name='[Calculation_3766557413043798072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[report_date] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [report_date] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))' />
      </column>
      <column caption='Week date Range' datatype='string' name='[Calculation_6067263559971188738]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(DATEPART(&apos;iso-year&apos;,[report_week]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;,[report_week]))' />
      </column>
      <column caption='This Week' datatype='boolean' name='[Calculation_6067263559971381251]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(REGEXP_EXTRACT([Calculation_6067263559971188738],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,0, DATEADD(&apos;day&apos;,-2,TODAY()))))' />
      </column>
      <column caption='Last Week' datatype='boolean' name='[Calculation_6067263559971471364]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(REGEXP_EXTRACT([Calculation_6067263559971188738],&quot;-(.*)&quot;)) = str(DATEPART(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-1, DATEADD(&apos;day&apos;,-2,TODAY()))))' />
      </column>
      <column caption='Content Score WoW (Abs)' datatype='string' name='[Calculation_6067263559971602437]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (&#10;    ([Overall Content Score This Month (copy)_897412605055410184] - [Overall Content Score Last Month (copy)_897412605055508489])&#10;    &gt;= 0&#10;)&#10;THEN &apos;▲&apos;&#10;ELSE &apos;▼&apos;&#10;END&#10;+ &apos; &apos; +&#10;STR(&#10;  ROUND(&#10;    (&#10;      ([Overall Content Score This Month (copy)_897412605055410184] - [Overall Content Score Last Month (copy)_897412605055508489])&#10;    ) * 100,&#10;    2&#10;  )&#10;)&#10;+ &apos;%&apos;' />
      </column>
      <column caption='WoW' datatype='string' name='[Calculation_6067263559972016134]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;WoW %Δ&apos;' />
      </column>
      <column caption='Month date Range' datatype='string' name='[Calculation_6067263560224469005]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(str(DATENAME(&apos;month&apos;,[report_month])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[report_month])),2)' />
      </column>
      <column caption='This month' datatype='boolean' name='[Calculation_6067263560224706574]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT([Calculation_6067263560224469005],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,0,DATETRUNC(&apos;month&apos;,TODAY())))),3)' />
      </column>
      <column caption='Last month' datatype='boolean' name='[Calculation_6067263560224800783]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT([Calculation_6067263560224469005],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3)' />
      </column>
      <column caption='Month Header' datatype='string' name='[Calculation_6067263560265306131]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(str(DATENAME(&apos;month&apos;,[report_month])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[report_month])),2)' />
      </column>
      <column caption='avg_dlp_c' datatype='real' name='[Calculation_897412605045493760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_dlp_c])/SUM([cnt_dlp_c])' />
      </column>
      <column caption='avg_dlp_q' datatype='real' name='[Calculation_897412605045624833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_dlp_q])/SUM([cnt_dlp_q])' />
      </column>
      <column caption='avg_vlp_q' datatype='real' name='[Calculation_897412605045739522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_vlp_q])/SUM([cnt_vlp_q])' />
      </column>
      <column caption='avg_dld_c' datatype='real' name='[Calculation_897412605045874691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_dld_c])/SUM([cnt_dld_c])' />
      </column>
      <column caption='avg_dld_q' datatype='real' name='[Calculation_897412605045985284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_dld_q])/SUM([cnt_dld_q])' />
      </column>
      <column caption='Overall Content Score This Month' datatype='real' name='[Calculation_897412605050355717]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    SUM(IF [Calculation_6067263560224706574] THEN [total_dlp_c] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_dlp_c] END), 0) * 0.3&#10;)&#10;+&#10;(&#10;    SUM(IF [Calculation_6067263560224706574] THEN [total_dlp_q] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_dlp_q] END), 0) * 0.3&#10;)&#10;+&#10;(&#10;    SUM(IF [Calculation_6067263560224706574] THEN [total_vlp_q] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_vlp_q] END), 0) * 0.2&#10;)&#10;+&#10;(&#10;    SUM(IF [Calculation_6067263560224706574] THEN [total_dld_c] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_dld_c] END), 0) * 0.15&#10;)&#10;+&#10;(&#10;    SUM(IF [Calculation_6067263560224706574] THEN [total_dld_q] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_dld_q] END), 0) * 0.05&#10;)' />
