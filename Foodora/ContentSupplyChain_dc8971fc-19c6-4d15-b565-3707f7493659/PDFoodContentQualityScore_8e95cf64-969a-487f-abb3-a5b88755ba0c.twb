    <worksheet name='Content Score MoM % Change'>
      <table>
        <view>
          <datasources>
            <datasource caption='Content Score SQL' name='federated.1ofaxku19m99zf14byduw04u8i7v' />
          </datasources>
          <datasource-dependencies datasource='federated.1ofaxku19m99zf14byduw04u8i7v'>
            <column caption='Month date Range' datatype='string' name='[Calculation_6067263560224469005]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(str(DATENAME(&apos;month&apos;,[report_month])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[report_month])),2)' />
            </column>
            <column caption='This month' datatype='boolean' name='[Calculation_6067263560224706574]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT([Calculation_6067263560224469005],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,0,DATETRUNC(&apos;month&apos;,TODAY())))),3)' />
            </column>
            <column caption='Last month' datatype='boolean' name='[Calculation_6067263560224800783]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT([Calculation_6067263560224469005],3) = LEFT(str(DATENAME(&apos;month&apos;,DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY())))),3)' />
            </column>
            <column caption='Overall Content Score This Month' datatype='real' name='[Calculation_897412605050355717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM(IF [Calculation_6067263560224706574] THEN [total_dlp_c] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_dlp_c] END), 0) * 0.3&#10;)&#10;+&#10;(&#10;    SUM(IF [Calculation_6067263560224706574] THEN [total_dlp_q] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_dlp_q] END), 0) * 0.3&#10;)&#10;+&#10;(&#10;    SUM(IF [Calculation_6067263560224706574] THEN [total_vlp_q] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_vlp_q] END), 0) * 0.2&#10;)&#10;+&#10;(&#10;    SUM(IF [Calculation_6067263560224706574] THEN [total_dld_c] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_dld_c] END), 0) * 0.15&#10;)&#10;+&#10;(&#10;    SUM(IF [Calculation_6067263560224706574] THEN [total_dld_q] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_dld_q] END), 0) * 0.05&#10;)' />
            </column>
            <column caption='Overall Content Score Last Month' datatype='real' name='[Calculation_897412605050638342]' role='measure' type='quantitative'>
