              <calculation class='tableau' formula='IF (&#10;    (&#10;        (SUM(IF [Calculation_6067263560224706574] THEN [total_dlp_c] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_dlp_c] END), 0)) // avg_dlp_c - This Week&#10;        -&#10;        (SUM(IF [Calculation_6067263560224800783] THEN [total_dlp_c] END) / IFNULL(SUM(IF [Calculation_6067263560224800783] THEN [cnt_dlp_c] END), 0)) // avg_dlp_c - Last Week&#10;    )&#10;    &gt;= 0&#10;)&#10;THEN &apos;▲&apos; // Up arrow&#10;ELSE &apos;▼&apos; // Down arrow&#10;END&#10;+ &apos; &apos; +&#10;STR(&#10;  ROUND(&#10;    (&#10;      (&#10;        (SUM(IF [Calculation_6067263560224706574] THEN [total_dlp_c] END) / IFNULL(SUM(IF [Calculation_6067263560224706574] THEN [cnt_dlp_c] END), 0)) // avg_dlp_c - This Month&#10;        -&#10;        (SUM(IF [Calculation_6067263560224800783] THEN [total_dlp_c] END) / IFNULL(SUM(IF [Calculation_6067263560224800783] THEN [cnt_dlp_c] END), 0)) // avg_dlp_c - Last month&#10;      )&#10;    ) * 100,&#10;    2&#10;  )&#10;)&#10;+ &apos;%&apos;' />
            </column>
            <column caption='DLP MoM ▲▼' datatype='string' name='[DLP WoW ▲▼ (copy)_6067263560310149162]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF  LEFT([DLP WoW (Abs) (copy)_6067263560267042838],1) =   &apos;▲&apos; THEN   &apos;▲&apos; &#10;ELSE   &apos;▼&apos;&#10;END' />
            </column>
