      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0400edz1az9kz11cx898d18d61px].[sum:approval_submission_with_result:qk]&quot;' value='# Menu Typing Submitted' />
          <alias key='&quot;[federated.0400edz1az9kz11cx898d18d61px].[sum:no_of_distinct_cases:qk]&quot;' value='# Distinct Cases' />
        </aliases>
      </column>
      <column caption='Approval Rate' datatype='real' name='[Calculation_1024639332622741504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_approval_submissions])/SUM([approval_submission_with_result])' />
      </column>
      <column caption='Rejection Rate' datatype='real' name='[Calculation_1024639332623110145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rejected_submissions])/SUM([approval_submission_with_result])' />
      </column>
      <column caption='QC Agent - % Approvals' datatype='real' name='[Calculation_1024639332623740930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_no_of_qc_approvals_given])/SUM([total_no_of_qc_review_done])' />
      </column>
      <column caption='QC Agent - % Rejection' datatype='real' name='[Calculation_1024639332624171011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_no_of_qc_rejections_given])/SUM([total_no_of_qc_review_done])' />
      </column>
      <column caption='QC Agent - # Completed Review' datatype='integer' name='[Calculation_1024639332624699396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [total_no_of_qc_review_done] != 0 THEN [total_no_of_qc_review_done] END)' />
      </column>
      <column caption='Menu Typing Agent - # Submission' datatype='integer' name='[Calculation_1024639332642013190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [approval_submission_with_result] != 0 THEN [approval_submission_with_result] END)' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
