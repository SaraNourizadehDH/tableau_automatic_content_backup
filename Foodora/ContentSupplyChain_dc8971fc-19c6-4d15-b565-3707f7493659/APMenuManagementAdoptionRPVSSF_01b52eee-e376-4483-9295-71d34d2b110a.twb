      </column>
      <column caption='Previous L7D to L7D' datatype='datetime' name='[Calculation_4355332736235315218]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [created_local], TODAY()) &gt;= 8&#10;THEN DATEADD(&apos;day&apos;, 7, [created_local])&#10;ELSE [created_local]&#10;END' />
      </column>
      <column caption='Metric Placeholder (RP)' datatype='real' name='[Calculation_4705557939909210119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;Count&quot; THEN SUM([total_rp_case])&#10;WHEN &quot;Percentage&quot; THEN [Calculation_6981283160316936192] * 100&#10;END' />
      </column>
      <column caption='RP ' datatype='real' name='[Calculation_6981283160316936192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_rp_case])/(sum([total_rp_case]) + SUM([total_sf_case]))' />
      </column>
      <column caption='Comparison' datatype='string' name='[DataStudio (copy)_4094123957455454210]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;RP VS SF Adoption&quot;' />
      </column>
      <column caption='Previous L7D' datatype='boolean' name='[L7D (copy)_4355332736148803594]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [created_local], TODAY()) &gt;= 8&#10;AND DATEDIFF(&apos;day&apos;, [created_local], TODAY()) &lt;= 14' />
      </column>
      <column caption='L7D &amp; Previous L7D' datatype='string' name='[L7D (copy)_4355332736234127376]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [created_local], TODAY()) &gt;= 1&#10;AND DATEDIFF(&apos;day&apos;, [created_local], TODAY()) &lt;= 7&#10;THEN &apos;L7D&apos;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [created_local], TODAY()) &gt;= 8&#10;AND DATEDIFF(&apos;day&apos;, [created_local], TODAY()) &lt;= 14&#10;THEN &apos;Previous L7D&apos;&#10;END' />
      </column>
      <column caption='Metric Placeholder (SF)' datatype='real' name='[Metric Placeholder (RP) (copy)_4783456146382577664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;Count&quot; THEN SUM([total_sf_case])&#10;WHEN &quot;Percentage&quot; THEN [Submissions via RP  (copy)_6981283160317231105] * 100&#10;END' />
      </column>
