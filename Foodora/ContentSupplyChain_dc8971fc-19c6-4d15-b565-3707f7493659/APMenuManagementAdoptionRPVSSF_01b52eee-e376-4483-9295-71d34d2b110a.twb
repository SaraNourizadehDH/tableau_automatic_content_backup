    <worksheet name='RF VS SF (Menu)'>
      <table>
        <view>
          <datasources>
            <datasource caption='[BQ] History log - RP vs SF' name='federated.08h4v710k0vkbh1gkskkg064vluj (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Week/Month Selector' datatype='string' name='[Dynamic Date (copy)_3498452509139501056]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;week&quot;' value='Week' />
              </aliases>
            </column>
            <column caption='Metric Selector' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Count&quot;'>
              <calculation class='tableau' formula='&quot;Count&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.08h4v710k0vkbh1gkskkg064vluj (copy)'>
            <column caption='week/month' datatype='string' name='[Calculation_3498452509139763201]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Dynamic Date (copy)_3498452509139501056] = &apos;week&apos; THEN [week]&#10;ELSEIF [Parameters].[Dynamic Date (copy)_3498452509139501056] = &apos;month&apos; THEN LEFT(str(DATENAME(&apos;month&apos;,[created_local])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[created_local])),2)&#10;END' />
            </column>
            <column caption='Metric Placeholder (RP)' datatype='real' name='[Calculation_4705557939909210119]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;Count&quot; THEN SUM([total_rp_case])&#10;WHEN &quot;Percentage&quot; THEN [Calculation_6981283160316936192] * 100&#10;END' />
            </column>
            <column caption='RP ' datatype='real' name='[Calculation_6981283160316936192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_rp_case])/(sum([total_rp_case]) + SUM([total_sf_case]))' />
            </column>
            <column caption='Metric Placeholder (SF)' datatype='real' name='[Metric Placeholder (RP) (copy)_4783456146382577664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;Count&quot; THEN SUM([total_sf_case])&#10;WHEN &quot;Percentage&quot; THEN [Submissions via RP  (copy)_6981283160317231105] * 100&#10;END' />
            </column>
            <column caption='SF ' datatype='real' name='[Submissions via RP  (copy)_6981283160317231105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_sf_case])/(sum([total_rp_case]) + SUM([total_sf_case]))' />
            </column>
            <column caption='account source' datatype='string' name='[account_source]' role='dimension' type='nominal' />
            <column caption='Case subject type' datatype='string' name='[case_subject_type]' role='dimension' type='nominal' />
