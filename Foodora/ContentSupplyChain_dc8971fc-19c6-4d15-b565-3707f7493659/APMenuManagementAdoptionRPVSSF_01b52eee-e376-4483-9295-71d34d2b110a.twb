      <date-options start-of-week='monday' />
      <datasource-dependencies datasource='Parameters'>
        <column alias='Week' caption='Week/Month Selector' datatype='string' name='[Dynamic Date (copy)_3498452509139501056]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
          <calculation class='tableau' formula='&quot;week&quot;' />
