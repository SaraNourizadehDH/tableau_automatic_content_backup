        </aliases>
      </column>
      <column caption='this_week_filter' datatype='boolean' name='[Calculation_1194439114090938399 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;iso-week&apos;, [created_local]) &lt;&gt; DATETRUNC(&apos;iso-week&apos;, TODAY())' />
      </column>
      <column caption='week/month filter' datatype='boolean' name='[Calculation_1194439114090938399]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Dynamic Date (copy)_3498452509139501056] = &apos;month&apos; THEN [created_local] &lt; DATETRUNC(&apos;iso-week&apos;,TODAY())&#10;ELSEIF [Parameters].[Dynamic Date (copy)_3498452509139501056] = &apos;week&apos; THEN [created_local] &lt; DATETRUNC(&apos;iso-week&apos;,TODAY())&#10;END' />
      </column>
      <column caption='week/month' datatype='string' name='[Calculation_3498452509139763201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Dynamic Date (copy)_3498452509139501056] = &apos;week&apos; THEN [week]&#10;ELSEIF [Parameters].[Dynamic Date (copy)_3498452509139501056] = &apos;month&apos; THEN LEFT(str(DATENAME(&apos;month&apos;,[created_local])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;,[created_local])),2)&#10;END' />
      </column>
      <column caption='DataStudio' datatype='string' name='[Calculation_4094123957449912320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Vendor QC Report&quot;' />
      </column>
      <column caption='bar_swap_metric' datatype='string' name='[Calculation_4355332735895580672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='RP_adoption' datatype='real' name='[Calculation_4355332735905234946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_rp_case]/([total_rp_case]+[total_sf_case])' />
      </column>
      <column caption='L7D' datatype='boolean' name='[Calculation_4355332736147918857]' role='dimension' type='nominal'>
