      </column>
      <column caption='RP adoption L7D' datatype='real' name='[Calculation_4355332736149159947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_4355332736147918857] THEN [total_rp_case] ELSE 0 END)/sum(IF [Calculation_4355332736147918857] THEN [total_case] ELSE 0 END)' />
      </column>
      <column caption='RP adoption wow growth' datatype='string' name='[Calculation_4355332736151158797]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF&#10;([Calculation_4355332736149159947]-[RP adoption L7D (copy)_4355332736150892556]) &gt;= 0&#10;THEN &apos;▲&apos; ELSE &apos;▼&apos; END&#10;&#10;+ &apos; &apos; +&#10;&#10;STR(ROUND((([Calculation_4355332736149159947]-[RP adoption L7D (copy)_4355332736150892556])*100),2))&#10;&#10;+ &apos;% wow growth&apos;' />
      </column>
      <column caption='index' datatype='integer' name='[Calculation_4355332736151977998]' role='measure' type='ordinal'>
