            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03kfoah1ssarcq13n0twm1lfroow'>
            <column caption='max_day' datatype='integer' name='[Calculation_2171298005993455616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;, MAX([order_date]))' />
            </column>
            <column caption='total_days_in_month' datatype='integer' name='[Calculation_2171298005993705473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, MAX([order_date])), DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, MAX([order_date]))))' />
            </column>
            <column caption='SelectedGMVCurrency' datatype='real' name='[Calculation_2313724335301591040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[gmv_local Parameter]&#13;&#10;WHEN &apos;GMV Local&apos; THEN [gmv_local]&#13;&#10;WHEN &apos;GMV Euro&apos; THEN [gmv_eur]&#13;&#10;END' />
            </column>
            <column caption='SumGMVLocal/EUR' datatype='real' name='[Calculation_2313724335310405633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2313724335301591040])' />
            </column>
            <column caption='ZN([RunRateShopsLocal/Euro]) - LOOKUP(ZN([RunRateShopsLocal/E...' datatype='real' name='[Calculation_2313724335311458307]' role='measure' type='quantitative' user:unnamed='[MY] ShopsGMVTotalsLocal/Euro'>
              <calculation class='tableau' formula='ZN([RunRateShopsLocal (copy)_2313724335311044610]) - LOOKUP(ZN([RunRateShopsLocal (copy)_2313724335311044610]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='(ZN([RunRateShopsLocal/Euro]) - LOOKUP(ZN([RunRateShopsLocal/...' datatype='real' name='[Calculation_2313724335311634436]' role='measure' type='quantitative' user:unnamed='[MY] ShopsGMVTotalsLocal/Euro'>
              <calculation class='tableau' formula='(ZN([RunRateShopsLocal (copy)_2313724335311044610]) - LOOKUP(ZN([RunRateShopsLocal (copy)_2313724335311044610]), -1)) / ABS(LOOKUP(ZN([RunRateShopsLocal (copy)_2313724335311044610]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='RunRateShopsLocal/Euro' datatype='real' name='[RunRateShopsLocal (copy)_2313724335311044610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2313724335310405633] * [Calculation_2171298005993705473]) / [Calculation_2171298005993455616]' />
            </column>
