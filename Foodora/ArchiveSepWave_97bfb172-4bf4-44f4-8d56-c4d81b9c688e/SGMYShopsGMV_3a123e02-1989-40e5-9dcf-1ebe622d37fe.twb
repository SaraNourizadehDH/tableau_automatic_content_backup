  SUM(IF(is_valid_order = TRUE, 1, 0)) AS num_of_valid_customers,
  SUM(CASE WHEN is_valid_order = TRUE THEN gmv_local END) AS valid_gmv_local,
  SUM(IF(is_valid_order = TRUE, gmv_local, null)) AS gmv_local
FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` AS o
LEFT JOIN `fulfillment-dwh-production.pandata_report.shops__vendors_report` AS v
  ON o.global_entity_id = v.global_entity_id
  AND o.vendor_code = v.vendor_code
WHERE created_date_utc <<= CURRENT_DATE
  AND ordered_at_local BETWEEN '2024-01-01' AND CURRENT_DATE()
  AND v.vendor_type = 'shops'
GROUP BY 1,2,3,4,5,6
ORDER BY order_date ASC
),
eurfx as (
SELECT FORMAT_DATE("%Y-%m", months) AS month, global_entity_id, fx
FROM fulfillment-dwh-production.pandata_report.regional_apac_finance_lucanet_fx_rates AS r
GROUP BY 1,2,3)
SELECT s.global_entity_id, s.month, s.order_date, s.chain_code, s.chain_name, s.valid_order, s.num_of_valid_customers, s.valid_gmv_local, s.gmv_local, (s.gmv_local/e.fx) as gmv_eur
FROM sggmv s
LEFT JOIN eurfx e
  ON s.month = e.month
  AND s.global_entity_id = e.global_entity_id
)]]></relation>
          <relation connection='bigquery.071zpsy0qitw5q14qy1xw02dbidc' name='Custom SQL Query1' type='text'><![CDATA[SELECT
  global_entity_id,
  FORMAT_DATE("%Y-%m", order_date) AS month,
  order_date,
  CASE WHEN business_type = 'shops' THEN 'shops'
      WHEN business_type = 'dmart' THEN 'dmart'
      WHEN business_type = 'restaurants' THEN 'restaurants'
      ELSE 'others'
    END AS business_type,
  COUNT(DISTINCT (CASE WHEN valid_order = 1 THEN pd_customer_uuid END)) AS num_of_valid_customers,
  SUM(valid_order) AS valid_orders,
  SUM(valid_gmv) AS valid_gmv_local,
  SUM(valid_gfv) AS valid_gfv_local,
FROM `fulfillment-dwh-production.pandata_report.country_MY_pd_orders`
WHERE created_date_utc <<= CURRENT_DATE()
  AND order_date BETWEEN '2024-01-01' AND CURRENT_DATE()
  --AND o.business_type = 'shops'
GROUP BY 1,2,3,4
UNION ALL
SELECT
  o.global_entity_id,  
  FORMAT_DATE("%Y-%m", o.ordered_at_date_local) AS month,
  ordered_at_date_local AS order_date,
  CASE WHEN c.business_type_apac = 'shops' THEN 'shops'
      WHEN c.business_type_apac = 'dmart' THEN 'dmart'
      WHEN c.business_type_apac = 'restaurants' THEN 'restaurants'
      ELSE 'others'
    END AS business_type,
  COUNT(DISTINCT (CASE WHEN is_valid_order = TRUE THEN pd_customer_uuid END)) AS num_of_valid_customers,  
  SUM(CASE WHEN is_valid_order = TRUE THEN 1 ELSE 0 END) AS valid_order,
  SUM(CASE WHEN is_valid_order = TRUE THEN gmv_local END) AS valid_gmv_local,
  SUM(CASE WHEN is_valid_order = TRUE THEN gfv_local END) AS valid_gfv_local,
FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` AS o
LEFT JOIN `fulfillment-dwh-production.pandata_report.shops__vendors_report` AS v
  ON o.global_entity_id = v.global_entity_id
  AND o.vendor_code = v.vendor_code
LEFT JOIN fulfillment-dwh-production.pandata_report.regional_apac_commercial_vendors AS c
  ON o.global_entity_id = c.global_entity_id
  AND o.vendor_code = c.vendor_code
WHERE o.created_date_utc <<= CURRENT_DATE
  AND o.ordered_at_local BETWEEN '2024-01-01' AND CURRENT_DATE()
  AND is_valid_order = TRUE
  --AND v.vendor_type = 'shops'
  --AND o.business_type_apac = 'shops'
GROUP BY 1,2,3,4
ORDER BY order_date ASC]]></relation>
