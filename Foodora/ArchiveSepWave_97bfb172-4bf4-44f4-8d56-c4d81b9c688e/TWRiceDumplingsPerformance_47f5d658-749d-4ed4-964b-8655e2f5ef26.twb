      <column caption='Date1' datatype='string' name='[Calculation_3526107409649598464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[參數 1]&#10;WHEN &quot;year&quot; THEN STR(YEAR([partition_date_local （複製）_3526107409649713153]))&#10;WHEN &quot;month&quot; THEN STR(DATEPART(&apos;year&apos;, [partition_date_local （複製）_3526107409649713153])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [partition_date_local （複製）_3526107409649713153])), 2)&#10;WHEN &quot;week&quot; THEN STR(DATEPART(&apos;year&apos;, [partition_date_local （複製）_3526107409649713153])) + &quot;-W&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;week&apos;, [partition_date_local （複製）_3526107409649713153])), 2)&#10;WHEN &quot;day&quot; THEN STR([partition_date_local （複製）_3526107409649713153])&#10;END' />
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_3526107409659756549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([sale_qty]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='南北粽' datatype='string' name='[Calculation_737745925399302144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (CONTAINS([product_name],&apos;南部&apos;) OR CONTAINS([product_name],&apos;南粽&apos;)) THEN &apos;南部粽&apos;&#10;ELSEIF (CONTAINS([product_name],&apos;北部&apos;) OR CONTAINS([product_name],&apos;北粽&apos;))THEN &apos;北部粽&apos;&#10;ELSE &apos;其他&apos;&#10;END' />
      </column>
