AND partition_date_local&gt;&gt;=&apos;2024-01-01&apos;
AND items.name LIKE &apos;%粽%&apos;
AND is_qcommerce AND is_successful
)
SELECT DISTINCT pd_orders.partition_date_local,pd_orders.order_id,pd_vendors.brand_name,items.name as product_name,items.unit_price as gfv, items.quantity as sale_qty FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` pd_orders
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_TW_vdr_svc_vendors` AS pd_vendors
ON pd_orders.vendor_id = pd_vendors.vendor_code
LEFT JOIN UNNEST (items) as items
INNER JOIN dumplings ON pd_orders.order_id = dumplings.order_id
WHERE pd_orders.global_entity_id = &apos;FP_TW&apos;
AND pd_orders.partition_date_local&gt;&gt;=&apos;2024-01-01&apos;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
