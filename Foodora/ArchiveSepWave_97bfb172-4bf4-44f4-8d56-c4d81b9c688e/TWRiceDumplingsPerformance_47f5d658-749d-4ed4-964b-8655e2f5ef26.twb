        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0yl87op1wiaevq1cjjylr1v30ho2' name='自訂 SQL 查詢' type='text'>with dumplings as (
SELECT partition_date_local,order_id,items.name as product_name,items.unit_price as gfv, items.quantity as sale_qty FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` pd_orders
