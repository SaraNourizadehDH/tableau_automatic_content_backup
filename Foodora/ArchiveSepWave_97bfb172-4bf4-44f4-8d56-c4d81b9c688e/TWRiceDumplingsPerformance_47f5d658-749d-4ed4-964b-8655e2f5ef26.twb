              <calculation class='tableau' formula='CASE [Parameters].[參數 1]&#10;WHEN &quot;year&quot; THEN STR(YEAR([Calculation_3526107409654841348]))&#10;WHEN &quot;month&quot; THEN STR(DATEPART(&apos;year&apos;, [Calculation_3526107409654841348])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;month&apos;, [Calculation_3526107409654841348])), 2)&#10;WHEN &quot;week&quot; THEN STR(DATEPART(&apos;year&apos;, [Calculation_3526107409654841348])) + &quot;-W&quot; + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;week&apos;, [Calculation_3526107409654841348])), 2)&#10;WHEN &quot;day&quot; THEN STR([Calculation_3526107409654841348])&#10;END' />
