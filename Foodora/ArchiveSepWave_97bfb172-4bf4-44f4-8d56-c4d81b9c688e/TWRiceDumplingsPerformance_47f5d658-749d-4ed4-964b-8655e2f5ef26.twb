        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1hut3me08gz9az12e88en0tszeb4' name='自訂 SQL 查詢' type='text'>SELECT partition_date_local,pd_vendors.brand_name,pd_vendors.vendor_name as outlet_name,city_name,items.name as product_name,COUNT(DISTINCT order_id) as order_count,SUM(items.unit_price) as gfv, SUM(items.quantity) as sale_qty FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` pd_orders
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_TW_vdr_svc_vendors` AS pd_vendors
ON pd_orders.vendor_id = pd_vendors.vendor_code
LEFT JOIN UNNEST (items) as items
WHERE global_entity_id = &apos;FP_TW&apos;
AND partition_date_local&gt;&gt;=&apos;2024-01-01&apos;
AND items.name LIKE &apos;%粽%&apos;
AND is_qcommerce AND is_successful
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
