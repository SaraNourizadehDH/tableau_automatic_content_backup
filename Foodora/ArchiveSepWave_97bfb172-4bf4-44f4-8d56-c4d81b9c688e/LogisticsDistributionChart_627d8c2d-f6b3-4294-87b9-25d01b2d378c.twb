        <calculation class='tableau' formula='(ZN([left agg main_kpi (copy)]) - LOOKUP(ZN([left agg main_kpi (copy)]), -1)) / ABS(LOOKUP(ZN([left agg main_kpi (copy)]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
