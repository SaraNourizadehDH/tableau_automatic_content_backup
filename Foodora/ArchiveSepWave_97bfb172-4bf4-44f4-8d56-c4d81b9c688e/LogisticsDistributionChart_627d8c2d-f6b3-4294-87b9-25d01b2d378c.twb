      <table>
        <view>
          <datasources>
            <datasource caption='deliveries_uuid' name='sqlproxy.0vhfoxl1iv341k1bjritn0kc766y' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Aggregations' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Average&quot;'>
              <calculation class='tableau' formula='&quot;Average&quot;' />
            </column>
            <column alias='DT' caption='Main KPIs' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dt&quot;'>
              <calculation class='tableau' formula='&quot;Dt&quot;' />
              <aliases>
                <alias key='&quot;Dt&quot;' value='DT' />
                <alias key='&quot;Pdt&quot;' value='PDT' />
                <alias key='&quot;Pdt Gap (Pdt - Dt)&quot;' value='PDT Gap (PDT - DT)' />
                <alias key='&quot;Prep Time Gap (EPT - APT)&quot;' value='Prep Time Gap (EPT - APT)' />
              </aliases>
            </column>
            <column caption='Partition by' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Brand or Outlet' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand&quot;'>
              <calculation class='tableau' formula='&quot;Brand&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0vhfoxl1iv341k1bjritn0kc766y'>
            <column caption='% number_of_records' datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Number of Records]) / TOTAL(SUM([Number of Records]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='main_kpi' datatype='real' name='[Calculation_1796091867996266511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#10;when &apos;Dt&apos; then [Calculation_3991667041229783042]&#10;when &apos;Pdt&apos; then [dt_adjusted (copy)_5468144017142534144]&#10;when &apos;Pdt Gap (Pdt - Dt)&apos; then [pdt_adjusted (copy)_5468144017168715778]&#10;when &apos;Dispatching Time&apos; then [dispatching_time]&#10;when &apos;Rider Reaction Time&apos; then [rider_reaction_time]&#10;when &apos;Accepting Time&apos; then [rider_accepting_time]&#10;when &apos;Driving To Res Time&apos; then [driving_to_restaurant_time]&#10;when &apos;At Res Time&apos; then [at_restaurant_time]&#10;when &apos;Bag Time&apos; then [bag_time]&#10;when &apos;Driving To Cx Time&apos; then [driving_to_customer_time]&#10;when &apos;At Cx Time&apos; then [at_customer_time]&#10;when &apos;Prep Time Gap (EPT - APT)&apos; then [pdt_dt_gap (copy)_5273996661245636608]&#10;when &apos;Vendor Delay&apos; then [vendor_delay]&#10;when &apos;Rider Delay&apos; then [rider_delay]&#10;when &apos;Delivery Delay&apos; then [delivery_delay]&#10;when &apos;Stacked Deliveries Count&apos; then [stacked_deliveries_count]&#10;when &apos;Estimated Prep Time&apos; then [estimated_prep_time]&#10;//when &apos;Pickup Distance Google&apos; then [pickup_distance_google_in_meters]/1000&#10;//when &apos;Dropoff Distance Google&apos; then [dropoff_distance_google_in_meters]/1000&#10;//when &apos;Delivery Distance Google&apos; then ([pickup_distance_google_in_meters]+[dropoff_distance_google_in_meters])/1000&#10;when &apos;Pickup Distance Manhattan&apos; then [pickup_distance_manhattan_in_meters]/1000&#10;when &apos;Dropoff Distance Manhattan&apos; then [dropoff_distance_manhattan_in_meters]/1000&#10;when &apos;Delivery Distance Manhattan&apos; then [delivery_distance_in_meters]/1000&#10;end' />
            </column>
            <column caption='Partition By' datatype='string' name='[Calculation_220324596778033154]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 4]&#10;when &apos;All&apos; then &apos;All&apos;&#10;when &apos;Vertical Type&apos; then [vertical_type]&#10;when &apos;City Name&apos; then [city_name]&#10;when &apos;Zone Name&apos; then [zone_name]&#10;when &apos;Stacked Deliveries Count&apos; then STR([stacked_deliveries_count])&#10;end' />
            </column>
            <column caption='Brand' datatype='string' name='[Calculation_361836141586194432]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5] &#10;WHEN &apos;Brand&apos; THEN LOWER(TRIM(REGEXP_REPLACE([vendor_name],&apos;\(.*\)&apos;,&apos;&apos;)))&#10;WHEN &apos;Outlet&apos; THEN [vendor_name]&#10;END' />
            </column>
            <column caption='dt_adjusted' datatype='real' name='[Calculation_3991667041229783042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF not [is_preorder]THEN [dt]END' />
            </column>
            <column caption='ATTR(date([rider_picked_up_at_local]))' datatype='date' name='[Calculation_4014959095554351104]' role='measure' type='ordinal' user:unnamed='distribution_chart'>
              <calculation class='tableau' formula='ATTR(date([rider_picked_up_at_local]))' />
            </column>
            <column caption='main_kpi (bin)' datatype='real' name='[Calculation_5677983645438042112]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 2], &apos;(Distance)&apos;)&#10;then ROUND([Calculation_1796091867996266511],1)&#10;else ROUND([Calculation_1796091867996266511],0)&#10;end' />
