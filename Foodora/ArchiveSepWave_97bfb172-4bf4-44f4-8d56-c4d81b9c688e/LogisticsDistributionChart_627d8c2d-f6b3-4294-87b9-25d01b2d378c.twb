    <worksheet name='left_hourly'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='false' fontalignment='1'><![CDATA[<[Parameters].[Aggregations (copy)]>]]></run>
            <run fontalignment='1'><![CDATA[ <[Parameters].[Main KPIs (copy)]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='deliveries_uuid' name='sqlproxy.0vhfoxl1iv341k1bjritn0kc766y' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Left Aggregations' datatype='string' name='[Aggregations (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Average&quot;'>
              <calculation class='tableau' formula='&quot;Average&quot;' />
            </column>
            <column caption='Left Main KPIs' datatype='string' name='[Main KPIs (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dt&quot;'>
              <calculation class='tableau' formula='&quot;Dt&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0vhfoxl1iv341k1bjritn0kc766y'>
            <column caption='left %diff agg main_kpi' datatype='real' default-format='p0.0%' name='[%diff agg main_kpi (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([agg main_kpi (copy)]) - LOOKUP(ZN([agg main_kpi (copy)]), -1)) / ABS(LOOKUP(ZN([agg main_kpi (copy)]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='left +%diff agg main_kpi' datatype='real' default-format='p0.0%' name='[+%diff agg main_kpi (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [%diff agg main_kpi (copy)] &gt; 0 then [%diff agg main_kpi (copy)] end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='left -%diff agg main_kpi' datatype='real' default-format='p0.0%' name='[-%diff agg main_kpi (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [%diff agg main_kpi (copy)] &lt;= 0 then [%diff agg main_kpi (copy)] end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='report_hour' datatype='string' name='[Calculation_1646136074632617984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;hour&apos;, [rider_picked_up_at_local]))' />
            </column>
            <column caption='dt_adjusted' datatype='real' name='[Calculation_3991667041229783042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF not [is_preorder]THEN [dt]END' />
            </column>
            <column caption='left agg main_kpi' datatype='real' name='[agg main_kpi (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Aggregations (copy)] &#10;when &apos;Average&apos; then avg([main_kpi (copy)])&#10;when &apos;PCT5&apos; then percentile([main_kpi (copy)], 0.05)&#10;when &apos;PCT25&apos; then percentile([main_kpi (copy)], 0.25)&#10;when &apos;Median&apos; then MEDIAN([main_kpi (copy)])&#10;when &apos;PCT75&apos; then percentile([main_kpi (copy)], 0.75)&#10;when &apos;PCT95&apos; then percentile([main_kpi (copy)], 0.95)&#10;end' />
            </column>
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[at_customer_time]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[at_restaurant_time]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[bag_time]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[city_name]' pivot='key' role='dimension' semantic-role='[City].[Name]' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[delivery_delay]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[delivery_distance_in_meters]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[dispatching_time]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[driving_to_customer_time]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[driving_to_restaurant_time]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[dropoff_distance_manhattan_in_meters]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[dt]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column-instance column='[rider_picked_up_at_local]' derivation='Hour' name='[hr:rider_picked_up_at_local:ok]' pivot='key' type='ordinal' />
            <column aggregation='Count' datatype='boolean' default-type='nominal' layered='true' name='[is_preorder]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default' />
            <column caption='left_main_kpi' datatype='real' name='[main_kpi (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Main KPIs (copy)]&#10;when &apos;Dt&apos; then [Calculation_3991667041229783042]&#10;when &apos;Dispatching Time&apos; then [dispatching_time]&#10;when &apos;Rider Reaction Time&apos; then [rider_reaction_time]&#10;when &apos;Accepting Time&apos; then [rider_accepting_time]&#10;when &apos;Driving To Res Time&apos; then [driving_to_restaurant_time]&#10;when &apos;At Res Time&apos; then [at_restaurant_time]&#10;when &apos;Bag Time&apos; then [bag_time]&#10;when &apos;Driving To Cx Time&apos; then [driving_to_customer_time]&#10;when &apos;At Cx Time&apos; then [at_customer_time]&#10;when &apos;Vendor Delay&apos; then [vendor_delay]&#10;when &apos;Rider Delay&apos; then [rider_delay]&#10;when &apos;Delivery Delay&apos; then [delivery_delay]&#10;//when &apos;Pickup Distance Google&apos; then [pickup_distance_google_in_meters]/1000&#10;//when &apos;Dropoff Distance Google&apos; then [dropoff_distance_google_in_meters]/1000&#10;//when &apos;Delivery Distance Google&apos; then ([pickup_distance_google_in_meters]+[dropoff_distance_google_in_meters])/1000&#10;when &apos;Pickup Distance Manhattan&apos; then [pickup_distance_manhattan_in_meters]/1000&#10;when &apos;Dropoff Distance Manhattan&apos; then [dropoff_distance_manhattan_in_meters]/1000&#10;when &apos;Delivery Distance Manhattan&apos; then [delivery_distance_in_meters]/1000&#10;end' />
            </column>
            <column-instance column='[rider_picked_up_at_local]' derivation='MDY' name='[md:rider_picked_up_at_local:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1646136074632617984]' derivation='None' name='[none:Calculation_1646136074632617984:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_hour (copy)_1646136074633535489]' derivation='None' name='[none:report_hour (copy)_1646136074633535489:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_weekday (copy)_1646136074633854979]' derivation='None' name='[none:report_weekday (copy)_1646136074633854979:nk]' pivot='key' type='nominal' />
            <column-instance column='[starting_geo_name]' derivation='None' name='[none:starting_geo_name:nk]' pivot='key' type='nominal' />
