      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='62' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='61' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone forceUpdate='true' h='7558' id='3' type-v2='text' w='98858' x='571' y='800'>
                  <formatted-text>
                    <run bold='true' fontcolor='#1b1b1b' fontsize='20'>Definitions</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='90842' id='5' type-v2='text' w='98858' x='571' y='8358'>
                  <formatted-text>
                    <run fontname='Tableau Light'>Raw data is aggregated by city, zone, report_date, is_peak_time [lunch, dinner, non peak], rider id</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light'>active riders: riders with at least 1 delivery</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Planned Hour] </run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'> Avg. rider scheduled hours on Rooster per active rider. [ end_at - start_at]</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Actual RH] </run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'>Avg. actual rider hours that active rider were on shift. [actual_end_at_ - actual_start_at]</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Actual Working RH]</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'>In the shift, active riders&apos; avg actual working hours</run>
                    <run bold='true' fontname='Tableau Light' fontsize='8'>. </run>
                    <run fontname='Tableau Light' fontsize='8'> [Actual Rh - Break]</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>[Avg. Active Days]</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'>Avg day counts per active riders where they have at least 1 delivery</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Actual Working RH Per Day]</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'>Daily avg actual working hours per rider when they were active [Actual Working RH/Avg. Active Days]</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>[Orders]</run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'>Avg completed orders per active rider</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[UTR] </run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'>Completed orders per actual rider hour per active rider</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[UTR w/o break] </run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'>Completed orders per actual working rider hour per active rider</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Order Fail Rate] </run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'>Avg % of failed orders per active rider. [failed_orders/ (failed_orders + completed_orders)]</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Acceptance Rate] </run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'>accepted_times/notified_times per active rider</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[PU Distance per delivery] </run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'>Pickup distance per delivery (km) per active rider</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[DO Distance per delivery] </run>
                    <run>Æ&#10;</run>
                    <run fontname='Tableau Light' fontsize='8'>Dropoff distance per delivery (km) per active rider</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Early Arrival To Vendor Rate] </run>
                    <run>Æ&#10;</run>
                    <run fontsize='8'>Avg % of orders </run>
                    <run fontname='Tableau Light' fontsize='8'>per active rider </run>
                    <run fontsize='8'>where rider arrive to vendor earlier than scheduled time more than 5 minutes</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Late To Vendor Rate] </run>
                    <run>Æ&#10;</run>
                    <run fontsize='8'>Avg % of orders </run>
                    <run fontname='Tableau Light' fontsize='8'>per active rider</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Light' fontsize='8'>Æ </run>
                    <run fontsize='8'>where rider arrive to vendor later than scheduled time more than 5 minutes</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Total Payment per hour] </run>
                    <run>Æ&#10;</run>
                    <run fontsize='8'>Total rider payment per actual working rider hour per rider, payments including all basic payment, 1-day-quest payment and 3-day-quest payment</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Fleet Bonus per hour] </run>
                    <run>Æ&#10;</run>
                    <run fontsize='8'>Fleet campaign payment + 1-day-quest payment per actual working rider hour per rider</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Light'>[Tipping Rate overall] </run>
                    <run>Æ&#10;</run>
                    <run fontsize='8'>Avg % of orders being tipped </run>
                    <run fontname='Tableau Light' fontsize='8'>per rider</run>
                    <run>Æ













































</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
