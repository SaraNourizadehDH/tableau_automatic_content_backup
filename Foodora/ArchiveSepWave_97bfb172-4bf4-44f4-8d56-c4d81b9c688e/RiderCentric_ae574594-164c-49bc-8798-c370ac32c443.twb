      </column>
      <column caption='datetrunc report_date' datatype='date' name='[Calculation_5405797362255843338]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) THEN date(datetrunc(&apos;month&apos;,[report_date]))&#10;ELSEIF  REGEXP_MATCH([Parameters].[Parameter 1],&apos;(week)|(wtd)&apos;) THEN date(DATETRUNC(&apos;iso-week&apos;,[report_date]))&#10;ELSE date(DATETRUNC(&apos;day&apos;,[report_date]))&#10;end' />
      </column>
      <column caption='datename(2) report_date' datatype='string' name='[Calculation_5405797362256662539]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;day&apos;&#10;THEN left(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#10;ELSE str(year([Calculation_5405797362255843338]))&#10;END' />
      </column>
      <column caption='datefilter(2) report_date' datatype='boolean' name='[Calculation_5405797362288267276]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_5405797362252464130] &lt;= 12+[Parameters].[Parameter 3]+[Parameters].[Parameter 2]&#10;AND &#10;[Calculation_5405797362252464130] &gt;= [Parameters].[Parameter 3]' />
      </column>
      <column caption='main_kpi' datatype='real' name='[Calculation_5405797362607448077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Planned Hour&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM(IF [deliveries]&gt;=1 THEN [planned_rh] END)})&#10;WHEN &apos;Actual RH&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM(IF [deliveries]&gt;=1 THEN [actual_rh] END)})&#10;WHEN &apos;Actual Working RH&apos; THEN [Calculation_5951858757598953472]&#10;WHEN &apos;Active Days&apos; THEN [Calculation_5951858757599178753]&#10;WHEN &apos;Actual Working RH Per Day&apos; THEN [Calculation_5951858757598953472]/[Calculation_5951858757599178753]&#10;WHEN &apos;Orders&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM(IF [deliveries]&gt;=1 THEN [orders] END)})&#10;WHEN &apos;UTR&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([orders])/SUM([actual_rh])})&#10;WHEN &apos;UTR w/o break&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([orders])/SUM([actual_working_rh])})&#10;WHEN &apos;Order Fail Rate&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([failed_orders])/(SUM([orders])+SUM([failed_orders]))})&#10;WHEN &apos;Acceptance Rate&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([accepted_times])/SUM([notified_times])})&#10;WHEN &apos;PU Distance&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([pickup_distance_manhattan])/(1000*SUM([deliveries]))})&#10;WHEN &apos;DO Distance&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([dropoff_distance_manhattan])/(1000*SUM([deliveries]))})&#10;WHEN &apos;Early Arrival To Vendor Rate&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([early_to_vendor_orders])/(SUM([orders])-SUM([preorders]))})&#10;WHEN &apos;Late To Vendor Rate&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([late_to_vendor_orders])/(SUM([orders])-SUM([preorders]))})&#10;WHEN &apos;Total Payment Per Hour&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: (SUM([total_basic_payment])+SUM([fleet_1day_quest_payment])+SUM([fleet_3day_quest_payment]))/SUM([actual_working_rh])})&#10;WHEN &apos;Fleet Bonus Per Hour&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: (SUM([fleet_campaign_payment])+SUM([fleet_1day_quest_payment]))/SUM([actual_working_rh])})&#10;WHEN &apos;Tipping Rate&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([tipped_orders])/SUM([orders])})&#10;END&#10;)' />
      </column>
      <column caption='avg_actual_working_rh' datatype='real' name='[Calculation_5951858757598953472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ INCLUDE [city_name], [lg_rider_id]: SUM(IF [deliveries]&gt;=1 THEN [actual_working_rh] END)})' />
      </column>
      <column caption='avg_active_days' datatype='real' name='[Calculation_5951858757599178753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ INCLUDE [city_name], [lg_rider_id]: COUNTD(IF [deliveries]&gt;=1 THEN [report_date] END)})' />
      </column>
