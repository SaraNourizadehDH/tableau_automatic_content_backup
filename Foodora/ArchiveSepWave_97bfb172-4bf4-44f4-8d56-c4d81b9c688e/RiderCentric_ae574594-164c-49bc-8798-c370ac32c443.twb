              <calculation class='tableau' formula='if [Parameters].[Parameter 5] then &quot;Total&quot;&#10;else [city_name]&#10;end' />
            </column>
            <column caption='filter_report_date' datatype='boolean' name='[Calculation_5405797362251862017]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] &lt; TODAY()' />
            </column>
            <column caption='datediff report_date' datatype='integer' name='[Calculation_5405797362252464130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) &#10;then DATEDIFF(&apos;month&apos;,[report_date], [Calculation_5405797362252648451])&#10;elseif REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;)&#10;then DATEDIFF(&apos;week&apos;,[report_date], [Calculation_5405797362252648451])&#10;elseif [Parameters].[Parameter 1] = &apos;day&apos; &#10;then DATEDIFF(&apos;day&apos;,[report_date], [Calculation_5405797362252648451])&#10;end' />
            </column>
            <column caption='updated_date' datatype='date' name='[Calculation_5405797362252648451]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([report_date])}' />
            </column>
            <column caption='datefilter report_date' datatype='boolean' name='[Calculation_5405797362253537284]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(week)|(day)&apos;)&#10;then [Calculation_5405797362252464130] &lt;= 12+[Parameters].[Parameter 3] and [Calculation_5405797362252464130] &gt;= [Parameters].[Parameter 3]&#10;elseif [Parameters].[Parameter 1] = &apos;mtd&apos;&#10;then [Calculation_5405797362253778949] &lt;= [Calculation_5405797362253991942] and [Calculation_5405797362252464130] &lt;= 12+[Parameters].[Parameter 3] and [Calculation_5405797362252464130] &gt;= [Parameters].[Parameter 3]&#10;elseif [Parameters].[Parameter 1] = &apos;wtd&apos;&#10;then [Calculation_5405797362254188551] &lt;= [Calculation_5405797362254942216] and [Calculation_5405797362252464130] &lt;= 12+[Parameters].[Parameter 3] and [Calculation_5405797362252464130] &gt;= [Parameters].[Parameter 3]&#10;end' />
            </column>
            <column caption='mtd report_date' datatype='integer' name='[Calculation_5405797362253778949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [report_date])' />
            </column>
            <column caption='mtd updated_date' datatype='integer' name='[Calculation_5405797362253991942]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [Calculation_5405797362252648451])' />
            </column>
            <column caption='wtd report_date' datatype='integer' name='[Calculation_5405797362254188551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[report_date]) = 1 then 7&#10;ELSE DATEPART(&apos;weekday&apos;,[report_date]) -1&#10;END' />
            </column>
            <column caption='wtd updated_date' datatype='integer' name='[Calculation_5405797362254942216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[Calculation_5405797362252648451]) = 1 then 7&#10;ELSE DATEPART(&apos;weekday&apos;,[Calculation_5405797362252648451]) -1&#10;END' />
            </column>
            <column caption='datename report_date' datatype='string' name='[Calculation_5405797362255568905]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) THEN left(DATENAME(&apos;month&apos;, [report_date]),3)&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 1], &apos;(week)|(wtd)&apos;) THEN &apos;Week &apos; + DATENAME(&apos;iso-week&apos;, [report_date])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;day&apos; THEN str([Calculation_5405797362255843338])&#10;END' />
            </column>
            <column caption='datetrunc report_date' datatype='date' name='[Calculation_5405797362255843338]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &apos;(month)|(mtd)&apos;) THEN date(datetrunc(&apos;month&apos;,[report_date]))&#10;ELSEIF  REGEXP_MATCH([Parameters].[Parameter 1],&apos;(week)|(wtd)&apos;) THEN date(DATETRUNC(&apos;iso-week&apos;,[report_date]))&#10;ELSE date(DATETRUNC(&apos;day&apos;,[report_date]))&#10;end' />
            </column>
            <column caption='datename(2) report_date' datatype='string' name='[Calculation_5405797362256662539]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;day&apos;&#10;THEN left(DATENAME(&apos;weekday&apos;, [report_date], &apos;monday&apos;),3)&#10;ELSE str(year([Calculation_5405797362255843338]))&#10;END' />
            </column>
            <column caption='datefilter(2) report_date' datatype='boolean' name='[Calculation_5405797362288267276]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5405797362252464130] &lt;= 12+[Parameters].[Parameter 3]+[Parameters].[Parameter 2]&#10;AND &#10;[Calculation_5405797362252464130] &gt;= [Parameters].[Parameter 3]' />
            </column>
            <column caption='main_kpi' datatype='real' name='[Calculation_5405797362607448077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Planned Hour&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM(IF [deliveries]&gt;=1 THEN [planned_rh] END)})&#10;WHEN &apos;Actual RH&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM(IF [deliveries]&gt;=1 THEN [actual_rh] END)})&#10;WHEN &apos;Actual Working RH&apos; THEN [Calculation_5951858757598953472]&#10;WHEN &apos;Active Days&apos; THEN [Calculation_5951858757599178753]&#10;WHEN &apos;Actual Working RH Per Day&apos; THEN [Calculation_5951858757598953472]/[Calculation_5951858757599178753]&#10;WHEN &apos;Orders&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM(IF [deliveries]&gt;=1 THEN [orders] END)})&#10;WHEN &apos;UTR&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([orders])/SUM([actual_rh])})&#10;WHEN &apos;UTR w/o break&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([orders])/SUM([actual_working_rh])})&#10;WHEN &apos;Order Fail Rate&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([failed_orders])/(SUM([orders])+SUM([failed_orders]))})&#10;WHEN &apos;Acceptance Rate&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([accepted_times])/SUM([notified_times])})&#10;WHEN &apos;PU Distance&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([pickup_distance_manhattan])/(1000*SUM([deliveries]))})&#10;WHEN &apos;DO Distance&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([dropoff_distance_manhattan])/(1000*SUM([deliveries]))})&#10;WHEN &apos;Early Arrival To Vendor Rate&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([early_to_vendor_orders])/(SUM([orders])-SUM([preorders]))})&#10;WHEN &apos;Late To Vendor Rate&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([late_to_vendor_orders])/(SUM([orders])-SUM([preorders]))})&#10;WHEN &apos;Total Payment Per Hour&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: (SUM([total_basic_payment])+SUM([fleet_1day_quest_payment])+SUM([fleet_3day_quest_payment]))/SUM([actual_working_rh])})&#10;WHEN &apos;Fleet Bonus Per Hour&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: (SUM([fleet_campaign_payment])+SUM([fleet_1day_quest_payment]))/SUM([actual_working_rh])})&#10;WHEN &apos;Tipping Rate&apos; THEN AVG({ INCLUDE [city_name], [lg_rider_id]: SUM([tipped_orders])/SUM([orders])})&#10;END&#10;)' />
            </column>
            <column caption='avg_actual_working_rh' datatype='real' name='[Calculation_5951858757598953472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [city_name], [lg_rider_id]: SUM(IF [deliveries]&gt;=1 THEN [actual_working_rh] END)})' />
            </column>
            <column caption='avg_active_days' datatype='real' name='[Calculation_5951858757599178753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [city_name], [lg_rider_id]: COUNTD(IF [deliveries]&gt;=1 THEN [report_date] END)})' />
            </column>
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[accepted_times]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[actual_rh]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[actual_working_rh]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column-instance column='[Calculation_5405797362255568905]' derivation='Attribute' name='[attr:Calculation_5405797362255568905:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5405797362256662539]' derivation='Attribute' name='[attr:Calculation_5405797362256662539:nk]' pivot='key' type='nominal' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[city_name]' pivot='key' role='dimension' semantic-role='[City].[Name]' type='nominal' user-datatype='string' visual-totals='Default' />
