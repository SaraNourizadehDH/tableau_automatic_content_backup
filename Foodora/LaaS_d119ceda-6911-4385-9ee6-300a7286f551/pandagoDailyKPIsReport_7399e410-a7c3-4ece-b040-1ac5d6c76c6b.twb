    <worksheet name='WoW API Orders Growth'>
      <table>
        <view>
          <datasources>
            <datasource caption='pandago_source' name='federated.1dbdutk0n3t1cm1h2bsd7125m3jw' />
          </datasources>
          <datasource-dependencies datasource='federated.1dbdutk0n3t1cm1h2bsd7125m3jw'>
            <column caption='is_API' datatype='string' datatype-customized='true' name='[Calculation_103864282125012996]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF business_type_apac = &quot;pandago_laas&quot; OR order_source = &quot;api-integration&quot; THEN &quot;API&quot; ELSE &quot;non-API&quot; END' />
            </column>
            <column caption='WoW Header' datatype='string' name='[Calculation_499829203865866248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(&apos;WoW %&apos;)' />
            </column>
            <column caption='Business Type Apac' datatype='string' name='[business_type_apac]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;pandago_b2c&quot;' value='b2c' />
                <alias key='&quot;pandago_c2c&quot;' value='c2c' />
                <alias key='&quot;pandago_laas&quot;' value='laas' />
              </aliases>
            </column>
            <column caption='wow_completed_orders' datatype='real' default-format='p0.00%' name='[completed_orders (copy)_1377045969482813441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [yesterday] = 1 THEN [completed_orders] END)&#10;/&#10;SUM(IF [wow_day] = 1 THEN [completed_orders] END) -1' />
            </column>
            <column caption='Completed Orders' datatype='integer' name='[completed_orders]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_103864282125012996]' derivation='None' name='[none:Calculation_103864282125012996:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_499829203865866248]' derivation='None' name='[none:Calculation_499829203865866248:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column caption='Order Source' datatype='string' name='[order_source]' role='dimension' type='nominal' />
            <column caption='completed_orders_ytd' datatype='integer' name='[revenue_sum_eur_ytd (copy)_1661194970172551184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [yesterday] = 1 THEN ZN([completed_orders]) END)' />
            </column>
            <column-instance column='[completed_orders (copy)_1377045969482813441]' derivation='User' name='[usr:completed_orders (copy)_1377045969482813441:qk]' pivot='key' type='quantitative' />
            <column-instance column='[revenue_sum_eur_ytd (copy)_1661194970172551184]' derivation='User' name='[usr:revenue_sum_eur_ytd (copy)_1661194970172551184:qk]' pivot='key' type='quantitative' />
            <column aggregation='Sum' caption='Wow Day' datatype='integer' name='[wow_day]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Yesterday' datatype='integer' name='[yesterday]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1dbdutk0n3t1cm1h2bsd7125m3jw].[:Measure Names]'>
            <groupfilter function='level-members' level='[:Measure Names]' />
