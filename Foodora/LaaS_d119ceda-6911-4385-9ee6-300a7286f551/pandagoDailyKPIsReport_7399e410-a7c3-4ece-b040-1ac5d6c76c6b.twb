      <aliases enabled='yes' />
      <column caption='% order vendor 5 min late_ytd' datatype='real' name='[% order rider 2 min late_ytd (copy)_1661194970153971719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [yesterday] = 1 THEN ZN([vendor_late_5min_to_order]) END)/&#10;SUM(IF [yesterday] = 1 THEN ZN([sum_fp_orders]) END)' />
      </column>
      <column caption='% order rider 5 mins late' datatype='real' default-format='p0.0%' name='[% order rider 2 mins late (copy)_5977613730552590338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_late_5min_to_order])/SUM([sum_fp_orders])' />
      </column>
      <column caption='% order vendor 5 mins late' datatype='real' default-format='p0.0%' name='[% order rider 5 mins late (copy)_5977613730552946691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_late_5min_to_order])/SUM([sum_fp_orders])' />
      </column>
      <column caption='avg_DO_distance_ytd' datatype='real' name='[% order vendor 5 min late_ytd (copy)_1661194970155343880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [yesterday] = 1 THEN ZN([dropoff_distance_in_km]) END)/&#10;SUM(IF [yesterday] = 1 THEN ZN([completed_orders]) + ZN([cancelled_orders]) END)' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1dbdutk0n3t1cm1h2bsd7125m3jw].[usr:\% order rider 2 mins late (copy)_5977613730552590338:qk]&quot;' value='5 mins late' />
          <alias key='&quot;[federated.1dbdutk0n3t1cm1h2bsd7125m3jw].[usr:DT per completed order (copy)_5977613730552348673:qk]&quot;' value='2 mins late' />
          <alias key='&quot;[federated.1dbdutk0n3t1cm1h2bsd7125m3jw].[usr:MoM_DT_growth (copy)_5977613730590617607:qk]&quot;' value='2 min' />
          <alias key='&quot;[federated.1dbdutk0n3t1cm1h2bsd7125m3jw].[usr:MoM_rider_late_2_min_growth (copy)_5977613730590793736:qk]&quot;' value='5 min' />
        </aliases>
      </column>
      <column caption='% order rider 2 min late_ytd' datatype='real' name='[AR_ytd (copy)_1661194969806389253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [yesterday] = 1 THEN ZN([rider_late_2min_to_order]) END)/&#10;SUM(IF [yesterday] = 1 THEN ZN([sum_fp_orders]) END)' />
      </column>
      <column caption='GPO' datatype='real' default-format='c#,##0.00;-#,##0.00' name='[CPO (copy)_5977613730963922967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue_sum_eur] - [rider_payment_with_quest_eur])/SUM(ZN([completed_orders]))' />
      </column>
      <column caption='GPO_ytd' datatype='real' name='[CPO_ytd (copy)_1661194970159054859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [yesterday] = 1 THEN ZN([revenue_sum_eur]) - ZN([rider_payment_with_quest_eur]) END)/&#10;SUM(IF [yesterday] = 1 THEN ZN([completed_orders]) END)' />
      </column>
      <column caption='cancel_rate' datatype='real' default-format='p0.0%' name='[Calculation_103864282122723328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([cancelled_orders]))&#10;/&#10;SUM(ZN([cancelled_orders]) + ZN([completed_orders]))' />
      </column>
      <column caption='is_API' datatype='string' datatype-customized='true' name='[Calculation_103864282125012996]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF business_type_apac = &quot;pandago_laas&quot; OR order_source = &quot;api-integration&quot; THEN &quot;API&quot; ELSE &quot;non-API&quot; END' />
      </column>
      <column caption='est_prep_time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_103864282184089611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ept_in_min])/SUM([completed_orders])' />
      </column>
      <column caption='is_last_8_day' datatype='boolean' name='[Calculation_1357342764564480001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [l7d] = 1 OR [wow_day] = 1 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='DT per completed order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1646417524223987719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_time_mins])/SUM([completed_orders])' />
      </column>
      <column caption='is_c2c' datatype='string' name='[Calculation_1646417524308320270]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [business_type_apac] = &quot;pandago_c2c&quot; THEN &quot;c2c&quot; ELSE &quot;b2c&quot; END' />
      </column>
      <column caption='AR' datatype='real' default-format='p0.0%' name='[Calculation_1646417524311539727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([accepted_vol])/SUM([notification_vol])' />
      </column>
      <column caption='Avg. DO distance' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_183099497976164352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([dropoff_distance_in_km]))/SUM(ZN([completed_orders]) + ZN([cancelled_orders]))' />
      </column>
      <column caption='Completed and Cancelled Orders' datatype='integer' name='[Calculation_2739947816571387915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([completed_orders]) + ZN([cancelled_orders]))' />
      </column>
      <column caption='latest month' datatype='string' name='[Calculation_3077577071563956224]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&apos;Latest Month&apos;)' />
      </column>
      <column caption='latest month filter' datatype='boolean' name='[Calculation_3077577071565484033]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;,[date_local])={MAX(DATETRUNC(&quot;month&quot;,[date_local]))}' />
      </column>
      <column caption='Order Value per Order' datatype='real' default-format='c#,##0.00;(#,##0.00)' name='[Calculation_3379318226227539968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_value_sum_eur])/SUM(ZN([completed_orders]))' />
      </column>
      <column caption='active vendor with &gt;=1 orders ' datatype='integer' name='[Calculation_4159778009528471552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unique_active_vendors_with_1_order])' />
      </column>
      <column caption='ytd_orders' datatype='integer' name='[Calculation_499829203862818821]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([yesterday] = 1,[sum_fp_orders],0)' />
      </column>
      <column caption='wow_c2c_order_count' datatype='real' default-format='p0.00%' name='[Calculation_499829203865600007]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [yesterday] = 1 THEN [c2c_completed_order_count] END)&#10;/&#10;SUM(IF [wow_day] = 1 THEN [c2c_completed_order_count] END) -1' />
      </column>
      <column caption='WoW Header' datatype='string' name='[Calculation_499829203865866248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&apos;WoW %&apos;)' />
      </column>
