    <worksheet name='Daily Cancel Rate (c2c)'>
      <table>
        <view>
          <datasources>
            <datasource caption='pandago_source' name='federated.1dbdutk0n3t1cm1h2bsd7125m3jw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dynamic Date' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dbdutk0n3t1cm1h2bsd7125m3jw'>
            <column caption='cancel_rate' datatype='real' default-format='p0.0%' name='[Calculation_103864282122723328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([cancelled_orders]))&#10;/&#10;SUM(ZN([cancelled_orders]) + ZN([completed_orders]))' />
            </column>
            <column caption='Completed and Cancelled Orders' datatype='integer' name='[Calculation_2739947816571387915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([completed_orders]) + ZN([cancelled_orders]))' />
            </column>
            <column caption='Dynamic Date Range' datatype='string' name='[Calculation_590745643843104768]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;week&apos; or [Parameters].[Parameter 1] = &apos;week w wtd&apos;) then str(DATEPART(&apos;iso-year&apos;, [date_local]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;, [date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;day&apos; then LEFT(str(DATENAME(&quot;weekday&quot;,[date_local])),3)+&apos; &apos;+str(DATEPART(&apos;day&apos;,  [date_local]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;, [date_local])),3)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;month&apos; or [Parameters].[Parameter 1] = &apos;month w mtd&apos;) then LEFT(str(DATENAME(&apos;month&apos;, [date_local])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;, [date_local])),2) &#10;ELSEIF [Parameters].[Parameter 1] = &apos;quarter&apos; THEN str(DATEPART(&apos;iso-year&apos;, [date_local])) + &apos;-Q&apos; + LEFT(str(DATENAME(&apos;iso-quarter&apos;, [date_local])),3)&#10;END' />
            </column>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_590745643843813377]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;month&apos; THEN [date_local] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) &#10;ELSEIF [Parameters].[Parameter 1] = &apos;week&apos; THEN [date_local] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;day&apos; THEN [date_local] &gt;= DATEADD(&apos;day&apos;,-9,TODAY()) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;month w mtd&apos; THEN [date_local] &gt;= DATEADD(&apos;month&apos;,-5,DATETRUNC(&apos;month&apos;,TODAY())) AND [date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;week w wtd&apos; THEN [date_local] &gt;= DATEADD(&apos;iso-week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [date_local] &lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;quarter&apos; THEN [date_local] &gt;= DATEADD(&apos;quarter&apos;,-5,DATETRUNC(&apos;iso-quarter&apos;,TODAY())) &#10;END' />
            </column>
            <column caption='Column name - Dynamic' datatype='string' name='[Calculation_590745643845210114]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;day&apos; then &apos;Daily&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;week&apos; then &apos;Week&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;month&apos; then &apos;Month&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;quarter&apos; then &apos;Quarter&apos;&#10;END' />
            </column>
            <column-instance column='[yesterday]' derivation='Attribute' name='[attr:yesterday:qk]' pivot='key' type='quantitative' />
            <column caption='Business Type Apac' datatype='string' name='[business_type_apac]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;pandago_b2c&quot;' value='b2c' />
                <alias key='&quot;pandago_c2c&quot;' value='c2c' />
                <alias key='&quot;pandago_laas&quot;' value='laas' />
              </aliases>
            </column>
            <column caption='Cancelled Orders' datatype='integer' name='[cancelled_orders]' role='measure' type='quantitative' />
            <column caption='Completed Orders' datatype='integer' name='[completed_orders]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Local' datatype='date' default-format='*ddd, dd mmm yy' name='[date_local]' role='dimension' type='ordinal' />
            <column caption='cancel_rate_ytd' datatype='real' name='[est_prep_time_ytd (copy)_1661194969801797633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [yesterday] = 1 THEN ZN([cancelled_orders]) END)/&#10;SUM(IF [yesterday] = 1 THEN (ZN([cancelled_orders]) + ZN([completed_orders])) END)' />
            </column>
            <column-instance column='[date_local]' derivation='Max' name='[max:date_local:qk]' pivot='key' type='quantitative' />
