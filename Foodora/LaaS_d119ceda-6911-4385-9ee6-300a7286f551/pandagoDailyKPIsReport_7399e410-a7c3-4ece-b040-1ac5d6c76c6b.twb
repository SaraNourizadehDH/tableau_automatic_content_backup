            <column caption='MoM_DT_growth' datatype='real' default-format='p0.0%' name='[MoM_cancel_rate_growth (copy)_1646417524243537928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [mtd] = 1 THEN [delivery_time_mins] END) / &#10;SUM(IF [mtd] = 1 THEN [completed_orders] END))&#10;/&#10;(SUM(IF [prev_mtd] = 1 THEN [delivery_time_mins] END) / &#10;SUM(IF [prev_mtd] = 1 THEN [completed_orders] END))&#10;) - 1' />
            </column>
