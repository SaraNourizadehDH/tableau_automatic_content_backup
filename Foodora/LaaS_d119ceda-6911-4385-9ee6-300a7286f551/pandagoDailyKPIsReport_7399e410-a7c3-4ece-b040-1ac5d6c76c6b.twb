    <datasource caption='regional_apac_lg_tb_pandago_percentage_fp_orders (pandata_report)' inline='true' name='federated.1iyf3mj18l5fvm1crd6yh0n712c1' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1ac4h2m1ouxpnz17vitfl17435hb'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='filbert.kang@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
