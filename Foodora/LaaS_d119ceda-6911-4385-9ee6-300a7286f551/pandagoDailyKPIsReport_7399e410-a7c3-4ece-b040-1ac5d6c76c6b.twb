            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column caption='Revenue Sum Eur' datatype='real' default-format='c#,##0.00;(#,##0.00)' name='[revenue_sum_eur]' role='measure' type='quantitative' />
            <column-instance column='[revenue_sum_eur]' derivation='Sum' name='[sum:revenue_sum_eur:qk]' pivot='key' type='quantitative' />
