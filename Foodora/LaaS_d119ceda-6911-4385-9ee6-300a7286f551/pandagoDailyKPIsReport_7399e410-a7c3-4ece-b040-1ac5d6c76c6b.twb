    <worksheet name='GPO L7D'>
      <table>
        <view>
          <datasources>
            <datasource caption='pandago_source' name='federated.1dbdutk0n3t1cm1h2bsd7125m3jw' />
          </datasources>
          <datasource-dependencies datasource='federated.1dbdutk0n3t1cm1h2bsd7125m3jw'>
            <column caption='% order rider 5 mins late' datatype='real' default-format='p0.0%' name='[% order rider 2 mins late (copy)_5977613730552590338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_5min_to_order])/SUM([sum_fp_orders])' />
            </column>
            <column caption='GPO' datatype='real' default-format='c#,##0.00;-#,##0.00' name='[CPO (copy)_5977613730963922967]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue_sum_eur] - [rider_payment_with_quest_eur])/SUM(ZN([completed_orders]))' />
            </column>
            <column caption='is_c2c' datatype='string' name='[Calculation_1646417524308320270]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [business_type_apac] = &quot;pandago_c2c&quot; THEN &quot;c2c&quot; ELSE &quot;b2c&quot; END' />
            </column>
            <column caption='label' datatype='string' name='[Calculation_499829203879342094]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [prev_l7d] =  1 THEN &quot;Previous L7D&quot; ELSEIF &#10;l7d =1 THEN &quot;L7D&quot; END' />
            </column>
            <column caption='% order rider 2 mins late' datatype='real' default-format='p0.0%' name='[DT per completed order (copy)_5977613730552348673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_2min_to_order])/SUM([sum_fp_orders])' />
            </column>
            <column caption='Business Type Apac' datatype='string' name='[business_type_apac]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;pandago_b2c&quot;' value='b2c' />
                <alias key='&quot;pandago_c2c&quot;' value='c2c' />
                <alias key='&quot;pandago_laas&quot;' value='laas' />
              </aliases>
            </column>
            <column caption='Completed Orders' datatype='integer' name='[completed_orders]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='L7D' datatype='integer' name='[l7d]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='L7D Rank' datatype='integer' name='[l7d_rank]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1646417524308320270]' derivation='None' name='[none:Calculation_1646417524308320270:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_499829203879342094]' derivation='None' name='[none:Calculation_499829203879342094:nk]' pivot='key' type='nominal' />
            <column-instance column='[l7d_rank]' derivation='None' name='[none:l7d_rank:ok]' pivot='key' type='ordinal' />
            <column-instance column='[l7d_rank]' derivation='None' name='[none:l7d_rank:qk]' pivot='key' type='quantitative' />
            <column aggregation='Sum' caption='Prev L7D' datatype='integer' name='[prev_l7d]' role='dimension' type='ordinal' />
            <column caption='Revenue Sum Eur' datatype='real' default-format='c#,##0.00;(#,##0.00)' name='[revenue_sum_eur]' role='measure' type='quantitative' />
            <column caption='Rider Late 2Min To Order' datatype='integer' name='[rider_late_2min_to_order]' role='measure' type='quantitative' />
            <column caption='Rider Late 5Min To Order' datatype='integer' name='[rider_late_5min_to_order]' role='measure' type='quantitative' />
            <column caption='Rider Payment With Quest Eur' datatype='real' name='[rider_payment_with_quest_eur]' role='measure' type='quantitative' />
            <column caption='Sum Fp Orders' datatype='integer' name='[sum_fp_orders]' role='measure' type='quantitative' />
            <column-instance column='[% order rider 2 mins late (copy)_5977613730552590338]' derivation='User' name='[usr:% order rider 2 mins late (copy)_5977613730552590338:qk]' pivot='key' type='quantitative' />
            <column-instance column='[CPO (copy)_5977613730963922967]' derivation='User' name='[usr:CPO (copy)_5977613730963922967:qk]' pivot='key' type='quantitative' />
            <column-instance column='[DT per completed order (copy)_5977613730552348673]' derivation='User' name='[usr:DT per completed order (copy)_5977613730552348673:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
