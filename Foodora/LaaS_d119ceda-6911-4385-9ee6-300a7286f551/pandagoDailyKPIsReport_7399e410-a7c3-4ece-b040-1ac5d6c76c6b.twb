          <datasource-dependencies datasource='federated.1dbdutk0n3t1cm1h2bsd7125m3jw'>
            <column caption='% order rider 5 mins late' datatype='real' default-format='p0.0%' name='[% order rider 2 mins late (copy)_5977613730552590338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_5min_to_order])/SUM([sum_fp_orders])' />
            </column>
            <column caption='% order rider 2 min late_ytd' datatype='real' name='[AR_ytd (copy)_1661194969806389253]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [yesterday] = 1 THEN ZN([rider_late_2min_to_order]) END)/&#10;SUM(IF [yesterday] = 1 THEN ZN([sum_fp_orders]) END)' />
            </column>
            <column caption='WoW Header' datatype='string' name='[Calculation_499829203865866248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(&apos;WoW %&apos;)' />
