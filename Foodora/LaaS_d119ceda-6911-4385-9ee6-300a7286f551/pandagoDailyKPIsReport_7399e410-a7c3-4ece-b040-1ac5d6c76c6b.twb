            <column caption='% order rider 5 mins late' datatype='real' default-format='p0.0%' name='[% order rider 2 mins late (copy)_5977613730552590338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_5min_to_order])/SUM([sum_fp_orders])' />
            </column>
            <column caption='is_c2c' datatype='string' name='[Calculation_1646417524308320270]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [business_type_apac] = &quot;pandago_c2c&quot; THEN &quot;c2c&quot; ELSE &quot;b2c&quot; END' />
            </column>
            <column caption='label' datatype='string' name='[Calculation_499829203879342094]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [prev_l7d] =  1 THEN &quot;Previous L7D&quot; ELSEIF &#10;l7d =1 THEN &quot;L7D&quot; END' />
            </column>
            <column caption='DF per Order' datatype='real' default-format='c#,##0.00;-#,##0.00' name='[Calculation_5977613730872487948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue_sum_eur])/SUM(ZN([completed_orders]))' />
