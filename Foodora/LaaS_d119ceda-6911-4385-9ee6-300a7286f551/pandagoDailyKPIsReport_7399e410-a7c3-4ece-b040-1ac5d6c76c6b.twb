    <worksheet name='% c2c of total'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>% C2C of Total (pd + non-pd orders)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_apac_lg_tb_pandago_percentage_fp_orders (pandata_report)' name='federated.1iyf3mj18l5fvm1crd6yh0n712c1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dynamic Date' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1iyf3mj18l5fvm1crd6yh0n712c1'>
            <column caption='% C2C of Total' datatype='real' name='[Calculation_2333427599405817856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_pandago_c2c])/SUM([pd_order_id_count]+[non_pd_order_id_count])' />
