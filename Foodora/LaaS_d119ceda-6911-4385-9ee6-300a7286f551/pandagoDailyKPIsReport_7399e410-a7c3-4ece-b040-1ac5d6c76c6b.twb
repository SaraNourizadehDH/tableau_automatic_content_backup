          <datasource-dependencies datasource='federated.1iyf3mj18l5fvm1crd6yh0n712c1'>
            <column caption='% B2C+LAAS of Total' datatype='real' name='[% C2C of Total (copy)_2333427599406485505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_pandago_b2c]+[total_pandago_laas])/SUM([pd_order_id_count]+[non_pd_order_id_count])' />
            </column>
            <column caption='Dynamic Date Filter' datatype='boolean' name='[Calculation_6334735152141905920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;month&apos; THEN [created_date_local] &gt;= DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) &#10;ELSEIF [Parameters].[Parameter 1] = &apos;week&apos; THEN [created_date_local] &gt;= DATEADD(&apos;week&apos;,-6,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [created_date_local] &lt;= DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;iso-week&apos;,TODAY()))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;day&apos; THEN [created_date_local] &gt;= DATEADD(&apos;day&apos;,-8,TODAY()) AND [created_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;month w mtd&apos; THEN [created_date_local]&gt;= DATEADD(&apos;month&apos;,-5,DATETRUNC(&apos;month&apos;,TODAY())) AND [created_date_local] &lt;= DATEADD(&apos;day&apos;,-1,TODAY())&#10;ELSEIF [Parameters].[Parameter 1] = &apos;week w wtd&apos; THEN [created_date_local] &gt;= DATEADD(&apos;iso-week&apos;,-5,DATETRUNC(&apos;iso-week&apos;,TODAY())) AND [created_date_local]&lt; TODAY()&#10;ELSEIF [Parameters].[Parameter 1] = &apos;quarter&apos; THEN [created_date_local] &gt;= DATEADD(&apos;quarter&apos;,-5,DATETRUNC(&apos;iso-quarter&apos;,TODAY())) &#10;END' />
            </column>
            <column caption='Dynamic Date Range' datatype='string' name='[Calculation_6334735152142409729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([Parameters].[Parameter 1] = &apos;week&apos; or [Parameters].[Parameter 1] = &apos;week w wtd&apos;) then str(DATEPART(&apos;iso-year&apos;, [created_date_local]))+&apos;-&apos;+str(DATEPART(&apos;iso-week&apos;, [created_date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;day&apos; then LEFT(str(DATENAME(&quot;weekday&quot;,[created_date_local])),3)+&apos; &apos;+str(DATEPART(&apos;day&apos;,  [created_date_local]))+&apos; &apos;+LEFT(str(DATENAME(&apos;month&apos;, [created_date_local])),3)&#10;ELSEIF ([Parameters].[Parameter 1] = &apos;month&apos; or [Parameters].[Parameter 1] = &apos;month w mtd&apos;) then LEFT(str(DATENAME(&apos;month&apos;, [created_date_local])),3)+&apos; &apos;+RIGHT(str(DATEPART(&apos;year&apos;, [created_date_local])),2) &#10;ELSEIF [Parameters].[Parameter 1] = &apos;quarter&apos; THEN str(DATEPART(&apos;iso-year&apos;, [created_date_local])) + &apos;-Q&apos; + LEFT(str(DATENAME(&apos;iso-quarter&apos;, [created_date_local])),3)&#10;END' />
            </column>
            <column caption='Column Name - Dynamic' datatype='string' name='[Calculation_6334735152142811138]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;day&apos; then &apos;Daily&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;week&apos; then &apos;Week&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;month&apos; then &apos;Month&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;quarter&apos; then &apos;Quarter&apos;&#10;END' />
            </column>
