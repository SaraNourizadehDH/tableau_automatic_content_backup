            <column caption='Cancelled Orders' datatype='integer' name='[cancelled_orders]' role='measure' type='quantitative' />
            <column caption='Completed Orders' datatype='integer' name='[completed_orders]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Local' datatype='date' default-format='*ddd, dd mmm yy' name='[date_local]' role='dimension' type='ordinal' />
            <column-instance column='[date_local]' derivation='Max' name='[max:date_local:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1646417524308320270]' derivation='None' name='[none:Calculation_1646417524308320270:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_590745643843104768]' derivation='None' name='[none:Calculation_590745643843104768:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_590745643843813377]' derivation='None' name='[none:Calculation_590745643843813377:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_590745643845210114]' derivation='None' name='[none:Calculation_590745643845210114:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
