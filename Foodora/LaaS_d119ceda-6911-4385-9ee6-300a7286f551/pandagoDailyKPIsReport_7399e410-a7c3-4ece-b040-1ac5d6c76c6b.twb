      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='regional_apac_lg_tb_pandago_percentage_fp_orders' id='regional_apac_lg_tb_pandago_percentage_fp_orders_03112D6C83BA43878EF9FAF6658D4384'>
            <properties context=''>
              <relation connection='bigquery.1ac4h2m1ouxpnz17vitfl17435hb' name='Custom SQL Query' type='text'><![CDATA[WITH
pd_orders AS (
  SELECT
    pd_orders.global_entity_id,
    shared_countries.region,
    pd_orders.country_name,
    pd_orders.id,
    pd_orders.code,
    pd_orders.pd_customer_uuid,
    pd_orders.is_valid_order,
    pd_orders.is_preorder,
    pd_orders.is_gross_order,
    pd_orders.is_failed_order,
    pd_orders.is_own_delivery,
    pd_orders.created_at_local,
    pd_orders.created_date_local,
    pd_orders.created_date_utc,
    pd_orders.ordered_at_local,
    TRUE AS is_pd
  FROM `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd_orders
  INNER JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
          ON shared_countries.global_entity_id = pd_orders.global_entity_id
         AND shared_countries.region = "Asia"
  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_accounting` AS pd_orders_agg_accounting
         ON pd_orders_agg_accounting.uuid = pd_orders.uuid
        AND pd_orders_agg_accounting.created_date_utc >>= DATE_SUB(DATE_TRUNC(DATE(CURRENT_DATE()), MONTH), INTERVAL 9 MONTH)
  LEFT JOIN UNNEST(pd_orders_agg_accounting.accounting) AS accounting
  WHERE pd_orders.created_date_local >>= DATE_SUB(DATE_TRUNC(DATE(CURRENT_DATE()), MONTH), INTERVAL 9 MONTH)
    AND pd_orders.created_date_local <<= CURRENT_DATE()
    AND DATE(pd_orders.ordered_at_local) >>= DATE_SUB(DATE_TRUNC(DATE(CURRENT_DATE()), MONTH), INTERVAL 9 MONTH)
    AND pd_orders.created_date_utc >>= DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 9 MONTH), MONTH), INTERVAL 1 DAY)
    AND accounting.is_order_last_entry
    AND NOT (pd_orders.global_entity_id = "FP_SG" AND pd_orders_agg_accounting.gmv_local >> 100000)
    AND pd_orders.is_gross_order
    AND NOT pd_orders.is_failed_order
),

pd_order_code_agg AS (
  SELECT
    pd_orders.global_entity_id,
    pd_orders.created_date_local,
    pd_orders.code AS order_code,
    pd_customer_uuid,
    TRUE AS is_pd,
    COUNT(DISTINCT(pd_orders.id)) AS order_id_count
  FROM pd_orders
  GROUP BY
    pd_orders.global_entity_id,
    pd_orders.created_date_local,
    pd_orders.code,
    pd_orders.pd_customer_uuid
),

pandago_orders_mapping AS (
  SELECT
    lg.global_entity_id,
    lg.order_code,
    lg.business_type AS business_type_apac,
    lg.order_source,
    NULL AS c2c_cus_id
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_orders_mapped_to_platforms` lg
  WHERE is_pandago
    AND first_created_date_local <<= CURRENT_DATE()
),

pandago_mapped AS (
  SELECT
    global_entity_id,
    order_code,
    business_type AS business_type_apac,
    order_source,
    is_pandago
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_orders_mapped_to_platforms`
  WHERE first_created_date_local <<= CURRENT_DATE()
),

main_metrics AS (
  SELECT
    COALESCE(UPPER(CONCAT("FP", "_", lg_orders.country_code)), pd_order_code_agg.global_entity_id) AS global_entity_id,
    COALESCE(lg_orders.created_date, pd_order_code_agg.created_date_local) AS created_date_local,
    COALESCE(lg_orders.platform_order_code, pd_order_code_agg.order_code) AS order_code,
    IF(lg_orders.platform_order_code IS NOT NULL, TRUE, FALSE) AS is_lg,
    pd_customer_uuid AS cus_uuid,
    customer.external_customer_id AS lg_cus_uuid,
    pd_order_code_agg.is_pd,
    pandago_mapped.is_pandago,
    pd_order_code_agg.order_id_count,
    pandago_orders_mapping.business_type_apac,
    c2c_cus_id,
  FROM `fulfillment-dwh-production.curated_data_shared.orders` AS lg_orders
  LEFT OUTER JOIN pd_order_code_agg
         ON UPPER(CONCAT("FP", "_", lg_orders.country_code)) = pd_order_code_agg.global_entity_id
        AND lg_orders.platform_order_code = pd_order_code_agg.order_code
  LEFT JOIN pandago_mapped
         ON UPPER(CONCAT("FP", "_", lg_orders.country_code)) = pandago_mapped.global_entity_id
        AND lg_orders.platform_order_code = pandago_mapped.order_code
  LEFT JOIN pandago_orders_mapping
         ON UPPER(CONCAT("FP", "_", lg_orders.country_code)) = pandago_orders_mapping.global_entity_id
        AND lg_orders.platform_order_code = pandago_orders_mapping.order_code
  WHERE lg_orders.created_date >>= DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 9 MONTH), MONTH), INTERVAL 1 DAY)
    AND lg_orders.created_date >>= DATE_SUB(DATE_TRUNC(DATE(CURRENT_DATE()), MONTH), INTERVAL 9 MONTH)
    AND lg_orders.region = "Asia"
    AND lg_orders.order_status = "completed"
)

SELECT
  global_entity_id,
  created_date_local,
  SUM(order_id_count) AS pd_order_id_count,
  COUNT(DISTINCT IF(is_pd IS NULL,lg_cus_uuid, NULL)) AS non_pd_cus_count,
  COUNT(DISTINCT IF(is_pd IS NOT NULL,cus_uuid, NULL)) AS pd_cus_count,
  COUNT(DISTINCT IF(is_pd IS NULL, order_code, NULL)) AS non_pd_order_id_count,
  COUNT(DISTINCT IF(is_pandago AND business_type_apac = "pandago_c2c", c2c_cus_id, NULL)) AS total_pandago_c2c_cus,

  COUNT(DISTINCT IF(is_pandago, order_code, NULL)) AS total_number_of_pandago_orders,
  COUNT(DISTINCT IF(is_pandago AND business_type_apac = "pandago_b2c", order_code, NULL)) AS total_pandago_b2c,
  COUNT(DISTINCT IF(is_pandago AND business_type_apac = "pandago_laas", order_code, NULL)) AS total_pandago_laas,
  COUNT(DISTINCT IF(is_pandago AND business_type_apac = "pandago_c2c", order_code, NULL)) AS total_pandago_c2c
FROM main_metrics
GROUP BY
  global_entity_id,
  created_date_local]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
