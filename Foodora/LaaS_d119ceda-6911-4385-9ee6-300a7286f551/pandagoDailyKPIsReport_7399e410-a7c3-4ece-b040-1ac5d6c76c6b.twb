    <worksheet name='Daily Cancel Rate latest month'>
      <table>
        <view>
          <datasources>
            <datasource caption='pandago_source' name='federated.1dbdutk0n3t1cm1h2bsd7125m3jw' />
          </datasources>
          <datasource-dependencies datasource='federated.1dbdutk0n3t1cm1h2bsd7125m3jw'>
            <column caption='cancel_rate' datatype='real' default-format='p0.0%' name='[Calculation_103864282122723328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([cancelled_orders]))&#10;/&#10;SUM(ZN([cancelled_orders]) + ZN([completed_orders]))' />
            </column>
            <column caption='is_API' datatype='string' datatype-customized='true' name='[Calculation_103864282125012996]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF business_type_apac = &quot;pandago_laas&quot; OR order_source = &quot;api-integration&quot; THEN &quot;API&quot; ELSE &quot;non-API&quot; END' />
            </column>
            <column caption='latest month' datatype='string' name='[Calculation_3077577071563956224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(&apos;Latest Month&apos;)' />
            </column>
            <column caption='latest month filter' datatype='boolean' name='[Calculation_3077577071565484033]' role='dimension' type='nominal'>
