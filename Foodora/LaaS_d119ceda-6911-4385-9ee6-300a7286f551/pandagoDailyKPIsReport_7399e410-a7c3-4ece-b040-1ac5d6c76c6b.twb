    <worksheet name='MTD Cancel Rate Growth'>
      <table>
        <view>
          <datasources>
            <datasource caption='pandago_source' name='federated.1dbdutk0n3t1cm1h2bsd7125m3jw' />
          </datasources>
          <datasource-dependencies datasource='federated.1dbdutk0n3t1cm1h2bsd7125m3jw'>
            <column caption='is_API' datatype='string' datatype-customized='true' name='[Calculation_103864282125012996]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF business_type_apac = &quot;pandago_laas&quot; OR order_source = &quot;api-integration&quot; THEN &quot;API&quot; ELSE &quot;non-API&quot; END' />
            </column>
            <column caption='MoM_cancel_rate_growth' datatype='real' default-format='p0.0%' name='[MoM_c2c_order_count (copy)_103864282134384649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [mtd] = 1 THEN ZN([cancelled_orders]) END) / &#10;SUM(IF [mtd] = 1 THEN ZN([cancelled_orders])+ZN([completed_orders]) END))&#10;/&#10;(SUM(IF [prev_mtd] = 1 THEN ZN([cancelled_orders]) END) / &#10;SUM(IF [prev_mtd] = 1 THEN ZN([cancelled_orders])+ZN([completed_orders]) END))&#10;) - 1' />
            </column>
            <column caption='MoM Header' datatype='string' name='[WoW Header (copy)_499829203878555661]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(&apos;MTD Growth&apos;)' />
