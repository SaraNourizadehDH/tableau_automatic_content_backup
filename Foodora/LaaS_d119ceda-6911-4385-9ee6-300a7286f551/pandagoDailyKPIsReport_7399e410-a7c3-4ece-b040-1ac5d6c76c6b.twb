            <column-instance column='[Calculation_590745643845210114]' derivation='None' name='[none:Calculation_590745643845210114:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_key_account]' derivation='None' name='[none:is_key_account:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_tracked_daily_kpi_pandago_key_account]' derivation='None' name='[none:is_tracked_daily_kpi_pandago_key_account:nk]' pivot='key' type='nominal' />
            <column-instance column='[pandago_key_account]' derivation='None' name='[none:pandago_key_account:nk]' pivot='key' type='nominal' />
            <column caption='Order Source' datatype='string' name='[order_source]' role='dimension' type='nominal' />
            <column caption='Pandago Key Account' datatype='string' name='[pandago_key_account]' role='dimension' type='nominal' />
            <column-instance column='[completed_orders]' derivation='Sum' name='[sum:completed_orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1377045969480953856]' derivation='User' name='[usr:Calculation_1377045969480953856:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1dbdutk0n3t1cm1h2bsd7125m3jw].[none:Calculation_103864282125012996:nk]'>
            <groupfilter function='member' level='[none:Calculation_103864282125012996:nk]' member='&quot;API&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
