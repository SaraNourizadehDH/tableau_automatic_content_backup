            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0s18d8h145hk2p1ejtqp31xcfo7v'>
            <column caption='CPO Eur' datatype='real' default-format='c&quot;€&quot;#,##0.0000;-&quot;€&quot;#,##0.0000' name='[1. CPO Eur (copy)_258394080379297795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([wastage_refund_eur]))/(ZN([Calculation_279997285287071745]))' />
            </column>
            <column caption='CPO Local' datatype='real' default-format='c&quot;$&quot;#,##0.0000;-&quot;$&quot;#,##0.0000' name='[2. CPO Local (copy)_258394080379297794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([wastage_refund_local]))/(ZN([Calculation_279997285287071745]))' />
            </column>
            <column caption='Wastage Refund Eur' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[3. Wastage Refund Eur (copy)_258394080379297797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[wastage_refund_eur]' />
            </column>
            <column caption='Wastage Refund Local' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[4. Wastage Refund Local (copy)_258394080379297798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[wastage_refund_local]' />
            </column>
            <column caption='Subscription Type' datatype='string' name='[Calculation_258394080381341704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_subscriber_order] = TRUE THEN &apos;Pro Order&apos;&#10;ELSEIF [is_subscriber_order] = FALSE THEN &apos;Non-Pro Order&apos;&#10;END' />
            </column>
            <column caption='CPO Orders' datatype='integer' name='[Calculation_279997285287071745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN IN (&apos;Company Name&apos;,&apos;Country&apos;,&apos;Vertical Type&apos;, &apos;Subscription Type&apos;, &apos;Expedition Type&apos;, &apos;Delivery Type&apos;, &apos;Payment Type&apos;, &apos;New Customer&apos;) THEN &#10;SUM({ EXCLUDE [cancellation_source],[decline_reason_code],[wastage_refund_gl],[wastage_refund_source],[wastage_refund_type],[ccr1],[ccr2],[ccr3],[refund_type]: &#10;SUM( { FIXED &#10;&#9;&#9;[granularity],&#10;        [report_date],&#10;        [company_name],&#10;        [country_name],&#10;        [vertical_type],&#10;        [Calculation_258394080381341704],        &#10;        [delivery_type],        &#10;        [payment_type],&#10;        [is_new_customer]&#10;:SUM([cpo_orders])})})&#10;&#10;ELSE &#10;&#10;SUM({ EXCLUDE [cancellation_source],[decline_reason_code],[wastage_refund_gl],[wastage_refund_source],[wastage_refund_type],[refund_type],[ccr1],[ccr2],[ccr3],[Calculation_808396155620605955]: &#10;SUM( { FIXED &#10;&#9;&#9;[granularity],&#10;        [report_date],&#10;        [company_name],&#10;        [country_name],&#10;        [granularity],&#10;        [vertical_type],&#10;        [Calculation_258394080381341704],        &#10;        [delivery_type],        &#10;        [payment_type],&#10;        [is_new_customer]&#10;:SUM([cpo_orders])})})&#10;END' />
            </column>
            <column caption='RANK([CPO Eur])' datatype='integer' name='[Calculation_353673368681693184]' role='measure' type='quantitative' user:unnamed='CPO Report'>
              <calculation class='tableau' formula='RANK([1. CPO Eur (copy)_258394080379297795])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Dimension ' datatype='string' name='[Calculation_808396155620605955]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#10;WHEN &apos;Company Name&apos; THEN [company_name]&#10;WHEN &quot;Country&quot; THEN [country_name]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Decline Reason Source&apos; THEN [cancellation_source]&#10;WHEN &apos;Decline Reason&apos; THEN [decline_reason_code]&#10;WHEN &apos;Subscription Type&apos; THEN [Calculation_258394080381341704]&#10;WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;WHEN &apos;Payment Type&apos; THEN [payment_type]&#10;WHEN &quot;New Customer&quot; THEN [is_new_customer]&#10;WHEN &quot;Wastage Refund GL&quot; THEN [wastage_refund_gl]&#10;WHEN &quot;Wastage Refund Source&quot; THEN [wastage_refund_source]&#10;WHEN &quot;Wastage Refund Type&quot; THEN [wastage_refund_type]&#10;END' />
