        <column caption='Wastage Refund Currency' datatype='string' name='[CPO Currency  (copy)_423408750549340166]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
          <calculation class='tableau' formula='&quot;Euro&quot;' />
