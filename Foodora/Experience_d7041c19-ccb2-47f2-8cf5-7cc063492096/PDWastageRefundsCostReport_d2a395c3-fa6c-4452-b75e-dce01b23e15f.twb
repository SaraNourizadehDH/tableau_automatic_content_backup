            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='14'>&gt; In &lt;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='14'>[Parameters].[Parameter 5]</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='14'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='service_operations__opex_wastage_refund_report' name='federated.0s18d8h145hk2p1ejtqp31xcfo7v' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension Selection.' datatype='string' name='[Dimension Selection (copy)_279997285444997135]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vertical Type&quot;'>
              <calculation class='tableau' formula='&quot;Vertical Type&quot;' />
            </column>
            <column caption='CPO Currency ' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0s18d8h145hk2p1ejtqp31xcfo7v'>
            <column caption='Wastage Refund Eur' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[3. Wastage Refund Eur (copy)_258394080379297797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[wastage_refund_eur]' />
            </column>
            <column caption='Wastage Refund Local' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[4. Wastage Refund Local (copy)_258394080379297798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[wastage_refund_local]' />
            </column>
            <column caption='Subscription Type' datatype='string' name='[Calculation_258394080381341704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_subscriber_order] = TRUE THEN &apos;Pro Order&apos;&#10;ELSEIF [is_subscriber_order] = FALSE THEN &apos;Non-Pro Order&apos;&#10;END' />
            </column>
            <column caption='Recoverable Wastage Refund' datatype='real' name='[Calculation_279997285449039894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Euro&quot; THEN [Total FP Wastage (copy)_279997285441908747]&#10;WHEN &quot;Local&quot; THEN [Recoverable Wastage Refund Eur (copy)_279997285447417877]&#10;END' />
            </column>
            <column caption='Wastage Refund Recovery' datatype='real' name='[Calculation_279997285449494552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Euro&quot; THEN [Recoverable Wastage Refund Eur (copy)_279997285443170316]&#10;WHEN &quot;Local&quot; THEN [Wastage Refund Recovery Eur (copy)_279997285447417876]&#10;END' />
            </column>
            <column caption='Wastage Refund Percentage' datatype='real' name='[Calculation_5872201347140055040]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [wastage_refund_source] != &quot;Partial Refunds&quot; AND CONTAINS([wastage_refund_type], &quot;pay as-if successful order&quot;) = FALSE &#10;THEN FLOAT(SPLIT(SPLIT([wastage_refund_type], &apos;(&apos;, 2), &apos;%&apos;, 1))&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Country Name (copy)' datatype='string' name='[Country Name (copy)_3741928399356342273]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country_name]' />
            </column>
            <column caption='Date..' datatype='date' name='[Date (copy)_279997285450555417]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='New Customer.' datatype='string' datatype-customized='true' name='[New Customer (copy)_2846626871832526848]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_new_customer]&#10;WHEN &quot;t&quot; THEN &quot;TRUE&quot;&#10;WHEN &quot;f&quot; THEN &quot;FALSE&quot;&#10;WHEN &quot;true&quot; THEN &quot;TRUE&quot;&#10;WHEN &quot;false&quot; THEN &quot;FALSE&quot;&#10;ELSE [is_new_customer]&#10;END' />
            </column>
            <column caption='Wastage Refund Recovery Eur' datatype='real' name='[Recoverable Wastage Refund Eur (copy)_279997285443170316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [wastage_refund_source] != &quot;Partial Refunds&quot; AND CONTAINS([wastage_refund_type], &quot;pay as-if successful order&quot;) = FALSE THEN  &#10;ZN([gross_food_value_eur])*(1-ZN([Calculation_5872201347140055040])) - ZN([commission_eur]) - ZN([vendor_funded_value_eur]) &#10;END' />
            </column>
            <column caption='Recoverable Wastage Refund Local' datatype='real' name='[Recoverable Wastage Refund Eur (copy)_279997285447417877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [wastage_refund_source] != &quot;Partial Refunds&quot; THEN &#10;ZN([gross_food_value_local])*(1-ZN([Calculation_5872201347140055040])) - ZN([commission_local]) - ZN([vendor_funded_value_local]) &#10;END' />
            </column>
            <column caption='Total FP Refund' datatype='real' name='[Total FP Refund Eur (copy)_279997285451857951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Euro&quot; THEN [Total FP Wastage Eur (copy)_279997285451591709]&#10;WHEN &quot;Local&quot; THEN [Total FP Wastage Local  (copy)_279997285451591710]&#10;END' />
            </column>
            <column caption='Recoverable Wastage Refund Eur' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Total FP Wastage (copy)_279997285441908747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [wastage_refund_source] != &quot;Partial Refunds&quot; THEN &#10;ZN([gross_food_value_eur])*(1-ZN([Calculation_5872201347140055040])) - ZN([commission_eur]) - ZN([vendor_funded_value_eur]) &#10;END' />
            </column>
            <column caption='Total FP Refund Eur' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Total FP Wastage Eur (copy)_279997285451591709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [wastage_refund_gl] = &quot;Refund GL&quot; THEN (ZN([3. Wastage Refund Eur (copy)_258394080379297797])) END' />
            </column>
            <column caption='Total FP Wastage' datatype='real' name='[Total FP Wastage Eur (copy)_279997285452005408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &quot;Euro&quot; THEN [Total FP Wastage Refund Eur (copy)_279997285451075610]&#10;WHEN &quot;Local&quot; THEN [Total FP Wastage Refund Local (copy)_279997285451075611]&#10;END' />
            </column>
            <column caption='Total FP Refund Local' datatype='real' name='[Total FP Wastage Local  (copy)_279997285451591710]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [wastage_refund_gl] = &quot;Refund GL&quot; THEN (ZN([4. Wastage Refund Local (copy)_258394080379297798])) END' />
            </column>
            <column caption='Total FP Wastage Eur' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Total FP Wastage Refund Eur (copy)_279997285451075610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [wastage_refund_gl] = &quot;Wastage GL&quot; THEN (ZN([3. Wastage Refund Eur (copy)_258394080379297797])) END' />
