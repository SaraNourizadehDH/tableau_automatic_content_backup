ype],[is_new_customer],[Calculation_808396155620605955 1]:&#10;          &#9;&#9;SUM([cpo_orders])&#10;          })&#10;    })&#10;    &#10;    &#10;ELSEIF &#10;    [Parameters].[Dimension Selection (A) (copy)_258394080383139852] IN (&apos;Company&apos;,&apos;Country&apos;,&apos;Vertical Type&apos;, &apos;Subscription Type&apos;, &apos;Expedition Type&apos;, &apos;Delivery Type&apos;, &apos;Payment Type&apos;) AND NOT&#10;    [Parameters].[Dimension Selection (copy)_258394080382984203] IN (&apos;Company&apos;,&apos;Country&apos;,&apos;Vertical Type&apos;, &apos;Subscription Type&apos;, &apos;Expedition Type&apos;, &apos;Delivery Type&apos;, &apos;Payment Type&apos;)&#10;THEN &#10;    SUM({EXCLUDE [refund_type],[cancellation_source],[decline_reason_code],[ccr1],[ccr2],[ccr3],[wastage_refund_gl],[wastage_refund_source],[wastage_refund_type],[Calculation_808396155620605955 1]: &#10;          SUM({FIXED [granularity],[report_date],[company_name],[country_name],[vertical_type],[Calculation_258394080381341704],[delivery_type],[payment_type],[is_new_customer],[Dimension  (copy)_2004946285200105475]:&#10;          &#9;&#9;SUM([cpo_orders])&#10;          })&#10;    })  &#10;    &#10;&#10;ELSE&#10;    SUM({EXCLUDE [refund_type],[cancellation_source],[decline_reason_code],[ccr1],[ccr2],[ccr3],[wastage_refund_gl],[wastage_refund_source],[wastage_refund_type]: &#10;          SUM({FIXED [granularity],[report_date],[company_name],[country_name],[vertical_type],[Calculation_258394080381341704],[delivery_type],[payment_type],[is_new_customer]:&#10;          &#9;&#9;SUM([cpo_orders])&#10;          })&#10;    }) &#10;END' />
