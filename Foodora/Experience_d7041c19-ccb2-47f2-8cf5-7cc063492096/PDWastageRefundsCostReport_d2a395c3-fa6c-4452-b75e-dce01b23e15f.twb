      </column>
      <column caption='CPO % TOT' datatype='string' name='[Calculation_825706896802533378]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF((sum (IF ([Calculation_825706896803622916] = [Calculation_825706896803508227]) then [3. Wastage Refund Eur (copy)_258394080379297797] end) / sum (IF ([Calculation_825706896803622916] = [Calculation_825706896803508227]) then [cpo_orders] end)) /&#10;(sum (IF ([Date (i - 1) (copy)_825706896804491269] = [Calculation_825706896803508227]) then [3. Wastage Refund Eur (copy)_258394080379297797] end) / sum (IF ([Date (i - 1) (copy)_825706896804491269] = [Calculation_825706896803508227]) then [cpo_orders] end))&#10;-1) &gt;= 0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END &#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(((sum (IF ([Calculation_825706896803622916] = [Calculation_825706896803508227]) then [3. Wastage Refund Eur (copy)_258394080379297797] end) / sum (IF ([Calculation_825706896803622916] = [Calculation_825706896803508227]) then [cpo_orders] end)) /&#10;(sum (IF ([Date (i - 1) (copy)_825706896804491269] = [Calculation_825706896803508227]) then [3. Wastage Refund Eur (copy)_258394080379297797] end) / sum (IF ([Date (i - 1) (copy)_825706896804491269] = [Calculation_825706896803508227]) then [cpo_orders] end))&#10;-1)*100,0)&#10;)&#10;&#10;+ STR(&apos;%&apos;)' />
      </column>
      <column caption='Date Number' datatype='integer' name='[Calculation_825706896803508227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [granularity]&#10;    when &apos;Weekly&apos; then ISOWEEK([report_date])&#10;    when &apos;Monthly&apos; then month([report_date])&#10;end' />
      </column>
      <column caption='Date (i - 1)' datatype='integer' name='[Calculation_825706896803622916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [granularity]&#10;    when &apos;Weekly&apos; then ISOWEEK(DATEADD(&apos;week&apos;,-1, TODAY()))&#10;    when &apos;Monthly&apos; then MONTH(DATEADD(&apos;month&apos;,-1, TODAY()))&#10;end' />
      </column>
      <column caption='CPO % TOT colour' datatype='string' name='[Calculation_825706896812761096]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF((sum (IF ([Calculation_825706896803622916] = [Calculation_825706896803508227]) then ([3. Wastage Refund Eur (copy)_258394080379297797]) end) / sum (IF ([Calculation_825706896803622916] = [Calculation_825706896803508227]) then [cpo_orders] end)) /&#10;(sum (IF ([Date (i - 1) (copy)_825706896804491269] = [Calculation_825706896803508227]) then ([3. Wastage Refund Eur (copy)_258394080379297797]) end) / sum (IF ([Date (i - 1) (copy)_825706896804491269] = [Calculation_825706896803508227]) then [cpo_orders] end))&#10;-1) &gt;= 0 THEN &apos;GREY&apos; ELSE &apos;GOLD&apos; END' />
      </column>
      <column caption='KPI ' datatype='real' name='[Calculation_825706896861937675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &quot;CPO (€)&quot; THEN [1. CPO Eur (copy)_258394080379297795]&#10;WHEN &quot;CPO ($)&quot; THEN [2. CPO Local (copy)_258394080379297794]&#10;WHEN &quot;Wastage Refund Amount (€)&quot; THEN SUM([3. Wastage Refund Eur (copy)_258394080379297797])&#10;WHEN &quot;Wastage Refund Amount ($)&quot; THEN SUM([4. Wastage Refund Local (copy)_258394080379297798])&#10;WHEN &quot;Wastage Refund Orders&quot; THEN SUM([5. Wastage Refund Orders (copy)_258394080379297799])&#10;END' />
      </column>
