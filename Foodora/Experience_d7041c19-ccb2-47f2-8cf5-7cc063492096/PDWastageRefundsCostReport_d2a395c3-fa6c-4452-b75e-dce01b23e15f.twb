            </column>
            <column caption='CPO Currency..' datatype='real' name='[CPO Currency (copy)_464644834723016706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[CPO Currency  (copy)_464644834722930689]&#10;WHEN &quot;Euro&quot; then ([CPO Eur (copy)_2973642395156594689])&#10;When &quot;Local&quot; then ([CPO Local (copy)_2973642395156697090])&#10;end' />
