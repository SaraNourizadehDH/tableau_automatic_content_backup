      <column caption='Wastage Refund Eur % TOT' datatype='string' name='[CPO % TOT (copy)_825706896872534028]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF((sum (IF ([Calculation_825706896803622916] = [Calculation_825706896803508227]) then [3. Wastage Refund Eur (copy)_258394080379297797] end)) /&#10;(sum (IF ([Date (i - 1) (copy)_825706896804491269] = [Calculation_825706896803508227]) then [3. Wastage Refund Eur (copy)_258394080379297797] end))&#10;-1) &gt;= 0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END &#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(((sum (IF ([Calculation_825706896803622916] = [Calculation_825706896803508227]) then [3. Wastage Refund Eur (copy)_258394080379297797] end)) /&#10;(sum (IF ([Date (i - 1) (copy)_825706896804491269] = [Calculation_825706896803508227]) then [3. Wastage Refund Eur (copy)_258394080379297797] end) )&#10;-1)*100,0)&#10;)&#10;&#10;+ STR(&apos;%&apos;)' />
      </column>
      <column caption='Wastage Refund Eur % TOT colour' datatype='string' name='[CPO % TOT colour (copy)_825706896872534029]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF((sum (IF ([Calculation_825706896803622916] = [Calculation_825706896803508227]) then ([3. Wastage Refund Eur (copy)_258394080379297797]) end)) /&#10;(sum (IF ([Date (i - 1) (copy)_825706896804491269] = [Calculation_825706896803508227]) then ([3. Wastage Refund Eur (copy)_258394080379297797]) end))&#10;-1) &gt;= 0 THEN &apos;GREY&apos; ELSE &apos;GOLD&apos; END' />
      </column>
