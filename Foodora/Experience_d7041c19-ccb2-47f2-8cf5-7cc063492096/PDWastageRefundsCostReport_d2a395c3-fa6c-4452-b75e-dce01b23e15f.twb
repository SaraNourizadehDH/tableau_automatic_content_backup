          <datasource-dependencies datasource='federated.0s18d8h145hk2p1ejtqp31xcfo7v'>
            <column caption='Wastage Refund Orders' datatype='integer' name='[5. Wastage Refund Orders (copy)_258394080379297799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[wastage_refund_orders]' />
            </column>
            <column caption='Subscription Type' datatype='string' name='[Calculation_258394080381341704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_subscriber_order] = TRUE THEN &apos;Pro Order&apos;&#10;ELSEIF [is_subscriber_order] = FALSE THEN &apos;Non-Pro Order&apos;&#10;END' />
            </column>
            <column caption='Relevent Time Period' datatype='boolean' name='[Calculation_825706896799268864]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [granularity]&#10; when &apos;Weekly&apos; then IIF(DATEADD(&apos;iso-week&apos;, -7, DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) &lt; DATETRUNC(&apos;week&apos;,[report_date],&apos;monday&apos;) AND ISOWEEK(TODAY()) != ISOWEEK([report_date]), true, false)&#10; when &apos;Monthly&apos; then IIF(DATEADD(&apos;month&apos;, -6, TODAY()) &lt; [report_date] AND DATETRUNC(&apos;month&apos;, TODAY()) != DATETRUNC(&apos;month&apos;, [report_date]), true, false)&#10;end' />
            </column>
            <column caption='ToT' datatype='string' name='[Calculation_825706896801959937]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [granularity]&#10; when &apos;Weekly&apos; then &apos;WoW% Δ&apos;&#10; when &apos;Monthly&apos; then &apos;MoM% Δ&apos;&#10;end' />
            </column>
            <column caption='Date Number' datatype='integer' name='[Calculation_825706896803508227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [granularity]&#10;    when &apos;Weekly&apos; then ISOWEEK([report_date])&#10;    when &apos;Monthly&apos; then month([report_date])&#10;end' />
            </column>
            <column caption='Date (i - 1)' datatype='integer' name='[Calculation_825706896803622916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [granularity]&#10;    when &apos;Weekly&apos; then ISOWEEK(DATEADD(&apos;week&apos;,-1, TODAY()))&#10;    when &apos;Monthly&apos; then MONTH(DATEADD(&apos;month&apos;,-1, TODAY()))&#10;end' />
            </column>
            <column caption='Country Name (copy)' datatype='string' name='[Country Name (copy)_3741928399356342273]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country_name]' />
            </column>
            <column caption='Date (i - 2)' datatype='integer' name='[Date (i - 1) (copy)_825706896804491269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [granularity]&#10;    when &apos;Weekly&apos; then ISOWEEK(DATEADD(&apos;week&apos;,-2, TODAY()))&#10;    when &apos;Monthly&apos; then MONTH(DATEADD(&apos;month&apos;,-2, TODAY()))&#10;end' />
            </column>
            <column caption='New Customer.' datatype='string' datatype-customized='true' name='[New Customer (copy)_2846626871832526848]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_new_customer]&#10;WHEN &quot;t&quot; THEN &quot;TRUE&quot;&#10;WHEN &quot;f&quot; THEN &quot;FALSE&quot;&#10;WHEN &quot;true&quot; THEN &quot;TRUE&quot;&#10;WHEN &quot;false&quot; THEN &quot;FALSE&quot;&#10;ELSE [is_new_customer]&#10;END' />
            </column>
            <column caption='Wastage Refund Order % TOT' datatype='string' name='[Wastage Refund Eur % TOT (copy)_825706896876617742]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((sum (IF ([Calculation_825706896803622916] = [Calculation_825706896803508227]) then [5. Wastage Refund Orders (copy)_258394080379297799] end)) /&#10;(sum (IF ([Date (i - 1) (copy)_825706896804491269] = [Calculation_825706896803508227]) then [5. Wastage Refund Orders (copy)_258394080379297799] end))&#10;-1) &gt;= 0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END &#10;&#10;+ &apos; &apos;&#10;&#10;+ STR(&#10;ROUND(((sum (IF ([Calculation_825706896803622916] = [Calculation_825706896803508227]) then [5. Wastage Refund Orders (copy)_258394080379297799] end)) /&#10;(sum (IF ([Date (i - 1) (copy)_825706896804491269] = [Calculation_825706896803508227]) then [5. Wastage Refund Orders (copy)_258394080379297799] end) )&#10;-1)*100,0)&#10;)&#10;&#10;+ STR(&apos;%&apos;)' />
            </column>
            <column caption='Wastage Refund Order % TOT colour' datatype='string' name='[Wastage Refund Eur % TOT colour (copy)_825706896876617743]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF((sum (IF ([Calculation_825706896803622916] = [Calculation_825706896803508227]) then ([5. Wastage Refund Orders (copy)_258394080379297799]) end)) /&#10;(sum (IF ([Date (i - 1) (copy)_825706896804491269] = [Calculation_825706896803508227]) then ([5. Wastage Refund Orders (copy)_258394080379297799]) end))&#10;-1) &gt;= 0 THEN &apos;GREY&apos; ELSE &apos;GOLD&apos; END' />
            </column>
