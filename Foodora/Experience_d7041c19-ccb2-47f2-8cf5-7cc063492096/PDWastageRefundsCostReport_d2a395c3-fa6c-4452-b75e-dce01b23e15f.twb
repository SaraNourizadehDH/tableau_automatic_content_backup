      <column caption='Dimension (A)' datatype='string' name='[Calculation_808396155620605955 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension Selection (copy)_258394080382984203]&#10;WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#10;WHEN &apos;Company Name&apos; THEN [company_name]&#10;WHEN &quot;Country&quot; THEN [country_name]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Decline Reason Source&apos; THEN [cancellation_source]&#10;WHEN &apos;Decline Reason&apos; THEN [decline_reason_code]&#10;WHEN &apos;Subscription Type&apos; THEN [Calculation_258394080381341704]&#10;WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;WHEN &apos;Payment Type&apos; THEN [payment_type]&#10;WHEN &quot;New Customer&quot; THEN [is_new_customer]&#10;WHEN &quot;Wastage Refund GL&quot; THEN [wastage_refund_gl]&#10;WHEN &quot;Wastage Refund Source&quot; THEN [wastage_refund_source]&#10;WHEN &quot;Wastage Refund Type&quot; THEN [wastage_refund_type]&#10;WHEN &quot;CCR1&quot; THEN [ccr1]&#10;WHEN &quot;CCR2&quot; THEN [ccr2]&#10;WHEN &quot;CCR3&quot; THEN [ccr3]&#10;END' />
      </column>
      <column caption='Dimension ' datatype='string' name='[Calculation_808396155620605955]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#10;WHEN &apos;Company Name&apos; THEN [company_name]&#10;WHEN &quot;Country&quot; THEN [country_name]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Decline Reason Source&apos; THEN [cancellation_source]&#10;WHEN &apos;Decline Reason&apos; THEN [decline_reason_code]&#10;WHEN &apos;Subscription Type&apos; THEN [Calculation_258394080381341704]&#10;WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;WHEN &apos;Payment Type&apos; THEN [payment_type]&#10;WHEN &quot;New Customer&quot; THEN [is_new_customer]&#10;WHEN &quot;Wastage Refund GL&quot; THEN [wastage_refund_gl]&#10;WHEN &quot;Wastage Refund Source&quot; THEN [wastage_refund_source]&#10;WHEN &quot;Wastage Refund Type&quot; THEN [wastage_refund_type]&#10;END' />
      </column>
      <column caption='Relevent Time Period' datatype='boolean' name='[Calculation_825706896799268864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [granularity]&#10; when &apos;Weekly&apos; then IIF(DATEADD(&apos;iso-week&apos;, -7, DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;)) &lt; DATETRUNC(&apos;week&apos;,[report_date],&apos;monday&apos;) AND ISOWEEK(TODAY()) != ISOWEEK([report_date]), true, false)&#10; when &apos;Monthly&apos; then IIF(DATEADD(&apos;month&apos;, -6, TODAY()) &lt; [report_date] AND DATETRUNC(&apos;month&apos;, TODAY()) != DATETRUNC(&apos;month&apos;, [report_date]), true, false)&#10;end' />
      </column>
      <column caption='ToT' datatype='string' name='[Calculation_825706896801959937]' role='dimension' type='nominal'>
