            <column caption='CPO Eur..' datatype='real' default-format='c&quot;€&quot;#,##0.0000;-&quot;€&quot;#,##0.0000' name='[CPO Eur (copy)_2973642395156594689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([wastage_refund_eur]))/(ZN([CPO Orders (copy)_2973642395156099072]))' />
            </column>
            <column caption='CPO Local..' datatype='real' default-format='c&quot;$&quot;#,##0.0000;-&quot;$&quot;#,##0.0000' name='[CPO Local (copy)_2973642395156697090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([wastage_refund_local]))/(ZN([CPO Orders (copy)_2973642395156099072]))' />
            </column>
            <column caption='CPO Orders..' datatype='integer' name='[CPO Orders (copy)_2973642395156099072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimension Selection (copy)_279997285468549153]&#10;WHEN IN (&apos;Country&apos;,&apos;Vertical Type&apos;, &apos;Subscription Type&apos;, &apos;Expedition Type&apos;, &apos;Delivery Type&apos;, &apos;Payment Type&apos;, &apos;New Customer&apos;) THEN &#10;SUM({ EXCLUDE [cancellation_source],[decline_reason_code],[wastage_refund_gl],[wastage_refund_source],[wastage_refund_type]: &#10;SUM( { FIXED &#10;        [report_date],&#10;        [granularity],&#10;        [country_name],&#10;        [vertical_type],&#10;        [Calculation_258394080381341704],        &#10;        [delivery_type],        &#10;        [payment_type],&#10;        [is_new_customer]&#10;:SUM([cpo_orders])})})&#10;&#10;ELSE &#10;&#10;SUM({ EXCLUDE [cancellation_source],[decline_reason_code],[wastage_refund_gl],[wastage_refund_source],[wastage_refund_type],[Dimension  (copy)_279997285468672034]: &#10;SUM( { FIXED &#10;&#9;&#9;[report_date],&#10;        [granularity],&#10;        [country_name],&#10;        [vertical_type],&#10;        [Calculation_258394080381341704],        &#10;        [delivery_type],        &#10;        [payment_type],&#10;        [is_new_customer]&#10;:SUM([cpo_orders])})})&#10;END' />
            </column>
            <column caption='Subscription Type' datatype='string' name='[Calculation_258394080381341704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_subscriber_order] = TRUE THEN &apos;Pro Order&apos;&#10;ELSEIF [is_subscriber_order] = FALSE THEN &apos;Non-Pro Order&apos;&#10;END' />
            </column>
            <column caption='Country Name (copy)' datatype='string' name='[Country Name (copy)_3741928399356342273]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country_name]' />
            </column>
            <column caption='Dimension..' datatype='string' name='[Dimension  (copy)_279997285468672034]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimension Selection (copy)_279997285468549153]&#10;WHEN &quot;Wastage Refund GL&quot; THEN [wastage_refund_gl]&#10;WHEN &quot;Wastage Refund Source&quot; THEN [wastage_refund_source]&#10;WHEN &quot;Wastage Refund Type&quot; THEN [wastage_refund_type]&#10;END' />
