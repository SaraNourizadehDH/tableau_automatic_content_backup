        <calculation class='tableau' formula='CASE [Parameters].[CPO Currency  (copy)_423408750549340166]&#10;WHEN &quot;Euro&quot; then ([3. Wastage Refund Eur (copy)_258394080379297797])&#10;When &quot;Local&quot; then ([4. Wastage Refund Local (copy)_258394080379297798])&#10;end' />
