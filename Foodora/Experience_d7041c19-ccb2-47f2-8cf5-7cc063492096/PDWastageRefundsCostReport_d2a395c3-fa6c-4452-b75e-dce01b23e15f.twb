      </column>
      <column caption='Wastage Refund Percentage' datatype='real' name='[Calculation_5872201347140055040]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [wastage_refund_source] != &quot;Partial Refunds&quot; AND CONTAINS([wastage_refund_type], &quot;pay as-if successful order&quot;) = FALSE &#10;THEN FLOAT(SPLIT(SPLIT([wastage_refund_type], &apos;(&apos;, 2), &apos;%&apos;, 1))&#10;ELSE 0&#10;END' />
