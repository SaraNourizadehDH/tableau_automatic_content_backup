              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
            <column caption='Dimension Selection..' datatype='string' name='[Dimension Selection (copy)_279997285468549153]' param-domain-type='list' role='measure' type='nominal' value='&quot;Wastage Refund Source&quot;'>
