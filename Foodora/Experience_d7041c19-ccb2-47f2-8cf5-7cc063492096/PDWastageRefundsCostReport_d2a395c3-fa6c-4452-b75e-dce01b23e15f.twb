      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#edc948' fontsize='12'><![CDATA[<[federated.0s18d8h145hk2p1ejtqp31xcfo7v].[none:granularity:nk]>]]></run>
