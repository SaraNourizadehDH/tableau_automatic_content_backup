            </column>
            <column caption='Dimension (B)' datatype='string' name='[Dimension  (copy)_2004946285200105475]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimension Selection (A) (copy)_258394080383139852]&#10;WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#10;WHEN &apos;Company Name&apos; THEN [company_name]&#10;WHEN &quot;Country&quot; THEN [country_name]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Decline Reason Source&apos; THEN [cancellation_source]&#10;WHEN &apos;Decline Reason&apos; THEN [decline_reason_code]&#10;WHEN &apos;Subscription Type&apos; THEN [Calculation_258394080381341704]&#10;WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;WHEN &apos;Payment Type&apos; THEN [payment_type]&#10;WHEN &quot;New Customer&quot; THEN [is_new_customer]&#10;WHEN &quot;Wastage Refund GL&quot; THEN [wastage_refund_gl]&#10;WHEN &quot;Wastage Refund Source&quot; THEN [wastage_refund_source]&#10;WHEN &quot;Wastage Refund Type&quot; THEN [wastage_refund_type]&#10;WHEN &quot;CCR1&quot; THEN [ccr1]&#10;WHEN &quot;CCR2&quot; THEN [ccr2]&#10;WHEN &quot;CCR3&quot; THEN [ccr3]&#10;END' />
            </column>
            <column caption='New Customer.' datatype='string' datatype-customized='true' name='[New Customer (copy)_2846626871832526848]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_new_customer]&#10;WHEN &quot;t&quot; THEN &quot;TRUE&quot;&#10;WHEN &quot;f&quot; THEN &quot;FALSE&quot;&#10;WHEN &quot;true&quot; THEN &quot;TRUE&quot;&#10;WHEN &quot;false&quot; THEN &quot;FALSE&quot;&#10;ELSE [is_new_customer]&#10;END' />
            </column>
