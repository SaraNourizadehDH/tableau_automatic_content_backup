            </column>
            <column caption='Partial Refund Automation Chart Dimension Selection' datatype='string' name='[Partial Refund Automation Chart Dimension Selection (copy)_2711518884719013984]' param-domain-type='list' role='measure' type='nominal' value='&quot;Company Name&quot;'>
              <calculation class='tableau' formula='&quot;Company Name&quot;' />
            </column>
            <column caption='Reactive Compensation Automation Chart Dimension Selection' datatype='string' name='[Partial Refund Automation Chart Dimension Selection (copy)_2711518884794339443]' param-domain-type='list' role='measure' type='nominal' value='&quot;Company Name&quot;'>
