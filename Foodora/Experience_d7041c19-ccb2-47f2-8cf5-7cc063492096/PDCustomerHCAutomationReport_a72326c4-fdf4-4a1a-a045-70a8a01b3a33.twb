              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Automation Rate&quot; THEN [01. Automation Rate (copy)_379780178807218177]&#10;WHEN &quot;Automation Recontact Rate&quot; THEN [02. Automation Recontact Rate (copy)_379780178808807429]&#10;WHEN &quot;Incident Cost Savings (EUR)&quot; THEN [Calculation_6758847568146268161]&#10;WHEN &quot;7-Day Gross Reorder Rate&quot; THEN [Calculation_2711518880905695244]&#10;WHEN &quot;7-Day Gross Reorder Rate - Successful Automation without Recontact&quot; THEN [04. 7-Day Gross Reorder Rate (copy)_6371960219717562370]&#10;WHEN &quot;7-Day Gross Reorder Rate - Successful Automation with Recontact&quot; THEN [04. 7-Day Gross Reorder Rate - Successful without Recontact (copy)_6371960219717881859]&#10;WHEN &quot;7-Day Gross Reorder Rate - Failed Automation without Recontact&quot; THEN [04. 7-Day Gross Reorder Rate - Successful without Recontact (copy)_6371960219718004740]&#10;WHEN &quot;7-Day Gross Reorder Rate - Failed Automation with Recontact&quot; THEN [04. 7-Day Gross Reorder Rate - Failed without Recontact (copy)_6371960219718197253]&#10;WHEN &quot;30-Day Gross Reorder Rate&quot; THEN [3. 7 Days Gross Reorder Rate (copy)_2711518880905945101]&#10;WHEN &quot;30-Day Gross Reorder Rate - Successful Automation without Recontact&quot; THEN [04a. 7-Day Gross Reorder Rate - Successful without Recontact (copy)_6371960219718918151]&#10;WHEN &quot;30-Day Gross Reorder Rate - Successful Automation with Recontact&quot; THEN [04b. 7-Day Gross Reorder Rate - Successful with Recontact (copy)_6371960219719110664]&#10;WHEN &quot;30-Day Gross Reorder Rate - Failed Automation without Recontact&quot; THEN [04c. 7-Day Gross Reorder Rate - Failed without Recontact (copy)_6371960219720286217]&#10;WHEN &quot;30-Day Gross Reorder Rate - Failed Automation with Recontact&quot; THEN [04d. 7-Day Gross Reorder Rate - Failed with Recontact (copy)_6371960219720437770]&#10;WHEN &quot;Total Automation Event (Successful + Failed)&quot; THEN [Calculation_2711518880905564171]&#10;WHEN &quot;Successful Automation without Recontact Event Count&quot; THEN [Calculation_2711518880891015173]&#10;WHEN &quot;Successful Automation with Recontact Event Count&quot; THEN [Automation Rate Numerator (copy)_2711518880909455375]&#10;WHEN &quot;Failed Automation without Recontact Event Count&quot; THEN [06. Successful Automation without Recontact Event Count (copy)_2711518881235939367]&#10;WHEN &quot;Failed Automation with Recontact Event Count&quot; THEN [08. Failed Automation without Recontact Event Count (copy)_2711518881236402216]&#10;WHEN &quot;Automation Failed Rate&quot; THEN [07. Automation Failed Rate (copy)_379780178807328770]&#10;END' />
            </column>
