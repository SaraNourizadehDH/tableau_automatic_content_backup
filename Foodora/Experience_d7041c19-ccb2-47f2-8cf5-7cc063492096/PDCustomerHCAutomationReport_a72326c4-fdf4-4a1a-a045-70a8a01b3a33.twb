              <calculation class='tableau' formula='SUM(IF[is_gross_reordered_in_7days] = &quot;TRUE&quot; AND [group_type] = &quot;failed_with_contact&quot; THEN [event_count] END)/[08. Failed Automation without Recontact Event Count (copy)_2711518881236402216]' />
