              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Automation Rate&quot; THEN [Rank - 01. Automation Rate (copy)_379780178808266755]&#10;WHEN &quot;Automation Recontact Rate&quot; THEN [Rank - 02. Automation Recontact Rate (copy)_379780178808983558]&#10;WHEN &quot;Incident Cost Savings (EUR)&quot; THEN [Rank - 02. Automation Recontact Rate (copy)_2711518881268891697]&#10;WHEN &quot;7-Day Gross Reorder Rate&quot; THEN [Rank - 03. Incident Cost Savings (EUR) (copy)_2711518881269112882]&#10;WHEN &quot;7-Day Gross Reorder Rate - Successful Automation without Recontact&quot; THEN [Rank - 04. 7-Day Gross Reorder Rate (copy)_6371960219732090891]&#10;WHEN &quot;7-Day Gross Reorder Rate - Successful Automation with Recontact&quot; THEN [Rank - 04a. 7-Day Gross Reorder Rate - Successful Automation without Recontact (copy)_6371960219732631564]&#10;WHEN &quot;7-Day Gross Reorder Rate - Failed Automation without Recontact&quot; THEN [Rank - 04b. 7-Day Gross Reorder Rate - Successful Automation with Recontact (copy)_6371960219733020687]&#10;WHEN &quot;7-Day Gross Reorder Rate - Failed Automation with Recontact&quot; THEN [Rank - 04c. 7-Day Gross Reorder Rate - Failed Automation without Recontact (copy)_6371960219733278736]&#10;WHEN &quot;30-Day Gross Reorder Rate&quot; THEN [Rank - 04. 7-Day Gross Reorder Rate (copy)_2711518881269248051]&#10;WHEN &quot;30-Day Gross Reorder Rate - Successful Automation without Recontact&quot; THEN [Rank - 04a. 7-Day Gross Reorder Rate - Successful Automation without Recontact (copy)_6371960219732779021]&#10;WHEN &quot;30-Day Gross Reorder Rate - Successful Automation with Recontact&quot; THEN [Rank - 04b. 7-Day Gross Reorder Rate - Successful Automation with Recontact (copy)_6371960219732905998]&#10;WHEN &quot;30-Day Gross Reorder Rate - Failed Automation without Recontact&quot; THEN [Rank - 04c. 7-Day Gross Reorder Rate - Failed Automation without Recontact (copy)_6371960219733942289]&#10;WHEN &quot