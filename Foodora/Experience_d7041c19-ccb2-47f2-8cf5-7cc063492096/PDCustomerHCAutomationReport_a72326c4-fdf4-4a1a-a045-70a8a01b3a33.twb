              <calculation class='tableau' formula='CASE [Parameters].[Is Gross Reordered In 30Days Parameter]&#10;WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#10;WHEN &quot;Company Name&quot; THEN [company_name]&#10;WHEN &quot;Country Name&quot; THEN [country_name]&#10;WHEN &quot;Vertical Type&quot; THEN [vertical_sub_type]&#10;WHEN &quot;Delivery Type&quot; THEN [delivery_type]&#10;WHEN &quot;Is Subscriber&quot; THEN [is_subscriber_order]&#10;WHEN &quot;Automation Type&quot; THEN [automation_type]&#10;WHEN &quot;Failed Reason&quot; THEN [failed_reason]&#10;WHEN &quot;Time of the Day&quot; THEN [time_of_the_day]&#10;WHEN &quot;Order Status During Event&quot; THEN [order_status_during_event]&#10;WHEN &quot;Final Order Status&quot; THEN [final_order_status]&#10;WHEN &quot;CCR1&quot; THEN [contact_reason_level_1]&#10;WHEN &quot;CCR2&quot; THEN [contact_reason_level_2]&#10;WHEN &quot;CCR3&quot; THEN [contact_reason_level_3]&#10;END' />
