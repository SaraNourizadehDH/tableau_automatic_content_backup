      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='11'>Country Trend: </run>
            <run fontalignment='1' fontcolor='#ffffff' fontsize='11'>&lt;[Parameters].[Parameter 3]&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='service_operations__opex_customer_hc_automation_report' name='federated.1rlpod919hxcqa1aan2v41intm4w' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Partial Refund Automation Metrics' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Refund Value EUR&quot;'>
              <calculation class='tableau' formula='&quot;Refund Value EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rlpod919hxcqa1aan2v41intm4w'>
            <column caption='Partial Refund Successful Automation Event Count' datatype='integer' name='[06. Successful Automation without Recontact Event Count (copy)_2711518884588888154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF&#10;    [automation_type] IN (&quot;partialRefundV2&quot;, &quot;autoPartialRefund&quot;) AND&#10;    [group_type] IN (&quot;successful_without_contact&quot;, &quot;successful_with_contact&quot;)&#10;    THEN [event_count] END)' />
            </column>
            <column caption='Refund CPI Denominator' datatype='integer' name='[Automation Rate Numerator (copy)_2711518880931160086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[automation_type] IN (&quot;partialRefundV2&quot;, &quot;autoPartialRefund&quot;) &#10;        AND [group_type] IN (&quot;successful_with_contact&quot;, &quot;successful_without_contact&quot;)&#10;     THEN [event_count] END)' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_2711518880882978817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;daily&quot; THEN &#10;&#10;STR(DATE([event_date_local]))&#10;ELSE NULL&#10;&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_2711518880883183618]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;monthly&quot; THEN &#10;&#10;IF month([event_date_local]) &lt; 10 THEN STR(YEAR([event_date_local])) + &quot;-0&quot; + STR(MONTH([event_date_local]))&#10;ELSE STR(YEAR([event_date_local])) + &quot;-&quot; + STR(MONTH([event_date_local]))&#10;END&#10;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_2711518880884617219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;weekly&quot; THEN &#10;&#10; IF ISOWEEK([event_date_local]) &lt; 10&#10;   THEN STR(ISOYEAR([event_date_local])) + &quot;-W0&quot; + STR(ISOWEEK([event_date_local]))&#10;   ELSE STR(ISOYEAR([event_date_local])) + &quot;-W&quot; + STR(ISOWEEK([event_date_local]))&#10;   END&#10;  ELSE NULL&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_2711518880885575684]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN [Calculation_2711518880882978817]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_2711518880884617219]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_2711518880883183618]&#10;END' />
            </column>
            <column caption='Refund Value EUR' datatype='real' name='[Calculation_2711518880917340180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[group_type] IN (&quot;successful_with_contact&quot;, &quot;successful_without_contact&quot;) THEN [refund_value_eur] END)' />
            </column>
            <column caption='Refund Cost Per Incident (CPI)' datatype='real' name='[Calculation_2711518880935444503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2711518880917340180]/[Automation Rate Numerator (copy)_2711518880931160086]' />
            </column>
            <column caption='Partial Refund Automation Metrics' datatype='real' name='[Calculation_2711518880936435738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Refund Value EUR&quot; THEN [Calculation_2711518880917340180]&#10;WHEN &quot;Refund Cost Per Incident (CPI)&quot; THEN [Calculation_2711518880935444503]&#10;WHEN &quot;Partial Refund Automation Successful Event Count&quot; THEN [06. Successful Automation without Recontact Event Count (copy)_2711518884588888154]&#10;END' />
            </column>
            <column caption='Partial Refund Automation CCR3' datatype='string' name='[Day (copy)_2711518883876528209]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [automation_type] IN (&quot;autoPartialRefund&quot;, &quot;partialRefundV2&quot;) THEN [contact_reason_level_3]&#10;END' />
            </column>
            <column caption='Display - Refund CPI' datatype='string' name='[Display - Incident Cost Savings (EUR) (copy)_2711518884592423006]' role='measure' type='nominal'>
              <calculation class='tableau' formula='&quot;€&quot; + STR(ROUND([Calculation_2711518880935444503],3))' />
            </column>
            <column caption='Display - Refund Value EUR' datatype='string' name='[Display - Incident Cost Savings (EUR) (copy)_2711518884593942623]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2711518880917340180] &gt;= 1000000 THEN&#10;    &quot;€&quot; +&#10;    STR(INT([Calculation_2711518880917340180]/ 1000000)) + &quot;,&quot; + &#10;    RIGHT(&quot;000&quot; + STR(INT([Calculation_2711518880917340180] % 1000000 / 1000)), 3) + &quot;,&quot; + &#10;    RIGHT(&quot;000&quot; + STR([Calculation_2711518880917340180]% 1000), 3)&#10;ELSEIF [Calculation_2711518880917340180] &gt;= 1000 THEN&#10;    &quot;€&quot; +&#10;    STR(INT([Calculation_2711518880917340180]/ 1000)) + &quot;,&quot; +&#10;    RIGHT(&quot;000&quot; + STR([Calculation_2711518880917340180]% 1000), 3)&#10;ELSE&#10;    &quot;€&quot; + STR(INT([Calculation_2711518880917340180]))&#10;END' />
            </column>
            <column caption='Display - Partial Refund Successful Automation Event Count' datatype='string' name='[Display - Total Automation Event (Succesful + Failed) (copy)_2711518884591788125]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [06. Successful Automation without Recontact Event Count (copy)_2711518884588888154] &gt;= 1000000 THEN&#10;    STR(INT([06. Successful Automation without Recontact Event Count (copy)_2711518884588888154]/ 1000000)) + &quot;,&quot; + &#10;    RIGHT(&quot;000&quot; + STR(INT([06. Successful Automation without Recontact Event Count (copy)_2711518884588888154] % 1000000 / 1000)), 3) + &quot;,&quot; + &#10;    RIGHT(&quot;000&quot; + STR([06. Successful Automation without Recontact Event Count (copy)_2711518884588888154] % 1000), 3)&#10;ELSEIF [06. Successful Automation without Recontact Event Count (copy)_2711518884588888154] &gt;= 1000 THEN&#10;    STR(INT([06. Successful Automation without Recontact Event Count (copy)_2711518884588888154] / 1000)) + &quot;,&quot; +&#10;    RIGHT(&quot;000&quot; + STR([06. Successful Automation without Recontact Event Count (copy)_2711518884588888154]% 1000), 3)&#10;ELSE&#10;    STR([06. Successful Automation without Recontact Event Count (copy)_2711518884588888154])&#10;END' />
            </column>
            <column caption='Partial Refund Automation Metrics Display' datatype='string' name='[Partial Refund Automation Metrics (copy)_2711518884591247452]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Refund Value EUR&quot; THEN [Display - Incident Cost Savings (EUR) (copy)_2711518884593942623]&#10;WHEN &quot;Refund Cost Per Incident (CPI)&quot; THEN [Display - Incident Cost Savings (EUR) (copy)_2711518884592423006]&#10;WHEN &quot;Partial Refund Automation Successful Event Count&quot; THEN [Display - Total Automation Event (Succesful + Failed) (copy)_2711518884591788125]&#10;END' />
            </column>
