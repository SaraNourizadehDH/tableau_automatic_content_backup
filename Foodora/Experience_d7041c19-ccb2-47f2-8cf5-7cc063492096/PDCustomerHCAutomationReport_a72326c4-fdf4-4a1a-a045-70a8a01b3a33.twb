          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='service_operations__opex_customer_hc_automation_report' name='federated.1rlpod919hxcqa1aan2v41intm4w' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Reactive Compensation Automation Chart Dimension Selection' datatype='string' name='[Partial Refund Automation Chart Dimension Selection (copy)_2711518884794339443]' param-domain-type='list' role='measure' type='nominal' value='&quot;Company Name&quot;'>
              <calculation class='tableau' formula='&quot;Company Name&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rlpod919hxcqa1aan2v41intm4w'>
            <column caption='Day' datatype='string' name='[Calculation_2711518880882978817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;daily&quot; THEN &#10;&#10;STR(DATE([event_date_local]))&#10;ELSE NULL&#10;&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_2711518880883183618]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;monthly&quot; THEN &#10;&#10;IF month([event_date_local]) &lt; 10 THEN STR(YEAR([event_date_local])) + &quot;-0&quot; + STR(MONTH([event_date_local]))&#10;ELSE STR(YEAR([event_date_local])) + &quot;-&quot; + STR(MONTH([event_date_local]))&#10;END&#10;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_2711518880884617219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;weekly&quot; THEN &#10;&#10; IF ISOWEEK([event_date_local]) &lt; 10&#10;   THEN STR(ISOYEAR([event_date_local])) + &quot;-W0&quot; + STR(ISOWEEK([event_date_local]))&#10;   ELSE STR(ISOYEAR([event_date_local])) + &quot;-W&quot; + STR(ISOWEEK([event_date_local]))&#10;   END&#10;  ELSE NULL&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_2711518880885575684]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN [Calculation_2711518880882978817]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_2711518880884617219]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_2711518880883183618]&#10;END' />
            </column>
            <column caption='Filter for Non-Time Series' datatype='boolean' name='[Calculation_2711518883888222290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN [class_date] = &quot;daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [class_date] = &quot;weekly&quot;&#10;WHEN &quot;Monthly&quot; THEN [class_date] = &quot;monthly&quot;&#10;END' />
            </column>
            <column caption='Reactive Compensation Type' datatype='string' name='[Calculation_2711518884776185963]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [automation_type] = &quot;reactiveCompensation - Live Order&quot; THEN &quot;reactiveCompensation - Live Order&quot;&#10;ELSEIF [automation_type] = &quot;reactiveCompensation - Post Delivery&quot; THEN &quot;reactiveCompensation - Post Delivery&quot;&#10;ELSEIF [automation_type] = &quot;reactiveCompensation - Undefined&quot; THEN &quot;reactiveCompensation - Undefined&quot;&#10;END' />
            </column>
            <column caption='Reactive Compensation Automation CCR3' datatype='string' name='[Partial Refund Automation CCR3 (copy)_2711518884781174893]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [automation_type] IN (&#10;    &quot;reactiveCompensation - Live Order&quot;,&#10;    &quot;reactiveCompensation - Post Delivery&quot;,&#10;    &quot;reactiveCompensation - Undefined&quot;)&#10;THEN [contact_reason_level_3]&#10;END' />
            </column>
            <column caption='Reactive Compensation Automation Chart Dimension Selection' datatype='string' name='[Partial Refund Automation Chart Dimension Selection (copy)_2711518884795908212]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Partial Refund Automation Chart Dimension Selection (copy)_2711518884794339443]&#10;WHEN &quot;Company Name&quot; THEN [company_name]&#10;WHEN &quot;Country&quot; THEN [country_name]&#10;WHEN &quot;Vertical Type&quot; THEN [vertical_sub_type]&#10;WHEN &quot;Delivery Type&quot; THEN [delivery_type]&#10;WHEN &quot;Is Subscriber&quot; THEN [is_subscriber_order]&#10;WHEN &quot;Contact Reason Level 3&quot; THEN [Partial Refund Automation CCR3 (copy)_2711518884781174893]&#10;WHEN &quot;Time of the Day&quot; THEN [time_of_the_day]&#10;WHEN &quot;Order Status During Event&quot; THEN [order_status_during_event]&#10;WHEN &quot;Final Order Status&quot; THEN [final_order_status]&#10;END' />
            </column>
            <column caption='Reactive Compensation Automation CCR1' datatype='string' name='[Reactive Compensation Automation CCR3 (copy)_1208653616722149376]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [automation_type] IN (&#10;    &quot;reactiveCompensation - Live Order&quot;,&#10;    &quot;reactiveCompensation - Post Delivery&quot;,&#10;    &quot;reactiveCompensation - Undefined&quot;)&#10;THEN [contact_reason_level_1]&#10;END' />
            </column>
            <column caption='Automation Type' datatype='string' name='[automation_type]' role='dimension' type='nominal' />
            <column caption='Class Date' datatype='string' name='[class_date]' role='dimension' type='nominal' />
            <column caption='Company Name' datatype='string' name='[company_name]' role='dimension' type='nominal' />
            <column caption='Contact Reason Level 1' datatype='string' name='[contact_reason_level_1]' role='dimension' type='nominal' />
