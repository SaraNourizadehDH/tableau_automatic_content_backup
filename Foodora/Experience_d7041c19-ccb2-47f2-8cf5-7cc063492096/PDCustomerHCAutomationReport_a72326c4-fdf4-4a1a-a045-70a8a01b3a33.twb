              <calculation class='tableau' formula='SUM(IF[is_gross_reordered_in_7days] = &quot;TRUE&quot; AND [group_type] = &quot;failed_without_contact&quot; THEN [event_count] END)/[06. Successful Automation without Recontact Event Count (copy)_2711518881235939367]' />
            </column>
            <column caption='05a. 30-Day Gross Reorder Rate - Successful without Recontact' datatype='real' default-format='p0.00%' name='[04a. 7-Day Gross Reorder Rate - Successful without Recontact (copy)_6371960219718918151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_gross_reordered_in_30days] = &quot;TRUE&quot; AND [group_type] = &quot;successful_without_contact&quot; THEN [event_count] END)/[Calculation_2711518880891015173]' />
            </column>
            <column caption='05b. 30-Day Gross Reorder Rate - Successful with Recontact' datatype='real' default-format='p0.00%' name='[04b. 7-Day Gross Reorder Rate - Successful with Recontact (copy)_6371960219719110664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[is_gross_reordered_in_30days]= &quot;TRUE&quot; AND [group_type] = &quot;successful_with_contact&quot; THEN [event_count] END)/[Automation Rate Numerator (copy)_2711518880909455375]' />
            </column>
            <column caption='05c. 30-Day Gross Reorder Rate - Failed without Recontact' datatype='real' default-format='p0.00%' name='[04c. 7-Day Gross Reorder Rate - Failed without Recontact (copy)_6371960219720286217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[is_gross_reordered_in_30days] = &quot;TRUE&quot; AND [group_type] = &quot;failed_without_contact&quot; THEN [event_count] END)/[06. Successful Automation without Recontact Event Count (copy)_2711518881235939367]' />
            </column>
            <column caption='05d. 30-Day Gross Reorder Rate - Failed with Recontact' datatype='real' default-format='p0.00%' name='[04d. 7-Day Gross Reorder Rate - Failed with Recontact (copy)_6371960219720437770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[is_gross_reordered_in_30days] = &quot;TRUE&quot; AND [group_type] = &quot;failed_with_contact&quot; THEN [event_count] END)/[08. Failed Automation without Recontact Event Count (copy)_2711518881236402216]' />
            </column>
            <column caption='06c. Failed Automation without Recontact Event Count' datatype='integer' name='[06. Successful Automation without Recontact Event Count (copy)_2711518881235939367]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[group_type] = &quot;failed_without_contact&quot; THEN [event_count] END)' />
            </column>
            <column caption='Overview Dimension: Automation Failed Rate' datatype='real' name='[07. Automation Failed Rate (copy)_379780178807328770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Automation Rate Numerator (copy)_2711518880911036433]/[Automation Rate Denominator - Overview Dimension Selection (copy)_379780178806288384]' />
            </column>
            <column caption='06d. Failed Automation with Recontact Event Count' datatype='integer' name='[08. Failed Automation without Recontact Event Count (copy)_2711518881236402216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[group_type] = &quot;failed_with_contact&quot; THEN [event_count] END)' />
            </column>
            <column caption='05. 30-Day Gross Reorder Rate' datatype='real' default-format='p0.00%' name='[3. 7 Days Gross Reorder Rate (copy)_2711518880905945101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Reordered in 7D Numerator (copy)_2711518880905322505]/[Calculation_2711518880905564171]' />
            </column>
            <column caption='Failed Rate Denominator - Overview Dimension Selection' datatype='integer' name='[Automation Rate Denominator - Overview Dimension Selection (copy)_379780178806288384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Is Gross Reordered In 30Days Parameter] IN (&quot;Company Name&quot;, &quot;Country Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;) AND&#10;[Parameters].[Table Dimension Selection (copy)]IN (&quot;Company Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;)&#10;THEN&#10;    SUM(&#10;        { EXCLUDE &#10;            [contact_reason_level_1],&#10;            [contact_reason_level_2],&#10;            [contact_reason_level_3],&#10;            [time_of_the_day],&#10;            [order_status_during_event],&#10;            [final_order_status],&#10;            [automation_type],&#10;            [failed_reason],&#10;            [request_refund_method],&#10;            [request_num_items],&#10;            [refund_percentage_of_order],&#10;            [is_gross_reordered_in_7days],&#10;            [is_gross_reordered_in_30days],&#10;            [group_type]: &#10;            SUM( { FIXED &#10;                [Calculation_2711518880885575684],&#10;                [company_name],&#10;                [country_name],&#10;                [vertical_sub_type],&#10;                [delivery_type],&#10;                [is_subscriber_order]:&#10;                SUM([failed_rate_denominator])}&#10;            )&#10;        }&#10;    )&#10;&#10;ELSEIF [Parameters].[Is Gross Reordered In 30Days Parameter] IN (&quot;Company Name&quot;, &quot;Country Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;) AND&#10;NOT [Parameters].[Table Dimension Selection (copy)]IN (&quot;Company Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;)&#10;THEN&#10;    SUM(&#10;        { EXCLUDE &#10;            [contact_reason_level_1],&#10;            [contact_reason_level_2],&#10;            [contact_reason_level_3],&#10;            [time_of_the_day],&#10;            [order_status_during_event],&#10;            [final_order_status],&#10;            [automation_type],&#10;            [failed_reason],&#10;            [request_refund_method],&#10;            [request_num_items],&#10;            [refund_percentage_of_order],&#10;            [is_gross_reordered_in_7days],&#10;            [is_gross_reordered_in_30days],&#10;            [group_type],&#10;            [Table Dimension Selection (copy)_2711518880859205632]: &#10;            SUM( { FIXED &#10;                [Calculation_2711518880885575684],&#10;                [company_name],&#10;                [country_name],&#10;                [vertical_sub_type],&#10;                [delivery_type],&#10;                [is_subscriber_order]:&#10;                SUM([failed_rate_denominator])}&#10;            )&#10;        }&#10;    )&#10;&#10;ELSEIF NOT [Parameters].[Is Gross Reordered In 30Days Parameter] IN (&quot;Company Name&quot;, &quot;Country Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;) AND&#10;[Parameters].[Table Dimension Selection (copy)]IN (&quot;Company Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;)&#10;THEN&#10;    SUM(&#10;        { EXCLUDE &#10;            [contact_reason_level_1],&#10;            [contact_reason_level_2],&#10;            [contact_reason_level_3],&#10;            [time_of_the_day],&#10;            [order_status_during_event],&#10;            [final_order_status],&#10;            [automation_type],&#10;            [failed_reason],&#10;            [request_refund_method],&#10;            [request_num_items],&#10;            [refund_percentage_of_order],&#10;            [is_gross_reordered_in_7days],&#10;            [is_gross_reordered_in_30days],&#10;            [group_type],&#10;            [Calculation_6758847568154533891]: &#10;            SUM( { FIXED &#10;                [Calculation_2711518880885575684],&#10;                [company_name],&#10;                [country_name],&#10;                [vertical_sub_type],&#10;                [delivery_type],&#10;                [is_subscriber_order]:&#10;                SUM([failed_rate_denominator])}&#10;            )&#10;        }&#10;    )&#10;&#10;ELSE&#10;    SUM(&#10;        { EXCLUDE &#10;            [contact_reason_level_1],&#10;            [contact_reason_level_2],&#10;            [contact_reason_level_3],&#10;            [time_of_the_day],&#10;            [order_status_during_event],&#10;            [final_order_status],&#10;            [automation_type],&#10;            [failed_reason],&#10;            [request_refund_method],&#10;            [request_num_items],&#10;            [refund_percentage_of_order],&#10;            [is_gross_reordered_in_7days],&#10;            [is_gross_reordered_in_30days],&#10;            [group_type],&#10;            [Table Dimension Selection (copy)_2711518880859205632],&#10;            [Calculation_6758847568154533891]: &#10;            SUM( { FIXED &#10;                [Calculation_2711518880885575684],&#10;                [company_name],&#10;                [country_name],&#10;                [vertical_sub_type],&#10;                [delivery_type],&#10;                [is_subscriber_order]:&#10;                SUM([failed_rate_denominator])}&#10;            )&#10;        }&#10;    )&#10;END' />
            </column>
            <column caption='06b. Successful Automation with Recontact Event Count' datatype='integer' name='[Automation Rate Numerator (copy)_2711518880909455375]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[group_type] = &quot;successful_with_contact&quot; THEN [event_count] END)' />
            </column>
            <column caption='Failed Rate Numerator' datatype='integer' name='[Automation Rate Numerator (copy)_2711518880911036433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[group_type] IN (&quot;failed_with_contact&quot;, &quot;failed_without_contact&quot;) THEN [event_count] END)' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_2711518880882978817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;daily&quot; THEN &#10;&#10;STR(DATE([event_date_local]))&#10;ELSE NULL&#10;&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_2711518880883183618]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;monthly&quot; THEN &#10;&#10;IF month([event_date_local]) &lt; 10 THEN STR(YEAR([event_date_local])) + &quot;-0&quot; + STR(MONTH([event_date_local]))&#10;ELSE STR(YEAR([event_date_local])) + &quot;-&quot; + STR(MONTH([event_date_local]))&#10;END&#10;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_2711518880884617219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;weekly&quot; THEN &#10;&#10; IF ISOWEEK([event_date_local]) &lt; 10&#10;   THEN STR(ISOYEAR([event_date_local])) + &quot;-W0&quot; + STR(ISOWEEK([event_date_local]))&#10;   ELSE STR(ISOYEAR([event_date_local])) + &quot;-W&quot; + STR(ISOWEEK([event_date_local]))&#10;   END&#10;  ELSE NULL&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_2711518880885575684]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN [Calculation_2711518880882978817]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_2711518880884617219]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_2711518880883183618]&#10;END' />
            </column>
            <column caption='06a. Successful Automation without Recontact Event Count' datatype='integer' name='[Calculation_2711518880891015173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[group_type] = &quot;successful_without_contact&quot; THEN [event_count] END)' />
            </column>
            <column caption='Reordered in 7D Numerator' datatype='integer' name='[Calculation_2711518880904830984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[is_gross_reordered_in_7days] = &quot;TRUE&quot; THEN [event_count] END)' />
            </column>
            <column caption='06. Total Automation Event (Successful + Failed)' datatype='integer' name='[Calculation_2711518880905564171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([event_count])' />
            </column>
            <column caption='04. 7-Day Gross Reorder Rate' datatype='real' default-format='p0.00%' name='[Calculation_2711518880905695244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2711518880904830984]/[Calculation_2711518880905564171]' />
            </column>
            <column caption='Display - Total Automation Event (Succesful + Failed)' datatype='string' name='[Calculation_2711518881079431205]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2711518880905564171] &gt;= 1000000 THEN&#10;    STR(INT([Calculation_2711518880905564171] / 1000000)) + &quot;,&quot; + &#10;    RIGHT(&quot;000&quot; + STR(INT([Calculation_2711518880905564171] % 1000000 / 1000)), 3) + &quot;,&quot; + &#10;    RIGHT(&quot;000&quot; + STR([Calculation_2711518880905564171] % 1000), 3)&#10;ELSEIF [Calculation_2711518880905564171] &gt;= 1000 THEN&#10;    STR(INT([Calculation_2711518880905564171] / 1000)) + &quot;,&quot; +&#10;    RIGHT(&quot;000&quot; + STR([Calculation_2711518880905564171]% 1000), 3)&#10;ELSE&#10;    STR([Calculation_2711518880905564171])&#10;END' />
            </column>
            <column caption='Filter for Non-Time Series' datatype='boolean' name='[Calculation_2711518883888222290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN [class_date] = &quot;daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [class_date] = &quot;weekly&quot;&#10;WHEN &quot;Monthly&quot; THEN [class_date] = &quot;monthly&quot;&#10;END' />
            </column>
            <column caption='Automation Rate Denominator - Overview Dimension Selection' datatype='integer' name='[Calculation_6758847568146251776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Is Gross Reordered In 30Days Parameter] IN (&quot;Company Name&quot;, &quot;Country Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;) AND&#10;[Parameters].[Table Dimension Selection (copy)]IN (&quot;Company Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;)&#10;THEN&#10;    SUM(&#10;        { EXCLUDE &#10;            [contact_reason_level_1],&#10;            [contact_reason_level_2],&#10;            [contact_reason_level_3],&#10;            [time_of_the_day],&#10;            [order_status_during_event],&#10;            [final_order_status],&#10;            [automation_type],&#10;            [failed_reason],&#10;            [request_refund_method],&#10;            [request_num_items],&#10;            [refund_percentage_of_order],&#10;            [is_gross_reordered_in_7days],&#10;            [is_gross_reordered_in_30days],&#10;            [group_type]: &#10;            SUM( { FIXED &#10;                [Calculation_2711518880885575684],&#10;                [company_name],&#10;                [country_name],&#10;                [vertical_sub_type],&#10;                [delivery_type],&#10;                [is_subscriber_order]:&#10;                SUM([automation_rate_denominator])}&#10;            )&#10;        }&#10;    )&#10;&#10;ELSEIF [Parameters].[Is Gross Reordered In 30Days Parameter] IN (&quot;Company Name&quot;, &quot;Country Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;) AND&#10;NOT [Parameters].[Table Dimension Selection (copy)]IN (&quot;Company Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;)&#10;THEN&#10;    SUM(&#10;        { EXCLUDE &#10;            [contact_reason_level_1],&#10;            [contact_reason_level_2],&#10;            [contact_reason_level_3],&#10;            [time_of_the_day],&#10;            [order_status_during_event],&#10;            [final_order_status],&#10;            [automation_type],&#10;            [failed_reason],&#10;            [request_refund_method],&#10;            [request_num_items],&#10;            [refund_percentage_of_order],&#10;            [is_gross_reordered_in_7days],&#10;            [is_gross_reordered_in_30days],&#10;            [group_type],&#10;            [Table Dimension Selection (copy)_2711518880859205632]: &#10;            SUM( { FIXED &#10;                [Calculation_2711518880885575684],&#10;                [company_name],&#10;                [country_name],&#10;                [vertical_sub_type],&#10;                [delivery_type],&#10;                [is_subscriber_order]:&#10;                SUM([automation_rate_denominator])}&#10;            )&#10;        }&#10;    )&#10;&#10;ELSEIF NOT [Parameters].[Is Gross Reordered In 30Days Parameter] IN (&quot;Company Name&quot;, &quot;Country Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;) AND&#10;[Parameters].[Table Dimension Selection (copy)]IN (&quot;Company Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;)&#10;THEN&#10;    SUM(&#10;        { EXCLUDE &#10;            [contact_reason_level_1],&#10;            [contact_reason_level_2],&#10;            [contact_reason_level_3],&#10;            [time_of_the_day],&#10;            [order_status_during_event],&#10;            [final_order_status],&#10;            [automation_type],&#10;            [failed_reason],&#10;            [request_refund_method],&#10;            [request_num_items],&#10;            [refund_percentage_of_order],&#10;            [is_gross_reordered_in_7days],&#10;            [is_gross_reordered_in_30days],&#10;            [group_type],&#10;            [Calculation_6758847568154533891]: &#10;            SUM( { FIXED &#10;                [Calculation_2711518880885575684],&#10;                [company_name],&#10;                [country_name],&#10;                [vertical_sub_type],&#10;                [delivery_type],&#10;                [is_subscriber_order]:&#10;                SUM([automation_rate_denominator])}&#10;            )&#10;        }&#10;    )&#10;&#10;ELSE&#10;    SUM(&#10;        { EXCLUDE &#10;            [contact_reason_level_1],&#10;            [contact_reason_level_2],&#10;            [contact_reason_level_3],&#10;            [time_of_the_day],&#10;            [order_status_during_event],&#10;            [final_order_status],&#10;            [automation_type],&#10;            [failed_reason],&#10;            [request_refund_method],&#10;            [request_num_items],&#10;            [refund_percentage_of_order],&#10;            [is_gross_reordered_in_7days],&#10;            [is_gross_reordered_in_30days],&#10;            [group_type],&#10;            [Table Dimension Selection (copy)_2711518880859205632],&#10;            [Calculation_6758847568154533891]: &#10;            SUM( { FIXED &#10;                [Calculation_2711518880885575684],&#10;                [company_name],&#10;                [country_name],&#10;                [vertical_sub_type],&#10;                [delivery_type],&#10;                [is_subscriber_order]:&#10;                SUM([automation_rate_denominator])}&#10;            )&#10;        }&#10;    )&#10;END' />
