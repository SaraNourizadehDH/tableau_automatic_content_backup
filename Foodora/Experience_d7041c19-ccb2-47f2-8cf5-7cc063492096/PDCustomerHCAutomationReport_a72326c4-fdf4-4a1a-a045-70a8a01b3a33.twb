    <worksheet name='Multi Dimensional Table'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='11'>Multi Dimensional Table</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='service_operations__opex_customer_hc_automation_report' name='federated.1rlpod919hxcqa1aan2v41intm4w' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Dimension Selection 1' datatype='string' name='[Table Dimension Selection (copy 2) (copy)_5923852056686137357]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
            </column>
            <column caption='Dimension Selection 2' datatype='string' name='[Table Dimension Selection (copy 2)_5923852056686129164]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rlpod919hxcqa1aan2v41intm4w'>
            <column caption='Automation Rate Denominator - Multi Dimensional' datatype='integer' name='[Automation Rate Denominator - Overview Dimension Selection (copy)_379780178809942023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Table Dimension Selection (copy 2) (copy)_5923852056686137357] IN (&quot;Company Name&quot;, &quot;Country Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;) AND&#10;[Parameters].[Table Dimension Selection (copy 2)_5923852056686129164] IN (&quot;Company Name&quot;, &quot;Country Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;)&#10;THEN&#10;    SUM(&#10;        { EXCLUDE &#10;            [contact_reason_level_1],&#10;            [contact_reason_level_2],&#10;            [contact_reason_level_3],&#10;            [time_of_the_day],&#10;            [order_status_during_event],&#10;            [final_order_status],&#10;            [automation_type],&#10;            [failed_reason],&#10;            [request_refund_method],&#10;            [request_num_items],&#10;            [refund_percentage_of_order],&#10;            [is_gross_reordered_in_7days],&#10;            [is_gross_reordered_in_30days],&#10;            [group_type]: &#10;            SUM( { FIXED &#10;                [Calculation_2711518880885575684],&#10;                [company_name],&#10;                [country_name],&#10;                [vertical_sub_type],&#10;                [delivery_type],&#10;                [is_subscriber_order]:&#10;                SUM([automation_rate_denominator])}&#10;            )&#10;        }&#10;    )&#10;&#10;ELSEIF [Parameters].[Table Dimension Selection (copy 2) (copy)_5923852056686137357] IN (&quot;Company Name&quot;, &quot;Country Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;) AND&#10;NOT [Parameters].[Table Dimension Selection (copy 2)_5923852056686129164] IN (&quot;Company Name&quot;, &quot;Country Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;)&#10;THEN&#10;    SUM(&#10;        { EXCLUDE &#10;            [contact_reason_level_1],&#10;            [contact_reason_level_2],&#10;            [contact_reason_level_3],&#10;            [time_of_the_day],&#10;            [order_status_during_event],&#10;            [final_order_status],&#10;            [automation_type],&#10;            [failed_reason],&#10;            [request_refund_method],&#10;            [request_num_items],&#10;            [refund_percentage_of_order],&#10;            [is_gross_reordered_in_7days],&#10;            [is_gross_reordered_in_30days],&#10;            [group_type],&#10;            [Table Dimension Selection (copy) (copy)_5923852056687198223]: &#10;            SUM( { FIXED &#10;                [Calculation_2711518880885575684],&#10;                [company_name],&#10;                [country_name],&#10;                [vertical_sub_type],&#10;                [delivery_type],&#10;                [is_subscriber_order]:&#10;                SUM([automation_rate_denominator])}&#10;            )&#10;        }&#10;    )&#10;&#10;ELSEIF NOT [Parameters].[Table Dimension Selection (copy 2) (copy)_5923852056686137357] IN (&quot;Company Name&quot;, &quot;Country Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;) AND&#10;[Parameters].[Table Dimension Selection (copy 2)_5923852056686129164] IN (&quot;Company Name&quot;, &quot;Country Name&quot;, &quot;Vertical Type&quot;, &quot;Delivery Type&quot;,&quot;Is Subscriber&quot;)&#10;THEN&#10;    SUM(&#10;        { EXCLUDE &#10;            [contact_reason_level_1],&#10;            [contact_reason_level_2],&#10;            [contact_reason_level_3],&#10;            [time_of_the_day],&#10;            [order_status_during_event],&#10;            [final_order_status],&#10;            [automation_type],&#10;            [failed_reason],&#10;            [request_refund_method],&#10;            [request_num_items],&#10;            [refund_percentage_of_order],&#10;            [is_gross_reordered_in_7days],&#10;            [is_gross_reordered_in_30days],&#10;            [group_type],&#10;            [Table Dimension Selection (copy)_5923852056687185934]: &#10;            SUM( { FIXED &#10;                [Calculation_2711518880885575684],&#10;                [company_name],&#10;                [country_name],&#10;                [vertical_sub_type],&#10;                [delivery_type],&#10;                [is_subscriber_order]:&#10;                SUM([automation_rate_denominator])}&#10;            )&#10;        }&#10;    )&#10;&#10;ELSE&#10;    SUM(&#10;        { EXCLUDE &#10;            [contact_reason_level_1],&#10;            [contact_reason_level_2],&#10;            [contact_reason_level_3],&#10;            [time_of_the_day],&#10;            [order_status_during_event],&#10;            [final_order_status],&#10;            [automation_type],&#10;            [failed_reason],&#10;            [request_refund_method],&#10;            [request_num_items],&#10;            [refund_percentage_of_order],&#10;            [is_gross_reordered_in_7days],&#10;            [is_gross_reordered_in_30days],&#10;            [group_type],&#10;            [Table Dimension Selection (copy)_5923852056687185934],&#10;            [Table Dimension Selection (copy) (copy)_5923852056687198223]: &#10;            SUM( { FIXED &#10;                [Calculation_2711518880885575684],&#10;                [company_name],&#10;                [country_name],&#10;                [vertical_sub_type],&#10;                [delivery_type],&#10;                [is_subscriber_order]:&#10;                SUM([automation_rate_denominator])}&#10;            )&#10;        }&#10;    )&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_2711518880882978817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;daily&quot; THEN &#10;&#10;STR(DATE([event_date_local]))&#10;ELSE NULL&#10;&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_2711518880883183618]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;monthly&quot; THEN &#10;&#10;IF month([event_date_local]) &lt; 10 THEN STR(YEAR([event_date_local])) + &quot;-0&quot; + STR(MONTH([event_date_local]))&#10;ELSE STR(YEAR([event_date_local])) + &quot;-&quot; + STR(MONTH([event_date_local]))&#10;END&#10;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_2711518880884617219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;weekly&quot; THEN &#10;&#10; IF ISOWEEK([event_date_local]) &lt; 10&#10;   THEN STR(ISOYEAR([event_date_local])) + &quot;-W0&quot; + STR(ISOWEEK([event_date_local]))&#10;   ELSE STR(ISOYEAR([event_date_local])) + &quot;-W&quot; + STR(ISOWEEK([event_date_local]))&#10;   END&#10;  ELSE NULL&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_2711518880885575684]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN [Calculation_2711518880882978817]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_2711518880884617219]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_2711518880883183618]&#10;END' />
            </column>
            <column caption='06a. Successful Automation without Recontact Event Count' datatype='integer' name='[Calculation_2711518880891015173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[group_type] = &quot;successful_without_contact&quot; THEN [event_count] END)' />
            </column>
            <column caption='01. Automation Rate' datatype='real' default-format='p0.00%' name='[Calculation_2711518880892375046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2711518880891015173]/[Automation Rate Denominator - Overview Dimension Selection (copy)_379780178809942023]' />
            </column>
            <column caption='Filter for Non-Time Series' datatype='boolean' name='[Calculation_2711518883888222290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN [class_date] = &quot;daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [class_date] = &quot;weekly&quot;&#10;WHEN &quot;Monthly&quot; THEN [class_date] = &quot;monthly&quot;&#10;END' />
            </column>
            <column caption='Dimension Selection 2' datatype='string' name='[Table Dimension Selection (copy) (copy)_5923852056687198223]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Table Dimension Selection (copy 2)_5923852056686129164]&#10;WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#10;WHEN &quot;Company Name&quot; THEN [company_name]&#10;WHEN &quot;Country Name&quot; THEN [country_name]&#10;WHEN &quot;Vertical Type&quot; THEN [vertical_sub_type]&#10;WHEN &quot;Delivery Type&quot; THEN [delivery_type]&#10;WHEN &quot;Is Subscriber&quot; THEN [is_subscriber_order]&#10;WHEN &quot;Automation Type&quot; THEN [automation_type]&#10;WHEN &quot;Failed Reason&quot; THEN [failed_reason]&#10;WHEN &quot;Time of the Day&quot; THEN [time_of_the_day]&#10;WHEN &quot;Order Status During Event&quot; THEN [order_status_during_event]&#10;WHEN &quot;Final Order Status&quot; THEN [final_order_status]&#10;WHEN &quot;CCR1&quot; THEN [contact_reason_level_1]&#10;WHEN &quot;CCR2&quot; THEN [contact_reason_level_2]&#10;WHEN &quot;CCR3&quot; THEN [contact_reason_level_3]&#10;END' />
            </column>
            <column caption='Dimension Selection 1' datatype='string' name='[Table Dimension Selection (copy)_5923852056687185934]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Table Dimension Selection (copy 2) (copy)_5923852056686137357]&#10;WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#10;WHEN &quot;Company Name&quot; THEN [company_name]&#10;WHEN &quot;Country Name&quot; THEN [country_name]&#10;WHEN &quot;Vertical Type&quot; THEN [vertical_sub_type]&#10;WHEN &quot;Delivery Type&quot; THEN [delivery_type]&#10;WHEN &quot;Is Subscriber&quot; THEN [is_subscriber_order]&#10;WHEN &quot;Automation Type&quot; THEN [automation_type]&#10;WHEN &quot;Failed Reason&quot; THEN [failed_reason]&#10;WHEN &quot;Time of the Day&quot; THEN [time_of_the_day]&#10;WHEN &quot;Order Status During Event&quot; THEN [order_status_during_event]&#10;WHEN &quot;Final Order Status&quot; THEN [final_order_status]&#10;WHEN &quot;CCR1&quot; THEN [contact_reason_level_1]&#10;WHEN &quot;CCR2&quot; THEN [contact_reason_level_2]&#10;WHEN &quot;CCR3&quot; THEN [contact_reason_level_3]&#10;END' />
            </column>
            <column caption='Raw Automation Rate Denominator' datatype='integer' name='[automation_rate_denominator]' role='measure' type='quantitative' />
            <column caption='Automation Type' datatype='string' name='[automation_type]' role='dimension' type='nominal' />
            <column caption='Class Date' datatype='string' name='[class_date]' role='dimension' type='nominal' />
            <column caption='Company Name' datatype='string' name='[company_name]' role='dimension' type='nominal' />
