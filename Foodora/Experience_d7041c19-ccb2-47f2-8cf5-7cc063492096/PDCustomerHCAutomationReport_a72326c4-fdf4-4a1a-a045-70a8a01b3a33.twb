            <column caption='04a. 7-Day Gross Reorder Rate - Successful without Recontact' datatype='real' default-format='p0.00%' name='[04. 7-Day Gross Reorder Rate (copy)_6371960219717562370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[is_gross_reordered_in_7days] = &quot;TRUE&quot; AND [group_type] = &quot;successful_without_contact&quot; THEN [event_count] END)/[Calculation_2711518880891015173]' />
