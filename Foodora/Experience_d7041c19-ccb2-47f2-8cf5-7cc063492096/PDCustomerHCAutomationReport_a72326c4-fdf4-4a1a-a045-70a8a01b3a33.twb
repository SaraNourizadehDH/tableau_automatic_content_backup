          <calculation class='tableau' formula='IF [automation_type] = &quot;reactiveCompensation - Live Order&quot; THEN &quot;reactiveCompensation - Live Order&quot;&#10;ELSEIF [automation_type] = &quot;reactiveCompensation - Post Delivery&quot; THEN &quot;reactiveCompensation - Post Delivery&quot;&#10;ELSEIF [automation_type] = &quot;reactiveCompensation - Undefined&quot; THEN &quot;reactiveCompensation - Undefined&quot;&#10;END' />
