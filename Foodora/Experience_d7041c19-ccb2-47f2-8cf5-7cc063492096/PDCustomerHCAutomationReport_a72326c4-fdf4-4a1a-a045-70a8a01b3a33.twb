            </column>
            <column caption='Reactive Compensation Successful Automation Event Count' datatype='integer' name='[Partial Refund Successful Automation Event Count (copy)_2711518884789399663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF&#10;    [automation_type] IN (&#10;    &quot;reactiveCompensation - Live Order&quot;,&#10;    &quot;reactiveCompensation - Post Delivery&quot;,&#10;    &quot;reactiveCompensation - Undefined&quot;) AND&#10;    [group_type] IN (&quot;successful_without_contact&quot;, &quot;successful_with_contact&quot;)&#10;    THEN [event_count] END)' />
            </column>
            <column caption='Reactive Compensation Automation CCR1' datatype='string' name='[Reactive Compensation Automation CCR3 (copy)_1208653616722149376]' role='dimension' type='nominal'>
