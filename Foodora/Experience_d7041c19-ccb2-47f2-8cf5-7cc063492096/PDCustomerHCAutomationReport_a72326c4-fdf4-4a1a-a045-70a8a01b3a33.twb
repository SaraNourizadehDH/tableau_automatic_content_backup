      <column caption='Day' datatype='string' name='[Calculation_5923852056607125505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [class_date] = &quot;daily&quot; THEN &#10;&#10;STR(DATE([created_date_local]))&#10;ELSE NULL&#10;&#10;END' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_5923852056608903171]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [class_date] = &quot;weekly&quot; THEN &#10;&#10; IF ISOWEEK([created_date_local]) &lt; 10&#10;   THEN STR(ISOYEAR([created_date_local])) + &quot;-W0&quot; + STR(ISOWEEK([created_date_local]))&#10;   ELSE STR(ISOYEAR([created_date_local])) + &quot;-W&quot; + STR(ISOWEEK([created_date_local]))&#10;   END&#10;  ELSE NULL&#10;END' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_5923852056609026053]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [class_date] = &quot;monthly&quot; THEN &#10;&#10;IF month([created_date_local]) &lt; 10 THEN STR(YEAR([created_date_local])) + &quot;-0&quot; + STR(MONTH([created_date_local]))&#10;ELSE STR(YEAR([created_date_local])) + &quot;-&quot; + STR(MONTH([created_date_local]))&#10;END&#10;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_5923852056609189895]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN [Calculation_5923852056607125505]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_5923852056608903171]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_5923852056609026053]&#10;END' />
      </column>
      <column caption='Automation %' datatype='real' default-format='p0.00%' name='[Calculation_5923852056611098632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_successful_automation_events])/ SUM([automation_rate_denominator])' />
      </column>
      <column caption='Filter for Non-Time Series' datatype='boolean' name='[Calculation_5923852056646688778]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN [class_date] = &quot;daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [class_date] = &quot;weekly&quot;&#10;WHEN &quot;Monthly&quot; THEN [class_date] = &quot;monthly&quot;&#10;END' />
      </column>
