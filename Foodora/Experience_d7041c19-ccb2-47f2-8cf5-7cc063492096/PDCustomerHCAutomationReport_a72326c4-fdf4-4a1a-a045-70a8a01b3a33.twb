              <calculation class='tableau' formula='IF [08. Failed Automation without Recontact Event Count (copy)_2711518881236402216]&gt;= 1000000 THEN&#10;    STR(INT([08. Failed Automation without Recontact Event Count (copy)_2711518881236402216]/ 1000000)) + &quot;,&quot; + &#10;    RIGHT(&quot;000&quot; + STR(INT([08. Failed Automation without Recontact Event Count (copy)_2711518881236402216] % 1000000 / 1000)), 3) + &quot;,&quot; + &#10;    RIGHT(&quot;000&quot; + STR([08. Failed Automation without Recontact Event Count (copy)_2711518881236402216] % 1000), 3)&#10;ELSEIF [08. Failed Automation without Recontact Event Count (copy)_2711518881236402216] &gt;= 1000 THEN&#10;    STR(INT([08. Failed Automation without Recontact Event Count (copy)_2711518881236402216] / 1000)) + &quot;,&quot; +&#10;    RIGHT(&quot;000&quot; + STR([08. Failed Automation without Recontact Event Count (copy)_2711518881236402216]% 1000), 3)&#10;ELSE&#10;    STR([08. Failed Automation without Recontact Event Count (copy)_2711518881236402216])&#10;END' />
