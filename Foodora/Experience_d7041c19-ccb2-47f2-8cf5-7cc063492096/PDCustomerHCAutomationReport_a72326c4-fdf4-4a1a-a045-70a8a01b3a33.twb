            </column>
            <column caption='Metrics Selection Display - Overview Dimension Selection' datatype='string' name='[Metrics Selection (copy)_2711518881076547619]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Automation Rate&quot; THEN STR(ROUND([01. Automation Rate (copy)_379780178807218177] * 100, 2)) + &quot; %&quot;&#10;WHEN &quot;Automation Recontact Rate&quot; THEN STR(ROUND([02. Automation Recontact Rate (copy)_379780178808807429] * 100, 2)) + &quot; %&quot;&#10;WHEN &quot;Incident Cost Savings (EUR)&quot; THEN [Failed Automation w/ Recontact Event Count Display (copy)_2711518883352072252]&#10;WHEN &quot;7-Day Gross Reorder Rate&quot; THEN STR(ROUND([Calculation_2711518880905695244] * 100, 2)) + &quot; %&quot;&#10;WHEN &quot;7-Day Gross Reorder Rate - Successful Automation without Recontact&quot; THEN STR(ROUND([04. 7-Day Gross Reorder Rate (copy)_6371960219717562370] * 100, 2)) + &quot; %&quot;&#10;WHEN &quot;7-Day Gross Reorder Rate - Successful Automation with Recontact&quot; THEN STR(ROUND([04. 7-Day Gross Reorder Rate - Successful without Recontact (copy)_6371960219717881859] * 100, 2)) + &quot; %&quot;&#10;WHEN &quot;7-Day Gross Reorder Rate - Failed Automation without Recontact&quot; THEN STR(ROUND([04. 7-Day Gross Reorder Rate - Successful without Recontact (copy)_6371960219718004740] * 100, 2)) + &quot; %&quot;&#10;WHEN &quot;7-Day Gross Reorder Rate - Failed Automation with Recontact&quot; THEN STR(ROUND([04. 7-Day Gross Reorder Rate - Failed without Recontact (copy)_6371960219718197253] * 100, 2)) + &quot; %&quot;&#10;WHEN &quot;30-Day Gross Reorder Rate&quot; THEN STR(ROUND([3. 7 Days Gross Reorder Rate (copy)_2711518880905945101] * 100, 2)) + &quot; %&quot;&#10;WHEN &quot;30-Day Gross Reorder Rate - Successful Automation without Recontact&quot; THEN STR(ROUND([04a. 7-Day Gross Reorder Rate - Successful without Recontact (copy)_6371960219718918151]* 100, 2)) + &quot; %&quot;&#10;WHEN &quot;30-Day Gross Reorder Rate - Successful Automation with Recontact&quot; THEN STR(ROUND([04b. 7-Day Gross Reorder Rate - Successful with Recontact (copy)_6371960219719110664]* 100, 2)) + &quot; %&quot;&#10;WHEN &quot;30-Day Gross Reorder Rate - Failed Automation without Recontact&quot; THEN STR(ROUND([04c. 7-Day Gross Reorder Rate - Failed without Recontact (copy)_6371960219720286217] * 100, 2)) + &quot; %&quot;&#10;WHEN &quot;30-Day Gross Reorder Rate - Failed Automation with Recontact&quot; THEN STR(ROUND([04d. 7-Day Gross Reorder Rate - Failed with Recontact (copy)_6371960219720437770] * 100, 2)) + &quot; %&quot;&#10;WHEN &quot;Total Automation Event (Successful + Failed)&quot; THEN [Calculation_2711518881079431205]&#10;WHEN &quot;Successful Automation without Recontact Event Count&quot; THEN [Total Automation Event (Succesful + Failed) Display (copy)_2711518881241620521]&#10;WHEN &quot;Successful Automation with Recontact Event Count&quot; THEN [Successful Automation wo Recontact Event Count Display (copy)_2711518881241993258]&#10;WHEN &quot;Failed Automation without Recontact Event Count&quot; THEN [Failed Automation w/ Recontact Event Count Display (copy)_2711518881242746924]&#10;WHEN &quot;Failed Automation with Recontact Event Count&quot; THEN [Successful Automation w/ Recontact Event Count Display (copy)_2711518881242365995]&#10;WHEN &quot;Automation Failed Rate&quot; THEN STR(ROUND([07. Automation Failed Rate (copy)_379780178807328770] * 100, 2)) + &quot; %&quot;&#10;END' />
            </column>
            <column caption='Reordered in 30D Numerator' datatype='integer' name='[Reordered in 7D Numerator (copy)_2711518880905322505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[is_gross_reordered_in_30days] = &quot;TRUE&quot; THEN [event_count] END)' />
