      <table>
        <view>
          <datasources>
            <datasource caption='service_operations__opex_customer_hc_automation_report' name='federated.1rlpod919hxcqa1aan2v41intm4w' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Reactive Compensation Automation Chart Dimension Selection (Successful Automation)' datatype='string' name='[Partial Refund Automation Chart Dimension Selection (Successful Automation) (copy)_2711518884775727210]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
            </column>
            <column caption='Reactive Compensation Automation Metrics' datatype='string' name='[Partial Refund Automation Metrics (copy)_2711518881044082715]' param-domain-type='list' role='measure' type='nominal' value='&quot;Compensation Value EUR&quot;'>
              <calculation class='tableau' formula='&quot;Compensation Value EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rlpod919hxcqa1aan2v41intm4w'>
            <column caption='Day' datatype='string' name='[Calculation_2711518880882978817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;daily&quot; THEN &#10;&#10;STR(DATE([event_date_local]))&#10;ELSE NULL&#10;&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_2711518880883183618]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;monthly&quot; THEN &#10;&#10;IF month([event_date_local]) &lt; 10 THEN STR(YEAR([event_date_local])) + &quot;-0&quot; + STR(MONTH([event_date_local]))&#10;ELSE STR(YEAR([event_date_local])) + &quot;-&quot; + STR(MONTH([event_date_local]))&#10;END&#10;&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_2711518880884617219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &quot;weekly&quot; THEN &#10;&#10; IF ISOWEEK([event_date_local]) &lt; 10&#10;   THEN STR(ISOYEAR([event_date_local])) + &quot;-W0&quot; + STR(ISOWEEK([event_date_local]))&#10;   ELSE STR(ISOYEAR([event_date_local])) + &quot;-W&quot; + STR(ISOWEEK([event_date_local]))&#10;   END&#10;  ELSE NULL&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_2711518880885575684]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN [Calculation_2711518880882978817]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_2711518880884617219]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_2711518880883183618]&#10;END' />
            </column>
            <column caption='Compensation Value EUR' datatype='real' name='[Calculation_2711518881064284188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([compensation_value_eur])' />
            </column>
            <column caption='Reactive Compensation Type' datatype='string' name='[Calculation_2711518884776185963]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [automation_type] = &quot;reactiveCompensation - Live Order&quot; THEN &quot;reactiveCompensation - Live Order&quot;&#10;ELSEIF [automation_type] = &quot;reactiveCompensation - Post Delivery&quot; THEN &quot;reactiveCompensation - Post Delivery&quot;&#10;ELSEIF [automation_type] = &quot;reactiveCompensation - Undefined&quot; THEN &quot;reactiveCompensation - Undefined&quot;&#10;END' />
            </column>
            <column caption='Display - Reactive Compensation Successful Automation Event Count' datatype='string' name='[Display - Partial Refund Successful Automation Event Count (copy)_2711518884790366321]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Partial Refund Successful Automation Event Count (copy)_2711518884789399663] &gt;= 1000000 THEN&#10;    STR(INT([Partial Refund Successful Automation Event Count (copy)_2711518884789399663]/ 1000000)) + &quot;,&quot; + &#10;    RIGHT(&quot;000&quot; + STR(INT([Partial Refund Successful Automation Event Count (copy)_2711518884789399663] % 1000000 / 1000)), 3) + &quot;,&quot; + &#10;    RIGHT(&quot;000&quot; + STR([Partial Refund Successful Automation Event Count (copy)_2711518884789399663]% 1000), 3)&#10;ELSEIF [Partial Refund Successful Automation Event Count (copy)_2711518884789399663]&gt;= 1000 THEN&#10;    STR(INT([Partial Refund Successful Automation Event Count (copy)_2711518884789399663]/ 1000)) + &quot;,&quot; +&#10;    RIGHT(&quot;000&quot; + STR([Partial Refund Successful Automation Event Count (copy)_2711518884789399663]% 1000), 3)&#10;ELSE&#10;    STR([Partial Refund Successful Automation Event Count (copy)_2711518884789399663])&#10;END' />
            </column>
            <column caption='Display - Compensation CPI' datatype='string' name='[Display - Refund CPI (copy)_2711518884790235248]' role='measure' type='nominal'>
              <calculation class='tableau' formula='&quot;€&quot; + STR(ROUND([Refund Cost Per Incident (CPI) (copy)_2711518881066369057],3))' />
            </column>
            <column caption='Display - Compensation Value EUR' datatype='string' name='[Display - Refund Value EUR (copy)_2711518884788764782]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2711518881064284188] &gt;= 1000000 THEN&#10;    &quot;€&quot; +&#10;    STR(INT([Calculation_2711518881064284188]/ 1000000)) + &quot;,&quot; + &#10;    RIGHT(&quot;000&quot; + STR(INT([Calculation_2711518881064284188] % 1000000 / 1000)), 3) + &quot;,&quot; + &#10;    RIGHT(&quot;000&quot; + STR([Calculation_2711518881064284188]% 1000), 3)&#10;ELSEIF [Calculation_2711518881064284188] &gt;= 1000 THEN&#10;    &quot;€&quot; +&#10;    STR(INT([Calculation_2711518881064284188]/ 1000)) + &quot;,&quot; +&#10;    RIGHT(&quot;000&quot; + STR([Calculation_2711518881064284188]% 1000), 3)&#10;ELSE&#10;    &quot;€&quot; + STR(INT([Calculation_2711518881064284188]))&#10;END' />
            </column>
            <column caption='Reactive Compensation Automation CCR3' datatype='string' name='[Partial Refund Automation CCR3 (copy)_2711518884781174893]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [automation_type] IN (&#10;    &quot;reactiveCompensation - Live Order&quot;,&#10;    &quot;reactiveCompensation - Post Delivery&quot;,&#10;    &quot;reactiveCompensation - Undefined&quot;)&#10;THEN [contact_reason_level_3]&#10;END' />
            </column>
            <column caption='Reactive Compensation Automation Chart Dimension Selection (Successful Automation)' datatype='string' name='[Partial Refund Automation Chart Dimension Selection (Successful Automation) (copy)_2711518884780507244]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Partial Refund Automation Chart Dimension Selection (Successful Automation) (copy)_2711518884775727210]&#10;WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#10;WHEN &quot;Reactive Compensation Type&quot; THEN [Calculation_2711518884776185963]&#10;WHEN &quot;Contact Reason Level 3&quot; THEN [Partial Refund Automation CCR3 (copy)_2711518884781174893]&#10;WHEN &quot;Time of the Day&quot; THEN [time_of_the_day]&#10;WHEN &quot;Order Status During Event&quot; THEN [order_status_during_event]&#10;WHEN &quot;Final Order Status&quot; THEN [final_order_status]&#10;END' />
            </column>
            <column caption='Reactive Compensation Automation Metrics' datatype='real' name='[Partial Refund Automation Metrics (copy)_2711518881067012130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Partial Refund Automation Metrics (copy)_2711518881044082715]&#10;WHEN &quot;Compensation Value EUR&quot; THEN [Calculation_2711518881064284188]&#10;WHEN &quot;Compensation Cost Per Incident (CPI)&quot; THEN [Refund Cost Per Incident (CPI) (copy)_2711518881066369057]&#10;WHEN &quot;Reactive Compensation Automation Successful Event Count&quot; THEN [Partial Refund Successful Automation Event Count (copy)_2711518884789399663]&#10;END' />
            </column>
            <column caption='Reactive Compensation Automation Metrics Display' datatype='string' name='[Partial Refund Automation Metrics Display (copy)_2711518884790648946]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Partial Refund Automation Metrics (copy)_2711518881044082715]&#10;WHEN &quot;Compensation Value EUR&quot; THEN [Display - Refund Value EUR (copy)_2711518884788764782]&#10;WHEN &quot;Compensation Cost Per Incident (CPI)&quot; THEN [Display - Refund CPI (copy)_2711518884790235248]&#10;WHEN &quot;Reactive Compensation Automation Successful Event Count&quot; THEN [Display - Partial Refund Successful Automation Event Count (copy)_2711518884790366321]&#10;END' />
            </column>
            <column caption='Reactive Compensation Successful Automation Event Count' datatype='integer' name='[Partial Refund Successful Automation Event Count (copy)_2711518884789399663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF&#10;    [automation_type] IN (&#10;    &quot;reactiveCompensation - Live Order&quot;,&#10;    &quot;reactiveCompensation - Post Delivery&quot;,&#10;    &quot;reactiveCompensation - Undefined&quot;) AND&#10;    [group_type] IN (&quot;successful_without_contact&quot;, &quot;successful_with_contact&quot;)&#10;    THEN [event_count] END)' />
            </column>
            <column caption='Reactive Compensation Automation CCR1' datatype='string' name='[Reactive Compensation Automation CCR3 (copy)_1208653616722149376]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [automation_type] IN (&#10;    &quot;reactiveCompensation - Live Order&quot;,&#10;    &quot;reactiveCompensation - Post Delivery&quot;,&#10;    &quot;reactiveCompensation - Undefined&quot;)&#10;THEN [contact_reason_level_1]&#10;END' />
            </column>
            <column caption='Successful Automation Group Type' datatype='string' name='[Reactive Compensation Type (copy)_6643231728576073729]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [group_type] = &quot;successful_with_contact&quot; THEN &quot;successful_with_contact&quot;&#10;ELSEIF [group_type] = &quot;successful_without_contact&quot; THEN &quot;successful_without_contact&quot;&#10;END' />
            </column>
            <column caption='Compensation CPI Denominator' datatype='integer' name='[Refund CPI Denominator (copy)_2711518881064828960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF CONTAINS([automation_type], &quot;reactiveCompensation&quot;) THEN [event_count] END)' />
