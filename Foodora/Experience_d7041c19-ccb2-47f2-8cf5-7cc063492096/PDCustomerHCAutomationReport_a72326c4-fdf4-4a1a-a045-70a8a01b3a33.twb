              <calculation class='tableau' formula='IF [06. Successful Automation without Recontact Event Count (copy)_2711518881235939367]&gt;= 1000000 THEN&#10;    STR(INT([06. Successful Automation without Recontact Event Count (copy)_2711518881235939367]/ 1000000)) + &quot;,&quot; + &#10;    RIGHT(&quot;000&quot; + STR(INT([06. Successful Automation without Recontact Event Count (copy)_2711518881235939367] % 1000000 / 1000)), 3) + &quot;,&quot; + &#10;    RIGHT(&quot;000&quot; + STR([06. Successful Automation without Recontact Event Count (copy)_2711518881235939367] % 1000), 3)&#10;ELSEIF [06. Successful Automation without Recontact Event Count (copy)_2711518881235939367] &gt;= 1000 THEN&#10;    STR(INT([06. Successful Automation without Recontact Event Count (copy)_2711518881235939367]/ 1000)) + &quot;,&quot; +&#10;    RIGHT(&quot;000&quot; + STR([06. Successful Automation without Recontact Event Count (copy)_2711518881235939367]% 1000), 3)&#10;ELSE&#10;    STR([06. Successful Automation without Recontact Event Count (copy)_2711518881235939367])&#10;END' />
