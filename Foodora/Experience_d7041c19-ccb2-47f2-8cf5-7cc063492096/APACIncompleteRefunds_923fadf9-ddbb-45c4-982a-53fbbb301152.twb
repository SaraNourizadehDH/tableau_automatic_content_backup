    <dashboard name='Refund Tickets Overview'>
      <repository-location derived-from='http://ip-172-31-0-197:8196/t/Foodora/workbooks/APACIncompleteRefunds/RefundTicketsOverview?rev=' id='RefundTicketsOverview' path='/t/Foodora/workbooks/APACIncompleteRefunds' revision='' site='Foodora' />
      <style>
        <style-rule element='parameter-ctrl'>
          <format attr='background-color' value='#606b76' />
        </style-rule>
      </style>
      <size maxheight='6250' maxwidth='1500' minheight='6250' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Refund Tickets Data' name='federated.0oa0d2v12ow21113yijc00kc4htp' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
          <calculation class='tableau' formula='&quot;Monthly&quot;' />
          <members>
            <member value='&quot;Monthly&quot;' />
            <member value='&quot;Weekly&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0oa0d2v12ow21113yijc00kc4htp'>
        <column caption='Online Payment' datatype='string' name='[Calculation_1292251663611756568]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [is_online_payment]&#13;&#10;WHEN True THEN &apos;OP&apos;&#13;&#10;WHEN False THEN &apos;COD&apos;&#13;&#10;END' />
        </column>
        <column caption='Date' datatype='string' name='[Calculation_1769351764312887301]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    when &apos;Monthly&apos; then [Calculation_1769351764309393410]&#13;&#10;      when &apos;Weekly&apos; then [Calculation_1769351764308762625]&#13;&#10;END' />
        </column>
        <column caption='Queue Time Bucket' datatype='string' name='[Calculation_521854673948651521]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [refund_queue_time]/1440 &gt; 7 THEN &quot;7+ Days&quot;&#13;&#10;ELSEIF [refund_queue_time]/1440 &gt; 3 THEN &quot;3-7 Days&quot;&#13;&#10;ELSEIF [refund_queue_time]/1440 &gt; 1 THEN &quot;1-3 Days&quot;&#13;&#10;ELSEIF [refund_queue_time]/1440 &gt; 0.5 THEN &quot;12-24 Hours&quot;&#13;&#10;ELSEIF [refund_queue_time]/1440 &gt;= 0 THEN &quot;0-12 Hours&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
        </column>
        <column caption='Handling Time Bucket' datatype='string' name='[Calculation_521854674170523650]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if [handling_time_in_minutes]/60 &gt; 48 THEN &quot;2+ Days&quot;&#13;&#10;ELSEIF [handling_time_in_minutes]/60 &gt; 24 THEN &quot;1-2 Days&quot;&#13;&#10;ELSEIF [handling_time_in_minutes]/60 &gt; 12 THEN &quot;12-24 Hours&quot;&#13;&#10;ELSEIF [handling_time_in_minutes]/60 &gt; 1 THEN &quot;1-12 Hours&quot;&#13;&#10;ELSEIF [handling_time_in_minutes]/60 &gt;= 0 THEN &quot;Within 1 Hour&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
        </column>
        <column caption='Resolved Case' datatype='boolean' name='[Calculation_901282894990151683]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [is_resolved_case] = TRUE THEN TRUE &#13;&#10;ELSE FALSE &#13;&#10;END' />
        </column>
        <column caption='Refund Type' datatype='string' name='[Calculation_901282895163277316]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [status_code] IN (55,63,64,65,67,68,592,631,679) THEN &apos;Full Refund&apos;&#13;&#10;ELSE &apos;Partial Refund&apos; &#13;&#10;END' />
        </column>
        <column caption='Refund Triggered' datatype='string' name='[Calculation_901282895170703365]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF ISNULL([triggered_refund_at]) = FALSE THEN &apos;Triggered&apos;&#13;&#10;ELSE &apos;Not Triggered&apos;&#13;&#10;END' />
        </column>
        <column caption='BPO' datatype='string' name='[bpo]' role='dimension' type='nominal' />
        <column caption='Case ID' datatype='string' name='[child_case_id]' role='dimension' type='nominal' />
        <column aggregation='None' caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_1292251663611756568]' derivation='None' name='[none:Calculation_1292251663611756568:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_1769351764312887301]' derivation='None' name='[none:Calculation_1769351764312887301:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_521854673948651521]' derivation='None' name='[none:Calculation_521854673948651521:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_521854674170523650]' derivation='None' name='[none:Calculation_521854674170523650:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_901282894990151683]' derivation='None' name='[none:Calculation_901282894990151683:nk]' pivot='key' type='nominal' />
