        <column-instance column='[Calculation_901282895170703365]' derivation='None' name='[none:Calculation_901282895170703365:nk]' pivot='key' type='nominal' />
        <column-instance column='[bpo]' derivation='None' name='[none:bpo:nk]' pivot='key' type='nominal' />
