      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1ej0yn40fgzxu912nz4jm13c506u (copy)].[ctd:order_code:qk]&quot;' value='Total Refunds' />
