      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#d3b348' fontsize='14'>Contacts Distribution by Payment Type</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Refund Triggers Data' name='federated.1ej0yn40fgzxu912nz4jm13c506u' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Granularity' datatype='string' name='[rdbms_id Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ej0yn40fgzxu912nz4jm13c506u'>
            <column caption='Operational Filter' datatype='boolean' name='[Calculation_1019783890501836800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[refund_triggered_date] &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -6, TODAY()))' />
            </column>
            <column caption='Refund PSP L2' datatype='string' name='[Calculation_1233704888191377423]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[refund_psp_l2]' />
            </column>
            <column caption='Week (string)' datatype='string' name='[Calculation_1769351764308762625]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([refund_triggered_date]) = 1 and ISOYEAR([refund_triggered_date]) = 2019 then &quot;2020-W01&quot;&#13;&#10;ELSEIF ISOWEEK([refund_triggered_date]) &lt; 10 then str(ISOYEAR([refund_triggered_date])) + &quot;-W0&quot; + str(ISOWEEK([refund_triggered_date]))&#13;&#10;ELSE str(ISOYEAR([refund_triggered_date])) + &quot;-W&quot; + str(ISOWEEK([refund_triggered_date]))&#13;&#10;END' />
            </column>
            <column caption='Month (string)' datatype='string' name='[Calculation_1769351764309393410]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([refund_triggered_date]) &lt; 10 then str(YEAR([refund_triggered_date])) + &quot;-0&quot; + str(month([refund_triggered_date]))&#13;&#10;ELSE str(YEAR([refund_triggered_date])) + &quot;-&quot; + str(month([refund_triggered_date]))&#13;&#10;END' />
            </column>
            <column caption='Day (string)' datatype='string' name='[Calculation_1769351764309934083]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([refund_triggered_date]) &lt; 10  then [Calculation_1769351764309393410]+&quot;-0&quot;+str(day([refund_triggered_date]))&#13;&#10;else [Calculation_1769351764309393410]+&quot;-&quot;+str(day([refund_triggered_date]))&#13;&#10;end' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1769351764312887301]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[rdbms_id Parameter]&#13;&#10;    when &apos;Monthly&apos; then [Calculation_1769351764309393410]&#13;&#10;      when &apos;Weekly&apos; then [Calculation_1769351764308762625]&#13;&#10;        when &apos;Daily&apos; then [Calculation_1769351764309934083]&#13;&#10;END' />
            </column>
            <column caption='% Contacts After Refund Trigger' datatype='real' name='[Calculation_521854674518630414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[contacts_contact_after_refund]/[contacts_count]' />
            </column>
            <column caption='Refund Type.' datatype='string' name='[Calculation_903534720989597696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([refund_type]) = TRUE THEN &apos;full_refund&apos; ELSE [refund_type] END' />
            </column>
            <column caption='Refund PSP L1' datatype='string' name='[Calculation_903534720990162945]' role='dimension' type='nominal'>
