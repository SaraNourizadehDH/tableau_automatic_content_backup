    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Wallet Refunds Deepdive'>
      <repository-location derived-from='http://ip-172-31-0-197:8196/t/Foodora/workbooks/APACIncompleteRefunds/WalletRefundsDeepdive?rev=' id='WalletRefundsDeepdive' path='/t/Foodora/workbooks/APACIncompleteRefunds' revision='' site='Foodora' />
      <style>
        <style-rule element='parameter-ctrl'>
          <format attr='background-color' value='#606b76' />
        </style-rule>
      </style>
      <size maxheight='2900' maxwidth='1500' minheight='2900' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Refund Triggers Data' name='federated.1ej0yn40fgzxu912nz4jm13c506u' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Time Granularity' datatype='string' name='[rdbms_id Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
          <calculation class='tableau' formula='&quot;Monthly&quot;' />
          <members>
            <member value='&quot;Daily&quot;' />
            <member value='&quot;Weekly&quot;' />
            <member value='&quot;Monthly&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1ej0yn40fgzxu912nz4jm13c506u'>
        <column caption='Date' datatype='string' name='[Calculation_1769351764312887301]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='Case [Parameters].[rdbms_id Parameter]&#13;&#10;    when &apos;Monthly&apos; then [Calculation_1769351764309393410]&#13;&#10;      when &apos;Weekly&apos; then [Calculation_1769351764308762625]&#13;&#10;        when &apos;Daily&apos; then [Calculation_1769351764309934083]&#13;&#10;END' />
        </column>
        <column caption='Country - Wallets' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
        <column caption='Decline Reason Code' datatype='string' name='[decline_reason_code]' role='dimension' type='nominal' />
        <column caption='Expedition Type' datatype='string' name='[expedition_type]' role='dimension' type='nominal' />
        <column caption='Is billable' datatype='boolean' name='[is_billable]' role='dimension' type='nominal' />
