      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0oa0d2v12ow21113yijc00kc4htp].[cnt:case_id:qk]&quot;' value='Count of Cases' />
          <alias key='&quot;[federated.0oa0d2v12ow21113yijc00kc4htp].[sum:escalation_time_min:qk]&quot;' value='Escalation Time' />
          <alias key='&quot;[federated.0oa0d2v12ow21113yijc00kc4htp].[sum:processing_time_min:qk]&quot;' value='Refund Processing Time' />
          <alias key='&quot;[federated.0oa0d2v12ow21113yijc00kc4htp].[sum:refund_amount:qk]&quot;' value='Amount Local' />
          <alias key='&quot;[federated.0oa0d2v12ow21113yijc00kc4htp].[sum:total_time_min:qk]&quot;' value='Total Resolution Time' />
        </aliases>
      </column>
      <column caption='Backlog Tickets' datatype='integer' name='[AVG_full_res_time_m  (copy)_1292251663298580490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_resolved_case] = FALSE THEN [child_case_id] END)' />
      </column>
      <column caption='Cases_within_SLA' datatype='integer' name='[AVG_full_res_time_m  (copy)_1292251663301603341]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [total_time_min]/60 &lt;= 24 THEN [child_case_id] END)' />
      </column>
      <column caption='Full Resolution Time' datatype='real' name='[AVG_refund_pro_time_m (copy)_1292251663292702725]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_time_min])/60)/COUNT([child_case_id])' />
      </column>
      <column caption='Refund Processing Time' datatype='real' name='[AVG_refund_pro_time_w (copy)_1292251663292039172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([processing_time_min])/1440)/COUNT(IF ISNULL([child_ticket_solved_at]) = FALSE THEN [child_case_id] END)' />
      </column>
      <column caption='% Backlog Tickets' datatype='real' default-format='p0.00%' name='[Backlog Tickets (copy)_901282894983667713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_resolved_case] = FALSE THEN [child_case_id] END)/COUNTD([child_case_id])' />
      </column>
      <column caption='week_number' datatype='integer' name='[Calculation_1292251663291305984]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;week&apos;,[child_ticket_created_at])' />
      </column>
      <column caption='Gran Filter' datatype='string' name='[Calculation_1292251663303307281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Online Payment' datatype='string' name='[Calculation_1292251663611756568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [is_online_payment]&#13;&#10;WHEN True THEN &apos;OP&apos;&#13;&#10;WHEN False THEN &apos;COD&apos;&#13;&#10;END' />
      </column>
      <column caption='Week (string)' datatype='string' name='[Calculation_1769351764308762625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISOWEEK([child_ticket_created_at]) = 1 and ISOYEAR([child_ticket_created_at]) = 2021 then &quot;2022-W01&quot;&#13;&#10;ELSEIF ISOWEEK([child_ticket_created_at]) &lt; 10 then str(ISOYEAR([child_ticket_created_at])) + &quot;-W0&quot; + str(ISOWEEK([child_ticket_created_at]))&#13;&#10;ELSE str(ISOYEAR([child_ticket_created_at])) + &quot;-W&quot; + str(ISOWEEK([child_ticket_created_at]))&#13;&#10;END' />
      </column>
      <column caption='Month (string)' datatype='string' name='[Calculation_1769351764309393410]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([child_ticket_created_at]) &lt; 10 then str(YEAR([child_ticket_created_at])) + &quot;-0&quot; + str(month([child_ticket_created_at]))&#13;&#10;ELSE str(YEAR([child_ticket_created_at])) + &quot;-&quot; + str(month([child_ticket_created_at]))&#13;&#10;END' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_1769351764312887301]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    when &apos;Monthly&apos; then [Calculation_1769351764309393410]&#13;&#10;      when &apos;Weekly&apos; then [Calculation_1769351764308762625]&#13;&#10;END' />
      </column>
      <column caption='Operational Filter' datatype='boolean' name='[Calculation_1810939656601174016]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[child_ticket_created_at] &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -5, TODAY()))' />
      </column>
      <column caption='Amount EUR' datatype='real' default-format='c&quot;€&quot;#,##0.00;(&quot;€&quot;#,##0.00)' name='[Calculation_256705224580706304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[refund_amount_eur]' />
      </column>
      <column caption='Queue Time Bucket' datatype='string' name='[Calculation_521854673948651521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [refund_queue_time]/1440 &gt; 7 THEN &quot;7+ Days&quot;&#13;&#10;ELSEIF [refund_queue_time]/1440 &gt; 3 THEN &quot;3-7 Days&quot;&#13;&#10;ELSEIF [refund_queue_time]/1440 &gt; 1 THEN &quot;1-3 Days&quot;&#13;&#10;ELSEIF [refund_queue_time]/1440 &gt; 0.5 THEN &quot;12-24 Hours&quot;&#13;&#10;ELSEIF [refund_queue_time]/1440 &gt;= 0 THEN &quot;0-12 Hours&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
      </column>
      <column caption='Handling Time Bucket' datatype='string' name='[Calculation_521854674170523650]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [handling_time_in_minutes]/60 &gt; 48 THEN &quot;2+ Days&quot;&#13;&#10;ELSEIF [handling_time_in_minutes]/60 &gt; 24 THEN &quot;1-2 Days&quot;&#13;&#10;ELSEIF [handling_time_in_minutes]/60 &gt; 12 THEN &quot;12-24 Hours&quot;&#13;&#10;ELSEIF [handling_time_in_minutes]/60 &gt; 1 THEN &quot;1-12 Hours&quot;&#13;&#10;ELSEIF [handling_time_in_minutes]/60 &gt;= 0 THEN &quot;Within 1 Hour&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
      </column>
      <column caption='FCR%' datatype='real' name='[Calculation_521854674176622598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([fcr_ind])/sum([total_ccr_contacts])' />
      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_521854674183376907]' role='measure' type='nominal'>
        <calculation class='tableau' formula='If [AVG_refund_pro_time_w (copy)_1292251663292039172]/1440 &gt; 7 THEN &quot;7+ Days&quot;&#13;&#10;ELSEIF [AVG_refund_pro_time_w (copy)_1292251663292039172]/1440 &gt; 3 THEN &quot;3-7 Days&quot;&#13;&#10;ELSEIF [AVG_refund_pro_time_w (copy)_1292251663292039172]/1440 &gt; 1 THEN &quot;1-3 Days&quot;&#13;&#10;ELSEIF [AVG_refund_pro_time_w (copy)_1292251663292039172]/1440 &gt; 0.5 THEN &quot;12-24 Hours&quot;&#13;&#10;ELSEIF [AVG_refund_pro_time_w (copy)_1292251663292039172]/1440 &gt;= 0 THEN &quot;0-12 Hours&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
      </column>
      <column caption='Resolved Case' datatype='boolean' name='[Calculation_901282894990151683]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_resolved_case] = TRUE THEN TRUE &#13;&#10;ELSE FALSE &#13;&#10;END' />
      </column>
      <column caption='Refund Type' datatype='string' name='[Calculation_901282895163277316]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [status_code] IN (55,63,64,65,67,68,592,631,679) THEN &apos;Full Refund&apos;&#13;&#10;ELSE &apos;Partial Refund&apos; &#13;&#10;END' />
      </column>
      <column caption='Refund Triggered' datatype='string' name='[Calculation_901282895170703365]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([triggered_refund_at]) = FALSE THEN &apos;Triggered&apos;&#13;&#10;ELSE &apos;Not Triggered&apos;&#13;&#10;END' />
      </column>
      <column caption='triggereing_time_min' datatype='integer' name='[Calculation_901282895284174862]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;, [child_ticket_solved_at], [triggered_refund_at])' />
      </column>
      <column caption='Trigger Time' datatype='real' name='[Calculation_901282895285415951]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_901282895284174862])/1440)/COUNT([child_case_id])' />
      </column>
      <column aggregation='None' caption='Country (copy)' datatype='string' name='[Country (copy)_3889139780344971264]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='[country]' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='% Cases_cases_within_SLA' datatype='real' default-format='p0%' name='[Percent_SLA_followed_w (copy)_1292251663305973780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [total_time_min]/60 &lt;= 24 THEN [child_case_id] END)/COUNTD([child_case_id])' />
      </column>
      <column caption='Resolution Time Bucket' datatype='string' name='[Queue Time Bucket (copy)_521854674190299148]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if sum([total_time_min])/1440 &gt; 7 THEN &quot;7+ Days&quot;&#13;&#10;ELSEIF sum([total_time_min])/1440 &gt; 3 THEN &quot;3-7 Days&quot;&#13;&#10;ELSEIF sum([total_time_min])/1440 &gt; 1 THEN &quot;1-3 Days&quot;&#13;&#10;ELSEIF sum([total_time_min])/1440 &gt; 0.5 THEN &quot;12-24 Hours&quot;&#13;&#10;ELSEIF sum([total_time_min])/1440 &gt;= 0 THEN &quot;0-12 Hours&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
      </column>
