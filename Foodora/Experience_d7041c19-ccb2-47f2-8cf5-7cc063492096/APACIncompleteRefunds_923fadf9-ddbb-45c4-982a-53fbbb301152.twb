      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(COUNT([order_code])) - LOOKUP(ZN(COUNT([order_code])), -1)) / ABS(LOOKUP(ZN(COUNT([order_code])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Decline Reason Code.' datatype='string' name='[Calculation_1205768450120732676]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [status_code]=&quot;67&quot; &#10;&#9;THEN &quot;CUSTOMER_ONLINE_PAYMENT_PROBLEM&quot;&#10;&#9;ELSE [decline_reason_code]&#10;END' />
      </column>
      <column caption='Online Payment' datatype='string' name='[Calculation_1292251663611756568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [is_online_payment]&#13;&#10;WHEN True THEN &apos;OP&apos;&#13;&#10;WHEN False THEN &apos;COD&apos;&#13;&#10;END' />
      </column>
      <column caption='Week (string)' datatype='string' name='[Calculation_1769351764308762625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([order_date_utc]) = 1 and ISOYEAR([order_date_utc]) = 2019 then &quot;2020-W01&quot;&#13;&#10;ELSEIF ISOWEEK([order_date_utc]) &lt; 10 then str(ISOYEAR([order_date_utc])) + &quot;-W0&quot; + str(ISOWEEK([order_date_utc]))&#13;&#10;ELSE str(ISOYEAR([order_date_utc])) + &quot;-W&quot; + str(ISOWEEK([order_date_utc]))&#13;&#10;END' />
      </column>
      <column caption='Month (string)' datatype='string' name='[Calculation_1769351764309393410]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([order_date_utc]) &lt; 10 then str(YEAR([order_date_utc])) + &quot;-0&quot; + str(month([order_date_utc]))&#13;&#10;ELSE str(YEAR([order_date_utc])) + &quot;-&quot; + str(month([order_date_utc]))&#13;&#10;END' />
      </column>
      <column caption='Day (string)' datatype='string' name='[Calculation_1769351764309934083]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if day([order_date_utc]) &lt; 10  then [Calculation_1769351764309393410]+&quot;-0&quot;+str(day([order_date_utc]))&#13;&#10;else [Calculation_1769351764309393410]+&quot;-&quot;+str(day([order_date_utc]))&#13;&#10;end' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_1769351764312887301]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[rdbms_id Parameter]&#13;&#10;    when &apos;Monthly&apos; then [Calculation_1769351764309393410]&#13;&#10;      when &apos;Weekly&apos; then [Calculation_1769351764308762625]&#13;&#10;        when &apos;Daily&apos; then [Calculation_1769351764309934083]&#13;&#10;END' />
      </column>
      <column caption='Is Refund Triggered' datatype='boolean' name='[Calculation_496240420723777536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([payment_refund_date]) = TRUE THEN FALSE ELSE TRUE END' />
