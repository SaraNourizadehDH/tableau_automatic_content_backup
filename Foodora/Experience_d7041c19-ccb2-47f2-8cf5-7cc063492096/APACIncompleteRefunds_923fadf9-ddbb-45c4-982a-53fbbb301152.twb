      <aliases enabled='yes' />
      <column caption='Week (string)' datatype='string' name='[Calculation_1769351764308762625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([order_date_local]) = 1 and ISOYEAR([order_date_local]) = 2019 then &quot;2020-W01&quot;&#13;&#10;ELSEIF ISOWEEK([order_date_local]) &lt; 10 then str(ISOYEAR([order_date_local])) + &quot;-W0&quot; + str(ISOWEEK([order_date_local]))&#13;&#10;ELSE str(ISOYEAR([order_date_local])) + &quot;-W&quot; + str(ISOWEEK([order_date_local]))&#13;&#10;END' />
      </column>
      <column caption='Month (string)' datatype='string' name='[Calculation_1769351764309393410]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([order_date_local]) &lt; 10 then str(YEAR([order_date_local])) + &quot;-0&quot; + str(month([order_date_local]))&#13;&#10;ELSE str(YEAR([order_date_local])) + &quot;-&quot; + str(month([order_date_local]))&#13;&#10;END' />
      </column>
      <column caption='Day (string)' datatype='string' name='[Calculation_1769351764309934083]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if day([order_date_local]) &lt; 10  then [Calculation_1769351764309393410]+&quot;-0&quot;+str(day([order_date_local]))&#13;&#10;else [Calculation_1769351764309393410]+&quot;-&quot;+str(day([order_date_local]))&#13;&#10;end' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_1769351764312887301]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[rdbms_id Parameter]&#13;&#10;    when &apos;Monthly&apos; then [Calculation_1769351764309393410]&#13;&#10;      when &apos;Weekly&apos; then [Calculation_1769351764308762625]&#13;&#10;        when &apos;Daily&apos; then [Calculation_1769351764309934083]&#13;&#10;END' />
      </column>
