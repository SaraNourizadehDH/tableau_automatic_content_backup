            <column>[federated.1i1ywo20j5utio0zizpqb1231iz1].[none:report_date:qk]</column>
            <column>[federated.1i1ywo20j5utio0zizpqb1231iz1].[none:Survey Type (copy)_3935372028547878918:nk]</column>
            <column>[federated.1i1ywo20j5utio0zizpqb1231iz1].[none:NPS Reason Delivery Filter (copy)_1093811808329007119:nk]</column>
            <column>[federated.1i1ywo20j5utio0zizpqb1231iz1].[none:Survey Vertical (copy)_4394739201140404224:nk]</column>
            <column>[federated.1i1ywo20j5utio0zizpqb1231iz1].[my:report_date:ok]</column>
            <column>[federated.1i1ywo20j5utio0zizpqb1231iz1].[none:Survey Type. (copy)_4394739201143726081:nk]</column>
