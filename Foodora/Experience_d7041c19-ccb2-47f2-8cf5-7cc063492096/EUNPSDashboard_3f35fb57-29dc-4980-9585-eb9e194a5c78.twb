    <worksheet name='NPS  Finding App Chioces Filter Distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#606b76' fontsize='12'>Finding App Choices Sub Reasons Distribution</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_nps_report_overview (pandata_report) ' name='federated.1i1ywo20j5utio0zizpqb1231iz1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[rdbms_id Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1i1ywo20j5utio0zizpqb1231iz1'>
            <column caption='Week (string)' datatype='string' name='[Calculation_1769351764308762625]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISOWEEK([report_date]) = 1 and ISOYEAR([report_date]) = 2023 then &quot;2024-W01&quot;&#13;&#10;ELSEIF ISOWEEK([report_date]) &lt; 10 then STR(ISOYEAR([report_date])) + &quot;-W0&quot; + STR(ISOWEEK([report_date]))&#13;&#10;ELSE STR(ISOYEAR([report_date])) + &quot;-W&quot; + STR(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Month (string)' datatype='string' name='[Calculation_1769351764309393410]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([report_date]) &lt; 10 then STR(YEAR([report_date])) + &quot;-0&quot; + STR(MONTH([report_date]))&#13;&#10;ELSE STR(YEAR([report_date])) + &quot;-&quot; + STR(MONTH([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day (string)' datatype='string' name='[Calculation_1769351764309934083]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DAY([report_date]) &lt; 10 THEN [Calculation_1769351764309393410] + &quot;-0&quot; + STR(DAY([report_date]))&#13;&#10;ELSE [Calculation_1769351764309393410] + &quot;-&quot; + STR(DAY([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1769351764312887301]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[rdbms_id Parameter]&#13;&#10;    when &apos;Monthly&apos; then [Calculation_1769351764309393410]&#13;&#10;      when &apos;Weekly&apos; then [Calculation_1769351764308762625]&#13;&#10;        when &apos;Daily&apos; then [Calculation_1769351764309934083]&#13;&#10;END' />
            </column>
            <column caption='NPS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3935372028478423040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [nps_group] = &quot;Promoter&quot; THEN [responses] END) - SUM(IF [nps_group] = &quot;Detractor&quot; THEN [responses] END))/&#10;SUM([responses])) * 100' />
            </column>
            <column caption='NPS Reason Finding App Chioces Filter' datatype='boolean' name='[NPS Reason Delivery Filter (copy)_1093811808329007119]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER([nps_reason]), &apos;variety and ease of ordering&apos;) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Survey Type (View Filter)' datatype='string' name='[Survey Type (copy)_3935372028547878918]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[survey_type]' />
            </column>
            <column caption='Survey Type' datatype='string' name='[Survey Type. (copy)_4394739201143726081]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [survey_type] = &quot;AO NPS&quot; THEN &quot;After Order NPS&quot;&#10;ELSEIF [survey_type] = &quot;R NPS&quot; THEN &quot;Relational NPS&quot;&#10;END' />
            </column>
            <column caption='Survey Vertical' datatype='string' name='[Survey Vertical (copy)_4394739201140404224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [survey_vertical] = &quot;NA&quot; THEN &quot;Null&quot; &#10;ELSEIF ISNULL([survey_vertical]) = TRUE THEN &quot;Null&quot;&#10;ELSE [survey_vertical]&#10;END' />
            </column>
            <column-instance column='[reason_finding_app_choice]' derivation='Attribute' name='[attr:reason_finding_app_choice:nk]' pivot='key' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[report_date]' derivation='MY' name='[my:report_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1769351764312887301]' derivation='None' name='[none:Calculation_1769351764312887301:nk]' pivot='key' type='nominal' />
            <column-instance column='[NPS Reason Delivery Filter (copy)_1093811808329007119]' derivation='None' name='[none:NPS Reason Delivery Filter (copy)_1093811808329007119:nk]' pivot='key' type='nominal' />
            <column-instance column='[Survey Type (copy)_3935372028547878918]' derivation='None' name='[none:Survey Type (copy)_3935372028547878918:nk]' pivot='key' type='nominal' />
            <column-instance column='[Survey Type. (copy)_4394739201143726081]' derivation='None' name='[none:Survey Type. (copy)_4394739201143726081:nk]' pivot='key' type='nominal' />
            <column-instance column='[Survey Vertical (copy)_4394739201140404224]' derivation='None' name='[none:Survey Vertical (copy)_4394739201140404224:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[nps_group]' derivation='None' name='[none:nps_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[reason_finding_app_choice]' derivation='None' name='[none:reason_finding_app_choice:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
            <column caption='NPS Group' datatype='string' name='[nps_group]' role='dimension' type='nominal' />
            <column caption='Nps Reason' datatype='string' name='[nps_reason]' role='dimension' type='nominal' />
            <column-instance column='[responses]' derivation='Sum' name='[pcto:sum:responses:qk:5]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
            <column caption='Reason Finding App Choice' datatype='string' name='[reason_finding_app_choice]' role='dimension' type='nominal' />
            <column caption='Survey Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column caption='Responses' datatype='integer' name='[responses]' role='measure' type='quantitative' />
            <column-instance column='[responses]' derivation='Sum' name='[sum:responses:qk]' pivot='key' type='quantitative' />
            <column caption='Survey Type.' datatype='string' name='[survey_type]' role='dimension' type='nominal' />
            <column caption='Survey Vertical.' datatype='string' name='[survey_vertical]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3935372028478423040]' derivation='User' name='[usr:Calculation_3935372028478423040:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1i1ywo20j5utio0zizpqb1231iz1].[none:NPS Reason Delivery Filter (copy)_1093811808329007119:nk]'>
            <groupfilter function='member' level='[none:NPS Reason Delivery Filter (copy)_1093811808329007119:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1i1ywo20j5utio0zizpqb1231iz1].[none:Survey Type (copy)_3935372028547878918:nk]' filter-group='3'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Survey Type (copy)_3935372028547878918:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:Survey Type (copy)_3935372028547878918:nk]' member='&quot;AO NPS&quot;' />
                <groupfilter function='member' level='[none:Survey Type (copy)_3935372028547878918:nk]' member='%null%' />
              </groupfilter>
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.1i1ywo20j5utio0zizpqb1231iz1].[none:nps_group:nk]</column>
