    <worksheet name='Delivery Experience Deepdive'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#d3b348' fontname='Tableau Book'>Delivery</run>
            <run fontalignment='1' fontcolor='#d3b348'> Experience Deepdive</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_eu_cx_nps_report_deepdive (pandata_report) ' name='federated.1i3mmwx0c473mg12988us0aqpsvo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Granularity' datatype='string' name='[rdbms_id Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1i3mmwx0c473mg12988us0aqpsvo'>
            <column caption='.Delivery: % Inf Cancelled Orders' datatype='real' default-format='p0.00%' name='[% Chain Orders (copy)_4254353546808905759]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [inf_cancelled_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [gross_orders] END)' />
            </column>
            <column caption='.Delivery: % On Time Orders' datatype='real' default-format='p0.00%' name='[% Chain Orders (copy)_4254353546809331746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [on_time_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_orders] END)' />
            </column>
            <column caption='.Delivery: % Stacked Orders' datatype='real' default-format='p0.00%' name='[% Chain Orders (copy)_4254353546810540072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [stacked_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [od_orders] END)' />
            </column>
            <column caption='.Delivery: % Seamless Orders' datatype='real' default-format='p0.00%' name='[% Chain Orders (copy)_4254353546810740777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [seamless_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [od_orders] END)' />
            </column>
            <column caption='.Delivery: % OD Orders' datatype='real' default-format='p0.00%' name='[% Chain Orders (copy)_4254353546810884138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [od_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [gross_orders] END)' />
            </column>
            <column caption='.Delivery: % Inf Cancelled Orders after 15 Min' datatype='real' default-format='p0.00%' name='[% Inf Cancelled Orders (copy)_4254353546809024544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [inf_cancelled_orders_after_15_min] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [gross_orders] END)' />
            </column>
            <column caption='.Delivery: % Inf Cancelled Orders after 60 Min' datatype='real' default-format='p0.00%' name='[% Inf Cancelled Orders after 15 Min (copy)_4254353546809212961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [inf_cancelled_orders_after_60_min] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [gross_orders] END)' />
            </column>
            <column caption='.Delivery: % Orders with DT less than 20 Min' datatype='real' default-format='p0.00%' name='[% Inf Cancelled Orders after 60 Min (copy)_4254353546809774115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [less_than_20_min_dt_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_orders] END)' />
            </column>
            <column caption='.Delivery: % Orders with DT more than 45 Min' datatype='real' default-format='p0.00%' name='[% Orders with DT less than 20 Min (copy)_4254353546810101796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [more_than_45_min_dt_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_orders] END)' />
            </column>
            <column caption='.Delivery: % Orders with DT more than 60 Min' datatype='real' default-format='p0.00%' name='[% Orders with DT more than 45 Min (copy)_4254353546810216485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [more_than_60_min_dt_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_orders] END)' />
            </column>
            <column caption='.Delivery: % Orders with Delay more than 10 Min' datatype='real' default-format='p0.00%' name='[% Orders with DT more than 60 Min (copy)_4254353546810318886]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [more_than_10_min_delayd_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_orders] END)' />
            </column>
            <column caption='.Delivery: % Orders with Delay more than 20 Min' datatype='real' default-format='p0.00%' name='[% Orders with Delay more than 10 Min (copy)_4254353546810437671]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [more_than_20_min_delayd_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_orders] END)' />
            </column>
            <column caption='.Delivery: AVG Inf Cancellation Time (Min)' datatype='real' name='[AVG Delivery Time (Min) (copy)_4254353546808791070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [time_to_inf_cancel_in_min] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [gross_orders] END)' />
            </column>
            <column caption='.Delivery: AVG Delivery Time (Min)' datatype='real' name='[AVG Order Time (Min) (copy)_4254353546808553501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_time_in_minute] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_orders] END)' />
            </column>
            <column caption='Week (string)' datatype='string' name='[Calculation_1769351764308762625]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISOWEEK([report_date]) = 1 and ISOYEAR([report_date]) = 2023 then &quot;2024-W01&quot;&#13;&#10;ELSEIF ISOWEEK([report_date]) &lt; 10 then STR(ISOYEAR([report_date])) + &quot;-W0&quot; + STR(ISOWEEK([report_date]))&#13;&#10;ELSE STR(ISOYEAR([report_date])) + &quot;-W&quot; + STR(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Month (string)' datatype='string' name='[Calculation_1769351764309393410]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([report_date]) &lt; 10 then STR(YEAR([report_date])) + &quot;-0&quot; + STR(MONTH([report_date]))&#13;&#10;ELSE STR(YEAR([report_date])) + &quot;-&quot; + STR(MONTH([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day (string)' datatype='string' name='[Calculation_1769351764309934083]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DAY([report_date]) &lt; 10 THEN [Calculation_1769351764309393410] + &quot;-0&quot; + STR(DAY([report_date]))&#13;&#10;ELSE [Calculation_1769351764309393410] + &quot;-&quot; + STR(DAY([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1769351764312887301]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[rdbms_id Parameter]&#13;&#10;    when &apos;Monthly&apos; then [Calculation_1769351764309393410]&#13;&#10;      when &apos;Weekly&apos; then [Calculation_1769351764308762625]&#13;&#10;        when &apos;Daily&apos; then [Calculation_1769351764309934083]&#13;&#10;END' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_4254353546462375941]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#10;WHEN &quot;Country&quot; THEN [country]&#10;WHEN &quot;Survey Vertical&quot; THEN [survey_vertical]&#10;WHEN &quot;Segment&quot; THEN [lifecycle_segment]&#10;END' />
            </column>
            <column caption='.Delivery: NPS - Cancellation and Delivery' datatype='real' name='[NPS Product: Quality and Accuracy (copy)_4254353546623283223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) AND [nps_group] = &quot;Promoter&quot; THEN [responses] END) - SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) AND [nps_group] = &quot;Detractor&quot; THEN [responses] END))/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [responses] END)) * 100' />
            </column>
