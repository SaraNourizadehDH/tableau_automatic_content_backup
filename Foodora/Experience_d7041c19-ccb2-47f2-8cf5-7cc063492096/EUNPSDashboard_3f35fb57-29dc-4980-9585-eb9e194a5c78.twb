      <aliases enabled='yes' />
      <column caption='Passive' datatype='real' default-format='p0.00%' name='[% Detractors (copy)_3935372028481835011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_group] = &quot;Passive&quot; THEN [responses] END)/SUM([responses])' />
      </column>
      <column caption='Detractors' datatype='real' default-format='p0.00%' name='[% Promoters (copy)_3935372028481642498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_group] = &quot;Detractor&quot; THEN [responses] END)/SUM([responses])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1i1ywo20j5utio0zizpqb1231iz1].[ctd:response_id:qk]&quot;' value='Response Count' />
        </aliases>
      </column>
      <column caption='Week (string)' datatype='string' name='[Calculation_1769351764308762625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISOWEEK([report_date]) = 1 and ISOYEAR([report_date]) = 2023 then &quot;2024-W01&quot;&#13;&#10;ELSEIF ISOWEEK([report_date]) &lt; 10 then STR(ISOYEAR([report_date])) + &quot;-W0&quot; + STR(ISOWEEK([report_date]))&#13;&#10;ELSE STR(ISOYEAR([report_date])) + &quot;-W&quot; + STR(ISOWEEK([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Month (string)' datatype='string' name='[Calculation_1769351764309393410]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF MONTH([report_date]) &lt; 10 then STR(YEAR([report_date])) + &quot;-0&quot; + STR(MONTH([report_date]))&#13;&#10;ELSE STR(YEAR([report_date])) + &quot;-&quot; + STR(MONTH([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Day (string)' datatype='string' name='[Calculation_1769351764309934083]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DAY([report_date]) &lt; 10 THEN [Calculation_1769351764309393410] + &quot;-0&quot; + STR(DAY([report_date]))&#13;&#10;ELSE [Calculation_1769351764309393410] + &quot;-&quot; + STR(DAY([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_1769351764312887301]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[rdbms_id Parameter]&#13;&#10;    when &apos;Monthly&apos; then [Calculation_1769351764309393410]&#13;&#10;      when &apos;Weekly&apos; then [Calculation_1769351764308762625]&#13;&#10;        when &apos;Daily&apos; then [Calculation_1769351764309934083]&#13;&#10;END' />
      </column>
      <column caption='NPS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3935372028478423040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(IF [nps_group] = &quot;Promoter&quot; THEN [responses] END) - SUM(IF [nps_group] = &quot;Detractor&quot; THEN [responses] END))/&#10;SUM([responses])) * 100' />
      </column>
      <column caption='NPS Reason Sub Attribute' datatype='string' name='[Calculation_4440267785500549123]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [NPS Reason Application Filter (copy)_1093811808328126477] = TRUE THEN [reason_cancelled]&#10;ELSEIF [NPS Reason Cancellation Filter (copy)_3935372028723585032] = TRUE THEN [reason_deals_discount]&#10;ELSEIF [NPS Reason Cancellation Filter (copy)_1093811808328630286] = TRUE THEN [reason_delivery]&#10;ELSEIF [NPS Reason Delivery Filter (copy)_1093811808329007119] = TRUE THEN [reason_finding_app_choice]&#10;ELSEIF [NPS Reason Payment Process Filter (copy)_1093811808329396240] = TRUE THEN [reason_pickup]&#10;ELSEIF [NPS Reason Pick up Filter (copy)_1093811808329801745] = TRUE THEN [reason_pricing]&#10;ELSEIF [NPS Reason Pricing Filter (copy)_1093811808330657810] = TRUE THEN [reason_quality_accuracy]&#10;ELSEIF [NPS Reason Quality and accuracy Filter (copy)_1093811808331087891] = TRUE THEN [reason_service_support]&#10;END' />
      </column>
      <column caption='Promoters' datatype='real' default-format='p0.00%' name='[NPS (copy)_3935372028481425409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_group] = &quot;Promoter&quot; THEN [responses] END)/SUM([responses])' />
      </column>
      <column caption='NPS Reason Cancellation Filter' datatype='boolean' name='[NPS Reason Application Filter (copy)_1093811808328126477]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([nps_reason]), &apos;cancellation&apos;) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='NPS Reason Delivery Filter' datatype='boolean' name='[NPS Reason Cancellation Filter (copy)_1093811808328630286]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([nps_reason]), &apos;delivery&apos;) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='NPS Reason Deals and Discount Filter' datatype='boolean' name='[NPS Reason Cancellation Filter (copy)_3935372028723585032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([nps_reason]), &apos;deals and discounts&apos;) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='NPS Reason Finding App Chioces Filter' datatype='boolean' name='[NPS Reason Delivery Filter (copy)_1093811808329007119]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([nps_reason]), &apos;variety and ease of ordering&apos;) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='NPS Reason Pick up Filter' datatype='boolean' name='[NPS Reason Payment Process Filter (copy)_1093811808329396240]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([nps_reason]), &apos;pick-up&apos;) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='NPS Reason Pricing Filter' datatype='boolean' name='[NPS Reason Pick up Filter (copy)_1093811808329801745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([nps_reason]), &apos;pricing&apos;) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='NPS Reason Quality and Accuracy Filter' datatype='boolean' name='[NPS Reason Pricing Filter (copy)_1093811808330657810]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([nps_reason]), &apos;quality and accuracy&apos;) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='NPS Reason Service and Support Filter' datatype='boolean' name='[NPS Reason Quality and accuracy Filter (copy)_1093811808331087891]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([nps_reason]), &apos;customer service&apos;) THEN TRUE ELSE FALSE END' />
