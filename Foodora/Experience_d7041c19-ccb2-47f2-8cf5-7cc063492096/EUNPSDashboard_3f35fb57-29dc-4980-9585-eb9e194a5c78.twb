      <aliases enabled='yes' />
      <column caption='.Service: % CSAT' datatype='real' default-format='p0.00%' name='[% CVR (copy)_4254353546853806128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] = &quot;Customer service&quot; THEN [csat_promoters] END)/&#10;SUM(IF [nps_reason] = &quot;Customer service&quot; THEN [csat_responses] END)' />
      </column>
      <column caption='.Delivery: % Inf Cancelled Orders' datatype='real' default-format='p0.00%' name='[% Chain Orders (copy)_4254353546808905759]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [inf_cancelled_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [gross_orders] END)' />
      </column>
      <column caption='.Delivery: % On Time Orders' datatype='real' default-format='p0.00%' name='[% Chain Orders (copy)_4254353546809331746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [on_time_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_orders] END)' />
      </column>
      <column caption='.Delivery: % Stacked Orders' datatype='real' default-format='p0.00%' name='[% Chain Orders (copy)_4254353546810540072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [stacked_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [od_orders] END)' />
      </column>
      <column caption='.Delivery: % Seamless Orders' datatype='real' default-format='p0.00%' name='[% Chain Orders (copy)_4254353546810740777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [seamless_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [od_orders] END)' />
      </column>
      <column caption='.Delivery: % OD Orders' datatype='real' default-format='p0.00%' name='[% Chain Orders (copy)_4254353546810884138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [od_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [gross_orders] END)' />
      </column>
      <column caption='.Service: % HC Intent' datatype='real' default-format='p0.00%' name='[% Chain Orders (copy)_4254353546851573803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] = &quot;Customer service&quot; THEN [hc_intent_orders] END)/&#10;SUM(IF [nps_reason] = &quot;Customer service&quot; THEN [gross_orders] END)' />
      </column>
      <column caption='.Service: % Contact Rate Delay' datatype='real' default-format='p0.00%' name='[% Contact Rate (copy)_4254353546851979310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] = &quot;Customer service&quot; THEN [delay_contacts] END)/&#10;SUM(IF [nps_reason] = &quot;Customer service&quot; THEN [gross_orders] END)' />
      </column>
      <column caption='.Service: % Contact Rate PD' datatype='real' default-format='p0.00%' name='[% Contact Rate Delay (copy)_4254353546852048943]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] = &quot;Customer service&quot; THEN [pd_contacts] END)/&#10;SUM(IF [nps_reason] = &quot;Customer service&quot; THEN [gross_orders] END)' />
      </column>
      <column caption='.Service: % Deflection' datatype='real' default-format='p0.00%' name='[% HC Intent (copy)_4254353546851676204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(SUM(IF [nps_reason] = &quot;Customer service&quot; THEN [non_deflected_session] END)/&#10;   SUM(IF [nps_reason] = &quot;Customer service&quot; THEN [resolution_page_sessions] END))' />
      </column>
      <column caption='.Service: % Contact Rate' datatype='real' default-format='p0.00%' name='[% HC Intent (copy)_4254353546851889197]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] = &quot;Customer service&quot; THEN [contacts] END)/&#10;SUM(IF [nps_reason] = &quot;Customer service&quot; THEN [gross_orders] END)' />
      </column>
      <column caption='.Delivery: % Inf Cancelled Orders after 15 Min' datatype='real' default-format='p0.00%' name='[% Inf Cancelled Orders (copy)_4254353546809024544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [inf_cancelled_orders_after_15_min] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [gross_orders] END)' />
      </column>
      <column caption='.Delivery: % Inf Cancelled Orders after 60 Min' datatype='real' default-format='p0.00%' name='[% Inf Cancelled Orders after 15 Min (copy)_4254353546809212961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [inf_cancelled_orders_after_60_min] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [gross_orders] END)' />
      </column>
      <column caption='.Delivery: % Orders with DT less than 20 Min' datatype='real' default-format='p0.00%' name='[% Inf Cancelled Orders after 60 Min (copy)_4254353546809774115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [less_than_20_min_dt_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_orders] END)' />
      </column>
      <column caption='.Affordability: % Orders with Discount or Voucher' datatype='real' default-format='p0.00%' name='[% Orders DF and SVC Fee/AFV &gt; 20% (copy)_4254353546614644752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Pricing&quot;, &quot;Deals and discounts&quot;) THEN [orders_with_incentive] END)/&#10;SUM(IF [nps_reason] IN (&quot;Pricing&quot;, &quot;Deals and discounts&quot;) THEN [gross_orders] END)' />
      </column>
      <column caption='.Delivery: % Orders with DT more than 45 Min' datatype='real' default-format='p0.00%' name='[% Orders with DT less than 20 Min (copy)_4254353546810101796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [more_than_45_min_dt_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_orders] END)' />
      </column>
      <column caption='.Delivery: % Orders with DT more than 60 Min' datatype='real' default-format='p0.00%' name='[% Orders with DT more than 45 Min (copy)_4254353546810216485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [more_than_60_min_dt_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_orders] END)' />
      </column>
      <column caption='.Delivery: % Orders with Delay more than 10 Min' datatype='real' default-format='p0.00%' name='[% Orders with DT more than 60 Min (copy)_4254353546810318886]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [more_than_10_min_delayd_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_orders] END)' />
      </column>
      <column caption='.Delivery: % Orders with Delay more than 20 Min' datatype='real' default-format='p0.00%' name='[% Orders with Delay more than 10 Min (copy)_4254353546810437671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [more_than_20_min_delayd_orders] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_orders] END)' />
      </column>
      <column caption='.Affordability: % Orders with Service Fee' datatype='real' default-format='p0.00%' name='[% Orders with Delivery Fee (copy)_4254353546614956050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Pricing&quot;, &quot;Deals and discounts&quot;) THEN [orders_with_sf] END)/&#10;SUM(IF [nps_reason] IN (&quot;Pricing&quot;, &quot;Deals and discounts&quot;) THEN [gross_orders] END)' />
      </column>
      <column caption='.Affordability: % Orders with Free Delivery' datatype='real' default-format='p0.00%' name='[% Orders with Incentive (copy)_4254353546614886417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Pricing&quot;, &quot;Deals and discounts&quot;) THEN [orders_with_free_df] END)/&#10;SUM(IF [nps_reason] IN (&quot;Pricing&quot;, &quot;Deals and discounts&quot;) THEN [gross_orders] END)' />
      </column>
      <column caption='.Affordability: % Orders with MOV ' datatype='real' default-format='p0.00%' name='[% Orders with Service Fee (copy)_4254353546615160851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Pricing&quot;, &quot;Deals and discounts&quot;) THEN [orders_with_mov] END)/&#10;SUM(IF [nps_reason] IN (&quot;Pricing&quot;, &quot;Deals and discounts&quot;) THEN [gross_orders] END)' />
      </column>
      <column caption='.Choice: AVG Vendors' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AVG Chain Orders (copy)_4254353546534862857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] = &quot;Variety and ease of ordering&quot; THEN [vendors] END)/&#10;SUM(IF [nps_reason] = &quot;Variety and ease of ordering&quot; THEN [sessions] END)' />
      </column>
      <column caption='.Choice: % Orders with Poor Vendor Rating' datatype='real' default-format='p0.00%' name='[AVG Chain Orders (copy)_4254353546535227403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] = &quot;Variety and ease of ordering&quot; THEN [poor_vendor_rating_orders] END)/&#10;SUM(IF [nps_reason] = &quot;Variety and ease of ordering&quot; THEN [gross_orders] END)' />
      </column>
      <column caption='.Delivery: AVG Inf Cancellation Time (Min)' datatype='real' name='[AVG Delivery Time (Min) (copy)_4254353546808791070]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [time_to_inf_cancel_in_min] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [gross_orders] END)' />
      </column>
      <column caption='.Delivery: AVG Delivery Time (Min)' datatype='real' name='[AVG Order Time (Min) (copy)_4254353546808553501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_time_in_minute] END)/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [delivery_orders] END)' />
      </column>
      <column caption='.Product: % CVR' datatype='real' default-format='p0.00%' name='[AVG Sessions (copy)_4254353546202198017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] = &quot;Quality and Accuracy&quot; THEN [transactions] END)/&#10;SUM(IF [nps_reason] = &quot;Quality and Accuracy&quot; THEN [sessions] END)' />
      </column>
      <column caption='.Product: AVG Order Time (Min)' datatype='real' name='[AVG Sessions (copy)_4254353546202284034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] = &quot;Quality and Accuracy&quot; THEN [time_to_order_in_min] END)/&#10;SUM(IF [nps_reason] = &quot;Quality and Accuracy&quot; THEN [transactions] END)' />
      </column>
      <column caption='.Choice: % Chain Orders' datatype='real' default-format='p0.00%' name='[AVG Sessions (copy)_4254353546534797320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] = &quot;Variety and ease of ordering&quot; THEN [chain_orders] END)/&#10;SUM(IF [nps_reason] = &quot;Variety and ease of ordering&quot; THEN [gross_orders] END)' />
      </column>
      <column caption='.Affordability: AVG Delivery Fee (EUR)' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[AVG Sessions (copy)_4254353546612031502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Pricing&quot;, &quot;Deals and discounts&quot;) THEN [df_eur] END)/&#10;SUM(IF [nps_reason] IN (&quot;Pricing&quot;, &quot;Deals and discounts&quot;) THEN [orders_with_df] END)' />
      </column>
      <column caption='.Choice: % Zombies' datatype='real' default-format='p0.00%' name='[AVG Vendors (copy)_4254353546535034890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] = &quot;Variety and ease of ordering&quot; THEN [zombie_vendors] END)/&#10;SUM(IF [nps_reason] = &quot;Variety and ease of ordering&quot; THEN [vendors] END)' />
      </column>
      <column caption='Week (string)' datatype='string' name='[Calculation_1769351764308762625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISOWEEK([report_date]) = 1 and ISOYEAR([report_date]) = 2023 then &quot;2024-W01&quot;&#13;&#10;ELSEIF ISOWEEK([report_date]) &lt; 10 then STR(ISOYEAR([report_date])) + &quot;-W0&quot; + STR(ISOWEEK([report_date]))&#13;&#10;ELSE STR(ISOYEAR([report_date])) + &quot;-W&quot; + STR(ISOWEEK([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Month (string)' datatype='string' name='[Calculation_1769351764309393410]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF MONTH([report_date]) &lt; 10 then STR(YEAR([report_date])) + &quot;-0&quot; + STR(MONTH([report_date]))&#13;&#10;ELSE STR(YEAR([report_date])) + &quot;-&quot; + STR(MONTH([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Day (string)' datatype='string' name='[Calculation_1769351764309934083]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DAY([report_date]) &lt; 10 THEN [Calculation_1769351764309393410] + &quot;-0&quot; + STR(DAY([report_date]))&#13;&#10;ELSE [Calculation_1769351764309393410] + &quot;-&quot; + STR(DAY([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_1769351764312887301]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[rdbms_id Parameter]&#13;&#10;    when &apos;Monthly&apos; then [Calculation_1769351764309393410]&#13;&#10;      when &apos;Weekly&apos; then [Calculation_1769351764308762625]&#13;&#10;        when &apos;Daily&apos; then [Calculation_1769351764309934083]&#13;&#10;END' />
      </column>
      <column caption='NPS' datatype='real' hidden='true' name='[Calculation_3935372028478423040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(IF [nps_group] = &quot;Promoter&quot; THEN [responses] END) - SUM(IF [nps_group] = &quot;Detractor&quot; THEN [responses] END))/&#10;SUM([responses])) * 100' />
      </column>
      <column caption='.Product: AVG Sessions' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4254353546202054656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] = &quot;Quality and Accuracy&quot; THEN [sessions] END)/&#10;SUM(IF [nps_reason] = &quot;Quality and Accuracy&quot; THEN [customers] END)' />
      </column>
      <column caption='KPI: Product ' datatype='real' name='[Calculation_4254353546203082756]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;CVR&quot; THEN [AVG Sessions (copy)_4254353546202198017]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;AVG Sessions&quot; THEN [Calculation_4254353546202054656]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;AVG Order Time (Min)&quot; THEN [AVG Sessions (copy)_4254353546202284034]&#10;END' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_4254353546462375941]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#10;WHEN &quot;Country&quot; THEN [country]&#10;WHEN &quot;Survey Vertical&quot; THEN [survey_vertical]&#10;WHEN &quot;Segment&quot; THEN [lifecycle_segment]&#10;END' />
      </column>
      <column caption='.Affordability: % Orders with DF and SVC Fee/AFV &gt; 20%' datatype='real' default-format='p0.00%' name='[Calculation_4254353546614370319]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [nps_reason] IN (&quot;Pricing&quot;, &quot;Deals and discounts&quot;) THEN [orders_with_20_per_plus_charges] END)/&#10;SUM(IF [nps_reason] IN (&quot;Pricing&quot;, &quot;Deals and discounts&quot;) THEN [gross_orders] END)' />
      </column>
      <column caption='.Product: NPS - Quality and Accuracy' datatype='real' name='[Calculation_4254353546619093012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(IF [nps_reason] = &quot;Quality and Accuracy&quot; AND [nps_group] = &quot;Promoter&quot; THEN [responses] END) - SUM(IF [nps_reason] = &quot;Quality and Accuracy&quot; AND [nps_group] = &quot;Detractor&quot; THEN [responses] END))/&#10;SUM(IF [nps_reason] = &quot;Quality and Accuracy&quot; THEN [responses] END)) * 100' />
      </column>
      <column caption='Dimension B' datatype='string' name='[Dimension (copy) (copy)_4254353546861977653]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension A (copy)_4254353546861842483]&#10;WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#10;WHEN &quot;Country&quot; THEN [country]&#10;WHEN &quot;Survey Vertical&quot; THEN [survey_vertical]&#10;WHEN &quot;Segment&quot; THEN [lifecycle_segment]&#10;END' />
      </column>
      <column caption='Dimension A' datatype='string' name='[Dimension (copy)_4254353546861969460]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension (copy)_4254353546861789234]&#10;WHEN &quot;Overall&quot; THEN &quot;Overall&quot;&#10;WHEN &quot;Country&quot; THEN [country]&#10;WHEN &quot;Survey Vertical&quot; THEN [survey_vertical]&#10;WHEN &quot;Segment&quot; THEN [lifecycle_segment]&#10;END' />
      </column>
      <column caption='KPI: Delivery' datatype='real' name='[KPI: Affordability (copy)_4254353546624589849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546623963160] = &quot;AVG Inf Cancellation Time (Min)&quot; THEN [AVG Delivery Time (Min) (copy)_4254353546808791070]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546623963160] = &quot;% Inflected Cancelled Orders&quot; THEN [% Chain Orders (copy)_4254353546808905759]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546623963160] = &quot;% Inf Cancelled orders &gt; 15 min&quot; THEN [% Inf Cancelled Orders (copy)_4254353546809024544]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546623963160] = &quot;% Inf Cancelled orders &gt; 60 min&quot; THEN [% Inf Cancelled Orders after 15 Min (copy)_4254353546809212961]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546623963160] = &quot;AVG Delivery Time (Min)&quot; THEN [AVG Order Time (Min) (copy)_4254353546808553501]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546623963160] = &quot;% Orders On Time&quot; THEN [% Chain Orders (copy)_4254353546809331746]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546623963160] = &quot;% Orders with DT &lt; 20 min&quot; THEN [% Inf Cancelled Orders after 60 Min (copy)_4254353546809774115]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546623963160] = &quot;% Orders with DT &gt; 45 min&quot; THEN [% Orders with DT less than 20 Min (copy)_4254353546810101796]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546623963160] = &quot;% Orders with DT &gt; 60 min&quot; THEN [% Orders with DT more than 45 Min (copy)_4254353546810216485]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546623963160] = &quot;% Order with Delay &gt; 10 min&quot; THEN [% Orders with DT more than 60 Min (copy)_4254353546810318886]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546623963160] = &quot;% Order with Delay &gt; 20 min&quot; THEN [% Orders with Delay more than 10 Min (copy)_4254353546810437671]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546623963160] = &quot;% Stacked Orders&quot; THEN [% Chain Orders (copy)_4254353546810540072]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546623963160] = &quot;% Seamless Orders&quot; THEN [% Chain Orders (copy)_4254353546810740777]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546623963160] = &quot;% OD Orders&quot; THEN [% Chain Orders (copy)_4254353546810884138]&#10;END' />
      </column>
      <column caption='KPI: Service' datatype='real' name='[KPI: Delivery (copy)_4254353546625609756]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Delivery KPIs (copy)_4254353546625183770] = &quot;% HC Intent&quot; THEN [% Chain Orders (copy)_4254353546851573803]&#10;ELSEIF [Parameters].[Delivery KPIs (copy)_4254353546625183770] = &quot;% Deflection&quot; THEN [% HC Intent (copy)_4254353546851676204]&#10;ELSEIF [Parameters].[Delivery KPIs (copy)_4254353546625183770] = &quot;% Contact Rate&quot; THEN [% HC Intent (copy)_4254353546851889197]&#10;ELSEIF [Parameters].[Delivery KPIs (copy)_4254353546625183770] = &quot;% Contact Rate Delay&quot; THEN [% Contact Rate (copy)_4254353546851979310]&#10;ELSEIF [Parameters].[Delivery KPIs (copy)_4254353546625183770] = &quot;% Contact Rate PD&quot; THEN [% Contact Rate Delay (copy)_4254353546852048943]&#10;ELSEIF [Parameters].[Delivery KPIs (copy)_4254353546625183770] = &quot;% CSAT&quot; THEN [% CVR (copy)_4254353546853806128]&#10;END' />
      </column>
      <column caption='.Choice: NPS - Variety and Ease of Ordering' datatype='real' name='[NPS Product: Quality and Accuracy (copy)_4254353546620592149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(IF [nps_reason] = &quot;Variety and ease of ordering&quot; AND [nps_group] = &quot;Promoter&quot; THEN [responses] END) - SUM(IF [nps_reason] = &quot;Variety and ease of ordering&quot; AND [nps_group] = &quot;Detractor&quot; THEN [responses] END))/&#10;SUM(IF [nps_reason] = &quot;Variety and ease of ordering&quot; THEN [responses] END)) * 100' />
      </column>
      <column caption='.Affordability: NPS - Pricing, Deals and Discounts' datatype='real' name='[NPS Product: Quality and Accuracy (copy)_4254353546621673494]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(IF [nps_reason] IN (&quot;Pricing&quot;, &quot;Deals and discounts&quot;) AND [nps_group] = &quot;Promoter&quot; THEN [responses] END) - SUM(IF [nps_reason] IN (&quot;Pricing&quot;, &quot;Deals and discounts&quot;) AND [nps_group] = &quot;Detractor&quot; THEN [responses] END))/&#10;SUM(IF [nps_reason] IN (&quot;Pricing&quot;, &quot;Deals and discounts&quot;) THEN [responses] END)) * 100' />
      </column>
      <column caption='.Delivery: NPS - Cancellation and Delivery' datatype='real' name='[NPS Product: Quality and Accuracy (copy)_4254353546623283223]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) AND [nps_group] = &quot;Promoter&quot; THEN [responses] END) - SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) AND [nps_group] = &quot;Detractor&quot; THEN [responses] END))/&#10;SUM(IF [nps_reason] IN (&quot;Cancellation&quot;, &quot;Delivery&quot;) THEN [responses] END)) * 100' />
      </column>
      <column caption='.Service: NPS - Customer Service' datatype='real' name='[NPS Product: Quality and Accuracy (copy)_4254353546625355803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(IF [nps_reason] = &quot;Customer service&quot; AND [nps_group] = &quot;Promoter&quot; THEN [responses] END) - SUM(IF [nps_reason] = &quot;Customer service&quot; AND [nps_group] = &quot;Detractor&quot; THEN [responses] END))/&#10;SUM(IF [nps_reason] = &quot;Customer service&quot; THEN [responses] END)) * 100' />
      </column>
      <column caption='KPI: Choice ' datatype='real' name='[Quality and Accuracy KPI (copy)_4254353546534653959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Quality and Accuracy KPIs (copy)_4254353546534629382] = &quot;AVG Vendors&quot; THEN [AVG Chain Orders (copy)_4254353546534862857]&#10;ELSEIF [Parameters].[Quality and Accuracy KPIs (copy)_4254353546534629382] = &quot;% Zombies&quot; THEN [AVG Vendors (copy)_4254353546535034890]&#10;ELSEIF [Parameters].[Quality and Accuracy KPIs (copy)_4254353546534629382] = &quot;% Chain Orders&quot; THEN [AVG Sessions (copy)_4254353546534797320]&#10;ELSEIF [Parameters].[Quality and Accuracy KPIs (copy)_4254353546534629382] = &quot;% Poor Vendor Rating Orders&quot; THEN [AVG Chain Orders (copy)_4254353546535227403]&#10;END' />
      </column>
      <column caption='KPI: Affordability' datatype='real' name='[Variety and Ease of Ordering KPI (copy)_4254353546611392524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546611408909] = &quot;AVG Delivery Fee (EUR)&quot; THEN [AVG Sessions (copy)_4254353546612031502]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546611408909] = &quot;% Orders with DF and SVC Fee/AFV &gt; 20%&quot; THEN [Calculation_4254353546614370319]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546611408909] = &quot;% Orders with Free Delivery&quot; THEN [% Orders with Incentive (copy)_4254353546614886417]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546611408909] = &quot;% Orders with Discount or Voucher&quot; THEN [% Orders DF and SVC Fee/AFV &gt; 20% (copy)_4254353546614644752]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546611408909] = &quot;% Orders with MOV&quot; THEN [% Orders with Service Fee (copy)_4254353546615160851]&#10;ELSEIF [Parameters].[Variety and Ease of Ordering KPIs (copy)_4254353546611408909] = &quot;% Orders with Service Fee&quot; THEN [% Orders with Delivery Fee (copy)_4254353546614956050]&#10;END' />
      </column>
