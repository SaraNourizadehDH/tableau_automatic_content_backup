            <column-instance column='[Calculation_3935372028478423040]' derivation='User' name='[rank:usr:Calculation_3935372028478423040:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' rank-options='Competition,Descending' type='Rank' />
            </column-instance>
            <column caption='Survey Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
