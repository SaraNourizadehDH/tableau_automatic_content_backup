      <datasource-dependencies datasource='federated.06d48ha0i7acf711oaxy91ho8v0l'>
        <column caption='WoW/MoM Display' datatype='string' name='[Calculation_6778269299743440899]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Parameters].[ABS/REL measure (copy)] = &quot;Weekly&quot; AND [granularity] = &quot;Weekly&quot; THEN&#10;    &quot;W&quot; + STR(DATEPART(&quot;week&quot;, [report_period]))&#10;ELSEIF [Parameters].[ABS/REL measure (copy)] = &quot;Monthly&quot; AND [granularity] = &quot;Monthly&quot; THEN&#10;    DATENAME(&quot;month&quot;, [report_period])&#10;ELSE&#10;    NULL // This handles cases where a row&apos;s granularity doesn&apos;t match the parameter&#10;          // These rows should be filtered out by the sheet filter below.&#10;END' />
        </column>
        <column-instance column='[Calculation_6778269299743440899]' derivation='None' name='[none:Calculation_6778269299743440899:nk]' pivot='key' type='nominal' />
        <column aggregation='Count' caption='Report Period' datatype='date' datatype-customized='true' name='[report_period]' role='dimension' type='ordinal' />
        <column-instance column='[report_period]' derivation='Week' name='[wk:report_period:ok]' pivot='key' type='ordinal' />
      </datasource-dependencies>
