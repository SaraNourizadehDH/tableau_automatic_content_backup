      <table>
        <view>
          <datasources>
            <datasource caption='service_operations__opex_comprehensive_tracker_on_cr_level (pandata_report)' name='federated.06d48ha0i7acf711oaxy91ho8v0l' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='WoW/MoM switch' datatype='string' name='[ABS/REL measure (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Show only last week' datatype='boolean' name='[Metric Dimensions ABS/REL (copy)]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
            <column caption='ABS/REL measure' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Relative&quot;'>
              <calculation class='tableau' formula='&quot;Relative&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06d48ha0i7acf711oaxy91ho8v0l'>
            <column caption='CSAT votes' datatype='integer' name='[CSAT_votes]' role='measure' type='quantitative' />
            <column caption='05a_AHT diff' datatype='real' name='[Calculation_2080381563125145607]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_8406672402161954834] - LOOKUP([Calculation_8406672402161954834], -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='001_CSAT %' datatype='real' default-format='p0.00%' name='[Calculation_2080381563126009864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promoters])/ SUM([CSAT_votes])' />
            </column>
            <column caption='01a_CSAT diff' datatype='real' default-format='p0.00%' name='[Calculation_2080381563126071305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2080381563126009864] - LOOKUP([Calculation_2080381563126009864], -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='002_FCR %' datatype='real' name='[Calculation_2080381563126308874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fcr_numerator]) / SUM([fcr_denominator])' />
            </column>
            <column caption='02a_FCR diff' datatype='real' name='[Calculation_2080381563126333451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2080381563126308874] - LOOKUP([Calculation_2080381563126308874], -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='003_I/O %' datatype='real' name='[Calculation_2080381563126530060]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incidents]) / MAX([Calculation_6475472595752869901])' />
            </column>
            <column caption='03a_I/O diff' datatype='real' name='[Calculation_2080381563126579213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2080381563126530060] - LOOKUP([Calculation_2080381563126530060], -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='004_Contacts Cancellation %' datatype='real' name='[Calculation_2080381563126824974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancelled_orders_with_contacts_count])/SUM([orders_with_contacts_count])' />
            </column>
            <column caption='04a_Cancellation diff' datatype='real' name='[Calculation_2080381563126886415]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2080381563126824974] - LOOKUP([Calculation_2080381563126824974], -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='06a_Wastage diff' datatype='real' name='[Calculation_2080381563127296016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([wastage_refund_eur]) - LOOKUP(SUM([wastage_refund_eur]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='007_Wastage CPO' datatype='real' name='[Calculation_2080381563128160273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[wastage_refund_eur] / [od_gross_orders]' />
            </column>
            <column caption='07a_Wastage CPO diff' datatype='real' name='[Calculation_2080381563128209426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2080381563128160273]) - LOOKUP(SUM([Calculation_2080381563128160273]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4083638972387004423]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Metric Dimensions ABS/REL (copy)] THEN // If parameter is True&#10;    LAST() = 0 // Apply the LAST()=0 logic&#10;ELSE&#10;    TRUE&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='08a_Refund diff' datatype='real' name='[Calculation_4083638972388409353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([refund_value_eur]) - LOOKUP(SUM([refund_value_eur]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='009_Refund CPO' datatype='real' name='[Calculation_4083638972388806666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[refund_value_eur] / [od_gross_orders]' />
            </column>
            <column caption='09a_Refund CPO diff' datatype='real' name='[Calculation_4083638972388859915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4083638972388806666]) - LOOKUP(SUM([Calculation_4083638972388806666]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='10a_Comp diff' datatype='real' name='[Calculation_4083638972390072332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([compensation_value_eur]) - LOOKUP(SUM([compensation_value_eur]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='11a_Comp CPO diff' datatype='real' name='[Calculation_4083638972390686734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_7704110860203216944]) - LOOKUP(SUM([Calculation_7704110860203216944]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='12a_Incidents diff' datatype='integer' name='[Calculation_4083638972391038991]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incidents]) - LOOKUP(SUM([incidents]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CR' datatype='string' name='[Calculation_4635611404372033536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;CR&quot;' />
            </column>
            <column caption='granularity filter' datatype='boolean' name='[Calculation_576671875761635328]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[granularity] = [Parameters].[ABS/REL measure (copy)]' />
            </column>
            <column caption='Pandora' datatype='string' name='[Calculation_576671876132945930]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Pandora&quot;' />
            </column>
            <column caption='I/O denominator' datatype='integer' name='[Calculation_6475472595752869901]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [stakeholder]&#10;WHEN &quot;Customer&quot; THEN [gross_orders]&#10;WHEN &quot;Rider&quot; THEN [od_gross_orders]&#10;WHEN &quot;Vendor&quot; THEN [gross_orders]&#10;END' />
            </column>
            <column caption='WoW/MoM Display' datatype='string' name='[Calculation_6778269299743440899]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[ABS/REL measure (copy)] = &quot;Weekly&quot; AND [granularity] = &quot;Weekly&quot; THEN&#10;    &quot;W&quot; + STR(DATEPART(&quot;week&quot;, [report_period]))&#10;ELSEIF [Parameters].[ABS/REL measure (copy)] = &quot;Monthly&quot; AND [granularity] = &quot;Monthly&quot; THEN&#10;    DATENAME(&quot;month&quot;, [report_period])&#10;ELSE&#10;    NULL // This handles cases where a row&apos;s granularity doesn&apos;t match the parameter&#10;          // These rows should be filtered out by the sheet filter below.&#10;END' />
            </column>
            <column caption='Display ABS' datatype='boolean' name='[Calculation_744219850695987201]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;Absolute&quot;' />
            </column>
            <column caption='011_Compensation CPO' datatype='real' name='[Calculation_7704110860203216944]' role='measure' type='quantitative'>
