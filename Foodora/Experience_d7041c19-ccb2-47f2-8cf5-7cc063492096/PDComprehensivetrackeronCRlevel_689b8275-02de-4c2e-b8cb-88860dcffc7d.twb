      </filter>
      <filter class='categorical' column='[federated.06d48ha0i7acf711oaxy91ho8v0l].[wk:report_period:ok]'>
        <groupfilter count='8' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
          <groupfilter direction='DESC' expression='MAX([report_period])' function='order' user:ui-marker='order'>
            <groupfilter function='level-members' level='[wk:report_period:ok]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </groupfilter>
        </groupfilter>
