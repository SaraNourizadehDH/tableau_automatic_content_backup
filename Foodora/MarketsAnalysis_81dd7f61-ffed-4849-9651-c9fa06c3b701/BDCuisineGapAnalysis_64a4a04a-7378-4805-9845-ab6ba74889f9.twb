      <aliases enabled='yes' />
      <column caption='Unique Vendor Count' datatype='integer' name='[Calculation_2161164887973261312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='Order Generating Vendors' datatype='integer' name='[Calculation_2161164887973367809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_count]&gt;0 THEN [vendor_code] ELSE NULL END)' />
      </column>
      <column caption='Per Day Order Count' datatype='real' name='[Calculation_2161164887975342083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_count])/COUNTD([order_date])' />
      </column>
