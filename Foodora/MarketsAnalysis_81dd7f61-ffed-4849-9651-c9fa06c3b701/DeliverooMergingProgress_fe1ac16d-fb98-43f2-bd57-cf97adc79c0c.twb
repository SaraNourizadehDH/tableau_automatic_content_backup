            <column caption='Pool Size' datatype='integer' name='[Calculation_220746806221742080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Vendor Grid / SF ID])' />
            </column>
            <column caption='Count Contacted' datatype='integer' name='[Calculation_220746806222352385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [Vendor Contacted] = &quot;Yes&quot; THEN [Vendor Grid / SF ID]&#10;    ELSE NULL&#10;    END&#10;)' />
            </column>
            <column caption='% Contacted' datatype='real' name='[Calculation_220746806284025859]' role='measure' type='quantitative'>
