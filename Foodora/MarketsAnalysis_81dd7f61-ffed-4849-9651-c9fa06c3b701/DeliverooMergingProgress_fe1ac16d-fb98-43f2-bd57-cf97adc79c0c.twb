            </column>
            <column caption='Count Activated' datatype='integer' name='[Count Consented (copy)_617485786323783680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF CONTAINS([Unprivated?], &quot;YES&quot;) THEN [Vendor Grid / SF ID]&#10;    ELSE NULL&#10;    END&#10;)' />
            </column>
            <column caption='Count Consented' datatype='integer' name='[Count Contacted (copy)_220746806224936962]' role='measure' type='quantitative'>
