          <datasource-dependencies datasource='federated.11m5j0h1mey71b19jixmb09vqw5v'>
            <column caption='Company Region' datatype='string' name='[Calculation_172544174729031681]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#10;[global_entity_id] = &apos;FP_BD&apos;&#10;OR [global_entity_id] = &apos;FP_PK&apos;&#10;OR [global_entity_id] = &apos;FP_SG&apos;&#10;OR [global_entity_id] = &apos;FP_MY&apos;&#10;OR [global_entity_id] = &apos;FP_TH&apos;&#10;OR [global_entity_id] = &apos;FP_PH&apos;&#10;OR [global_entity_id] = &apos;FP_TW&apos;&#10;OR [global_entity_id] = &apos;FP_HK&apos;&#10;OR [global_entity_id] = &apos;FP_KH&apos;&#10;OR [global_entity_id] = &apos;FP_MM&apos;&#10;OR [global_entity_id] = &apos;FP_LA&apos;&#10;OR [global_entity_id] = &apos;FP_JP&apos;&#10;THEN &apos;foodpanda - APAC&apos;&#10;ELSEIF &#10;[global_entity_id] = &apos;FP_DE&apos;&#10;OR [global_entity_id] = &apos;FP_BG&apos;&#10;OR [global_entity_id] = &apos;FP_SK&apos;&#10;OR [global_entity_id] = &apos;FP_RO&apos;&#10;THEN &apos;foodpanda - Europe&apos;&#10;END' />
            </column>
            <column caption='Total NCR' datatype='real' name='[Calculation_1864771753382678529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot; &#10;THEN&#10;SUM(IFNULL([joker_fee_amount_eur],0))&#10;+SUM(IFNULL([cpp_revenue_eur],0))&#10;+SUM(IFNULL([cpc_revenue_eur],0))&#10;+SUM(IFNULL([listing_fee_revenue_eur],0))&#10;WHEN &quot;Local&quot;&#10;THEN&#10;SUM(IFNULL([joker_fee_amount_local],0))&#10;+&#10;SUM(IFNULL([cpp_revenue_local],0))&#10;+SUM(IFNULL([cpc_revenue_local],0))&#10;+SUM(IFNULL([listing_fee_revenue_local],0))&#10;END' />
            </column>
            <column caption='Commission Rev Per Order' datatype='real' name='[Calculation_1986650416601403443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_87046200866787328]/SUM([no_of_valid_order])' />
            </column>
            <column caption='Brand filter' datatype='boolean' name='[Calculation_2994893805993615362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_2994893806305103875]) THEN FALSE ELSE TRUE END' />
            </column>
            <column caption='FP Brand' datatype='string' name='[Calculation_2994893806305103875]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([top_hierarchy_name],IFNULL([chain],[outlet]))' />
            </column>
            <column caption='Gross Profit' datatype='real' name='[Calculation_2994893806319652869]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot;&#10;THEN &#10;IIF(NOT ISNULL(MAX([cost_per_order_eur])),&#10;(SUM(IFNULL([commission_base_x_cr],0))&#10;+SUM(IFNULL([Calculation_2994893806332268550],0))&#10;+SUM(IFNULL([cpp_revenue_eur],0))&#10;+SUM(IFNULL([cpc_revenue_eur],0))&#10;+SUM(IFNULL([joker_fee_amount_eur],0))&#10;+SUM(IFNULL([delivery_fee],0))&#10;+SUM(IFNULL([listing_fee_revenue_eur],0))),&#10;NULL&#10;)&#10;WHEN &quot;Local&quot;&#10;THEN &#10;IIF(NOT ISNULL(MAX([cost_per_order_eur])),&#10;(SUM(IFNULL([commission_local],0))&#10;+SUM(IFNULL([Calculation_2994893806332268550],0))&#10;+SUM(IFNULL([cpp_revenue_local],0))&#10;+SUM(IFNULL([cpc_revenue_local],0))&#10;+SUM(IFNULL([joker_fee_amount_local],0))&#10;+SUM(IFNULL([delivery_fee]*[exchange_rate],0))&#10;+SUM(IFNULL([listing_fee_revenue_local],0))),&#10;NULL&#10;)&#10;END' />
            </column>
            <column caption='Order Cost' datatype='real' name='[Calculation_2994893806332268550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot;&#10;THEN&#10;(IF &#10;(IFNULL([no_order_foodpanda_delivery]*[cost_per_order_eur_delivery],0)&#10;+ IFNULL([no_of_valid_order]*[cost_per_order_eur_cost_of_sales],0)&#10;) = 0&#10;THEN NULL&#10;ELSE&#10;(&#10;IFNULL([no_order_foodpanda_delivery]*[cost_per_order_eur_delivery],0)&#10;+ IFNULL([no_of_valid_order]*[cost_per_order_eur_cost_of_sales],0)&#10;) END&#10;)&#10;WHEN &quot;Local&quot;&#10;THEN&#10;(IF&#10;(IFNULL([no_order_foodpanda_delivery]*[cost_per_order_eur_delivery],0)&#10;+ IFNULL([no_of_valid_order]*[cost_per_order_eur_cost_of_sales],0)&#10;) = 0&#10;THEN NULL&#10;ELSE&#10;(&#10;IFNULL([no_order_foodpanda_delivery]*[cost_per_order_eur_delivery]*[exchange_rate],0)&#10;+ IFNULL([no_of_valid_order]*[cost_per_order_eur_cost_of_sales]*[exchange_rate],0)&#10;) END&#10;)&#10;END' />
            </column>
            <column caption='pandabox (Joker) Revenue' datatype='real' name='[Calculation_346495755294863361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot; &#10;THEN&#10;SUM(IFNULL([joker_fee_amount_eur],0))&#10;WHEN &quot;Local&quot;&#10;THEN&#10;SUM(IFNULL([joker_fee_amount_local],0))&#10;END' />
            </column>
            <column caption='pandapicks (CPP) Revenue' datatype='real' name='[Calculation_346495755295166466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot; &#10;THEN&#10;SUM(IFNULL([cpp_revenue_eur],0))&#10;WHEN &quot;Local&quot;&#10;THEN&#10;SUM(IFNULL([cpp_revenue_local],0))&#10;END' />
            </column>
            <column caption='pandaclicks (CPC) Revenue' datatype='real' name='[Calculation_346495755295793155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot; &#10;THEN&#10;SUM(IFNULL([cpc_revenue_eur],0))&#10;WHEN &quot;Local&quot;&#10;THEN&#10;SUM(IFNULL([cpc_revenue_local],0))&#10;END' />
            </column>
            <column caption='Listing Fee (Estimated)' datatype='real' name='[Calculation_346495755295997956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot; &#10;THEN&#10;SUM(IFNULL([listing_fee_revenue_eur],0))&#10;WHEN &quot;Local&quot;&#10;THEN&#10;SUM(IFNULL([listing_fee_revenue_local],0))&#10;END' />
            </column>
            <column caption='Total Revenue Per Order' datatype='real' name='[Calculation_346495755307806727]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot;&#10;THEN &#10;(SUM(IFNULL([commission_base_x_cr],0))&#10;+SUM(IFNULL([cpp_revenue_eur],0))&#10;+SUM(IFNULL([cpc_revenue_eur],0))&#10;+SUM(IFNULL([joker_fee_amount_eur],0))&#10;+SUM(IFNULL([delivery_fee],0)))&#10;WHEN &quot;Local&quot;&#10;THEN &#10;(SUM(IFNULL([commission_local],0))&#10;+SUM(IFNULL([cpp_revenue_local],0))&#10;+SUM(IFNULL([cpc_revenue_local],0))&#10;+SUM(IFNULL([joker_fee_amount_local],0))&#10;+SUM(IFNULL([delivery_fee],0)))&#10;END&#10;/&#10;SUM(IFNULL([no_of_valid_order],0))' />
            </column>
            <column caption='Cost Per Order' datatype='real' name='[Calculation_346495755308511240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cost_per_order_eur]' />
            </column>
            <column caption='Country Filter' datatype='boolean' name='[Calculation_346495755656380425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([country])' />
            </column>
            <column caption='Commission Revenue (Estimated)' datatype='real' name='[Calculation_87046200866787328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot;&#10;THEN &#10;SUM(IFNULL([commission_base_x_cr],0))&#10;WHEN &quot;Local&quot;&#10;THEN &#10;SUM(IFNULL([commission_local],0))&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_87046200904212483]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;year&apos;,[order_date])+&apos;-&apos;&#10;+STR(DATEPART(&apos;month&apos;,[order_date]))+&apos; (&apos;+DATENAME(&apos;month&apos;,[order_date])+&apos;)&apos;' />
            </column>
            <column caption='Delivery Fee' datatype='real' name='[Calculation_87046200980369417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot; &#10;THEN&#10;SUM(IFNULL([delivery_fee],0))&#10;WHEN &quot;Local&quot;&#10;THEN&#10;SUM(IFNULL([delivery_fee]*[exchange_rate],0))&#10;END' />
