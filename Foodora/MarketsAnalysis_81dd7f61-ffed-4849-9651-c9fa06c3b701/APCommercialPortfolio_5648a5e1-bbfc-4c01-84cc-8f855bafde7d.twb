            </column>
            <column caption='GBV (Delivery)' datatype='real' name='[Calculation_87046200968687622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot; &#10;THEN&#10;SUM(IFNULL([gfv_b2c],0))&#10;WHEN &quot;Local&quot;&#10;THEN&#10;SUM(IFNULL([gfv_b2c]*[exchange_rate],0))&#10;END' />
            </column>
            <column caption='GMV (All)' datatype='real' name='[Calculation_87046200971735047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot; &#10;THEN&#10;SUM(IFNULL([gmv_eur],0))&#10;WHEN &quot;Local&quot;&#10;THEN&#10;SUM(IFNULL([gmv_eur]*[exchange_rate],0))&#10;END' />
            </column>
            <column caption='GMV (Delivery)' datatype='real' name='[Calculation_87046200978714632]' role='measure' type='quantitative'>
