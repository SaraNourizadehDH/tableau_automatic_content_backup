      <column datatype='real' default-format='p0.00%' hidden='true' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([gfv_valid])) - LOOKUP(ZN(SUM([gfv_valid])), -1)) / ABS(LOOKUP(ZN(SUM([gfv_valid])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Delivery Time (min)' datatype='real' name='[Calculation_100275476648271872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_adt_min])/sum([adt_base])' />
      </column>
      <column caption='Order Accuracy % (Valid)' datatype='real' name='[Calculation_100275476649488386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([no_of_valid_order])-SUM([orders_with_item_issues]))&#10;/&#10;SUM([no_of_valid_order])' />
      </column>
      <column caption='Vendor Acceptance Time (min)' datatype='real' name='[Calculation_100275476652638211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_vendor_confirmation_min])/SUM([vendor_confirmation_base])' />
      </column>
      <column caption='Online Rate %' datatype='real' name='[Calculation_100275476654551044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_open_hours])/SUM([total_open_hours])' />
      </column>
      <column caption='Vendor Cancelled (min)' datatype='real' name='[Calculation_100275476662501381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_vendor_cancelled_time_min])/SUM([vendor_cancelled_time_base])' />
      </column>
      <column caption='Non-NC Vendor' datatype='integer' name='[Calculation_1242712055243644928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[no_of_valid_order]-[first_valid_order_with_this_vendor]' />
      </column>
      <column caption='TF_enterprise_account' datatype='boolean' name='[Calculation_1242712055599718401]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([enterprise_account]) THEN FALSE ELSE [enterprise_account] END' />
      </column>
      <column caption='Order /outlet' datatype='real' name='[Calculation_1242712055813459970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_of_valid_order])/[Calculation_346495755106664448]' />
      </column>
      <column caption='% Vendor Fails' datatype='real' name='[Calculation_1242712057348395016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_order_vendor])/SUM([no_of_all_order])' />
      </column>
      <column caption='GFV Runrate' datatype='real' name='[Calculation_1242712057379176470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1+(ZN(SUM([gfv_valid])) - LOOKUP(ZN(SUM([gfv_valid])), -1)) / ABS(LOOKUP(ZN(SUM([gfv_valid])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Vendor Funded Deal Value (over GMV)' datatype='real' name='[Calculation_140174542729125889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IFNULL([vf_discount_deal_value_eur],0))+SUM(IFNULL([vf_voucher_deal_value_eur],0)))&#10;/SUM([gmv_eur])' />
      </column>
      <column caption='Company Region' datatype='string' name='[Calculation_172544174729031681]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF&#10;[global_entity_id] = &apos;FP_BD&apos;&#10;OR [global_entity_id] = &apos;FP_PK&apos;&#10;OR [global_entity_id] = &apos;FP_SG&apos;&#10;OR [global_entity_id] = &apos;FP_MY&apos;&#10;OR [global_entity_id] = &apos;FP_TH&apos;&#10;OR [global_entity_id] = &apos;FP_PH&apos;&#10;OR [global_entity_id] = &apos;FP_TW&apos;&#10;OR [global_entity_id] = &apos;FP_HK&apos;&#10;OR [global_entity_id] = &apos;FP_KH&apos;&#10;OR [global_entity_id] = &apos;FP_MM&apos;&#10;OR [global_entity_id] = &apos;FP_LA&apos;&#10;OR [global_entity_id] = &apos;FP_JP&apos;&#10;THEN &apos;foodpanda - APAC&apos;&#10;ELSEIF &#10;[global_entity_id] = &apos;FP_DE&apos;&#10;OR [global_entity_id] = &apos;FP_BG&apos;&#10;OR [global_entity_id] = &apos;FP_SK&apos;&#10;OR [global_entity_id] = &apos;FP_RO&apos;&#10;THEN &apos;foodpanda - Europe&apos;&#10;END' />
      </column>
      <column caption='% Total Failed Rate' datatype='real' name='[Calculation_1821494994282598401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_of_failed_order])/SUM([no_of_all_order])' />
      </column>
      <column caption='Delivery + Service (Estimated)' datatype='real' name='[Calculation_1860760725895356422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([delivery_fee],0))&#10;+SUM(IFNULL([service_fee],0))' />
      </column>
      <column caption='No of Outlets (with Orders)' datatype='integer' name='[Calculation_1864771753377255424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [no_of_valid_order] &gt; 0&#10;THEN [vendor_code]&#10;END&#10;)' />
      </column>
      <column caption='Total NCR' datatype='real' name='[Calculation_1864771753382678529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot; &#10;THEN&#10;SUM(IFNULL([joker_fee_amount_eur],0))&#10;+SUM(IFNULL([cpp_revenue_eur],0))&#10;+SUM(IFNULL([cpc_revenue_eur],0))&#10;+SUM(IFNULL([listing_fee_revenue_eur],0))&#10;WHEN &quot;Local&quot;&#10;THEN&#10;SUM(IFNULL([joker_fee_amount_local],0))&#10;+&#10;SUM(IFNULL([cpp_revenue_local],0))&#10;+SUM(IFNULL([cpc_revenue_local],0))&#10;+SUM(IFNULL([listing_fee_revenue_local],0))&#10;END' />
      </column>
      <column caption='L1D #Order %Diff' datatype='real' name='[Calculation_1986650415545569280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([no_of_valid_order]) - LOOKUP(ZN(SUM([no_of_valid_order])), -1))/LOOKUP(ZN(SUM([no_of_valid_order])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Period Column Filter - Last' datatype='integer' name='[Calculation_1986650415704412162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Calculation_1986650415704817667] = 1 THEN 1 ELSE 0 END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Last' datatype='integer' name='[Calculation_1986650415704817667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LAST()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GFV Month End Projection' datatype='real' name='[Calculation_1986650415743234071]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1986650415704817667] = 0 then SUM([gfv_valid])/[(test) first date of this month (copy)_1986650415740084244]*([(test)  days passed (copy)_1986650415742672918]) else NULL end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Projected GFV Run Rate' datatype='real' hidden='true' name='[Calculation_1986650415747805209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1986650415743234071])/[L1th Day Sales (copy)_1986650415734386704]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Last x Day Filter' datatype='boolean' hidden='true' name='[Calculation_1986650415776276506]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='datetrunc(&apos;month&apos;,[order_date]) &gt;= datetrunc(&apos;month&apos;,dateadd(&apos;month&apos;,-1,today()-1))&#13;&#10;AND&#13;&#10;DATETRUNC(&apos;day&apos;, [order_date]) &lt;=  DATETRUNC(&apos;day&apos;, TODAY()-1)' />
      </column>
      <column caption='ABV' datatype='real' name='[Calculation_1986650416561721378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_87046200959381508]/SUM([no_of_valid_order])' />
      </column>
      <column caption='CR2' datatype='real' name='[Calculation_1986650416573059113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_of_shop_menu_loaded])/SUM([count_of_shop_list_loaded])' />
      </column>
      <column caption='CR3' datatype='real' name='[Calculation_1986650416573632554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(MAX([count_of_checkout_loaded],[count_of_add_cart_clicked]))/SUM([count_of_shop_menu_loaded])' />
      </column>
      <column caption='CR4' datatype='real' name='[Calculation_1986650416574185515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_of_transaction])/SUM([count_of_checkout_loaded])' />
