    <worksheet name='Operational Summary'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#d70f64' fontname='Tableau Regular'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[AP] Commercial Portfolio' name='federated.11m5j0h1mey71b19jixmb09vqw5v' />
          </datasources>
          <datasource-dependencies datasource='federated.11m5j0h1mey71b19jixmb09vqw5v'>
            <column caption='Delivery Time (min)' datatype='real' name='[Calculation_100275476648271872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_adt_min])/sum([adt_base])' />
            </column>
            <column caption='Vendor Acceptance Time (min)' datatype='real' name='[Calculation_100275476652638211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_vendor_confirmation_min])/SUM([vendor_confirmation_base])' />
            </column>
            <column caption='Company Region' datatype='string' name='[Calculation_172544174729031681]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#10;[global_entity_id] = &apos;FP_BD&apos;&#10;OR [global_entity_id] = &apos;FP_PK&apos;&#10;OR [global_entity_id] = &apos;FP_SG&apos;&#10;OR [global_entity_id] = &apos;FP_MY&apos;&#10;OR [global_entity_id] = &apos;FP_TH&apos;&#10;OR [global_entity_id] = &apos;FP_PH&apos;&#10;OR [global_entity_id] = &apos;FP_TW&apos;&#10;OR [global_entity_id] = &apos;FP_HK&apos;&#10;OR [global_entity_id] = &apos;FP_KH&apos;&#10;OR [global_entity_id] = &apos;FP_MM&apos;&#10;OR [global_entity_id] = &apos;FP_LA&apos;&#10;OR [global_entity_id] = &apos;FP_JP&apos;&#10;THEN &apos;foodpanda - APAC&apos;&#10;ELSEIF &#10;[global_entity_id] = &apos;FP_DE&apos;&#10;OR [global_entity_id] = &apos;FP_BG&apos;&#10;OR [global_entity_id] = &apos;FP_SK&apos;&#10;OR [global_entity_id] = &apos;FP_RO&apos;&#10;THEN &apos;foodpanda - Europe&apos;&#10;END' />
            </column>
            <column caption='CR3' datatype='real' name='[Calculation_1986650416573632554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(MAX([count_of_checkout_loaded],[count_of_add_cart_clicked]))/SUM([count_of_shop_menu_loaded])' />
            </column>
            <column caption='CR4' datatype='real' name='[Calculation_1986650416574185515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_of_transaction])/SUM([count_of_checkout_loaded])' />
            </column>
            <column caption='Session Conversion Rate' datatype='real' name='[Calculation_1986650416575893549]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_of_valid_order])/SUM([count_of_shop_menu_loaded])' />
            </column>
            <column caption='Est Prep Time' datatype='real' name='[Calculation_1986650416604397620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_ept_min])/sum([ept_base])' />
            </column>
            <column caption='Actual Prep Time' datatype='real' name='[Calculation_1986650416604844085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_apt_min])/sum([apt_base])' />
            </column>
            <column caption='30D Reordering (pending)' datatype='real' name='[Calculation_270216009563148290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reorder_b])/SUM([reorder_a])' />
            </column>
            <column caption='%vendor Lateness &gt;=5min' datatype='real' name='[Calculation_270216009578921987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_lateness_5min_a])/sum([vendor_lateness_5min_b])' />
            </column>
            <column caption='Brand filter' datatype='boolean' name='[Calculation_2994893805993615362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_2994893806305103875]) THEN FALSE ELSE TRUE END' />
            </column>
            <column caption='FP Brand' datatype='string' name='[Calculation_2994893806305103875]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([top_hierarchy_name],IFNULL([chain],[outlet]))' />
            </column>
            <column caption='# Outlets' datatype='integer' name='[Calculation_346495755106664448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF [is_monthly_active] OR [no_of_valid_order] &gt; 0&#10;THEN [vendor_code]&#10;END&#10;)' />
            </column>
            <column caption='Country Filter' datatype='boolean' name='[Calculation_346495755656380425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([country])' />
            </column>
            <column caption='# Zombie Outlets' datatype='integer' name='[Calculation_4085679673934716928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF [is_monthly_active] AND ([no_of_valid_order] = 0 OR ISNULL([no_of_valid_order]))&#10;THEN [vendor_code]&#10;END&#10;)' />
            </column>
            <column caption='% Zombie' datatype='real' name='[Calculation_4085679673936281601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4085679673934716928]/[Calculation_346495755106664448]' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_87046200904212483]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;year&apos;,[order_date])+&apos;-&apos;&#10;+STR(DATEPART(&apos;month&apos;,[order_date]))+&apos; (&apos;+DATENAME(&apos;month&apos;,[order_date])+&apos;)&apos;' />
            </column>
