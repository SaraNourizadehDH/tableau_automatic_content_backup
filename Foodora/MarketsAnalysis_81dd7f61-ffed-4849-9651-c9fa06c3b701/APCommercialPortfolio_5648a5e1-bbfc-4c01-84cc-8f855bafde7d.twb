      <column caption='# New Vendors' datatype='integer' name='[Calculation_346495756094828557]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF &#10;(Left(DATENAME(&apos;month&apos;,[order_date]), 3)+&quot;-&quot;+DATENAME(&apos;year&apos;,[order_date])) &#10;= (Left(DATENAME(&apos;month&apos;,[activation_date]), 3)+&quot;-&quot;+DATENAME(&apos;year&apos;,[activation_date]))&#10;THEN &#10;[vendor_code]&#10;END)' />
      </column>
