            </column>
            <column caption='Company Region' datatype='string' name='[Calculation_172544174729031681]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#10;[global_entity_id] = &apos;FP_BD&apos;&#10;OR [global_entity_id] = &apos;FP_PK&apos;&#10;OR [global_entity_id] = &apos;FP_SG&apos;&#10;OR [global_entity_id] = &apos;FP_MY&apos;&#10;OR [global_entity_id] = &apos;FP_TH&apos;&#10;OR [global_entity_id] = &apos;FP_PH&apos;&#10;OR [global_entity_id] = &apos;FP_TW&apos;&#10;OR [global_entity_id] = &apos;FP_HK&apos;&#10;OR [global_entity_id] = &apos;FP_KH&apos;&#10;OR [global_entity_id] = &apos;FP_MM&apos;&#10;OR [global_entity_id] = &apos;FP_LA&apos;&#10;OR [global_entity_id] = &apos;FP_JP&apos;&#10;THEN &apos;foodpanda - APAC&apos;&#10;ELSEIF &#10;[global_entity_id] = &apos;FP_DE&apos;&#10;OR [global_entity_id] = &apos;FP_BG&apos;&#10;OR [global_entity_id] = &apos;FP_SK&apos;&#10;OR [global_entity_id] = &apos;FP_RO&apos;&#10;THEN &apos;foodpanda - Europe&apos;&#10;END' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_1986650416561721378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_87046200959381508]/SUM([no_of_valid_order])' />
            </column>
            <column caption='Brand filter' datatype='boolean' name='[Calculation_2994893805993615362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_2994893806305103875]) THEN FALSE ELSE TRUE END' />
            </column>
            <column caption='FP Brand' datatype='string' name='[Calculation_2994893806305103875]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([top_hierarchy_name],IFNULL([chain],[outlet]))' />
            </column>
            <column caption='# Outlets' datatype='integer' name='[Calculation_346495755106664448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF [is_monthly_active] OR [no_of_valid_order] &gt; 0&#10;THEN [vendor_code]&#10;END&#10;)' />
            </column>
            <column caption='Country Filter' datatype='boolean' name='[Calculation_346495755656380425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([country])' />
            </column>
            <column caption='ABV (Delivery)' datatype='real' name='[Calculation_346495756046716938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_87046200968687622]/SUM([no_order_b2c])' />
            </column>
            <column caption='VF Deal Value' datatype='real' name='[Calculation_346495756047798283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot;&#10;THEN &#10;(SUM(IFNULL([vf_discount_deal_value_eur],0))+SUM(IFNULL([vf_voucher_deal_value_eur],0)))&#10;WHEN &quot;Local&quot;&#10;THEN &#10;(SUM(IFNULL([vf_discount_deal_value_local],0))+SUM(IFNULL([vf_voucher_deal_value_local],0)))&#10;END' />
            </column>
            <column caption='Weighted Commission (OD)' datatype='real' name='[Calculation_346495756050214924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_commission_local])/SUM([od_commission_base_local])' />
            </column>
            <column caption='# New Vendors' datatype='integer' name='[Calculation_346495756094828557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF &#10;(Left(DATENAME(&apos;month&apos;,[order_date]), 3)+&quot;-&quot;+DATENAME(&apos;year&apos;,[order_date])) &#10;= (Left(DATENAME(&apos;month&apos;,[activation_date]), 3)+&quot;-&quot;+DATENAME(&apos;year&apos;,[activation_date]))&#10;THEN &#10;[vendor_code]&#10;END)' />
            </column>
            <column caption='# Brands' datatype='integer' name='[Calculation_4980770094267867138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF [is_monthly_active] OR [no_of_valid_order] &gt; 0&#10;THEN [Calculation_2994893806305103875]&#10;END&#10;)' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_87046200904212483]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;year&apos;,[order_date])+&apos;-&apos;&#10;+STR(DATEPART(&apos;month&apos;,[order_date]))+&apos; (&apos;+DATENAME(&apos;month&apos;,[order_date])+&apos;)&apos;' />
            </column>
            <column caption='GBV (All)' datatype='real' name='[Calculation_87046200959381508]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot; &#10;THEN&#10;SUM(IFNULL([gfv_valid],0))&#10;WHEN &quot;Local&quot;&#10;THEN&#10;SUM(IFNULL([gfv_valid_local],0))&#10;END' />
            </column>
            <column caption='GBV (Delivery)' datatype='real' name='[Calculation_87046200968687622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot; &#10;THEN&#10;SUM(IFNULL([gfv_b2c],0))&#10;WHEN &quot;Local&quot;&#10;THEN&#10;SUM(IFNULL([gfv_b2c]*[exchange_rate],0))&#10;END' />
            </column>
            <column caption='GMV (All)' datatype='real' name='[Calculation_87046200971735047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Euro&quot; &#10;THEN&#10;SUM(IFNULL([gmv_eur],0))&#10;WHEN &quot;Local&quot;&#10;THEN&#10;SUM(IFNULL([gmv_eur]*[exchange_rate],0))&#10;END' />
            </column>
