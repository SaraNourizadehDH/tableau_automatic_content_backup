      <column caption='Session/Txn' datatype='real' hidden='true' name='[Calculation_1986650416575217708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_of_transaction])/SUM([count_of_shop_menu_loaded])' />
      </column>
      <column caption='Session Conversion Rate' datatype='real' name='[Calculation_1986650416575893549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([no_of_valid_order])/SUM([count_of_shop_menu_loaded])' />
      </column>
