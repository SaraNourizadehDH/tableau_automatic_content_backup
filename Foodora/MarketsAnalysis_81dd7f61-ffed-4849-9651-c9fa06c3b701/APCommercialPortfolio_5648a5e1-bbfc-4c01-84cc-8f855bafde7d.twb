      <column caption='Order /outlet / day' datatype='real' name='[#Order (Valid) (copy)_1242712059767336988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([no_of_valid_order])/[Calculation_346495755106664448])' />
      </column>
      <column caption='&apos;L28D #Order %Diff' datatype='integer' name='[&apos;L7D #Order %Diff (copy)_270216009635713035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='days remaining in this month' datatype='integer' name='[(test)  days passed (copy)_1986650415742672918]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,max([order_date]),[(test) first date of this month (copy)_1986650415741624341])+1' />
      </column>
      <column caption='days passed in this month' datatype='integer' name='[(test) first date of this month (copy)_1986650415740084244]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[(test) max_order_date (copy)_1986650415738322963],max([order_date]))' />
      </column>
      <column caption='date of this month - last date' datatype='datetime' name='[(test) first date of this month (copy)_1986650415741624341]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;,-datepart(&apos;day&apos;,max([order_date])),DATEADD(&apos;month&apos;,1,max([order_date])))' />
