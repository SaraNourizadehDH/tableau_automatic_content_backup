        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.17qgspo0z1jzuz19qtdk70xbhvje' name='Custom SQL Query' type='text'>SELECT e.chain_code , e.chain_name, d.id as grand_grand_id, d.name as grand_grand_parent_name,  c.id as grand_id, c.name as grand_parent_name, b.id as parent_id, b.name as parent_name, a.id , a.name, a.vendor_code, a.global_vendor_id as GRID, a.owner_name,e.department, a.type, a.gmv_class, a.last_modified_date, a.formatted_restaurant_address, b.name as parent_name,  a.vertical, a.created_date, e.is_exclusive, if (is_exclusive = true, &quot;Exclusive&quot; , &quot;Non-Exclusive&quot;) as Exclusivity&#13;
&#13;
from `fulfillment-dwh-production.pandata_curated.sf_accounts` as a&#13;
left join `fulfillment-dwh-production.pandata_curated.sf_accounts` as b &#13;
on a.sf_parent_account_id = b.id &#13;
left join `fulfillment-dwh-production.pandata_curated.sf_accounts` as c &#13;
on b.sf_parent_account_id = c.id &#13;
left join `fulfillment-dwh-production.pandata_curated.sf_accounts` as d &#13;
on c.sf_parent_account_id = d.id&#13;
left join `dhh---analytics-apac.pandata_hk.hkg_vendors_agg`as e &#13;
on a.vendor_code = e.vendor_code&#13;
&#13;
where a.global_entity_id = &quot;FP_HK&quot; and a.country_name=&quot;Hong Kong&quot; and a.status =&quot;Active&quot; and a.is_marked_for_testing_training = False　 and a.vertical =&quot;Restaurant&quot; and a.type = &quot;Branch - Main&quot;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
