      <aliases enabled='yes' />
      <column caption='% dCPO/AFV YoY' datatype='real' default-format='*0.0pp' name='[% DdCPO/AFV MoM (copy)_3087499060838825987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    ((&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_delivery_rider_costs_eur] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [own_delivery_orders] END)&#10;    )&#13;&#10;    /&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [own_delivery_gfv_eur] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [own_delivery_orders] END)&#13;&#10;    ))&#13;&#10;&#10;    -&#13;&#10;&#10;    ((&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [total_delivery_rider_costs_eur] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [own_delivery_orders] END)&#13;&#10;    )&#13;&#10;    /&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [own_delivery_gfv_eur] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [own_delivery_orders] END)&#13;&#10;    ))&#10;) * 100' />
      </column>
