    <worksheet name='TR - Seamless'>
      <table>
        <view>
          <datasources>
            <datasource caption='City' name='federated.1845m2l0bz7ckv1d0te2x0rhh32u' />
          </datasources>
          <datasource-dependencies datasource='federated.1845m2l0bz7ckv1d0te2x0rhh32u'>
            <column caption='% dCPO/AFV' datatype='real' default-format='p0.0%' name='[Calculation_3087499060837339136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(total_delivery_rider_costs_eur) / SUM([own_delivery_orders]))&#13;&#10;/&#13;&#10;(SUM([own_delivery_gfv_eur]) / SUM([own_delivery_orders]))' />
            </column>
            <column caption='3 month filter' datatype='boolean' name='[Calculation_5824983944797523975]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([month]&gt;= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -3, TODAY())) AND [month] &lt; DATETRUNC(&apos;month&apos;,TODAY())) OR [month] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -13, TODAY()))' />
            </column>
            <column caption='[agg] healthy vendors' datatype='real' default-format='p0.0%' name='[Calculation_6404963148140711936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([healthy_vendor_availability_n])&#10;/&#10;sum([healthy_vendor_availability_d])' />
