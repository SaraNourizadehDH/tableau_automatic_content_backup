    <worksheet name='TR - Choice'>
      <table>
        <view>
          <datasources>
            <datasource caption='City' name='federated.1845m2l0bz7ckv1d0te2x0rhh32u' />
          </datasources>
          <datasource-dependencies datasource='federated.1845m2l0bz7ckv1d0te2x0rhh32u'>
            <column caption='% Vendors F30D Orders &gt;1' datatype='real' default-format='p0.0%' name='[Calculation_2347782818534805506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([d30_has_order])&#13;&#10;/&#13;&#10;SUM([vendor_count])' />
            </column>
            <column caption='3 month filter' datatype='boolean' name='[Calculation_5824983944797523975]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([month]&gt;= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -3, TODAY())) AND [month] &lt; DATETRUNC(&apos;month&apos;,TODAY())) OR [month] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -13, TODAY()))' />
