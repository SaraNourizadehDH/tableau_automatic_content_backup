      <column caption='subscriber GMV Share YOY' datatype='real' default-format='*0.0pp' name='[subscriber GMV Share MoM (copy)_122089819339333636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [Month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv_contribtuion_percent_a] END) &#10;        /&#10;        SUM(IF [Month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv_contribtuion_percent_b] END)&#10;    )&#10;    - &#10;    (&#10;        SUM(IF [Month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv_contribtuion_percent_a] END) &#10;        /&#10;        SUM(IF [Month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gmv_contribtuion_percent_b] END)&#10;    )&#10;) * 100' />
