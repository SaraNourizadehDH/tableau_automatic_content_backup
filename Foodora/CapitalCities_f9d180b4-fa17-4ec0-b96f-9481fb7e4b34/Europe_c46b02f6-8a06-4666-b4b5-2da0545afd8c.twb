            <column caption='Dmart Pct Fresh Penetration YOY' datatype='real' default-format='*0.0pp' name='[Dmart Pct Fresh Penetration MoM (copy)_2092766498465710083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_pct_fresh_penetration] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [dmart_pct_fresh_penetration] END)) &#10;) * 100' />
            </column>
            <column caption='Dmart Pct Weighted Availability V2 YOY' datatype='real' default-format='*0.0pp' name='[Dmart Pct Weighted Availability V2 MOM (copy)_4501558987588145177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_wa_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_wa_den] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [dmart_wa_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [dmart_wa_den] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='QC GMV Share YOY' datatype='real' default-format='*0.0pp' name='[QC GMV Share MoM (copy)_1640225104335839235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [qc_gmv_share] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [qc_gmv_share] END)) &#10;) * 100' />
            </column>
            <column caption='QC MAU Share YoY' datatype='real' default-format='*0.0pp' name='[QC MAU Share MoM (copy)_1193172472306163734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [qc_mau_share] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [qc_mau_share] END)) &#10;) * 100' />
            </column>
