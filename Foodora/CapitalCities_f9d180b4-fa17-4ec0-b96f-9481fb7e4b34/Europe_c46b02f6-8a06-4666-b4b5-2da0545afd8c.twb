              <calculation class='tableau' formula='(&#10;    ((&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_delivery_rider_costs_eur] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [own_delivery_orders] END)&#10;    )&#13;&#10;    /&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [own_delivery_gfv_eur] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [own_delivery_orders] END)&#13;&#10;    ))&#13;&#10;&#10;    -&#13;&#10;&#10;    ((&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [total_delivery_rider_costs_eur] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [own_delivery_orders] END)&#13;&#10;    )&#13;&#10;    /&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [own_delivery_gfv_eur] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [own_delivery_orders] END)&#13;&#10;    ))&#10;) * 100' />
            </column>
            <column caption='% No Rider Fail YoY' datatype='real' default-format='*0.0pp' name='[Fail rate YoY (copy)_1316458503496679430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [failed_no_rider_count] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gross_orders] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [failed_no_rider_count] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gross_orders] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='Rider hours YoY' datatype='real' default-format='p0.0%' name='[Rider hours actual planned MoM (copy)_1193172472305737746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [rider_hours] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [rider_hours] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [rider_hours] END)' />
            </column>
            <column caption='Shrinkage L2+ YoY' datatype='real' default-format='*0.0pp' name='[Shrinkage YoY (copy)_1316458503494897666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [shrink_level_2_order_count] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [forecasted_orders] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [shrink_level_2_order_count] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [forecasted_orders] END)) &#10;)&#10;&#10;&#10;) * 100' />
