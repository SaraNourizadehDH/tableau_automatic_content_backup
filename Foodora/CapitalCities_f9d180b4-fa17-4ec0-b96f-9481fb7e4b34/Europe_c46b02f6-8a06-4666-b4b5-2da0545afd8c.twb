              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [vf_orders] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [orders_op] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [vf_orders] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [orders_op] END)&#10;    )&#10;) * 100' />
