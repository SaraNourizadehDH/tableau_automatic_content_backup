      <column caption='subscriber GMV Share MoM' datatype='real' default-format='*0.0pp' name='[QC GMV Share MoM (copy)_1709608686130102273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [Month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv_contribtuion_percent_a] END) &#10;        /&#10;        SUM(IF [Month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv_contribtuion_percent_b] END)&#10;    )&#10;    - &#10;    (&#10;        SUM(IF [Month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gmv_contribtuion_percent_a] END) &#10;        /&#10;        SUM(IF [Month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gmv_contribtuion_percent_b] END)&#10;    )&#10;) * 100' />
      </column>
