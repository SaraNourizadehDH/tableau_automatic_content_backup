              <calculation class='tableau' formula='(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [qc_gmv_share] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [qc_gmv_share] END)) &#10;) * 100' />
            </column>
            <column caption='QC MAU Share MoM' datatype='real' default-format='*0.0pp' name='[Retention rate MoM (copy)_1193172472305975317]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [qc_mau_share] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [qc_mau_share] END)) &#10;) * 100' />
            </column>
            <column datatype='real' name='[all_platform_mau_country_average]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
