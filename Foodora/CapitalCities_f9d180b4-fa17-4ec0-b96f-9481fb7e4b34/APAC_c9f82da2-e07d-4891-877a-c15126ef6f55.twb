    <worksheet name='KH - Affordability'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025_city_view' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
          </datasources>
          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='% Deal Utilization' datatype='real' default-format='p0.0%' name='[% No Rider Fail (copy)_992762282728665088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vf_orders])&#10;/&#10;sum([orders_op])' />
            </column>
            <column caption='[agg] VFD GMV' datatype='real' name='[Calculation_3984137611677024256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vfd_num])&#10;/&#10;sum([gmv_eur])' />
            </column>
            <column caption='3 month filter' datatype='boolean' name='[Calculation_5824983944797523975]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([month]&gt;= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -3, TODAY())) AND [month] &lt; DATETRUNC(&apos;month&apos;,TODAY())) OR [month] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -13, TODAY()))' />
            </column>
            <column caption='[agg] VFD GMV AO' datatype='real' name='[Calculation_6404963148143558658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ao_vendor_eur])&#10;/&#10;sum([gmv_eur])' />
            </column>
            <column caption='[agg] vfd vendor penetration' datatype='real' name='[Calculation_6404963148151947275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_spend])&#10;/&#10;sum([vendor_code])' />
            </column>
            <column caption='Ao Vendor Eur' datatype='real' name='[ao_vendor_eur]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[month]' derivation='Month' name='[mn:month:ok]' pivot='key' type='ordinal' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5824983944797523975]' derivation='None' name='[none:Calculation_5824983944797523975:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[orders_op]' role='measure' type='quantitative' />
            <column-instance column='[vfd_gmv]' derivation='Sum' name='[sum:vfd_gmv:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vfd_vendor_penetration]' derivation='Sum' name='[sum:vfd_vendor_penetration:qk]' pivot='key' type='quantitative' />
            <column-instance column='[% No Rider Fail (copy)_992762282728665088]' derivation='User' name='[usr:% No Rider Fail (copy)_992762282728665088:qk]' pivot='key' type='quantitative' />
