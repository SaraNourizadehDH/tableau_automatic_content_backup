    <worksheet name='BD - Seamless YOY'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025_city_view' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
          </datasources>
          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='% No Rider Fail YoY' datatype='real' default-format='*0.0pp' name='[Fail rate YoY (copy)_1316458503496679430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [failed_no_rider_count] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gross_orders] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [failed_no_rider_count] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gross_orders] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='On time delivery YOY' datatype='real' default-format='*0.0pp' name='[On time delivery MOM (copy)_1193172472312139807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [on_time_okr_weighted_per_pdt_pct] * [gross_orders] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gross_orders] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [on_time_okr_weighted_per_pdt_pct] * [gross_orders] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [gross_orders] END)&#10;    )&#10;&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='Rider hours YOY' datatype='real' default-format='p0.0%' name='[Rider hours MoM (copy)_560909311152951311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [rider_hours] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [rider_hours] END)&#10;) &#10;&#10;/&#10;&#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [rider_hours] END)' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[failed_no_rider_count]' role='measure' type='quantitative' />
            <column caption='Gross Orders' datatype='integer' name='[gross_orders]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column caption='On Time Okr Weighted Per Pdt Pct' datatype='real' default-format='p0.0%' name='[on_time_okr_weighted_per_pdt_pct]' role='measure' type='quantitative' />
            <column caption='Rider Hours' datatype='real' name='[rider_hours]' role='measure' type='quantitative' />
            <column-instance column='[Fail rate YoY (copy)_1316458503496679430]' derivation='User' name='[usr:Fail rate YoY (copy)_1316458503496679430:qk]' pivot='key' type='quantitative' />
