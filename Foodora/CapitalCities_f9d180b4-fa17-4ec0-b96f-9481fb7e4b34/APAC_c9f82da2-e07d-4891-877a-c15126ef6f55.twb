            <column-instance column='[Calculation_3984137611677843457]' derivation='User' name='[usr:Calculation_3984137611677843457:qk]' pivot='key' type='quantitative' />
            <column-instance column='[VFD Vendor % MoM (copy)_5216294321414668288]' derivation='User' name='[usr:VFD Vendor % MoM (copy)_5216294321414668288:qk]' pivot='key' type='quantitative' />
