    <worksheet name='KH - Choice MOM'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025_city_view' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
          </datasources>
          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='% Vendors F30D Orders &gt;1 MoM' datatype='real' default-format='*0.0pp' name='[% Vendors F30D Orders &gt;1 (copy)_2347782818535157763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [d30_has_order] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [vendor_count] END)&#13;&#10;    )&#13;&#10;    -&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [d30_has_order] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [vendor_count] END)&#13;&#10;    )&#13;&#10;) * 100' />
            </column>
            <column caption='Ogv vendors MoM' datatype='real' default-format='p0.0%' name='[AB Acquisitions MoM (copy)_1193172472303448075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [ogv_vendors] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [ogv_vendors] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [ogv_vendors] END)' />
            </column>
            <column caption='AB Zombies % MoM' datatype='real' default-format='*0.0pp' name='[Fail rate MoM (copy)_2092766498462769152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [ab_zombie_vendors] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [sa_ka_vendors] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [ab_zombie_vendors] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [sa_ka_vendors] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='AB Acquisitions MoM' datatype='real' default-format='p0.0%' name='[MAU MoM (copy)_1193172472302460937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [ab_acquisitions] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [ab_acquisitions] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [ab_acquisitions] END)' />
            </column>
