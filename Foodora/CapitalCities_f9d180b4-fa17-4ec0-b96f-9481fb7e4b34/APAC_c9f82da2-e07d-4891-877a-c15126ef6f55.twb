        <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN ([total_incidents_customer] + [total_incidents_vendor] + [total_incidents_rider]) END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gross_orders] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN ([total_incidents_customer] + [total_incidents_vendor] + [total_incidents_rider]) END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gross_orders] END)&#10;    )&#10;) * 100' />
      </column>
      <column caption='stacking % MOM' datatype='real' name='[Calculation_426856855937912840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [stacked_deliveries_sum] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [stacked_deliveries_cnt] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [stacked_deliveries_sum] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [stacked_deliveries_cnt] END)&#10;    )&#10;) * 100' />
      </column>
      <column caption='avg onboarding age day MOM' datatype='real' name='[Calculation_426856855938236426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [onboarding_age_days] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [onboarded_vendors] END)&#10;    )&#10;    /&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [onboarding_age_days] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [onboarded_vendors] END)&#10;    )&#10;) - 1' />
      </column>
      <column caption='DLP MOM' datatype='real' name='[Calculation_426856855939088396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;  (&#10;    SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [active_products_with_images] END)&#10;    /&#10;    SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [active_products] END)&#10;  )&#10;  -&#10;  (&#10;    SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [active_products_with_images] END)&#10;    /&#10;    SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [active_products] END)&#10;  )&#10;) * 100' />
      </column>
      <column caption='[agg] Dmart Pct Weighted Availability V2' datatype='real' default-format='p0.0%' name='[Calculation_4501558987557949440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([dmart_wa_num])&#10;/&#10;sum([dmart_wa_den])' />
      </column>
      <column caption='[agg] shops key partners per MAU' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4501558987558252545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([key_partner_country_average])&#10;/&#10;sum([all_platform_mau_country_average])' />
      </column>
      <column caption='[agg] shops pct promo gpv contribution' datatype='real' name='[Calculation_4501558987559272450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([shops_promo_gpv_contribution_num])&#10;/&#10;sum([shops_promo_gpv_contribution_den])' />
      </column>
      <column caption='[agg] items not delivered' datatype='real' default-format='p0.0%' name='[Calculation_4501558987562876933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([shops_items_not_delivered_excl_post_delivery_num])&#10;/&#10;sum([shops_items_not_delivered_den])' />
