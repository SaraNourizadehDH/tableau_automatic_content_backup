            <column-instance column='[Ogv vendors MoM (copy)_1193172472303656972]' derivation='User' name='[usr:Ogv vendors MoM (copy)_1193172472303656972:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Vendor Acquisitions MoM (copy)_1765411100274044929]' derivation='User' name='[usr:Vendor Acquisitions MoM (copy)_1765411100274044929:qk]' pivot='key' type='quantitative' />
