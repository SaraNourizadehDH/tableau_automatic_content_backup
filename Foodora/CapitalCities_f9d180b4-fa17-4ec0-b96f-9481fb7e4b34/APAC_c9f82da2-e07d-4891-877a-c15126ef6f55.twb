        <calculation class='tableau' formula='SUM([pro_gmv_eur])&#13;&#10;/&#13;&#10;SUM([gmv_eur])' />
      </column>
      <column caption='Loyalty %' datatype='real' name='[Calculation_868068876645425152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_participants])&#10;/&#10;sum([MAU])' />
      </column>
      <column caption='Loyalty share MoM' datatype='real' name='[Calculation_868068876646047746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_participants] END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [MAU] END)&#10;    )&#10;    - &#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [total_participants] END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [MAU] END)&#10;    )&#10;) * 100' />
      </column>
      <column caption='Pro VFD / Pro GMV' datatype='real' default-format='p0.0%' name='[Calculation_992762282739269635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pro_vendor_eur])&#13;&#10;/&#13;&#10;SUM([pro_gmv_eur])' />
      </column>
      <column caption='D30 AB Deals and Ads YoY' datatype='real' default-format='*0.0pp' name='[D30 Deals and Ads MoM (copy)_1455788616383070213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [d30_ab_deals_and_ads_pcnt] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [d30_ab_deals_and_ads_pcnt] END)) &#10;*100' />
      </column>
      <column caption='DLP YOY' datatype='real' name='[DLP MOM (copy)_426856855939153933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;  (&#10;    SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [active_products_with_images] END)&#10;    /&#10;    SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [active_products] END)&#10;  )&#10;  -&#10;  (&#10;    SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [active_products_with_images] END)&#10;    /&#10;    SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [active_products] END)&#10;  )&#10;) * 100' />
