            <column datatype='real' name='[total_incentive_cost_vendor_eur]' role='measure' type='quantitative' />
            <column-instance column='[AB Zombies % MoM (copy)_1654509965038370816]' derivation='User' name='[usr:AB Zombies % MoM (copy)_1654509965038370816:qk]' pivot='key' type='quantitative' />
