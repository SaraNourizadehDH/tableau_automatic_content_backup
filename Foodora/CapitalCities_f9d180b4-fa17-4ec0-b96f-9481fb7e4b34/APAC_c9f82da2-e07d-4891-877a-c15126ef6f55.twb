    <worksheet name='MM - Choice YOY'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025_city_view' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
          </datasources>
          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='% Offline YOY' datatype='real' default-format='*0.0pp' name='[% Offline MoM (copy)_5829206083545305091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [closed_hours] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [scheduled_hours] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [closed_hours] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [scheduled_hours] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='% Vendors F30D Orders &gt;1 YoY' datatype='real' default-format='*0.0pp' name='[% Vendors F30D Orders &gt;1 MoM (copy)_2347782818535317509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [d30_has_order] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [vendor_count] END)&#13;&#10;    )&#13;&#10;    -&#13;&#10;    (&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [d30_has_order] END)&#13;&#10;        /&#13;&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -13, TODAY())) THEN [vendor_count] END)&#13;&#10;    )&#13;&#10;) * 100' />
            </column>
            <column caption='AB Acquisitions YoY' datatype='real' default-format='p0.0%' name='[AB Acquisitions MoM (copy)_1193172472302776330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [ab_acquisitions] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [ab_acquisitions] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [ab_acquisitions] END)' />
            </column>
            <column caption='AB Zombies % YOY' datatype='real' default-format='*0.0pp' name='[AB Zombies % MoM (copy)_2092766498462908417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [ab_zombie_vendors] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [sa_ka_vendors] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [ab_zombie_vendors] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [sa_ka_vendors] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='Ogv vendors YoY' datatype='real' default-format='p0.0%' name='[Ogv vendors MoM (copy)_1193172472303656972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [ogv_vendors] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [ogv_vendors] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [ogv_vendors] END)' />
            </column>
