              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [failed_no_rider_count] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gross_orders] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [failed_no_rider_count] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gross_orders] END)&#10;    )&#10;) * 100' />
