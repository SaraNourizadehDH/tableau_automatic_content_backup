    <worksheet name='PH - Affordability MOM'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025_city_view' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
          </datasources>
          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='Pro VFD / Pro GMV MoM ' datatype='real' default-format='*0.0pp' name='[% Deal Utilization MoM (copy)_992762282740281349]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [pro_vendor_eur] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [pro_gmv_eur] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [pro_vendor_eur] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [pro_gmv_eur] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='VFD GMV MOM' datatype='real' default-format='*0.0pp' name='[Calculation_3984137611677843457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_incentive_cost_vendor_eur] END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [gmv_eur] END)&#10;    )&#10;    - &#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [total_incentive_cost_vendor_eur] END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [gmv_eur] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='disco cofunding ratio MoM' datatype='real' default-format='*0.0pp' name='[VFD Vendor % MoM (copy)_5216294321414668288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [disco_vendor_eur] END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [disco_eur] END)&#10;    )&#10;    - &#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [disco_vendor_eur] END) &#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [disco_eur] END)&#10;    )&#10;) * 100' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[disco_eur]' role='measure' type='quantitative' />
            <column caption='Disco Vendor Eur' datatype='real' name='[disco_vendor_eur]' role='measure' type='quantitative' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[pro_gmv_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[pro_vendor_eur]' role='measure' type='quantitative' />
