        <calculation class='tableau' formula='sum([qc_mau])&#10;/&#10;sum([MAU])' />
      </column>
      <column caption='[agg] subscriber mau share' datatype='real' name='[Calculation_6404963148165742605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([mau_penetration_percent_a])&#10;/&#10;sum([mau_penetration_percent_b])' />
      </column>
      <column caption='[agg] retention %' datatype='real' default-format='p0.0%' name='[Calculation_6404963148166184974]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([reorders])&#10;/&#10;sum([prev_customers])' />
      </column>
      <column caption='[agg] qc rejection %' datatype='real' name='[Calculation_6404963148166717455]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_rejected_case_id])&#10;/&#10;sum([count_qc_case_id])' />
