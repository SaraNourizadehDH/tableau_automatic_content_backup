            <column caption='Total Vendor Acquisitions' datatype='integer' name='[total_vendor_acquisitions]' role='measure' type='quantitative' />
            <column caption='Total Vendors Sf' datatype='integer' name='[total_vendors_sf]' role='measure' type='quantitative' />
