    <worksheet name='LA - Choice'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025_city_view' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
          </datasources>
          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='% Vendors F30D Orders &gt;1' datatype='real' default-format='p0.0%' name='[Calculation_2347782818534805506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([d30_has_order])&#13;&#10;/&#13;&#10;SUM([vendor_count])' />
            </column>
            <column caption='3 month filter' datatype='boolean' name='[Calculation_5824983944797523975]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([month]&gt;= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -3, TODAY())) AND [month] &lt; DATETRUNC(&apos;month&apos;,TODAY())) OR [month] = DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;, -13, TODAY()))' />
            </column>
            <column caption='[agg] offline %' datatype='real' default-format='p0.0%' name='[Calculation_6404963148145274884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([closed_hours])&#10;/&#10;sum([scheduled_hours])' />
            </column>
            <column caption='[agg] AB zombie % ' datatype='real' default-format='p0.0%' name='[Calculation_6404963148151656458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ab_zombie_vendors])&#10;/&#10;sum([sa_ka_vendors])' />
            </column>
            <column caption='Ab Acquisitions' datatype='integer' name='[ab_acquisitions]' role='measure' type='quantitative' />
            <column caption='Ab Zombie Vendors' datatype='integer' name='[ab_zombie_vendors]' role='measure' type='quantitative' />
            <column caption='Closed Hours' datatype='integer' name='[closed_hours]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[d30_has_order]' role='measure' type='quantitative' />
