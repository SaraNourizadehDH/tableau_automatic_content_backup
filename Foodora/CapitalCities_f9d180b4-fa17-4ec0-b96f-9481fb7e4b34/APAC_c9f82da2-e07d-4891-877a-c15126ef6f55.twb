            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column caption='Ogv Vendors' datatype='integer' name='[ogv_vendors]' role='measure' type='quantitative' />
            <column caption='productivity YOY' datatype='real' default-format='p0.0%' name='[productivity MOM (copy)_1558878845643583488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [productivity] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [productivity]   END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -13, TODAY())) THEN [productivity]  END)' />
