    <worksheet name='PK - QC MOM'>
      <table>
        <view>
          <datasources>
            <datasource caption='sp_okr_automation_2025_city_view' name='federated.1u33d850g9lkdp1dfuxpn1sdmmx7' />
          </datasources>
          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='QC Trials MoM' datatype='real' default-format='p0.0%' name='[AB Acquisitions MoM (copy)_1193172472306266135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [qc_trials] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [qc_trials] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [qc_trials] END)' />
            </column>
            <column caption='Dmart Pct Weighted Availability V2 MOM' datatype='real' default-format='*0.0pp' name='[Calculation_4501558987588059160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_wa_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_wa_den] END)&#10;    )&#10;    -&#10;    (&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [dmart_wa_num] END)&#10;        /&#10;        SUM(IF [month] = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY())) THEN [dmart_wa_den] END)&#10;    )&#10;) * 100' />
            </column>
            <column datatype='integer' name='[MAU]' role='measure' type='quantitative' />
            <column caption='Dmart Pct Fresh Penetration MoM' datatype='real' default-format='*0.0pp' name='[QC GMV Share MoM (copy)_2092766498465468418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [dmart_pct_fresh_penetration] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [dmart_pct_fresh_penetration] END)) &#10;) * 100' />
            </column>
            <column caption='Shops AAA Supermarket active products MoM' datatype='real' default-format='p0.0%' name='[QC Trials MoM (copy)_1559723260989415428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [shops_aaa_supermarket_active_products] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [shops_aaa_supermarket_active_products] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [shops_aaa_supermarket_active_products] END)' />
            </column>
            <column caption='QC MAU Share MoM' datatype='real' default-format='*0.0pp' name='[Retention rate MoM (copy)_1193172472305975317]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [qc_mau] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [MAU] END)) &#10;)&#10;&#10;-&#10;&#10;(&#10;(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [qc_mau] END) &#10;/ SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [MAU] END)) &#10;)&#10;&#10;&#10;) * 100' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[dmart_pct_fresh_penetration]' role='measure' type='quantitative' />
            <column datatype='real' name='[dmart_wa_den]' role='measure' type='quantitative' />
            <column datatype='real' name='[dmart_wa_num]' role='measure' type='quantitative' />
