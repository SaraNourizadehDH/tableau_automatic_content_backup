          <datasource-dependencies datasource='federated.1u33d850g9lkdp1dfuxpn1sdmmx7'>
            <column caption='Ogv vendors MoM' datatype='real' default-format='p0.0%' name='[AB Acquisitions MoM (copy)_1193172472303448075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [ogv_vendors] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [ogv_vendors] END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [ogv_vendors] END)' />
            </column>
            <column caption='D30 AB Deals and Ads MoM' datatype='real' default-format='*0.0pp' name='[AB Acquisitions MoM (copy)_1455788616381902852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [d30_ab_deals_and_ads_pcnt] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [d30_ab_deals_and_ads_pcnt] END))*100' />
            </column>
            <column caption='Vendor Acquisitions MoM' datatype='real' default-format='p0.0%' name='[AB Acquisitions MoM (copy)_1765411100273885184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [total_vendor_acquisitions] END) &#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [total_vendor_acquisitions]  END)) &#10;/ &#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [total_vendor_acquisitions]  END)' />
            </column>
            <column caption='Zombies Formed MoM' datatype='real' default-format='p0.0%' name='[Calculation_2347782818537582601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -1, TODAY())) THEN [zombies_formed] END) &#13;&#10;- SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [zombies_formed] END)) &#13;&#10;/ &#13;&#10;SUM(IF [month]= DATETRUNC(&apos;month&apos;,  DATEADD(&apos;month&apos;, -2, TODAY())) THEN [zombies_formed] END)' />
            </column>
