            </column>
            <column caption='Pivot Field Values unit (after)' datatype='string' name='[Calculation_4617385936277516293]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Calculation_4617385936636059665]&#10;WHEN &quot;€&apos;000&quot; THEN &quot;K&quot;&#10;WHEN &quot;#&apos;000&quot; THEN &quot;K&quot;&#10;WHEN &quot;%&quot; THEN &quot;%&quot;&#10;WHEN &quot;min&quot; THEN &quot;min&quot;&#10;END' />
            </column>
            <column caption='Pivot Field Values unit (before)' datatype='string' name='[Calculation_4617385936277643270]' role='dimension' type='nominal'>
