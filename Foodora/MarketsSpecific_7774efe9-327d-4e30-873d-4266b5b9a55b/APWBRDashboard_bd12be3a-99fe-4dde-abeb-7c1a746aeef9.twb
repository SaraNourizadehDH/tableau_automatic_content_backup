                <zone fixed-size='142' forceUpdate='true' h='13636' id='459' is-fixed='true' type-v2='text' w='99000' x='500' y='8454'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333'>General rule of thumb:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333'>- For regional_apac_mkt_qcommerce_okr_dashboard: </run>
                    <run bold='true' fontcolor='#333333'>Pass</run>
                    <run fontcolor='#333333'> = W-1 data is available and has no duplicates, otherwise </run>
                    <run bold='true' fontcolor='#333333'>Fail</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333'>- For all other tables: </run>
                    <run bold='true' fontcolor='#333333'>Pass</run>
                    <run fontcolor='#333333'> = Data is available up till at least last Sunday and has no duplicates, otherwise </run>
                    <run bold='true' fontcolor='#333333'>Fail</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333'>- If all tables are marked as </run>
                    <run bold='true' fontcolor='#333333'>Pass</run>
                    <run fontcolor='#333333'>, the WBR dashboard is fresh for W-1 and has no duplicates</run>
