            </column>
            <column caption='Pivot Field Values with format2' datatype='real' name='[Calculation_4617385936278597639]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Calculation_4617385936636059665]&#10;WHEN &quot;€&apos;000&quot; THEN ROUND([Pivot Field Values (Pivot1)]/1000,0)&#10;WHEN &quot;#&apos;000&quot; THEN ROUND([Pivot Field Values (Pivot1)]/1000,0)&#10;WHEN &quot;€&quot; THEN ROUND([Pivot Field Values (Pivot1)],2)&#10;WHEN &quot;#&quot; THEN ROUND([Pivot Field Values (Pivot1)],1)&#10;WHEN &quot;%&quot; THEN ROUND([Pivot Field Values (Pivot1)]*100,1)&#10;WHEN &quot;min&quot; THEN ROUND([Pivot Field Values (Pivot1)],1)&#10;WHEN &quot;ppt&quot; THEN ROUND([Pivot Field Values (Pivot1)],1)&#10;ELSE ROUND([Pivot Field Values (Pivot1)],2)&#10;END' />
            </column>
            <column caption='week with format' datatype='string' name='[Calculation_4617385936294961161]' role='dimension' type='nominal'>
