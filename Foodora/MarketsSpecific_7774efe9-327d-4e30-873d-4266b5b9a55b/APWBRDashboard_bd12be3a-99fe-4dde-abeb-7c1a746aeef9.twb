      <aliases enabled='yes' />
      <column aggregation='Sum' caption='WBR metrics ranking' datatype='integer' name='[Calculation_3742280236480348160]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_3742280236497002498] = &quot;Session&quot; THEN 1&#10;ELSEIF [Calculation_3742280236497002498] = &quot;Conversion Rate&quot; THEN 2&#10;ELSEIF [Calculation_3742280236497002498] = &quot;Orders&quot; THEN 3&#10;ELSEIF [Calculation_3742280236497002498] = &quot;AFV&quot; THEN 4&#10;ELSEIF [Calculation_3742280236497002498] = &quot;Net GMV&quot; THEN 5&#10;ELSEIF CONTAINS([Calculation_3742280236497002498], &quot;DF as %&quot;) THEN 6&#10;ELSEIF CONTAINS([Calculation_3742280236497002498], &quot;CF as %&quot;) THEN 7&#10;ELSEIF [Calculation_3742280236497002498] = &quot;NC&quot; THEN 8&#10;ELSEIF [Calculation_3742280236497002498] = &quot;Active Users&quot; THEN 9&#10;ELSEIF [Calculation_3742280236497002498] = &quot;QC Active Users&quot; THEN 10&#10;ELSEIF [Calculation_3742280236497002498] = &quot;Order Frequency&quot; THEN 11&#10;ELSEIF [Calculation_3742280236497002498] = &quot;DT&quot; THEN 12&#10;ELSEIF [Calculation_3742280236497002498] = &quot;Logistics Index&quot; THEN 13&#10;ELSEIF CONTAINS([Calculation_3742280236497002498], &quot;Fail Rate&quot;) THEN 14&#10;ELSEIF CONTAINS([Calculation_3742280236497002498], &quot;Seamless Orders&quot;) THEN 15&#10;ELSEIF CONTAINS([Calculation_3742280236497002498], &quot;Delays&quot;) THEN 16&#10;ELSEIF CONTAINS([Calculation_3742280236497002498], &quot;CSAT&quot;) THEN 17&#10;END' />
      </column>
      <column caption='Metric Name' datatype='string' name='[Calculation_3742280236497002498]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [metric_name] = &quot;MAU&quot; AND [automation_column_name] = &quot;qcommerce_mau&quot; THEN &quot;QC Active Users&quot;&#10;ELSEIF [metric_name] = &quot;MAU&quot; THEN &quot;Active Users&quot;&#10;ELSE [metric_name]&#10;END' />
      </column>
      <column caption='is delta color opposite' datatype='boolean' name='[Calculation_4237957670525886464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_3742280236497002498] = &quot;DT&quot; OR&#10;CONTAINS([Calculation_3742280236497002498], &quot;delays&quot;) OR&#10;CONTAINS([Calculation_3742280236497002498], &quot;fail rate&quot;) OR&#10;[Calculation_3742280236497002498] = &quot;Logistics Index&quot;' />
      </column>
      <column caption='is last week' datatype='boolean' name='[Calculation_4617385936276140034]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, [report_date_local (Metrics360 Extract (PD)1)], TODAY()) = 1' />
      </column>
      <column caption='delta' datatype='real' name='[Calculation_4617385936276692996]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4617385936636059665] = &quot;%&quot; THEN ROUND(([Pivot Field Values (Pivot1)]-[Pivot Field Values])*100,1)&#10;ELSE ROUND((([Pivot Field Values (Pivot1)]-[Pivot Field Values]) / [Pivot Field Values])*100,1)&#10;END' />
      </column>
      <column caption='Pivot Field Values unit (after)' datatype='string' name='[Calculation_4617385936277516293]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_4617385936636059665]&#10;WHEN &quot;€&apos;000&quot; THEN &quot;K&quot;&#10;WHEN &quot;#&apos;000&quot; THEN &quot;K&quot;&#10;WHEN &quot;%&quot; THEN &quot;%&quot;&#10;WHEN &quot;min&quot; THEN &quot;min&quot;&#10;END' />
      </column>
      <column caption='Pivot Field Values unit (before)' datatype='string' name='[Calculation_4617385936277643270]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_4617385936636059665]&#10;WHEN &quot;€&apos;000&quot; THEN &quot;€&quot;&#10;WHEN &quot;€&quot; THEN &quot;€&quot;&#10;END' />
      </column>
      <column caption='Pivot Field Values with format2' datatype='real' name='[Calculation_4617385936278597639]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Calculation_4617385936636059665]&#10;WHEN &quot;€&apos;000&quot; THEN ROUND([Pivot Field Values (Pivot1)]/1000,0)&#10;WHEN &quot;#&apos;000&quot; THEN ROUND([Pivot Field Values (Pivot1)]/1000,0)&#10;WHEN &quot;€&quot; THEN ROUND([Pivot Field Values (Pivot1)],2)&#10;WHEN &quot;#&quot; THEN ROUND([Pivot Field Values (Pivot1)],1)&#10;WHEN &quot;%&quot; THEN ROUND([Pivot Field Values (Pivot1)]*100,1)&#10;WHEN &quot;min&quot; THEN ROUND([Pivot Field Values (Pivot1)],1)&#10;WHEN &quot;ppt&quot; THEN ROUND([Pivot Field Values (Pivot1)],1)&#10;ELSE ROUND([Pivot Field Values (Pivot1)],2)&#10;END' />
      </column>
      <column caption='delta color' datatype='string' name='[Calculation_4617385936281096200]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4237957670525886464] AND [Calculation_4617385936276692996] &lt; 0 THEN &apos;green&apos;&#10;ELSEIF [Calculation_4237957670525886464] AND [Calculation_4617385936276692996] &gt; 0 THEN &apos;red&apos;&#10;ELSEIF [Calculation_4617385936276692996] &gt; 0 THEN &apos;green&apos;&#10;ELSEIF [Calculation_4617385936276692996] &lt; 0 THEN &apos;red&apos;&#10;END' />
      </column>
      <column caption='week with format' datatype='string' name='[Calculation_4617385936294961161]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;W&quot; + STR(ISOWEEK([report_date_local (Metrics360 Extract (PD)1)])) +&#10;&quot; (&quot; + STR(DAY([report_date_local (Metrics360 Extract (PD)1)])) + &quot; &quot; +&#10;LEFT(DATENAME(&quot;month&quot;,[report_date_local (Metrics360 Extract (PD)1)]),3) + &quot;)&quot;' />
      </column>
      <column caption='attr' datatype='integer' name='[Calculation_4617385936602468364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ATTR(1)' />
      </column>
      <column caption='metric name with unit' datatype='string' name='[Calculation_4617385936625917966]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_4617385936277643270]) AND ISNULL([Calculation_4617385936277516293])&#10;THEN [Calculation_3742280236497002498]&#10;&#10;ELSEIF ISNULL([Calculation_4617385936277643270])&#10;THEN [Calculation_3742280236497002498] + &quot; (&quot; + [Calculation_4617385936277516293] + &quot;)&quot;&#10;&#10;ELSEIF ISNULL([Calculation_4617385936277516293])&#10;THEN [Calculation_3742280236497002498] + &quot; (&quot; + [Calculation_4617385936277643270] + &quot;)&quot;&#10;&#10;ELSE&#10;[Calculation_3742280236497002498] + &quot; (&quot; + [Calculation_4617385936277643270] + &quot; in &quot; + [Calculation_4617385936277516293] + &quot;)&quot;&#10;END' />
      </column>
      <column caption='unit2' datatype='string' name='[Calculation_4617385936636059665]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3742280236497002498] IN (&quot;Session&quot;, &quot;Orders&quot;, &quot;Active Users&quot;, &quot;QC Active Users&quot;, &quot;NC&quot;) THEN &quot;#&apos;000&quot;&#10;ELSE [unit]&#10;END' />
      </column>
      <column caption='delta unit' datatype='string' name='[Calculation_6980368366542843907]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_4617385936636059665]&#10;WHEN &quot;%&quot; THEN &quot;p.p.&quot;&#10;ELSE &quot;%&quot;&#10;END' />
      </column>
      <column caption='Pivot Field Values (L1W)' datatype='real' name='[Pivot Field Values (Pivot1)]' role='dimension' type='ordinal' />
      <column caption='Pivot Field Values unit (after) (copy)' datatype='string' name='[Pivot Field Values unit (after) (copy)_6980368366539251714]' role='dimension' type='nominal'>
