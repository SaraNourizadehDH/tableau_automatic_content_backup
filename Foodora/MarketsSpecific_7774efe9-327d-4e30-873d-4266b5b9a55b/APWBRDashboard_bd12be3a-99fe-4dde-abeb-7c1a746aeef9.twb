            <properties context=''>
              <relation connection='bigquery.16f5sho16gwqj715p54270te0cm9' name='Custom SQL Query' type='text'>WITH pd_metrics AS (
  SELECT
    country_code,
    is_subscriber_order,
    report_date_local,
    date_granularity,
    &quot;regional_apac_pandata_af_metrics360_pd_metrics&quot; AS table_name,
    COUNT(*) AS row_count
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_pandata_af_metrics360_pd_metrics`
  WHERE report_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 MONTH) AND CURRENT_DATE
  GROUP BY
    country_code,
    is_subscriber_order,
    report_date_local,
    date_granularity
),

finance_metrics AS (
  SELECT
    country_code,
    is_subscriber_order,
    report_date_local,
    date_granularity,
    &quot;regional_apac_pandata_af_metrics360_finance_metrics&quot; AS table_name,
    COUNT(*) AS row_count
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_pandata_af_metrics360_finance_metrics`
  WHERE report_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 MONTH) AND CURRENT_DATE
  GROUP BY
    country_code,
    is_subscriber_order,
    report_date_local,
    date_granularity
),

finance_order_level_metrics AS (
  SELECT
    global_entity_id,
    order_date,
    order_uuid,
    &quot;regional_apac_finance_order_level_flgp_platform&quot; AS table_name,
    COUNT(*) AS row_count
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_finance_order_level_flgp_platform`
  WHERE order_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 MONTH) AND CURRENT_DATE
  GROUP BY
    global_entity_id,
    order_date,
    order_uuid
),

mic_metrics AS (
  SELECT
    global_entity_id,
    created_date_local,
    order_uuid,
    &quot;regional_apac_mkt_incentive_cost&quot; AS table_name,
    COUNT(*) AS row_count
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_incentive_cost`
  WHERE partition_month BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 MONTH) AND CURRENT_DATE
  GROUP BY
    global_entity_id,
    created_date_local,
    order_uuid
),

qcommerce_metrics AS (
  SELECT
    global_entity_id,
    date_type,
    report_date_local,
    vertical,
    &quot;regional_apac_mkt_qcommerce_okr_dashboard&quot; AS table_name,
    COUNT(*) AS row_count
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_mkt_qcommerce_okr_dashboard`
  WHERE report_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 MONTH) AND CURRENT_DATE
    AND date_type = &quot;Week&quot;
  GROUP BY
    global_entity_id,
    date_type,
    report_date_local,
    vertical
),

nc_metrics AS (
  SELECT
    global_entity_id,
    analytical_customer_id,
    first_valid_order_date_utc,
    &quot;regional_apac_bmp_agg_customer_acquisition&quot; AS table_name,
    COUNT(*) AS row_count
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_bmp_agg_customer_acquisition`
  WHERE first_valid_order_date_utc BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 MONTH) AND CURRENT_DATE
  GROUP BY
    global_entity_id,
    analytical_customer_id,
    first_valid_order_date_utc
),

csat_metrics AS (
  SELECT
    global_entity_id,
    response_date_local,
    uuid,
    &quot;regional_apac_cx_ac_csat_responses&quot; AS table_name,
    COUNT(*) AS row_count
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_cx_ac_csat_responses`
  WHERE response_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 MONTH) AND CURRENT_DATE
  GROUP BY
    global_entity_id,
    response_date_local,
    uuid
),

lg_performance_metrics AS (
  SELECT
    global_entity_id,
    report_date,
    &quot;regional_apac_lg_performance&quot; AS table_name,
    1 AS row_count
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_performance`
  WHERE report_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 MONTH) AND CURRENT_DATE
  GROUP BY
    global_entity_id,
    report_date
),

lg_staffing_metrics AS (
  SELECT
    global_entity_id,
    report_date,
    lg_city_id,
    lg_zone_id,
    &quot;regional_apac_lg_rider_staffing&quot; AS table_name,
    COUNT(*) AS row_count
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_rider_staffing`
  WHERE report_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 MONTH) AND CURRENT_DATE
  GROUP BY
    global_entity_id,
    report_date,
    lg_city_id,
    lg_zone_id
),

seamless_order_metrics AS (
  SELECT
    global_entity_id,
    ordered_at_date_local,
    &quot;regional_apac_cx_seamless_orders_cx_2_report&quot; AS table_name,
    1 AS row_count
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_cx_seamless_orders_cx_2_report`
  WHERE ordered_at_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 MONTH) AND CURRENT_DATE
  GROUP BY
    global_entity_id,
    ordered_at_date_local
),

perseus_metrics AS (
  SELECT
    global_entity_id,
    partition_date,
    platform,
    vertical,
    &quot;product__x_product_executive_dashboard_perseus&quot; AS table_name,
    COUNT(*) AS row_count
  FROM `fulfillment-dwh-production.pandata_report.product__x_product_executive_dashboard_perseus`
  WHERE partition_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 MONTH) AND CURRENT_DATE
  GROUP BY
    global_entity_id,
    partition_date,
    platform,
    vertical
),

fail_rate_metrics AS (
  SELECT
    global_entity_id,
    report_date,
    &quot;regional_apac_lg_tb_weekly_kpi&quot; AS table_name,
    COUNT(*) AS row_count
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_tb_weekly_kpi`
  WHERE report_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 MONTH) AND CURRENT_DATE
  GROUP BY
    global_entity_id,
    report_date
),

order_late_metrics AS (
  SELECT
    global_entity_id,
    reference_date_local,
    vendor_type,
    expedition_type,
    is_corporate,
    is_group_order,
    &quot;regional_apac_lg_tb_daily_ops_kpi&quot; AS table_name,
    COUNT(*) AS row_count
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_tb_daily_ops_kpi`
  WHERE reference_date_local BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE, MONTH), INTERVAL 1 MONTH) AND CURRENT_DATE
  GROUP BY
    global_entity_id,
    reference_date_local,
    vendor_type,
    expedition_type,
    is_corporate,
    is_group_order
),

combined AS (
  SELECT
    table_name,
    MAX(report_date_local) AS max_date,
    COUNTIF(row_count &gt;&gt; 1) AS no_of_dups
  FROM pd_metrics
  GROUP BY table_name

  UNION ALL

  SELECT
    table_name,
    MAX(report_date_local) AS max_date,
    COUNTIF(row_count &gt;&gt; 1) AS no_of_dups
  FROM finance_metrics
  GROUP BY table_name

  UNION ALL

  SELECT
    table_name,
    MAX(order_date) AS max_date,
    COUNTIF(row_count &gt;&gt; 1) AS no_of_dups
  FROM finance_order_level_metrics
  GROUP BY table_name

  UNION ALL

  SELECT
    table_name,
    MAX(created_date_local) AS max_date,
    COUNTIF(row_count &gt;&gt; 1) AS no_of_dups
  FROM mic_metrics
  GROUP BY table_name

  UNION ALL

  SELECT
    table_name,
    MAX(report_date_local) AS max_date,
    COUNTIF(row_count &gt;&gt; 1) AS no_of_dups
  FROM qcommerce_metrics
  GROUP BY table_name

  UNION ALL

  SELECT
    table_name,
    MAX(first_valid_order_date_utc) AS max_date,
    COUNTIF(row_count &gt;&gt; 1) AS no_of_dups
  FROM nc_metrics
  GROUP BY table_name

  UNION ALL

  SELECT
    table_name,
    MAX(response_date_local) AS max_date,
    COUNTIF(row_count &gt;&gt; 1) AS no_of_dups
  FROM csat_metrics
  GROUP BY table_name

  UNION ALL

  SELECT
    table_name,
    MAX(report_date) AS max_date,
    COUNTIF(row_count &gt;&gt; 1) AS no_of_dups
  FROM lg_performance_metrics
  GROUP BY table_name

  UNION ALL

  SELECT
    table_name,
    MAX(report_date) AS max_date,
    COUNTIF(row_count &gt;&gt; 1) AS no_of_dups
  FROM lg_staffing_metrics
  GROUP BY table_name

  UNION ALL

  SELECT
    table_name,
    MAX(ordered_at_date_local) AS max_date,
    COUNTIF(row_count &gt;&gt; 1) AS no_of_dups
  FROM seamless_order_metrics
  GROUP BY table_name

  UNION ALL

  SELECT
    table_name,
    MAX(partition_date) AS max_date,
    COUNTIF(row_count &gt;&gt; 1) AS no_of_dups
  FROM perseus_metrics
  GROUP BY table_name

  UNION ALL

  SELECT
    table_name,
    MAX(report_date) AS max_date,
    COUNTIF(row_count &gt;&gt; 1) AS no_of_dups
  FROM fail_rate_metrics
  GROUP BY table_name

  UNION ALL

  SELECT
    table_name,
    MAX(reference_date_local) AS max_date,
    COUNTIF(row_count &gt;&gt; 1) AS no_of_dups
  FROM order_late_metrics
  GROUP BY table_name
),

master_list AS (
  SELECT
    data_source,
    STRING_AGG(
      CASE
        WHEN metric_name = &quot;MAU&quot; AND automation_column_name = &quot;qcommerce_mau&quot; THEN &quot;QC Active Users&quot;
        WHEN metric_name = &quot;MAU&quot; THEN &quot;Active Users&quot;
        ELSE metric_name
      END
      , &quot;, &quot;) AS metric_name
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_pandata_af_metrics360_master_list`,
  UNNEST(SPLIT(data_source, &quot;\n&quot;)) AS data_source
  WHERE wbr_dashboard = &quot;Yes&quot;
    AND data_source IS NOT NULL
  GROUP BY data_source
)

SELECT
  combined.*,
  CASE
    WHEN REGEXP_CONTAINS(combined.table_name, &quot;metrics360&quot;) THEN &quot;Base table for all metrics&quot;
    ELSE master_list.metric_name
  END AS metric_name
FROM combined
LEFT JOIN master_list
       ON combined.table_name = master_list.data_source</relation>
            </properties>
