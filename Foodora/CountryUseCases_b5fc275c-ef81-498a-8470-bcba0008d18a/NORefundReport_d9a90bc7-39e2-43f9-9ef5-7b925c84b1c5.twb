      <aliases enabled='yes' />
      <column caption='Total Refunds (LC)' datatype='real' name='[# Total Refunds (copy)_2395352072293691395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([full_refunds_amt],0)+IFNULL([partial_refunds_amt],0)' />
      </column>
      <column caption='Has Refund' datatype='string' name='[Calculation_1206683241436168194]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [# Total Refunds (copy)_2395352072293691395] &gt; 0 THEN &quot;Y&quot; ELSE &quot;N&quot; END' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_1476899219047751680]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Daily&quot; THEN STR([report_date])&#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;WHEN &quot;Monthly&quot; THEN LEFT(STR([report_month]),7)&#13;&#10;END' />
      </column>
      <column caption='% Partial Refunds (of Gross Orders)' datatype='real' name='[Calculation_1476899219048456193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([partial_refunds])/SUM([gross_orders])' />
      </column>
      <column caption='Avg. Partial Refund (LC)' datatype='real' name='[Calculation_1476899219048620034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([partial_refunds_amt])/SUM([partial_refunds])' />
      </column>
      <column caption='% Partial Refund of GFV' datatype='real' name='[Calculation_1476899219048742915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([partial_refunds_amt])/SUM([partial_refund_gfv_initial])' />
      </column>
      <column caption='# Partial Refunds w Wrong/Missing Item Ticket' datatype='integer' name='[Calculation_1476899219048931332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[partial_refunds_wrong_missing_item]' />
      </column>
      <column caption='# Gross Orders' datatype='integer' name='[Calculation_1476899219049771013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[gross_orders]' />
      </column>
      <column caption='# Remove Items' datatype='integer' name='[Calculation_1476899219050594310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[removed_quantity]' />
      </column>
