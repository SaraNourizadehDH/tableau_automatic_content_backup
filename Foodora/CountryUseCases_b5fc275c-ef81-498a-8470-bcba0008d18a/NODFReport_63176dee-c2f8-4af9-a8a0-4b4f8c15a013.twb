      <aliases enabled='yes' />
      <column caption='Orders' datatype='integer' name='[# Successful Orders (copy)_1258474674191847455]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='TOTAL(zn(sum([successful_orders])))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='# Successful Orders - VD' datatype='integer' name='[# Successful Orders - OD (copy)_1258474674142564356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [delivery_type]=&quot;VD&quot; THEN [successful_orders] ELSE 0  END)' />
      </column>
      <column caption='# Successful Orders - Pickup' datatype='integer' name='[# Successful Orders - VD (copy)_1258474674142650373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [delivery_type]=&quot;PICKUP&quot; THEN [successful_orders] ELSE 0  END)' />
      </column>
      <column caption='% DF of Customer Paid - Adjusted' datatype='real' name='[% DF of Customer Paid (copy)_1258474674150916104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [delivery_fee] END)/sum(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [non_free_delivery_customer_paid_local] END)' />
      </column>
      <column caption='% VD' datatype='real' name='[% OD (copy)_1258474674142162945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [delivery_type]=&quot;VD&quot; THEN [successful_orders] ELSE 0 END)/sum([successful_orders])' />
      </column>
      <column caption='% Pickup' datatype='real' name='[% OD (copy)_1258474674146381830]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [delivery_type]=&quot;PICKUP&quot; THEN [successful_orders] ELSE 0 END)/sum([successful_orders])' />
      </column>
      <column caption='Avg. DF' datatype='real' name='[Avg. DF (LC) (copy)_1258474674192457760]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='ROUND(TOTAL(ZN(SUM(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [delivery_fee] END)))/TOTAL(ZN(SUM(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [successful_orders] END))),1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg. DF (LC) - Adjusted Excl. VAT' datatype='real' name='[Avg. DF (LC) - Adjusted (copy)_314970555088453632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [delivery_fee_ex_vat] END)/SUM(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [non_free_delivery_no] END)' />
      </column>
      <column caption='Avg. DF (LC) - Adjusted' datatype='real' name='[Avg. DF (copy)_584623579609341955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [delivery_fee] END)/SUM(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [non_free_delivery_no] END)' />
      </column>
      <column caption='% OD' datatype='real' name='[Calculation_1258474674142044160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [delivery_type]=&quot;OD&quot; THEN [successful_orders] ELSE 0 END)/sum([successful_orders])' />
      </column>
      <column caption='# Successful Orders - OD' datatype='integer' name='[Calculation_1258474674142429187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [delivery_type]=&quot;OD&quot; THEN [successful_orders] ELSE 0  END)' />
      </column>
      <column caption='% DF of Customer Paid' datatype='real' name='[Calculation_1258474674147758087]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [delivery_fee] END)/sum(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [customer_paid_local] END)' />
      </column>
      <column caption='Date Drill Down (+)' datatype='string' name='[Calculation_1258474674193960993]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF 1=1 THEN &quot;&quot; END' />
      </column>
      <column caption='Total delivery Fee (incl. Priority Fee)' datatype='real' name='[Calculation_227220684125552640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[delivery_fee] + [delivery_priority_fee_local]' />
      </column>
      <column caption='% Priority Delivery Fee of Total' datatype='real' name='[Calculation_227220684136402945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[delivery_priority_fee_local]/[Calculation_227220684125552640]' />
      </column>
      <column caption='% Successful Priority Delivery Orders' datatype='real' name='[Calculation_227220684154601475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_priority_delivery_orders])/[Calculation_1258474674142429187]' />
      </column>
      <column caption='Avg. Priority Delivery Fee  (LC)' datatype='real' name='[Calculation_227220684156198916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_priority_fee_local])/SUM([successful_priority_delivery_orders])' />
      </column>
      <column caption='Zone' datatype='string' name='[Calculation_565201797959823360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;City (Simplified)&quot; THEN [log_zone]&#13;&#10;WHEN &quot;City (Detailed)&quot; THEN &quot;Not Applicable&quot;&#13;&#10;END' />
      </column>
      <column caption='test_vat' datatype='real' name='[Calculation_565201797986398212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IFNULL([delivery_fee],0)-IFNULL([delivery_fee_ex_vat],0))/sum(IFNULL([delivery_fee_ex_vat],0))' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_584623579604656128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Monthly&quot; THEN LEFT(STR([report_month]),7)&#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;END' />
      </column>
      <column caption='Avg. DF (LC)' datatype='real' name='[Calculation_584623579608010754]' role='measure' type='quantitative'>
