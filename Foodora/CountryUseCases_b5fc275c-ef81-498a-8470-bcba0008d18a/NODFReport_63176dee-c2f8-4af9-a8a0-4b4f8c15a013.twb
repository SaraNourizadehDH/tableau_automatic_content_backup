    <dashboard name='Info'>
      <style />
      <size maxheight='1050' maxwidth='1640' minheight='1050' minwidth='1640' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='6' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='73745' id='5' type-v2='text' w='99024' x='488' y='21611'>
            <formatted-text>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' underline='true'>Time period</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#333333'>Weekly/monthly available for last 13 months</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>Daily information available for last 12 months</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#333333' underline='true'>City types</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>City (Simplified) = Customer order city re-allocated to most common Logistic City where applicable, otherwise Customer order city kept.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>City (Detailed) = Customer order city as per backend.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#333333' underline='true'>DF Categories</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'><![CDATA[All unique delivery fees that has represented 3% or more of monthly total in any of the last 13 months will be separated. Low frequency delivery fees (< 3%) are grouped into "Other".]]></run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontcolor='#333333' underline='true'>Metrics</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#333333'># Succesful Orders = Number of orders that were successful.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>Avg. DF (LC) = Average delivery fee </run>
              <run bold='true' fontcolor='#333333'>including</run>
              <run fontcolor='#333333'> 0 zero delivery fee and pickup orders (local currency).</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>Avg. DF (LC) - Adjusted = Average delivery fee </run>
              <run bold='true' fontcolor='#333333'>excluding</run>
              <run fontcolor='#333333'> 0 zero delivery fee and pickup orders (local currency).</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>Avg. DF (LC) - Excl. VAT = Avg. delivery fee after tax/VAT.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#333333'>% of Successful Orders = % of total successful orders represented by the delivery fee.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#333333'>Avg. GFV (LC) = Average gross food value.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>Avg. Customer Paid (LC) = Average amount paid by the customer after deductions made for discounts and vouchers.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#333333'>% DF of Customer Paid = % of the customer paid amount represented by delivery fee amount.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>% DF of Customer Paid - Adjusted = % of of the customer paid amount represented by delivery fee amount, excluding orders with delivery fee = 0.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#333333'>% Free Delivery = % of successful orders with delivery fee = 0 (including pickup). </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#333333' italic='true'>% of Free Delivery By Source:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>     % Pickup - No DF = Delivery fee = 0 due to pickup order</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>     % Co-Funded = Discount/voucher ratio in backend split between platform and vendor</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>     % Platform Funded = Discount/voucher ratio in backend fully allocated to platform (or delivery fee hard coded to zero and delivery type = OD)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>     % Vendor Funded= Discount/voucher ratio in backend fully allocated to vendor (or delivery fee hard coded to zero and delivery type = VD)</run>
              <run>Æ&#10;&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='3882' id='7' type-v2='empty' w='99024' x='488' y='95356'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
