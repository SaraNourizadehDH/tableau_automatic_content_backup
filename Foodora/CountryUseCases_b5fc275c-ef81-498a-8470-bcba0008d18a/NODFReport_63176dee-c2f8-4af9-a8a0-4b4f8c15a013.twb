    <worksheet name='Summary - % Free Delivery'>
      <table>
        <view>
          <datasources>
            <datasource caption='report_df (bl_nordics)' name='federated.0vh5im40xlcj6w1gmpxdq17uc5is' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Dim Para' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Select City Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;City (Simplified)&quot;'>
              <calculation class='tableau' formula='&quot;City (Simplified)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vh5im40xlcj6w1gmpxdq17uc5is'>
            <column caption='Avg. DF (LC) - Adjusted' datatype='real' name='[Avg. DF (copy)_584623579609341955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [delivery_fee] END)/SUM(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [non_free_delivery_no] END)' />
            </column>
            <column caption='Zone' datatype='string' name='[Calculation_565201797959823360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;City (Simplified)&quot; THEN [log_zone]&#13;&#10;WHEN &quot;City (Detailed)&quot; THEN &quot;Not Applicable&quot;&#13;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_584623579604656128]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Monthly&quot; THEN LEFT(STR([report_month]),7)&#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;END' />
            </column>
            <column caption='Avg. DF (LC)' datatype='real' name='[Calculation_584623579608010754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [delivery_fee] END)/SUM(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [successful_orders] END)' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_584623579614461956]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;City (Simplified)&quot; THEN [super_city]&#13;&#10;WHEN &quot;City (Detailed)&quot; THEN [city_name]&#13;&#10;END' />
            </column>
            <column caption='Avg. GFV (LC)' datatype='real' name='[Calculation_584623579615805445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gfv_local])/sum([successful_orders])' />
            </column>
            <column caption='Avg. Customer Paid (LC)' datatype='real' name='[Calculation_584623579615924230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customer_paid_local])/sum([successful_orders])' />
            </column>
            <column caption='Date Filter' datatype='date' name='[Calculation_584623579617427463]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Monthly&quot; THEN [report_month]&#13;&#10;WHEN &quot;Weekly&quot; THEN [week_commencing_date]&#13;&#10;END' />
            </column>
            <column caption='# Successful Orders' datatype='integer' name='[Calculation_584623579621150729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders])' />
            </column>
            <column caption='% Platform Funded' datatype='real' name='[Calculation_584623579629395982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([platform_free_delivery])/sum(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [free_delivery_no] END)' />
            </column>
            <column caption='% Vendor Funded' datatype='real' name='[Calculation_584623579629518863]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vendor_free_delivery])/sum(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [free_delivery_no] END)' />
            </column>
            <column caption='% Co Funded' datatype='real' name='[Calculation_584623579629576208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cofunded_free_delivery])/sum(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [free_delivery_no] END)' />
            </column>
            <column caption='% Pickup - No DF' datatype='real' name='[Calculation_584623579629662225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_type]=&quot;PICKUP&quot; THEN [successful_orders] END)/sum([free_delivery_no])' />
            </column>
            <column caption='% Free Delivery' datatype='real' name='[Calculation_584623579630174226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [free_delivery_no] END)/sum(IF [delivery_type]&lt;&gt;&quot;PICKUP&quot; THEN [successful_orders] END)' />
            </column>
            <column aggregation='None' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
