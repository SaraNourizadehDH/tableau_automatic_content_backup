              <calculation class='tableau' formula='[warehouse_name_backend]' />
            </column>
            <column caption='Items Per Order' datatype='real' name='[Calculation_612489560988573701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivered_qty])/SUM([orders])' />
            </column>
            <column caption='Waste - WAC  (LC)' datatype='real' name='[Calculation_612489560989089798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([waste_qty_wac])' />
            </column>
            <column caption='% Waste' datatype='real' name='[Calculation_612489560989466631]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([waste_qty_wac])/(SUM([delivered_qty_wac])+SUM([waste_qty_wac]))' />
            </column>
            <column caption='% Change 7d - Delivered Items' datatype='real' name='[Calculation_612489560990027785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [day1to7]=TRUE THEN [delivered_qty] END)&#13;&#10;/ SUM(IF [day8to14]=TRUE THEN [delivered_qty] END)-1' />
            </column>
            <column caption='On Hand EOB' datatype='integer' name='[Calculation_612489560994312204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [report_date] = DATEADD(&apos;day&apos;,-1,TODAY()) THEN [stock_quantity_day] END)' />
            </column>
