      <aliases enabled='yes' />
      <column caption='Change 7d - Waste WAC (LC)' datatype='real' name='[% Change 7d - Delivered Items (copy)_612489560990654474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [day1to7]=TRUE THEN [waste_qty_wac] END)&#13;&#10;- SUM(IF [day8to14]=TRUE THEN [waste_qty_wac] END)' />
      </column>
      <column caption='% Change 7d - % Waste' datatype='real' name='[% Change 7d - Delivered Items (copy)_612489560993181707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM(IF [day1to7]=TRUE THEN [waste_qty_wac] END)&#13;&#10;/(&#13;&#10;SUM(IF [day1to7]=TRUE THEN [delivered_qty_wac] END)&#13;&#10;+SUM(IF [day1to7]=TRUE THEN [waste_qty_wac] END)&#13;&#10;)&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(IF [day8to14]=TRUE THEN [waste_qty_wac] END)&#13;&#10;/(&#13;&#10;SUM(IF [day8to14]=TRUE THEN [delivered_qty_wac] END)&#13;&#10;+SUM(IF [day8to14]=TRUE THEN [waste_qty_wac] END)&#13;&#10;)&#13;&#10;)-1' />
      </column>
      <column caption='Last Delivered Date' datatype='string' name='[Calculation_612489560982286339]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([last_delivered_date])' />
      </column>
      <column caption='Warehouse  ' datatype='string' name='[Calculation_612489560984281092]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[warehouse_name_backend]' />
      </column>
      <column caption='Items Per Order' datatype='real' name='[Calculation_612489560988573701]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivered_qty])/SUM([orders])' />
      </column>
      <column caption='Waste - WAC  (LC)' datatype='real' name='[Calculation_612489560989089798]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([waste_qty_wac])' />
      </column>
      <column caption='% Waste' datatype='real' name='[Calculation_612489560989466631]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([waste_qty_wac])/(SUM([delivered_qty_wac])+SUM([waste_qty_wac]))' />
      </column>
      <column caption='% Change 7d - Delivered Items' datatype='real' name='[Calculation_612489560990027785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [day1to7]=TRUE THEN [delivered_qty] END)&#13;&#10;/ SUM(IF [day8to14]=TRUE THEN [delivered_qty] END)-1' />
      </column>
      <column caption='On Hand EOB' datatype='integer' name='[Calculation_612489560994312204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [report_date] = DATEADD(&apos;day&apos;,-1,TODAY()) THEN [stock_quantity_day] END)' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
