    <worksheet name='Voucher (NOK)'>
      <table>
        <view>
          <datasources>
            <datasource caption='report_restaurant_gpo_analysis (bl_bi)' name='federated.0zbcs6b14rc8420zrwt7c0gcdjl4' />
          </datasources>
          <datasource-dependencies datasource='federated.0zbcs6b14rc8420zrwt7c0gcdjl4'>
            <column caption='Total Voucher (NOK)' datatype='real' name='[Calculation_4723220489745289250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([dh_df_voucher_value_local],0)+IFNULL([dh_non_df_voucher_value_local],0)' />
            </column>
            <column caption='Avg. Voucher Value (NOK)' datatype='real' name='[Calculation_4723220489745743907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4723220489745289250])/SUM([gross_orders])' />
            </column>
            <column caption='DH DF Voucher Value (NOK)' datatype='real' name='[dh_df_voucher_value_local]' role='measure' type='quantitative' />
            <column caption='DH Non DF Voucher Value (NOK)' datatype='real' name='[dh_non_df_voucher_value_local]' role='measure' type='quantitative' />
            <column caption='# Gross Orders' datatype='integer' name='[gross_orders]' role='measure' type='quantitative' />
            <column-instance column='[order_delivery_type]' derivation='None' name='[none:order_delivery_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_month]' derivation='None' name='[none:report_month:nk]' pivot='key' type='nominal' />
            <column caption='Order Delivery Type' datatype='string' name='[order_delivery_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Own Delivery&quot;' value='OD' />
                <alias key='&quot;Pickup&quot;' value='PU' />
                <alias key='&quot;Vendor Delivery&quot;' value='VD' />
              </aliases>
            </column>
