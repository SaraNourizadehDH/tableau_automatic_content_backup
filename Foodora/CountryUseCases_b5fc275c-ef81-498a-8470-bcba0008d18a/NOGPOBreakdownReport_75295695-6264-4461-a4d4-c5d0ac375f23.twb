      <column caption='Report Month Filter' datatype='string' name='[Calculation_6170072238832484353]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6170072238832082944] = DATE(LEFT(STR(TODAY()),8) + &quot;01&quot;)&#10;THEN &quot;This Month&quot;&#10;ELSE [report_month]&#10;END' />
      </column>
      <column caption='Pro Fee Per Order' datatype='real' name='[Calculation_732257198762000384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sb_fee])/SUM([successful_orders])' />
      </column>
      <column caption='GPO (NOK)' datatype='real' name='[FLGPO (copy)_4349843941318807553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Fully Loaded Profit (copy)_4349843941318676480])/SUM([successful_orders])' />
      </column>
      <column caption='Profit (NOK)' datatype='real' name='[Fully Loaded Profit (copy)_4349843941318676480]' role='measure' type='quantitative'>
