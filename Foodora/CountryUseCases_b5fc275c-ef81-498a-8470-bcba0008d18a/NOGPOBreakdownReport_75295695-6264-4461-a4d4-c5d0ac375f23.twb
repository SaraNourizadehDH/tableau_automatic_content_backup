      <column caption='Fully Loaded Profit (NOK)' datatype='real' name='[Calculation_4723220489454276610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4723220489433927680]-[Calculation_4723220489435082753]-[Calculation_308496586677239835]' />
      </column>
      <column caption='CPO (NOK)' datatype='real' name='[Calculation_4723220489454895107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4723220489435082753])/SUM([successful_orders])' />
      </column>
      <column caption='Take in per order (NOK)' datatype='real' name='[Calculation_4723220489454997508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4723220489433927680])/SUM([successful_orders])' />
      </column>
      <column caption='FLGPO (NOK)' datatype='real' name='[Calculation_4723220489455169541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4723220489454276610])/SUM([successful_orders])' />
      </column>
      <column caption='% CR Bucket' datatype='string' name='[Calculation_4723220489457614854]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF FLOAT([sf_commission_percentage]) &lt;= 5 THEN &apos;5&apos;&#10;ELSEIF FLOAT([sf_commission_percentage]) &lt;= 10 THEN &apos;10&apos;&#10;ELSEIF FLOAT([sf_commission_percentage]) &lt;= 15 THEN &apos;15&apos;&#10;ELSEIF FLOAT([sf_commission_percentage]) &lt;= 20 THEN &apos;20&apos;&#10;ELSEIF FLOAT([sf_commission_percentage]) &lt;= 25 THEN &apos;25&apos;&#10;ELSEIF FLOAT([sf_commission_percentage]) &lt;= 30 THEN &apos;30&apos;&#10;ELSEIF FLOAT([sf_commission_percentage]) &lt;= 35 THEN &apos;35&apos;&#10;ELSEIF FLOAT([sf_commission_percentage]) &lt;= 40 THEN &apos;40&apos;&#10;END' />
      </column>
      <column caption='Partial Refund CPO (NOK)' datatype='real' name='[Calculation_4723220489461706759]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([partial_refund_cost_local])/SUM([successful_orders])' />
      </column>
      <column caption='Delivery CPO (NOK)' datatype='real' name='[Calculation_4723220489462132744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_cost_local])/SUM([successful_orders])' />
      </column>
      <column caption='% Voucher Utilization' datatype='real' name='[Calculation_4723220489462812681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_voucher_orders])/SUM([successful_orders])' />
      </column>
      <column caption='Order Frequency Vendor Level' datatype='real' name='[Calculation_4723220489465839626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gross_orders])/SUM([active_customers])' />
      </column>
      <column caption='-- Total Costs' datatype='integer' name='[Calculation_4723220489711517708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(NULL)' />
      </column>
      <column caption='-- CPO' datatype='integer' name='[Calculation_4723220489711685645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(NULL)' />
      </column>
      <column caption='Compensation CPO (NOK)' datatype='real' name='[Calculation_4723220489711788046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([compensation_cost_local])/SUM([successful_orders])' />
      </column>
      <column caption='DF Discount CPO (NOK)' datatype='real' name='[Calculation_4723220489712164879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([dh_df_dicount_amount_local],0))/SUM([successful_orders])' />
      </column>
      <column caption='Non DF Discount CPO (NOK)' datatype='real' name='[Calculation_4723220489712283664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dh_non_df_dicount_amount_local])/SUM([successful_orders])' />
      </column>
      <column caption='DF Voucher CPO (NOK)' datatype='real' name='[Calculation_4723220489712463889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dh_df_voucher_value_local])/SUM([successful_orders])' />
      </column>
      <column caption='Non DF Voucher CPO (NOK)' datatype='real' name='[Calculation_4723220489712623634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dh_non_df_voucher_value_local])/SUM([successful_orders])' />
      </column>
      <column caption='Full Refund CPO (NOK)' datatype='real' name='[Calculation_4723220489712795667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([full_refund_cost_local])/SUM([successful_orders])' />
      </column>
      <column caption='Contact Center CPO (NOK)' datatype='real' name='[Calculation_4723220489713115157]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([service_sga_cost_local])/SUM([successful_orders])' />
      </column>
      <column caption='Order Delivery Group' datatype='string' name='[Calculation_4723220489715666966]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_delivery_type]=&apos;Own Delivery&apos; THEN &apos;Delivery&apos; ELSE &apos;Market Place&apos; END' />
      </column>
      <column caption='Semi Variable Delivery CPO (NOK)' datatype='real' name='[Calculation_4723220489723211799]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_sga_cost_local])/SUM([successful_orders])' />
      </column>
      <column caption='-- Total Take In' datatype='integer' name='[Calculation_4723220489726853144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(NULL)' />
      </column>
      <column caption='-- Take In Per Order' datatype='integer' name='[Calculation_4723220489726906393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(NULL)' />
      </column>
      <column caption='Container Price Per Order (NOK)' datatype='real' name='[Calculation_4723220489727033370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([container_price_local])/SUM([successful_orders])' />
      </column>
      <column caption='Delivery Fee Per Order (NOK)' datatype='real' name='[Calculation_4723220489727160347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_fee_local])/SUM([successful_orders])' />
      </column>
      <column caption='Surcharge Per Order (NOK)' datatype='real' name='[Calculation_4723220489727291420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([difference_to_minimum_local])/SUM([successful_orders])' />
      </column>
      <column caption='Commission Revenue Per Order (NOK)' datatype='real' name='[Calculation_4723220489727393821]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([estimated_commission_local])/SUM([successful_orders])' />
      </column>
      <column caption='Service Fee Per Order (NOK)' datatype='real' name='[Calculation_4723220489727983647]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([service_fee_local])/SUM([successful_orders])' />
      </column>
      <column caption='% Fail Rate' datatype='real' name='[Calculation_4723220489731358752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders])/SUM([gross_orders])' />
      </column>
      <column caption='AFV (NOK)' datatype='real' name='[Calculation_4723220489743519777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv_local])/SUM([successful_orders])' />
      </column>
      <column caption='Total Voucher (NOK)' datatype='real' name='[Calculation_4723220489745289250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([dh_df_voucher_value_local],0)+IFNULL([dh_non_df_voucher_value_local],0)' />
      </column>
      <column caption='Avg. Voucher Value (NOK)' datatype='real' name='[Calculation_4723220489745743907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4723220489745289250])/SUM([gross_orders])' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_4723220489762652209]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &apos;Chain Name&apos; THEN [chain_name]&#10;  WHEN &apos;City&apos; THEN [pd_city]&#10;  WHEN &apos;Log City&apos; THEN [lg_city]&#10;  WHEN &apos;Log Zone&apos; THEN [lg_zone]&#10;  WHEN &apos;Cuisine&apos; THEN [primary_cuisine]&#10;  WHEN &apos;Order Delivery Type&apos; THEN [order_delivery_type]&#10;  WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;  WHEN &apos;Vendor Name&apos; THEN [vendor_name]&#10;END' />
      </column>
      <column caption='FLGPO Color' datatype='integer' name='[Calculation_4723220489763811378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4723220489455169541] &gt; 0 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Report Date calc' datatype='date' name='[Calculation_6170072238832082944]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([report_month] + &quot;-01&quot;)' />
