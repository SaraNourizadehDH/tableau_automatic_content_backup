    <worksheet name='GPO Breakdown Chart'>
      <table>
        <view>
          <datasources>
            <datasource caption='report_restaurant_gpo_analysis (bl_bi)' name='federated.0zbcs6b14rc8420zrwt7c0gcdjl4' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Log City&quot;'>
              <calculation class='tableau' formula='&quot;Log City&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zbcs6b14rc8420zrwt7c0gcdjl4'>
            <column caption='-[DF Discount CPO (NOK)]' datatype='real' name='[Calculation_308496586672852994]' role='measure' type='quantitative' user:unnamed='GPO Breakdown Chart'>
              <calculation class='tableau' formula='-[Calculation_4723220489712164879]' />
            </column>
            <column caption='-[DF Voucher CPO (NOK)]' datatype='real' name='[Calculation_308496586672881667]' role='measure' type='quantitative' user:unnamed='GPO Breakdown Chart'>
              <calculation class='tableau' formula='-[Calculation_4723220489712463889]' />
            </column>
            <column caption='-[Non DF Discount CPO (NOK)]' datatype='real' name='[Calculation_308496586672889860]' role='measure' type='quantitative' user:unnamed='GPO Breakdown Chart'>
              <calculation class='tableau' formula='-[Calculation_4723220489712283664]' />
            </column>
            <column caption='-[Non DF Voucher CPO (NOK)]' datatype='real' name='[Calculation_308496586672898053]' role='measure' type='quantitative' user:unnamed='GPO Breakdown Chart'>
              <calculation class='tableau' formula='-[Calculation_4723220489712623634]' />
            </column>
            <column caption='-[Partial Refund CPO (NOK)]' datatype='real' name='[Calculation_308496586672910342]' role='measure' type='quantitative' user:unnamed='GPO Breakdown Chart'>
              <calculation class='tableau' formula='-[Calculation_4723220489461706759]' />
            </column>
            <column caption='-[Full Refund CPO (NOK)]' datatype='real' name='[Calculation_308496586672930824]' role='measure' type='quantitative' user:unnamed='GPO Breakdown Chart'>
              <calculation class='tableau' formula='-[Calculation_4723220489712795667]' />
            </column>
            <column caption='-[Delivery CPO (NOK)]' datatype='real' name='[Calculation_308496586672939017]' role='measure' type='quantitative' user:unnamed='GPO Breakdown Chart'>
              <calculation class='tableau' formula='-[Calculation_4723220489462132744]' />
            </column>
            <column caption='-[Semi Variable Delivery CPO (NOK)]' datatype='real' name='[Calculation_308496586672947210]' role='measure' type='quantitative' user:unnamed='GPO Breakdown Chart'>
              <calculation class='tableau' formula='-[Calculation_4723220489723211799]' />
            </column>
            <column caption='-[Contact Center CPO (NOK)]' datatype='real' name='[Calculation_308496586672955403]' role='measure' type='quantitative' user:unnamed='GPO Breakdown Chart'>
              <calculation class='tableau' formula='-[Calculation_4723220489713115157]' />
            </column>
            <column caption='-[Compensation CPO (NOK)]' datatype='real' name='[Calculation_308496586672963596]' role='measure' type='quantitative' user:unnamed='GPO Breakdown Chart'>
              <calculation class='tableau' formula='-[Calculation_4723220489711788046]' />
            </column>
            <column caption='-[CPO (NOK)]' datatype='real' name='[Calculation_308496586672975885]' role='measure' type='quantitative' user:unnamed='GPO Breakdown Chart'>
              <calculation class='tableau' formula='-[Calculation_4723220489454895107]' />
            </column>
            <column caption='DH Basket Incentives (NOK)' datatype='real' name='[Calculation_308496586677239835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([dh_df_dicount_amount_local],0)&#10;+IFNULL([dh_non_df_dicount_amount_local],0)&#10;+IFNULL([dh_df_voucher_value_local],0)&#10;+IFNULL([dh_non_df_voucher_value_local],0)' />
            </column>
            <column caption='DH Basket Incentives Per Order (NOK)' datatype='real' name='[Calculation_308496586677428252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_308496586677239835])/SUM([successful_orders])' />
            </column>
            <column caption='-- Incentives Per Order' datatype='integer' name='[Calculation_308496591621025823]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(NULL)' />
            </column>
            <column caption='Take In Local (NOK)' datatype='real' name='[Calculation_4723220489433927680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([container_price_local],0)&#10;+IFNULL([delivery_fee_local],0)&#10;+IFNULL([difference_to_minimum_local],0)&#10;+IFNULL([estimated_commission_local],0)&#10;+IFNULL([sb_fee],0)&#10;+IFNULL([service_fee_local],0)' />
            </column>
            <column caption='Cost (NOK)' datatype='real' name='[Calculation_4723220489435082753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([compensation_cost_local],0)&#10;+IFNULL([delivery_cost_local],0)&#10;+IFNULL([full_refund_cost_local],0)&#10;+IFNULL([partial_refund_cost_local],0)&#10;+IFNULL([service_sga_cost_local],0)&#10;+IFNULL([delivery_sga_cost_local],0)&#10;+IFNULL([payment_fee],0)' />
            </column>
            <column caption='Fully Loaded Profit (NOK)' datatype='real' name='[Calculation_4723220489454276610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4723220489433927680]-[Calculation_4723220489435082753]-[Calculation_308496586677239835]' />
            </column>
            <column caption='CPO (NOK)' datatype='real' name='[Calculation_4723220489454895107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4723220489435082753])/SUM([successful_orders])' />
            </column>
            <column caption='Take in per order (NOK)' datatype='real' name='[Calculation_4723220489454997508]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4723220489433927680])/SUM([successful_orders])' />
            </column>
            <column caption='FLGPO (NOK)' datatype='real' name='[Calculation_4723220489455169541]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4723220489454276610])/SUM([successful_orders])' />
            </column>
            <column caption='Partial Refund CPO (NOK)' datatype='real' name='[Calculation_4723220489461706759]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partial_refund_cost_local])/SUM([successful_orders])' />
            </column>
            <column caption='Delivery CPO (NOK)' datatype='real' name='[Calculation_4723220489462132744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_cost_local])/SUM([successful_orders])' />
            </column>
            <column caption='Compensation CPO (NOK)' datatype='real' name='[Calculation_4723220489711788046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([compensation_cost_local])/SUM([successful_orders])' />
            </column>
            <column caption='DF Discount CPO (NOK)' datatype='real' name='[Calculation_4723220489712164879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([dh_df_dicount_amount_local],0))/SUM([successful_orders])' />
            </column>
            <column caption='Non DF Discount CPO (NOK)' datatype='real' name='[Calculation_4723220489712283664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_non_df_dicount_amount_local])/SUM([successful_orders])' />
            </column>
            <column caption='DF Voucher CPO (NOK)' datatype='real' name='[Calculation_4723220489712463889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_df_voucher_value_local])/SUM([successful_orders])' />
            </column>
            <column caption='Non DF Voucher CPO (NOK)' datatype='real' name='[Calculation_4723220489712623634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_non_df_voucher_value_local])/SUM([successful_orders])' />
            </column>
            <column caption='Full Refund CPO (NOK)' datatype='real' name='[Calculation_4723220489712795667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([full_refund_cost_local])/SUM([successful_orders])' />
            </column>
            <column caption='Contact Center CPO (NOK)' datatype='real' name='[Calculation_4723220489713115157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([service_sga_cost_local])/SUM([successful_orders])' />
            </column>
            <column caption='Order Delivery Group' datatype='string' name='[Calculation_4723220489715666966]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_delivery_type]=&apos;Own Delivery&apos; THEN &apos;Delivery&apos; ELSE &apos;Market Place&apos; END' />
            </column>
            <column caption='Semi Variable Delivery CPO (NOK)' datatype='real' name='[Calculation_4723220489723211799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_sga_cost_local])/SUM([successful_orders])' />
            </column>
            <column caption='Container Price Per Order (NOK)' datatype='real' name='[Calculation_4723220489727033370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([container_price_local])/SUM([successful_orders])' />
            </column>
            <column caption='Delivery Fee Per Order (NOK)' datatype='real' name='[Calculation_4723220489727160347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_local])/SUM([successful_orders])' />
            </column>
            <column caption='Surcharge Per Order (NOK)' datatype='real' name='[Calculation_4723220489727291420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([difference_to_minimum_local])/SUM([successful_orders])' />
            </column>
            <column caption='Commission Revenue Per Order (NOK)' datatype='real' name='[Calculation_4723220489727393821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estimated_commission_local])/SUM([successful_orders])' />
            </column>
            <column caption='Service Fee Per Order (NOK)' datatype='real' name='[Calculation_4723220489727983647]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([service_fee_local])/SUM([successful_orders])' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_4723220489762652209]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &apos;Chain Name&apos; THEN [chain_name]&#10;  WHEN &apos;City&apos; THEN [pd_city]&#10;  WHEN &apos;Log City&apos; THEN [lg_city]&#10;  WHEN &apos;Log Zone&apos; THEN [lg_zone]&#10;  WHEN &apos;Cuisine&apos; THEN [primary_cuisine]&#10;  WHEN &apos;Order Delivery Type&apos; THEN [order_delivery_type]&#10;  WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;  WHEN &apos;Vendor Name&apos; THEN [vendor_name]&#10;END' />
            </column>
            <column caption='-[Payment CPO (NOK)]' datatype='real' name='[Calculation_5624925585898954753]' role='measure' type='quantitative' user:unnamed='GPO Breakdown Chart'>
              <calculation class='tableau' formula='-[Partial Refund CPO (copy)_5624925585882939392]' />
            </column>
            <column caption='-[DH Basket Incentives Per Order (NOK)]' datatype='real' name='[Calculation_5624925585899958274]' role='measure' type='quantitative' user:unnamed='GPO Breakdown Chart'>
              <calculation class='tableau' formula='-[Calculation_308496586677428252]' />
            </column>
            <column caption='Report Date calc' datatype='date' name='[Calculation_6170072238832082944]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([report_month] + &quot;-01&quot;)' />
            </column>
            <column caption='Report Month Filter' datatype='string' name='[Calculation_6170072238832484353]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6170072238832082944] = DATE(LEFT(STR(TODAY()),8) + &quot;01&quot;)&#10;THEN &quot;This Month&quot;&#10;ELSE [report_month]&#10;END' />
            </column>
            <column caption='Pro Fee Per Order' datatype='real' name='[Calculation_732257198762000384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sb_fee])/SUM([successful_orders])' />
            </column>
            <column caption='GPO (NOK)' datatype='real' name='[FLGPO (copy)_4349843941318807553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Fully Loaded Profit (copy)_4349843941318676480])/SUM([successful_orders])' />
            </column>
            <column caption='Profit (NOK)' datatype='real' name='[Fully Loaded Profit (copy)_4349843941318676480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4723220489433927680]-[Calculation_4723220489435082753]' />
            </column>
            <column caption='Payment CPO (NOK)' datatype='real' name='[Partial Refund CPO (copy)_5624925585882939392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([payment_fee])/SUM([successful_orders])' />
            </column>
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='Compensation Cost (NOK)' datatype='real' name='[compensation_cost_local]' role='measure' type='quantitative' />
