            <column-instance column='[order_delivery_type]' derivation='None' name='[none:order_delivery_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[pd_city]' derivation='None' name='[none:pd_city:nk]' pivot='key' type='nominal' />
            <column-instance column='[primary_cuisine]' derivation='None' name='[none:primary_cuisine:nk]' pivot='key' type='nominal' />
