            <column datatype='string' name='[lg_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[lg_zone]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4723220489715666966]' derivation='None' name='[none:Calculation_4723220489715666966:nk]' pivot='key' type='nominal' />
