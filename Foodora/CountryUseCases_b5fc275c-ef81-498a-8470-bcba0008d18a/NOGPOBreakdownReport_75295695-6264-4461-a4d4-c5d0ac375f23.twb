            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zbcs6b14rc8420zrwt7c0gcdjl4'>
            <column caption='-[Compensation CPO (NOK)]' datatype='real' name='[Calculation_308496586675707919]' role='measure' type='quantitative' user:unnamed='CPO Breakdown'>
              <calculation class='tableau' formula='-[Calculation_4723220489711788046]' />
            </column>
            <column caption='-[Delivery CPO (NOK)]' datatype='real' name='[Calculation_308496586675716112]' role='measure' type='quantitative' user:unnamed='CPO Breakdown'>
              <calculation class='tableau' formula='-[Calculation_4723220489462132744]' />
            </column>
            <column caption='-[DF Discount CPO (NOK)]' datatype='real' name='[Calculation_308496586675724305]' role='measure' type='quantitative' user:unnamed='CPO Breakdown'>
              <calculation class='tableau' formula='-[Calculation_4723220489712164879]' />
            </column>
            <column caption='-[Non DF Discount CPO (NOK)]' datatype='real' name='[Calculation_308496586675728402]' role='measure' type='quantitative' user:unnamed='CPO Breakdown'>
              <calculation class='tableau' formula='-[Calculation_4723220489712283664]' />
            </column>
            <column caption='-[DF Voucher CPO (NOK)]' datatype='real' name='[Calculation_308496586675736595]' role='measure' type='quantitative' user:unnamed='CPO Breakdown'>
              <calculation class='tableau' formula='-[Calculation_4723220489712463889]' />
            </column>
            <column caption='-[Non DF Voucher CPO (NOK)]' datatype='real' name='[Calculation_308496586675744788]' role='measure' type='quantitative' user:unnamed='CPO Breakdown'>
              <calculation class='tableau' formula='-[Calculation_4723220489712623634]' />
            </column>
            <column caption='-[Full Refund CPO (NOK)]' datatype='real' name='[Calculation_308496586675752981]' role='measure' type='quantitative' user:unnamed='CPO Breakdown'>
              <calculation class='tableau' formula='-[Calculation_4723220489712795667]' />
            </column>
            <column caption='-[Partial Refund CPO (NOK)]' datatype='real' name='[Calculation_308496586675761174]' role='measure' type='quantitative' user:unnamed='CPO Breakdown'>
              <calculation class='tableau' formula='-[Calculation_4723220489461706759]' />
            </column>
            <column caption='-[Contact Center CPO (NOK)]' datatype='real' name='[Calculation_308496586675765271]' role='measure' type='quantitative' user:unnamed='CPO Breakdown'>
              <calculation class='tableau' formula='-[Calculation_4723220489713115157]' />
            </column>
            <column caption='-[Semi Variable Delivery CPO (NOK)]' datatype='real' name='[Calculation_308496586675773464]' role='measure' type='quantitative' user:unnamed='CPO Breakdown'>
              <calculation class='tableau' formula='-[Calculation_4723220489723211799]' />
            </column>
            <column caption='-[CPO (NOK)]' datatype='real' name='[Calculation_308496586675781657]' role='measure' type='quantitative' user:unnamed='CPO Breakdown'>
              <calculation class='tableau' formula='-[Calculation_4723220489454895107]' />
            </column>
            <column caption='Cost (NOK)' datatype='real' name='[Calculation_4723220489435082753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([compensation_cost_local],0)&#10;+IFNULL([delivery_cost_local],0)&#10;+IFNULL([full_refund_cost_local],0)&#10;+IFNULL([partial_refund_cost_local],0)&#10;+IFNULL([service_sga_cost_local],0)&#10;+IFNULL([delivery_sga_cost_local],0)&#10;+IFNULL([payment_fee],0)' />
            </column>
            <column caption='CPO (NOK)' datatype='real' name='[Calculation_4723220489454895107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4723220489435082753])/SUM([successful_orders])' />
            </column>
            <column caption='Partial Refund CPO (NOK)' datatype='real' name='[Calculation_4723220489461706759]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partial_refund_cost_local])/SUM([successful_orders])' />
            </column>
            <column caption='Delivery CPO (NOK)' datatype='real' name='[Calculation_4723220489462132744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_cost_local])/SUM([successful_orders])' />
            </column>
            <column caption='Compensation CPO (NOK)' datatype='real' name='[Calculation_4723220489711788046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([compensation_cost_local])/SUM([successful_orders])' />
            </column>
            <column caption='DF Discount CPO (NOK)' datatype='real' name='[Calculation_4723220489712164879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([dh_df_dicount_amount_local],0))/SUM([successful_orders])' />
            </column>
            <column caption='Non DF Discount CPO (NOK)' datatype='real' name='[Calculation_4723220489712283664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_non_df_dicount_amount_local])/SUM([successful_orders])' />
            </column>
            <column caption='DF Voucher CPO (NOK)' datatype='real' name='[Calculation_4723220489712463889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_df_voucher_value_local])/SUM([successful_orders])' />
            </column>
            <column caption='Non DF Voucher CPO (NOK)' datatype='real' name='[Calculation_4723220489712623634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_non_df_voucher_value_local])/SUM([successful_orders])' />
            </column>
            <column caption='Full Refund CPO (NOK)' datatype='real' name='[Calculation_4723220489712795667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([full_refund_cost_local])/SUM([successful_orders])' />
            </column>
            <column caption='Contact Center CPO (NOK)' datatype='real' name='[Calculation_4723220489713115157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([service_sga_cost_local])/SUM([successful_orders])' />
            </column>
            <column caption='Order Delivery Group' datatype='string' name='[Calculation_4723220489715666966]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_delivery_type]=&apos;Own Delivery&apos; THEN &apos;Delivery&apos; ELSE &apos;Market Place&apos; END' />
            </column>
            <column caption='Semi Variable Delivery CPO (NOK)' datatype='real' name='[Calculation_4723220489723211799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_sga_cost_local])/SUM([successful_orders])' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_4723220489762652209]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &apos;Chain Name&apos; THEN [chain_name]&#10;  WHEN &apos;City&apos; THEN [pd_city]&#10;  WHEN &apos;Log City&apos; THEN [lg_city]&#10;  WHEN &apos;Log Zone&apos; THEN [lg_zone]&#10;  WHEN &apos;Cuisine&apos; THEN [primary_cuisine]&#10;  WHEN &apos;Order Delivery Type&apos; THEN [order_delivery_type]&#10;  WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;  WHEN &apos;Vendor Name&apos; THEN [vendor_name]&#10;END' />
            </column>
            <column caption='Report Date calc' datatype='date' name='[Calculation_6170072238832082944]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([report_month] + &quot;-01&quot;)' />
            </column>
            <column caption='Report Month Filter' datatype='string' name='[Calculation_6170072238832484353]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6170072238832082944] = DATE(LEFT(STR(TODAY()),8) + &quot;01&quot;)&#10;THEN &quot;This Month&quot;&#10;ELSE [report_month]&#10;END' />
            </column>
