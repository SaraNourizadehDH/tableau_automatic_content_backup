    <worksheet name='CPO Trends'>
      <table>
        <view>
          <datasources>
            <datasource caption='report_restaurant_gpo_analysis (bl_bi)' name='federated.0zbcs6b14rc8420zrwt7c0gcdjl4' />
          </datasources>
          <datasource-dependencies datasource='federated.0zbcs6b14rc8420zrwt7c0gcdjl4'>
            <column caption='Cost (NOK)' datatype='real' name='[Calculation_4723220489435082753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([compensation_cost_local],0)&#10;+IFNULL([delivery_cost_local],0)&#10;+IFNULL([full_refund_cost_local],0)&#10;+IFNULL([partial_refund_cost_local],0)&#10;+IFNULL([service_sga_cost_local],0)&#10;+IFNULL([delivery_sga_cost_local],0)&#10;+IFNULL([payment_fee],0)' />
            </column>
            <column caption='CPO (NOK)' datatype='real' name='[Calculation_4723220489454895107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4723220489435082753])/SUM([successful_orders])' />
            </column>
            <column caption='Compensation Cost (NOK)' datatype='real' name='[compensation_cost_local]' role='measure' type='quantitative' />
            <column caption='Delivery Cost (NOK)' datatype='real' name='[delivery_cost_local]' role='measure' type='quantitative' />
            <column caption='Semi Variable Delivery Cost (NOK)' datatype='real' name='[delivery_sga_cost_local]' role='measure' type='quantitative' />
            <column caption='Full Refund Cost (NOK)' datatype='real' name='[full_refund_cost_local]' role='measure' type='quantitative' />
            <column-instance column='[order_delivery_type]' derivation='None' name='[none:order_delivery_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_month]' derivation='None' name='[none:report_month:nk]' pivot='key' type='nominal' />
            <column caption='Order Delivery Type' datatype='string' name='[order_delivery_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Own Delivery&quot;' value='OD' />
                <alias key='&quot;Pickup&quot;' value='PU' />
                <alias key='&quot;Vendor Delivery&quot;' value='VD' />
              </aliases>
            </column>
            <column caption='Partial Refund Cost (NOK)' datatype='real' name='[partial_refund_cost_local]' role='measure' type='quantitative' />
            <column caption='Payment Fee (NOK)' datatype='real' name='[payment_fee]' role='measure' type='quantitative' />
            <column caption='Report Month' datatype='string' name='[report_month]' role='dimension' type='nominal' />
            <column caption='Contact Center Cost (NOK)' datatype='real' name='[service_sga_cost_local]' role='measure' type='quantitative' />
            <column caption='# Successful Orders' datatype='integer' name='[successful_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_4723220489454895107]' derivation='User' name='[usr:Calculation_4723220489454895107:qk]' pivot='key' type='quantitative' />
