    <worksheet name='Dimension Chart'>
      <table>
        <view>
          <datasources>
            <datasource caption='report_restaurant_gpo_analysis (bl_bi)' name='federated.0zbcs6b14rc8420zrwt7c0gcdjl4' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Log City&quot;'>
              <calculation class='tableau' formula='&quot;Log City&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zbcs6b14rc8420zrwt7c0gcdjl4'>
            <column caption='DH Basket Incentives (NOK)' datatype='real' name='[Calculation_308496586677239835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([dh_df_dicount_amount_local],0)&#10;+IFNULL([dh_non_df_dicount_amount_local],0)&#10;+IFNULL([dh_df_voucher_value_local],0)&#10;+IFNULL([dh_non_df_voucher_value_local],0)' />
            </column>
            <column caption='Take In Local (NOK)' datatype='real' name='[Calculation_4723220489433927680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([container_price_local],0)&#10;+IFNULL([delivery_fee_local],0)&#10;+IFNULL([difference_to_minimum_local],0)&#10;+IFNULL([estimated_commission_local],0)&#10;+IFNULL([sb_fee],0)&#10;+IFNULL([service_fee_local],0)' />
            </column>
            <column caption='Cost (NOK)' datatype='real' name='[Calculation_4723220489435082753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([compensation_cost_local],0)&#10;+IFNULL([delivery_cost_local],0)&#10;+IFNULL([full_refund_cost_local],0)&#10;+IFNULL([partial_refund_cost_local],0)&#10;+IFNULL([service_sga_cost_local],0)&#10;+IFNULL([delivery_sga_cost_local],0)&#10;+IFNULL([payment_fee],0)' />
            </column>
            <column caption='Fully Loaded Profit (NOK)' datatype='real' name='[Calculation_4723220489454276610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4723220489433927680]-[Calculation_4723220489435082753]-[Calculation_308496586677239835]' />
            </column>
            <column caption='FLGPO (NOK)' datatype='real' name='[Calculation_4723220489455169541]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4723220489454276610])/SUM([successful_orders])' />
            </column>
            <column caption='Order Delivery Group' datatype='string' name='[Calculation_4723220489715666966]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_delivery_type]=&apos;Own Delivery&apos; THEN &apos;Delivery&apos; ELSE &apos;Market Place&apos; END' />
