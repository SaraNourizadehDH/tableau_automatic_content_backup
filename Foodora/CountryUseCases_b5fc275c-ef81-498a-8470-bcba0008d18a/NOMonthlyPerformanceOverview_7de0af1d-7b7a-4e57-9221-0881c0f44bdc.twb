    <worksheet name='Churn &amp; Net Growth - Prep'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='14'>Flow in/out - (90 Days Active)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='report_monthly_performance (bl_nordics)' name='federated.092rwen0upps2y1gauyef1ql24j3' />
          </datasources>
          <datasource-dependencies datasource='federated.092rwen0upps2y1gauyef1ql24j3'>
            <column caption='# Net Churn' datatype='integer' name='[% Net Churn (of BOM) (copy)_1588926297568903175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-(sum([churn90])-sum([reactivations]))' />
            </column>
            <column caption='% Total Flow In (of EOM)' datatype='real' name='[% Reactivations (of EOM) (copy)_1588926297463193602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([new_customers])+sum([reactivations]))/sum([active_customers_eom_90])' />
            </column>
            <column caption='# Total Flow In' datatype='integer' name='[% Total Flow In (of EOM) (copy)_1588926297569333256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([new_customers])+sum([reactivations]))' />
            </column>
            <column caption='# 90 Days Active (EOM)' datatype='integer' name='[Calculation_123567568447447040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([active_customers_eom_90])' />
            </column>
            <column caption='# New Customers' datatype='integer' name='[Calculation_123567568449576967]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([new_customers])' />
            </column>
            <column caption='# Reactivations' datatype='integer' name='[Calculation_123567568449675272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([reactivations])' />
            </column>
            <column caption='# Churn ( of BOM 90 Days Active)' datatype='integer' name='[Calculation_123567568450293769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-sum([churn90])' />
            </column>
            <column caption='% Churn (of BOM)' datatype='real' name='[Calculation_123567568458453017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-sum([churn90])/sum([active_customers_bom_90])' />
            </column>
            <column caption='% Reactivations (of EOM)' datatype='real' name='[Calculation_123567568458510362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([reactivations])/sum([active_customers_eom_90])' />
            </column>
            <column caption='# Net Growth' datatype='integer' name='[Calculation_123567568459264027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([new_customers])+sum([reactivations])-SUM([churn90])' />
            </column>
            <column caption='% Net Churn (of BOM)' datatype='real' name='[Calculation_123567568469499933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-(sum([churn90])-sum([reactivations]))/SUM([active_customers_bom_90])' />
            </column>
            <column caption='% New Customers (of EOM)' datatype='real' name='[Calculation_123567568476454942]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([new_customers])/sum([active_customers_eom_90])' />
            </column>
            <column caption='report_date_m_excl' datatype='date' name='[Calculation_1307451294419419149]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [report_date] &lt; DATETRUNC(&apos;month&apos;, TODAY()) then [report_date] END' />
            </column>
            <column caption='# Monthly Active Customers' datatype='integer' name='[Calculation_1588926297466122244]' role='measure' type='quantitative'>
