      <aliases enabled='yes' />
      <column caption='% Customer Reorder Rate - 60d' datatype='real' name='[% Customer Reorder Rate - 30d (copy)_226868887397466112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([active_customers_ro_60d])/sum(if [report_date]&lt;dateadd(&apos;month&apos;,-2,DATE(DATETRUNC(&apos;month&apos;,TODAY()))) THEN [active_customers_ro_60d_den] END)' />
      </column>
      <column caption='# Net Churn' datatype='integer' name='[% Net Churn (of BOM) (copy)_1588926297568903175]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-(sum([churn90])-sum([reactivations]))' />
      </column>
      <column caption='% Total Flow In (of EOM)' datatype='real' name='[% Reactivations (of EOM) (copy)_1588926297463193602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([new_customers])+sum([reactivations]))/sum([active_customers_eom_90])' />
      </column>
      <column caption='% Customer Reorder Rate - 30d' datatype='real' name='[% Retention (of Monthly Active) (copy)_123567568478666784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([active_customers_ro_30d])/sum(if [report_date]&lt;dateadd(&apos;month&apos;,-1,DATE(DATETRUNC(&apos;month&apos;,TODAY()))) THEN [active_customers_ro_30d_den] END)' />
      </column>
