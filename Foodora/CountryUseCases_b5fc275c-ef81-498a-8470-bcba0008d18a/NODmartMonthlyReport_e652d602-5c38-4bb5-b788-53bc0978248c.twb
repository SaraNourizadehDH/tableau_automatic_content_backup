    <worksheet name='Overview YoY Prep regular'>
      <table>
        <view>
          <datasources>
            <datasource caption='report_monthly_dmart (bl_nordics)' name='federated.0ic7ueh0xefvtz1911epz130idau' />
          </datasources>
          <datasource-dependencies datasource='federated.0ic7ueh0xefvtz1911epz130idau'>
            <column caption='# New Customers - Warehouse' datatype='integer' name='[# New Customers - Foodora Market (copy)_1011339610637561903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month_type]=&quot;CM&quot; THEN [new_customer_warehouse] END' />
            </column>
            <column caption='# New Customers - Foodora' datatype='integer' name='[# New Customers - Warehouses (copy)_1011339610637635632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [new_customer_platform] END)' />
            </column>
            <column caption='# Daily Orders Per Warehouse' datatype='real' name='[# Orders Per Warehouse (copy)_2201978762645757954]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [orders] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [warehouse_days] END)' />
            </column>
            <column caption='% Fill Rate' datatype='real' name='[% Wrong / Missing Items (copy)_648799847232229379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [customer_qty_delivered] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [customer_qty_ordered] END)' />
            </column>
            <column caption='--Warehouse' datatype='real' name='[--Logistics (copy)_1023724510260727808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1/NULL' />
            </column>
            <column caption='Avg. Sub Categories Per Order' datatype='real' name='[Avg. Main Categories Per Order (copy)_620652343275864068]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [order_sub_categories] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [orders] END)' />
            </column>
            <column caption='Avg. Main Categories Per Order' datatype='real' name='[Avg. SKUs Per Order (copy)_620652343275671554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_type]=&quot;CM&quot; THEN [order_parent_categories] END)&#13;&#10;/SUM(IF [month_type]=&quot;CM&quot; THEN [orders] END)' />
            </column>
            <column caption='GFV (LC)' datatype='real' name='[Calculation_1011339610622701568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month_type]=&quot;CM&quot; THEN [gfv_local] END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1011339610626564100]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR([report_month]),7)' />
            </column>
            <column caption='# Active Warehouses' datatype='integer' name='[Calculation_1011339610626818053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [month_type]=&quot;CM&quot; THEN [warehouse_id] END)' />
            </column>
            <column caption='# Successful Orders' datatype='integer' name='[Calculation_1011339610627137543]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [month_type]=&quot;CM&quot; THEN [successful_orders] END' />
            </column>
