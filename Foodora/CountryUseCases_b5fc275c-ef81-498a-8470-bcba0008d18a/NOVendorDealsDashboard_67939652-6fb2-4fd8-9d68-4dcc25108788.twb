    <worksheet name='City - Monthly - Subscription'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/NOVendorDealsDashboard/City-Monthly-Subscription?rev=' id='City-Monthly-Subscription' path='/t/Foodora/workbooks/NOVendorDealsDashboard' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='report_deals_dashboard (bl_bi)' name='federated.19q0dt0011s2im17zqftp02htzkl' />
          </datasources>
          <datasource-dependencies datasource='federated.19q0dt0011s2im17zqftp02htzkl'>
            <column caption='# Vendors w Subscription Deal - Last Month' datatype='integer' name='[# Vendors w Deal - Last Month (copy)_194991811670265859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP(SUM([Calculation_137922756686569476]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% MoM -  # Vendors w  Subscription Deal ' datatype='real' name='[# Vendors w Deal - MoM (copy)_194991811670192130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_137922756686569476]) - [# Vendors w Deal - Last Month (copy)_194991811670265859]) / [# Vendors w Deal - Last Month (copy)_194991811670265859]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='# Vendors w Subscription Deal (excl. FD)' datatype='integer' name='[# Vendors w Free Delivery Subscription Deal (copy)_693272898111741953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE [vendor_code]: &#10;&#10;IF SUM(&#10;   IF [discount_type_detailed] = &apos;subscription&apos; &#10;   AND [discount_type] &lt;&gt; &apos;free_delivery&apos; &#10;   THEN [discounts_active_vendor] &#10;   ELSE 0 &#10;   END&#10;  ) &gt; 0 &#10;&#10;THEN COUNTD([vendor_code]) END }' />
            </column>
            <column caption='# Vendors w Free Delivery Subscription Deal' datatype='integer' name='[# Vendors w Subscription Deal (copy)_693272898107760640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE [vendor_code]: &#10;&#10;IF SUM(&#10;   IF [discount_type_detailed] = &apos;subscription&apos; &#10;   AND [discount_type] = &apos;free_delivery&apos; &#10;   THEN [discounts_active_vendor] &#10;   ELSE 0 &#10;   END&#10;  ) &gt; 0 &#10;&#10;THEN COUNTD([vendor_code]) END }' />
            </column>
            <column caption='% GMV of Subscription Deal Orders of Total GMV' datatype='real' name='[% GMV of Deal Orders of Total GMV (copy 2)_476748258456035328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV (LC) - Restaurants (copy)_476748258456469505])/SUM([Calculation_1659857967462260750])' />
            </column>
            <column caption='% Vendors w Subscription Deal' datatype='real' name='[% Vendors w Deal (copy)_194991811663474688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_137922756686569476]) / SUM([vendors_active])' />
            </column>
            <column caption='% Vendors w Subscription Deal (excl. FD)' datatype='real' name='[% Vendors w Free Deliery Subscription Deal (copy)_693272898112483331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# Vendors w Free Delivery Subscription Deal (copy)_693272898111741953]) / SUM([vendors_active])' />
            </column>
            <column caption='% Vendors w Free Delivery Subscription Deal' datatype='real' name='[% Vendors w Subscription Deal (copy)_693272898112282626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([# Vendors w Subscription Deal (copy)_693272898107760640]) / SUM([vendors_active])' />
            </column>
            <column caption='# Vendors w Subscription Deal' datatype='integer' name='[Calculation_137922756686569476]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE [vendor_code]: &#10;&#10;IF SUM(&#10;   IF [discount_type_detailed] = &apos;subscription&apos; &#10;   THEN [discounts_active_vendor] &#10;   ELSE 0 &#10;   END&#10;  ) &gt; 0 &#10;&#10;THEN COUNTD([vendor_code]) END }' />
            </column>
            <column caption='GMV of Vendors with Subscription Discount' datatype='real' name='[Calculation_144326322217533440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE [city_status],[vendor_code]: &#10;&#10;IF SUM(&#10;   IF [discount_type_detailed] = &apos;subscription&apos; &#10;   THEN [discounts_active_vendor] &#10;   ELSE 0 &#10;   END&#10;  ) &gt; 0 &#10;&#10;THEN SUM([Calculation_1659857967462260750]) END }' />
            </column>
            <column caption='% GMV of Vendors with Subscription Discount of Total GMV' datatype='real' name='[Calculation_144326322217644033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_144326322217533440]) /SUM({ FIXED [Date Dimension (copy)_584623536916992000] :  SUM([Calculation_1659857967462260750]) })' />
            </column>
            <column caption='Report Month' datatype='string' name='[Calculation_1659857967456649216]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR([report_month]),7)' />
            </column>
            <column caption='GMV (LC)' datatype='real' name='[Calculation_1659857967462260750]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_gmv]' />
            </column>
            <column caption='City2' datatype='string' name='[Calculation_1659857967477964840]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[city]' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_512214119632580608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Date Dimension (copy)_584623536916992000]' />
            </column>
            <column caption='Date Dimension' datatype='string' name='[Date Dimension (copy)_584623536916992000]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_dim] WHEN &apos;Monthly&apos; THEN [Calculation_1659857967456649216] &#10;ELSE [report_week] END' />
            </column>
            <column caption='GMV (LC) - Subscription Orders' datatype='real' name='[GMV (LC) - Restaurants (copy)_476748258456469505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [discount_type_detailed] = &apos;subscription&apos;&#10;THEN [discounts_gmv]&#10;END' />
            </column>
