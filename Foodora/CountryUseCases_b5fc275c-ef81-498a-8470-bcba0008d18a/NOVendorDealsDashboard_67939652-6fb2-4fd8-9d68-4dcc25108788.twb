          <datasource-dependencies datasource='federated.19q0dt0011s2im17zqftp02htzkl'>
            <column caption='# Orders w Deal - DH Paid' datatype='integer' name='[# Orders w Deal (copy)_1659857967460532234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[discounts_dh]' />
            </column>
            <column caption='# Orders w Deal - Vendor Paid' datatype='integer' name='[# Orders w Deal - DH Paid (copy)_1659857967461543947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[discounts_vendor]' />
            </column>
            <column caption='# Orders w Deal - Mixed Paid' datatype='integer' name='[# Orders w Deal - Vendor Paid (copy)_1659857967461703692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[discounts_mixed]' />
            </column>
            <column caption='% Deal Value (Foodora Funded) of GMV' datatype='real' name='[% Deal Value (Foodora Funded) of Total GMV (copy)_668010537911283715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Deal Value (LC) (copy)_1659857967462727696])/SUM([discounts_gmv])' />
            </column>
            <column caption='% Deal Value (Vendor Funded) of GMV' datatype='real' name='[% Deal Value (Vendor Funded) of Total GMV (copy)_668010537911410692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Deal Value (LC) - DH Paid (copy)_1659857967462813713])/SUM([discounts_gmv])' />
            </column>
            <column caption='% Deal Value of GMV (Dmart)' datatype='real' name='[% Deal Value of GMV (Shops) (copy)_244601805260574745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_244601805184651266])/SUM([GMV (LC) - (Restaurants) (copy)_244601805259956246])' />
            </column>
            <column caption='% Deal Value of GMV (Restaurants)' datatype='real' name='[% Deal Value of GMV - Restaurants (copy 2)_244601805258469396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_244601805184593921])/SUM([GMV (LC) - Restaurants (copy)_244601805259403285])' />
            </column>
            <column caption='% Deal Value of GMV' datatype='real' name='[% Deal Value of Total GMV (copy)_668010537911480325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1659857967462129677])/SUM([discounts_gmv])' />
            </column>
            <column caption='AFV (LC) - Deal' datatype='real' name='[AFV (LC) (copy)_1659857967463370771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discounts_gfv])/SUM([discounts])' />
            </column>
            <column caption='AOV (LC) - Deal' datatype='real' name='[AFV (LC) - Deals (copy)_1659857967463682069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discounts_gmv])/SUM([discounts])' />
            </column>
            <column caption='Report Month' datatype='string' name='[Calculation_1659857967456649216]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR([report_month]),7)' />
