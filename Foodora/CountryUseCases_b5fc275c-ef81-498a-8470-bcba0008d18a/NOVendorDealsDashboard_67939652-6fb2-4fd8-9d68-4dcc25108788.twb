              <calculation class='tableau' formula='[discounts_active_other_vendor]' />
            </column>
            <column caption='% Deal Value (Foodora Funded) of Total GMV' datatype='real' name='[% Deal Value of Total GMV (copy)_668010537908383744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Deal Value (LC) (copy)_1659857967462727696])/SUM([Calculation_1659857967462260750])' />
            </column>
            <column caption='% Deal Value (Vendor Funded) of Total GMV' datatype='real' name='[% Deal Value of Total GMV (copy)_668010537908785153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Deal Value (LC) - DH Paid (copy)_1659857967462813713])/SUM([Calculation_1659857967462260750])' />
            </column>
            <column caption='% GMV of Subscription Deal Orders of Total GMV' datatype='real' name='[% GMV of Deal Orders of Total GMV (copy 2)_476748258456035328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV (LC) - Restaurants (copy)_476748258456469505])/SUM([Calculation_1659857967462260750])' />
            </column>
            <column caption='% Vendors w Subscription Deal' datatype='real' name='[% Vendors w Deal (copy)_194991811663474688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_137922756686569476]) / SUM([vendors_active])' />
            </column>
            <column caption='AFV (LC) - Deal' datatype='real' name='[AFV (LC) (copy)_1659857967463370771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discounts_gfv])/SUM([discounts])' />
            </column>
            <column caption='AOV (LC)' datatype='real' name='[AFV (LC) (copy)_1659857967463579668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_gmv])/SUM([orders])' />
            </column>
            <column caption='AOV (LC) - Deal' datatype='real' name='[AFV (LC) - Deals (copy)_1659857967463682069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discounts_gmv])/SUM([discounts])' />
            </column>
            <column caption='# Vendors w Subscription Deal' datatype='integer' name='[Calculation_137922756686569476]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE [vendor_code]: &#10;&#10;IF SUM(&#10;   IF [discount_type_detailed] = &apos;subscription&apos; &#10;   THEN [discounts_active_vendor] &#10;   ELSE 0 &#10;   END&#10;  ) &gt; 0 &#10;&#10;THEN COUNTD([vendor_code]) END }' />
            </column>
            <column caption='Report Month' datatype='string' name='[Calculation_1659857967456649216]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR([report_month]),7)' />
