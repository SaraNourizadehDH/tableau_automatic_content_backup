      <column caption='Gfv %' datatype='real' name='[Gmv Net % (copy)_847661902150172692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv_local]) / SUM({ INCLUDE [report_date]:MAX([ttl_gfv_local])})' />
