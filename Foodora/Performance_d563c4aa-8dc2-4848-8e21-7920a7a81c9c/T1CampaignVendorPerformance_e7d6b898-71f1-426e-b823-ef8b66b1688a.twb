      <aliases enabled='yes' />
      <column caption='Customer Fail Rate' datatype='real' name='[Calculation_1265792980302151680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_orders_customer]) / SUM([gross_orders])' />
      </column>
      <column caption='Acceptance Rate' datatype='real' name='[Calculation_2109092012034613248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([accepted_times]) / SUM([notified_times])' />
      </column>
      <column caption='EPT' datatype='real' name='[Calculation_2109092012034789377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([estimated_prep_time]) / SUM([ept_orders])' />
      </column>
      <column caption='APT' datatype='real' name='[Calculation_2109092012034904066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_prep_time]) / SUM([apt_orders])' />
      </column>
      <column caption='Rider Delay Order Rate' datatype='real' name='[Calculation_2109092012035219459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_delay_10_orders]) / SUM([rider_delay_ttl_orders])' />
      </column>
      <column caption='Vendor Wastage' datatype='real' name='[Calculation_4228528218873286656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_wastage_local])' />
      </column>
      <column caption='fp Cost' datatype='real' name='[Calculation_4304033878968221696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [brand_name] = &quot;麥當勞&quot;&#10;THEN [ttl_cost] * 0.55&#10;ELSE [fp_cost]&#10;END' />
      </column>
      <column caption='Vendor Cost' datatype='real' name='[Calculation_4304033878968532993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [brand_name] = &quot;麥當勞&quot;&#10;THEN [ttl_cost] * 0.45&#10;ELSE [vendor_cost]&#10;END' />
      </column>
      <column caption='t1 color' datatype='string' name='[Calculation_4306496787440611328]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM({ INCLUDE [Calculation_847661902155472928]:MAX(IIF([is_in_t1_period], 2, 0))}) = 2&#10;THEN &quot;T1 Period&quot;&#10;ELSE &quot;Others&quot;&#10;END' />
      </column>
      <column caption='recent 3 weeks' datatype='boolean' name='[Calculation_4306496787446816774]' role='measure' type='nominal'>
        <calculation class='tableau' formula='DATE(TOTAL(MAX(DATETRUNC(&quot;iso-week&quot;, [report_date])))) - MAX(DATETRUNC(&quot;iso-week&quot;, [report_date])) &lt;= 14'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='week color' datatype='real' name='[Calculation_4306496787476344842]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATE(TOTAL(MAX(DATETRUNC(&quot;iso-week&quot;, [report_date])))) - MAX(DATETRUNC(&quot;week&quot;, [report_date]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Main KPIs' datatype='real' name='[Calculation_4306496787477757964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Net Gmv&quot; THEN SUM([gmv_net_local])&#10;WHEN &quot;Gfv&quot; THEN SUM([gfv_local])&#10;WHEN &quot;Orders&quot; THEN SUM([orders])&#10;WHEN &quot;Afv&quot; THEN [Calculation_847661902141906948]&#10;WHEN &quot;Unique Vendor Count&quot; THEN [Calculation_847661902142119941]&#10;WHEN &quot;Unique Brand Count&quot; THEN [Unique Vendor Count (copy)_847661902142246918]&#10;WHEN &quot;T1 Voucher Usage&quot; THEN SUM([t1_voucher_usage])&#10;WHEN &quot;TTL Cost&quot; THEN SUM([ttl_cost])&#10;WHEN &quot;fp Cost&quot; THEN SUM([Calculation_4304033878968221696])&#10;WHEN &quot;Vendor Cost&quot; THEN SUM([Calculation_4304033878968532993])&#10;WHEN &quot;T1 Voucher Net Gmv&quot; THEN SUM([t1_voucher_net_gmv])&#10;WHEN &quot;T1 Voucher Gfv&quot; THEN SUM([t1_voucher_gfv])&#10;WHEN &quot;T1 Voucher Afv&quot; THEN [Calculation_847661902142726151]&#10;END' />
      </column>
      <column caption='Name ' datatype='string' name='[Calculation_847661902141083648]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;All&quot; THEN &quot;All&quot;&#10;WHEN &quot;Brand&quot; THEN [brand_name]&#10;WHEN &quot;Outlet&quot; THEN [vendor_name]&#10;END' />
      </column>
      <column caption='Afv' datatype='real' name='[Calculation_847661902141906948]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv_local])/SUM([orders])' />
      </column>
      <column caption='Unique Vendor Count' datatype='integer' name='[Calculation_847661902142119941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [orders] &gt; 0&#10;THEN [vendor_code]&#10;END&#10;)' />
      </column>
      <column caption='T1 Voucher Afv' datatype='real' name='[Calculation_847661902142726151]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([t1_voucher_gfv]) / SUM([t1_voucher_usage])' />
      </column>
      <column caption='Actual Open Hours' datatype='real' name='[Calculation_847661902142857224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_open_seconds]) / 3600' />
      </column>
      <column caption='Offline Rate' datatype='real' name='[Calculation_847661902142984201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([actual_open_seconds]) / SUM([planned_open_seconds])' />
      </column>
      <column caption='Delay Rate' datatype='real' name='[Calculation_847661902143229962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delay_orders]) / SUM([actual_prep_orders])' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_847661902143385611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_orders]) / SUM([gross_orders])' />
      </column>
      <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_847661902143463436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_orders_vendor]) / SUM([gross_orders])' />
      </column>
      <column caption='Avg DT' datatype='real' name='[Calculation_847661902144036879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_dt]) / SUM([dt_orders])' />
      </column>
      <column caption='fp Wastage' datatype='real' name='[Calculation_847661902144180240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fp_wastage_local])' />
      </column>
      <column caption='Order On Time Rate' datatype='real' name='[Calculation_847661902144311313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([on_time_w_pdt_10_orders]) / SUM([pdt_10_orders]))&#10;+ ZN(SUM([on_time_w_pdt_20_orders]) / SUM([pdt_20_orders]))&#10;+ ZN(SUM([on_time_w_pdt_30_orders]) / SUM([pdt_30_orders]))&#10;+ ZN(SUM([on_time_w_pdt_40_orders]) / SUM([pdt_40_orders]))&#10;+ ZN(SUM([on_time_w_pdt_50_orders]) / SUM([pdt_50_orders]))&#10;+ ZN(SUM([on_time_w_pdt_60_orders]) / SUM([pdt_60_orders]))' />
      </column>
      <column caption='Gmv Net %' datatype='real' name='[Calculation_847661902149382163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_net_local]) / SUM({ INCLUDE [report_date]:MAX([ttl_gmv_net_local])})' />
      </column>
      <column caption='updated_date' datatype='date' name='[Calculation_847661902154579993]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([report_date])}' />
      </column>
      <column aggregation='Sum' caption='wtd updated_date' datatype='integer' name='[Calculation_847661902154788891]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATEPART(&quot;weekday&quot;, [Calculation_847661902154579993]) = 1&#10;THEN 7&#10;ELSE DATEPART(&quot;weekday&quot;, [Calculation_847661902154579993]) - 1&#10;END' />
      </column>
      <column aggregation='Sum' caption='wtd report_date' datatype='integer' name='[Calculation_847661902154903580]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATEPART(&quot;weekday&quot;, [report_date]) = 1&#10;THEN 7&#10;ELSE DATEPART(&quot;weekday&quot;, [report_date]) - 1&#10;END' />
      </column>
      <column aggregation='Sum' caption='mtd updated_date' datatype='integer' name='[Calculation_847661902155005981]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&quot;day&quot;, [Calculation_847661902154579993])' />
      </column>
      <column aggregation='Sum' caption='mtd report_date' datatype='integer' name='[Calculation_847661902155108382]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&quot;day&quot;, [report_date])' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_847661902155472928]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(Monthly)|(Mtd)&quot;)&#10;THEN DATE(DATETRUNC(&quot;month&quot;, [report_date]))&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(Weekly)|(Wtd)&quot;)&#10;THEN DATE(DATETRUNC(&quot;iso-week&quot;, [report_date]))&#10;ELSE DATE(DATETRUNC(&quot;day&quot;, [report_date]))&#10;END' />
      </column>
      <column caption='datefilter report_date' datatype='boolean' name='[Calculation_847661902155632673]' role='dimension' type='nominal'>
