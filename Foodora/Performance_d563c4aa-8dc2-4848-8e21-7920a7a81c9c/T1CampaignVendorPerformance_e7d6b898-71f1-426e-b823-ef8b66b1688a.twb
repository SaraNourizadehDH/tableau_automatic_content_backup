              <calculation class='tableau' formula='IF SUM({ INCLUDE [Calculation_847661902155472928]:MAX(IIF([is_in_t1_period], 2, 0))}) = 2&#10;THEN &quot;T1 Period&quot;&#10;ELSE &quot;Others&quot;&#10;END' />
