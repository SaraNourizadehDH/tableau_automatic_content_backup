      </column>
      <column caption='MX Main KPIs' datatype='real' name='[Main KPIs (copy)_4992029093269565442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Actual Open Hours&quot; THEN [Calculation_847661902142857224]&#10;WHEN &quot;Offline Rate&quot; THEN [Calculation_847661902142984201]&#10;WHEN &quot;Delay Rate&quot; THEN [Calculation_847661902143229962]&#10;WHEN &quot;Fail Rate&quot; THEN [Calculation_847661902143385611]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [Calculation_847661902143463436]&#10;WHEN &quot;Customer Fail Rate&quot; THEN [Calculation_1265792980302151680]&#10;WHEN &quot;foodpanda Fail Rate&quot; THEN [Vendor Fail Rate (copy)_847661902143631373]&#10;WHEN &quot;Avg DT&quot; THEN [Calculation_847661902144036879]&#10;WHEN &quot;Order On Time Rate&quot; THEN [Calculation_847661902144311313]&#10;WHEN &quot;Avg DT in 4 km&quot; THEN [Calculation_847661902165188642]&#10;WHEN &quot;Acceptance Rate&quot; THEN [Calculation_2109092012034613248]&#10;WHEN &quot;EPT&quot; THEN [Calculation_2109092012034789377]&#10;WHEN &quot;APT&quot; THEN [Calculation_2109092012034904066]&#10;WHEN &quot;Rider Delay Order Rate&quot; THEN [Calculation_2109092012035219459]&#10;WHEN &quot;fp Wastage&quot; THEN [Calculation_847661902144180240]&#10;WHEN &quot;Vendor Wastage&quot; THEN [Calculation_4228528218873286656]&#10;END' />
      </column>
      <column caption='Afv %' datatype='real' name='[Order % (copy)_847661902151299096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([gfv_local]) / SUM([orders]))/&#10;(SUM({ INCLUDE [report_date]:MAX([ttl_gfv_local])}) / SUM({ INCLUDE [report_date]:MAX([ttl_orders])})) - 1' />
