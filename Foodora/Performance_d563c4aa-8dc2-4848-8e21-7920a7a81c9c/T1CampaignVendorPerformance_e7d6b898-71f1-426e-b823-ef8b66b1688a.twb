    <worksheet name='mx wow'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10'>&lt;[Parameters].[Parameter 4]&gt;</run>
            <run fontsize='10'> WoW Comparison</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='t1_order_performance' name='sqlproxy.1axikql0n57kb715ydm3i08npsas' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Part' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Wtd&quot;'>
              <calculation class='tableau' formula='&quot;Wtd&quot;' />
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand&quot;'>
              <calculation class='tableau' formula='&quot;Brand&quot;' />
            </column>
            <column caption='MX KPIs' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Offline Rate&quot;'>
              <calculation class='tableau' formula='&quot;Offline Rate&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1axikql0n57kb715ydm3i08npsas'>
            <column caption='Customer Fail Rate' datatype='real' name='[Calculation_1265792980302151680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_customer]) / SUM([gross_orders])' />
            </column>
            <column caption='Acceptance Rate' datatype='real' name='[Calculation_2109092012034613248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([accepted_times]) / SUM([notified_times])' />
            </column>
            <column caption='EPT' datatype='real' name='[Calculation_2109092012034789377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estimated_prep_time]) / SUM([ept_orders])' />
            </column>
            <column caption='APT' datatype='real' name='[Calculation_2109092012034904066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_prep_time]) / SUM([apt_orders])' />
            </column>
            <column caption='Rider Delay Order Rate' datatype='real' name='[Calculation_2109092012035219459]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_delay_10_orders]) / SUM([rider_delay_ttl_orders])' />
            </column>
            <column caption='Vendor Wastage' datatype='real' name='[Calculation_4228528218873286656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_wastage_local])' />
            </column>
            <column caption='recent 3 weeks' datatype='boolean' name='[Calculation_4306496787446816774]' role='measure' type='nominal'>
              <calculation class='tableau' formula='DATE(TOTAL(MAX(DATETRUNC(&quot;iso-week&quot;, [report_date])))) - MAX(DATETRUNC(&quot;iso-week&quot;, [report_date])) &lt;= 14'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='week color' datatype='real' name='[Calculation_4306496787476344842]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='DATE(TOTAL(MAX(DATETRUNC(&quot;iso-week&quot;, [report_date])))) - MAX(DATETRUNC(&quot;week&quot;, [report_date]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Name ' datatype='string' name='[Calculation_847661902141083648]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;All&quot; THEN &quot;All&quot;&#10;WHEN &quot;Brand&quot; THEN [brand_name]&#10;WHEN &quot;Outlet&quot; THEN [vendor_name]&#10;END' />
            </column>
            <column caption='Actual Open Hours' datatype='real' name='[Calculation_847661902142857224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_open_seconds]) / 3600' />
            </column>
            <column caption='Offline Rate' datatype='real' name='[Calculation_847661902142984201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - SUM([actual_open_seconds]) / SUM([planned_open_seconds])' />
            </column>
            <column caption='Delay Rate' datatype='real' name='[Calculation_847661902143229962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delay_orders]) / SUM([actual_prep_orders])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_847661902143385611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders]) / SUM([gross_orders])' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_847661902143463436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_vendor]) / SUM([gross_orders])' />
            </column>
            <column caption='Avg DT' datatype='real' name='[Calculation_847661902144036879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_dt]) / SUM([dt_orders])' />
            </column>
            <column caption='fp Wastage' datatype='real' name='[Calculation_847661902144180240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fp_wastage_local])' />
            </column>
            <column caption='Order On Time Rate' datatype='real' name='[Calculation_847661902144311313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([on_time_w_pdt_10_orders]) / SUM([pdt_10_orders]))&#10;+ ZN(SUM([on_time_w_pdt_20_orders]) / SUM([pdt_20_orders]))&#10;+ ZN(SUM([on_time_w_pdt_30_orders]) / SUM([pdt_30_orders]))&#10;+ ZN(SUM([on_time_w_pdt_40_orders]) / SUM([pdt_40_orders]))&#10;+ ZN(SUM([on_time_w_pdt_50_orders]) / SUM([pdt_50_orders]))&#10;+ ZN(SUM([on_time_w_pdt_60_orders]) / SUM([pdt_60_orders]))' />
            </column>
