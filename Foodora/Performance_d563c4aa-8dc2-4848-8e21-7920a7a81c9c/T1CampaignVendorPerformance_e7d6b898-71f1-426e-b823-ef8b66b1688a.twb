            </column>
            <column aggregation='Sum' caption='mtd report_date' datatype='integer' name='[Calculation_847661902155108382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&quot;day&quot;, [report_date])' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_847661902155472928]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(Monthly)|(Mtd)&quot;)&#10;THEN DATE(DATETRUNC(&quot;month&quot;, [report_date]))&#10;ELSEIF REGEXP_MATCH([Parameters].[Parameter 1], &quot;(Weekly)|(Wtd)&quot;)&#10;THEN DATE(DATETRUNC(&quot;iso-week&quot;, [report_date]))&#10;ELSE DATE(DATETRUNC(&quot;day&quot;, [report_date]))&#10;END' />
            </column>
