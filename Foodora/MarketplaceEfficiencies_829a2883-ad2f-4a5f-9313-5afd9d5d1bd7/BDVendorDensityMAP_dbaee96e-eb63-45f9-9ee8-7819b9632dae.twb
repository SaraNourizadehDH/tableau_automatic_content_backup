      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom_SQL_Query' id='_22C115BCE8AC4E67A775551E7D7A1515'>
            <properties context=''>
              <relation connection='bigquery.0p2ofvt0wkbi7o19cl4yb0abrg6u' name='Custom_SQL_Query' type='text'>SELECT&#13;
live.date,&#13;
live.vendor_code,&#13;
all_vendor_mapping_file.* &#13;
EXCEPT(vendor_code, vendor_closing_reason, is_restaurants,	is_kitchens,	is_concepts,	is_dmart,	is_caterers,	is_pandago,	is_shops,	is_vouchers,&#13;
is_home_based_kitchen,	is_kitchen_concept_vendor_active,	is_self_operated_kitchen,	kitchen_name,	kitchen_type,	concept_brand_name,	&#13;
concept_outlet_name, concept_operator_name,	concept_type, grid_id,	uuid,	operator_vendor_code),&#13;
live.live_status,&#13;
live.Gross_orders,&#13;
live.Successful_orders,&#13;
live.Offline_percentage,&#13;
live.vendor_closing_reason,&#13;
live.Total_open_Hours,&#13;
live.Total_closed_Hours,&#13;
live.BAD_WEATHER,&#13;
live.CHECK_IN_REQUIRED,&#13;
live.CLOSED,&#13;
live.HOLIDAY_SPECIAL_DAY,&#13;
live.ORDER_FAILURE,&#13;
live.OTHER,&#13;
live.REFURBISHMENT,&#13;
live.RESTRICTED_VISIBILITY,&#13;
live.TECHNICAL_PROBLEM,&#13;
live.TOO_BUSY_KITCHEN,&#13;
live.TOO_BUSY_NO_DRIVERS,&#13;
live.UNREACHABLE,&#13;
live.UPDATES_IN_MENU,&#13;
live.COURIER_DELAYED_AT_PICKUP&#13;
FROM `foodpanda-bd-bigquery.pandata_bd_ops.new_live_closed_vendor_list` AS live&#13;
LEFT JOIN `foodpanda-bd-bigquery.pandata_bd_commerical.all_vendor_mapping_file` AS all_vendor_mapping_file&#13;
ON all_vendor_mapping_file.vendor_code = live.vendor_code&#13;
&#13;
WHERE date &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 4 MONTH)&#13;
AND all_vendor_mapping_file.vendor_code IS NOT NULL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
