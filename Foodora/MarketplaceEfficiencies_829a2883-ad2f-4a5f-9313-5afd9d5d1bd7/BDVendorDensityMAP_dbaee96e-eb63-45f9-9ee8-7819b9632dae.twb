        <calculation class='tableau' formula='IF [Calculation_1793558590695723012] &lt; .10 THEN &quot;0%-10%&quot;&#13;&#10;ELSEIF [Calculation_1793558590695723012] &gt;=.10 &#13;&#10;    AND [Calculation_1793558590695723012] &lt;.20 THEN &quot;10%-20%&quot;&#13;&#10;ELSEIF [Calculation_1793558590695723012] &gt;=.20 &#13;&#10;    AND [Calculation_1793558590695723012] &lt;.30 THEN &quot;20%-30%&quot;&#13;&#10;ELSEIF [Calculation_1793558590695723012] &gt;=.30 &#13;&#10;    AND [Calculation_1793558590695723012] &lt;.40 THEN &quot;30%-40%&quot;&#13;&#10;ELSEIF [Calculation_1793558590695723012] &gt;=.40 &#13;&#10;    AND [Calculation_1793558590695723012] &lt;.50 THEN &quot;40%-50%&quot;&#13;&#10;ELSEIF [Calculation_1793558590695723012] &gt;=.50 &#13;&#10;    AND [Calculation_1793558590695723012] &lt;.60 THEN &quot;50%-60%&quot;&#13;&#10;ELSEIF [Calculation_1793558590695723012] &gt;=.60 &#13;&#10;    AND [Calculation_1793558590695723012] &lt;.70 THEN &quot;60%-70%&quot;&#13;&#10;ELSEIF [Calculation_1793558590695723012] &gt;=.70 &#13;&#10;    AND [Calculation_1793558590695723012] &lt;.80 THEN &quot;70%-80%&quot;&#13;&#10;ELSE &quot;80% of Above&quot;&#13;&#10;END' />
      </column>
