    <worksheet lock-quick-filters='true' name='Delivery Hub Map (Performance)'>
      <table>
        <view>
          <datasources>
            <datasource caption='ndh.shp+ (Multiple Connections)' name='federated.1i7bl1g1o602ap1ar3cf80w3gp4y' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='MAP_METRIC' datatype='string' datatype-customized='true' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;GFV&quot;'>
              <calculation class='tableau' formula='&quot;GFV&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1i7bl1g1o602ap1ar3cf80w3gp4y'>
            <column caption='DH_GFV_GROWTH' datatype='real' default-format='*+0.0%;-0.0%;0%' name='[Calculation_1234408575059513344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([dh_gfv])-SUM([p1_dh_gfv]))/SUM([p1_dh_gfv])' />
            </column>
            <column caption='sum([dh_gfv])/sum([dh_outlets])' datatype='real' name='[Calculation_1292673840722202625]' role='measure' type='quantitative' user:unnamed='Delivery Hub Map (Performance)'>
              <calculation class='tableau' formula='sum([dh_gfv])/sum([dh_outlets])' />
            </column>
            <column caption='sum([dh_order_count])/SUM([dh_unique_customers])' datatype='real' name='[Calculation_5560186377833447428]' role='measure' type='quantitative' user:unnamed='Delivery Hub Map (Performance)'>
              <calculation class='tableau' formula='sum([dh_order_count])/SUM([dh_unique_customers])' />
            </column>
            <column caption='ZCF_AVG_MEDIAN_INCOME' datatype='real' name='[Calculation_5560186377833918469]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([households_median_income]*[households_total])&#10;/&#10;SUM([households_total])' />
            </column>
            <column caption='SUM([Population Total])/SUM([Households Total])' datatype='real' name='[Calculation_5560186377834991625]' role='measure' type='quantitative' user:unnamed='Delivery Hub Map (Performance)'>
              <calculation class='tableau' formula='SUM([population_total])/SUM([households_total])' />
            </column>
            <column caption='sum([dh_order_count])/sum([dh_outlets])' datatype='real' name='[Calculation_6502986812951515136]' role='measure' type='quantitative' user:unnamed='Delivery Hub Map (Performance)'>
              <calculation class='tableau' formula='sum([dh_order_count])/sum([dh_outlets])' />
            </column>
            <column caption='Food Rating (DH)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_717479719025094656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dh_restaurant_food_rating_sum])&#10;/&#10;sum([dh_restaurant_food_rating_count])' />
            </column>
            <column caption='CR3 (DH)' datatype='real' default-format='p0.0%' name='[Calculation_717479719028977665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_of_checkout_loaded])/&#10;sum([count_of_shop_menu_loaded])' />
            </column>
            <column caption='Avg Delivery Time (DH)' datatype='real' name='[Calculation_717479719038824451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dh_delivery_actual_delivery_time_sum])&#10;/&#10;sum([dh_delivery_nonpreorder_valid_order_count])' />
            </column>
            <column caption='DELIVERY_HUB_MAP_METRIC' datatype='real' name='[Calculation_791578057419530241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &apos;GFV&apos; THEN SUM([dh_gfv])&#10;    WHEN &apos;GFV per Outlet&apos; THEN sum([dh_gfv])/sum([dh_outlets])&#10;    WHEN &apos;GFV Growth&apos; THEN [Calculation_1234408575059513344]&#10;    WHEN &apos;AFV&apos; THEN SUM([dh_gfv])/SUM([dh_order_count])&#10;    WHEN &apos;Reachable Outlets&apos; THEN SUM([dh_outlets])&#10;    WHEN &apos;Orders&apos; THEN SUM([dh_order_count])&#10;    WHEN &apos;Orders per Customer&apos; THEN SUM([dh_order_count])/SUM([dh_unique_customers])&#10;    WHEN &apos;Orders per Outlet&apos; THEN SUM([dh_order_count])/SUM([dh_outlets])&#10;    WHEN &apos;Orders Growth&apos; THEN [DH_GFV_GROWTH (copy)_1234408575060033537]&#10;    WHEN &apos;Customers&apos; THEN SUM([dh_unique_customers])&#10;    WHEN &apos;Orders per Customer&apos; THEN sum([dh_order_count])/sum([dh_unique_customers])&#10;    WHEN &apos;Pickup GFV&apos; THEN SUM([dh_valid_pickup_gfv])&#10;    WHEN &apos;Pickup Orders&apos; THEN SUM([dh_valid_pickup_orders])&#10;    WHEN &apos;Pickup Outlets&apos; THEN SUM([dh_pickup_outlets])&#10;    WHEN &apos;Actual Delivery Time&apos; THEN [Calculation_717479719038824451]&#10;    WHEN &apos;Population&apos; THEN sum([population_total])&#10;    WHEN &apos;Households&apos; THEN sum([households_total])&#10;    WHEN &apos;Household Size&apos; THEN sum([population_total])/sum([households_total])&#10;    WHEN &apos;Avg Median Income&apos; THEN [Calculation_5560186377833918469]&#10;    WHEN &apos;Avg Food Rating&apos; THEN [Calculation_717479719025094656]&#10;    WHEN &apos;Physical Outlets&apos; THEN SUM([active_outlet_count])&#10;    WHEN &apos;CR3&apos; THEN [Calculation_717479719028977665]&#10;END' />
            </column>
            <column caption='DH_AFV' datatype='real' name='[Calculation_791578057421238275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv])/SUM([order_count])' />
            </column>
            <column caption='DH_ORDER_GROWTH' datatype='real' default-format='*+0.0%;-0.0%;0%' name='[DH_GFV_GROWTH (copy)_1234408575060033537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([dh_order_count])-SUM([p1_dh_order_count]))/SUM([p1_dh_order_count])' />
            </column>
            <column datatype='spatial' name='[Geometry]' role='measure' type='nominal' />
            <column caption='Lg Geo Id (copy)' datatype='string' name='[Lg Geo Id (copy)_3255117407361474576]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[lg_geo_id]' />
            </column>
            <column datatype='integer' name='[active_outlet_count]' role='measure' type='quantitative' />
            <column-instance column='[Geometry]' derivation='Collect' name='[clct:Geometry:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[count_of_checkout_loaded]' role='measure' type='quantitative' />
            <column datatype='integer' name='[count_of_shop_menu_loaded]' role='measure' type='quantitative' />
            <column datatype='real' name='[dh_delivery_actual_delivery_time_sum]' role='measure' type='quantitative' />
            <column datatype='integer' name='[dh_delivery_nonpreorder_valid_order_count]' role='measure' type='quantitative' />
            <column datatype='real' name='[dh_gfv]' role='measure' type='quantitative' />
            <column datatype='integer' name='[dh_order_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[dh_outlets]' role='measure' type='quantitative' />
            <column datatype='integer' name='[dh_pickup_outlets]' role='measure' type='quantitative' />
            <column datatype='integer' name='[dh_restaurant_food_rating_count]' role='measure' type='quantitative' />
            <column datatype='real' name='[dh_restaurant_food_rating_sum]' role='measure' type='quantitative' />
            <column datatype='integer' name='[dh_unique_customers]' role='measure' type='quantitative' />
            <column datatype='real' name='[dh_valid_pickup_gfv]' role='measure' type='quantitative' />
