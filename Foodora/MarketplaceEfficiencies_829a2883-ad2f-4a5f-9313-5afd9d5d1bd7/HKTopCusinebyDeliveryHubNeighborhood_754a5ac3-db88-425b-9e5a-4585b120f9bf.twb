          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='MAP_METRIC' datatype='string' datatype-customized='true' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;GFV&quot;'>
              <calculation class='tableau' formula='&quot;GFV&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1i7bl1g1o602ap1ar3cf80w3gp4y'>
            <column caption='Avg Delivery Time (Neighborhood)' datatype='real' name='[Avg Delivery Time (DH) (copy)_717479719038902276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([delivery_actual_delivery_time_sum])&#10;/&#10;sum([delivery_nonpreorder_valid_order_count])' />
            </column>
            <column caption='CR3 (Neighborhood)' datatype='real' default-format='p0.0%' name='[CR3 (copy)_7012174996656947202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_of_checkout_loaded (Custom SQL Query1)])/&#10;sum([count_of_shop_menu_loaded (Custom SQL Query1)])' />
            </column>
            <column caption='sum([order_count])/sum([outlets])' datatype='real' name='[Calculation_505247621008478208]' role='measure' type='quantitative' user:unnamed='Neighborhood Map (Performance)'>
              <calculation class='tableau' formula='sum([order_count])/sum([outlets])' />
            </column>
            <column caption='sum([gfv])/sum([outlets])' datatype='real' name='[Calculation_505247621008506881]' role='measure' type='quantitative' user:unnamed='Neighborhood Map (Performance)'>
              <calculation class='tableau' formula='sum([gfv])/sum([outlets])' />
            </column>
            <column caption='sum([order_count])/sum([unique_customers])' datatype='real' name='[Calculation_505247621008535554]' role='measure' type='quantitative' user:unnamed='Neighborhood Map (Performance)'>
              <calculation class='tableau' formula='sum([order_count])/sum([unique_customers])' />
            </column>
            <column caption='ZCF_AVG_MEDIAN_INCOME' datatype='real' name='[Calculation_5560186377833918469]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([households_median_income]*[households_total])&#10;/&#10;SUM([households_total])' />
            </column>
            <column caption='SUM([Population Total])/SUM([Households Total])' datatype='real' name='[Calculation_6263029395012808710]' role='measure' type='quantitative' user:unnamed='Neighborhood Map (Performance)'>
              <calculation class='tableau' formula='SUM([population_total])/SUM([households_total])' />
            </column>
            <column caption='Food Rating (Neighborhood)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_717479719038603266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([restaurant_food_rating_sum])&#10;/&#10;sum([restaurant_food_rating_count])' />
            </column>
            <column caption='sum([gfv])/sum([order_count])' datatype='real' name='[Calculation_791578057426243592]' role='measure' type='quantitative' user:unnamed='Neighborhood Map (Performance)'>
              <calculation class='tableau' formula='sum([gfv])/sum([order_count])' />
            </column>
            <column caption='NEIGHBORHOOD_MAP_METRIC' datatype='real' name='[DELIVERY_HUB_MAP_METRIC (copy)_791578057423974404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &apos;GFV&apos; THEN SUM([gfv])&#10;    WHEN &apos;GFV per Outlet&apos; THEN SUM([gfv])/SUM([outlets])&#10;    WHEN &apos;GFV Growth&apos; THEN [DH_GFV_GROWTH (copy)_1234408575062024195]&#10;    WHEN &apos;Orders&apos; THEN SUM([order_count])&#10;    WHEN &apos;Orders Growth&apos; THEN [DH_ORDER_GROWTH (copy)_1234408575062024196]&#10;    WHEN &apos;AFV&apos; THEN SUM([gfv])/SUM([order_count])&#10;    WHEN &apos;Actual Delivery Time&apos; THEN [Avg Delivery Time (DH) (copy)_717479719038902276]&#10;    WHEN &apos;Reachable Outlets&apos; THEN SUM([outlets])&#10;    WHEN &apos;Orders per Outlet&apos; THEN SUM([order_count])/SUM([outlets])&#10;    WHEN &apos;Customers&apos; THEN SUM([unique_customers])&#10;    WHEN &apos;Orders per Customer&apos; THEN sum([order_count])/sum([unique_customers])&#10;    WHEN &apos;Pickup GFV&apos; THEN sum([valid_pickup_gfv])&#10;    WHEN &apos;Pickup Orders&apos; then SUM([valid_pickup_orders])&#10;    WHEN &apos;Pickup Outlets&apos; THEN sum([pickup_outlets])&#10;    WHEN &apos;Population&apos; THEN sum([population_total])&#10;    WHEN &apos;Households&apos; THEN sum([households_total])&#10;    WHEN &apos;Household Size&apos; THEN sum([population_total])/sum([households_total])&#10;    WHEN &apos;Avg Median Income&apos; THEN [Calculation_5560186377833918469]&#10;    WHEN &apos;Avg Food Rating&apos; THEN [Calculation_717479719038603266]&#10;    WHEN &apos;Physical Outlets&apos; THEN SUM([active_outlet_count (Custom SQL Query1)])&#10;    WHEN &apos;CR3&apos; THEN [CR3 (copy)_7012174996656947202]&#10;END' />
            </column>
            <column caption='NH_GFV_GROWTH' datatype='real' default-format='*+0.0%;-0.0%;0%' name='[DH_GFV_GROWTH (copy)_1234408575062024195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gfv])-SUM([p1_gfv]))/SUM([p1_gfv])' />
            </column>
            <column caption='NH_ORDER_GROWTH' datatype='real' default-format='*+0.0%;-0.0%;0%' name='[DH_ORDER_GROWTH (copy)_1234408575062024196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([order_count])-SUM([p1_order_count]))/SUM([p1_order_count])' />
            </column>
