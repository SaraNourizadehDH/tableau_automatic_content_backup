          <relation connection='bigquery.1lme7qo1n9gmxr18jwrhx1c2kf09' name='Custom SQL Query' type='text'><![CDATA[with input AS (
  SELECT
    date(<[Parameters].[Parameter 5]>) start_d,
    date(<[Parameters].[START_DATE (copy)_700591256702152704]>) end_d,
    date_sub(<[Parameters].[Parameter 5]>, interval date_diff(date(<[Parameters].[START_DATE (copy)_700591256702152704]>), date(<[Parameters].[Parameter 5]>), day) day) p1_start_d,
    date_sub(<[Parameters].[START_DATE (copy)_700591256702152704]>, interval date_diff(date(<[Parameters].[START_DATE (copy)_700591256702152704]>), date(<[Parameters].[Parameter 5]>), day) day) p1_end_d,
    <[Parameters].[Parameter 8]> primary_cuisine,
    <[Parameters].[SELECTED_PRIMARY_CUISINE (copy)_1979402459478306816]> secondary_cuisine,
    <[Parameters].[SELECTED_SECONDARY_CUISINE (copy)_6405103889542782976]> food_characteristics,
),
base AS (
  SELECT 
    distinct 
    v.primary_cuisine,
    o.zone_name_grouped,
    count(distinct order_code) over (partition by o.zone_name_grouped, v.primary_cuisine) primary_cuisine_order_count,
    count(distinct order_code) over (partition by o.zone_name_grouped) zone_order_count,
  FROM `dhh---analytics-apac.pandata_hk.hkg_orders_agg` o, input 
  LEFT JOIN `dhh---analytics-apac.pandata_hk.hkg_vendors_agg` v ON o.vendor_code = v.vendor_code
  WHERE o.created_date_local between input.start_d and input.end_d and v.vertical_type='restaurants' and is_valid_order
    and  
  if (input.primary_cuisine = '' and input.secondary_cuisine = '' and input.food_characteristics = '',
    1=1,
    (if( input.primary_cuisine <<>> '', regexp_contains(lower(v.primary_cuisine), lower(CONCAT('.*(', REPLACE(input.primary_cuisine, ', ' , '|'),').*')))  , 1=0)
      OR if( input.secondary_cuisine <<>> '', regexp_contains(lower(v.cuisines), lower(CONCAT('.*(', REPLACE(input.secondary_cuisine, ', ' , '|'),').*')))  , 1=0)
      OR if( input.food_characteristics <<>> '', regexp_contains(lower(v.food_characteristics), lower(CONCAT('.*(', REPLACE(input.food_characteristics, ', ' , '|'),').*')))  , 1=0)
    ))
),
base2 AS (
  SELECT
    base.*,
    row_number() over (partition by zone_name_grouped order by primary_cuisine_order_count desc) ranking
  FROM base
),
best_in_zone AS (
  SELECT
    zone_name_grouped,
    max(primary_cuisine_order_count) best_orders,
    max(safe_divide(primary_cuisine_order_count, zone_order_count)) best_share_of_orders,
    string_agg(primary_cuisine ORDER BY primary_cuisine_order_count DESC LIMIT 1) top_cuisine,
    max(ranking) ranking
  FROM base2
  where zone_name_grouped is not null and ranking=1
  GROUP BY 1
),
session AS (
  SELECT 
    v.zone_name_grouped,
    sum( count_of_shop_list_loaded) count_of_shop_list_loaded,
    sum( count_of_shop_menu_loaded ) count_of_shop_menu_loaded ,
    sum( count_of_add_cart_clicked ) count_of_add_cart_clicked ,
    sum( count_of_checkout_loaded ) count_of_checkout_loaded , 
    sum( count_of_transaction ) count_of_transaction , 
    count(distinct v.vendor_code) active_outlet_count
  FROM
    `fulfillment-dwh-production.pandata_report.product__vendor_session_metrics` vs, input
  LEFT JOIN `dhh---analytics-apac.pandata_hk.hkg_vendors_agg` v on v.vendor_code = vs.vendor_code
  where partition_date >>= input.p1_start_d 
    and vertical_type='restaurants' 
    and vs.global_entity_id='FP_HK'
    and v.is_active
    and  
    if (input.primary_cuisine = '' and input.secondary_cuisine = '' and input.food_characteristics = '',
      1=1,
      (if( input.primary_cuisine <<>> '', regexp_contains(lower(v.primary_cuisine), lower(CONCAT('.*(', REPLACE(input.primary_cuisine, ', ' , '|'),').*')))  , 1=0)
        OR if( input.secondary_cuisine <<>> '', regexp_contains(lower(v.cuisines), lower(CONCAT('.*(', REPLACE(input.secondary_cuisine, ', ' , '|'),').*')))  , 1=0)
        OR if( input.food_characteristics <<>> '', regexp_contains(lower(v.food_characteristics), lower(CONCAT('.*(', REPLACE(input.food_characteristics, ', ' , '|'),').*')))  , 1=0)
      ))

  GROUP BY 1
),
order_final AS (
  SELECT
    o.zone_name_grouped,
    sum(if( o.created_date_local between input.start_d and input.end_d , o.gfv_local, 0)) dh_gfv,
    count(distinct if( o.created_date_local between input.start_d and input.end_d, order_code, null)) dh_order_count,
    sum(if(is_valid_order and  o.created_date_local between input.start_d and input.end_d ,discount_local,0)) dh_discount_local,
    count(distinct if(is_valid_order and  o.created_date_local between input.start_d and input.end_d ,v.vendor_code,null)) dh_outlets,
    count(distinct if(is_valid_order and  o.created_date_local between input.start_d and input.end_d ,coalesce(v.brand_id,v.chain_code,v.vendor_code),null)) dh_brands,
    count(distinct if(is_valid_order and  o.created_date_local between input.start_d and input.end_d ,pd_customer_uuid,null)) dh_unique_customers,
    count(distinct if(is_valid_order and expedition_type='pickup' and  o.created_date_local between input.start_d and input.end_d ,order_code,null)) dh_valid_pickup_orders,
    count(distinct if(is_valid_order and expedition_type='pickup' and  o.created_date_local between input.start_d and input.end_d ,o.vendor_code,null)) dh_pickup_outlets,
    sum(if(is_valid_order and o.restaurant_food_rating>>0, o.restaurant_food_rating, 0)) dh_restaurant_food_rating_sum,
    count(distinct if(is_valid_order and o.restaurant_food_rating>>0, order_code, null)) dh_restaurant_food_rating_count,  
    sum(if(is_valid_order and is_delivery and is_preorder=false, actual_delivery_time_in_minutes, 0)) dh_delivery_actual_delivery_time_sum,
    count(distinct if(is_valid_order and is_delivery and is_preorder=false, order_code, null)) dh_delivery_nonpreorder_valid_order_count,
    sum( if(is_valid_order and expedition_type='pickup' and  o.created_date_local between input.start_d and input.end_d ,gfv_local,0)) dh_valid_pickup_gfv,
    count(distinct if(is_valid_order and expedition_type='delivery' and  o.created_date_local between input.start_d and input.end_d ,order_code,null)) dh_valid_delivery_orders,
    sum(if( o.created_date_local between input.p1_start_d and input.p1_end_d , o.gfv_local, 0)) p1_dh_gfv,
    count(distinct if( o.created_date_local between input.p1_start_d and input.p1_end_d, order_code, null)) p1_dh_order_count,
    count(distinct if(is_valid_order and  o.created_date_local between input.p1_start_d and input.p1_end_d ,pd_customer_uuid,null)) p1_dh_unique_customers,
    count(distinct if(is_valid_order and expedition_type='pickup' and  o.created_date_local between input.p1_start_d and input.p1_end_d ,order_code,null)) p1_dh_valid_pickup_orders,
    max(biz.best_orders) dh_best_orders,
    max(biz.best_share_of_orders) dh_best_share_of_orders,
    max(top_cuisine) dh_top_cuisine,
    max(ranking) dh_ranking,
  FROM `dhh---analytics-apac.pandata_hk.hkg_orders_agg` o, input
  LEFT JOIN `dhh---analytics-apac.pandata_hk.hkg_vendors_agg` v on v.vendor_code=o.vendor_code
  LEFT JOIN best_in_zone biz on biz.zone_name_grouped = o.zone_name_grouped
  where o.created_date_local >>= input.p1_start_d and o.zone_name_grouped is not null and is_valid_order
    and o.vertical_type='restaurants' 
    and  
    if (input.primary_cuisine = '' and input.secondary_cuisine = '' and input.food_characteristics = '',
      1=1,
      (if( input.primary_cuisine <<>> '', regexp_contains(lower(v.primary_cuisine), lower(CONCAT('.*(', REPLACE(input.primary_cuisine, ', ' , '|'),').*')))  , 1=0)
        OR if( input.secondary_cuisine <<>> '', regexp_contains(lower(v.cuisines), lower(CONCAT('.*(', REPLACE(input.secondary_cuisine, ', ' , '|'),').*')))  , 1=0)
        OR if( input.food_characteristics <<>> '', regexp_contains(lower(v.food_characteristics), lower(CONCAT('.*(', REPLACE(input.food_characteristics, ', ' , '|'),').*')))  , 1=0)
      ))
  group by 1 
  order by 2 desc
)
SELECT
  f.*,
  count_of_shop_list_loaded,
  count_of_shop_menu_loaded ,
  count_of_add_cart_clicked ,
  count_of_checkout_loaded , 
  count_of_transaction , 
  active_outlet_count
FROM order_final f
LEFT JOIN session s on s.zone_name_grouped = f.zone_name_grouped]]></relation>
