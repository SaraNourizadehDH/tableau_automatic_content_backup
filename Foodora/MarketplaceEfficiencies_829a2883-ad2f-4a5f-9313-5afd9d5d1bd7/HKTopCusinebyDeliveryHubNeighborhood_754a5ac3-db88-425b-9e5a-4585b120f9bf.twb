      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ndh.shp+ (Multiple Connections)' name='federated.1i7bl1g1o602ap1ar3cf80w3gp4y' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='PARAM_CUISINE_TYPE' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Primary&quot;'>
              <calculation class='tableau' formula='&quot;Primary&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1i7bl1g1o602ap1ar3cf80w3gp4y'>
            <column caption='ZCF_CUISINE_TYPE' datatype='string' name='[Calculation_3255117407142023182]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] &#10;    WHEN &apos;Primary&apos; THEN [primary_cuisine]&#10;    WHEN &apos;Secondary&apos; then [secondary_cuisine]&#10;END' />
            </column>
