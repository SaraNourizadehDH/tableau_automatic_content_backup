      <column caption='DELIVERY_HUB_MAP_METRIC' datatype='real' name='[Calculation_791578057419530241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &apos;GFV&apos; THEN SUM([dh_gfv])&#10;    WHEN &apos;GFV per Outlet&apos; THEN sum([dh_gfv])/sum([dh_outlets])&#10;    WHEN &apos;GFV Growth&apos; THEN [Calculation_1234408575059513344]&#10;    WHEN &apos;AFV&apos; THEN SUM([dh_gfv])/SUM([dh_order_count])&#10;    WHEN &apos;Reachable Outlets&apos; THEN SUM([dh_outlets])&#10;    WHEN &apos;Orders&apos; THEN SUM([dh_order_count])&#10;    WHEN &apos;Orders per Customer&apos; THEN SUM([dh_order_count])/SUM([dh_unique_customers])&#10;    WHEN &apos;Orders per Outlet&apos; THEN SUM([dh_order_count])/SUM([dh_outlets])&#10;    WHEN &apos;Orders Growth&apos; THEN [DH_GFV_GROWTH (copy)_1234408575060033537]&#10;    WHEN &apos;Customers&apos; THEN SUM([dh_unique_customers])&#10;    WHEN &apos;Orders per Customer&apos; THEN sum([dh_order_count])/sum([dh_unique_customers])&#10;    WHEN &apos;Pickup GFV&apos; THEN SUM([dh_valid_pickup_gfv])&#10;    WHEN &apos;Pickup Orders&apos; THEN SUM([dh_valid_pickup_orders])&#10;    WHEN &apos;Pickup Outlets&apos; THEN SUM([dh_pickup_outlets])&#10;    WHEN &apos;Actual Delivery Time&apos; THEN [Calculation_717479719038824451]&#10;    WHEN &apos;Population&apos; THEN sum([population_total])&#10;    WHEN &apos;Households&apos; THEN sum([households_total])&#10;    WHEN &apos;Household Size&apos; THEN sum([population_total])/sum([households_total])&#10;    WHEN &apos;Avg Median Income&apos; THEN [Calculation_5560186377833918469]&#10;    WHEN &apos;Avg Food Rating&apos; THEN [Calculation_717479719025094656]&#10;    WHEN &apos;Physical Outlets&apos; THEN SUM([active_outlet_count])&#10;    WHEN &apos;CR3&apos; THEN [Calculation_717479719028977665]&#10;END' />
      </column>
      <column caption='DH_AFV' datatype='real' name='[Calculation_791578057421238275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv])/SUM([order_count])' />
