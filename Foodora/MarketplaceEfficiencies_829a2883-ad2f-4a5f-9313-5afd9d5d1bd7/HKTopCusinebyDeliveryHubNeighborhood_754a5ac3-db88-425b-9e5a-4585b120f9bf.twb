            <properties context=''>
              <relation connection='bigquery.1lme7qo1n9gmxr18jwrhx1c2kf09' name='neighborhood_2016' table='[foodpanda-hk-bigquery.data_gov_hk].[neighborhood_2016]' type='table' />
