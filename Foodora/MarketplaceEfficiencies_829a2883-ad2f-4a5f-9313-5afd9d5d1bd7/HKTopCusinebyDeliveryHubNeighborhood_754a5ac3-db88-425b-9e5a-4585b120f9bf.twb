      <column caption='ZCF_SELECTED_METRICS_VALUE' datatype='real' name='[Calculation_1019361659884584966]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;GFV&apos; THEN [Calculation_1019361659881873409]&#10;    WHEN &apos;AFV&apos; THEN [Calculation_1019361659882012675]&#10;    WHEN &apos;ORDERS&apos; THEN [Calculation_1019361659881943042]&#10;    WHEN &apos;DISCOUNT RATE&apos; THEN [Calculation_1019361659949182990]&#10;    WHEN &apos;CUSTOMERS&apos; THEN SUM([unique_customers])&#10;    WHEN &apos;PENETRATION&apos; THEN [Calculation_1019361660289155098]&#10;    WHEN &apos;CPO&apos; THEN [Calculation_4957055847426572288]&#10;    WHEN &apos;PENETRATION_DIFF&apos; THEN [ZCF_PENETRATION (copy)_851391470087303169]&#10;END' />
      </column>
      <column caption='ZCF_POPULATION' datatype='real' name='[Calculation_1019361659885703180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[coverage]*[population_total]' />
      </column>
      <column caption='ZCF_DISCOUNT_RATE' datatype='real' name='[Calculation_1019361659949182990]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_local])/SUM([dh_gfv])' />
      </column>
      <column caption='ZCF_SELECTED_VENDORS_POPULATION' datatype='string' name='[Calculation_1019361660026474520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_selected_vendors] THEN &quot;Selected Vendors&quot;&#10;ELSE&#10;    STR(INT([population_total]/1000)*1000)&#10;END' />
      </column>
      <column caption='ZCF_PENETRATION' datatype='real' name='[Calculation_1019361660289155098]' role='measure' type='quantitative'>
