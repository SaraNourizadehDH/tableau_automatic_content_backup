SELECT *, &quot;OD&quot; AS exp_type FROM resto_od
UNION ALL
SELECT *, &quot;OD&quot; AS exp_type FROM homechefs
UNION ALL
SELECT *, &quot;OD&quot; AS exp_type FROM kitchens
UNION ALL
SELECT *, &quot;OD&quot; AS exp_type FROM concepts
UNION ALL
SELECT *, &quot;OD&quot; AS exp_type FROM shops
UNION ALL
SELECT *, &quot;OD&quot; AS exp_type FROM darkstores
UNION ALL
SELECT *, &quot;Pickup&quot; AS exp_type FROM resto_od_pu
UNION ALL
SELECT *, &quot;Pickup&quot; AS exp_type FROM homechefs_pu
UNION ALL
SELECT *, &quot;Pickup&quot; AS exp_type FROM kitchens_pu
UNION ALL
SELECT *, &quot;Pickup&quot; AS exp_type FROM concepts_pu
UNION ALL
