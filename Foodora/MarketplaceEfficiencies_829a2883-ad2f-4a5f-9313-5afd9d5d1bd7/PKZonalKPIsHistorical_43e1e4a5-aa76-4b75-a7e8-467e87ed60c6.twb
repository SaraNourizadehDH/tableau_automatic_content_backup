        <field-sort-custom-order field='exp_type (Custom SQL Query2)' />
        <field-sort-custom-order field='account_type (Custom SQL Query2)' />
        <field-sort-custom-order field='total_close_hours' />
        <field-sort-custom-order field='total_open_hours' />
        <field-sort-custom-order field='actual_open_hours' />
        <field-sort-custom-order field='actual_open_hours_w_special' />
        <field-sort-custom-order field='Calculation_6677079048946188289' />
        <field-sort-custom-order field='actual_open_vendors' />
      </field-sort-info>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
          <calculation class='tableau' formula='&quot;Month&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Offline Hours' id='_0D9D032B27274DB6AC6BD5EB5CFE4C34'>
            <properties context=''>
              <relation connection='bigquery.0xby99m1ew4e5n1d5cvqx16ihddn' name='Custom SQL Query2' type='text'>SELECT 
  off.report_date,
  vi.vertical,
  CASE
  WHEN vi.lg_city IS NULL THEN &quot;N/A&quot;
  ELSE vi.lg_city
  END AS lg_city,
  CASE
  WHEN vi.lg_zone_name IS NULL THEN &quot;N/A&quot;
  ELSE vi.lg_zone_name
  END AS lg_zone_name,
  &quot;OD&quot; AS exp_type,
  vi.account_type,
  SUM(off.total_close_hours) AS total_close_hours,
  SUM(off.total_open_hours) AS total_open_hours,
  SUM(off.total_open_hours) - SUM(off.total_close_hours) AS actual_open_hours,
  SUM(off.total_open_hours) - SUM(off.total_closed_with_special_day) AS actual_open_hours_w_special,
  SAFE_DIVIDE(SUM(off.total_close_hours), SUM(off.total_open_hours)) AS offline_percentage,
  COUNT(DISTINCT(CASE WHEN off.total_open_hours &gt;&gt; 0 THEN off.vendor_code END)) AS actual_open_vendors

FROM `fulfillment-dwh-production.pandata_report.country_PK_vendor_offline_hours` AS off
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
ON off.vendor_code = vi.vendor_code

WHERE off.report_date &gt;&gt;= &quot;2023-01-01&quot;
AND LOWER(vi.vertical) IN (&quot;shared kitchens&quot;, &quot;restaurants&quot;, &quot;concepts&quot;, &quot;home chefs&quot;, &quot;darkstores&quot;, &quot;shops&quot;)

GROUP BY 1, 2, 3, 4, 5, 6</relation>
            </properties>
            <properties context='extract'>
              <relation name='_0D9D032B27274DB6AC6BD5EB5CFE4C34' table='[Extract].[_0D9D032B27274DB6AC6BD5EB5CFE4C34]' type='table' />
            </properties>
          </object>
          <object caption='Logistics Shrink &amp; Surge' id='_24B5CCF4138E49B78CD80255B096021F'>
            <properties context=''>
              <relation connection='bigquery.0xby99m1ew4e5n1d5cvqx16ihddn' name='Custom SQL Query9' type='text'>WITH daily_surge_experience AS (
  SELECT
    global_entity_id,
    lg_country_code,
    city_name, 
    lg_city_id,
    zone_name,
    lg_zone_id,
    created_date_local,

    COUNT(CASE WHEN is_surged THEN order_code END) AS surged_order_experience,
    COUNT(CASE WHEN is_surged_1 THEN order_code END) AS surged_1st_order_experience,
    COUNT(CASE WHEN is_surged_2 THEN order_code END) AS surged_2nd_order_experience,
    COUNT(CASE WHEN is_surged_3 THEN order_code END) AS surged_3rd_order_experience,
    COUNT(CASE WHEN is_surged_4 THEN order_code END) AS surged_4th_order_experience,
    COUNT(CASE WHEN is_surged_above_4 THEN order_code END) AS surged_above_4_order_experience,
    COUNT(order_code) AS actual_orders,

    COUNT(CASE WHEN EXTRACT(HOUR FROM order_placed_at_local) IN (19,20,21,22,23,24) AND is_surged THEN order_code END) AS surged_order_experience_7pm,
    COUNT(CASE WHEN EXTRACT(HOUR FROM order_placed_at_local) IN (19,20,21,22,23,24) AND is_surged_1 THEN order_code END) AS surged_1st_order_experience_7pm,
    COUNT(CASE WHEN EXTRACT(HOUR FROM order_placed_at_local) IN (19,20,21,22,23,24) AND is_surged_2 THEN order_code END) AS surged_2nd_order_experience_7pm,
    COUNT(CASE WHEN EXTRACT(HOUR FROM order_placed_at_local) IN (19,20,21,22,23,24) AND is_surged_3 THEN order_code END) AS surged_3rd_order_experience_7pm,
    COUNT(CASE WHEN EXTRACT(HOUR FROM order_placed_at_local) IN (19,20,21,22,23,24) AND is_surged_4 THEN order_code END) AS surged_4th_order_experience_7pm,
    COUNT(CASE WHEN EXTRACT(HOUR FROM order_placed_at_local) IN (19,20,21,22,23,24) AND is_surged_above_4 THEN order_code END) AS surged_above_4_order_experience_7pm,
    COUNT(CASE WHEN EXTRACT(HOUR FROM order_placed_at_local) IN (19,20,21,22,23,24) THEN order_code END) AS actual_orders_7pm,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_surged_orders_experienced` 
  WHERE created_date_local &gt;&gt;= &quot;2023-01-01&quot;
    AND lg_zone_id IS NOT NULL
    AND global_entity_id = &quot;FP_PK&quot;
  GROUP BY 1,2,3,4,5,6,7
),

daily_shrink_close_events AS (
  SELECT 
    global_entity_id,
    lg_country_code,
    lg_city_id,  
    city_name, 
    lg_zone_id,
    zone_name,
    date_local,
    SUM(forecasted_orders) AS forecasted_orders,
    SUM(shrink_orders) AS shrink_orders,
    SUM(shrink_0_orders) AS shrink_0_orders,
    SUM(shrink_1st_orders) AS shrink_1st_orders,
    SUM(shrink_2nd_orders) AS shrink_2nd_orders,
    SUM(shrink_3rd_orders) AS shrink_3rd_orders,
    SUM(shrink_4th_orders) AS shrink_4th_orders,
    SUM(shrink_5th_orders) AS shrink_5th_orders,
    SUM(shrink_6th_orders) AS shrink_6th_orders,
    SUM(close_orders) AS close_orders
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_weighted_das_events_hourly` 
  WHERE date_local &gt;&gt;= &quot;2023-01-01&quot;
  AND global_entity_id = &quot;FP_PK&quot;
  GROUP BY 1,2,3,4,5,6,7
)

SELECT 
  shrink_close.global_entity_id,
  shrink_close.lg_country_code AS country_code,
  shrink_close.lg_city_id,
  CASE
  WHEN shrink_close.city_name IS NULL THEN &quot;N/A&quot;
  ELSE shrink_close.city_name
  END AS city_name,
  shrink_close.lg_zone_id,
  CASE
  WHEN shrink_close.zone_name IS NULL THEN &quot;N/A&quot;
  ELSE shrink_close.zone_name
  END AS zone_name,
  shrink_close.date_local as date_local,
  &quot;restaurants&quot; AS vertical,
  &quot;OD&quot; AS exp_type,
  &quot;Accounts&quot; AS account_type,

  SUM(surge.actual_orders) AS actual_orders,
  SUM(surge.actual_orders_7pm) AS actual_orders_7pm,
  SUM(shrink_close.forecasted_orders) AS forecasted_orders,
  
  SUM(surge.surged_1st_order_experience) AS surged_1st_order_experience,
  SUM(surge.surged_2nd_order_experience) AS surged_2nd_order_experience,
  SUM(surge.surged_3rd_order_experience) AS surged_3rd_order_experience,
  SUM(surge.surged_4th_order_experience) AS surged_4th_order_experience,
  SUM(surge.surged_above_4_order_experience) AS surged_above_4_order_experience,
  SAFE_DIVIDE(
    SUM(surge.surged_1st_order_experience) + SUM(surge.surged_2nd_order_experience) + SUM(surge.surged_3rd_order_experience) + SUM(surge.surged_4th_order_experience) + SUM(surge.surged_above_4_order_experience), 
    SUM(surge.actual_orders)
  ) AS surge_percentage,

  SUM(surge.surged_1st_order_experience_7pm) AS surged_1st_order_experience_7pm,
  SUM(surge.surged_2nd_order_experience_7pm) AS surged_2nd_order_experience_7pm,
  SUM(surge.surged_3rd_order_experience_7pm) AS surged_3rd_order_experience_7pm,
  SUM(surge.surged_4th_order_experience_7pm) AS surged_4th_order_experience_7pm,
  SUM(surge.surged_above_4_order_experience_7pm) AS surged_above_4_order_experience_7pm,
  SAFE_DIVIDE(
    SUM(surge.surged_1st_order_experience_7pm) + SUM(surge.surged_2nd_order_experience_7pm) + SUM(surge.surged_3rd_order_experience_7pm) + SUM(surge.surged_4th_order_experience_7pm) + SUM(surge.surged_above_4_order_experience_7pm), 
    SUM(surge.actual_orders_7pm)
  ) AS surge_percentage_7pm,

  SUM(shrink_close.shrink_0_orders) AS shrink_0_orders, 
  SUM(shrink_close.shrink_1st_orders) AS shrink_1st_orders, 
  SUM(shrink_close.shrink_2nd_orders) AS shrink_2nd_orders,
  SUM(shrink_close.shrink_3rd_orders) AS shrink_3rd_orders,
  SUM(shrink_close.shrink_4th_orders) AS shrink_4th_orders,
  SUM(shrink_close.shrink_5th_orders) AS shrink_5th_orders,
  SUM(shrink_close.shrink_6th_orders) AS shrink_6th_orders,

  SAFE_DIVIDE(
    SUM(shrink_close.shrink_0_orders) + SUM(shrink_close.shrink_1st_orders) + SUM(shrink_close.shrink_2nd_orders) + SUM(shrink_close.shrink_3rd_orders) + SUM(shrink_close.shrink_4th_orders) + SUM(shrink_close.shrink_5th_orders) + SUM(shrink_close.shrink_6th_orders),
    SUM(shrink_close.forecasted_orders)
  ) AS shrinkage_percentage,  

  SAFE_DIVIDE(
    SUM(shrink_close.shrink_1st_orders) + SUM(shrink_close.shrink_2nd_orders) + SUM(shrink_close.shrink_3rd_orders) + SUM(shrink_close.shrink_4th_orders) + SUM(shrink_close.shrink_5th_orders) + SUM(shrink_close.shrink_6th_orders),
    SUM(shrink_close.forecasted_orders)
  ) AS shrinkage_percentage_exclude_shrink_0,

  SAFE_DIVIDE(
    SUM(shrink_close.shrink_0_orders),
    SUM(shrink_close.forecasted_orders)
  ) AS shrink_0_percentage,

  
  SUM(shrink_close.close_orders) AS close_orders, 
  SAFE_DIVIDE(
    SUM(shrink_close.close_orders), 
    SUM(shrink_close.forecasted_orders)
  ) AS closure_percentage,

FROM daily_shrink_close_events AS shrink_close
LEFT JOIN daily_surge_experience AS surge
ON 
  surge.global_entity_id = shrink_close.global_entity_id
  and surge.lg_country_code = shrink_close.lg_country_code
  and surge.city_name = shrink_close.city_name
  and surge.zone_name = shrink_close.zone_name
  AND surge.created_date_local = shrink_close.date_local
WHERE 
  shrink_close.lg_country_code = &apos;pk&apos;
  AND shrink_close.global_entity_id = &quot;FP_PK&quot;
  GROUP BY 1,2,3,4,5,6,7</relation>
            </properties>
            <properties context='extract'>
              <relation name='_24B5CCF4138E49B78CD80255B096021F' table='[Extract].[_24B5CCF4138E49B78CD80255B096021F]' type='table' />
            </properties>
          </object>
          <object caption='Orders' id='_67313A7385974593A00F15FB1B60DCA4'>
            <properties context=''>
              <relation connection='bigquery.0xby99m1ew4e5n1d5cvqx16ihddn' name='Custom SQL Query' type='text'>SELECT 
pd.global_entity_id,
pd.created_date_local,
vi.vertical,
CASE
  WHEN vi.lg_city IS NULL THEN &quot;N/A&quot;
  ELSE vi.lg_city
END AS lg_city,
CASE
  WHEN vi.lg_zone_name IS NULL THEN &quot;N/A&quot;
  ELSE vi.lg_zone_name
END AS lg_zone_name,
CASE
  WHEN pd.expedition_type = &quot;pickup&quot; THEN &quot;Pickup&quot;
  WHEN pd.expedition_type = &quot;delivery&quot; AND pd.is_own_delivery THEN &quot;OD&quot;
  WHEN pd.expedition_type = &quot;delivery&quot; AND NOT pd.is_own_delivery THEN &quot;VD&quot;
END AS exp_type,
vi.account_type,
vi.lg_region_name,
COUNT(DISTINCT(CASE WHEN pd.is_valid_order THEN pd.code END)) AS valid_orders,
COUNT(DISTINCT(pd.code)) AS gross_orders,
COUNT(DISTINCT(CASE WHEN pd.is_failed_order THEN pd.code END)) AS failed_orders,
COUNT(DISTINCT(CASE WHEN pd.is_failed_order and pd.decline_reason.type = &apos;VENDOR&apos; THEN pd.code END)) AS ven_failed_orders,
COUNT(DISTINCT(CASE WHEN pd.is_failed_order and pd.decline_reason.type = &apos;CUSTOMER&apos; THEN pd.code END)) AS cus_failed_orders,
COUNT(DISTINCT(CASE WHEN pd.is_failed_order and pd.decline_reason.type = &apos;TRAFFIC_MANAGER&apos; THEN pd.code END)) AS log_failed_orders,
COUNT(DISTINCT(CASE WHEN pd.is_valid_order THEN pd.pd_customer_uuid END)) AS valid_customers,
COUNT(DISTINCT(CASE WHEN pd.is_valid_order THEN pd.vendor_code END)) AS active_order_inventory,
SUM(CASE WHEN pd.is_valid_order THEN pd.delivery_time_in_minutes END) AS delivery_time,
SUM(CASE WHEN pd.is_valid_order THEN lg.rider.vendor_late_in_seconds/60 END) AS vendor_late_in_minutes,
COUNT(DISTINCT(CASE WHEN pd.is_valid_order AND dis.is_discount_used THEN pd.code END)) AS valid_dis_orders,
SUM(CASE WHEN pd.is_valid_order AND dis.is_discount_used THEN dis.discount_amount_local END) AS total_discount,
SUM(CASE WHEN pd.is_valid_order THEN pd.total_value_local END) AS user_paid_gmv,
SUM(CASE WHEN pd.is_valid_order AND pd.is_own_delivery THEN deliveries.delivery_distance_in_meters END) AS distance,
COUNT(DISTINCT(CASE WHEN pd.is_valid_order AND pd.is_own_delivery THEN pd.code END)) AS od_valid_orders

FROM `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_lg_orders` AS lg
       ON lg.order_code = pd.code
      AND lg.global_entity_id = pd.global_entity_id
      AND lg.created_date_utc = pd.created_date_utc
LEFT JOIN UNNEST(lg.rider.deliveries) AS deliveries
       ON deliveries.is_primary
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
       ON vi.vendor_code = pd.vendor_code
      AND pd.global_entity_id = &quot;FP_PK&quot;
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_discounts` AS dis
       ON pd.uuid = dis.uuid
      AND pd.global_entity_id = dis.global_entity_id
      AND dis.created_date_utc &gt;&gt;= &quot;2023-01-01&quot; - 10

WHERE pd.created_date_utc &gt;&gt;= &quot;2023-01-01&quot; - 10
AND pd.created_date_local &gt;&gt;= &quot;2023-01-01&quot;
AND pd.global_entity_id = &quot;FP_PK&quot;
AND pd.is_gross_order
AND NOT pd.is_test_order
AND LOWER(vi.vertical) IN (&quot;shared kitchens&quot;, &quot;restaurants&quot;, &quot;concepts&quot;, &quot;home chefs&quot;, &quot;darkstores&quot;, &quot;shops&quot;)

GROUP BY 1, 2, 3, 4, 5, 6, 7, 8</relation>
            </properties>
            <properties context='extract'>
              <relation name='_67313A7385974593A00F15FB1B60DCA4' table='[Extract].[_67313A7385974593A00F15FB1B60DCA4]' type='table' />
            </properties>
          </object>
          <object caption='DLP &amp; DLD' id='_6F274CC170544ED7969656526CE3AF4C'>
            <properties context=''>
              <relation connection='bigquery.0xby99m1ew4e5n1d5cvqx16ihddn' name='Custom SQL Query3' type='text'>SELECT
  dates.date,
  v.vertical,
  CASE
  WHEN v.lg_city IS NULL THEN &quot;N/A&quot;
  ELSE v.lg_city
  END AS lg_city,
  CASE
  WHEN v.lg_zone_name IS NULL THEN &quot;N/A&quot;
  ELSE v.lg_zone_name
  END AS lg_zone_name,
  &quot;OD&quot; AS exp_type,
  v.account_type,
  SUM(products_with_images) AS products_with_images,
  SUM(products_with_description) products_with_description,
  SUM(total_product) AS total_product,

FROM `fulfillment-dwh-production.pandata_curated.shared_dates` AS dates
CROSS JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendorwise_dlp` AS dlp
JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS v
ON dlp.vendor_code = v.vendor_code
WHERE date BETWEEN &quot;2023-01-01&quot; AND CURRENT_DATE (&quot;Asia/Karachi&quot;) -1
AND LOWER(v.vertical) IN (&quot;shared kitchens&quot;, &quot;restaurants&quot;, &quot;concepts&quot;, &quot;home chefs&quot;, &quot;darkstores&quot;, &quot;shops&quot;)

GROUP BY 1, 2, 3, 4, 5, 6</relation>
            </properties>
            <properties context='extract'>
              <relation name='_6F274CC170544ED7969656526CE3AF4C' table='[Extract].[_6F274CC170544ED7969656526CE3AF4C]' type='table' />
            </properties>
          </object>
          <object caption='Rider Working Hour' id='_8ABE5845A1A2466993C30671431B09F2'>
            <properties context=''>
              <relation connection='bigquery.0xby99m1ew4e5n1d5cvqx16ihddn' name='Custom SQL Query6' type='text'>SELECT
created_date_local AS date,
&quot;restaurants&quot; AS vertical,
CASE
  WHEN city_name IS NULL THEN &quot;N/A&quot;
  ELSE city_name
END AS city_name,
CASE
  WHEN zone_name IS NULL THEN &quot;N/A&quot;
  ELSE zone_name
END AS zone_name,
&quot;OD&quot; AS exp_type,
&quot;Accounts&quot; AS account_type,
SUM(working_time/3600) AS evaluated_hours

FROM `fulfillment-dwh-production.curated_data_shared.rider_kpi`

WHERE created_date_local &gt;&gt;= &quot;2023-01-01&quot;
AND country_code = &apos;pk&apos;
AND working_time/3600 &gt;&gt; 0

GROUP BY 1, 2, 3, 4</relation>
            </properties>
            <properties context='extract'>
              <relation name='_8ABE5845A1A2466993C30671431B09F2' table='[Extract].[_8ABE5845A1A2466993C30671431B09F2]' type='table' />
            </properties>
          </object>
          <object caption='Weekly Reorder Rate' id='_A8C084FF2BF1442EBD745F75BDC9F447'>
            <properties context=''>
              <relation connection='bigquery.0xby99m1ew4e5n1d5cvqx16ihddn' name='Custom SQL Query11' type='text'>SELECT
DATE(FORMAT_DATE(&apos;%Y-%m-%d&apos;, PARSE_DATE(&apos;%Y%W&apos;, week_number))) AS week_start,
vi.vertical,
CASE
  WHEN vi.lg_city IS NULL THEN &quot;N/A&quot;
  ELSE vi.lg_city
END AS lg_city,
CASE
  WHEN vi.lg_zone_name IS NULL THEN &quot;N/A&quot;
  ELSE vi.lg_zone_name
END AS lg_zone_name,
&quot;OD&quot; AS exp_type,
vi.account_type,
SUM(unique_customers) AS unique_customers,
SUM(reorder_customers) AS reorder_customers

FROM `fulfillment-dwh-production.pandata_report.country_PK_weekly_vendor_reorder_rate` AS rr
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
ON rr.vendor_code = vi.vendor_code

WHERE DATE(FORMAT_DATE(&apos;%Y-%m-%d&apos;, PARSE_DATE(&apos;%Y%W&apos;, week_number))) &gt;&gt;= &quot;2023-01-01&quot; - 10

GROUP BY 1, 2, 3, 4, 5, 6</relation>
            </properties>
            <properties context='extract'>
              <relation name='_A8C084FF2BF1442EBD745F75BDC9F447' table='[Extract].[_A8C084FF2BF1442EBD745F75BDC9F447]' type='table' />
            </properties>
          </object>
          <object caption='ICPO' id='_AF67C313A7284B31AFFBF04FB3D60FC1'>
            <properties context=''>
              <relation connection='bigquery.0xby99m1ew4e5n1d5cvqx16ihddn' name='Custom SQL Query4' type='text'>SELECT
burn.created_date_local,
burn.vertical,
CASE
  WHEN burn.lg_city IS NULL THEN &quot;N/A&quot;
  ELSE burn.lg_city
END AS city,
CASE
  WHEN burn.lg_zone_name IS NULL THEN &quot;N/A&quot;
  ELSE burn.lg_zone_name
END AS zone_name,
CASE
  WHEN burn.expedition_type = &quot;pickup&quot; THEN &quot;Pickup&quot;
  WHEN burn.expedition_type = &quot;delivery&quot; AND burn.exp_type = &quot;OD&quot; THEN &quot;OD&quot;
  WHEN burn.expedition_type = &quot;delivery&quot; AND burn.exp_type = &quot;VD&quot; THEN &quot;VD&quot;
  ELSE &quot;Others&quot;
END AS delivery_type,
vi.account_type,
SUM(ncp_cashback) AS ncp_cashback,
SUM(non_ncp_cashback) AS non_ncp, 
SUM(mkt_voucher_burn) AS voucher_val,
SUM(subsidy_voucher_burn) AS subsidy_voucher_burn,
SUM(total_orders) AS ICPO_orders

FROM `fulfillment-dwh-production.pandata_report.country_PK_mkt_subsidy_burn` AS burn
LEFT JOIN  `fulfillment-dwh-production.pandata_report.country_PK_mkt_voucher_burn` AS v 
ON burn.vendor_code = v.vendor_code
AND burn.created_date_local = v.voucher_redemption_date
AND burn.expedition_type = v.expedition_type
AND burn.exp_type = v.exp_type
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
ON burn.vendor_code = vi.vendor_code

WHERE burn.created_date_local &gt;&gt;= &quot;2023-01-01&quot;
GROUP BY 1,2,3,4,5,6</relation>
            </properties>
            <properties context='extract'>
              <relation name='_AF67C313A7284B31AFFBF04FB3D60FC1' table='[Extract].[_AF67C313A7284B31AFFBF04FB3D60FC1]' type='table' />
            </properties>
          </object>
          <object caption='Sessions' id='_AF992F46E1FE4A7CAF86C97447559C04'>
            <properties context=''>
              <relation connection='bigquery.0xby99m1ew4e5n1d5cvqx16ihddn' name='Custom SQL Query10' type='text'><![CDATA[WITH sess AS (
SELECT
  ga_sessions.coredata_tracking_session_id || "_" || ga_sessions.global_entity_id || "_" || ga_sessions.partition_date_utc AS uuid,
  ga_sessions.global_entity_id,
  ga_sessions.coredata_tracking_session_id,
  ga_sessions.coredata_tracking_customer_id,

  ga_sessions.lg_city_uuid,
  ga_sessions.lg_city_name,
  ga_sessions.lg_zone_uuid,
  ga_sessions.lg_zone_name,

  ga_sessions.mocvr1,
  ga_sessions.mocvr2,
  ga_sessions.mocvr3,
  ga_sessions.mocvr4,

  ga_sessions.mcvr1,
  ga_sessions.mcvr2,
  ga_sessions.mcvr3,
  ga_sessions.mcvr4,

  ga_sessions.selected_delivery_method,
  ga_sessions.platform,
  ga_sessions.customer_code,
  ga_sessions.funnel,
  ga_sessions.has_order,
  ga_events.has_restaurants,
  ga_events.has_kitchens,
  ga_events.has_home_based_kitchen,
  ga_events.has_concepts,
  ga_events.has_dmart,
  ga_events.has_caterers,
  ga_events.has_shops,

  ga_events.has_restaurants_impression,
  ga_events.has_home_based_kitchen_impression,
  ga_events.has_kitchens_impression,
  ga_events.has_concepts_impression,
  ga_events.has_dmart_impression,
  ga_events.has_caterers_impression,
  ga_events.has_shops_impression,

  ga_sessions.orders_info,

  session_start_date_local,
  session_start_at_local,
  ga_sessions.session_start_date_utc,
  ga_sessions.session_start_at_utc,
  ga_sessions.partition_date_utc
FROM `fulfillment-dwh-production.pandata_report.regional_apac_perseus_sessions_agg_lg_city_zones` AS ga_sessions
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_perseus_agg_business_types` AS ga_events
       ON ga_events.ga_session_id = ga_sessions.coredata_tracking_session_id
      AND ga_events.global_entity_id = ga_sessions.global_entity_id
      AND ga_events.partition_date = ga_sessions.partition_date_utc
WHERE ga_sessions.partition_date_utc >>= "2023-01-01"
  AND ga_sessions.global_entity_id = "FP_PK"),

resto_od AS (
SELECT 
session_start_date_local,
"restaurants" AS vertical,
CASE
  WHEN ga.lg_city_name IS NULL THEN "N/A"
  ELSE ga.lg_city_name
END AS lg_city,
CASE
  WHEN ga.lg_zone_name IS NULL THEN "N/A"
  ELSE ga.lg_zone_name
END AS lg_zone_name,
"OD" AS exp_type,
---resto od---
COUNT(DISTINCT(CASE WHEN ga.has_restaurants_impression THEN ga.coredata_tracking_session_id END)) AS resto_sessions,
COUNT(DISTINCT(CASE WHEN ga.has_restaurants_impression AND vi.vertical = "restaurants" AND ga.has_order THEN ga.coredata_tracking_session_id END)) AS resto_transactions,
COUNT(DISTINCT(CASE WHEN ga.has_restaurants_impression THEN ga.coredata_tracking_customer_id END)) AS resto_sessions_users,

FROM sess AS ga
LEFT JOIN UNNEST(ga.orders_info) AS tr
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
ON LEFT(tr.order_id, 4) = vi.vendor_code

WHERE partition_date_utc <<= CURRENT_DATE("Asia/Karachi")
AND session_start_date_local BETWEEN "2023-01-01" AND CURRENT_DATE("Asia/Karachi") - 3
AND LOWER(ga.selected_delivery_method) LIKE "%delivery%"

GROUP BY 1, 2, 3, 4),

home_chef AS (
SELECT 
session_start_date_local,
"home chefs" AS vertical,
CASE
  WHEN ga.lg_city_name IS NULL THEN "N/A"
  ELSE ga.lg_city_name
END AS lg_city,
CASE
  WHEN ga.lg_zone_name IS NULL THEN "N/A"
  ELSE ga.lg_zone_name
END AS lg_zone_name,
"OD" AS exp_type,
---resto od---
COUNT(DISTINCT(CASE WHEN ga.has_home_based_kitchen_impression THEN ga.coredata_tracking_session_id END)) AS resto_sessions,
COUNT(DISTINCT(CASE WHEN ga.has_home_based_kitchen_impression AND vi.vertical = "home chefs" AND ga.has_order THEN ga.coredata_tracking_session_id END)) AS resto_transactions,
COUNT(DISTINCT(CASE WHEN ga.has_home_based_kitchen_impression THEN ga.coredata_tracking_customer_id END)) AS resto_sessions_users,

FROM sess AS ga
LEFT JOIN UNNEST(ga.orders_info) AS tr
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
ON LEFT(tr.order_id, 4) = vi.vendor_code

WHERE partition_date_utc <<= CURRENT_DATE("Asia/Karachi")
AND session_start_date_local BETWEEN "2023-01-01" AND CURRENT_DATE("Asia/Karachi") - 3
AND LOWER(ga.selected_delivery_method) LIKE "%delivery%"

GROUP BY 1, 2, 3, 4),

shared_kitchens AS (
SELECT 
session_start_date_local,
"shared kitchens" AS vertical,
CASE
  WHEN ga.lg_city_name IS NULL THEN "N/A"
  ELSE ga.lg_city_name
END AS lg_city,
CASE
  WHEN ga.lg_zone_name IS NULL THEN "N/A"
  ELSE ga.lg_zone_name
END AS lg_zone_name,
"OD" AS exp_type,
---resto od---
COUNT(DISTINCT(CASE WHEN ga.has_kitchens_impression THEN ga.coredata_tracking_session_id END)) AS resto_sessions,
COUNT(DISTINCT(CASE WHEN ga.has_kitchens_impression AND vi.vertical = "shared kitchens" AND ga.has_order THEN ga.coredata_tracking_session_id END)) AS resto_transactions,
COUNT(DISTINCT(CASE WHEN ga.has_kitchens_impression THEN ga.coredata_tracking_customer_id END)) AS resto_sessions_users,

FROM sess AS ga
LEFT JOIN UNNEST(ga.orders_info) AS tr
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
ON LEFT(tr.order_id, 4) = vi.vendor_code

WHERE partition_date_utc <<= CURRENT_DATE("Asia/Karachi")
AND session_start_date_local BETWEEN "2023-01-01" AND CURRENT_DATE("Asia/Karachi") - 3
AND LOWER(ga.selected_delivery_method) LIKE "%delivery%"

GROUP BY 1, 2, 3, 4),

concepts AS (
SELECT 
session_start_date_local,
"concepts" AS vertical,
CASE
  WHEN ga.lg_city_name IS NULL THEN "N/A"
  ELSE ga.lg_city_name
END AS lg_city,
CASE
  WHEN ga.lg_zone_name IS NULL THEN "N/A"
  ELSE ga.lg_zone_name
END AS lg_zone_name,
"OD" AS exp_type,
---resto od---
COUNT(DISTINCT(CASE WHEN ga.has_concepts_impression THEN ga.coredata_tracking_session_id END)) AS resto_sessions,
COUNT(DISTINCT(CASE WHEN ga.has_concepts_impression AND vi.vertical = "concepts" AND ga.has_order THEN ga.coredata_tracking_session_id END)) AS resto_transactions,
COUNT(DISTINCT(CASE WHEN ga.has_concepts_impression THEN ga.coredata_tracking_customer_id END)) AS resto_sessions_users,

FROM sess AS ga
LEFT JOIN UNNEST(ga.orders_info) AS tr
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
ON LEFT(tr.order_id, 4) = vi.vendor_code

WHERE partition_date_utc <<= CURRENT_DATE("Asia/Karachi")
AND session_start_date_local BETWEEN "2023-01-01" AND CURRENT_DATE("Asia/Karachi") - 3
AND LOWER(ga.selected_delivery_method) LIKE "%delivery%"

GROUP BY 1, 2, 3, 4),

shops AS (
SELECT 
session_start_date_local,
"shops" AS vertical,
CASE
  WHEN ga.lg_city_name IS NULL THEN "N/A"
  ELSE ga.lg_city_name
