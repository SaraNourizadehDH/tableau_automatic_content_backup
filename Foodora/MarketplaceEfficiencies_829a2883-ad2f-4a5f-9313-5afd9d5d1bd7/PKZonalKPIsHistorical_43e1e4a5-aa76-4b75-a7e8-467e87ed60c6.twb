            <column caption='Surge Orders %age' datatype='real' default-format='p0.0%' name='[Calculation_931963679277297681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([surged_1st_order_experience]) + SUM([surged_2nd_order_experience]) + SUM([surged_3rd_order_experience]) + SUM([surged_4th_order_experience]) + SUM([surged_above_4_order_experience]))/SUM([actual_orders])' />
