      <column caption='Reorder Rate (Weekly)' datatype='real' default-format='p0.00%' name='[Calculation_330451685123485696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reorder_customers])/SUM([unique_customers])' />
