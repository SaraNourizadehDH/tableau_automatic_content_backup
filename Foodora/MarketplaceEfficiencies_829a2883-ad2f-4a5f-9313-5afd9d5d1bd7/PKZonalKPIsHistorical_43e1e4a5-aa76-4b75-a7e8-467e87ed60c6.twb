            <column caption='Overall ICPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_931963679272411146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([ncp_cashback], 0)) + SUM(IFNULL([non_ncp], 0)) + (SUM(IFNULL([subsidy_voucher_burn], 0)))+ (SUM(IFNULL([voucher_val], 0))))/SUM([ICPO_orders])' />
            </column>
            <column caption='Subsidy ICPO' datatype='real' name='[Calculation_931963679272673291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([ncp_cashback], 0)) + SUM(IFNULL([non_ncp], 0)) + (SUM(IFNULL([subsidy_voucher_burn], 0))))/SUM([ICPO_orders])' />
