      <column caption='Date Granularity' datatype='string' name='[Calculation_1915718723554295808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10;when &apos;Day&apos; then str(DATENAME(&apos;month&apos;,[created_date_local])) +str(&apos; &apos;) +str(day([created_date_local])) +str(&apos;, &apos;) +str(DATENAME(&apos;weekday&apos;,[created_date_local]))&#13;&#10;when &apos;Week&apos; then [Calculation_381117178111410178]&#13;&#10;when &apos;Month&apos; then str(DATENAME(&apos;year&apos;,[created_date_local])) + &apos;, &apos; + str(DATENAME(&apos;month&apos;,[created_date_local]))&#13;&#10;END' />
