              <calculation class='tableau' formula='RIGHT(STR([Calculation_381117178111156225]),2) &#13;&#10;            +&quot;-&quot;+&#13;&#10;MID(STR([Calculation_381117178111156225]),6,2)&#13;&#10;            +&quot;-&quot;+&#13;&#10;LEFT(STR([Calculation_381117178111156225]),4)&#13;&#10;&#13;&#10;      +&quot; to &quot;+&#13;&#10;&#13;&#10;RIGHT(STR([Calculation_381117178111156225]+6),2) &#13;&#10;            +&quot;-&quot;+&#13;&#10;MID(STR([Calculation_381117178111156225]+6),6,2)&#13;&#10;            +&quot;-&quot;+&#13;&#10;LEFT(STR([Calculation_381117178111156225]+6),4)' />
            </column>
            <column caption='Overall IC' datatype='real' name='[Calculation_6097733226520322048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([ncp_cashback], 0)) + SUM(IFNULL([non_ncp], 0)) + (SUM(IFNULL([subsidy_voucher_burn], 0)))+ (SUM(IFNULL([voucher_val], 0))))' />
            </column>
            <column caption='Customer Facing Discount Per Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6097733226520788993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_discount])/SUM([valid_orders])' />
            </column>
            <column caption='Customer Fail Rate' datatype='real' name='[Calculation_705376329997545472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cus_failed_orders])/SUM([gross_orders])' />
            </column>
            <column caption='Logistics Fail Rate' datatype='real' name='[Calculation_705376329997774849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([log_failed_orders])/SUM([gross_orders])' />
            </column>
            <column caption='Shrink Orders %age (inc. Shrink 0)' datatype='real' default-format='p0.0%' name='[Calculation_834291865810587649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([shrink_0_orders]) + SUM([shrink_1st_orders]) + SUM([shrink_2nd_orders]) + SUM([shrink_3rd_orders]) + SUM([shrink_4th_orders]) + SUM([shrink_5th_orders]) + SUM([shrink_6th_orders]))/SUM([forecasted_orders])' />
            </column>
            <column caption='Shrink 0 Orders %age' datatype='real' default-format='p0.0%' name='[Calculation_834291865810788354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrink_0_orders])/SUM([forecasted_orders])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_931963679236571136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([gross_orders])' />
            </column>
            <column caption='RPO (Inc. DF)' datatype='real' name='[Calculation_931963679237328897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([commission_revenue]) + SUM([df]))/SUM([billable_orders])' />
            </column>
            <column caption='DF/Order' datatype='real' name='[Calculation_931963679237992450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([df])/SUM([billable_orders])' />
            </column>
            <column caption='Basket Size' datatype='real' name='[Calculation_931963679238463491]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_base])/SUM([billable_orders])' />
            </column>
            <column caption='Service Fee/Order' datatype='real' name='[Calculation_931963679238717444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([service_fee])/SUM([billable_orders])' />
            </column>
            <column caption='Pandabox Revenue/Order' datatype='real' name='[Calculation_931963679242358789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([joker_fee])/SUM([joker_orders])' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_931963679271030790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ven_failed_orders])/SUM([gross_orders])' />
            </column>
            <column caption='Offline Hours %age' datatype='real' name='[Calculation_931963679271428103]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_close_hours])/SUM([total_open_hours])' />
