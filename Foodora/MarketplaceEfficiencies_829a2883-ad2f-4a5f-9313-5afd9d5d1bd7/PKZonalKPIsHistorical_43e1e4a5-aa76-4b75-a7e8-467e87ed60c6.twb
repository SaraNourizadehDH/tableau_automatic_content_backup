UNION ALL
SELECT *, &quot;Pickup&quot; AS exp_type FROM darkstores_pu</relation>
            </properties>
            <properties context='extract'>
              <relation name='_BA6536FA91D24210B2B79697B08772DC' table='[Extract].[_BA6536FA91D24210B2B79697B08772DC]' type='table' />
            </properties>
          </object>
          <object caption='Finance' id='_FF9D9D619F6E45D5BF6A9ED1CC8C8203'>
            <properties context=''>
              <relation connection='bigquery.0xby99m1ew4e5n1d5cvqx16ihddn' name='Custom SQL Query1' type='text'>SELECT 
cb.date_local,
cb.vertical,
CASE
  WHEN cb.lg_city IS NULL THEN &quot;N/A&quot;
  ELSE cb.lg_city
END AS lg_city,
CASE
  WHEN cb.lg_zone_name IS NULL THEN &quot;N/A&quot;
  ELSE cb.lg_zone_name
END AS lg_zone_name,
CASE
  WHEN cb.expedition_type = &quot;pickup&quot; THEN &quot;Pickup&quot;
  WHEN cb.expedition_type = &quot;delivery&quot; AND LOWER(cb.exp_type) LIKE &quot;%%od%&quot; THEN &quot;OD&quot;
  WHEN cb.expedition_type = &quot;delivery&quot; AND LOWER(cb.exp_type) LIKE &quot;%vd%&quot; THEN &quot;VD&quot;
END AS exp_type,
vi.account_type,
COUNT(DISTINCT(cb.order_code)) AS billable_orders,
COUNT(DISTINCT(cb.joker_orders)) AS joker_orders,
SUM(IFNULL(cb.commission_revenue, 0)) AS commission_revenue,
SUM(IFNULL(cb.df_adj_exc_tax, 0)) AS df,
SUM(IFNULL(cb.commission_base, 0)) AS commission_base,
SUM(IFNULL(cb.service_fee_exc_tax, 0)) AS service_fee,
SUM(IFNULL(cb.joker_fee, 0)) AS joker_fee,

FROM `fulfillment-dwh-production.pandata_report.country_PK_finance_cashback_order_level` AS cb
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
ON cb.vendor_code = vi.vendor_code

WHERE cb.date_local &gt;&gt;= &quot;2023-01-01&quot;
AND cb.billable = &quot;Billable&quot;
AND LOWER(cb.vertical) IN (&quot;shared kitchens&quot;, &quot;restaurants&quot;, &quot;concepts&quot;, &quot;home chefs&quot;, &quot;darkstores&quot;, &quot;shops&quot;)

GROUP BY 1, 2, 3, 4, 5, 6</relation>
            </properties>
