          <object caption='NCs &amp; ECs' id='_BA6536FA91D24210B2B79697B08772DC'>
            <properties context=''>
              <relation connection='bigquery.0xby99m1ew4e5n1d5cvqx16ihddn' name='Custom SQL Query5' type='text'>WITH resto_od AS (
SELECT 
  pd.created_date_local,
  CASE
  WHEN vi.lg_city IS NULL THEN &quot;N/A&quot;
  ELSE vi.lg_city
  END AS lg_city,
  CASE
  WHEN vi.lg_zone_name IS NULL THEN &quot;N/A&quot;
  ELSE vi.lg_zone_name
  END AS lg_zone_name,
  &quot;restaurants&quot; AS vertical,
  vi.account_type,
  COUNT(DISTINCT(pd.pd_customer_uuid)) AS active_customers,
  COUNT(DISTINCT(CASE WHEN mc.first_valid_order_all_uuid IS NOT NULL THEN pd.pd_customer_uuid END)) AS new_customers

FROM `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd
LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_mkt_customers_agg_orders_dates` AS mc
       ON pd.uuid = mc.first_valid_order_all_uuid
      AND pd.global_entity_id = mc.global_entity_id
LEFT JOIN `fulfillment-dwh-production.pandata_report.country_PK_vendor_info` AS vi
       ON pd.vendor_code = vi.vendor_code
      AND pd.global_entity_id = &quot;FP_PK&quot;

WHERE pd.created_date_utc &gt;&gt;= &quot;2023-01-01&quot; - 30
  AND pd.created_date_local &gt;&gt;= &quot;2023-01-01&quot;
  AND pd.global_entity_id = &quot;FP_PK&quot;
  AND pd.is_gross_order
  AND NOT pd.is_test_order
  AND pd.is_valid_order
  AND pd.expedition_type = &quot;delivery&quot;
  AND vi.vertical IN (&apos;restaurants&apos;)

GROUP BY 1, 2, 3, 4, 5
),

homechefs AS (
  SELECT 
    pd.created_date_local,
    CASE
    WHEN vi.lg_city IS NULL THEN &quot;N/A&quot;
    ELSE vi.lg_city
    END AS lg_city,
    CASE
    WHEN vi.lg_zone_name IS NULL THEN &quot;N/A&quot;
    ELSE vi.lg_zone_name
    END AS lg_zone_name,
    &apos;home chefs&apos; AS vertical,
    vi.account_type,
    COUNT(DISTINCT(pd.pd_customer_uuid)) AS active_customers,
    COUNT(DISTINCT(CASE WHEN mc.first_valid_order_all_uuid IS NOT NULL THEN pd.pd_customer_uuid END)) AS new_customers

  FROM `fulfillment-dwh-production.pandata_curated.pd_orders` AS pd
