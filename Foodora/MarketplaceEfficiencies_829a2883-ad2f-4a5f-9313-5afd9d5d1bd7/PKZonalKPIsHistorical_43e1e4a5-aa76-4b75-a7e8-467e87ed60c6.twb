  <worksheets>
    <worksheet name='KPIs (Consolidated)'>
      <table>
        <view>
          <datasources>
            <datasource caption='[PK] Zone Data' name='federated.1r7trsq0fs8hp615bzzmb0ufqwoz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1r7trsq0fs8hp615bzzmb0ufqwoz'>
            <column datatype='integer' hidden='true' name='[Billable_orders_ICPO_denominator]' role='measure' type='quantitative' />
            <column caption='Day Name' datatype='string' name='[Calculation_1571474834058539008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [created_date_local])' />
            </column>
            <column caption='Delivery Time/Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1571474834086604807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([delivery_time]))/ZN(SUM([valid_orders]))' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_1915718723554295808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10;when &apos;Day&apos; then str(DATENAME(&apos;month&apos;,[created_date_local])) +str(&apos; &apos;) +str(day([created_date_local])) +str(&apos;, &apos;) +str(DATENAME(&apos;weekday&apos;,[created_date_local]))&#13;&#10;when &apos;Week&apos; then [Calculation_381117178111410178]&#13;&#10;when &apos;Month&apos; then str(DATENAME(&apos;year&apos;,[created_date_local])) + &apos;, &apos; + str(DATENAME(&apos;month&apos;,[created_date_local]))&#13;&#10;END' />
            </column>
            <column caption='Reorder Rate (Weekly)' datatype='real' default-format='p0.00%' name='[Calculation_330451685123485696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reorder_customers])/SUM([unique_customers])' />
            </column>
            <column caption='calc' datatype='boolean' name='[Calculation_376050605873283072]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(&#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [created_date_local]) &lt;  DATETRUNC(&apos;day&apos;, TODAY())&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;OR&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#13;&#10;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [created_date_local]) &lt;  DATETRUNC(&apos;day&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;OR&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY()))&#13;&#10;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [created_date_local]) &lt;  DATETRUNC(&apos;day&apos;, DATEADD(&apos;month&apos;, -2, TODAY()))&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;OR&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -3, TODAY()))&#13;&#10;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [created_date_local]) &lt;  DATETRUNC(&apos;day&apos;, DATEADD(&apos;month&apos;, -3, TODAY()))&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;OR&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -4, TODAY()))&#13;&#10;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [created_date_local]) &lt;  DATETRUNC(&apos;day&apos;, DATEADD(&apos;month&apos;, -4, TODAY()))&#13;&#10;&#13;&#10;)' />
            </column>
            <column caption='Date (Week)' datatype='date' name='[Calculation_381117178111156225]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;iso-week&apos;,[created_date_local]))' />
