      <column caption='calc' datatype='boolean' name='[Calculation_376050605873283072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='(&#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [created_date_local]) &lt;  DATETRUNC(&apos;day&apos;, TODAY())&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;OR&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#13;&#10;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [created_date_local]) &lt;  DATETRUNC(&apos;day&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;OR&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, TODAY()))&#13;&#10;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [created_date_local]) &lt;  DATETRUNC(&apos;day&apos;, DATEADD(&apos;month&apos;, -2, TODAY()))&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;OR&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -3, TODAY()))&#13;&#10;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [created_date_local]) &lt;  DATETRUNC(&apos;day&apos;, DATEADD(&apos;month&apos;, -3, TODAY()))&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;OR&#13;&#10;&#13;&#10; &#13;&#10;&#13;&#10;DATETRUNC(&apos;month&apos;, [created_date_local]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -4, TODAY()))&#13;&#10;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [created_date_local]) &lt;  DATETRUNC(&apos;day&apos;, DATEADD(&apos;month&apos;, -4, TODAY()))&#13;&#10;&#13;&#10;)' />
      </column>
      <column caption='Date (Week)' datatype='date' name='[Calculation_381117178111156225]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;iso-week&apos;,[created_date_local]))' />
      </column>
      <column caption='Date Range' datatype='string' name='[Calculation_381117178111410178]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RIGHT(STR([Calculation_381117178111156225]),2) &#13;&#10;            +&quot;-&quot;+&#13;&#10;MID(STR([Calculation_381117178111156225]),6,2)&#13;&#10;            +&quot;-&quot;+&#13;&#10;LEFT(STR([Calculation_381117178111156225]),4)&#13;&#10;&#13;&#10;      +&quot; to &quot;+&#13;&#10;&#13;&#10;RIGHT(STR([Calculation_381117178111156225]+6),2) &#13;&#10;            +&quot;-&quot;+&#13;&#10;MID(STR([Calculation_381117178111156225]+6),6,2)&#13;&#10;            +&quot;-&quot;+&#13;&#10;LEFT(STR([Calculation_381117178111156225]+6),4)' />
      </column>
      <column caption='Days - DO' datatype='integer' hidden='true' name='[Calculation_592504833079328772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;, [created_date_local]) = DATEPART(&apos;month&apos;, TODAY()) AND DATEPART(&apos;year&apos;, [created_date_local]) = DATEPART(&apos;year&apos;, TODAY())&#13;&#10;THEN DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, [created_date_local]), TODAY())&#13;&#10;ELSE DATEDIFF(&apos;day&apos;, DATETRUNC(&apos;month&apos;, [created_date_local]), DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [created_date_local])))&#13;&#10;END' />
      </column>
