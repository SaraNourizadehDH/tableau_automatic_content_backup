        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0d67jgs0bwo0fb10inei21fu6ftg' name='Custom_SQL_Query' type='text'><![CDATA[WITH primary_zone AS (
  SELECT * 
  FROM(
    SELECT vendor_code, primary_zone_name, lg_primary_zone_id, capture_date,
    RANK() OVER(PARTITION BY vendor_code order by  primary_zone_name) AS rank
    FROM `foodpanda-bd-bigquery.pandata_bd_local.all_vendors_primary_zone_bd`
  ) 
  WHERE rank = 1
),

pd_vendors AS(
  SELECT
  pd_vendors.global_entity_id,
  pd_vendors.vendor_code,
  pd_vendors.name AS vendor_name,
  pd_vendors.chain_code,
  pd_vendors.chain_name,
  pd_vendors_agg_business_types.business_type_apac,
  sf_accounts.owner_name,
  pd_vendors_agg_business_types.is_restaurants,
  pd_vendors_agg_business_types.is_home_based_kitchen,
  pd_vendors.location.latitude,
  pd_vendors.location.longitude,
  FROM `fulfillment-dwh-production.pandata_curated.pd_vendors` AS pd_vendors
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_vendors_agg_business_types` AS pd_vendors_agg_business_types
  ON pd_vendors_agg_business_types.vendor_code = pd_vendors.vendor_code
  AND pd_vendors_agg_business_types.global_entity_id = pd_vendors.global_entity_id 
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.sf_accounts` AS sf_accounts
  ON sf_accounts.vendor_code = pd_vendors.vendor_code
  AND sf_accounts.global_entity_id = pd_vendors.global_entity_id 
  
  WHERE pd_vendors.global_entity_id = 'FP_BD'
),

dates AS(
SELECT DISTINCT date FROM `fulfillment-dwh-production.pandata_curated.shared_dates` 
WHERE date >>= DATE_SUB(CURRENT_DATE(), INTERVAL 60 DAY)
),

drive_time AS(
SELECT dates.date,
historical_value.* EXCEPT (capture_date)
FROM dates
LEFT JOIN `foodpanda-bd-bigquery.pandata_bd_ops.zone_drive_time_and_area_historical_date` AS historical_value
ON dates.date = historical_value.capture_date
),

logistics_city_name AS(
  SELECT
  c.id AS city_id,
  z.id AS zone_id,
  z.name AS zone_name,
  c.name AS city_name,
  z.shape.updated_at_local,
  z.area_in_km_square AS zone_area_in_km_square,
  drive_time.drive_time_in_minutes,
  drive_time.date
  FROM `fulfillment-dwh-production.pandata_curated.lg_countries`, UNNEST(cities) AS c, UNNEST(zones) AS z
  LEFT JOIN drive_time
  ON z.id = drive_time.zone_id
  WHERE global_entity_id = 'FP_BD'
  AND c.is_active
  AND z.is_active
),


cluster_mapping AS(
  SELECT
  logistics_city_name.*,
  city_cluster_mapping.cluster_name
  FROM logistics_city_name
  LEFT JOIN `foodpanda-bd-bigquery.pandata_bd_local.city_cluster_mapping` city_cluster_mapping
  ON logistics_city_name.city_name = city_cluster_mapping.city_name
),

cluster_info AS(
  SELECT
  date,
  cluster_name,
  SUM(zone_area_in_km_square) AS cluster_area_in_KM_square,
  COUNT(DISTINCT CASE WHEN drive_time_in_minutes << 15 THEN zone_id ELSE NULL END) AS Less_then_15_mins_drive_time_zones
  FROM cluster_mapping
  GROUP BY
  cluster_name,
  date
),  

vendor_info AS(
  SELECT
  live.date,
  live.vendor_code,
  pd_vendors.* EXCEPT(vendor_code),
  vm.primary_zone_name,
  logistics_city_name.city_name,
  vm.cluster_name,
  vm.account_type,
  vm.wxyz_class,
  vm.abcd_class,
  live.live_status,
  Gross_orders,
  Successful_orders,
  Offline_percentage,
  live.vendor_closing_reason,
  vm.lg_primary_zone_id,
  zone_area_in_km_square,
  drive_time_in_minutes

  FROM `foodpanda-bd-bigquery.pandata_bd_ops.new_live_closed_vendor_list` AS live
  LEFT JOIN pd_vendors
  ON pd_vendors.vendor_code = live.vendor_code
  LEFT JOIN primary_zone
  ON primary_zone.vendor_code = pd_vendors.vendor_code
  LEFT JOIN logistics_city_name
  ON logistics_city_name.zone_id = primary_zone.lg_primary_zone_id
  AND logistics_city_name.date = live.date
  LEFT JOIN `foodpanda-bd-bigquery.pandata_bd_commerical.all_vendor_mapping_file` AS vm
         ON vm.vendor_code = live.vendor_code
  

  WHERE live.date >>= DATE_SUB(CURRENT_DATE(), INTERVAL 60 DAY)
    AND vm.vendor_code IS NOT NULL
),


cluster_wise_vendor_count AS(
  SELECT
  date,
  primary_zone_name,
  city_name,
  zone_area_in_km_square,
  drive_time_in_minutes,
  COUNT(DISTINCT CASE WHEN live_status = 'Live' THEN vendor_code END) AS live_vendor_count,
  COUNT(vendor_code) AS Active_vendor_count,
  COUNT(DISTINCT CASE WHEN live_status = 'Live' AND business_type_apac = 'restaurants' THEN vendor_code END) AS live_resto_count,
  COUNT(CASE WHEN business_type_apac = 'restaurants' THEN vendor_code END) AS Active_resto_count,
  COUNT(DISTINCT CASE WHEN live_status = 'Live' AND business_type_apac = 'shops'  THEN vendor_code END) AS live_shops_count,
  COUNT(CASE WHEN business_type_apac = 'shops' THEN vendor_code END) AS Active_shops_count,
  SUM(Successful_orders) AS Successful_orders
  FROM vendor_info
  GROUP BY
  primary_zone_name,
  city_name,
  zone_area_in_km_square,
  drive_time_in_minutes,
  date
)


SELECT
cluster_wise_vendor_count.*,
live_vendor_count/zone_area_in_km_square AS live_vendors_per_sq_KM,
Active_vendor_count/zone_area_in_km_square AS active_vendors_per_sq_KM,
live_resto_count/zone_area_in_km_square AS live_rest0_per_sq_KM,
Active_resto_count/zone_area_in_km_square AS active_resto_per_sq_KM,
live_shops_count/zone_area_in_km_square AS live_shops_per_sq_KM,
Active_shops_count/zone_area_in_km_square AS active_shops_per_sq_KM,
FROM cluster_wise_vendor_count]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
