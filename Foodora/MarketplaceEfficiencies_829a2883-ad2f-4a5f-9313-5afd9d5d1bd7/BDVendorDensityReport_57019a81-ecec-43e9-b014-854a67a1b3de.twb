    <datasource caption='Cluster wise Zone Count' inline='true' name='federated.1fgutne1pde43712ykhhb1j0md91' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0rx9thb1jbct2z11scoob08rhzp3'>
            <connection CATALOG='foodpanda-bd-bigquery' EXECCATALOG='foodpanda-bd-bigquery' REDIRECT_URI='urn:ietf:wg:oauth:2.0:oob' SCOPE='email profile https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/cloudplatformprojects.readonly' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='foodpanda-bd-bigquery' schema='datastudio_tableau_background_queries' server='' server-oauth='' username='fahim.anik@foodpanda.com.bd' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0rx9thb1jbct2z11scoob08rhzp3' name='Custom_SQL_Query' type='text'><![CDATA[WITH primary_zone AS (
  SELECT * 
  FROM(
    SELECT vendor_code, primary_zone_name, lg_primary_zone_id,
    RANK() OVER(PARTITION BY vendor_code order by  primary_zone_name) AS rank
    FROM `foodpanda-bd-bigquery.pandata_bd_local.all_vendors_primary_zone_bd` 
    WHERE capture_date = DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
  ) 
  WHERE rank = 1
),

pd_vendors AS(
  SELECT
  pd_vendors.vendor_code,
  pd_vendors.name AS vendor_name,
  pd_vendors.chain_code,
  pd_vendors.chain_name,
  pd_vendors_agg_business_types.business_type_apac,
  sf_accounts.owner_name,
  pd_vendors_agg_business_types.is_restaurants,
  pd_vendors_agg_business_types.is_home_based_kitchen,
  FROM `fulfillment-dwh-production.pandata_curated.pd_vendors` AS pd_vendors
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_vendors_agg_business_types` AS pd_vendors_agg_business_types
  ON pd_vendors_agg_business_types.vendor_code = pd_vendors.vendor_code
  AND pd_vendors_agg_business_types.global_entity_id = pd_vendors.global_entity_id 
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.sf_accounts` AS sf_accounts
  ON sf_accounts.vendor_code = pd_vendors.vendor_code
  AND sf_accounts.global_entity_id = pd_vendors.global_entity_id 
  
  WHERE pd_vendors.global_entity_id = 'FP_BD'
),

logistics_city_name AS(
  SELECT
  c.id AS city_id,
  z.id AS zone_id,
  z.name AS zone_name,
  c.name AS city_name,
  z.shape.geo
  FROM `fulfillment-dwh-production.pandata_curated.lg_countries` , UNNEST(cities) AS c, UNNEST(zones) AS z
  WHERE global_entity_id = 'FP_BD'
  AND c.is_active
  AND z.is_active
),


Zone_wise_live_vendors AS(
SELECT
live.date,
primary_zone.primary_zone_name,
logistics_city_name.city_name,
city_cluster_mapping.cluster_name,
primary_zone.lg_primary_zone_id,
COUNT(CASE WHEN live_status = 'Live' THEN live.vendor_code END) AS live_vendors,
COUNT(live.vendor_code) AS Active_vendors,
SAFE_DIVIDE(COUNT(CASE WHEN live_status = 'Live' THEN live.vendor_code END),COUNT(live.vendor_code)) AS live_vendor_percentage

FROM `foodpanda-bd-bigquery.pandata_bd_ops.new_live_closed_vendor_list` AS live
LEFT JOIN pd_vendors
ON pd_vendors.vendor_code = live.vendor_code
LEFT JOIN primary_zone
ON primary_zone.vendor_code = pd_vendors.vendor_code
LEFT JOIN logistics_city_name
ON logistics_city_name.zone_id = primary_zone.lg_primary_zone_id
LEFT JOIN `foodpanda-bd-bigquery.pandata_bd_commerical.kam_accounts` AS KAM
ON KAM.account_owner = pd_vendors.owner_name
LEFT JOIN `foodpanda-bd-bigquery.pandata_bd_local.city_cluster_mapping` city_cluster_mapping
ON logistics_city_name.city_name = city_cluster_mapping.city_name
LEFT JOIN `foodpanda-bd-bigquery.pandata_bd_commerical.last_3_month_zone_wise_gmv_class_wxyz` AS wx
ON pd_vendors.vendor_code = wx.vendor_code
LEFT JOIN `fulfillment-dwh-production.pandata_report.vendor_gmv_class` AS ab
ON pd_vendors.vendor_code = ab.vendor_code
AND ab.global_entity_id = 'FP_BD'
LEFT JOIN `foodpanda-bd-bigquery.pandata_bd_commerical.all_vendor_mapping_file` AS vm
       ON live.vendor_code = vm.vendor_code
WHERE vm.vendor_code IS NOT NULL

GROUP BY
live.date,
primary_zone.primary_zone_name,
logistics_city_name.city_name,
city_cluster_mapping.cluster_name,
lg_primary_zone_id
)


SELECT
date,
cluster_name,
(CASE
WHEN live_vendor_percentage << .1 THEN '0%-10%'
WHEN live_vendor_percentage >>= .1 AND live_vendor_percentage <<.2 THEN '10%-20%'
WHEN live_vendor_percentage >>= .2 AND live_vendor_percentage <<.3 THEN '20%-30%'
WHEN live_vendor_percentage >>= .3 AND live_vendor_percentage <<.4 THEN '30%-40%'
WHEN live_vendor_percentage >>= .4 AND live_vendor_percentage <<.5 THEN '40%-50%'
WHEN live_vendor_percentage >>= .5 AND live_vendor_percentage <<.6 THEN '50%-60%'
WHEN live_vendor_percentage >>= .6 AND live_vendor_percentage <<.7 THEN '60%-70%'
WHEN live_vendor_percentage >>= .7 AND live_vendor_percentage <<.8 THEN '70%-80%'
WHEN live_vendor_percentage >>= .8 THEN '80% or Above%'
END) AS Live_vendor_percentage_bucketing,
COUNT(DISTINCT lg_primary_zone_id) AS Zone_count

FROM Zone_wise_live_vendors

GROUP BY
date,
cluster_name,
(CASE
WHEN live_vendor_percentage << .1 THEN '0%-10%'
WHEN live_vendor_percentage >>= .1 AND live_vendor_percentage <<.2 THEN '10%-20%'
WHEN live_vendor_percentage >>= .2 AND live_vendor_percentage <<.3 THEN '20%-30%'
WHEN live_vendor_percentage >>= .3 AND live_vendor_percentage <<.4 THEN '30%-40%'
WHEN live_vendor_percentage >>= .4 AND live_vendor_percentage <<.5 THEN '40%-50%'
WHEN live_vendor_percentage >>= .5 AND live_vendor_percentage <<.6 THEN '50%-60%'
WHEN live_vendor_percentage >>= .6 AND live_vendor_percentage <<.7 THEN '60%-70%'
WHEN live_vendor_percentage >>= .7 AND live_vendor_percentage <<.8 THEN '70%-80%'
WHEN live_vendor_percentage >>= .8 THEN '80% or Above%'
END)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
