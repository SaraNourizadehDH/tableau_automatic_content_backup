            <connection CATALOG='foodpanda-bd-bigquery' EXECCATALOG='foodpanda-bd-bigquery' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='foodpanda-bd-bigquery' schema='pandata_bd_local' server-oauth='' username='fahim.anik@foodpanda.com.bd' workgroup-auth-mode='prompt' />
          </named-connection>
