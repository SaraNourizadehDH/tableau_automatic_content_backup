        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1ncfr940xud1zj13tzram0bhir7t' name='Custom_SQL_Query' type='text'>WITH primary_zone AS (&#13;
  SELECT * &#13;
  FROM(&#13;
    SELECT vendor_code, primary_zone_name, lg_primary_zone_id,&#13;
    RANK() OVER(PARTITION BY vendor_code order by  primary_zone_name) AS rank&#13;
    FROM `foodpanda-bd-bigquery.pandata_bd_local.all_vendors_primary_zone_bd` &#13;
  ) &#13;
  WHERE rank = 1&#13;
),&#13;
&#13;
pd_vendors AS(&#13;
  SELECT&#13;
  pd_vendors.vendor_code,&#13;
  pd_vendors.name AS vendor_name,&#13;
  pd_vendors.chain_code,&#13;
  pd_vendors.chain_name,&#13;
  pd_vendors_agg_business_types.business_type_apac,&#13;
  sf_accounts.owner_name,&#13;
  pd_vendors_agg_business_types.is_restaurants,&#13;
  pd_vendors_agg_business_types.is_home_based_kitchen,&#13;
  pd_vendors.location.latitude,&#13;
  pd_vendors.location.longitude,&#13;
  FROM `fulfillment-dwh-production.pandata_curated.pd_vendors` AS pd_vendors&#13;
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_vendors_agg_business_types` AS pd_vendors_agg_business_types&#13;
  ON pd_vendors_agg_business_types.vendor_code = pd_vendors.vendor_code&#13;
  AND pd_vendors_agg_business_types.global_entity_id = pd_vendors.global_entity_id &#13;
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.sf_accounts` AS sf_accounts&#13;
  ON sf_accounts.vendor_code = pd_vendors.vendor_code&#13;
  AND sf_accounts.global_entity_id = pd_vendors.global_entity_id &#13;
  &#13;
  WHERE pd_vendors.global_entity_id = &apos;FP_BD&apos;&#13;
),&#13;
&#13;
logistics_city_name AS(&#13;
  SELECT&#13;
  c.id AS city_id,&#13;
  z.id AS zone_id,&#13;
  z.name AS zone_name,&#13;
  c.name AS city_name,&#13;
  z.shape.geo&#13;
  FROM `fulfillment-dwh-production.pandata_curated.lg_countries` , UNNEST(cities) AS c, UNNEST(zones) AS z&#13;
  WHERE global_entity_id = &apos;FP_BD&apos;&#13;
  AND c.is_active&#13;
  AND z.is_active&#13;
)&#13;
&#13;
SELECT&#13;
live.date,&#13;
live.vendor_code,&#13;
pd_vendors.* EXCEPT(vendor_code),&#13;
primary_zone.primary_zone_name,&#13;
logistics_city_name.city_name,&#13;
vm.cluster_name,&#13;
vm.account_type,&#13;
(CASE WHEN vm.wxyz_class IS NULL THEN &apos;-&apos; ELSE vm.wxyz_class END) AS wxyz_class,&#13;
vm.abcd_class,&#13;
live.live_status,&#13;
Gross_orders,&#13;
Successful_orders,&#13;
Offline_percentage,&#13;
live.vendor_closing_reason,&#13;
vm.lg_primary_zone_id&#13;
&#13;
FROM `foodpanda-bd-bigquery.pandata_bd_ops.new_live_closed_vendor_list` AS live&#13;
LEFT JOIN pd_vendors&#13;
ON pd_vendors.vendor_code = live.vendor_code&#13;
LEFT JOIN primary_zone&#13;
ON primary_zone.vendor_code = pd_vendors.vendor_code&#13;
LEFT JOIN logistics_city_name&#13;
ON logistics_city_name.zone_id = primary_zone.lg_primary_zone_id&#13;
LEFT JOIN `foodpanda-bd-bigquery.pandata_bd_commerical.all_vendor_mapping_file` AS vm&#13;
       ON vm.vendor_code = live.vendor_code&#13;
&#13;
WHERE date = DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
