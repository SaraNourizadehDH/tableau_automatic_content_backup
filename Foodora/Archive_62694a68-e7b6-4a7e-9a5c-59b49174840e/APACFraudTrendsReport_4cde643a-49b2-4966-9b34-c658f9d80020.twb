            </column>
            <column caption='Metric Choice' datatype='real' datatype-customized='true' default-format='N' name='[Calculation_5348306071213785095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &quot;Order Count&quot; THEN SUM([Calculation_5348306071213617158])&#10;  WHEN &quot;Customer Count&quot; THEN SUM([Calculation_5348306071210024964])&#10;  WHEN &quot;Total Fraud Value Eur&quot; THEN ROUND(SUM([total_fraud_value_eur]), 2)&#10;  WHEN &quot;CPO (LOD)&quot; THEN ROUND([CPO (LOD) (copy)_6959679945827540993], 6)&#10;END' />
            </column>
            <column caption='Gross Order Count (LOD)' datatype='integer' name='[Gross Order Count (LOD Refund Type) (copy)_5348306071236378640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [refund_type], [order_level_partial_refund], [l1_rfm], [fraud_type], [decline_reason_code], [order_status]:&#10;SUM({ FIXED [ordered_date_local], [global_entity_id], [aas_range], &#10;    [account_age_range], [vertical_type], [customer_dh_profit_quantile],&#10;    [customer_l30d_avg_total_value_local_per_order_quantile], [payment_type], [platform],&#10;    [customer_l30d_valid_order_count_range], [email_risk_score_range]&#10;     : SUM([gross_order_count])})}' />
