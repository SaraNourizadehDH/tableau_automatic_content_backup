      </column>
      <column caption='Date Range' datatype='date' name='[Calculation_6959679945884852229]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;  WHEN &quot;Last 2 Weeks&quot; THEN IF [ordered_date_local] &gt; DATEADD(&quot;day&quot;, -14, {MAX([ordered_date_local])}) THEN [ordered_date_local] END&#10;  WHEN &quot;All Dates&quot; THEN [ordered_date_local]&#10;END' />
