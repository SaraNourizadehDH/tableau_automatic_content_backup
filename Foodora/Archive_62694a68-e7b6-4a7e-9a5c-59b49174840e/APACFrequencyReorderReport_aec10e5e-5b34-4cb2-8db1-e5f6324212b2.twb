            <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [class]&#13;&#10; WHEN &apos;Weekly&apos; THEN [Calculation_456271002456002578]&#13;&#10; WHEN &apos;Monthly&apos; THEN [Calculation_456271002455613457]&#10; WHEN &apos;Daily&apos; THEN [Calculation_456271002456092691]&#13;&#10;END' />
            </column>
            <column caption='KPI' datatype='string' name='[Calculation_73746477910888457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
            </column>
            <column caption='Customer Count' datatype='integer' name='[Order Count (copy)_73746477904539653]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;All Order&apos; THEN [all_order_customer_count]&#10;WHEN &apos;Gross Order&apos; THEN [gross_order_customer_count]&#10;WHEN &apos;Valid Order&apos; THEN [valid_order_customer_count]&#10;WHEN &apos;Non Gross Order&apos; THEN [non_gross_order_customer_count]&#10;END' />
