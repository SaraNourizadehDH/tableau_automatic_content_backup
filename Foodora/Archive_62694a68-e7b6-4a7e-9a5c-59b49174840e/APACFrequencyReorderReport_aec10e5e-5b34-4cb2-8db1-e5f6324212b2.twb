      <aliases enabled='yes' />
      <column caption='AVG. Basket Value eur' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_144326326985756672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([total_gmv_eur])) / ZN(SUM([customer_initial_count]))' />
      </column>
      <column caption='% Customer with incident' datatype='real' default-format='p0.00%' name='[Calculation_144326326987554818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([incident_customers])) / ZN(SUM([customer_initial_count]))' />
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_144326326988718084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([total_order_count])) / ZN(SUM([customer_initial_count]))' />
      </column>
      <column caption='KPI' datatype='real' name='[Calculation_144326326989549573]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Frequency&apos; THEN [Calculation_144326326988718084]&#10;WHEN &apos;Reorder Rate %&apos; THEN [Calculation_59883832947773440]&#10;WHEN &apos;Reorder Rate % with voucher&apos; THEN [Reorder Rate % (copy)_144326326988177411]&#10;WHEN &apos;AVG. Basket Value eur&apos; THEN [Calculation_144326326985756672]&#10;WHEN &apos;% Customer with incident&apos; THEN [Calculation_144326326987554818]&#10;END' />
      </column>
      <column caption='KPI Filter' datatype='string' name='[Calculation_144326326991024134]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_1824802341321637898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([report_month]) &lt; 10 then str(YEAR([report_month])) + &quot;-0&quot; + str(month([report_month]))&#13;&#10;ELSE str(YEAR([report_month])) + &quot;-&quot; + str(month([report_month]))&#13;&#10;END' />
      </column>
      <column caption='Reorder Rate %' datatype='real' default-format='p0.00%' name='[Calculation_59883832947773440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([customer_order])) / ZN(SUM([customer_initial_count]))' />
      </column>
      <column caption='Quarter' datatype='string' name='[Calculation_59883832948940801]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Q&apos; + STR(QUARTER([report_month]))' />
      </column>
      <column caption='Year' datatype='string' name='[Calculation_59883832949145603]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([report_month]))' />
      </column>
      <column caption='Month ' datatype='string' name='[Calculation_59883832949325828]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATENAME(&apos;month&apos;,[report_month]))' />
      </column>
      <column caption='Relevant time period' datatype='boolean' name='[Calculation_59883832953036805]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(DATEADD(&apos;month&apos;, -10, TODAY()) &lt; [report_month] AND Month([report_month]) != month(DATEADD(&apos;month&apos;, -1, TODAY())) AND month(TODAY()) != month([report_month]), true, false)' />
      </column>
      <column caption='Reorder Rate % with voucher' datatype='real' default-format='p0.00%' name='[Reorder Rate % (copy)_144326326988177411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([customer_order_voc])) / ZN(SUM([customer_initial_count_voc]))' />
      </column>
