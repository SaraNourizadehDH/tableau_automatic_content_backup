      <column caption='CPO' datatype='real' default-format='n#,##0.00000;-#,##0.00000' name='[Calculation_6948491326829998080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_compensation_euro])/SUM([total_orders])' />
      </column>
      <column caption='Spend Delta' datatype='real' datatype-customized='true' default-format='n#,##0;-#,##0' name='[Calculation_6948491326832201729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([target_total_compensation]) - SUM([forecasted_total_compensation])' />
      </column>
      <column caption='Delta %' datatype='real' default-format='p0%' name='[Calculation_6948491326838779906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6948491326832201729]/AVG([target_total_compensation])' />
      </column>
      <column caption='Delta CPO %' datatype='real' default-format='p0.0%' name='[Calculation_6948491326840029187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - ([Calculation_6948491326829998080]/AVG([target_cpo]))' />
      </column>
      <column caption='month.' datatype='boolean' name='[Calculation_6948491326941741060]' role='dimension' type='nominal'>
