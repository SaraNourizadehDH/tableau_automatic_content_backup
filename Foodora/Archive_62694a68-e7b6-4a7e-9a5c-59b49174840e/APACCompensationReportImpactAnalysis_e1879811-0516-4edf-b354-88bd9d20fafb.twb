            <column caption='Count Passive After 30' datatype='integer' name='[count_passive_after_30]' role='measure' type='quantitative' />
            <column caption='Count Promotor After 30' datatype='integer' name='[count_promotor_after_30]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
