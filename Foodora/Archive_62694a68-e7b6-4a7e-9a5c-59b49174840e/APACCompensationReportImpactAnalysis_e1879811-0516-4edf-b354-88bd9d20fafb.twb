          <calculation class='tableau' formula='IF [Compensation Category (copy)_1860549615602868224] != &apos;Cancellation.&apos; AND [Compensation Category (copy)_1860549615602868224] != &apos;Delay.&apos;&#13;&#10;AND [compensation_category] != &apos;PD-OTP Delay.&apos;&#13;&#10; THEN [Compensation Category (copy)_1860549615602868224] END' />
