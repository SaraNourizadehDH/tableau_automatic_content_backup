    <worksheet name='proactive reorder peak'>
      <table>
        <view>
          <datasources>
            <datasource caption='Compensation Budget Proactive (pandata_report)' name='federated.0g97zx31f827p715itlmg1d5wvqs' />
          </datasources>
          <datasource-dependencies datasource='federated.0g97zx31f827p715itlmg1d5wvqs'>
            <column caption='Voucher Given Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2349823522559979521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([after_order_count_30_voucher_given])/SUM([voucher_given_customers]))' />
            </column>
            <column caption='Month.' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_month]) &lt; 10 then str(YEAR([report_month])) + &quot;-0&quot; + str(month([report_month]))&#13;&#10;ELSE str(YEAR([report_month])) + &quot;-&quot; + str(month([report_month]))&#13;&#10;END' />
            </column>
            <column caption='Redemption Rate' datatype='real' default-format='p0.0%' name='[Calculation_4662351562989592576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(Sum([redeemed_voucher_count_30days])/ SUM([created_voucher_count]))' />
            </column>
            <column caption='Voucher Given Reorder Rate' datatype='real' default-format='p0.0%' name='[Calculation_4662351563156488193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([reorder_30_count_voucher_given])/SUM([count_of_customers_voucher_given]))' />
            </column>
            <column caption='ABV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4662351563158503427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([after_order_gmv_eur_30])/SUM([after_order_count_30]))' />
            </column>
            <column caption='Created Avg Voucher Value ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4662351563208687620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([created_voucher_value_eur])/SUM([created_voucher_count]))' />
            </column>
            <column caption='Used Avg Voucher Value' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4662351563208896517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([used_voucher_value_eur])/SUM([used_voucher_count]))' />
            </column>
            <column caption='Delta Reoder Rate' datatype='real' default-format='p0.0%' name='[Calculation_4662351563213135878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4662351563156488193] - [Voucher Given Reorder Rate (copy)_4662351563156717570]' />
            </column>
            <column caption='Delta Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4662351563213291527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2349823522559979521] - [Voucher Given Frequency (copy)_2349823522560290818]' />
            </column>
            <column caption='% Over ABV' datatype='real' default-format='p0.0%' name='[Calculation_4662351563213803528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_4662351563208896517]/[Calculation_4662351563158503427])' />
            </column>
            <column caption='used_voucher_count1' datatype='integer' name='[Calculation_4662351563216277514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([used_voucher_count])' />
            </column>
            <column caption='income' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4662351563216588811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4662351563213291527]*[Calculation_4662351563216277514]*[Calculation_4662351563158503427]*0.2' />
            </column>
            <column caption='Expense' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4662351563219542028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4662351563208896517] * [Calculation_4662351563216277514]' />
            </column>
            <column caption='Profit' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4662351563220029453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4662351563216588811] - [Calculation_4662351563219542028]' />
            </column>
            <column caption='ROI' datatype='real' default-format='p0.00%' name='[Calculation_4662351563220566030]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4662351563216588811]/([Calculation_4662351563219542028] - 1)' />
            </column>
            <column caption='Voucher Not Given Frequency ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Voucher Given Frequency (copy)_2349823522560290818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([after_order_count_30_voucher_not_given])/SUM([voucher_not_given_customers]))' />
            </column>
            <column caption='Voucher Not Given Reorder Rate' datatype='real' default-format='p0.0%' name='[Voucher Given Reorder Rate (copy)_4662351563156717570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([reorder_30_count_voucher_not_given])/SUM([count_of_customers_voucher_not_given]))' />
            </column>
            <column caption='After Order Count 30' datatype='integer' name='[after_order_count_30]' role='measure' type='quantitative' />
            <column caption='After Order Count 30 Voucher Given' datatype='integer' name='[after_order_count_30_voucher_given]' role='measure' type='quantitative' />
            <column caption='After Order Count 30 Voucher Not Given' datatype='integer' name='[after_order_count_30_voucher_not_given]' role='measure' type='quantitative' />
            <column caption='After Order Gmv Eur 30' datatype='real' name='[after_order_gmv_eur_30]' role='measure' type='quantitative' />
            <column caption='Compensation Category' datatype='string' name='[compensation_category]' role='dimension' type='nominal' />
            <column caption='Count Of Customers Voucher Given' datatype='integer' name='[count_of_customers_voucher_given]' role='measure' type='quantitative' />
            <column caption='Count Of Customers Voucher Not Given' datatype='integer' name='[count_of_customers_voucher_not_given]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Created Voucher Count' datatype='integer' name='[created_voucher_count]' role='measure' type='quantitative' />
