      <aliases enabled='yes' />
      <column caption='ABV Local' datatype='real' name='[AFV Euro (copy)_3567062034719903748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([gmv_local]))/SUM(ZN([accounting_orders_count]))' />
      </column>
      <column caption='Avg Used Voucher Value Local' datatype='real' name='[Avg Used Voucher Value Euro (copy)_3567062034719576066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([redeemed_voucher_value_local]))/SUM(ZN([redeemed_voucher_count]))' />
      </column>
      <column caption='Week (string)' datatype='string' name='[Calculation_1769351764308762625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if WEEK([report_date]) = 1 and YEAR([report_date]) = 2019 then &quot;2020-W01&quot;&#13;&#10;ELSEIF WEEK([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-W0&quot; + str(WEEK([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-W&quot; + str(WEEK([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Month (string)' datatype='string' name='[Calculation_1769351764309393410]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
      </column>
      <column caption='DATE' datatype='string' name='[Calculation_1769351764312887301]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [class]&#10; when &apos;Weekly&apos; then [Calculation_1769351764308762625]&#10; when &apos;Monthly&apos; then [Calculation_1769351764309393410]&#10;end' />
      </column>
      <column caption='Avg Used Voucher Value Euro' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3567062034719354881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([redeemed_voucher_value_eur]))/SUM(ZN([redeemed_voucher_count]))' />
      </column>
      <column caption='ABV Euro' datatype='real' name='[Calculation_3567062034719698947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([gmv_eur]))/SUM(ZN([accounting_orders_count]))' />
      </column>
      <column caption='Compensation As % of ABV' datatype='real' default-format='p0.00%' name='[Calculation_3567062034727813125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3567062034719354881]/[Calculation_3567062034719698947]' />
      </column>
      <column caption='local' datatype='real' name='[Calculation_3567062034761572358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Avg Used Voucher Value Euro (copy)_3567062034719576066]/[AFV Euro (copy)_3567062034719903748]' />
      </column>
