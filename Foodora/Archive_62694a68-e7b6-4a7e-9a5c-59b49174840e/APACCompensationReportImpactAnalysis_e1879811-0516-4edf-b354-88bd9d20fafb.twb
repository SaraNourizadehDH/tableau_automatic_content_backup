    <worksheet name='Benchmark Summery 30 Days'>
      <table>
        <view>
          <datasources>
            <datasource caption='Compensation Impact Matrix (pandata_report)' name='federated.0azx7fe157ykl314y7p651dgdg61' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Impect KPI Based on: ' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Δ&quot;'>
              <calculation class='tableau' formula='&quot;Δ&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0azx7fe157ykl314y7p651dgdg61'>
            <column caption='AVG After Order Time 30 Days' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AVG After Order ABV 30 Days (copy)_916482528077766692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([after_order_time_30] )/24)/&#13;&#10;SUM(ZN([after_order_count_30] ))' />
            </column>
            <column caption='AVG Before Order Count 30 Days' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AVG After Order Count 30 Days (copy)_916482528056221721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([before_order_count_30]))/&#13;&#10;SUM(ZN([count_of_customers]))' />
            </column>
            <column caption='AVG After Order ABV 30 Days' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AVG After Order Count 30 Days (copy)_916482528066748449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([after_order_gmv_eur_30] ))/&#13;&#10;SUM(ZN([after_order_count_30] ))' />
            </column>
            <column caption='AVG After NPS % 30 Days' datatype='real' default-format='p0.00%' name='[AVG Before NPS % 30 Days (copy)_546624412226826243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(ZN([count_promotor_after_30] ))-&#13;&#10; SUM(ZN([count_detractor_after_30] )))/&#13;&#10;(SUM(ZN([count_promotor_after_30] ))+&#13;&#10; SUM(ZN([count_detractor_after_30] ))+&#13;&#10; SUM(ZN([count_passive_after_30] )))' />
            </column>
            <column caption='AVG Before Order Time 30 Days' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AVG Before Order ABV 30 Days (copy)_916482528077766694]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([before_order_time_30] )/24)/&#13;&#10;SUM(ZN([before_order_count_30] ))' />
            </column>
            <column caption='AVG Before Order ABV 30 Days' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AVG Before Order Count 30 Days (copy)_916482528066748447]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([before_order_gmv_eur_30] ))/&#13;&#10;SUM(ZN([before_order_count_30] ))' />
            </column>
            <column caption='Date Frame' datatype='datetime' name='[Calculation_1224134677903568896]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, 30, [report_date])' />
            </column>
            <column caption='After KPI Days Complete' datatype='boolean' name='[Calculation_1224134677906747394]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1224134677903568896] &lt; TODAY() THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Month (string)' datatype='string' name='[Calculation_1769351764309393410]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1769351764312887301]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1769351764309393410]' />
            </column>
            <column caption='AVG Before NPS % 30 Days' datatype='real' default-format='p0.00%' name='[Calculation_546624412226138112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(ZN([count_promotor_before_30] ))-&#13;&#10; SUM(ZN([count_detractor_before_30] )))/&#13;&#10;(SUM(ZN([count_promotor_before_30] ))+&#13;&#10; SUM(ZN([count_detractor_before_30] ))+&#13;&#10; SUM(ZN([count_passive_before_30] )))' />
            </column>
            <column caption=' After NPS Respondents 30 Days' datatype='integer' name='[Calculation_546624412243972106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([count_detractor_after_30] ))+&#13;&#10;SUM(ZN([count_passive_after_30] ))+&#13;&#10;SUM(ZN([count_promotor_after_30]))' />
            </column>
            <column caption='Proactive Category' datatype='string' name='[Calculation_916482527988269056]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Compensation Category (copy)_1860549615602868224] &#10;WHEN &apos;Cancellation.&apos; THEN [Compensation Category (copy)_1860549615602868224] &#10;WHEN &apos;Post-Delivery Delay.&apos; THEN [Compensation Category (copy)_1860549615602868224]&#10;WHEN &apos;Pre-Delivery Delay.&apos; THEN [Compensation Category (copy)_1860549615602868224]&#10;END' />
            </column>
            <column caption='AVG After Order Count 30 Days' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_916482528054644758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([after_order_count_30] ))/&#13;&#10;SUM(ZN([count_of_customers] ))' />
            </column>
            <column caption='Δ Order Count 30 Days %' datatype='real' default-format='p0.00%' name='[Calculation_916482528059023386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-([AVG After Order Count 30 Days (copy)_916482528056221721]/[Calculation_916482528054644758])' />
            </column>
            <column caption='Impect KPI Based on Filter' datatype='string' name='[Calculation_916482528060936220]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
            </column>
            <column caption='Compensation Category.' datatype='string' name='[Compensation Category (copy)_1860549615602868224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [compensation_category] = &apos;Customer account&apos; THEN &apos;Customer Account&apos;&#10;ELSEIF [compensation_category] = &apos;Food issue&apos; THEN &apos;Food Issue&apos;&#10;ELSEIF [compensation_category] = &apos;Information request&apos; THEN &apos;Information Request&apos;&#10;ELSEIF [compensation_category] = &apos;Cancellations.&apos; THEN &apos;Cancellations.&apos;&#10;ELSEIF [compensation_category] = &apos;PD-OTP Delay.&apos; THEN &apos;Pre-Delivery Delay.&apos;&#10;ELSEIF [compensation_category] = &apos;Delay.&apos; THEN &apos;Post-Delivery Delay.&apos;&#10;ELSE [compensation_category]&#10;END' />
