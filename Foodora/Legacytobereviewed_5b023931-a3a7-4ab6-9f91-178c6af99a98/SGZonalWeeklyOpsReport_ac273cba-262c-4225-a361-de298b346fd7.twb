        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1tktd1o06defoq1cyrv7f0zi37vh' name='Custom SQL Query' type='text'><![CDATA[WITH seamless_orders AS (
SELECT 
  ordered_at_date_local,
  vertical_type,
  order_code,
  is_valid_order,
  is_failed_order,
  is_seamless_order,
  is_non_seamless_order,

FROM `fulfillment-dwh-production.pandata_report.regional_apac_cx_seamless_order`
WHERE global_entity_id = "FP_SG"
  AND ordered_at_date_local >>= CURRENT_DATE()-50
  AND ordered_at_date_local <<= CURRENT_DATE()
  AND is_gross_order IS TRUE
  AND vertical_type NOT IN ("kitchens", "concepts")
)

,contacts AS (
  SELECT 
        order_id AS ticket_order_code,
        creation_timestamp AS contact_created_at_utc,
        contact_id,
        contact_reason_l1 AS ccr1,
        contact_reason_l2 AS ccr2,
        contact_reason_l3 AS ccr3,
        local_contact_reason AS lcr,
        global_cr_code,

  FROM `fulfillment-dwh-production.curated_data_shared.all_contacts`
  WHERE LOWER(stakeholder) LIKE "%customer%"
        AND global_entity_id = "FP_SG"
        AND DATE(created_date) >>= DATE_SUB(CURRENT_DATE(), INTERVAL 7 WEEK)
        AND order_id IS NOT NULL
        AND contact_reason_l3 IN ("Complain about late order","Request: order is late, does not want to wait","Delayed delivery","Wrong order","Food quality","Food temperature","Spilled food","Order marked as delivered but didn't receive")
)

,automations AS (
      SELECT DISTINCT
            a.order_id AS order_code,
            a.event_id,
            a.automation_type,
            cs.ccr3 AS auto_ccr3,
            a.session_id,
            a.page_id,

      FROM `fulfillment-dwh-production.curated_data_shared.helpcenter_automations_v2` a
      LEFT JOIN (SELECT DISTINCT ccr3, global_cr_code FROM contacts) cs
            ON a.contact_reason_level_3 = cs.global_cr_code
      WHERE a.global_entity_id = "FP_SG"
      AND a.created_date >>= DATE_SUB(CURRENT_DATE(), INTERVAL 7 WEEK)
      AND a.is_automation IS TRUE
      AND a.order_id IS NOT NULL
),


zone AS (
SELECT DISTINCT order_code,
zone_name
FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_order_performance`
WHERE created_date_local >> "2024-01-27"
AND created_date_utc >> DATE_SUB(CURRENT_DATE(), INTERVAL 8 WEEK)
AND lg_country_code = "sg"
--AND zone_name = "Bukit timah"

)

,base AS (
        SELECT DISTINCT
                po.ordered_at_date_local,
                po.code AS order_code,
                po.is_failed_order,
                po.decline_reason.code AS cancellation_reason,
                po.decline_reason.type_with_post_delivery AS cancellation_source,
                s.order_code AS order_code2,
                s.is_seamless_order,
                c.ccr3,
                a.auto_ccr3,
                c.contact_id,
                a.event_id,
                z.zone_name


        FROM `fulfillment-dwh-production.pandata_curated.pd_orders` po
        LEFT JOIN seamless_orders s
                ON po.code = s.order_code
        LEFT JOIN contacts c
                ON po.code = c.ticket_order_code
        LEFT JOIN automations a
                ON po.code = a.order_code

        LEFT JOIN zone z
                ON po.code = z.order_code
        WHERE po.created_date_utc >>= DATE_SUB(CURRENT_DATE(), INTERVAL 7 WEEK)
        AND po.ordered_at_date_local >>= CURRENT_DATE()-50
        AND po.ordered_at_date_local <<= CURRENT_DATE()
        AND po.is_gross_order = TRUE
        AND po.global_entity_id = "FP_SG"
        AND po.is_own_delivery = TRUE
        AND po.is_pickup = FALSE
        AND po.is_preorder = FALSE
       -- AND z.zone_name = "Bukit timah"
)

SELECT
ordered_at_date_local AS report_date,
FORMAT_DATE('%a',DATE(ordered_at_date_local)) as day,
zone_name,
    COUNT(DISTINCT CASE WHEN is_seamless_order IS TRUE THEN order_code2 END) AS seamless_orders_perc,
    (COUNT(DISTINCT CASE WHEN ccr3 = "Complain about late order" THEN contact_id END) + COUNT(DISTINCT CASE WHEN auto_ccr3 = "Complain about late order" THEN event_id END)) AS complain_about_late_order_IO,
    COUNT(DISTINCT CASE WHEN ccr3 = "Request: order is late, does not want to wait" THEN contact_id END) AS complain_about_late_order_canc_req_IO,
    COUNT(DISTINCT CASE WHEN ccr3 = "Order marked as delivered but didn't receive" THEN contact_id END) AS OMAD_IO,
    COUNT(DISTINCT CASE WHEN ccr3 = "Delayed delivery" THEN contact_id END) AS delayed_delivery_PD_IO,
    COUNT(DISTINCT CASE WHEN ccr3 = "Wrong order" THEN contact_id END) AS wrong_order_IO,
    COUNT(DISTINCT CASE WHEN ccr3 = "Food quality" THEN contact_id END) AS food_quality_IO,
    COUNT(DISTINCT CASE WHEN ccr3 = "Food temperature" THEN contact_id END) AS food_temperature_IO,
    COUNT(DISTINCT CASE WHEN ccr3 = "Spilled food" THEN contact_id END) AS spilled_food_IO,

    COUNT(DISTINCT order_code2) AS orders2,
    COUNT(DISTINCT order_code) AS orders

FROM base
WHERE ordered_at_date_local << CURRENT_DATE()
AND ordered_at_date_local >>= date_sub(date_trunc(current_date(), WEEK(Monday)), INTERVAL 6 WEEK)
GROUP BY 1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
