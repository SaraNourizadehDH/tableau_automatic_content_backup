&#13;
FROM `fulfillment-dwh-production.curated_data_shared.rider_kpi` , UNNEST(deliveries) as d&#13;
WHERE country_code = &quot;sg&quot;&#13;
AND created_date_local &gt;&gt;= date_sub(date_trunc(current_date(), WEEK(Monday)), INTERVAL 6 WEEK)&#13;
