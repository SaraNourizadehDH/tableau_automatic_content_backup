      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Singapore&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_302076C2B50D41DA93176844207535EE'>
            <properties context=''>
              <relation connection='bigquery.0jp4kai1abrx9g170833z0qghppy' name='Custom SQL Query' type='text'><![CDATA[WITH staffing AS (

SELECT 
report_date,
zone_name,
SUM(evaluated_working_hours) AS EH,
SAFE_DIVIDE(SUM(assigned_shifts_hours),SUM(opened_shifts_hours)) AS fill_rate,
SUM(assigned_shifts_hours) AS assigned_shift_hrs,
SUM(opened_shifts_hours) AS open_shift_hrs

FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_rider_staffing`
WHERE global_entity_id = "FP_SG"
AND report_date >> "2024-01-01"
GROUP BY 1,2
ORDER BY 1),

zone AS (
SELECT 
created_date_local,
zone_name,
order_code

FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_order_performance` 
WHERE created_date_utc >>= date_sub(date_trunc(current_date, isoweek), interval 10 week)
AND global_entity_id = "FP_SG"
),

oot AS (
SELECT 
ordered_at_date_local as report_date,
z.zone_name,
COUNTIF (is_order_not_on_time IS FALSE) AS oot_n,
COUNTIF (is_order_not_on_time_late IS TRUE) AS orders_late,
COUNTIF (is_order_not_on_time_early IS TRUE) AS orders_early,
COUNT (DISTINCT c.order_code) as oot_d

FROM `fulfillment-dwh-production.pandata_report.regional_apac_cx_seamless_order` AS c
LEFT JOIN zone AS z ON z.order_code = c.order_code
WHERE ordered_at_date_local  >>= date_sub(date_trunc(current_date, isoweek), interval 10 week)
and global_entity_id = 'FP_SG'
GROUP BY 1,2
ORDER BY 1 DESC)

SELECT
report_date,
FORMAT_DATE('%a',report_date) as day,
DATE_TRUNC(report_date, MONTH) as Month,
DATE_TRUNC(report_date, ISOWEEK) AS Isoweek,
-- business_type_apac,
-- vehicle_bag as vehicle,
zone_name,
SUM(orders_completed) AS orders,
SUM(orders_cancelled) AS failed_orders,
SUM(dt_mins_n) AS DT_n,
SUM(dt_mins_d) AS DT_d,
SUM(vendor_late_10_mins_n) AS vendor_late_10,
SUM(vendor_late_mins_d) AS vendor_late_d,
-- SUM(order_on_time_n) AS oot_n,
-- SUM(order_late_5_mins_n) AS orders_late_5,
-- SUM(order_early_15_mins_n) AS orders_early_15,
-- SUM(order_delays_d) AS oot_d,
AVG(o.oot_n) AS oot_n,
AVG(o.orders_early) AS orders_early,
AVG(o.orders_late) AS orders_late,
AVG(o.oot_d) AS oot_d,
SUM(stacked_deliveries) AS stack_n,
SUM(deliveries_completed) AS stack_d,
AVG(s.EH) AS hours,
AVG(assigned_shift_hrs) AS assigned_hrs,
AVG(open_shift_hrs) AS open_shift_hrs

FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_performance` as p
LEFT JOIN staffing AS s USING (report_date, zone_name)
LEFT JOIN oot AS o USING (report_date, zone_name)

WHERE p.global_entity_id = "FP_SG"
AND p.report_date >>= date_sub(date_trunc(current_date(), WEEK(Monday)), INTERVAL 6 WEEK)
AND  p.report_date << CURRENT_DATE()
AND zone_name IS NOT NULL
GROUP BY 1,2,3,4, 5
ORDER BY 1 DESC]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
