    <worksheet name='Eval Hours'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Eval Hours</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Ops Metrics' name='federated.1916g3s0o09p6e19lycji0qi4flz' />
          </datasources>
          <datasource-dependencies datasource='federated.1916g3s0o09p6e19lycji0qi4flz'>
            <column datatype='string' name='[day]' role='dimension' type='nominal' />
            <column-instance column='[hours]' derivation='Sum' name='[diff:sum:hours:qk:1]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-field='[federated.1916g3s0o09p6e19lycji0qi4flz].[iwk:report_date:ok]' ordering-type='Field' type='Difference'>
                <address>
                  <value>-1</value>
                </address>
              </table-calc>
