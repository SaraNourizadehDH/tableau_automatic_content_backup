      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Singapore&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_532210097350499BB33C2804277AAA44'>
            <properties context=''>
              <relation connection='bigquery.0z8pmae1t1i9381ewxvhy0if4yy4' name='Custom SQL Query' type='text'><![CDATA[WITH all_zones AS (

  SELECT

    zones.name AS zone_name,
    zones.id AS lg_zone_id,

  FROM `fulfillment-dwh-production.curated_data_shared.countries` c,
  UNNEST(c.cities) city,
  UNNEST(city.zones) zones

  WHERE LOWER(country_code) = 'sg'
    AND zones.is_active = TRUE
    AND LOWER(zones.name) NOT LIKE '%dmart%'
    AND zones.has_default_delivery_area_settings = TRUE

),

zone_stats AS (

  SELECT DISTINCT

    lg.zone_id,
    a.zone_name,
    CAST(ROUND(stats.mean_delay, 2) AS FLOAT64) AS mean_delay,
    TIMESTAMP(DATETIME_TRUNC(DATETIME(TIMESTAMP(created_at), "Asia/Singapore"), MINUTE)) AS local_timestamp,

  FROM `fulfillment-dwh-production.curated_data_shared.zone_stats` lg, UNNEST(lg.stats) stats

  LEFT JOIN all_zones a
    ON lg.zone_id = a.lg_zone_id

  WHERE lg.created_date BETWEEN DATE_SUB(CURRENT_DATE() + 1, INTERVAL 2 MONTH) AND (CURRENT_DATE() + 1)
    AND DATE(TIMESTAMP(stats.created_at), "Asia/Singapore") >>= DATE_SUB(date_trunc(current_date(), WEEK(Monday)), INTERVAL 6 WEEK)
    AND LOWER(lg.country_code) = "sg"
    AND zone_name IS NOT NULL
  ORDER BY local_timestamp, zone_name

),

min_max AS (

  SELECT

    zone_name,
    MIN(TIMESTAMP(local_timestamp)) min_dt,
    MAX(TIMESTAMP(local_timestamp)) max_dt

  FROM zone_stats
  GROUP BY 1

),

all_timestamps AS (

  SELECT

    zone_name,
    local_timestamp

  FROM min_max,
  UNNEST(GENERATE_TIMESTAMP_ARRAY(min_dt, max_dt, INTERVAL 1 MINUTE)) local_timestamp

),

all_stats AS (

  SELECT
    DATE(a.local_timestamp) AS created_date_local,
    a.zone_name,
    a.local_timestamp,
    FORMAT_TIME("%R", TIME(a.local_timestamp)) AS time_local,
    EXTRACT(HOUR FROM a.local_timestamp) hour,
    EXTRACT(minute FROM a.local_timestamp) minute,
    LAST_VALUE(z.mean_delay IGNORE NULLS) OVER (PARTITION BY a.zone_name ORDER BY a.local_timestamp) mean_delay,

  FROM all_timestamps a
  LEFT JOIN zone_stats z
    ON a.local_timestamp = TIMESTAMP(z.local_timestamp)
    AND a.zone_name = z.zone_name

  ORDER BY zone_name, local_timestamp

),

mean_delay_stats AS (

  SELECT

    zone_name,
    date_array,

    CASE
      WHEN delay_start = 0 THEN 0
      ELSE delay_start + 0.01
    END AS mean_delay_start,

    delay_end AS mean_delay_end,
    surge_event,

  FROM `fulfillment-dwh-production.pandata_report.country_SG_zonal_surge_logs`  surge

  JOIN UNNEST(GENERATE_DATE_ARRAY(active_from, active_to, INTERVAL 1 DAY)) AS date_array

  WHERE zone_name IS NOT NULL
    --AND date_array = CURRENT_DATE() - 1

    QUALIFY ROW_NUMBER() OVER(PARTITION BY date_array,zone_name, surge_event) = 1

),

min_surge AS (

  SELECT DISTINCT

    f1.zone_name,

  FROM mean_delay_stats f1
  WHERE f1.zone_name IS NOT NULL
  GROUP BY 1

),

min_mean_delay_stats AS (

  SELECT DISTINCT

    f1.zone_name,
    f2.surge_event,

  FROM min_surge f1
  LEFT JOIN mean_delay_stats f2
    ON f1.zone_name = f2.zone_name

),

max_surge AS (

  SELECT DISTINCT

    f1.zone_name,
    MAX(f1.mean_delay_end) AS max_mean_delay_end,

  FROM mean_delay_stats f1
  WHERE f1.zone_name IS NOT NULL
  GROUP BY 1

),

max_mean_delay_stats AS (

  SELECT DISTINCT

    f1.zone_name,
    f2.surge_event,
    f1.max_mean_delay_end

  FROM max_surge f1
  LEFT JOIN mean_delay_stats f2
    ON f1.zone_name = f2.zone_name

),

combined_zone_stats AS (

  SELECT

    a.*,
    CASE
      WHEN a.mean_delay << -1 THEN md.surge_event
      WHEN a.mean_delay >> maxd.max_mean_delay_end THEN maxd.surge_event
      ELSE m.surge_event
    END AS surge_event

  FROM all_stats a

  LEFT JOIN mean_delay_stats m
    ON a.zone_name = m.zone_name
    AND a.mean_delay BETWEEN m.mean_delay_start AND m.mean_delay_end
    AND a.created_date_local = m.date_array

  LEFT JOIN min_mean_delay_stats md
    ON a.zone_name = md.zone_name

  LEFT JOIN max_mean_delay_stats maxd
    ON a.zone_name = maxd.zone_name
  ORDER BY a.zone_name, a.local_timestamp DESC

),

order_hourly AS (

  SELECT DISTINCT

    DATE(DATE_ADD(d.rider_dropped_off_at, INTERVAL 8 HOUR)) AS date,
    DATE(DATE_ADD(order_placed_at, INTERVAL 8 HOUR)) AS date_local,
    EXTRACT(HOUR FROM DATE_ADD(order_placed_at, INTERVAL 8 HOUR)) hour_local,
    EXTRACT(MINUTE FROM DATE_ADD(order_placed_at, INTERVAL 8 HOUR)) minute_local,
    CONCAT(CASE WHEN EXTRACT(HOUR FROM DATE_ADD(order_placed_at, INTERVAL 8 HOUR)) <<= 9 THEN CONCAT('0',CAST(EXTRACT(HOUR FROM DATE_ADD(order_placed_at, INTERVAL 8 HOUR))AS STRING))
      ELSE CAST(EXTRACT(HOUR FROM DATE_ADD(order_placed_at, INTERVAL 8 HOUR)) AS STRING)
    END,
    CAST((CASE WHEN EXTRACT(MINUTE FROM DATE_ADD(order_placed_at, INTERVAL 8 HOUR)) << 30 THEN ':00' ELSE ':30'
        END) AS STRING)) AS hour,
    dz.zone_name as zones, -- zone_name
    ord.platform_order_code AS code,
    ROUND(ST_DISTANCE(customer.location, vendor.location) *0.27099000389865546/60,2) travel_time,
    delivery_fee_original_local / (o.delivery_fee_vat_rate/100+1) AS delivery_fee_original_local,

    CASE
      WHEN sb.is_free_delivery_subscription_order IS TRUE THEN 'pandapro'
      WHEN v1.type = 'free_delivery' THEN 'voucher_discount'
      WHEN d1.discount_type = 'free_delivery' THEN 'voucher_discount'
      WHEN b.business_type_apac = 'restaurants' AND o.delivery_fee_local = 0.99 THEN '99c_campaign'
      WHEN b.business_type_apac = 'restaurants' AND o.delivery_fee_local IN (0.93, 0.92) THEN '99c_campaign'
      ELSE 'nil'
    END type_of_delivery,

  FROM `fulfillment-dwh-production.curated_data_shared.orders`  ord,
  UNNEST (ord.deliveries) d

  LEFT JOIN `fulfillment-dwh-production.pandata_curated.pd_orders`  o
    ON o.code = ord.platform_order_code
    AND o.global_entity_id = 'FP_SG'

  LEFT JOIN all_zones dz
    ON ord.zone_id = dz.lg_zone_id

  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` b
    ON b.uuid = o.pd_vendor_uuid
    AND b.global_entity_id = o.global_entity_id
    AND b.global_entity_id = "FP_SG"

  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_vouchers`  v1
    ON o.uuid = v1.uuid
    AND o.global_entity_id = v1.global_entity_id
    AND v1.global_entity_id = "FP_SG"
    AND v1.created_date_utc BETWEEN DATE_SUB(CURRENT_DATE() + 1, INTERVAL 2 MONTH) AND (CURRENT_DATE() + 1)

  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_discounts` d1
    ON o.uuid = d1.uuid
    AND o.global_entity_id = d1.global_entity_id
    AND d1.global_entity_id = "FP_SG"
    AND d1.created_date_utc BETWEEN DATE_SUB(CURRENT_DATE() + 1, INTERVAL 2 MONTH) AND (CURRENT_DATE() + 1)

  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_orders_agg_sb_subscriptions` sb
    ON o.uuid = sb.uuid
    AND o.global_entity_id = sb.global_entity_id
    AND sb.global_entity_id = "FP_SG"
    AND sb.created_date_utc BETWEEN DATE_SUB(CURRENT_DATE() + 1, INTERVAL 2 MONTH) AND (CURRENT_DATE() + 1)

  WHERE LOWER(ord.country_code) = 'sg'
    AND o.created_date_utc BETWEEN DATE_SUB(CURRENT_DATE() + 1, INTERVAL 2 MONTH) AND CURRENT_DATE() + 1
    AND ord.created_date BETWEEN DATE_SUB(CURRENT_DATE() + 1, INTERVAL 2 MONTH) AND CURRENT_DATE() + 1
    AND ord.customer.location IS NOT NULL
    AND ord.vendor.location IS NOT NULL
    AND o.is_valid_order = TRUE
    AND is_delivery = TRUE
    AND ord.vendor.vertical_type = 'restaurants'
    AND DATE(DATE_ADD(d.rider_dropped_off_at, INTERVAL 8 HOUR)) >>= DATE_SUB(date_trunc(current_date(), WEEK(Monday)), INTERVAL 6 WEEK)

),

all_orders AS (

  SELECT DISTINCT

    code,
    date,
    type_of_delivery,
    -- CASE
    --   WHEN DATE_DIFF(CURRENT_DATE() + 1, date, DAY) = 1 THEN '1. yesterday'
    -- END AS date_,
    o.hour,
    zones,
    delivery_fee_original_local,
    travel_time,
    c.surge_event AS surge_type

  FROM order_hourly o
  LEFT JOIN combined_zone_stats c
    ON o.date_local = c.created_date_local
    AND o.hour_local = c.hour
    AND o.minute_local = c.minute
    AND o.zones = c.zone_name

)

SELECT

date,
FORMAT_DATE('%a',date) as day,
  hour,
  zones,
  surge_type,
  type_of_delivery,
  COUNT(DISTINCT code) order_count,
  ROUND(AVG(delivery_fee_original_local), 2) avg_df,

FROM all_orders
WHERE date << current_date()
GROUP BY 1,2,3,4,5,6
ORDER BY 1]]></relation>
            </properties>
