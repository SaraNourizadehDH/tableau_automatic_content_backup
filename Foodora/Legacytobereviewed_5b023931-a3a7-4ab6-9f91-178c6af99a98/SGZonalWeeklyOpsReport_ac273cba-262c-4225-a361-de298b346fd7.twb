        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0jp4kai1abrx9g170833z0qghppy'>
            <connection CATALOG='foodpanda-sg-bigquery' EXECCATALOG='logistics-sg-cloud-4435' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='APAC Country - SG' schema='ops_sg' server-oauth='' username='poojaa.velusamy@foodpanda.sg' workgroup-auth-mode='prompt' />
          </named-connection>
