        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1rc1w461vesucq1bcf58h0kjmsrc' name='Custom SQL Query' type='text'><![CDATA[SELECT
report_date,
DATE_TRUNC(report_date, MONTH) as Month,
DATE_TRUNC(report_date, ISOWEEK) AS Isoweek,
-- business_type_apac,
-- vehicle_bag as vehicle,
zone_name,
SUM(orders_completed) AS orders,
SUM(delivery_distance_cleaned_n) AS p_d_n,
SUM(delivery_distance_cleaned_d) AS p_d_d,
SUM(dropoff_distance_manhattan_cleaned_n) AS do_n,
SUM(dropoff_distance_manhattan_cleaned_d) AS do_d


FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_performance` as p

WHERE p.global_entity_id = "FP_SG"
AND p.report_date >>= date_sub(current_date(), INTERVAL 15 DAY)
AND  p.report_date << CURRENT_DATE()
AND zone_name IS NOT NULL
GROUP BY 1,2,3,4
ORDER BY 1 DESC]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
