            <format attr='text-format' field='[federated.0mdhclp19yl5z41fxpoh41uocslk].[usr:Calculation_825284638256721920:qk]' value='n#,##0.00;-#,##0.00' />
            <format attr='width' field='[federated.0mdhclp19yl5z41fxpoh41uocslk].[:Measure Names]' value='61' />
