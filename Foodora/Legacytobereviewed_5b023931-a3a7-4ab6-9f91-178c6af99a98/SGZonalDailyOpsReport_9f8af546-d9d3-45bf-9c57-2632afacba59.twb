        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0eujtdq1i8q7ko16nkyed0wenvm1' name='Custom SQL Query' type='text'><![CDATA[SELECT
created_date_local,
batch_number,
vehicle_name,
zone_name,
SUM(d.actual_rider_accepted) AS accept,
SUM(d.manual_undispatched) AS undispatch,
SUM(d.actual_rider_notified) AS notified


FROM `fulfillment-dwh-production.curated_data_shared.rider_kpi` , UNNEST(deliveries) as d
WHERE country_code = "sg"
AND created_date_local >>= date_sub(current_date(), INTERVAL 8 DAY)
AND created_date_local << current_date()
GROUP BY 1,2,3,4]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0eujtdq1i8q7ko16nkyed0wenvm1' name='Custom SQL Query' type='text'><![CDATA[SELECT
