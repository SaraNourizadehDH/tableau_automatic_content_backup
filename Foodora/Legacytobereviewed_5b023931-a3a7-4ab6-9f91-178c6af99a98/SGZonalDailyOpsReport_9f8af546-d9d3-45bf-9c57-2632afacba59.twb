      <table>
        <view>
          <datasources>
            <datasource caption='Order Count (2)' name='federated.0mdhclp19yl5z41fxpoh41uocslk' />
          </datasources>
          <datasource-dependencies datasource='federated.0mdhclp19yl5z41fxpoh41uocslk'>
            <column caption='DO' datatype='real' name='[Calculation_825284638256721920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([do_n])/SUM([do_d])' />
            </column>
            <column caption='p-d' datatype='real' name='[Calculation_840765785851817987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[p_d_n]/[p_d_d]' />
            </column>
            <column caption='Previous p-d' datatype='real' name='[Previous week orders (copy)_840765785851928580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP(SUM([Calculation_840765785851817987]),-7)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='WoW% (p-d)' datatype='real' name='[WoW% (copy)_840765785852055557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(([p-d (copy)_22799506323980290])-([Previous week orders (copy)_840765785851928580]))/[Previous week orders (copy)_840765785851928580]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
