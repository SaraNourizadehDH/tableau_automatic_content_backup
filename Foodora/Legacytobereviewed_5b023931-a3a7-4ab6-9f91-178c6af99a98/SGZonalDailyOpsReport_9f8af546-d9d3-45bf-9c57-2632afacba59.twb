            <encodings>
              <color column='[federated.0mdhclp19yl5z41fxpoh41uocslk].[usr:Calculation_825284638256721920:qk]' />
              <text column='[federated.0mdhclp19yl5z41fxpoh41uocslk].[Multiple Values]' />
