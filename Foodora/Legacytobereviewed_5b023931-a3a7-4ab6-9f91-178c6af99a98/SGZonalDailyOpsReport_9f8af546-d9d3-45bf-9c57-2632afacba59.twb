      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_070A48DB0A0841C38DECA4CCC1CE7268'>
            <properties context=''>
              <relation connection='bigquery.1umkev400wsb5a12krv9i0otky50' name='Custom SQL Query' type='text'><![CDATA[with starting_points AS
  (SELECT -1 as all_, s.id, s.name AS starting_point_name, zones.name AS zone_name, zones.id as zone_id
FROM `fulfillment-dwh-production.curated_data_shared.countries` AS cc, UNNEST(cc.cities) AS cities, UNNEST(cities.zones) AS zones, UNNEST(zones.starting_points) AS s
WHERE country_code = 'sg'
AND s.is_active = TRUE)

SELECT
DISTINCT
s.zone_name,
DATE(d.created_at, "Asia/Singapore") AS report_date,
FORMAT_DATE('%a',DATE(d.created_at, "Asia/Singapore")) as day,
SUM(d.dropoff_distance_google) AS do_google_dist,
COUNT(DISTINCT d.delivery_id) AS order_count

FROM `fulfillment-dwh-production.curated_data_shared.rider_payment_delivery_distance_service` AS d
LEFT JOIN starting_points s
ON d.starting_point_id = s.id

WHERE DATE(d.created_at, "Asia/Singapore")  >>= date_sub(current_date(), INTERVAL 8 DAY)
AND  DATE(d.created_at, "Asia/Singapore")  << CURRENT_DATE()
AND d.created_date >>= date_sub(current_date(), INTERVAL 8 DAY)-2
AND LOWER(country_code) = 'sg'
AND d.delivery_status = 'COMPLETED'

GROUP BY 1,2,3]]></relation>
