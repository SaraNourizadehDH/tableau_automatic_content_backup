    <datasource caption='Fail_rate RTO' inline='true' name='federated.0bam4b51pdiaiu1935jbn08ucgvi' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1c5m5gt0b2704d11stekm0gvwas6'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhub-data-commune' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_datamart' server-oauth='' username='jawad.afzaal@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1c5m5gt0b2704d11stekm0gvwas6' name='Custom SQL Query' type='text'>SELECT
  global_entity_id,
  FORMAT_DATE(&apos;%m-%d-%Y %A&apos;, created_date_local) AS created_date_local,
  DATETIME_TRUNC(created_at_local, HOUR) AS created_hour,
  ROUND(
    100 * SAFE_DIVIDE(
      SUM(CASE WHEN is_failed_order THEN 1 ELSE 0 END),
      SUM(CASE WHEN is_gross_order THEN 1 ELSE 0 END)
    ), 
    2
  ) AS fail_rate
FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders`
WHERE created_date_local &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH)
  AND global_entity_id = &quot;FP_SG&quot;
GROUP BY global_entity_id, created_date_local, created_hour
ORDER BY global_entity_id, created_date_local, created_hour</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1c5m5gt0b2704d11stekm0gvwas6' name='Custom SQL Query' type='text'>SELECT
  global_entity_id,
  FORMAT_DATE(&apos;%m-%d-%Y %A&apos;, created_date_local) AS created_date_local,
  DATETIME_TRUNC(created_at_local, HOUR) AS created_hour,
  ROUND(
    100 * SAFE_DIVIDE(
      SUM(CASE WHEN is_failed_order THEN 1 ELSE 0 END),
      SUM(CASE WHEN is_gross_order THEN 1 ELSE 0 END)
    ), 
    2
  ) AS fail_rate
FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders`
WHERE created_date_local &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH)
  AND global_entity_id = &quot;FP_SG&quot;
GROUP BY global_entity_id, created_date_local, created_hour
ORDER BY global_entity_id, created_date_local, created_hour</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
