      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_DC0D4C4156ED42DAA0DDB3722E7C0EB2'>
            <properties context=''>
              <relation connection='bigquery.1c5m5gt0b2704d11stekm0gvwas6' name='Custom SQL Query' type='text'>SELECT
  global_entity_id,
  FORMAT_DATE(&apos;%m-%d-%Y %A&apos;, created_date_local) AS created_date_local,
  DATETIME_TRUNC(created_at_local, HOUR) AS created_hour,
  ROUND(
    100 * SAFE_DIVIDE(
      SUM(CASE WHEN is_failed_order THEN 1 ELSE 0 END),
      SUM(CASE WHEN is_gross_order THEN 1 ELSE 0 END)
    ), 
    2
  ) AS fail_rate
FROM `fulfillment-dwh-production.pandata_datamart.pandora__agg_orders`
WHERE created_date_local &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH)
  AND global_entity_id = &quot;FP_SG&quot;
GROUP BY global_entity_id, created_date_local, created_hour
ORDER BY global_entity_id, created_date_local, created_hour</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
