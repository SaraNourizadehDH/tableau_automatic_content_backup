      <table>
        <view>
          <datasources>
            <datasource caption='AR Hourly Graph' name='federated.0jyvq4w1gyc1iv1et98jj0hegg66' />
            <datasource caption='AR MU Transitions' name='federated.1gejnnl1hosedr1a370ei0jooc4m' />
          </datasources>
          <datasource-dependencies datasource='federated.0jyvq4w1gyc1iv1et98jj0hegg66'>
            <column caption='Net Acceptance Rate' datatype='real' name='[Calculation_1939925543173230611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([accepted_count],0)) &#10;- SUM(IFNULL([mu_dispatcher_after_accepted_count],0)) &#10;- SUM(IFNULL([mu_dispatcher_after_near_pu_count],0))&#10;- SUM(IFNULL([mu_ice_after_accepted_count],0))&#10;- SUM(IFNULL([mu_ice_after_near_pu_count],0))&#10;)&#10;/ SUM(IFNULL([notified_count],0))' />
            </column>
            <column caption='MU (Dispatcher) after accepted rate' datatype='real' name='[Calculation_1939925543176855576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([mu_dispatcher_after_accepted_count],0))/ SUM(IFNULL([notified_count],0))' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_1939925543178276892]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;APAC&apos;' />
              <aliases>
                <alias key='&quot;APAC&quot;' value='Pandora' />
              </aliases>
            </column>
            <column caption='MU (Dispatcher) after near pu rate' datatype='real' name='[MU (Dispatcher) after accepted rate (copy)_1939925543176912921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([mu_dispatcher_after_near_pu_count],0))/ SUM(IFNULL([notified_count],0))' />
            </column>
            <column caption='MU (ICE) after accepted rate' datatype='real' name='[MU (Dispatcher) after accepted rate (copy)_1939925543176966170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([mu_ice_after_accepted_count],0))/ SUM(IFNULL([notified_count],0))' />
            </column>
            <column caption='MU (ICE) after near pu rate' datatype='real' name='[MU (ICE) after accepted rate (copy)_1939925543177039899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([mu_ice_after_near_pu_count],0))/ SUM(IFNULL([notified_count],0))' />
            </column>
            <column datatype='integer' name='[accepted_count]' role='measure' type='quantitative' />
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
