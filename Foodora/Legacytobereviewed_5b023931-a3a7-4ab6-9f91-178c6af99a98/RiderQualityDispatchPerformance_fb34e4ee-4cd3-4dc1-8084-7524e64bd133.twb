      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_10E4F7DFC14D43B1A4A0609C2537C44B'>
            <properties context=''>
              <relation connection='bigquery.121bj931mwxr381c8n3qs1jx31bq' name='Custom SQL Query' type='text'><![CDATA[SELECT
  global_entity_id,
  country_name,
  lg_entity_id,
  lg_city_id,
  city_name,
  lg_zone_id,
  zone_name,
  notified_week,
  notified_weekday,
  notified_hour,
  SUM(CASE WHEN transition_state = 'courier_notified' THEN transition_count END) AS notified_count,
  SUM(CASE WHEN transition_state = 'accepted' THEN transition_count END) AS accepted_count,
  SUM(CASE 
    WHEN previous_transition_state = 'accepted' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'dispatcher' 
      THEN transition_count 
    END
  ) AS mu_dispatcher_after_accepted_count,
  SUM(CASE 
    WHEN previous_transition_state = 'near_pickup' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'dispatcher' 
      THEN transition_count 
    END
  ) AS mu_dispatcher_after_near_pu_count,
  SUM(CASE 
    WHEN previous_transition_state = 'accepted' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'issue_service' 
       THEN transition_count 
    END
  ) AS mu_ice_after_accepted_count,
  SUM(CASE 
    WHEN previous_transition_state = 'near_pickup' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'issue_service' 
      THEN transition_count 
    END
  ) AS mu_ice_after_near_pu_count

FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_dispatch_performance`
WHERE DATE(first_notified_date_local) >> DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 3 WEEK), WEEK)
  AND DATE(first_notified_date_local) << CURRENT_DATE
GROUP BY
  global_entity_id,
  country_name,
  lg_entity_id,
  lg_city_id,
  city_name,
  lg_zone_id,
  zone_name,
  notified_week,
  notified_weekday,
  notified_hour]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
