        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.08hvkkd02lcd6f13p5t05131a7fg' name='Custom SQL Query' type='text'><![CDATA[SELECT
  global_entity_id,
  country_name,
  lg_entity_id,
  lg_city_id,
  city_name,
  lg_zone_id,
  zone_name,
  vertical_type,
  business_type_apac,
  delivery_distance_category,
  is_primary_raw_delivery AS is_primary_delivery,
  first_notified_date_local AS delivery_first_notified_date,
  notified_week,
  previous_transition_state,
  transition_state,
  next_transition_state,
  action_performed_by,
  action_reason,
  action_issue_type,
  undispatch_type,
  SUM(transition_count) AS transition_count
FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_dispatch_performance`
WHERE DATE(first_notified_date_local) >> DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 4 WEEK), WEEK)
  AND DATE(first_notified_date_local) << CURRENT_DATE
GROUP BY
  global_entity_id,
  country_name,
  lg_entity_id,
  lg_city_id,
  city_name,
  lg_zone_id,
  zone_name,
  vertical_type,
  business_type_apac,
  delivery_distance_category,
  is_primary_raw_delivery,
  first_notified_date_local,
  notified_week,
  previous_transition_state,
  transition_state,
  next_transition_state,
  action_performed_by,
  action_reason,
  action_issue_type,
  undispatch_type]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
