      <aliases enabled='yes' />
      <column caption='%_of_notified (APAC Daily)' datatype='real' name='[%_of_previous_transition (APAC Weekly) (copy)_4818218284172136485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([transition_count])&#10;/&#10;CASE [previous_transition_state] &#10;  WHEN &apos;courier_notified&apos; &#10;    THEN&#10;      {fixed ([delivery_first_notified_date]):&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;accepted&apos; &#10;    THEN&#10;      {fixed ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;near_pickup&apos; &#10;    THEN&#10;      {fixed ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;END' />
      </column>
      <column caption='%_of_notified (City Daily)' datatype='real' name='[%_of_previous_transition (City Weekly) (copy)_4818218284182097961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([transition_count])&#10;/&#10;CASE [previous_transition_state] &#10;  WHEN &apos;courier_notified&apos; &#10;    THEN&#10;      {fixed [global_entity_id], [city_name], ([delivery_first_notified_date]):&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;accepted&apos; &#10;    THEN&#10;      {fixed [global_entity_id], [city_name], ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;near_pickup&apos; &#10;    THEN&#10;      {fixed [global_entity_id], [city_name], ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;END' />
      </column>
      <column caption='%_of_notified (Country Daily)' datatype='real' name='[%_of_previous_transition (Country Weekly) (copy)_4818218284182183978]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([transition_count])&#10;/&#10;CASE [previous_transition_state] &#10;  WHEN &apos;courier_notified&apos; &#10;    THEN&#10;      {fixed [global_entity_id], ([delivery_first_notified_date]):&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;accepted&apos; &#10;    THEN&#10;      {fixed [global_entity_id], ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;near_pickup&apos; &#10;    THEN&#10;      {fixed [global_entity_id], ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;END' />
      </column>
      <column caption='%_of_notified (Zone Daily)' datatype='real' name='[%_of_previous_transition (Zone Weekly) (copy)_4818218284182253611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([transition_count])&#10;/&#10;CASE [previous_transition_state] &#10;  WHEN &apos;courier_notified&apos; &#10;    THEN&#10;      {fixed [global_entity_id], [city_name], [zone_name], ([delivery_first_notified_date]):&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;accepted&apos; &#10;    THEN&#10;      {fixed [global_entity_id], [city_name], [zone_name], ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;near_pickup&apos; &#10;    THEN&#10;      {fixed [global_entity_id], [city_name], [zone_name], ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;END' />
      </column>
      <column caption='Geo View - Country' datatype='boolean' name='[APAC Only Filter (copy)_4818218284163055648]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN  &apos;Country&apos; THEN TRUE END' />
      </column>
      <column caption='Net Acceptance Rate' datatype='real' name='[Acceptance Rate (copy)_4818218283919634443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4818218283922001932]&#10;- [Calculation_4818218283922395149]&#10;- [Transitions - MU after Accepted (copy)_4818218283922587662]&#10;- [Transitions - MU after Accepted (copy)_4818218284083806232]&#10;- [Transitions - MU after Accepted (copy)_4818218284084129817]&#10;)&#10;/ &#10;[Calculation_4818218283900309511]' />
      </column>
      <column caption='Dispatcher MU After Near PU' datatype='real' name='[Acceptance Rate (copy)_4818218283923038223]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Transitions - MU after Accepted (copy)_4818218283922587662]&#10;/&#10;[Calculation_4818218283900309511]' />
      </column>
      <column caption='Acceptance Rate' datatype='real' name='[Calculation_4818218283862831106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4818218283922001932]&#10;/&#10;[Calculation_4818218283900309511]' />
      </column>
      <column caption='Transitions - Notified' datatype='integer' name='[Calculation_4818218283900309511]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)' />
      </column>
      <column caption='Transitions - Accepted' datatype='integer' name='[Calculation_4818218283922001932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)' />
      </column>
      <column caption='Transitions - MU Dispatcher after Accepted' datatype='integer' name='[Calculation_4818218283922395149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#10;  SUM(&#10;    IF([previous_transition_state]) = &apos;accepted&apos; &#10;      AND [undispatch_type] = &apos;manual_undispatch&apos; &#10;      AND [action_performed_by] = &apos;dispatcher&apos; &#10;    THEN [transition_count]  &#10;  END)&#10;)' />
