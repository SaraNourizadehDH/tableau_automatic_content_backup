      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='AR MU Transitions' name='federated.1gejnnl1hosedr1a370ei0jooc4m' />
          </datasources>
          <datasource-dependencies datasource='federated.1gejnnl1hosedr1a370ei0jooc4m'>
            <column caption='Net Acceptance Rate' datatype='real' name='[Acceptance Rate (copy)_4818218283919634443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_4818218283922001932]&#10;- [Calculation_4818218283922395149]&#10;- [Transitions - MU after Accepted (copy)_4818218283922587662]&#10;- [Transitions - MU after Accepted (copy)_4818218284083806232]&#10;- [Transitions - MU after Accepted (copy)_4818218284084129817]&#10;)&#10;/ &#10;[Calculation_4818218283900309511]' />
            </column>
            <column caption='Dispatcher MU After Near PU' datatype='real' name='[Acceptance Rate (copy)_4818218283923038223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Transitions - MU after Accepted (copy)_4818218283922587662]&#10;/&#10;[Calculation_4818218283900309511]' />
            </column>
            <column caption='Acceptance Rate' datatype='real' name='[Calculation_4818218283862831106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4818218283922001932]&#10;/&#10;[Calculation_4818218283900309511]' />
            </column>
            <column caption='Transitions - Notified' datatype='integer' name='[Calculation_4818218283900309511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)' />
            </column>
            <column caption='Transitions - Accepted' datatype='integer' name='[Calculation_4818218283922001932]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)' />
            </column>
            <column caption='Transitions - MU Dispatcher after Accepted' datatype='integer' name='[Calculation_4818218283922395149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#10;  SUM(&#10;    IF([previous_transition_state]) = &apos;accepted&apos; &#10;      AND [undispatch_type] = &apos;manual_undispatch&apos; &#10;      AND [action_performed_by] = &apos;dispatcher&apos; &#10;    THEN [transition_count]  &#10;  END)&#10;)' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_4818218283943014421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;APAC&apos;' />
              <aliases>
                <alias key='&quot;APAC&quot;' value='Pandora' />
              </aliases>
            </column>
            <column caption='Dispatcher MU After Accepted' datatype='real' name='[MU Rate After Accepted (copy)_4818218284084740122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4818218283922395149]&#10;/&#10;[Calculation_4818218283900309511]' />
            </column>
            <column caption='ICE MU After Accepted' datatype='real' name='[MU Rate After Near PU (copy)_4818218284084985883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Transitions - MU after Accepted (copy)_4818218284083806232]&#10;/&#10;[Calculation_4818218283900309511]' />
            </column>
            <column caption='ICE MU After Near PU' datatype='real' name='[Manual Undispatch After Accepted Rate (copy)_4818218283923222544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Transitions - MU after Accepted (copy)_4818218284084129817]&#10;/&#10;[Calculation_4818218283900309511]' />
            </column>
            <column caption='Transitions - MU Dispatcher after Near PU' datatype='integer' name='[Transitions - MU after Accepted (copy)_4818218283922587662]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF ([previous_transition_state]) = &apos;near_pickup&apos; AND [undispatch_type] = &apos;manual_undispatch&apos; AND [action_performed_by] = &apos;dispatcher&apos; THEN [transition_count] END))' />
            </column>
            <column caption='Transitions - MU ICE after Accepted' datatype='integer' name='[Transitions - MU after Accepted (copy)_4818218284083806232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF ([previous_transition_state]) = &apos;accepted&apos; AND [undispatch_type] = &apos;manual_undispatch&apos; AND [action_performed_by] = &apos;issue_service&apos; THEN [transition_count] END))' />
