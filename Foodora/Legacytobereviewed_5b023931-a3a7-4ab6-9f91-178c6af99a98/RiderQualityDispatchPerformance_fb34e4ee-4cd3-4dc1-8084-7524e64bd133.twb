        <objects>
          <object caption='Custom SQL Query' id='_F8E39694C9124179BF3645F0803D2143'>
            <properties context=''>
              <relation connection='bigquery.1hf4x6j0b9zwcq19iqeks1tjrzqr' name='Custom SQL Query' type='text'><![CDATA[SELECT
  global_entity_id,
  country_name,
  lg_entity_id,
  lg_city_id,
  city_name,
  lg_zone_id,
  zone_name,
  business_type_apac,
  pickup_distance_300_metres_bin,
  delivery_distance_300_metres_bin,
  batch_number,
  vehicle_name,
  notified_week,
  SUM(CASE WHEN transition_state = 'courier_notified' THEN transition_count END) AS notified_count,
  SUM(CASE WHEN transition_state = 'accepted' THEN transition_count END) AS accepted_count,
  SUM(CASE 
    WHEN previous_transition_state = 'accepted' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'dispatcher' 
      THEN transition_count 
    END
  ) AS mu_dispatcher_after_accepted_count,
  SUM(CASE 
    WHEN previous_transition_state = 'near_pickup' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'dispatcher' 
      THEN transition_count 
    END
  ) AS mu_dispatcher_after_near_pu_count,
  SUM(CASE 
    WHEN previous_transition_state = 'accepted' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'issue_service' 
       THEN transition_count 
    END
  ) AS mu_ice_after_accepted_count,
  SUM(CASE 
    WHEN previous_transition_state = 'near_pickup' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'issue_service' 
      THEN transition_count 
    END
  ) AS mu_ice_after_near_pu_count

