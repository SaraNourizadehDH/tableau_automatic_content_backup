              <calculation class='tableau' formula='([transition_count])&#10;/&#10;CASE [previous_transition_state] &#10;  WHEN &apos;courier_notified&apos; &#10;    THEN&#10;      {fixed [global_entity_id], [city_name], [zone_name], isoweek([delivery_first_notified_date]):&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;accepted&apos; &#10;    THEN&#10;      {fixed [global_entity_id], [city_name], [zone_name], isoweek([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;near_pickup&apos; &#10;    THEN&#10;      {fixed [global_entity_id], [city_name], [zone_name], isoweek([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;END' />
            </column>
