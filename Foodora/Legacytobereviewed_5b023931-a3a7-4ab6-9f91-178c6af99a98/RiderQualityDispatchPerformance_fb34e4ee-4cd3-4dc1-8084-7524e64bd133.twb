          <named-connection caption='BigQuery' name='bigquery.1hf4x6j0b9zwcq19iqeks1tjrzqr'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='alvin.chua@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1hf4x6j0b9zwcq19iqeks1tjrzqr' name='Custom SQL Query' type='text'><![CDATA[SELECT
  global_entity_id,
  country_name,
  lg_entity_id,
  lg_city_id,
  city_name,
  lg_zone_id,
  zone_name,
  business_type_apac,
  pickup_distance_300_metres_bin,
  delivery_distance_300_metres_bin,
  batch_number,
  vehicle_name,
  notified_week,
  SUM(CASE WHEN transition_state = 'courier_notified' THEN transition_count END) AS notified_count,
  SUM(CASE WHEN transition_state = 'accepted' THEN transition_count END) AS accepted_count,
  SUM(CASE 
    WHEN previous_transition_state = 'accepted' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'dispatcher' 
      THEN transition_count 
    END
  ) AS mu_dispatcher_after_accepted_count,
  SUM(CASE 
    WHEN previous_transition_state = 'near_pickup' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'dispatcher' 
      THEN transition_count 
    END
  ) AS mu_dispatcher_after_near_pu_count,
  SUM(CASE 
    WHEN previous_transition_state = 'accepted' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'issue_service' 
       THEN transition_count 
    END
  ) AS mu_ice_after_accepted_count,
  SUM(CASE 
    WHEN previous_transition_state = 'near_pickup' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'issue_service' 
      THEN transition_count 
    END
  ) AS mu_ice_after_near_pu_count

FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_dispatch_performance`
WHERE DATE(first_notified_date_local) >> DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 4 WEEK), WEEK)
  AND DATE(first_notified_date_local) << CURRENT_DATE
GROUP BY
  global_entity_id,
  country_name,
  lg_entity_id,
  lg_city_id,
  lg_zone_id,
  zone_name,
  city_name,
  business_type_apac,
  pickup_distance_300_metres_bin,
  delivery_distance_300_metres_bin,
  batch_number,
  vehicle_name,
  notified_week]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1hf4x6j0b9zwcq19iqeks1tjrzqr' name='Custom SQL Query' type='text'><![CDATA[SELECT
  global_entity_id,
  country_name,
  lg_entity_id,
  lg_city_id,
  city_name,
  lg_zone_id,
  zone_name,
  business_type_apac,
  pickup_distance_300_metres_bin,
  delivery_distance_300_metres_bin,
  batch_number,
  vehicle_name,
  notified_week,
  SUM(CASE WHEN transition_state = 'courier_notified' THEN transition_count END) AS notified_count,
  SUM(CASE WHEN transition_state = 'accepted' THEN transition_count END) AS accepted_count,
  SUM(CASE 
    WHEN previous_transition_state = 'accepted' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'dispatcher' 
      THEN transition_count 
    END
  ) AS mu_dispatcher_after_accepted_count,
  SUM(CASE 
    WHEN previous_transition_state = 'near_pickup' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'dispatcher' 
      THEN transition_count 
    END
  ) AS mu_dispatcher_after_near_pu_count,
  SUM(CASE 
    WHEN previous_transition_state = 'accepted' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'issue_service' 
       THEN transition_count 
    END
  ) AS mu_ice_after_accepted_count,
  SUM(CASE 
    WHEN previous_transition_state = 'near_pickup' 
     AND undispatch_type = 'manual_undispatch' 
     AND action_performed_by = 'issue_service' 
      THEN transition_count 
    END
  ) AS mu_ice_after_near_pu_count

FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_dispatch_performance`
WHERE DATE(first_notified_date_local) >> DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 4 WEEK), WEEK)
  AND DATE(first_notified_date_local) << CURRENT_DATE
GROUP BY
  global_entity_id,
