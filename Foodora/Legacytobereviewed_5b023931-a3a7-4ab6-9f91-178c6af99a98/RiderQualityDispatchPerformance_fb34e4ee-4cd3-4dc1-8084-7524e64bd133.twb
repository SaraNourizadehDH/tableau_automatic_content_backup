              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Geo Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gejnnl1hosedr1a370ei0jooc4m'>
            <column caption='%_of_notified (APAC Daily)' datatype='real' name='[%_of_previous_transition (APAC Weekly) (copy)_4818218284172136485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([transition_count])&#10;/&#10;CASE [previous_transition_state] &#10;  WHEN &apos;courier_notified&apos; &#10;    THEN&#10;      {fixed ([delivery_first_notified_date]):&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;accepted&apos; &#10;    THEN&#10;      {fixed ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;near_pickup&apos; &#10;    THEN&#10;      {fixed ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;END' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_4818218283943014421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;APAC&apos;' />
              <aliases>
                <alias key='&quot;APAC&quot;' value='Pandora' />
              </aliases>
            </column>
            <column caption='Geo View - APAC' datatype='boolean' name='[Calculation_4818218284162273311]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN  &apos;Regional&apos; THEN TRUE END' />
            </column>
            <column caption='Time View - Daily' datatype='boolean' name='[Geo View - APAC (copy)_4818218284172910631]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Geo Granularity (copy)_4818218284172558374] WHEN &apos;Daily&apos; THEN TRUE END' />
            </column>
            <column datatype='string' name='[action_issue_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[action_performed_by]' role='dimension' type='nominal' />
            <column datatype='string' name='[action_reason]' role='dimension' type='nominal' />
