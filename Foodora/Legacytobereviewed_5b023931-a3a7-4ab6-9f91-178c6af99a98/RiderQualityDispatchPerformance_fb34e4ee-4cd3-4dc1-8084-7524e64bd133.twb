            </column>
            <column caption='Geo View - APAC' datatype='boolean' name='[Calculation_4818218284162273311]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN  &apos;Regional&apos; THEN TRUE END' />
            </column>
            <column caption='Time View - Weekly' datatype='boolean' name='[Time View - Daily (copy)_4818218284173008936]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Geo Granularity (copy)_4818218284172558374] WHEN &apos;Weekly&apos; THEN TRUE END' />
            </column>
