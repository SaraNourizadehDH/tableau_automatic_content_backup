            <column datatype='string' name='[action_reason]' role='dimension' type='nominal' />
            <column caption='%_of_notified (Country Weekly)' datatype='real' name='[apac_fixed_weekly_previous_transition (copy)_4818218283936292884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([transition_count])&#10;/&#10;CASE [previous_transition_state] &#10;  WHEN &apos;courier_notified&apos; &#10;    THEN&#10;      {fixed [global_entity_id], isoweek([delivery_first_notified_date]):&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;accepted&apos; &#10;    THEN&#10;      {fixed [global_entity_id], isoweek([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;near_pickup&apos; &#10;    THEN&#10;      {fixed [global_entity_id], isoweek([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;END' />
