          <zone forceUpdate='true' h='7286' id='113' type-v2='text' w='99200' x='400' y='11571'>
            <formatted-text>
              <run>This table shows the following transitions
- All &apos;courier_notified&apos; states
- All states where previous state = &apos;courier_notified&apos;  (Shows all actions after riders were notified)
- All states where previous state = &apos;accepted&apos; and current state is not &apos;near_pickup&apos; (Shows all actions where riders accepted but did not head towards pickup)
- All states where previous state = &apos;near_pickup&apos; and current state is not &apos;picked_up&apos; (Shows all actions where riders were near pickup but did not pick up)</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
