          <datasource-dependencies datasource='federated.1gejnnl1hosedr1a370ei0jooc4m'>
            <column caption='%_of_notified (Country Daily)' datatype='real' name='[%_of_previous_transition (Country Weekly) (copy)_4818218284182183978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([transition_count])&#10;/&#10;CASE [previous_transition_state] &#10;  WHEN &apos;courier_notified&apos; &#10;    THEN&#10;      {fixed [global_entity_id], ([delivery_first_notified_date]):&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;accepted&apos; &#10;    THEN&#10;      {fixed [global_entity_id], ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;near_pickup&apos; &#10;    THEN&#10;      {fixed [global_entity_id], ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;END' />
            </column>
            <column caption='Placeholder' datatype='integer' name='[Calculation_4818218284096884764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
