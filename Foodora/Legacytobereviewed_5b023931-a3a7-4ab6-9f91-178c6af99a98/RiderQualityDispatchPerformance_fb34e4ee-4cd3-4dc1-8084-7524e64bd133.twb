    <worksheet name='Manual Undispatch After Acceptance %'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='AR MU Transitions' name='federated.1gejnnl1hosedr1a370ei0jooc4m' />
          </datasources>
          <datasource-dependencies datasource='federated.1gejnnl1hosedr1a370ei0jooc4m'>
            <column caption='%_of_notified (Country Daily)' datatype='real' name='[%_of_previous_transition (Country Weekly) (copy)_4818218284182183978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([transition_count])&#10;/&#10;CASE [previous_transition_state] &#10;  WHEN &apos;courier_notified&apos; &#10;    THEN&#10;      {fixed [global_entity_id], ([delivery_first_notified_date]):&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;accepted&apos; &#10;    THEN&#10;      {fixed [global_entity_id], ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;near_pickup&apos; &#10;    THEN&#10;      {fixed [global_entity_id], ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;END' />
            </column>
            <column caption='action_issue_type_cleaned' datatype='string' name='[Calculation_4818218284254294061]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [action_performed_by] &#10;  WHEN &apos;issue_service&apos; THEN&#10;    IF(IFNULL([action_issue_type],&apos;&apos;) + &apos; &apos; + IFNULL([action_reason],&apos;&apos;)) = &apos; &apos;&#10;      THEN NULL&#10;      ELSE TRIM(&#10;        IFNULL([action_issue_type],&apos;&apos;) + &apos; &apos; + IFNULL([action_reason],&apos;&apos;)&#10;      )&#10;    END&#10;  ELSE NULL&#10;END' />
            </column>
            <column datatype='string' name='[action_issue_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[action_performed_by]' role='dimension' type='nominal' />
            <column datatype='string' name='[action_reason]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[delivery_first_notified_date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4818218284254294061]' derivation='None' name='[none:Calculation_4818218284254294061:nk]' pivot='key' type='nominal' />
            <column-instance column='[action_performed_by]' derivation='None' name='[none:action_performed_by:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_first_notified_date]' derivation='None' name='[none:delivery_first_notified_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[notified_week]' derivation='None' name='[none:notified_week:nk]' pivot='key' type='nominal' />
            <column-instance column='[previous_transition_state]' derivation='None' name='[none:previous_transition_state:nk]' pivot='key' type='nominal' />
            <column-instance column='[undispatch_type]' derivation='None' name='[none:undispatch_type:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[notified_week]' role='dimension' type='nominal' />
            <column datatype='string' name='[previous_transition_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[%_of_previous_transition (Country Weekly) (copy)_4818218284182183978]' derivation='Sum' name='[sum:%_of_previous_transition (Country Weekly) (copy)_4818218284182183978:qk]' pivot='key' type='quantitative' />
            <column-instance column='[transition_count]' derivation='Sum' name='[sum:transition_count:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[transition_count]' role='measure' type='quantitative' />
            <column datatype='string' name='[transition_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column datatype='string' name='[undispatch_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1gejnnl1hosedr1a370ei0jooc4m].[none:action_performed_by:nk]' filter-group='8'>
            <groupfilter function='level-members' level='[none:action_performed_by:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
