    <worksheet name='AR Distance Graph'>
      <table>
        <view>
          <datasources>
            <datasource caption='AR Distance Custom Graph' name='federated.0j9k0qk0jd1avd1eu3hpx0b5x19o' />
            <datasource caption='AR Hourly Graph' name='federated.0jyvq4w1gyc1iv1et98jj0hegg66' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Outlier Filter' datatype='real' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='0.0005'>
              <calculation class='tableau' formula='0.0005' />
            </column>
            <column caption='Max Distance' datatype='integer' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='12000'>
              <calculation class='tableau' formula='12000' />
            </column>
            <column caption='line_split' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;notified_week&quot;'>
              <calculation class='tableau' formula='&quot;notified_week&quot;' />
            </column>
            <column caption='y-axis' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Net Acceptance Rate&quot;'>
              <calculation class='tableau' formula='&quot;Net Acceptance Rate&quot;' />
            </column>
            <column caption='x-axis' datatype='string' name='[y-axis (copy)_2787868911030255616]' param-domain-type='list' role='measure' type='nominal' value='&quot;delivery distance (Manhattan)&quot;'>
              <calculation class='tableau' formula='&quot;delivery distance (Manhattan)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0j9k0qk0jd1avd1eu3hpx0b5x19o'>
            <column caption='Net Acceptance Rate' datatype='real' name='[Acceptance Rate (copy)_1939925543146790922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IFNULL([accepted_count],0)) &#10;- SUM(IFNULL([mu_dispatcher_after_accepted_count],0)) &#10;- SUM(IFNULL([mu_dispatcher_after_near_pu_count],0))&#10;- SUM(IFNULL([mu_ice_after_accepted_count],0))&#10;- SUM(IFNULL([mu_ice_after_near_pu_count],0))&#10;)&#10;/ SUM(IFNULL([notified_count],0))' />
            </column>
            <column caption='MU (Dispatcher) after accepted rate' datatype='real' name='[Acceptance Rate (copy)_1939925543175970836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([mu_dispatcher_after_accepted_count],0))/ SUM(IFNULL([notified_count],0))' />
            </column>
            <column caption='Acceptance Rate' datatype='real' name='[Calculation_1939925541773230081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([accepted_count],0))/ SUM(IFNULL([notified_count],0))' />
            </column>
            <column aggregation='Sum' caption='x-axis' datatype='real' name='[Calculation_1939925541787709444]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[y-axis (copy)_2787868911030255616]&#10;  WHEN &apos;delivery distance (Manhattan)&apos; &#10;    THEN (&#10;      IF [delivery_distance_300_metres_bin] &lt; [Parameters].[Parameter 3]&#10;        THEN [delivery_distance_300_metres_bin] &#10;      ELSE [Parameters].[Parameter 3] &#10;    END&#10;  )&#10;  WHEN &apos;pickup distance (Manhattan)&apos; &#10;    THEN (&#10;      IF [pickup_distance_300_metres_bin] &lt; [Parameters].[Parameter 3]&#10;        THEN [pickup_distance_300_metres_bin] &#10;      ELSE [Parameters].[Parameter 3] &#10;    END&#10;  )&#10;END' />
            </column>
            <column caption='Relative Volume Share' datatype='real' name='[Calculation_1939925541791105029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([notified_count])/TOTAL(SUM([notified_count])) &gt;= [Parameters].[Parameter 2] &#10;  THEN SUM([notified_count])/TOTAL(SUM([notified_count])) &#10;ELSE NULL &#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Line Split' datatype='string' name='[Calculation_1939925543101964294]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]  &#10;WHEN &apos;country_name&apos; THEN [country_name]&#10;WHEN &apos;lg_entity_id&apos; THEN [lg_entity_id]&#10;WHEN &apos;city_name&apos; THEN [city_name]&#10;WHEN &apos;zone_name&apos; THEN [zone_name]&#10;WHEN &apos;notified_week&apos; THEN [notified_week]&#10;WHEN &apos;vehicle_name&apos; THEN [vehicle_name]&#10;WHEN &apos;batch_number&apos; THEN STR([batch_number])&#10;WHEN &apos;business_type_apac&apos; THEN [business_type_apac]&#10;END' />
            </column>
            <column caption='y-axis' datatype='real' name='[Calculation_1939925543148179469]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5] &#10;  WHEN &apos;Acceptance Rate&apos; THEN [Calculation_1939925541773230081]&#10;  WHEN &apos;MU (Dispatcher) after accepted&apos; THEN [Acceptance Rate (copy)_1939925543175970836]&#10;  WHEN &apos;MU (ICE) after accepted&apos; THEN [MU (Dispatcher) after accepted rate (copy)_1939925543176351765]&#10;  WHEN &apos;MU (Dispatcher) after near pu&apos; THEN [MU (Dispatcher) after accepted rate (copy)_1939925543176564758]&#10;  WHEN &apos;MU (ICE) after near pu&apos; THEN [MU (ICE) after accepted rate (copy)_1939925543176712215]&#10;  WHEN &apos;Net Acceptance Rate&apos; THEN [Acceptance Rate (copy)_1939925543146790922]&#10;END' />
            </column>
            <column caption='MU (ICE) after accepted rate' datatype='real' name='[MU (Dispatcher) after accepted rate (copy)_1939925543176351765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([mu_ice_after_accepted_count],0)) / SUM(IFNULL([notified_count],0))' />
            </column>
            <column caption='MU (Dispatcher) after near pu' datatype='real' name='[MU (Dispatcher) after accepted rate (copy)_1939925543176564758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([mu_dispatcher_after_near_pu_count],0))/ SUM(IFNULL([notified_count],0))' />
            </column>
            <column caption='MU (ICE) after near pu rate' datatype='real' name='[MU (ICE) after accepted rate (copy)_1939925543176712215]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([mu_ice_after_near_pu_count],0)) / SUM(IFNULL([notified_count],0))' />
            </column>
            <column datatype='integer' name='[accepted_count]' role='measure' type='quantitative' />
