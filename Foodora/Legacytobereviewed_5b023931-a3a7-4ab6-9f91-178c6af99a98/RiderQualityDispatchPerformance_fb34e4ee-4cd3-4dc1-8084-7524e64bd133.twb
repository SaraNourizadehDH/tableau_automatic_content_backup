    <worksheet name='City Transitions Daily Breakdown'>
      <table>
        <view>
          <datasources>
            <datasource caption='AR MU Transitions' name='federated.1gejnnl1hosedr1a370ei0jooc4m' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Period Granularity' datatype='string' name='[Geo Granularity (copy)_4818218284172558374]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Geo Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gejnnl1hosedr1a370ei0jooc4m'>
            <column caption='%_of_notified (City Daily)' datatype='real' name='[%_of_previous_transition (City Weekly) (copy)_4818218284182097961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([transition_count])&#10;/&#10;CASE [previous_transition_state] &#10;  WHEN &apos;courier_notified&apos; &#10;    THEN&#10;      {fixed [global_entity_id], [city_name], ([delivery_first_notified_date]):&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;accepted&apos; &#10;    THEN&#10;      {fixed [global_entity_id], [city_name], ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;  WHEN &apos;near_pickup&apos; &#10;    THEN&#10;      {fixed [global_entity_id], [city_name], ([delivery_first_notified_date]):&#10;      /*SUM(CASE [transition_state] WHEN &apos;accepted&apos; THEN [transition_count] END)*/&#10;      SUM(CASE [transition_state] WHEN &apos;courier_notified&apos; THEN [transition_count] END)&#10;      }&#10;END' />
