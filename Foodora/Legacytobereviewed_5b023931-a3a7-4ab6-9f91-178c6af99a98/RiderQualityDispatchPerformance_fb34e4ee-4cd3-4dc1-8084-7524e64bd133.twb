        <column caption='Outlier Filter' datatype='real' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='0.0005'>
          <calculation class='tableau' formula='0.0005' />
        </column>
        <column caption='Max Distance' datatype='integer' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='12000'>
          <calculation class='tableau' formula='12000' />
        </column>
        <column caption='line_split' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;notified_week&quot;'>
          <calculation class='tableau' formula='&quot;notified_week&quot;' />
        </column>
        <column caption='y-axis' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Net Acceptance Rate&quot;'>
          <calculation class='tableau' formula='&quot;Net Acceptance Rate&quot;' />
        </column>
        <column caption='x-axis' datatype='string' name='[y-axis (copy)_2787868911030255616]' param-domain-type='list' role='measure' type='nominal' value='&quot;delivery distance (Manhattan)&quot;'>
          <calculation class='tableau' formula='&quot;delivery distance (Manhattan)&quot;' />
        </column>
      </datasource-dependencies>
