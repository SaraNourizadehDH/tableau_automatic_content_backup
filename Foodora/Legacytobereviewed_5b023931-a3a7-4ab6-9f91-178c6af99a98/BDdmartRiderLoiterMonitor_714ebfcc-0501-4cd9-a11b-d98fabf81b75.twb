        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1ib10sf0ar18p0109ius80tym2gm' name='Custom SQL Query' type='text'><![CDATA[SELECT
  "Bangladesh" AS country,
  created_date_local,
  vendor_name,
  COUNT(DISTINCT CASE WHEN fir_estimated_pickup << -5 AND loitering_time >> 5 THEN order_code END) AS c,
  COUNT(DISTINCT order_code) AS total_order_count,
  SUM(loitering_time) AS total_loitering_time,
  AVG(loitering_time) AS avg_loitering_time
  -- SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN fir_estimated_pickup << -5 AND loitering_time >> 5 THEN order_code END), COUNT(DISTINCT order_code)) AS a,
  -- 1- SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN fir_estimated_pickup << -5 AND loitering_time >> 5 THEN order_code END), COUNT(DISTINCT order_code)) AS b
FROM `fulfillment-dwh-production.pandata_report.country_BD_pandamart_rider_loiter_tracker`
WHERE created_date_local << CURRENT_DATE
GROUP BY 1, 2, 3
ORDER BY 1

--------------------
---PREVIOUS QUERY---
--------------------

