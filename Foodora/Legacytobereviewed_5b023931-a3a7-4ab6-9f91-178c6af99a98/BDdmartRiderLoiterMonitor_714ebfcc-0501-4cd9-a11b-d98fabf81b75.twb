--       (vo.created_at IS NOT NULL) AS is_vendor_order,
--       (ro.created_at IS NOT NULL) AS is_rider_order,
--       COALESCE(vo.order_code, ro.platform_order_code) AS order_code,
--       COALESCE(vo.global_order_id, ro.global_order_id) AS global_order_id,
--       COALESCE(vo.vendor.code, ro.vendor.vendor_code) AS vendor_code,
--       vo.order_status,
--       ro.order_id AS rider_order_id,
--       ro.timings AS timings,
--       ro.deliveries,
--       ro.order_status AS rider_order_status,
--       ro.zone_id,
--       ro.sent_to_vendor_at,
--       ro.order_placed_at,
--       ro.food_is_ready_at,
--       ro.original_scheduled_pickup_at,
--       ro.estimated_prep_time
--     FROM vendor_orders_dataset vo
--     FULL JOIN rider_orders_dataset ro ON vo.entity.id = ro.entity.id
--       AND vo.order_code = ro.platform_order_code
--   ),

--   orders AS (
--     SELECT
--       *
--     FROM all_orders_data
--   )

--   SELECT
--     order_code,
--     vendor_code,
--     d.rider_id,
--     orders.zone_id,
--     DATETIME(orders.food_is_ready_at, "Asia/Dhaka") AS food_is_ready_at,
--     DATETIME(orders.created_at, "Asia/Dhaka") AS created_at_local,
--     CASE 
--       WHEN d.stacked_deliveries >> 0 THEN "Stacked" ELSE "Non Stacked" END
--     AS stacked_order_status,
--     DATETIME(d.rider_picked_up_at, "Asia/Dhaka") AS rider_picked_up_at_local,
--     DATETIME(orders.original_scheduled_pickup_at, "Asia/Dhaka") AS original_scheduled_pickup_at_local, 
--     -- DATETIME(vendor.near_pickup_at, "Asia/Dhaka") AS near_pickup_at,
--     DATETIME(d.rider_near_restaurant_at, "Asia/Dhaka") AS rider_near_restaurant_at_local,
--     DATETIME_DIFF(DATETIME(orders.food_is_ready_at, "Asia/Dhaka"), DATETIME(orders.original_scheduled_pickup_at, "Asia/Dhaka"), MINUTE) AS fir_estimated_pickup,
--     CASE
--       WHEN orders.food_is_ready_at >>  d.rider_near_restaurant_at THEN "FIR after Near Pickup"
--       WHEN orders.food_is_ready_at <<  d.rider_near_restaurant_at THEN "FIR before Near Pickup"
--     END AS status,
--     CASE
--       WHEN orders.food_is_ready_at >>  d.rider_near_restaurant_at THEN DATETIME_DIFF(DATETIME(d.rider_picked_up_at, "Asia/Dhaka"), DATETIME(orders.food_is_ready_at, "Asia/Dhaka"), MINUTE)
--       WHEN orders.food_is_ready_at <<  d.rider_near_restaurant_at THEN DATETIME_DIFF(DATETIME(d.rider_picked_up_at, "Asia/Dhaka"), DATETIME(d.rider_near_restaurant_at, "Asia/Dhaka"), MINUTE)
--     END AS loitering_time,
--   orders.timings.actual_delivery_time/60 AS DT,
--   orders.timings.promised_delivery_time/60 AS PDT,
--   d.timings.rider_late/60 AS rider_late,  
--   d.timings.vendor_late/60 AS vendor_late,  
--   orders.estimated_prep_time/60 AS EPT,
--   d.timings.assumed_actual_preparation_time/60 AS APT,
