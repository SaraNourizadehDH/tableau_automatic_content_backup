--    d.timings.to_customer_time/60.0 AS to_customer_time,
--    d.timings.at_customer_time/60.0 AS at_customer_time,


--   FROM orders
--   -- `fulfillment-dwh-production.curated_data_shared.orders_v2` AS orders
--   LEFT JOIN UNNEST(deliveries) AS d
--   WHERE created_date >>= "2023-10-01"
