--   -- 1- SAFE_DIVIDE(COUNT(DISTINCT CASE WHEN fir_estimated_pickup << -5 AND loitering_time >> 5 THEN order_code END), COUNT(DISTINCT order_code)) AS b
-- FROM (
--   SELECT
--     order_level_data.*,
--     DATE(created_at_local) AS created_date_local,
--     first_working_day.lg_zone_id,
--     -- zone_name AS rider_last_working_zone,
--     vm.vendor_name,
--     vm.business_type_apac
--   FROM order_level_data
--   LEFT JOIN `fulfillment-dwh-production.pandata_report.country_BD_vendor_mapping_general_use` AS vm
--     ON order_level_data.vendor_code = vm.Vendor_code
--   LEFT JOIN first_working_day
--     ON order_level_data.rider_id = first_working_day.lg_rider_id
--   LEFT JOIN zones
--     ON first_working_day.lg_zone_id = zones.lg_zone_id
--   WHERE business_type_apac = "dmart"
--   AND rider_late << 0
-- )
-- WHERE created_date_local << CURRENT_DATE
-- GROUP BY 1, 2, 3
-- ORDER BY 1]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
