      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_6ACC3C0DB9594C9BB7D40465579EDED1'>
            <properties context=''>
              <relation connection='bigquery.10jgrdl0j3pmhz17wtfup04e9bze' name='Custom SQL Query' type='text'><![CDATA[With starting_points AS (
  SELECT
    s.id,
    REPLACE(s.name, '.', '') AS zone
  FROM `fulfillment-dwh-production.curated_data_shared.countries` AS cc, 
  UNNEST(cc.cities) AS cities, 
  UNNEST(cities.zones) AS zones, 
  UNNEST(zones.starting_points) AS s
  WHERE cc.country_code = 'sg'
  AND s.is_active = TRUE
),
contracts AS
(
  SELECT
    rider_id,
    MIN(DATETIME(c.start_at, 'Asia/Singapore')) AS contract_start
  FROM
    `fulfillment-dwh-production.curated_data_shared.riders` r,
    UNNEST (contracts) AS c
  WHERE
  country_code = 'sg'
  GROUP BY
    rider_id),

batches AS 

(
  SELECT  
  DISTINCT r.rider_id,
  r.rider_name,
  b.number as batch_number,
  --CASE WHEN b.number <<1 then 6 ELSE b.number END AS batch_number,
  DATETIME(b.active_from, "Asia/Singapore") active_from,
  DATETIME(b.active_until, "Asia/Singapore") active_until,
  --COUNT(DISTINCT b.number) OVER (PARTITION BY r.rider_id, DATE_TRUNC(DATE(b.active_from, "Asia/Singapore"), WEEK)) as count_check,
FROM `fulfillment-dwh-production.curated_data_shared.riders` r,
UNNEST(rider_vehicles) AS v,
UNNEST(custom_fields) AS c,
UNNEST(batches) as b
WHERE
country_code = 'sg'
--AND r.rider_id = 822891
-- GROUP BY 1,2,4
ORDER by r.rider_id, active_from)

SELECT
  DISTINCT d.rider_id,
  DATE(contract_start) as contract_start,
  IFNULL(b.batch_number,6) as batch_number,
  s.zone,
  DATE(DATETIME(d.rider_accepted_at, 'Asia/Singapore')) AS accepted_date,
  EXTRACT (HOUR FROM (DATETIME(d.rider_accepted_at, 'Asia/Singapore'))) as hour,
  format_timestamp("%G-%V", DATETIME(d.rider_accepted_at, 'Asia/Singapore')) as accepted_week,
  FORMAT_DATE('%a',DATETIME(d.rider_accepted_at, 'Asia/Singapore')) as day,
  CASE WHEN FORMAT_DATE('%a',DATETIME(d.rider_accepted_at, 'Asia/Singapore')) IN ('Sun', 'Sat') THEN "weekend" ELSE "weekday" END AS day_type,
  d.vehicle.name AS vehicle,
  COUNT(DISTINCT d.id) AS delivery_count,
  vendor.vertical_type,
 --AVG(b.batch_number) OVER (PARTITION BY d.rider_id, DATE(DATETIME(d.rider_accepted_at, 'Asia/Singapore')))
FROM `fulfillment-dwh-production.curated_data_shared.orders` o,
UNNEST(o.deliveries) d
LEFT JOIN starting_points s
  ON d.rider_starting_point_id = s.id
LEFT JOIN contracts ON contracts.rider_id = d.rider_id
LEFT JOIN batches b ON b.rider_id = d.rider_id AND DATE_TRUNC(DATE(b.active_from), WEEK(MONDAY)) = DATE_TRUNC(DATE(DATETIME(d.rider_accepted_at, 'Asia/Singapore')), WEEK(MONDAY))
WHERE LOWER(country_code) = 'sg'
AND d.delivery_status = 'completed'
AND o.created_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, WEEK(MONDAY)), INTERVAL 13 WEEK)
--AND TIME(d.rider_accepted_at, 'Asia/Singapore') BETWEEN "16:00:00" AND "19:01:00"
--AND DATETIME(d.rider_accepted_at, 'Asia/Singapore') BETWEEN contract_start AND DATE_ADD(contract_start,INTERVAL 30 day)
--AND DATE(DATETIME(d.rider_accepted_at, 'Asia/Singapore')) BETWEEN "2023-03-07" AND "2023-04-23"
--AND DATE(contracts.contract_start) BETWEEN "2023-03-07" AND "2023-04-23" -- When you want their join date
-- AND d.rider_id = 582677
AND DATE(DATETIME(d.rider_accepted_at, 'Asia/Singapore')) >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, WEEK(MONDAY)), INTERVAL 12 WEEK)
--AND DATE(DATETIME(d.rider_accepted_at, 'Asia/Singapore')) << DATE_TRUNC(CURRENT_DATE, WEEK(MONDAY))
--AND d.rider_id = 63015
GROUP BY rider_id, zone, accepted_date, vehicle, day, contract_start, day_type, batch_number,accepted_week, hour, vertical_type]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
