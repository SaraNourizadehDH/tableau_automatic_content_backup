      <aliases enabled='yes' />
      <column caption='date_partitioned_deliveries' datatype='integer' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [Calculation_202099093432176656]: SUM([delivery_count]) })' />
      </column>
      <column caption='distinct riders' datatype='integer' name='[Calculation_1036390917225676800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(rider_id)' />
      </column>
      <column caption='batch(STR)' datatype='string' name='[Calculation_1036390917226479617]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([batch_number])' />
      </column>
      <column caption='delivery_partition_dimensions' datatype='integer' name='[Calculation_1305199530252562433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [Calculation_1380634816295182336], [Dimension A selection (copy)_1380634816304779266], [Calculation_202099093432176656]: SUM([delivery_count]) })' />
      </column>
      <column caption='hour(str)' datatype='string' name='[Calculation_1373316466180042753]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str([hour])' />
      </column>
      <column caption='Dimension A selection' datatype='string' name='[Calculation_1380634816295182336]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;  WHEN &apos;accepted_week&apos; THEN [accepted_week]&#13;&#10;  WHEN &apos;vehicle&apos; THEN [vehicle]&#13;&#10;  WHEN &apos;zone&apos; THEN [zone]&#13;&#10;WHEN &apos;batch&apos; THEN [Calculation_1036390917226479617]&#13;&#10;WHEN &apos;day&apos; THEN [day]&#13;&#10;WHEN &apos;hour&apos; THEN [Calculation_1373316466180042753]&#13;&#10;END' />
      </column>
      <column caption='window_percentile(color grades)' datatype='real' name='[Calculation_202099093370986496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_PERCENTILE([Dimension B selection (copy)_1380634816312836100],0.5)'>
          <table-calc ordering-type='Field'>
            <order field='[federated.1i3ugnx0u6zhoj12kret004avv0x].[Calculation_1380634816295182336]' />
            <order field='[federated.1i3ugnx0u6zhoj12kret004avv0x].[Dimension A selection (copy)_1380634816304779266]' />
          </table-calc>
