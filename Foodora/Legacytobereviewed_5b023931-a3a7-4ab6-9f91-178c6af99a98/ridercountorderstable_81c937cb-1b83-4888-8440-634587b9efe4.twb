            <column caption='delivery_partition_dimensions' datatype='integer' name='[Calculation_1305199530252562433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [Calculation_1380634816295182336], [Dimension A selection (copy)_1380634816304779266], [Calculation_202099093432176656]: SUM([delivery_count]) })' />
            </column>
            <column caption='hour(str)' datatype='string' name='[Calculation_1373316466180042753]' role='dimension' type='nominal'>
