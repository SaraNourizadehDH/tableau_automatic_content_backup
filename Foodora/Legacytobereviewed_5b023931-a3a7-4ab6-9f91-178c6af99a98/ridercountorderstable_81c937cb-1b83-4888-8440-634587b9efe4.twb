              <calculation class='tableau' formula='&quot;vehicle&quot;' />
            </column>
            <column caption='date_dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;isoweek&quot;'>
              <calculation class='tableau' formula='&quot;isoweek&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1i3ugnx0u6zhoj12kret004avv0x'>
            <column caption='date_partitioned_deliveries' datatype='integer' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [Calculation_202099093432176656]: SUM([delivery_count]) })' />
            </column>
            <column caption='batch(STR)' datatype='string' name='[Calculation_1036390917226479617]' role='dimension' type='nominal'>
