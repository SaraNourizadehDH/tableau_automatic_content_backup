          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension (B)' datatype='string' name='[Dimension (A) (copy)_1380634816304742401]' param-domain-type='list' role='measure' type='nominal' value='&quot;zone&quot;'>
              <calculation class='tableau' formula='&quot;zone&quot;' />
            </column>
            <column caption='Metric' datatype='string' name='[Dimension (B) (copy)_1380634816306503683]' param-domain-type='list' role='measure' type='nominal' value='&quot;distinct_riders&quot;'>
              <calculation class='tableau' formula='&quot;distinct_riders&quot;' />
