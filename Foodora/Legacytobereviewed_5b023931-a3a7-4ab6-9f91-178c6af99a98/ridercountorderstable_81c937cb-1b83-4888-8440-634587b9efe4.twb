            </column>
            <column caption='Dimension A selection' datatype='string' name='[Calculation_1380634816295182336]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;  WHEN &apos;accepted_week&apos; THEN [accepted_week]&#13;&#10;  WHEN &apos;vehicle&apos; THEN [vehicle]&#13;&#10;  WHEN &apos;zone&apos; THEN [zone]&#13;&#10;WHEN &apos;batch&apos; THEN [Calculation_1036390917226479617]&#13;&#10;WHEN &apos;day&apos; THEN [day]&#13;&#10;WHEN &apos;hour&apos; THEN [Calculation_1373316466180042753]&#13;&#10;END' />
            </column>
            <column caption='window_percentile(color grades)' datatype='real' name='[Calculation_202099093370986496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_PERCENTILE([Dimension B selection (copy)_1380634816312836100],0.5)'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1i3ugnx0u6zhoj12kret004avv0x].[Calculation_1380634816295182336]' />
                  <order field='[federated.1i3ugnx0u6zhoj12kret004avv0x].[Dimension A selection (copy)_1380634816304779266]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='date_dimensions' datatype='string' name='[Calculation_202099093432176656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;  WHEN &quot;isoweek&quot; THEN [accepted_week]&#13;&#10;  WHEN &quot;date&quot; THEN STR([accepted_date])&#13;&#10;END' />
            </column>
            <column caption='Dimension B selection' datatype='string' name='[Dimension A selection (copy)_1380634816304779266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimension (A) (copy)_1380634816304742401]&#13;&#10;  WHEN &apos;accepted_week&apos; THEN [accepted_week]&#13;&#10;  WHEN &apos;vehicle&apos; THEN [vehicle]&#13;&#10;  WHEN &apos;zone&apos; THEN [zone]&#13;&#10;WHEN &apos;batch&apos; THEN [Calculation_1036390917226479617]&#13;&#10;WHEN &apos;day&apos; THEN [day]&#13;&#10;WHEN &apos;hour&apos; THEN [Calculation_1373316466180042753]&#13;&#10;END' />
            </column>
            <column caption='Metric selection' datatype='real' name='[Dimension B selection (copy)_1380634816312836100]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimension (B) (copy)_1380634816306503683]&#13;&#10;  WHEN &apos;deliveries&apos; THEN SUM([delivery_count])&#13;&#10;WHEN &apos;distinct_riders&apos; THEN COUNTD([rider_id])&#13;&#10;WHEN &apos;% of deliveries&apos; THEN ([Calculation_1305199530252562433])/ ([Calculation1]) * 100&#13;&#10;WHEN &apos;% of riders&apos; THEN ([delivery_partition_dimensions (copy)_1305199530253684738])/ ([date_partitioned_deliveries (copy)_1305199530253873155]) * 100&#13;&#10;END' />
