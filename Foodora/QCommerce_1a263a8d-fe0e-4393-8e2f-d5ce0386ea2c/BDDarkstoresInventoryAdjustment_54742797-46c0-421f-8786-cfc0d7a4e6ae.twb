      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (pandata_report)' name='federated.1lb1lis0lyvhsi19xy0to0xjqhds' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date-Gran' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1lb1lis0lyvhsi19xy0to0xjqhds'>
            <column caption='Date-Granularity ' datatype='string' name='[Calculation_1627699428064509952]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Year&apos; THEN STR(YEAR([created_date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN STR(YEAR([created_date_local])) + &quot;-&quot; + &quot;W&quot;+STR(WEEK([created_date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos; THEN STR(YEAR([created_date_local]))+ &quot;-&quot; + STR(MONTH([created_date_local]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Quarter&apos; THEN STR(YEAR([created_date_local])) + &quot;-&quot; + &quot;Q&quot;+STR(QUARTER([created_date_local]))&#10;ELSE  STR([created_date_local])&#10;END' />
            </column>
            <column caption='Supplier Type ' datatype='string' name='[Calculation_1627699428070952962]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([primary_supplier_name], &quot;(Consignment)&quot;) THEN &quot;Consignment&quot; ELSE &quot;Not Consignment&quot;  END' />
            </column>
            <column caption='Fresh/Non-Fresh' datatype='string' name='[Calculation_4352940185835630592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [subcategory] IN (&apos;Bread &amp; Bun&apos;, &apos;Borhani &amp; Laban&apos;, &apos;Butter &amp; Margarine&apos;, &apos;Cheese&apos;, &apos;Cream &amp; Whipped Toppings&apos;, &apos;Flavoured Milk&apos;, &apos;Liquid &amp; UHT Milk&apos;,&apos;Yoghurt&apos;,&#10;&apos;Bar-B-Q Meat&apos;,&apos;Beef&apos;,&apos;Chicken&apos;,&apos;Duck &amp; Goose&apos;,&apos;Egg&apos;,&apos;Mutton&apos;,&apos;Bar-B-Q Fish&apos;,&apos;Big Fish Portion (Bhaga)&#10;Chingri (Shrimp)&apos;,&apos;Cut &amp; Clean Frozen Fish&apos;,&apos;Dry Fish&apos;,&apos;Fresh Water Fish (Frozen)&apos;,&apos;Sea Fish (Frozen)&apos;,&apos;Dry Fruits&apos;,&apos;&#10;Fresh Fruits Imported&apos;,&apos;Fresh Fruits Local&apos;,&apos;Frozen Fruits&apos;,&apos;Fruits Basket &amp; Gifts&apos;,&apos;Hill Fruits&apos;,&apos;&#10;Home Made&apos;,&apos;&#10;Ready-to-Cook &amp; Ready-to-Eat&apos;,&#10;&apos;Liquid &amp; Patali Gur&apos;,&#10;&apos;Mishti&apos;,&#10;&apos;Fresh Vegetables&apos;,&#10;&apos;Frozen Vegetables&apos;,&#10;&apos;Hill Vegetable&apos;,&#10;&apos;Leafy Vegetable&apos;,&#10;&apos;Mushroom&apos;) THEN &apos;Fresh&apos; ELSE &apos;Non-Fresh&apos; END' />
            </column>
            <column caption='shrinkage_value' datatype='real' name='[Calculation_7994593034973061120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([adjustment_quantity]*[cost_price_local])' />
            </column>
            <column datatype='integer' name='[adjustment_quantity]' role='measure' type='quantitative' />
            <column caption='Adjustment Reason' datatype='string' name='[adjustment_reason]' role='dimension' type='nominal' />
            <column datatype='real' name='[adjustment_value]' role='measure' type='quantitative' />
            <column datatype='string' name='[category]' role='dimension' type='nominal' />
            <column datatype='real' name='[cost_price_local]' role='measure' type='quantitative' />
            <column datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
