      <column caption='COGS (Local)' datatype='real' name='[COGS_local]' role='measure' type='quantitative' />
      <column caption='Front Margin + Rebates %' datatype='real' default-format='p0.00%' name='[Calculation_1439463068726984704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn([Calculation_542683772878225408])+ zn([Calculation_429249380549820416])' />
      </column>
      <column caption='FM (Local)' datatype='real' default-format='C18441%' name='[Calculation_220676415182913536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if attr(left([month],4))= &quot;2023&quot;&#13;&#10;then sum([GFV_local])/1.08-sum([COGS_local])&#13;&#10;else&#13;&#10;sum([GFV_local])/1.09-sum([COGS_local])&#13;&#10;end' />
      </column>
      <column caption='Scan Rebates%' datatype='real' default-format='p0.00%' name='[Calculation_429249380549820416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR(LEFT([month], 4)) = &quot;2023&quot; THEN&#13;&#10;    SUM([Scan_rebates]) / (SUM([GFV_local]) / 1.08)&#13;&#10;ELSEIF ATTR(LEFT([month], 4)) = &quot;2024&quot; THEN&#13;&#10;    SUM([Scan_rebates]) / (SUM([GFV_local]) / 1.09)&#13;&#10;ELSEIF ATTR(LEFT([month], 4)) = &quot;2025&quot; THEN&#13;&#10;    SUM([Scan_rebates]) / (SUM([GFV_local]) / 1.09)&#13;&#10;END' />
      </column>
      <column caption='Category Two' datatype='string' name='[Calculation_429249380555468801]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Date-Gran (copy)] = &apos;FE&apos;&#13;&#10;THEN [sub_category]&#13;&#10;ELSE [master_category_two]&#13;&#10;END' />
      </column>
      <column caption='Category One' datatype='string' name='[Calculation_429249380555718658]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Date-Gran (copy)] = &apos;FE&apos;&#13;&#10;THEN [category]&#13;&#10;ELSE [master_category_one]&#13;&#10;END' />
      </column>
      <column caption='bp_category' datatype='real' default-format='p0.00%' name='[Calculation_455145075668664320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [month],[category]: countd([order_code])})/SUM({FIXED [month]: countd([order_code])})' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_455145075669057537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([order_code])' />
      </column>
      <column caption='bp_store' datatype='real' default-format='p0.00%' name='[Calculation_455145075690176514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [month],[category],[vendor_name]: countd([order_code])})/SUM({FIXED [month],[vendor_name]: countd([order_code])})' />
      </column>
      <column caption='GFV Contribution to Category' datatype='real' default-format='p0.00%' name='[Calculation_522699081951608832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([GFV_local])/SUM({FIXED [month],[category]: sum([GFV_local])})' />
      </column>
      <column caption='Front Margin%' datatype='real' default-format='p0.00%' name='[Calculation_542683772878225408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if attr(left([month],4))=&quot;2023&quot;&#13;&#10;then&#13;&#10;[Calculation_220676415182913536]/(sum([GFV_local])/1.08)&#13;&#10;else&#13;&#10;[Calculation_220676415182913536]/(sum([GFV_local])/1.09)&#13;&#10;end' />
      </column>
      <column caption='Front Margin+Rebates' datatype='real' default-format='C18441%' name='[Calculation_542683772878610433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn([Calculation_220676415182913536])+zn(sum([Scan_rebates]))' />
      </column>
      <column caption='Front Margin+Rebates % - old ' datatype='real' default-format='p0.00%' name='[Calculation_542683772878852098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if attr(left([month],4))=&quot;2023&quot;&#13;&#10;then&#13;&#10;[Calculation_542683772878610433]/(sum([GFV_local])/1.08)&#13;&#10;elseif attr(left([month],4))=&quot;2024&quot;&#13;&#10;then&#13;&#10;[Calculation_542683772878610433]/(sum([GFV_local])/1.09)&#13;&#10;end' />
      </column>
      <column caption='Units per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_542683772886249475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Quantity])/countd([order_code])' />
      </column>
      <column caption='Avg Selling Price' datatype='real' default-format='C18441%' name='[Calculation_542683772886753284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([GFV_local])/sum([Quantity])' />
      </column>
      <column caption='Avg Basket Size (Local)' datatype='real' default-format='C18441%' name='[Calculation_542683772887007237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([GFV_local])/COUNTD([order_code])' />
      </column>
      <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_542683772888080390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([order_code])/countd([customer_id])' />
      </column>
      <column caption='Customers' datatype='integer' name='[Calculation_817825583464480768]' role='measure' type='quantitative'>
