                <zone forceUpdate='true' h='76500' id='24' type-v2='text' w='45998' x='53335' y='22500'>
                  <formatted-text>
                    <run bold='true' fontcolor='#b91e9c' fontname='Tableau Bold' fontsize='12'>How Tos:</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontsize='8'>pandora Palette Reference:</run>
                    <run fontsize='8'> Figma pandora Identity </run>
                    <run auto-url='true' fontsize='8' hyperlink='tabdoc:load-url url=&amp;quot;https://www.figma.com/proto/I5utEftmzJpwTSLt98y69y/&amp;quot;'>https://www.figma.com/proto/I5utEftmzJpwTSLt98y69y/</run>
                    <run fontsize='8'>Æ </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='8'>For </run>
                    <run bold='true' fontsize='8'>the gradient header</run>
                    <run fontsize='8'>, you can refer to the gradient rectangle and take a screenshot that fits your dashboard width: </run>
                    <run auto-url='true' fontsize='8' hyperlink='tabdoc:load-url url=&amp;quot;https://drive.google.com/file/d/1IO8SSIbGWyQiNmIN2HUTr-IQ_36aEzNR/view&amp;quot;'>https://drive.google.com/file/d/1IO8SSIbGWyQiNmIN2HUTr-IQ_36aEzNR/view</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontsize='8'>Update </run>
                    <run bold='true' fontsize='8'>Preferences.tps (</run>
                    <run fontsize='8'>with Visual Studio Code or any IDE of choice</run>
                    <run bold='true' fontsize='8'>) </run>
                    <run fontsize='8'> to add pandora palette colours. Tutorial: </run>
                    <run auto-url='true' fontsize='8' hyperlink='tabdoc:load-url url=&amp;quot;https://help.tableau.com/current/pro/desktop/en-us/formatting_create_custom_colors.htm&amp;quot;'>https://help.tableau.com/current/pro/desktop/en-us/formatting_create_custom_colors.htm</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>&lt;?</run>
                    <run fontcolor='#e06c75' fontname='Menlo' fontsize='7'>xml</run>
                    <run fontcolor='#d19a66' fontname='Menlo' fontsize='7'> version</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>=</run>
                    <run fontcolor='#98c379' fontname='Menlo' fontsize='7'>&apos;1.0&apos;</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>?&gt;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>&lt;</run>
                    <run fontcolor='#e06c75' fontname='Menlo' fontsize='7'>workbook</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>&gt;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>&lt;</run>
                    <run fontcolor='#e06c75' fontname='Menlo' fontsize='7'>preferences</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>&gt;</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>&lt;</run>
                    <run fontcolor='#e06c75' fontname='Menlo' fontsize='7'>color-palette</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>Æ </run>
                    <run fontcolor='#d19a66' fontname='Menlo' fontsize='7'>name</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>=</run>
                    <run fontcolor='#98c379' fontname='Menlo' fontsize='7'>&quot;pandora colours&quot;</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>Æ </run>
                    <run fontcolor='#d19a66' fontname='Menlo' fontsize='7'>type</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>=</run>
                    <run fontcolor='#98c379' fontname='Menlo' fontsize='7'>&quot;regular&quot;</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>&gt;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>&lt;</run>
                    <run fontcolor='#e06c75' fontname='Menlo' fontsize='7'>color</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>&gt;#b8209d&lt;/</run>
                    <run fontcolor='#e06c75' fontname='Menlo' fontsize='7'>color</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>&gt;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>&lt;</run>
                    <run fontcolor='#e06c75' fontname='Menlo' fontsize='7'>color</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>&gt;#333333&lt;/</run>
                    <run fontcolor='#e06c75' fontname='Menlo' fontsize='7'>color</run>
                    <run fontcolor='#abb2bf' fontname='Menlo' fontsize='7'>&gt;</run>
                    <run>Æ&#10;</run>
