    <datasource caption='retention RCTCPQ' inline='true' name='federated.1x7e2ly10vnhvh1f5hfjy0xb9e7n (copy 4)' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1y17y6s0xj799b1ftryy61fp6ugb (copy 4)'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='server-custom' username='vanessa.goh@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1y17y6s0xj799b1ftryy61fp6ugb (copy 4)' name='Custom SQL Query' type='text'>#testing
WITH parameters AS (
  SELECT
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 13 MONTH), MONTH) AS start_date_extended,
    DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 13 MONTH), MONTH), INTERVAL 1 DAY) AS start_date_extended_utc,
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 13 MONTH), MONTH) AS start_date,
    DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL (7 - EXTRACT(DAYOFWEEK FROM CURRENT_DATE)) DAY), WEEK) AS end_date
),

countries AS (
  SELECT 
  countries.region_short_name,
  countries.country_code,
  countries.country_name,
  cities.id AS city_id,
  cities.name as city_name,
  cities.timezone as timezone
  FROM `fulfillment-dwh-production.curated_data_shared.countries` as countries
  LEFT JOIN UNNEST(countries.cities) AS cities
),

RCTCPQ AS (
  SELECT
    pt.region,
    pt.country_code,
    DATE_TRUNC(DATETIME(created_at,timezone), MONTH) AS month,
    qst.payment_rule_id AS rule_id,
    qst.quest_payment_rule_name AS quest_name,
    qst.status,
    rider_id,
    SUM(qst.total) AS total_paid,
    SUM(qst.total_eur) AS total_paid_eur
  FROM `fulfillment-dwh-production.curated_data_shared.rider_payments` pt
  LEFT JOIN UNNEST(pt.payment_details.quest) AS qst
  WHERE 
    pt.created_date &gt;&gt; (SELECT start_date_extended FROM parameters)
    AND pt.region IN (&apos;eu&apos;, &apos;ap&apos;)
  GROUP BY 
    pt.region, 
    pt.country_code, 
    month, 
    rule_id, 
    quest_name, 
    qst.status, 
    rider_id
  ORDER BY 
    total_paid DESC
),

quest_details AS (
SELECT 
  quest.country_code,
  id,
  payment_name AS quest_name2,
  DATE(DATETIME(end_date, timezone)) AS end_date
FROM `fulfillment-dwh-production.curated_data_shared.payments_quest_rules` quest
LEFT JOIN countries
  ON quest.country_code = countries.country_code
),

quest AS (
SELECT
  RCTCPQ.region,
  RCTCPQ.country_code AS lg_country_code,
  rider_id AS lg_rider_id,
  quest_name AS quest_name_to_riders,
  quest_name2 AS quest_name_internal,
  rule_id,
  end_date AS end_date_local,
  FORMAT_DATE(&apos;%G-%V&apos;,  end_date) AS report_week,
  total_paid
FROM RCTCPQ
LEFT JOIN quest_details
  ON RCTCPQ.rule_id = quest_details.id
  AND RCTCPQ.country_code = quest_details.country_code
WHERE RCTCPQ.country_code IN (&apos;bd&apos;,&apos;hk&apos;,&apos;kh&apos;,&apos;la&apos;,&apos;mm&apos;,&apos;my&apos;,&apos;sg&apos;,&apos;pk&apos;,&apos;ph&apos;,&apos;th&apos;,&apos;tw&apos;, &apos;tr&apos;, &apos;t3&apos;, &apos;no&apos;, &apos;se&apos;, &apos;fi&apos;, &apos;cz&apos;, &apos;at&apos;, &apos;hu&apos;)
  AND (
    quest_name2 LIKE &apos;%CPQ%&apos;
    OR quest_name2 LIKE &apos;%RCT%&apos;
    OR LOWER(quest_name2) LIKE &apos;%reactivation%&apos;
    OR LOWER(quest_name2) LIKE &apos;%retention%&apos;
    OR LOWER(quest_name2) LIKE &apos;%miss%&apos;
  )
  AND total_paid &gt;&gt; 0
ORDER BY region DESC, rule_id DESC
),

weekly_active_riders AS (
    SELECT
        DISTINCT
        FORMAT_DATE(&quot;%G-%V&quot;, DATE(report_date_local)) AS report_week,
        lg_country_code,
        city_name,
        lg_rider_id,
        is_activated
  FROM `fulfillment-dwh-production.pandata_report.pandora_lg_rider_status` AS daily_metrics
    WHERE is_active = TRUE 
    AND report_date_local BETWEEN (SELECT start_date_extended FROM parameters) AND (SELECT end_date FROM parameters) 
),

#unless there is an error here, where my data in weekly_active is less than quest
#suspect is the timezone that caused the difference x no, tried to convert to local time and it didnt work
all_active_weeks AS ( 
    SELECT 
    DISTINCT 
    tb1.report_week AS report_year_week,
    tb1.lg_country_code,
    tb1.lg_rider_id,
    tb2.report_week AS retention_year_week,
    quest_name_internal
    FROM quest AS tb1
    LEFT JOIN weekly_active_riders AS tb2 
    ON tb1.lg_rider_id = tb2.lg_rider_id
    AND tb2.report_week &gt;&gt;= tb1.report_week 
    AND tb1.lg_country_code = tb2.lg_country_code
),

#the join part is problematic
report_weekly AS (
  SELECT 
  report_year_week,
  lg_country_code,
  quest_name_internal,
  COUNT(DISTINCT lg_rider_id) AS weekly_active_riders 
  FROM all_active_weeks
  #WHERE retention_year_week = report_year_week
  GROUP BY 1,2,3
),

retention_weekly AS (
  SELECT 
  report_year_week,
  lg_country_code,
  quest_name_internal,
  retention_year_week,
  COUNT(lg_rider_id) AS weekly_retained_riders
  FROM all_active_weeks
  WHERE retention_year_week &gt;&gt;= report_year_week
  GROUP BY 1,2,3,4
),


combined AS (
  SELECT 
  rtm.lg_country_code,
  rtm.report_year_week, 
  rtm.quest_name_internal,
  weekly_active_riders,
  rtm.retention_year_week,
  weekly_retained_riders
  FROM retention_weekly rtm
  LEFT JOIN report_weekly rpm
  ON rtm.report_year_week = rpm.report_year_week
  AND rtm.lg_country_code = rpm.lg_country_code
  AND rtm.quest_name_internal = rpm.quest_name_internal
)


SELECT 
cb.lg_country_code, 
cb.report_year_week, 
cb.quest_name_internal,
cb.weekly_active_riders, 
cb.retention_year_week,
cb.weekly_retained_riders,
(CAST(SUBSTR(cb.retention_year_week, 1, 4) AS INT64) * 52 + CAST(SUBSTR(cb.retention_year_week, 6, 2) AS INT64)) -
    (CAST(SUBSTR(cb.report_year_week, 1, 4) AS INT64) * 52 + CAST(SUBSTR(cb.report_year_week, 6, 2) AS INT64)) AS week_diff
FROM combined cb
ORDER BY lg_country_code, report_year_week, retention_year_week, quest_name_internal</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1y17y6s0xj799b1ftryy61fp6ugb (copy 4)' name='Custom SQL Query' type='text'>#testing
WITH parameters AS (
