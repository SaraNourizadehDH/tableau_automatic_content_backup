        <metadata-records>
          <metadata-record class='column'>
            <remote-name>lg_country_code</remote-name>
            <remote-type>130</remote-type>
            <local-name>[lg_country_code]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>lg_country_code</remote-alias>
            <local-type>string</local-type>
