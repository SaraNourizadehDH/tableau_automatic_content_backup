      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_2B4DE9AF241F41C28907D727C79866E0'>
            <properties context=''>
              <relation connection='bigquery.1y17y6s0xj799b1ftryy61fp6ugb (copy 3)' name='Custom SQL Query' type='text'>WITH parameters AS (
  SELECT
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 13 MONTH), MONTH) AS start_date_extended,
    DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 13 MONTH), MONTH), INTERVAL 1 DAY) AS start_date_extended_utc,
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 13 MONTH), MONTH) AS start_date,
    DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL (7 - EXTRACT(DAYOFWEEK FROM CURRENT_DATE)) DAY), WEEK) AS end_date
),

monthly_active_riders AS (
    SELECT
        DISTINCT
        FORMAT_DATE(&apos;%Y-%m&apos;, DATE(report_date_local)) as report_month,
        lg_country_code,
        city_name,
        lg_rider_id,
        is_activated
  FROM `fulfillment-dwh-production.pandata_report.pandora_lg_rider_status` AS daily_metrics
    WHERE is_active = TRUE 
    AND report_date_local BETWEEN (SELECT start_date_extended FROM parameters) AND (SELECT end_date FROM parameters)
  
),

all_active_months AS (
    SELECT 
    DISTINCT 
    tb1.report_month AS report_year_month,
    tb1.lg_country_code,
    tb1.city_name,
    tb1.lg_rider_id,
    tb2.report_month AS retention_year_month
    FROM monthly_active_riders AS tb1
    LEFT JOIN monthly_active_riders AS tb2 
    ON tb1.lg_rider_id = tb2.lg_rider_id
    AND tb2.report_month &gt;&gt;= tb1.report_month 
),

all_active_months_nr AS (
    SELECT 
    DISTINCT 
    tb1.report_month AS report_year_month,
    tb1.lg_country_code,
    tb1.city_name,
    tb1.lg_rider_id,
    tb2.report_month AS retention_year_month
    FROM monthly_active_riders AS tb1
    LEFT JOIN monthly_active_riders AS tb2 
    ON tb1.lg_rider_id = tb2.lg_rider_id
    AND tb2.report_month &gt;&gt;= tb1.report_month
    WHERE tb1.is_activated = TRUE 
),

all_active_months_or AS (
    SELECT 
    DISTINCT 
    tb1.report_month AS report_year_month,
    tb1.lg_country_code,
    tb1.city_name,
    tb1.lg_rider_id,
    tb2.report_month AS retention_year_month
    FROM monthly_active_riders AS tb1
    LEFT JOIN monthly_active_riders AS tb2 
    ON tb1.lg_rider_id = tb2.lg_rider_id
    AND tb2.report_month &gt;&gt;= tb1.report_month
    WHERE NOT EXISTS (
    SELECT 1
    FROM all_active_months_nr t2
    WHERE tb1.lg_rider_id = t2.lg_rider_id 
    AND tb1.report_month = t2.report_year_month
  )
),

report_monthly AS (
  SELECT 
  report_year_month,
  lg_country_code,
  city_name,
  COUNT( DISTINCT lg_rider_id) as monthly_active_riders
  FROM all_active_months
  GROUP BY 1,2,3
),

report_monthly_or AS (
  SELECT 
  report_year_month,
  lg_country_code,
  city_name,
  COUNT( DISTINCT lg_rider_id) as monthly_active_riders
  FROM all_active_months_or
  GROUP BY 1,2,3
),

report_monthly_nr AS (
  SELECT 
  report_year_month,
  lg_country_code,
  city_name,
  COUNT( DISTINCT lg_rider_id) as monthly_active_riders
  FROM all_active_months_nr
  GROUP BY 1,2,3
),


retention_monthly AS (
  SELECT 
  report_year_month,
  lg_country_code,
  city_name,
  retention_year_month,
  COUNT(DISTINCT lg_rider_id) AS monthly_retained_riders
  FROM all_active_months
  WHERE retention_year_month &gt;&gt;= report_year_month
  GROUP BY 1,2,3,4
),

retention_monthly_or AS (
  SELECT 
  report_year_month,
  lg_country_code,
  city_name,
  retention_year_month,
  COUNT(DISTINCT lg_rider_id) AS monthly_retained_riders
  FROM all_active_months_or
  WHERE retention_year_month &gt;&gt;= report_year_month
  GROUP BY 1,2,3,4
),


retention_monthly_nr AS (
  SELECT 
  report_year_month,
  lg_country_code,
  city_name,
  retention_year_month,
  COUNT(DISTINCT lg_rider_id) AS monthly_retained_riders
  FROM all_active_months_nr
  WHERE retention_year_month &gt;&gt;= report_year_month
  GROUP BY 1,2,3,4
),

combined AS (
  SELECT 
  rtm.lg_country_code,
  rtm.city_name,
  rtm.report_year_month, 
  monthly_active_riders,
  rtm.retention_year_month,
  monthly_retained_riders
  FROM retention_monthly rtm
  LEFT JOIN report_monthly rpm
  ON rtm.report_year_month = rpm.report_year_month
  AND rtm.lg_country_code = rpm.lg_country_code
  AND rtm.city_name = rpm.city_name
),

combined_or AS (
  SELECT 
  rtm.lg_country_code,
  rtm.city_name,
  rtm.report_year_month, 
  monthly_active_riders,
  rtm.retention_year_month,
  monthly_retained_riders
  FROM retention_monthly_or rtm
  LEFT JOIN report_monthly_or rpm
  ON rtm.report_year_month = rpm.report_year_month
  AND rtm.lg_country_code = rpm.lg_country_code
  AND rtm.city_name = rpm.city_name
),

combined_nr AS (
  SELECT 
  rtm.lg_country_code,
  rtm.city_name,
  rtm.report_year_month, 
  monthly_active_riders,
  rtm.retention_year_month,
  monthly_retained_riders
  FROM retention_monthly_nr rtm
  LEFT JOIN report_monthly_nr rpm
  ON rtm.report_year_month = rpm.report_year_month
  AND rtm.lg_country_code = rpm.lg_country_code
  AND rtm.city_name = rpm.city_name
)

SELECT 
cb.lg_country_code, 
cb.city_name, 
cb.report_year_month, 
cb.monthly_active_riders, 
cb_or.monthly_active_riders AS monthly_active_riders_old ,
cb_nr.monthly_active_riders AS monthly_active_riders_new,
cb.retention_year_month, 
cb.monthly_retained_riders,
cb_or.monthly_retained_riders AS monthly_retained_riders_old,
cb_nr.monthly_retained_riders AS monthly_retained_riders_new,
DATE_DIFF(DATE(CONCAT(cb.retention_year_month, &apos;-01&apos;)), DATE(CONCAT(cb.report_year_month, &apos;-01&apos;)), MONTH) AS month_diff
FROM combined cb
LEFT JOIN combined_or cb_or
  ON cb.lg_country_code = cb_or.lg_country_code
  AND cb.city_name = cb_or.city_name
  AND cb.report_year_month = cb_or.report_year_month
  AND cb.retention_year_month = cb_or.retention_year_month
LEFT JOIN combined_nr cb_nr
  ON cb.lg_country_code = cb_nr.lg_country_code
  AND cb.city_name = cb_nr.city_name
  AND cb.report_year_month = cb_nr.report_year_month
  AND cb.retention_year_month = cb_nr.retention_year_month
ORDER BY report_year_month, retention_year_month</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
