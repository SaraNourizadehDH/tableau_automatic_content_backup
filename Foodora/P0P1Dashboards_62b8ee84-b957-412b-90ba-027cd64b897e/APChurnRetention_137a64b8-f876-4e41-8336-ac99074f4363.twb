            </column>
            <column caption='Weekly Riders Churn Rate Flag' datatype='string' default-format='*^' name='[Weekly Riders Churn Rate indicator (copy)_6731755611188506627]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Activated Week Select (copy 2)] = &apos;On&apos; THEN &#10;IF ZN(([Calculation_1513913227619115014])) - LOOKUP(ZN(([Calculation_1513913227619115014])), -1) &gt; &#10;0.1 * LOOKUP(ZN(([Calculation_1513913227619115014])), -1)  THEN  &apos;▲&apos;&#10;END END'>
                <table-calc ordering-type='Rows' />
