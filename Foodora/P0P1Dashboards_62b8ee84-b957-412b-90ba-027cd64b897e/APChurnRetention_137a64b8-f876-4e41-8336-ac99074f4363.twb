    <worksheet name='Weekly Country Reactivation (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Churn Rate (Churned/(Active L4W + Churned))</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Churn' name='federated.1x7e2ly10vnhvh1f5hfjy0xb9e7n' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Country/City Level ' datatype='string' name='[Select Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Select Granularity' datatype='string' name='[Select Month (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1x7e2ly10vnhvh1f5hfjy0xb9e7n'>
            <column caption='reactivation Active Riders Weekly' datatype='real' name='[Active Riders Weekly (copy)_6238752140310482946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([weekly_city_active_fleet_l4w])/7)' />
            </column>
            <column datatype='real' name='[CPH_month]' role='measure' type='quantitative' />
            <column caption='Selected Granularity' datatype='string' name='[Calculation_1974828502025793538]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Select Month (copy 2)]' />
            </column>
            <column caption='Selected Country/City Level' datatype='string' name='[Calculation_1974828502063017990]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Select Granularity (copy)]' />
            </column>
            <column caption='report_week' datatype='string' name='[Calculation_399835239438876681]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [tb_report_week_parameter])) + &quot;-&quot; + &#10;RIGHT(&quot;00&quot; + STR(DATEPART(&apos;week&apos;, [tb_report_week_parameter])), 2)' />
            </column>
            <column caption='CPH month' datatype='real' name='[Calculation_807903620485681153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR([CPH_month])' />
            </column>
            <column caption='Reactivated Riders' datatype='integer' name='[Churned Riders (copy)_6238752140307214336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([city_reactivated_rider_count], 0)' />
            </column>
            <column caption='Monthly CPH indicator' datatype='string' default-format='p0.0%' name='[Monthly Riders Churn Rate indicator (copy)_1136877499549802496]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ZN(([Calculation_807903620485681153])) &gt; LOOKUP(ZN(([Calculation_807903620485681153])), -1) THEN &apos;▲&apos;&#10;ELSEIF ZN(([Calculation_807903620485681153])) &lt; LOOKUP(ZN(([Calculation_807903620485681153])), -1) THEN &apos;▼&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Weekly Riders Reactivation Rate' datatype='real' default-format='p0.0%' name='[Weekly Riders Churn Rate (copy)_6238752140307435521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Churned Riders (copy)_6238752140307214336])/&#10;&#10;((SUM([weekly_city_active_fleet_l4w])/7) + SUM([Churned Riders (copy)_6238752140307214336]))' />
            </column>
            <column caption='Weekly Riders Reactivation Rate indicator' datatype='string' default-format='p0.0%' name='[Weekly Riders Churn Rate indicator (copy)_6238752140319465479]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ZN(([Weekly Riders Churn Rate (copy)_6238752140307435521])) &gt; LOOKUP(ZN(([Weekly Riders Churn Rate (copy)_6238752140307435521])), -1) THEN &apos;▲&apos;&#10;ELSEIF ZN(([Weekly Riders Churn Rate (copy)_6238752140307435521])) &lt; LOOKUP(ZN(([Weekly Riders Churn Rate (copy)_6238752140307435521])), -1) THEN &apos;▼&apos;&#10;ELSE &apos;&apos;&#10;END'>
