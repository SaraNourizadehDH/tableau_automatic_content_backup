              <calculation class='tableau' formula='IF ZN(([Calculation_1513913227619115014])) &gt; LOOKUP(ZN(([Calculation_1513913227619115014])), -1) THEN &apos;▲&apos;&#10;ELSEIF ZN(([Calculation_1513913227619115014])) &lt; LOOKUP(ZN(([Calculation_1513913227619115014])), -1) THEN &apos;▼&apos;&#10;ELSE &apos;&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
