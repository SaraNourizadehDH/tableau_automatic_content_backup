    <worksheet name='Monthly Country Reactivation (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Churn Rate (Churned/(Active L4W + Churned))</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Churn' name='federated.1x7e2ly10vnhvh1f5hfjy0xb9e7n' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Highlight increase by 10%' datatype='string' name='[Activated Week Select (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;On&quot;'>
              <calculation class='tableau' formula='&quot;On&quot;' />
            </column>
            <column caption='Country/City Level ' datatype='string' name='[Select Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Select Granularity' datatype='string' name='[Select Month (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1x7e2ly10vnhvh1f5hfjy0xb9e7n'>
            <column caption='Re Active Riders Monthly  Country' datatype='integer' name='[Active Riders Monthly  Country (copy 2)_6238752140312666115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR([monthly_country_unique_riders])' />
            </column>
            <column caption='Active Riders Monthly Country (copy)' datatype='real' default-format='p0.0%' name='[Active Riders Monthly  Country (copy)_6731755611201040389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([city_churned_rider_count])/ &#10;(SUM({FIXED[lg_country_code (copy)_399835239485263902],[report_month_local]: AVG([monthly_country_unique_riders])}) + SUM([city_churned_rider_count]))' />
            </column>
            <column caption='Reactivated Riders Monthly Country (copy)' datatype='real' default-format='p0.0%' name='[Active Riders Monthly Country (copy) (copy)_6238752140312907780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Churned Riders (copy)_6238752140307214336])/ &#10;(SUM({FIXED[lg_country_code (copy)_399835239485263902],[report_month_local]: AVG([monthly_country_unique_riders])}) + SUM([Churned Riders (copy)_6238752140307214336]))' />
            </column>
            <column caption='report_month_date' datatype='date' datatype-customized='true' name='[Calculation_118500990561665024]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEPARSE(&quot;yyyy-MM&quot;, [report_month_local]))' />
            </column>
            <column caption='cell' datatype='integer' name='[Calculation_1932607191017431043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Selected Granularity' datatype='string' name='[Calculation_1974828502025793538]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Select Month (copy 2)]' />
            </column>
            <column caption='Selected Country/City Level' datatype='string' name='[Calculation_1974828502063017990]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Select Granularity (copy)]' />
            </column>
            <column caption='Reactivated Riders' datatype='integer' name='[Churned Riders (copy)_6238752140307214336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([city_reactivated_rider_count], 0)' />
            </column>
            <column caption='Monthly Riders Reactivation Rate Country indicator' datatype='string' default-format='p0.0%' name='[Monthly Riders Churn Rate Country indicator (copy)_6238752140320088073]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ZN(([Active Riders Monthly Country (copy) (copy)_6238752140312907780])) &gt; LOOKUP(ZN(([Active Riders Monthly Country (copy) (copy)_6238752140312907780])), -1) THEN &apos;▲&apos;&#10;ELSEIF ZN(([Active Riders Monthly Country (copy) (copy)_6238752140312907780])) &lt; LOOKUP(ZN(([Active Riders Monthly Country (copy) (copy)_6238752140312907780])), -1) THEN &apos;▼&apos;&#10;ELSE &apos;&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Monthly Churn Rate Country Flag ' datatype='string' default-format='*^' name='[Monthly Riders Churn Rate Country indicator (copy)_6731755611181899777]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Activated Week Select (copy 2)] = &apos;On&apos; THEN &#10;IF ZN(([Active Riders Monthly  Country (copy)_6731755611201040389])) - LOOKUP(ZN(([Active Riders Monthly  Country (copy)_6731755611201040389])), -1) &#10;&gt;= 0.1 * LOOKUP(ZN(([Active Riders Monthly  Country (copy)_6731755611201040389])), -1)  THEN &apos;▲&apos;&#10;END&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='integer' name='[city_churned_rider_count]' role='measure' type='quantitative' />
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='integer' name='[city_reactivated_rider_count]' role='measure' type='quantitative' />
            <column caption='lg_country_code (copy)' datatype='string' name='[lg_country_code (copy)_1974828502058340357]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[lg_country_code]' />
