    <worksheet name='Monthly City Churn'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Churn Rate (Churned/(Active L4W + Churned))</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Churn' name='federated.1x7e2ly10vnhvh1f5hfjy0xb9e7n' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Highlight increase by 10%' datatype='string' name='[Activated Week Select (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;On&quot;'>
              <calculation class='tableau' formula='&quot;On&quot;' />
            </column>
            <column caption='Country/City Level ' datatype='string' name='[Select Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Select Granularity' datatype='string' name='[Select Month (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1x7e2ly10vnhvh1f5hfjy0xb9e7n'>
            <column caption='Active Riders Monthly ' datatype='integer' name='[Active Riders Weekly (copy)_1974828502319185929]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ATTR([monthly_city_unique_riders])' />
            </column>
            <column caption='report_month_date' datatype='date' datatype-customized='true' name='[Calculation_118500990561665024]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEPARSE(&quot;yyyy-MM&quot;, [report_month_local]))' />
            </column>
            <column caption='cell' datatype='integer' name='[Calculation_1932607191017431043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Selected Granularity' datatype='string' name='[Calculation_1974828502025793538]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Select Month (copy 2)]' />
            </column>
            <column caption='Selected Country/City Level' datatype='string' name='[Calculation_1974828502063017990]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Select Granularity (copy)]' />
            </column>
            <column caption='Monthly Riders Churn Rate Flag' datatype='string' default-format='p0.0%' name='[Monthly Riders Churn Rate indicator (copy)_6731755611188404226]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Activated Week Select (copy 2)] = &apos;On&apos; THEN &#10;IF ZN(([Riders Churn Rate (copy)_1513913227651276811])) - LOOKUP(ZN(([Riders Churn Rate (copy)_1513913227651276811])), -1) &#10;&gt;  0.1 * LOOKUP(ZN(([Riders Churn Rate (copy)_1513913227651276811])), -1) THEN &apos;▲&apos;&#10;&#10;END END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Monthly Riders Churn Rate' datatype='real' default-format='p0.0%' name='[Riders Churn Rate (copy)_1513913227651276811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([city_churned_rider_count])/&#10;&#10;(ATTR([monthly_city_unique_riders]) + SUM([city_churned_rider_count]))' />
            </column>
            <column caption='Monthly Riders Churn Rate indicator' datatype='string' default-format='p0.0%' name='[Weekly Riders Churn Rate indicator (copy)_6512345866584768514]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ZN(([Riders Churn Rate (copy)_1513913227651276811])) &gt; LOOKUP(ZN(([Riders Churn Rate (copy)_1513913227651276811])), -1) THEN &apos;▲&apos;&#10;ELSEIF ZN(([Riders Churn Rate (copy)_1513913227651276811])) &lt; LOOKUP(ZN(([Riders Churn Rate (copy)_1513913227651276811])), -1) THEN  &apos;▼&apos;&#10;ELSE &apos;&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='integer' name='[city_churned_rider_count]' role='measure' type='quantitative' />
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='lg_country_code (copy)' datatype='string' name='[lg_country_code (copy)_1974828502058340357]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[lg_country_code]' />
            </column>
            <column datatype='string' name='[lg_country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_1932607191017431043]' derivation='Min' name='[min:Calculation_1932607191017431043:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[monthly_city_unique_riders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_118500990561665024]' derivation='None' name='[none:Calculation_118500990561665024:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1974828502025793538]' derivation='None' name='[none:Calculation_1974828502025793538:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1974828502063017990]' derivation='None' name='[none:Calculation_1974828502063017990:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[lg_country_code (copy)_1974828502058340357]' derivation='None' name='[none:lg_country_code (copy)_1974828502058340357:nk]' pivot='key' type='nominal' />
            <column-instance column='[lg_country_code]' derivation='None' name='[none:lg_country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_month_local]' derivation='None' name='[none:report_month_local:nk]' pivot='key' type='nominal' />
            <column caption='report_month' datatype='string' name='[report_month_local]' role='dimension' type='nominal' />
            <column-instance column='[city_churned_rider_count]' derivation='Sum' name='[sum:city_churned_rider_count:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Active Riders Weekly (copy)_1974828502319185929]' derivation='User' name='[usr:Active Riders Weekly (copy)_1974828502319185929:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Monthly Riders Churn Rate indicator (copy)_6731755611188404226]' derivation='User' name='[usr:Monthly Riders Churn Rate indicator (copy)_6731755611188404226:nk]' pivot='key' type='nominal'>
