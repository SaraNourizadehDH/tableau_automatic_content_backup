    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Weekly RCTCPQ Retention'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APChurnRetention/WeeklyRCTCPQRetention?rev=' id='WeeklyRCTCPQRetention' path='/t/Foodora/workbooks/APChurnRetention' revision='' site='Foodora' />
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' sizing-mode='fixed' />
      <datasources>
        <datasource caption='retention RCTCPQ' name='federated.1x7e2ly10vnhvh1f5hfjy0xb9e7n (copy 4)' />
      </datasources>
      <datasource-dependencies datasource='federated.1x7e2ly10vnhvh1f5hfjy0xb9e7n (copy 4)'>
        <column caption='first_day_of_report_week' datatype='date' name='[Calculation_5975080504445501440]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='DATE(DATEPARSE(&quot;yyyy-ww&quot;, [report_year_week]) - (DATEPART(&apos;weekday&apos;, DATEPARSE(&quot;yyyy-ww&quot;, [report_year_week])) + 5) % 7)' />
        </column>
        <column datatype='string' name='[lg_country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column-instance column='[Calculation_5975080504445501440]' derivation='None' name='[none:Calculation_5975080504445501440:qk]' pivot='key' type='quantitative' />
