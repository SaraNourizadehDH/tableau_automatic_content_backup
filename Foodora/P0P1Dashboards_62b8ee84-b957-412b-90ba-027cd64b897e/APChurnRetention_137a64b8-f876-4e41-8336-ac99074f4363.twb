        <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1x7e2ly10vnhvh1f5hfjy0xb9e7n].[Calculation_338332948179836929]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1x7e2ly10vnhvh1f5hfjy0xb9e7n].[tb_report_week_parameter]' caption='Select Week' datatype='date' default-format='*yyyy\ \Www' name='[Select Month (copy)]' param-domain-type='list' role='measure' type='quantitative' value='#2025-06-02#'>
          <calculation class='tableau' formula='#2025-06-02#' />
