            </column>
            <column caption='Reactivated Riders' datatype='integer' name='[Churned Riders (copy)_6238752140307214336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([city_reactivated_rider_count], 0)' />
            </column>
            <column caption='Monthly Riders Reactivation Rate Country indicator' datatype='string' default-format='p0.0%' name='[Monthly Riders Churn Rate Country indicator (copy)_6238752140320088073]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ZN(([Active Riders Monthly Country (copy) (copy)_6238752140312907780])) &gt; LOOKUP(ZN(([Active Riders Monthly Country (copy) (copy)_6238752140312907780])), -1) THEN &apos;▲&apos;&#10;ELSEIF ZN(([Active Riders Monthly Country (copy) (copy)_6238752140312907780])) &lt; LOOKUP(ZN(([Active Riders Monthly Country (copy) (copy)_6238752140312907780])), -1) THEN &apos;▼&apos;&#10;ELSE &apos;&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Monthly Churn Rate Country Flag ' datatype='string' default-format='*^' name='[Monthly Riders Churn Rate Country indicator (copy)_6731755611181899777]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Activated Week Select (copy 2)] = &apos;On&apos; THEN &#10;IF ZN(([Active Riders Monthly  Country (copy)_6731755611201040389])) - LOOKUP(ZN(([Active Riders Monthly  Country (copy)_6731755611201040389])), -1) &#10;&gt;= 0.1 * LOOKUP(ZN(([Active Riders Monthly  Country (copy)_6731755611201040389])), -1)  THEN &apos;▲&apos;&#10;END&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
