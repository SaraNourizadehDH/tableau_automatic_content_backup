        <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1x7e2ly10vnhvh1f5hfjy0xb9e7n].[MAX month (copy)_464152279307018242]' _.fcp.ParameterDefaultValues.true...source-field='[federated.1x7e2ly10vnhvh1f5hfjy0xb9e7n].[report_month_date (copy)_310396573007093760]' caption='Select Comparison Month' datatype='date' default-format='*MMM yyyy' name='[Select Month (copy 4)_464152279296569344]' param-domain-type='list' role='measure' type='quantitative' value='#2025-08-22#'>
          <calculation class='tableau' formula='#2025-08-22#' />
