  FROM `fulfillment-dwh-production.curated_data_shared.countries` as countries
  LEFT JOIN UNNEST(countries.cities) AS cities
),

RCTCPQ AS (
  SELECT
    pt.region,
    pt.country_code,
    DATE_TRUNC(DATETIME(created_at,timezone), MONTH) AS month,
    qst.payment_rule_id AS rule_id,
    qst.quest_payment_rule_name AS quest_name,
    qst.status,
    rider_id,
