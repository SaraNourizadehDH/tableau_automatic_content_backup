      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_2B4DE9AF241F41C28907D727C79866E0'>
            <properties context=''>
              <relation connection='bigquery.1y17y6s0xj799b1ftryy61fp6ugb' name='Custom SQL Query' type='text'><![CDATA[WITH parameters AS (
  SELECT
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 13 MONTH), MONTH) AS start_date_extended,
    DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 13 MONTH), MONTH), INTERVAL 1 DAY) AS start_date_extended_utc,
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 12 MONTH), MONTH) AS start_date,
    DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL (7 - EXTRACT(DAYOFWEEK FROM CURRENT_DATE)) DAY), WEEK) AS end_date
),


rider_supply AS (
SELECT
  lg_country_code,
  city_name,
  date_local,
  daily_unique_riders,
  active_riders_l28d,
  report_month AS report_month_local,
  report_week AS report_week_local,
  reactivated_riders,
  churned_riders ,
  PARSE_DATE("%G-%V", report_week) AS report_week_date_local,
  weekly_city_unique_riders,
  monthly_city_unique_riders,
  weekly_city_active_fleet_l4w,
  monthly_country_unique_riders,
  weekly_country_active_fleet_l4w,
  weekly_country_unique_riders
FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_rider_supply`
WHERE date_local BETWEEN (SELECT start_date_extended FROM parameters) AND (SELECT end_date FROM parameters)
),

churn AS (
SELECT 
date_local,
daily_unique_riders,
lg_country_code,
city_name,
report_month_local,
report_week_local,
report_week_date_local,
active_riders_l28d,
monthly_country_unique_riders,

CASE
WHEN report_month_local >> FORMAT_DATE("%Y-%m", (SELECT start_date FROM parameters)) AND report_month_local << FORMAT_DATE("%Y-%m",  CURRENT_DATE) THEN report_month_local
END AS tb_report_month_parameter,
CASE
WHEN report_week_date_local >>= DATE_TRUNC((SELECT start_date FROM parameters), WEEK) THEN report_week_date_local
END AS tb_report_week_parameter,
rider_supply.reactivated_riders AS city_reactivated_rider_count,
rider_supply.churned_riders AS city_churned_rider_count,



weekly_city_unique_riders,
monthly_city_unique_riders,
weekly_city_active_fleet_l4w,
weekly_country_active_fleet_l4w,
weekly_country_unique_riders
FROM rider_supply

ORDER BY lg_country_code, city_name, tb_report_week_parameter
),

cph_week AS (
  SELECT 
  lg_country_code,
  FORMAT_DATE('%G-%V', DATE(report_date)) AS report_week_local,
  #FORMAT_DATE("%Y-%m", DATE(report_date)) AS report_month,
  SUM(cost_eur) as Cost_week, 
  SUM(hires) AS Hires_week, 
  SUM(leads) AS Leads_week,
  SUM(completed_orders) AS Orders_week,
  SAFE_DIVIDE(SUM(cost_eur), SUM(hires)) AS CPH_week
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_tb_rider_supply_marketing` 
  WHERE report_date BETWEEN (SELECT start_date_extended FROM parameters) AND (SELECT end_date FROM parameters)
  AND marketing_type NOT LIKE "Branding"
  GROUP BY 1, 2
),

cph_month AS (
  SELECT 
  lg_country_code,
  FORMAT_DATE("%Y-%m", DATE(report_date)) AS report_month_local,
  SUM(cost_eur) as Cost_month, 
  SUM(hires) AS Hires_month, 
  SUM(leads) AS Leads_month,
  SUM(completed_orders) AS Orders_month,
  SAFE_DIVIDE(SUM(cost_eur), SUM(hires)) AS CPH_month
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_tb_rider_supply_marketing` 
  WHERE report_date BETWEEN (SELECT start_date_extended FROM parameters) AND (SELECT end_date FROM parameters)
  AND marketing_type NOT LIKE "Branding"
  GROUP BY 1, 2
)




#can only do it on a country level as some budgets are allocated for all countries
SELECT 
    DISTINCT
    rs.date_local,
    daily_unique_riders,
    rs.lg_country_code,
    rs.city_name,
    rs.report_month_local,
    rs.report_week_local,
    rs.report_week_date_local,
    active_riders_l28d,
    cost_month,
    hires_month,
    CPH_month,
    cost_week,
    hires_week,
    CPH_week,
    monthly_country_unique_riders,
    CASE
    WHEN report_week_date_local >>= DATE_TRUNC((SELECT start_date FROM parameters), WEEK) THEN report_week_date_local
    END AS tb_report_week_parameter,
    rs.reactivated_riders AS city_reactivated_rider_count,
    rs.churned_riders AS city_churned_rider_count,

    weekly_city_unique_riders,
    monthly_city_unique_riders,
    weekly_city_active_fleet_l4w,
    weekly_country_active_fleet_l4w,
    weekly_country_unique_riders
  FROM rider_supply rs
  LEFT JOIN cph_month cm
  ON rs.report_month_local = cm.report_month_local
  AND rs.lg_country_code = cm.lg_country_code
  LEFT JOIN cph_week cw
  ON rs.report_week_local = cw.report_week_local
  AND rs.lg_country_code = cw.lg_country_code
  order by report_month_local, report_week_local]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='retention' inline='true' name='federated.1x7e2ly10vnhvh1f5hfjy0xb9e7n (copy 2)' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1y17y6s0xj799b1ftryy61fp6ugb (copy 2)'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='server-custom' username='vanessa.goh@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1y17y6s0xj799b1ftryy61fp6ugb (copy 2)' name='Custom SQL Query' type='text'>WITH parameters AS (
  SELECT
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 13 MONTH), MONTH) AS start_date_extended,
    DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 13 MONTH), MONTH), INTERVAL 1 DAY) AS start_date_extended_utc,
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 13 MONTH), MONTH) AS start_date,
    DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL (7 - EXTRACT(DAYOFWEEK FROM CURRENT_DATE)) DAY), WEEK) AS end_date
),

weekly_active_riders AS (
    SELECT
        DISTINCT
        FORMAT_DATE(&quot;%G-%V&quot;, DATE(report_date_local)) AS report_week,
        lg_country_code,
        city_name,
        lg_rider_id,
        is_activated
  FROM `fulfillment-dwh-production.pandata_report.pandora_lg_rider_status` AS daily_metrics
    WHERE is_active = TRUE 
    #AND lg_country_code = &apos;sg&apos;
    AND report_date_local BETWEEN (SELECT start_date_extended FROM parameters) AND (SELECT end_date FROM parameters) 
),

all_active_weeks AS (
    SELECT 
    DISTINCT 
    tb1.report_week AS report_year_week,
    tb1.lg_country_code,
    tb1.city_name,
    tb1.lg_rider_id,
    tb2.report_week AS retention_year_week
    FROM weekly_active_riders AS tb1
    LEFT JOIN weekly_active_riders AS tb2 
    ON tb1.lg_rider_id = tb2.lg_rider_id
    AND tb2.report_week &gt;&gt;= tb1.report_week 
),


all_active_weeks_nr AS (
    SELECT 
    DISTINCT 
    tb1.report_week AS report_year_week,
    tb1.lg_country_code,
    tb1.city_name,
    tb1.lg_rider_id,
    tb2.report_week AS retention_year_week
    FROM weekly_active_riders AS tb1
    LEFT JOIN weekly_active_riders AS tb2 
    ON tb1.lg_rider_id = tb2.lg_rider_id
    AND tb2.report_week &gt;&gt;= tb1.report_week
    WHERE tb1.is_activated = TRUE 
),

#this is the issue
all_active_weeks_or AS (
    SELECT 
    DISTINCT 
    tb1.report_week AS report_year_week,
    tb1.lg_country_code,
    tb1.city_name,
    tb1.lg_rider_id,
    tb2.report_week AS retention_year_week
    FROM weekly_active_riders AS tb1
    LEFT JOIN weekly_active_riders AS tb2 
    ON tb1.lg_rider_id = tb2.lg_rider_id
    AND tb2.report_week &gt;&gt;= tb1.report_week
    WHERE NOT EXISTS (
      SELECT 1
      FROM all_active_weeks_nr t2
      WHERE tb1.lg_rider_id = t2.lg_rider_id 
      AND tb1.report_week = t2.report_year_week
    ) 
),


report_monthly AS (
  SELECT 
  report_year_week,
  lg_country_code,
  city_name,
  COUNT( DISTINCT lg_rider_id) as weekly_active_riders
  FROM all_active_weeks
  GROUP BY 1,2,3
),

report_monthly_or AS (
  SELECT 
  report_year_week,
  lg_country_code,
  city_name,
  COUNT( DISTINCT lg_rider_id) as weekly_active_riders
  FROM all_active_weeks_or
  GROUP BY 1,2,3
),

report_monthly_nr AS (
  SELECT 
  report_year_week,
  lg_country_code,
  city_name,
  COUNT( DISTINCT lg_rider_id) as weekly_active_riders
  FROM all_active_weeks_nr
  GROUP BY 1,2,3
),


retention_monthly AS (
  SELECT 
  report_year_week,
  lg_country_code,
  city_name,
  retention_year_week,
  COUNT(DISTINCT lg_rider_id) AS weekly_retained_riders
  FROM all_active_weeks
  WHERE retention_year_week &gt;&gt;= report_year_week
  GROUP BY 1,2,3,4
),

retention_monthly_or AS (
  SELECT 
  report_year_week,
  lg_country_code,
  city_name,
  retention_year_week,
  COUNT(DISTINCT lg_rider_id) AS weekly_retained_riders
  FROM all_active_weeks_or
  WHERE retention_year_week &gt;&gt;= report_year_week
  GROUP BY 1,2,3,4
),


retention_monthly_nr AS (
  SELECT 
  report_year_week,
  lg_country_code,
  city_name,
  retention_year_week,
  COUNT(DISTINCT lg_rider_id) AS weekly_retained_riders
  FROM all_active_weeks_nr
  WHERE retention_year_week &gt;&gt;= report_year_week
  GROUP BY 1,2,3,4
),

combined AS (
  SELECT 
  rtm.lg_country_code,
  rtm.city_name,
  rtm.report_year_week, 
  weekly_active_riders,
  rtm.retention_year_week,
  weekly_retained_riders
  FROM retention_monthly rtm
  LEFT JOIN report_monthly rpm
  ON rtm.report_year_week = rpm.report_year_week
  AND rtm.lg_country_code = rpm.lg_country_code
  AND rtm.city_name = rpm.city_name
),

combined_or AS (
  SELECT 
  rtm.lg_country_code,
  rtm.city_name,
  rtm.report_year_week, 
  weekly_active_riders,
  rtm.retention_year_week,
  weekly_retained_riders
  FROM retention_monthly_or rtm
  LEFT JOIN report_monthly_or rpm
  ON rtm.report_year_week = rpm.report_year_week
  AND rtm.lg_country_code = rpm.lg_country_code
  AND rtm.city_name = rpm.city_name
),

combined_nr AS (
  SELECT 
  rtm.lg_country_code,
  rtm.city_name,
  rtm.report_year_week, 
  weekly_active_riders,
  rtm.retention_year_week,
  weekly_retained_riders
  FROM retention_monthly_nr rtm
  LEFT JOIN report_monthly_nr rpm
  ON rtm.report_year_week = rpm.report_year_week
  AND rtm.lg_country_code = rpm.lg_country_code
  AND rtm.city_name = rpm.city_name
)

SELECT 
cb.lg_country_code, 
cb.city_name, 
cb.report_year_week, 
cb.weekly_active_riders, 
cb_or.weekly_active_riders AS weekly_active_riders_old ,
cb_nr.weekly_active_riders AS weekly_active_riders_new,
cb.retention_year_week,
cb.weekly_retained_riders,
cb_or.weekly_retained_riders AS weekly_retained_riders_old,
cb_nr.weekly_retained_riders AS weekly_retained_riders_new,
(CAST(SUBSTR(cb.retention_year_week, 1, 4) AS INT64) * 52 + CAST(SUBSTR(cb.retention_year_week, 6, 2) AS INT64)) -
    (CAST(SUBSTR(cb.report_year_week, 1, 4) AS INT64) * 52 + CAST(SUBSTR(cb.report_year_week, 6, 2) AS INT64)) AS week_diff
FROM combined cb
LEFT JOIN combined_or cb_or
  ON cb.lg_country_code = cb_or.lg_country_code
  AND cb.city_name = cb_or.city_name
  AND cb.report_year_week = cb_or.report_year_week
  AND cb.retention_year_week = cb_or.retention_year_week
LEFT JOIN combined_nr cb_nr
  ON cb.lg_country_code = cb_nr.lg_country_code
  AND cb.city_name = cb_nr.city_name
  AND cb.report_year_week = cb_nr.report_year_week
  AND cb.retention_year_week = cb_nr.retention_year_week
ORDER BY report_year_week, retention_year_week</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
