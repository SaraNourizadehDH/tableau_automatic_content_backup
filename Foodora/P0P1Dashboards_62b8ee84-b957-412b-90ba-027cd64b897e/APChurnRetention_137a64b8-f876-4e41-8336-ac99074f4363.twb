          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Highlight increase by 10%' datatype='string' name='[Activated Week Select (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;On&quot;'>
              <calculation class='tableau' formula='&quot;On&quot;' />
            </column>
            <column caption='Country/City Level ' datatype='string' name='[Select Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
