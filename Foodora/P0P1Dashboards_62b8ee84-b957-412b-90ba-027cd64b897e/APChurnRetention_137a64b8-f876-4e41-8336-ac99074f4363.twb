            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1x7e2ly10vnhvh1f5hfjy0xb9e7n'>
            <column caption='Active Riders Weekly' datatype='real' name='[Active Riders (Current) (copy)_1513913227637248007]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([weekly_city_active_fleet_l4w])/7))' />
            </column>
            <column caption='Weekly Riders Churn Rate' datatype='real' default-format='p0.0%' name='[Calculation_1513913227619115014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Churned Riders (Current) (copy)_5763270564644790283])/&#10;&#10;((SUM([weekly_city_active_fleet_l4w])/7) + SUM([Churned Riders (Current) (copy)_5763270564644790283]))' />
            </column>
            <column caption='cell' datatype='integer' name='[Calculation_1932607191017431043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Selected Granularity' datatype='string' name='[Calculation_1974828502025793538]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Select Month (copy 2)]' />
