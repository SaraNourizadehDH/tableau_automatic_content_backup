            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='integer' name='[city_reactivated_rider_count]' role='measure' type='quantitative' />
            <column caption='lg_country_code (copy)' datatype='string' name='[lg_country_code (copy)_1974828502058340357]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
