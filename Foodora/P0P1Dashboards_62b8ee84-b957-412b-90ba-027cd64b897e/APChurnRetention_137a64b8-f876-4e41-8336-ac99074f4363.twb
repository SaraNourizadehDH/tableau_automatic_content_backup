      <column caption='Select Week Filter' datatype='boolean' name='[Calculation_1939925567040372739]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Select Month (copy 2)] = &apos;Week&apos;' />
      </column>
      <column caption='[DUMMY for Parameter Hiding]' datatype='string' name='[Calculation_1939925567041085444]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Current Time Period' datatype='string' datatype-customized='true' name='[Calculation_1939925567050874886]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&#10;    IF [Parameters].[Select Month (copy 2)] = &apos;Month&apos; THEN&#10;        DATENAME(&apos;month&apos;, [Parameters].[Parameter 1]) + &quot; &quot; + STR(YEAR([Parameters].[Parameter 1]))&#10;    ELSE&#10;        STR(YEAR([Parameters].[Select Month (copy)])) + &quot; W&quot; + STR(DATEPART(&apos;week&apos;, [Parameters].[Select Month (copy)]))&#10;    END&#10;)' />
      </column>
      <column caption='Selected Granularity' datatype='string' name='[Calculation_1974828502025793538]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Select Month (copy 2)]' />
      </column>
      <column caption='Selected Country/City Level' datatype='string' name='[Calculation_1974828502063017990]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Select Granularity (copy)]' />
      </column>
      <column caption='Previous Time Period' datatype='string' name='[Calculation_2043860202213212160]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&#10;    IF [Parameters].[Select Month (copy 2)] = &apos;Month&apos; THEN&#10;        DATENAME(&apos;month&apos;, [Parameters].[Select Month (copy 4)_464152279296569344]) + &quot; &quot; + STR(YEAR(DATETRUNC(&apos;month&apos;, [Parameters].[Select Month (copy 4)_464152279296569344])))&#10;    ELSE&#10;        STR(YEAR([Parameters].[Select Week (copy)_464152279296860161])) + &quot; W&quot; + STR(DATEPART(&apos;week&apos;, [Parameters].[Select Week (copy)_464152279296860161]))&#10;    END&#10;)' />
      </column>
      <column caption='report week active riders' datatype='real' name='[Calculation_3709980996759482372]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM({FIXED [lg_country_code],[city_name],[report_year_week], [weekly_active_riders]: AVG([weekly_active_riders])})' />
