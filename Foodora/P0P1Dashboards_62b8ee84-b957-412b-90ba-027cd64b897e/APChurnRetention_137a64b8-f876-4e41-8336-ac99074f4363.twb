      <column caption='(tool tip) Weekly retained riders lvl' datatype='integer' name='[Calculation_4800907638686584838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Activated Week Select (copy)] = &quot;New Riders&quot; THEN [weekly_retained_riders_new] &#10;ELSEIF [Parameters].[Activated Week Select (copy)] = &quot;Late Riders&quot; THEN [weekly_retained_riders_old] &#10;ELSE [weekly_retained_riders]&#10;END' />
