            </column>
            <column caption='Reactivated Riders' datatype='integer' name='[Churned Riders (copy)_6238752140307214336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([city_reactivated_rider_count], 0)' />
            </column>
            <column caption='Monthly Riders Reactivation Rate' datatype='real' default-format='p0.0%' name='[Monthly Riders Churn Rate (copy)_6238752140316655622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Churned Riders (copy)_6238752140307214336])/&#10;&#10;(ATTR([monthly_city_unique_riders]) + SUM([Churned Riders (copy)_6238752140307214336]))' />
            </column>
            <column caption='Monthly Riders Reactivation Rate indicator' datatype='string' default-format='p0.0%' name='[Monthly Riders Churn Rate indicator (copy)_6238752140319928328]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ZN(([Monthly Riders Churn Rate (copy)_6238752140316655622])) &gt; LOOKUP(ZN(([Monthly Riders Churn Rate (copy)_6238752140316655622])), -1) THEN &apos;▲&apos;&#10;ELSEIF ZN(([Monthly Riders Churn Rate (copy)_6238752140316655622])) &lt; LOOKUP(ZN(([Monthly Riders Churn Rate (copy)_6238752140316655622])), -1) THEN  &apos;▼&apos;&#10;ELSE &apos;&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Monthly Riders Churn Rate Flag' datatype='string' default-format='p0.0%' name='[Monthly Riders Churn Rate indicator (copy)_6731755611188404226]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Activated Week Select (copy 2)] = &apos;On&apos; THEN &#10;IF ZN(([Riders Churn Rate (copy)_1513913227651276811])) - LOOKUP(ZN(([Riders Churn Rate (copy)_1513913227651276811])), -1) &#10;&gt;  0.1 * LOOKUP(ZN(([Riders Churn Rate (copy)_1513913227651276811])), -1) THEN &apos;▲&apos;&#10;&#10;END END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Monthly Riders Churn Rate' datatype='real' default-format='p0.0%' name='[Riders Churn Rate (copy)_1513913227651276811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([city_churned_rider_count])/&#10;&#10;(ATTR([monthly_city_unique_riders]) + SUM([city_churned_rider_count]))' />
