              <calculation class='tableau' formula='[One Expected Fleet Size (copy)_3954864172167544858] - [One Available fleet size (copy)_3954864172167544859]' />
            </column>
            <column caption='Three Available fleet size' datatype='real' name='[One Available fleet size (copy)_3954864172167544859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[Input w1 Active Riders Forcast (copy)_3954864172167168021] != 0 AND [Parameters].[Input w1 Churn Forcast (copy)_3954864172167168020] = 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172167168019] = 0) THEN [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172167168021] + SUM([three_avg_reactivated_rider_num]) - SUM([three_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input w1 Churn Forcast (copy)_3954864172167168020] != 0 AND [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172167168021] = 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172167168019] = 0) THEN SUM([three_avg_active_rider_num]) + SUM([three_avg_reactivated_rider_num]) - [Parameters].[Input w1 Churn Forcast (copy)_3954864172167168020]&#10;ELSEIF ([Parameters].[Input w1 Reactivation Forcast (copy)_3954864172167168019] != 0 AND [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172167168021] = 0 AND [Parameters].[Input w1 Churn Forcast (copy)_3954864172167168020] = 0) THEN SUM([three_avg_active_rider_num]) + SUM([Parameters].[Input w1 Reactivation Forcast (copy)_3954864172167168019]) - SUM([three_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input w1 Active Riders Forcast (copy)_3954864172167168021] != 0 AND [Parameters].[Input w1 Churn Forcast (copy)_3954864172167168020] != 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172167168019] = 0) THEN [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172167168021] + SUM([three_avg_reactivated_rider_num]) - [Parameters].[Input w1 Churn Forcast (copy)_3954864172167168020]&#10;ELSEIF ([Parameters].[Input w1 Active Riders Forcast (copy)_3954864172167168021] != 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172167168019] != 0 AND [Parameters].[Input w1 Churn Forcast (copy)_3954864172167168020] = 0) THEN [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172167168021] + [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172167168019] - SUM([three_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input w1 Churn Forcast (copy)_3954864172167168020] != 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172167168019] != 0 AND [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172167168021] = 0) THEN SUM([three_avg_active_rider_num]) + [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172167168019] - [Parameters].[Input w1 Churn Forcast (copy)_3954864172167168020]&#10;ELSEIF ([Parameters].[Input w1 Churn Forcast (copy)_3954864172167168020] != 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172167168019] != 0 AND [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172167168021] != 0) THEN [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172167168021] + [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172167168019] - [Parameters].[Input w1 Churn Forcast (copy)_3954864172167168020]&#10;ELSE SUM([three_avg_active_rider_num]) + SUM([three_avg_reactivated_rider_num]) - SUM([three_avg_churned_rider_num]) END' />
            </column>
            <column caption='Three Expected Fleet Size' datatype='real' name='[One Expected Fleet Size (copy)_3954864172167544858]' role='measure' type='quantitative'>
