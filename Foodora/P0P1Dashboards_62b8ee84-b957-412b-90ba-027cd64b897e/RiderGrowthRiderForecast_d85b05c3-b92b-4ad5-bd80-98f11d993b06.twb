            </column>
            <column caption='Four Additional New Riders 28' datatype='real' name='[Four Additional New Riders (copy)_5667076467845246981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Three Expected Fleet Size (copy)_3954864172173803555] - [Four Available fleet size (copy)_5667076467845214212]' />
            </column>
            <column caption='Four Available fleet size 28' datatype='real' name='[Four Available fleet size (copy)_5667076467845214212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] != 0 AND [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304] = 0 AND [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] = 0) THEN [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] + 4*(SUM([four_avg_reactivated_rider_num]) - SUM([four_avg_churned_rider_num]))&#10;ELSEIF ([Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304] != 0 AND [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] = 0 AND [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] = 0) THEN SUM([four_avg_active_rider_num]) + 4*SUM([four_avg_reactivated_rider_num]) - [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304]&#10;ELSEIF ([Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] != 0 AND [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] = 0 AND [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304] = 0) THEN SUM([four_avg_active_rider_num]) + SUM([Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307]) - 4*SUM([four_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] != 0 AND [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304] != 0 AND [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] = 0) THEN [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] + 4*SUM([four_avg_reactivated_rider_num]) - [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304]&#10;ELSEIF ([Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] != 0 AND [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] != 0 AND [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304] = 0) THEN [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] + [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] - 4*SUM([four_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304] != 0 AND [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] != 0 AND [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] = 0) THEN SUM([four_avg_active_rider_num]) + [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] - [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304]&#10;ELSEIF ([Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304] != 0 AND [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] != 0 AND [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] != 0) THEN [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] + [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] - [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304]&#10;ELSE SUM([four_avg_active_rider_num]) + 4*(SUM([four_avg_reactivated_rider_num]) - SUM([four_avg_churned_rider_num])) END' />
            </column>
            <column caption='Four Available fleet size' datatype='real' name='[Three Available fleet size (copy)_3954864172173803554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] != 0 AND [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304] = 0 AND [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] = 0) THEN [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] + SUM([four_avg_reactivated_rider_num]) - SUM([four_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304] != 0 AND [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] = 0 AND [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] = 0) THEN SUM([four_avg_active_rider_num]) + SUM([four_avg_reactivated_rider_num]) - [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304]&#10;ELSEIF ([Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] != 0 AND [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] = 0 AND [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304] = 0) THEN SUM([four_avg_active_rider_num]) + SUM([Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307]) - SUM([four_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] != 0 AND [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304] != 0 AND [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] = 0) THEN [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] + SUM([four_avg_reactivated_rider_num]) - [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304]&#10;ELSEIF ([Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] != 0 AND [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] != 0 AND [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304] = 0) THEN [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] + [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] - SUM([four_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304] != 0 AND [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] != 0 AND [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] = 0) THEN SUM([four_avg_active_rider_num]) + [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] - [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304]&#10;ELSEIF ([Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304] != 0 AND [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] != 0 AND [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] != 0) THEN [Parameters].[Input w3 Active Riders Forcast (copy)_3954864172174475303] + [Parameters].[Input w3 Reactivation Forcast (copy)_3954864172174475307] - [Parameters].[Input w3 Churn Forcast (copy)_3954864172174475304]&#10;ELSE SUM([four_avg_active_rider_num]) + SUM([four_avg_reactivated_rider_num]) - SUM([four_avg_churned_rider_num]) END' />
            </column>
            <column caption='Four Expected Fleet Size' datatype='real' name='[Three Expected Fleet Size (copy)_3954864172173803555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[Input w3 HPR Forcast (copy)_3954864172174475305] = 0) THEN [Three Rider hours needed (copy)_3954864172173803556]/[Three L4W HPR (copy)_3954864172173803557]&#10;ELSE [Three Rider hours needed (copy)_3954864172173803556]/[Parameters].[Input w3 HPR Forcast (copy)_3954864172174475305]&#10;END' />
            </column>
            <column caption='Four L4W HPR' datatype='real' default-format='n#,##0;-#,##0' name='[Three L4W HPR (copy)_3954864172173803557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([four_avg_working_hrs]) / IFNULL(SUM([four_avg_active_rider_num]), 0), 0)' />
            </column>
            <column caption='Four L4W UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Three L4W UTR (copy)_3954864172173803558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([four_avg_count_of_del]) / IFNULL(SUM([four_avg_working_hrs]), 0), 0)' />
            </column>
            <column caption='Four Rider hours needed' datatype='real' name='[Three Rider hours needed (copy)_3954864172173803556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[Input w3 UTR Forcast (copy)_3954864172174475308] = 0 AND [Parameters].[Input w3 Order Forcast (copy)_3954864172174475306] = 0 ) THEN SUM([four_avg_order_number])/[Three L4W UTR (copy)_3954864172173803558]&#10;ELSEIF ([Parameters].[Input w3 UTR Forcast (copy)_3954864172174475308] = 0 AND  [Parameters].[Input w3 Order Forcast (copy)_3954864172174475306] != 0) THEN [Parameters].[Input w3 Order Forcast (copy)_3954864172174475306]/[Three L4W UTR (copy)_3954864172173803558]&#10;ELSEIF ([Parameters].[Input w3 UTR Forcast (copy)_3954864172174475308] != 0 AND  [Parameters].[Input w3 Order Forcast (copy)_3954864172174475306] == 0) THEN SUM([four_avg_order_number])/[Parameters].[Input w3 UTR Forcast (copy)_3954864172174475308]&#10;ELSE [Parameters].[Input w3 Order Forcast (copy)_3954864172174475306]/[Parameters].[Input w3 UTR Forcast (copy)_3954864172174475308]&#10;END' />
            </column>
