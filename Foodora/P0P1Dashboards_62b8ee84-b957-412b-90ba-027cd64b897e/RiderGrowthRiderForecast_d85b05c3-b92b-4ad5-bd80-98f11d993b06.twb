            <column caption='Two Additional New Riders' datatype='real' name='[One Additional New Riders (copy)_3954864172152360964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[One Expected Fleet Size (copy)_3954864172152520710] - [One Available fleet size (copy)_3954864172152561671]' />
            </column>
            <column caption='Two Available fleet size' datatype='real' name='[One Available fleet size (copy)_3954864172152561671]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] != 0 AND [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729] = 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] = 0) THEN [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] + SUM([two_avg_reactivated_rider_num]) - SUM([two_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729] != 0 AND [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] = 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] = 0) THEN SUM([two_avg_active_rider_num]) + SUM([two_avg_reactivated_rider_num]) - [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729]&#10;ELSEIF ([Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] != 0 AND [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] = 0 AND [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729] = 0) THEN SUM([two_avg_active_rider_num]) + SUM([Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421]) - SUM([two_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] != 0 AND [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729] != 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] = 0) THEN [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] + SUM([two_avg_reactivated_rider_num]) - [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729]&#10;ELSEIF ([Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] != 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] != 0 AND [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729] = 0) THEN [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] + [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] - SUM([two_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729] != 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] != 0 AND [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] = 0) THEN SUM([two_avg_active_rider_num]) + [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] - [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729]&#10;ELSEIF ([Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729] != 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] != 0 AND [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] != 0) THEN [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] + [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] - [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729]&#10;ELSE SUM([two_avg_active_rider_num]) + SUM([two_avg_reactivated_rider_num]) - SUM([two_avg_churned_rider_num]) END' />
