      <column caption='total_1 checking' datatype='real' default-format='p0.00%' name='[Calculation_1359101940888461316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_1])/SUM({ EXCLUDE  [contract_category] : SUM([num_1])})' />
      </column>
      <column caption='week_date_local' datatype='date' default-format='*yyyy\ \Www' name='[Calculation_1556275150350979078]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE(&quot;yyyy-ww&quot;, [week]) - (DATEPART(&apos;weekday&apos;, DATEPARSE(&quot;yyyy-ww&quot;, [week])) + 5) % 7)' />
      </column>
      <column caption='Fill_rate' datatype='real' default-format='p0.00%' name='[Calculation_1556275150390562829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([open_slots_size]) = 0 THEN 0&#10;ELSE SUM([open_slots_assigned]) / SUM([open_slots_size])&#10;END' />
      </column>
      <column caption='One Rider hours needed' datatype='real' name='[Calculation_1556275150394810383]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Parameters].[Input Order Forcast (copy)] = 0 AND [Parameters].[Parameter 1] = 0 ) THEN SUM([one_avg_order_number])/[UTR (copy)_3954864171847671810]&#10;ELSEIF ([Parameters].[Input Order Forcast (copy)] = 0 AND  [Parameters].[Parameter 1] != 0) THEN [Parameters].[Parameter 1]/[UTR (copy)_3954864171847671810]&#10;ELSEIF ([Parameters].[Input Order Forcast (copy)] != 0 AND  [Parameters].[Parameter 1] == 0) THEN SUM([one_avg_order_number])/[Parameters].[Input Order Forcast (copy)]&#10;ELSE [Parameters].[Parameter 1]/[Parameters].[Input Order Forcast (copy)]&#10;END' />
      </column>
      <column caption='One Expected Fleet Size' datatype='real' name='[Calculation_1556275150396420112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Parameters].[Input UTR Forcast (copy)] = 0) THEN [Calculation_1556275150394810383]/[HPR (copy)_3954864171847786499]&#10;ELSE [Calculation_1556275150394810383]/[Parameters].[Input UTR Forcast (copy)]&#10;END' />
