          <named-connection caption='BigQuery' name='bigquery.1xfbhgx1o1sfdl18i3aok0kwcm1q'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-eu' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='oliver.kampfmann@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1xfbhgx1o1sfdl18i3aok0kwcm1q' name='Custom SQL Query2' type='text'><![CDATA[#Vehicle
WITH parameters AS (
  SELECT
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 4 MONTH), MONTH) AS start_date_extended,
    DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 4 MONTH), MONTH), INTERVAL 1 DAY) AS start_date_extended_utc,
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH), MONTH) AS start_date,
    DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL (7 - EXTRACT(DAYOFWEEK FROM CURRENT_DATE)) DAY), WEEK) AS end_date
), 

countries AS (
  SELECT 
  countries.region_short_name,
  countries.country_code,
  countries.country_name,
  cities.id AS city_id,
  cities.name as city_name,
  cities.timezone as timezone
  FROM `fulfillment-dwh-production.curated_data_shared.countries` as countries
  LEFT JOIN UNNEST(countries.cities) AS cities
),

vehicle AS (
  SELECT 
  distinct 
  country_code, 
  rider_id,
  city_id,
  vehic.updated_at as updated_at,
  vehic.created_at AS created_at,
  vehic.vehicle_type_id AS vec_type,
  vehic.name AS vec_name,
  vehic.profile AS vec_profile
  FROM `fulfillment-dwh-production.curated_data_shared.riders` 
  LEFT JOIN Unnest(rider_vehicles) AS vehic
  LEFT JOIN Unnest(contracts)
  order by 3
),

vehicle_city AS (
  SELECT 
  CASE 
    WHEN vehicle.country_code = 't3' THEN 'tr'
    ELSE vehicle.country_code
  END AS country_code,
  city_name,
  rider_id,
  vec_type,
  vec_name,
  vec_profile,
  FORMAT_DATE('%G-%V', DATE(DATETIME(updated_at,countries.timezone))) AS updated_week, 
  FORMAT_DATE('%G-%V', DATE(DATETIME(created_at,countries.timezone))) AS created_week,
  FROM vehicle
  LEFT JOIN countries
  ON vehicle.country_code = countries.country_code
  AND vehicle.city_id = countries.city_id
),

combined AS ( #helps combine the monthly riders and their corresponding vehicle
  SELECT 
  DISTINCT
  lg_country_code,
  lg_rider_id,
  status.city_name,
  report_week,
  is_active,
  is_churned,
  is_reactivated,
  vec_profile
  FROM `fulfillment-dwh-production.pandata_report.pandora_lg_rider_status` AS status
  LEFT JOIN vehicle_city
  ON lg_country_code = country_code 
  AND status.city_name = vehicle_city.city_name
  AND rider_id = lg_rider_id
  AND updated_week <<= report_week
  WHERE report_date_local BETWEEN (SELECT start_date FROM parameters) AND (SELECT end_date FROM parameters)
  AND is_active = TRUE
),

tb AS (
SELECT 
report_week,
lg_country_code,
city_name,
vec_profile,
COUNT(DISTINCT lg_rider_id) as num,
SUM(COUNT(DISTINCT lg_rider_id)) OVER (PARTITION BY lg_country_code,city_name, report_week) AS total
FROM combined
WHERE LOWER(city_name) NOT LIKE '%test%'
GROUP BY 1,2,3,4
ORDER BY 2,3,1,2
),

week1 AS (
  SELECT 
  tb.*,
  AVG(num) OVER (PARTITION BY lg_country_code, city_name, vec_profile  ORDER BY report_week ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS num_1
  FROM tb
  ORDER BY 2,3,1
),

week2 AS (
  SELECT 
  week1.*,
  (SUM(num) OVER (PARTITION BY lg_country_code, city_name, vec_profile  ORDER BY report_week ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) + num_1)/4 AS num_2
  FROM week1
  ORDER BY 2,3,1
),

week3 AS (
  SELECT 
  week2.*,
  (SUM(num) OVER (PARTITION BY lg_country_code, city_name, vec_profile  ORDER BY report_week ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) + num_1 + num_2)/4 AS num_3
  FROM week2
  ORDER BY 2,3,1
),

week4 AS (
  SELECT 
  week3.*,
  (num + num_1 + num_2 + num_3)/4 AS num_4
  FROM week3
  ORDER BY 2,3,1
)

SELECT *,
SUM(num) OVER (PARTITION BY lg_country_code, city_name, report_week) AS total_num,
  SUM(num_1) OVER (PARTITION BY lg_country_code, city_name, report_week) AS total_num_1,
  SUM(num_2) OVER (PARTITION BY lg_country_code, city_name, report_week) AS total_num_2,
  SUM(num_3) OVER (PARTITION BY lg_country_code, city_name, report_week) AS total_num_3,
  SUM(num_4) OVER (PARTITION BY lg_country_code, city_name, report_week) AS total_num_4
FROM week4
ORDER BY 2,3,1]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1xfbhgx1o1sfdl18i3aok0kwcm1q' name='Custom SQL Query' type='text'>#forecast model city
WITH parameters AS (
  SELECT
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 4 MONTH), MONTH) AS start_date_extended,
    DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 4 MONTH), MONTH), INTERVAL 1 DAY) AS start_date_extended_utc,
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH), MONTH) AS start_date,
    DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL (7 - EXTRACT(DAYOFWEEK FROM CURRENT_DATE)) DAY), WEEK) AS end_date
),


countries AS (
  SELECT 
  countries.region_short_name,
  countries.country_code,
  countries.country_name,
  cities.id AS city_id,
  cities.name as city_name
  FROM `fulfillment-dwh-production.curated_data_shared.countries` as countries
  LEFT JOIN UNNEST(countries.cities) AS cities
),

hours AS (
    SELECT
        CASE WHEN rider_wh.country_code = &apos;t3&apos; THEN &apos;tr&apos; 
        ELSE rider_wh.country_code 
        END AS country_code,
        city_name,
        city_id,
        FORMAT_DATE(&apos;%G-%V&apos;, DATE(created_date_local))  AS week,
        SUM(transition_working_time) / 3600 AS working_hrs
    FROM
        `fulfillment-dwh-production.curated_data_shared.rider_kpi` AS rider_wh
    WHERE created_date_local BETWEEN (SELECT start_date FROM parameters) AND (SELECT end_date FROM parameters)
    GROUP BY
        country_code, city_name,  city_id, week
    ORDER BY
        country_code, city_name
),

deliveries AS (
    SELECT
        CASE WHEN rider_deliveries.country_code = &apos;t3&apos; THEN &apos;tr&apos; 
        ELSE rider_deliveries.country_code 
        END AS country_code,
        city_name,
        city_id,
        COUNT(DISTINCT rider_id) as rider_num,
        COUNT(DISTINCT CASE WHEN completed_deliveries != 0 THEN rider_id END) as active_rider_num,
        FORMAT_DATE(&apos;%G-%V&apos;, DATE(created_date_local))  AS week,
        SUM(completed_deliveries) AS count_of_del
    FROM
        `fulfillment-dwh-production.curated_data_shared.rider_kpi` AS rider_deliveries
    LEFT JOIN
        UNNEST(deliveries) AS del
    WHERE created_date_local BETWEEN (SELECT start_date FROM parameters) AND (SELECT end_date FROM parameters)
    GROUP BY
        country_code, city_name, city_id, week
    ORDER BY
        country_code
),

UTR AS (
SELECT
    hours.week, 
    hours.country_code,
    hours.city_name,
    hours.working_hrs,
    hours.city_id,
    deliveries.count_of_del,
    deliveries.rider_num,
    deliveries.active_rider_num,
    #SAFE_DIVIDE(deliveries.count_of_del, hours.working_hrs) AS utr, #do it in tableau
    #SAFE_DIVIDE(hours.working_hrs, deliveries.active_rider_num) AS hpr

FROM
    hours
LEFT JOIN
    deliveries ON hours.country_code = deliveries.country_code
        AND hours.city_name = deliveries.city_name
        AND hours.city_id = deliveries.city_id
        AND hours.week = deliveries.week
ORDER BY
    country_code, working_hrs, count_of_del
),

orders AS (
  SELECT
  CASE 
    WHEN orders.country_code = &apos;t3&apos; THEN &apos;tr&apos; 
    ELSE orders.country_code 
    END AS country_code,
  city_id,
  FORMAT_DATE(&quot;%G-%V&quot;, DATE(DATETIME(created_at, timezone))) AS week,
  count(order_id) AS order_number
  FROM `fulfillment-dwh-production.curated_data_shared.orders` orders
  WHERE DATE(created_at) BETWEEN (SELECT start_date FROM parameters) AND (SELECT end_date FROM parameters)
  GROUP BY 1,2,3
),

status AS (
  SELECT 
  lg_country_code,
  city_name,
  report_week,
  COUNT(DISTINCT CASE WHEN is_active THEN lg_rider_id END) as weekly_active_rider,
  COUNT(DISTINCT CASE WHEN is_churned THEN lg_rider_id END) as churned_rider_num,
  COUNT(DISTINCT CASE WHEN is_reactivated THEN lg_rider_id END) as reactivated_rider_num,
  FROM `fulfillment-dwh-production.pandata_report.pandora_lg_rider_status`
  WHERE report_date_local BETWEEN (SELECT start_date FROM parameters) AND (SELECT end_date FROM parameters)
  GROUP BY 1,2,3
),

fill AS (
  SELECT 
  CASE 
    WHEN country_code = &apos;t3&apos; THEN &apos;tr&apos; 
    ELSE country_code 
    END AS country_code,
  city_name,
  FORMAT_DATE(&quot;%G-%V&quot;, created_date_local)  AS report_week,
  SUM(open_slots_assigned) as open_slots_assigned,
  SUM(open_slots_size) as open_slots_size,
  #ROUND(SAFE_DIVIDE(SUM(open_slots_assigned), SUM(open_slots_size)), 2) AS fill_rate
  FROM `fulfillment-dwh-production.curated_data_shared.staffing_kpi`
  WHERE created_date_local BETWEEN (SELECT start_date FROM parameters) AND (SELECT end_date FROM parameters)
  GROUP BY 1, 2, 3
  ORDER BY 1 DESC, 2 DESC

),

final AS (
SELECT 
DISTINCT
countries.country_name,
countries.region_short_name,
UTR.week, 
UTR.country_code,
UTR.city_name,
UTR.working_hrs,
UTR.count_of_del,
UTR.rider_num,
UTR.active_rider_num,
orders.order_number,
status.weekly_active_rider,
status.churned_rider_num,
status.reactivated_rider_num,
fill.open_slots_assigned,
fill.open_slots_size
FROM UTR
LEFT JOIN orders
ON UTR.country_code = orders.country_code
AND UTR.city_id = orders.city_id
AND UTR.week = orders.week
LEFT JOIN status
ON UTR.country_code = status.lg_country_code
AND UTR.city_name = status.city_name
AND UTR.week = status.report_week
LEFT JOIN fill
ON UTR.country_code = fill.country_code
AND UTR.city_name = fill.city_name
AND UTR.week = fill.report_week
LEFT JOIN countries
ON UTR.country_code = countries.country_code
WHERE UTR.city_name IS NOT NULL
ORDER BY country_code, city_name, UTR.week),

week_one AS (
SELECT 
  final.*,
  AVG(count_of_del) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS one_avg_count_of_del,
  AVG(working_hrs) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS one_avg_working_hrs,
  AVG(rider_num) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS one_avg_rider_num,
  AVG(active_rider_num) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS one_avg_active_rider_num,
  AVG(order_number) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS one_avg_order_number,
  AVG(weekly_active_rider) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS one_avg_weekly_active_rider,
  AVG(churned_rider_num) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS one_avg_churned_rider_num,
  AVG(reactivated_rider_num) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS one_avg_reactivated_rider_num,
  AVG(open_slots_assigned) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS one_avg_open_slots_assigned,
  AVG(open_slots_size) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS one_avg_open_slots_size
FROM final
),
#what ill do is to add the one_avg_count_of_del to the end and divide by 4 and change the front avg to sum
week_two AS (
SELECT 
  week_one.*,
  (SUM(count_of_del) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) + one_avg_count_of_del)/4 AS two_avg_count_of_del,
  (SUM(working_hrs) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) + one_avg_working_hrs)/4 AS two_avg_working_hrs,
  (SUM(rider_num) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) + one_avg_rider_num)/4 AS two_avg_rider_num,
  (SUM(active_rider_num) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) + one_avg_active_rider_num)/4 AS two_avg_active_rider_num,
  (SUM(order_number) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) + one_avg_order_number)/4 AS two_avg_order_number,
  (SUM(weekly_active_rider) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) + one_avg_weekly_active_rider)/4 AS two_avg_weekly_active_rider,
  (SUM(churned_rider_num) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) + one_avg_churned_rider_num)/4 AS two_avg_churned_rider_num,
  (SUM(reactivated_rider_num) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) + one_avg_reactivated_rider_num)/4 AS two_avg_reactivated_rider_num,
  (SUM(open_slots_assigned) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) + one_avg_open_slots_assigned)/4 AS two_avg_open_slots_assigned,
  (SUM(open_slots_size) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) + one_avg_open_slots_size)/4 AS two_avg_open_slots_size
FROM week_one  
),

#this should be less
week_three AS (
SELECT 
  week_two.*,
  (SUM(count_of_del) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) + one_avg_count_of_del + two_avg_count_of_del)/4 AS three_avg_count_of_del,
  (SUM(working_hrs) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) + one_avg_working_hrs + two_avg_working_hrs)/4 AS three_avg_working_hrs,
  (SUM(rider_num) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) + one_avg_rider_num + two_avg_rider_num)/4 AS three_avg_rider_num,
  (SUM(active_rider_num) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) + one_avg_active_rider_num + two_avg_active_rider_num)/4 AS three_avg_active_rider_num,
  (SUM(order_number) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) + one_avg_order_number + two_avg_order_number)/4 AS three_avg_order_number,
  (SUM(weekly_active_rider) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) + one_avg_weekly_active_rider + two_avg_weekly_active_rider)/4 AS three_avg_weekly_active_rider,
  (SUM(churned_rider_num) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) + one_avg_churned_rider_num + two_avg_churned_rider_num)/4 AS three_avg_churned_rider_num,
  (SUM(reactivated_rider_num) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) + one_avg_reactivated_rider_num + two_avg_reactivated_rider_num)/4 AS three_avg_reactivated_rider_num,
  (SUM(open_slots_assigned) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) + one_avg_open_slots_assigned + two_avg_open_slots_assigned)/4 AS three_avg_open_slots_assigned,
  (SUM(open_slots_size) OVER (PARTITION BY country_code, city_name ORDER BY week ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) + one_avg_open_slots_size + two_avg_open_slots_size)/4 AS three_avg_open_slots_size
FROM week_two  
),

week_four AS (
SELECT 
  week_three.*,
  (count_of_del + one_avg_count_of_del + two_avg_count_of_del + three_avg_count_of_del)/4 AS four_avg_count_of_del,
  (working_hrs + one_avg_working_hrs+ two_avg_working_hrs + three_avg_working_hrs)/4 AS four_avg_working_hrs,
  (rider_num + one_avg_rider_num + two_avg_rider_num + three_avg_rider_num)/4 AS four_avg_rider_num,
  (active_rider_num + one_avg_active_rider_num + two_avg_active_rider_num + three_avg_active_rider_num)/4 AS four_avg_active_rider_num,
  (order_number + one_avg_order_number + two_avg_order_number + three_avg_order_number)/4 AS four_avg_order_number,
  (weekly_active_rider + one_avg_weekly_active_rider + two_avg_weekly_active_rider + three_avg_weekly_active_rider)/4 AS four_avg_weekly_active_rider,
  (churned_rider_num + one_avg_churned_rider_num + two_avg_churned_rider_num + three_avg_churned_rider_num)/4 AS four_avg_churned_rider_num,
  (reactivated_rider_num + one_avg_reactivated_rider_num + two_avg_reactivated_rider_num + three_avg_reactivated_rider_num)/4 AS four_avg_reactivated_rider_num,
  (open_slots_assigned + one_avg_open_slots_assigned + two_avg_open_slots_assigned + three_avg_open_slots_assigned)/4 AS four_avg_open_slots_assigned,
  (open_slots_size + one_avg_open_slots_size + two_avg_open_slots_size + three_avg_open_slots_size)/4 AS four_avg_open_slots_size
FROM week_three
)

SELECT * FROM week_four</relation>
          <relation connection='bigquery.1xfbhgx1o1sfdl18i3aok0kwcm1q' name='Custom SQL Query2' type='text'><![CDATA[#Vehicle
WITH parameters AS (
  SELECT
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 4 MONTH), MONTH) AS start_date_extended,
    DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 4 MONTH), MONTH), INTERVAL 1 DAY) AS start_date_extended_utc,
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH), MONTH) AS start_date,
    DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL (7 - EXTRACT(DAYOFWEEK FROM CURRENT_DATE)) DAY), WEEK) AS end_date
), 

countries AS (
  SELECT 
  countries.region_short_name,
  countries.country_code,
  countries.country_name,
  cities.id AS city_id,
  cities.name as city_name,
  cities.timezone as timezone
  FROM `fulfillment-dwh-production.curated_data_shared.countries` as countries
  LEFT JOIN UNNEST(countries.cities) AS cities
),

vehicle AS (
  SELECT 
  distinct 
  country_code, 
  rider_id,
  city_id,
  vehic.updated_at as updated_at,
  vehic.created_at AS created_at,
  vehic.vehicle_type_id AS vec_type,
  vehic.name AS vec_name,
  vehic.profile AS vec_profile
  FROM `fulfillment-dwh-production.curated_data_shared.riders` 
  LEFT JOIN Unnest(rider_vehicles) AS vehic
  LEFT JOIN Unnest(contracts)
  order by 3
),

vehicle_city AS (
  SELECT 
  CASE 
    WHEN vehicle.country_code = 't3' THEN 'tr'
    ELSE vehicle.country_code
  END AS country_code,
  city_name,
  rider_id,
  vec_type,
  vec_name,
  vec_profile,
  FORMAT_DATE('%G-%V', DATE(DATETIME(updated_at,countries.timezone))) AS updated_week, 
  FORMAT_DATE('%G-%V', DATE(DATETIME(created_at,countries.timezone))) AS created_week,
  FROM vehicle
  LEFT JOIN countries
  ON vehicle.country_code = countries.country_code
  AND vehicle.city_id = countries.city_id
),

combined AS ( #helps combine the monthly riders and their corresponding vehicle
  SELECT 
  DISTINCT
  lg_country_code,
  lg_rider_id,
  status.city_name,
  report_week,
  is_active,
  is_churned,
  is_reactivated,
  vec_profile
  FROM `fulfillment-dwh-production.pandata_report.pandora_lg_rider_status` AS status
  LEFT JOIN vehicle_city
  ON lg_country_code = country_code 
  AND status.city_name = vehicle_city.city_name
  AND rider_id = lg_rider_id
  AND updated_week <<= report_week
  WHERE report_date_local BETWEEN (SELECT start_date FROM parameters) AND (SELECT end_date FROM parameters)
  AND is_active = TRUE
),

tb AS (
SELECT 
report_week,
lg_country_code,
city_name,
vec_profile,
COUNT(DISTINCT lg_rider_id) as num,
SUM(COUNT(DISTINCT lg_rider_id)) OVER (PARTITION BY lg_country_code,city_name, report_week) AS total
FROM combined
WHERE LOWER(city_name) NOT LIKE '%test%'
GROUP BY 1,2,3,4
ORDER BY 2,3,1,2
),

week1 AS (
  SELECT 
  tb.*,
  AVG(num) OVER (PARTITION BY lg_country_code, city_name, vec_profile  ORDER BY report_week ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS num_1
  FROM tb
  ORDER BY 2,3,1
),

week2 AS (
  SELECT 
  week1.*,
  (SUM(num) OVER (PARTITION BY lg_country_code, city_name, vec_profile  ORDER BY report_week ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) + num_1)/4 AS num_2
  FROM week1
  ORDER BY 2,3,1
),

week3 AS (
  SELECT 
  week2.*,
  (SUM(num) OVER (PARTITION BY lg_country_code, city_name, vec_profile  ORDER BY report_week ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) + num_1 + num_2)/4 AS num_3
  FROM week2
  ORDER BY 2,3,1
),

week4 AS (
  SELECT 
  week3.*,
  (num + num_1 + num_2 + num_3)/4 AS num_4
  FROM week3
  ORDER BY 2,3,1
)

SELECT *,
SUM(num) OVER (PARTITION BY lg_country_code, city_name, report_week) AS total_num,
  SUM(num_1) OVER (PARTITION BY lg_country_code, city_name, report_week) AS total_num_1,
  SUM(num_2) OVER (PARTITION BY lg_country_code, city_name, report_week) AS total_num_2,
  SUM(num_3) OVER (PARTITION BY lg_country_code, city_name, report_week) AS total_num_3,
  SUM(num_4) OVER (PARTITION BY lg_country_code, city_name, report_week) AS total_num_4
FROM week4
ORDER BY 2,3,1]]></relation>
          <relation connection='bigquery.1xfbhgx1o1sfdl18i3aok0kwcm1q' name='Custom SQL Query1' type='text'><![CDATA[#contract
WITH parameters AS (
  SELECT
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 4 MONTH), MONTH) AS start_date_extended,
    DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 4 MONTH), MONTH), INTERVAL 1 DAY) AS start_date_extended_utc,
    DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 3 MONTH), MONTH) AS start_date,
    DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL (7 - EXTRACT(DAYOFWEEK FROM CURRENT_DATE)) DAY), WEEK) AS end_date
), 

countries AS (
  SELECT 
  countries.region_short_name,
  countries.country_code,
  countries.country_name,
  cities.id AS city_id,
  cities.name as city_name
  FROM `fulfillment-dwh-production.curated_data_shared.countries` as countries
  LEFT JOIN UNNEST(countries.cities) AS cities
),

contract AS (
  SELECT 
  distinct 
  country_code, 
  rider_id,
  city_id,
  contracts.start_at as start_at,
  contracts.end_at AS end_at,
  FORMAT_DATE('%G-%V', DATE(contracts.start_at)) AS created_week, 
  FORMAT_DATE('%G-%V', DATE(contracts.end_at)) AS end_week,
  contracts.type AS contract_type
  FROM `fulfillment-dwh-production.curated_data_shared.riders` 
  LEFT JOIN Unnest(contracts) AS contracts
  order by 3
),

contract_city AS (
SELECT 
  CASE 
    WHEN contract.country_code = 't3' THEN 'tr'
    ELSE contract.country_code
  END AS country_code,
  city_name,
  rider_id,
  created_week,
  end_week,
  contract_type
FROM contract
LEFT JOIN countries
ON contract.country_code = countries.country_code
AND contract.city_id = countries.city_id
),

combined AS (
  SELECT 
  DISTINCT
  lg_country_code,
  lg_rider_id,
  status.city_name,
  report_week,
  is_active,
  is_churned,
  is_reactivated,
  contract_type
  FROM `fulfillment-dwh-production.pandata_report.pandora_lg_rider_status` AS status
  LEFT JOIN contract_city
  ON lg_country_code = country_code 
  AND status.city_name = contract_city.city_name
  AND rider_id = lg_rider_id
  AND report_week >>= created_week
  AND report_week << end_week
  WHERE report_date_local BETWEEN (SELECT start_date FROM parameters) AND (SELECT end_date FROM parameters)
  AND is_active = TRUE
),

#renaming
cat_name AS (
SELECT 
report_week,
lg_country_code,
city_name,
lg_rider_id,
CASE 
        -- Countries where contract_category is always 'freelancer'
        WHEN lg_country_code IN ('bd', 'sg', 'tw', 'hk', 'ph', 'pk', 'my', 'mm', 'la', 'kh') THEN 'FREELANCER'
        
        -- Country-specific rules
        WHEN lg_country_code = 'at' AND contract_type = 'FULL_TIME' THEN 'EMPLOYEE'
        WHEN lg_country_code = 'at' AND contract_type = 'MINI' THEN '3PL'
        WHEN lg_country_code = 'at' THEN 'FREELANCER'
        
        WHEN lg_country_code = 'cz' AND contract_type = '' THEN 'NA'
        WHEN lg_country_code = 'cz' AND contract_type IN ('MIDI', 'ON_DEMAND') THEN '3PL'
        WHEN lg_country_code = 'cz' THEN 'FREELANCER'
        
        WHEN lg_country_code = 'fi' AND contract_type = '' THEN 'NA'
        WHEN lg_country_code = 'fi' THEN 'FREELANCER'
        
        WHEN lg_country_code = 'hu' AND contract_type = '' THEN 'NA'
        WHEN lg_country_code = 'hu' THEN 'FREELANCER'
        
        WHEN lg_country_code = 'no' AND contract_type = '' THEN 'NA'
        WHEN lg_country_code = 'no' AND contract_type = 'PART_TIME' THEN 'EMPLOYEE'
        WHEN lg_country_code = 'no' THEN 'FREELANCER'
        
        WHEN lg_country_code = 'se' AND contract_type = '' THEN 'NA'
        WHEN lg_country_code = 'se' AND contract_type = 'MIDI' THEN 'EMPLOYEE'
        WHEN lg_country_code = 'se' AND contract_type = 'MINI' THEN '3PL'
        WHEN lg_country_code = 'se' AND contract_type = 'PART_TIME' THEN 'EMPLOYEE'
        
        WHEN lg_country_code = 'th' THEN 'FREELANCER'
        
        WHEN lg_country_code = 'tr' AND contract_type IS NULL THEN 'FREELANCER'
        ELSE UPPER(contract_type)
        END AS contract_category,
FROM combined
WHERE LOWER(city_name) NOT LIKE "%test%"
ORDER BY 2,3,1,4
),

tb AS (
  SELECT 
  report_week,
  lg_country_code,
  city_name,
  contract_category,
  COUNT(DISTINCT lg_rider_id) AS num,
  SUM(COUNT(DISTINCT lg_rider_id)) OVER (PARTITION BY lg_country_code,city_name, report_week) AS total
  FROM cat_name
  GROUP BY 1,2,3,4
  ORDER BY 2,3,1,2
),
week1 AS (
  SELECT 
  tb.*,
  AVG(num) OVER (PARTITION BY lg_country_code, city_name, contract_category  ORDER BY report_week ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS num_1
  FROM tb
  ORDER BY 2,3,1
),

week2 AS (
  SELECT 
  week1.*,
  (SUM(num) OVER (PARTITION BY lg_country_code, city_name, contract_category  ORDER BY report_week ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) + num_1)/4 AS num_2
  FROM week1
  ORDER BY 2,3,1
),

week3 AS (
  SELECT 
  week2.*,
  (SUM(num) OVER (PARTITION BY lg_country_code, city_name, contract_category  ORDER BY report_week ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) + num_1 + num_2)/4 AS num_3
  FROM week2
  ORDER BY 2,3,1
),

week4 AS (
  SELECT 
  week3.*,
  (num + num_1 + num_2 + num_3)/4 AS num_4
  FROM week3
  ORDER BY 2,3,1
)

SELECT *,
SUM(num) OVER (PARTITION BY lg_country_code, city_name, report_week) AS total_num,
  SUM(num_1) OVER (PARTITION BY lg_country_code, city_name, report_week) AS total_num_1,
  SUM(num_2) OVER (PARTITION BY lg_country_code, city_name, report_week) AS total_num_2,
  SUM(num_3) OVER (PARTITION BY lg_country_code, city_name, report_week) AS total_num_3,
  SUM(num_4) OVER (PARTITION BY lg_country_code, city_name, report_week) AS total_num_4
FROM week4
ORDER BY 2,3,1]]></relation>
