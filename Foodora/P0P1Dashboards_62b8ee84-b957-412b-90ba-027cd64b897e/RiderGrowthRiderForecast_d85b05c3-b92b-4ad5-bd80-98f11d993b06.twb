            </column>
            <column caption='Three Rider hours needed' datatype='real' name='[One Rider hours needed (copy)_3954864172167544857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[Input w1 UTR Forcast (copy)_3954864172167168022] = 0 AND [Parameters].[Input w1 Order Forcast (copy)_3954864172167168024] = 0 ) THEN SUM([three_avg_order_number])/[one L4W UTR (copy)_3954864172167544862]&#10;ELSEIF ([Parameters].[Input w1 UTR Forcast (copy)_3954864172167168022] = 0 AND  [Parameters].[Input w1 Order Forcast (copy)_3954864172167168024] != 0) THEN [Parameters].[Input w1 Order Forcast (copy)_3954864172167168024]/[one L4W UTR (copy)_3954864172167544862]&#10;ELSEIF ([Parameters].[Input w1 UTR Forcast (copy)_3954864172167168022] != 0 AND  [Parameters].[Input w1 Order Forcast (copy)_3954864172167168024] == 0) THEN SUM([three_avg_order_number])/[Parameters].[Input w1 UTR Forcast (copy)_3954864172167168022]&#10;ELSE [Parameters].[Input w1 Order Forcast (copy)_3954864172167168024]/[Parameters].[Input w1 UTR Forcast (copy)_3954864172167168022]&#10;END' />
            </column>
