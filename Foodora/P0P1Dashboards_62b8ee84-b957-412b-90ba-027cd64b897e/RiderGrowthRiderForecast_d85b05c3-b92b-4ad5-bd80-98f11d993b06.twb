    <worksheet name='weekly summary'>
      <table>
        <view>
          <datasources>
            <datasource caption='Forecast' name='federated.1oi9c771rl2efj15wcyjo1qdorg8' />
          </datasources>
          <datasource-dependencies datasource='federated.1oi9c771rl2efj15wcyjo1qdorg8'>
            <column caption='Country' datatype='string' name='[Calculation_1338413544978472960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_name]' />
            </column>
            <column caption='week_date_local' datatype='date' default-format='*yyyy\ \Www' name='[Calculation_1556275150350979078]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEPARSE(&quot;yyyy-ww&quot;, [week]) - (DATEPART(&apos;weekday&apos;, DATEPARSE(&quot;yyyy-ww&quot;, [week])) + 5) % 7)' />
            </column>
            <column caption='Fill_rate' datatype='real' default-format='p0.00%' name='[Calculation_1556275150390562829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([open_slots_size]) = 0 THEN 0&#10;ELSE SUM([open_slots_assigned]) / SUM([open_slots_size])&#10;END' />
            </column>
            <column caption='HPR' datatype='real' default-format='n#,##0;-#,##0' name='[HPR (copy)_2567755485896708096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([working_hrs]) / IFNULL(SUM([active_rider_num]), 0), 0)' />
            </column>
            <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[UTR (copy)_2567755485898256385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM(count_of_del) / IFNULL(SUM(working_hrs), 0), 0)' />
            </column>
            <column caption='active_riders' datatype='integer' name='[active_rider_num]' role='measure' type='quantitative' />
            <column datatype='integer' name='[churned_rider_num]' role='measure' type='quantitative' />
