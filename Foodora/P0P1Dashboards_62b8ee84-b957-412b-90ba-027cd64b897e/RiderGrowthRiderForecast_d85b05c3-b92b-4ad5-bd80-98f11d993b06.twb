        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.16x4qvt17rhy2o11k9oje11mar71' name='Custom SQL Query' type='text'>SELECT
  &quot;Forecast&quot; AS dashboard_name,
  &quot;Forecast&quot; AS data_source,
  &quot;rider_kpi&quot; AS ref_table_name,
  MAX(created_date_local) AS latest_date
FROM `fulfillment-dwh-production.curated_data_shared.rider_kpi`
WHERE created_date_local &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 3 DAY)

UNION ALL

SELECT
  &quot;Forecast&quot; AS dashboard_name,
  &quot;Forecast&quot; AS data_source,
  &quot;regional_apac_lg_rider_daily_metrics&quot; AS ref_table_name,
  MAX(date_local) AS latest_date
FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_rider_daily_metrics`
WHERE date_local &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 3 DAY)

UNION ALL

SELECT
  &quot;Forecast&quot; AS dashboard_name,
  &quot;Forecast&quot; AS data_source,
  &quot;orders&quot; AS ref_table_name,
  MAX(DATE(created_at)) AS latest_date
FROM `fulfillment-dwh-production.curated_data_shared.orders`
WHERE DATE(created_at) &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 3 DAY)

UNION ALL

SELECT
  &quot;Forecast&quot; AS dashboard_name,
  &quot;Forecast&quot; AS data_source,
  &quot;pandora_lg_rider_status&quot; AS ref_table_name,
  MAX(report_date_local) AS latest_date
FROM `fulfillment-dwh-production.pandata_report.pandora_lg_rider_status`
WHERE report_date_local &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 3 DAY)

UNION ALL

SELECT
  &quot;Forecast&quot; AS dashboard_name,
  &quot;Forecast&quot; AS data_source,
  &quot;staffing_kpi&quot; AS ref_table_name,
  MAX(created_date_local) AS latest_date
FROM `fulfillment-dwh-production.curated_data_shared.staffing_kpi`
WHERE created_date_local &gt;&gt;= DATE_SUB(CURRENT_DATE, INTERVAL 3 DAY)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
