      <table>
        <view>
          <datasources>
            <datasource caption='Forecast' name='federated.1oi9c771rl2efj15wcyjo1qdorg8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Input w1 Reactivation Forcast' datatype='integer' name='[Input Churn Forcast (copy)]' param-domain-type='any' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Input w1 Churn Forcast' datatype='integer' datatype-customized='true' name='[Input HPR Forcast (copy 2)_1556275150392578062]' param-domain-type='any' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Input w1 Active Riders Forcast' datatype='integer' name='[Input HPR Forcast (copy)]' param-domain-type='any' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Input w1 UTR Forcast' datatype='real' name='[Input Order Forcast (copy)]' param-domain-type='any' role='measure' type='quantitative' value='0.'>
              <calculation class='tableau' formula='0.' />
            </column>
            <column caption='Input w1 HPR Forcast' datatype='real' name='[Input UTR Forcast (copy)]' param-domain-type='any' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
            </column>
            <column caption='Input w1 Order Forcast' datatype='integer' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1oi9c771rl2efj15wcyjo1qdorg8'>
            <column caption='Country' datatype='string' name='[Calculation_1338413544978472960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_name]' />
            </column>
            <column caption='One Rider hours needed' datatype='real' name='[Calculation_1556275150394810383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[Input Order Forcast (copy)] = 0 AND [Parameters].[Parameter 1] = 0 ) THEN SUM([one_avg_order_number])/[UTR (copy)_3954864171847671810]&#10;ELSEIF ([Parameters].[Input Order Forcast (copy)] = 0 AND  [Parameters].[Parameter 1] != 0) THEN [Parameters].[Parameter 1]/[UTR (copy)_3954864171847671810]&#10;ELSEIF ([Parameters].[Input Order Forcast (copy)] != 0 AND  [Parameters].[Parameter 1] == 0) THEN SUM([one_avg_order_number])/[Parameters].[Input Order Forcast (copy)]&#10;ELSE [Parameters].[Parameter 1]/[Parameters].[Input Order Forcast (copy)]&#10;END' />
            </column>
            <column caption='One Expected Fleet Size' datatype='real' name='[Calculation_1556275150396420112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[Input UTR Forcast (copy)] = 0) THEN [Calculation_1556275150394810383]/[HPR (copy)_3954864171847786499]&#10;ELSE [Calculation_1556275150394810383]/[Parameters].[Input UTR Forcast (copy)]&#10;END' />
            </column>
            <column caption='One Available fleet size' datatype='real' name='[Calculation_1556275150398271505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[Input HPR Forcast (copy)] != 0 AND [Parameters].[Input HPR Forcast (copy 2)_1556275150392578062] = 0 AND [Parameters].[Input Churn Forcast (copy)] = 0) THEN [Parameters].[Input HPR Forcast (copy)] + SUM([one_avg_reactivated_rider_num]) - SUM([one_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input HPR Forcast (copy 2)_1556275150392578062] != 0 AND [Parameters].[Input HPR Forcast (copy)] = 0 AND [Parameters].[Input Churn Forcast (copy)] = 0) THEN SUM([one_avg_active_rider_num]) + SUM([one_avg_reactivated_rider_num]) - [Parameters].[Input HPR Forcast (copy 2)_1556275150392578062]&#10;ELSEIF ([Parameters].[Input Churn Forcast (copy)] != 0 AND [Parameters].[Input HPR Forcast (copy)] = 0 AND [Parameters].[Input HPR Forcast (copy 2)_1556275150392578062] = 0) THEN SUM([one_avg_active_rider_num]) + SUM([Parameters].[Input Churn Forcast (copy)]) - SUM([one_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input HPR Forcast (copy)] != 0 AND [Parameters].[Input HPR Forcast (copy 2)_1556275150392578062] != 0 AND [Parameters].[Input Churn Forcast (copy)] = 0) THEN [Parameters].[Input HPR Forcast (copy)] + SUM([one_avg_reactivated_rider_num]) - [Parameters].[Input HPR Forcast (copy 2)_1556275150392578062]&#10;ELSEIF ([Parameters].[Input HPR Forcast (copy)] != 0 AND [Parameters].[Input Churn Forcast (copy)] != 0 AND [Parameters].[Input HPR Forcast (copy 2)_1556275150392578062] = 0) THEN [Parameters].[Input HPR Forcast (copy)] + [Parameters].[Input Churn Forcast (copy)] - SUM([one_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input HPR Forcast (copy 2)_1556275150392578062] != 0 AND [Parameters].[Input Churn Forcast (copy)] != 0 AND [Parameters].[Input HPR Forcast (copy)] = 0) THEN SUM([one_avg_active_rider_num]) + [Parameters].[Input Churn Forcast (copy)] - [Parameters].[Input HPR Forcast (copy 2)_1556275150392578062]&#10;ELSEIF ([Parameters].[Input HPR Forcast (copy 2)_1556275150392578062] != 0 AND [Parameters].[Input Churn Forcast (copy)] != 0 AND [Parameters].[Input HPR Forcast (copy)] != 0) THEN [Parameters].[Input HPR Forcast (copy)] + [Parameters].[Input Churn Forcast (copy)] - [Parameters].[Input HPR Forcast (copy 2)_1556275150392578062]&#10;ELSE SUM([one_avg_active_rider_num]) + SUM([one_avg_reactivated_rider_num]) - SUM([one_avg_churned_rider_num]) END' />
            </column>
            <column caption='One Additional New Riders' datatype='real' name='[Calculation_1556275150399729684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1556275150396420112] - [Calculation_1556275150398271505]' />
            </column>
            <column caption='one L4W HPR' datatype='real' datatype-customized='true' default-format='n#,##0;-#,##0' name='[HPR (copy)_3954864171847786499]' role='measure' type='quantitative'>
