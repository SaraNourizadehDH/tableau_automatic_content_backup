            <column caption='Two Expected Fleet Size' datatype='real' name='[One Expected Fleet Size (copy)_3954864172152520710]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[Input w1 HPR Forcast (copy)_3954864172159819786] = 0) THEN [One Rider hours needed (copy)_3954864172152442885]/[one L4W HPR (copy)_3954864172163440654]&#10;ELSE [One Rider hours needed (copy)_3954864172152442885]/[Parameters].[Input w1 HPR Forcast (copy)_3954864172159819786]&#10;END' />
            </column>
            <column caption='Two Rider hours needed' datatype='real' name='[One Rider hours needed (copy)_3954864172152442885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[Input w1 UTR Forcast (copy)_3954864172159909900] = 0 AND [Parameters].[Input w1 Order Forcast (copy)_3954864172159864843] = 0 ) THEN SUM([two_avg_order_number])/[one L4W UTR (copy)_3954864172163567631]&#10;ELSEIF ([Parameters].[Input w1 UTR Forcast (copy)_3954864172159909900] = 0 AND  [Parameters].[Input w1 Order Forcast (copy)_3954864172159864843] != 0) THEN [Parameters].[Input w1 Order Forcast (copy)_3954864172159864843]/[one L4W UTR (copy)_3954864172163567631]&#10;ELSEIF ([Parameters].[Input w1 UTR Forcast (copy)_3954864172159909900] != 0 AND  [Parameters].[Input w1 Order Forcast (copy)_3954864172159864843] == 0) THEN SUM([two_avg_order_number])/[Parameters].[Input w1 UTR Forcast (copy)_3954864172159909900]&#10;ELSE [Parameters].[Input w1 Order Forcast (copy)_3954864172159864843]/[Parameters].[Input w1 UTR Forcast (copy)_3954864172159909900]&#10;END' />
            </column>
            <column caption='Two Additional New Riders 14' datatype='real' name='[Two Additional New Riders (copy)_5667076467841699841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[One Expected Fleet Size (copy)_3954864172152520710] - [Two Available fleet size (copy)_5667076467841605632]' />
            </column>
            <column caption='Two Available fleet size 14' datatype='real' name='[Two Available fleet size (copy)_5667076467841605632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] != 0 AND [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729] = 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] = 0) THEN [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] + 2*(SUM([two_avg_reactivated_rider_num]) - SUM([two_avg_churned_rider_num]))&#10;ELSEIF ([Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729] != 0 AND [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] = 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] = 0) THEN SUM([two_avg_active_rider_num]) + 2*SUM([two_avg_reactivated_rider_num]) - [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729]&#10;ELSEIF ([Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] != 0 AND [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] = 0 AND [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729] = 0) THEN SUM([two_avg_active_rider_num]) + SUM([Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421]) - 2*SUM([two_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] != 0 AND [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729] != 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] = 0) THEN [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] + 2*SUM([two_avg_reactivated_rider_num]) - [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729]&#10;ELSEIF ([Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] != 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] != 0 AND [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729] = 0) THEN [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] + [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] - 2*SUM([two_avg_churned_rider_num])&#10;ELSEIF ([Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729] != 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] != 0 AND [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] = 0) THEN SUM([two_avg_active_rider_num]) + [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] - [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729]&#10;ELSEIF ([Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729] != 0 AND [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] != 0 AND [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] != 0) THEN [Parameters].[Input w1 Active Riders Forcast (copy)_3954864172159348744] + [Parameters].[Input w1 Reactivation Forcast (copy)_3954864172162961421] - [Parameters].[Input w1 Churn Forcast (copy)_3954864172159774729]&#10;ELSE SUM([two_avg_active_rider_num]) + 2*(SUM([two_avg_reactivated_rider_num]) - SUM([two_avg_churned_rider_num])) END' />
            </column>
