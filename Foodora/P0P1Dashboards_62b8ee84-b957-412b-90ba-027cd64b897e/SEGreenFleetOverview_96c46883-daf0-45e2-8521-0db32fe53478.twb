      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_868991487D344C7FBBFC0C0E90BE2A85'>
            <properties context=''>
              <relation connection='bigquery.1m1uwrj1qdbrcz1dcqeta1xxjvbs' name='Custom SQL Query' type='text'>WITH&#13;
  zones AS (&#13;
  SELECT&#13;
    a.*,&#13;
    r.region_name&#13;
  FROM (&#13;
    SELECT&#13;
      c.name AS city_name,&#13;
      c.id AS city_id,&#13;
      z.id AS zone_id,&#13;
      z.name AS zone_name,&#13;
      country_code&#13;
    FROM `fulfillment-dwh-production.curated_data_shared.countries` co&#13;
    LEFT JOIN UNNEST(co.cities) AS c&#13;
    LEFT JOIN UNNEST (c.zones) AS z&#13;
    WHERE country_code = &apos;se&apos; ) AS a&#13;
  LEFT JOIN `foodora-bi-se.bl_performance.lg_dim_regions` AS r ON r.city_id = a.city_id &#13;
  ),&#13;
&#13;
deliveries AS (&#13;
&#13;
  SELECT&#13;
    created_date,&#13;
    rider_id,&#13;
    COUNT(order_code) AS total_orders&#13;
  FROM `foodora-bi-se.bl_performance.delivery_data`&#13;
  -- WHERE created_date &gt;&gt;= DATE_TRUNC((DATE_SUB(current_date, INTERVAL 6 MONTH)),MONTH)&#13;
  WHERE EXTRACT(YEAR FROM created_date) IN (2024, 2025)&#13;
  AND LOWER(order_status) = &apos;completed&apos;&#13;
  GROUP BY 1,2 &#13;
  ),&#13;
&#13;
rider_info AS (&#13;
    SELECT&#13;
      r.created_date,&#13;
      r.rider_id,&#13;
      r.city_id,&#13;
      r.zone_id,&#13;
      z.zone_name,&#13;
      z.region_name,&#13;
      r.vehicle_bag,&#13;
      ROUND(SUM(r.worekd_hours),2) AS total_hours&#13;
    FROM (&#13;
      SELECT&#13;
        created_date,&#13;
        shift_id,&#13;
        rider_id,&#13;
        city_id,&#13;
        zone_id,&#13;
        vehicle_bag,&#13;
        SAFE_DIVIDE(actual_working_time,3600) AS worekd_hours&#13;
      FROM`fulfillment-dwh-production.curated_data_shared.shifts` AS s&#13;
      -- WHERE created_date &gt;&gt;= DATE_TRUNC((DATE_SUB(current_date, INTERVAL 6 MONTH)),MONTH)&#13;
      WHERE EXTRACT(YEAR FROM created_date) IN (2024, 2025)&#13;
      AND country_code = &apos;se&apos;&#13;
      AND shift_state = &apos;EVALUATED&apos; ) AS r&#13;
    LEFT JOIN zones AS z ON z.zone_id = r.zone_id&#13;
    GROUP BY 1, 2,3,4,5,6,7&#13;
),&#13;
&#13;
date_dim as (&#13;
&#13;
  SELECT DISTINCT &#13;
    &#13;
    iso_date as report_date&#13;
    ,c.rider_id as rider_id&#13;
    ,c.city_id as city_id&#13;
    ,c.contract_name as contract_name&#13;
&#13;
  FROM `foodora-bi-se.bl_bi.dim_date` as d&#13;
  LEFT JOIN `foodora-bi-se.bl_performance.lg_rider_daily_contract`  as c ON c.report_date = d.iso_date&#13;
  -- WHERE iso_date &gt;&gt;= DATE_TRUNC((DATE_SUB(current_date, INTERVAL 6 MONTH)),MONTH) &#13;
  WHERE EXTRACT(YEAR FROM iso_date) IN (2024, 2025)&#13;
  ORDER By rider_id, iso_date ASC&#13;
)&#13;
SELECT *,&#13;
&#13;
  CASE WHEN vehicle_name IN (&apos;E Car&apos;,&apos;E Moped-Cl2&apos;,&apos;E Moped-Cl1&apos;) THEN &apos;Green Vehicles&apos;&#13;
       WHEN vehicle_name IN (&apos;Bike&apos;, &apos;Walker&apos;) THEN &apos;Bikes&apos;&#13;
       ELSE &apos;Conventional Vehicles&apos;&#13;
  END as vehicle_category&#13;
&#13;
FROM (&#13;
  SELECT&#13;
    ri.created_date,&#13;
    ri.rider_id,&#13;
    ri.zone_name,&#13;
    ri.region_name,&#13;
    ri.vehicle_bag,&#13;
    dd.contract_name,&#13;
    ri.total_hours,&#13;
    d.total_orders,&#13;
    ROUND(SAFE_DIVIDE(d.total_orders,total_hours),2) AS UTR,&#13;
&#13;
    CASE WHEN LOWER(contract_name) LIKE &apos;%foodora car%&apos; OR vehicle_bag LIKE &apos;%E Car%&apos; THEN &apos;E Car&apos; &#13;
         WHEN LOWER(contract_name) NOT LIKE &apos;%foodora car%&apos; AND vehicle_bag LIKE &apos;%Car - Standard Car Bag%&apos; THEN &apos;Car&apos;&#13;
         WHEN vehicle_bag LIKE &apos;Moped - Backpack%&apos; OR vehicle_bag LIKE &apos;Moped - Cl2 - Backpack%&apos; OR vehicle_bag LIKE &apos;Moped - Cl1%&apos; THEN &apos;Mopeds&apos;&#13;
         WHEN vehicle_bag LIKE &apos;%Bike - Backpack%&apos; THEN &apos;Bike&apos;&#13;
         WHEN vehicle_bag LIKE &apos;%Walker%&apos; THEN &apos;Walker&apos;&#13;
         WHEN vehicle_bag LIKE &apos;%E Moped - Cl2%&apos; OR vehicle_bag LIKE &apos;%E Moped Cargo - Cl2%&apos; OR vehicle_bag LIKE &apos;%Bike - Cargo%&apos; OR vehicle_bag LIKE &apos;%Bike - Heavy Cargo%&apos; THEN &apos;E Moped-Cl2&apos;&#13;
         WHEN vehicle_bag LIKE &apos;%E Moped - Cl1%&apos; OR vehicle_bag LIKE &apos;%E Moped Cargo - Cl1%&apos; OR  vehicle_bag LIKE &apos;Moped - Cargo%&apos; THEN &apos;E Moped-Cl1&apos;&#13;
    END as vehicle_name&#13;
&#13;
  FROM rider_info AS ri&#13;
  LEFT JOIN deliveries AS d ON d.created_date = ri.created_date AND d.rider_id = ri.rider_id&#13;
  LEFT JOIN date_dim as dd ON dd.report_date = ri.created_date AND dd.rider_id = ri.rider_id&#13;
  WHERE zone_name IS NOT NULL&#13;
  AND vehicle_bag IS NOT NULL&#13;
)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
