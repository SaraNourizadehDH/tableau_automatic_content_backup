      <column caption='Scheduled Riders for vacation' datatype='real' name='[Calculation_1950340180497797121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(([total_planned_vacations_hours] * 6)/([target_zone_hpr] * [num_working_days]))' />
      </column>
      <column caption='total_vacations' datatype='integer' name='[Calculation_2487675853674131457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[final_balance_days] + [saved_days]' />
      </column>
