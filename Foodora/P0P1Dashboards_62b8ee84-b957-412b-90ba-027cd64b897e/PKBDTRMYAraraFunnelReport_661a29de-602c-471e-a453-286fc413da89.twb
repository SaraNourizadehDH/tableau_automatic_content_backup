      <aliases enabled='yes' />
      <column caption='Applicant Count ' datatype='integer' name='[Applicant Count (t -1) (copy)_1872934555484880911]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([applicant_id])' />
      </column>
      <column caption='Applicant Count (t -1)' datatype='integer' name='[Calculation_1872934555447169025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF tier = -1 THEN [applicant_id] END )' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_1872934555465777156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM((COUNTD([applicant_id])))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation2' datatype='real' name='[Calculation_1872934555466379270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([applicant_id]) / WINDOW_SUM([Calculation_1872934555447169025])'>
          <table-calc ordering-field='[federated.0nsbx350no7ns91h7crdr1reyw8d].[stage_name]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Window Sum with %' datatype='string' name='[Calculation_1872934555466686471]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR([Calculation_1872934555465777156]) &#13;&#10;+ CHAR(10) + &quot;(&quot; + STR(ROUND([Calculation_1872934555466379270] * 100, 0)) + &quot;%)&quot;'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CVR %' datatype='real' default-format='p0.0%' name='[Calculation_1872934555503018009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hired])/SUM([applicants])' />
      </column>
      <column caption='RAF Share %' datatype='real' default-format='p0.0%' name='[Calculation_1872934555503292442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([raf_hired])/SUM([hired])' />
      </column>
      <column caption='D2H' datatype='real' name='[Calculation_1872934555503505435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([days_to_hire])/SUM([hired])' />
      </column>
      <column caption='Stage Tiers' datatype='string' name='[Calculation_2460091357543063553]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [stage_name]  &#13;&#10;    WHEN &apos;Lead&apos; THEN &apos;T1&apos;  &#13;&#10;    WHEN &apos;Welcome&apos; THEN &apos;T2&apos;  &#13;&#10;    WHEN &apos;Decentralized Onboarding&apos; THEN &apos;T3&apos;  &#13;&#10;    WHEN &apos;Walk-in Onboarding&apos; THEN &apos;T3&apos;  &#13;&#10;    WHEN &apos;Schedule Onboarding&apos; THEN &apos;T3&apos;  &#13;&#10;    WHEN &apos;Document Collection&apos; THEN &apos;T4&apos;  &#13;&#10;    WHEN &apos;Document Review&apos; THEN &apos;T5&apos;  &#13;&#10;    WHEN &apos;Training&apos; THEN &apos;T6&apos;  &#13;&#10;    WHEN &apos;Quiz&apos; THEN &apos;T6&apos;  &#13;&#10;    WHEN &apos;Service Agreement&apos; THEN &apos;T7&apos;  &#13;&#10;    WHEN &apos;Hired&apos; THEN &apos;T8&apos;  &#13;&#10;    WHEN &apos;Rider&apos; THEN &apos;T9&apos;  &#13;&#10;    WHEN &apos;Active Rider&apos; THEN &apos;T10&apos;  &#13;&#10;END' />
      </column>
      <column caption='Lead Source' datatype='string' name='[Calculation_2505971779144396800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [utm_source] = &apos;raf&apos; THEN &apos;RAF&apos;  &#13;&#10;ELSE &apos;Non RAF&apos;  &#13;&#10;END' />
      </column>
      <column caption='Non RAF CVR%' datatype='real' default-format='p0.0%' name='[Calculation_918452910161461248]' role='measure' type='quantitative'>
