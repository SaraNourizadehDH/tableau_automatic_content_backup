          </named-connection>
        </named-connections>
      </connection>
      <aliases enabled='yes' />
      <column caption='Total Leads' datatype='integer' name='[Calculation_2988138407499251712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([applicants])' />
      </column>
      <column caption='Workflow Stage Name' datatype='string' name='[Calculation_2988138407515271175]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [workflow_stage_name] IN (&apos;Welcome&apos;, &apos;Decentralized Onboarding&apos;, &apos;Scheduled Onboarding&apos;, &apos;Walk-in Onboarding&apos;) THEN &#13;&#10;    &apos;S1: Welcome Stage&apos;&#13;&#10;ELSEIF [workflow_stage_name] = &apos;Document Collection&apos; THEN &#13;&#10;    &apos;S2: Document Collection&apos;&#13;&#10;ELSEIF [workflow_stage_name] IN (&apos;Quiz&apos;, &apos;Training&apos;) THEN &#13;&#10;    &apos;S3: Quiz&apos;&#13;&#10;ELSEIF [workflow_stage_name] = &apos;Service Agreement&apos; THEN &#13;&#10;    &apos;S4: Service Agreement&apos;&#13;&#10;ELSEIF [workflow_stage_name] = &apos;Document Review&apos; THEN &#13;&#10;    &apos;S5: Document Review&apos;&#13;&#10;ELSEIF [workflow_stage_name] = &apos;Rejected&apos; THEN &#13;&#10;    &apos;S6: Rejected&apos;&#13;&#10;ELSE &#13;&#10;    &apos;Other&apos;  // Optional: Handles unexpected values&#13;&#10;END' />
      </column>
      <column caption='CVR %' datatype='real' default-format='p0.0%' name='[Calculation_2988138408592162828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hired])/SUM([applicants (Custom SQL Query1)])' />
      </column>
      <column caption='RAF %' datatype='real' default-format='p0.0%' name='[Calculation_2988138408594968589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([raf_hired])/SUM([hired])' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_2988138409294524431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM([applicants]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation2' datatype='real' name='[Calculation_2988138409294741520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([applicants]) / WINDOW_SUM(SUM([applicants]))'>
          <table-calc ordering-field='[federated.1nen6a00mxg1zr1fjyq5w1yls6oa].[workflow_stage_name]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Applicants with % of Total' datatype='string' name='[Calculation_2988138409294987281]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR([Calculation_2988138409294524431]) &#13;&#10;+ CHAR(10) + &quot;(&quot; + STR(ROUND([Calculation_2988138409294741520] * 100, 0)) + &quot;%)&quot;'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column-instance column='[Calculation_2988138407515271175]' derivation='None' name='[none:Calculation_2988138407515271175:nk]' pivot='key' type='nominal' />
      <column-instance column='[Calculation_2988138409294987281]' derivation='User' name='[usr:Calculation_2988138409294987281:nk:2]' pivot='key' type='nominal'>
