      <aliases enabled='yes' />
      <column caption='# Activated Leads' datatype='integer' default-format='N' name='[# Hired Leads (copy)_1266918914863206405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [first_shift_at] &gt; DATE(&quot;1970-01-01&quot;) then [applicant_id] end)' />
      </column>
      <column caption='# Hired Leads' datatype='integer' default-format='N' name='[# Leads (copy)_1266918914851127300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [hired_at] &gt; DATE(&quot;1970-01-01&quot;) then [applicant_id] end)' />
      </column>
      <column caption='% Hired Leads' datatype='real' default-format='p0.0%' name='[% Activated Leads (copy)_1266918914864418823]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# Leads (copy)_1266918914851127300]/[Calculation_1266918914850570243]' />
      </column>
      <column caption='AVG Days Hire to Shift' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AVG Days Lead to Hire (copy)_1266918914885275659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(if [hire_to_shift] &gt;= 0 and date([first_shift_at]) &gt; date(&quot;1970-01-01&quot;) then [hire_to_shift] end)' />
      </column>
      <column caption='# Leads' datatype='integer' default-format='N' name='[Calculation_1266918914850570243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([applicant_id])' />
      </column>
      <column caption='% Activated Leads' datatype='real' default-format='p0.0%' name='[Calculation_1266918914863464454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# Hired Leads (copy)_1266918914863206405] / [# Leads (copy)_1266918914851127300]' />
      </column>
      <column caption='AVG Days to Stage' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1266918914873393160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([time_to_stage])/24' />
      </column>
      <column caption='AVG Days to Complete Stage' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1266918914873974793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(if [stage_is_completed] then [time_to_complete_stage] END) / 86400' />
      </column>
      <column caption='AVG Days Lead to Hire' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1266918914884743178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(if [welc_to_hired] &gt;= 1 then [welc_to_hired] end)' />
      </column>
      <column caption='vehicle group' datatype='string' name='[Calculation_662873589214613504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(lower([vehicle]), &apos;car&apos;) then &apos;car&apos;&#13;&#10;elseif CONTAINS(lower([vehicle]), &apos;motorbike&apos;) then &apos;motorbike&apos;&#13;&#10;elseif CONTAINS(lower([vehicle]), &apos;bicyc&apos;) or CONTAINS(lower([vehicle]), &apos;bike&apos;) then &apos;bicycle&apos;&#13;&#10;else &apos;organic&apos; end' />
      </column>
