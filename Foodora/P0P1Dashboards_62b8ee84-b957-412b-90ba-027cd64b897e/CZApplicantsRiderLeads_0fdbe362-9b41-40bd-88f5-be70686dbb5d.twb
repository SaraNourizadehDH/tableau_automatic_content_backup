        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0fv1f200n9nqhp10a950l0uxa8nf' name='Custom SQL Query' type='text'><![CDATA[WITH params AS (
  SELECT
    DATE_SUB(CURRENT_DATE(), INTERVAL 60 DAY) AS start_date,
    CURRENT_DATE() AS end_date
),
base_applicants AS (
  SELECT
    a.country_code,
    a.applicant_id,
    a.rider_id,
    a.company_name,
    a.created_date,
    DATETIME(a.approved_at, "Europe/Prague") AS hired_at,
    s.created_at                             AS shift_created_at_utc,
    DATETIME(s.actual_start_at, "Europe/Prague") AS first_shift_at,
    ROW_NUMBER() OVER (
      PARTITION BY a.applicant_id, a.country_code
      ORDER BY s.actual_start_at
    ) AS rn
  FROM `fulfillment-dwh-production.curated_data_shared.applicants` a
  CROSS JOIN params
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.shifts` s
    ON a.rider_id = s.rider_id
   AND a.country_code = s.country_code
   AND s.created_date BETWEEN params.start_date AND params.end_date
  WHERE a.country_code = 'cz'
    AND a.company_name = 'ico'
    AND a.created_date BETWEEN params.start_date AND params.end_date
    AND a.approved_at IS NOT NULL
)
SELECT
  DATE_TRUNC(a.created_date, WEEK(MONDAY)) AS week_start,
  COUNT(*) AS total_hired_riders,
  COUNTIF(
    TIMESTAMP_DIFF(shift_created_at_utc, TIMESTAMP(hired_at, "Europe/Prague"), HOUR) <<= 24
  ) AS riders_booked_shift_in_24h,
  SAFE_DIVIDE(
    COUNTIF(
      TIMESTAMP_DIFF(shift_created_at_utc, TIMESTAMP(hired_at, "Europe/Prague"), HOUR) <<= 24
    ),
    COUNT(*)
  ) AS pct_riders_booked_shift_in_24h,
  COUNTIF(
    TIMESTAMP_DIFF(
      TIMESTAMP(first_shift_at, "Europe/Prague"),
      TIMESTAMP(hired_at,       "Europe/Prague"),
      HOUR
    ) <<= 24
  ) AS riders_started_shift_in_24h,
  SAFE_DIVIDE(
    COUNTIF(
      TIMESTAMP_DIFF(
        TIMESTAMP(first_shift_at, "Europe/Prague"),
        TIMESTAMP(hired_at,       "Europe/Prague"),
        HOUR
      ) <<= 24
    ),
    COUNT(*)
  ) AS pct_riders_started_shift_in_24h
FROM base_applicants a
WHERE rn = 1
GROUP BY week_start
ORDER BY week_start]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0fv1f200n9nqhp10a950l0uxa8nf' name='Custom SQL Query' type='text'><![CDATA[WITH params AS (
