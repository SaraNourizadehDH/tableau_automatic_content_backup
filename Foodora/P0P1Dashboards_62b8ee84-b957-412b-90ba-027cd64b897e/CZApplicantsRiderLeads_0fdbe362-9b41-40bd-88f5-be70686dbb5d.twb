        TIMESTAMP(hired_at,       "Europe/Prague"),
        HOUR
      ) <<= 24
    ),
    COUNT(*)
  ) AS pct_riders_started_shift_in_24h
FROM base_applicants a
WHERE rn = 1
GROUP BY week_start
ORDER BY week_start]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
