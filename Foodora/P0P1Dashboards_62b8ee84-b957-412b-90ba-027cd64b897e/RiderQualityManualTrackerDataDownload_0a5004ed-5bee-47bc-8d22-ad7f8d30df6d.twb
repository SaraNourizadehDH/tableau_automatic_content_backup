      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_80F3D71F5C3546C88271810906776632'>
            <properties context=''>
              <relation connection='bigquery.119f1bo02v4w5l1eb6lw71atsy53' name='Custom SQL Query' type='text'><![CDATA[WITH input AS (
  SELECT 
    DATETIME_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 WEEK), WEEK(MONDAY)) AS datetime_start,
    DATETIME_SUB(DATETIME_TRUNC(CURRENT_DATE, WEEK(MONDAY)), INTERVAL 1 SECOND) AS datetime_end,
    DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 WEEK), WEEK(MONDAY)), INTERVAL 1 DAY) AS date
),

ccr AS (
  SELECT
    order_id AS order_code,
    global_entity_id,
    contact_reason_l1 AS rcr1,
    contact_reason_l2 AS rcr2,
    contact_reason_l3 AS rcr3
  FROM `fulfillment-dwh-production.curated_data_shared.all_contacts`
  JOIN input ON TRUE
  WHERE 1=1
    AND created_date >>= date
    AND global_entity_id NOT IN ("FP_DE","FP_TW","FP_JP","HN_DK")
    AND contact_reason_l3 IN (
         "Order marked as delivered but didn't receive",
         "Order never arrived",
         "Order not delivered",
         "Wrong order",
         "Spilled food",
         "Spilled/Damaged"
        )   
),

base AS (
  SELECT DISTINCT
    FORMAT_DATE("%G-%b", DATETIME_TRUNC(pd.ordered_at_local, WEEK(MONDAY))) AS year_month,
    FORMAT_DATE("%G-%V", DATETIME_TRUNC(pd.ordered_at_local, WEEK(MONDAY))) AS year_week,
    pd.created_date_local,
    CASE 
      WHEN LOWER(RIGHT(pd.global_entity_id,2)) IN ("at","cz","fi","hu","no","se") THEN "foodora"
      WHEN LOWER(RIGHT(pd.global_entity_id,2)) IN ("bd","kh","hk","la","my","mm","pk","ph","sg","th") THEN "foodpanda"
      WHEN LOWER(RIGHT(pd.global_entity_id,2)) IN ("tr") THEN "Yemeksepeti"
    END AS brand,
    o.country_code,
    o.platform_order_code,
    o.customer.external_customer_id,
    d.id AS delivery_id,
    d.has_proof_of_pickup,
    d.has_proof_of_delivery,
    d.is_returning,
    d.rider_id,
    ccr.rcr3,
    pd.decline_reason.title
  FROM `fulfillment-dwh-production.pandata_curated.pd_orders` pd
  JOIN input ON TRUE
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.orders` o
    ON o.entity.id = pd.global_entity_id
   AND o.platform_order_code = pd.code
   AND o.created_date >>= date
  LEFT JOIN UNNEST(deliveries) d
  LEFT JOIN ccr 
    ON ccr.global_entity_id = o.entity.id 
   AND ccr.order_code = o.platform_order_code
  WHERE created_date_utc >>= date
    AND DATETIME(o.created_at) BETWEEN datetime_start AND datetime_end
    AND pd.decline_reason.title IN (
         "Customer received wrong order",
         "Customer received food totally spilled",
         "Customer never received the order"
        )
    AND pd.global_entity_id NOT IN ("FP_DE","FP_TW","FP_JP","HN_DK")
    AND o.country_code <<>> 't5'
    AND ccr.rcr3 IS NOT NULL
    AND d.has_proof_of_delivery IS TRUE
),

customer AS (
  -- valid order | failed order | event type
  --  False          True         not null
  --  True          False       refund / mixed

  WITH input AS (
    SELECT 
      DATETIME_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 WEEK), WEEK(MONDAY)) AS datetime_start,
      DATETIME_SUB(DATETIME_TRUNC(CURRENT_DATE, WEEK(MONDAY)), INTERVAL 1 SECOND) AS datetime_end,
      DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE, INTERVAL 1 WEEK), WEEK(MONDAY)), INTERVAL 1 DAY) AS date
  ),
  base AS (
    SELECT DISTINCT
      CASE 
        WHEN LOWER(RIGHT(pd.global_entity_id,2)) IN ("at","cz","fi","hu","no","se") THEN "foodora"
        WHEN LOWER(RIGHT(pd.global_entity_id,2)) IN ("bd","kh","hk","la","my","mm","pk","ph","sg","th") THEN "foodpanda"
        WHEN LOWER(RIGHT(pd.global_entity_id,2)) IN ("tr") THEN "Yemeksepeti"
      END AS brand,
      LOWER(RIGHT(pd.global_entity_id,2)) AS country_code,
      o.customer.external_customer_id,
      COUNT(DISTINCT code) AS total_order_count,
      COUNT(DISTINCT (CASE WHEN is_failed_order IS TRUE AND event_type IS NOT NULL THEN code END)) AS failed_order_count,
      COUNT(DISTINCT (CASE WHEN event_type IS NOT NULL THEN code END)) AS all_refunded_comp_order_count
    FROM `fulfillment-dwh-production.pandata_curated.pd_orders` pd
    JOIN input ON TRUE
    LEFT JOIN `fulfillment-dwh-production.curated_data_shared.orders` o
      ON pd.global_entity_id = o.entity.id
     AND pd.code = o.platform_order_code
     AND o.country_code <<>> "t5"
     AND o.created_date >>= date 
    LEFT JOIN `fulfillment-dwh-production.curated_data_shared.comp_and_refund_events` c
      ON c.global_entity_id = pd.global_entity_id 
     AND c.order_id = pd.code
    WHERE created_date_utc >>= date
      AND o.created_date >>= date
      AND pd.global_entity_id NOT IN ("FP_DE","FP_TW","FP_JP","HN_DK")
      AND pd.is_delivery = TRUE
    GROUP BY all
  )
  SELECT DISTINCT
    brand,
    country_code,
    external_customer_id,
    total_order_count,
    failed_order_count,
    all_refunded_comp_order_count,
    SAFE_DIVIDE(failed_order_count, total_order_count) AS failed_order_rate,
    SAFE_DIVIDE(all_refunded_comp_order_count, total_order_count) AS all_refunded_comp_order_count_rate
  FROM base
  WHERE brand IS NOT NULL
  GROUP BY all
)

SELECT DISTINCT
  country_code,
  created_date_local,
  platform_order_code,
  title AS decline_reason,
  delivery_id,
  rider_id,
  has_proof_of_pickup,
  has_proof_of_delivery,
  is_returning,
  CONCAT("https://hk.ap.logisticsbackoffice.com/dashboard/v2/hurrier/order_details/", platform_order_code) AS Hurrier_link,
  c.total_order_count AS customer_yearly_total_order_count,
  c.failed_order_count AS customer_yearly_failed_order_count,
  c.failed_order_rate AS customer_yearly_fail_rate
FROM base
LEFT JOIN customer c USING (country_code, external_customer_id)
ORDER BY created_date_local]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Potential Fraud' inline='true' name='federated.1pjuvwn0isbgdf19ohdav0o36n70' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1lza54b11c01ez1a76nct0c0wpta'>
            <connection CATALOG='foodora-bi-no' EXECCATALOG='foodora-bi-no' authentication='yes' class='bigquery' connection-dialect='google-sql' project='Foodora BI NO' schema='bl_lg_mgmt' server='' server-oauth='server-custom' username='alvaro.marcano@foodora.no' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1lza54b11c01ez1a76nct0c0wpta' name='Custom SQL Query' type='text'><![CDATA[With input as (
  SELECT 
    DATETIME_TRUNC(DATE_SUB(CURRENT_DATE,INTERVAL 7 DAY),WEEK(MONDAY)) as datetime_start,
    DATETIME_SUB(DATETIME_TRUNC(CURRENT_DATE, WEEK(MONDAY)),INTERVAL 1 SECOND) as datetime_end,
    DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE,INTERVAL 1 WEEK),WEEK(MONDAY)),INTERVAL 1 DAY) AS date
)

,ccr as (

SELECT

  order_id as order_code,
  global_entity_id,
  contact_reason_l1 AS rcr1,
  contact_reason_l2 AS rcr2,
  contact_reason_l3 AS rcr3

FROM `fulfillment-dwh-production.curated_data_shared.all_contacts`
JOIN input on true
WHERE 1=1
      AND created_date >>= date
      AND global_entity_id not in ("FP_DE","FP_TW","FP_JP","HN_DK")
      AND lower(contact_reason_l3) in ("accident","customer unreachable","unable to contact","unable to find location","request: unable to locate pickup partner","unable to locate the address","request: partner closed for pickup","restaurant shown as closed","closed","vendor clicked through for pick-up","need help locating partner for pickup")
)

,base as (
Select distinct

format_date("%G-%b",datetime_trunc(pd.ordered_at_local,week(monday))) as year_month,
format_date("%G-%V",datetime_trunc(pd.ordered_at_local,week(monday))) as year_week,
pd.created_date_local,
case when lower(right(pd.global_entity_id,2)) in ("at","cz","fi","hu","no","se") then "foodora"
     when lower(right(pd.global_entity_id,2)) in ("bd","kh","hk","la","my","mm","pk","ph","sg","th") then "foodpanda"
     when lower(right(pd.global_entity_id,2)) in ("tr") then "Yemeksepeti"
     end as brand,
o.country_code,
o.platform_order_code,
o.customer.external_customer_id,
d.id as delivery_id,
d.rider_id,
ccr.rcr3,
pd.decline_reason.title


From `fulfillment-dwh-production.pandata_curated.pd_orders` pd
Join input on true
Left join `fulfillment-dwh-production.curated_data_shared.orders` o
on o.entity.id = pd.global_entity_id
and o.platform_order_code = pd.code
and o.created_date >>= date
left join unnest (deliveries) d
left join ccr on ccr.global_entity_id = o.entity.id 
             and ccr.order_code = o.platform_order_code
where created_date_utc >>= date
and datetime(o.created_at) between datetime_start and datetime_end
and pd.decline_reason.title in ("Rider accident","Unable to find or reach customer","Vendor closed","Customer refuses/is unable to pay for the order")
and pd.global_entity_id not in ("FP_DE","FP_TW","FP_JP","HN_DK")
and o.country_code <<>> 't5'
--and ccr.rcr3 is not null
),

count as (
Select distinct

country_code,
rider_id,
title,
count(distinct platform_order_code) as count

from base
group by 1,2,3
),

customer as (

With input as (
  SELECT 
    DATETIME_TRUNC(DATE_SUB(CURRENT_DATE,INTERVAL 1 YEAR),WEEK(MONDAY)) as datetime_start,
    DATETIME_SUB(DATETIME_TRUNC(CURRENT_DATE, WEEK(MONDAY)),INTERVAL 1 SECOND) as datetime_end,
    DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE,INTERVAL 1 YEAR),WEEK(MONDAY)),INTERVAL 1 DAY) AS date
),

base as (
Select distinct

-- format_date("%G-%V",datetime_trunc(created_date_local,week(monday))) as year_week,
case when lower(right(pd.global_entity_id,2)) in ("at","cz","fi","hu","no","se") then "foodora"
     when lower(right(pd.global_entity_id,2)) in ("bd","kh","hk","la","my","mm","pk","ph","sg","th") then "foodpanda"
     when lower(right(pd.global_entity_id,2)) in ("tr") then "Yemeksepeti"
     end as brand,
lower(right(pd.global_entity_id,2)) as country_code,
o.customer.external_customer_id,
count(distinct code) as total_order_count,
count(distinct (case when is_failed_order is true and event_type is not null then code end)) as failed_order_count,
count(distinct (case when event_type is not null then code end)) as all_refunded_comp_order_count


From `fulfillment-dwh-production.pandata_curated.pd_orders` pd
Join input on true
Left join `fulfillment-dwh-production.curated_data_shared.orders` o
on pd.global_entity_id = o.entity.id
and pd.code = o.platform_order_code
and o.country_code <<>> "t5"
and o.created_date >>= date 
Left join `fulfillment-dwh-production.curated_data_shared.comp_and_refund_events` c
on c.global_entity_id = pd.global_entity_id 
and c.order_id = pd.code
where created_date_utc >>= date
and o.created_date >>= date
and pd.global_entity_id not in ("FP_DE","FP_TW","FP_JP","HN_DK")
and pd.is_delivery = True
group by all
)

Select distinct

brand,
country_code,
external_customer_id,
total_order_count,
failed_order_count,
all_refunded_comp_order_count,
safe_divide(failed_order_count,total_order_count) as failed_order_rate,
safe_divide(all_refunded_comp_order_count,total_order_count) as all_refunded_comp_order_count_rate


from base
where brand is not null
group by all
)

SELECT DISTINCT

country_code,
created_date_local,
platform_order_code,
title as decline_reason,
delivery_id,
rider_id,
concat("https://hk.ap.logisticsbackoffice.com/dashboard/v2/hurrier/order_details/",platform_order_code) as Hurrier_link, --- change country code
c.total_order_count as customer_yearly_total_order_count,
c.failed_order_count as customer_yearly_failed_order_count,
c.failed_order_rate as customer_yearly_fail_rate

from base
left join customer c using (country_code,external_customer_id)
left join count ct using (country_code,rider_id,title)
where
ct.count >>= 2
order by 6,4,2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1lza54b11c01ez1a76nct0c0wpta' name='Custom SQL Query' type='text'><![CDATA[With input as (
  SELECT 
    DATETIME_TRUNC(DATE_SUB(CURRENT_DATE,INTERVAL 7 DAY),WEEK(MONDAY)) as datetime_start,
    DATETIME_SUB(DATETIME_TRUNC(CURRENT_DATE, WEEK(MONDAY)),INTERVAL 1 SECOND) as datetime_end,
    DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE,INTERVAL 1 WEEK),WEEK(MONDAY)),INTERVAL 1 DAY) AS date
)

,ccr as (

SELECT

  order_id as order_code,
  global_entity_id,
  contact_reason_l1 AS rcr1,
  contact_reason_l2 AS rcr2,
  contact_reason_l3 AS rcr3

FROM `fulfillment-dwh-production.curated_data_shared.all_contacts`
JOIN input on true
WHERE 1=1
      AND created_date >>= date
      AND global_entity_id not in ("FP_DE","FP_TW","FP_JP","HN_DK")
      AND lower(contact_reason_l3) in ("accident","customer unreachable","unable to contact","unable to find location","request: unable to locate pickup partner","unable to locate the address","request: partner closed for pickup","restaurant shown as closed","closed","vendor clicked through for pick-up","need help locating partner for pickup")
)

,base as (
Select distinct

format_date("%G-%b",datetime_trunc(pd.ordered_at_local,week(monday))) as year_month,
format_date("%G-%V",datetime_trunc(pd.ordered_at_local,week(monday))) as year_week,
pd.created_date_local,
case when lower(right(pd.global_entity_id,2)) in ("at","cz","fi","hu","no","se") then "foodora"
     when lower(right(pd.global_entity_id,2)) in ("bd","kh","hk","la","my","mm","pk","ph","sg","th") then "foodpanda"
     when lower(right(pd.global_entity_id,2)) in ("tr") then "Yemeksepeti"
     end as brand,
o.country_code,
o.platform_order_code,
o.customer.external_customer_id,
d.id as delivery_id,
d.rider_id,
ccr.rcr3,
pd.decline_reason.title


From `fulfillment-dwh-production.pandata_curated.pd_orders` pd
Join input on true
Left join `fulfillment-dwh-production.curated_data_shared.orders` o
on o.entity.id = pd.global_entity_id
and o.platform_order_code = pd.code
and o.created_date >>= date
left join unnest (deliveries) d
left join ccr on ccr.global_entity_id = o.entity.id 
             and ccr.order_code = o.platform_order_code
where created_date_utc >>= date
and datetime(o.created_at) between datetime_start and datetime_end
and pd.decline_reason.title in ("Rider accident","Unable to find or reach customer","Vendor closed","Customer refuses/is unable to pay for the order")
and pd.global_entity_id not in ("FP_DE","FP_TW","FP_JP","HN_DK")
and o.country_code <<>> 't5'
--and ccr.rcr3 is not null
),

count as (
Select distinct

country_code,
rider_id,
title,
count(distinct platform_order_code) as count

from base
group by 1,2,3
),

customer as (

With input as (
  SELECT 
    DATETIME_TRUNC(DATE_SUB(CURRENT_DATE,INTERVAL 1 YEAR),WEEK(MONDAY)) as datetime_start,
    DATETIME_SUB(DATETIME_TRUNC(CURRENT_DATE, WEEK(MONDAY)),INTERVAL 1 SECOND) as datetime_end,
    DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE,INTERVAL 1 YEAR),WEEK(MONDAY)),INTERVAL 1 DAY) AS date
),

base as (
Select distinct

-- format_date("%G-%V",datetime_trunc(created_date_local,week(monday))) as year_week,
case when lower(right(pd.global_entity_id,2)) in ("at","cz","fi","hu","no","se") then "foodora"
     when lower(right(pd.global_entity_id,2)) in ("bd","kh","hk","la","my","mm","pk","ph","sg","th") then "foodpanda"
     when lower(right(pd.global_entity_id,2)) in ("tr") then "Yemeksepeti"
     end as brand,
lower(right(pd.global_entity_id,2)) as country_code,
o.customer.external_customer_id,
count(distinct code) as total_order_count,
count(distinct (case when is_failed_order is true and event_type is not null then code end)) as failed_order_count,
count(distinct (case when event_type is not null then code end)) as all_refunded_comp_order_count


From `fulfillment-dwh-production.pandata_curated.pd_orders` pd
Join input on true
Left join `fulfillment-dwh-production.curated_data_shared.orders` o
on pd.global_entity_id = o.entity.id
and pd.code = o.platform_order_code
and o.country_code <<>> "t5"
and o.created_date >>= date 
Left join `fulfillment-dwh-production.curated_data_shared.comp_and_refund_events` c
on c.global_entity_id = pd.global_entity_id 
and c.order_id = pd.code
where created_date_utc >>= date
and o.created_date >>= date
and pd.global_entity_id not in ("FP_DE","FP_TW","FP_JP","HN_DK")
and pd.is_delivery = True
group by all
)

Select distinct

brand,
country_code,
external_customer_id,
total_order_count,
failed_order_count,
all_refunded_comp_order_count,
safe_divide(failed_order_count,total_order_count) as failed_order_rate,
safe_divide(all_refunded_comp_order_count,total_order_count) as all_refunded_comp_order_count_rate


from base
where brand is not null
group by all
)

SELECT DISTINCT

country_code,
created_date_local,
platform_order_code,
title as decline_reason,
delivery_id,
rider_id,
concat("https://hk.ap.logisticsbackoffice.com/dashboard/v2/hurrier/order_details/",platform_order_code) as Hurrier_link, --- change country code
c.total_order_count as customer_yearly_total_order_count,
c.failed_order_count as customer_yearly_failed_order_count,
c.failed_order_rate as customer_yearly_fail_rate

from base
left join customer c using (country_code,external_customer_id)
left join count ct using (country_code,rider_id,title)
where
ct.count >>= 2
order by 6,4,2]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
