    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Total_APAC_reporting'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/BambooRewardsAnalysis/Total_APAC_reporting?rev=' id='Total_APAC_reporting' path='/t/Foodora/workbooks/BambooRewardsAnalysis' revision='' site='Foodora' />
      <style />
