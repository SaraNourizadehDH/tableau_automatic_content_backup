            <map to='#a6dc96'>
              <bucket>&quot;Good&quot;</bucket>
            </map>
            <map to='#f2f2f2'>
              <bucket>&quot;To Improve&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[usr:Calculation_1380564400488742919:nk]' type='palette'>
            <map to='#6cba5d'>
              <bucket>&quot;Great&quot;</bucket>
            </map>
            <map to='#a6dc96'>
              <bucket>&quot;Good&quot;</bucket>
