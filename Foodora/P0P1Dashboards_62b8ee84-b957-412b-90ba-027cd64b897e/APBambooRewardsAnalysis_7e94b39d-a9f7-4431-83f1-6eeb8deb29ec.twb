      <datasources>
        <datasource caption='enrolled riders' name='federated.1x9mkmx1rplbv21d75gam1mmfq3p' />
      </datasources>
      <datasource-dependencies datasource='federated.1x9mkmx1rplbv21d75gam1mmfq3p'>
        <column caption='is_BR_city' datatype='boolean' name='[Calculation_2443413919069224969]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [lg_country_code] = &apos;pk&apos; THEN [city_name (group)] = &apos;PK_BR_city&apos; &#10;ELSEIF [lg_country_code] = &apos;la&apos; THEN [city_name (group)] = &apos;LA_BR_city&apos;&#10;END' />
        </column>
        <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column datatype='string' name='[lg_country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column-instance column='[Calculation_2443413919069224969]' derivation='None' name='[none:Calculation_2443413919069224969:nk]' pivot='key' type='nominal' />
        <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[lg_country_code]' derivation='None' name='[none:lg_country_code:nk]' pivot='key' type='nominal' />
