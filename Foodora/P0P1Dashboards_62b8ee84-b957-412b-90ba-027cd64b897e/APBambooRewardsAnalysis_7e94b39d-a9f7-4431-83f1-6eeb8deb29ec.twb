    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='README'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/BambooRewardsAnalysis/README_1?rev=' id='README_1' path='/t/Foodora/workbooks/BambooRewardsAnalysis' revision='' site='Foodora' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='87000' id='3' param='vert' type-v2='layout-flow' w='98400' x='800' y='12000'>
            <zone forceUpdate='true' h='81625' id='6' type-v2='text' w='98400' x='800' y='12000'>
              <formatted-text>
                <run bold='true' fontcolor='#000000'>with effect from 1 November 2023,</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#ff2b85' fontsize='12'>Total Points Awarded </run>
                <run bold='true' fontcolor='#555555' fontsize='12'>=</run>
                <run bold='true' fontcolor='#000000' fontsize='12'>Æ </run>
                <run fontcolor='#000000' fontsize='12'>No. of deliveries made by enrolled riders</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='10'>                                                                (exception of PH with 1 delivery = 2 points &amp; TH using</run>
                <run fontcolor='#555555' fontsize='10'> local calculations est *3.5)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ff2b85' fontsize='12'>Total Points Utilised </run>
                <run bold='true' fontcolor='#555555' fontsize='12'>= </run>
                <run fontcolor='#555555' fontsize='12'>Using shopify discounted amount via voucher converted from value amount into points.</run>
                <run bold='true' fontcolor='#555555' fontsize='12'>Æ </run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='10'>Refer to Column D for Conversion Rates &gt;</run>
                <run fontcolor='#555555' fontsize='10'>Æ </run>
                <run auto-url='true' fontcolor='#4996b2' fontsize='10' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/spreadsheets/d/1djWyw3kmd1k-kwoAKNdteipTUckNzCXRyzfpkIP42UI/edit#gid=1252634332&amp;quot;'>https://docs.google.com/spreadsheets/d/1djWyw3kmd1k-kwoAKNdteipTUckNzCXRyzfpkIP42UI/edit#gid=1252634332</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ff2b85' fontsize='12'>Redemptions mRDR</run>
                <run bold='true' fontcolor='#333333' fontsize='12'>Æ </run>
                <run bold='true' fontcolor='#555555' fontsize='12'>= </run>
                <run fontcolor='#555555' fontsize='12'>Total Points Utilised / Total Points Awarded</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ff2b85' fontsize='12'>Penetration mRPR </run>
                <run bold='true' fontcolor='#555555' fontsize='12'>= </run>
                <run fontcolor='#555555' fontsize='12'>No. of riders who redeemed / Total active riders in that month</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#ff2b85' fontsize='12'>Provision Points</run>
                <run bold='true' fontcolor='#d37295' fontsize='12'>Æ </run>
                <run bold='true' fontcolor='#000000' fontsize='12'>= </run>
                <run fontcolor='#555555' fontsize='12'>unused points from previous month (can be used in the future)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#555555' fontsize='12'>Æ                                </run>
                <run fontcolor='#555555' fontsize='12'>(ie. points awarded in feb (for jan) vs points utilised in feb = provision points to be </run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='12'>                                        added to March)</run>
                <run>Æ&#10;</run>
                <run bold='true'>* following APAC&apos;s expiry cycle, provision will hence be done every month. if expiry is in Dec, all unused points in Dec accumulated in H2 cycle will be reset, provision will then be reversed fully back to 0</run>
                <run>&#10;&#10;-----&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='12'>Launch Timelines</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#333333'>Rewards in-app points Launch Timelines:</run>
                <run>Æ&#10;</run>
                <run bold='true'>Phase 1 </run>
                <run>(</run>
                <run bold='true' fontcolor='#d37295'>SG</run>
                <run>): </run>
                <run bold='true'>22 May 2023</run>
                <run>Æ&#10;</run>
                <run bold='true'>Phase 2</run>
                <run> (</run>
                <run bold='true' fontcolor='#d37295'>HK, MY, PH</run>
                <run>): </run>
                <run bold='true'>14 Aug 2023</run>
                <run>Æ&#10;</run>
                <run bold='true'>Phase 3</run>
                <run> (</run>
                <run bold='true' fontcolor='#d37295'>BD, CLM, PK</run>
                <run>)*: </run>
                <run bold='true'>11 Sep 2023</run>
                <run>
*PK is only for Lahore, Karachi, Islamabad; LA is only for Vientiane Capital
# TH &amp; TW waiting for manager portal in H1 2024

</run>
                <run bold='true' fontcolor='#333333'>Loyalty 2.0 Launch Timelines:</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#d37295'>LA, MY, SG, BD</run>
                <run bold='true'>: May 2022</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#d37295'>PH</run>
                <run bold='true'>: Jun 2022</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#d37295'>TH</run>
                <run bold='true'>: Jul 2022</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#d37295'>MM, PK</run>
                <run bold='true'>: Aug 2022</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#d37295'>KH</run>
                <run bold='true'>: Oct 2022</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#d37295'>HK</run>
                <run bold='true'>: -</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#d37295'>TW</run>
                <run bold='true'>: local, on pointshop since Q4 2021 (excluded from this tableau)</run>
                <run>Æ&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone forceUpdate='true' h='11000' id='7' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='36'>APAC Rider Loyalty</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
