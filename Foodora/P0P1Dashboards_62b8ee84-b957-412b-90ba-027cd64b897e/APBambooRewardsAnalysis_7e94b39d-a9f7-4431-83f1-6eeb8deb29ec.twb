    <worksheet name='new Total APAC Reporting'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Pre-inapp Total APAC Reporting Consolidation</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='city-level' name='federated.1pak0uq1mai2dl0zvvzir1m38b0q' />
          </datasources>
          <datasource-dependencies datasource='federated.1pak0uq1mai2dl0zvvzir1m38b0q'>
            <column caption='is_BR_city' datatype='boolean' name='[Calculation_1380564400506703880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lg_country_code] = &apos;pk&apos; THEN [city_name (group)] = &apos;PK_BR_city&apos; &#10;ELSEIF [lg_country_code] = &apos;la&apos; THEN [city_name (group)] = &apos;LA_BR_city&apos;&#10;END' />
            </column>
            <column caption='mRDR' datatype='real' default-format='p0.0%' name='[Calculation_4702391337845989381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hy city redeemed riders (copy)_4702391337863745549])/SUM([hy city total points_awarded (copy)_1380564400469884930])' />
            </column>
            <column caption='mRPR' datatype='real' default-format='p0.0%' name='[Calculation_4702391337846468614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hy city active riders (copy)_4702391337859280906]) / SUM([Calculation_4702391337852993544])' />
            </column>
            <column caption='hy city active riders' datatype='real' name='[Calculation_4702391337852993544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [lg_country_code], [city_name], [report_month] : AVG([active_riders]) }' />
            </column>
            <column datatype='integer' name='[active_riders]' role='measure' type='ordinal' />
            <column datatype='string' name='[city_name (group)]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <calculation class='categorical-bin' column='[city_name]' default='&quot;Other&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;LA_BR_city&quot;'>
                  <value>&quot;Vientiane capital&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;PK_BR_city&quot;'>
                  <value>&quot;Islamabad&quot;</value>
                  <value>&quot;Karachi&quot;</value>
                  <value>&quot;Lahore&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='integer' name='[delivery_count]' role='measure' type='quantitative' />
            <column caption='hy city redeemed riders' datatype='real' default-format='N' name='[hy city active riders (copy)_4702391337859280906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [lg_country_code], [city_name], [report_month] : AVG([redeemed_riders]) }' />
            </column>
            <column caption='hy city total points_utilised' datatype='real' name='[hy city redeemed riders (copy)_4702391337863745549]' role='measure' type='quantitative'>
