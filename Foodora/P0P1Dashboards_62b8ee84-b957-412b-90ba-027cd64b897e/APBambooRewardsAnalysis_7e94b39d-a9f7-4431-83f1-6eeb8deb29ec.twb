            <map to='#fc0072'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[sum:hy final active riders (copy)_4702391337863602188:qk]&quot;</bucket>
            </map>
            <map to='#fc0072'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[sum:hy final total_points_utilised (copy)_4702391337866080271:qk]&quot;</bucket>
            </map>
            <map to='#fc0072'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[usr:Calculation_4702391337846468614:qk]&quot;</bucket>
            </map>
            <map to='#ff9d9a'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[sum:casual_riders:qk]&quot;</bucket>
            </map>
            <map to='#ffbe7d'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[sum:active_riders:qk]&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[usr:Calculation_1380564400488640518:nk]' type='palette'>
            <map to='#6cba5d'>
              <bucket>&quot;Great&quot;</bucket>
