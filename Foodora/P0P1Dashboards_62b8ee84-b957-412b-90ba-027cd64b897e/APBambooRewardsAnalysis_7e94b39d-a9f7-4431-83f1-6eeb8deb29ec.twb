              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[sum:total_points_utilised:qk]&quot;</bucket>
            </map>
            <map to='#f1ce63'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[avg:prev_points_awarded:qk]&quot;</bucket>
            </map>
            <map to='#f1ce63'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[sum:prev_points_awarded:qk]&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[avg:redeemed_riders:qk]&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[sum:total_points_awarded:qk]&quot;</bucket>
            </map>
            <map to='#f3a5c8'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[attr:active_riders:qk]&quot;</bucket>
            </map>
            <map to='#f3a5c8'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[attr:Calculation_4702391337853943817:qk]&quot;</bucket>
            </map>
            <map to='#f3a5c8'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[none:active_riders:ok]&quot;</bucket>
            </map>
            <map to='#f3a5c8'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[sum:Calculation_4702391337853943817:qk]&quot;</bucket>
            </map>
            <map to='#f4a5c8'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[sum:Calculation_4702391337852993544:qk]&quot;</bucket>
            </map>
            <map to='#f60072'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[sum:hy city redeemed riders (copy)_4702391337863745549:qk]&quot;</bucket>
            </map>
            <map to='#f60072'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[sum:hy city total points_utilised (copy)_4702391337866010638:qk]&quot;</bucket>
            </map>
            <map to='#fabfd2'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[sum:non_redeemed_before_AWH:qk]&quot;</bucket>
            </map>
            <map to='#fc0072'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[attr:total_points_awarded:qk]&quot;</bucket>
            </map>
            <map to='#fc0072'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[attr:total_points_utilised:qk]&quot;</bucket>
            </map>
            <map to='#fc0072'>
              <bucket>&quot;[federated.1pak0uq1mai2dl0zvvzir1m38b0q].[none:total_points_utilised:qk]&quot;</bucket>
