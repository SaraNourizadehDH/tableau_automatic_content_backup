          <calculation class='tableau' formula='IF [lg_country_code] = &apos;pk&apos; THEN [city_name (group)] = &apos;PK_BR_city&apos; &#10;ELSEIF [lg_country_code] = &apos;la&apos; THEN [city_name (group)] = &apos;LA_BR_city&apos;&#10;END' />
