        <objects>
          <object caption='metric_definitions' id='metric!definitions_9A9F3B54E61242FCAB231B6ECE6B2E30'>
            <properties context=''>
              <relation connection='cloudfile:googledrive-excel-direct.03ibho2057neb116v36g40lrm7uc' name='metric_definitions' table='[metric_definitions$]' type='table'>
                <columns gridOrigin='A1:C151:no:A1:C151:0' header='yes' outcome='2'>
                  <column datatype='string' name='dashboard_name' ordinal='0' />
                  <column datatype='string' name='metric name' ordinal='1' />
                  <column datatype='string' name='metric definition' ordinal='2' />
                </columns>
              </relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='city-level' inline='true' name='federated.1pak0uq1mai2dl0zvvzir1m38b0q' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.17mn5zr1v00hkm157fehf1dg6o0c'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='server-custom' username='vanessa.goh@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='Bamboo Rewards Analysis Metric' name='cloudfile:googledrive-excel-direct.0gxw58k11n07350zp8b631ri2jkk'>
            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='1EI8E18TpfK1iik7sn94vfYW-QXhn78ymc7JmNVf41RY' cloudFileMetadata_-_folder='root' cloudFileName='Bamboo Rewards Analysis Metric.xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/1EI8E18TpfK1iik7sn94vfYW-QXhn78ymc7JmNVf41RY/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='Bamboo Rewards Analysis Metric.xlsx' interpretationMode='0' server='' server-oauth='server-custom' username='vanessa.goh@foodpanda.com' validate='no' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.17mn5zr1v00hkm157fehf1dg6o0c' name='Custom SQL Query' type='text'><![CDATA[WITH riders as (
    SELECT
    riders.country_code as lg_country_code,
    riders.rider_id AS lg_rider_id,
    -- contracts.city_id as lg_city_id,
    -- to match rider's email in shopify table
    CASE
        WHEN riders.email LIKE "%delivery.ph" THEN REPLACE(riders.email, "@delivery.ph", "@deliveryhero.com")
        WHEN riders.email LIKE "0%deliveryhero.com" THEN REPLACE(riders.email, "0", "63")
        WHEN riders.email LIKE "%delivery.com" THEN REPLACE(riders.email, "@delivery.com", "@deliveryhero.com")
        WHEN riders.email LIKE "%delivery.th" THEN REPLACE(riders.email, "@delivery.th", "@deliveryhero.com")
        WHEN riders.email LIKE "%foodpanda-hub-retail.myshopify.com" THEN REPLACE(riders.email, "@foodpanda-hub-retail.myshopify.com", "@deliveryhero.com") 
        WHEN riders.email LIKE "+%" THEN REPLACE (riders.email, "+", "")
        ELSE riders.email
    END AS email,
    FROM `fulfillment-dwh-production.curated_data_shared.riders` AS riders
    LEFT JOIN UNNEST(contracts) AS contracts
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON riders.country_code = LOWER(shared_countries.country_code_iso)
  WHERE LOWER(riders.rider_name) NOT LIKE "%test%"
    AND riders.email NOT LIKE "%@whizz.sg%"
    AND shared_countries.region = "Asia"
    AND shared_countries.company_name = "Foodpanda"
  QUALIFY ROW_NUMBER() OVER (PARTITION BY riders.rider_id, riders.country_code ORDER BY contracts.start_at DESC) = 1
),

-- calculate points awarded to each rider using deliveries made
metrics_manipulated AS (
  SELECT
    lg_country_code,
    country_name,
    LAST_VALUE(city_name) OVER (PARTITION BY lg_country_code, lg_rider_id, DATE_TRUNC(date_local, MONTH) ORDER BY date_local) AS city_name,
    CASE
      WHEN completed_deliveries_count >> 0 THEN 1
      ELSE 0
    END AS is_rider_delivery_done,
    lg_rider_id,
    DATE_TRUNC(date_local, MONTH) AS report_month,
    completed_deliveries_count,
    rider_notified_count,
    rider_accepted_count,
    undispatched_after_accepted_count,
    transition_working_time_in_min,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_rider_daily_metrics`
  WHERE date_local BETWEEN "2022-12-01" AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
),

metrics AS (
  SELECT
    lg_country_code,
    country_name,
    city_name,
    lg_rider_id,
    report_month,
    SUM(is_rider_delivery_done) AS worked_day_count,
    SUM(completed_deliveries_count) AS completed_deliveries_count,
    SUM(rider_notified_count) AS rider_notified_count,
    SUM(rider_accepted_count) AS rider_accepted_count,
    SUM(undispatched_after_accepted_count) AS undispatched_after_accepted_count,
    SUM(transition_working_time_in_min) / 60 AS transition_working_time_in_hours
    FROM metrics_manipulated
  GROUP BY 1, 2, 3, 4, 5
),

riders_mapped_metrics AS (
  SELECT
    metrics.lg_country_code,
    metrics.country_name,
    metrics.city_name,
    metrics.report_month,
    metrics.lg_rider_id,
    riders.email,
    worked_day_count,
    IFNULL(metrics.completed_deliveries_count, 0) AS delivery_count, -- used for points computation
    IFNULL(metrics.rider_notified_count, 0) AS rider_notified_count,
    IFNULL(metrics.rider_accepted_count, 0) AS rider_accepted_count,
    IFNULL(metrics.undispatched_after_accepted_count, 0) AS undispatched_after_accepted_count,
    ROUND(
      IF(
        SAFE_DIVIDE(metrics.rider_accepted_count - metrics.undispatched_after_accepted_count, metrics.rider_notified_count) >> 1,
        1,
        SAFE_DIVIDE(metrics.rider_accepted_count - metrics.undispatched_after_accepted_count, metrics.rider_notified_count)), 2
    ) AS acceptance_rate,
    IFNULL(metrics.transition_working_time_in_hours, 0) AS transition_working_time_in_hours
  FROM metrics
  LEFT JOIN riders
         ON metrics.lg_country_code = riders.lg_country_code
        AND metrics.lg_rider_id = riders.lg_rider_id
  -- WHERE city_name IS NOT NULL -- to check if this is needed - not needed! city_name won't be null as we left join from metrics which does not have null city data whereas null city is coming from riders table (2,340 riders)
),

applicants AS (
  SELECT
    lg_country_code,
    referrer_lg_rider_id,
    lg_rider_id,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_marketing_channel_mapped_to_applicants`
  WHERE mapped_marketing_channel = "RAF"
    AND application_date_local BETWEEN "2022-12-01" AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
  GROUP BY 1, 2, 3
),

raf_payments AS (
  SELECT
    lg_rider_referral_payments.country_code as lg_country_code,
    lg_rider_referral_payments.city_name,
    payment_details.referrer_id as referrer_lg_rider_id,
    payment_details.referee_id as referee_lg_rider_id,
    payment_details.status,
    lg_rider_referral_payments.created_date AS start_date
  FROM `fulfillment-dwh-production.curated_data_shared.rider_referral_payments` AS lg_rider_referral_payments
  LEFT JOIN UNNEST(payment_details) AS payment_details
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.payments_referral_rules` AS lg_payments_referral_rules
         ON lg_rider_referral_payments.country_code = lg_payments_referral_rules.country_code
        AND payment_details.payment_rule_id = lg_payments_referral_rules.id
  WHERE lg_rider_referral_payments.created_date <<= CURRENT_DATE()
    AND payment_details.status IN ("PENDING", "PAID")
    AND lg_payments_referral_rules.applies_to IN ("REFERRER", "REFEREE", "ALL")
    AND lg_rider_referral_payments.country_code = "my"
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY lg_rider_referral_payments.country_code, payment_details.referee_id, lg_payments_referral_rules.id
    ORDER BY payment_details.payment_id DESC
  ) = 1
),

referrals AS (
  SELECT
    DATE_TRUNC(raf_payments.start_date, MONTH) AS report_month,
    applicants.lg_country_code,
    raf_payments.city_name,
    applicants.referrer_lg_rider_id,
    applicants.lg_rider_id,
    raf_payments.status
  FROM applicants
  LEFT JOIN raf_payments
         ON applicants.lg_country_code = raf_payments.lg_country_code
        AND applicants.lg_rider_id = raf_payments.referee_lg_rider_id
  -- WHERE start_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
  WHERE start_date BETWEEN "2022-12-01" AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
  GROUP BY 1, 2, 3, 4, 5, 6
),

my_raf_intermediate AS (
  SELECT
    report_month, 
    lg_country_code,
    referrer_lg_rider_id AS lg_rider_id,
    CASE
      WHEN ROW_NUMBER() OVER (PARTITION BY referrer_lg_rider_id, report_month) IN (1, 2, 3, 4, 5) THEN 100 
      ELSE 0
    END AS raf_points
  FROM referrals
  GROUP BY 1, 2, 3
),

my_raf AS (
  SELECT
    report_month,
    lg_country_code,
    lg_rider_id,
    IFNULL(SUM(raf_points), 0) AS raf_points
  FROM my_raf_intermediate
  GROUP BY 1, 2, 3
),

compiled_points AS (
  SELECT 
    riders_mapped_metrics.report_month,
    riders_mapped_metrics.lg_country_code,
    riders_mapped_metrics.city_name,
    riders_mapped_metrics.lg_rider_id,
    riders_mapped_metrics.email,
    riders_mapped_metrics.worked_day_count,
    riders_mapped_metrics.delivery_count,
    riders_mapped_metrics.transition_working_time_in_hours,
    my_raf.raf_points,
    CASE
      WHEN riders_mapped_metrics.lg_country_code = "my" AND riders_mapped_metrics.report_month >>= "2021-10-01" AND IFNULL(riders_mapped_metrics.delivery_count,0) + IFNULL(my_raf.raf_points,0) >>= 300 THEN IFNULL(riders_mapped_metrics.delivery_count,0) + IFNULL(my_raf.raf_points,0) -- MY: award points as hit min 300 pts/mth
      WHEN riders_mapped_metrics.lg_country_code = "my" AND riders_mapped_metrics.report_month >>= "2021-10-01" AND IFNULL(riders_mapped_metrics.delivery_count,0) + IFNULL(my_raf.raf_points,0) << 300 THEN 0 -- MY: don't award points as never hit min 300 pts/mth
      WHEN riders_mapped_metrics.lg_country_code = "sg" AND riders_mapped_metrics.report_month >>= "2020-01-01" AND riders_mapped_metrics.acceptance_rate >>= 0.5 THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      WHEN riders_mapped_metrics.lg_country_code = "pk" AND riders_mapped_metrics.acceptance_rate >>= 0.5 AND riders_mapped_metrics.report_month >>= "2022-07-01" AND riders_mapped_metrics.report_month << "2022-12-01" AND LOWER(riders_mapped_metrics.city_name) IN ("lahore") THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      WHEN riders_mapped_metrics.lg_country_code = "pk" AND riders_mapped_metrics.acceptance_rate >>= 0.5 AND riders_mapped_metrics.report_month >>= "2022-12-01" AND LOWER(riders_mapped_metrics.city_name) IN ("islamabad", "karachi") THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      WHEN riders_mapped_metrics.lg_country_code = "la" AND riders_mapped_metrics.report_month >>= "2021-12-01" AND LOWER(riders_mapped_metrics.city_name) IN ("vientiane capital") THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      WHEN riders_mapped_metrics.lg_country_code = "ph" AND riders_mapped_metrics.report_month >>= "2022-06-01" THEN IFNULL(riders_mapped_metrics.delivery_count * 2, 0)
      WHEN riders_mapped_metrics.lg_country_code = "th" AND riders_mapped_metrics.report_month >>= "2022-07-01" THEN IFNULL(riders_mapped_metrics.delivery_count * 3.5, 0)
      WHEN riders_mapped_metrics.lg_country_code = "bd" AND riders_mapped_metrics.report_month >>= "2022-02-01" THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      WHEN riders_mapped_metrics.lg_country_code = "mm" AND riders_mapped_metrics.report_month >>= "2022-02-01" THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      WHEN riders_mapped_metrics.lg_country_code = "kh" AND riders_mapped_metrics.report_month >>= "2022-10-01" THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      WHEN riders_mapped_metrics.lg_country_code = "tw" AND riders_mapped_metrics.report_month >>= "2022-10-01" THEN IFNULL(riders_mapped_metrics.delivery_count / 6, 0)
      WHEN riders_mapped_metrics.lg_country_code = "hk" AND riders_mapped_metrics.report_month >>= "2023-08-01" THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      ELSE IFNULL(riders_mapped_metrics.delivery_count, 0)
    END AS total_points_awarded,
  FROM riders_mapped_metrics
  LEFT JOIN my_raf
         ON riders_mapped_metrics.report_month = my_raf.report_month
        AND riders_mapped_metrics.lg_country_code = my_raf.lg_country_code
        AND riders_mapped_metrics.lg_rider_id = my_raf.lg_rider_id
),

compiled_points_manipulated AS (
  SELECT
    *,
    LAG(total_points_awarded, 1, 0) OVER (PARTITION BY lg_country_code, city_name, lg_rider_id ORDER BY report_month) AS prev_points_awarded
  FROM compiled_points
),

-- identify redeemed riders (TW does not use shopify)
discounts_manipulated_most AS (
  SELECT
    DATE_TRUNC(DATE(sales_revenue_shopify_api_orders.created_at), MONTH) AS report_month, -- created_date_utc changed to created_at
    customer.email AS email,
    regional_apac_lg_mapping_rider_shopify_order.lg_country_code,
    COUNT(DISTINCT sales_revenue_shopify_api_orders.order_number) AS redeemed_order_count,
    IFNULL(SUM(discount_codes.amount), 0) AS discount_amount_local,
    IFNULL(SUM(discount_codes.amount*regional_apac_lg_mapping_rider_shopify_order.shopify_value_local_to_bamboo_point_conversion_rate), 0)  AS total_points_utilised,
    IFNULL((SUM(discount_codes.amount / central_dwh_fx_rates.fx_rate_eur)), 0) AS discount_amount_eur
  FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.shopify_api_order` AS sales_revenue_shopify_api_orders
  LEFT JOIN UNNEST (discount_codes) AS discount_codes
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS central_dwh_fx_rates 
         ON DATE(sales_revenue_shopify_api_orders.created_at) = central_dwh_fx_rates.fx_rate_date -- created_date_utc changed to created_at
        AND sales_revenue_shopify_api_orders.currency = central_dwh_fx_rates.currency_code -- currency_code changed to currency (sales_revenue) & currency_code_iso changed to currency_code (fx_rates)
  INNER JOIN `fulfillment-dwh-production.pandata_report.regional_apac_lg_mapping_rider_shopify_order` AS regional_apac_lg_mapping_rider_shopify_order
          ON sales_revenue_shopify_api_orders.account_name = regional_apac_lg_mapping_rider_shopify_order.shopify_account_name
  WHERE sales_revenue_shopify_api_orders.cancelled_at IS NULL -- cancelled_at_utc changed to cancelled_at
    AND financial_status <<>> "refunded"
    AND DATE(sales_revenue_shopify_api_orders.created_at) BETWEEN "2022-12-01" AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY) -- created_at_utc changed to created_at
    AND customer.email IS NOT NULL 
    AND (LOWER(discount_codes.code) LIKE "br%" OR LOWER(discount_codes.code) LIKE "pp%")
    AND central_dwh_fx_rates.fx_rate_date BETWEEN "2022-12-01" AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
  GROUP BY lg_country_code, email, report_month
),

discounts_manipulated_TW AS (
  SELECT 
    DATE_TRUNC(DATE(regional_apac_shopify_rider_redemptions_tw.date_local), MONTH) AS report_month,
    regional_apac_shopify_rider_redemptions_tw.email,
    regional_apac_shopify_rider_redemptions_tw.lg_country_code,
    COUNT(DISTINCT regional_apac_shopify_rider_redemptions_tw.erawppa_order_ID) AS redeemed_order_count,
    IFNULL(SUM(regional_apac_shopify_rider_redemptions_tw.value_local_converted_from_bamboo_point), 0) AS discount_amount_local,
    IFNULL(SUM(regional_apac_shopify_rider_redemptions_tw.value_local_converted_from_bamboo_point*regional_apac_lg_mapping_rider_shopify_order.shopify_value_local_to_bamboo_point_conversion_rate),0) AS total_points_utilised,
    IFNULL(SUM(regional_apac_shopify_rider_redemptions_tw.value_local_converted_from_bamboo_point/central_dwh_fx_rates.fx_rate_eur), 0) AS discount_amount_eur
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_mapping_shopify_rider_redemptions_tw` AS regional_apac_shopify_rider_redemptions_tw
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS central_dwh_fx_rates 
         ON DATE(regional_apac_shopify_rider_redemptions_tw.date_local) = central_dwh_fx_rates.fx_rate_date
        AND regional_apac_shopify_rider_redemptions_tw.currency_code = central_dwh_fx_rates.currency_code
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.riders` AS riders
         ON riders.country_code = regional_apac_shopify_rider_redemptions_tw.lg_country_code -- changed lg_country_code to country_code (riders)
        AND riders.rider_id = CAST(regional_apac_shopify_rider_redemptions_tw.lg_rider_id AS INT) -- changed id to rider_id (riders)
  INNER JOIN `fulfillment-dwh-production.pandata_report.regional_apac_lg_mapping_rider_shopify_order` AS regional_apac_lg_mapping_rider_shopify_order
          ON regional_apac_lg_mapping_rider_shopify_order.lg_country_code = regional_apac_shopify_rider_redemptions_tw.lg_country_code
  WHERE central_dwh_fx_rates.fx_rate_date BETWEEN "2022-12-01" AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
  GROUP BY 1, 2, 3
),

discounts_manipulated_PH AS (
  SELECT 
    DATE_TRUNC(DATE(regional_apac_shopify_rider_redemptions_ph.date_local), MONTH) AS report_month,
    regional_apac_shopify_rider_redemptions_ph.email,
    regional_apac_shopify_rider_redemptions_ph.lg_country_code,
    COUNT(DISTINCT regional_apac_shopify_rider_redemptions_ph.order_number) AS redeemed_order_count,
    IFNULL(SUM(regional_apac_shopify_rider_redemptions_ph.value_local_converted_from_bamboo_point), 0) AS discount_amount_local,
    IFNULL(SUM(regional_apac_shopify_rider_redemptions_ph.value_local_converted_from_bamboo_point*regional_apac_lg_mapping_rider_shopify_order.shopify_value_local_to_bamboo_point_conversion_rate),0) AS total_points_utilised,
    IFNULL(SUM(regional_apac_shopify_rider_redemptions_ph.value_local_converted_from_bamboo_point/central_dwh_fx_rates.fx_rate_eur), 0) AS discount_amount_eur
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_mapping_shopify_rider_redemptions_ph` AS regional_apac_shopify_rider_redemptions_ph
    LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS central_dwh_fx_rates 
         ON DATE(regional_apac_shopify_rider_redemptions_ph.date_local) = central_dwh_fx_rates.fx_rate_date
         AND regional_apac_shopify_rider_redemptions_ph.currency_code = central_dwh_fx_rates.currency_code
    LEFT JOIN `fulfillment-dwh-production.curated_data_shared.riders` AS riders
          ON riders.country_code = regional_apac_shopify_rider_redemptions_ph.lg_country_code -- changed lg_country_code to country_code (riders)
          AND riders.rider_id = CAST(regional_apac_shopify_rider_redemptions_ph.lg_rider_id AS INT) -- changed id to rider_id (riders)
    INNER JOIN `fulfillment-dwh-production.pandata_report.regional_apac_lg_mapping_rider_shopify_order` AS regional_apac_lg_mapping_rider_shopify_order
        ON regional_apac_lg_mapping_rider_shopify_order.lg_country_code = regional_apac_shopify_rider_redemptions_ph.lg_country_code
    WHERE central_dwh_fx_rates.fx_rate_date BETWEEN "2022-12-01" AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
    GROUP BY 1, 2, 3
),

discounts_manipulated AS (
  SELECT * FROM discounts_manipulated_most
  UNION ALL
  SELECT * FROM discounts_manipulated_TW
  UNION ALL
  SELECT * FROM discounts_manipulated_PH
),

final AS (
  SELECT
    COALESCE(compiled_points_manipulated.report_month, discounts_manipulated.report_month) AS report_month,
    COALESCE(compiled_points_manipulated.lg_country_code, discounts_manipulated.lg_country_code) AS lg_country_code,
    compiled_points_manipulated.city_name,
    compiled_points_manipulated.lg_rider_id,
    CASE
      WHEN compiled_points_manipulated.lg_rider_id IN (
        SELECT  
          distinct rider_id
        FROM `fulfillment-dwh-production.curated_data_shared.rider_loyalty_onboarded_rider` onboarded_rider
        WHERE rider_id IS NOT NULL
          AND onboarded_rider.country_code = compiled_points_manipulated.lg_country_code) THEN TRUE
      ELSE FALSE
    END AS has_opted_in,
    CASE
      WHEN compiled_points_manipulated.worked_day_count >> 0 THEN TRUE
      ELSE FALSE
    END AS is_active,
    CASE
      WHEN discounts_manipulated.redeemed_order_count >> 0 THEN TRUE
      ELSE FALSE
    END AS is_redeemed,
    CASE
      WHEN FIRST_VALUE(discounts_manipulated.redeemed_order_count IGNORE NULLS) OVER (PARTITION BY compiled_points_manipulated.lg_country_code, compiled_points_manipulated.lg_rider_id ORDER BY compiled_points_manipulated.report_month) >> 0 THEN TRUE
      ELSE FALSE
    END AS has_redeemed_before,
    CASE
      WHEN compiled_points_manipulated.lg_rider_id IS NOT NULL AND discounts_manipulated.total_points_utilised >> 0 THEN TRUE
      ELSE FALSE
    END AS is_matched_redeemed,
    CASE
      WHEN compiled_points_manipulated.transition_working_time_in_hours >> 160 THEN "Full-Time"
      WHEN (compiled_points_manipulated.transition_working_time_in_hours >> 32 AND compiled_points_manipulated.transition_working_time_in_hours <<= 160) THEN "Part-Time"
      WHEN compiled_points_manipulated.transition_working_time_in_hours <<= 32 THEN "Casual"
      ELSE "Others"
    END AS employment_status,
    compiled_points_manipulated.worked_day_count,
    compiled_points_manipulated.delivery_count,
    compiled_points_manipulated.transition_working_time_in_hours,
    compiled_points_manipulated.total_points_awarded, -- monthly points
    compiled_points_manipulated.prev_points_awarded,
    discounts_manipulated.redeemed_order_count,
    discounts_manipulated.discount_amount_local,
    discounts_manipulated.discount_amount_eur,
    discounts_manipulated.total_points_utilised
  FROM compiled_points_manipulated
  FULL OUTER JOIN discounts_manipulated
              ON compiled_points_manipulated.lg_country_code = discounts_manipulated.lg_country_code
              AND compiled_points_manipulated.report_month = discounts_manipulated.report_month
              AND compiled_points_manipulated.email = discounts_manipulated.email
),

final_metrics_aggregated AS (
  SELECT
    lg_country_code,
    city_name,
    report_month,
    SUM(IF(is_active = TRUE,1,0)) as active_riders,
    SUM(IF(is_redeemed = TRUE,1,0)) as redeemed_riders,
    IFNULL(SAFE_DIVIDE(SUM(IF(is_redeemed = TRUE,1,0)), SUM(IF(is_active = TRUE,1,0))), 0) as penetration_rate,
    SUM(IF(is_active = TRUE,1,0)) - SUM(IF(is_redeemed = TRUE,1,0)) as non_redeemed_riders,
    SUM(total_points_awarded) as total_points_awarded,
    SUM(total_points_utilised) as total_points_utilised,
    SUM(prev_points_awarded) as prev_points_awarded,
    IFNULL(SAFE_DIVIDE(SUM(total_points_utilised), SUM(prev_points_awarded)), 0) as redemption_rate,
    SUM(IF(is_matched_redeemed = TRUE,1,0)) as matched_redeemed_riders,
    SUM(IF(employment_status = "Casual", 1,0)) as casual_riders,
    SUM(IF(employment_status = "Part-Time", 1,0)) as PT_riders,
    SUM(IF(employment_status = "Full-Time", 1,0)) as FT_riders,
    SUM(delivery_count) as delivery_count
  FROM final
  WHERE report_month >>= "2022-12-01"
    AND is_active = TRUE
  GROUP BY lg_country_code, city_name, report_month
),

incremental_AWH AS (
  SELECT 
    lg_country_code,
    city_name,
    report_month,
    employment_status,
    IFNULL(SAFE_DIVIDE(SUM(IF(has_redeemed_before = TRUE, transition_working_time_in_hours, 0)), SUM(IF(has_redeemed_before = TRUE,1,0))), 0) as redeemed_before_AWH,
    IFNULL(SAFE_DIVIDE(SUM(IF(has_redeemed_before = FALSE, transition_working_time_in_hours, 0)), SUM(IF(has_redeemed_before = FALSE,1,0))), 0) as non_redeemed_before_AWH
  FROM final
  WHERE report_month >>= "2022-12-01"
    AND is_active = TRUE
  GROUP by lg_country_code, city_name, report_month, employment_status
),

final_final AS (
  SELECT
    final_metrics_aggregated.*,
    incremental_AWH.employment_status,
    incremental_AWH.redeemed_before_AWH,
    incremental_AWH.non_redeemed_before_AWH
  FROM final_metrics_aggregated 
  LEFT JOIN incremental_AWH
         ON incremental_AWH.lg_country_code = final_metrics_aggregated.lg_country_code
        AND incremental_AWH.city_name = final_metrics_aggregated.city_name
        AND incremental_AWH.report_month = final_metrics_aggregated.report_month
)

SELECT
  *
FROM final_final]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.17mn5zr1v00hkm157fehf1dg6o0c' name='Custom SQL Query' type='text'><![CDATA[WITH riders as (
    SELECT
    riders.country_code as lg_country_code,
    riders.rider_id AS lg_rider_id,
    -- contracts.city_id as lg_city_id,
    -- to match rider's email in shopify table
    CASE
        WHEN riders.email LIKE "%delivery.ph" THEN REPLACE(riders.email, "@delivery.ph", "@deliveryhero.com")
        WHEN riders.email LIKE "0%deliveryhero.com" THEN REPLACE(riders.email, "0", "63")
        WHEN riders.email LIKE "%delivery.com" THEN REPLACE(riders.email, "@delivery.com", "@deliveryhero.com")
        WHEN riders.email LIKE "%delivery.th" THEN REPLACE(riders.email, "@delivery.th", "@deliveryhero.com")
        WHEN riders.email LIKE "%foodpanda-hub-retail.myshopify.com" THEN REPLACE(riders.email, "@foodpanda-hub-retail.myshopify.com", "@deliveryhero.com") 
        WHEN riders.email LIKE "+%" THEN REPLACE (riders.email, "+", "")
        ELSE riders.email
    END AS email,
    FROM `fulfillment-dwh-production.curated_data_shared.riders` AS riders
    LEFT JOIN UNNEST(contracts) AS contracts
  LEFT JOIN `fulfillment-dwh-production.pandata_curated.shared_countries` AS shared_countries
         ON riders.country_code = LOWER(shared_countries.country_code_iso)
  WHERE LOWER(riders.rider_name) NOT LIKE "%test%"
    AND riders.email NOT LIKE "%@whizz.sg%"
    AND shared_countries.region = "Asia"
    AND shared_countries.company_name = "Foodpanda"
  QUALIFY ROW_NUMBER() OVER (PARTITION BY riders.rider_id, riders.country_code ORDER BY contracts.start_at DESC) = 1
),

-- calculate points awarded to each rider using deliveries made
metrics_manipulated AS (
  SELECT
    lg_country_code,
    country_name,
    LAST_VALUE(city_name) OVER (PARTITION BY lg_country_code, lg_rider_id, DATE_TRUNC(date_local, MONTH) ORDER BY date_local) AS city_name,
    CASE
      WHEN completed_deliveries_count >> 0 THEN 1
      ELSE 0
    END AS is_rider_delivery_done,
    lg_rider_id,
    DATE_TRUNC(date_local, MONTH) AS report_month,
    completed_deliveries_count,
    rider_notified_count,
    rider_accepted_count,
    undispatched_after_accepted_count,
    transition_working_time_in_min,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_rider_daily_metrics`
  WHERE date_local BETWEEN "2022-12-01" AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
),

metrics AS (
  SELECT
    lg_country_code,
    country_name,
    city_name,
    lg_rider_id,
    report_month,
    SUM(is_rider_delivery_done) AS worked_day_count,
    SUM(completed_deliveries_count) AS completed_deliveries_count,
    SUM(rider_notified_count) AS rider_notified_count,
    SUM(rider_accepted_count) AS rider_accepted_count,
    SUM(undispatched_after_accepted_count) AS undispatched_after_accepted_count,
    SUM(transition_working_time_in_min) / 60 AS transition_working_time_in_hours
    FROM metrics_manipulated
  GROUP BY 1, 2, 3, 4, 5
),

riders_mapped_metrics AS (
  SELECT
    metrics.lg_country_code,
    metrics.country_name,
    metrics.city_name,
    metrics.report_month,
    metrics.lg_rider_id,
    riders.email,
    worked_day_count,
    IFNULL(metrics.completed_deliveries_count, 0) AS delivery_count, -- used for points computation
    IFNULL(metrics.rider_notified_count, 0) AS rider_notified_count,
    IFNULL(metrics.rider_accepted_count, 0) AS rider_accepted_count,
    IFNULL(metrics.undispatched_after_accepted_count, 0) AS undispatched_after_accepted_count,
    ROUND(
      IF(
        SAFE_DIVIDE(metrics.rider_accepted_count - metrics.undispatched_after_accepted_count, metrics.rider_notified_count) >> 1,
        1,
        SAFE_DIVIDE(metrics.rider_accepted_count - metrics.undispatched_after_accepted_count, metrics.rider_notified_count)), 2
    ) AS acceptance_rate,
    IFNULL(metrics.transition_working_time_in_hours, 0) AS transition_working_time_in_hours
  FROM metrics
  LEFT JOIN riders
         ON metrics.lg_country_code = riders.lg_country_code
        AND metrics.lg_rider_id = riders.lg_rider_id
  -- WHERE city_name IS NOT NULL -- to check if this is needed - not needed! city_name won't be null as we left join from metrics which does not have null city data whereas null city is coming from riders table (2,340 riders)
),

applicants AS (
  SELECT
    lg_country_code,
    referrer_lg_rider_id,
    lg_rider_id,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_marketing_channel_mapped_to_applicants`
  WHERE mapped_marketing_channel = "RAF"
    AND application_date_local BETWEEN "2022-12-01" AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
  GROUP BY 1, 2, 3
),

raf_payments AS (
  SELECT
    lg_rider_referral_payments.country_code as lg_country_code,
    lg_rider_referral_payments.city_name,
    payment_details.referrer_id as referrer_lg_rider_id,
    payment_details.referee_id as referee_lg_rider_id,
    payment_details.status,
    lg_rider_referral_payments.created_date AS start_date
  FROM `fulfillment-dwh-production.curated_data_shared.rider_referral_payments` AS lg_rider_referral_payments
  LEFT JOIN UNNEST(payment_details) AS payment_details
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.payments_referral_rules` AS lg_payments_referral_rules
         ON lg_rider_referral_payments.country_code = lg_payments_referral_rules.country_code
        AND payment_details.payment_rule_id = lg_payments_referral_rules.id
  WHERE lg_rider_referral_payments.created_date <<= CURRENT_DATE()
    AND payment_details.status IN ("PENDING", "PAID")
    AND lg_payments_referral_rules.applies_to IN ("REFERRER", "REFEREE", "ALL")
    AND lg_rider_referral_payments.country_code = "my"
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY lg_rider_referral_payments.country_code, payment_details.referee_id, lg_payments_referral_rules.id
    ORDER BY payment_details.payment_id DESC
  ) = 1
),

referrals AS (
  SELECT
    DATE_TRUNC(raf_payments.start_date, MONTH) AS report_month,
    applicants.lg_country_code,
    raf_payments.city_name,
    applicants.referrer_lg_rider_id,
    applicants.lg_rider_id,
    raf_payments.status
  FROM applicants
  LEFT JOIN raf_payments
         ON applicants.lg_country_code = raf_payments.lg_country_code
        AND applicants.lg_rider_id = raf_payments.referee_lg_rider_id
  -- WHERE start_date BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 12 MONTH) AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
  WHERE start_date BETWEEN "2022-12-01" AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
  GROUP BY 1, 2, 3, 4, 5, 6
),

my_raf_intermediate AS (
  SELECT
    report_month, 
    lg_country_code,
    referrer_lg_rider_id AS lg_rider_id,
    CASE
      WHEN ROW_NUMBER() OVER (PARTITION BY referrer_lg_rider_id, report_month) IN (1, 2, 3, 4, 5) THEN 100 
      ELSE 0
    END AS raf_points
  FROM referrals
  GROUP BY 1, 2, 3
),

my_raf AS (
  SELECT
    report_month,
    lg_country_code,
    lg_rider_id,
    IFNULL(SUM(raf_points), 0) AS raf_points
  FROM my_raf_intermediate
  GROUP BY 1, 2, 3
),

compiled_points AS (
  SELECT 
    riders_mapped_metrics.report_month,
    riders_mapped_metrics.lg_country_code,
    riders_mapped_metrics.city_name,
    riders_mapped_metrics.lg_rider_id,
    riders_mapped_metrics.email,
    riders_mapped_metrics.worked_day_count,
    riders_mapped_metrics.delivery_count,
    riders_mapped_metrics.transition_working_time_in_hours,
    my_raf.raf_points,
    CASE
      WHEN riders_mapped_metrics.lg_country_code = "my" AND riders_mapped_metrics.report_month >>= "2021-10-01" AND IFNULL(riders_mapped_metrics.delivery_count,0) + IFNULL(my_raf.raf_points,0) >>= 300 THEN IFNULL(riders_mapped_metrics.delivery_count,0) + IFNULL(my_raf.raf_points,0) -- MY: award points as hit min 300 pts/mth
      WHEN riders_mapped_metrics.lg_country_code = "my" AND riders_mapped_metrics.report_month >>= "2021-10-01" AND IFNULL(riders_mapped_metrics.delivery_count,0) + IFNULL(my_raf.raf_points,0) << 300 THEN 0 -- MY: don't award points as never hit min 300 pts/mth
      WHEN riders_mapped_metrics.lg_country_code = "sg" AND riders_mapped_metrics.report_month >>= "2020-01-01" AND riders_mapped_metrics.acceptance_rate >>= 0.5 THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      WHEN riders_mapped_metrics.lg_country_code = "pk" AND riders_mapped_metrics.acceptance_rate >>= 0.5 AND riders_mapped_metrics.report_month >>= "2022-07-01" AND riders_mapped_metrics.report_month << "2022-12-01" AND LOWER(riders_mapped_metrics.city_name) IN ("lahore") THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      WHEN riders_mapped_metrics.lg_country_code = "pk" AND riders_mapped_metrics.acceptance_rate >>= 0.5 AND riders_mapped_metrics.report_month >>= "2022-12-01" AND LOWER(riders_mapped_metrics.city_name) IN ("islamabad", "karachi") THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      WHEN riders_mapped_metrics.lg_country_code = "la" AND riders_mapped_metrics.report_month >>= "2021-12-01" AND LOWER(riders_mapped_metrics.city_name) IN ("vientiane capital") THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      WHEN riders_mapped_metrics.lg_country_code = "ph" AND riders_mapped_metrics.report_month >>= "2022-06-01" THEN IFNULL(riders_mapped_metrics.delivery_count * 2, 0)
      WHEN riders_mapped_metrics.lg_country_code = "th" AND riders_mapped_metrics.report_month >>= "2022-07-01" THEN IFNULL(riders_mapped_metrics.delivery_count * 3.5, 0)
      WHEN riders_mapped_metrics.lg_country_code = "bd" AND riders_mapped_metrics.report_month >>= "2022-02-01" THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      WHEN riders_mapped_metrics.lg_country_code = "mm" AND riders_mapped_metrics.report_month >>= "2022-02-01" THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      WHEN riders_mapped_metrics.lg_country_code = "kh" AND riders_mapped_metrics.report_month >>= "2022-10-01" THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      WHEN riders_mapped_metrics.lg_country_code = "tw" AND riders_mapped_metrics.report_month >>= "2022-10-01" THEN IFNULL(riders_mapped_metrics.delivery_count / 6, 0)
      WHEN riders_mapped_metrics.lg_country_code = "hk" AND riders_mapped_metrics.report_month >>= "2023-08-01" THEN IFNULL(riders_mapped_metrics.delivery_count, 0)
      ELSE IFNULL(riders_mapped_metrics.delivery_count, 0)
    END AS total_points_awarded,
  FROM riders_mapped_metrics
  LEFT JOIN my_raf
         ON riders_mapped_metrics.report_month = my_raf.report_month
        AND riders_mapped_metrics.lg_country_code = my_raf.lg_country_code
        AND riders_mapped_metrics.lg_rider_id = my_raf.lg_rider_id
),

compiled_points_manipulated AS (
  SELECT
    *,
    LAG(total_points_awarded, 1, 0) OVER (PARTITION BY lg_country_code, city_name, lg_rider_id ORDER BY report_month) AS prev_points_awarded
  FROM compiled_points
),

-- identify redeemed riders (TW does not use shopify)
discounts_manipulated_most AS (
  SELECT
    DATE_TRUNC(DATE(sales_revenue_shopify_api_orders.created_at), MONTH) AS report_month, -- created_date_utc changed to created_at
    customer.email AS email,
    regional_apac_lg_mapping_rider_shopify_order.lg_country_code,
    COUNT(DISTINCT sales_revenue_shopify_api_orders.order_number) AS redeemed_order_count,
    IFNULL(SUM(discount_codes.amount), 0) AS discount_amount_local,
    IFNULL(SUM(discount_codes.amount*regional_apac_lg_mapping_rider_shopify_order.shopify_value_local_to_bamboo_point_conversion_rate), 0)  AS total_points_utilised,
    IFNULL((SUM(discount_codes.amount / central_dwh_fx_rates.fx_rate_eur)), 0) AS discount_amount_eur
  FROM `fulfillment-dwh-production.curated_data_shared_sales_revenue.shopify_api_order` AS sales_revenue_shopify_api_orders
  LEFT JOIN UNNEST (discount_codes) AS discount_codes
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS central_dwh_fx_rates 
         ON DATE(sales_revenue_shopify_api_orders.created_at) = central_dwh_fx_rates.fx_rate_date -- created_date_utc changed to created_at
        AND sales_revenue_shopify_api_orders.currency = central_dwh_fx_rates.currency_code -- currency_code changed to currency (sales_revenue) & currency_code_iso changed to currency_code (fx_rates)
  INNER JOIN `fulfillment-dwh-production.pandata_report.regional_apac_lg_mapping_rider_shopify_order` AS regional_apac_lg_mapping_rider_shopify_order
          ON sales_revenue_shopify_api_orders.account_name = regional_apac_lg_mapping_rider_shopify_order.shopify_account_name
  WHERE sales_revenue_shopify_api_orders.cancelled_at IS NULL -- cancelled_at_utc changed to cancelled_at
    AND financial_status <<>> "refunded"
    AND DATE(sales_revenue_shopify_api_orders.created_at) BETWEEN "2022-12-01" AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY) -- created_at_utc changed to created_at
    AND customer.email IS NOT NULL 
    AND (LOWER(discount_codes.code) LIKE "br%" OR LOWER(discount_codes.code) LIKE "pp%")
    AND central_dwh_fx_rates.fx_rate_date BETWEEN "2022-12-01" AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
  GROUP BY lg_country_code, email, report_month
),

discounts_manipulated_TW AS (
  SELECT 
    DATE_TRUNC(DATE(regional_apac_shopify_rider_redemptions_tw.date_local), MONTH) AS report_month,
    regional_apac_shopify_rider_redemptions_tw.email,
    regional_apac_shopify_rider_redemptions_tw.lg_country_code,
    COUNT(DISTINCT regional_apac_shopify_rider_redemptions_tw.erawppa_order_ID) AS redeemed_order_count,
    IFNULL(SUM(regional_apac_shopify_rider_redemptions_tw.value_local_converted_from_bamboo_point), 0) AS discount_amount_local,
    IFNULL(SUM(regional_apac_shopify_rider_redemptions_tw.value_local_converted_from_bamboo_point*regional_apac_lg_mapping_rider_shopify_order.shopify_value_local_to_bamboo_point_conversion_rate),0) AS total_points_utilised,
    IFNULL(SUM(regional_apac_shopify_rider_redemptions_tw.value_local_converted_from_bamboo_point/central_dwh_fx_rates.fx_rate_eur), 0) AS discount_amount_eur
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_mapping_shopify_rider_redemptions_tw` AS regional_apac_shopify_rider_redemptions_tw
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS central_dwh_fx_rates 
         ON DATE(regional_apac_shopify_rider_redemptions_tw.date_local) = central_dwh_fx_rates.fx_rate_date
        AND regional_apac_shopify_rider_redemptions_tw.currency_code = central_dwh_fx_rates.currency_code
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.riders` AS riders
         ON riders.country_code = regional_apac_shopify_rider_redemptions_tw.lg_country_code -- changed lg_country_code to country_code (riders)
        AND riders.rider_id = CAST(regional_apac_shopify_rider_redemptions_tw.lg_rider_id AS INT) -- changed id to rider_id (riders)
  INNER JOIN `fulfillment-dwh-production.pandata_report.regional_apac_lg_mapping_rider_shopify_order` AS regional_apac_lg_mapping_rider_shopify_order
          ON regional_apac_lg_mapping_rider_shopify_order.lg_country_code = regional_apac_shopify_rider_redemptions_tw.lg_country_code
  WHERE central_dwh_fx_rates.fx_rate_date BETWEEN "2022-12-01" AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
  GROUP BY 1, 2, 3
),

discounts_manipulated_PH AS (
  SELECT 
    DATE_TRUNC(DATE(regional_apac_shopify_rider_redemptions_ph.date_local), MONTH) AS report_month,
    regional_apac_shopify_rider_redemptions_ph.email,
    regional_apac_shopify_rider_redemptions_ph.lg_country_code,
    COUNT(DISTINCT regional_apac_shopify_rider_redemptions_ph.order_number) AS redeemed_order_count,
    IFNULL(SUM(regional_apac_shopify_rider_redemptions_ph.value_local_converted_from_bamboo_point), 0) AS discount_amount_local,
    IFNULL(SUM(regional_apac_shopify_rider_redemptions_ph.value_local_converted_from_bamboo_point*regional_apac_lg_mapping_rider_shopify_order.shopify_value_local_to_bamboo_point_conversion_rate),0) AS total_points_utilised,
    IFNULL(SUM(regional_apac_shopify_rider_redemptions_ph.value_local_converted_from_bamboo_point/central_dwh_fx_rates.fx_rate_eur), 0) AS discount_amount_eur
    FROM `fulfillment-dwh-production.pandata_report.regional_apac_lg_mapping_shopify_rider_redemptions_ph` AS regional_apac_shopify_rider_redemptions_ph
    LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` AS central_dwh_fx_rates 
         ON DATE(regional_apac_shopify_rider_redemptions_ph.date_local) = central_dwh_fx_rates.fx_rate_date
         AND regional_apac_shopify_rider_redemptions_ph.currency_code = central_dwh_fx_rates.currency_code
    LEFT JOIN `fulfillment-dwh-production.curated_data_shared.riders` AS riders
          ON riders.country_code = regional_apac_shopify_rider_redemptions_ph.lg_country_code -- changed lg_country_code to country_code (riders)
          AND riders.rider_id = CAST(regional_apac_shopify_rider_redemptions_ph.lg_rider_id AS INT) -- changed id to rider_id (riders)
    INNER JOIN `fulfillment-dwh-production.pandata_report.regional_apac_lg_mapping_rider_shopify_order` AS regional_apac_lg_mapping_rider_shopify_order
        ON regional_apac_lg_mapping_rider_shopify_order.lg_country_code = regional_apac_shopify_rider_redemptions_ph.lg_country_code
    WHERE central_dwh_fx_rates.fx_rate_date BETWEEN "2022-12-01" AND DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
    GROUP BY 1, 2, 3
),

discounts_manipulated AS (
  SELECT * FROM discounts_manipulated_most
  UNION ALL
  SELECT * FROM discounts_manipulated_TW
  UNION ALL
  SELECT * FROM discounts_manipulated_PH
),

final AS (
  SELECT
    COALESCE(compiled_points_manipulated.report_month, discounts_manipulated.report_month) AS report_month,
    COALESCE(compiled_points_manipulated.lg_country_code, discounts_manipulated.lg_country_code) AS lg_country_code,
    compiled_points_manipulated.city_name,
    compiled_points_manipulated.lg_rider_id,
    CASE
      WHEN compiled_points_manipulated.lg_rider_id IN (
        SELECT  
          distinct rider_id
        FROM `fulfillment-dwh-production.curated_data_shared.rider_loyalty_onboarded_rider` onboarded_rider
        WHERE rider_id IS NOT NULL
          AND onboarded_rider.country_code = compiled_points_manipulated.lg_country_code) THEN TRUE
      ELSE FALSE
    END AS has_opted_in,
    CASE
      WHEN compiled_points_manipulated.worked_day_count >> 0 THEN TRUE
      ELSE FALSE
    END AS is_active,
    CASE
      WHEN discounts_manipulated.redeemed_order_count >> 0 THEN TRUE
      ELSE FALSE
    END AS is_redeemed,
    CASE
      WHEN FIRST_VALUE(discounts_manipulated.redeemed_order_count IGNORE NULLS) OVER (PARTITION BY compiled_points_manipulated.lg_country_code, compiled_points_manipulated.lg_rider_id ORDER BY compiled_points_manipulated.report_month) >> 0 THEN TRUE
      ELSE FALSE
    END AS has_redeemed_before,
    CASE
      WHEN compiled_points_manipulated.lg_rider_id IS NOT NULL AND discounts_manipulated.total_points_utilised >> 0 THEN TRUE
      ELSE FALSE
    END AS is_matched_redeemed,
    CASE
      WHEN compiled_points_manipulated.transition_working_time_in_hours >> 160 THEN "Full-Time"
      WHEN (compiled_points_manipulated.transition_working_time_in_hours >> 32 AND compiled_points_manipulated.transition_working_time_in_hours <<= 160) THEN "Part-Time"
      WHEN compiled_points_manipulated.transition_working_time_in_hours <<= 32 THEN "Casual"
      ELSE "Others"
    END AS employment_status,
    compiled_points_manipulated.worked_day_count,
    compiled_points_manipulated.delivery_count,
    compiled_points_manipulated.transition_working_time_in_hours,
    compiled_points_manipulated.total_points_awarded, -- monthly points
    compiled_points_manipulated.prev_points_awarded,
    discounts_manipulated.redeemed_order_count,
    discounts_manipulated.discount_amount_local,
    discounts_manipulated.discount_amount_eur,
    discounts_manipulated.total_points_utilised
  FROM compiled_points_manipulated
  FULL OUTER JOIN discounts_manipulated
              ON compiled_points_manipulated.lg_country_code = discounts_manipulated.lg_country_code
              AND compiled_points_manipulated.report_month = discounts_manipulated.report_month
              AND compiled_points_manipulated.email = discounts_manipulated.email
),

final_metrics_aggregated AS (
  SELECT
    lg_country_code,
    city_name,
    report_month,
    SUM(IF(is_active = TRUE,1,0)) as active_riders,
    SUM(IF(is_redeemed = TRUE,1,0)) as redeemed_riders,
    IFNULL(SAFE_DIVIDE(SUM(IF(is_redeemed = TRUE,1,0)), SUM(IF(is_active = TRUE,1,0))), 0) as penetration_rate,
    SUM(IF(is_active = TRUE,1,0)) - SUM(IF(is_redeemed = TRUE,1,0)) as non_redeemed_riders,
    SUM(total_points_awarded) as total_points_awarded,
    SUM(total_points_utilised) as total_points_utilised,
    SUM(prev_points_awarded) as prev_points_awarded,
    IFNULL(SAFE_DIVIDE(SUM(total_points_utilised), SUM(prev_points_awarded)), 0) as redemption_rate,
    SUM(IF(is_matched_redeemed = TRUE,1,0)) as matched_redeemed_riders,
    SUM(IF(employment_status = "Casual", 1,0)) as casual_riders,
    SUM(IF(employment_status = "Part-Time", 1,0)) as PT_riders,
    SUM(IF(employment_status = "Full-Time", 1,0)) as FT_riders,
    SUM(delivery_count) as delivery_count
  FROM final
  WHERE report_month >>= "2022-12-01"
    AND is_active = TRUE
  GROUP BY lg_country_code, city_name, report_month
),

incremental_AWH AS (
  SELECT 
    lg_country_code,
    city_name,
    report_month,
    employment_status,
    IFNULL(SAFE_DIVIDE(SUM(IF(has_redeemed_before = TRUE, transition_working_time_in_hours, 0)), SUM(IF(has_redeemed_before = TRUE,1,0))), 0) as redeemed_before_AWH,
    IFNULL(SAFE_DIVIDE(SUM(IF(has_redeemed_before = FALSE, transition_working_time_in_hours, 0)), SUM(IF(has_redeemed_before = FALSE,1,0))), 0) as non_redeemed_before_AWH
  FROM final
  WHERE report_month >>= "2022-12-01"
    AND is_active = TRUE
  GROUP by lg_country_code, city_name, report_month, employment_status
),

final_final AS (
  SELECT
    final_metrics_aggregated.*,
    incremental_AWH.employment_status,
    incremental_AWH.redeemed_before_AWH,
    incremental_AWH.non_redeemed_before_AWH
  FROM final_metrics_aggregated 
  LEFT JOIN incremental_AWH
         ON incremental_AWH.lg_country_code = final_metrics_aggregated.lg_country_code
        AND incremental_AWH.city_name = final_metrics_aggregated.city_name
        AND incremental_AWH.report_month = final_metrics_aggregated.report_month
)

SELECT
  *
FROM final_final]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
