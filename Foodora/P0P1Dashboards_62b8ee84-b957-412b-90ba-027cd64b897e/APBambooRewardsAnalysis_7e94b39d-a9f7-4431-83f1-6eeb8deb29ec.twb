          <zone forceUpdate='true' h='19875' id='39' type-v2='text' w='82400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#000000'>[!]:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#ff2b85' fontname='Arial' fontsize='8'>● </run>
              <run fontcolor='#000000'>Manual adjustments are not accounted for - RAF, event points etc</run>
              <run>Æ&#10;</run>
              <run fontcolor='#ff2b85' fontname='Arial' fontsize='8'>● </run>
              <run fontcolor='#000000'>Total deliveries refer to deliveries of total fleet, including non-enrolled</run>
              <run>Æ&#10;</run>
              <run fontcolor='#ff2b85' fontname='Arial' fontsize='8'>● </run>
              <run fontcolor='#000000'>For TH &amp; TW, numbers are still based on pre-inapp alignment calculations estimates</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='19875' id='98' type-v2='text' w='16000' x='83200' y='1000'>
            <formatted-text>
              <run bold='true'>For this tab,</run>
              <run bold='true' fontcolor='#ff2b85'> focus only from Nov 2023 onwards</run>
              <run>, as hard cut off for points backfill for non-enrolled riders wef Nov 2023.</run>
              <run>Æ&#10;</run>
              <run>Oct 2023 and before, please refer to pre-inapp_APAC_reporting tab</run>
