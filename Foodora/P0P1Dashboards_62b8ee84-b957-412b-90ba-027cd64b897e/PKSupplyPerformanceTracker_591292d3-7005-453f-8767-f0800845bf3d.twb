                <semantic-value key='&quot;Mirpur&quot;' value='33.148000000000003' />
                <semantic-value key='&quot;Rahim yar khan&quot;' value='28.421199999999999' />
                <semantic-value key='&quot;Wah&quot;' value='33.771500000000003' />
              </semantic-values>
              <semantic-values semantic-role='[City].[Name]'>
                <semantic-value key='&quot;Attock&quot;' value='&quot;Attock City&quot;' />
