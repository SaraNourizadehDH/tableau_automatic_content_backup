      <column caption='RAF Qualifiers' datatype='integer' name='[Calculation_1221038459842990080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([referee_id])' />
      </column>
      <column caption='NHB Achievers' datatype='integer' name='[Calculation_1312236396969037824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([achievers])' />
      </column>
      <column caption='Conversion Rate %' datatype='real' default-format='p0.0%' name='[Calculation_1426515231943155712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([riders_hired])/SUM([leads_generated])' />
      </column>
      <column caption='Cost Per Lead' datatype='real' default-format='c&quot; €&quot;0.0;-&quot; €&quot;0.0' name='[Calculation_1426515231944278017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cost_eur])/SUm([leads_generated])' />
      </column>
      <column caption='Cost Per Lead (PKR)' datatype='real' default-format='c&quot;PKR&quot;#,##0.00;(&quot;PKR&quot;#,##0.00)' name='[Calculation_1426515231945744386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1426515231944278017]*220' />
      </column>
      <column caption='Total Cost of Hiring (PKR)' datatype='real' default-format='c&quot;PKR&quot;#,##0;(&quot;PKR&quot;#,##0)' name='[Calculation_1426515231945940995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(([cost_eur]*300)/3)+SUM([total])+SUM([raf_amount])' />
      </column>
      <column caption='Cost Per Hire (PKR)' datatype='real' default-format='c&quot;PKR&quot;#,##0;(&quot;PKR&quot;#,##0)' name='[Calculation_1426515231946313732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1426515231945940995])/SUM([riders_hired])' />
      </column>
      <column caption='Date Granularity' datatype='string' name='[Calculation_1426515231952412677]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN 1 THEN STR([date_local])&#13;&#10;WHEN 2 THEN STR(WEEK([date_local]))&#13;&#10;WHEN 3 THEN STR(MONTH([date_local]))&#13;&#10;END' />
      </column>
      <column caption='Hiring Count' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1457477440462024705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([rider_id])' />
      </column>
      <column caption='H2A % (30 Days)' datatype='real' default-format='p0.0%' name='[Calculation_1457477440462200834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([activated_30_days])/[Calculation_1457477440462024705]' />
      </column>
      <column caption='Activation Sum 30' datatype='integer' name='[Calculation_1457477440462901252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([activated_30_days])' />
      </column>
      <column caption='100T%' datatype='real' default-format='p0.0%' name='[Calculation_1457477440463998981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([trips_completed_greater_100_days_30])/[Calculation_1457477440462901252]' />
      </column>
      <column caption='300T %' datatype='real' name='[Calculation_1457477440464433158]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([trips_completed_greater_300_days_60])/[Calculation_1457477440462901252]' />
      </column>
      <column caption='Inactive 28 Days Count' datatype='integer' name='[Calculation_1457477440464838663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF([days_since_last_shift] &gt; 27) THEN 1 ELSE 0 END' />
      </column>
      <column caption='Inactive 14 Days Count' datatype='integer' name='[Calculation_1457477440465412104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF([days_since_last_shift] &gt; 13) THEN 1 ELSE 0 END' />
      </column>
      <column caption='14D Inactive %' datatype='real' name='[Calculation_1457477440465727497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1457477440465412104])/[Calculation_1457477440462024705]' />
      </column>
      <column caption='28D Inactive %' datatype='real' name='[Calculation_1457477440466079754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1457477440464838663])/[Calculation_1457477440462024705]' />
      </column>
      <column caption='RAF Penetration' datatype='real' name='[Calculation_1457477440487788557]' role='measure' type='quantitative'>
