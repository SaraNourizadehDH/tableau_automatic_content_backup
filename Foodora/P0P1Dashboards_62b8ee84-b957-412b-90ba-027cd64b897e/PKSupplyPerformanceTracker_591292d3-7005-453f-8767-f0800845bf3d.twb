            <column datatype='real' default-format='c&quot; €&quot;#,##0.00;(&quot; €&quot;#,##0.00)' name='[cost_eur]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date_local]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[month]' role='dimension' type='ordinal' />
