            <datasource caption='Custom SQL Query (samples)' name='federated.1rc9zbc0t07zwh117fkpz040fytd' />
          </datasources>
          <datasource-dependencies datasource='federated.1rc9zbc0t07zwh117fkpz040fytd'>
            <column caption='Conversion Rate %' datatype='real' default-format='p0.0%' name='[Calculation_1426515231943155712]' role='measure' type='quantitative'>
