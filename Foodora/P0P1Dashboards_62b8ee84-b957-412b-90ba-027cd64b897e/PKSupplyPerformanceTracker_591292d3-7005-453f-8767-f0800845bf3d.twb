    <worksheet name='Daily/Weekly Leads View'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='18'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (samples)' name='federated.1rc9zbc0t07zwh117fkpz040fytd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Month' caption='Date Parameter' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rc9zbc0t07zwh117fkpz040fytd'>
            <column caption='Conversion Rate %' datatype='real' default-format='p0.0%' name='[Calculation_1426515231943155712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([riders_hired])/SUM([leads_generated])' />
            </column>
            <column caption='Total Cost of Hiring (PKR)' datatype='real' default-format='c&quot;PKR&quot;#,##0;(&quot;PKR&quot;#,##0)' name='[Calculation_1426515231945940995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(([cost_eur]*300)/3)+SUM([total])+SUM([raf_amount])' />
            </column>
            <column caption='Cost Per Hire (PKR)' datatype='real' default-format='c&quot;PKR&quot;#,##0;(&quot;PKR&quot;#,##0)' name='[Calculation_1426515231946313732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1426515231945940995])/SUM([riders_hired])' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_1426515231952412677]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN 1 THEN STR([date_local])&#13;&#10;WHEN 2 THEN STR(WEEK([date_local]))&#13;&#10;WHEN 3 THEN STR(MONTH([date_local]))&#13;&#10;END' />
            </column>
            <column caption='Hiring Count' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1457477440462024705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([rider_id])' />
            </column>
            <column caption='Raf Flag' datatype='string' name='[Calculation_1655354344945348608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([RAF_ID]) THEN &quot;Non Raf&quot;&#13;&#10;ELSE &quot;Raf&quot;&#13;&#10;END' />
            </column>
            <column caption='RAF Cost' datatype='real' name='[Calculation_1784269932876365824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([raf_amount])' />
            </column>
            <column caption='NHB Cost' datatype='real' name='[Calculation_1784269932876668929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total])' />
            </column>
            <column caption='Referred By' datatype='integer' name='[RAF_ID]' role='measure' type='quantitative' />
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='real' default-format='c&quot; €&quot;#,##0.00;(&quot; €&quot;#,##0.00)' name='[cost_eur]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date_local]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[leads_generated]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1426515231952412677]' derivation='None' name='[none:Calculation_1426515231952412677:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1655354344945348608]' derivation='None' name='[none:Calculation_1655354344945348608:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[date_local]' derivation='None' name='[none:date_local:ok]' pivot='key' type='ordinal' />
            <column-instance column='[month]' derivation='None' name='[none:month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[week]' derivation='None' name='[none:week:ok]' pivot='key' type='ordinal' />
            <column-instance column='[year]' derivation='None' name='[none:year:ok]' pivot='key' type='ordinal' />
            <column datatype='real' name='[raf_amount]' role='measure' type='quantitative' />
            <column caption='Rooster ID' datatype='integer' name='[rider_id]' role='measure' type='quantitative' />
            <column datatype='integer' name='[riders_hired]' role='measure' type='quantitative' />
            <column-instance column='[leads_generated]' derivation='Sum' name='[sum:leads_generated:qk]' pivot='key' type='quantitative' />
