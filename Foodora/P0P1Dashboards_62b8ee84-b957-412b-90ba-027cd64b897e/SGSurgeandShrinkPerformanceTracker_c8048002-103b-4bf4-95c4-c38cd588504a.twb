      <aliases enabled='yes' />
      <column caption='Surged Orders Experienced' datatype='real' name='[Calculation_5574682329955532800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([surged_order_experience_w_fees]) / SUM([actual_orders])' />
      </column>
      <column caption='Shrink Orders Experienced' datatype='real' name='[Calculation_5574682329956216833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shrink_orders] + [close_orders]) / SUM([forecasted_orders])' />
      </column>
