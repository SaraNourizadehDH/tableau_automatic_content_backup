      <aliases enabled='yes' />
      <column caption='% Spent in Surge' datatype='real' name='[% Spent in Shrink (copy)_2363967611040739337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM(IF [event] IN (&apos;surge_1&apos;, &apos;surge_2&apos;, &apos;surge_3&apos;, &apos;surge_4&apos;) THEN [event_minutes] ELSE 0 END), 0) / (COUNTD([Calculation_2363967611028062209]) * 60)' />
      </column>
      <column caption='% Spent in Shrink' datatype='real' name='[Calculation_2363967611026984960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM(IF event IN (&apos;shrink_1&apos;, &apos;shrink_2&apos;, &apos;shrink_3&apos;, &apos;shrink_4&apos;, &apos;close&apos;) THEN [event_minutes] ELSE 0 END), 0) / (COUNTD([Calculation_2363967611028062209]) * 60)' />
      </column>
      <column caption='event key' datatype='string' name='[Calculation_2363967611028062209]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([date_local]) + &apos;-&apos; + STR([hour])' />
      </column>
      <column caption='MAX DATE' datatype='date' name='[Calculation_2363967611030102019]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed : max([date_local])}' />
      </column>
      <column caption='WTD?' datatype='boolean' name='[Calculation_2363967611031474180]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_2363967611030102019])' />
      </column>
      <column caption='Latest Week % Spent in Shrink' datatype='real' name='[Calculation_2363967611032649733]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM (IF DATETRUNC(&apos;week&apos;,[date_local]) = DATETRUNC(&apos;week&apos;,[Calculation_2363967611030102019]) AND event IN (&apos;shrink_1&apos;, &apos;shrink_2&apos;, &apos;shrink_3&apos;, &apos;shrink_4&apos;, &apos;close&apos;) THEN [event_minutes] END), 0) / (COUNTD(IF DATETRUNC(&apos;week&apos;,[date_local]) = DATETRUNC(&apos;week&apos;,[Calculation_2363967611030102019]) THEN [Calculation_2363967611028062209] END) * 60)' />
      </column>
      <column caption='% Spent in Event' datatype='real' name='[Calculation_2363967611034861574]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([event_minutes]) / (COUNTD([Calculation_2363967611028062209]) * 60)' />
      </column>
      <column caption='WoW Difference in % Spent in Shrink' datatype='real' name='[Calculation_2363967611037237256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2363967611032649733] - [Latest Week % Spent in Shrink (copy)_2363967611037073415]' />
      </column>
      <column caption='Category Week' datatype='string' name='[Calculation_2363967611043393550]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_2363967611030102019]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_2363967611030102019])&#10;THEN &apos;CW&apos;&#10;elseif datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_2363967611030102019]))})=1&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_2363967611030102019])&#10;THEN &apos;LW&apos;&#10;elseif datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_2363967611030102019]))})=2&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_2363967611030102019])&#10;THEN &apos;L2W&apos;&#10;elseif datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_2363967611030102019]))})=3&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_2363967611030102019])&#10;THEN &apos;L3W&apos;&#10;elseif datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_2363967611030102019]))})=4&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_2363967611030102019])&#10;THEN &apos;L4W&apos;&#10;elseif datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_2363967611030102019]))})=5&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_2363967611030102019])&#10;THEN &apos;L5W&apos;&#10;elseif datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_local]),{MAX(DATETRUNC(&apos;iso-week&apos;,[Calculation_2363967611030102019]))})=6&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_2363967611030102019])&#10;THEN &apos;L6W&apos;&#10;&#10;END' />
      </column>
      <column caption='Last Week % Spent in Surge' datatype='real' name='[Last Week % Spent in Shrink (copy)_2363967611042336780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM (IF DATEDIFF(&apos;iso-week&apos;, DATETRUNC(&apos;iso-week&apos;,[date_local]), DATETRUNC(&apos;iso-week&apos;,[Calculation_2363967611030102019])) = 1 AND [event] IN (&apos;surge_1&apos;, &apos;surge_2&apos;, &apos;surge_3&apos;, &apos;surge_4&apos;) THEN [event_minutes] END), 0) / (COUNTD(IF DATEDIFF(&apos;iso-week&apos;, DATETRUNC(&apos;iso-week&apos;,[date_local]), DATETRUNC(&apos;iso-week&apos;,[Calculation_2363967611030102019])) = 1 THEN [Calculation_2363967611028062209] END) * 60)' />
      </column>
      <column caption='Last Week % Spent in Shrink' datatype='real' name='[Latest Week % Spent in Shrink (copy)_2363967611037073415]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM (IF DATEDIFF(&apos;iso-week&apos;, DATETRUNC(&apos;iso-week&apos;,[date_local]), DATETRUNC(&apos;iso-week&apos;,[Calculation_2363967611030102019])) = 1 AND event IN (&apos;shrink_1&apos;, &apos;shrink_2&apos;, &apos;shrink_3&apos;, &apos;shrink_4&apos;, &apos;close&apos;) THEN [event_minutes] END), 0) / (COUNTD(IF DATEDIFF(&apos;iso-week&apos;, DATETRUNC(&apos;iso-week&apos;,[date_local]), DATETRUNC(&apos;iso-week&apos;,[Calculation_2363967611030102019])) = 1 THEN [Calculation_2363967611028062209] END) * 60)' />
      </column>
      <column caption='Latest Week % Spent in Surge' datatype='real' name='[Latest Week % Spent in Shrink (copy)_2363967611041665035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM (IF DATETRUNC(&apos;week&apos;,[date_local]) = DATETRUNC(&apos;week&apos;,[Calculation_2363967611030102019]) AND [event] IN (&apos;surge_1&apos;, &apos;surge_2&apos;, &apos;surge_3&apos;, &apos;surge_4&apos;) THEN [event_minutes] END), 0) / (COUNTD(IF DATETRUNC(&apos;week&apos;,[date_local]) = DATETRUNC(&apos;week&apos;,[Calculation_2363967611030102019]) THEN [Calculation_2363967611028062209] END) * 60)' />
      </column>
      <column caption='WoW Difference in % Spent in Surge' datatype='real' name='[WoW Difference in % Spent in Shrink (copy)_2363967611042586637]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Latest Week % Spent in Shrink (copy)_2363967611041665035] - [Last Week % Spent in Shrink (copy)_2363967611042336780]' />
      </column>
