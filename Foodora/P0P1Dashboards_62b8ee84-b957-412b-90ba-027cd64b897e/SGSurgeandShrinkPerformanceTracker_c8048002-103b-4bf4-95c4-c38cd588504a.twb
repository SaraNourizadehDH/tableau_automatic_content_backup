      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/SGSurgeandShrinkPerformanceTracker/WeeklyTimeSpentDashboard?rev=' id='WeeklyTimeSpentDashboard' path='/t/Foodora/workbooks/SGSurgeandShrinkPerformanceTracker' revision='' site='Foodora' />
      <style />
      <size maxheight='1000' maxwidth='1700' minheight='1000' minwidth='1700' sizing-mode='fixed' />
      <datasources>
        <datasource caption='Mean Delay Movement' name='federated.1nzxi4b13vrs9k14yxhx41967msl' />
      </datasources>
      <datasource-dependencies datasource='federated.1nzxi4b13vrs9k14yxhx41967msl'>
        <column caption='WTD?' datatype='boolean' name='[Calculation_2363967611031474180]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_2363967611030102019])' />
        </column>
        <column caption='Date Local' datatype='date' name='[date_local]' role='dimension' type='ordinal' />
        <column caption='Event' datatype='string' name='[event]' role='dimension' type='nominal' />
        <column aggregation='Sum' caption='Hour' datatype='integer' name='[hour]' role='dimension' type='ordinal' />
        <column-instance column='[Calculation_2363967611031474180]' derivation='None' name='[none:Calculation_2363967611031474180:nk]' pivot='key' type='nominal' />
        <column-instance column='[event]' derivation='None' name='[none:event:nk]' pivot='key' type='nominal' />
        <column datatype='string' name='[time of day]' role='dimension' type='nominal'>
          <calculation class='categorical-bin' column='[hour]' new-bin='true'>
            <bin default-name='false' value='&quot;Breakfast&quot;'>
              <value>7</value>
              <value>8</value>
              <value>9</value>
              <value>10</value>
            </bin>
            <bin default-name='false' value='&quot;Dinner&quot;'>
              <value>17</value>
              <value>18</value>
              <value>19</value>
            </bin>
            <bin default-name='false' value='&quot;Lunch&quot;'>
              <value>11</value>
              <value>12</value>
              <value>13</value>
            </bin>
            <bin default-name='false' value='&quot;Supper&quot;'>
