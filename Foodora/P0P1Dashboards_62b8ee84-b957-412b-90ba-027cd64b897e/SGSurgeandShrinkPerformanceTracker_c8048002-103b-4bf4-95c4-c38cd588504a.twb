    <worksheet name='Weekly Shrink'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Regular' fontsize='14'>Weekly Time Spent in Shrink</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Mean Delay Movement' name='federated.1nzxi4b13vrs9k14yxhx41967msl' />
          </datasources>
          <datasource-dependencies datasource='federated.1nzxi4b13vrs9k14yxhx41967msl'>
            <column caption='% Spent in Shrink' datatype='real' name='[Calculation_2363967611026984960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM(IF event IN (&apos;shrink_1&apos;, &apos;shrink_2&apos;, &apos;shrink_3&apos;, &apos;shrink_4&apos;, &apos;close&apos;) THEN [event_minutes] ELSE 0 END), 0) / (COUNTD([Calculation_2363967611028062209]) * 60)' />
            </column>
            <column caption='event key' datatype='string' name='[Calculation_2363967611028062209]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([date_local]) + &apos;-&apos; + STR([hour])' />
            </column>
            <column caption='MAX DATE' datatype='date' name='[Calculation_2363967611030102019]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed : max([date_local])}' />
            </column>
            <column caption='WTD?' datatype='boolean' name='[Calculation_2363967611031474180]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[date_local]) &lt;= DATEPART(&apos;iso-weekday&apos;,[Calculation_2363967611030102019])' />
            </column>
            <column caption='Latest Week % Spent in Shrink' datatype='real' name='[Calculation_2363967611032649733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM (IF DATETRUNC(&apos;week&apos;,[date_local]) = DATETRUNC(&apos;week&apos;,[Calculation_2363967611030102019]) AND event IN (&apos;shrink_1&apos;, &apos;shrink_2&apos;, &apos;shrink_3&apos;, &apos;shrink_4&apos;, &apos;close&apos;) THEN [event_minutes] END), 0) / (COUNTD(IF DATETRUNC(&apos;week&apos;,[date_local]) = DATETRUNC(&apos;week&apos;,[Calculation_2363967611030102019]) THEN [Calculation_2363967611028062209] END) * 60)' />
            </column>
            <column caption='Date Local' datatype='date' name='[date_local]' role='dimension' type='ordinal' />
            <column caption='Event' datatype='string' name='[event]' role='dimension' type='nominal' />
            <column caption='Event Minutes' datatype='integer' name='[event_minutes]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Hour' datatype='integer' name='[hour]' role='dimension' type='ordinal' />
            <column-instance column='[date_local]' derivation='Max' name='[max:date_local:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2363967611031474180]' derivation='None' name='[none:Calculation_2363967611031474180:nk]' pivot='key' type='nominal' />
            <column-instance column='[date_local]' derivation='None' name='[none:date_local:qk]' pivot='key' type='quantitative' />
            <column-instance column='[event]' derivation='None' name='[none:event:nk]' pivot='key' type='nominal' />
            <column-instance column='[zone_name]' derivation='None' name='[none:zone_name:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[time of day]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[hour]' new-bin='true'>
                <bin default-name='false' value='&quot;Breakfast&quot;'>
                  <value>7</value>
                  <value>8</value>
                  <value>9</value>
                  <value>10</value>
                </bin>
                <bin default-name='false' value='&quot;Dinner&quot;'>
                  <value>17</value>
                  <value>18</value>
                  <value>19</value>
                </bin>
                <bin default-name='false' value='&quot;Lunch&quot;'>
                  <value>11</value>
                  <value>12</value>
                  <value>13</value>
                </bin>
                <bin default-name='false' value='&quot;Supper&quot;'>
                  <value>20</value>
                  <value>21</value>
                  <value>22</value>
                  <value>23</value>
                </bin>
                <bin default-name='false' value='&quot;Teabreak&quot;'>
                  <value>14</value>
                  <value>15</value>
                  <value>16</value>
                </bin>
                <bin default-name='false' value='&quot;Wee hours&quot;'>
                  <value>0</value>
                  <value>1</value>
                  <value>2</value>
                  <value>3</value>
                  <value>4</value>
                  <value>5</value>
                  <value>6</value>
                </bin>
              </calculation>
            </column>
            <column-instance column='[date_local]' derivation='ISO-Week-Trunc' name='[tiwk:date_local:ok]' pivot='key' type='ordinal' />
