            <column caption='Hire Date Filter' datatype='boolean' name='[Cost Date Filter (copy)_958985246642184195]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[hire_date] &gt;= [Parameters].[Date To (copy)_958985246639104001]&#13;&#10;AND &#13;&#10;[hire_date] &lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='Days In Period Total' datatype='real' name='[Days Since Start of Period (copy)_1770196130291179531]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Monthly&quot; THEN DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;,1,[Parameters].[Parameter 1])) - DATETRUNC(&quot;month&quot;, [Parameters].[Parameter 1]) &#13;&#10;WHEN &quot;Weekly&quot; THEN 7&#13;&#10;WHEN &quot;Daily&quot; THEN 1&#13;&#10;END)' />
            </column>
            <column caption='Hire Date Period' datatype='date' default-format='*d.m.' name='[Lead Date Period (copy)_1770196130283663364]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Daily&quot; THEN [hire_date]&#13;&#10;WHEN &quot;Weekly&quot; THEN DATETRUNC(&quot;week&quot;,[hire_date],&quot;Monday&quot;)&#13;&#10;WHEN &quot;Monthly&quot; THEN DATETRUNC(&quot;month&quot;, [hire_date])&#13;&#10;END)' />
