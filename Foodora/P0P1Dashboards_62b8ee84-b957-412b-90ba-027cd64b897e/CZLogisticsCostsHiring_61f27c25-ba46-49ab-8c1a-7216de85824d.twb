              </calculation>
            </column>
            <column caption='RR' datatype='real' name='[Calculation_1770196130290491402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1770196130289365001] AND [Parameters].[Daily / Weekly / Monthly (copy)] = &quot;Yes&quot; THEN [Days Since Start of Period (copy)_1770196130291179531]/[Calculation_1770196130288414728] ELSE 1 END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cost' datatype='real' name='[Calculation_1770196130292662285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cost_eur])*[Calculation_1770196130290491402]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Data Date' datatype='date' name='[Calculation_1770196130294853649]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED:MAX(MAX(MAX([cost_date]), MAX([hire_date])), MAX([lead_date]))}' />
            </column>
            <column caption='Cost Date Filter' datatype='boolean' name='[Calculation_958985246642094082]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[cost_date] &gt;= [Parameters].[Date To (copy)_958985246639104001]&#13;&#10;AND &#13;&#10;[cost_date] &lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='Days In Period Total' datatype='real' name='[Days Since Start of Period (copy)_1770196130291179531]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Monthly&quot; THEN DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;,1,[Parameters].[Parameter 1])) - DATETRUNC(&quot;month&quot;, [Parameters].[Parameter 1]) &#13;&#10;WHEN &quot;Weekly&quot; THEN 7&#13;&#10;WHEN &quot;Daily&quot; THEN 1&#13;&#10;END)' />
            </column>
