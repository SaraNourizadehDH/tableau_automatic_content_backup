              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Daily&quot; THEN IFNULL([cost_date],[lead_date])&#13;&#10;WHEN &quot;Weekly&quot; THEN DATETRUNC(&quot;week&quot;,IFNULL([cost_date],[lead_date]),&quot;Monday&quot;)&#13;&#10;WHEN &quot;Monthly&quot; THEN DATETRUNC(&quot;month&quot;, IFNULL([cost_date],[lead_date]))&#13;&#10;END)' />
