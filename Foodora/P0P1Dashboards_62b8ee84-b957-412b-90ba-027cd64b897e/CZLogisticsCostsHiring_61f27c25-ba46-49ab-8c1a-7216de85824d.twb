            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00i21ue15avwkz17rnlkm1smtxde'>
            <column caption='Days Since Start of Period' datatype='real' name='[Calculation_1770196130288414728]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Monthly&quot; THEN [Parameters].[Parameter 1] - DATETRUNC(&quot;month&quot;, [Parameters].[Parameter 1]) + 1&#13;&#10;WHEN &quot;Weekly&quot; THEN [Parameters].[Parameter 1] - DATETRUNC(&quot;week&quot;, [Parameters].[Parameter 1], &quot;Monday&quot;)+1&#13;&#10;WHEN &quot;Daily&quot; THEN 1&#13;&#10;END)' />
            </column>
            <column caption='Is Last Period' datatype='boolean' name='[Calculation_1770196130289365001]' role='measure' type='nominal'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1 = 1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='RR' datatype='real' name='[Calculation_1770196130290491402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1770196130289365001] AND [Parameters].[Daily / Weekly / Monthly (copy)] = &quot;Yes&quot; THEN [Days Since Start of Period (copy)_1770196130291179531]/[Calculation_1770196130288414728] ELSE 1 END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Hires' datatype='real' name='[Calculation_1770196130293211151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([h_hires])*[Calculation_1770196130290491402]'>
                <table-calc ordering-type='Rows' />
