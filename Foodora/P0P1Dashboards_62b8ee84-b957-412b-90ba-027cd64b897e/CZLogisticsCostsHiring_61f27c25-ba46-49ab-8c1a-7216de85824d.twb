      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rider_recruitment_costs' name='federated.00i21ue15avwkz17rnlkm1smtxde' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='RR prediction' datatype='string' name='[Daily / Weekly / Monthly (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;No&quot;'>
              <calculation class='tableau' formula='&quot;No&quot;' />
            </column>
            <column caption='Date From' datatype='date' default-format='*dd-mmm-yy' name='[Date To (copy)_958985246639104001]' param-domain-type='any' role='measure' type='quantitative' value='#2024-09-01#'>
              <calculation class='tableau' formula='#2024-09-01#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.00i21ue15avwkz17rnlkm1smtxde].[Calculation_1770196130294853649]' caption='Date To' datatype='date' default-format='*dd-mmm-yy' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2025-06-30#'>
              <calculation class='tableau' formula='#2025-06-30#' />
            </column>
            <column caption='Daily / Weekly / Monthly' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00i21ue15avwkz17rnlkm1smtxde'>
            <column caption='Leads vs Target Channel' datatype='real' name='[Calculation_1103663389703311368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1770196130292912142]/[Leads (copy)_1103663389695082499]-1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Days Since Start of Period' datatype='real' name='[Calculation_1770196130288414728]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Monthly&quot; THEN [Parameters].[Parameter 1] - DATETRUNC(&quot;month&quot;, [Parameters].[Parameter 1]) + 1&#13;&#10;WHEN &quot;Weekly&quot; THEN [Parameters].[Parameter 1] - DATETRUNC(&quot;week&quot;, [Parameters].[Parameter 1], &quot;Monday&quot;)+1&#13;&#10;WHEN &quot;Daily&quot; THEN 1&#13;&#10;END)' />
            </column>
            <column caption='Is Last Period' datatype='boolean' name='[Calculation_1770196130289365001]' role='measure' type='nominal'>
              <calculation class='tableau' formula='SIZE() -INDEX() +1 = 1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='RR' datatype='real' name='[Calculation_1770196130290491402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1770196130289365001] AND [Parameters].[Daily / Weekly / Monthly (copy)] = &quot;Yes&quot; THEN [Days Since Start of Period (copy)_1770196130291179531]/[Calculation_1770196130288414728] ELSE 1 END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Leads' datatype='real' name='[Calculation_1770196130292912142]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([l_leads]) * [Calculation_1770196130290491402]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Data Date' datatype='date' name='[Calculation_1770196130294853649]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED:MAX(MAX(MAX([cost_date]), MAX([hire_date])), MAX([lead_date]))}' />
            </column>
            <column caption='Lead Date Filter' datatype='boolean' name='[Cost Date Filter (copy) (copy)_958985246642192388]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[lead_date] &gt;= [Parameters].[Date To (copy)_958985246639104001]&#13;&#10;AND &#13;&#10;[lead_date] &lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='Lead Date Period' datatype='date' default-format='*d.m.' name='[Cost Date Period (copy)_1770196130282881026]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Daily&quot; THEN [lead_date]&#13;&#10;WHEN &quot;Weekly&quot; THEN DATETRUNC(&quot;week&quot;,[lead_date],&quot;Monday&quot;)&#13;&#10;WHEN &quot;Monthly&quot; THEN DATETRUNC(&quot;month&quot;, [lead_date])&#13;&#10;END)' />
            </column>
            <column caption='Days In Period Total' datatype='real' name='[Days Since Start of Period (copy)_1770196130291179531]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Monthly&quot; THEN DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;,1,[Parameters].[Parameter 1])) - DATETRUNC(&quot;month&quot;, [Parameters].[Parameter 1]) &#13;&#10;WHEN &quot;Weekly&quot; THEN 7&#13;&#10;WHEN &quot;Daily&quot; THEN 1&#13;&#10;END)' />
            </column>
            <column caption='Leads Target Channel' datatype='real' name='[Leads (copy)_1103663389695082499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(CASE [channel] &#13;&#10;WHEN &quot;Organic&quot; THEN 1000&#13;&#10;WHEN &quot;Other&quot; THEN 0&#13;&#10;WHEN &quot;Own Channels&quot; THEN 1000&#13;&#10;WHEN &quot;Paid Social&quot; THEN 1500&#13;&#10;WHEN &quot;RAF&quot; THEN 500&#13;&#10;WHEN &quot;Search&quot; THEN 2200&#13;&#10;END)&#13;&#10;/&#13;&#10;(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;,1,[Parameters].[Parameter 1])) - DATETRUNC(&quot;month&quot;, [Parameters].[Parameter 1]))&#13;&#10;* [Days Since Start of Period (copy)_1770196130291179531]&#13;&#10;/ [RR (copy)_1103663389699571717]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='inverse RR' datatype='real' name='[RR (copy)_1103663389699571717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1770196130289365001] AND [Parameters].[Daily / Weekly / Monthly (copy)] = &quot;No&quot; THEN [Days Since Start of Period (copy)_1770196130291179531]/[Calculation_1770196130288414728] ELSE 1 END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
