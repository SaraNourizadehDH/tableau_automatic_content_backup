AND o.created_date &gt;&gt;= &apos;2024-09-01&apos;&#13;
GROUP BY ALL&#13;
UNION DISTINCT&#13;
SELECT&#13;
date_trunc(o.created_date, isoweek) as date,&#13;
ifnull(utm_source,&apos;--empty--&apos;) as utm_source,&#13;
city.city,&#13;
&apos;Weekly&apos; as dimension,&#13;
count(distinct d.rider_id) as active_riders&#13;
FROM `fulfillment-dwh-production.curated_data_shared.orders` o &#13;
join unnest(deliveries) as d&#13;
join cities as city on o.city_id = city.city_id and city.country_code = o.country_code AND city.zone_id = o.zone_id&#13;
left join rider_channels ON d.rider_id = rider_channels.rider_id&#13;
WHERE o.entity.id in (&apos;DJ_CZ&apos;)&#13;
AND o.created_date &gt;&gt;= &apos;2024-09-01&apos;&#13;
GROUP BY ALL&#13;
UNION DISTINCT&#13;
SELECT&#13;
date_trunc(o.created_date, month) as date,&#13;
ifnull(utm_source,&apos;--empty--&apos;) as utm_source,&#13;
city.city,&#13;
&apos;Monthly&apos; as dimension,&#13;
count(distinct d.rider_id) as active_riders&#13;
FROM `fulfillment-dwh-production.curated_data_shared.orders` o &#13;
join unnest(deliveries) as d&#13;
join cities as city on o.city_id = city.city_id and city.country_code = o.country_code AND city.zone_id = o.zone_id&#13;
left join rider_channels ON d.rider_id = rider_channels.rider_id&#13;
WHERE o.entity.id in (&apos;DJ_CZ&apos;)&#13;
AND o.created_date &gt;&gt;= &apos;2024-09-01&apos;&#13;
GROUP BY ALL</relation>
            </properties>
