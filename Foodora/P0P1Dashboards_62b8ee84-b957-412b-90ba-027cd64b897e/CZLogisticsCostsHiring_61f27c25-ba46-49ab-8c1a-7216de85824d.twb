            <column caption='Hires Target Channel' datatype='real' name='[Leads Target Channel (copy)_924645304832303105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [channel] = &quot;Organic&quot; AND MONTH([hire_date]) = 9 THEN 172&#13;&#10;ELSEIF [channel] = &quot;Organic&quot; AND MONTH([hire_date]) = 10 THEN 250&#13;&#10;ELSEIF [channel] = &quot;Organic&quot; AND MONTH([hire_date]) = 11 THEN 172&#13;&#10;ELSEIF [channel] = &quot;Organic&quot; AND MONTH([hire_date]) = 12 THEN 172&#13;&#10;ELSEIF [channel] = &quot;Other&quot; AND MONTH([hire_date]) = 9 THEN 1&#13;&#10;ELSEIF [channel] = &quot;Other&quot; AND MONTH([hire_date]) = 10 THEN 413&#13;&#10;ELSEIF [channel] = &quot;Other&quot; AND MONTH([hire_date]) = 11 THEN 416&#13;&#10;ELSEIF [channel] = &quot;Other&quot; AND MONTH([hire_date]) = 12 THEN 416&#13;&#10;ELSEIF [channel] = &quot;Own Channels&quot; AND MONTH([hire_date]) = 9 THEN 204&#13;&#10;ELSEIF [channel] = &quot;Own Channels&quot; AND MONTH([hire_date]) = 10 THEN 250&#13;&#10;ELSEIF [channel] = &quot;Own Channels&quot; AND MONTH([hire_date]) = 11 THEN 152&#13;&#10;ELSEIF [channel] = &quot;Own Channels&quot; AND MONTH([hire_date]) = 12 THEN 152&#13;&#10;ELSEIF [channel] = &quot;RAF&quot; AND MONTH([hire_date]) = 9 THEN 141&#13;&#10;ELSEIF [channel] = &quot;RAF&quot; AND MONTH([hire_date]) = 10 THEN 250&#13;&#10;ELSEIF [channel] = &quot;RAF&quot; AND MONTH([hire_date]) = 11 THEN 200&#13;&#10;ELSEIF [channel] = &quot;RAF&quot; AND MONTH([hire_date]) = 12 THEN 200&#13;&#10;ELSEIF [channel] = &quot;Search&quot; THEN 274&#13;&#10;ELSEIF [channel] = &quot;Paid Social&quot; THEN 81&#13;&#10;ELSEIF [channel] = &quot;Search&quot; THEN 274&#13;&#10;END)&#13;&#10;/&#13;&#10;(DATETRUNC(&quot;month&quot;, DATEADD(&quot;month&quot;,1,[Parameters].[Parameter 1])) - DATETRUNC(&quot;month&quot;, [Parameters].[Parameter 1]))&#13;&#10;* [Days Since Start of Period (copy)_1770196130291179531]&#13;&#10;/ [RR (copy)_1103663389699571717]'>
