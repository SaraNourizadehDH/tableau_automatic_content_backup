            <properties context=''>
              <relation connection='bigquery.08d9urh1f6w2ub19j58x31upmxdj' name='Custom SQL Query' type='text'>with rider_channels as &#13;
  (SELECT DISTINCT&#13;
  rider_id,&#13;
  LAST_VALUE(utm_source) OVER (PARTITION BY rider_id ORDER BY created_date ASC, utm_source DESC) as utm_source&#13;
  FROM `damejidlo-cz-bigquery.master.applicants`&#13;
  WHERE country_code = &apos;cze&apos;&#13;
  AND rider_id IS NOT NULL)&#13;
SELECT&#13;
o.created_date as date,&#13;
ifnull(utm_source,&apos;--empty--&apos;) as utm_source,&#13;
&apos;Daily&apos; as dimension,&#13;
count(distinct d.rider_id) as active_riders&#13;
FROM `fulfillment-dwh-production.curated_data_shared.orders` o &#13;
join unnest(deliveries) as d&#13;
left join rider_channels ON d.rider_id = rider_channels.rider_id&#13;
WHERE o.entity.id in (&apos;DJ_CZ&apos;)&#13;
AND o.created_date &gt;&gt;= &apos;2024-09-01&apos;&#13;
GROUP BY ALL&#13;
UNION DISTINCT&#13;
SELECT&#13;
date_trunc(o.created_date, isoweek) as date,&#13;
ifnull(utm_source,&apos;--empty--&apos;) as utm_source,&#13;
&apos;Weekly&apos; as dimension,&#13;
count(distinct d.rider_id) as active_riders&#13;
