    <worksheet name='Orders per day - Graph'>
      <table>
        <view>
          <datasources>
            <datasource caption='dmart_rider_delivery_data+ (bl_performance)' name='federated.1o9f2kv0f1wd8j10qrc5r1r64jpq' />
          </datasources>
          <datasource-dependencies datasource='federated.1o9f2kv0f1wd8j10qrc5r1r64jpq'>
            <column caption='Rider at date' datatype='date' name='[Calculation_3753187382344634368]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([rider_at_local])' />
            </column>
            <column caption='Weekday Average' datatype='real' name='[Calculation_3753187382345433089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([platform_order_code])/COUNTD(DATEPART(&apos;week&apos;, [created_date]))' />
            </column>
            <column caption='Country' datatype='string' name='[Calculation_708754019423535104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Sweden&quot;' />
            </column>
            <column caption='Warehouse' datatype='string' name='[Calculation_817966322802561044]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([warehouse_name (dmart_rider_delivery_data)],[vendor_name])' />
            </column>
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
