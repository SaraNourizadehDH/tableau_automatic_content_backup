    <worksheet name='Daily/Weekly View - Store - Sheet'>
      <table>
        <view>
          <datasources>
            <datasource caption='dmart_rider_delivery_data+ (bl_performance)' name='federated.1o9f2kv0f1wd8j10qrc5r1r64jpq' />
          </datasources>
          <datasource-dependencies datasource='federated.1o9f2kv0f1wd8j10qrc5r1r64jpq'>
            <column caption='% DT &lt; 10 min' datatype='real' name='[% DT &lt; 15 min (copy)_116812158884065287]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_preorder] == FALSE AND [actual_delivery_time]/60 &lt;= 10 THEN 1 END) / COUNT([actual_delivery_time])' />
            </column>
            <column caption='% DT &lt; 20 min' datatype='real' name='[% DT &lt; 15 min (copy)_817966323365720091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_preorder] == FALSE AND [actual_delivery_time]/60 &lt;= 20 THEN 1 END) / COUNT([actual_delivery_time])' />
            </column>
            <column caption='% DT &lt; 30 min' datatype='real' name='[% DT &lt; 25 min (copy)_817966323366555677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_preorder] == FALSE AND [actual_delivery_time]/60 &lt;= 30 THEN 1 END) / COUNT([actual_delivery_time])' />
            </column>
            <column caption='% DT &lt; 15 min' datatype='real' name='[% Stacked Deliveries (copy)_817966323365191706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_preorder] == FALSE AND [actual_delivery_time]/60 &lt;= 15 THEN 1 END) / COUNT([actual_delivery_time])' />
            </column>
            <column caption='At Vendor Time cl' datatype='real' name='[At Vendor Time (copy)_817966322770169866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([at_vendor_time_cleaned]/60)' />
            </column>
            <column caption='To Customer Time' datatype='real' name='[At Vendor Time (copy)_817966322770272267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([to_customer_time]/60)' />
            </column>
            <column caption='DP Hold Back Time (Primary)' datatype='real' name='[Calculation_116812156730986499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_preorder] == FALSE AND [is_primary] == TRUE THEN [dp_hold_back_time]/60 ELSE NULL END)' />
            </column>
            <column caption='Avg. Delivery Costs' datatype='real' name='[Calculation_1212031286045913088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1.43*SUM([costs])/[Calculation_817966322769489925]' />
            </column>
            <column caption='Week' datatype='integer' name='[Calculation_1725160138207137795]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;week&apos;, [created_date])' />
            </column>
            <column caption='Vendor Late &gt; 10 min' datatype='real' name='[Calculation_4655877640907444224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [at_vendor_time_cleaned] &gt; 600 THEN 1 ELSE 0 END) / COUNT([at_vendor_time_cleaned])' />
            </column>
            <column caption='Country' datatype='string' name='[Calculation_708754019423535104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Sweden&quot;' />
            </column>
            <column caption='Orders &gt; 8 kg' datatype='real' name='[Calculation_719731575246438405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [total_weight_ordered] &gt; 8 THEN 1 ELSE 0 END) / COUNTD([platform_order_code])' />
            </column>
            <column caption='DT' datatype='real' name='[Calculation_817966322764677120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_preorder] == FALSE THEN [actual_delivery_time]/60 ELSE NULL END)' />
            </column>
            <column caption='% Extra Deliveries' datatype='real' name='[Calculation_817966322765504513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([delivery_id]) / COUNTD([platform_order_code]) -1' />
            </column>
            <column caption='Avg. GMV' datatype='real' name='[Calculation_817966322766368770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([amt_gmv_lc])' />
            </column>
            <column caption='Orders' datatype='integer' name='[Calculation_817966322769489925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([platform_order_code])' />
            </column>
            <column caption='Rider Accepting Time' datatype='real' name='[Calculation_817966322769866759]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([rider_accepting_time]/60)' />
            </column>
            <column caption='Fulfillment Time' datatype='real' name='[Calculation_817966322774499340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_preorder] == FALSE THEN [fulfillment_time_s]/60 ELSE NULL END)' />
            </column>
            <column caption='Total Picking Time' datatype='real' name='[Calculation_817966322775248911]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_preorder] == FALSE THEN ([assignment_time_s]+[fulfillment_time_s])/60 ELSE NULL END)' />
            </column>
            <column caption='Warehouse' datatype='string' name='[Calculation_817966322802561044]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([warehouse_name (dmart_rider_delivery_data)],[vendor_name])' />
            </column>
            <column caption='% Stacked Deliveries' datatype='real' name='[Calculation_817966322802962453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [stacked_deliveries] &gt; 0 THEN 1 END) / COUNT([stacked_deliveries])' />
            </column>
            <column caption='Pickup Dist' datatype='real' name='[Calculation_817966322805596182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [pickup_distance_manhattan] &gt; 10000 THEN NULL ELSE [pickup_distance_manhattan]/1000 END)' />
            </column>
            <column caption='DP Hold Back Time (under 400 &amp; Primary)' datatype='real' name='[DP Hold Back Time (copy)_116812156829495300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_preorder] == FALSE AND [amt_gmv_lc] &lt;= 400 AND [is_primary] == TRUE THEN [dp_hold_back_time]/60 ELSE NULL END)' />
            </column>
            <column caption='DP Hold Back Time (over 400 &amp; primary)' datatype='real' name='[DP Hold Back Time (under 400) (copy)_116812156829794309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_preorder] == FALSE AND [amt_gmv_lc] &gt;= 400 AND [is_primary] == TRUE THEN [dp_hold_back_time]/60 ELSE NULL END)' />
            </column>
            <column caption='DT Primary Delivery' datatype='real' name='[DT (copy)_817966322768080899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_primary] == TRUE AND [is_preorder] == FALSE THEN [actual_delivery_time]/60 ELSE NULL END)' />
            </column>
            <column caption='DT Secondary Delivery' datatype='real' name='[DT Primary (copy)_817966322768465924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_primary] == FALSE AND [is_preorder] == FALSE THEN [actual_delivery_time]/60 ELSE NULL END)' />
            </column>
            <column caption='% Dedicated Orders' datatype='real' name='[Dedicated Orders (copy)_1725160136789495809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;&#13;&#10;IF &#13;&#10;[rider_id] = 1027790 OR&#13;&#10;[rider_id] = 1027792 OR&#13;&#10;[rider_id] = 1027794 OR&#13;&#10;[rider_id] = 1027796 OR&#13;&#10;[rider_id] = 1027799 OR&#13;&#10;[rider_id] = 1027801 OR&#13;&#10;[rider_starting_point_id] = 25006 OR &#13;&#10;[rider_starting_point_id] = 25057 OR&#13;&#10;[rider_starting_point_id] = 25007 OR&#13;&#10;[rider_starting_point_id] = 25058 OR&#13;&#10;[rider_starting_point_id] = 25059 &#13;&#10;&#13;&#10;THEN [platform_order_code]&#13;&#10;ELSE NULL&#13;&#10;END&#13;&#10;)&#13;&#10;&#13;&#10;/ COUNTD([platform_order_code])' />
            </column>
            <column caption='% orders &lt; 2 km' datatype='real' name='[Dropoff Dist (copy)_1725160137548320770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [dropoff_distance_manhattan]&lt;2000 THEN 1 ELSE 0 END) / COUNTD([delivery_id])' />
            </column>
            <column caption='Assignment Time' datatype='real' name='[Fulfillment Time (copy)_817966322774913038]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [is_preorder] == FALSE THEN [assignment_time_s]/60 ELSE NULL END)' />
            </column>
            <column caption='Dedicated Orders' datatype='integer' name='[Orders (copy)_1725160136788930560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF &#13;&#10;[rider_id] = 1027790 OR&#13;&#10;[rider_id] = 1027792 OR&#13;&#10;[rider_id] = 1027794 OR&#13;&#10;[rider_id] = 1027796 OR&#13;&#10;[rider_id] = 1027799 OR&#13;&#10;[rider_id] = 1027801 OR&#13;&#10;[rider_starting_point_id] = 25006 OR &#13;&#10;[rider_starting_point_id] = 25057 OR&#13;&#10;[rider_starting_point_id] = 25007 OR&#13;&#10;[rider_starting_point_id] = 25058 OR&#13;&#10;[rider_starting_point_id] = 25059&#13;&#10;&#13;&#10;THEN [platform_order_code]&#13;&#10;ELSE NULL&#13;&#10;END)' />
            </column>
            <column caption='Extra Deliveries' datatype='integer' name='[Orders (copy)_817966322769539078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([delivery_id]) - COUNTD([platform_order_code])' />
            </column>
            <column caption='Dropoff Dist' datatype='real' name='[Pickup Dist (copy)_817966322805694487]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([dropoff_distance_manhattan]/1000)' />
            </column>
            <column caption='To Vendor Time' datatype='real' name='[Rider Accepting Time (copy)_817966322770006024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([to_vendor_time]/60)' />
            </column>
            <column caption='To Customer Time (not stacked &amp; Primary)' datatype='real' name='[To Customer Time (copy)_817966322800934929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [stacked_deliveries] == 0 AND [is_primary] == TRUE THEN [to_customer_time]/60 ELSE NULL END)' />
            </column>
            <column caption='To Customer Time (stacked)' datatype='real' name='[To Customer Time (stack 0) (copy)_817966322801291282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [stacked_deliveries] &gt;= 1 THEN [to_customer_time]/60 ELSE NULL END)' />
            </column>
            <column caption='At Vendor Time' datatype='real' name='[To Vendor Time (copy)_817966322770083849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([at_vendor_time]/60)' />
            </column>
            <column caption='Vendor Late &gt; 5 min' datatype='real' name='[Vendor Late &gt; 10 min (copy)_4655877640908296193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [at_vendor_time_cleaned] &gt; 300 THEN 1 ELSE 0 END) / COUNT([at_vendor_time_cleaned])' />
            </column>
            <column caption='acc + to vendor &lt; 5 min' datatype='real' name='[Vendor Late &gt; 5 min (copy)_719731570305228800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [rider_accepting_time] + [to_vendor_time] &lt; 300 THEN 1 ELSE 0 END) / COUNT([delivery_id])' />
            </column>
