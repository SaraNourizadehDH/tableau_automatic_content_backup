      <aliases enabled='yes' />
      <column caption='% Surge Paid - MTD' datatype='real' name='[% Surge Subjected - MTD (copy)_3882384400009691166]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE : SUM(IF DATETRUNC(&apos;month&apos;,{MAX([date_])}) &lt;= [date_]&#10;THEN [surge_paid_orders]&#10;END&#10;)} / &#10;{INCLUDE : SUM(IF DATETRUNC(&apos;month&apos;,{MAX([date_])}) &lt;= [date_]&#10;THEN [orders]&#10;END&#10;)}' />
      </column>
      <column caption='% Surge Paid - PMTD' datatype='real' name='[% Surge Subjected - PMTD (copy)_3882384400009736223]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE : SUM(IF DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([date_])})) &lt;= [date_]&#10;AND DATEADD(&apos;month&apos;,-1,{MAX([date_])}) &gt;= [date_]&#10;THEN [surge_paid_orders]&#10;END&#10;)} / &#10;{INCLUDE : SUM(IF DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([date_])})) &lt;= [date_]&#10;AND DATEADD(&apos;month&apos;,-1,{MAX([date_])}) &gt;= [date_]&#10;THEN [orders]&#10;END&#10;)}' />
      </column>
      <column caption='% Surge Paid - PWTD' datatype='real' name='[% Surge Subjected - PWTD (copy)_3882384400009793568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=1&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [surge_paid_orders]&#10;END&#10;)} / {INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=1&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [orders]&#10;END&#10;)}' />
      </column>
      <column caption='% Surge Subjected - PWTD' datatype='real' name='[% Surge Subjected - WTD (copy)_3882384400007368727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=1&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [surge_subjected_orders]&#10;END&#10;)} / {INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=1&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [orders]&#10;END&#10;)}' />
      </column>
      <column caption='% Surge Paid - WTD' datatype='real' name='[% Surge Subjected - WTD (copy)_3882384400009846817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [surge_paid_orders]&#10;END&#10;)} / &#10;{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [orders]&#10;END&#10;)}' />
      </column>
      <column caption='Type of Immune to Surge Orders' datatype='real' name='[% of Orders Immune to Surge (copy)_3882384399987482638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [immune_to_surge_type], [Calculation_211739597395197964]: SUM([immune_to_surge_orders])} / {FIXED [Calculation_211739597395197964]: SUM([immune_to_surge_orders])}' />
      </column>
      <column caption='% of Orders Immune to Surge by Time of Day' datatype='real' name='[% of Orders Immune to Surge (copy)_3882384399988174863]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Calculation_211739597235019780]: SUM([immune_to_surge_orders])} / {FIXED [Calculation_211739597235019780]: SUM([orders])}' />
      </column>
      <column caption='% of Orders Paid for Surge' datatype='real' name='[% of Orders Subjected to Surge (copy)_211739597235146758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([surge_paid_orders]) / SUM([orders])' />
      </column>
      <column caption='time_of_day' datatype='string' name='[Calculation_211739597235019780]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF hour_ IN (7,8,9,10) THEN &apos;Breakfast&apos;&#10;ELSEIF [hour_] IN (11,12,13) THEN &apos;Lunch&apos;&#10;ELSEIF [hour_] IN (14,15,16) THEN &apos;Teabreak&apos;&#10;ELSEIF [hour_] IN (17,18,19) THEN &apos;Dinner&apos;&#10;ELSEIF [hour_] IN (20,21,22,23) THEN &apos;Supper&apos;&#10;ELSE &apos;Wee hours&apos;&#10;END' />
      </column>
      <column caption='% of Orders Subjected to Surge' datatype='real' name='[Calculation_211739597235052549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([surge_subjected_orders]) / SUM([orders])' />
      </column>
      <column caption='Date Switchable' datatype='date' name='[Calculation_211739597395132427]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(&#10;&#10;CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN [date_]&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;iso-week&apos;, [date_])&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [date_])&#10;&#10;END&#10;)' />
      </column>
      <column caption='Date Switchable String' datatype='string' name='[Calculation_211739597395197964]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN RIGHT(DATENAME(&apos;year&apos;, [Calculation_211739597395132427]), 2) + &apos;/&apos; + STR(DATEPART(&apos;month&apos;, [Calculation_211739597395132427])) + &apos;/&apos; + STR(DATEPART(&apos;day&apos;, [Calculation_211739597395132427]))&#10;WHEN &apos;Weekly&apos; THEN RIGHT(DATENAME(&apos;year&apos;, [Calculation_211739597395132427]), 2) + &apos;/&apos; + STR(DATEPART(&apos;month&apos;, [Calculation_211739597395132427])) + &apos;/&apos; + STR(DATEPART(&apos;day&apos;, [Calculation_211739597395132427]))&#10;WHEN &apos;Monthly&apos; THEN RIGHT(DATENAME(&apos;year&apos;, [Calculation_211739597395132427]), 2) + &apos;/&apos; + STR(DATEPART(&apos;month&apos;, [Calculation_211739597395132427])) + &apos;/&apos; + STR(DATEPART(&apos;day&apos;, [Calculation_211739597395132427]))&#10;END' />
      </column>
      <column caption='Is Within Last X Days?' datatype='boolean' name='[Calculation_3882384399979712516]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [date_] &gt;= ({MAX([date_])} - [Parameters].[Parameter 2]) AND [date_] &lt;= {MAX([date_])} THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Is Within Last X Weeks?' datatype='boolean' name='[Calculation_3882384399979798533]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;, [date_]) &gt;= ({MAX(DATETRUNC(&apos;iso-week&apos;, [date_]))} - [Parameters].[Last X Days (copy)_3882384399977398274] * 7) AND DATETRUNC(&apos;iso-week&apos;, [date_]) &lt;= {MAX(DATETRUNC(&apos;iso-week&apos;, [date_]))} THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='WTD?' datatype='boolean' name='[Calculation_3882384399983296518]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,{MAX([date_])})' />
      </column>
      <column caption='MTD?' datatype='boolean' name='[Calculation_3882384399983415303]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date_]) &lt;= {MAX([date_])} AND day([date_]) &lt;= day({MAX([date_])})' />
      </column>
      <column caption='D/W/M To Date?' datatype='boolean' name='[Calculation_3882384399983542280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN [Calculation_3882384399983296518]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_3882384399983296518]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_3882384399983415303]&#10;&#10;END' />
      </column>
      <column caption='% of Orders Immune to Surge' datatype='real' name='[Calculation_3882384399985324044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [vertical], [Calculation_211739597395197964]: SUM([immune_to_surge_orders])} / {FIXED [Calculation_211739597395197964]: SUM([orders])}' />
      </column>
      <column caption='% Surge Subjected - WTD' datatype='real' name='[Calculation_3882384400007098390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [surge_subjected_orders]&#10;END&#10;)} / &#10;{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [orders]&#10;END&#10;)}' />
      </column>
      <column caption='WoW Change % Surge Subjected' datatype='real' name='[Calculation_3882384400007581721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3882384400007098390] - [% Surge Subjected - WTD (copy)_3882384400007368727]' />
      </column>
      <column caption='% Surge Subjected - MTD' datatype='real' name='[Calculation_3882384400007704602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE : SUM(IF DATETRUNC(&apos;month&apos;,{MAX([date_])}) &lt;= [date_]&#10;THEN [surge_subjected_orders]&#10;END&#10;)} / &#10;{INCLUDE : SUM(IF DATETRUNC(&apos;month&apos;,{MAX([date_])}) &lt;= [date_]&#10;THEN [orders]&#10;END&#10;)}' />
      </column>
      <column caption='% Surge Subjected - PMTD' datatype='real' name='[Calculation_3882384400007933979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE : SUM(IF DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([date_])})) &lt;= [date_]&#10;AND DATEADD(&apos;month&apos;,-1,{MAX([date_])}) &gt;= [date_]&#10;THEN [surge_subjected_orders]&#10;END&#10;)} / &#10;{INCLUDE : SUM(IF DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([date_])})) &lt;= [date_]&#10;AND DATEADD(&apos;month&apos;,-1,{MAX([date_])}) &gt;= [date_]&#10;THEN [orders]&#10;END&#10;)}' />
      </column>
      <column caption='WoW / MoM Change % Surge Subjected' datatype='real' name='[Calculation_3882384400008372253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN [Calculation_3882384400007581721]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_3882384400007581721]&#10;WHEN &apos;Monthly&apos; THEN [WoW Change % Surge Subjected (copy)_3882384400008011804]&#10;&#10;END' />
      </column>
      <column caption='MoM Change % Surge Paid' datatype='real' name='[MoM Change % Surge Subjected (copy)_3882384400009977891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% Surge Subjected - MTD (copy)_3882384400009691166] - [% Surge Subjected - PMTD (copy)_3882384400009736223]' />
      </column>
      <column caption='WoW / MoM Change % Surge Paid' datatype='real' name='[WoW / MoM Change % Surge Subjected (copy)_3882384400010031140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN [WoW Change % Surge Subjected (copy)_3882384400009904162]&#10;WHEN &apos;Weekly&apos; THEN [WoW Change % Surge Subjected (copy)_3882384400009904162]&#10;WHEN &apos;Monthly&apos; THEN [MoM Change % Surge Subjected (copy)_3882384400009977891]&#10;&#10;END' />
      </column>
      <column caption='MoM Change % Surge Subjected' datatype='real' name='[WoW Change % Surge Subjected (copy)_3882384400008011804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3882384400007704602] - [Calculation_3882384400007933979]' />
      </column>
      <column caption='WoW Change % Surge Paid' datatype='real' name='[WoW Change % Surge Subjected (copy)_3882384400009904162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% Surge Subjected - WTD (copy)_3882384400009846817] - [% Surge Subjected - PWTD (copy)_3882384400009793568]' />
      </column>
