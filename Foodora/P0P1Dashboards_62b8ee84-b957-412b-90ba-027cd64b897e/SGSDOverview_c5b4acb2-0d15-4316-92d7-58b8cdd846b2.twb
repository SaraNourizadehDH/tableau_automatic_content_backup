            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3882384400008372253]' derivation='Sum' name='[sum:Calculation_3882384400008372253:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[surge_subjected_orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[vertical]' role='dimension' type='nominal' />
            <column-instance column='[date_]' derivation='Weekday' name='[wd:date_:ok]' pivot='key' type='ordinal' />
            <column datatype='string' name='[zone_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
