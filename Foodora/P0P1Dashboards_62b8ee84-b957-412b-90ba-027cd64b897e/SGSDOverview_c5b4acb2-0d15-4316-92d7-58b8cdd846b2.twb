            <column-instance column='[% of Orders Subjected to Surge (copy)_211739597235146758]' derivation='User' name='[usr:% of Orders Subjected to Surge (copy)_211739597235146758:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[vertical]' role='dimension' type='nominal' />
