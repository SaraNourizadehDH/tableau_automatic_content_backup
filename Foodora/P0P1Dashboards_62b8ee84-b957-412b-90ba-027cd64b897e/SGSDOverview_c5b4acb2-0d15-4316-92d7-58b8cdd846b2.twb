            <column-instance column='[WoW / MoM Change % Order Loss in Shrink (copy)_3882384400016277561]' derivation='Sum' name='[sum:WoW / MoM Change % Order Loss in Shrink (copy)_3882384400016277561:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[total_time]' role='measure' type='quantitative' />
            <column datatype='real' name='[total_time_in_close]' role='measure' type='quantitative' />
            <column datatype='real' name='[total_time_in_shrink]' role='measure' type='quantitative' />
            <column-instance column='[date_]' derivation='Weekday' name='[wd:date_:ok]' pivot='key' type='ordinal' />
            <column datatype='string' name='[zone_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
