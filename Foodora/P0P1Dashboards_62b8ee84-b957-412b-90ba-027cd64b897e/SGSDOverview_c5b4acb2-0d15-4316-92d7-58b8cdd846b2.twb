            <column-instance column='[% of Orders Immune to Surge (copy)_3882384399988174863]' derivation='Sum' name='[sum:% of Orders Immune to Surge (copy)_3882384399988174863:qk]' pivot='key' type='quantitative' />
            <column-instance column='[date_]' derivation='Weekday' name='[wd:date_:ok]' pivot='key' type='ordinal' />
            <column datatype='string' name='[zone_name]' role='dimension' type='nominal' />
