            <column-instance column='[Calculation_3882384399993344020]' derivation='None' name='[none:Calculation_3882384399993344020:nk]' pivot='key' type='nominal' />
            <column-instance column='[hour_]' derivation='None' name='[none:hour_:ok]' pivot='key' type='ordinal' />
            <column-instance column='[zone_name]' derivation='None' name='[none:zone_name:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[total_orders_in_close]' role='measure' type='quantitative' />
            <column datatype='real' name='[total_orders_in_shrink]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_211739597065662465]' derivation='User' name='[usr:Calculation_211739597065662465:qk]' pivot='key' type='quantitative' />
            <column-instance column='[date_]' derivation='Weekday' name='[wd:date_:ok]' pivot='key' type='ordinal' />
            <column datatype='string' name='[zone_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
