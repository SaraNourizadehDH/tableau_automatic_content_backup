    <worksheet name='CVR Delta (Surge 1)'>
      <table>
        <view>
          <datasources>
            <datasource caption='[SG] Conversion by Surge Events' name='federated.0wduqjh11d3dd515yesz71gvgl3c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0wduqjh11d3dd515yesz71gvgl3c'>
            <column caption='CVR - MTD' datatype='real' name='[CVR - PMTD (copy)_211739597424562197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE : SUM(IF DATETRUNC(&apos;month&apos;,{MAX([date_])}) &lt;= [date_]&#10;THEN [total_sessions_w_transactions]&#10;END&#10;)} / &#10;{INCLUDE : SUM(IF DATETRUNC(&apos;month&apos;,{MAX([date_])}) &lt;= [date_]&#10;THEN [total_sessions]&#10;END&#10;)}' />
            </column>
            <column caption='CVR - PMTD' datatype='real' name='[CVR - PWTD (copy)_211739597423394834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE : SUM(IF DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([date_])})) &lt;= [date_]&#10;AND DATEADD(&apos;month&apos;,-1,{MAX([date_])}) &gt;= [date_]&#10;THEN [total_sessions_w_transactions]&#10;END&#10;)} / &#10;{INCLUDE : SUM(IF DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([date_])})) &lt;= [date_]&#10;AND DATEADD(&apos;month&apos;,-1,{MAX([date_])}) &gt;= [date_]&#10;THEN [total_sessions]&#10;END&#10;)}' />
            </column>
            <column caption='time_of_day' datatype='string' name='[Calculation_211739597243949064]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF hour_ IN (7,8,9,10) THEN &apos;Breakfast&apos;&#10;ELSEIF [hour_] IN (11,12,13) THEN &apos;Lunch&apos;&#10;ELSEIF [hour_] IN (14,15,16) THEN &apos;Teabreak&apos;&#10;ELSEIF [hour_] IN (17,18,19) THEN &apos;Dinner&apos;&#10;ELSEIF [hour_] IN (20,21,22,23) THEN &apos;Supper&apos;&#10;ELSE &apos;Wee hours&apos;&#10;END' />
            </column>
            <column caption='CVR - WTD' datatype='real' name='[Calculation_211739597396357135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [total_sessions_w_transactions]&#10;END&#10;)} / &#10;{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [total_sessions]&#10;END&#10;)}' />
            </column>
            <column caption='CVR - PWTD' datatype='real' name='[Calculation_211739597396619280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=1&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [total_sessions_w_transactions]&#10;END&#10;)} / {INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=1&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [total_sessions]&#10;END&#10;)}' />
            </column>
            <column caption='WoW Change % CVR' datatype='real' name='[Calculation_211739597397008401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_211739597396357135]) - SUM([Calculation_211739597396619280])' />
            </column>
            <column caption='WoW / MoM Change % CVR' datatype='real' name='[Calculation_3882384399967424512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN [Calculation_211739597397008401]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_211739597397008401]&#10;WHEN &apos;Monthly&apos; THEN [WoW Change % CVR (copy)_211739597424832534]&#10;&#10;END' />
            </column>
            <column caption='WTD?' datatype='boolean' name='[Calculation_3882384399984341001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,{MAX([date_])})' />
            </column>
            <column caption='MTD?' datatype='boolean' name='[Calculation_3882384399984447498]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date_]) &lt;= {MAX([date_])} AND day([date_]) &lt;= day({MAX([date_])})' />
            </column>
            <column caption='D/W/M To Date?' datatype='boolean' name='[Calculation_3882384399984521227]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN [Calculation_3882384399984341001]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_3882384399984341001]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_3882384399984447498]&#10;&#10;END' />
            </column>
            <column caption='MoM Change % CVR' datatype='real' name='[WoW Change % CVR (copy)_211739597424832534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([CVR - PMTD (copy)_211739597424562197]) - SUM([CVR - PWTD (copy)_211739597423394834])' />
            </column>
            <column datatype='date' name='[date_]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[hour_]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_211739597243949064]' derivation='None' name='[none:Calculation_211739597243949064:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3882384399984521227]' derivation='None' name='[none:Calculation_3882384399984521227:nk]' pivot='key' type='nominal' />
            <column-instance column='[hour_]' derivation='None' name='[none:hour_:ok]' pivot='key' type='ordinal' />
            <column-instance column='[surge_event]' derivation='None' name='[none:surge_event:nk]' pivot='key' type='nominal' />
            <column-instance column='[zone_name]' derivation='None' name='[none:zone_name:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[surge_event]' role='dimension' type='nominal' />
            <column datatype='integer' name='[total_sessions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_sessions_w_transactions]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3882384399967424512]' derivation='User' name='[usr:Calculation_3882384399967424512:qk]' pivot='key' type='quantitative' />
