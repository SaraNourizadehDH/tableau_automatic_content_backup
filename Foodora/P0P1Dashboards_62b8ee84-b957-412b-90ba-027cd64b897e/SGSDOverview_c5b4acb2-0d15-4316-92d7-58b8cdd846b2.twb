      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Singapore&quot;' />
      </semantic-values>
      <date-options start-of-week='monday' />
      <datasource-dependencies datasource='Parameters'>
        <column caption='Last X Weeks' datatype='integer' name='[Last X Days (copy)_3882384399977398274]' param-domain-type='range' role='measure' type='quantitative' value='6'>
          <calculation class='tableau' formula='6' />
          <range max='12' min='1' />
        </column>
        <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
          <calculation class='tableau' formula='&quot;Weekly&quot;' />
        </column>
        <column caption='Last X Days' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='1'>
          <calculation class='tableau' formula='1' />
          <range max='30' min='1' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_E22E411B391746BA892915905F411EDC'>
            <properties context=''>
              <relation connection='bigquery.1wb0dkn1xr04ji1bt6j3h1q41n9u' name='Custom SQL Query' type='text'>WITH orders AS (

  SELECT

    pd.ordered_at_date_local AS date_,
    zones.name AS zone_name,
    EXTRACT(HOUR FROM pd.ordered_at_local) AS hour_,
    pd.code,

    CASE
      WHEN verticals.global_code IN (&apos;restaurants&apos;, &apos;street_food&apos;, &apos;caterers&apos;) THEN &apos;Restaurants&apos;
      WHEN verticals.global_code IN (&apos;darkstores&apos;) THEN &apos;Dmart&apos;
      ELSE &apos;Shops&apos;
    END AS vertical,

    CASE
      WHEN pd.delivery_fee_local = 0 THEN &apos;free_delivery&apos;
      WHEN cdbo.is_meal_for_one = TRUE THEN &apos;meal_for_one&apos;
      WHEN is_df_campaign_order = TRUE THEN &quot;$1.99&quot;
      ELSE &apos;NA&apos;
    END AS immune_to_surge_type,

    IFNULL(COALESCE(dps_surge_fee_local, dps_standard_surge_fee_local), 0) AS surge_fee,

  FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` pd

  JOIN (`fulfillment-dwh-production.pandata_curated.vdr_svc_vendors` vdr
  JOIN UNNEST(verticals) verticals)
    ON pd.vendor_code = vdr.vendor_code
    AND vdr.global_entity_id = &apos;FP_SG&apos;
    AND verticals.is_main = TRUE

  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_additional_vf_df_revenue` df
    ON pd.code = df.code

  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` cdbo
    ON pd.code = cdbo.order_id
    AND cdbo.global_entity_id = &apos;FP_SG&apos;
    AND cdbo.partition_date_local &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)
  
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.orders` cdso
    ON cdso.platform_order_code = pd.code
    AND cdso.country_code = &apos;sg&apos;
    AND cdso.created_date &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)

  LEFT JOIN (`fulfillment-dwh-production.curated_data_shared.countries` c
  JOIN UNNEST(c.cities) city
  JOIN UNNEST(city.zones) zones)
    ON cdso.zone_id = zones.id
    AND LOWER(c.country_code) = &apos;sg&apos;
    AND zones.is_active = TRUE
    AND LOWER(zones.name) NOT LIKE &apos;%dmart%&apos;
    AND zones.has_default_delivery_area_settings = TRUE

  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` dps
    ON pd.code = dps.platform_order_code
    AND dps.country_code = &apos;sg&apos;
    AND dps.created_date &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)

  WHERE pd.ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH) AND (CURRENT_DATE() - 1)
    AND is_valid_order = TRUE
    AND is_test_order = FALSE
    AND expedition_type = &apos;delivery&apos;
    AND pd.is_own_delivery = TRUE

  QUALIFY ROW_NUMBER() OVER(PARTITION BY code) = 1

)

SELECT

  zone_name,
  date_,
  hour_,
  vertical,
  immune_to_surge_type,

  COUNT(DISTINCT code) AS orders,
  COUNT(DISTINCT CASE WHEN immune_to_surge_type != &apos;NA&apos; THEN code END) AS immune_to_surge_orders,
  COUNT(DISTINCT CASE WHEN surge_fee &gt;&gt; 0 THEN code END) AS surge_subjected_orders,
  COUNT(DISTINCT CASE WHEN immune_to_surge_type = &apos;NA&apos; AND surge_fee &gt;&gt; 0 THEN code END) AS surge_paid_orders,

FROM orders

GROUP BY 1,2,3,4,5</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='% of Orders Immune to Surge'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>% OF ORDERS IMMUNE TO SURGE BY VERTICAL</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Regular' fontsize='9' italic='true'>Total immune to surge orders from vertical / Total orders </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[SG] Surgeable Orders' name='federated.0we3agp0qucbs01ea7y4m1p02fsa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Last X Weeks' datatype='integer' name='[Last X Days (copy)_3882384399977398274]' param-domain-type='range' role='measure' type='quantitative' value='6'>
              <calculation class='tableau' formula='6' />
              <range max='12' min='1' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Last X Days' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <range max='30' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0we3agp0qucbs01ea7y4m1p02fsa'>
            <column caption='time_of_day' datatype='string' name='[Calculation_211739597235019780]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF hour_ IN (7,8,9,10) THEN &apos;Breakfast&apos;&#10;ELSEIF [hour_] IN (11,12,13) THEN &apos;Lunch&apos;&#10;ELSEIF [hour_] IN (14,15,16) THEN &apos;Teabreak&apos;&#10;ELSEIF [hour_] IN (17,18,19) THEN &apos;Dinner&apos;&#10;ELSEIF [hour_] IN (20,21,22,23) THEN &apos;Supper&apos;&#10;ELSE &apos;Wee hours&apos;&#10;END' />
            </column>
            <column caption='Date Switchable' datatype='date' name='[Calculation_211739597395132427]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(&#10;&#10;CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN [date_]&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;iso-week&apos;, [date_])&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [date_])&#10;&#10;END&#10;)' />
            </column>
            <column caption='Date Switchable String' datatype='string' name='[Calculation_211739597395197964]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN RIGHT(DATENAME(&apos;year&apos;, [Calculation_211739597395132427]), 2) + &apos;/&apos; + STR(DATEPART(&apos;month&apos;, [Calculation_211739597395132427])) + &apos;/&apos; + STR(DATEPART(&apos;day&apos;, [Calculation_211739597395132427]))&#10;WHEN &apos;Weekly&apos; THEN RIGHT(DATENAME(&apos;year&apos;, [Calculation_211739597395132427]), 2) + &apos;/&apos; + STR(DATEPART(&apos;month&apos;, [Calculation_211739597395132427])) + &apos;/&apos; + STR(DATEPART(&apos;day&apos;, [Calculation_211739597395132427]))&#10;WHEN &apos;Monthly&apos; THEN RIGHT(DATENAME(&apos;year&apos;, [Calculation_211739597395132427]), 2) + &apos;/&apos; + STR(DATEPART(&apos;month&apos;, [Calculation_211739597395132427])) + &apos;/&apos; + STR(DATEPART(&apos;day&apos;, [Calculation_211739597395132427]))&#10;END' />
            </column>
            <column caption='Is Within Last X Days?' datatype='boolean' name='[Calculation_3882384399979712516]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_] &gt;= ({MAX([date_])} - [Parameters].[Parameter 2]) AND [date_] &lt;= {MAX([date_])} THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Is Within Last X Weeks?' datatype='boolean' name='[Calculation_3882384399979798533]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;, [date_]) &gt;= ({MAX(DATETRUNC(&apos;iso-week&apos;, [date_]))} - [Parameters].[Last X Days (copy)_3882384399977398274] * 7) AND DATETRUNC(&apos;iso-week&apos;, [date_]) &lt;= {MAX(DATETRUNC(&apos;iso-week&apos;, [date_]))} THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='WTD?' datatype='boolean' name='[Calculation_3882384399983296518]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,{MAX([date_])})' />
            </column>
            <column caption='MTD?' datatype='boolean' name='[Calculation_3882384399983415303]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date_]) &lt;= {MAX([date_])} AND day([date_]) &lt;= day({MAX([date_])})' />
            </column>
            <column caption='D/W/M To Date?' datatype='boolean' name='[Calculation_3882384399983542280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN [Calculation_3882384399983296518]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_3882384399983296518]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_3882384399983415303]&#10;&#10;END' />
