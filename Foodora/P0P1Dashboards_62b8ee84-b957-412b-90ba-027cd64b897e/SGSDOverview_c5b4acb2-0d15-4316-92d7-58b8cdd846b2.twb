      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_F7A09BD9B323471AAB54339576C31807'>
            <properties context=''>
              <relation connection='bigquery.1mxhxho0qvzb561h96msh0z00wp3' name='Custom SQL Query' type='text'><![CDATA[WITH all_zones AS (

  SELECT

    zones.name AS zone_name,
    zones.id AS lg_zone_id,
    zones.shape AS shape

  FROM `fulfillment-dwh-production.curated_data_shared.countries` c,
  UNNEST(c.cities) city,
  UNNEST(city.zones) zones

  WHERE LOWER(country_code) = 'sg'
    AND zones.is_active = TRUE
    AND LOWER(zones.name) NOT LIKE '%dmart%'
    AND zones.has_default_delivery_area_settings = TRUE

),

surge_intermediate AS (

  SELECT

    lg.zone_id,
    a.zone_name,

    IFNULL(surge_event, 'no_surge') surge_event,
    EXTRACT(HOUR FROM DATE_ADD(created_at_bucket, INTERVAL 8 HOUR)) hour_,
    EXTRACT(MINUTE FROM DATE_ADD(created_at_bucket, INTERVAL 8 HOUR)) minute_,
    EXTRACT(DATE FROM DATE_ADD(created_at_bucket, INTERVAL 8 HOUR)) date_,

  FROM `fulfillment-dwh-production.curated_data_shared.zone_stats` lg, UNNEST(lg.stats) stats
  
  LEFT JOIN all_zones a
    ON lg.zone_id = a.lg_zone_id

  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_zonal_surge_logs` surge
    ON a.zone_name = surge.zone_name
    AND EXTRACT(DATE FROM DATE_ADD(created_at_bucket, INTERVAL 8 HOUR)) BETWEEN surge.active_from AND surge.active_to
    AND CASE WHEN ROUND(stats.mean_delay, 2) << 0 THEN 0 ELSE ROUND(stats.mean_delay, 2) END BETWEEN delay_start AND delay_end

  WHERE lg.created_date >>= DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)
    AND DATE(DATE_ADD(created_at_bucket, INTERVAL 8 HOUR)) BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH) AND (CURRENT_DATE() - 1)
    AND LOWER(lg.country_code) = "sg"
    AND a.zone_name IS NOT NULL
    
  QUALIFY ROW_NUMBER() OVER(PARTITION BY zone_name, hour_, minute_, date_ ORDER BY created_at_bucket DESC) = 1

),

sessions_intermediate AS (

  SELECT

    das_zone AS zone_name,
    IFNULL(surge_event, 'no_surge') AS surge_event, -- Can alternatively backpopulated taking latest point
    session_start_date_local AS date_,
    p.hour_,
    ga_session_id AS session_id,
    
    CASE  
      WHEN order_id IS NOT NULL AND pd.code IS NOT NULL THEN TRUE
      ELSE FALSE
    END AS has_transaction,

  FROM `fulfillment-dwh-production.pandata_report.country_SG_restaurant_perseus_sessions_pandora` p

  JOIN `fulfillment-dwh-production.curated_data_shared_coredata_tracking.perseus_sessions_pandora` main
    ON p.ga_session_id = main.session_id
    AND main.global_entity_id = 'FP_SG'
    AND main.partition_date >>= DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)
  
  JOIN `fulfillment-dwh-production.pandata_report.country_SG_platform_perseus_funnel` funnel
    ON p.ga_session_id = funnel.coredata_tracking_session_id
    AND (has_delivery_shop_list OR has_delivery_shop_details OR has_delivery_checkout OR has_delivery_transaction)
  
  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` pd
    ON p.order_id = pd.code
    AND pd.expedition_type = 'delivery'
    AND pd.business_type_apac IN ('restaurants', 'street_food', 'caterers')

  LEFT JOIN surge_intermediate
    ON surge_intermediate.zone_name = p.das_zone
    AND surge_intermediate.date_ = p.session_start_date_local
    AND surge_intermediate.hour_ = p.hour_
    AND surge_intermediate.minute_ = EXTRACT(MINUTE FROM p.session_start_at_local)

  WHERE session_start_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH) AND (CURRENT_DATE() - 1)
    AND is_valid_user_session = TRUE

  QUALIFY ROW_NUMBER() OVER(PARTITION BY session_id) = 1

)

SELECT

  zone_name,
  date_,
  hour_,
  surge_event,

  COUNT(DISTINCT session_id) AS total_sessions,
  COUNT(DISTINCT CASE WHEN has_transaction = TRUE THEN session_id END) AS total_sessions_w_transactions

FROM sessions_intermediate

WHERE zone_name IS NOT NULL

GROUP BY 1,2,3,4]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='[SG] Surgeable Orders' inline='true' name='federated.0we3agp0qucbs01ea7y4m1p02fsa' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1wb0dkn1xr04ji1bt6j3h1q41n9u'>
            <connection CATALOG='foodpanda-sg-bigquery' EXECCATALOG='foodpanda-sg-bigquery' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='APAC Country - SG' schema='pricing_sg' server-oauth='' username='cheryl.yeo@foodpanda.sg' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1wb0dkn1xr04ji1bt6j3h1q41n9u' name='Custom SQL Query' type='text'>WITH orders AS (

  SELECT

    pd.ordered_at_date_local AS date_,
    zones.name AS zone_name,
    EXTRACT(HOUR FROM pd.ordered_at_local) AS hour_,
    pd.code,

    CASE
      WHEN verticals.global_code IN (&apos;restaurants&apos;, &apos;street_food&apos;, &apos;caterers&apos;) THEN &apos;Restaurants&apos;
      WHEN verticals.global_code IN (&apos;darkstores&apos;) THEN &apos;Dmart&apos;
      ELSE &apos;Shops&apos;
    END AS vertical,

    CASE
      WHEN pd.delivery_fee_local = 0 THEN &apos;free_delivery&apos;
      WHEN cdbo.is_meal_for_one = TRUE THEN &apos;meal_for_one&apos;
      WHEN is_df_campaign_order = TRUE THEN &quot;$1.99&quot;
      ELSE &apos;NA&apos;
    END AS immune_to_surge_type,

    IFNULL(COALESCE(dps_surge_fee_local, dps_standard_surge_fee_local), 0) AS surge_fee,

  FROM `fulfillment-dwh-production.pandata_report.country_SG_pd_orders` pd

  JOIN (`fulfillment-dwh-production.pandata_curated.vdr_svc_vendors` vdr
  JOIN UNNEST(verticals) verticals)
    ON pd.vendor_code = vdr.vendor_code
    AND vdr.global_entity_id = &apos;FP_SG&apos;
    AND verticals.is_main = TRUE

  LEFT JOIN `fulfillment-dwh-production.pandata_report.country_SG_additional_vf_df_revenue` df
    ON pd.code = df.code

  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata_business.orders` cdbo
    ON pd.code = cdbo.order_id
    AND cdbo.global_entity_id = &apos;FP_SG&apos;
    AND cdbo.partition_date_local &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)
  
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.orders` cdso
    ON cdso.platform_order_code = pd.code
    AND cdso.country_code = &apos;sg&apos;
    AND cdso.created_date &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)

  LEFT JOIN (`fulfillment-dwh-production.curated_data_shared.countries` c
  JOIN UNNEST(c.cities) city
  JOIN UNNEST(city.zones) zones)
    ON cdso.zone_id = zones.id
    AND LOWER(c.country_code) = &apos;sg&apos;
    AND zones.is_active = TRUE
    AND LOWER(zones.name) NOT LIKE &apos;%dmart%&apos;
    AND zones.has_default_delivery_area_settings = TRUE

  LEFT JOIN `fulfillment-dwh-production.curated_data_shared.dps_sessions_mapped_to_orders` dps
    ON pd.code = dps.platform_order_code
    AND dps.country_code = &apos;sg&apos;
    AND dps.created_date &gt;&gt;= DATE_SUB(CURRENT_DATE(), INTERVAL 3 MONTH)

  WHERE pd.ordered_at_date_local BETWEEN DATE_SUB(CURRENT_DATE(), INTERVAL 2 MONTH) AND (CURRENT_DATE() - 1)
    AND is_valid_order = TRUE
    AND is_test_order = FALSE
    AND expedition_type = &apos;delivery&apos;
    AND pd.is_own_delivery = TRUE

  QUALIFY ROW_NUMBER() OVER(PARTITION BY code) = 1

)

SELECT

  zone_name,
  date_,
  hour_,
  vertical,
  immune_to_surge_type,

  COUNT(DISTINCT code) AS orders,
  COUNT(DISTINCT CASE WHEN immune_to_surge_type != &apos;NA&apos; THEN code END) AS immune_to_surge_orders,
  COUNT(DISTINCT CASE WHEN surge_fee &gt;&gt; 0 THEN code END) AS surge_subjected_orders,
  COUNT(DISTINCT CASE WHEN immune_to_surge_type = &apos;NA&apos; AND surge_fee &gt;&gt; 0 THEN code END) AS surge_paid_orders,

FROM orders

GROUP BY 1,2,3,4,5</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
