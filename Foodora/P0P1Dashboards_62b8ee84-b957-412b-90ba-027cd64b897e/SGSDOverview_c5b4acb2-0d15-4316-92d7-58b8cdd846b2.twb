    <worksheet name='CVR by Surge 1 (Table)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#f52a85' fontname='Tableau Regular'>CVR AT </run>
            <run bold='true' fontcolor='#f52a85' fontname='Tableau Regular' underline='true'>SURGE 1</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='[SG] Conversion by Surge Events' name='federated.0wduqjh11d3dd515yesz71gvgl3c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Last X Weeks' datatype='integer' name='[Last X Days (copy)_3882384399977398274]' param-domain-type='range' role='measure' type='quantitative' value='6'>
              <calculation class='tableau' formula='6' />
              <range max='12' min='1' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Last X Days' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <range max='30' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0wduqjh11d3dd515yesz71gvgl3c'>
            <column caption='CVR' datatype='real' name='[Calculation_211739597243854855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_sessions_w_transactions]) / SUM([total_sessions])' />
            </column>
            <column caption='time_of_day' datatype='string' name='[Calculation_211739597243949064]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF hour_ IN (7,8,9,10) THEN &apos;Breakfast&apos;&#10;ELSEIF [hour_] IN (11,12,13) THEN &apos;Lunch&apos;&#10;ELSEIF [hour_] IN (14,15,16) THEN &apos;Teabreak&apos;&#10;ELSEIF [hour_] IN (17,18,19) THEN &apos;Dinner&apos;&#10;ELSEIF [hour_] IN (20,21,22,23) THEN &apos;Supper&apos;&#10;ELSE &apos;Wee hours&apos;&#10;END' />
            </column>
            <column caption='Date Switchable' datatype='date' name='[Calculation_211739597394784265]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(&#10;&#10;CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN [date_]&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;iso-week&apos;, [date_])&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [date_])&#10;&#10;END&#10;)' />
            </column>
            <column caption='Date Switchable String' datatype='string' name='[Calculation_211739597394935818]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN RIGHT(DATENAME(&apos;year&apos;, [Calculation_211739597394784265]), 2) + &apos;/&apos; + STR(DATEPART(&apos;month&apos;, [Calculation_211739597394784265])) + &apos;/&apos; + STR(DATEPART(&apos;day&apos;, [Calculation_211739597394784265]))&#10;WHEN &apos;Weekly&apos; THEN RIGHT(DATENAME(&apos;year&apos;, [Calculation_211739597394784265]), 2) + &apos;/&apos; + STR(DATEPART(&apos;month&apos;, [Calculation_211739597394784265])) + &apos;/&apos; + STR(DATEPART(&apos;day&apos;, [Calculation_211739597394784265]))&#10;WHEN &apos;Monthly&apos; THEN RIGHT(DATENAME(&apos;year&apos;, [Calculation_211739597394784265]), 2) + &apos;/&apos; + STR(DATEPART(&apos;month&apos;, [Calculation_211739597394784265])) + &apos;/&apos; + STR(DATEPART(&apos;day&apos;, [Calculation_211739597394784265]))&#10;END' />
            </column>
            <column caption='Is Within Last X Days?' datatype='boolean' name='[Calculation_3882384399975395329]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_] &gt;= ({MAX([date_])} - [Parameters].[Parameter 2]) AND [date_] &lt;= {MAX([date_])} THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='WTD?' datatype='boolean' name='[Calculation_3882384399984341001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,{MAX([date_])})' />
            </column>
            <column caption='MTD?' datatype='boolean' name='[Calculation_3882384399984447498]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date_]) &lt;= {MAX([date_])} AND day([date_]) &lt;= day({MAX([date_])})' />
            </column>
            <column caption='D/W/M To Date?' datatype='boolean' name='[Calculation_3882384399984521227]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN [Calculation_3882384399984341001]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_3882384399984341001]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_3882384399984447498]&#10;&#10;END' />
            </column>
            <column caption='Is Within Last X Weeks?' datatype='boolean' name='[Is Within Last X Days? (copy)_3882384399977525251]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;, [date_]) &gt;= ({MAX(DATETRUNC(&apos;iso-week&apos;, [date_]))} - [Parameters].[Last X Days (copy)_3882384399977398274] * 7) AND DATETRUNC(&apos;iso-week&apos;, [date_]) &lt;= {MAX(DATETRUNC(&apos;iso-week&apos;, [date_]))} THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column datatype='date' name='[date_]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_211739597243854855]' derivation='User' name='[diff:usr:Calculation_211739597243854855:qk]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='Difference'>
                <address>
