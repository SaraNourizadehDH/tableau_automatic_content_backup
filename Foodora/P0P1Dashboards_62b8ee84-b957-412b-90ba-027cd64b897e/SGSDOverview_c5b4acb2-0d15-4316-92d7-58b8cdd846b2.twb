            <column-instance column='[Is Within Last X Days? (copy)_3882384399977525251]' derivation='None' name='[none:Is Within Last X Days? (copy)_3882384399977525251:nk]' pivot='key' type='nominal' />
            <column-instance column='[hour_]' derivation='None' name='[none:hour_:ok]' pivot='key' type='ordinal' />
