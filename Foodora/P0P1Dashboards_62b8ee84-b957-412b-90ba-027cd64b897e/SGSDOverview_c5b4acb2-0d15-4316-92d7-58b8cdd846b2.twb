      <aliases enabled='yes' />
      <column caption='% Time Spent in Surge' datatype='real' name='[% Time Spent in Shrink (copy)_211739597068230659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([total_time_in_surge], 0)) / SUM([total_time])' />
      </column>
      <column caption='time_of_day' datatype='string' name='[Calculation_211739597065347072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF hour_ IN (7,8,9,10) THEN &apos;Breakfast&apos;&#10;ELSEIF [hour_] IN (11,12,13) THEN &apos;Lunch&apos;&#10;ELSEIF [hour_] IN (14,15,16) THEN &apos;Teabreak&apos;&#10;ELSEIF [hour_] IN (17,18,19) THEN &apos;Dinner&apos;&#10;ELSEIF [hour_] IN (20,21,22,23) THEN &apos;Supper&apos;&#10;ELSE &apos;Wee hours&apos;&#10;END' />
      </column>
      <column caption='% Order Loss in Shrink + Close' datatype='real' name='[Calculation_211739597065662465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([total_orders_in_shrink], 0) + IFNULL([total_orders_in_close], 0)) / SUM([forecasted_orders])' />
      </column>
      <column caption='% Time Spent in Shrink' datatype='real' name='[Calculation_211739597067177986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([total_time_in_close], 0) + IFNULL([total_time_in_shrink], 0)) / SUM([total_time])' />
      </column>
      <column caption='Date Switchable' datatype='date' name='[Calculation_211739597395271693]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(&#10;&#10;CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN [date_]&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;iso-week&apos;, [date_])&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [date_])&#10;&#10;END&#10;)' />
      </column>
      <column caption='Date Switchable String' datatype='string' name='[Calculation_211739597395353614]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN RIGHT(DATENAME(&apos;year&apos;, [Calculation_211739597395271693]), 2) + &apos;/&apos; + STR(DATEPART(&apos;month&apos;, [Calculation_211739597395271693])) + &apos;/&apos; + STR(DATEPART(&apos;day&apos;, [Calculation_211739597395271693]))&#10;WHEN &apos;Weekly&apos; THEN RIGHT(DATENAME(&apos;year&apos;, [Calculation_211739597395271693]), 2) + &apos;/&apos; + STR(DATEPART(&apos;month&apos;, [Calculation_211739597395271693])) + &apos;/&apos; + STR(DATEPART(&apos;day&apos;, [Calculation_211739597395271693]))&#10;WHEN &apos;Monthly&apos; THEN RIGHT(DATENAME(&apos;year&apos;, [Calculation_211739597395271693]), 2) + &apos;/&apos; + STR(DATEPART(&apos;month&apos;, [Calculation_211739597395271693])) + &apos;/&apos; + STR(DATEPART(&apos;day&apos;, [Calculation_211739597395271693]))&#10;END' />
      </column>
      <column caption='Is Within Last X Days?' datatype='boolean' name='[Calculation_3882384399992995856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [date_] &gt;= ({MAX([date_])} - [Parameters].[Parameter 2]) AND [date_] &lt;= {MAX([date_])} THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Is Within Last X Weeks?' datatype='boolean' name='[Calculation_3882384399993098257]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;, [date_]) &gt;= ({MAX(DATETRUNC(&apos;iso-week&apos;, [date_]))} - [Parameters].[Last X Days (copy)_3882384399977398274] * 7) AND DATETRUNC(&apos;iso-week&apos;, [date_]) &lt;= {MAX(DATETRUNC(&apos;iso-week&apos;, [date_]))} THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='WTD?' datatype='boolean' name='[Calculation_3882384399993192466]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,{MAX([date_])})' />
      </column>
      <column caption='MTD?' datatype='boolean' name='[Calculation_3882384399993262099]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date_]) &lt;= {MAX([date_])} AND day([date_]) &lt;= day({MAX([date_])})' />
      </column>
      <column caption='D/W/M To Date?' datatype='boolean' name='[Calculation_3882384399993344020]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN [Calculation_3882384399993192466]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_3882384399993192466]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_3882384399993262099]&#10;&#10;END' />
      </column>
      <column caption='Order Loss in Shrink - WTD' datatype='real' name='[Calculation_3882384400011845669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='({INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [total_orders_in_shrink]&#10;END&#10;)} + {INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [total_orders_in_close]&#10;END&#10;)}) / &#10;{INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=0&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [forecasted_orders]&#10;END&#10;)}' />
      </column>
      <column caption='Order Loss in Shrink - PWTD' datatype='real' name='[Calculation_3882384400012111910]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='({INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=1&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [total_orders_in_close]&#10;END&#10;)} + {INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=1&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [total_orders_in_shrink]&#10;END&#10;)}) / {INCLUDE : SUM(if datediff(&apos;iso-week&apos;, datetrunc(&apos;iso-week&apos;,[date_]),{MAX(DATETRUNC(&apos;iso-week&apos;,[date_]))})=1&#10;AND DATEPART(&apos;iso-weekday&apos;,[date_]) &lt;= DATEPART(&apos;iso-weekday&apos;,[date_])&#10;THEN [forecasted_orders]&#10;END&#10;)}' />
      </column>
      <column caption='Order Loss in Shrink - PMTD' datatype='real' name='[Calculation_3882384400012279847]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='({INCLUDE : SUM(IF DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([date_])})) &lt;= [date_]&#10;AND DATEADD(&apos;month&apos;,-1,{MAX([date_])}) &gt;= [date_]&#10;THEN [total_orders_in_close]&#10;END&#10;)} + {INCLUDE : SUM(IF DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([date_])})) &lt;= [date_]&#10;AND DATEADD(&apos;month&apos;,-1,{MAX([date_])}) &gt;= [date_]&#10;THEN [total_orders_in_shrink]&#10;END&#10;)}) / &#10;{INCLUDE : SUM(IF DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([date_])})) &lt;= [date_]&#10;AND DATEADD(&apos;month&apos;,-1,{MAX([date_])}) &gt;= [date_]&#10;THEN [forecasted_orders]&#10;END&#10;)}' />
      </column>
      <column caption='Order Loss in Shrink - MTD' datatype='real' name='[Calculation_3882384400012447784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='({INCLUDE : SUM(IF DATETRUNC(&apos;month&apos;,{MAX([date_])}) &lt;= [date_]&#10;THEN [total_orders_in_close]&#10;END&#10;)} + {INCLUDE : SUM(IF DATETRUNC(&apos;month&apos;,{MAX([date_])}) &lt;= [date_]&#10;THEN [total_orders_in_shrink]&#10;END&#10;)}) / &#10;{INCLUDE : SUM(IF DATETRUNC(&apos;month&apos;,{MAX([date_])}) &lt;= [date_]&#10;THEN [forecasted_orders]&#10;END&#10;)}' />
      </column>
      <column caption='WoW Change % Order Loss in Shrink' datatype='real' name='[Calculation_3882384400014585906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3882384400011845669] - [Calculation_3882384400012111910]' />
      </column>
      <column caption='WoW / MoM Change % Order Loss in Shrink' datatype='real' name='[Calculation_3882384400016179256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Daily&apos; THEN [Calculation_3882384400014585906]&#10;WHEN &apos;Weekly&apos; THEN [Calculation_3882384400014585906]&#10;WHEN &apos;Monthly&apos; THEN [WoW Change % Order Loss in Shrink (copy)_3882384400015700019]&#10;&#10;END' />
      </column>
      <column caption='Is Within Last 1 Week?' datatype='boolean' name='[Calculation_3882384400021487675]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;iso-week&apos;, [date_]) &gt;= ({MAX(DATETRUNC(&apos;iso-week&apos;, [date_]))} - 7) AND DATETRUNC(&apos;iso-week&apos;, [date_]) &lt;= {MAX(DATETRUNC(&apos;iso-week&apos;, [date_]))} THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='MoM Change % Time Spent in Shrink' datatype='real' name='[MoM Change % Order Loss in Shrink (copy)_3882384400015867957]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Order Loss in Shrink - MTD (copy)_3882384400012591145] - [Order Loss in Shrink - PMTD (copy)_3882384400012763178]' />
      </column>
      <column caption='MoM Change % Time Spent in Surge' datatype='real' name='[MoM Change % Time Spent in Shrink (copy)_3882384400016056375]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Time Spent in Shrink - MTD (copy)_3882384400013103150] - [Time Spent in Shrink - PMTD (copy)_3882384400013205551]' />
      </column>
      <column caption='Time Spent in Shrink - MTD' datatype='real' name='[Order Loss in Shrink - MTD (copy)_3882384400012591145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='({INCLUDE : SUM(IF DATETRUNC(&apos;month&apos;,{MAX([date_])}) &lt;= [date_]&#10;THEN [total_time_in_close]&#10;END&#10;)} + {INCLUDE : SUM(IF DATETRUNC(&apos;month&apos;,{MAX([date_])}) &lt;= [date_]&#10;THEN [total_time_in_shrink]&#10;END&#10;)}) / &#10;{INCLUDE : SUM(IF DATETRUNC(&apos;month&apos;,{MAX([date_])}) &lt;= [date_]&#10;THEN [total_time]&#10;END&#10;)}' />
      </column>
      <column caption='Time Spent in Shrink - PMTD' datatype='real' name='[Order Loss in Shrink - PMTD (copy)_3882384400012763178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='({INCLUDE : SUM(IF DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([date_])})) &lt;= [date_]&#10;AND DATEADD(&apos;month&apos;,-1,{MAX([date_])}) &gt;= [date_]&#10;THEN [total_time_in_close]&#10;END&#10;)} + {INCLUDE : SUM(IF DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([date_])})) &lt;= [date_]&#10;AND DATEADD(&apos;month&apos;,-1,{MAX([date_])}) &gt;= [date_]&#10;THEN [total_time_in_shrink]&#10;END&#10;)}) / &#10;{INCLUDE : SUM(IF DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,{MAX([date_])})) &lt;= [date_]&#10;AND DATEADD(&apos;month&apos;,-1,{MAX([date_])}) &gt;= [date_]&#10;THEN [total_time]&#10;END&#10;)}' />
