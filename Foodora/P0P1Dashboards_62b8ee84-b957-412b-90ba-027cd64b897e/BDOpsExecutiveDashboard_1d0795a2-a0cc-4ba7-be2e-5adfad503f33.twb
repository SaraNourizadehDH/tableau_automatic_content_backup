      THEN &apos;kitchen&apos;&#13;
      WHEN pd_vendors_agg_business_types.business_type_apac = &apos;concepts&apos;&#13;
      THEN &apos;concepts&apos;&#13;
      WHEN pd_vendors_agg_business_types.business_type_apac = &apos;dmart&apos;&#13;
      THEN &apos;pandamart&apos;&#13;
      WHEN pd_vendors_agg_business_types.business_type_apac = &apos;shops&apos;&#13;
