    <worksheet name='Hurrier Distance - Logistics KPIs'>
      <table>
        <view>
          <datasources>
            <datasource caption='Hurrier Distance - Logistics KPIs' name='federated.0cpy0ns1c0re6y1dzxt7m0tqvivz' />
          </datasources>
          <datasource-dependencies datasource='federated.0cpy0ns1c0re6y1dzxt7m0tqvivz'>
            <column caption='P-D Distance ' datatype='real' name='[Calculation_1378945916062625796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_distance_in_meters]/1000)/SUM([completed_orders])' />
            </column>
            <column caption='Seamless %' datatype='real' name='[Calculation_1378945916372975621]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-SUM([seamless_total_orders_with_issues])/SUM([seamless_total_gross_orders])' />
            </column>
            <column caption='Weekday' datatype='string' name='[Calculation_1847038859820703749]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&quot;weekday&quot;,[order_date])' />
            </column>
            <column caption='Delivery Time' datatype='real' name='[Calculation_362258355360493568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DT])/SUM([completed_orders])' />
            </column>
            <column caption='Acceptance Rate %' datatype='real' name='[Calculation_362258355360559105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acceptances])/SUM([notifications])' />
            </column>
            <column caption='DT &gt; 45 min %' datatype='real' name='[Calculation_362258355360690178]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_greater_than_45_orders])/SUM([completed_orders])' />
            </column>
            <column caption='DT &lt; 25 min %' datatype='real' name='[Calculation_362258355360768003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_less_than_25_orders])/SUM([completed_orders])' />
            </column>
            <column caption='Fail Rate %' datatype='real' name='[Calculation_362258355361001477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([gross_orders])' />
            </column>
            <column caption='Order Early &lt; 15 min %' datatype='real' name='[Calculation_362258355361329159]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_early_less_than_15_orders])/SUM([completed_orders])' />
            </column>
            <column caption='Order On Time %' datatype='real' name='[Calculation_362258355361402888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_on_time_orders])/SUM([completed_orders])' />
            </column>
            <column caption='Order Late &gt; 5 min %' datatype='real' name='[Calculation_362258355361509385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_greater_than_5_orders])/SUM([completed_orders])' />
            </column>
            <column caption='Stacking %' datatype='real' name='[Calculation_362258355361603594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_orders])/SUM([completed_orders])' />
            </column>
            <column caption='Vendor Late &gt; 5 min %' datatype='real' name='[Calculation_362258355361677323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_greater_than_5_orders])/SUM([completed_orders])' />
            </column>
            <column caption='Rider Late &gt; 5 min %' datatype='real' name='[Calculation_362258355361738764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_greater_than_5_orders])/SUM([completed_orders])' />
            </column>
            <column caption='Completed Orders %' datatype='integer' name='[Completed Orders (copy)_1378945916057374723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[completed_orders]' />
            </column>
            <column datatype='real' name='[DT]' role='measure' type='quantitative' />
            <column caption='Select Dates' datatype='date' name='[Order Date (copy)_362258355365011469]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[order_date]' />
            </column>
            <column caption='Rider early &lt; 15 min %' datatype='real' name='[Rider Late &gt; 5 min % (copy)_257831125511221251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_early_less_than_15_orders])/SUM([completed_orders])' />
            </column>
            <column caption='Vendor Early &lt; 15 min % ' datatype='real' name='[Vendor Late &gt; 5 min % (copy)_257831125511774212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_early_less_than_15_orders])/SUM([completed_orders])' />
