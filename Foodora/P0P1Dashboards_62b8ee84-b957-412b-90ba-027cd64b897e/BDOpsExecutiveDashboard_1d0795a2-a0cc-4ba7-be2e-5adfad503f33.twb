      <aliases enabled='yes' />
      <column caption='DT_calc' datatype='real' name='[Calculation_1018939427247067136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([DT])/SUM([completed_orders])' />
      </column>
      <column caption='Stacking %' datatype='real' name='[Calculation_1373316456562745348]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stacked_orders])/SUM([completed_orders])' />
      </column>
      <column caption='Acceptance Rate %' datatype='real' name='[Calculation_1373316456562851845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acceptances])/SUM([notifications])' />
      </column>
      <column caption='DT &gt; 45 min %' datatype='real' name='[Calculation_1373316456562999302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dt_greater_than_45_orders])/SUM([completed_orders])' />
      </column>
      <column caption='DT &lt; 25 min %' datatype='real' name='[Calculation_1373316456563101703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dt_less_than_25_orders])/SUM([completed_orders])' />
      </column>
      <column caption='Fail Rate %' datatype='real' name='[Calculation_1373316456563208200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fr_failed_orders])/SUM([fr_gross_orders])' />
      </column>
      <column caption='Customer Fail Rate %' datatype='real' name='[Calculation_1373316456563593225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fr_customer_fail_orders])/SUM([fr_gross_orders])' />
      </column>
      <column caption='Rider Fail Rate %' datatype='real' name='[Calculation_1373316456563691530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fr_rider_fail_orders])/SUM([fr_gross_orders])' />
      </column>
      <column caption='Vendor Fail Rate %' datatype='real' name='[Calculation_1373316456563810315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fr_vendor_fail_orders])/SUM([fr_gross_orders])' />
      </column>
      <column caption='Order Early &lt; 15 min %' datatype='real' name='[Calculation_1373316456564170764]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_early_less_than_15_orders])/SUM([completed_orders])' />
      </column>
      <column caption='Order On Time %' datatype='real' name='[Calculation_1373316456564269069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_on_time_orders])/SUM([completed_orders])' />
      </column>
      <column caption='Order Late &gt; 5 min %' datatype='real' name='[Calculation_1373316456564355086]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_late_greater_than_5_orders])/SUM([completed_orders])' />
      </column>
      <column caption='Vendor Late &gt; 5 min %' datatype='real' name='[Calculation_1373316456564822031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_late_greater_than_5_orders])/SUM([completed_orders])' />
      </column>
      <column caption='Rider Late &gt; 5 min %' datatype='real' name='[Calculation_1373316456564957200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_late_greater_than_5_orders])/SUM([completed_orders])' />
      </column>
      <column caption='Display Measures' datatype='real' name='[Calculation_1373316456566714385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Completed Orders&quot; THEN SUM([completed_orders])&#13;&#10;WHEN &quot;Failed Orders&quot; THEN SUM([failed_orders])&#13;&#10;WHEN &quot;DT&quot; THEN AVG(DT)&#13;&#10;WHEN &quot;Promised DT&quot; THEN AVG([Promised_DT])&#13;&#10;WHEN &quot;Stacking %&quot; THEN [Calculation_1373316456562745348]&#13;&#10;WHEN &quot;Order Early &lt; 15 min %&quot; THEN [Calculation_1373316456564170764]&#13;&#10;WHEN &quot;Order On Time %&quot; THEN [Calculation_1373316456564269069]&#13;&#10;WHEN &quot;Order Late &gt; 5 min %&quot; THEN [Calculation_1373316456564355086]&#13;&#10;WHEN &quot;Rider Late &gt; 5 min %&quot; THEN [Calculation_1373316456564957200]&#13;&#10;WHEN &quot;Vendor Late &gt; 5 min %&quot; THEN [Calculation_1373316456564822031]&#13;&#10;WHEN &quot;Fail Rate %&quot; THEN [Calculation_1373316456563208200]&#13;&#10;WHEN &quot;Customer Fail Rate %&quot; THEN [Calculation_1373316456563593225]&#13;&#10;WHEN &quot;Rider Fail Rate %&quot; THEN [Calculation_1373316456563691530]&#13;&#10;WHEN &quot;Vendor Fail Rate %&quot; THEN [Calculation_1373316456563810315]&#13;&#10;END' />
      </column>
      <column caption='Seamless %' datatype='real' name='[Calculation_612208120284446728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1 - SUM([seamless_order_with_issue])/SUM([seamless_gross_orders]))' />
      </column>
