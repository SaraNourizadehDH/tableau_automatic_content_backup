    <worksheet name='Daily - IT/FR/BH'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Orders By Date</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='7 - Logistics View Dashboard KPIs' name='federated.1j4n33f0i2es2u1460keq132hcri' />
          </datasources>
          <datasource-dependencies datasource='federated.1j4n33f0i2es2u1460keq132hcri'>
            <column caption='Weekday' datatype='string' name='[Calculation_1847038859818917890]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&quot;weekday&quot;,[order_date])' />
            </column>
            <column caption='Fill Rate %' datatype='real' name='[Calculation_814025643459366913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([assigned_shifts_hours])/(SUM([assigned_shifts_hours]) + SUM([unassigned_shifts_hours]))' />
            </column>
            <column caption='Break Hours %' datatype='real' name='[Calculation_814025643459653634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_hours_rider_was_on_break])/(SUM([total_hours_rider_was_in_shift]) + SUM([total_hours_rider_was_on_break]))' />
            </column>
            <column caption='Idle Time %' datatype='real' name='[Calculation_814025643459944451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([transition_working_hours]) - SUM([transition_busy_hours]))/SUM([transition_working_hours])' />
            </column>
            <column caption='No Show %' datatype='real' name='[Calculation_936185801979605003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([no_show_shifts_hours]) + SUM([no_show_excused_shifts_hours]))/SUM([scheduled_hours])' />
            </column>
            <column caption='Acceptance Rate %' datatype='real' name='[Calculation_936185801979981836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acceptances])/SUM([notifications])' />
            </column>
            <column caption='Select Date' datatype='date' name='[Order Date (copy)_1001769506183086092]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[order_date]' />
            </column>
            <column datatype='integer' name='[acceptances]' role='measure' type='quantitative' />
            <column datatype='real' name='[assigned_shifts_hours]' role='measure' type='quantitative' />
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='real' name='[no_show_excused_shifts_hours]' role='measure' type='quantitative' />
            <column datatype='real' name='[no_show_shifts_hours]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1847038859818917890]' derivation='None' name='[none:Calculation_1847038859818917890:nk]' pivot='key' type='nominal' />
