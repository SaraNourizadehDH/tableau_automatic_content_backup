    <worksheet name='Weekly - Total Riders By Zones'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Orders By Date</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='7 - Logistics View Dashboard KPIs' name='federated.1j4n33f0i2es2u1460keq132hcri' />
          </datasources>
          <datasource-dependencies datasource='federated.1j4n33f0i2es2u1460keq132hcri'>
            <column caption='Avg. Daily Riders By Zones' datatype='real' name='[Calculation_814025643479859209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_riders]/[fixed dates (copy)_1001769506151337988]' />
            </column>
            <column caption='0 - 2 Hours Riders %' datatype='real' name='[Calculation_814025643490877450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([zeros_to_2_hours_riders])/SUM([total_riders])' />
            </column>
            <column caption='2 - 4 Hours Riders %' datatype='real' name='[Calculation_814025643491061771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([two_to_4_hours_riders])/SUM([total_riders])' />
            </column>
            <column caption='4 - 6 Hours Riders %' datatype='real' name='[Calculation_814025643491389452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([four_to_six_hours_riders])/SUM([total_riders])' />
            </column>
            <column caption='6 - 8 Hours Riders %' datatype='real' name='[Calculation_814025643491536909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([six_to_eight_hours_riders])/SUM([total_riders])' />
            </column>
            <column caption='8 - 10 Hours Riders %' datatype='real' name='[Calculation_814025643491672078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([eight_to_ten_hours_riders])/SUM([total_riders])' />
            </column>
            <column caption='10 or more Hours Riders %' datatype='real' name='[Calculation_814025643491889167]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ten_onwards_hours_riders])/SUM([total_riders])' />
            </column>
            <column caption='Select Date' datatype='date' name='[Order Date (copy)_1001769506183086092]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[order_date]' />
            </column>
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='integer' name='[eight_to_ten_hours_riders]' role='measure' type='quantitative' />
            <column caption='fixed dates weekly' datatype='integer' name='[fixed dates (copy)_1001769506151337988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [order_week] : countd([order_date])}' />
            </column>
            <column datatype='integer' name='[four_to_six_hours_riders]' role='measure' type='quantitative' />
            <column-instance column='[order_date]' derivation='ISO-Week' name='[iwk:order_date:ok]' pivot='key' type='ordinal' />
