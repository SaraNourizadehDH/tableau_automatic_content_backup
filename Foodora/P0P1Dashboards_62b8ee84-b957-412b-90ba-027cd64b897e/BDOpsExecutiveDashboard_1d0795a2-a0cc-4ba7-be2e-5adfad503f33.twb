        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ch6alw1nrsttr1bz2lep0a8nnek' name='Custom SQL Query' type='text'>WITH dates AS (&#13;
    SELECT &#13;
        DATE_SUB(DATE(TIMESTAMP_TRUNC(CURRENT_TIMESTAMP(), MONTH)), INTERVAL 5 MONTH) date_start,&#13;
        DATE_SUB(DATE(TIMESTAMP_TRUNC(CURRENT_TIMESTAMP(), DAY)), INTERVAL 1 DAY) date_end,&#13;
),&#13;
&#13;
countries AS (&#13;
    SELECT&#13;
        countries.country_code AS country_code, &#13;
        countries.country_name AS country_name, &#13;
        cities.name AS city_name, &#13;
        zones.name AS zone_name,&#13;
        cities.id AS lg_city_id, &#13;
        zones.id AS lg_zone_id  &#13;
    FROM &#13;
        `fulfillment-dwh-production.curated_data_shared.countries` AS countries, UNNEST(cities) AS cities, UNNEST(zones) AS zones&#13;
    WHERE &#13;
         country_code = &apos;bd&apos;&#13;
),&#13;
&#13;
orders AS (&#13;
    SELECT&#13;
        DISTINCT &#13;
        orders.platform_order_code AS order_code,&#13;
        orders.vendor.vendor_code AS vendor_code,&#13;
        DATETIME(orders.order_placed_at, orders.timezone) AS order_placed_at_local,&#13;
        DATETIME(d.rider_dropped_off_at, d.timezone) AS rider_dropped_off_at_local,&#13;
        DATE(DATETIME(orders.created_at, orders.timezone)) AS created_date_local,&#13;
        orders.created_date AS created_date_utc,&#13;
        DATE(DATETIME(orders.created_at, orders.timezone)) AS created_at_local,&#13;
        orders.country_code AS lg_country_code,&#13;
        orders.city_id AS lg_city_id,&#13;
        orders.zone_id AS lg_zone_id,&#13;
        &#13;
        orders.order_status AS rider_order_status,&#13;
        d.delivery_status AS delivery_status,&#13;
        d.rider_id AS lg_rider_id,&#13;
&#13;
    FROM &#13;
        `fulfillment-dwh-production.curated_data_shared.orders` orders, &#13;
        UNNEST(deliveries) d &#13;
&#13;
    WHERE     &#13;
        DATE(orders.created_date) &gt;&gt;= (SELECT date_start FROM dates) - 3&#13;
        AND d.is_primary = TRUE&#13;
        AND orders.country_code = &apos;bd&apos;&#13;
),&#13;
&#13;
rider_count AS (&#13;
    SELECT&#13;
        FORMAT_DATE(&apos;%G&apos;, DATE(o.rider_dropped_off_at_local)) AS order_year,&#13;
        EXTRACT(MONTH FROM DATE(o.rider_dropped_off_at_local)) as order_month_number, &#13;
        FORMAT_DATE(&quot;%B&quot;, DATE(o.rider_dropped_off_at_local)) as order_month,&#13;
        FORMAT_DATE(&apos;%G-%V&apos;, DATE(o.rider_dropped_off_at_local)) AS order_week,&#13;
        DATE(o.rider_dropped_off_at_local) AS order_date, &#13;
        c.lg_city_id AS lg_city_id,&#13;
        c.city_name AS city_name,&#13;
        -- c.lg_zone_id AS lg_zone_id,&#13;
        -- c.zone_name AS zone_name,&#13;
        COUNT(DISTINCT o.lg_rider_id) AS total_riders,&#13;
    FROM orders o&#13;
    LEFT JOIN countries c &#13;
    ON&#13;
        c.country_code = o.lg_country_code&#13;
        AND c.lg_city_id = o.lg_city_id&#13;
        AND c.lg_zone_id = o.lg_zone_id&#13;
    WHERE &#13;
        o.lg_country_code = &apos;bd&apos;&#13;
        AND DATE(o.rider_dropped_off_at_local) BETWEEN (SELECT date_start FROM dates) AND (SELECT date_end FROM dates)&#13;
        AND o.delivery_status = &apos;completed&apos;&#13;
    GROUP BY 1,2,3,4,5,6,7&#13;
)&#13;
&#13;
SELECT  &#13;
    *, &quot;FP_PK&quot; AS global_entity_id&#13;
FROM rider_count</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
