    orders.order_status AS rider_order_status,&#13;
    d.delivery_status AS delivery_status,&#13;
    orders.cancellation.reason AS cancellation_reason,&#13;
    orders.cancellation.source AS cancellation_source,&#13;
    IF(orders.entity.id=&apos;ODR_PK&apos;,&apos;pandago&apos;,&apos;others&apos;) as pandago_flag&#13;
&#13;
  FROM &#13;
    `fulfillment-dwh-production.curated_data_shared.orders` orders, &#13;
    UNNEST(orders.deliveries) d &#13;
