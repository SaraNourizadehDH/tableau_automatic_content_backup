    <worksheet name='Daily - Closure &amp; Shrinkage'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Closure &amp; Shrinkage By Date</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='7 - Logistics View Dashboard KPIs' name='federated.1j4n33f0i2es2u1460keq132hcri' />
          </datasources>
          <datasource-dependencies datasource='federated.1j4n33f0i2es2u1460keq132hcri'>
            <column caption='Weekday' datatype='string' name='[Calculation_1847038859818917890]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&quot;weekday&quot;,[order_date])' />
            </column>
            <column caption='Shrinkage_new_def %' datatype='real' name='[Calculation_1923037069952491529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([shrink_1st_orders]) + SUM([shrink_2nd_orders]) + SUM([shrink_3rd_orders]) )/SUM([forecasted_orders])' />
            </column>
            <column caption='Shrink 0_new_def %' datatype='real' name='[Calculation_344525429085376513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrink_0_orders])/SUM([forecasted_orders])' />
            </column>
            <column caption='surge_new_def %' datatype='real' name='[Calculation_936185801983819789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([surged_1st_order_experience]) + SUM([surged_2nd_order_experience]) + SUM([surged_3rd_order_experience])&#13;&#10;+ SUM([surged_4th_order_experience]) + SUM([surged_above_4_order_experience]))/SUM([actual_order_surge])' />
            </column>
            <column caption='closure_new_def %' datatype='real' name='[Calculation_936185801985142798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([close_orders])/SUM([forecasted_orders])' />
            </column>
            <column caption='Select Date' datatype='date' name='[Order Date (copy)_1001769506183086092]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[order_date]' />
            </column>
            <column datatype='integer' name='[actual_order_surge]' role='measure' type='quantitative' />
            <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='real' name='[close_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[forecasted_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1847038859818917890]' derivation='None' name='[none:Calculation_1847038859818917890:nk]' pivot='key' type='nominal' />
            <column-instance column='[Order Date (copy)_1001769506183086092]' derivation='None' name='[none:Order Date (copy)_1001769506183086092:ok]' pivot='key' type='ordinal' />
