            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_2785DC9AC5084FBC9E70A29B76E799DA]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>order_on_time_orders</remote-name>
            <remote-type>20</remote-type>
