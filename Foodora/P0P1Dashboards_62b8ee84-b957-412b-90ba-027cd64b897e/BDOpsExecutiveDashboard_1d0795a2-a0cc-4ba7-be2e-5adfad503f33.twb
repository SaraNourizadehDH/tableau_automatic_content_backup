  SELECT&#13;
    FORMAT_DATE(&apos;%G&apos;, DATE(surge.created_date_local)) AS year,&#13;
    EXTRACT(MONTH FROM DATE(surge.created_date_local)) as month_number, &#13;
    FORMAT_DATE(&quot;%B&quot;, DATE(surge.created_date_local)) as month,&#13;
    FORMAT_DATE(&apos;%G-%V&apos;, DATE(surge.created_date_local)) AS week,&#13;
