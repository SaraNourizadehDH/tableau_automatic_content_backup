      THEN &apos;restaurants&apos;&#13;
      WHEN REGEXP_REPLACE(lower(business_types.vendor_type),&quot; &quot;,&quot;&quot;)  IN (&apos;homechef&apos;,&apos;homechefs&apos;)&#13;
      THEN &apos;home chefs&apos;&#13;
      ELSE NULL&#13;
    END AS business_type,&#13;
    c.lg_city_id AS lg_city_id,&#13;
    c.city_name AS city_name,&#13;
    c.lg_zone_id AS lg_zone_id,&#13;
    c.zone_name AS zone_name,&#13;
    o.cancellation_reason AS cancellation_reason,&#13;
    o.cancellation_source AS cancellation_source,&#13;
    COUNTIF(o.rider_order_status = &apos;cancelled&apos;) as failed_orders,&#13;
    COUNT(o.order_code) AS total_orders,&#13;
  FROM orders o&#13;
  LEFT JOIN countries c &#13;
  ON&#13;
    (CASE WHEN c.country_code  = &apos;bd&apos; THEN &apos;FP_BD&apos; ELSE c.country_code END) = o.global_entity_id&#13;
    AND c.lg_city_id = o.lg_city_id&#13;
    AND c.lg_zone_id = o.lg_zone_id&#13;
  LEFT JOIN  business_types as business_types &#13;
  ON &#13;
    business_types.vendor_code  = o.vendor_code&#13;
    AND business_types.global_entity_id  = o.global_entity_id&#13;
  WHERE &#13;
    o.global_entity_id = &apos;FP_BD&apos;&#13;
    -- AND COALESCE(DATE(o.rider_dropped_off_at_local), DATE(o.created_at_local)) BETWEEN (SELECT date_start FROM dates) AND (SELECT date_end FROM dates)&#13;
    AND DATE(o.created_date_local) BETWEEN (SELECT date_start FROM dates) AND (SELECT date_end FROM dates)&#13;
