            <column caption='Display Measures' datatype='real' name='[Calculation_773774754129317900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Completed Orders&quot; THEN SUM([completed_orders])&#13;&#10;WHEN &quot;Failed Orders&quot; THEN SUM([failed_orders])&#13;&#10;WHEN &quot;DT&quot; THEN [Calculation_649925732433055745]&#13;&#10;WHEN &quot;Promised DT&quot; THEN AVG([Promised_DT])&#13;&#10;WHEN &quot;Stacking %&quot; THEN [Calculation_773774754099671042]&#13;&#10;WHEN &quot;Order Early &lt; 10 min %&quot; THEN [Calculation_773774754100027396]&#13;&#10;WHEN &quot;Order On Time %&quot; THEN [Calculation_773774754099867651]&#13;&#10;WHEN &quot;Order Late &gt; 10 min %&quot; THEN [Calculation_773774754100199429]&#13;&#10;WHEN &quot;Rider Late &gt; 10 min %&quot; THEN [Calculation_773774754100555782]&#13;&#10;WHEN &quot;Vendor Late &gt; 10 min %&quot; THEN [Calculation_773774754100707335]&#13;&#10;WHEN &quot;Acceptance Rate %&quot; THEN [Calculation_773774754098974721]&#13;&#10;WHEN &quot;Fail Rate %&quot; THEN [Calculation_773774754100940808]&#13;&#10;WHEN &quot;Customer Fail Rate %&quot; THEN [Calculation_773774754103189513]&#13;&#10;WHEN &quot;Rider Fail Rate %&quot; THEN [Calculation_773774754103386122]&#13;&#10;WHEN &quot;Vendor Fail Rate %&quot; THEN [Calculation_773774754103885835]&#13;&#10;WHEN &quot;Vendors Availability&quot; THEN SUM([vendors])&#13;&#10;WHEN &quot;Rider Availability&quot; THEN SUM([riders_hourly])&#13;&#10;WHEN &quot;Working Hours&quot; THEN SUM([working_hours])&#13;&#10;WHEN &quot;UTR Hourly&quot; THEN [Calculation_1843942625718988800]&#13;&#10;END' />
            </column>
