  LEFT JOIN `fulfillment-dwh-production.pandata_report.regional_apac_pd_vendors_agg_business_types` pd_vendors_agg_business_types&#13;
  ON pd_vendors_agg_business_types.uuid = v.uuid&#13;
  &#13;
