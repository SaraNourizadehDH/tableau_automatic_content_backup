      </column>
      <column caption='SDDs DT' datatype='real' name='[Calculation_597008461259710477]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sdds_delivery_time])/SUM([sdds_orders])' />
      </column>
      <column caption='LDDs DT' datatype='real' name='[Calculation_597008461260169230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ldds_delivery_time])/SUM([ldds_orders])' />
      </column>
      <column caption='DT_cacl.' datatype='real' name='[Calculation_814025643457654784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([DT])/SUM([completed_orders])' />
      </column>
      <column caption='Fill Rate %' datatype='real' name='[Calculation_814025643459366913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([assigned_shifts_hours])/(SUM([assigned_shifts_hours]) + SUM([unassigned_shifts_hours]))' />
      </column>
      <column caption='Break Hours %' datatype='real' name='[Calculation_814025643459653634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_hours_rider_was_on_break])/(SUM([total_hours_rider_was_in_shift]) + SUM([total_hours_rider_was_on_break]))' />
      </column>
      <column caption='Idle Time %' datatype='real' name='[Calculation_814025643459944451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([transition_working_hours]) - SUM([transition_busy_hours]))/SUM([transition_working_hours])' />
      </column>
      <column caption='promised_dt_calc.' datatype='real' name='[Calculation_814025643471224839]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Promised_DT])/SUM([completed_orders])' />
