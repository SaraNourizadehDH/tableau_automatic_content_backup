            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_773774754100940808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((SUM([fr_failed_orders])/SUM([fr_gross_orders])*100),2)' />
