    <worksheet name='Hourly - Surge, Shrink &amp; Closure'>
      <table>
        <view>
          <datasources>
            <datasource caption='13 - Surge, Shrink, Closure Hourly' name='federated.06b6f7c1x40ryb18q2uvi1eojmip' />
            <datasource caption='12 - Hourly Trends KPIs' name='federated.1y775cc1urmj0m10e7ue30b4joi4' />
          </datasources>
          <datasource-dependencies datasource='federated.06b6f7c1x40ryb18q2uvi1eojmip'>
            <column caption='Surge %_new_def' datatype='real' name='[Calculation_1437492742373097472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([surged_1st_order_experience]) + SUM([surged_2nd_order_experience]) + SUM([surged_3rd_order_experience]) + SUM([surged_4th_order_experience]) + SUM([surged_above_4_order_experience]))/SUM([actual_orders])' />
            </column>
            <column caption='Shrink %_new_def' datatype='real' name='[Calculation_1437492742373535745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([shrink_1st_orders]) + SUM([shrink_2nd_orders]) + SUM([shrink_3rd_orders]) + SUM([shrink_4th_orders]) + SUM([shrink_5th_orders]) + SUM([shrink_6th_orders]))/SUM([forecasted_orders])' />
            </column>
            <column caption='Closure %_new_def' datatype='real' name='[Calculation_1437492742373937154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([close_orders])/SUM([forecasted_orders])' />
            </column>
            <column caption='Weekday' datatype='string' name='[Calculation_1847038859816419328]' role='dimension' type='nominal'>
