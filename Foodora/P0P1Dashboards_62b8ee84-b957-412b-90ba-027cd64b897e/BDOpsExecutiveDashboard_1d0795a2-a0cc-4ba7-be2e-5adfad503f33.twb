    -- AND orders.global_entity_id = &apos;FP_BD&apos;&#13;
    AND orders.country_code = &apos;bd&apos;&#13;
),&#13;
&#13;
cancelled_orders AS (&#13;
  SELECT&#13;
    FORMAT_DATE(&apos;%G&apos;, DATE(o.order_placed_at_local)) AS order_year,&#13;
    EXTRACT(MONTH FROM DATE(o.order_placed_at_local)) as order_month_number, &#13;
    FORMAT_DATE(&quot;%B&quot;, DATE(o.order_placed_at_local)) as order_month,&#13;
    FORMAT_DATE(&apos;%G-%V&apos;, DATE(o.order_placed_at_local)) AS order_week,&#13;
    DATE(o.order_placed_at_local) AS order_date,&#13;
    EXTRACT(HOUR FROM o.order_placed_at_local) AS hour,&#13;
    CASE&#13;
      WHEN pandago_flag  IN (&apos;pandago&apos;)&#13;
      THEN &apos;pandago&apos;&#13;
      WHEN REGEXP_REPLACE(lower(business_types.vendor_type),&quot; &quot;,&quot;&quot;)  IN (&apos;pandamart&apos;,&apos;pandamarts&apos;)&#13;
      THEN &apos;pandamarts&apos;&#13;
      WHEN REGEXP_REPLACE(lower(business_types.vendor_type),&quot; &quot;,&quot;&quot;)  IN (&apos;shop&apos;,&apos;shops&apos;)&#13;
      THEN &apos;shops&apos;&#13;
      WHEN REGEXP_REPLACE(lower(business_types.vendor_type),&quot; &quot;,&quot;&quot;)  IN (&apos;caterer&apos;,&apos;caterers&apos;)&#13;
      THEN &apos;caterers&apos;&#13;
      WHEN REGEXP_REPLACE(lower(business_types.vendor_type),&quot; &quot;,&quot;&quot;)  IN (&apos;concept&apos;,&apos;concepts&apos;)&#13;
      THEN &apos;concepts&apos;&#13;
      WHEN REGEXP_REPLACE(lower(business_types.vendor_type),&quot; &quot;,&quot;&quot;)  IN (&apos;kitchen&apos;,&apos;kitchens&apos;)&#13;
      THEN &apos;kitchens&apos;&#13;
