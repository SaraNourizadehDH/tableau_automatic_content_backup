      <column caption='Weekly - Avg. Comp. Orders ' datatype='real' name='[Avg. Comp. Orders (copy)_1001769506151727109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([completed_orders])/SUM([fixed dates (copy)_1001769506151337988])' />
      </column>
      <column caption='Avg. Comp. Orders (OLD)' datatype='real' name='[Avg. Comp. Orders (copy)_1001769506170507273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF(DAY(TODAY())-DAY([order_date]) &lt;=8, [completed_orders], 0))/7' />
      </column>
      <column caption='Avg. DT' datatype='real' name='[Avg. Comp. Orders (copy)_570549822749310977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_814025643457654784]/SUM([fixed dates (copy)_1001769506151337988])' />
      </column>
      <column caption='Avg. VD Orders ' datatype='real' name='[Avg. Comp. Orders (copy)_814025643463000068]' role='measure' type='quantitative'>
