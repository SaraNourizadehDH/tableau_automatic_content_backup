      <column caption='Avg. Delivery Area Size' datatype='real' name='[Calculation_1018939427258646530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_delivery_area_km2])/SUM([completed_orders])' />
      </column>
      <column caption='Total Shrink Orders' datatype='real' name='[Calculation_1373316456543604737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shrink_1st_orders]+[shrink_2nd_orders]+[shrink_3rd_orders]+[shrink_4th_orders]+[shrink_5th_orders]+[shrink_6th_orders])' />
      </column>
      <column caption='SDDs Order %' datatype='real' name='[Calculation_1396397395322830848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sdds_orders])/SUM([completed_orders])' />
      </column>
      <column caption='LDDs Orders %' datatype='real' name='[Calculation_1396397395323322369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ldds_orders])/SUM([completed_orders])' />
      </column>
      <column caption='Weekly - LDDs Orders %' datatype='real' name='[Calculation_1396397395378368515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ldds_orders])/SUM([completed_orders])' />
      </column>
      <column caption='Weekly - SDDs Orders %' datatype='real' name='[Calculation_1396397395379077124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sdds_orders])/SUM([completed_orders])' />
      </column>
      <column caption='Weekday' datatype='string' name='[Calculation_1847038859818917890]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&quot;weekday&quot;,[order_date])' />
      </column>
      <column caption='Fail Rate %' datatype='real' name='[Calculation_1923037069934350336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_rate_failed_orders])/SUM([fail_rate_gross_orders])' />
      </column>
      <column caption='Rider Fail Rate %' datatype='real' name='[Calculation_1923037069936066561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_rate_rider_fail_orders])/SUM([fail_rate_gross_orders])' />
      </column>
      <column caption='Customer Fail Rate %' datatype='real' name='[Calculation_1923037069936971779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_rate_customer_fail_orders])/SUM([fail_rate_gross_orders])' />
      </column>
      <column caption='Vendor Fail Rate %' datatype='real' name='[Calculation_1923037069937360900]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_rate_vendor_fail_orders])/SUM([fail_rate_gross_orders])' />
      </column>
      <column caption='Shrinkage_new_def %' datatype='real' name='[Calculation_1923037069952491529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([shrink_1st_orders]) + SUM([shrink_2nd_orders]) + SUM([shrink_3rd_orders]) )/SUM([forecasted_orders])' />
      </column>
      <column caption='Seamless %' datatype='real' name='[Calculation_1923037069958807564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([seamless_order_with_issue])/SUM([seamless_gross_orders])' />
      </column>
      <column caption='Week Filter' datatype='string' name='[Calculation_331577586169741312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATEPART(&quot;month&quot;, [order_date]))' />
      </column>
      <column caption='order_month' datatype='datetime' default-format='*mmm yyyy' name='[Calculation_331577586190823425]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [order_date])' />
      </column>
      <column caption='Day Granularity' datatype='string' name='[Calculation_331577586199797762]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 4]&#13;&#10;when &apos;Day&apos; then str(DATENAME(&apos;month&apos;,[order_date])) +str(&apos; &apos;) +str(day([order_date]))&#13;&#10;when &apos;Week&apos; then str(DATENAME(&apos;year&apos;, [order_date])) + &apos;, &apos; + str(&apos;Week&apos;) + str(&apos; &apos;)+ str(ISOWEEK([order_date]))&#13;&#10;when &apos;Month&apos; then str(DATENAME(&apos;year&apos;, [order_date])) + &apos;, &apos; + str(DATENAME(&apos;month&apos;, [order_date]))&#13;&#10;END' />
      </column>
      <column caption='Day Name' datatype='string' name='[Calculation_331577586200182787]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[order_date])' />
      </column>
      <column caption='fixed dates' datatype='integer' name='[Calculation_331577586239643658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : countd([order_date])}' />
      </column>
      <column caption='Avg. Daily Riders' datatype='real' name='[Calculation_331577586240942091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_riders]/[fixed dates (copy)_1001769506151337988]' />
      </column>
      <column caption='Shrink 0_new_def %' datatype='real' name='[Calculation_344525429085376513]' role='measure' type='quantitative'>
