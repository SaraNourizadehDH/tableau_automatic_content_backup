    <worksheet name='Logistics KPIs'>
      <table>
        <view>
          <datasources>
            <datasource caption='7 - Logistics View Dashboard KPIs' name='federated.1j4n33f0i2es2u1460keq132hcri' />
          </datasources>
          <datasource-dependencies datasource='federated.1j4n33f0i2es2u1460keq132hcri'>
            <column caption='Avg. Delivery Area Size' datatype='real' name='[Calculation_1018939427258646530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_delivery_area_km2])/SUM([completed_orders])' />
            </column>
            <column caption='Fail Rate %' datatype='real' name='[Calculation_1923037069934350336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_rate_failed_orders])/SUM([fail_rate_gross_orders])' />
            </column>
            <column caption='Rider Fail Rate %' datatype='real' name='[Calculation_1923037069936066561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_rate_rider_fail_orders])/SUM([fail_rate_gross_orders])' />
            </column>
            <column caption='Customer Fail Rate %' datatype='real' name='[Calculation_1923037069936971779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_rate_customer_fail_orders])/SUM([fail_rate_gross_orders])' />
            </column>
            <column caption='Vendor Fail Rate %' datatype='real' name='[Calculation_1923037069937360900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_rate_vendor_fail_orders])/SUM([fail_rate_gross_orders])' />
            </column>
            <column caption='Shrinkage_new_def %' datatype='real' name='[Calculation_1923037069952491529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([shrink_1st_orders]) + SUM([shrink_2nd_orders]) + SUM([shrink_3rd_orders]) )/SUM([forecasted_orders])' />
            </column>
            <column caption='Seamless %' datatype='real' name='[Calculation_1923037069958807564]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - SUM([seamless_order_with_issue])/SUM([seamless_gross_orders])' />
            </column>
            <column caption='Day Name' datatype='string' name='[Calculation_331577586200182787]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[order_date])' />
            </column>
            <column caption='Avg. Daily Riders' datatype='real' name='[Calculation_331577586240942091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_riders]/[fixed dates (copy)_1001769506151337988]' />
            </column>
            <column caption='DT_cacl.' datatype='real' name='[Calculation_814025643457654784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DT])/SUM([completed_orders])' />
            </column>
            <column caption='Fill Rate %' datatype='real' name='[Calculation_814025643459366913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([assigned_shifts_hours])/(SUM([assigned_shifts_hours]) + SUM([unassigned_shifts_hours]))' />
            </column>
            <column caption='Break Hours %' datatype='real' name='[Calculation_814025643459653634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_hours_rider_was_on_break])/(SUM([total_hours_rider_was_in_shift]) + SUM([total_hours_rider_was_on_break]))' />
            </column>
            <column caption='Idle Time %' datatype='real' name='[Calculation_814025643459944451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([transition_working_hours]) - SUM([transition_busy_hours]))/SUM([transition_working_hours])' />
            </column>
            <column caption='promised_dt_calc.' datatype='real' name='[Calculation_814025643471224839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Promised_DT])/SUM([completed_orders])' />
            </column>
            <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_936185801974734848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([completed_orders])/SUM([evaluated_hours])' />
            </column>
            <column caption='DT &gt; 45mins %' datatype='real' name='[Calculation_936185801975312386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_greater_than_45_orders])/SUM([completed_orders])' />
            </column>
            <column caption='DT &lt; 25mins %' datatype='real' name='[Calculation_936185801975513091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_less_than_25_orders])/SUM([completed_orders])' />
            </column>
            <column caption='Stacking %' datatype='real' name='[Calculation_936185801975607300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_orders])/SUM([completed_orders])' />
            </column>
            <column caption='Order Early &lt; 15mins %' datatype='real' name='[Calculation_936185801975914502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([order_early_less_than_15_orders])/SUM([completed_orders])' />
            </column>
            <column caption='Order On Time %' datatype='real' name='[Calculation_936185801976127495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_on_time_orders])/SUM([completed_orders])' />
            </column>
            <column caption='Order Late &gt; 5mins %' datatype='real' name='[Calculation_936185801976274952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_late_greater_than_5_orders])/SUM([completed_orders])' />
            </column>
            <column caption='Rider Late  &gt; 10mins %' datatype='real' name='[Calculation_936185801979207689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_late_greater_than_10_orders])/SUM([completed_orders])' />
            </column>
            <column caption='Vendor Late &gt; 10mins %' datatype='real' name='[Calculation_936185801979404298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_greater_than_10_orders])/SUM([completed_orders])' />
            </column>
            <column caption='No Show %' datatype='real' name='[Calculation_936185801979605003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([no_show_shifts_hours]) + SUM([no_show_excused_shifts_hours]))/SUM([scheduled_hours])' />
            </column>
            <column caption='Acceptance Rate %' datatype='real' name='[Calculation_936185801979981836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acceptances])/SUM([notifications])' />
            </column>
            <column caption='surge_new_def %' datatype='real' name='[Calculation_936185801983819789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([surged_1st_order_experience]) + SUM([surged_2nd_order_experience]) + SUM([surged_3rd_order_experience])&#13;&#10;+ SUM([surged_4th_order_experience]) + SUM([surged_above_4_order_experience]))/SUM([actual_order_surge])' />
            </column>
            <column caption='closure_new_def %' datatype='real' name='[Calculation_936185801985142798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([close_orders])/SUM([forecasted_orders])' />
            </column>
            <column caption='dt' datatype='real' name='[DT]' role='measure' type='quantitative' />
            <column caption='P-D Distance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Fill Rate % (copy)_814025643475816456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_distance_in_km])/SUM([completed_orders])' />
            </column>
