    <worksheet name='Hourly - KPIs Trend By City/Zone'>
      <table>
        <view>
          <datasources>
            <datasource caption='12 - Hourly Trends KPIs' name='federated.1y775cc1urmj0m10e7ue30b4joi4' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Measures' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Rider Fail Rate \%&quot;'>
              <calculation class='tableau' formula='&quot;Rider Fail Rate %&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1y775cc1urmj0m10e7ue30b4joi4'>
            <column caption='UTR Hourly' datatype='real' name='[Calculation_1843942625718988800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([completed_orders])/SUM([working_hours])' />
            </column>
            <column caption='Weekday' datatype='string' name='[Calculation_1847038859817426945]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&quot;weekday&quot;,[Order Date (copy)_1001769506401632272])' />
            </column>
            <column caption='DT_calc' datatype='real' name='[Calculation_649925732433055745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([DT])/SUM([completed_orders])' />
            </column>
            <column caption='Acceptacnce Rate' datatype='real' name='[Calculation_773774754098974721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((SUM([acceptances])/SUM([notifications])*100),2)' />
            </column>
            <column caption='Stacking %' datatype='real' name='[Calculation_773774754099671042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((SUM([stacked_orders])/SUM([completed_orders]))*100,2)' />
            </column>
            <column caption='Order On Time %' datatype='real' name='[Calculation_773774754099867651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((SUM([order_on_time_orders])/SUM([completed_orders])*100),2)' />
            </column>
            <column caption='Order Early &lt; 10 min %' datatype='real' name='[Calculation_773774754100027396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((SUM([order_early_less_than_10_orders])/SUM([completed_orders])*100),2)' />
            </column>
            <column caption='Order Late &gt; 10 min %' datatype='real' name='[Calculation_773774754100199429]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND((SUM([order_late_greater_than_10_orders])/SUM([completed_orders])*100),2)' />
            </column>
            <column caption='Rider Late &gt; 10 min %' datatype='real' name='[Calculation_773774754100555782]' role='measure' type='quantitative'>
