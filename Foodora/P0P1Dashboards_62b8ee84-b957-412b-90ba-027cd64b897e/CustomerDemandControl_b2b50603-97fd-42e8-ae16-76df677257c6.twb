            <column caption='Report Time' datatype='string' name='[Calculation_6434869865912352770]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Day&apos; THEN STR([report_date])&#10;    WHEN &apos;Weekday&apos; THEN [report_weekday]&#10;    WHEN &apos;Week&apos; THEN [report_week]&#10;    WHEN &apos;Month&apos; THEN [report_month]&#10;END' />
