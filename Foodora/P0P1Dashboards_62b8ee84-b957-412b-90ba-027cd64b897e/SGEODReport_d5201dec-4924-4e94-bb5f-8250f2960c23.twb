      <column caption='surge order count' datatype='integer' default-format='p0.00%' name='[% of total by zones (copy)_5196802156776325121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [type_of_delivery] = &apos;nil&apos; then [order_count] end)' />
      </column>
      <column caption='% of total by zones' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [type_of_delivery] = &apos;nil&apos; then [order_count] end) / TOTAL(SUM([order_count]))'>
          <table-calc ordering-type='ColumnInPane' />
        </calculation>
      </column>
      <column caption='Order Count by Zone w Surge' datatype='integer' name='[Calculation_4499870084684107776]' role='measure' type='quantitative'>
