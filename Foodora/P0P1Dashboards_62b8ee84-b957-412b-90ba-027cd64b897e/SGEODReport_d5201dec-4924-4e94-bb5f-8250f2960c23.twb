    <worksheet name='Orders &amp; DT (Dmart)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Medium' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/SGEODReport/OrdersDTDmart?rev=' id='OrdersDTDmart' path='/t/Foodora/workbooks/SGEODReport' revision='' site='Foodora' />
      <table>
        <view>
          <datasources>
            <datasource caption='orders &amp; dt' name='federated.1uygrzq15os02010ihzoi1jx11t9' />
          </datasources>
          <datasource-dependencies datasource='federated.1uygrzq15os02010ihzoi1jx11t9'>
            <column caption='Delay' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg DT (copy)_3826933818777841669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_delay_sum])/SUM([delivery_delay_count])' />
            </column>
            <column caption='WAPE' datatype='real' default-format='p0.0%' name='[Calculation_3826933818774335488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_count])/AVG([forecasted_orders])' />
            </column>
            <column caption='Avg DT' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3826933818777063428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_time_sum])/SUM([delivery_time_count])' />
            </column>
            <column caption='% Delay (&gt;10 mins)' datatype='real' default-format='p0.0%' name='[Calculation_3826933818778066950]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_delay_10_count])/SUM([order_count])' />
            </column>
            <column caption='UTR' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3826933818778750983]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_count])/AVG([clocked_hour_sum])' />
            </column>
            <column caption='LI' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3826933818778861576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3826933818777063428]/[Calculation_3826933818778750983]' />
            </column>
            <column caption='Area' datatype='string' name='[area]' role='dimension' type='nominal' />
            <column-instance column='[forecasted_orders]' derivation='Avg' name='[avg:forecasted_orders:vtsum:qk]' pivot='key' type='quantitative' visual-totals='Sum' />
            <column caption='Clocked Hour Sum' datatype='real' name='[clocked_hour_sum]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Delivery Delay 10 Count' datatype='integer' name='[delivery_delay_10_count]' role='measure' type='quantitative' />
            <column caption='Delivery Delay Count' datatype='integer' name='[delivery_delay_count]' role='measure' type='quantitative' />
            <column caption='Delivery Delay Sum' datatype='real' name='[delivery_delay_sum]' role='measure' type='quantitative' />
            <column caption='Delivery Time Count' datatype='integer' name='[delivery_time_count]' role='measure' type='quantitative' />
            <column caption='Delivery Time Sum' datatype='real' name='[delivery_time_sum]' role='measure' type='quantitative' />
            <column caption='Forecasted Orders' datatype='integer' name='[forecasted_orders]' role='measure' type='quantitative' />
            <column-instance column='[area]' derivation='None' name='[none:area:nk]' pivot='key' type='nominal' />
            <column-instance column='[rank]' derivation='None' name='[none:rank:nk]' pivot='key' type='nominal' />
            <column-instance column='[sub_area]' derivation='None' name='[none:sub_area:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_type]' derivation='None' name='[none:vendor_type:nk]' pivot='key' type='nominal' />
            <column caption='Order Count' datatype='integer' name='[order_count]' role='measure' type='quantitative' />
            <column-instance column='[forecasted_orders]' derivation='Avg' name='[pcdf:avg:forecasted_orders:qk]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='PctDiff'>
                <address>
                  <value>-1</value>
                </address>
