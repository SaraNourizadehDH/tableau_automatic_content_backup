  <worksheets>
    <worksheet name='Forecast'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Riders Demand Forecast</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='lg_rider_forecast (bl_logistics)' name='federated.014t21x0nghkuh185qmfz1dlfwv8' />
          </datasources>
          <datasource-dependencies datasource='federated.014t21x0nghkuh185qmfz1dlfwv8'>
            <column caption='Additional Hours Needed (calculated)' datatype='real' name='[Additional Hours Needed (copy)_734086790819487745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;&#10;(SUM([rider_hours_needed]) - (SUM([weekly_worked_hours]) - SUM([weekly_churned_hours]) + SUM([weekly_reactivated_hour])))&#10;&#10;&lt;0 THEN 0 &#10;&#10;ELSE &#10;&#10;(SUM([rider_hours_needed]) - (SUM([weekly_worked_hours]) - SUM([weekly_churned_hours]) + SUM([weekly_reactivated_hour])))&#10;&#10;END' />
            </column>
            <column caption='Available Hours (calculated)' datatype='real' name='[Available Hours (copy)_1079878799739367424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;&#10;(SUM([weekly_worked_hours]) - SUM([weekly_churned_hours]) + SUM([weekly_reactivated_hour]))&#10;&#10;&lt;0 THEN 0 ELSE &#10;&#10;(SUM([weekly_worked_hours]) - SUM([weekly_churned_hours]) + SUM([weekly_reactivated_hour]))&#10;&#10;END' />
            </column>
            <column caption='% Recrutiment Need' datatype='real' name='[Calculation_732960879927083008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([additional_hours_needed]) / SUM([rider_hours_needed])' />
            </column>
            <column caption='Additional Hours Needed' datatype='real' name='[additional_hours_needed]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
