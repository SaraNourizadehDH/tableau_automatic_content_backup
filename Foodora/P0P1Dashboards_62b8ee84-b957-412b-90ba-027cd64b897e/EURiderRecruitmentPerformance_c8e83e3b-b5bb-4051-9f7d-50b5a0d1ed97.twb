      </column>
      <column caption='MoM fleet change' datatype='real' name='[Calculation_3981956163102056450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_riders (lg_rider_supply_historic_monthly)] - [active_riders_last_month])/SUM([active_riders_last_month])' />
      </column>
      <column caption='Hire to Lead Ratio' datatype='real' name='[Calculation_4988792154850095105]' role='measure' type='quantitative'>
