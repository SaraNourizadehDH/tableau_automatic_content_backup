    <worksheet name='Weekly overview table'>
      <table>
        <view>
          <datasources>
            <datasource caption='tmp_recruitment (sb_performance)' name='federated.0s1q46r0bg4fab1bn1zc503vcl25' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Include' caption='Austria 3PL' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='Exclude' />
                <alias key='true' value='Include' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0s1q46r0bg4fab1bn1zc503vcl25'>
            <column caption='Planned Riders' datatype='integer' name='[Calculation_2690408258742358019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]&#10;THEN SUM([planned_riders])&#10;ELSE &#10;    IF (SUM([planned_riders]) - IFNULL(SUM([planned_riders_at_3pl]),0)) = 0 THEN NULL ELSE (SUM([planned_riders]) - IFNULL(SUM([planned_riders_at_3pl]),0)) END&#10;END' />
            </column>
            <column caption='Planned Hours' datatype='real' name='[Calculation_2690408258742476804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]&#10;THEN SUM([planned_hours])&#10;ELSE (SUM([planned_hours]) - IFNULL(SUM([planned_hours_at_3pl]),0))&#10;END' />
            </column>
            <column caption='Scheduled Riders' datatype='integer' name='[Calculation_293578465060474881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF([Parameters].[Parameter 2])&#10;THEN SUM([planned_riders])&#10;ELSE IF (SUM([planned_riders]) - SUM([planned_riders_at_3pl])) = 0 THEN NULL ELSE (SUM([planned_riders]) - SUM([planned_riders_at_3pl])) END&#10;END' />
            </column>
            <column caption='Hires' datatype='integer' name='[Calculation_293578465060544514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([hire_count]),0)' />
            </column>
            <column caption='Leads' datatype='integer' name='[Calculation_293578465061724163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([applicant_count])' />
            </column>
            <column caption='Hours Per Rider (HPR)' datatype='real' name='[Calculation_293578465063440388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_293578465063538693] &gt; [Calculation_293578465063616518] THEN [Calculation_293578465063538693] ELSE [Calculation_293578465063616518] END' />
            </column>
            <column caption='HPR - Demand' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_293578465063538693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Planned Hours (copy)_2690408258743443461] / [Calculation_2690408258742358019]' />
            </column>
            <column caption='HPR - Worked' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_293578465063616518]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2690408258742476804] / [Calculation_2690408258742358019]' />
            </column>
            <column caption='Exclude current week' datatype='boolean' name='[Calculation_293578465068331018]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='datetrunc(&apos;week&apos;,[week_date]) &lt;&gt; datetrunc(&apos;week&apos;,today())' />
            </column>
            <column caption='Rider Demand Hours' datatype='real' name='[Planned Hours (copy)_2690408258743443461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]&#10;THEN SUM([rider_demand_hours])&#10;ELSE MAX(0,(SUM([rider_demand_hours]) - IFNULL(SUM([planned_hours_at_3pl]),0)))&#10;END' />
            </column>
