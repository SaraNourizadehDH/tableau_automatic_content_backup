      <column caption='Month' datatype='string' name='[Calculation_4060276554022887424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(year([cost_date])) + &quot;-&quot; + &#10;if month([cost_date]) &lt; 10 then &quot;0&quot; else &quot;&quot; end +&#10;str(month([cost_date]))' />
