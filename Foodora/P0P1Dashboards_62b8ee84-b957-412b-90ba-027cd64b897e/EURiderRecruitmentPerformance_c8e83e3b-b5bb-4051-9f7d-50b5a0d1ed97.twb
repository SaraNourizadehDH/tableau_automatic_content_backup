        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1lcka5m0nr7ud716tuusp1exfpuq (copy 2)' name='Custom SQL Query1' type='text'><![CDATA[#for monthly cvr
WITH countries AS (
  SELECT 
  countries.country_code,
  countries.country_name,
  cities.id AS city_id,
  cities.name as city_name
  FROM `fulfillment-dwh-production.curated_data_shared.countries` as countries
  LEFT JOIN UNNEST(countries.cities) AS cities
),

cvr_daily AS (
SELECT distinct 
FORMAT_DATE("%G-%m", DATE(DATETIME(applicants.created_at, applicants.timezone))) AS report_month_local,
applicants.country_code,
applicant_id,
country_name,
city_name,
created_date, 
location_name,
CASE WHEN TIMESTAMP_DIFF(approved_at, created_at, DAY) <<= 7 THEN 1 END AS CVR_7_day,
CASE WHEN TIMESTAMP_DIFF(approved_at, created_at, DAY) <<= 14 THEN 1 END AS CVR_14_day,
CASE WHEN TIMESTAMP_DIFF(approved_at, created_at, DAY) <<= 30 THEN 1 END AS CVR_30_day
FROM `fulfillment-dwh-production.curated_data_shared.applicants` as applicants
LEFT JOIN countries
ON applicants.country_code = countries.country_code
AND applicants.city_id = countries.city_id
)

 SELECT 
 report_month_local,
 country_name,
 city_name,
 count(applicant_id) AS num_applicants,
 SUM(CVR_7_day) AS CVR_7_day,
 SUM(CVR_14_day) AS CVR_14_day,
 SUM(CVR_30_day) AS CVR_30_day
 FROM cvr_daily
 GROUP BY 1,2,3]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
