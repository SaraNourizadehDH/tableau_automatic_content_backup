  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definition'>
      <repository-location derived-from='http://ip-172-31-0-201:8679/t/Foodora/workbooks/RiderRecruitmentDashboardEU/Definition?rev=' id='Definition' path='/t/Foodora/workbooks/RiderRecruitmentDashboardEU' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_3' value='left' />
          <format attr='vertical-align' id='dash-text_3' value='top' />
        </style-rule>
      </style>
      <size maxheight='900' maxwidth='1600' minheight='900' minwidth='1600' preset-index='8' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98222' id='3' type-v2='text' w='99000' x='500' y='889'>
            <formatted-text>
              <run fontcolor='#1b1b1b' fontname='Tableau Medium' fontsize='15'>Definitions</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>1. </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Number of orders</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: Completed OD orders in the week</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>2. </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>UTR</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: standard global definition </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>3. </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>HPR</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: total evaluated shift hours divided by total active riders (riders with &gt; 1 actual worked hours)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>4. </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Total riders worked</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: riders with &gt; 1 actual worked hours in the week</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>5. </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Total evaluated hours</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: sum total of evaluated shift hours (actual worked hours) in the week</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>6. </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>% fleet increase (WoW)</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: change in actual worked rider count compared to previous week</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>7. </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Additional riders needed</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: rider activation target for the week based on demand forecast and past 2 week performance</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>8. </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Stale/inactive/reactivated riders</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: global definition of fleet segmentation:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Medium' fontsize='10'>          Stale Riders: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Medium' fontsize='10'>Riders with last order date between 14 to 28 days ago </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Medium' fontsize='10'>          Inactive Riders: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Medium' fontsize='10'>Riders with last order date between 28 to 42 days ago </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Medium' fontsize='10'>          Reactivated Riders: </run>
              <run fontcolor='#1b1b1b' fontname='Tableau Medium' fontsize='10'>Riders with a completed order after more than 42 days w/o an order</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>9. </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Activated riders</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: newly hired riders who took first shift in the week</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>10. </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Hires</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: number of applicants which got approved in Arara in the week </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>11. </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Leads</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: new applicants with created date in the week</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>12. </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Hires to lead ratio</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: ratio of number of hires in the week and no. of applicants in the week. (Please note that this is not funnel conversion)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>13. </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Activated to hired ratio</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> : ratio of number of riders which got activated (point 9) and number of riders which got hired in the week. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>14. </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Time to hire (days)</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: days from application created till application is approved for riders hired in the week</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>15. </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Time to activate (days)</run>
              <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: days from application is approved in Arara till the rider starts his/her first shift, for riders who got activated (point 9) in the week</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='416' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='415' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone forceUpdate='true' h='98222' id='3' type-v2='text' w='99000' x='500' y='889'>
                  <formatted-text>
                    <run fontcolor='#1b1b1b' fontname='Tableau Medium' fontsize='15'>Definitions</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>1. </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Number of orders</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: Completed OD orders in the week</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>2. </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>UTR</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: standard global definition </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>3. </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>HPR</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: total evaluated shift hours divided by total active riders (riders with &gt; 1 actual worked hours)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>4. </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Total riders worked</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: riders with &gt; 1 actual worked hours in the week</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>5. </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Total evaluated hours</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: sum total of evaluated shift hours (actual worked hours) in the week</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>6. </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>% fleet increase (WoW)</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: change in actual worked rider count compared to previous week</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>7. </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Additional riders needed</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: rider activation target for the week based on demand forecast and past 2 week performance</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>8. </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Stale/inactive/reactivated riders</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: global definition of fleet segmentation:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Medium' fontsize='10'>          Stale Riders: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Medium' fontsize='10'>Riders with last order date between 14 to 28 days ago </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Medium' fontsize='10'>          Inactive Riders: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Medium' fontsize='10'>Riders with last order date between 28 to 42 days ago </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Medium' fontsize='10'>          Reactivated Riders: </run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Medium' fontsize='10'>Riders with a completed order after more than 42 days w/o an order</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>9. </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Activated riders</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: newly hired riders who took first shift in the week</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>10. </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Hires</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: number of applicants which got approved in Arara in the week </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>11. </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Leads</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: new applicants with created date in the week</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>12. </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Hires to lead ratio</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: ratio of number of hires in the week and no. of applicants in the week. (Please note that this is not funnel conversion)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>13. </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Activated to hired ratio</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> : ratio of number of riders which got activated (point 9) and number of riders which got hired in the week. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>14. </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Time to hire (days)</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: days from application created till application is approved for riders hired in the week</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>15. </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Time to activate (days)</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: days from application is approved in Arara till the rider starts his/her first shift, for riders who got activated (point 9) in the week</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{8B63EDFA-DB3A-4D91-BB89-CD68A3B53882}' />
    </dashboard>
