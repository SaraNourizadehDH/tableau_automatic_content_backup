      <column caption='CVR' datatype='real' default-format='p0%' name='[Calculation_1975461780568899584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hires]) / SUM([leads])' />
      </column>
      <column caption='Cost per Lead' datatype='real' default-format='c#,##0.00&quot;€&quot;;-#,##0.00&quot;€&quot;' name='[Calculation_3689714752908353536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cost_eur]) / SUM([leads])' />
