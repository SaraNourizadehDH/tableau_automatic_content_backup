      <layout-options>
        <title>
          <formatted-text>
            <run>Rider reqruitment historical - Weekly</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='lg_rider_supply_historic_monthly (bl_logistics)' name='federated.04sazpn0auqomy181vdn91xax2cc (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.04sazpn0auqomy181vdn91xax2cc (copy 2)'>
            <column caption='% No-Shows' datatype='real' name='[% Fill Rate (copy)_6927451076385693697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([no_show_hours_total (lg_rider_supply_historic_monthly)])/SUM([planned_hours (lg_rider_supply_historic_monthly)]),0)' />
            </column>
            <column datatype='integer' name='[CVR_14_day]' role='measure' type='quantitative' />
            <column datatype='integer' name='[CVR_30_day]' role='measure' type='quantitative' />
            <column datatype='integer' name='[CVR_7_day]' role='measure' type='quantitative' />
            <column caption='%CVR_7_day' datatype='real' default-format='p0.0%' name='[Calculation_3138305254475100160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([CVR_7_day])/SUM([num_applicants])' />
            </column>
            <column caption='%CVR_14_day' datatype='real' default-format='p0.0%' name='[Calculation_3138305254475776001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([CVR_14_day])/SUM([num_applicants])' />
            </column>
            <column caption='%CVR_30_day' datatype='real' default-format='p0.0%' name='[Calculation_3138305254475890690]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([CVR_30_day])/SUM([num_applicants])' />
            </column>
            <column caption='MoM fleet change' datatype='real' name='[Calculation_3981956163102056450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_riders (lg_rider_supply_historic_monthly)] - [active_riders_last_month])/SUM([active_riders_last_month])' />
            </column>
            <column caption='Hire to Lead Ratio' datatype='real' name='[Calculation_4988792154850095105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hire_count (lg_rider_supply_historic_monthly)]) / SUM([applicant_count (lg_rider_supply_historic_monthly)])' />
            </column>
            <column caption='Activate to Hire Ratio' datatype='real' name='[Calculation_4988792154850463746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([activated_riders_count (lg_rider_supply_historic_monthly)]) / SUM([hire_count (lg_rider_supply_historic_monthly)])' />
            </column>
            <column caption='HPR' datatype='real' name='[Calculation_5086252863750799364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([evaluated_hours (lg_rider_supply_historic_monthly)])/SUM([active_riders (lg_rider_supply_historic_monthly)])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_5086252863751106565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_number (lg_rider_supply_historic_monthly)])/SUM([evaluated_hours (lg_rider_supply_historic_monthly)])' />
            </column>
