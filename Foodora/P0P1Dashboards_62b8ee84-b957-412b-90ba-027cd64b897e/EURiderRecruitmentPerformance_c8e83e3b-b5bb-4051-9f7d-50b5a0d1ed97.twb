prev_year_active_riders,
orders_number,
prev_year_orders,
previous_year_month,
previous_month_date
FROM corrected
LEFT JOIN prev_year
USING(country, report_month, city_name)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
