      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_87576F0DCF294F6AA21AF3132ECD75B9'>
            <properties context=''>
              <relation connection='bigquery.1lcka5m0nr7ud716tuusp1exfpuq (copy 4)' name='Custom SQL Query' type='text'>WITH 
corrected AS (
  SELECT
    country, 
    city_name,
    report_month,
    month_date,
    orders_number,
    active_riders
FROM `dhh---analytics-eu.bl_logistics.lg_rider_supply_historic_monthly`
WHERE month_date IS NOT NULL
),

prev_year AS (
  SELECT 
    country, 
    city_name, 
    CONCAT(CAST(CAST(SUBSTR(report_month, 1, 4) AS INT64) + 1 AS STRING), &apos;-&apos;, SUBSTR(report_month, 6)) AS report_month,
    report_month as previous_year_month, 
    month_date as previous_month_date,
    orders_number as prev_year_orders, 
    active_riders as prev_year_active_riders
  FROM corrected
)
SELECT 
country, 
report_month,
month_date,
city_name, 
active_riders, 
prev_year_active_riders,
orders_number,
prev_year_orders,
previous_year_month,
previous_month_date
FROM corrected
LEFT JOIN prev_year
USING(country, report_month, city_name)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
