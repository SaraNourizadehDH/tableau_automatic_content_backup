    <worksheet name='Weekly'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Rider reqruitment historical - Weekly</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='lg_rider_supply_historic_weekly (bl_logistics)' name='federated.04sazpn0auqomy181vdn91xax2cc' />
          </datasources>
          <datasource-dependencies datasource='federated.04sazpn0auqomy181vdn91xax2cc'>
            <column caption='% No-Shows' datatype='real' name='[% Fill Rate (copy)_6927451076385693697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([no_show_hours_total])/SUM([planned_hours]),0)' />
            </column>
            <column caption='%CVR_14_day' datatype='real' default-format='p0.0%' name='[%CVR_14_day (copy)_2603995379600330753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([CVR_14_day])/SUM([num_applicants])' />
            </column>
            <column datatype='integer' name='[CVR_14_day]' role='measure' type='quantitative' />
            <column datatype='integer' name='[CVR_30_day]' role='measure' type='quantitative' />
            <column datatype='integer' name='[CVR_7_day]' role='measure' type='quantitative' />
            <column caption='%CVR_30_day' datatype='real' default-format='p0.0%' name='[Calculation_2603995379602800643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([CVR_30_day])/SUM([num_applicants])' />
            </column>
            <column caption='%CVR_7_day' datatype='real' default-format='p0.0%' name='[Calculation_2603995379602972676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([CVR_7_day])/SUM([num_applicants])' />
            </column>
            <column caption='WoW fleet change' datatype='real' name='[Calculation_3981956163102056450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_riders] - [active_riders_last_week])/SUM([active_riders_last_week])' />
            </column>
            <column caption='Hire to Lead Ratio' datatype='real' name='[Calculation_4988792154850095105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hire_count]) / SUM([applicant_count])' />
            </column>
            <column caption='Activate to Hire Ratio' datatype='real' name='[Calculation_4988792154850463746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([activated_riders_count]) / SUM([hire_count])' />
            </column>
            <column caption='HPR' datatype='real' name='[Calculation_5086252863750799364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([evaluated_hours])/SUM([active_riders])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_5086252863751106565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_number])/SUM([evaluated_hours])' />
            </column>
            <column caption='Activated Riders' datatype='integer' name='[activated_riders_count]' role='measure' type='quantitative' />
            <column caption='Active Riders' datatype='integer' name='[active_riders]' role='measure' type='quantitative' />
