          <named-connection caption='BigQuery' name='bigquery.1lcka5m0nr7ud716tuusp1exfpuq (copy 2)'>
            <connection CATALOG='dhh---analytics-eu' EXECCATALOG='dhub-data-commune' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='Pandata EU Production' schema='bl_logistics' server-oauth='server-custom' username='oliver.kampfmann@deliveryhero.com' workgroup-auth-mode='prompt' />
