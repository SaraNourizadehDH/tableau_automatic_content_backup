      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_87576F0DCF294F6AA21AF3132ECD75B9'>
            <properties context=''>
              <relation connection='bigquery.1lcka5m0nr7ud716tuusp1exfpuq (copy 3)' name='Custom SQL Query' type='text'>WITH 
corrected AS (
SELECT 
country, 
city_name, 
report_week,
week_date,
orders_number,
active_riders
FROM `dhh---analytics-eu.bl_logistics.lg_rider_supply_historic_weekly`
WHERE week_date IS NOT NULL
),

prev_year AS (
SELECT 
country, 
city_name, 
CONCAT(CAST(CAST(SUBSTR(report_week, 1, 4) AS INT64) + 1 AS STRING), &apos;-&apos;, SUBSTR(report_week, 6)) AS report_week,
report_week as previous_year_week, 
week_date as previous_week_date,
orders_number as prev_year_orders_number, 
active_riders as prev_year_active_riders
FROM corrected
)

SELECT 
country, 
city_name, 
report_week,
week_date,
orders_number,
prev_year_orders_number,
active_riders,
prev_year_active_riders,
previous_year_week,
previous_week_date
FROM corrected
LEFT JOIN prev_year
USING(country, report_week, city_name)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
