      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0s1q46r0bg4fab1bn1zc503vcl25].[pcdf:sum:evaluated_hours:qk:8]&quot;' value='Δ Worked Hours' />
