    <worksheet name='yoy Weekly'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Weekly YoY Growth</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='yoy weekly' name='federated.04sazpn0auqomy181vdn91xax2cc (copy 3)' />
          </datasources>
          <datasource-dependencies datasource='federated.04sazpn0auqomy181vdn91xax2cc (copy 3)'>
            <column caption='% Fleet Increase YoY' datatype='real' default-format='p0.0%' name='[Calculation_5781918247480033280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([active_riders]) - SUM([prev_year_active_riders]))/SUM([prev_year_active_riders])' />
            </column>
            <column caption='% Order Growth YoY' datatype='real' default-format='p0.0%' name='[Calculation_5992250424063070209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders_number])-SUM([prev_year_orders_number]))/SUM([prev_year_orders_number])' />
            </column>
            <column datatype='integer' name='[active_riders]' role='measure' type='quantitative' />
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_week]' derivation='None' name='[none:report_week:nk]' pivot='key' type='nominal' />
            <column-instance column='[week_date]' derivation='None' name='[none:week_date:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[orders_number]' role='measure' type='quantitative' />
            <column datatype='integer' name='[prev_year_active_riders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[prev_year_orders_number]' role='measure' type='quantitative' />
            <column datatype='string' name='[report_week]' role='dimension' type='nominal' />
            <column-instance column='[active_riders]' derivation='Sum' name='[sum:active_riders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[orders_number]' derivation='Sum' name='[sum:orders_number:qk]' pivot='key' type='quantitative' />
