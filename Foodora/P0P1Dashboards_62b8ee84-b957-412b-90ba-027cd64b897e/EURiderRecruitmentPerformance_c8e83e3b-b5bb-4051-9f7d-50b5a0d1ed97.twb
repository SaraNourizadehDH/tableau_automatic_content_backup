          <datasource-dependencies datasource='federated.04sazpn0auqomy181vdn91xax2cc (copy 4)'>
            <column caption='% Fleet Increase YoY' datatype='real' default-format='p0.0%' name='[Calculation_5781918247480033280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([active_riders]) - SUM([prev_year_active_riders]))/SUM([prev_year_active_riders])' />
            </column>
            <column caption='% Order Growth YoY' datatype='real' default-format='p0.0%' name='[Calculation_5992250424063070209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders_number])-SUM([prev_year_orders]))/SUM([prev_year_orders])' />
            </column>
