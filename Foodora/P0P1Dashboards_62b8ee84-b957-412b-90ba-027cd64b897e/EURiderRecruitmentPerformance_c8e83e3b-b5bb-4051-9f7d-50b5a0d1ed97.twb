      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='CVR' id='_402EA83B39294A308DEBB7F9FD404D0F'>
            <properties context=''>
              <relation connection='bigquery.1lcka5m0nr7ud716tuusp1exfpuq (copy 2)' name='Custom SQL Query1' type='text'><![CDATA[#for monthly cvr
WITH countries AS (
  SELECT 
  countries.country_code,
  countries.country_name,
  cities.id AS city_id,
  cities.name as city_name
  FROM `fulfillment-dwh-production.curated_data_shared.countries` as countries
  LEFT JOIN UNNEST(countries.cities) AS cities
),

cvr_daily AS (
SELECT distinct 
FORMAT_DATE("%G-%m", DATE(DATETIME(applicants.created_at, applicants.timezone))) AS report_month_local,
applicants.country_code,
applicant_id,
country_name,
city_name,
created_date, 
location_name,
CASE WHEN TIMESTAMP_DIFF(approved_at, created_at, DAY) <<= 7 THEN 1 END AS CVR_7_day,
CASE WHEN TIMESTAMP_DIFF(approved_at, created_at, DAY) <<= 14 THEN 1 END AS CVR_14_day,
CASE WHEN TIMESTAMP_DIFF(approved_at, created_at, DAY) <<= 30 THEN 1 END AS CVR_30_day
FROM `fulfillment-dwh-production.curated_data_shared.applicants` as applicants
LEFT JOIN countries
ON applicants.country_code = countries.country_code
AND applicants.city_id = countries.city_id
)

 SELECT 
 report_month_local,
 country_name,
 city_name,
 count(applicant_id) AS num_applicants,
 SUM(CVR_7_day) AS CVR_7_day,
 SUM(CVR_14_day) AS CVR_14_day,
 SUM(CVR_30_day) AS CVR_30_day
 FROM cvr_daily
 GROUP BY 1,2,3]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_402EA83B39294A308DEBB7F9FD404D0F' table='[Extract].[_402EA83B39294A308DEBB7F9FD404D0F]' type='table' />
            </properties>
          </object>
          <object caption='lg_rider_forecast_monthly' id='lg_rider_forecast_monthly_77D12CE0150F40F7BB3DA4C302B4CB43'>
            <properties context=''>
              <relation connection='bigquery.1lcka5m0nr7ud716tuusp1exfpuq (copy 2)' name='Custom SQL Query' type='text'>SELECT `lg_rider_forecast_monthly`.`additional_hours_needed` AS `additional_hours_needed`,
  `lg_rider_forecast_monthly`.`available_hours` AS `available_hours`,
  `lg_rider_forecast_monthly`.`avg_hpr` AS `avg_hpr`,
  `lg_rider_forecast_monthly`.`city_name` AS `city_name`,
  `lg_rider_forecast_monthly`.`country` AS `country`,
  `lg_rider_forecast_monthly`.`country_code` AS `country_code`,
  CAST(`lg_rider_forecast_monthly`.`month_date` AS TIMESTAMP) AS `month_date__lg_rider_forecast_monthly_`,
  `lg_rider_forecast_monthly`.`month_forecast` AS `month_forecast`,
  `lg_rider_forecast_monthly`.`monthly_churned_hours` AS `monthly_churned_hours`,
  `lg_rider_forecast_monthly`.`monthly_reactivated_hour` AS `monthly_reactivated_hour`,
  `lg_rider_forecast_monthly`.`monthly_worked_hours` AS `monthly_worked_hours`,
  CAST(`lg_rider_forecast_monthly`.`rider_hours_needed` AS FLOAT64) AS `rider_hours_needed`,
  `lg_rider_forecast_monthly`.`riders_needed` AS `riders_needed`
FROM `dhh---analytics-eu.bl_logistics`.`lg_rider_forecast_monthly` `lg_rider_forecast_monthly`</relation>
            </properties>
            <properties context='extract'>
              <relation name='lg_rider_forecast_monthly_77D12CE0150F40F7BB3DA4C302B4CB43' table='[Extract].[lg_rider_forecast_monthly_77D12CE0150F40F7BB3DA4C302B4CB43]' type='table' />
            </properties>
