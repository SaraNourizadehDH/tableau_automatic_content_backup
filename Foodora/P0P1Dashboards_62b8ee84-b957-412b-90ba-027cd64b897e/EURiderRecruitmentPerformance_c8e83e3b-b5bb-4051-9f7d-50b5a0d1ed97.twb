          <object caption='lg_rider_forecast' id='lg_rider_forecast_05E9DC469CBB4967AA7B3C079655148E'>
            <properties context=''>
              <relation connection='bigquery.1lcka5m0nr7ud716tuusp1exfpuq' name='lg_rider_forecast' table='[dhh---analytics-eu.bl_logistics].[lg_rider_forecast]' type='table' />
            </properties>
            <properties context='extract'>
              <relation name='lg_rider_forecast_05E9DC469CBB4967AA7B3C079655148E' table='[Extract].[lg_rider_forecast_05E9DC469CBB4967AA7B3C079655148E]' type='table' />
            </properties>
          </object>
          <object caption='lg_rider_supply_historic_weekly' id='lg_rider_supply_historic_weekly_180EB27455D742668FC4AA9F4057137C'>
            <properties context=''>
              <relation connection='bigquery.1lcka5m0nr7ud716tuusp1exfpuq' name='Custom SQL Query' type='text'><![CDATA[WITH countries AS (
  SELECT 
  countries.country_code,
  countries.country_name,
  cities.id AS city_id,
  cities.name as city_name
  FROM `fulfillment-dwh-production.curated_data_shared.countries` as countries
  LEFT JOIN UNNEST(countries.cities) AS cities
),

cvr_daily AS (
SELECT distinct 
FORMAT_DATE("%G-%V", DATE(DATETIME(applicants.created_at, applicants.timezone))) AS report_week_local,
applicants.country_code,
applicant_id,
country_name,
city_name,
created_date, 
location_name,
CASE WHEN TIMESTAMP_DIFF(approved_at, created_at, DAY) <<= 7 THEN 1 END AS CVR_7_day,
CASE WHEN TIMESTAMP_DIFF(approved_at, created_at, DAY) <<= 14 THEN 1 END AS CVR_14_day,
CASE WHEN TIMESTAMP_DIFF(approved_at, created_at, DAY) <<= 30 THEN 1 END AS CVR_30_day
FROM `fulfillment-dwh-production.curated_data_shared.applicants` as applicants
LEFT JOIN countries
ON applicants.country_code = countries.country_code
AND applicants.city_id = countries.city_id
),

CVR AS (
  SELECT 
  report_week_local,
  country_name,
  city_name,
  count(applicant_id) AS num_applicants,
  SUM(CVR_7_day) AS CVR_7_day,
  SUM(CVR_14_day) AS CVR_14_day,
  SUM(CVR_30_day) AS CVR_30_day
  FROM cvr_daily
  GROUP BY 1,2,3
)


SELECT `lg_rider_supply_historic_weekly`.`activated_riders_count` AS `activated_riders_count`,
  `lg_rider_supply_historic_weekly`.`active_riders` AS `active_riders`,
  `lg_rider_supply_historic_weekly`.`active_riders_l28d` AS `active_riders_l28d`,
  `lg_rider_supply_historic_weekly`.`active_riders_last_week` AS `active_riders_last_week`,
  `lg_rider_supply_historic_weekly`.`applicant_count` AS `applicant_count`,
  `lg_rider_supply_historic_weekly`.`at_risk_riders` AS `at_risk_riders`,
  `lg_rider_supply_historic_weekly`.`avg_time_hire_to_lead_day` AS `avg_time_hire_to_lead_day`,
  `lg_rider_supply_historic_weekly`.`avg_time_lead_to_activate_day` AS `avg_time_lead_to_activate_day`,
  `lg_rider_supply_historic_weekly`.`churned_riders` AS `churned_riders`,
  `lg_rider_supply_historic_weekly`.`city_name` AS `city_name`,
  `lg_rider_supply_historic_weekly`.`country` AS `country`,
  `lg_rider_supply_historic_weekly`.`evaluated_hours` AS `evaluated_hours`,
  `lg_rider_supply_historic_weekly`.`global_entity_id` AS `global_entity_id`,
  `lg_rider_supply_historic_weekly`.`hire_count` AS `hire_count`,
  `lg_rider_supply_historic_weekly`.`inactive_riders` AS `inactive_riders`,
  `lg_rider_supply_historic_weekly`.`no_show_hours_total` AS `no_show_hours_total`,
  `lg_rider_supply_historic_weekly`.`open_slots_assigned` AS `open_slots_assigned`,
  `lg_rider_supply_historic_weekly`.`open_slots_size` AS `open_slots_size`,
  `lg_rider_supply_historic_weekly`.`orders_number` AS `orders_number`,
  `lg_rider_supply_historic_weekly`.`planned_hours` AS `planned_hours`,
  `lg_rider_supply_historic_weekly`.`reactivated_riders` AS `reactivated_riders`,
  `lg_rider_supply_historic_weekly`.`report_week` AS `report_week`,
  `lg_rider_supply_historic_weekly`.`rider_referrals` AS `rider_referrals`,
  CAST(`lg_rider_supply_historic_weekly`.`riders_hours_needed` AS FLOAT64) AS `riders_hours_needed`,
  `lg_rider_supply_historic_weekly`.`stale_riders` AS `stale_riders`,
  `lg_rider_supply_historic_weekly`.`week_date` AS `week_date`,
  `lg_rider_supply_historic_weekly`.`yesterday` AS `yesterday`,
  num_applicants,
  CVR_7_day,
  CVR_14_day,
  CVR_30_day
FROM `dhh---analytics-eu.bl_logistics`.`lg_rider_supply_historic_weekly` `lg_rider_supply_historic_weekly` 
LEFT JOIN CVR
ON report_week = report_week_local
AND country = country_name
AND `lg_rider_supply_historic_weekly`.city_name = CVR.city_name]]></relation>
            </properties>
