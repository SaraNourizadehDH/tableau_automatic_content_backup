      </column>
      <column caption='Cost per Click' datatype='real' default-format='c#,##0.00&quot;€&quot;;-#,##0.00&quot;€&quot;' name='[Calculation_4060276554026270723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cost_eur]) / sum([clicks])' />
