      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4E25E9D37B504E47A2254229F2D76506'>
            <properties context=''>
              <relation connection='bigquery.1tekonu0jtp54u15qu8nf0ysm45l' name='Custom SQL Query' type='text'><![CDATA[WITH lao AS (
  SELECT
    global_entity_id,
    vendor_code,
    vendor_grade,
    activation_date,
    full_name_internal_non_pii AS fs
  FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated`
  WHERE is_closed
    AND is_won
    AND vendor_type = 'Restaurants'
    AND opportunity_business_type IN ("New Business", "Win Back")
  QUALIFY ROW_NUMBER() OVER (PARTITION BY global_entity_id, vendor_code ORDER BY opp_close_date_utc DESC) = 1
),

base AS (
  SELECT
    v.report_date,
    v.global_entity_id,
    v.chain_code,
    v.chain_name,
    v.vendor_code,
    v.vendor_name,
    v.vendor_type_classification,
    v.vendor_type_breakdown,
    i.vendor_grade,
    i.fs,
    i.activation_date,
    DATE_DIFF(v.report_date, i.activation_date, DAY) AS days_since_activation,
    v.active_product_count as sku,
    v.products_w_image_count as dlp,
    v.products_w_description_count as dld,
    SAFE_DIVIDE(v.products_w_image_count, v.active_product_count) AS dlp_pcnt,
    SAFE_DIVIDE(v.products_w_description_count, v.active_product_count) AS dld_pcnt,
  FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_vendors_inventory` AS v
  LEFT JOIN lao AS i
         ON v.global_entity_id = i.global_entity_id
        AND v.vendor_code = i.vendor_code
        AND v.report_date >>= i.activation_date
  WHERE i.activation_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, ISOWEEK), INTERVAL 112 DAY)
    AND i.activation_date << DATE_TRUNC(CURRENT_DATE, ISOWEEK) -- 16 weeks
)

SELECT
  report_date,
  DATE_TRUNC(activation_date, ISOWEEK) AS activation_week,
  global_entity_id,
  chain_code,
  chain_name,
  vendor_code,
  vendor_name,
  fs,
  vendor_type_classification,
  vendor_type_breakdown,
  vendor_grade,
  activation_date,
  days_since_activation,
  sku,
  dlp,
  dld,
  dlp_pcnt,
  dld_pcnt,
FROM base
WHERE report_date = CURRENT_DATE-1]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='dlp/d agg' inline='true' name='federated.0z6mr870u9u2o81d955ye1y8ybdz' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0wm5ss71979wgx13694zp01imint'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh---analytics-apac' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='pandata_report' server-oauth='' username='felicia.anto@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0wm5ss71979wgx13694zp01imint' name='Custom SQL Query' type='text'><![CDATA[WITH lao AS (
SELECT
global_entity_id,
vendor_code,
vendor_grade,
activation_date
FROM `fulfillment-dwh-production.pandata_report.sales_lead_account_opp_aggregated`
WHERE is_closed
AND is_won
AND vendor_type = 'Restaurants'
AND opportunity_business_type IN ("New Business", "Win Back")
QUALIFY ROW_NUMBER() OVER (PARTITION BY global_entity_id, vendor_code ORDER BY opp_close_date_utc DESC) = 1
),

base AS (
SELECT
v.report_date,
v.global_entity_id,
v.vendor_code,
v.vendor_type_classification,
v.vendor_type_breakdown,
i.vendor_grade,
i.activation_date,
DATE_DIFF(v.report_date, i.activation_date, DAY) AS days_since_activation,
v.active_product_count as sku,
v.products_w_image_count as dlp,
v.products_w_description_count as dld,
SAFE_DIVIDE(v.products_w_image_count, v.active_product_count) AS dlp_pcnt,
SAFE_DIVIDE(v.products_w_description_count, v.active_product_count) AS dld_pcnt,
FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_vendors_inventory` AS v
LEFT JOIN lao AS i
ON v.global_entity_id = i.global_entity_id
AND v.vendor_code = i.vendor_code
AND v.report_date >>= i.activation_date
WHERE i.activation_date >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE, ISOWEEK), INTERVAL 112 DAY)
AND i.activation_date << DATE_TRUNC(CURRENT_DATE, ISOWEEK) -- 16 weeks
),

final AS (
SELECT
report_date,
global_entity_id,
vendor_code,
vendor_type_classification,
vendor_type_breakdown,
vendor_grade,
activation_date,
days_since_activation,
sku,
dlp,
dld,
dlp_pcnt,
dld_pcnt,
dlp_pcnt >>= 0.3 AS dlp_30,
dlp_pcnt >>= 0.5 AS dlp_50,
dlp_pcnt >>= 0.8 AS dlp_80,
dlp_pcnt = 1 AS dlp_100,
dld_pcnt >>= 0.3 AS dld_30,
dld_pcnt >>= 0.5 AS dld_50,
dld_pcnt >>= 0.8 AS dld_80,
dld_pcnt = 1 AS dld_100
FROM base
WHERE days_since_activation IN (1,8,15,22,29,60,90)
)

SELECT
DATE_TRUNC(activation_date, ISOWEEK) AS activation_week,
global_entity_id,
vendor_grade,
days_since_activation,
vendor_type_classification,
vendor_type_breakdown,
COUNT(DISTINCT vendor_code) AS vendor_cnt,
AVG(sku) AS avg_sku,
AVG(dlp_pcnt) AS avg_dlp_pcnt,
AVG(dld_pcnt) AS avg_dld_pcnt,
COUNT(DISTINCT IF(dlp_30, vendor_code, NULL)) AS dlp_30_vendor_cnt,
COUNT(DISTINCT IF(dlp_50, vendor_code, NULL)) AS dlp_50_vendor_cnt,
COUNT(DISTINCT IF(dlp_80, vendor_code, NULL)) AS dlp_80_vendor_cnt,
COUNT(DISTINCT IF(dlp_100, vendor_code, NULL)) AS dlp_100_vendor_cnt,
COUNT(DISTINCT IF(dld_30, vendor_code, NULL)) AS dld_30_vendor_cnt,
COUNT(DISTINCT IF(dld_50, vendor_code, NULL)) AS dld_50_vendor_cnt,
COUNT(DISTINCT IF(dld_80, vendor_code, NULL)) AS dld_80_vendor_cnt,
COUNT(DISTINCT IF(dld_100, vendor_code, NULL)) AS dld_100_vendor_cnt
FROM final
WHERE vendor_grade IS NOT NULL
GROUP BY 1,2,3,4,5,6]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
