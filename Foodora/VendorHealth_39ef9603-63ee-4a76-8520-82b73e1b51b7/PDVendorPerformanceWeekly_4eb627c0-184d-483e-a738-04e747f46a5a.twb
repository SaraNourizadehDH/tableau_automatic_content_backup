      <column caption='test1' datatype='integer' name='[Calculation_215961740965474305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;    ISOWEEK(NOW()) = 1 THEN 54 - 1 &#10;ELSEIF ISOWEEK(NOW()) = 2 THEN 1&#10;ELSEIF ISOWEEK(NOW()) = 3 THEN 2&#10;ELSE ISOWEEK(NOW()) - 1 &#10;END' />
