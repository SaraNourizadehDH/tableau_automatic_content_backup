    <worksheet name='MTD Zombie Vendors'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#d70f64'>1</run>
            <run>Æ&#10;</run>
            <run fontcolor='#d70f64' fontsize='9'>1</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Operations MTD' name='federated.0a7nlxi0qd1zud1am8iny1wsyec6' />
            <datasource caption='[BQ] Ops Performance Summary' name='federated.1vwzzdx1ipz2aa1cjrceo0bb96ua' />
          </datasources>
          <datasource-dependencies datasource='federated.0a7nlxi0qd1zud1am8iny1wsyec6'>
            <column caption='MTD' datatype='boolean' name='[Calculation_215961741045485577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [month], today() - 1) = 0&#10;AND&#10;DAY([month]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column caption='PMTD' datatype='boolean' name='[Calculation_215961741045592074]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [month], today() - 1) = 1&#10;AND&#10;DAY([month]) &lt;= DAY(TODAY()-1)' />
            </column>
            <column aggregation='Sum' caption='1' datatype='integer' name='[Calculation_215961741048295437]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='MTD % Δ' />
              </aliases>
            </column>
            <column caption='MTD Zombie Vendors' datatype='string' name='[MOM Non Zombie Vendors (copy)_614952495873900551]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_215961741045485577], [count_of_past_30_day_zombie_vendor], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_215961741045592074], [count_of_past_30_day_zombie_vendor], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_215961741045592074], [count_of_past_30_day_zombie_vendor], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([Calculation_215961741045485577], [count_of_past_30_day_zombie_vendor], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_215961741045592074], [count_of_past_30_day_zombie_vendor], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_215961741045592074], [count_of_past_30_day_zombie_vendor], 0)&#10;) * 100&#10;,2)&#10;)' />
            </column>
            <column caption='MTD Zombie Vendors Indicator' datatype='real' name='[MOM Non Zombie Vendors Indicator (copy)_614952495873912840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM(&#10;        iif([Calculation_215961741045485577], [count_of_past_30_day_zombie_vendor], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_215961741045592074], [count_of_past_30_day_zombie_vendor], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_215961741045592074], [count_of_past_30_day_zombie_vendor], 0)&#10;)' />
            </column>
            <column datatype='string' name='[activation_status]' role='dimension' type='nominal' />
            <column datatype='integer' name='[count_of_past_30_day_zombie_vendor]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column datatype='date' name='[month]' role='dimension' type='ordinal' />
