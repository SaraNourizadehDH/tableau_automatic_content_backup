            <column-instance column='[MOM Non Zombie Vendors (copy)_614952495873900551]' derivation='User' name='[usr:MOM Non Zombie Vendors (copy)_614952495873900551:nk]' pivot='key' type='nominal' />
            <column-instance column='[MOM Non Zombie Vendors Indicator (copy)_614952495873912840]' derivation='User' name='[usr:MOM Non Zombie Vendors Indicator (copy)_614952495873912840:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
