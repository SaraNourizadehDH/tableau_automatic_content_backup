      <aliases enabled='yes' />
      <column caption='MTD' datatype='boolean' name='[Calculation_215961741045485577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [month], today() - 1) = 0&#10;AND&#10;DAY([month]) &lt;= DAY(TODAY()-1)' />
      </column>
      <column caption='PMTD' datatype='boolean' name='[Calculation_215961741045592074]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [month], today() - 1) = 1&#10;AND&#10;DAY([month]) &lt;= DAY(TODAY()-1)' />
      </column>
      <column aggregation='Sum' caption='1' datatype='integer' name='[Calculation_215961741048295437]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='1' />
        <aliases>
          <alias key='1' value='MTD % Δ' />
        </aliases>
      </column>
      <column caption='MTD Active Vendors' datatype='string' name='[Calculation_215961741060501518]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_215961741045485577], [active_vendors], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_215961741045592074], [active_vendors], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_215961741045592074], [active_vendors], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([Calculation_215961741045485577], [active_vendors], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_215961741045592074], [active_vendors], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_215961741045592074], [active_vendors], 0)&#10;) * 100&#10;,2)&#10;)' />
      </column>
      <column caption='MTD Active Vendors Indicator' datatype='real' name='[Calculation_215961741060927503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    SUM(&#10;        iif([Calculation_215961741045485577], [active_vendors], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_215961741045592074], [active_vendors], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_215961741045592074], [active_vendors], 0)&#10;)' />
      </column>
      <column caption='MTD Onboarded Vendors' datatype='string' name='[Calculation_215961741061091344]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_215961741045485577], [total_new_sf_vendors], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_215961741045592074], [total_new_sf_vendors], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_215961741045592074], [total_new_sf_vendors], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([Calculation_215961741045485577], [total_new_sf_vendors], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_215961741045592074], [total_new_sf_vendors], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_215961741045592074], [total_new_sf_vendors], 0)&#10;) * 100&#10;,2)&#10;)' />
      </column>
      <column caption='MTD Onboarded Vendors Indicator' datatype='real' name='[Calculation_215961741061283857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    SUM(&#10;        iif([Calculation_215961741045485577], [total_new_sf_vendors], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_215961741045592074], [total_new_sf_vendors], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_215961741045592074], [total_new_sf_vendors], 0)&#10;)' />
      </column>
      <column caption='MTD Deactivated Vendors' datatype='string' name='[Calculation_215961741061521426]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    SUM(&#10;        iif([Calculation_215961741045485577], [total_terminated_vendors], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_215961741045592074], [total_terminated_vendors], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_215961741045592074], [total_terminated_vendors], 0)&#10;) &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;    SUM(&#10;        iif([Calculation_215961741045485577], [total_terminated_vendors], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_215961741045592074], [total_terminated_vendors], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_215961741045592074], [total_terminated_vendors], 0)&#10;) * 100&#10;,2)&#10;)' />
      </column>
      <column caption='MTD Deactivated Vendors Indicator' datatype='real' name='[Calculation_215961741061902355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    SUM(&#10;        iif([Calculation_215961741045485577], [total_terminated_vendors], 0)&#10;    )&#10;    -&#10;    SUM(&#10;        iif([Calculation_215961741045592074], [total_terminated_vendors], 0)&#10;    )&#10;)&#10;&#10;/&#10;&#10;SUM(&#10;    iif([Calculation_215961741045592074], [total_terminated_vendors], 0)&#10;)' />
      </column>
      <column caption='MTD % Deactivated Vendors' datatype='string' name='[Calculation_215961741062242324]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if&#10;(&#10;    (SUM(iif([Calculation_215961741045485577], [total_terminated_vendors], 0)) / SUM(iif([Calculation_215961741045485577], [active_vendors], 0)))&#10;    /&#10;    (SUM(iif([Calculation_215961741045592074], [total_terminated_vendors], 0)) / SUM(iif([Calculation_215961741045592074], [active_vendors], 0)))&#10;)&#10;-1&#10; &lt;= 0&#10;then &apos;▼ &apos; &#10;ELSE &apos;▲ &apos; &#10;end&#10;&#10;+&#10;str(round(&#10;(&#10;(&#10;    (SUM(iif([Calculation_215961741045485577], [total_terminated_vendors], 0)) / SUM(iif([Calculation_215961741045485577], [active_vendors], 0)))&#10;    /&#10;    (SUM(iif([Calculation_215961741045592074], [total_terminated_vendors], 0)) / SUM(iif([Calculation_215961741045592074], [active_vendors], 0)))&#10;)&#10;-1&#10;) * 100&#10;,2)&#10;)' />
      </column>
      <column caption='MTD % Deactivated Vendors Indicator' datatype='real' name='[Calculation_215961741062504469]' role='measure' type='quantitative'>
