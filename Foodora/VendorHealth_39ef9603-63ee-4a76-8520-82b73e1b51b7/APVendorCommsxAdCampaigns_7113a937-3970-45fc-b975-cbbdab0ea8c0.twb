        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1e4l57u0j6ps75144bvu30aqpdwc' name='Custom SQL Query' type='text'>SELECT 
  table_catalog,
  table_schema,
  table_name,
  CONCAT(table_catalog,&quot;.&quot;,table_schema,&quot;.&quot;, table_name ) AS bq_table_name,
  column_name,
  data_type,
  description, 
  DATE(DATETIME(TIMESTAMP_MILLIS(t.last_modified_time))) AS last_refreshed_date,
  DATETIME(TIMESTAMP_MILLIS(t.creation_time)) AS creation_time,
  DATETIME(TIMESTAMP_MILLIS(t.last_modified_time)) AS last_modified_time,
  IF((DATE(TIMESTAMP_MILLIS(t.last_modified_time)) = CURRENT_DATE), TRUE, FALSE) AS is_data_fresh
FROM `fulfillment-dwh-production.pandata_report.INFORMATION_SCHEMA.COLUMN_FIELD_PATHS` AS c
LEFT JOIN `fulfillment-dwh-production.pandata_report.__TABLES__` AS t
        ON c.table_name = t.table_id
WHERE table_name IN (
  &quot;regional_apac_vendor_pe_insider_ad_output_metric&quot;,
  &quot;regional_apac_vendor_pe_insider_ad_output_info&quot;,
  &quot;regional_apac_vendor_pe_insider_ad_input_metric&quot;)
ORDER BY table_name</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1e4l57u0j6ps75144bvu30aqpdwc' name='Custom SQL Query' type='text'>SELECT 
