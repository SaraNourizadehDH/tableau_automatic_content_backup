        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0lhy5160qmnjlx1fryxyo0o9v7tv' name='Custom SQL Query' type='text'>SELECT
 report_month,
 global_entity_id,
  CASE
    WHEN global_entity_id = &quot;FP_MM&quot; THEN &quot;Myanmar&quot;
    WHEN global_entity_id = &quot;FP_PK&quot; THEN &quot;Pakistan&quot;
    WHEN global_entity_id = &quot;FP_SG&quot; THEN &quot;Singapore&quot;
    WHEN global_entity_id = &quot;FP_KH&quot; THEN &quot;Cambodia&quot;
    WHEN global_entity_id = &quot;FP_HK&quot; THEN &quot;Hong Kong&quot;
    WHEN global_entity_id = &quot;FP_PH&quot; THEN &quot;Philippines&quot;
    WHEN global_entity_id = &quot;FP_TH&quot; THEN &quot;Thailand&quot;
    WHEN global_entity_id = &quot;FP_TW&quot; THEN &quot;Taiwan&quot;
    WHEN global_entity_id = &quot;FP_BD&quot; THEN &quot;Bangladesh&quot;
    WHEN global_entity_id = &quot;FP_LA&quot; THEN &quot;Laos&quot;
    WHEN global_entity_id = &quot;FP_MY&quot; THEN &quot;Malaysia&quot;
  END country, 
  campaign_topic,
  campaign_type,
  event_name,
  event_source,
  MAX(ppu_per_channel) AS ppu_per_channel,
  COUNT(DISTINCT pd_vendor_uuid) AS vendor_count
FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_insider_ad_input_metric` 
GROUP BY
 report_month,
 global_entity_id,
 country,
 campaign_topic,
 campaign_type,
 event_name,
 event_source
HAVING country IS NOT NULL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
