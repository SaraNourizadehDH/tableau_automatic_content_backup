      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98666' id='16' param='horz' type-v2='layout-flow' w='98666' x='667' y='667'>
            <zone h='98666' id='9' type-v2='layout-basic' w='98666' x='667' y='667'>
              <zone h='5916' id='3' type-v2='text' w='19081' x='667' y='667'>
                <formatted-text>
                  <run bold='true' fontsize='15'>foodpanda</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#e6e6e6' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='31917' id='6' type-v2='text' w='98666' x='667' y='6583'>
                <formatted-text>
                  <run fontcolor='#000000' fontsize='10'>This dashboard provides campaign performance results (engagement and business impact) for different Ad Campaigns.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff2b85' fontsize='10' underline='true'>CPC</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff0072' fontsize='10'>-&gt; </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Pandaclicks Acquisition: </run>
                  <run fontcolor='#000000' fontsize='10'>Monthly campaign to acquire new CPC vendors</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff0072' fontsize='10'>-&gt; </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Pandaclicks Topup: </run>
                  <run fontcolor='#000000' fontsize='10'>Mid-month (15th) campaign to encourage vendors to top-up their CPC budget when 70% is used up</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff0072' fontsize='10'>-&gt; </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Pandaclicks Churn: </run>
                  <run fontcolor='#000000' fontsize='10'>Monthly campaign to re-engage churned CPC vendors</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff2b85' fontsize='10' underline='true'>Pandabox</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff0072' fontsize='10'>-&gt; </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Pandabox Acquisition: </run>
                  <run fontcolor='#000000' fontsize='10'>Monthly campaign to acquire new Pandabox vendors</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff0072' fontsize='10'>-&gt; </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Pandabox Churn: </run>
                  <run fontcolor='#000000' fontsize='10'>Monthly campaign to re-engage churned Pandabox  vendors</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff2b85' fontsize='10' underline='true'>Deals Targeting</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>Monthly acquisition campaign to encourage existing Pandabox vendors to adopt deals targeting</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff2b85' fontsize='10' underline='true'>Ad Credits</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>Monthly acquisition campaign to promote CPC adoption through ad credits. Ad credits allow vendors to offset their CPC budget </run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
