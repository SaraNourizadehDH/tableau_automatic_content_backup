              <calculation class='tableau' formula='SUM([final_revenue])/SUM([overall_final_revenue])' />
            </column>
            <column caption='Vendor Perc' datatype='real' default-format='p0.0%' name='[Calculation_3835096618450120704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_vendors])/SUM([overall_total_vendors])' />
            </column>
