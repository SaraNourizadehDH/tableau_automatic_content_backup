      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/APVendorCommsxAdCampaigns/DescriptionMetricDefinitionsDataQualityChecks?rev=' id='DescriptionMetricDefinitionsDataQualityChecks' path='/t/Foodora/workbooks/APVendorCommsxAdCampaigns' revision='' site='Foodora' />
