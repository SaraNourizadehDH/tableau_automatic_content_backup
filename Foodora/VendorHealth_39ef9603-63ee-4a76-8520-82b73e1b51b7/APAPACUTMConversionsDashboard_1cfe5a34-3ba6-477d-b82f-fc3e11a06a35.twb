        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0j6h4vo1tbavhj1g1mreb0skx8kn' name='Custom SQL Query' type='text'>SELECT DISTINCT
    ga4.session_date_utc,
    ga4.session_id,
    ga4.vp_uuid,
    ga4.global_entity_id,
    ga4.pd_vendor_uuid,
    ga4.is_chain_vendor,
    ga4.chain_code,
    events.campaign_param AS campaign,
    events.source_param AS traffic_source,
    events.medium_param AS traffic_medium,
FROM `fulfillment-dwh-production.pandata_report.regional_apac_vendor_pe_portal_ga4_sessions` AS ga4
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_sales_revenue.vp_ga_fct_main` AS events 
       ON ga4.session_id = events.session_id
WHERE events.campaign_param LIKE &apos;%vxp%&apos;
   OR events.campaign_param LIKE &apos;%apsed%&apos;
   OR events.campaign_param LIKE &apos;%ewuser%&apos;
   OR events.campaign_param LIKE &apos;%dashboard%&apos;
   OR events.medium_param LIKE &apos;%pandaconnect%&apos;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0j6h4vo1tbavhj1g1mreb0skx8kn' name='Custom SQL Query' type='text'>SELECT DISTINCT
