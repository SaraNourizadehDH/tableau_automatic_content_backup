      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_CE6381215C594B128F2EF2EA0DDDCF1B'>
            <properties context=''>
              <relation connection='bigquery.1llykj401vfm831gtzh5o1l6w2pn' name='Custom SQL Query' type='text'>SELECT DISTINCT
    ga4.session_date_utc,
    ga4.session_id,
    ga4.vp_uuid,
    ga4.global_entity_id,
    ga4.pd_vendor_uuid,
    ga4.is_chain_vendor,
    ga4.chain_code,
    events.source_param AS traffic_source,
    events.medium_param AS traffic_medium,
    CASE
      WHEN events.campaign_param = &apos;bd_d1_l1&apos; THEN	&apos;BD Uni RP&apos;
      WHEN events.campaign_param = &apos;bd_d12_l1&apos; THEN	&apos;BD pandaclicks &apos;
      WHEN events.campaign_param = &apos;bd_d12_l2&apos; THEN	&apos;BD Uni pandaclicks &apos;
      WHEN events.campaign_param = &apos;bd_d12_l3&apos; THEN	&apos;KH pandaclicks &apos;
      WHEN events.campaign_param = &apos;bd_d12_l4&apos; THEN	&apos;BD Uni discounts&apos;
      WHEN events.campaign_param = &apos;bd_d12_l5&apos; THEN	&apos;BD discounts&apos;
      WHEN events.campaign_param = &apos;bd_d18_l1&apos; THEN	&apos;BD invoice&apos;
      WHEN events.campaign_param = &apos;bd_d18_l2&apos; THEN	&apos;BD Uni invoice&apos;
      WHEN events.campaign_param = &apos;bd_d18_l3&apos; THEN	&apos;BD invoice&apos;
      WHEN events.campaign_param = &apos;bd_d2_l1&apos; THEN	&apos;BD Uni device&apos;
      WHEN events.campaign_param = &apos;bd_d24_l1&apos; THEN	&apos;BD reports&apos;
      WHEN events.campaign_param = &apos;bd_d24_l2&apos; THEN	&apos;BD Uni sales reports&apos;
      WHEN events.campaign_param = &apos;bd_d24_l3&apos; THEN	&apos;BD Uni operations reports&apos;
      WHEN events.campaign_param = &apos;bd_d24_l4&apos; THEN	&apos;BD Uni customers reports&apos;
      WHEN events.campaign_param = &apos;bd_d24_l5&apos; THEN	&apos;BD reports&apos;
      WHEN events.campaign_param = &apos;bd_d29_l1&apos; THEN	&apos;BD help center&apos;
      WHEN events.campaign_param = &apos;bd_d29_l2&apos; THEN	&apos;BD uni help center&apos;
