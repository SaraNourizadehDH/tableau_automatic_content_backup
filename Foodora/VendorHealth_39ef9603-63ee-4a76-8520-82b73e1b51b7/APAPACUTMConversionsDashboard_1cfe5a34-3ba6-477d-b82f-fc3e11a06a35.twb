      <column caption='chain_count' datatype='integer' name='[Calculation_1506454081073295361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_chain_vendor] THEN [global_entity_id]+&quot;_&quot;+[chain_code] END)' />
      </column>
      <column caption='single_count' datatype='integer' name='[Calculation_1506454081073487874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT [is_chain_vendor] THEN [pd_vendor_uuid] END)' />
      </column>
      <column caption='highband_count' datatype='integer' name='[Calculation_1506454081073606659]' role='measure' type='quantitative'>
