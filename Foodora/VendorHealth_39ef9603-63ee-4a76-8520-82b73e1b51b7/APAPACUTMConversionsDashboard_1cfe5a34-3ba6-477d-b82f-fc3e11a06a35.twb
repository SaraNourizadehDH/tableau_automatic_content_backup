      </column>
      <column caption='weighted_count' datatype='integer' name='[Calculation_1506454081073733636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_chain_vendor] THEN [global_entity_id]+&quot;_&quot;+[chain_code] ELSE [pd_vendor_uuid] END)' />
      </column>
