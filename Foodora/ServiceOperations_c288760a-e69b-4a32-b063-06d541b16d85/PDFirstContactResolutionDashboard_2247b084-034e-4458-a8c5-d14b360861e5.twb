          <datasource-dependencies datasource='federated.0wcbjd40eg34uo1gnwtrv05hyddp'>
            <column caption='2nd Dimension ' datatype='string' name='[1st Dimension (copy)_725079608171589637]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[1st Dimension  (copy)_4614711940539641856]&#10;when &apos;Country&apos; THEN [country]&#10;when &apos;Company Name&apos; THEN [company_name]&#10;when &apos;Date&apos; then [Calculation_456271002456420372]&#10;when &apos;Language&apos; then [contact_language]&#10;when &apos;Vertical Type&apos; then [vertical_type]&#10;when &apos;Skill Level&apos; then [skill_level]&#10;when &apos;Channel&apos; then [channel]&#10;when &apos;Agent Category&apos; then [agent_category]&#10;when &apos;CCR1&apos; then [ccr1]&#10;when &apos;CCR2&apos; then [ccr2]&#10;when &apos;CCR3&apos; then [ccr3]&#10;when &apos;LCR&apos; then [Calculation_1106829991229349888]&#10;WHEN &apos;Date&apos; then [Calculation_456271002456420372]&#10;WHEN &apos;Agent Category&apos; then [agent_category]&#10;WHEN &apos;BPO&apos; then [bpo]&#10;end' />
            </column>
            <column caption='Local Contact Reason' datatype='string' name='[Calculation_1106829991229349888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;NULL&quot;' />
            </column>
            <column caption='Non-FCR Contacts' datatype='integer' name='[Calculation_1943373619328094209 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3169619403998597120 1] - [Calculation_4739334980748742656 1]' />
            </column>
            <column caption='Non-FCR %' datatype='real' default-format='p0.00%' name='[Calculation_1943373619328659458 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1943373619328094209 1] / [Calculation_3169619403998597120 1]' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_2175590476403822593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date] = &apos;Monthly&apos;&#10;THEN &#10;IF month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#10;END&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_2175590476404076546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [class_date]= &apos;Weekly&apos;&#10;THEN&#10;IF &#10;ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#10;END&#10;END' />
            </column>
            <column caption='FCR Total Contacts' datatype='integer' name='[Calculation_3169619403998597120 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ticket_count_fcr])' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [class_date]&#13;&#10; when &apos;Weekly&apos; then [Calculation_2175590476404076546]&#13;&#10; when &apos;Monthly&apos; then [Calculation_2175590476403822593]&#13;&#10;end' />
            </column>
            <column caption='FCR First Contacts' datatype='integer' name='[Calculation_4739334980748742656 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_fcr])' />
            </column>
            <column caption='FCR %' datatype='real' default-format='p0.00%' name='[Calculation_5662924745547104256 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ EXCLUDE [Calculation_1106829991229349888] :SUM([num_fcr])}) /&#10;SUM({ EXCLUDE [Calculation_1106829991229349888] :SUM([ticket_count_fcr])})' />
            </column>
