      <column caption='Month' datatype='string' name='[Calculation_2175590476403822593]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [class_date] = &apos;Monthly&apos;&#10;THEN &#10;IF month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#10;END&#10;END' />
