      <column caption='KPI RCR Filter' datatype='string' name='[KPI Filter (copy)_622341232391938052]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI (copy)_622341232391819267]&#13;&#10;WHEN &apos;Incoming Chats&apos; THEN &apos;Incoming Chats&apos;&#13;&#10;WHEN &apos;Incoming Chats % of Total&apos; THEN &apos;Incoming Chats % of Total&apos;&#13;&#10;WHEN &apos;AHT min&apos; THEN &apos;AHT min&apos;&#13;&#10;WHEN &apos;AQT sec&apos; THEN &apos;AQT sec&apos;&#13;&#10;WHEN &apos;Avg. FRT Min&apos; THEN &apos;-q: Avg. FRT Min&apos;&#13;&#10;WHEN &apos;Avg. Agent FRT sec&apos; THEN &apos;Avg. Agent FRT sec&apos;&#13;&#10;WHEN &apos;Promotor RSAT %&apos; THEN &apos;Promotor RSAT %&apos;&#13;&#10;WHEN &apos;Promotor RSAT % of Total&apos; THEN &apos;Promotor RSAT % of Total&apos;&#13;&#10;WHEN &apos;Passive RSAT %&apos; THEN &apos;Passive RSAT %&apos;&#13;&#10;WHEN &apos;Passive RSAT % of Total&apos; THEN &apos;Passive RSAT % of Total&apos;&#13;&#10;WHEN &apos;Detractor RSAT %&apos; THEN &apos;Detractor RSAT %&apos;&#13;&#10;WHEN &apos;Detractor RSAT % of Total&apos; THEN &apos;Detractor RSAT % of Total&apos;&#13;&#10;END' />
