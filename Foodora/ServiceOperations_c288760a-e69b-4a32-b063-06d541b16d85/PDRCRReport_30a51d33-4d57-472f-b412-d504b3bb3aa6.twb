    <worksheet name='RCR table 2'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>RCR Table</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='preprocessing__service_operations__rcr_agg_level (pandata_report)' name='federated.1th1ngg0e4axqj1awxd3y0ovihhn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1th1ngg0e4axqj1awxd3y0ovihhn'>
            <column caption='-b: OD Gross Orders' datatype='integer' name='[-a: Gross Orders (copy)_1431159578051727360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE &#10;[contact_language],&#10;[rcr1],&#10;[rcr2],&#10;[rcr3] ,&#10;[local_contact_reason],&#10;[bpo],&#10;[channel]:&#10;SUM(IIF([delivery_type] = &quot;Own Delivery&quot;, [gross_order_count], 0))}' />
            </column>
            <column caption='-a: I/O %' datatype='real' default-format='p0.00%' name='[-d: I/O % (copy)_1431159578052665345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([contacts_count]) / SUM([-a: Gross Orders (copy)_1431159578051727360])' />
            </column>
            <column caption='-c: Incidents Distribution ' datatype='real' default-format='p0.00%' name='[Calculation_105412383765929986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([contacts_count]) / SUM({ EXCLUDE [rcr1], [rcr2], [rcr3], [local_contact_reason]: SUM([contacts_count])})' />
            </column>
            <column caption='-d: Incidents' datatype='integer' name='[Calculation_105412383766605827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([contacts_count])' />
            </column>
            <column caption='RCR' datatype='string' name='[Calculation_1997909399006457856]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;RCR&quot;' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_456271002456092691]&#13;&#10; when &apos;week&apos; then [Calculation_456271002456002578]&#13;&#10; when &apos;month&apos; then [Calculation_456271002455613457]&#10; when &apos;quarter&apos; then [Day (copy)_169096155160829952]&#13;&#10;end' />
            </column>
            <column caption='BPO' datatype='string' name='[Calculation_622341232362639361]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LOWER([bpo]) = &apos;not bpo data&apos; OR ISNULL([bpo]) THEN &apos;No BPO Data&apos;&#13;&#10;ELSEIF CONTAINS(LOWER(TRIM([bpo])), &apos;thailand - bpo&apos;) THEN &apos;Thailand BPO&apos;&#13;&#10;ELSEIF CONTAINS(LOWER([bpo]), &apos;in house&apos;) THEN &apos;SSC&apos;&#13;&#10;ELSEIF CONTAINS([bpo], &apos;-&apos;) THEN TRIM(SPLIT([bpo],&apos;-&apos;,2))&#13;&#10;ELSE [bpo] &#13;&#10;END' />
            </column>
            <column caption='Quarter' datatype='string' name='[Day (copy)_169096155160829952]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE(DATETRUNC(&apos;quarter&apos;, DATE([report_date]))))' />
            </column>
            <column caption='Agent Category' datatype='string' name='[agent_category]' role='dimension' type='nominal' />
            <column caption='Bpo' datatype='string' name='[bpo]' role='dimension' type='nominal' />
            <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
            <column caption='Brand' datatype='string' name='[company_name]' role='dimension' type='nominal' />
            <column caption='Contact Language' datatype='string' name='[contact_language]' role='dimension' type='nominal' />
            <column caption='Contacts Count' datatype='integer' name='[contacts_count]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
