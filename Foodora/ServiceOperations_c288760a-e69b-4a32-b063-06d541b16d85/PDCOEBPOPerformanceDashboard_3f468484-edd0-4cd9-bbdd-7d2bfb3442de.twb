    <worksheet name='Customer Overall'>
      <table>
        <view>
          <datasources>
            <datasource caption='service_operations__coe_bpo_performance_report' name='federated.1putw4c1ynuu4y17poapw1oyjvmf' />
          </datasources>
          <datasource-dependencies datasource='federated.1putw4c1ynuu4y17poapw1oyjvmf'>
            <column caption='CSAT % (Non-Live)' datatype='real' default-format='p0.00%' name='[CSAT % (Livel) (copy)_6562659517111603216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([csat_non_live_promotor]) / SUM([total_non_live_csat_reponses])' />
            </column>
            <column caption='CSAT % (Live)' datatype='real' default-format='p0.00%' name='[CSAT % (Overall) (copy)_6562659517111373839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([csat_live_promotor]) / SUM([total_live_csat_reponses])' />
            </column>
            <column caption='Chat SLA Customer %' datatype='real' default-format='p0.00%' name='[Calculation_3601472393117913095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sla_30s_chat_cs])/SUM([inbound_chats_cs])' />
            </column>
            <column caption='Non-Live SLA Customer % (24h)' datatype='real' default-format='p0.00%' name='[Calculation_3601472393121980426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sla_24hrs_email_cs]) / SUM([inbound_emails_cs])' />
            </column>
            <column caption='CSAT % (Overall)' datatype='real' default-format='p0.00%' name='[Calculation_3601472393122545675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6562659517110784014]) / SUM([total_csat_reponses])' />
            </column>
            <column caption='Chat AHT Customer (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3601472393124265996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_aht_min_customer]) / SUM([inbound_chats_cs])' />
            </column>
            <column caption='Chat AWUT Customer (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3601472393124777997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_wrap_up_min_customer]) / SUM([inbound_chats_cs])' />
            </column>
            <column caption='QA Score Customer (avg)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6562659516870361088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_qa_score_customer]) / SUM([total_evaluations_customer])' />
            </column>
            <column caption='CSAT Promoter Overall' datatype='integer' name='[Calculation_6562659517110784014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[csat_live_promotor]+[csat_non_live_promotor]' />
            </column>
            <column caption='Month-Year' datatype='string' name='[Calculation_6562659517228363821]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_month]) &lt; 10 then str(YEAR([report_month])) + &quot;-0&quot; + str(month([report_month]))&#10;ELSE str(YEAR([report_month])) + &quot;-&quot; + str(month([report_month]))&#10;END' />
            </column>
            <column caption='Is Current Month' datatype='boolean' name='[L2Month (copy)_6562659517166792748]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [report_month]) = DATETRUNC(&apos;month&apos;, TODAY())' />
            </column>
            <column caption='CSAT Reponses # ' datatype='integer' name='[RSAT Reponses # (copy)_6562659517112610834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_csat_reponses]' />
            </column>
            <column caption='CSAT Response Rate %' datatype='real' default-format='p0.00%' name='[VSAT Response Rate % (copy)_6562659517112094737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_csat_reponses])/SUM([monthly_incidents_customer])' />
            </column>
            <column caption='a-Gross Order' datatype='integer' name='[a-Gross Order (copy)_6562659517100290052]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[monthly_gross_order_customer]' />
