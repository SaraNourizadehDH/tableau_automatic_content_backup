    <worksheet name='Rider Overall'>
      <table>
        <view>
          <datasources>
            <datasource caption='service_operations__coe_bpo_performance_report' name='federated.1putw4c1ynuu4y17poapw1oyjvmf' />
          </datasources>
          <datasource-dependencies datasource='federated.1putw4c1ynuu4y17poapw1oyjvmf'>
            <column caption='RSAT % (Live)' datatype='real' default-format='p0.00%' name='[CSAT % (Live) (copy)_6562659517120512030]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rsat_live_promotor]) / SUM([total_live_rsat_reponses])' />
            </column>
            <column caption='RSAT % (Non-Live)' datatype='real' default-format='p0.00%' name='[CSAT % (Non-Live) (copy)_6562659517120544799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rsat_non_live_promotor]) / SUM([total_non_live_rsat_reponses])' />
            </column>
            <column caption='RSAT % (Overall)' datatype='real' default-format='p0.00%' name='[CSAT % (Overall) (copy)_6562659517120561184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([CSAT Promoter Overall (copy)_6562659517120569377]) / SUM([total_rsat_reponses])' />
            </column>
            <column caption='RSAT Promoter Overall' datatype='integer' name='[CSAT Promoter Overall (copy)_6562659517120569377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[rsat_live_promotor]+[rsat_non_live_promotor]' />
            </column>
            <column caption='RSAT Response Rate %' datatype='real' default-format='p0.00%' name='[CSAT Response Rate % (copy)_6562659517121904674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_rsat_reponses])/SUM([monthly_incidents_rider])' />
            </column>
            <column caption='Month-Year' datatype='string' name='[Calculation_6562659517228363821]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_month]) &lt; 10 then str(YEAR([report_month])) + &quot;-0&quot; + str(month([report_month]))&#10;ELSE str(YEAR([report_month])) + &quot;-&quot; + str(month([report_month]))&#10;END' />
            </column>
            <column caption='Chat AHT Rider (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Chat AHT Customer (min) (copy)_6562659517122199587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_aht_min_rider]) / SUM([inbound_chats_rs])' />
            </column>
            <column caption='Chat AWUT Rider (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Chat AWUT Customer (min) (copy)_6562659517122314276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_wrap_up_min_rider]) / SUM([inbound_chats_rs])' />
            </column>
            <column caption='Chat SLA Rider %' datatype='real' default-format='p0.00%' name='[Chat SLA Customer % (copy)_6562659517120159772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sla_30s_chat_rs])/SUM([inbound_chats_rs])' />
            </column>
            <column caption='Contact Rate Rider %' datatype='real' default-format='p0.00%' name='[Contact Rate Customer % (copy) (copy)_6562659517100605447]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monthly_incidents_rider]) / SUM([b-Gross Order (copy)_6562659517100474373])' />
            </column>
            <column caption='Is Current Month' datatype='boolean' name='[L2Month (copy)_6562659517166792748]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [report_month]) = DATETRUNC(&apos;month&apos;, TODAY())' />
            </column>
            <column caption='Non-Live SLA Rider % (24h)' datatype='real' default-format='p0.00%' name='[Non-Live SLA Vendor % (24h) (copy)_6562659517120323613]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sla_24hrs_email_rs]) / SUM([inbound_emails_rs])' />
            </column>
            <column caption='QA Score Rider (avg)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[QA Score Customer % (copy) (copy)_6562659517124456486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_qa_score_rider]) / SUM([total_evaluations_rider])' />
            </column>
            <column caption='RSAT Reponses #' datatype='integer' name='[VSAT Reponses # (copy)_6562659517107683340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_rsat_reponses]' />
            </column>
            <column caption='c-Gross Order' datatype='integer' name='[b-Gross Order (copy)_6562659517100474373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[monthly_gross_order_rider]' />
            </column>
