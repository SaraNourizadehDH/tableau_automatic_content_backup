    <worksheet name='Vendor COE'>
      <table>
        <view>
          <datasources>
            <datasource caption='service_operations__coe_bpo_performance_report' name='federated.1putw4c1ynuu4y17poapw1oyjvmf' />
          </datasources>
          <datasource-dependencies datasource='federated.1putw4c1ynuu4y17poapw1oyjvmf'>
            <column caption='VSAT % (Live) ' datatype='real' default-format='p0.00%' name='[CSAT % (Live) (copy)_6562659517114908694]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vsat_live_promotor]) / SUM([total_live_vsat_reponses])' />
            </column>
            <column caption='VSAT % (Non-Live)' datatype='real' default-format='p0.00%' name='[CSAT % (Non-Live) (copy)_6562659517115068439]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vsat_non_live_promotor]) / SUM([total_non_live_vsat_reponses])' />
            </column>
            <column caption='VSAT % (Overall)' datatype='real' default-format='p0.00%' name='[CSAT % (Overall) (copy)_6562659517113872404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([CSAT Promoter Overall (copy)_6562659517114155029]) / SUM([total_vsat_reponses])' />
            </column>
            <column caption='VSAT Promoter Overall' datatype='integer' name='[CSAT Promoter Overall (copy)_6562659517114155029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[vsat_live_promotor]+[vsat_non_live_promotor]' />
            </column>
            <column caption='VSAT Reponses #' datatype='integer' name='[CSAT Reponses # (copy)_6562659517107277835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_vsat_reponses]' />
            </column>
            <column caption='QA Score Customer (avg)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6562659516870361088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_qa_score_customer]) / SUM([total_evaluations_customer])' />
            </column>
            <column caption='VSAT Response Rate %' datatype='real' default-format='p0.00%' name='[Calculation_6562659516875030530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_vsat_reponses])/SUM([monthly_incidents_vendor])' />
            </column>
            <column caption='Month-Year' datatype='string' name='[Calculation_6562659517228363821]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_month]) &lt; 10 then str(YEAR([report_month])) + &quot;-0&quot; + str(month([report_month]))&#10;ELSE str(YEAR([report_month])) + &quot;-&quot; + str(month([report_month]))&#10;END' />
            </column>
            <column caption='Chat AHT Vendor (min) ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Chat AHT Customer (min) (copy)_6562659517115777050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_aht_min_vendor]) / SUM([inbound_chats_vs])' />
            </column>
            <column caption='Chat AWUT Vendor (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Chat AWUT Customer (min) (copy)_6562659517115785243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_wrap_up_min_vendor]) / SUM([inbound_chats_vs])' />
            </column>
            <column caption='Chat SLA Vendor %' datatype='real' default-format='p0.00%' name='[Chat SLA Customer % (copy)_6562659517101985800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sla_30s_chat_vs])/SUM([inbound_chats_vs])' />
            </column>
            <column caption='Contact Rate Vendor %' datatype='real' default-format='p0.00%' name='[Contact Rate Customer % (copy)_6562659517100597254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monthly_incidents_vendor]) / SUM([a-Gross Order (copy)_6562659517100113923])' />
            </column>
            <column caption='Is Current Month' datatype='boolean' name='[L2Month (copy)_6562659517166792748]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [report_month]) = DATETRUNC(&apos;month&apos;, TODAY())' />
            </column>
            <column caption='Non-Live SLA Vendor % (24h)' datatype='real' default-format='p0.00%' name='[Non-Live SLA Customer % (24h) (copy)_6562659517106802697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sla_24hrs_email_vs]) / SUM([inbound_emails_vs])' />
            </column>
            <column caption='QA Score Vendor (avg)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[QA Score Customer % (copy)_6562659517124436005]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_qa_score_vendor]) / SUM([total_evaluations_vendor])' />
            </column>
            <column caption='b-Gross Order' datatype='integer' name='[a-Gross Order (copy)_6562659517100113923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[monthly_gross_order_vendor]' />
            </column>
