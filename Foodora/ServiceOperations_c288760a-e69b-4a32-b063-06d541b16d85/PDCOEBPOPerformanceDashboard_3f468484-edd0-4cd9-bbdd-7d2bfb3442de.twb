            <column caption='CSAT Response Rate %' datatype='real' default-format='p0.00%' name='[VSAT Response Rate % (copy)_6562659517112094737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_csat_reponses])/SUM([monthly_incidents_customer])' />
