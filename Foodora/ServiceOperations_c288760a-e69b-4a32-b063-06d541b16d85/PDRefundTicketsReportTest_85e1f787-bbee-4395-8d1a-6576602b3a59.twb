  <worksheets>
    <worksheet name='Backlog Tickets.'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#d3b348' fontsize='12'>Distribution of Unresolved Refund Tickets</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Refund Tickets Data' name='federated.0oa0d2v12ow21113yijc00kc4htp' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0oa0d2v12ow21113yijc00kc4htp'>
            <column caption='Backlog Tickets' datatype='integer' name='[AVG_full_res_time_m  (copy)_1292251663298580490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_resolved_case] = FALSE THEN [child_case_id] END)' />
            </column>
            <column caption='% Backlog Tickets' datatype='real' default-format='p0.00%' name='[Backlog Tickets (copy)_901282894983667713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_resolved_case] = FALSE THEN [child_case_id] END)/COUNTD([child_case_id])' />
            </column>
            <column caption='Online Payment' datatype='string' name='[Calculation_1292251663611756568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[is_online_payment]' />
            </column>
            <column caption='Week (string)' datatype='string' name='[Calculation_1769351764308762625]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISOWEEK([child_ticket_created_at]) = 1 and ISOYEAR([child_ticket_created_at]) = 2021 then &quot;2022-W01&quot;&#13;&#10;ELSEIF ISOWEEK([child_ticket_created_at]) &lt; 10 then str(ISOYEAR([child_ticket_created_at])) + &quot;-W0&quot; + str(ISOWEEK([child_ticket_created_at]))&#13;&#10;ELSE str(ISOYEAR([child_ticket_created_at])) + &quot;-W&quot; + str(ISOWEEK([child_ticket_created_at]))&#13;&#10;END' />
            </column>
            <column caption='Month (string)' datatype='string' name='[Calculation_1769351764309393410]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([child_ticket_created_at]) &lt; 10 then str(YEAR([child_ticket_created_at])) + &quot;-0&quot; + str(month([child_ticket_created_at]))&#13;&#10;ELSE str(YEAR([child_ticket_created_at])) + &quot;-&quot; + str(month([child_ticket_created_at]))&#13;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1769351764312887301]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    when &apos;Monthly&apos; then [Calculation_1769351764309393410]&#13;&#10;      when &apos;Weekly&apos; then [Calculation_1769351764308762625]&#13;&#10;END' />
            </column>
            <column caption='Queue Time Bucket' datatype='string' name='[Calculation_521854673948651521]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [refund_queue_time]/1440 &gt; 7 THEN &quot;7+ Days&quot;&#13;&#10;ELSEIF [refund_queue_time]/1440 &gt; 3 THEN &quot;3-7 Days&quot;&#13;&#10;ELSEIF [refund_queue_time]/1440 &gt; 1 THEN &quot;1-3 Days&quot;&#13;&#10;ELSEIF [refund_queue_time]/1440 &gt; 0.5 THEN &quot;12-24 Hours&quot;&#13;&#10;//ELSEIF [Refund Queue Time]/1440 &gt;= 0 THEN &quot;0-12 Hours&quot;&#10;    ELSEIF [refund_queue_time] / 1440 &gt; 0.25 THEN &apos;6-12 Hours&apos;  &#10;    ELSEIF [refund_queue_time] / 1440 &gt; 0.125 THEN &apos;3-6 Hours&apos;  &#10;    ELSEIF [refund_queue_time] / 1440 &gt;= 0 THEN &apos;0-3 Hours&apos; &#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
            </column>
            <column caption='Handling Time Bucket' datatype='string' name='[Calculation_521854674170523650]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [handling_time_in_minutes]/60 &gt; 48 THEN &quot;2+ Days&quot;&#13;&#10;ELSEIF [handling_time_in_minutes]/60 &gt; 24 THEN &quot;1-2 Days&quot;&#13;&#10;ELSEIF [handling_time_in_minutes]/60 &gt; 12 THEN &quot;12-24 Hours&quot;&#13;&#10;ELSEIF [handling_time_in_minutes]/60 &gt; 1 THEN &quot;1-12 Hours&quot;&#13;&#10;ELSEIF [handling_time_in_minutes]/60 &gt;= 0 THEN &quot;Within 1 Hour&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
            </column>
            <column caption='Resolved Case' datatype='boolean' name='[Calculation_901282894990151683]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_resolved_case] = TRUE THEN TRUE &#13;&#10;ELSE FALSE &#13;&#10;END' />
            </column>
            <column caption='Refund Type' datatype='string' name='[Calculation_901282895163277316]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF [status_code] IN (55,63,64,65,67,68,592,631,679) THEN &apos;Full Refund&apos;&#13;&#10;//ELSE &apos;Partial Refund&apos; &#13;&#10;//END&#10;[refund_type]' />
            </column>
            <column caption='Refund Triggered' datatype='string' name='[Calculation_901282895170703365]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([triggered_refund_at]) = FALSE THEN &apos;Triggered&apos;&#13;&#10;ELSE &apos;Not Triggered&apos;&#13;&#10;END' />
            </column>
            <column caption='BPO' datatype='string' name='[bpo]' role='dimension' type='nominal' />
