    <worksheet name='PCR3 (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='service_operations__pcr_report (pandata_report)' name='federated.1do339o0sr4q1l19zxx9z0jbbpuy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Metrics' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Incidents&quot;'>
              <calculation class='tableau' formula='&quot;Incidents&quot;' />
              <aliases>
                <alias key='&quot;-b: Incidents Distribution&quot;' value='Incidents Distribution' />
                <alias key='&quot;-d: I/O \%&quot;' value='I/O %' />
                <alias key='&quot;-l1: QA \%&quot;' value='QA Score % (Logic Deprecated)' />
                <alias key='&quot;Average Handling Time (AHT min)&quot;' value='Average Handling Time (AHT min)' />
                <alias key='&quot;chats sla 30 sec \%&quot;' value='Chats SLA 30 sec %' />
                <alias key='&quot;detractor vsat \%&quot;' value='Contact Date Detractor VSAT %' />
                <alias key='&quot;promotor vsat \%&quot;' value='Contact Date Promoter VSAT %' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1do339o0sr4q1l19zxx9z0jbbpuy'>
            <column caption='-b: Gross Orders' datatype='integer' name='[Calculation_105412383764697088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE &#10;[contact_language],&#10;[pcr1],&#10;[pcr2],&#10;[pcr3] ,&#10;[lcr],&#10;[bpo],&#10;[channel],&#10;[contact_origin]:&#10;SUM([gross_order_count])}' />
            </column>
            <column caption='-a: I/O %' datatype='real' default-format='p0.0000%' name='[Calculation_105412383765557249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([interaction_count]) / SUM([Calculation_105412383764697088])' />
            </column>
            <column caption='-h2: Contact Date VSAT %' datatype='real' default-format='p0.00%' name='[Calculation_105412383769866247]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vsat_4_5])/SUM([total_responses])' />
            </column>
            <column caption='-g1: Contact Date VSAT Total Responses' datatype='integer' name='[Calculation_105412383770398728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_responses])' />
            </column>
            <column caption='-j2: Total QA Evaluations (Logic Deprecated)' datatype='integer' name='[Calculation_120400959888490496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([evaluation_count])' />
            </column>
            <column caption='-j3: QA Score % (Logic Deprecated)' datatype='real' name='[Calculation_129126674277629952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qa_score])/ SUM([evaluation_count])' />
            </column>
            <column caption='-zz: Incidents Distribution ' datatype='real' default-format='p0.00%' name='[Calculation_129126674299953153]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([interaction_count]) / SUM({ EXCLUDE [pcr1], [pcr2], [pcr3], [lcr]: SUM([interaction_count])})' />
            </column>
            <column caption='-d: Incidents' datatype='integer' name='[Calculation_129126674300428290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([interaction_count])' />
            </column>
            <column caption='Metrics Values' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2273403044599279619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;-d: I/O %&apos; THEN [Calculation_105412383765557249] * 100&#10;WHEN &apos;chats sla 30 sec %&apos; THEN [Calculation_929430436902539264 1]&#10;WHEN &apos;Average Handling Time (AHT min)&apos; THEN [Calculation_2949576345245401096]&#10;WHEN &apos;detractor vsat %&apos; THEN [Calculation_929430436902899714 1]&#10;WHEN &apos;passive vsat %&apos; THEN [Calculation_929430436903043075 1]&#10;WHEN &apos;promotor vsat %&apos; THEN [Calculation_105412383769866247]&#10;WHEN &apos;-b: Incidents Distribution&apos; THEN [Calculation_129126674299953153]&#10;WHEN &quot;Avg. Incidents per Vendor&quot; THEN [Calculation_397583458158026756]&#10;WHEN &quot;-l1: QA %&quot; THEN [Calculation_129126674277629952]&#10;WHEN &quot;Response Rate %&quot; THEN [Calculation_2949576345248710665]&#10;WHEN &quot;Incidents&quot; THEN [Calculation_129126674300428290]&#10;WHEN &quot;Total QA Evaluations (Logic Deprecated)&quot; THEN [Calculation_120400959888490496]&#10;WHEN &quot;Total VSAT Responses&quot; THEN [Calculation_105412383770398728]&#10;END' />
            </column>
            <column caption='-f: Avg Handling Time (AHT min)' datatype='real' name='[Calculation_2949576345245401096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ht_in_sec]) / SUM([interaction_count])) / 60' />
            </column>
            <column caption='-h1: Contact Date VSAT Response Rate %' datatype='real' default-format='p0.00%' name='[Calculation_2949576345248710665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_responses])/SUM([interaction_count])' />
            </column>
            <column caption='-e: Avg Incidents per Vendor' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_397583458158026756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([interaction_count])/ SUM([unique_vendor_count])' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
            </column>
            <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_456271002456092691]&#13;&#10; when &apos;week&apos; then [Calculation_456271002456002578]&#13;&#10; when &apos;month&apos; then [Calculation_456271002455613457]&#13;&#10;end' />
            </column>
            <column caption='-i2: Chats SLA 30 sec %' datatype='real' default-format='p0.00%' name='[Calculation_929430436902539264 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([chat_within_sla_30]) / SUM([total_chats])' />
            </column>
            <column caption='Chats SLA 30 sec %' datatype='real' default-format='p0.00%' name='[Calculation_929430436902539264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([chat_within_sla_30]) / SUM([total_chats])' />
            </column>
            <column caption='-h3: Contact Date VSAT Detractor %' datatype='real' default-format='p0.00%' name='[Calculation_929430436902899714 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([vsat_1_2]) + SUM([vsat_3])) / SUM([total_responses])' />
            </column>
            <column caption='-zz:  VSAT Passive %' datatype='real' default-format='p0.00%' name='[Calculation_929430436903043075 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vsat_3]) / SUM([total_responses])' />
            </column>
            <column caption='BPO' datatype='string' name='[Calculation_929430436913967111]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [bpo]&#13;&#10;WHEN &apos;Foodpanda APAC BPO - MIBs&apos; THEN &apos;MIBs&apos;&#13;&#10;ELSE [bpo]&#13;&#10;END' />
            </column>
            <column caption='PCR 3 (Modify Item Exclude)' datatype='string' name='[PCR 3 (copy)_109141935214813184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[pcr3]' />
            </column>
