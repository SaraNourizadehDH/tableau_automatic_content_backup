          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Foodora/workbooks/PDPCRReportdraft/PCRTrends?rev=' id='PCRTrends' path='/t/Foodora/workbooks/PDPCRReportdraft' revision='' site='Foodora' />
      <style>
        <style-rule element='dash-title'>
          <format attr='font-weight' value='bold' />
          <format attr='text-align' value='center' />
          <format attr='background-color' value='#9e2e89' />
        </style-rule>
        <style-rule element='dash-subtitle'>
          <format attr='background-color' value='#9e2e89' />
        </style-rule>
        <style-rule element='parameter-ctrl'>
          <format attr='border-style' value='solid' />
          <format attr='border-color' value='#ffffff' />
          <format attr='color' value='#ffffff' />
          <format attr='background-color' value='#9e2e89' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='font-weight' value='bold' />
          <format attr='text-align' value='center' />
          <format attr='color' value='#ffffff' />
        </style-rule>
      </style>
      <size maxheight='3000' maxwidth='1450' minheight='3000' minwidth='1450' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='service_operations__pcr_report (pandata_report)' name='federated.1do339o0sr4q1l19zxx9z0jbbpuy' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Monthly' caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
          <calculation class='tableau' formula='&quot;month&quot;' />
          <aliases>
            <alias key='&quot;day&quot;' value='Daily' />
            <alias key='&quot;month&quot;' value='Monthly' />
            <alias key='&quot;week&quot;' value='Weekly' />
          </aliases>
          <members>
            <member alias='Daily' value='&quot;day&quot;' />
            <member alias='Weekly' value='&quot;week&quot;' />
            <member alias='Monthly' value='&quot;month&quot;' />
          </members>
        </column>
        <column caption='Metrics' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Incidents&quot;'>
          <calculation class='tableau' formula='&quot;Incidents&quot;' />
          <aliases>
            <alias key='&quot;-b: Incidents Distribution&quot;' value='Incidents Distribution' />
            <alias key='&quot;-d: I/O \%&quot;' value='I/O %' />
            <alias key='&quot;-l1: QA \%&quot;' value='QA Score % (Logic Deprecated)' />
            <alias key='&quot;Average Handling Time (AHT min)&quot;' value='Average Handling Time (AHT min)' />
            <alias key='&quot;chats sla 30 sec \%&quot;' value='Chats SLA 30 sec %' />
            <alias key='&quot;detractor vsat \%&quot;' value='Contact Date Detractor VSAT %' />
            <alias key='&quot;promotor vsat \%&quot;' value='Contact Date Promoter VSAT %' />
          </aliases>
          <members>
            <member value='&quot;Incidents&quot;' />
            <member alias='I/O %' value='&quot;-d: I/O \%&quot;' />
            <member alias='Incidents Distribution' value='&quot;-b: Incidents Distribution&quot;' />
            <member alias='Chats SLA 30 sec %' value='&quot;chats sla 30 sec \%&quot;' />
            <member alias='Contact Date Detractor VSAT %' value='&quot;detractor vsat \%&quot;' />
            <member alias='Contact Date Promoter VSAT %' value='&quot;promotor vsat \%&quot;' />
            <member alias='Average Handling Time (AHT min)' value='&quot;Average Handling Time (AHT min)&quot;' />
            <member value='&quot;Avg. Incidents per Vendor&quot;' />
            <member alias='QA Score % (Logic Deprecated)' value='&quot;-l1: QA \%&quot;' />
