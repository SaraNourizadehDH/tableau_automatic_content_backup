            <zone fixed-size='94' forceUpdate='true' h='5513' id='477' is-fixed='true' type-v2='text' w='98896' x='552' y='11242'>
              <formatted-text>
                <run fontalignment='1' fontcolor='#f70000' fontsize='8'>Note 1: Toku Incidents tagged with a case number have been included in this report</run>
                <run fontalignment='1'>Æ&#10;</run>
                <run fontalignment='1' fontcolor='#f70000' fontsize='8'>Note 2: Contacts in this report are excluding outbound calls and PC cases from SF Sales Console. Therefore the I/O will not be matched with the </run>
                <run fontalignment='1' fontcolor='#4996b2' hyperlink='tabdoc:load-url url=&amp;quot;https://tableau.deliveryhero.net/#/site/Foodora/workbooks/38876/views&amp;quot;'>[PD] Service Ops &amp; Opex Scorecard.</run>
                <run fontalignment='1'>Æ&#10;</run>
                <run fontalignment='1' fontcolor='#f70000' fontsize='8'>Note 3: Select  “N/A” category along with the required category when applying the filter for I/O &amp; Gross Orders.</run>
                <run fontalignment='1'>Æ&#10;</run>
                <run fontalignment='1' fontcolor='#f70000' fontsize='8'>Note 4: VSAT in this report is based on contact creation date, For overall values kindly refer to </run>
                <run fontalignment='1' fontcolor='#4996b2' hyperlink='tabdoc:load-url url=&amp;quot;https://tableau.deliveryhero.net/#/site/Foodora/views/PDAfterContactRatingReportdraft/CSAT?:iid=1&amp;amp;amp;amp;&amp;quot;'>[PD] After Contact Rating Report.</run>
                <run fontalignment='1'>Æ&#10;</run>
                <run bold='true' fontalignment='1' fontcolor='#f70000' fontsize='8'>Note 5 (14th July):</run>
                <run fontalignment='1' fontcolor='#f70000' fontsize='8'> The gross order count includes </run>
                <run bold='true' fontalignment='1' fontcolor='#f70000' fontsize='8' underline='true'>ODR orders</run>
                <run fontalignment='1' fontcolor='#f70000' fontsize='8'>; as a result, the I/O number will be lower.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#9e2e89' />
                <format attr='border-style' value='solid' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#e6e6e6' />
              </zone-style>
            </zone>
            <zone h='75568' id='240' param='horz' type-v2='layout-flow' w='98896' x='552' y='16755'>
              <zone fixed-size='1200' h='75568' id='363' is-fixed='true' name='PCR wise summary (4)' show-title='false' w='78206' x='552' y='16755'>
