      </connection>
      <aliases enabled='yes' />
      <column caption='-zz: Total AHT min(+wrap up)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[-k: Chat AHT min (copy)_803048139344965632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([ht_in_sec]) / SUM([valid_chats])) / 60' />
      </column>
      <column caption='2nd Dimension ' datatype='string' name='[1st Dimension (copy)_6465409883705073665]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 6 1 1]&#10;WHEN &apos;Pandora&apos; THEN &apos;Pandora&apos;&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand&apos; THEN [company_name]&#10;when &apos;country&apos; then [country]&#10;when &apos;vertical type&apos; then [vertical_type]&#10;when &apos;language&apos; then [contact_language]&#10;when &apos;Agent Category&apos; then [agent_category]&#10;when &apos;channel&apos; then [channel]&#10;WHEN &apos;BPO&apos; THEN [Calculation_929430436913967111]&#10;END' />
      </column>
      <column caption='Trend Dimension' datatype='string' name='[1st Dimension (copy)_6477161439217135617]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[1st Dimension (copy)_6477161439217000448]&#10;WHEN &apos;Pandora&apos; THEN &apos;Pandora&apos;&#10;WHEN &apos;Brand&apos; THEN [company_name]&#10;when &apos;Country&apos; then [country]&#10;END' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_chats]) / TOTAL(SUM([total_chats]))'>
          <table-calc ordering-field='[federated.1do339o0sr4q1l19zxx9z0jbbpuy].[pcr3]' ordering-type='Field' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_chats]) / TOTAL(SUM([total_chats]))'>
          <table-calc ordering-type='CellInPane' />
        </calculation>
      </column>
      <column caption='-b: Gross Orders' datatype='integer' name='[Calculation_105412383764697088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE &#10;[contact_language],&#10;[pcr1],&#10;[pcr2],&#10;[pcr3] ,&#10;[lcr],&#10;[bpo],&#10;[channel],&#10;[contact_origin]:&#10;SUM([gross_order_count])}' />
      </column>
      <column caption='-a: I/O %' datatype='real' default-format='p0.0000%' name='[Calculation_105412383765557249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([interaction_count]) / SUM([Calculation_105412383764697088])' />
      </column>
      <column caption='-h2: Contact Date VSAT %' datatype='real' default-format='p0.00%' name='[Calculation_105412383769866247]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vsat_4_5])/SUM([total_responses])' />
      </column>
      <column caption='-g1: Contact Date VSAT Total Responses' datatype='integer' name='[Calculation_105412383770398728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_responses])' />
      </column>
      <column caption='FCR First Contacts' datatype='integer' name='[Calculation_105412383771983885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_fcr])' />
      </column>
      <column caption='FCR %' datatype='real' default-format='p0.00%' name='[Calculation_105412383774715918]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({EXCLUDE [lcr] :SUM([num_fcr])}) /&#10;SUM({EXCLUDE [lcr] :SUM([ticket_count_fcr])})' />
      </column>
      <column caption='-j2: Total QA Evaluations (Logic Deprecated)' datatype='integer' name='[Calculation_120400959888490496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([evaluation_count])' />
      </column>
      <column caption='-zz: Valid Chats %' datatype='real' name='[Calculation_120400959889211393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([valid_chats])/SUM([total_chats])' />
      </column>
      <column caption='-j3: QA Score % (Logic Deprecated)' datatype='real' name='[Calculation_129126674277629952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qa_score])/ SUM([evaluation_count])' />
      </column>
      <column caption='-zz: Incidents Distribution ' datatype='real' default-format='p0.00%' name='[Calculation_129126674299953153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([interaction_count]) / SUM({ EXCLUDE [pcr1], [pcr2], [pcr3], [lcr]: SUM([interaction_count])})' />
      </column>
      <column caption='-d: Incidents' datatype='integer' name='[Calculation_129126674300428290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([interaction_count])' />
      </column>
      <column caption='-zz: Total Chats' datatype='integer' name='[Calculation_129126674303393796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_chats])' />
      </column>
      <column caption='-zz: Total Valid Chats' datatype='integer' name='[Calculation_129126674310242310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([valid_chats])' />
      </column>
      <column caption='KPI Filter' datatype='string' name='[Calculation_1335035878362763264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Chat AHT min&apos; THEN &apos;Chat AHT min&apos;&#13;&#10;WHEN &apos;Chat SLA 30 sec %&apos; THEN &apos;Chat SLA 30 sec %&apos;&#13;&#10;WHEN &apos;Promotor VSAT %&apos; THEN &apos;Promotor VSAT %&apos;&#13;&#10;WHEN &apos;Passive VSAT %&apos; THEN &apos;Passive VSAT %&apos;&#13;&#10;WHEN &apos;Detractor VSAT %&apos; THEN &apos;Detractor VSAT %&apos;&#13;&#10;END' />
      </column>
      <column caption='KPI PCR Filter' datatype='string' name='[Calculation_1335035878388547586]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Incoming Chats&apos; THEN &apos;Incoming Chats&apos;&#13;&#10;WHEN &apos;Incoming Chats % of Total&apos; THEN &apos;Incoming Chats % of Total&apos;&#13;&#10;WHEN &apos;Chat AHT min&apos; THEN &apos;Chat AHT min&apos;&#13;&#10;WHEN &apos;Chat SLA 30 sec %&apos; THEN &apos;Chat SLA 30 sec %&apos;&#13;&#10;WHEN &apos;Promotor VSAT %&apos; THEN &apos;Promotor VSAT %&apos;&#13;&#10;WHEN &apos;Promotor VSAT % of Total&apos; THEN &apos;Promotor VSAT % of Total&apos;&#13;&#10;WHEN &apos;Passive VSAT %&apos; THEN &apos;Passive VSAT %&apos;&#13;&#10;WHEN &apos;Passive VSAT % of Total&apos; THEN &apos;Passive VSAT % of Total&apos;&#13;&#10;WHEN &apos;Detractor VSAT %&apos; THEN &apos;Detractor VSAT %&apos;&#13;&#10;WHEN &apos;Detractor VSAT % of Total&apos; THEN &apos;Detractor VSAT % of Total&apos;&#13;&#10;END' />
      </column>
      <column caption='Metrics Values' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2273403044599279619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;-d: I/O %&apos; THEN [Calculation_105412383765557249] * 100&#10;WHEN &apos;chats sla 30 sec %&apos; THEN [Calculation_929430436902539264 1]&#10;WHEN &apos;Average Handling Time (AHT min)&apos; THEN [Calculation_2949576345245401096]&#10;WHEN &apos;detractor vsat %&apos; THEN [Calculation_929430436902899714 1]&#10;WHEN &apos;passive vsat %&apos; THEN [Calculation_929430436903043075 1]&#10;WHEN &apos;promotor vsat %&apos; THEN [Calculation_105412383769866247]&#10;WHEN &apos;-b: Incidents Distribution&apos; THEN [Calculation_129126674299953153]&#10;WHEN &quot;Avg. Incidents per Vendor&quot; THEN [Calculation_397583458158026756]&#10;WHEN &quot;-l1: QA %&quot; THEN [Calculation_129126674277629952]&#10;WHEN &quot;Response Rate %&quot; THEN [Calculation_2949576345248710665]&#10;WHEN &quot;Incidents&quot; THEN [Calculation_129126674300428290]&#10;WHEN &quot;Total QA Evaluations (Logic Deprecated)&quot; THEN [Calculation_120400959888490496]&#10;WHEN &quot;Total VSAT Responses&quot; THEN [Calculation_105412383770398728]&#10;END' />
      </column>
      <column caption='1st Dimension' datatype='string' name='[Calculation_2273403044958945284]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 6 1]&#10;WHEN &apos;Pandora&apos; THEN &apos;Pandora&apos;&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand&apos; THEN [company_name]&#10;when &apos;country&apos; then [country]&#10;when &apos;vertical type&apos; then [vertical_type]&#10;when &apos;language&apos; then [contact_language]&#10;when &apos;Agent Category&apos; then [agent_category]&#10;when &apos;channel&apos; then [channel]&#10;WHEN &apos;BPO&apos; THEN [Calculation_929430436913967111]&#10;END' />
      </column>
      <column caption='Calculation2' datatype='string' name='[Calculation_2949576345221185539]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 4]&#10; when &apos;PCR 1&apos; then [pcr1]&#10; when &apos;PCR 2&apos; then [pcr2]&#10; when &apos;PCR 3&apos; then [pcr3]&#10; when &apos;LCR&apos; then [lcr]&#10;END' />
      </column>
      <column caption='PCR Type' datatype='string' name='[Calculation_2949576345240379398]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;PCR 1&apos; THEN [pcr1]&#10;WHEN &apos;PCR 2&apos; THEN [pcr2]&#10;WHEN &apos;PCR 3&apos; THEN [pcr3]&#10;WHEN &apos;LCR&apos; THEN [lcr]&#10;END' />
      </column>
      <column caption='Average Handling Time (AHT)' datatype='real' name='[Calculation_2949576345244958727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([ht_in_sec]) / ([Calculation_129126674300428290])) / 60' />
      </column>
      <column caption='-f: Avg Handling Time (AHT min)' datatype='real' name='[Calculation_2949576345245401096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([ht_in_sec]) / SUM([interaction_count])) / 60' />
      </column>
      <column caption='-h1: Contact Date VSAT Response Rate %' datatype='real' default-format='p0.00%' name='[Calculation_2949576345248710665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_responses])/SUM([interaction_count])' />
      </column>
      <column caption='-g2: Contact Date VSAT Promoter Responses' datatype='integer' name='[Calculation_2949576345258885131]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vsat_4_5])' />
      </column>
      <column caption='-g3: Contact Date VSAT Detractor Responses' datatype='integer' name='[Calculation_2949576345259139084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vsat_1_2]) + SUM([vsat_3])' />
      </column>
      <column caption='-zz: Total VSAT Passive' datatype='integer' name='[Calculation_2949576345259335693]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vsat_3])' />
      </column>
      <column caption='-k: Total Vendors' datatype='integer' name='[Calculation_2949576345264943119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unique_vendor_count])' />
      </column>
      <column caption='-j1: Total QA Score (Logic Deprecated)' datatype='real' name='[Calculation_2949576345271865361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qa_score])' />
      </column>
      <column caption='PCR' datatype='string' name='[Calculation_3483956536843423744]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;PCR&quot;' />
      </column>
      <column caption='-c: Incidents Distribution' datatype='real' default-format='p0.00%' name='[Calculation_3483956536865382401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([interaction_count]) / SUM({ EXCLUDE [pcr1], [pcr2], [pcr3], [lcr]: SUM([interaction_count])})' />
      </column>
      <column caption='Incidents Distribution (Per Source)' datatype='real' default-format='p0.00%' name='[Calculation_397583458145173504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([interaction_count]) / SUM({ EXCLUDE [contact_origin]: SUM([interaction_count])})' />
      </column>
      <column caption='Unique Vendor %' datatype='real' default-format='p0.00%' name='[Calculation_397583458147307521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unique_vendor_count]) / SUM([all_vendor_count])' />
      </column>
      <column caption='-e: Avg Incidents per Vendor' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_397583458158026756]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([interaction_count])/ SUM([unique_vendor_count])' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_456271002455613457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#13;&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_456271002456002578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#13;&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#13;&#10;END' />
      </column>
      <column caption='Day' datatype='string' name='[Calculation_456271002456092691]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if day([report_date]) &lt; 10  then [Calculation_456271002455613457]+&quot;-0&quot;+str(day([report_date]))&#13;&#10;else [Calculation_456271002455613457]+&quot;-&quot;+str(day([report_date]))&#13;&#10;end' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_456271002456420372]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#13;&#10; when &apos;day&apos; then [Calculation_456271002456092691]&#13;&#10; when &apos;week&apos; then [Calculation_456271002456002578]&#13;&#10; when &apos;month&apos; then [Calculation_456271002455613457]&#13;&#10;end' />
      </column>
      <column caption='KPI Filter (1)' datatype='string' name='[Calculation_622341232379977730 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 2]&#13;&#10;WHEN &apos;-k: Chat AHT min&apos; THEN &apos;-k: Chat AHT min&apos;&#10;WHEN &apos;-k3: Chats SLA 30 sec %&apos; THEN &apos;-k3: Chats SLA 30 sec %&apos;&#13;&#10;WHEN &apos;-g1: VSAT%&apos; THEN &apos;-g1: VSAT%&apos;&#13;&#10;WHEN &apos;-g3: Passive VSAT %&apos; THEN &apos;-g3: Passive VSAT %&apos;&#13;&#10;WHEN &apos;-g: Detractor VSAT %&apos; THEN &apos;-g: Detractor VSAT %&apos;&#13;&#10;END' />
      </column>
      <column caption='-i2: Chats SLA 30 sec %' datatype='real' default-format='p0.00%' name='[Calculation_929430436902539264 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([chat_within_sla_30]) / SUM([total_chats])' />
      </column>
      <column caption='Chats SLA 30 sec %' datatype='real' default-format='p0.00%' name='[Calculation_929430436902539264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([chat_within_sla_30]) / SUM([total_chats])' />
      </column>
      <column caption='-zz: Chat AHT min' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_929430436902744065 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([handling_time_sec]) / SUM([valid_chats])) / 60' />
      </column>
      <column caption='Chat AHT min' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_929430436902744065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([handling_time_sec]) / SUM([valid_chats])) / 60' />
      </column>
      <column caption='-h3: Contact Date VSAT Detractor %' datatype='real' default-format='p0.00%' name='[Calculation_929430436902899714 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([vsat_1_2]) + SUM([vsat_3])) / SUM([total_responses])' />
      </column>
      <column caption='Detractor VSAT %' datatype='real' default-format='p0.00%' name='[Calculation_929430436902899714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vsat_1_2]) / SUM([total_responses])' />
      </column>
      <column caption='-zz:  VSAT Passive %' datatype='real' default-format='p0.00%' name='[Calculation_929430436903043075 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vsat_3]) / SUM([total_responses])' />
      </column>
      <column caption='Passive VSAT %' datatype='real' default-format='p0.00%' name='[Calculation_929430436903043075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vsat_3]) / SUM([total_responses])' />
      </column>
      <column caption='Promotor VSAT %' datatype='real' default-format='p0.00%' name='[Calculation_929430436903145476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vsat_4_5]) / SUM([total_responses])' />
      </column>
      <column caption='Hide Null Data' datatype='boolean' name='[Calculation_929430436904693765]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_date] &gt;= DATE(&quot;2021-06-15&quot;) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='BPO' datatype='string' name='[Calculation_929430436913967111]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [bpo]&#13;&#10;WHEN &apos;Foodpanda APAC BPO - MIBs&apos; THEN &apos;MIBs&apos;&#13;&#10;ELSE [bpo]&#13;&#10;END' />
