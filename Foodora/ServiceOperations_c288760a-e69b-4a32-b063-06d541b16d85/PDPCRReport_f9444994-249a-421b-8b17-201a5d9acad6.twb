            <column caption='1st Dimension' datatype='string' name='[Parameter 6 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand&quot;'>
              <calculation class='tableau' formula='&quot;Brand&quot;' />
              <aliases>
                <alias key='&quot;channel&quot;' value='Channel' />
                <alias key='&quot;country&quot;' value='Country' />
                <alias key='&quot;language&quot;' value='Language' />
