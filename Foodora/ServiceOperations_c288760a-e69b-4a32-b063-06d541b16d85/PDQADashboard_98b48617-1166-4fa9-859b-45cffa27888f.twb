      <aliases enabled='yes' />
      <column caption='2nd Dimension ' datatype='string' name='[1st Dimension (copy)_725079608171589637]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[1st Dimension  (copy)_4682406609033732102]&#10;when &apos;Country&apos; THEN [country]&#10;when &apos;Company Name&apos; THEN [company_name]&#10;when &apos;Date&apos; then [Calculation_4682406609015496707]&#10;when &apos;Language&apos; then [contact_language]&#10;when &apos;Channel&apos; then [channel]&#10;when &apos;Agent Category&apos; then [agent_category]&#10;WHEN &apos;BPO&apos; then [bpo]&#10;WHEN &apos;Queue&apos; then [queue]&#10;when &apos;lob&apos; then [lob]&#10;WHEN &apos;CCR3&apos; THEN [ccr3]&#10;end' />
      </column>
      <column caption='Perfect Interaction Rate' datatype='real' default-format='p0.00%' name='[Avg QA Score (copy)_4682406609033981959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([perfect_evaluations],0)) / SUM(IFNULL([total_evaluations],0))' />
      </column>
      <column caption='Avg QA Score' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4682406609013694464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([total_qa_score],0)) / SUM(IFNULL([total_evaluations],0))' />
      </column>
      <column caption='Week' datatype='string' name='[Calculation_4682406609014919169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISOWEEK([report_date]) &lt; 10 then str(ISOYEAR([report_date])) + &quot;-W0&quot; + str(ISOWEEK([report_date]))&#10;ELSE str(ISOYEAR([report_date])) + &quot;-W&quot; + str(ISOWEEK([report_date]))&#10;END' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_4682406609015267330]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if month([report_date]) &lt; 10 then str(YEAR([report_date])) + &quot;-0&quot; + str(month([report_date]))&#10;ELSE str(YEAR([report_date])) + &quot;-&quot; + str(month([report_date]))&#10;END' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_4682406609015496707]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [granularity]&#10; when &apos;Weekly&apos; then [Calculation_4682406609014919169]&#10; when &apos;Monthly&apos; then [Calculation_4682406609015267330]&#10;end' />
      </column>
      <column caption='Company-Country Selection' datatype='string' name='[Calculation_4682406609026764804]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#10;when &apos;Country&apos; THEN [country]&#10;when &apos;Company&apos; THEN [company_name]&#10;end' />
      </column>
      <column caption='1st Dimension' datatype='string' name='[Metrics  (copy)_725079608170524676]' role='dimension' type='nominal'>
